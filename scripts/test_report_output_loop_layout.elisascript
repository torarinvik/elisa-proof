#!/usr/bin/env elisascript
# ElisaScript counterpart for test_report_output_loop_layout.py.

using EsBoundedText

const PROOF_REPORT_OUTPUT_LOOP_LAYOUT_MAX_SOURCE_BYTES: usize = 16777216


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, File.Read, Console.Write, Console.Format]:
    _ = arguments
    script_file: Path = try path_real(Script::source_path()) else err:
        _ = write_stderr("report serialization loop layout: unable to resolve script path\n")
        return 1i64
    script_directory: Path = script_file.parent()
    proof_root: Path = script_directory.parent()
    source_file: Path = proof_root.joinpath("src/app/report_output_serialization_helpers.elisa")

    source_real_before: Path = try path_real(source_file) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    if not is_file(source_file):
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64

    source_size_before: usize = try file_size(source_file) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    if source_size_before > PROOF_REPORT_OUTPUT_LOOP_LAYOUT_MAX_SOURCE_BYTES:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    source_mtime_before: i64 = try file_mtime(source_file) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    source_ctime_before: i64 = try file_ctime(source_file) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64

    source: sview = try EsBoundedText::read_utf8(source_file, PROOF_REPORT_OUTPUT_LOOP_LAYOUT_MAX_SOURCE_BYTES) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64

    source_real_after: Path = try path_real(source_file) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    source_size_after: usize = try file_size(source_file) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    source_mtime_after: i64 = try file_mtime(source_file) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    source_ctime_after: i64 = try file_ctime(source_file) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64

    if not is_file(source_file) or source_real_before != source_real_after or source_size_before != source_size_after or source_size_before != len(source) or source_mtime_before != source_mtime_after or source_ctime_before != source_ctime_after:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64

    normalized_source: sview = source.replace("\r\n", "\n").replace("\r", "\n")
    required: darray[sview] = [
        "-> (complete: bool, index: usize):\n    for candidate in 0..<names.count",
        "-> (complete: bool, contains: bool):\n    for prior in 0..<count",
        "\n        return (false, names.count) if not proof_replay_fact_origin_text_compare_charge(names[candidate], name, work)",
        "\n        return (false, false) if not proof_replay_fact_origin_work_charge(1, work)"
    ]
    for fragment in required:
        if not normalized_source.contains(fragment):
            _ = write_stderr("report serialization loop layout: expected bounded scan fragment is missing\n")
            return 1i64

    print("report serialization loop layout: bounded scans remain correctly nested")
    return 0i64
