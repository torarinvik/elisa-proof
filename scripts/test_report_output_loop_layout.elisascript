#!/usr/bin/env elisascript
# ElisaScript counterpart for test_report_output_loop_layout.py.
include "../../elisa-script/vendor/elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../../elisa-script/vendor/elisa-compiler/elisacore_std/elisacore_fileio.elisa"
include "../../elisa-script/src/runtime/encoding.elisa"
include "../../elisa-script/src/runtime/bounded_text_posix.elisa"

using EsBoundedText
using EsRuntime

def proof_report_output_loop_layout_contains(haystack: sview, needle: sview) -> bool can[Memory.Allocate, Abort.Panic]:
    haystack_length: usize = sview_len(haystack)
    needle_length: usize = sview_len(needle)
    return true if needle_length == 0
    return false if needle_length > haystack_length
    failure: mutable darray[usize] = []
    failure.reserve(needle_length)
    for _ in 0..<needle_length |failure|:
        failure.push(0)
    prefix_length: mutable usize = 0
    for index in 1..<needle_length |failure, needle, prefix_length|:
        while prefix_length > 0 and sview_at(needle, index) != sview_at(needle, prefix_length) |failure, needle, index, prefix_length|:
            prefix_length <- failure[prefix_length - 1]
        prefix_length <- prefix_length + 1 if sview_at(needle, index) == sview_at(needle, prefix_length)
        failure[index] <- prefix_length
    matched: mutable usize = 0
    for index in 0..<haystack_length |haystack, needle, failure, matched|:
        while matched > 0 and sview_at(haystack, index) != sview_at(needle, matched) |haystack, needle, failure, index, matched|:
            matched <- failure[matched - 1]
        matched <- matched + 1 if sview_at(haystack, index) == sview_at(needle, matched)
        return true if matched == needle_length
    return false


def proof_report_output_loop_layout_run() -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    script_file: Path = try path_real(path(Script::source_path())) else err:
        _ = write_stderr("report serialization loop layout: unable to resolve script path\n")
        return 1i64
    script_directory: Path = script_file.parent()
    proof_root: Path = script_directory.parent()
    source_file: Path = proof_root.joinpath("src/app/report_output_serialization_helpers.elisa")
    source: sview = try EsBoundedText::read_utf8(source_file, 16777216) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    normalized_bytes: mutable darray[u8] = []
    normalized_bytes.reserve(sview_len(source))
    normalization_offset: mutable usize = 0
    while normalization_offset < sview_len(source):
        current_byte: u8 = sview_at(source, normalization_offset)
        if current_byte == 13u8:
            normalized_bytes.push(10u8)
            normalization_offset <- normalization_offset + 1
            normalization_offset <- normalization_offset + 1 if normalization_offset < sview_len(source) and sview_at(source, normalization_offset) == 10u8
        else:
            normalized_bytes.push(current_byte)
            normalization_offset <- normalization_offset + 1
    normalized_source: sview = bytes_view(normalized_bytes)

    required: darray[sview] = [
        "-> (complete: bool, index: usize):\n    for candidate in 0..<names.count",
        "-> (complete: bool, contains: bool):\n    for prior in 0..<count",
        "\n        return (false, names.count) if not proof_replay_fact_origin_text_compare_charge(names[candidate], name, work)",
        "\n        return (false, false) if not proof_replay_fact_origin_work_charge(1, work)"
    ]
    for fragment in required:
        if not proof_report_output_loop_layout_contains(normalized_source, fragment):
            _ = write_stderr("report serialization loop layout: expected bounded scan fragment is missing\n")
            return 1i64

    print("report serialization loop layout: bounded scans remain correctly nested")
    return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console.Write, Console.Format]:
    _ = arguments
    return proof_report_output_loop_layout_run()
