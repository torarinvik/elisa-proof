#!/usr/bin/env elisascript
# ElisaScript counterpart for ../test_report_output_loop_layout.py.
include "../../../elisa-script/src/runtime/encoding.elisa"
include "../../../elisa-script/src/runtime/bounded_text_posix.elisa"

using EsBoundedText

def proof_report_output_loop_layout_run() -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, File.Read, Directory.Read, Console.Write, Console.Format]:
    script_file: Path = try path_real(path(Script::source_path())) else err:
        _ = write_stderr("report serialization loop layout: unable to resolve script path\n")
        return 1i64
    script_directory: Path = script_file.parent()
    scripts_directory: Path = script_directory.parent()
    proof_root: Path = scripts_directory.parent()
    source_file: Path = proof_root.joinpath("src/app/report_output_serialization_helpers.elisa")
    source: sview = try EsBoundedText::read_utf8(source_file, 16777216) else err:
        _ = write_stderr("report serialization loop layout: unable to read source file\n")
        return 1i64
    crlf_normalized: sview = source.replace("\r\n", "\n")
    normalized_source: sview = crlf_normalized.replace("\r", "\n")

    required: darray[sview] = [
        "-> (complete: bool, index: usize):\n    for candidate in 0..<names.count",
        "-> (complete: bool, contains: bool):\n    for prior in 0..<count",
        "\n        return (false, names.count) if not proof_replay_fact_origin_text_compare_charge(names[candidate], name, work)",
        "\n        return (false, false) if not proof_replay_fact_origin_work_charge(1, work)"
    ]
    for fragment in required:
        fragment_index: i64 = try normalized_source.index(fragment) else err:
            -1i64
        if fragment_index < 0:
            _ = write_stderr("report serialization loop layout: expected bounded scan fragment is missing\n")
            return 1i64

    print("report serialization loop layout: bounded scans remain correctly nested")
    return 0i64


def main(arguments: darray[sview]) -> i64 can[Blocking.IO, Memory.Allocate, Abort.Panic, Unsafe.PointerCast, File.Read, Directory.Read, Console.Write, Console.Format]:
    _ = arguments
    return proof_report_output_loop_layout_run()
