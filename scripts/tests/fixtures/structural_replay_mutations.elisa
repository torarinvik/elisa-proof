def api_structural_certificate_offset_tamper(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    return false if report.structural.verified_names.count == 0 or report.certificates.count == 0
    certificate_index: mutable usize = report.certificates.count
    for index in 0..<report.certificates.count |index, report, certificate_index|:
        certificate: ProofGoalCertificate = report.certificates[index]
        if certificate.rule == "structural-safety":
            certificate_index <- index
            break
    return false if certificate_index >= report.certificates.count
    certificate: ProofGoalCertificate = report.certificates[certificate_index]
    return false if certificate.kernel_goal >= report.kernel.nodes.count
    root: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[certificate.kernel_goal]
    return false if root.kind != "structural-safety"
    # Keep the report, theorem, and witness unchanged; only detach the proof claim from its
    # source call site. Replay must rebuild that correspondence from the retained declarations.
    report.kernel.nodes[certificate.kernel_goal] <- ElisaProofKernelCore::ProofKernelNode{kind: root.kind, operator: root.operator, left: root.left + 1, right: root.right, auxiliary: root.auxiliary, children_start: root.children_start, children_count: root.children_count, value: root.value, name: root.name, secondary_name: root.secondary_name}
    (proof_replay_certificates(report) can Global{Read,Write})
    return report.replay_gaps > 0 and not report.certificates[certificate_index].replayed

def api_structural_certificate_callee_tamper(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    certificate_index: mutable usize = report.certificates.count
    for index in 0..<report.certificates.count |index, report, certificate_index|:
        certificate: ProofGoalCertificate = report.certificates[index]
        if certificate.rule == "structural-safety":
            certificate_index <- index
            break
    return false if certificate_index >= report.certificates.count
    certificate: ProofGoalCertificate = report.certificates[certificate_index]
    return false if certificate.kernel_goal >= report.kernel.nodes.count
    root: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[certificate.kernel_goal]
    return false if root.kind != "structural-safety" or root.children_count != 1 or root.children_start >= report.kernel.children.count
    edge_index: usize = report.kernel.children[root.children_start]
    return false if edge_index >= report.kernel.nodes.count
    edge: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[edge_index]
    return false if edge.kind != "structural-edge"
    # Preserve the source call offset and witness while forging only the recursive target name.
    report.kernel.nodes[edge_index] <- ElisaProofKernelCore::ProofKernelNode{kind: edge.kind, operator: edge.operator, left: edge.left, right: edge.right, auxiliary: edge.auxiliary, children_start: edge.children_start, children_count: edge.children_count, value: edge.value, name: edge.name, secondary_name: "missing_recursive_target"}
    (proof_replay_certificates(report) can Global{Read,Write})
    return report.replay_gaps > 0 and not report.certificates[certificate_index].replayed

def api_structural_certificate_omission(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    kept: mutable darray[ProofGoalCertificate] = []
    omitted: mutable bool = false
    for certificate in report.certificates |certificate, kept, omitted|:
        if not omitted and certificate.rule == "structural-safety":
            omitted <- true
        else:
            kept.push(certificate)
    return false if not omitted
    report.certificates.clear()
    report.certificates.extend(kept)
    (proof_replay_certificates(report) can Global{Read,Write})
    # Missing evidence must keep the proof incomplete even though the remaining rows replay.
    return report.replay_gaps > 0

def api_structural_ambiguous_owner_source(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    certificate_index: mutable usize = report.certificates.count
    for index in 0..<report.certificates.count |index, report, certificate_index|:
        certificate: ProofGoalCertificate = report.certificates[index]
        if certificate.rule == "structural-safety":
            certificate_index <- index
            break
    return false if certificate_index >= report.certificates.count
    owner: sview = report.certificates[certificate_index].name
    duplicate: mutable Ast::Decl = Ast::Decl.Invalid
    found: mutable bool = false
    for declaration in report.source_declarations |owner, duplicate, found|:
        match declaration:
            Ast::Decl.Func(name, _, _, _, _, _, _):
                if name == owner:
                    duplicate <- declaration
                    found <- true
                    break
            _:
                pass
    return false if not found
    report.source_declarations.push(duplicate)
    (proof_replay_certificates(report) can Global{Read,Write})
    return report.replay_gaps > 0 and not report.certificates[certificate_index].replayed
