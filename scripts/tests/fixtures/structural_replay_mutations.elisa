def api_structural_certificate_offset_tamper(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    return false if report.structural.verified_names.count == 0 or report.certificates.count == 0
    certificate_index: mutable usize = report.certificates.count
    for index in 0..<report.certificates.count |index, report, certificate_index|:
        certificate: ProofGoalCertificate = report.certificates[index]
        if certificate.rule == "structural-safety":
            certificate_index <- index
            break
    return false if certificate_index >= report.certificates.count
    certificate: ProofGoalCertificate = report.certificates[certificate_index]
    return false if certificate.kernel_goal >= report.kernel.nodes.count
    root: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[certificate.kernel_goal]
    return false if root.kind != "structural-safety"
    # Keep the report, theorem, and witness unchanged; only detach the proof claim from its
    # source call site. Replay must rebuild that correspondence from the retained declarations.
    report.kernel.nodes[certificate.kernel_goal] <- ElisaProofKernelCore::ProofKernelNode{kind: root.kind, operator: root.operator, left: root.left + 1, right: root.right, auxiliary: root.auxiliary, children_start: root.children_start, children_count: root.children_count, value: root.value, name: root.name, secondary_name: root.secondary_name}
    (proof_replay_certificates(report) can Global{Read,Write})
    return report.replay_gaps > 0 and not report.certificates[certificate_index].replayed

def api_structural_certificate_callee_tamper(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    certificate_index: mutable usize = report.certificates.count
    for index in 0..<report.certificates.count |index, report, certificate_index|:
        certificate: ProofGoalCertificate = report.certificates[index]
        if certificate.rule == "structural-safety":
            certificate_index <- index
            break
    return false if certificate_index >= report.certificates.count
    certificate: ProofGoalCertificate = report.certificates[certificate_index]
    return false if certificate.kernel_goal >= report.kernel.nodes.count
    root: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[certificate.kernel_goal]
    return false if root.kind != "structural-safety" or root.children_count != 1 or root.children_start >= report.kernel.children.count
    edge_index: usize = report.kernel.children[root.children_start]
    return false if edge_index >= report.kernel.nodes.count
    edge: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[edge_index]
    return false if edge.kind != "structural-edge"
    # Preserve the source call offset and witness while forging only the recursive target name.
    report.kernel.nodes[edge_index] <- ElisaProofKernelCore::ProofKernelNode{kind: edge.kind, operator: edge.operator, left: edge.left, right: edge.right, auxiliary: edge.auxiliary, children_start: edge.children_start, children_count: edge.children_count, value: edge.value, name: edge.name, secondary_name: "missing_recursive_target"}
    (proof_replay_certificates(report) can Global{Read,Write})
    return report.replay_gaps > 0 and not report.certificates[certificate_index].replayed

def api_structural_certificate_subject_tamper(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    certificate_index: mutable usize = report.certificates.count
    for index in 0..<report.certificates.count |index, report, certificate_index|:
        certificate: ProofGoalCertificate = report.certificates[index]
        if certificate.rule == "structural-safety":
            certificate_index <- index
            break
    return false if certificate_index >= report.certificates.count
    certificate: ProofGoalCertificate = report.certificates[certificate_index]
    return false if certificate.kernel_goal >= report.kernel.nodes.count
    root: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[certificate.kernel_goal]
    return false if root.kind != "structural-safety" or root.children_count != 1 or root.children_start >= report.kernel.children.count
    edge_index: usize = report.kernel.children[root.children_start]
    return false if edge_index >= report.kernel.nodes.count
    edge: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[edge_index]
    return false if edge.kind != "structural-edge" or edge.children_count == 0 or edge.children_start > report.kernel.children.count or edge.children_count > report.kernel.children.count - edge.children_start
    witness_index: mutable usize = report.kernel.nodes.count
    for witness_offset in 0..<edge.children_count |witness_offset, edge, report, witness_index|:
        candidate_index: usize = report.kernel.children[edge.children_start + witness_offset]
        return false if candidate_index >= report.kernel.nodes.count
        candidate: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[candidate_index]
        if candidate.kind == "structural-argument" and candidate.operator == "strict":
            witness_index <- candidate_index
            break
    return false if witness_index >= report.kernel.nodes.count
    witness: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[witness_index]
    return false if witness.kind != "structural-argument"
    # Keep the witness locally well-shaped; only its source subject identity is forged.
    report.kernel.nodes[witness_index] <- ElisaProofKernelCore::ProofKernelNode{kind: witness.kind, operator: witness.operator, left: witness.left, right: witness.right, auxiliary: witness.auxiliary, children_start: witness.children_start, children_count: witness.children_count, value: witness.value, name: "forged_structural_subject", secondary_name: witness.secondary_name}
    (proof_replay_certificates(report) can Global{Read,Write})
    return report.replay_gaps > 0 and not report.certificates[certificate_index].replayed

def api_structural_certificate_binder_tamper(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    certificate_index: mutable usize = report.certificates.count
    for index in 0..<report.certificates.count |index, report, certificate_index|:
        certificate: ProofGoalCertificate = report.certificates[index]
        if certificate.rule == "structural-safety":
            certificate_index <- index
            break
    return false if certificate_index >= report.certificates.count
    certificate: ProofGoalCertificate = report.certificates[certificate_index]
    return false if certificate.kernel_goal >= report.kernel.nodes.count
    root: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[certificate.kernel_goal]
    return false if root.kind != "structural-safety" or root.children_count != 1 or root.children_start >= report.kernel.children.count
    edge_index: usize = report.kernel.children[root.children_start]
    return false if edge_index >= report.kernel.nodes.count
    edge: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[edge_index]
    return false if edge.kind != "structural-edge" or edge.children_count == 0 or edge.children_start > report.kernel.children.count or edge.children_count > report.kernel.children.count - edge.children_start
    witness_index: mutable usize = report.kernel.nodes.count
    for witness_offset in 0..<edge.children_count |witness_offset, edge, report, witness_index|:
        candidate_index: usize = report.kernel.children[edge.children_start + witness_offset]
        return false if candidate_index >= report.kernel.nodes.count
        candidate: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[candidate_index]
        if candidate.kind == "structural-argument" and candidate.operator == "strict":
            witness_index <- candidate_index
            break
    return false if witness_index >= report.kernel.nodes.count
    witness: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[witness_index]
    return false if witness.kind != "structural-argument"
    # Preserve the source subject, rank relation, and identities; forge only the strict-subterm binder.
    report.kernel.nodes[witness_index] <- ElisaProofKernelCore::ProofKernelNode{kind: witness.kind, operator: witness.operator, left: witness.left, right: witness.right, auxiliary: witness.auxiliary, children_start: witness.children_start, children_count: witness.children_count, value: witness.value, name: witness.name, secondary_name: "forged_structural_binder"}
    (proof_replay_certificates(report) can Global{Read,Write})
    return report.replay_gaps > 0 and not report.certificates[certificate_index].replayed

def api_structural_certificate_omission(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    kept: mutable darray[ProofGoalCertificate] = []
    omitted: mutable bool = false
    for certificate in report.certificates |certificate, kept, omitted|:
        if not omitted and certificate.rule == "structural-safety":
            omitted <- true
        else:
            kept.push(certificate)
    return false if not omitted
    report.certificates.clear()
    report.certificates.extend(kept)
    (proof_replay_certificates(report) can Global{Read,Write})
    # Missing evidence must keep the proof incomplete even though the remaining rows replay.
    return report.replay_gaps > 0

def api_structural_ambiguous_owner_source(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    certificate_index: mutable usize = report.certificates.count
    for index in 0..<report.certificates.count |index, report, certificate_index|:
        certificate: ProofGoalCertificate = report.certificates[index]
        if certificate.rule == "structural-safety":
            certificate_index <- index
            break
    return false if certificate_index >= report.certificates.count
    owner: sview = report.certificates[certificate_index].name
    duplicate: mutable Ast::Decl = Ast::Decl.Invalid
    found: mutable bool = false
    for declaration in report.source_declarations |owner, duplicate, found|:
        match declaration:
            Ast::Decl.Func(name, _, _, _, _, _, _):
                if name == owner:
                    duplicate <- declaration
                    found <- true
                    break
            _:
                pass
    return false if not found
    report.source_declarations.push(duplicate)
    (proof_replay_certificates(report) can Global{Read,Write})
    return report.replay_gaps > 0 and not report.certificates[certificate_index].replayed

def api_structural_ambiguous_callee_source(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(UNIQUE_SIBLING_STRUCTURAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    return false if report.structural.verified_names.count == 0
    ambiguous_position: Ast::Pos = Ast::pos_at_line(200)
    duplicate: Ast::Decl = Ast::Decl.Func("sibling_step", [], Ast::Expr.Ident("i64", ambiguous_position), [Ast::Stmt.Return(Ast::Expr.IntLit(1, ambiguous_position), ambiguous_position)], [], [], ambiguous_position)
    report.source_declarations.push(duplicate)
    (proof_replay_certificates(report) can Global{Read,Write})
    return false if report.replay_gaps == 0
    for certificate in report.certificates |certificate|:
        return false if certificate.rule == "structural-safety" and certificate.replayed
    return true

def api_structural_unrelated_ambiguous_declarations(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&, route: usize) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(UNIQUE_SIBLING_STRUCTURAL_API_SOURCE, source, report, diagnostics, route) can Global{Read,Write})
    return false if report.structural.verified_names.count == 0
    duplicate_position: Ast::Pos = Ast::pos_at_line(200)
    duplicate: Ast::Decl = Ast::Decl.Func("unrelated_overload", [], Ast::Expr.Ident("i64", duplicate_position), [], [], [], duplicate_position)
    report.source_declarations.push(duplicate)
    report.source_declarations.push(duplicate)
    (proof_replay_certificates(report) can Global{Read,Write})
    return false if report.replay_gaps != 0
    structural_seen: mutable bool = false
    for certificate in report.certificates |certificate, structural_seen|:
        if certificate.rule == "structural-safety":
            structural_seen <- true
            return false if not certificate.replayed
    return structural_seen

def api_structural_import_declaration_tamper(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    return false if report.structural.verified_names.count == 0
    report.source_declarations.push(Ast::Decl.Import("unresolved_structural_import", Ast::pos_at_line(200)))
    (proof_replay_certificates(report) can Global{Read,Write})
    return false if report.replay_gaps == 0
    for certificate in report.certificates |certificate|:
        return false if certificate.rule == "structural-safety" and certificate.replayed
    return true

def api_structural_import_annotation_tamper(source: mutable darray[u8]&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(MUTUAL_API_SOURCE, source, report, diagnostics, 0) can Global{Read,Write})
    return false if report.structural.verified_names.count == 0
    report.source_annotations.push(Ast::EnumAnnotation{owner: "", name: "__using", line: 200})
    (proof_replay_certificates(report) can Global{Read,Write})
    return false if report.replay_gaps == 0
    for certificate in report.certificates |certificate|:
        return false if certificate.rule == "structural-safety" and certificate.replayed
    return true
