extend ElisaProof:
    public:
        def test_summary_local_binding_source(report: ProofReport&, owner: sview, owner_line: u32, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr) -> bool:
            matches: mutable usize = PROOF_REPLAY_LOCAL_CALL_NO_MATCH
            found: mutable bool = false
            return proof_replay_summary_local_call_declarations(report.source_declarations, owner, owner_line, local_name, binding_position, call, &matches, &found, 0) and found and matches == PROOF_REPLAY_LOCAL_CALL_EXACT_MATCH

        def test_summary_argument_order_replay() -> bool:
            report: mutable ProofReport = proof_empty_report()
            report.executable_parameters.push("first")
            report.executable_parameters.push("second")
            report.traces.summary_names.push("first")
            report.traces.summary_names.push("second")
            position: Ast::Pos = Ast::pos_at_line(1)
            report.traces.summary_values.push(Ast::Expr.Ident("left", position))
            report.traces.summary_values.push(Ast::Expr.Ident("right", position))
            summary: ProofExecutableSummary = ProofExecutableSummary{name: "ordered", line: 1, parameters_start: 0, parameters_count: 2, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: true, verified: true, verification_reason: ""}
            trace: ProofFactTrace = ProofFactTrace{expression: Ast::Expr.Absent, kernel_expression: 0, kind: "function-summary", line: 1, name: "caller", dependency: "ordered", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 3, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 1}
            arguments: darray[Ast::Expr] = [Ast::Expr.Ident("left", position), Ast::Expr.Ident("right", position)]
            argument_names: darray[sview] = ["", ""]
            call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("ordered", position), arguments, argument_names, position)
            return false if not proof_replay_summary_call_arguments_match(&report, trace, summary, call)
            report.traces.summary_values[0] <- Ast::Expr.Ident("right", position)
            report.traces.summary_values[1] <- Ast::Expr.Ident("left", position)
            return not proof_replay_summary_call_arguments_match(&report, trace, summary, call)

        def test_summary_nested_call_span_is_unsupported() -> bool:
            report: mutable ProofReport = proof_empty_report()
            source_position: Ast::Pos = Ast::pos_at_line(10)
            forged_position: Ast::Pos = source_position
            forged_position.line <- forged_position.line + 1
            forged_position.column <- forged_position.column + 1
            forged_position.offset <- forged_position.offset + 1
            forged_position.end_line <- forged_position.end_line + 1
            forged_position.end_column <- forged_position.end_column + 1
            forged_position.end_offset <- forged_position.end_offset + 1
            source_inner_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("tick", source_position), [], [], source_position)
            forged_inner_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("tick", forged_position), [], [], forged_position)
            report.traces.summary_values.push(forged_inner_call)
            summary: ProofExecutableSummary = ProofExecutableSummary{name: "wrap", line: 1, parameters_start: 0, parameters_count: 1, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 1, pure: true, verified: true, verification_reason: ""}
            trace: ProofFactTrace = ProofFactTrace{expression: Ast::Expr.Absent, kernel_expression: 0, kind: "function-summary", line: 10, name: "caller", dependency: "wrap", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 2, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 1}
            call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("wrap", source_position), [source_inner_call], [""], source_position)
            return not proof_replay_summary_call_arguments_match(&report, trace, summary, call)

        def test_deterministic_nested_call_span_is_unsupported() -> bool:
            outer_position: Ast::Pos = Ast::pos_at_line(20)
            inner_position: Ast::Pos = Ast::pos_at_line(21)
            forged_inner_position: Ast::Pos = inner_position
            forged_inner_position.line <- forged_inner_position.line + 1
            forged_inner_position.column <- forged_inner_position.column + 1
            forged_inner_position.offset <- forged_inner_position.offset + 1
            forged_inner_position.end_line <- forged_inner_position.end_line + 1
            forged_inner_position.end_column <- forged_inner_position.end_column + 1
            forged_inner_position.end_offset <- forged_inner_position.end_offset + 1
            source_inner: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("tick", inner_position), [], [], inner_position)
            forged_inner: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("tick", forged_inner_position), [], [], forged_inner_position)
            source_outer: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("keep", outer_position), [source_inner], [""], outer_position)
            forged_outer: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("keep", outer_position), [forged_inner], [""], outer_position)
            # Same outer call span/callee and same-shaped nested call; this must reach and be
            # refused by proof_replay_deterministic_call_arguments_equal.
            return not proof_replay_deterministic_call_expression_equal(source_outer, forged_outer)

        def test_deterministic_source_rejects_shadow_and_join() -> bool:
            position: Ast::Pos = Ast::pos_at_line(2)
            arguments: darray[Ast::Expr] = []
            names: darray[sview] = []
            callback_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("callback", position), arguments, names, position)
            bound_names: mutable darray[sview] = ["callback"]
            bound_values: mutable darray[Ast::Expr] = [Ast::Expr.Absent]
            return false if proof_replay_deterministic_call_source_expression(callback_call, callback_call, &bound_names, &bound_values)
            qualified_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Scope(Ast::Expr.Ident("Namespace", position), "callback", position), arguments, names, position)
            namespace_names: mutable darray[sview] = ["Namespace"]
            namespace_values: mutable darray[Ast::Expr] = [Ast::Expr.Absent]
            return false if proof_replay_deterministic_call_source_expression(qualified_call, qualified_call, &namespace_names, &namespace_values)

            body: mutable darray[Ast::Stmt] = []
            branch_write: Ast::Stmt = Ast::Stmt.Assign(Ast::Expr.Ident("value", Ast::pos_at_line(1)), TokenKind.Assign, Ast::Expr.IntLit(1, Ast::pos_at_line(1)), Ast::pos_at_line(1))
            body.push(Ast::Stmt.If(Ast::Expr.BoolLit(true, Ast::pos_at_line(1)), [branch_write], [], Ast::pos_at_line(1)))
            body.push(Ast::Stmt.Expr(callback_call, position))
            empty_names: mutable darray[sview] = ["value"]
            empty_values: mutable darray[Ast::Expr] = [Ast::Expr.IntLit(0, Ast::pos_at_line(1))]
            return false if not proof_replay_deterministic_call_source_expression(callback_call, callback_call, &empty_names, &empty_values)
            source_walk: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(&body, callback_call, 10, &empty_names, &empty_values, 0)
            return not source_walk.known

        def test_trace_with_expression(original: ProofFactTrace, expression: Ast::Expr) -> ProofFactTrace:
            return ProofFactTrace{expression: expression, kernel_expression: original.kernel_expression, kind: original.kind, line: original.line, name: original.name, dependency: original.dependency, premises_start: original.premises_start, premises_count: original.premises_count, kernel_premises_start: original.kernel_premises_start, kernel_premises_count: original.kernel_premises_count, summary_bindings_start: original.summary_bindings_start, summary_bindings_count: original.summary_bindings_count, summary_requires_start: original.summary_requires_start, summary_requires_count: original.summary_requires_count, summary_ensure_index: original.summary_ensure_index, owner_line: original.owner_line}

        def test_call_result_binding_replay() -> i64:
            text: sview = "def ordered_call(first: u8, second: u8) -> u8:\n    ensure result == first\n    return first\n\ndef call_result_owner(first: u8, second: u8) -> u8:\n    requires first <= 10\n    requires second <= 10\n    ensure result == first\n    answer: u8 = ordered_call(first, second)\n    return answer\n"
            source: mutable darray[u8] = []
            for index in 0..<sview_len(text) |index, text, source|:
                source.push(sview_at(text, index))
            source.push(0)
            file: Ast::File = frontend_parse(&source[0])
            report: mutable ProofReport = proof_empty_report()
            proof_check(file, &report)
            proof_replay_certificates(&report)
            owner: (found: bool, line: u32) = test_owner_function_line(report.source_declarations, "call_result_owner", 0)
            return 1 if not owner.found
            trace_index: mutable usize = report.traces.records.count
            for index in 0..<report.traces.records.count |index, report, trace_index|:
                trace: ProofFactTrace = report.traces.records[index]
                continue if trace.kind != "local-binding" or trace.name != "call_result_owner"
                match trace.expression:
                    Ast::Expr.Binary(Ast::Expr.Ident("answer", _), TokenKind.EqEq, Ast::Expr.Call(_, _, _, _), _):
                        trace_index <- index
                        break
                    _:
                        pass
            return 2 if trace_index >= report.traces.records.count
            original: ProofFactTrace = report.traces.records[trace_index]
            certificate_line: mutable u32 = 0
            for certificate in report.certificates |certificate, original, certificate_line|:
                certificate_line <- certificate.line if certificate.name == original.name and certificate.rule == "goal" and certificate.line > original.line
            return 3 if certificate_line == 0
            report.replay_owner_line <- owner.line
            report.trace_owner_line <- certificate_line
            return 4 if not proof_replay_call_result_binding_valid(report, original)
            match original.expression:
                Ast::Expr.Binary(left, TokenKind.EqEq, Ast::Expr.Call(callee, arguments, argument_names, call_position), binding_position):
                    report.trace_owner_line <- original.line
                    statement_site_valid: bool = proof_replay_deterministic_call_source_site(report, original, Ast::Expr.Call(callee, arguments, argument_names, call_position))
                    future_position: Ast::Pos = call_position
                    future_position.line <- future_position.line + 1
                    future_position.offset <- future_position.offset + 1
                    future_position.end_line <- future_position.end_line + 1
                    future_position.end_offset <- future_position.end_offset + 1
                    future_site_refused: bool = not proof_replay_deterministic_call_source_site(report, original, Ast::Expr.Call(callee, arguments, argument_names, future_position))
                    report.trace_owner_line <- certificate_line
                    return 11 if not statement_site_valid or not future_site_refused
                    forged_position: Ast::Pos = call_position
                    forged_position.offset <- forged_position.offset + 1
                    forged_position.end_offset <- forged_position.end_offset + 1
                    forged_call: Ast::Expr = Ast::Expr.Call(callee, arguments, argument_names, forged_position)
                    forged_span: ProofFactTrace = test_trace_with_expression(original, Ast::Expr.Binary(left, TokenKind.EqEq, forged_call, binding_position))
                    return 5 if proof_replay_call_result_binding_valid(report, forged_span)
                    return 6 if arguments.count != 2
                    reversed_arguments: darray[Ast::Expr] = [arguments[1], arguments[0]]
                    reordered_call: Ast::Expr = Ast::Expr.Call(callee, reversed_arguments, argument_names, call_position)
                    forged_order: ProofFactTrace = test_trace_with_expression(original, Ast::Expr.Binary(left, TokenKind.EqEq, reordered_call, binding_position))
                    return 7 if proof_replay_call_result_binding_valid(report, forged_order)
                _:
                    return 8
            saved_declarations: darray[Ast::Decl] = report.source_declarations
            overload_text: sview = "extern ordered_call(first: i64, second: i64) -> u8\n"
            overload_source: mutable darray[u8] = []
            for index in 0..<sview_len(overload_text) |index, overload_text, overload_source|:
                overload_source.push(sview_at(overload_text, index))
            overload_source.push(0)
            overload_file: Ast::File = frontend_parse(&overload_source[0])
            report.source_declarations.extend(overload_file.top_decls)
            overload_refused: bool = not proof_replay_call_result_binding_valid(report, original)
            report.source_declarations <- saved_declarations
            return 9 if not overload_refused
            report.source_declarations.push(Ast::Decl.Import("unresolved_call_api.elisa", Ast::pos_at_line(original.line)))
            import_refused: bool = not proof_replay_call_result_binding_valid(report, original)
            report.source_declarations <- saved_declarations
            return 10 if not import_refused
            return 0

        def test_summary_source_call_known(report: ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary) -> bool:
            return proof_replay_summary_source_call(report, trace, summary).known

        def test_summary_source_call(report: ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary) -> (known: bool, call: Ast::Expr):
            return proof_replay_summary_source_call(report, trace, summary)

        def test_chained_summary_replay_stages() -> i64:
            text: sview = "def domain_status(value: bool) -> u8:\n    ensure result <= 9\n    return 9 if value\n    return 0\n\ndef domain_choice(status: u8) -> u8:\n    ensure result >= 0\n    return status\n\ndef caller(value: bool) -> u8:\n    ensure result >= 0\n    status: u8 = domain_status(value)\n    return domain_choice(status)\n"
            source: mutable darray[u8] = []
            for index in 0..<sview_len(text) |index, text, source|:
                source.push(sview_at(text, index))
            source.push(0)
            file: Ast::File = frontend_parse(&source[0])
            report: mutable ProofReport = proof_empty_report()
            proof_check(file, &report)
            proof_replay_certificates(&report)
            owner: (found: bool, line: u32) = test_owner_function_line(report.source_declarations, "caller", 0)
            return 1 if not owner.found
            for trace in report.traces.records |trace, report, owner|:
                continue if trace.kind != "function-summary" or trace.name != "caller" or trace.dependency != "domain_choice"
                summary: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
                found_summary: mutable bool = false
                for candidate in report.executable_summaries |candidate, summary, found_summary, trace|:
                    if candidate.name == trace.dependency and candidate.line == trace.owner_line:
                        summary <- candidate
                        found_summary <- true
                return 2 if not found_summary
                report.replay_owner_line <- owner.line
                report.trace_owner_line <- trace.line
                source_call: (known: bool, call: Ast::Expr) = proof_replay_summary_source_call(&report, trace, summary)
                return 3 if not source_call.known
                return 4 if not proof_replay_deterministic_call_source_site(report, trace, source_call.call)
                return 5 if not proof_replay_summary_call_arguments_match(&report, trace, summary, source_call.call)
                match source_call.call:
                    Ast::Expr.Call(callee, _, _, _):
                        return 6 if not proof_replay_summary_owner_matches_call(report, trace, summary, callee)
                    _:
                        return 7
                return 0
            return 8

        def test_local_summary_expression(report: ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, local_name: sview, local_position: Ast::Pos) -> (known: bool, expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if trace.summary_ensure_index >= summary.ensures_count
            parameter_names: mutable darray[sview] = []
            parameter_values: mutable darray[Ast::Expr] = []
            for offset in 0..<summary.parameters_count |offset, report, trace, parameter_names, parameter_values|:
                parameter_names.push(report.traces.summary_names[trace.summary_bindings_start + offset])
                parameter_values.push(report.traces.summary_values[trace.summary_bindings_start + offset])
            expression: mutable Ast::Expr = report.executable_ensures[summary.ensures_start + trace.summary_ensure_index]
            expression <- proof_replay_substitute_many(expression, parameter_names, parameter_values)
            expression <- proof_replay_substitute(expression, "result", Ast::Expr.Ident(local_name, local_position))
            return (not proof_replay_expr_is_invalid(expression), expression)

        def test_forged_local_call_result_refused(report: mutable ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, owner_line: u32, local_name: sview, local_position: Ast::Pos) -> bool:
            return false if trace.summary_bindings_start > report.traces.summary_values.count or trace.summary_bindings_count > report.traces.summary_values.count - trace.summary_bindings_start
            return false if trace.summary_bindings_start > report.traces.summary_names.count or trace.summary_bindings_count > report.traces.summary_names.count - trace.summary_bindings_start
            return false if summary.parameters_count >= trace.summary_bindings_count
            return false if report.traces.summary_names.count != report.traces.summary_values.count
            local_result: (known: bool, expression: Ast::Expr) = test_local_summary_expression(report, trace, summary, local_name, local_position)
            return false if not local_result.known
            encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(local_result.expression, report, trace.name)
            return false if not encoded.known
            binding_start: usize = report.traces.summary_values.count
            for offset in 0..<trace.summary_bindings_count |offset, report, trace, binding_start|:
                source_binding: usize = trace.summary_bindings_start + offset
                report.traces.summary_names.push(report.traces.summary_names[source_binding])
                report.traces.summary_values.push(report.traces.summary_values[source_binding])
            report.traces.summary_values[binding_start + summary.parameters_count] <- Ast::Expr.Ident(local_name, local_position)
            forged_trace: ProofFactTrace = ProofFactTrace{expression: local_result.expression, kernel_expression: encoded.root, kind: trace.kind, line: trace.line, name: trace.name, dependency: trace.dependency, premises_start: trace.premises_start, premises_count: trace.premises_count, kernel_premises_start: trace.kernel_premises_start, kernel_premises_count: trace.kernel_premises_count, summary_bindings_start: binding_start, summary_bindings_count: trace.summary_bindings_count, summary_requires_start: trace.summary_requires_start, summary_requires_count: trace.summary_requires_count, summary_ensure_index: trace.summary_ensure_index, owner_line: trace.owner_line}
            report.replay_owner_line <- owner_line
            report.traces.records.push(forged_trace)
            return not proof_replay_fact_trace_entry(report, report.traces.records.count - 1)

        def test_literal_call_binding_replay() -> i64:
            source_text: sview = "def signed_identity(value: i64) -> i64:\n    requires value >= 0\n    ensure result == value\n    return value\n\ndef literal_argument_owner() -> i64:\n    return 1 if signed_identity(7) != 7\n    return 0\n"
            source: mutable darray[u8] = []
            for index in 0..<sview_len(source_text) |index, source_text, source|:
                source.push(sview_at(source_text, index))
            source.push(0)
            file: Ast::File = frontend_parse(&source[0])
            report: mutable ProofReport = proof_empty_report()
            proof_check(file, &report)
            proof_replay_certificates(&report)
            return 11 if report.replay_gaps != 0
            owner: (found: bool, line: u32) = test_owner_function_line(report.source_declarations, "literal_argument_owner", 0)
            return 2 if not owner.found
            saved_owner_line: u32 = report.replay_owner_line
            saved_trace_line: u32 = report.trace_owner_line
            found_binding: mutable bool = false
            accepted_forgery: mutable bool = false
            for index in 0..<report.traces.records.count |index, report, owner, saved_owner_line, saved_trace_line, found_binding, accepted_forgery|:
                trace: ProofFactTrace = report.traces.records[index]
                continue if trace.kind != "local-binding" or trace.name != "literal_argument_owner"
                match trace.expression:
                    Ast::Expr.Binary(Ast::Expr.Ident(symbol, _), TokenKind.EqEq, Ast::Expr.IntLit(value, literal_position), expression_position):
                        continue if proof_replay_literal_binding_symbol_index(symbol) >= PROOF_INTERNAL_REBIND_SYMBOL_COUNT
                        report.replay_owner_line <- owner.line
                        report.trace_owner_line <- trace.line
                        if not proof_replay_literal_call_argument_binding_valid(report, trace):
                            report.replay_owner_line <- saved_owner_line
                            report.trace_owner_line <- saved_trace_line
                            return 3
                        forged_expression: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident(symbol, Ast::expr_pos(trace.expression)), TokenKind.EqEq, Ast::Expr.IntLit(value + 1, literal_position), expression_position)
                        forged_trace: ProofFactTrace = ProofFactTrace{expression: forged_expression, kernel_expression: trace.kernel_expression, kind: trace.kind, line: trace.line, name: trace.name, dependency: trace.dependency, premises_start: trace.premises_start, premises_count: trace.premises_count, kernel_premises_start: trace.kernel_premises_start, kernel_premises_count: trace.kernel_premises_count, summary_bindings_start: trace.summary_bindings_start, summary_bindings_count: trace.summary_bindings_count, summary_requires_start: trace.summary_requires_start, summary_requires_count: trace.summary_requires_count, summary_ensure_index: trace.summary_ensure_index, owner_line: trace.owner_line}
                        report.traces.records[index] <- forged_trace
                        accepted_forgery <- proof_replay_literal_call_argument_binding_valid(report, forged_trace)
                        report.traces.records[index] <- trace
                        found_binding <- true
                        report.replay_owner_line <- saved_owner_line
                        report.trace_owner_line <- saved_trace_line
                        break
                    _:
                        pass
            report.replay_owner_line <- saved_owner_line
            report.trace_owner_line <- saved_trace_line
            return 4 if accepted_forgery
            return 0 if found_binding
            return 5

        def test_owner_function_line(declarations: darray[Ast::Decl]&, owner: sview, depth: usize) -> (found: bool, line: u32):
            return (false, 0) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for declaration in declarations |owner, depth|:
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, position):
                        return (true, position.line) if name == owner
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        nested_result: (found: bool, line: u32) = test_owner_function_line(nested, owner, depth + 1)
                        return nested_result if nested_result.found
                    _:
                        pass
            return (false, 0)

        def test_source_has_import_declaration(declarations: darray[Ast::Decl]&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for declaration in declarations |depth|:
                match declaration:
                    Ast::Decl.Import(_, _):
                        return true
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if test_source_has_import_declaration(nested, depth + 1)
                    _:
                        pass
            return false

        def test_first_direct_summary_call(report: ProofReport&, owner: sview, dependency: sview, parameter_count: usize) -> (found: bool, trace_index: usize, call: Ast::Expr):
            selected: mutable usize = report.traces.records.count
            first_line: mutable u32 = 0
            selected_call: mutable Ast::Expr = Ast::Expr.Invalid
            for index in 0..<report.traces.records.count |index, report, owner, dependency, parameter_count, selected, first_line, selected_call|:
                trace: ProofFactTrace = report.traces.records[index]
                continue if trace.kind != "function-summary" or trace.name != owner or trace.dependency != dependency
                continue if trace.summary_bindings_start > report.traces.summary_values.count or parameter_count >= trace.summary_bindings_count or parameter_count >= report.traces.summary_values.count - trace.summary_bindings_start
                result_value: Ast::Expr = report.traces.summary_values[trace.summary_bindings_start + parameter_count]
                match result_value:
                    Ast::Expr.Call(_, _, _, _):
                        if selected >= report.traces.records.count or trace.line < first_line:
                            selected <- index
                            first_line <- trace.line
                            selected_call <- result_value
                    Ast::Expr.Paren(inner, _):
                        if proof_replay_is_call(inner) and (selected >= report.traces.records.count or trace.line < first_line):
                            selected <- index
                            first_line <- trace.line
                            selected_call <- inner
                    _:
                        pass
            return (selected < report.traces.records.count, selected, selected_call)

        def test_owner_has_unproven_goal(report: ProofReport&, owner: sview) -> bool:
            for attempt in report.goal_attempts |attempt, owner|:
                return true if attempt.name == owner and not attempt.proven
            return false

        def test_owner_goals_all_proven(report: ProofReport&, owner: sview) -> bool:
            found: mutable bool = false
            for attempt in report.goal_attempts |attempt, owner, found|:
                if attempt.name == owner:
                    return false if not attempt.proven
                    found <- true
            return found

        def test_summary_overload_is_unsupported(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return not proof_replay_summary_overload_is_unique(report, trace)

        def test_owner_summary_trace_replay_status(report: mutable ProofReport&, owner: sview, dependency: sview, owner_line: u32, minimum_count: usize) -> usize:
            report.replay_owner_line <- owner_line
            matched: mutable usize = 0
            for index in 0..<report.traces.records.count |index, report, owner, dependency, matched|:
                trace: ProofFactTrace = report.traces.records[index]
                continue if trace.kind != "function-summary" or trace.name != owner or trace.dependency != dependency
                summary: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
                summary_found: mutable bool = false
                for candidate in report.executable_summaries |candidate, trace, summary, summary_found|:
                    if candidate.name == dependency and candidate.line == trace.owner_line:
                        summary <- candidate
                        summary_found <- true
                return 1 if not summary_found
                return 2 if not proof_replay_summary_overload_is_unique(report, trace)
                source_call: (known: bool, call: Ast::Expr) = proof_replay_summary_source_call(report, trace, summary)
                return 3 if not source_call.known
                return 4 if not proof_replay_deterministic_call_source_site(report, trace, source_call.call)
                if not proof_replay_summary_call_arguments_match(report, trace, summary, source_call.call):
                    return 8 if proof_replay_fact_trace_entry(report, index)
                    return 5
                match source_call.call:
                    Ast::Expr.Call(callee, _, _, _):
                        return 6 if not proof_replay_summary_owner_matches_call(report, trace, summary, callee)
                    _:
                        return 7
                matched <- matched + 1
                return 8 if not proof_replay_fact_trace_entry(report, index)
            return 0 if matched >= minimum_count else 9

        def test_owner_summary_trace_count(report: ProofReport&, owner: sview, dependency: sview) -> usize:
            count: mutable usize = 0
            for trace in report.traces.records |trace, owner, dependency, count|:
                count <- count + 1 if trace.kind == "function-summary" and trace.name == owner and trace.dependency == dependency
            return count

        def test_local_return_position(body: darray[Ast::Stmt]&, local_name: sview) -> (found: bool, position: Ast::Pos):
            for statement in body |local_name|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        match value:
                            Ast::Expr.Ident(name, source_position) if name == local_name:
                                return (true, source_position)
                    Ast::Stmt.If(_, yes, no, _):
                        yes_result: (found: bool, position: Ast::Pos) = test_local_return_position(yes, local_name)
                        return yes_result if yes_result.found
                        no_result: (found: bool, position: Ast::Pos) = test_local_return_position(no, local_name)
                        return no_result if no_result.found
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |arm, local_name|:
                            arm_result: (found: bool, position: Ast::Pos) = test_local_return_position(arm.body, local_name)
                            return arm_result if arm_result.found
                    _:
                        pass
            return (false, Ast::pos_at_line(0))

        def test_local_return_position_declarations(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, local_name: sview, position: mutable Ast::Pos&, found: mutable bool&, depth: usize) -> bool:
            return false if depth >= 96
            for declaration in declarations |owner, owner_line, local_name, position, found, depth|:
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, function_position):
                        if name == owner and (owner_line == 0 or function_position.line == owner_line):
                            result: (found: bool, position: Ast::Pos) = test_local_return_position(body, local_name)
                            position <- result.position
                            found <- result.found
                            return true
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not test_local_return_position_declarations(nested, owner, owner_line, local_name, position, found, depth + 1)
                    _:
                        pass
            return true
