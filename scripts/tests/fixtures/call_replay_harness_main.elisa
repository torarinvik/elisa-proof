using Ast
using ElisaProof

const FORGED_LOCAL_BINDING_VALUE: i64 = 987654321
const FORGED_LOCAL_BINDING_ENCODING_FAILED: i64 = 25
const FORGED_LOCAL_BINDING_ACCEPTED: i64 = 26

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 34 if not test_summary_argument_order_replay()
    return 92 if not test_summary_nested_call_span_is_unsupported()
    return 93 if not test_deterministic_nested_call_span_is_unsupported()
    return 99 if not test_deterministic_source_rejects_shadow_and_join()
    chained_summary_stage: i64 = test_chained_summary_replay_stages()
    return 130 + chained_summary_stage if chained_summary_stage != 0
    call_result_binding_status: i64 = test_call_result_binding_replay()
    return 110 + call_result_binding_status if call_result_binding_status != 0
    literal_binding_status: i64 = test_literal_call_binding_replay()
    return 105 + literal_binding_status if literal_binding_status != 0
    text: sview = "module Gate:\n    module Inner:\n        public:\n            def bounded(x: i64) -> i64:\n                requires x >= 0\n                ensure result >= 0\n                return x\n\nmodule Elsewhere:\n    module Inner:\n        public:\n            def unrelated(x: i64) -> i64:\n                return x\n\ndef caller(x: i64) -> i64:\n    requires x >= 0\n    ensure result >= 0\n    return Gate::Inner::bounded(x)\n\ndef caller_local(x: i64) -> i64:\n    requires x >= 0\n    ensure result >= 0\n    result_value: i64 = Gate::Inner::bounded(x)\n    return result_value\n\ndef caller_guard(x: i64) -> i64:\n    requires x >= 0\n    ensure result >= 0\n    return 1 if Gate::Inner::bounded(x) < 0\n    return 0\n"
    source: mutable darray[u8] = []
    for index in 0..<sview_len(text) |index, text, source|:
        source.push(sview_at(text, index))
    source.push(0)
    file: Ast::File = frontend_parse(&source[0])
    report: mutable ProofReport = proof_empty_report()
    proof_check(file, &report)
    proof_replay_certificates(&report)

    summary_index: mutable usize = report.traces.records.count
    for index in 0..<report.traces.records.count |index, report, summary_index|:
        if report.traces.records[index].kind == "function-summary" and report.traces.records[index].name == "caller" and report.traces.records[index].dependency == "bounded":
            summary_index <- index
            break
    return 9 if summary_index >= report.traces.records.count
    summary_original: ProofFactTrace = report.traces.records[summary_index]
    return 10 if not proof_replay_fact_trace_entry(&report, summary_index)

    guard_trace_index: mutable usize = report.traces.records.count
    for index in 0..<report.traces.records.count |index, report, guard_trace_index|:
        candidate: ProofFactTrace = report.traces.records[index]
        if candidate.kind == "function-summary" and candidate.name == "caller_guard" and candidate.dependency == "bounded":
            guard_trace_index <- index
            break
    return 43 if guard_trace_index >= report.traces.records.count
    report.replay_owner_line <- 26
    return 44 if not proof_replay_fact_trace_entry(&report, guard_trace_index)
    report.replay_owner_line <- 15
    summary_result_index: mutable usize = summary_original.summary_bindings_start
    for offset in 0..<summary_original.summary_bindings_count |offset, summary_original, report, summary_result_index|:
        summary_result_index <- summary_original.summary_bindings_start + offset if report.traces.summary_names[summary_original.summary_bindings_start + offset] == "result"
    return 11 if summary_result_index == summary_original.summary_bindings_start
    summary_result_original: Ast::Expr = report.traces.summary_values[summary_result_index]
    forged_summary_result: mutable Ast::Expr = Ast::Expr.Invalid
    match summary_result_original:
        Ast::Expr.Call(_, call_arguments, call_names, call_position):
            wrong_module: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("Elsewhere", call_position), "Inner", call_position)
            forged_callee: Ast::Expr = Ast::Expr.Scope(wrong_module, "bounded", call_position)
            forged_summary_result <- Ast::Expr.Call(forged_callee, call_arguments, call_names, call_position)
        _:
            return 15
    forged_owner_summary: Ast::Expr = Ast::Expr.Binary(forged_summary_result, TokenKind.GtEq, Ast::Expr.IntLit(0, Ast::expr_pos(summary_original.expression)), Ast::expr_pos(summary_original.expression))
    forged_owner_encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(forged_owner_summary, &report, summary_original.name)
    return 16 if not forged_owner_encoded.known
    report.traces.summary_values[summary_result_index] <- forged_summary_result
    report.traces.records[summary_index] <- ProofFactTrace{expression: forged_owner_summary, kernel_expression: forged_owner_encoded.root, kind: summary_original.kind, line: summary_original.line, name: summary_original.name, dependency: summary_original.dependency, premises_start: summary_original.premises_start, premises_count: summary_original.premises_count, kernel_premises_start: summary_original.kernel_premises_start, kernel_premises_count: summary_original.kernel_premises_count, summary_bindings_start: summary_original.summary_bindings_start, summary_bindings_count: summary_original.summary_bindings_count, summary_requires_start: summary_original.summary_requires_start, summary_requires_count: summary_original.summary_requires_count, summary_ensure_index: summary_original.summary_ensure_index, owner_line: summary_original.owner_line}
    return 17 if proof_replay_fact_trace_entry(&report, summary_index)
    report.traces.records[summary_index] <- summary_original
    report.traces.summary_values[summary_result_index] <- summary_result_original
    return 18 if not proof_replay_fact_trace_entry(&report, summary_index)

    report.traces.summary_values[summary_result_index] <- Ast::Expr.IntLit(0, Ast::expr_pos(summary_original.expression))
    forged_summary: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, Ast::expr_pos(summary_original.expression)), TokenKind.GtEq, Ast::Expr.IntLit(0, Ast::expr_pos(summary_original.expression)), Ast::expr_pos(summary_original.expression))
    summary_encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(forged_summary, &report, summary_original.name)
    return 12 if not summary_encoded.known
    report.traces.records[summary_index] <- ProofFactTrace{expression: forged_summary, kernel_expression: summary_encoded.root, kind: summary_original.kind, line: summary_original.line, name: summary_original.name, dependency: summary_original.dependency, premises_start: summary_original.premises_start, premises_count: summary_original.premises_count, kernel_premises_start: summary_original.kernel_premises_start, kernel_premises_count: summary_original.kernel_premises_count, summary_bindings_start: summary_original.summary_bindings_start, summary_bindings_count: summary_original.summary_bindings_count, summary_requires_start: summary_original.summary_requires_start, summary_requires_count: summary_original.summary_requires_count, summary_ensure_index: summary_original.summary_ensure_index, owner_line: summary_original.owner_line}
    return 13 if proof_replay_fact_trace_entry(&report, summary_index)
    report.traces.records[summary_index] <- summary_original
    report.traces.summary_values[summary_result_index] <- summary_result_original
    return 14 if not proof_replay_fact_trace_entry(&report, summary_index)

    local_trace_index: mutable usize = report.traces.records.count
    for index in 0..<report.traces.records.count |index, report, local_trace_index|:
        candidate: ProofFactTrace = report.traces.records[index]
        continue if candidate.kind != "function-summary" or candidate.name != "caller_local" or candidate.dependency != "bounded"
        local_trace_index <- index
    return 19 if local_trace_index >= report.traces.records.count
    local_trace: ProofFactTrace = report.traces.records[local_trace_index]
    local_result_index: usize = local_trace.summary_bindings_start + 1
    return 20 if local_result_index >= report.traces.summary_values.count
    local_call: mutable Ast::Expr = report.traces.summary_values[local_result_index]
    match local_call:
        Ast::Expr.Paren(inner, _):
            local_call <- inner
        _:
            pass
    local_binding_position: mutable Ast::Pos = Ast::pos_at_line(24)
    local_binding_found: mutable bool = false
    return 21 if not test_local_return_position_declarations(report.source_declarations, "caller_local", 20, "result_value", &local_binding_position, &local_binding_found, 0)
    return 22 if not local_binding_found
    return 23 if not test_summary_local_binding_source(&report, "caller_local", 20, "result_value", local_binding_position, local_call)
    return 24 if test_summary_local_binding_source(&report, "caller_local", 20, "wrong_local", local_binding_position, local_call)
    summary_argument_index: usize = summary_original.summary_bindings_start
    summary_argument_original: Ast::Expr = report.traces.summary_values[summary_argument_index]
    report.traces.summary_values[summary_argument_index] <- Ast::Expr.IntLit(0, Ast::expr_pos(summary_original.expression))
    return 25 if proof_replay_fact_trace_entry(&report, summary_index)
    report.traces.summary_values[summary_argument_index] <- summary_argument_original
    return 26 if not proof_replay_fact_trace_entry(&report, summary_index)

    assignment_text: sview = "def assignment_add_one(x: i64) -> i64:\n    requires x >= 0\n    ensure result == x + 1\n    return x + 1\n\ndef assignment_rhs_state(x: i64) -> i64:\n    requires x >= 0\n    ensure result == x + 1\n    value: mutable i64 = x\n    value <- assignment_add_one(value)\n    return value\n"
    assignment_source: mutable darray[u8] = []
    for index in 0..<sview_len(assignment_text) |index, assignment_text, assignment_source|:
        assignment_source.push(sview_at(assignment_text, index))
    assignment_source.push(0)
    assignment_file: Ast::File = frontend_parse(&assignment_source[0])
    assignment_report: mutable ProofReport = proof_empty_report()
    proof_check(assignment_file, &assignment_report)
    proof_replay_certificates(&assignment_report)
    return 59 if assignment_report.replay_gaps != 0
    return 68 if not test_owner_goals_all_proven(&assignment_report, "assignment_rhs_state")
    assignment_trace_index: mutable usize = assignment_report.traces.records.count
    for index in 0..<assignment_report.traces.records.count |index, assignment_report, assignment_trace_index|:
        candidate: ProofFactTrace = assignment_report.traces.records[index]
        if candidate.kind == "function-summary" and candidate.name == "assignment_rhs_state" and candidate.dependency == "assignment_add_one":
            assignment_trace_index <- index
            break
    return 35 if assignment_trace_index >= assignment_report.traces.records.count
    assignment_report.replay_owner_line <- 6
    return 36 if not proof_replay_fact_trace_entry(&assignment_report, assignment_trace_index)
    reassigned_text: sview = "def assignment_add_one(x: i64) -> i64:\n    requires x >= 0\n    ensure result == x + 1\n    return x + 1\n\ndef assignment_rhs_state(x: i64) -> i64:\n    requires x >= 0\n    ensure result == x + 1\n    value: mutable i64 = x\n    value <- assignment_add_one(value)\n    value <- 0\n    return value\n"
    reassigned_source: mutable darray[u8] = []
    for index in 0..<sview_len(reassigned_text) |index, reassigned_text, reassigned_source|:
        reassigned_source.push(sview_at(reassigned_text, index))
    reassigned_source.push(0)
    reassigned_file: Ast::File = frontend_parse(&reassigned_source[0])
    reassigned_position: mutable Ast::Pos = Ast::pos_at_line(12)
    reassigned_return_found: mutable bool = false
    return 37 if not test_local_return_position_declarations(reassigned_file.top_decls, "assignment_rhs_state", 6, "value", &reassigned_position, &reassigned_return_found, 0)
    return 38 if not reassigned_return_found
    assignment_trace: ProofFactTrace = assignment_report.traces.records[assignment_trace_index]
    assignment_summary: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
    assignment_summary_found: mutable bool = false
    for candidate in assignment_report.executable_summaries |candidate, assignment_trace, assignment_summary_found, assignment_summary|:
        if candidate.name == "assignment_add_one" and candidate.line == assignment_trace.owner_line:
            assignment_summary <- candidate
            assignment_summary_found <- true
    return 39 if not assignment_summary_found
    assignment_call: (known: bool, call: Ast::Expr) = test_summary_source_call(&assignment_report, assignment_trace, assignment_summary)
    return 40 if not assignment_call.known
    return 41 if test_summary_local_binding_source(&assignment_report, "assignment_rhs_state", 6, "value", reassigned_position, assignment_call.call)

    stale_call_text: sview = "def replay_identity(x: i64) -> i64:\n    requires x >= 0\n    ensure result == x\n    return x\n\ndef stale_call_to_call() -> i64:\n    ensure result == 1\n    value: mutable i64 = replay_identity(1)\n    value <- replay_identity(2)\n    return value\n\ndef stale_branch_join(flag: bool) -> i64:\n    ensure result == 1\n    value: mutable i64 = replay_identity(1)\n    if flag:\n        value <- replay_identity(2)\n    return value\n\ndef stale_if_return(flag: bool) -> i64:\n    ensure result == 1\n    value: mutable i64 = replay_identity(1)\n    if flag:\n        return value\n    value <- replay_identity(2)\n    return value\n\ndef stale_match_join(flag: bool) -> i64:\n    ensure result == 1\n    value: mutable i64 = replay_identity(1)\n    match flag:\n        true:\n            return value\n        false:\n            value <- replay_identity(2)\n            return value\n"
    stale_call_source: mutable darray[u8] = []
    for index in 0..<sview_len(stale_call_text) |index, stale_call_text, stale_call_source|:
        stale_call_source.push(sview_at(stale_call_text, index))
    stale_call_source.push(0)
    stale_call_file: Ast::File = frontend_parse(&stale_call_source[0])
    stale_call_report: mutable ProofReport = proof_empty_report()
    proof_check(stale_call_file, &stale_call_report)
    proof_replay_certificates(&stale_call_report)
    return 42 if not test_owner_has_unproven_goal(&stale_call_report, "stale_call_to_call")
    return 43 if not test_owner_has_unproven_goal(&stale_call_report, "stale_branch_join")
    return 86 if not test_owner_has_unproven_goal(&stale_call_report, "stale_if_return")
    return 76 if not test_owner_has_unproven_goal(&stale_call_report, "stale_match_join")

    stale_call_function: (found: bool, line: u32) = test_owner_function_line(stale_call_report.source_declarations, "stale_call_to_call", 0)
    stale_use_position: mutable Ast::Pos = Ast::pos_at_line(0)
    stale_use_found: mutable bool = false
    return 44 if not stale_call_function.found
    return 45 if not test_local_return_position_declarations(stale_call_report.source_declarations, "stale_call_to_call", stale_call_function.line, "value", &stale_use_position, &stale_use_found, 0)
    return 46 if not stale_use_found
    stale_first: (found: bool, trace_index: usize, call: Ast::Expr) = test_first_direct_summary_call(&stale_call_report, "stale_call_to_call", "replay_identity", 1)
    return 47 if not stale_first.found
    return 48 if test_summary_local_binding_source(&stale_call_report, "stale_call_to_call", stale_call_function.line, "value", stale_use_position, stale_first.call)

    branch_function: (found: bool, line: u32) = test_owner_function_line(stale_call_report.source_declarations, "stale_branch_join", 0)
    branch_use_position: mutable Ast::Pos = Ast::pos_at_line(0)
    branch_use_found: mutable bool = false
    branch_first: (found: bool, trace_index: usize, call: Ast::Expr) = test_first_direct_summary_call(&stale_call_report, "stale_branch_join", "replay_identity", 1)
    return 49 if not branch_function.found or not branch_first.found
    return 50 if not test_local_return_position_declarations(stale_call_report.source_declarations, "stale_branch_join", branch_function.line, "value", &branch_use_position, &branch_use_found, 0)
    return 51 if not branch_use_found
    return 52 if test_summary_local_binding_source(&stale_call_report, "stale_branch_join", branch_function.line, "value", branch_use_position, branch_first.call)

    if_function: (found: bool, line: u32) = test_owner_function_line(stale_call_report.source_declarations, "stale_if_return", 0)
    if_use_position: mutable Ast::Pos = Ast::pos_at_line(0)
    if_use_found: mutable bool = false
    if_first: (found: bool, trace_index: usize, call: Ast::Expr) = test_first_direct_summary_call(&stale_call_report, "stale_if_return", "replay_identity", 1)
    return 87 if not if_function.found or not if_first.found
    return 88 if not test_local_return_position_declarations(stale_call_report.source_declarations, "stale_if_return", if_function.line, "value", &if_use_position, &if_use_found, 0)
    return 89 if not if_use_found
    return 90 if test_summary_local_binding_source(&stale_call_report, "stale_if_return", if_function.line, "value", if_use_position, if_first.call)

    match_function: (found: bool, line: u32) = test_owner_function_line(stale_call_report.source_declarations, "stale_match_join", 0)
    match_use_position: mutable Ast::Pos = Ast::pos_at_line(0)
    match_use_found: mutable bool = false
    match_first: (found: bool, trace_index: usize, call: Ast::Expr) = test_first_direct_summary_call(&stale_call_report, "stale_match_join", "replay_identity", 1)
    return 77 if not match_function.found or not match_first.found
    return 78 if not test_local_return_position_declarations(stale_call_report.source_declarations, "stale_match_join", match_function.line, "value", &match_use_position, &match_use_found, 0)
    return 79 if not match_use_found
    return 80 if test_summary_local_binding_source(&stale_call_report, "stale_match_join", match_function.line, "value", match_use_position, match_first.call)

    stale_trace: ProofFactTrace = stale_call_report.traces.records[stale_first.trace_index]
    replay_identity_summary: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
    replay_identity_found: mutable bool = false
    for candidate in stale_call_report.executable_summaries |candidate, stale_trace, replay_identity_summary, replay_identity_found|:
        if candidate.name == "replay_identity" and candidate.line == stale_trace.owner_line:
            replay_identity_summary <- candidate
            replay_identity_found <- true
    return 53 if not replay_identity_found
    return 96 if not test_forged_local_call_result_refused(&stale_call_report, stale_call_report.traces.records[branch_first.trace_index], replay_identity_summary, branch_function.line, "value", branch_use_position)
    return 97 if not test_forged_local_call_result_refused(&stale_call_report, stale_call_report.traces.records[if_first.trace_index], replay_identity_summary, if_function.line, "value", if_use_position)
    return 98 if not test_forged_local_call_result_refused(&stale_call_report, stale_call_report.traces.records[match_first.trace_index], replay_identity_summary, match_function.line, "value", match_use_position)
    stale_result_index: usize = stale_trace.summary_bindings_start + replay_identity_summary.parameters_count
    return 54 if stale_result_index >= stale_call_report.traces.summary_values.count
    local_binding_start: usize = stale_call_report.traces.summary_values.count
    return 55 if stale_call_report.traces.summary_names.count != local_binding_start
    forged_local_result: (known: bool, expression: Ast::Expr) = test_local_summary_expression(&stale_call_report, stale_trace, replay_identity_summary, "value", stale_use_position)
    return 71 if not forged_local_result.known
    forged_local_expression: Ast::Expr = forged_local_result.expression
    forged_local_encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(forged_local_expression, &stale_call_report, stale_trace.name)
    return 56 if not forged_local_encoded.known
    for offset in 0..<stale_trace.summary_bindings_count |offset, stale_trace, stale_call_report|:
        source_binding: usize = stale_trace.summary_bindings_start + offset
        stale_call_report.traces.summary_names.push(stale_call_report.traces.summary_names[source_binding])
        stale_call_report.traces.summary_values.push(stale_call_report.traces.summary_values[source_binding])
    stale_call_report.traces.summary_values[local_binding_start + replay_identity_summary.parameters_count] <- Ast::Expr.Ident("value", stale_use_position)
    forged_local_trace: ProofFactTrace = ProofFactTrace{expression: forged_local_expression, kernel_expression: forged_local_encoded.root, kind: stale_trace.kind, line: stale_trace.line, name: stale_trace.name, dependency: stale_trace.dependency, premises_start: stale_trace.premises_start, premises_count: stale_trace.premises_count, kernel_premises_start: stale_trace.kernel_premises_start, kernel_premises_count: stale_trace.kernel_premises_count, summary_bindings_start: local_binding_start, summary_bindings_count: stale_trace.summary_bindings_count, summary_requires_start: stale_trace.summary_requires_start, summary_requires_count: stale_trace.summary_requires_count, summary_ensure_index: stale_trace.summary_ensure_index, owner_line: stale_trace.owner_line}
    stale_call_report.traces.records.push(forged_local_trace)
    stale_call_report.replay_owner_line <- stale_call_function.line
    return 57 if test_summary_source_call_known(&stale_call_report, forged_local_trace, replay_identity_summary)
    return 58 if proof_replay_fact_trace_entry(&stale_call_report, stale_call_report.traces.records.count - 1)

    positive_call_text: sview = "def replay_identity(x: i64) -> i64:\n    requires x >= 0\n    ensure result == x\n    return x\n\ndef unchanged_branch_join(flag: bool) -> i64:\n    ensure result == 1\n    value: mutable i64 = replay_identity(1)\n    if flag:\n        marker: i64 = 0\n    return value\n\ndef same_value_branch_join(flag: bool) -> i64:\n    ensure result == 1\n    value: mutable i64 = replay_identity(1)\n    if flag:\n        value <- value\n    else:\n        value <- value\n    return value\n\ndef same_value_match_join(flag: bool) -> i64:\n    ensure result == 1\n    value: mutable i64 = replay_identity(1)\n    match flag:\n        true:\n            value <- value\n        false:\n            value <- value\n    return value\n\ndef nested_call_result() -> i64:\n    ensure result == 1\n    return replay_identity(replay_identity(1))\n"
    positive_call_source: mutable darray[u8] = []
    for index in 0..<sview_len(positive_call_text) |index, positive_call_text, positive_call_source|:
        positive_call_source.push(sview_at(positive_call_text, index))
    positive_call_source.push(0)
    positive_call_file: Ast::File = frontend_parse(&positive_call_source[0])
    positive_call_report: mutable ProofReport = proof_empty_report()
    proof_check(positive_call_file, &positive_call_report)
    proof_replay_certificates(&positive_call_report)
    unchanged_function: (found: bool, line: u32) = test_owner_function_line(positive_call_report.source_declarations, "unchanged_branch_join", 0)
    unchanged_use_position: mutable Ast::Pos = Ast::pos_at_line(0)
    unchanged_use_found: mutable bool = false
    unchanged_first: (found: bool, trace_index: usize, call: Ast::Expr) = test_first_direct_summary_call(&positive_call_report, "unchanged_branch_join", "replay_identity", 1)
    return 62 if not unchanged_function.found or not unchanged_first.found
    return 63 if not test_local_return_position_declarations(positive_call_report.source_declarations, "unchanged_branch_join", unchanged_function.line, "value", &unchanged_use_position, &unchanged_use_found, 0)
    return 64 if not unchanged_use_found or not test_summary_local_binding_source(&positive_call_report, "unchanged_branch_join", unchanged_function.line, "value", unchanged_use_position, unchanged_first.call)
    same_value_function: (found: bool, line: u32) = test_owner_function_line(positive_call_report.source_declarations, "same_value_branch_join", 0)
    same_value_use_position: mutable Ast::Pos = Ast::pos_at_line(0)
    same_value_use_found: mutable bool = false
    same_value_first: (found: bool, trace_index: usize, call: Ast::Expr) = test_first_direct_summary_call(&positive_call_report, "same_value_branch_join", "replay_identity", 1)
    return 65 if not same_value_function.found or not same_value_first.found
    return 66 if not test_local_return_position_declarations(positive_call_report.source_declarations, "same_value_branch_join", same_value_function.line, "value", &same_value_use_position, &same_value_use_found, 0)
    return 67 if not same_value_use_found or not test_summary_local_binding_source(&positive_call_report, "same_value_branch_join", same_value_function.line, "value", same_value_use_position, same_value_first.call)
    nested_function: (found: bool, line: u32) = test_owner_function_line(positive_call_report.source_declarations, "nested_call_result", 0)
    return 69 if not nested_function.found or not test_owner_goals_all_proven(&positive_call_report, "nested_call_result")
    nested_trace_count: usize = test_owner_summary_trace_count(&positive_call_report, "nested_call_result", "replay_identity")
    return 74 if nested_trace_count == 0
    nested_replay_status: usize = test_owner_summary_trace_replay_status(&positive_call_report, "nested_call_result", "replay_identity", nested_function.line, nested_trace_count)
    return 75 if nested_replay_status != 5

    overload_text: sview = "def overloaded_identity(x: i64) -> i64:\n    ensure result == x\n    return x\n\ndef overloaded_identity(x: bool) -> i64:\n    ensure result == 1\n    return 1\n"
    overload_source: mutable darray[u8] = []
    for index in 0..<sview_len(overload_text) |index, overload_text, overload_source|:
        overload_source.push(sview_at(overload_text, index))
    overload_source.push(0)
    overload_file: Ast::File = frontend_parse(&overload_source[0])
    overload_report: mutable ProofReport = proof_empty_report()
    overload_report.source_declarations <- overload_file.top_decls
    overload_trace: ProofFactTrace = ProofFactTrace{expression: Ast::Expr.Absent, kernel_expression: 0, kind: "function-summary", line: 1, name: "overload_caller", dependency: "overloaded_identity", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 1}
    overload_summary: ProofExecutableSummary = ProofExecutableSummary{name: "overloaded_identity", line: 1, parameters_start: 0, parameters_count: 1, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 1, pure: true, verified: true, verification_reason: ""}
    return 72 if not test_summary_overload_is_unsupported(&overload_report, overload_trace)
    return 73 if test_summary_source_call_known(&overload_report, overload_trace, overload_summary)

    namespace_overload_text: sview = "module FirstScope:\n    def namespace_collision(x: i64) -> i64:\n        return x\n\nmodule SecondScope:\n    def namespace_collision(x: i64) -> i64:\n        return x\n"
    namespace_overload_source: mutable darray[u8] = []
    for index in 0..<sview_len(namespace_overload_text) |index, namespace_overload_text, namespace_overload_source|:
        namespace_overload_source.push(sview_at(namespace_overload_text, index))
    namespace_overload_source.push(0)
    namespace_overload_file: Ast::File = frontend_parse(&namespace_overload_source[0])
    namespace_overload_report: mutable ProofReport = proof_empty_report()
    namespace_overload_report.source_declarations <- namespace_overload_file.top_decls
    namespace_owner: (found: bool, line: u32) = test_owner_function_line(namespace_overload_report.source_declarations, "namespace_collision", 0)
    namespace_trace: ProofFactTrace = ProofFactTrace{expression: Ast::Expr.Absent, kernel_expression: 0, kind: "function-summary", line: 1, name: "namespace_caller", dependency: "namespace_collision", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: namespace_owner.line}
    return 106 if not namespace_owner.found or not test_summary_overload_is_unsupported(&namespace_overload_report, namespace_trace)

    # This arity-distinct internal/extern overload is compiler-legal. Replay has no resolved
    # declaration identity, so it must not guess the internal summary from the shared name.
    mixed_overload_text: sview = "def mixed_internal_extern(x: i64) -> i64:\n    ensure result == x\n    return x\n\nextern mixed_internal_extern(x: i64, y: i64) -> i64\n"
    mixed_overload_source: mutable darray[u8] = []
    for index in 0..<sview_len(mixed_overload_text) |index, mixed_overload_text, mixed_overload_source|:
        mixed_overload_source.push(sview_at(mixed_overload_text, index))
    mixed_overload_source.push(0)
    mixed_overload_file: Ast::File = frontend_parse(&mixed_overload_source[0])
    mixed_overload_report: mutable ProofReport = proof_empty_report()
    mixed_overload_report.source_declarations <- mixed_overload_file.top_decls
    mixed_owner: (found: bool, line: u32) = test_owner_function_line(mixed_overload_report.source_declarations, "mixed_internal_extern", 0)
    mixed_overload_trace: ProofFactTrace = ProofFactTrace{expression: Ast::Expr.Absent, kernel_expression: 0, kind: "function-summary", line: 1, name: "mixed_caller", dependency: "mixed_internal_extern", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: mixed_owner.line}
    mixed_overload_summary: ProofExecutableSummary = ProofExecutableSummary{name: "mixed_internal_extern", line: mixed_owner.line, parameters_start: 0, parameters_count: 1, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 1, pure: true, verified: true, verification_reason: ""}
    return 94 if not mixed_owner.found or not test_summary_overload_is_unsupported(&mixed_overload_report, mixed_overload_trace)
    return 95 if test_summary_source_call_known(&mixed_overload_report, mixed_overload_trace, mixed_overload_summary)

    # The parser records this source import as Decl.Import; absent a resolved target/callee
    # witness, a summary inside that candidate namespace must not be selected.
    imported_text: sview = "module ImportedScope:\n    include \"unresolved_api.elisa\"\n    def imported_collision(x: i64) -> i64:\n        ensure result == x\n        return x\n"
    imported_source: mutable darray[u8] = []
    for index in 0..<sview_len(imported_text) |index, imported_text, imported_source|:
        imported_source.push(sview_at(imported_text, index))
    imported_source.push(0)
    imported_file: Ast::File = frontend_parse(&imported_source[0])
    imported_report: mutable ProofReport = proof_empty_report()
    imported_report.source_declarations <- imported_file.top_decls
    imported_report.source_annotations <- imported_file.enum_annotations
    return 104 if not test_source_has_import_declaration(imported_report.source_declarations, 0)
    imported_owner: (found: bool, line: u32) = test_owner_function_line(imported_report.source_declarations, "imported_collision", 0)
    imported_trace: ProofFactTrace = ProofFactTrace{expression: Ast::Expr.Absent, kernel_expression: 0, kind: "function-summary", line: 1, name: "import_caller", dependency: "imported_collision", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: imported_owner.line}
    imported_summary: ProofExecutableSummary = ProofExecutableSummary{name: "imported_collision", line: imported_owner.line, parameters_start: 0, parameters_count: 1, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 1, pure: true, verified: true, verification_reason: ""}
    return 100 if not imported_owner.found or not test_summary_overload_is_unsupported(&imported_report, imported_trace)
    return 101 if test_summary_source_call_known(&imported_report, imported_trace, imported_summary)

    # `using` import resolution is kept in parser annotations, not Decl rows. It too must
    # prevent name/arity-only summary selection when the resolved import identity is absent.
    using_text: sview = "using ImportedApi\ndef imported_collision(x: i64) -> i64:\n    ensure result == x\n    return x\n"
    using_source: mutable darray[u8] = []
    for index in 0..<sview_len(using_text) |index, using_text, using_source|:
        using_source.push(sview_at(using_text, index))
    using_source.push(0)
    using_file: Ast::File = frontend_parse(&using_source[0])
    using_report: mutable ProofReport = proof_empty_report()
    using_report.source_declarations <- using_file.top_decls
    using_report.source_annotations <- using_file.enum_annotations
    using_owner: (found: bool, line: u32) = test_owner_function_line(using_report.source_declarations, "imported_collision", 0)
    using_trace: ProofFactTrace = ProofFactTrace{expression: Ast::Expr.Absent, kernel_expression: 0, kind: "function-summary", line: 1, name: "using_caller", dependency: "imported_collision", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: using_owner.line}
    using_summary: ProofExecutableSummary = ProofExecutableSummary{name: "imported_collision", line: using_owner.line, parameters_start: 0, parameters_count: 1, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 1, pure: true, verified: true, verification_reason: ""}
    return 102 if not using_owner.found or not test_summary_overload_is_unsupported(&using_report, using_trace)
    return 103 if test_summary_source_call_known(&using_report, using_trace, using_summary)
    trace_index: mutable usize = report.traces.records.count
    for index in 0..<report.traces.records.count |index, report, trace_index|:
        if report.traces.records[index].kind == "deterministic-call":
            trace_index <- index
            break
    return 1 if trace_index >= report.traces.records.count
    return 2 if not proof_replay_fact_trace_entry(&report, trace_index)

    original: ProofFactTrace = report.traces.records[trace_index]
    return 107 if not proof_replay_fact_trace_entry(&report, trace_index)
    saved_declarations: darray[Ast::Decl] = report.source_declarations
    report.source_declarations.push(Ast::Decl.Import("unresolved_api.elisa", Ast::pos_at_line(original.line)))
    return 108 if proof_replay_fact_trace_entry(&report, trace_index)
    report.source_declarations <- saved_declarations
    saved_annotations: darray[Ast::EnumAnnotation] = report.source_annotations
    report.source_annotations.push(Ast::EnumAnnotation{owner: "ImportedApi", name: "__using", module: "", line: original.line, offset: 0, pos: Ast::pos_at_line(original.line)})
    return 109 if proof_replay_fact_trace_entry(&report, trace_index)
    report.source_annotations <- saved_annotations
    match original.expression:
        Ast::Expr.Call(marker_callee, marker_arguments, marker_names, position):
            return 3 if marker_arguments.count != 1
            match marker_arguments[0]:
                Ast::Expr.Call(call_callee, arguments, argument_names, call_position):
                    forged_position: Ast::Pos = call_position
                    forged_position.line <- forged_position.line + 1
                    forged_position.column <- forged_position.column + 1
                    forged_position.offset <- forged_position.offset + 1
                    forged_position.end_line <- forged_position.end_line + 1
                    forged_position.end_column <- forged_position.end_column + 1
                    forged_position.end_offset <- forged_position.end_offset + 1
                    position_forged_call: Ast::Expr = Ast::Expr.Call(call_callee, arguments, argument_names, forged_position)
                    position_forged_arguments: darray[Ast::Expr] = [position_forged_call]
                    position_forgery: Ast::Expr = Ast::Expr.Call(marker_callee, position_forged_arguments, marker_names, position)
                    position_encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(position_forgery, &report, original.name)
                    return 9 if not position_encoded.known
                    report.traces.records[trace_index] <- ProofFactTrace{expression: position_forgery, kernel_expression: position_encoded.root, kind: original.kind, line: original.line, name: original.name, dependency: original.dependency, premises_start: original.premises_start, premises_count: original.premises_count, kernel_premises_start: original.kernel_premises_start, kernel_premises_count: original.kernel_premises_count, summary_bindings_start: original.summary_bindings_start, summary_bindings_count: original.summary_bindings_count, summary_requires_start: original.summary_requires_start, summary_requires_count: original.summary_requires_count, summary_ensure_index: original.summary_ensure_index, owner_line: original.owner_line}
                    return 10 if proof_replay_fact_trace_entry(&report, trace_index)
                    report.traces.records[trace_index] <- original
                    return 11 if not proof_replay_fact_trace_entry(&report, trace_index)
                    wrong_module: Ast::Expr = Ast::Expr.Scope(Ast::Expr.Ident("Elsewhere", call_position), "Inner", call_position)
                    forged_callee: Ast::Expr = Ast::Expr.Scope(wrong_module, "bounded", call_position)
                    forged_call: Ast::Expr = Ast::Expr.Call(forged_callee, arguments, argument_names, call_position)
                    forged_arguments: darray[Ast::Expr] = [forged_call]
                    forged_expression: Ast::Expr = Ast::Expr.Call(marker_callee, forged_arguments, marker_names, position)
                    encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(forged_expression, &report, original.name)
                    return 4 if not encoded.known
                    report.traces.records[trace_index] <- ProofFactTrace{expression: forged_expression, kernel_expression: encoded.root, kind: original.kind, line: original.line, name: original.name, dependency: original.dependency, premises_start: original.premises_start, premises_count: original.premises_count, kernel_premises_start: original.kernel_premises_start, kernel_premises_count: original.kernel_premises_count, summary_bindings_start: original.summary_bindings_start, summary_bindings_count: original.summary_bindings_count, summary_requires_start: original.summary_requires_start, summary_requires_count: original.summary_requires_count, summary_ensure_index: original.summary_ensure_index, owner_line: original.owner_line}
                    return 5 if proof_replay_fact_trace_entry(&report, trace_index)
                    report.traces.records[trace_index] <- original
                    return 6 if not proof_replay_fact_trace_entry(&report, trace_index)
                _:
                    return 7
        _:
            return 8

    forged_binding_position: Ast::Pos = Ast::pos_at_line(0)
    forged_binding: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("x", forged_binding_position), TokenKind.EqEq, Ast::Expr.IntLit(FORGED_LOCAL_BINDING_VALUE, forged_binding_position), forged_binding_position)
    forged_binding_encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(forged_binding, &report, "caller")
    return FORGED_LOCAL_BINDING_ENCODING_FAILED if not forged_binding_encoded.known
    forged_binding_trace: ProofFactTrace = ProofFactTrace{expression: forged_binding, kernel_expression: forged_binding_encoded.root, kind: "local-binding", line: 0, name: "caller", dependency: "", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 0}
    report.traces.records.push(forged_binding_trace)
    return FORGED_LOCAL_BINDING_ACCEPTED if proof_replay_fact_trace_entry(&report, report.traces.records.count - 1)
    return 0
