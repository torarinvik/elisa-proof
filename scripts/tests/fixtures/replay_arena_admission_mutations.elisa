def api_disconnected_malformed_arena_revokes_batch[@r](source: mutable darray[u8]&, report: mutable ProofReport& @r, diagnostics: mutable darray[Semantic::Diagnostic]&, route: usize) -> bool can Memory.Allocate, Abort.Panic:
    (api_probe_before_replay(VALID_API_SOURCE, source, report, diagnostics, route) can Global{Read,Write})
    return false if report.analysis_1.certificates.count == 0
    originally_valid: bool = (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children) can Global{Read,Write})
    return false if not originally_valid
    # This node is unreachable from every certificate, but the report arena is one serialized
    # trust boundary. A malformed disconnected component must revoke the entire batch.
    report.analysis_1.kernel.nodes.push(ElisaProofKernelCore::ProofKernelNode{kind: "malformed-disconnected-node", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""})
    receipt: ProofReplayReceipt[r] = (proof_replay_certificates(report) can Global{Read,Write})
    return false if proof_replay_receipt_kernel_batch_complete(receipt) or proof_replay_receipt_is_complete(receipt) or proof_replay_receipt_source_validated(receipt)
    for attempt_index in 0..<proof_replay_receipt_attempt_count(receipt) |attempt_index, receipt|:
        return false if proof_replay_receipt_kernel_attempt_status(receipt, attempt_index) or proof_replay_receipt_attempt_status(receipt, attempt_index) or proof_replay_receipt_attempt_is_proven(receipt, attempt_index)
    for certificate_index in 0..<proof_replay_receipt_certificate_count(receipt) |certificate_index, receipt|:
        return false if proof_replay_receipt_kernel_certificate_status(receipt, certificate_index) or proof_replay_receipt_certificate_status(receipt, certificate_index)
    for certificate in report.analysis_1.certificates |certificate|:
        return false if certificate.replayed
    nonempty_revoked: bool = report.analysis_2.replayed == 0 and report.analysis_2.replay_gaps > 0 and not report.analysis_1.kernel.arena_validated and not proof_replay_certificates_complete(report)
    return false if not nonempty_revoked
    empty_report: mutable ProofReport = proof_empty_report()
    empty_report.analysis_1.kernel.nodes.push(ElisaProofKernelCore::ProofKernelNode{kind: "malformed-disconnected-node", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""})
    empty_receipt: ProofReplayReceipt[r] = (proof_replay_certificates(&empty_report) can Global{Read,Write})
    empty_gaps: (available: bool, count: u32) = proof_replay_receipt_gap_count(empty_receipt)
    return empty_report.analysis_2.replayed == 0 and empty_report.analysis_2.replay_gaps > 0 and not empty_report.analysis_1.kernel.arena_validated and not proof_replay_certificates_complete(empty_report) and proof_replay_receipt_is_issued(empty_receipt) and not proof_replay_receipt_kernel_batch_complete(empty_receipt) and empty_gaps.available and empty_gaps.count > 0
