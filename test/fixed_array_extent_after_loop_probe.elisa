def fixed_array_extent_after_loop(values: mutable array[u8, 4]&) -> u8:
    ensure result == 1
    index: mutable usize = 0
    while index < 3 |index, values|:
        invariant index <= 3
        decreases 3 - index
        values[index] <- 7
        index <- index + 1
    values[3] <- 10
    return 1

def fixed_array_extent_after_for_loop(values: mutable array[u8, 4]&) -> u8:
    ensure result == 1
    for index in 0..<3 |values|:
        values[index] <- 7
    values[3] <- 10
    return 1

def rejected_fixed_array_after_loop_out_of_bounds(values: mutable array[u8, 4]&) -> u8:
    index: mutable usize = 0
    while index < 3 |index, values|:
        invariant index <= 3
        decreases 3 - index
        values[index] <- 7
        index <- index + 1
    values[4] <- 10
    return 1

# Keeping the declaration's extent must not retain the entry element value.
def rejected_fixed_array_stale_element_after_loop(values: mutable array[u8, 4]&) -> u8:
    requires values[3] == 5
    ensure values[3] == 5
    index: mutable usize = 0
    while index < 3 |index, values|:
        invariant index <= 3
        decreases 3 - index
        values[3] <- 7
        index <- index + 1
    return 1
