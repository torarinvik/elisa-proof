def fixed_array_extent_after_loop(values: mutable array[u8, 4]&) -> u8:
    ensure result == 1
    index: mutable usize = 0
    while index < 3 |index, values|:
        invariant index <= 3
        decreases 3 - index
        values[index] <- 7
        index <- index + 1
    values[3] <- 10
    return 1

def rejected_fixed_array_after_loop_out_of_bounds(values: mutable array[u8, 4]&) -> u8:
    index: mutable usize = 0
    while index < 3 |index, values|:
        invariant index <= 3
        decreases 3 - index
        values[index] <- 7
        index <- index + 1
    values[4] <- 10
    return 1
