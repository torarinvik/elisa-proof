def unsigned_span_literal_endpoint(start: usize, next: usize) -> bool:
    requires start < 64
    requires next == start + 1
    ensure 64 - next < 64 - start
    return true

def unsigned_span_literal_u8_endpoint(start: u8, next: u8) -> bool:
    requires start < 255
    requires next == start + 1
    ensure 255 - next < 255 - start
    return true
