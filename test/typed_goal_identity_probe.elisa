def typed_u8_identity_positive() -> u8:
    ensure 7u8 == 7u8
    return 0u8

def typed_u8_identity_negative() -> u8:
    ensure 7u8 == 8u8
    return 0u8

def typed_u16_identity_negative() -> u16:
    ensure 7u16 == 8u16
    return 0u16

def typed_u64_high_bit_negative() -> u64:
    ensure 18446744073709551615u64 < 0u64
    return 0u64
def typed_u64_identity_positive() -> u8:
    ensure 18446744073709551615u64 == 18446744073709551615u64
    return 0

def typed_u16_identity_positive() -> u8:
    ensure 65535u16 == 65535u16
    return 0
