# Independent ordinary single-file inputs and literal observations. No import
# of the candidate counter, reader, filesystem, process adapter or launcher.
module EsSourceLengthCases:
    private:
        def repeated(value: sview, count: usize) -> sview can[Memory.Allocate, Abort.Panic]:
            result: mutable sview = ""
            for _ in 0..<count |result|:
                result <- result + value
            return result

    public:
        const module Fixture:
            CASES: usize = 13
            TOO_LONG_601: sview = "file exceeds 600 lines: src/boundary.elisa (601)\n"
            TOO_LONG_602: sview = "file exceeds 600 lines: src/boundary.elisa (602)\n"


        struct Case:
            label: sview
            contents: sview
            lines: usize
            status: i64 = 0
            stderr: sview = ""


        def ordinary() -> darray[Case] can[Memory.Allocate, Abort.Panic]:
            return [
                Case{label: "empty", contents: "", lines: 0},
                Case{label: "bom-content", contents: "\xef\xbb\xbf", lines: 1},
                Case{label: "lf-599", contents: repeated("\n", 599), lines: 599},
                Case{label: "lf-600", contents: repeated("\n", 600), lines: 600},
                Case{label: "lf-601", contents: repeated("\n", 601), lines: 601, status: 1, stderr: Fixture::TOO_LONG_601},
                Case{label: "unterminated-600", contents: repeated("\n", 599) + "tail", lines: 600},
                Case{label: "unterminated-601", contents: repeated("\n", 600) + "tail", lines: 601, status: 1, stderr: Fixture::TOO_LONG_601},
                Case{label: "cr-600", contents: repeated("\r", 600), lines: 600},
                Case{label: "crlf-600", contents: repeated("\r\n", 600), lines: 600},
                Case{label: "cr-crlf-600", contents: repeated("\r\r\n", 300), lines: 600},
                Case{label: "mixed-control-601", contents: repeated("x\r\ny\rz\n", 200) + "\xc2\x85\xe2\x80\xa8\xe2\x80\xa9\x0b\x0c\0", lines: 601, status: 1, stderr: Fixture::TOO_LONG_601},
                # Unicode splitlines separators and VT/FF/NUL are all content
                # to Python text-file iteration, not 601 new logical lines.
                Case{label: "unicode-control-content", contents: repeated("\xc2\x85\xe2\x80\xa8\xe2\x80\xa9\x0b\x0c\0", 601), lines: 1},
                Case{label: "lf-602", contents: repeated("\n", 602), lines: 602, status: 1, stderr: Fixture::TOO_LONG_602}
            ]
