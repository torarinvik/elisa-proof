# Dormant, explicitly gated parity matrix. Run only through run_bounded_test.sh
# after user reauthorization; never launch it against a live project tree.
include "../../../elisa-script/src/testing/differential.elisa"
include "../../../elisa-script/src/runtime/bounded_text_posix.elisa"
include "../../../elisa-script/src/testing/checksum_record_model.elisa"
include "../../../elisa-script/test/script_parity/skia_environment_launcher_plan.elisa"
include "source_length_cases.elisa"
include "../../scripts/check_source_length.elisascript"

using EsDifferential


module EsSourceLengthLauncherParity:
    private:
        const module Tools:
            PYTHON: sview = "/usr/bin/python3"
            PYTHON_SHA256: sview = "34129c71a01a74f7f3b2443521519b2e5447553fa187f5fcafaaf8c42cc192e2"
            SHA256: sview = "/usr/bin/shasum"
            COMPILER: sview = EsSkiaEnvironmentLauncherPlan::Pins::COMPILER
            PATH_VALUE: sview = "/usr/bin:/bin:/usr/sbin:/sbin"
            REFERENCE_SOURCE_SHA256: sview = "8a5142e1c3c82db4f21668e9e9dcdc3dd8acae2452fcba73cb3f3278a7f18996"
            CANDIDATE_SOURCE_SHA256: sview = "ad5526a1d577b9490fb9ed8eb28fc343111b8a6804a8b78c17524ad5e0288a09"
            TIMEOUT_STEPS: u64 = 10000
            OUTPUT_BYTES: u64 = 65536
            PIN_BYTES: usize = 67108864
            COPY_BYTES: usize = 524288
            TOTAL_COPY_BYTES: usize = 2097152


        const module Paths:
            REFERENCE: sview = "elisa-proof/scripts/check_source_length.py"
            CANDIDATE: sview = "elisa-proof/scripts/check_source_length.elisascript"
            CANDIDATE_LAUNCH: sview = "elisa-proof/alternate/scripts/check_source_length.elisascript"
            SOURCE_ROOT: sview = "elisa-proof/src"


        struct SourceCopy:
            source: sview
            destination: sview
            sha256: sview


        struct TemporaryRoot:
            path: Path
            created: bool = false
            ready: bool = false
            files: darray[Path] = []
            directories: darray[Path] = []


        struct Authorization:
            launcher: sview
            launcher_sha256: sview
            compiler_sha256: sview


        error GateError:
            Disabled
            MissingGuard
            WrongCompiler
            MissingIdentity


        def environment_value(name: sview) -> sview can[Environment.Read]:
            return try getenv(name, "") else ""


        def valid_sha256(value: sview) -> bool:
            return EsSkiaEnvironmentLauncherPlan::valid_hash(value)


        def authorization() -> Authorization error[GateError] can[Environment.Read]:
            raise GateError.Disabled if environment_value("ELISASCRIPT_VALIDATION_REAUTHORIZED") != "1" or environment_value("ELISASCRIPT_SOURCE_LENGTH_LAUNCHER_QUALIFIED") != "1"
            raise GateError.MissingGuard if environment_value("ELISASCRIPT_BOUNDED_TEST_RSS_GUARD") != "active"
            raise GateError.WrongCompiler if environment_value("ELISA_LOCAL_COMPILER") != Tools::COMPILER or environment_value("ELISACORE_BIN") != Tools::COMPILER
            launcher: sview = environment_value("ELISASCRIPT_PUBLIC_LAUNCHER")
            launcher_hash: sview = environment_value("ELISASCRIPT_PUBLIC_LAUNCHER_SHA256")
            compiler_hash: sview = environment_value("ELISASCRIPT_LOCAL_COMPILER_SHA256")
            try EsSkiaEnvironmentLauncherPlan::validate_roles(
                EsSkiaEnvironmentLauncherPlan::Identity{path: launcher, hash: launcher_hash},
                EsSkiaEnvironmentLauncherPlan::Identity{path: Tools::PYTHON, hash: Tools::PYTHON_SHA256}, compiler_hash) else err:
                raise GateError.MissingIdentity
            return Authorization{launcher: launcher, launcher_sha256: launcher_hash, compiler_sha256: compiler_hash}


        def sources(repository_root: Path) -> darray[SourceCopy] can[Memory.Allocate, Abort.Panic]:
            script_root: Path = repository_root.parent().joinpath("elisa-script")
            reference_script: Path = repository_root.joinpath("test/fixtures/script_parity/source_length/reference.py")
            candidate_script: Path = repository_root.joinpath("scripts/check_source_length.elisascript")
            source_length_model: Path = script_root.joinpath("src/runtime/source_length_model.elisa")
            source_length_stream: Path = script_root.joinpath("src/runtime/source_length_stream_posix.elisa")
            bounded_reader: Path = script_root.joinpath("src/runtime/bounded_text_posix.elisa")
            encoding: Path = script_root.joinpath("src/runtime/encoding.elisa")
            file_reader: Path = script_root.joinpath("src/runtime/file_posix.elisa")
            directory_reader: Path = script_root.joinpath("src/runtime/directory_posix.elisa")
            stdio: Path = script_root.joinpath("src/runtime/stdio_posix.elisa")
            return [
                SourceCopy{source: f"{reference_script}", destination: Paths::REFERENCE, sha256: Tools::REFERENCE_SOURCE_SHA256},
                SourceCopy{source: f"{candidate_script}", destination: Paths::CANDIDATE, sha256: Tools::CANDIDATE_SOURCE_SHA256},
                SourceCopy{source: f"{source_length_model}", destination: "elisa-script/src/runtime/source_length_model.elisa", sha256: "4a4b986e05ac7e5acd33101e5bfa2107b628efc3aeb2174a2ca2542f575500aa"},
                SourceCopy{source: f"{source_length_stream}", destination: "elisa-script/src/runtime/source_length_stream_posix.elisa", sha256: "ca174f1e3ad1ecccbca96c2f7db4bd4a8cbf55368b7a226b269750ff69056026"},
                SourceCopy{source: f"{bounded_reader}", destination: "elisa-script/src/runtime/bounded_text_posix.elisa", sha256: "24e7e77b147f86b101a9273d0861c0122c097743303adee99b205adca852f5ff"},
                SourceCopy{source: f"{encoding}", destination: "elisa-script/src/runtime/encoding.elisa", sha256: "67815c728730d891c2e5fc0cc53a33d672d0f40003cfd468de903c4fbfcd9a53"},
                SourceCopy{source: f"{file_reader}", destination: "elisa-script/src/runtime/file_posix.elisa", sha256: "14e1e3a9f0d95ee3e45509bd7d76c1ba2694992d5530f82edf8533d9cf149643"},
                # Pin the committed bridge, not another agent's dirty edits.
                SourceCopy{source: f"{directory_reader}", destination: "elisa-script/src/runtime/directory_posix.elisa", sha256: "226121fabdb841e3f03e8d8e46848087677db8057571b9a544ef828093a97f92"},
                SourceCopy{source: f"{stdio}", destination: "elisa-script/src/runtime/stdio_posix.elisa", sha256: "c02cac5eec931a2f2aa9131616482df4e17333948961c4b6d0d215b0ab0e766c"}
            ]


        def has_sha256(target: sview, expected: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not valid_sha256(expected) or target == "" or target == "-" or len(target) > EsChecksumRecord::Limits::FILENAME_BYTES
            for byte in target:
                return false if byte == 0u8
            return false if not is_file(path(target)) or is_symlink(path(target))
            size: usize = try file_size(path(target)) else err:
                return false
            return false if size == 0 or size > Tools::PIN_BYTES
            runner: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "source-length-identity",
                target: Tools::SHA256, arguments: ["-a", "256", "-t", "--", target],
                environment_mode: EsProcess::ProcessEnvironmentMode.Clear,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            observed: DifferentialRun = try run_differential_process(runner) else err:
                return false
            return false if observed.outcome != DifferentialRunOutcome.Completed or observed.exit_status != 0 or observed.stderr != ""
            return try EsChecksumRecord::sha256_text_record_matches(observed.stdout, expected, target) else false


        def native_artifact(target: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            return false if not EsSkiaEnvironmentLauncherPlan::absolute_identity_path(target)
            file: Path = path(target)
            return false if not is_file(file) or is_symlink(file) or not is_executable(file)
            size: usize = try file_size(file) else 0usize
            return false if size < 4 or size > Tools::PIN_BYTES
            name: mutable darray[u8] = []
            for byte in target |name|:
                name.push(byte)
            name.push(0u8)
            mode: darray[u8] = [114u8,98u8,0u8]
            stream: mutable heap void&? = fopen(&name[0], &mode[0])
            return false if stream == null
            opened: mutable heap void& = stream
            header: mutable darray[u8] = [0u8,0u8,0u8,0u8]
            amount: usize = fread((&header[0]).cast[mutable void&], 1, 4, opened)
            closed: int = fclose(opened)
            return amount == 4 and closed == 0 and EsSkiaEnvironmentLauncherPlan::native_container_header(header) and not is_symlink(file)


        def pinned_inputs(auth: Authorization, repository_root: Path) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Unsafe.PointerCast]:
            # Reject executable text wrappers before even the hash-tool child.
            # Header recognition is not qualification or no-auto-build proof.
            return false if not native_artifact(Tools::COMPILER) or not native_artifact(Tools::PYTHON) or not native_artifact(auth.launcher)
            script_root: Path = repository_root.parent().joinpath("elisa-script")
            reference_snapshot: Path = repository_root.joinpath("test/fixtures/script_parity/source_length/reference.py")
            candidate_script: Path = repository_root.joinpath("scripts/check_source_length.elisascript")
            launcher_plan: Path = script_root.joinpath("test/script_parity/skia_environment_launcher_plan.elisa")
            checksum_model: Path = script_root.joinpath("src/testing/checksum_record_model.elisa")
            cases: Path = repository_root.joinpath("test/script_parity/source_length_cases.elisa")
            original_reference: Path = repository_root.joinpath("scripts/check_source_length.py")
            return false if not has_sha256(f"{original_reference}", Tools::REFERENCE_SOURCE_SHA256)
            return false if not has_sha256(f"{reference_snapshot}", Tools::REFERENCE_SOURCE_SHA256)
            return false if not has_sha256(f"{candidate_script}", Tools::CANDIDATE_SOURCE_SHA256)
            return false if not has_sha256(Tools::SHA256, "0812595f981a26f813d98dc380af14d4af427626c9339eda29eb849ae13de1e3")
            return false if not has_sha256(f"{launcher_plan}", "95bc181e302a42db00ba79882a7a23aec36b49ac918004351438d97e6af7b072")
            return false if not has_sha256(f"{checksum_model}", "1b3cec1235d42076e50b15491d3d6b906f3841ea966937779dc665f1e8a59488")
            return false if not has_sha256(f"{cases}", "f0e7b830dbc9367f77daf2787e87de9af4062eba23cb3c172a4893be62e058ee")
            return false if not has_sha256(Tools::PYTHON, Tools::PYTHON_SHA256) or not has_sha256(Tools::COMPILER, auth.compiler_sha256) or not has_sha256(auth.launcher, auth.launcher_sha256)
            for source in sources(repository_root):
                return false if not has_sha256(source.source, source.sha256)
            return true


        def write_new(root: mutable TemporaryRoot&, relative: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            return false if path_exists(target) or is_symlink(target)
            root.files.push(target)
            written: usize = try write_text(target, contents) else err:
                return false
            return written == len(contents)


        def rewrite(root: TemporaryRoot, relative: sview, contents: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            return false if is_symlink(target) or not is_file(target)
            written: usize = try write_text(target, contents) else err:
                return false
            return written == len(contents)


        # Only retire the last recorded file/link, after successful unlink.
        # Retain its ledger entry on failure so centralized cleanup can retry.
        # Like the other fixture fences, this is not atomic inode ownership.
        def retire_last_file(root: mutable TemporaryRoot&, relative: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if root.files.count == 0 or not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            recorded: Path = root.files[root.files.count - 1]
            return false if f"{recorded}" != f"{target}"
            return false if not is_symlink(target) and not is_file(target)
            removed: bool = try remove_path(target) else false
            return false if not removed
            _ = root.files.pop()
            return true


        def make_directory(root: mutable TemporaryRoot&, relative: sview) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return false if not parents_intact(root, root.directories.count)
            target: Path = root.path.joinpath(relative)
            return false if path_exists(target) or is_symlink(target)
            created: bool = try create_directory(target) else false
            return false if not created
            root.directories.push(target)
            return true


        def make_symlink(root: mutable TemporaryRoot&, relative: sview, target: Path) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read]:
            return false if not parents_intact(root, root.directories.count)
            link: Path = root.path.joinpath(relative)
            return false if path_exists(link) or is_symlink(link)
            created: bool = try symlink(target, link) else false
            return false if not created
            root.files.push(link)
            return true


        # Creation records ancestors before descendants. During reverse
        # cleanup, only the still-retained prefix must remain intact. This is
        # an observational path fence, not atomic identity or native authority.
        def parents_intact(root: TemporaryRoot, remaining: usize) -> bool can[Memory.Allocate, Abort.Panic, File.Read, Directory.Read]:
            return false if remaining > root.directories.count or is_symlink(root.path) or not is_directory(root.path)
            for index in 0..<remaining:
                directory: Path = root.directories[index]
                return false if is_symlink(directory) or not is_directory(directory)
            return true


        def cleanup(root: TemporaryRoot) -> bool can[Memory.Allocate, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write]:
            return true if not root.created
            cleaned: mutable bool = true
            for index in 0..<root.files.count |root, cleaned|:
                return false if not parents_intact(root, root.directories.count)
                target: Path = root.files[root.files.count - index - 1]
                # Registration precedes writes, so partial setup may leave a
                # missing file. Dangling final symlinks must still be unlinked.
                if path_exists(target) or is_symlink(target):
                    removed: bool = try remove_path(target) else false
                    cleaned <- removed and cleaned
            for index in 0..<root.directories.count |root, cleaned|:
                return false if not parents_intact(root, root.directories.count - index)
                removed: bool = try remove_directory(root.directories[root.directories.count - index - 1]) else false
                cleaned <- removed and cleaned
            return false if not parents_intact(root, 0)
            removed_root: bool = try remove_directory(root.path) else false
            return removed_root and cleaned


        def copy_sources(root: mutable TemporaryRoot&, repository_root: Path) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Unsafe.PointerCast]:
            copied_bytes: mutable usize = 0
            for source in sources(repository_root) |root, copied_bytes|:
                contents: sview = try EsBoundedText::read_utf8_path_text(f"{path(source.source)}", Tools::COPY_BYTES) else err:
                    return false
                return false if contents == "" or len(contents) > Tools::TOTAL_COPY_BYTES - copied_bytes
                return false if not write_new(root, source.destination, contents)
                copied_bytes <- copied_bytes + len(contents)
                # Detect source replacement between initial pinning and copying.
                return false if not has_sha256(f"{root.path.joinpath(source.destination)}", source.sha256)
            return true


        def create_root(repository_root: Path) -> TemporaryRoot can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast]:
            allocated: Path = try temp_directory("elisascript source length parity ") else err:
                return TemporaryRoot{path: path("."), created: false}
            canonical: Path = try path_real(allocated) else err:
                # Preserve the trusted allocation for centralized cleanup even
                # when canonicalization fails; do not hide an orphaned root.
                return TemporaryRoot{path: allocated, created: true}
            root: mutable TemporaryRoot = TemporaryRoot{path: canonical, created: true}
            for relative in ["elisa-script", "elisa-script/scripts", "elisa-script/src", "elisa-script/src/runtime", "elisa-proof", "elisa-proof/scripts", "elisa-proof/src", "elisa-proof/test", "elisa-proof/examples", "elisa-proof/alternate", "elisa-proof/alternate/scripts", "elisa-proof/elisa-script", "elisa-proof/elisa-script/src"]:
                if not make_directory(root, relative):
                    return root
            if not copy_sources(root, repository_root):
                return root
            if not make_symlink(root, "elisa-proof/elisa-script/src/runtime", root.path.joinpath("elisa-script/src/runtime")):
                return root
            if not make_symlink(root, Paths::CANDIDATE_LAUNCH, root.path.joinpath(Paths::CANDIDATE)):
                return root
            root.ready <- true
            return root


        def case_matches_at(auth: Authorization, root: TemporaryRoot, candidate_script: sview, status: i64, stderr: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            return false if not root.ready or not parents_intact(root, root.directories.count)
            environment: darray[DifferentialEnvironmentEntry] = [
                DifferentialEnvironmentEntry{name: "PATH", value: Tools::PATH_VALUE},
                DifferentialEnvironmentEntry{name: "LC_ALL", value: "C"}
            ]
            reference: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "python-source-length-reference",
                target: Tools::PYTHON, arguments: ["-I", "-B", f"{root.path.joinpath(Paths::REFERENCE)}", "ignored argument"],
                working_directory: "/", environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            candidate: DifferentialRunner = DifferentialRunner{
                kind: DifferentialRunnerKind.NativeProcess, name: "public-source-length-candidate",
                target: auth.launcher, arguments: [f"{root.path.joinpath(candidate_script)}", "ignored argument"],
                working_directory: "/", environment: environment,
                environment_mode: EsProcess::ProcessEnvironmentMode.Replace,
                timeout_steps: Tools::TIMEOUT_STEPS, max_output_bytes: Tools::OUTPUT_BYTES
            }
            reference_run: DifferentialRun = try run_differential_process(reference) else err:
                return false
            return false if not expected_observation(reference_run, status, stderr) or not parents_intact(root, root.directories.count)
            port_stdout: mutable darray[u8] = []
            port_stderr: mutable darray[u8] = []
            port_status: i64 = EsProofSourceLength::observe_root(root.path.joinpath("elisa-proof"), port_stdout, port_stderr)
            return false if port_status != status or bytes_view(port_stdout) != "" or bytes_view(port_stderr) != stderr
            return false if not parents_intact(root, root.directories.count)
            candidate_run: DifferentialRun = try run_differential_process(candidate) else err:
                return false
            comparison: DifferentialComparison = compare_differential_runs(reference_run, candidate_run)
            return comparison.equal and expected_observation(candidate_run, status, stderr) and parents_intact(root, root.directories.count)


        def case_matches(auth: Authorization, root: TemporaryRoot, status: i64, stderr: sview) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, Directory.Read, Unsafe.PointerCast, Console.Format]:
            return case_matches_at(auth, root, Paths::CANDIDATE, status, stderr)


        def expected_observation(run: DifferentialRun, status: i64, stderr: sview) -> bool:
            return run.outcome == DifferentialRunOutcome.Completed and run.error_text == "" and run.exit_status == status and run.stdout == "" and run.stderr == stderr


        def repeated(value: sview, count: usize) -> sview can[Memory.Allocate, Abort.Panic]:
            result: mutable sview = ""
            for _ in 0..<count |value, result|:
                result <- result + value
            return result


        def matrix(auth: Authorization, root: mutable TemporaryRoot&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format]:
            # A non-directory source root is ignored, even with oversized data.
            return false if not case_matches(auth, root, 0, "")
            return false if not write_new(root, Paths::SOURCE_ROOT, repeated("\n", 601))
            return false if not case_matches(auth, root, 0, "")
            return false if not retire_last_file(root, Paths::SOURCE_ROOT)

            # The initial root symlink is followed, unlike descendant directory
            # symlinks. Keep its target outside src and diagnostics under src/.
            linked_root: sview = "elisa-proof/root-target"
            return false if not make_directory(root, linked_root)
            return false if not write_new(root, linked_root + "/boundary.elisa", repeated("\n", 601))
            return false if not make_symlink(root, Paths::SOURCE_ROOT, root.path.joinpath(linked_root))
            return false if not case_matches(auth, root, 1, EsSourceLengthCases::Fixture::TOO_LONG_601)
            return false if not retire_last_file(root, Paths::SOURCE_ROOT)

            # The retained root-target is outside src and must not leak into
            # the subsequent ordinary-tree runs. Empty src accepts silently.
            return false if not make_directory(root, Paths::SOURCE_ROOT)
            return false if not case_matches(auth, root, 0, "")
            boundary: sview = Paths::SOURCE_ROOT + "/boundary.elisa"
            return false if not write_new(root, boundary, "")
            single_file_cases: darray[EsSourceLengthCases::Case] = EsSourceLengthCases::ordinary()
            return false if single_file_cases.count != EsSourceLengthCases::Fixture::CASES
            for selected in single_file_cases |root|:
                return false if not rewrite(root, boundary, selected.contents)
                if not case_matches(auth, root, selected.status, selected.stderr):
                    _ = write_stderr("source length parity: failed single-file case " + selected.label + "\n")
                    return false
            # The POSIX scanner reads 16,384-byte chunks. Put CR at the last
            # byte of its first chunk and LF at the start of the next one.
            return false if not rewrite(root, boundary, repeated("x", 16383) + "\r\n")
            if not case_matches(auth, root, 0, ""):
                _ = write_stderr("source length parity: failed split-CRLF read-boundary case\n")
                return false
            # Split a valid two-byte UTF-8 scalar at that same read boundary.
            return false if not rewrite(root, boundary, repeated("x", 16383) + "\xc3\xa9")
            if not case_matches(auth, root, 0, ""):
                _ = write_stderr("source length parity: failed split-UTF-8 read-boundary case\n")
                return false
            return false if not rewrite(root, boundary, repeated("\n", 600))

            # Resolve the candidate file itself, not only the launcher parent.
            # The alternate relative include path is staged as a directory link.
            return false if not rewrite(root, boundary, repeated("\n", 601))
            symlink_launch_stderr: sview = "file exceeds 600 lines: src/boundary.elisa (601)\n"
            if not case_matches_at(auth, root, Paths::CANDIDATE_LAUNCH, 1, symlink_launch_stderr):
                _ = write_stderr("source length parity: failed final-script-symlink launch case\n")
                return false
            return false if not rewrite(root, boundary, repeated("\n", 600))

            for directory in ["a", "a-", ".hidden"]:
                return false if not make_directory(root, Paths::SOURCE_ROOT + "/" + directory)
            for name in ["a.elisa", "a/z.elisa", "a-/z.elisa", ".hidden.elisa", ".hidden/child.elisa", "z.elisa", "\xc3\xa9.elisa"]:
                return false if not write_new(root, Paths::SOURCE_ROOT + "/" + name, repeated("\n", 601))
            return false if not write_new(root, Paths::SOURCE_ROOT + "/ignored.ELISA", repeated("\n", 601))
            expected: sview = "file exceeds 600 lines: src/.hidden/child.elisa (601)\nfile exceeds 600 lines: src/.hidden.elisa (601)\nfile exceeds 600 lines: src/a/z.elisa (601)\nfile exceeds 600 lines: src/a-/z.elisa (601)\nfile exceeds 600 lines: src/a.elisa (601)\nfile exceeds 600 lines: src/z.elisa (601)\nfile exceeds 600 lines: src/\xc3\xa9.elisa (601)\n"
            return false if not case_matches(auth, root, 1, expected)

            # A descendant directory symlink cycle must not be traversed; a
            # matching file symlink must still be counted in pathname order.
            return false if not make_symlink(root, Paths::SOURCE_ROOT + "/loop", root.path.joinpath(Paths::SOURCE_ROOT))
            return false if not make_symlink(root, Paths::SOURCE_ROOT + "/m_link.elisa", root.path.joinpath(Paths::SOURCE_ROOT + "/a.elisa"))
            with_link: sview = replace(expected, "file exceeds 600 lines: src/z.elisa", "file exceeds 600 lines: src/m_link.elisa (601)\nfile exceeds 600 lines: src/z.elisa")
            return false if not case_matches(auth, root, 1, with_link)

            # Do not impose the candidate's former 64-directory traversal cap.
            deep_directory: mutable sview = Paths::SOURCE_ROOT
            for _ in 0..<65 |deep_directory|:
                deep_directory <- deep_directory + "/d"
                if not make_directory(root, deep_directory):
                    return false
            deep_file: sview = deep_directory + "/deep.elisa"
            return false if not write_new(root, deep_file, repeated("\n", 601))
            deep_line: sview = "file exceeds 600 lines: " + deep_file + " (601)\n"
            deep_expected: sview = replace(with_link, "file exceeds 600 lines: src/m_link.elisa", deep_line + "file exceeds 600 lines: src/m_link.elisa")
            return false if not case_matches(auth, root, 1, deep_expected)

            # The checker scans four more ordered glob groups after src.
            # Nested files exercise recursive globbing; the combined expected
            # stream locks category order as well as order within each group.
            for directory in ["elisa-proof/scripts/nested", "elisa-proof/test/nested", "elisa-proof/examples/nested"]:
                return false if not make_directory(root, directory)
            for file in [
                "elisa-proof/scripts/z.sh", "elisa-proof/scripts/a.sh",
                "elisa-proof/scripts/nested/m.py", "elisa-proof/test/nested/t.py",
                "elisa-proof/examples/nested/e.elisa"
            ]:
                return false if not write_new(root, file, repeated("\n", 601))
            grouped_expected: sview = deep_expected + "file exceeds 600 lines: scripts/a.sh (601)\nfile exceeds 600 lines: scripts/z.sh (601)\nfile exceeds 600 lines: scripts/nested/m.py (601)\nfile exceeds 600 lines: test/nested/t.py (601)\nfile exceeds 600 lines: examples/nested/e.elisa (601)\n"
            return case_matches(auth, root, 1, grouped_expected)

    public:
        # Assertion bodies are data-only, but this full harness also contains
        # the separately gated native matrix. Do not auto-run it for this test.
        @test
        def source_length_oracle_admission_requires_complete_exact_observation() -> void:
            can Memory.Allocate, Abort.Panic:
                expected: sview = "file exceeds 600 lines: src/a.elisa (601)\n"
                accepted: DifferentialRun = DifferentialRun{observations: [], exit_status: 1i64, stderr: expected}
                assert expected_observation(accepted, 1i64, expected)
                assert not expected_observation(accepted, 0i64, expected)
                assert not expected_observation(accepted, 1i64, expected + "extra\n")
                assert not expected_observation(DifferentialRun{observations: [], exit_status: 1i64, stdout: "unexpected", stderr: expected}, 1i64, expected)
                assert not expected_observation(DifferentialRun{observations: [], exit_status: 1i64, error_text: "host failure", stderr: expected}, 1i64, expected)
                assert not expected_observation(DifferentialRun{observations: [], outcome: DifferentialRunOutcome.Timeout, exit_status: 1i64, stderr: expected}, 1i64, expected)
                empty: DifferentialRun = DifferentialRun{observations: []}
                assert expected_observation(empty, 0i64, "")


        def public_launcher_parity() -> bool can[Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format]:
            # This gate is inside the public entry, not just the @test wrapper.
            auth: Authorization = try authorization() else err:
                _ = write_stderr("source length parity: validation gate is not qualified\n")
                return false
            script_directory: Path = try path_real(path_parent(Script::source_path())) else err:
                _ = write_stderr("source length parity: unable to locate repository root\n")
                return false
            repository_root: Path = script_directory.parent().parent()
            if not pinned_inputs(auth, repository_root):
                _ = write_stderr("source length parity: source/tool identity check failed\n")
                return false
            root: mutable TemporaryRoot = create_root(repository_root)
            return false if not root.created
            # Even partially constructed roots reach the same cleanup path.
            matched: bool = root.ready and matrix(auth, root)
            cleaned: bool = cleanup(root)
            if not cleaned:
                _ = write_stderr(f"source length parity: cleanup failed at {root.path}\n")
                return false
            if not matched:
                _ = write_stderr("source length parity: fixture setup or expected observation failed\n")
                return false
            return pinned_inputs(auth, repository_root)


@test
def source_length_public_launcher_matches_pinned_python_reference() -> void:
    can Environment.Read, Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, File.Read, File.Write, Directory.Read, Directory.Write, Unsafe.PointerCast, Console.Write, Console.Format:
        assert EsSourceLengthLauncherParity::public_launcher_parity()
