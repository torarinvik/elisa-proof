# Pure ordering fixtures only; these do not run the filesystem audit or Python.
include "../../scripts/check_source_length.elisascript"


@test
def source_length_path_order_is_component_wise() -> void:
    can Memory.Allocate, Abort.Panic:
        ordered: darray[sview] = EsProofSourceLength::ordered_source_paths([
            "src/a.elisa", "src/a/z.elisa", "src/a-/z.elisa",
            "src/.hidden.elisa", "src/.hidden/child.elisa"
        ])
        assert ordered.count == 5
        assert ordered[0] == "src/.hidden/child.elisa"
        assert ordered[1] == "src/.hidden.elisa"
        assert ordered[2] == "src/a/z.elisa"
        assert ordered[3] == "src/a-/z.elisa"
        assert ordered[4] == "src/a.elisa"


@test
def source_length_order_preserves_duplicates_and_utf8() -> void:
    can Memory.Allocate, Abort.Panic:
        ordered: darray[sview] = EsProofSourceLength::ordered_source_paths([
            "src/\xc3\xa9.elisa", "src/z.elisa", "src/a.elisa", "src/a.elisa"
        ])
        assert ordered.count == 4
        assert ordered[0] == "src/a.elisa"
        assert ordered[1] == "src/a.elisa"
        assert ordered[2] == "src/z.elisa"
        assert ordered[3] == "src/\xc3\xa9.elisa"
        assert EsProofSourceLength::ordered_source_paths([]).count == 0
