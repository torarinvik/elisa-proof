def guarded_forward(row: u64, count: u64) -> u64:
    requires row <= count
    ensure result <= count
    return row if row >= count
    return row + 1

def guarded_reverse(row: u64, count: u64) -> u64:
    requires row <= count
    ensure result <= count
    return row if count <= row
    return row + 1

def false_unguarded_progress(row: u64, count: u64) -> u64:
    requires row <= count
    ensure result > row
    return row + 1

def false_mixed_width(row: u8, count: u64) -> u8:
    requires row <= count
    ensure result > row
    return row if row >= count
    return row + 1

def false_equal_progress(row: u64, count: u64) -> u64:
    requires row <= count
    ensure result > row
    return row if row >= count
    return row + 1
