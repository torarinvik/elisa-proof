struct BindingSinkBox:
    value: i64

def sink_assignment(value: i64) -> i64:
    requires value >= 0
    ensure result == value
    copy: mutable i64 = 0
    copy <- value
    return copy

def sink_return(value: i64) -> i64:
    requires value >= 0
    ensure result == value
    copy: i64 = value
    return copy

def sink_record_field(box: BindingSinkBox) -> i64:
    ensure result == box.value
    copy: i64 = box.value
    return copy

def sink_indexed_read(values: darray[i64]&, index: usize) -> i64:
    ensure result == values[index]
    copy: i64 = values[index]
    return copy

def sink_indexed_write(values: mutable darray[i64]&, index: usize, value: i64) -> i64:
    ensure result == value
    copy: mutable i64 = 0
    values[index] <- value
    return copy

def sink_call(value: i64) -> i64:
    ensure result == value
    copy: i64 = identity(value)
    return copy

def sink_nested_call(value: i64) -> i64:
    ensure result == value + 1
    copy: i64 = identity(value + 1)
    return copy

def sink_branch_join(value: i64, condition: bool) -> i64:
    ensure result == value
    if condition:
        copy: i64 = value
    else:
        copy: i64 = value
    return value

def identity(value: i64) -> i64:
    return value
