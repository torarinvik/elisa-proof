struct Samples:
    frames: mutable u64[32]

def clock(samples: Samples&, slot: usize, value: u64) -> u64:
    requires slot < 32
    samples.frames[slot] + value

def bounded(samples: Samples&, slot: usize, value: u64) -> u64:
    requires slot < 32
    ensure result == 0 or result < samples.frames[slot]
    elapsed: u64 = clock(samples, slot, value)
    length: u64 = samples.frames[slot]
    return 0 if length == 0
    held: u64 = elapsed if elapsed < length else length - 1
    held
