struct Store:
    count: mutable usize
    flags: mutable bool[4]
def checked(store: mutable Store&) -> void:
    return if store.count >= 4
    found: usize =
        for index in 0..<4 |hit: usize = 4, store| -> hit:
            invariant hit <= 4
            break index if store.flags[index]
    slot: usize = store.count
    store.flags[slot] <- false
