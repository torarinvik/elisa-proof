# Scalar cast syntax is resolved before ordinary UFCS function lookup, so an ordinary function
# named after a numeric target must not suppress proofs about the builtin conversion.
def i64(value: u8) -> i64:
    return 0

extern u64(value: u8) -> u64

def ordinary_i64_selector_does_not_shadow_cast(value: u8) -> i64:
    ensure result >= 0
    ensure result <= 255
    return value.i64()

def extern_u64_selector_does_not_shadow_cast(value: u8) -> u64:
    ensure result <= 255
    return value.u64()
