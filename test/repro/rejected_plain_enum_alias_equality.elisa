enum Device:
    Keyboard
    Mouse
type AliasDevice = Device

protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for AliasDevice:
    def __eq__(self: AliasDevice, other: AliasDevice) -> bool:
        false

def alias_equality_is_not_builtin(device: AliasDevice) -> bool:
    ensure result
    device == AliasDevice.Keyboard
