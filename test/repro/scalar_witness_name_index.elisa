include "../../../Elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa"
include "../../../Elisa-compiler/elisacore_std/collections.elisa"
include "../../../Elisa-compiler/elisacore_std/elisacore_runtime_strings.elisa"
include "../../../Elisa-compiler/src/semantic/semantic.elisa"
include "../../src/proof/kernel_core.elisa"
include "../../src/proof/operator_impl_model.elisa"
include "../../src/proof/model/enum_index.elisa"
include "../../src/proof/model/findings.elisa"
include "../../src/proof/model.elisa"
include "../../src/proof/model/lemma_table.elisa"
include "../../src/proof/kernel.elisa"
include "../../src/proof/kernel_intern.elisa"
include "../../src/proof/expr.elisa"
include "../../src/proof/linear.elisa"
include "../../src/proof/resources.elisa"
include "../../src/proof/check.elisa"
include "../../src/proof/kernel_replay.elisa"
include "../../src/proof/replay.elisa"
include "../../src/proof/tactics.elisa"

using Ast
using ElisaProof

extend ElisaProof:
    public:
        def test_scalar_name_linear_oracle(facts: darray[Ast::Expr]&, name: sview) -> bool:
            return false if name == ""
            for fact in facts:
                return true if proof_scalar_marker_name(fact) == name
                return true if proof_unsigned_marker_name(fact) == name
            return false

        def test_scalar_name_index_parity(facts: darray[Ast::Expr]&, queries: darray[sview]&) -> bool:
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            for name in queries |name, markers, facts|:
                return false if proof_scalar_witnesses_name(markers, name) != test_scalar_name_linear_oracle(facts, name)
            return true

        def test_make_scalar_marker(name: sview, position: Ast::Pos) -> Ast::Expr:
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), [Ast::Expr.Ident(name, position)], [], position)

        def test_make_unsigned_marker(name: sview, position: Ast::Pos) -> Ast::Expr:
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_unsigned_type_bound", position), [Ast::Expr.Ident(name, position), Ast::Expr.IntLit(8, position)], [], position)

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    position: Ast::Pos = Ast::pos_at_line(1)

    # This pair has the same complete 32-bit FNV-1a hash, not merely the same
    # table bucket. Exact string equality must reject the non-member candidate.
    collision_a: sview = "r019-s6WXBpYWBJfn"
    collision_b: sview = "r019-u22pK2GiCukM"
    collision_facts: mutable darray[Ast::Expr] = [test_make_scalar_marker(collision_a, position)]
    collision_queries: darray[sview] = [collision_a, collision_b, "absent", ""]
    return 2 if not test_scalar_name_index_parity(collision_facts, collision_queries)
    collision_markers: ProofScalarWitnesses = proof_scalar_witness_markers(collision_facts)
    return 3 if proof_scalar_witnesses_name(collision_markers, collision_b)

    # Duplicate markers remain in source order; the lookup remains a membership
    # predicate and must agree with the old scan regardless of marker kind/order.
    ordered_facts: mutable darray[Ast::Expr] = [
        Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), [], [], position),
        test_make_scalar_marker("first", position),
        test_make_unsigned_marker("second", position),
        test_make_scalar_marker("first", Ast::pos_at_line(2)),
        test_make_unsigned_marker("third", position),
        test_make_scalar_marker("second", position)
    ]
    ordered_queries: darray[sview] = ["first", "second", "third", "missing", ""]
    return 4 if not test_scalar_name_index_parity(ordered_facts, ordered_queries)
    markers: ProofScalarWitnesses = proof_scalar_witness_markers(ordered_facts)
    expected_order: darray[sview] = ["first", "second", "first", "third", "second"]
    return 5 if markers.names.count != expected_order.count
    for index in 0..<expected_order.count |index, markers, expected_order|:
        return 6 if markers.names[index] != expected_order[index]

    # Identical source spelling at distinct positions models a shadowed binding:
    # this index keys names only and must not accidentally depend on marker order
    # or source position to answer the legacy bare-name query.
    shadowed_facts: mutable darray[Ast::Expr] = [
        test_make_scalar_marker("shadow", Ast::pos_at_line(10)),
        test_make_scalar_marker("other", Ast::pos_at_line(11)),
        test_make_scalar_marker("shadow", Ast::pos_at_line(20))
    ]
    shadowed_queries: darray[sview] = ["shadow", "other", "missing", ""]
    return 7 if not test_scalar_name_index_parity(shadowed_facts, shadowed_queries)
    shadowed_markers: ProofScalarWitnesses = proof_scalar_witness_markers(shadowed_facts)
    return 8 if shadowed_markers.names.count != 3
    return 9 if shadowed_markers.names[0] != shadowed_markers.names[2]
    return 0
