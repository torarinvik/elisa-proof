# A generic helper cannot assume that independent region parameters are distinct:
# a caller may instantiate both with the same arena. Freeing the arena must not
# leave the helper able to read the borrowed view afterward.
include "../../Elisa-compiler/elisacore_std/arena.elisa"
include "../../Elisa-compiler/elisacore_std/collections.elisa"
include "../../Elisa-compiler/elisacore_std/elisacore_runtime_strings.elisa"

def make_view[@r](arena: mutable Arena& @r) -> sview @r can Memory.Allocate, Abort.Panic:
    in arena:
        bytes: mutable darray[u8] = []
        bytes.push(65)
        return bytes.as_sview()

def generic_reset_then_read[@arena, @view](arena: mutable Arena& @arena, view: sview @view) -> i64 can Memory.Release, Abort.Panic:
    arena_free(arena)
    return view[0].i64()

def main() -> i64 can Memory.Allocate, Memory.Release, Abort.Panic:
    arena: mutable Arena = zeroed
    view: sview = make_view(&arena)
    return generic_reset_then_read(&arena, view)
