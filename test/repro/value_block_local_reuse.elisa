def device_index(flag: bool) -> usize:
    ensure result < 4
    return 0
struct Binding:
    code: i64
struct Store:
    bindings: mutable Binding[4]
    flags: mutable bool[4]
def checked(store: mutable Store&, flag: bool) -> void:
    available: bool =
        slot: usize = device_index(flag)
        store.flags[slot]
    return if not available
    for index in 0..<4 |store, flag|:
        binding: Binding = store.bindings[index]
        if binding.code == 0:
            local: usize = 0
            store.flags[index] <- false
        slot: usize = 0
        active: bool = binding.code == 0 or store.flags[index] or flag
        store.flags[index] <- active
