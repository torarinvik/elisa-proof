# Elisa resolves an exact source/target __cast__ hook before the builtin conversion.
# Its declared result type is known, but its value is not the builtin's value-preserving cast.
type Byte = u8

def __cast__(value: Byte) -> i64:
    return 1000

def rejected_custom_cast_range(value: u8) -> i64:
    ensure result <= 255
    return value.i64()

def rejected_custom_cast_identity(value: u8) -> i64:
    ensure result == value
    return value.i64()

def rejected_custom_cast_monotonicity(value: u8) -> i64:
    requires value < 255
    ensure result <= value + 1
    return value.i64()

def rejected_custom_cast_reference_write(value: u8, target: mutable i64&) -> void:
    ensure target == value
    changes target
    target <- value.i64()
    return

def custom_cast_direct_call(value: Byte) -> i64:
    ensure result == 1000
    return __cast__(value)
