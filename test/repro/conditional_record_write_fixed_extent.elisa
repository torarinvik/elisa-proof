struct Store:
    count: mutable usize
    flags: mutable bool[4]
    active: mutable bool
def checked(store: mutable Store&) -> void:
    for index in 0..<4 |store|:
        break if index >= store.count
        if store.flags[index]:
            store.active <- true
        first: bool = store.flags[index]
        store.flags[index] <- false
        second: bool = store.flags[index]
