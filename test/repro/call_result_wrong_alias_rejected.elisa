def cap(part: u64, whole: u64) -> u64:
    requires part < whole and whole <= 10000
    ensure result < 750
    part * 750 / whole

# The first call returns 75, but the returned second result is 150.
def wrong_result_alias() -> u64:
    ensure result == 75
    first: u64 = cap(1, 10)
    second: u64 = cap(2, 10)
    second
