def cap(part: u64, whole: u64) -> u64:
    requires part < whole and whole <= 10000
    ensure result < 750
    part * 750 / whole

def gain(threshold: u64, full: u64, drop: u64) -> u64:
    requires threshold < full and full <= 10000
    ensure result <= 998
    return 0 if drop < threshold
    return 0 if drop >= full
    share: u64 = cap(drop - threshold, full - threshold)
    250 + share
