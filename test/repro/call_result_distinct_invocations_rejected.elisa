def cap(part: u64, whole: u64) -> u64:
    requires part < whole and whole <= 10000
    ensure result < 750
    part * 750 / whole

# Distinct calls return 75 and 150; their results must never share identity.
def distinct_invocations() -> u64:
    ensure result == 0
    first: u64 = cap(1, 10)
    second: u64 = cap(2, 10)
    first - second
