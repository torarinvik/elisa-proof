def clamp_i(value: i64, low: i64, high: i64) -> i64:
    requires low <= high
    ensure result >= low
    ensure result <= high
    return low if value < low
    return high if value > high
    value

def window(frame: i64, before: i64, count: i64) -> i64:
    requires count >= 1 and count <= 1000000000
    ensure result >= 0
    ensure result <= count - 1
    first: i64 = clamp_i(frame, 0, count - 1)
    span: i64 = clamp_i(before, 0, 1000000)
    clamp_i(first - span, 0, count - 1)
