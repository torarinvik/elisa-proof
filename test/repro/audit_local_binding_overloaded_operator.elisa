protocol Add:
    def __add__(self: Self, other: Self) -> Self

impl Add for i64:
    def __add__(self: i64, other: i64) -> i64:
        return 0

def overloaded_add_does_not_keep_source_bound(row: i64) -> i64:
    requires row >= 0 and row < 8
    ensure result != 0
    converted: i64 = row + 1
    return converted
