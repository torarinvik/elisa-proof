def direct_literal_denial(value: u8) -> u8:
    requires not true or value == 7
    ensure result == 7
    return value

def nested_literal_denials(value: u8) -> u8:
    requires not true or not true or value == 7
    ensure result == 7
    return value

def parenthesized_literal_denial(value: u8) -> u8:
    requires not (true) or value == 7
    ensure result == 7
    return value

def repeated_literal_negation(value: u8) -> u8:
    requires not (not (not true)) or value == 7
    ensure result == 7
    return value

def selector(next_match: bool, present: bool) -> u8:
    ensure not next_match or not present or result == 1
    return 1 if next_match and present
    return 3

def checked_call_literal_denial() -> u8:
    ensure result == 1
    return selector(true, true)

def rejected_true_alternative(value: u8) -> u8:
    requires not false or value == 7
    ensure result == 7
    return value

def rejected_symbolic_alternative(condition: bool, value: u8) -> u8:
    requires not condition or value == 7
    ensure result == 7
    return value

def rejected_wrong_literal_value(value: u8) -> u8:
    requires not true or value == 7
    ensure result == 8
    return value

def rejected_wrong_checked_result() -> u8:
    ensure result == 3
    return selector(true, true)
