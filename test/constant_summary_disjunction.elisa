def constant_summary(future: u8, nanos: u32) -> u8:
    ensure result <= 2
    ensure future != 1 or nanos > 999999999u32 or result == 1
    return 2 if future > 1 or nanos > 999999999u32
    return 1 if future == 1
    return 0

def valid_summary_caller() -> u8:
    ensure result == 1
    return constant_summary(1, 0u32)

def rejected_summary_caller() -> u8:
    ensure result == 0
    return constant_summary(1, 0u32)

def wide_summary(future: u8, seconds: u64, nanos: u32, limit: u64) -> u8:
    ensure result <= 2
    ensure future != 1 or nanos > 999999999u32 or result == 1
    return 2 if future > 1 or nanos > 999999999u32
    return 1 if future == 1
    return 0 if seconds > limit
    return 0 if seconds == limit and nanos > 0
    return 1

def valid_wide_summary_caller() -> u8:
    ensure result == 1
    return wide_summary(1, 0u64, 0u32, 900u64)

def rejected_wide_summary_caller() -> u8:
    ensure result == 0
    return wide_summary(1, 0u64, 0u32, 900u64)

def four_argument_summary(future: u8, seconds: u32, nanos: u32, limit: u32) -> u8:
    ensure result <= 2
    ensure future != 1 or nanos > 999999999u32 or result == 1
    return 2 if future > 1 or nanos > 999999999u32
    return 1 if future == 1
    return 0 if seconds > limit
    return 0 if seconds == limit and nanos > 0
    return 1

def valid_four_argument_caller() -> u8:
    ensure result == 1
    return four_argument_summary(1, 0u32, 0u32, 900u32)

def exact_four_argument_summary(first: u8, second: u32, third: u32, fourth: u32) -> u8:
    ensure result == 1
    return 1

def exact_four_argument_caller() -> u8:
    ensure result == 1
    return exact_four_argument_summary(1, 0u32, 0u32, 900u32)

def rejected_call_arithmetic_wrap() -> u8:
    ensure result == 255
    return constant_summary(1, 0u32) + 255
