def stride_index_write(output: mutable array[u8, 8]&, index: usize) -> u8:
    requires index < 4
    output[index * 2] <- 7
    return 1

def stride_index_write_offset(output: mutable array[u8, 8]&, index: usize) -> u8:
    requires index < 4
    output[index * 2 + 1] <- 7
    return 1

# Missing bound must not be admitted by recognizing the access expression.
def rejected_stride_index_write_missing_bound(output: mutable array[u8, 8]&, index: usize) -> u8:
    output[index * 2] <- 7
    return 1
