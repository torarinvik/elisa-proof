def unsigned_span_full_width(start: u64, end: u64, next: u64) -> bool:
    requires start < end
    requires next == start + 1
    ensure end - next < end - start
    return true

def unsigned_span_reversed_equation(start: u64, end: u64, next: u64) -> bool:
    requires start < end
    requires start + 1 == next
    ensure end - next < end - start
    return true
