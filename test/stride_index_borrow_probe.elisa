def stride_index_borrow_disjoint(values: mutable i64[8], index: usize) -> i64:
    requires index < 4
    shared: i64& = &values[index * 2]
    exclusive: mutable i64& = &values[index * 2 + 1]
    return values[0]

def rejected_stride_index_borrow_same_element(values: mutable i64[8], index: usize) -> i64:
    requires index < 4
    shared: i64& = &values[index * 2]
    exclusive: mutable i64& = &values[2 * index]
    return values[0]
