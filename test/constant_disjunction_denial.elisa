def closed_order_denial(value: u8) -> u8:
    requires 1 != 1 or 0u32 > 999999999u32 or value == 7
    ensure result == 7
    return value
def reversed_order_denial(value: u8) -> u8:
    requires 999999999u32 < 0u32 or value == 7
    ensure result == 7
    return value
def rejected_true_order(value: u8) -> u8:
    requires 0u32 < 999999999u32 or value == 7
    ensure result == 7
    return value
def rejected_symbolic_order(other: u32, value: u8) -> u8:
    requires other > 999999999u32 or value == 7
    ensure result == 7
    return value
def rejected_wrong_value(value: u8) -> u8:
    requires 0u32 > 999999999u32 or value == 7
    ensure result == 8
    return value

def full_width_order_denial(value: u8) -> u8:
    requires 0u64 >= 18446744073709551615u64 or value == 7
    ensure result == 7
    return value

def rejected_true_full_width_order(value: u8) -> u8:
    requires 0u64 < 18446744073709551615u64 or value == 7
    ensure result == 7
    return value
