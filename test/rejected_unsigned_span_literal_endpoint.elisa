def rejected_literal_endpoint_missing_guard(start: usize, next: usize) -> bool:
    requires next == start + 1
    ensure 64 - next < 64 - start
    return true

def rejected_literal_endpoint_mismatch(start: usize, next: usize) -> bool:
    requires start < 64
    requires next == start + 1
    ensure 65 - next < 64 - start
    return true
