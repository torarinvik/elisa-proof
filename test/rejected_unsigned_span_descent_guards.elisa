# Missing start<end permits unsigned wrap in the increment/subtractions.
def rejected_span_missing_wrap_guard(start: u64, end: u64, next: u64) -> bool:
    requires next == start + 1
    ensure end - next < end - start
    return true

# The subtraction endpoints must be identical, not merely equally typed.
def rejected_span_different_endpoint(start: u64, end: u64, other: u64, next: u64) -> bool:
    requires start < end
    requires next == start + 1
    ensure other - next < end - start
    return true

# An unrelated increment equation cannot witness this next cursor.
def rejected_span_wrong_alias(start: u64, end: u64, next: u64, unrelated: u64) -> bool:
    requires start < end
    requires unrelated == start + 1
    ensure end - next < end - start
    return true
