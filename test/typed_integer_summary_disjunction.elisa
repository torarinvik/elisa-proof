def checked_child(root: u64, limit: u64) -> u64:
    ensure result == 0 or result > root
    ensure result == 0 or result < limit
    return 0 if root >= limit / 2
    child: u64 = root * 2 + 1
    return 0 if child <= root or child >= limit
    return child

def valid_context_typed_summary() -> u64:
    ensure result < 2
    return checked_child(0u64, 2u64)

def rejected_different_literal() -> u64:
    ensure result < 1
    return checked_child(0u64, 2u64)
