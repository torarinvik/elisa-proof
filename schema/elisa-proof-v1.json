{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elisa-lang.org/schemas/elisa-proof-v1.json",
  "title": "Elisa proof JSON report v1",
  "description": "Compatibility schema for reports emitted before protocol_version was introduced. Unknown fields are allowed so additive report extensions remain readable.",
  "type": "object",
  "required": ["status", "verification_state", "engine_state", "source", "summary", "replay", "kernel", "findings", "goals"],
  "properties": {
    "status": { "type": "string", "enum": ["proved", "failed", "proved_with_replay_gaps"] },
    "verification_state": { "type": "string", "enum": ["proved", "disproved", "unsupported", "unknown"] },
    "engine_state": { "type": "string", "enum": ["proved", "failed", "unknown"] },
    "source": { "type": "object", "required": ["bytes", "fingerprint"], "properties": { "bytes": { "type": "integer", "minimum": 0 }, "fingerprint": { "type": "object", "required": ["algorithm", "value"], "properties": { "algorithm": { "type": "string" }, "value": { "type": "integer", "minimum": 0 } } } } },
    "summary": { "type": "object", "required": ["declarations", "obligations", "proven", "unproven", "failed", "finding_count"] },
    "replay": { "type": "object", "required": ["certificates", "replayed", "gaps"] },
    "kernel": { "type": "object", "required": ["format", "independent_replay", "nodes", "children"] },
    "findings": { "type": "array" },
    "goals": { "type": "array" }
  },
  "additionalProperties": true
}
