{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elisa-lang.org/schemas/elisa-proof-v2.json",
  "title": "Elisa proof JSON report v2",
  "description": "Version 2 adds an explicit protocol_version field to the v1 report shape. Unknown fields remain allowed for additive evolution.",
  "allOf": [
    { "$ref": "elisa-proof-v1.json" },
    {
      "type": "object",
      "required": ["protocol_version"],
      "properties": { "protocol_version": { "const": 2 } }
    },
    {
      "if": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "proved" } }
      },
      "then": {
        "type": "object",
        "properties": {
          "verification_state": { "const": "proved" },
          "engine_state": { "const": "proved" },
          "summary": {
            "type": "object",
            "required": ["obligations", "proven", "unproven", "failed", "finding_count"],
            "properties": {
              "unproven": { "const": 0 },
              "failed": { "const": 0 },
              "finding_count": { "const": 0 }
            }
          },
          "findings": { "type": "array", "maxItems": 0 },
          "replay": {
            "type": "object",
            "required": ["certificates", "replayed", "gaps"],
            "properties": { "gaps": { "const": 0 } }
          },
          "kernel": {
            "type": "object",
            "required": ["independent_replay"],
            "properties": { "independent_replay": { "const": true } }
          }
        }
      }
    }
  ]
}
