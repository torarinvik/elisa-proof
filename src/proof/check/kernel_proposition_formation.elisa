# Charge and run one proposition-typing pass against its source-derived local environment.
extend ElisaProof:
    private:
        def proof_source_kernel_proposition_formed[@r](expression: Ast::Expr, names: darray[sview]&, types: darray[sview]&, source_types: darray[Ast::Expr]&, module_path: darray[sview]&, global_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], workspace: mutable ProofSourceKernelFormationWorkspace& @r, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace& @r, file: Ast::File&, failure: mutable sview&) -> bool can[Memory.Allocate, Abort.Panic]:
            if workspace.typing_work_used >= ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_BUDGET:
                failure <- "kernel proposition typing work budget exceeded"
                return false
            workspace.nodes.clear()
            workspace.children.clear()
            root: usize = proof_kernel_encode_annotated(expression, &workspace.nodes, &workspace.children, file.enum_annotations)
            if root >= workspace.nodes.count:
                failure <- "kernel proposition term exceeded its bounded arena"
                return false
            typing: (known: bool, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) = proof_source_kernel_type_environment(names, types, source_types, module_path, global_bindings, workspace, file.top_decls, workspace.scoped_function_index)
            if workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                failure <- "kernel source work budget exceeded"
                return false
            failure <- "local-context-unrepresented" if not typing.known
            return false if not typing.known
            if global_bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET:
                workspace.typing_work_used <- ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_BUDGET
                failure <- "kernel proposition typing work budget exceeded"
                return false
            remaining_bindings: usize = ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET - global_bindings.count
            if typing.environment.bindings.count > remaining_bindings:
                workspace.typing_work_used <- ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_BUDGET
                failure <- "kernel proposition typing work budget exceeded"
                return false
            total_bindings: usize = global_bindings.count + typing.environment.bindings.count
            node_count: usize = workspace.nodes.count
            per_binding_limit: usize = ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_BUDGET / ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_FACTOR / node_count
            if total_bindings > per_binding_limit:
                workspace.typing_work_used <- ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_BUDGET
                failure <- "kernel proposition typing work budget exceeded"
                return false

            # The static product guard above bounds each proposition independently. The shared
            # counter below tracks actual kernel typing operations, not a source-side estimate;
            # the global type index is reused and must not be charged again per proposition.
            formed: bool = (ElisaProofKernelReplay::proof_kernel_replay_proposition_formation_report_with_cached_globals_and_work(&workspace.nodes, &workspace.children, typing.environment.bindings, [], root, validation_workspace, &workspace.typing_workspace, &workspace.typing_work_used) can[Global{Read,Write}])
            failure <- "term-sort-or-operator-rejected" if not formed and failure == ""
            return formed
