extend ElisaProof:
    private:
        # Primitive types normally use the language's built-in operators, but Elisa also permits
        # protocol implementations for a concrete primitive spelling. Follow aliases and storage
        # wrappers while looking for that implementation; otherwise a primitive scalar witness
        # could accidentally bless a user-defined equality as if it were Leibniz equality.
        #
        # The walk is the same for every protocol, so collect the reachable names once and share
        # the source-work meter across the type walk, alias scans, and protocol/name checks.
        def proof_type_operator_impl_names(expression: Ast::Expr, report: ProofReport&, names: mutable darray[sview]&, depth: usize, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if not proof_type_audit_work_charge(sview_len(name), source_work)
                    names.push(name)
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_with_work(report.source_declarations, name, 0, source_work)
                    return false if:
                        source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        alias.count > 1
                        alias.count == 1 and proof_type_alias_root_count_with_work(report.source_declarations, name, 0, source_work) != 1
                        source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_type_operator_impl_names(alias.target, report, names, depth + 1, source_work) if alias.count == 1
                Ast::Expr.Scope(_, name, _):
                    # The exact owner path is resolved by the enum witness path below. Keep the
                    # source spelling here only for the operator-override scan; matching an
                    # unrelated same-leaf implementation can suppress a builtin witness, but
                    # cannot grant one.
                    return false if not proof_type_audit_work_charge(sview_len(name), source_work)
                    names.push(name)
                Ast::Expr.Paren(inner, _):
                    return proof_type_operator_impl_names(inner, report, names, depth + 1, source_work)
                Ast::Expr.Refinement(base, _, _):
                    return proof_type_operator_impl_names(base, report, names, depth + 1, source_work)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_type_operator_impl_names(inner, report, names, depth + 1, source_work) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    pass
            return true

        def proof_add_primitive_operator_witnesses_with_aliases_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, position: Ast::Pos, caller_scope: darray[sview]&, caller_module: sview, module_aliases: ProofModuleAliasIndex&, declaration_line: u32, source_work: mutable usize&) -> bool:
            return false if not report.operator_impls.valid
            return true if proof_resource_type_mentions_owner_generic_with_work(type_expression, declaration_line, report.source_generic_param_lines, report.source_generic_param_names, report.source_effect_index, report.source_generic_params_valid and report.source_generic_param_lines.count == report.source_generic_param_names.count, source_work, 0)
            names: mutable darray[sview] = []
            return false if:
                not proof_type_operator_impl_names(type_expression, report, &names, 0, source_work)
                source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
            witnessed_protocols: mutable darray[sview] = []
            for protocol in protocols |facts, report, root, names, position, source_work, witnessed_protocols|:
                return false if not proof_type_audit_work_charge(1 + sview_len(protocol), source_work)
                has_impl: mutable bool = false
                for name in names |report, protocol, source_work, has_impl|:
                    return false if not proof_type_audit_work_charge(1 + sview_len(name) + sview_len(protocol), source_work)
                    implementation: (complete: bool, exists: bool) = proof_report_builtin_operator_impl_exists_with_work(report, name, protocol, source_work)
                    return false if not implementation.complete
                    has_impl <- true if implementation.exists
                witnessed_protocols.push(protocol) if has_impl
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            enum_name: sview = proof_plain_enum_builtin_equality_type_with_work(type_expression, "", report, source_work)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for protocol in witnessed_protocols |facts, report, root, position|:
                marker: Ast::Expr = proof_untrusted_operator_marker(root, protocol, position)
                proof_add_type_bound_fact(facts, report, marker, position.line, report.type_bounds.owner)
            return false if:
                not proof_add_const_enum_member_scalar_witnesses_with_work(facts, report, type_expression, caller_scope, caller_module, module_aliases, declaration_line, position.line, report.type_bounds.owner, position, source_work)
                not proof_add_const_enum_value_exclusions_with_work(facts, report, root, type_expression, position, source_work)
            proof_add_type_bound_fact(facts, report, proof_builtin_operator_marker(root, "Eq", position), position.line, report.type_bounds.owner) if enum_name != ""
            return true

        def proof_add_primitive_operator_witnesses_with_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, position: Ast::Pos, caller_scope: darray[sview]&, declaration_line: u32, source_work: mutable usize&) -> bool:
            empty_aliases: ProofModuleAliasIndex = proof_operator_enum_empty_module_alias_index()
            proof_add_primitive_operator_witnesses_with_aliases_work(facts, report, root, type_expression, position, caller_scope, "", empty_aliases, declaration_line, source_work)

        def proof_add_primitive_operator_witnesses(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, position: Ast::Pos) -> void:
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            empty_scope: darray[sview] = []
            proof_add_primitive_operator_witnesses_with_work(facts, report, root, type_expression, position, empty_scope, 0, &source_work)
            report.source_effect_index.implicit_effect_work <- source_work

        def proof_add_primitive_operator_witnesses_in_scope(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, position: Ast::Pos, caller_scope: darray[sview]&, declaration_line: u32) -> void:
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            proof_add_primitive_operator_witnesses_with_work(facts, report, root, type_expression, position, caller_scope, declaration_line, &source_work)
            report.source_effect_index.implicit_effect_work <- source_work

        def proof_add_primitive_operator_witnesses_in_scope_with_aliases(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, position: Ast::Pos, caller_scope: darray[sview]&, caller_module: sview, module_aliases: ProofModuleAliasIndex&, declaration_line: u32) -> void:
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            proof_add_primitive_operator_witnesses_with_aliases_work(facts, report, root, type_expression, position, caller_scope, caller_module, module_aliases, declaration_line, &source_work)
            report.source_effect_index.implicit_effect_work <- source_work
