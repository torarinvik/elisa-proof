# Repeated checks of one source assignment share a witness only for the same typed input term.
# Replay still independently checks source identity, reaching state and witness uniqueness.
extend ElisaProof:
    private:
        def proof_unsigned_rebind_site_equal(left: Ast::Pos, right: Ast::Pos) -> bool:
            return left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        def proof_unsigned_rebind_existing_width(report: ProofReport&, owner: sview, symbol: sview, width: i64, position: Ast::Pos) -> bool:
            for trace in report.traces.records |trace, owner, symbol, width, position|:
                continue if trace.kind != "type-bound" or trace.name != owner or trace.line != position.line
                match trace.expression:
                    Ast::Expr.Call(Ast::Expr.Ident(marker, _), arguments, argument_names, _):
                        continue if marker != "__elisa_unsigned_type_bound" or arguments.count != 2 or argument_names.count != 0
                        match arguments[0]:
                            Ast::Expr.Ident(name, symbol_position):
                                continue if name != symbol or not proof_unsigned_rebind_site_equal(symbol_position, position)
                                match arguments[1]:
                                    Ast::Expr.IntLit(bits, _):
                                        return bits == width
                                    _:
                                        pass
                            _:
                                pass
                    _:
                        pass
            return false

        def proof_unsigned_rebind_existing_symbol(report: ProofReport&, owner: sview, width: i64, value: Ast::Expr, position: Ast::Pos) -> sview:
            for trace in report.traces.records |trace, report, owner, width, value, position|:
                continue if trace.kind != "local-binding" or trace.name != owner or trace.line != position.line
                match trace.expression:
                    Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, existing, _):
                        continue if not proof_internal_name_is_rebind(symbol) or not proof_unsigned_rebind_site_equal(symbol_position, position)
                        return symbol if proof_expr_equal(existing, value) and proof_unsigned_rebind_existing_width(report, owner, symbol, width, position)
                    _:
                        pass
            return ""

        def proof_unsigned_rebind_symbol(report: mutable ProofReport&, owner: sview, width: i64, value: Ast::Expr, position: Ast::Pos) -> sview:
            existing: sview = proof_unsigned_rebind_existing_symbol(report, owner, width, value, position)
            return existing if existing != "" else proof_rebind_symbol(report)
