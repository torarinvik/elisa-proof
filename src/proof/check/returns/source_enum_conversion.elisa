extend ElisaProof:
    private:
        # A qualified member of a uniquely declared const enum is a pure source value.
        # Preserve its builtin integer conversion as a term at the return boundary, while
        # leaving numeric evaluation to a separate source-backed value proof.
        def proof_return_source_enum_conversion(expression: Ast::Expr, functions: ProofFunctionTable&, report: ProofReport&) -> bool:
            match proof_strip_parens(expression):
                Ast::Expr.Call(callee, arguments, _, _):
                    conversion: (known: bool, receiver: Ast::Expr) = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                    return false if not conversion.known
                    match conversion.receiver:
                        Ast::Expr.Field(enum_type, member_name, _):
                            return proof_exact_const_enum_member_owner(enum_type, member_name, report.source_declarations).known
                        _:
                            return false
                _:
                    return false
