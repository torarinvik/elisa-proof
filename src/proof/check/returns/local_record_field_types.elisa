extend ElisaProof:
    private:
        # This first local-record transition accepts a deliberately small source shape.
        # It cannot hide binders, address-taking, calls, or ownership changes in expressions.
        def proof_local_record_expression_closed(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_local_record_expression_closed(object, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_local_record_expression_closed(inner, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_local_record_expression_closed(inner, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return (proof_is_comparison(operator) or operator == TokenKind.And or operator == TokenKind.Or) and proof_local_record_expression_closed(left, depth + 1) and proof_local_record_expression_closed(right, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |depth|:
                        return false if not proof_local_record_expression_closed(field.value, depth + 1)
                    return true
                _:
                    return false

        # Resolve only an explicit record declaration, without stripping a reference or
        # following an alias that might denote reference storage.
        def proof_local_direct_record_name(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_local_direct_record_name(inner, depth + 1)
                Ast::Expr.Unary(TokenKind.Mutable, inner, _):
                    return proof_local_direct_record_name(inner, depth + 1)
                _:
                    return ""

        # Require a unique declaration at function scope. Shadowing or an unsupported
        # binding construct rejects the transition, even when it appears on another path.
        def proof_local_record_in_body(body: darray[Ast::Stmt]&, wanted: sview, depth: usize) -> (count: usize, record: sview):
            return (2, "") if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            record: mutable sview = ""
            for statement in body |body, wanted, depth, count, record|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, _):
                        return (2, "") if not proof_local_record_expression_closed(initializer, 0)
                        if local_name == wanted:
                            return (2, "") if depth != 0 or count != 0
                            count <- 1
                            record <- proof_local_direct_record_name(type_expression, 0)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return (2, "") if not proof_local_record_expression_closed(condition, 0)
                        first: (count: usize, record: sview) = proof_local_record_in_body(then_body, wanted, depth + 1)
                        second: (count: usize, record: sview) = proof_local_record_in_body(else_body, wanted, depth + 1)
                        return (2, "") if first.count > 0 or second.count > 0
                    Ast::Stmt.While(condition, loop_body, _):
                        return (2, "") if not proof_local_record_expression_closed(condition, 0)
                        nested: (count: usize, record: sview) = proof_local_record_in_body(loop_body, wanted, depth + 1)
                        return (2, "") if nested.count > 0
                    Ast::Stmt.Assign(target, _, initializer, _):
                        return (2, "") if not proof_local_record_expression_closed(target, 0) or not proof_local_record_expression_closed(initializer, 0)
                    Ast::Stmt.Contract(_, expression, _):
                        return (2, "") if not proof_local_record_expression_closed(expression, 0)
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return (2, "") if not proof_local_record_expression_closed(returned, 0)
                    _:
                        return (2, "")
            return (count, record)

        def proof_local_record_source(declarations: darray[Ast::Decl]&, owner: sview, wanted: sview, depth: usize) -> (owners: usize, count: usize, record: sview):
            return (2, 2, "") if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            owners: mutable usize = 0
            count: mutable usize = 0
            record: mutable sview = ""
            for declaration in declarations |declarations, owner, wanted, depth, owners, count, record|:
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, _):
                        if name == owner:
                            owners <- owners + 1
                            local: (count: usize, record: sview) = proof_local_record_in_body(body, wanted, 0)
                            count <- count + local.count
                            record <- local.record if local.count == 1
                    Ast::Decl.Module(_, body, _):
                        nested: (owners: usize, count: usize, record: sview) = proof_local_record_source(body, owner, wanted, depth + 1)
                        owners <- owners + nested.owners
                        count <- count + nested.count
                        record <- nested.record if nested.count == 1
                    Ast::Decl.Scoped(body, _):
                        nested: (owners: usize, count: usize, record: sview) = proof_local_record_source(body, owner, wanted, depth + 1)
                        owners <- owners + nested.owners
                        count <- count + nested.count
                        record <- nested.record if nested.count == 1
                    _:
                        pass
            return (owners, count, record)

        def proof_unaliased_local_record_field(target: Ast::Expr, names: darray[sview]&, frame_parameters: darray[sview]&, report: ProofReport&, owner: sview) -> bool:
            match target:
                Ast::Expr.Field(Ast::Expr.Ident(root, _), field, _):
                    return false if root == "" or field == "" or proof_current_parameter(names, frame_parameters, root)
                    return false if report.aliased_owner != owner or owner == "" or not (any live in names where live == root)
                    return false if any aliased in report.aliased_names where aliased == root or aliased == "*"
                    return false if any escaping in report.escaping_names where escaping == root or escaping == "*"
                    source: (owners: usize, count: usize, record: sview) = proof_local_record_source(report.source_declarations, owner, root, 0)
                    return false if source.owners != 1 or source.count != 1 or source.record == ""
                    fields: mutable darray[sview] = []
                    return false if proof_struct_field_names(report.source_declarations, source.record, 0, &fields) != 1
                    return proof_struct_field_type(report.source_declarations, source.record, field, 0).count == 1
                _:
                    return false
