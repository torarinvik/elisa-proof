extend ElisaProof:
    private:
        def proof_check_return_contracts[@r](statement: Ast::Stmt, moved_roots: darray[sview], names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]& @r, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, flow: mutable ProofFlow&) -> bool can[Global.Read, Global.Write]:
            match statement:
                Ast::Stmt.Contract(kind, expression, position):
                    if kind == "assert":
                        prepared_assertion: (ready: bool, expression: Ast::Expr) = proof_return_substitution_prepare(expression, names, values, report, name, position.line)
                        if not prepared_assertion.ready:
                            report.proof_obligation(false)
                            flow.normal <- false
                            flow.valid <- false
                            return true
                        assertion: mutable Ast::Expr = prepared_assertion.expression
                        assertion_has_call: bool = proof_expr_has_call(expression)
                        assertion_has_move: bool = proof_expr_has_move(expression)
                        assertion_has_overloaded_operator: bool = proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
                        assertion_may_mutate_state: bool = assertion_has_call or assertion_has_move or assertion_has_overloaded_operator
                        # The assertion expression is evaluated at runtime before its
                        # proposition becomes a fact. Calls, ownership transfers and
                        # source-overloaded operators can invalidate prior state, so discard all
                        # pre-evaluation facts.
                        if not lemma_steps:
                            (proof_check_frame_calls_in_expression(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write}) if assertion_has_call
                            proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position) if assertion_may_mutate_state
                            (proof_clear_facts_after_call(facts, names, frame_parameters, report, name) can Global{Read,Write}) if assertion_may_mutate_state
                        if lemma_steps:
                            assertion_stable: bool = proof_block_assertion_expression_stable(assertion, facts, report, functions) can Global.Read
                            proof_add_goal_attempt(report, facts, assertion, position.line, name, "lemma-step", false) if not assertion_stable
                            proof_add_finding(report, "lemma-impure", position.line, name, "lemma assertions may use only stable primitive expressions") if not assertion_stable
                            assertion_proven: bool = assertion_stable and (proof_certify_goal(facts, assertion, report, position.line, name, annotations) can Global{Read,Write})
                            report.proof_obligation(assertion_proven)
                            proof_add_derived_fact(facts, report, assertion, "lemma-step", position.line, name) if assertion_proven
                            proof_add_goal_failure(report, "lemma-step-unproven", position.line, name, "lemma proof step is not entailed by earlier facts", facts, assertion) if not assertion_proven
                        else:
                            assertion_stable: bool = proof_runtime_fact_is_stable(assertion, expression, report.source_primitive_operator_mask, report)
                            if assertion_stable:
                                assertion_certified: bool = (proof_certify_goal(facts, assertion, report, position.line, name, annotations) can Global{Read,Write})
                            proof_add_traced_fact(facts, report, assertion, "runtime-assert", position.line, name) if assertion_stable
                Ast::Stmt.Expr(expression, position):
                    expression_has_unmodeled_operator: mutable bool = false
                    expression_has_unmodeled_operator <- proof_invalidate_for_unmodeled_operator(expression, names, values, facts, frame_parameters, report, name, position) if not lemma_steps
                    prepared: (ready: bool, expression: Ast::Expr) = (proof_block_lemma_return_expression_prepare(expression, lemma_steps, names, values, facts, lemmas, functions, report, name, position.line) can Global{Read,Write})
                    substituted_expression: mutable Ast::Expr = prepared.expression
                    lemma_application_reserved: bool = prepared.ready
                    if not prepared.ready:
                        report.proof_obligation(false)
                        flow.normal <- false
                        flow.valid <- false
                        return true
                    terminal_expression: bool = proof_expression_is_terminal(expression)
                    match expression:
                        Ast::Expr.Call(callee, arguments, _, _):
                            (proof_check_frame_call_children(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write}) if not lemma_steps
                            if proof_callable_name(callee) == "assert" and arguments.count == 1:
                                prepared_assertion: (ready: bool, expression: Ast::Expr) = proof_return_substitution_prepare(arguments[0], names, values, report, name, position.line)
                                if not prepared_assertion.ready:
                                    report.proof_obligation(false)
                                    flow.normal <- false
                                    flow.valid <- false
                                    return true
                                assertion_call: Ast::Expr = prepared_assertion.expression
                                assertion_has_call: bool = proof_expr_has_call(arguments[0])
                                assertion_has_move: bool = proof_expr_has_move(arguments[0])
                                assertion_has_overloaded_operator: bool = proof_source_expression_has_overloaded_operator(arguments[0], report.source_primitive_operator_mask, 0)
                                assertion_may_mutate_state: bool = assertion_has_call or assertion_has_move or assertion_has_overloaded_operator
                                # `assert(expr)` evaluates expr before publishing it. Do not
                                # retain facts that a nested call, ownership transfer or
                                # source-overloaded operator may have invalidated.
                                if not lemma_steps:
                                    proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position) if assertion_may_mutate_state
                                    (proof_clear_facts_after_call(facts, names, frame_parameters, report, name) can Global{Read,Write}) if assertion_may_mutate_state
                                if lemma_steps:
                                    assertion_stable: bool = proof_block_assertion_expression_stable(assertion_call, facts, report, functions) can Global.Read
                                    proof_add_goal_attempt(report, facts, assertion_call, position.line, name, "lemma-step", false) if not assertion_stable
                                    proof_add_finding(report, "lemma-impure", position.line, name, "lemma assertions may use only stable primitive expressions") if not assertion_stable
                                    call_assertion_proven: bool = assertion_stable and (proof_certify_goal(facts, assertion_call, report, position.line, name, annotations) can Global{Read,Write})
                                    report.proof_obligation(call_assertion_proven)
                                    proof_add_derived_fact(facts, report, assertion_call, "lemma-step", position.line, name) if call_assertion_proven
                                    proof_add_goal_failure(report, "lemma-step-unproven", position.line, name, "lemma proof step is not entailed by earlier facts", facts, assertion_call) if not call_assertion_proven
                                else:
                                    assertion_stable: bool = proof_runtime_fact_is_stable(assertion_call, arguments[0], report.source_primitive_operator_mask, report)
                                    if assertion_stable:
                                        assertion_certified: bool = (proof_certify_goal(facts, assertion_call, report, position.line, name, annotations) can Global{Read,Write})
                                    proof_add_traced_fact(facts, report, assertion_call, "runtime-assert", position.line, name) if assertion_stable
                            if proof_callable_name(callee) != "assert":
                                # Lemma calls are valid only in proof blocks (which are
                                # checked by proof_check_block). A normal executable body
                                # cannot gain ghost facts from an erased declaration.
                                push_receiver: sview = proof_push_receiver(expression, names, values, frame_parameters, functions, report, name)
                                push_before: Ast::Expr = (proof_push_before(facts, report, push_receiver, name, position) can Global{Read,Write}) if push_receiver != "" else Ast::Expr.Invalid
                                push_kept: mutable darray[Ast::Expr] = []
                                push_premises: mutable darray[Ast::Expr] = []
                                (proof_push_kept_elements(facts, push_receiver, push_before, push_kept, push_premises) can Global{Read,Write}) if push_receiver != ""
                                pop_receiver: sview = proof_pop_receiver(expression, names, values, frame_parameters, functions, report, name) if push_receiver == "" else ""
                                pop_before: Ast::Expr = (proof_push_before(facts, report, pop_receiver, name, position) can Global{Read,Write}) if pop_receiver != "" else Ast::Expr.Invalid
                                proof_pop_kept_elements(facts, pop_receiver, pop_before, push_kept, push_premises) if pop_receiver != ""
                                applied_lemma: mutable bool = false
                                if lemma_steps:
                                    applied_lemma <- (proof_apply_lemma(substituted_expression, facts, lemmas, functions, names, values, report, name, annotations) can Global{Read,Write}) if lemma_application_reserved
                                if not applied_lemma:
                                    # A statement call may thread its exclusive `&` locals.
                                    report.value_thread_site <- true
                                    applied_function: bool = (proof_apply_function(proof_call_source(expression, substituted_expression), Ast::Expr.Absent, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations) can Global{Read,Write})
                                    report.value_thread_site <- false
                                    proof_check_opaque_call_frame(substituted_expression, expression, facts, names, frame_parameters, changes, preserves, functions, report, name) if not applied_function
                                    # A statement call has no result binding to carry forward;
                                    # even a framed summary may have changed an untracked local
                                    # alias, so forget symbolic values at the call boundary.
                                    # The values are settled against the pre-call facts, whose
                                    # witnesses the clear below would keep anyway.
                                    call_aliases: darray[sview] = proof_opaque_call_extra_alias_roots(expression, functions, names)
                                    proof_forget_values_after_call_with_aliases(names, values, facts, frame_parameters, report, name, values.count, values.count, position, call_aliases)
                                    (proof_clear_facts_after_call_with_aliases(facts, names, frame_parameters, report, name, call_aliases) can Global{Read,Write}) if not applied_function
                                    proof_value_thread_apply(names, values, report, "")
                                # A modeled collection mutation can be "applied" without taking
                                # the generic opaque-call clear above. Facts over the receiver's
                                # pre-call state are still stale; keep unrelated facts, then add
                                # back only the collection post-state model below. The push path
                                # restates count facts over its ghost snapshot before this clear.
                                proof_clear_facts_for_mutated_root(facts, push_receiver, report, name) if push_receiver != ""
                                proof_clear_facts_for_mutated_root(facts, pop_receiver, report, name) if pop_receiver != ""
                                proof_push_after(facts, report, push_receiver, push_before, proof_push_argument(substituted_expression), name, position) if push_receiver != ""
                                proof_pop_after(facts, report, pop_receiver, pop_before, name, position) if pop_receiver != ""
                                proof_push_restore_elements(facts, report, push_kept, push_premises, name, position) if push_receiver != "" or pop_receiver != ""
                        _:
                            (proof_check_frame_calls_in_expression(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write}) if proof_expr_has_call(expression)
                            if proof_expr_has_call(expression):
                                post_call: (ready: bool, expression: Ast::Expr) = proof_return_substitution_prepare(expression, names, values, report, name, position.line)
                                if not post_call.ready:
                                    report.proof_obligation(false)
                                    flow.normal <- false
                                    flow.valid <- false
                                    return true
                                substituted_expression <- post_call.expression
                            proof_forget_values_after_call_with_aliases(names, values, facts, frame_parameters, report, name, values.count, values.count, position, proof_opaque_call_extra_alias_roots(expression, functions, names)) if proof_expr_has_call(expression)
                            (proof_clear_facts_after_call(facts, names, frame_parameters, report, name) can Global{Read,Write})
                    if expression_has_unmodeled_operator:
                        # A nested call may have restored summary facts after the initial
                        # invalidation; none can cross an unmodeled operator evaluation.
                        proof_forget_values(names, values, position)
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                    flow.normal <- false if terminal_expression
                Ast::Stmt.Return(value, position):
                    if value is returned:
                        match returned:
                            Ast::Expr.Catch(guarded, arms, _):
                                # Expression catches are checked arm-by-arm. The supported
                                # shape is guaranteed by the statement admission gate above;
                                # each arm receives its own post-state and the catch itself
                                # is terminal at this return boundary.
                                if not proof_return_analysis_budget_available(facts, names, values, report, name, position.line):
                                    report.proof_obligation(false)
                                    flow.normal <- false
                                    flow.valid <- false
                                    return true
                                (proof_check_catch_return(guarded, arms, names, values, facts, ensures, functions, frame_parameters, old_values, changes, preserves, report, name, annotations, position) can Global{Read,Write})
                                flow.normal <- false
                                flow.valid <- false if report.budgets.return_reported
                                return true
                            Ast::Expr.Match(scrutinee, arms, _):
                                # A value match has one return value per arm. Checking the
                                # lowered conditional as one expression would let a summary
                                # fact from one arm justify another, so preserve the source
                                # branch states and check each arm through a synthetic return.
                                if not proof_return_analysis_budget_available(facts, names, values, report, name, position.line):
                                    report.proof_obligation(false)
                                    flow.normal <- false
                                    flow.valid <- false
                                    return true
                                (proof_check_value_match_return(scrutinee, arms, names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, position) can Global{Read,Write})
                                flow.normal <- false
                                flow.valid <- false if report.budgets.return_reported
                                return true
                            _:
                                pass
                        return_value: mutable Ast::Expr = proof_substitute(returned, names, values)
                        returned_has_unmodeled_operator: bool = proof_invalidate_for_unmodeled_operator(returned, names, values, facts, frame_parameters, report, name, position)
                        return_value <- Ast::Expr.Invalid if returned_has_unmodeled_operator
                        return_call_applied: mutable bool = false
                        # Only a syntactic call at the return site is evaluated here. If a
                        # local already contains a summarized call result, substituting it
                        # produces a Call-shaped value but must not execute/apply that call a
                        # second time; the declaration or assignment already established its
                        # postcondition and may have consumed the caller's pre-call facts.
                        match returned:
                            Ast::Expr.Call(_, _, _, _):
                                # An integer conversion of a bare name runs no source function,
                                # so there is no summary to apply; the value stays the term.
                                if not proof_expr_calls_are_conversions(return_value, functions, 0) and not proof_return_bounded_u8_conversion(return_value, facts, functions):
                                    (proof_check_frame_call_children(returned, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write})
                                    return_call_applied <- (proof_apply_function(return_value, return_value, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations) can Global{Read,Write})
                                    proof_check_opaque_call_frame(return_value, returned, facts, names, frame_parameters, changes, preserves, functions, report, name) if not return_call_applied
                                    return_value <- Ast::Expr.Invalid if not return_call_applied
                            Ast::Expr.GetElse(guarded, _, _):
                                # A GetElse is transparent only after its recovery has been
                                # checked. If its successful value is a syntactic call, apply
                                # that summary exactly once here, just as for `return call()`.
                                # This is distinct from a substituted local whose value merely
                                # happens to have Call shape.
                                match guarded:
                                    Ast::Expr.Call(_, _, _, _):
                                        (proof_check_frame_call_children(guarded, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write})
                                        return_call_applied <- (proof_apply_function(return_value, return_value, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations) can Global{Read,Write})
                                        proof_check_opaque_call_frame(return_value, guarded, facts, names, frame_parameters, changes, preserves, functions, report, name) if not return_call_applied
                                        return_value <- Ast::Expr.Invalid if not return_call_applied
                                    _:
                                        pass
                            _:
                                (proof_check_frame_calls_in_expression(returned, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write}) if proof_expr_has_call(returned)
                                return_value <- proof_substitute(returned, names, values) if proof_expr_has_call(returned)
                        return_value <- proof_rewrite_pure_call_summaries(return_value, facts, functions, 0) if proof_expr_has_call(return_value)
                        # Only a call written at the return runs here. A local's call ran at its
                        # binding, which already applied its summary and havoc; clearing again
                        # would discard the summary that describes the returned value.
                        # Numeric conversions and verified pure calls write nothing.
                        return_source_call_unstable: bool = proof_expr_has_call(returned) and proof_fact_expression_has_fresh_runtime_value(report, returned)
                        return_value_call_unstable: bool = proof_expr_has_call(return_value) and proof_fact_expression_has_fresh_runtime_value(report, return_value)
                        return_has_fresh_value: bool = proof_block_expression_has_fresh_value(return_value, 0) or return_source_call_unstable or return_value_call_unstable
                        if proof_expr_has_call(returned) and not return_call_applied:
                            return_aliases: darray[sview] = proof_opaque_call_extra_alias_roots(returned, functions, names)
                            if proof_expression_has_opaque_callable_call(returned, functions, names, 0):
                                proof_forget_values_after_call_with_aliases(names, values, facts, frame_parameters, report, name, values.count, values.count, position, return_aliases)
                                (proof_clear_facts_after_call_with_aliases(facts, names, frame_parameters, report, name, return_aliases) can Global{Read,Write})
                            else:
                                (proof_clear_facts_after_call(facts, names, frame_parameters, report, name) can Global{Read,Write}) if return_has_fresh_value
                        if returned_has_unmodeled_operator:
                            proof_forget_values(names, values, position)
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                            return_value <- Ast::Expr.Invalid
                        proof_invalidate_moved_roots(moved_roots, names, values, facts, report, name, position)
                        (proof_add_plain_enum_comparison_result_witness(return_value, facts, functions, report, name, position) can Global.Read) if not returned_has_unmodeled_operator
                        result_name: mutable darray[sview] = ["result"]
                        result_value: mutable darray[Ast::Expr] = [return_value]
                        typed_symbol: mutable sview = ""
                        ensure_index: mutable usize = 0
                        for ensure in ensures |report, name, facts, result_name, result_value, position, typed_symbol, ensure_index|:
                            current_goal: Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, values, old_values)
                            goal: mutable Ast::Expr = proof_substitute(current_goal, result_name, result_value)
                            (proof_add_quantified_call_summaries(goal, facts, functions, annotations, report, name) can Global{Read,Write}) if proof_expr_has_call(goal)
                            projected_goal: (known: bool, value: Ast::Expr) = proof_project_tuple_result(current_goal, return_value, functions, name)
                            goal <- projected_goal.value if projected_goal.known
                            typed_goal: bool = not projected_goal.known and proof_typed_return_constant_needed(current_goal, goal, return_value, facts, report)
                            if typed_goal:
                                typed_symbol <- proof_rebind_symbol(report) if typed_symbol == ""
                            proven: mutable bool = false
                            if typed_goal and typed_symbol != "":
                                goal_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                                proof_add_typed_return_constant(goal_facts, report, typed_symbol, return_value, name, position)
                                typed_name: darray[Ast::Expr] = [Ast::Expr.Ident(typed_symbol, position)]
                                goal <- proof_substitute(current_goal, result_name, typed_name)
                                proven <- (proof_certify_return_goal(goal_facts, return_value, goal, report, position.line, name, annotations, proof_quantifier_rule(ensure, annotations)) can Global{Read,Write})
                                proof_add_goal_failure(report, "ensure-unproven", position.line, name, "return value does not establish ensure", goal_facts, goal) if not proven
                            else:
                                goal <- proof_rewrite_pure_call_summaries(goal, facts, functions, 0) if proof_expr_has_call(goal)
                                proof_add_pure_call_witnesses(goal, facts, functions, report, position.line, name, 0)
                                proven <- (proof_certify_return_goal(facts, return_value, goal, report, position.line, name, annotations, proof_quantifier_rule(ensure, annotations)) can Global{Read,Write})
                                proof_add_goal_failure(report, "ensure-unproven", position.line, name, "return value does not establish ensure", facts, goal) if not proven
                            if ensure_index < report.current_source_postcondition_count:
                                report.proof_obligation_for_source(proven, report.current_source_postcondition_line, report.current_source_postcondition_name, "postcondition", ensure_index)
                            else:
                                report.proof_obligation(proven)
                            ensure_index <- ensure_index + 1
                            if not proven:
                                if report.findings.count > 0 and report.findings[report.findings.count - 1].counterexample_found and not proof_return_counterexample_parameters_only(report, functions, name):
                                    report.findings[report.findings.count - 1].status <- "unknown"
                                    report.findings[report.findings.count - 1].counterexample_found <- false
                                    report.findings[report.findings.count - 1].counterexample_count <- 0
                    else:
                        # A void return still completes normally and must establish its
                        # postconditions. There is no result binding to substitute, so a
                        # result-dependent ensure fails closed rather than disappearing.
                        ensure_index: mutable usize = 0
                        for ensure in ensures |report, name, facts, names, values, frame_parameters, old_values, annotations, position, ensure_index|:
                            goal: mutable Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, values, old_values)
                            proven: mutable bool = false
                            if proof_expr_mentions_name(goal, "result"):
                                failed_rule: mutable sview = proof_quantifier_rule(ensure, annotations)
                                failed_rule <- "goal" if failed_rule == ""
                                proof_add_goal_attempt(report, facts, goal, position.line, name, failed_rule, false)
                            else:
                                goal <- proof_rewrite_pure_call_summaries(goal, facts, functions, 0) if proof_expr_has_call(goal)
                                proven <- (proof_certify_goal_with_rule(facts, goal, report, position.line, name, annotations, proof_quantifier_rule(ensure, annotations)) can Global{Read,Write})
                            if ensure_index < report.current_source_postcondition_count:
                                report.proof_obligation_for_source(proven, report.current_source_postcondition_line, report.current_source_postcondition_name, "postcondition", ensure_index)
                            else:
                                report.proof_obligation(proven)
                            ensure_index <- ensure_index + 1
                            proof_add_goal_failure(report, "ensure-unproven", position.line, name, "void return does not establish ensure", facts, goal) if not proven
                        proof_invalidate_moved_roots(moved_roots, names, values, facts, report, name, position)
                    flow.normal <- false
                Ast::Stmt.If(condition, then_body, else_body, position):
                    # An if forks the symbolic environment. If the function budget is already
                    # spent, refuse before cloning both branch states.
                    if not proof_return_analysis_budget_available(facts, names, values, report, name, position.line):
                        report.proof_obligation(false)
                        flow.normal <- true
                        flow.valid <- false
                        return true
                    condition_value: mutable Ast::Expr = proof_substitute(condition, names, values)
                    condition_source_has_call: bool = proof_expr_has_call(condition)
                    condition_value_has_call: bool = proof_expr_has_call(condition_value)
                    condition_has_call: bool = condition_source_has_call or condition_value_has_call
                    condition_has_move: bool = proof_expr_has_move(condition_value)
                    condition_has_overloaded_operator: bool = proof_source_expression_has_overloaded_operator(condition, report.source_primitive_operator_mask, 0)
                    condition_source_call_unstable: bool = condition_source_has_call and proof_fact_expression_has_fresh_runtime_value(report, condition)
                    condition_value_call_unstable: bool = condition_value_has_call and proof_fact_expression_has_fresh_runtime_value(report, condition_value)
                    condition_has_fresh_value: bool = proof_block_expression_has_fresh_value(condition_value, 0) or condition_source_call_unstable or condition_value_call_unstable
                    condition_facts_stable: bool = not condition_has_overloaded_operator and not condition_has_move and not condition_has_fresh_value
                    (proof_check_frame_calls_in_expression(condition, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write}) if condition_source_has_call
                    condition_may_mutate_state: bool = condition_has_overloaded_operator or condition_has_move or (condition_has_call and not condition_facts_stable)
                    proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position) if condition_may_mutate_state
                    branch_value_count: usize = values.count
                    branch_entry_values: darray[Ast::Expr] = proof_copy_exprs(values)
                    then_names: mutable darray[sview] = proof_copy_names(names)
                    then_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                    then_facts: mutable darray[Ast::Expr] @r = proof_copy_exprs(facts)
                    then_flow: mutable ProofFlow = proof_empty_flow()
                    (proof_clear_facts_after_call(then_facts, names, frame_parameters, report, name) can Global{Read,Write}) if condition_may_mutate_state
                    # If evaluating the condition can change state, its source-level formula
                    # describes a mixture of pre- and post-call values. Clearing the incoming
                    # facts is not enough: reintroducing that formula would let its conjuncts
                    # resurrect stale values (for example, an index guard before a mutating
                    # call on the RHS). Until branch conditions carry explicit post-state
                    # semantics, admit them only when every call is a verified pure call.
                    proof_add_branch_condition_facts(then_facts, report, functions, condition_value, position.line, name) if condition_facts_stable
                    proof_add_effect_stable_short_circuit_branch_fact(then_facts, then_names, frame_parameters, report, functions, name, condition_value, true, position.line) if condition_may_mutate_state and condition_has_call
                    (proof_check_returns(then_body, &then_names, &then_values, &then_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &then_flow) can Global{Read,Write})
                    if report.budgets.return_reported:
                        flow.normal <- true
                        flow.valid <- false
                        return true
                    else_names: mutable darray[sview] = proof_copy_names(names)
                    else_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                    else_facts: mutable darray[Ast::Expr] @r = proof_copy_exprs(facts)
                    else_flow: mutable ProofFlow = proof_empty_flow()
                    negated: Ast::Expr = proof_branch_negation(condition_value, Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0})
                    (proof_clear_facts_after_call(else_facts, names, frame_parameters, report, name) can Global{Read,Write}) if condition_may_mutate_state
                    proof_add_branch_condition_facts(else_facts, report, functions, negated, position.line, name) if condition_facts_stable
                    proof_add_effect_stable_short_circuit_branch_fact(else_facts, else_names, frame_parameters, report, functions, name, condition_value, false, position.line) if condition_may_mutate_state and condition_has_call
                    (proof_check_returns(else_body, &else_names, &else_values, &else_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &else_flow) can Global{Read,Write})
                    if report.budgets.return_reported:
                        flow.normal <- true
                        flow.valid <- false
                        return true
                    then_falls_through: bool = then_flow.normal
                    else_falls_through: bool = else_flow.normal
                    flow.breaks <- then_flow.breaks or else_flow.breaks
                    flow.continues <- then_flow.continues or else_flow.continues
                    flow.valid <- then_flow.valid and else_flow.valid
                    proof_append_continue_states(flow, then_flow)
                    proof_append_continue_states(flow, else_flow)
                    # If one branch definitely terminates, the other branch is the complete
                    # state at the following statement. Merge only the surviving branch and
                    # only when it did not introduce a branch-local binding; leaking a local
                    # name or a fact mentioning it would be unsound. When both branches can
                    # continue, retain the pre-branch state as a conservative intersection.
                    if not then_falls_through and else_falls_through:
                        if condition_facts_stable and else_names.count == names.count and else_values.count >= branch_value_count:
                            for index in 0..<branch_value_count |index, values, else_values|:
                                values[index] <- else_values[index]
                            facts.clear()
                            for fact in else_facts |facts|:
                                facts.push(fact)
                        else:
                            proof_forget_values(names, values, position)
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                            # Control reaches the next statement only through the surviving
                            # branch, so its end state holds here. The opaque condition call
                            # forbids importing that state wholesale, but a call-stable fact
                            # is over by-value scalars of this frame that nothing references:
                            # true at the end of the branch means true at this point.
                            else_reads: darray[Ast::Expr] = proof_join_reads(else_facts, values, names, else_values, branch_value_count, report)
                            proof_restore_call_stable_facts(else_reads, facts, names, frame_parameters, report, name, report.aliased_names) if else_names.count == names.count
                            # The same holds for the values it leaves: the call-stable ones, a
                            # module constant among them, keep their recorded value.
                            proof_restore_branch_values(values, names, then_values, else_values, false, else_names.count == names.count, branch_value_count, facts, frame_parameters, report, name)
                    elif then_falls_through and not else_falls_through:
                        if condition_facts_stable and then_names.count == names.count and then_values.count >= branch_value_count:
                            for index in 0..<branch_value_count |index, values, then_values|:
                                values[index] <- then_values[index]
                            facts.clear()
                            for fact in then_facts |facts|:
                                facts.push(fact)
                        else:
                            proof_forget_values(names, values, position)
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                            then_reads: darray[Ast::Expr] = proof_join_reads(then_facts, values, names, then_values, branch_value_count, report)
                            proof_restore_call_stable_facts(then_reads, facts, names, frame_parameters, report, name, report.aliased_names) if then_names.count == names.count
                            proof_restore_branch_values(values, names, then_values, else_values, then_names.count == names.count, false, branch_value_count, facts, frame_parameters, report, name)
                    elif not then_falls_through and not else_falls_through:
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                        flow.normal <- false
                    # Only a branch that falls through reaches the next statement. A return or
                    # continue checks its own state, a raise leaves the function, and a loop exit
                    # reached by a break keeps only the invariants the break re-establishes, so a
                    # leaving branch's effects cannot weaken this join. The raise in
                    # `raise E if not live(table, slot)` is call-shaped but never reaches it.
                    then_weakens_join: bool = then_falls_through and proof_body_may_modify(then_body, report.source_primitive_operator_mask, report)
                    else_weakens_join: bool = else_falls_through and proof_body_may_modify(else_body, report.source_primitive_operator_mask, report)
                    if not lemma_steps and (then_weakens_join or else_weakens_join):
                        prior_facts: darray[Ast::Expr] = proof_copy_exprs(facts)
                        prior_values: darray[Ast::Expr] = proof_copy_exprs(values)
                        proof_forget_values(names, values, position)
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                        # The arms were executed symbolically, so a fact still standing at a
                        # surviving arm's exit is true on that path. Import the call-stable
                        # ones from the paths that actually reach this statement, and the
                        # recorded values those paths agree on.
                        proof_restore_branch_values(values, names, then_values, else_values, then_falls_through and proof_arm_names_extend(then_names, names), else_falls_through and proof_arm_names_extend(else_names, names), branch_value_count, facts, frame_parameters, report, name)
                        # A forgotten binding is joined under its own name, which an arm that
                        # rebound it to a fresh symbol still uses for the old value.
                        then_joined: mutable darray[Ast::Expr] = proof_join_reads(then_facts, values, names, then_values, branch_value_count, report)
                        else_joined: mutable darray[Ast::Expr] = proof_join_reads(else_facts, values, names, else_values, branch_value_count, report)
                        record_join_closed: bool = not condition_has_call and proof_record_branch_expression_closed(condition, false, 0) and (all ensure in ensures where proof_record_branch_expression_closed(ensure, true, 0)) and proof_record_branch_body_closed(then_body, names, frame_parameters, functions, report, name, 0) and proof_record_branch_body_closed(else_body, names, frame_parameters, functions, report, name, 0)
                        record_then_reaches: bool = then_falls_through and then_names.count == names.count
                        record_else_reaches: bool = else_falls_through and else_names.count == names.count
                        if record_join_closed and (not then_falls_through or record_then_reaches) and (not else_falls_through or record_else_reaches):
                            proof_restore_record_branch_values(values, names, branch_entry_values, then_values, else_values, record_then_reaches, record_else_reaches, condition_value, frame_parameters, functions, report, name, position)
                            if record_then_reaches:
                                proof_restore_record_branch_reference_facts(then_facts, else_facts, facts, record_else_reaches, report, name)
                            elif record_else_reaches:
                                proof_restore_record_branch_reference_facts(else_facts, then_facts, facts, false, report, name)
                        if then_falls_through and else_falls_through:
                            # A binding both arms rebind joins as a conditional over the
                            # branch condition, before the facts below are restored over it.
                            if condition_facts_stable and not condition_has_call and proof_arm_names_extend(then_names, names) and proof_arm_names_extend(else_names, names):
                                proof_join_conditional_values(condition_value, then_body, else_body, functions, prior_values, values, names, then_values, else_values, then_facts, else_facts, then_names, else_names, branch_value_count, facts, frame_parameters, report, name, Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0})
                                then_joined <- proof_join_reads(then_facts, values, names, then_values, branch_value_count, report)
                                else_joined <- proof_join_reads(else_facts, values, names, else_values, branch_value_count, report)
                            proof_restore_branch_stable_facts(then_joined, else_joined, facts, names, frame_parameters, report, name, prior_facts, not proof_body_has_call(then_body, report.source_primitive_operator_mask) and not proof_body_has_call(else_body, report.source_primitive_operator_mask))
                            (proof_restore_branch_implied_facts(&then_facts, &else_facts, prior_facts, then_names, else_names, then_values, else_values, values, names, branch_value_count, facts, frame_parameters, report, name, annotations, position, not proof_body_has_call(then_body, report.source_primitive_operator_mask) and not proof_body_has_call(else_body, report.source_primitive_operator_mask)) can Global{Read,Write}) if proof_arm_names_extend(then_names, names) and proof_arm_names_extend(else_names, names)
                        elif then_falls_through:
                            proof_restore_call_stable_facts(then_joined, facts, names, frame_parameters, report, name, report.aliased_names)
                        elif else_falls_through:
                            proof_restore_call_stable_facts(else_joined, facts, names, frame_parameters, report, name, report.aliased_names)
                _:
                    return false
            return true
