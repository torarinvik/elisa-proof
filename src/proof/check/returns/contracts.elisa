extend ElisaProof:
    private:
        def proof_return_counterexample_is_parameter(functions: ProofFunctionTable&, owner: sview, symbol: sview) -> bool:
            function_index: usize = proof_function_index_of_current(functions, owner)
            return false if function_index >= functions.names.count or function_index >= functions.param_starts.count or function_index >= functions.param_counts.count
            parameter_start: usize = functions.param_starts[function_index]
            parameter_count: usize = functions.param_counts[function_index]
            return false if parameter_start > functions.all_params.count or parameter_count > functions.all_params.count - parameter_start
            for parameter_index in parameter_start..<parameter_start + parameter_count |parameter_index, functions, symbol|:
                return true if functions.all_params[parameter_index] == symbol
            return false

        # Return-contract model search abstracts the body to its checked facts. A satisfying
        # assignment to a free local omitted from that state is only an abstract countermodel,
        # not a concrete function input. Keep `disproved` for return failures only when every
        # assigned symbol is an actual formal parameter (constant, closed counterexamples need
        # no assignments and remain concrete).
        def proof_return_counterexample_parameters_only(report: ProofReport&, functions: ProofFunctionTable&, owner: sview) -> bool:
            return false if report.findings.count == 0
            finding: ProofFinding = report.findings[report.findings.count - 1]
            return false if not finding.counterexample_found
            return true if finding.counterexample_count == 0
            return false if finding.counterexample_start > report.counterexample_facts.count or finding.counterexample_count > report.counterexample_facts.count - finding.counterexample_start
            for offset in 0..<finding.counterexample_count |offset, finding, report, functions, owner|:
                match report.counterexample_facts[finding.counterexample_start + offset]:
                    Ast::Expr.Binary(Ast::Expr.Ident(symbol, _), TokenKind.EqEq, Ast::Expr.IntLit(_, _), _):
                        return false if not proof_return_counterexample_is_parameter(functions, owner, symbol)
                    Ast::Expr.Binary(Ast::Expr.Ident(symbol, _), TokenKind.EqEq, Ast::Expr.BoolLit(_, _), _):
                        return false if not proof_return_counterexample_is_parameter(functions, owner, symbol)
                    _:
                        return false
            return true

        # `return <block>` -- how a tail loop with a header accumulator (`|acc: T = init| -> acc`)
        # arrives -- runs the block's statements in the function's own frame and then returns the
        # block's value. That is exactly the body `statements ++ [return value]`. A block with no
        # value is not this shape and stays with the ordinary admission gate.
        # `result.f` over a returned tuple literal is the literal's element labelled `f` in the
        # declared return type. The literal stands in as a construction under a reserved type name,
        # which `proof_substitute` projects field by field. If that name survives, some use of
        # `result` was not a labelled field, and the caller keeps the plain substitution.
        def proof_project_tuple_result(goal: Ast::Expr, return_value: Ast::Expr, functions: ProofFunctionTable&, name: sview) -> (known: bool, value: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            function_index: usize = proof_function_index_of_current(functions, name)
            return (false, goal) if function_index >= functions.return_label_counts.count
            match return_value:
                Ast::Expr.Tuple(elements, position):
                    return (false, goal) if elements.count == 0 or functions.return_label_counts[function_index] != elements.count
                    start: usize = functions.return_label_starts[function_index]
                    fields: mutable darray[Ast::FieldInit] = []
                    for index in 0..<elements.count |fields, elements, functions, start|:
                        fields.push(Ast::FieldInit{name: functions.all_return_labels[start + index], value: elements[index]})
                    result_name: darray[sview] = ["result"]
                    result_value: darray[Ast::Expr] = [Ast::Expr.Construct(Ast::Expr.Ident("__elisa_tuple_result", position), fields, position)]
                    projected: Ast::Expr = proof_substitute(goal, result_name, result_value)
                    return (not proof_expr_mentions_name(projected, "__elisa_tuple_result"), projected)
                _:
                    return (false, goal)

        def proof_return_value_block(statement: Ast::Stmt) -> (known: bool, body: darray[Ast::Stmt], position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            empty: mutable darray[Ast::Stmt] = []
            match statement:
                Ast::Stmt.Return(value, position):
                    if value is returned:
                        match returned:
                            Ast::Expr.Block(statements, block_value, _, _):
                                match block_value:
                                    Ast::Expr.Absent:
                                        pass
                                    Ast::Expr.Invalid:
                                        pass
                                    _:
                                        body: mutable darray[Ast::Stmt] = []
                                        body.extend(statements)
                                        body.push(Ast::Stmt.Return(block_value, position))
                                        return (true, body, position)
                            _:
                                pass
                _:
                    pass
            return (false, empty, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        # `x: T = <block>` -- how a loop with a header accumulator arrives as a local's value --
        # runs the block's statements in the function's own frame and then binds its value. When
        # no name the block declares is visible there, flattening it to `statements ++ [x: T =
        # value]` keeps every later read meaning the same: the compiler rejects reads of the
        # block's names after it, and a later declaration of one rebinds it as usual. A block
        # that would shadow a visible name is left alone.
        def proof_flatten_value_block_declaration(body: darray[Ast::Stmt]&, names: darray[sview]&) -> (known: bool, body: darray[Ast::Stmt]) can[Memory.Allocate, Abort.Panic]:
            flattened: mutable darray[Ast::Stmt] = []
            visible: mutable darray[sview] = []
            visible.extend(names)
            found: mutable bool = false
            for statement in body |flattened, visible, found|:
                if found:
                    flattened.push(statement)
                    continue
                block: (known: bool, statements: darray[Ast::Stmt], local_name: sview, type_expression: Ast::Expr, value: Ast::Expr, position: Ast::Pos) = proof_declared_value_block(statement)
                if block.known and not proof_block_shadows(block.statements, visible):
                    flattened.extend(block.statements)
                    # `x: T = x` over the block's own `x: T` binds the value it already holds, so
                    # it is dropped rather than read as a shadowing that forgets every fact.
                    flattened.push(Ast::Stmt.VarDecl(block.local_name, block.type_expression, block.value, block.position)) if not proof_block_identity_rebind(block.statements, block.local_name, block.type_expression, block.value)
                    found <- true
                    continue
                flattened.push(statement)
                declared: sview = proof_statement_declared_name(statement)
                visible.push(declared) if declared != ""
            return (found, flattened)

        # `x: T = A if c else B`, `t <- A if c else B` (with `t` a bare name) and
        # `return A if c else B` evaluate `c` and then exactly one arm. When the condition or an
        # arm holds a call other than an integer conversion, the if-expression cannot enter the
        # proof state as a term: the call may not run, so instantiating its summary would assume
        # its `ensure`s on a path where its `requires` were never checked. The statement is
        # rewritten instead to the control flow it denotes, with the rest of the block as the
        # continuation of each arm:
        #
        #     S[A if c else B]; rest   ==>   if c: S[A]; rest   else: S[B]; rest
        #
        # Both sides evaluate `c` once, then exactly one of `A` and `B`, then `rest`, so they have
        # the same paths and the same state at every point; a binding `S` introduces stays in
        # scope for `rest` because `rest` runs in the same arm. Each arm is checked by the
        # ordinary `if` rule and passes every statement gate on its own, so a call in `c`, `A`
        # or `B` is treated exactly as the same program written with statements: its `requires`
        # are checked on the path that runs it and nothing about it is assumed on the path that
        # skips it. An assignment target must be a bare name, so evaluating it has no effect the
        # reordering could move. Conversion-only arms are already admitted as a term and are left
        # alone. A tail expression is already a `return` in the AST, so it is covered; an
        # if-expression nested inside another expression (an operand or a call argument) is not
        # rewritten and still meets the statement gate. The continuation is duplicated, so a block with many such statements can spend the
        # return-analysis budget; that is reported as a refusal like any other budget overrun.
        def proof_split_conditional_value(body: darray[Ast::Stmt]&) -> (known: bool, body: darray[Ast::Stmt]) can[Memory.Allocate, Abort.Panic]:
            split: mutable darray[Ast::Stmt] = []
            for index in 0..<body.count |index, body, split|:
                arms: (known: bool, condition: Ast::Expr, then_statement: Ast::Stmt, else_statement: Ast::Stmt, position: Ast::Pos) = proof_conditional_value_arms(body[index])
                if arms.known:
                    then_body: mutable darray[Ast::Stmt] = []
                    else_body: mutable darray[Ast::Stmt] = []
                    then_body.push(arms.then_statement)
                    else_body.push(arms.else_statement)
                    for rest in (index + 1)..<body.count |rest, body, then_body, else_body|:
                        then_body.push(body[rest])
                        else_body.push(body[rest])
                    split.push(Ast::Stmt.If(arms.condition, then_body, else_body, arms.position))
                    return (true, split)
                split.push(body[index])
            return (false, split)

        def proof_conditional_value_arms(statement: Ast::Stmt) -> (known: bool, condition: Ast::Expr, then_statement: Ast::Stmt, else_statement: Ast::Stmt, position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            match statement:
                Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                    parts: (known: bool, condition: Ast::Expr, then_value: Ast::Expr, else_value: Ast::Expr, position: Ast::Pos) = proof_conditional_value_parts(initializer)
                    return (true, parts.condition, Ast::Stmt.VarDecl(local_name, type_expression, parts.then_value, position), Ast::Stmt.VarDecl(local_name, type_expression, parts.else_value, position), parts.position) if parts.known
                Ast::Stmt.Assign(target, operator, initializer, position):
                    if proof_ident_name(target) != "":
                        parts: (known: bool, condition: Ast::Expr, then_value: Ast::Expr, else_value: Ast::Expr, position: Ast::Pos) = proof_conditional_value_parts(initializer)
                        return (true, parts.condition, Ast::Stmt.Assign(target, operator, parts.then_value, position), Ast::Stmt.Assign(target, operator, parts.else_value, position), parts.position) if parts.known
                Ast::Stmt.Return(value, position):
                    if value is returned:
                        parts: (known: bool, condition: Ast::Expr, then_value: Ast::Expr, else_value: Ast::Expr, position: Ast::Pos) = proof_conditional_value_parts(returned)
                        return (true, parts.condition, Ast::Stmt.Return(parts.then_value, position), Ast::Stmt.Return(parts.else_value, position), parts.position) if parts.known
                _:
                    pass
            return (false, Ast::Expr.Invalid, Ast::Stmt.Invalid, Ast::Stmt.Invalid, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        def proof_conditional_value_parts(expression: Ast::Expr) -> (known: bool, condition: Ast::Expr, then_value: Ast::Expr, else_value: Ast::Expr, position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(expression):
                Ast::Expr.If(condition, then_value, else_value, position):
                    admitted_as_term: bool = proof_expr_calls_are_conversions(condition, 0) and proof_expr_calls_are_conversions(then_value, 0) and proof_expr_calls_are_conversions(else_value, 0)
                    return (true, condition, then_value, else_value, position) if not admitted_as_term
                _:
                    pass
            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, Ast::Expr.Invalid, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        def proof_declared_value_block(statement: Ast::Stmt) -> (known: bool, statements: darray[Ast::Stmt], local_name: sview, type_expression: Ast::Expr, value: Ast::Expr, position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            empty: mutable darray[Ast::Stmt] = []
            match statement:
                Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                    match initializer:
                        Ast::Expr.Block(statements, block_value, _, _):
                            match block_value:
                                Ast::Expr.Absent:
                                    pass
                                Ast::Expr.Invalid:
                                    pass
                                _:
                                    return (true, statements, local_name, type_expression, block_value, position)
                        _:
                            pass
                _:
                    pass
            return (false, empty, "", Ast::Expr.Absent, Ast::Expr.Absent, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        def proof_block_identity_rebind(statements: darray[Ast::Stmt]&, local_name: sview, type_expression: Ast::Expr, value: Ast::Expr) -> bool:
            match value:
                Ast::Expr.Ident(value_name, _):
                    return false if value_name != local_name
                _:
                    return false
            same: mutable bool = false
            for statement in statements |local_name, type_expression, same|:
                match statement:
                    Ast::Stmt.VarDecl(declared, declared_type, _, _):
                        same <- proof_expr_equal(declared_type, type_expression) if declared == local_name
                    _:
                        pass
            same

        def proof_block_shadows(statements: darray[Ast::Stmt]&, visible: darray[sview]&) -> bool:
            for statement in statements |visible|:
                declared: sview = proof_statement_declared_name(statement)
                return true if declared != "" and (any candidate in visible where candidate == declared)
            false

        # Check a return value block in a private copy of the state. The block's declarations
        # are scoped to it and every path through it ends at the appended return, so only its
        # validity and any loop edge that escapes it reach the enclosing flow.
        def proof_check_value_block_return(body: darray[Ast::Stmt]&, position: Ast::Pos, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, flow: mutable ProofFlow&) -> void:
            flow.normal <- false
            if not proof_return_analysis_budget_available(facts, names, values, report, name, position.line):
                report.proof_obligation(false)
                flow.valid <- false
                return
            block_names: mutable darray[sview] = proof_copy_names(names)
            block_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
            block_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            block_flow: mutable ProofFlow = proof_empty_flow()
            proof_check_returns(body, &block_names, &block_values, &block_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &block_flow)
            flow.valid <- false if not block_flow.valid or report.return_analysis_budget_reported
            flow.breaks <- flow.breaks or block_flow.breaks
            flow.continues <- flow.continues or block_flow.continues
            proof_append_continue_states(flow, block_flow)

        def proof_check_return_contracts[@r](statement: Ast::Stmt, moved_roots: darray[sview], names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]& @r, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, flow: mutable ProofFlow&) -> bool:
            match statement:
                Ast::Stmt.Contract(kind, expression, position):
                    if kind == "assert":
                        assertion: mutable Ast::Expr = proof_substitute(expression, names, values)
                        assertion_has_call: bool = proof_expr_has_call(expression)
                        assertion_has_overloaded_operator: bool = proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
                        assertion_may_mutate_state: bool = assertion_has_call or assertion_has_overloaded_operator
                        # The assertion expression is evaluated at runtime before its
                        # proposition becomes a fact. Calls and source-overloaded operators
                        # can invalidate prior state, so discard all pre-evaluation facts.
                        proof_check_frame_calls_in_expression(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if assertion_has_call
                        proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position) if assertion_may_mutate_state
                        proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if assertion_may_mutate_state
                        if lemma_steps:
                            assertion_stable: bool = not assertion_has_overloaded_operator and (not assertion_has_call or proof_contract_calls_are_pure(expression, functions))
                            assertion_proven: bool = assertion_stable and proof_certify_goal(facts, assertion, report, position.line, name, annotations)
                            report.proof_obligation(assertion_proven)
                            proof_add_derived_fact(facts, report, assertion, "lemma-step", position.line, name) if assertion_proven
                            proof_add_goal_failure(report, "lemma-step-unproven", position.line, name, "lemma proof step is not entailed by earlier facts", facts, assertion) if not assertion_proven
                        else:
                            proof_add_traced_fact(facts, report, assertion, "runtime-assert", position.line, name) if proof_runtime_fact_is_stable(assertion, functions, report.source_primitive_operator_mask)
                Ast::Stmt.Expr(expression, position):
                    expression_has_unmodeled_operator: bool = proof_invalidate_for_unmodeled_operator(expression, names, values, facts, frame_parameters, report, name, position)
                    substituted_expression: mutable Ast::Expr = proof_substitute(expression, names, values)
                    terminal_expression: bool = proof_expression_is_terminal(expression)
                    match expression:
                        Ast::Expr.Call(callee, arguments, _, _):
                            proof_check_frame_call_children(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                            if proof_callable_name(callee) == "assert" and arguments.count == 1:
                                assertion_call: Ast::Expr = proof_substitute(arguments[0], names, values)
                                assertion_has_call: bool = proof_expr_has_call(arguments[0])
                                assertion_has_overloaded_operator: bool = proof_source_expression_has_overloaded_operator(arguments[0], report.source_primitive_operator_mask, 0)
                                assertion_may_mutate_state: bool = assertion_has_call or assertion_has_overloaded_operator
                                # `assert(expr)` evaluates expr before publishing it. Do not
                                # retain facts that a nested executable call may have
                                # invalidated, even when the outer builtin is pure.
                                proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position) if assertion_may_mutate_state
                                proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if assertion_may_mutate_state
                                if lemma_steps:
                                    assertion_stable: bool = not assertion_has_overloaded_operator and (not assertion_has_call or proof_contract_calls_are_pure(arguments[0], functions))
                                    call_assertion_proven: bool = assertion_stable and proof_certify_goal(facts, assertion_call, report, position.line, name, annotations)
                                    report.proof_obligation(call_assertion_proven)
                                    proof_add_derived_fact(facts, report, assertion_call, "lemma-step", position.line, name) if call_assertion_proven
                                    proof_add_goal_failure(report, "lemma-step-unproven", position.line, name, "lemma proof step is not entailed by earlier facts", facts, assertion_call) if not call_assertion_proven
                                else:
                                    proof_add_traced_fact(facts, report, assertion_call, "runtime-assert", position.line, name) if proof_runtime_fact_is_stable(assertion_call, functions, report.source_primitive_operator_mask)
                            if proof_callable_name(callee) != "assert":
                                # Lemma calls are valid only in proof blocks (which are
                                # checked by proof_check_block). A normal executable body
                                # cannot gain ghost facts from an erased declaration.
                                push_receiver: sview = proof_push_receiver(expression, names, values, frame_parameters, functions, report, name)
                                push_before: Ast::Expr = proof_push_before(facts, report, push_receiver, name, position) if push_receiver != "" else Ast::Expr.Invalid
                                push_kept: mutable darray[Ast::Expr] = []
                                push_premises: mutable darray[Ast::Expr] = []
                                proof_push_kept_elements(facts, push_receiver, push_before, push_kept, push_premises) if push_receiver != ""
                                applied_lemma: mutable bool = false
                                applied_lemma <- proof_apply_lemma(substituted_expression, facts, lemmas, names, values, report, name, annotations) if lemma_steps
                                if not applied_lemma:
                                    applied_function: bool = proof_apply_function(proof_call_source(expression, substituted_expression), Ast::Expr.Absent, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations)
                                    proof_check_opaque_call_frame(substituted_expression, names, frame_parameters, changes, preserves, functions, report, name) if not applied_function
                                    # A statement call has no result binding to carry forward;
                                    # even a framed summary may have changed an untracked local
                                    # alias, so forget symbolic values at the call boundary.
                                    # The values are settled against the pre-call facts, whose
                                    # witnesses the clear below would keep anyway.
                                    proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position)
                                    proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if not applied_function
                                proof_push_after(facts, report, push_receiver, push_before, proof_push_argument(substituted_expression), name, position) if push_receiver != ""
                                proof_push_restore_elements(facts, report, push_kept, push_premises, name, position) if push_receiver != ""
                        _:
                            proof_check_frame_calls_in_expression(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(expression)
                            substituted_expression <- proof_substitute(expression, names, values) if proof_expr_has_call(expression)
                            proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position) if proof_expr_has_call(expression)
                            proof_clear_facts_after_call(facts, names, frame_parameters, report, name)
                    if expression_has_unmodeled_operator:
                        # A nested call may have restored summary facts after the initial
                        # invalidation; none can cross an unmodeled operator evaluation.
                        proof_forget_values(names, values, position)
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                    flow.normal <- false if terminal_expression
                Ast::Stmt.Return(value, position):
                    if value is returned:
                        match returned:
                            Ast::Expr.Catch(guarded, arms, _):
                                # Expression catches are checked arm-by-arm. The supported
                                # shape is guaranteed by the statement admission gate above;
                                # each arm receives its own post-state and the catch itself
                                # is terminal at this return boundary.
                                if not proof_return_analysis_budget_available(facts, names, values, report, name, position.line):
                                    report.proof_obligation(false)
                                    flow.normal <- false
                                    flow.valid <- false
                                    return true
                                proof_check_catch_return(guarded, arms, names, values, facts, ensures, functions, frame_parameters, old_values, changes, preserves, report, name, annotations, position)
                                flow.normal <- false
                                flow.valid <- false if report.return_analysis_budget_reported
                                return true
                            Ast::Expr.Match(scrutinee, arms, _):
                                # A value match has one return value per arm. Checking the
                                # lowered conditional as one expression would let a summary
                                # fact from one arm justify another, so preserve the source
                                # branch states and check each arm through a synthetic return.
                                if not proof_return_analysis_budget_available(facts, names, values, report, name, position.line):
                                    report.proof_obligation(false)
                                    flow.normal <- false
                                    flow.valid <- false
                                    return true
                                proof_check_value_match_return(scrutinee, arms, names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, position)
                                flow.normal <- false
                                flow.valid <- false if report.return_analysis_budget_reported
                                return true
                            _:
                                pass
                        return_value: mutable Ast::Expr = proof_substitute(returned, names, values)
                        returned_has_unmodeled_operator: bool = proof_invalidate_for_unmodeled_operator(returned, names, values, facts, frame_parameters, report, name, position)
                        return_value <- Ast::Expr.Invalid if returned_has_unmodeled_operator
                        return_call_applied: mutable bool = false
                        # Only a syntactic call at the return site is evaluated here. If a
                        # local already contains a summarized call result, substituting it
                        # produces a Call-shaped value but must not execute/apply that call a
                        # second time; the declaration or assignment already established its
                        # postcondition and may have consumed the caller's pre-call facts.
                        match returned:
                            Ast::Expr.Call(_, _, _, _):
                                # An integer conversion of a bare name runs no source function,
                                # so there is no summary to apply; the value stays the term.
                                if not proof_expr_calls_are_conversions(return_value, functions, 0):
                                    proof_check_frame_call_children(returned, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                                    return_call_applied <- proof_apply_function(return_value, return_value, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations)
                                    proof_check_opaque_call_frame(return_value, names, frame_parameters, changes, preserves, functions, report, name) if not return_call_applied
                                    return_value <- Ast::Expr.Invalid if not return_call_applied
                            Ast::Expr.GetElse(guarded, _, _):
                                # A GetElse is transparent only after its recovery has been
                                # checked. If its successful value is a syntactic call, apply
                                # that summary exactly once here, just as for `return call()`.
                                # This is distinct from a substituted local whose value merely
                                # happens to have Call shape.
                                match guarded:
                                    Ast::Expr.Call(_, _, _, _):
                                        proof_check_frame_call_children(guarded, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                                        return_call_applied <- proof_apply_function(return_value, return_value, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations)
                                        proof_check_opaque_call_frame(return_value, names, frame_parameters, changes, preserves, functions, report, name) if not return_call_applied
                                        return_value <- Ast::Expr.Invalid if not return_call_applied
                                    _:
                                        pass
                            _:
                                proof_check_frame_calls_in_expression(returned, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(returned)
                                return_value <- proof_substitute(returned, names, values) if proof_expr_has_call(returned)
                        return_value <- proof_rewrite_pure_call_summaries(return_value, facts, functions, 0) if proof_expr_has_call(return_value)
                        # Only a call written at the return runs here. A local's call ran at its
                        # binding, which already applied its summary and havoc; clearing again
                        # would discard the summary that describes the returned value.
                        # Numeric conversions and verified pure calls write nothing.
                        proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if proof_expr_has_call(returned) and not return_call_applied and not proof_contract_calls_are_pure(returned, functions)
                        if returned_has_unmodeled_operator:
                            proof_forget_values(names, values, position)
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                            return_value <- Ast::Expr.Invalid
                        proof_invalidate_moved_roots(moved_roots, names, values, facts, report, name, position)
                        result_name: mutable darray[sview] = ["result"]
                        result_value: mutable darray[Ast::Expr] = [return_value]
                        for ensure in ensures |report, name, facts, result_name, result_value, position|:
                            current_goal: Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, values, old_values)
                            goal: mutable Ast::Expr = proof_substitute(current_goal, result_name, result_value)
                            projected_goal: (known: bool, value: Ast::Expr) = proof_project_tuple_result(current_goal, return_value, functions, name)
                            goal <- projected_goal.value if projected_goal.known
                            goal <- proof_rewrite_pure_call_summaries(goal, facts, functions, 0) if proof_expr_has_call(goal)
                            proof_add_pure_call_witnesses(goal, facts, functions, report, position.line, name, 0)
                            proven: bool = proof_certify_return_goal(facts, return_value, goal, report, position.line, name, annotations, proof_quantifier_rule(ensure, annotations))
                            report.proof_obligation(proven)
                            if not proven:
                                proof_add_goal_failure(report, "ensure-unproven", position.line, name, "return value does not establish ensure", facts, goal)
                                if report.findings.count > 0 and report.findings[report.findings.count - 1].counterexample_found and not proof_return_counterexample_parameters_only(report, functions, name):
                                    report.findings[report.findings.count - 1].status <- "unknown"
                                    report.findings[report.findings.count - 1].counterexample_found <- false
                                    report.findings[report.findings.count - 1].counterexample_count <- 0
                    else:
                        # A void return still completes normally and must establish its
                        # postconditions. There is no result binding to substitute, so a
                        # result-dependent ensure fails closed rather than disappearing.
                        for ensure in ensures |report, name, facts, names, values, frame_parameters, old_values, annotations, position|:
                            goal: Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, values, old_values)
                            proven: mutable bool = false
                            if proof_expr_mentions_name(goal, "result"):
                                failed_rule: mutable sview = proof_quantifier_rule(ensure, annotations)
                                failed_rule <- "goal" if failed_rule == ""
                                proof_add_goal_attempt(report, facts, goal, position.line, name, failed_rule, false)
                            else:
                                proven <- proof_certify_goal_with_rule(facts, goal, report, position.line, name, annotations, proof_quantifier_rule(ensure, annotations))
                            report.proof_obligation(proven)
                            proof_add_goal_failure(report, "ensure-unproven", position.line, name, "void return does not establish ensure", facts, goal) if not proven
                        proof_invalidate_moved_roots(moved_roots, names, values, facts, report, name, position)
                    flow.normal <- false
                Ast::Stmt.If(condition, then_body, else_body, position):
                    # An if forks the symbolic environment. If the function budget is already
                    # spent, refuse before cloning both branch states.
                    if not proof_return_analysis_budget_available(facts, names, values, report, name, position.line):
                        report.proof_obligation(false)
                        flow.normal <- true
                        flow.valid <- false
                        return true
                    condition_value: mutable Ast::Expr = proof_substitute(condition, names, values)
                    condition_has_call: bool = proof_expr_has_call(condition)
                    condition_has_overloaded_operator: bool = proof_source_expression_has_overloaded_operator(condition, report.source_primitive_operator_mask, 0)
                    condition_facts_stable: bool = not condition_has_overloaded_operator and (not condition_has_call or proof_contract_calls_are_pure(condition, functions))
                    proof_check_frame_calls_in_expression(condition, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if condition_has_call
                    condition_may_mutate_state: bool = condition_has_overloaded_operator or (condition_has_call and not condition_facts_stable)
                    proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position) if condition_may_mutate_state
                    branch_value_count: usize = values.count
                    then_names: mutable darray[sview] = proof_copy_names(names)
                    then_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                    then_facts: mutable darray[Ast::Expr] @r = proof_copy_exprs(facts)
                    then_flow: mutable ProofFlow = proof_empty_flow()
                    proof_clear_facts_after_call(then_facts, names, frame_parameters, report, name) if condition_may_mutate_state
                    # If evaluating the condition can change state, its source-level formula
                    # describes a mixture of pre- and post-call values. Clearing the incoming
                    # facts is not enough: reintroducing that formula would let its conjuncts
                    # resurrect stale values (for example, an index guard before a mutating
                    # call on the RHS). Until branch conditions carry explicit post-state
                    # semantics, admit them only when every call is a verified pure call.
                    proof_add_branch_condition_facts(then_facts, report, condition_value, position.line, name) if condition_facts_stable
                    proof_add_effect_stable_short_circuit_branch_fact(then_facts, then_names, frame_parameters, report, name, condition_value, true, position.line) if condition_may_mutate_state and condition_has_call
                    proof_check_returns(then_body, &then_names, &then_values, &then_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &then_flow)
                    if report.return_analysis_budget_reported:
                        flow.normal <- true
                        flow.valid <- false
                        return true
                    else_names: mutable darray[sview] = proof_copy_names(names)
                    else_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                    else_facts: mutable darray[Ast::Expr] @r = proof_copy_exprs(facts)
                    else_flow: mutable ProofFlow = proof_empty_flow()
                    negated: Ast::Expr = proof_branch_negation(condition_value, Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0})
                    proof_clear_facts_after_call(else_facts, names, frame_parameters, report, name) if condition_may_mutate_state
                    proof_add_branch_condition_facts(else_facts, report, negated, position.line, name) if condition_facts_stable
                    proof_add_effect_stable_short_circuit_branch_fact(else_facts, else_names, frame_parameters, report, name, condition_value, false, position.line) if condition_may_mutate_state and condition_has_call
                    proof_check_returns(else_body, &else_names, &else_values, &else_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &else_flow)
                    if report.return_analysis_budget_reported:
                        flow.normal <- true
                        flow.valid <- false
                        return true
                    then_falls_through: bool = then_flow.normal
                    else_falls_through: bool = else_flow.normal
                    flow.breaks <- then_flow.breaks or else_flow.breaks
                    flow.continues <- then_flow.continues or else_flow.continues
                    flow.valid <- then_flow.valid and else_flow.valid
                    proof_append_continue_states(flow, then_flow)
                    proof_append_continue_states(flow, else_flow)
                    # If one branch definitely terminates, the other branch is the complete
                    # state at the following statement. Merge only the surviving branch and
                    # only when it did not introduce a branch-local binding; leaking a local
                    # name or a fact mentioning it would be unsound. When both branches can
                    # continue, retain the pre-branch state as a conservative intersection.
                    if not then_falls_through and else_falls_through:
                        if condition_facts_stable and else_names.count == names.count and else_values.count >= branch_value_count:
                            for index in 0..<branch_value_count |index, values, else_values|:
                                values[index] <- else_values[index]
                            facts.clear()
                            facts.extend(else_facts)
                        else:
                            proof_forget_values(names, values, position)
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                            # Control reaches the next statement only through the surviving
                            # branch, so its end state holds here. The opaque condition call
                            # forbids importing that state wholesale, but a call-stable fact
                            # is over by-value scalars of this frame that nothing references:
                            # true at the end of the branch means true at this point.
                            else_reads: darray[Ast::Expr] = proof_join_reads(else_facts, values, names, else_values, branch_value_count)
                            proof_restore_call_stable_facts(else_reads, facts, names, frame_parameters, report, name, report.aliased_names) if else_names.count == names.count
                            # The same holds for the values it leaves: the call-stable ones, a
                            # module constant among them, keep their recorded value.
                            proof_restore_branch_values(values, names, then_values, else_values, false, else_names.count == names.count, branch_value_count, facts, frame_parameters, report, name)
                    elif then_falls_through and not else_falls_through:
                        if condition_facts_stable and then_names.count == names.count and then_values.count >= branch_value_count:
                            for index in 0..<branch_value_count |index, values, then_values|:
                                values[index] <- then_values[index]
                            facts.clear()
                            facts.extend(then_facts)
                        else:
                            proof_forget_values(names, values, position)
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                            then_reads: darray[Ast::Expr] = proof_join_reads(then_facts, values, names, then_values, branch_value_count)
                            proof_restore_call_stable_facts(then_reads, facts, names, frame_parameters, report, name, report.aliased_names) if then_names.count == names.count
                            proof_restore_branch_values(values, names, then_values, else_values, then_names.count == names.count, false, branch_value_count, facts, frame_parameters, report, name)
                    elif not then_falls_through and not else_falls_through:
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                        flow.normal <- false
                    # Only a branch that falls through reaches the next statement. A return or
                    # continue checks its own state, a raise leaves the function, and a loop exit
                    # reached by a break keeps only the invariants the break re-establishes, so a
                    # leaving branch's effects cannot weaken this join. The raise in
                    # `raise E if not live(table, slot)` is call-shaped but never reaches it.
                    then_weakens_join: bool = then_falls_through and proof_body_may_modify(then_body, report.source_primitive_operator_mask, report)
                    else_weakens_join: bool = else_falls_through and proof_body_may_modify(else_body, report.source_primitive_operator_mask, report)
                    if not lemma_steps and (then_weakens_join or else_weakens_join):
                        prior_facts: darray[Ast::Expr] = proof_copy_exprs(facts)
                        proof_forget_values(names, values, position)
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                        # The arms were executed symbolically, so a fact still standing at a
                        # surviving arm's exit is true on that path. Import the call-stable
                        # ones from the paths that actually reach this statement, and the
                        # recorded values those paths agree on.
                        proof_restore_branch_values(values, names, then_values, else_values, then_falls_through and then_names.count == names.count, else_falls_through and else_names.count == names.count, branch_value_count, facts, frame_parameters, report, name)
                        # A forgotten binding is joined under its own name, which an arm that
                        # rebound it to a fresh symbol still uses for the old value.
                        then_joined: darray[Ast::Expr] = proof_join_reads(then_facts, values, names, then_values, branch_value_count)
                        else_joined: darray[Ast::Expr] = proof_join_reads(else_facts, values, names, else_values, branch_value_count)
                        if then_falls_through and else_falls_through:
                            proof_restore_branch_stable_facts(then_joined, else_joined, facts, names, frame_parameters, report, name, prior_facts, not proof_body_has_call(then_body, report.source_primitive_operator_mask) and not proof_body_has_call(else_body, report.source_primitive_operator_mask))
                            proof_restore_branch_implied_facts(&then_facts, &else_facts, prior_facts, then_names, else_names, then_values, else_values, values, names, branch_value_count, facts, frame_parameters, report, name, annotations, position, not proof_body_has_call(then_body, report.source_primitive_operator_mask) and not proof_body_has_call(else_body, report.source_primitive_operator_mask)) if proof_arm_names_extend(then_names, names) and proof_arm_names_extend(else_names, names)
                        elif then_falls_through:
                            proof_restore_call_stable_facts(then_joined, facts, names, frame_parameters, report, name, report.aliased_names)
                        elif else_falls_through:
                            proof_restore_call_stable_facts(else_joined, facts, names, frame_parameters, report, name, report.aliased_names)
                _:
                    return false
            return true
