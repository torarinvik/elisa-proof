# Private cleanup policy for statement transitions.
extend ElisaProof:
    private:
        def proof_return_statement_skips_cleanup(statement: Ast::Stmt) -> bool:
            match statement:
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        match returned:
                            Ast::Expr.Catch(_, _, _):
                                return true
                            Ast::Expr.Match(_, _, _):
                                return true
                            _:
                                pass
                Ast::Stmt.For(bind, _, _, _, _):
                    return bind == "parallel"
                _:
                    pass
            return false
