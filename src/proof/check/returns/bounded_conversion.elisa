extend ElisaProof:
    private:
        # Preserve only the narrow, source-witnessed conversion modeled by both
        # the arithmetic producer and replay. This is not general call purity.
        def proof_return_bounded_u8_conversion(expression: Ast::Expr, facts: darray[Ast::Expr]&, functions: ProofFunctionTable&) -> bool:
            match proof_strip_parens(expression):
                Ast::Expr.Call(callee, arguments, _, _):
                    conversion = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                    return false if not conversion.known
                    match callee:
                        Ast::Expr.Field(_, target, _):
                            return target == "u8" and proof_bounded_u8_receiver(conversion.receiver, facts)
                        _:
                            return false
                _:
                    return false
