extend ElisaProof:
    private:
        def proof_return_conversion_receiver_is_place_with_work(receiver: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, is_place: bool):
            if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT:
                return (false, false)
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match receiver:
                Ast::Expr.Ident(name, _):
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                    return (true, name != "")
                Ast::Expr.Field(object, field, _):
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(field))
                    return (true, false) if field == ""
                    return proof_return_conversion_receiver_is_place_with_work(object, depth + 1, budget, exhausted)
                Ast::Expr.Paren(inner, _):
                    return proof_return_conversion_receiver_is_place_with_work(inner, depth + 1, budget, exhausted)
                _:
                    return (true, false)

        def proof_return_call_is_conversion_with_work(expression: Ast::Expr, functions: ProofFunctionTable&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, is_conversion: bool):
            can Abort.Panic:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                return (false, false) if budget > PROOF_LINEAR_SAFETY_WORK_LIMIT
                return (false, false) if proof_goal_bool_ref_value(exhausted)
                return (false, false) if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
                match expression:
                    Ast::Expr.Paren(inner, _):
                        return proof_return_call_is_conversion_with_work(inner, functions, depth + 1, budget, exhausted)
                    Ast::Expr.Unary(_, operand, _):
                        return proof_return_call_is_conversion_with_work(operand, functions, depth + 1, budget, exhausted)
                    Ast::Expr.Binary(left, _, right, _):
                        left_result: (complete: bool, is_conversion: bool) = proof_return_call_is_conversion_with_work(left, functions, depth + 1, budget, exhausted)
                        return (false, false) if not left_result.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not left_result.is_conversion
                        return proof_return_call_is_conversion_with_work(right, functions, depth + 1, budget, exhausted)
                    Ast::Expr.If(condition, then_expression, else_expression, _):
                        condition_result: (complete: bool, is_conversion: bool) = proof_return_call_is_conversion_with_work(condition, functions, depth + 1, budget, exhausted)
                        return (false, false) if not condition_result.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not condition_result.is_conversion
                        then_result: (complete: bool, is_conversion: bool) = proof_return_call_is_conversion_with_work(then_expression, functions, depth + 1, budget, exhausted)
                        return (false, false) if not then_result.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not then_result.is_conversion
                        return proof_return_call_is_conversion_with_work(else_expression, functions, depth + 1, budget, exhausted)
                    Ast::Expr.Call(callee, arguments, _, _):
                        match callee:
                            Ast::Expr.Field(_, target, _):
                                return (false, false) if not proof_linear_safety_work_charge_scaled(budget, exhausted, sview_len(target), PROOF_FACT_NUMERIC_CAST_TARGET_COUNT + 10)
                            _:
                                pass
                        conversion = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                        return (true, false) if not conversion.known
                        place: (complete: bool, is_place: bool) = proof_return_conversion_receiver_is_place_with_work(conversion.receiver, 0, budget, exhausted)
                        return (false, false) if not place.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, place.is_place)
                    _:
                        had_call: bool = proof_expr_has_call_with_work(expression, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT)
                        exhausted <- true if budget > PROOF_LINEAR_SAFETY_WORK_LIMIT
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, not had_call)

        # Preserve only the narrow, source-witnessed conversion modeled by both
        # the arithmetic producer and replay. This is not general call purity.
        def proof_return_bounded_u8_conversion_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, functions: ProofFunctionTable&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, accepted: bool):
            can Abort.Panic:
                stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
                return (false, false) if not stripped.complete or proof_goal_bool_ref_value(exhausted)
                match stripped.expression:
                    Ast::Expr.Call(callee, arguments, _, _):
                        match callee:
                            Ast::Expr.Field(_, target, _):
                                return (false, false) if not proof_linear_safety_work_charge_scaled(budget, exhausted, sview_len(target), PROOF_FACT_NUMERIC_CAST_TARGET_COUNT + 10)
                            _:
                                pass
                        conversion = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                        return (true, false) if not conversion.known
                        match callee:
                            Ast::Expr.Field(_, target, _):
                                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(target))
                                return (true, false) if target != "u8"
                                return proof_bounded_u8_receiver_with_work(conversion.receiver, facts, budget, exhausted)
                            _:
                                return (true, false)
                    _:
                        return (true, false)
