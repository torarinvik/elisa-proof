extend ElisaProof:
    private:
        def proof_check_return_matches(statement: Ast::Stmt, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, flow: mutable ProofFlow&) -> bool can[Global.Read, Global.Write]:
            match statement:
                Ast::Stmt.Match(scrutinee, arms, match_position):
                    match_work: mutable usize = report.analysis_1.budgets.match_lowering_source_work
                    scrutinee_value: mutable Ast::Expr = proof_substitute_with_work(scrutinee, names, values, &match_work)
                    scrutinee_has_call: bool = proof_frame_expression_has_call_with_work(scrutinee, report, name, match_position.line)
                    scrutinee_has_overloaded_operator: bool = proof_frame_expression_has_overloaded_operator_with_work(scrutinee, report.source.source_primitive_operator_mask, report, name, match_position.line)
                    scrutinee_has_move: bool = proof_frame_expression_has_move_with_work(scrutinee_value, report, name, match_position.line)
                    scrutinee_has_fresh_value: bool = proof_block_expression_has_fresh_value(scrutinee_value, 0)
                    scrutinee_effectful: bool = scrutinee_has_call or scrutinee_has_overloaded_operator or scrutinee_has_move
                    scrutinee_stable: bool = not scrutinee_effectful and not scrutinee_has_fresh_value
                    pattern_source: Ast::Expr = scrutinee_value if scrutinee_stable else Ast::Expr.Invalid
                    (proof_check_frame_calls_in_expression(scrutinee, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write}) if scrutinee_has_call
                    scrutinee_value <- proof_substitute_with_work(scrutinee, names, values, &match_work) if scrutinee_has_call
                    proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, Ast::expr_pos(scrutinee)) if scrutinee_effectful
                    (proof_clear_facts_after_call(facts, names, frame_parameters, report, name) can Global{Read,Write}) if scrutinee_effectful
                    pattern_type: Ast::Expr = proof_pattern_active_formal_type(report, name, scrutinee, pattern_source, names) if scrutinee_stable else Ast::Expr.Absent
                    arms_may_modify: mutable bool = false
                    match_has_normal: mutable bool = false
                    match_valid: mutable bool = true
                    # Arms are tried in order, so an arm is reached only when every earlier
                    # unguarded arm's pattern failed. Only exact conditions may be negated.
                    refuted: mutable darray[Ast::Expr] = []
                    variant_exclusion_enum_cache: mutable ProofVariantExclusionEnumCache = ProofVariantExclusionEnumCache{names: [], variant_starts: [], variant_counts: [], variants: [], complete: [], unique: []}
                    refuting: mutable bool = true
                    if scrutinee_has_overloaded_operator:
                        match_valid <- false
                        report.proof_obligation(false)
                        proof_add_finding(report, "expression-unsupported", match_position.line, name, "match scrutinee uses a source-overloaded operator with unmodeled effects")
                    for arm in arms |names, values, facts, ensures, lemmas, report, name, lemma_steps, arms_may_modify, match_position, refuted, variant_exclusion_enum_cache, refuting, pattern_type|:
                        # Check the shared per-function budget before cloning three symbolic
                        # arrays. The recursive checker performs the same check, but doing it
                        # only after these copies lets a huge match allocate one snapshot per
                        # remaining arm even after analysis has already been refused.
                        if not proof_return_analysis_budget_available(facts, names, values, report, name, match_position.line):
                            report.proof_obligation(false)
                            match_valid <- false
                            match_has_normal <- true
                            arms_may_modify <- true
                            break
                        # Empty or very small arms may not recurse enough to consume the
                        # statement budget. Count each branch expansion before its snapshots.
                        report.analysis_1.budgets.return_steps <- report.analysis_1.budgets.return_steps + 1
                        arm_names: mutable darray[sview] = proof_copy_names(names)
                        arm_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                        arm_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                        arm_flow: mutable ProofFlow = proof_empty_flow()
                        arm_refuted: mutable Ast::Expr = Ast::Expr.Invalid
                        arm_facts.clear() if scrutinee_effectful
                        first_binding: usize = arm_values.count
                        pattern_supported: mutable bool = proof_bind_pattern(arm.pattern, match_position, pattern_source, &arm_names, &arm_values)
                        proof_freshen_opaque_bindings(&arm_values, first_binding, pattern_source, report, match_position) if pattern_supported
                        pattern_bindings: mutable darray[sview] = []
                        # Every arm consumes the function-wide return-step budget above. The
                        # helper also has a per-pattern work cap; never use truncated bindings
                        # to retain facts when that independent pattern walk is incomplete.
                        pattern_source_work: mutable usize = report.analysis_1.budgets.return_source_work
                        pattern_bindings_complete: bool = proof_structural_pattern_bindings_with_source_limit(arm.pattern, &pattern_bindings, pattern_source_work, PROOF_PURITY_WALK_WORK_LIMIT)
                        report.analysis_1.budgets.return_source_work <- pattern_source_work
                        if pattern_source_work > PROOF_PURITY_WALK_WORK_LIMIT:
                            pattern_work: mutable ProofBlockPurityWork = ProofBlockPurityWork{used: pattern_source_work, reported: report.analysis_1.budgets.return_source_reported, match_work_used: report.analysis_1.budgets.match_lowering_source_work}
                            proof_purity_budget_finding(report, name, match_position.line, "proof-return-pattern-source-work", pattern_source_work, PROOF_PURITY_WALK_WORK_LIMIT, &pattern_work)
                            report.analysis_1.budgets.return_source_work <- pattern_work.used
                            report.analysis_1.budgets.return_source_reported <- pattern_work.reported
                            report.proof_obligation(false)
                        pattern_supported <- false if not pattern_bindings_complete
                        proof_remove_type_bound_facts_for_names(&arm_facts, pattern_bindings)
                        proof_add_payload_binder_type_facts(arm.pattern, arm_values, first_binding, &arm_facts, report, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, name, match_position) if pattern_supported
                        if not pattern_supported:
                            arm_flow.valid <- false
                            report.proof_obligation(false)
                            proof_add_finding(report, "pattern-unsupported", match_position.line, name, "match pattern bindings are not modeled for proof-state substitution")
                            arm_facts.clear()
                        if pattern_supported and scrutinee_stable:
                            pattern_condition: Ast::Expr? = proof_pattern_condition_using_type(arm.pattern, pattern_source, match_position, pattern_type, report)
                            for earlier in refuted |earlier, arm_facts, report, name, match_position|:
                                proof_add_traced_fact(arm_facts, report, Ast::Expr.Unary(TokenKind.Not, earlier, match_position), "branch-condition", match_position.line, name)
                            if pattern_condition is condition:
                                proof_add_traced_fact(arm_facts, report, condition, "branch-condition", match_position.line, name)
                                proof_add_variant_exclusions(variant_exclusion_enum_cache, &arm_facts, report, condition, match_position.line, name, match_position)
                                arm_refuted <- condition if proof_pattern_condition_exact_using_type(arm.pattern, pattern_type, report)
                        guard_present: mutable bool = false
                        match arm.guard:
                            Ast::Expr.Absent:
                                pass
                            _:
                                guard_present <- true
                        guard_has_call: mutable bool = false
                        guard_has_move: mutable bool = false
                        guard_has_overloaded_operator: mutable bool = false
                        refuted.push(arm_refuted) if refuting and not guard_present and not (arm_refuted is Ast::Expr.Invalid)
                        if guard_present:
                            guard_has_overloaded_operator <- proof_frame_expression_has_overloaded_operator_with_work(arm.guard, report.source.source_primitive_operator_mask, report, name, match_position.line)
                            guard_value: mutable Ast::Expr = proof_substitute_with_work(arm.guard, arm_names, arm_values, &match_work)
                            guard_has_call <- proof_frame_expression_has_call_with_work(arm.guard, report, name, match_position.line)
                            guard_has_move <- proof_frame_expression_has_move_with_work(guard_value, report, name, match_position.line)
                            guard_supported: bool = proof_expr_supported(arm.guard) and not guard_has_overloaded_operator and not guard_has_move and not proof_block_expression_has_fresh_value(guard_value, 0)
                            if not guard_supported:
                                arm_flow.valid <- false
                                report.proof_obligation(false)
                                proof_add_finding(report, "expression-unsupported", match_position.line, name, "unsupported match guard cannot enter a verified proof state")
                                arm_facts.clear()
                            (proof_check_frame_calls_in_expression(arm.guard, arm_facts, arm_names, arm_values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write}) if guard_has_call and guard_supported
                            guard_value <- proof_substitute_with_work(arm.guard, arm_names, arm_values, &match_work) if guard_has_call and guard_supported
                            guard_has_move <- proof_frame_expression_has_move_with_work(guard_value, report, name, match_position.line) if guard_has_call and guard_supported
                            guard_facts_stable: bool = not guard_has_overloaded_operator and not guard_has_move and not proof_block_expression_has_fresh_value(guard_value, 0) and (not guard_has_call or (not proof_fact_expression_has_fresh_runtime_value(report, arm.guard) and proof_contract_calls_are_pure(arm.guard, functions)))
                            proof_forget_values(arm_names, arm_values, match_position) if guard_has_call and guard_supported
                            arm_facts.clear() if guard_has_call and guard_supported
                            # Unsupported or effectful guards may mutate values that existing
                            # pattern facts describe. Retain no such fact, and never publish the
                            # guard's mixed pre/post-state formula as a branch condition.
                            if guard_has_overloaded_operator or guard_has_move or (guard_has_call and not guard_facts_stable):
                                proof_forget_values(arm_names, arm_values, match_position)
                                arm_facts.clear()
                            if guard_has_call or guard_has_overloaded_operator or guard_has_move:
                                refuted.clear()
                                refuting <- false
                            proof_add_traced_fact(arm_facts, report, guard_value, "branch-condition", match_position.line, name) if guard_supported and guard_facts_stable
                        report.analysis_1.budgets.match_lowering_source_work <- match_work
                        (proof_check_returns(arm.body, &arm_names, &arm_values, &arm_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &arm_flow) can Global{Read,Write})
                        match_work <- report.analysis_1.budgets.match_lowering_source_work
                        match_has_normal <- true if arm_flow.normal
                        flow.breaks <- flow.breaks or arm_flow.breaks
                        flow.continues <- flow.continues or arm_flow.continues
                        proof_append_continue_states(flow, arm_flow)
                        match_valid <- false if not arm_flow.valid
                        # A guard's call runs whenever its pattern matches, even when a later arm
                        # is taken, so it always weakens the join. An arm's own effects matter
                        # only when the arm falls through to the statement after the match.
                        arms_may_modify <- true if not pattern_supported or guard_has_call or guard_has_overloaded_operator or guard_has_move or (arm_flow.normal and proof_body_may_modify(arm.body, report.source.source_primitive_operator_mask, report))
                        if report.analysis_1.budgets.return_reported:
                            report.analysis_1.budgets.match_lowering_source_work <- match_work
                            match_valid <- false
                            match_has_normal <- true
                            arms_may_modify <- true
                            break
                    if arms_may_modify:
                        proof_forget_values(names, values, Ast::expr_pos(scrutinee))
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                    flow.normal <- match_has_normal if arms.count > 0
                    flow.valid <- flow.valid and match_valid
                    if match_valid and match_has_normal and not arms_may_modify and scrutinee_stable and refuting:
                        case_disjunction: Ast::Expr? = proof_match_case_disjunction(refuted, report, match_position)
                        if case_disjunction is fact:
                            proof_add_traced_fact(facts, report, fact, "match-exhaustiveness", match_position.line, name) if not (any existing in facts where proof_expr_equal(existing, fact))
                    report.analysis_1.budgets.match_lowering_source_work <- match_work
                Ast::Stmt.Block(block_kind, _, binding, block_body, block_position):
                    if block_kind == "assert_by":
                        proofed: bool = (proof_check_block(block_body, binding, facts, names, values, frame_parameters, functions, lemmas, report, name, annotations) can Global{Read,Write})
                        if proofed and block_body.count > 0:
                            match block_body[0]:
                                Ast::Stmt.Contract("assert", block_goal, _):
                                    match_work: mutable usize = report.analysis_1.budgets.match_lowering_source_work
                                    runtime_goal: mutable Ast::Expr = proof_substitute_with_work(block_goal, names, values, &match_work)
                                    runtime_goal_has_call: bool = proof_frame_expression_has_call_with_work(block_goal, report, name, block_position.line)
                                    runtime_goal_has_move: bool = proof_frame_expression_has_move_with_work(block_goal, report, name, block_position.line)
                                    runtime_goal_has_overloaded_operator: bool = proof_frame_expression_has_overloaded_operator_with_work(block_goal, report.source.source_primitive_operator_mask, report, name, block_position.line)
                                    runtime_goal_may_mutate_state: bool = runtime_goal_has_call or runtime_goal_has_move or runtime_goal_has_overloaded_operator
                                    # `assert ... by:` still evaluates its runtime guard after
                                    # the erased proof body. Its calls cannot be allowed to
                                    # preserve facts established before guard evaluation.
                                    (proof_check_frame_calls_in_expression(block_goal, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write}) if runtime_goal_has_call
                                    proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, Ast::expr_pos(block_goal)) if runtime_goal_may_mutate_state
                                    (proof_clear_facts_after_call(facts, names, frame_parameters, report, name) can Global{Read,Write}) if runtime_goal_may_mutate_state
                                    proof_add_traced_fact(facts, report, runtime_goal, "runtime-guard", block_position.line, name) if proof_runtime_fact_is_stable(runtime_goal, block_goal, report.source.source_primitive_operator_mask, report)
                                    report.analysis_1.budgets.match_lowering_source_work <- match_work
                                _:
                                    pass
                    if block_kind != "assert_by":
                        if not proof_return_analysis_budget_available(facts, names, values, report, name, block_position.line):
                            report.proof_obligation(false)
                            flow.normal <- true
                            flow.valid <- false
                            return true
                        block_names: mutable darray[sview] = proof_copy_names(names)
                        block_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                        block_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                        if binding != "":
                            # Error/success scoped blocks introduce a local binding. Keep it
                            # opaque and lexical; otherwise a binding that shadows a caller
                            # parameter could leak the parameter's symbolic value into a
                            # return from the block.
                            block_names.push(binding)
                            block_values.push(Ast::Expr.Invalid)
                            block_binding_names: mutable darray[sview] = [binding]
                            proof_remove_type_bound_facts_for_names(&block_facts, block_binding_names)
                        block_flow: mutable ProofFlow = proof_empty_flow()
                        (proof_check_returns(block_body, &block_names, &block_values, &block_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &block_flow) can Global{Read,Write})
                        if report.analysis_1.budgets.return_reported:
                            flow.normal <- true
                            flow.valid <- false
                            return true
                        flow.normal <- block_flow.normal
                        flow.breaks <- block_flow.breaks
                        flow.continues <- block_flow.continues
                        flow.valid <- flow.valid and block_flow.valid
                        proof_append_continue_states(flow, block_flow)
                        if proof_body_may_modify(block_body, report.source.source_primitive_operator_mask, report):
                            proof_forget_values(names, values, block_position)
                            if block_kind == "can" and block_flow.normal:
                                # An effect block only grants capabilities; its body already
                                # havocked what its own writes and calls reach, so the
                                # outer facts it left standing still hold. Facts over the
                                # block's locals or binding leave with its scope.
                                facts.clear()
                                for fact in block_facts |facts, block_names, names|:
                                    facts.push(fact) if not proof_expr_mentions_arm_local(fact, block_names, names.count)
                            else:
                                proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                                if binding == "" and (block_names.count == names.count or block_kind == "region"):
                                    # Region locals expire, including names that
                                    # shadow an outer scalar. Retain only facts
                                    # whose surviving terms are call-stable.
                                    surviving: mutable darray[Ast::Expr] = []
                                    for fact in block_facts |surviving|:
                                        surviving.push(fact) if not proof_expr_mentions_arm_local(fact, block_names, names.count)
                                    proof_restore_call_stable_facts(surviving, facts, names, frame_parameters, report, name, report.aliases.aliased_names)
                Ast::Stmt.Break(label, position):
                    if loop_depth == 0 or label != "":
                        flow.valid <- false
                        report.proof_obligation(false)
                        proof_add_finding(report, "control-flow-unsupported", position.line, name, "break is outside a modeled loop or uses an unsupported label")
                    else:
                        flow.valid <- false if not (proof_check_loop_control_invariants(loop_invariants, names, values, facts, loop_scope_count, frame_parameters, old_values, report, name, annotations, position.line) can Global{Read,Write})
                        flow.breaks <- true
                    flow.normal <- false
                Ast::Stmt.Continue(label, position):
                    if loop_depth == 0 or label != "":
                        flow.valid <- false
                        report.proof_obligation(false)
                        proof_add_finding(report, "control-flow-unsupported", position.line, name, "continue is outside a modeled loop or uses an unsupported label")
                    else:
                        flow.valid <- false if not (proof_check_loop_control_invariants(loop_invariants, names, values, facts, loop_scope_count, frame_parameters, old_values, report, name, annotations, position.line) can Global{Read,Write})
                        flow.continues <- true
                        proof_record_continue_state(flow, names, values, facts)
                    flow.normal <- false
                Ast::Stmt.Invalid:
                    flow.valid <- false
                    flow.normal <- false
                    report.proof_obligation(false)
                    proof_add_finding(report, "statement-unsupported", 0, name, "invalid statement cannot enter a verified proof state")
                    proof_forget_values(names, values, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})
                    proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                _:
                    # This arm is unreachable for the compiler AST version known to this
                    # build. Keep it rejecting so adding a future statement variant to the
                    # live frontend cannot silently turn an unmodeled state transition into
                    # a verified no-op.
                    flow.valid <- false
                    flow.normal <- false
                    report.proof_obligation(false)
                    proof_add_finding(report, "statement-unsupported", 0, name, "unknown statement form cannot enter a verified proof state")
                    proof_forget_values(names, values, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})
                    proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
            return true
