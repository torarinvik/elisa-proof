# Private statement-transition submodule for the checker.
include "local_record_field_types.elisa"
extend ElisaProof:
    private:
        # Primitive numeric casts are total reserved conversions. A user-defined call
        # may also be retained as the exact scalar written here, but only when its
        # verified executable summary proves it pure and scalar-valued. The statement
        # transition will separately apply that summary and independent replay checks
        # the resulting fact; this predicate does not itself grant a postcondition.
        def proof_scalar_reference_write_value_supported(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            return true if not proof_expr_has_call(expression)
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    cast: (known: bool, receiver: Ast::Expr) = proof_expr_numeric_cast_receiver(callee, arguments)
                    if cast.known:
                        return not proof_expr_has_call(cast.receiver) and proof_expr_supported(cast.receiver)
                    called: sview = proof_callable_name(callee)
                    called_index: usize = proof_function_index(functions, called)
                    return called != "" and called_index < functions.return_scalar.count and functions.return_scalar[called_index] and proof_contract_calls_are_pure(expression, functions)
                _:
                    return false

        def proof_scalar_reference_write_target(target: Ast::Expr, operator: TokenKind, initializer: Ast::Expr, names: darray[sview]&, frame_parameters: darray[sview]&, functions: ProofFunctionTable&, declarations: darray[Ast::Decl]&, owner: sview) -> (known: bool, name: sview):
            return (false, "") if operator != TokenKind.LArrow or not proof_scalar_reference_write_value_supported(initializer, functions) or proof_expr_has_move(initializer) or not proof_expr_supported(initializer)
            match target:
                Ast::Expr.Index(object, index, _):
                    root: sview = proof_ident_name(object)
                    match index:
                        Ast::Expr.IntLit(offset, _):
                            return (false, "") if offset != 0
                        _:
                            return (false, "")
                    return (false, "") if root == "" or not proof_current_parameter(names, frame_parameters, root)
                    function_index: usize = proof_function_index_of_current(functions, owner)
                    return (false, "") if function_index >= functions.param_starts.count or function_index >= functions.param_counts.count
                    parameter_start: usize = functions.param_starts[function_index]
                    parameter_count: usize = functions.param_counts[function_index]
                    return (false, "") if parameter_start > functions.all_params.count or parameter_count > functions.all_params.count - parameter_start
                    parameter_slot: mutable usize = functions.all_params.count
                    for parameter_index in parameter_start..<parameter_start + parameter_count |parameter_index, functions, root, parameter_slot|:
                        parameter_slot <- parameter_index if functions.all_params[parameter_index] == root
                    return (false, "") if parameter_slot >= functions.all_params.count or parameter_slot >= functions.all_parameter_mutable_references.count or not functions.all_parameter_mutable_references[parameter_slot]
                    source_parameter: (count: usize, type_expression: Ast::Expr) = proof_scalar_reference_parameter_type_in_declarations(declarations, owner, root, 0)
                    return (false, "") if source_parameter.count != 1
                    scalar_target: (known: bool, target: Ast::Expr) = proof_scalar_reference_target_type(source_parameter.type_expression, declarations, 0)
                    return (false, "") if not scalar_target.known
                    return (true, root)
                _:
                    return (false, "")

        def proof_mutable_reference_parameter(owner: sview, root: sview, functions: ProofFunctionTable&) -> bool:
            return false if root == ""
            function_index: usize = proof_function_index_of_current(functions, owner)
            return false if function_index >= functions.param_starts.count or function_index >= functions.param_counts.count
            parameter_start: usize = functions.param_starts[function_index]
            parameter_count: usize = functions.param_counts[function_index]
            return false if parameter_start > functions.all_params.count or parameter_count > functions.all_params.count - parameter_start
            for parameter_index in parameter_start..<parameter_start + parameter_count |parameter_index, functions, root|:
                if functions.all_params[parameter_index] == root:
                    return parameter_index < functions.all_parameter_mutable_references.count and functions.all_parameter_mutable_references[parameter_index]
            return false

        # Track a direct store through a mutable-reference parameter as an immutable record-update
        # term. This versions the field without recursively substituting the receiver into itself.
        # Nested places, compound writes, calls and ownership transfers are deliberately opaque;
        # they poison the receiver's post-state instead of preserving a stale pre-state field.
        def proof_track_mutable_parameter_field_write(target: Ast::Expr, operator: TokenKind, initializer: Ast::Expr, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, frame_parameters: darray[sview]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, functions: ProofFunctionTable&, report: mutable ProofReport&, owner: sview, annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos) -> bool:
            place: (known: bool, place: ProofFramePlace) = proof_frame_place(target)
            return false if not place.known or place.place.depth == 0
            parameter_write: bool = proof_current_parameter(names, frame_parameters, place.place.root) and proof_mutable_reference_parameter(owner, place.place.root, functions)
            local_write: bool = proof_unaliased_local_record_field(target, names, frame_parameters, report, owner)
            return false if not parameter_write and not local_write
            proof_check_direct_frame_write(target, names, frame_parameters, changes, preserves, report, owner, position.line)
            root_slot: mutable usize = names.count
            while root_slot > 0 |root_slot, names, place|:
                root_slot <- root_slot - 1
                break if names[root_slot] == place.place.root
            direct_field: mutable bool = false
            field_name: mutable sview = ""
            match target:
                Ast::Expr.Field(Ast::Expr.Ident(root, _), field, _):
                    direct_field <- root == place.place.root and field != "" and place.place.depth == 1
                    field_name <- field
                _:
                    pass
            if direct_field and (operator == TokenKind.LArrow or operator == TokenKind.Assign) and not proof_expr_has_call(initializer) and not proof_expr_has_move(initializer) and proof_expr_supported(initializer) and root_slot < values.count:
                field_value: Ast::Expr = proof_substitute(initializer, names, values)
                match field_value:
                    Ast::Expr.Invalid:
                        values[root_slot] <- Ast::Expr.Invalid
                    _:
                        updates: darray[Ast::FieldInit] = [Ast::FieldInit{name: field_name, value: field_value}]
                        values[root_slot] <- Ast::Expr.RecordUpdate(values[root_slot], updates, position)
                proof_clear_facts_for_mutated_root(facts, place.place.root, report, owner)
                return true
            if proof_expr_has_call(initializer):
                proof_check_frame_calls_in_expression(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, owner, annotations)
                proof_forget_values_after_call(names, values, facts, frame_parameters, report, owner, values.count, values.count, position)
            values[root_slot] <- Ast::Expr.Invalid if root_slot < values.count
            proof_clear_facts_after_call(facts, names, frame_parameters, report, owner)
            return true

        def proof_check_return_declarations(statement: Ast::Stmt, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, flow: mutable ProofFlow&) -> bool:
            match statement:
                Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                    # `x: T = v.pop()` on the builtin darray pop binds the last element and then
                    # removes it: the read `v[v.count - 1]` followed by the statement pop. Both
                    # trap on an empty array, and the pop's own rule records the new count.
                    pop_receiver: sview = proof_pop_receiver(initializer, names, values, frame_parameters, functions, report, name)
                    if pop_receiver != "" and pop_receiver != local_name:
                        last: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident(pop_receiver, position), Ast::Expr.Binary(proof_count_place(pop_receiver, position), TokenKind.Minus, Ast::Expr.IntLit(1, position), position), position)
                        proof_check_return_declarations(Ast::Stmt.VarDecl(local_name, type_expression, last, position), names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, flow)
                        # The local's value names `v`, which the pop's call boundary forgets;
                        # state it as a fact first so the pop can carry it over its count.
                        slot: usize = names.count - 1 if names.count > 0 else 0
                        if names.count > 0 and slot < values.count and names[slot] == local_name and proof_expr_mentions_name(values[slot], pop_receiver):
                            proof_add_traced_fact(facts, report, Ast::Expr.Binary(Ast::Expr.Ident(local_name, position), TokenKind.EqEq, values[slot], position), "local-binding", position.line, name)
                            values[slot] <- Ast::Expr.Ident(local_name, position)
                        proof_pop_restate_slot(facts, report, pop_receiver, local_name, name, position, annotations)
                        no_moves: darray[sview] = []
                        proof_check_return_contracts(Ast::Stmt.Expr(initializer, position), no_moves, names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, flow)
                        return true
                    value: mutable Ast::Expr = proof_substitute(initializer, names, values)
                    prior_value_count: usize = values.count
                    shadowed: mutable bool = false
                    for existing_name in names |shadowed, local_name|:
                        shadowed <- true if existing_name == local_name
                    call_applied: mutable bool = false
                    # An integer conversion of a bare name runs no source function: there is no
                    # summary to apply and no state it can change, so the local keeps the term.
                    # Classify against the source initializer: substitution can replace a
                    # match-bound cast receiver with its branch symbol, which is useful for
                    # its width witness but must not make the original builtin cast opaque.
                    conversion_only: mutable bool = false
                    match initializer:
                        Ast::Expr.Call(callee, arguments, _, _):
                            conversion: (known: bool, receiver: Ast::Expr) = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                            # The effect scan deliberately treats reserved casts as call-free,
                            # so detect this direct conversion from its AST shape instead.
                            conversion_only <- conversion.known and proof_conversion_receiver_is_place(conversion.receiver, 0)
                        _:
                            pass
                    # The generic operator audit does not classify method-shaped numeric casts;
                    # the conversion recognizer above does, after checking the builtin target
                    # and receiver place. Do not erase its type/range facts as if it were an
                    # unmodeled user call.
                    initializer_has_unmodeled_operator: bool = false if conversion_only else proof_invalidate_for_unmodeled_operator(initializer, names, values, facts, frame_parameters, report, name, position)
                    match value:
                        Ast::Expr.Call(callee, _, _, _):
                            if not conversion_only:
                                proof_check_frame_call_children(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                                # Store this invocation's non-total-pure result under
                                # a reserved SSA name, not a repeatable call expression.
                                # The local has not entered scope and may shadow an
                                # initializer argument, so do not use its source name.
                                call_width: i64 = proof_unsigned_type_width_index(type_expression, functions.type_audit_index, 0)
                                call_return: (count: usize, type_expression: Ast::Expr) = proof_source_function_return_type(report.source_declarations, proof_callable_name(callee), 0)
                                same_width: bool = call_return.count == 1 and call_width > 0 and proof_unsigned_type_width_index(call_return.type_expression, functions.type_audit_index, 0) == call_width
                                result_symbol: sview = proof_rebind_symbol(report) if same_width and not proof_contract_calls_are_pure(value, functions) else ""
                                result_value: Ast::Expr = Ast::Expr.Ident(result_symbol, position) if result_symbol != "" else value
                                call_applied <- proof_apply_function(proof_call_source(initializer, value), result_value, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations)
                                proof_check_opaque_call_frame(value, facts, names, frame_parameters, changes, preserves, functions, report, name) if not call_applied
                                if call_applied and result_symbol != "":
                                    proof_add_unsigned_binding_facts(facts, report, result_symbol, call_width, position.line, name, position)
                                    value <- result_value
                                # A no-summary Boolean result is one opaque local value,
                                # not a repeatable non-pure call in later branch facts.
                                called_index: usize = proof_function_index(functions, proof_callable_name(callee))
                                opaque_boolean: bool = proof_ident_name(type_expression) == "bool" and call_return.count == 1 and proof_ident_name(call_return.type_expression) == "bool" and called_index < functions.ensure_counts.count and functions.ensure_counts[called_index] == 0
                                value <- Ast::Expr.Invalid if call_applied and opaque_boolean and not proof_contract_calls_are_pure(value, functions)
                                value <- Ast::Expr.Invalid if not call_applied
                        _:
                            proof_check_frame_calls_in_expression(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(initializer)
                            value <- proof_substitute(initializer, names, values) if proof_expr_has_call(initializer)
                    if initializer_has_unmodeled_operator:
                        # Nested calls may have added summaries while walking the expression;
                        # the unsupported operator invalidates those post-state claims too.
                        proof_forget_values(names, values, position)
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                        value <- Ast::Expr.Ident(local_name, position)
                        call_applied <- false
                    # A declaration's initializer is evaluated before its binding enters
                    # scope. Commit the new local only after nested calls have seen the
                    # pre-declaration environment; otherwise `x: T = f(x)` would pass the
                    # freshly assigned x back into f instead of the outer x.
                    # The spelling may already denote an earlier symbol: a shadowed local,
                    # a parameter, or a binding forgotten to its own name. Purge everything
                    # that refers to that symbol before it denotes the new binding; a value
                    # that mentions its own new name has no expressible meaning either.
                    proof_resymbolize_binding(names, values, facts, report, name, local_name, position)
                    value <- Ast::Expr.Invalid if proof_expr_mentions_name(value, local_name)
                    # A local that holds a container keeps its own symbol when its initializer
                    # is a call. A call is not a place, and every extent rule is written over
                    # places, so substituting it turns `values.count` into `<call>.count` --
                    # a term with no place root, which no extent, alias or stability rule can
                    # say anything about. The equality with the call was never usable for a
                    # container anyway: nothing folds it, and an opaque callee's result is not
                    # a value this state models. The symbol is what carries the facts.
                    # The same holds for a tuple or a struct local: `located.node` is a place
                    # only while `located` is one. A scalar local is excluded because the two
                    # binders below already give it its own symbol.
                    # A correctly labelled named-tuple call can stay as a stable value under the
                    # local name, so replay can check each summary over the original `call.field`.
                    aggregate_local: bool = proof_scalar_type_kind_index(type_expression, report.source_declarations, functions.type_audit_index, 0) != 1
                    call_value: Ast::Expr = value
                    tuple_local: mutable bool = false
                    match type_expression:
                        Ast::Expr.Tuple(_, _):
                            tuple_local <- true
                        _:
                            pass
                    tuple_labels_match: mutable bool = false
                    tuple_labels_match <- proof_tuple_call_labels_match_local(call_value, type_expression, report, functions) if tuple_local
                    # Keep a correctly labelled named-tuple call as the value of its local. This
                    # lets field reads reuse the original call summary, which replay checks
                    # directly against the callee's postcondition. A reordered or incomplete
                    # label mapping stays opaque below.
                    call_tuple: bool = call_applied and tuple_local and tuple_labels_match and proof_contract_calls_are_pure(value, functions)
                    value <- Ast::Expr.Ident(local_name, position) if (aggregate_local or (tuple_local and not tuple_labels_match)) and proof_expr_has_call(initializer) and not call_tuple
                    # A fixed-array local has the count its type states. It keeps its own symbol,
                    # as a call-initialized container does, so `fields.count` stays a place
                    # rather than `zeroed.count`, and that count enters as a type bound below.
                    local_extent: i64 = proof_local_fixed_extent(type_expression, report.source_declarations)
                    value <- Ast::Expr.Ident(local_name, position) if local_extent >= 0
                    names <- names.push(local_name)
                    values <- values.push(value)
                    values[prior_value_count] <- value if proof_expr_has_call(initializer) and prior_value_count < values.count
                    unsigned_width: i64 = proof_unsigned_type_width_index(type_expression, functions.type_audit_index, 0)
                    signed_width: i64 = proof_signed_type_width_index(type_expression, functions.type_audit_index, 0)
                    proof_add_type_bound_fact(facts, report, proof_signed_type_marker(Ast::Expr.Ident(local_name, position), signed_width, position), position.line, name) if signed_width > 0
                    if unsigned_width < 0:
                        values[prior_value_count] <- Ast::Expr.Invalid
                        proof_add_finding(report, "contract-expression-unsupported", position.line, name, "local numeric type alias cannot be resolved uniquely")
                    if proof_expr_has_call(initializer) and not conversion_only:
                        # The new local contains the call result, so retain its binding, but
                        # forget every pre-existing binding that the call may have mutated.
                        proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, prior_value_count, values.count, position)
                    proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name) if shadowed
                    proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if not shadowed and proof_expr_has_call(initializer) and not call_applied and not conversion_only
                    # The type range of the new binding, stated after the purges so a call cannot clear it.
                    proof_add_signed_range_facts(facts, report, Ast::Expr.Ident(local_name, position), signed_width, position.line, name, position) if signed_width > 0
                    proof_bind_unsigned_symbol(names, values, facts, report, name, prior_value_count, unsigned_width, value, position, annotations) if unsigned_width > 0
                    # An aggregate local is this call's result under its own symbol, so the call's
                    # summaries are instantiated again with `result` bound to it: `record.count`
                    # then carries the callee's `ensure result.count <= N`.
                    proof_rebind_call_summaries(facts, report, call_value, local_name, position.line, name, position) if aggregate_local and call_applied and not shadowed and not call_tuple and not tuple_local
                    proof_add_bound_tuple_label_witnesses(call_value, Ast::Expr.Ident(local_name, position), facts, functions, report, position.line, name, position) if aggregate_local and call_applied and not shadowed and not call_tuple and not tuple_local
                    proof_add_bound_tuple_label_witnesses(call_value, call_value, facts, functions, report, position.line, name, position) if aggregate_local and call_applied and not shadowed and tuple_local and tuple_labels_match
                    local_count: Ast::Expr = Ast::Expr.Field(Ast::Expr.Ident(local_name, position), "count", position)
                    proof_add_type_bound_fact(facts, report, Ast::Expr.Binary(local_count, TokenKind.EqEq, Ast::Expr.IntLit(local_extent, position), position), position.line, name) if local_extent >= 0
                    # A scalar local carries the same primitive-type witness as a parameter, so
                    # equality reasoning over it is not held back by the binding form. An
                    # unsigned width marker already witnesses the same thing.
                    local_scalar_kind: i64 = proof_scalar_type_kind_index(type_expression, report.source_declarations, functions.type_audit_index, 0)
                    proof_add_primitive_operator_witnesses(facts, report, Ast::Expr.Ident(local_name, position), type_expression, position)
                    proof_add_scalar_type_witness(facts, report, proof_scalar_type_marker(local_name, position), position.line, name) if local_scalar_kind == 1 and unsigned_width <= 0
                    proof_bind_scalar_symbol(names, values, prior_value_count, position) if local_scalar_kind == 1 and unsigned_width <= 0
                    # A signed scalar local normally has no value equation in the proof state.
                    # For a recognized widening conversion only, retain the source value across
                    # the binding so later arithmetic can use the receiver's checked type range.
                    # Matching the declared and conversion target types prevents an implicit
                    # narrowing or additional conversion from entering this path.
                    # A conversion local is a snapshot, not a live alias of its receiver. Keep
                    # its own symbol so a later write to a field such as `values.count` cannot
                    # rewrite the local to the collection's new count. When the declared type
                    # exactly matches the reserved conversion target, record the initializer
                    # equality; mutation invalidation will remove it if the receiver changes.
                    if local_scalar_kind == 1 and unsigned_width <= 0 and not shadowed and conversion_only:
                        match initializer:
                            Ast::Expr.Call(callee, arguments, _, _):
                                conversion: (known: bool, receiver: Ast::Expr) = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                                if conversion.known:
                                    values[prior_value_count] <- Ast::Expr.Ident(local_name, position)
                                    conversion_target: sview = proof_cast_target_name(callee)
                                    if conversion_target != "" and proof_ident_name(type_expression) == conversion_target and not proof_expr_is_invalid(value) and not proof_expr_has_move(value):
                                        binding: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident(local_name, position), TokenKind.EqEq, value, position)
                                        proof_add_traced_fact(facts, report, binding, "local-binding", position.line, name)
                            _:
                                pass
                    if local_scalar_kind == 1 and unsigned_width <= 0 and not shadowed:
                        # Keep the source initializer's cast shape, but resolve its receiver to
                        # the branch-local SSA name before looking up the width marker. Substituting
                        # the whole cast first can project it away when the bound value itself has
                        # already been rebound.
                        match initializer:
                            Ast::Expr.Call(callee, arguments, _, _):
                                resolved_callee: Ast::Expr = proof_substitute(callee, names, values)
                                widened: (known: bool, receiver: Ast::Expr, target: sview) = proof_widening_cast_receiver(resolved_callee, arguments.count, facts, functions)
                                receiver_name: sview = proof_ident_name(widened.receiver)
                                if widened.known and proof_ident_name(type_expression) == widened.target and receiver_name != "" and receiver_name != local_name:
                                    binding: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident(local_name, position), TokenKind.EqEq, widened.receiver, position)
                                    proof_add_traced_fact(facts, report, binding, "local-binding", position.line, name)
                            _:
                                pass
                    local_witness_budget: mutable usize = PROOF_SCALAR_WITNESS_BUDGET
                    proof_add_scalar_witnesses(facts, report, Ast::Expr.Ident(local_name, position), type_expression, position.line, name, position, &local_witness_budget, 0) if local_scalar_kind != 1
                    # A local is call-stable only when its type has no nested reference or
                    # borrowed view. A by-value aggregate can still reach externally mutable
                    # state, so its nested fields/counts cannot inherit the root's storage
                    # stability. Rewrite the entry to withdraw an earlier shadowed claim.
                    proof_drop_local_extent(report, local_name)
                    local_value: bool = not proof_resource_is_reference_type(type_expression) and proof_type_is_reference_free(type_expression, report.source_declarations, 0) and not proof_type_contains_borrowed_view(type_expression, report.source_declarations, 0)
                    plain_value: bool = not proof_resource_is_reference_type(type_expression) and proof_value_binding_type(type_expression, report, 0)
                    report.local_extent_names.push(local_name) if local_value or plain_value
                    report.value_binding_names.push(local_name) if plain_value
                    report.reference_local_names.push(local_name) if proof_resource_is_reference_type(type_expression)
                Ast::Stmt.Assign(target, operator, initializer, position):
                    initializer_has_unmodeled_operator: bool = proof_invalidate_for_unmodeled_operator(initializer, names, values, facts, frame_parameters, report, name, position)
                    target_name: sview = proof_ident_name(target)
                    if target_name != "":
                        proof_check_direct_frame_write(proof_substitute(target, names, values), names, frame_parameters, changes, preserves, report, name, position.line)
                        value: mutable Ast::Expr = proof_substitute(initializer, names, values)
                        slot: mutable usize = names.count
                        target_slot: mutable usize = names.count
                        while slot > 0 |slot, names, target_name|:
                            slot <- slot - 1
                            if names[slot] == target_name:
                                target_slot <- slot
                                # Only a plain rebind has the RHS as the new value. A
                                # compound assignment (`+=`, `-=`, …) depends on the old
                                # value and is opaque until the assignment algebra is modeled.
                                values[slot] <- Ast::Expr.Absent if operator != TokenKind.LArrow and operator != TokenKind.Assign
                                break
                        call_applied: mutable bool = false
                        match value:
                            Ast::Expr.Call(_, _, _, _):
                                proof_check_frame_call_children(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if operator == TokenKind.LArrow or operator == TokenKind.Assign
                                call_applied <- proof_apply_function(proof_call_source(initializer, value), value, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations) if operator == TokenKind.LArrow or operator == TokenKind.Assign
                                proof_check_opaque_call_frame(value, facts, names, frame_parameters, changes, preserves, functions, report, name) if not call_applied
                                value <- Ast::Expr.Invalid if not call_applied
                                proof_check_frame_calls_in_expression(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if operator != TokenKind.LArrow and operator != TokenKind.Assign
                                value <- proof_substitute(initializer, names, values) if operator != TokenKind.LArrow and operator != TokenKind.Assign
                            _:
                                proof_check_frame_calls_in_expression(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(initializer)
                                value <- proof_substitute(initializer, names, values) if proof_expr_has_call(initializer)
                        values[target_slot] <- value if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and target_slot < values.count
                        if proof_expr_has_call(initializer):
                            if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and target_slot < values.count:
                                # Preserve the assigned result, but do not let the call's
                                # possible mutation of another binding survive this point.
                                proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, target_slot, position)
                            else:
                                proof_forget_values_after_call(names, values, facts, frame_parameters, report, name, values.count, values.count, position)
                        # An unsigned local keeps its width by staying symbolic; its new
                        # value becomes an equality fact when it is range-safe.
                        rebound_width: i64 = proof_unsigned_marker_width_for_name(facts, target_name) if target_slot < values.count else 0
                        proof_bind_unsigned_symbol(names, values, facts, report, name, target_slot, rebound_width, value, position, annotations) if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and rebound_width > 0
                        # A compound assignment still executes its RHS call, but the
                        # resulting value depends on the old target and is not modeled.
                        # Discard all facts after it, including when the RHS call had a
                        # usable executable summary. The target denotes a new opaque value,
                        # so bindings that recorded the old symbol are forgotten with it.
                        proof_resymbolize_binding(names, values, facts, report, name, target_name, position) if operator != TokenKind.LArrow and operator != TokenKind.Assign
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name) if operator != TokenKind.LArrow and operator != TokenKind.Assign
                        # A plain local rebind is represented in `values`, so keep facts
                        # about prior symbolic values available for the substitution-based
                        # postcondition check. Parameter rebinding is different: it changes
                        # an externally visible root, so all facts must be discarded. Calls
                        # still clear facts when no checked summary was applied.
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name) if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and proof_current_parameter(names, frame_parameters, target_name)
                        proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and proof_expr_has_call(initializer) and not call_applied
                        # `r <- v` through a reference local stores into its referent, not into
                        # `r`'s symbolic slot. The referent is not tracked, so havoc everything.
                        if any reference_local in report.reference_local_names where reference_local == target_name:
                            proof_forget_values(names, values, position)
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                    else:
                        field_write_tracked: bool = proof_track_mutable_parameter_field_write(target, operator, initializer, names, values, facts, frame_parameters, changes, preserves, functions, report, name, annotations, position)
                        if not field_write_tracked:
                            # A mutable scalar reference's exact zero element is one primitive
                            # storage cell. Version that pointee in the same substitution state
                            # used for direct mutable variables; broader writes remain opaque.
                            reference_target: (known: bool, name: sview) = proof_scalar_reference_write_target(target, operator, initializer, names, frame_parameters, functions, report.source_declarations, name)
                            proof_check_direct_frame_write(target, names, frame_parameters, changes, preserves, report, name, position.line)
                            if reference_target.known:
                                value: mutable Ast::Expr = proof_substitute(initializer, names, values)
                                match value:
                                    Ast::Expr.Call(callee, arguments, _, _):
                                        # Primitive numeric casts use the call-shaped AST but
                                        # are total conversions, not executable function calls.
                                        # Preserve their exact symbolic value; only user calls
                                        # need an executable summary and call-frame check.
                                        numeric_cast: (known: bool, receiver: Ast::Expr) = proof_expr_numeric_cast_receiver(callee, arguments)
                                        if not numeric_cast.known:
                                            proof_check_frame_call_children(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                                            call_applied: bool = proof_apply_function(proof_call_source(initializer, value), value, facts, functions, names, values, frame_parameters, changes, preserves, report, name, annotations)
                                            proof_check_opaque_call_frame(value, facts, names, frame_parameters, changes, preserves, functions, report, name) if not call_applied
                                            value <- Ast::Expr.Invalid if not call_applied
                                    _:
                                        pass
                                target_slot: mutable usize = names.count
                                while target_slot > 0 |target_slot, names, reference_target|:
                                    target_slot <- target_slot - 1
                                    if names[target_slot] == reference_target.name:
                                        values[target_slot] <- proof_scalar_reference_state_marker(value, position)
                                        break
                            else:
                                proof_resolve_disjunctive_facts(facts, report, position.line, name)
                                before_write: darray[Ast::Expr] = proof_copy_exprs(facts)
                                proof_clear_facts_after_call(facts, names, frame_parameters, report, name)
                                proof_apply_indexed_write(target, operator, initializer, before_write, facts, names, values, report, name, annotations, position) if not initializer_has_unmodeled_operator
                    if initializer_has_unmodeled_operator:
                        # Assignment summaries and symbolic RHS values are not reusable after
                        # an operator with arbitrary source effects has executed.
                        proof_forget_values(names, values, position)
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                _:
                    return false
            return true
