extend ElisaProof:
    private:
        def proof_emit_prepared_frame_events(report: mutable ProofReport&, name: sview, line: u32, offset: u32) -> bool:
            table: ProofFrameProducerWorkspace& = report.analysis_1.frame_producer
            return false if:
                not table.owner_lookup_valid or table.names.count == 0 or table.owner_lookup_hashes.count != table.owner_lookup_slots.count
                table.names.count != table.lines.count or table.names.count != table.offsets.count or table.names.count != table.starts.count or table.names.count != table.counts.count
                table.owner_lookup_hashes.count != proof_name_index_capacity(table.names.count)
                not ElisaProofFrameSource::replay_work_charge(1, table.owner_lookup_work_used)
                not ElisaProofFrameSource::replay_work_charge(sview_len(name), table.owner_lookup_work_used)
            capacity: usize = table.owner_lookup_slots.count
            hash: u32 = proof_expr_shape_mix(proof_expr_shape_mix(proof_name_hash(name), line.i64()), offset.i64())
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, line, offset, table, capacity|:
                return false if not ElisaProofFrameSource::replay_work_charge(1, table.owner_lookup_work_used)
                owner_index: usize = table.owner_lookup_slots[slot]
                return false if owner_index > table.names.count
                if owner_index == table.names.count:
                    return false
                if table.owner_lookup_hashes[slot] == hash:
                    return false if not ElisaProofFrameSource::replay_work_charge(sview_len(table.names[owner_index]), table.owner_lookup_work_used)
                    if table.names[owner_index] == name and table.lines[owner_index] == line and table.offsets[owner_index] == offset:
                        start: usize = table.starts[owner_index]
                        count: usize = table.counts[owner_index]
                        return false if start > table.rows.count or count > table.rows.count - start
                        accounted: usize = 0 if report.results.obligation_inventory.count == 0 else report.results.obligation_inventory[report.results.obligation_inventory.count - 1].attempts_start + report.results.obligation_inventory[report.results.obligation_inventory.count - 1].attempts_count
                        return false if accounted != report.results.goal_attempts.count
                        for index in 0..<count |index, start, report, name, line, offset, table|:
                            row = table.rows[start + index]
                            rule: sview = "frame-allow" if row.kind == "allow" else "frame-preserve" if row.kind == "preserve" else "frame-spec"
                            mirror: Ast::Expr = Ast::Expr.BoolLit(true, row.position)
                            certificate_index: usize = report.analysis_1.certificates.count
                            report.results.goal_attempts.push(ProofGoalAttempt{goal: mirror, budget_exhausted: false, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: row.root, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: row.position.line, name: name, rule: rule, producer_proven: row.proven, has_certificate: row.proven, certificate_index: certificate_index, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                            if row.proven:
                                report.analysis_1.certificates.push(ProofGoalCertificate{goal: mirror, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: row.root, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: row.position.line, name: name, rule: rule, replayed: false})
                            report.proof_obligation_for_source(row.proven, line, name, row.kind, row.source_index)
                            if not row.proven:
                                kind: sview = "frame-write-outside" if row.kind == "allow" else "frame-preserve-write" if row.kind == "preserve" else "kernel-certificate-invalid"
                                proof_add_latest_goal_finding(report, kind, row.position.line, name, "source-bound frame event did not replay")
                        report.analysis_1.frame_producer.active_name <- name
                        return true
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return false
