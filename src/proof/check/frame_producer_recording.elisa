extend ElisaProof:
    private:
        def proof_emit_prepared_frame_events(report: mutable ProofReport&, name: sview, line: u32) -> bool:
            for owner_index in 0..<report.frame_producer.names.count |owner_index, report, name, line|:
                if report.frame_producer.names[owner_index] == name and report.frame_producer.lines[owner_index] == line:
                    start: usize = report.frame_producer.starts[owner_index]
                    count: usize = report.frame_producer.counts[owner_index]
                    return false if start > report.frame_producer.rows.count or count > report.frame_producer.rows.count - start
                    accounted: usize = 0 if report.obligation_inventory.count == 0 else report.obligation_inventory[report.obligation_inventory.count - 1].attempts_start + report.obligation_inventory[report.obligation_inventory.count - 1].attempts_count
                    return false if accounted != report.goal_attempts.count
                    for index in 0..<count |index, start, report, name, line|:
                        row = report.frame_producer.rows[start + index]
                        rule: sview = "frame-allow" if row.kind == "allow" else "frame-preserve" if row.kind == "preserve" else "frame-spec"
                        mirror: Ast::Expr = Ast::Expr.BoolLit(true, row.position)
                        certificate_index: usize = report.certificates.count
                        report.goal_attempts.push(ProofGoalAttempt{goal: mirror, budget_exhausted: false, facts_start: report.certificate_facts.count, facts_count: 0, kernel_goal: row.root, kernel_facts_start: report.kernel.certificate_facts.count, kernel_facts_count: 0, line: row.position.line, name: name, rule: rule, proven: row.proven, has_certificate: row.proven, certificate_index: certificate_index})
                        if row.proven:
                            report.certificates.push(ProofGoalCertificate{goal: mirror, facts_start: report.certificate_facts.count, facts_count: 0, kernel_goal: row.root, kernel_facts_start: report.kernel.certificate_facts.count, kernel_facts_count: 0, line: row.position.line, name: name, rule: rule, replayed: false})
                        report.proof_obligation_for_source(row.proven, line, name, row.kind, row.source_index)
                        if not row.proven:
                            kind: sview = "frame-write-outside" if row.kind == "allow" else "frame-preserve-write" if row.kind == "preserve" else "kernel-certificate-invalid"
                            proof_add_latest_goal_finding(report, kind, row.position.line, name, "source-bound frame event did not replay")
                    report.frame_producer.active_name <- name
                    return true
            return false
