extend ElisaProof:
    private:
        # Audit every payload, even variants the current callee never returns.
        # Recursive and ambiguous names fail closed under the shared depth limit.
        def proof_enum_payloads_reference_free(current: darray[Ast::Decl]&, declarations: darray[Ast::Decl]&, name: sview, annotations: darray[Ast::EnumAnnotation]&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in current |declarations, name, annotations, depth|:
                match declaration:
                    Ast::Decl.Enum(enum_name, variants, is_const, _, _):
                        if enum_name == name and not is_const:
                            for variant in variants |declarations, annotations, depth|:
                                for field in variant.fields |declarations, annotations, depth|:
                                    return false if not proof_type_is_reference_free(field, declarations, annotations, depth + 1)
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_enum_payloads_reference_free(body, declarations, name, annotations, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_enum_payloads_reference_free(body, declarations, name, annotations, depth + 1)
                    _:
                        pass
            return true

        def proof_named_aggregate_is_reference_free(name: sview, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or name == "" or proof_enum_in_hierarchy(annotations, name)
            counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(declarations, name, 0)
            return false if counts.const_enums != 0
            return proof_struct_is_reference_free(name, declarations, annotations, depth + 1) if counts.structs == 1 and counts.enums == 0
            return false if counts.enums != 1 or counts.structs != 0
            return proof_enum_payloads_reference_free(declarations, declarations, name, annotations, depth + 1)
