extend ElisaProof:
    private:
        struct ProofBlockLemmaStabilityShape:
            scalar_query: mutable bool = false
            index_query: mutable bool = false
            element_lookup: mutable bool = false
            enum_shorthand_query: mutable bool = false
            enum_field_query: mutable bool = false
            call_query: mutable bool = false
            expanded_depth: mutable usize = 0

        def proof_block_lemma_stability_mark_all(shape: mutable ProofBlockLemmaStabilityShape&, maximum_depth: mutable usize&) -> void:
            shape.scalar_query <- true
            shape.index_query <- true
            shape.element_lookup <- true
            shape.enum_shorthand_query <- true
            shape.enum_field_query <- true
            shape.call_query <- true
            maximum_depth <- ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT

        # Shape-only preflight for the operators whose stability checks consult fact witnesses.
        # This deliberately does not invoke any witness query; its single source-size charge is
        # reserved before the scan at the call site.
        def proof_block_lemma_stability_scan_shape(expression: Ast::Expr, shape: mutable ProofBlockLemmaStabilityShape&, maximum_depth: mutable usize&, depth: usize) -> void:
            maximum_depth <- depth + 1 if depth + 1 > maximum_depth
            if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT:
                proof_block_lemma_stability_mark_all(shape, maximum_depth)
                return
            match expression:
                Ast::Expr.Invalid | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Absent | Ast::Expr.Ident(_, _):
                    return
                Ast::Expr.ShorthandMember(_, _):
                    shape.enum_shorthand_query <- true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.GetElse(inner, _, _):
                    proof_block_lemma_stability_scan_shape(inner, shape, maximum_depth, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    shape.scalar_query <- true
                    proof_block_lemma_stability_scan_shape(operand, shape, maximum_depth, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    shape.scalar_query <- true
                    proof_block_lemma_stability_scan_shape(left, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(right, shape, maximum_depth, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    shape.call_query <- true
                    proof_block_lemma_stability_scan_shape(callee, shape, maximum_depth, depth + 1)
                    for argument in arguments |shape, maximum_depth, depth|:
                        proof_block_lemma_stability_scan_shape(argument, shape, maximum_depth, depth + 1)
                Ast::Expr.Field(object, _, _):
                    shape.element_lookup <- true
                    shape.enum_field_query <- true
                    proof_block_lemma_stability_scan_shape(object, shape, maximum_depth, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    proof_block_lemma_stability_scan_shape(base, shape, maximum_depth, depth + 1)
                Ast::Expr.Index(object, index, _):
                    shape.index_query <- true
                    shape.element_lookup <- true
                    proof_block_lemma_stability_scan_shape(object, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(index, shape, maximum_depth, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    proof_block_lemma_stability_scan_shape(object, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(low, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(high, shape, maximum_depth, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    shape.index_query <- true
                    shape.element_lookup <- true
                    proof_block_lemma_stability_scan_shape(object, shape, maximum_depth, depth + 1)
                    for argument in arguments |shape, maximum_depth, depth|:
                        proof_block_lemma_stability_scan_shape(argument, shape, maximum_depth, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |shape, maximum_depth, depth|:
                        proof_block_lemma_stability_scan_shape(element, shape, maximum_depth, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |shape, maximum_depth, depth|:
                        proof_block_lemma_stability_scan_shape(entry.key, shape, maximum_depth, depth + 1)
                        proof_block_lemma_stability_scan_shape(entry.value, shape, maximum_depth, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |shape, maximum_depth, depth|:
                        proof_block_lemma_stability_scan_shape(field.value, shape, maximum_depth, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_block_lemma_stability_scan_shape(base, shape, maximum_depth, depth + 1)
                    for field in fields |shape, maximum_depth, depth|:
                        proof_block_lemma_stability_scan_shape(field.value, shape, maximum_depth, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    proof_block_lemma_stability_scan_shape(condition, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(then_expression, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(else_expression, shape, maximum_depth, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    proof_block_lemma_stability_scan_shape(iterable, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(condition, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(body, shape, maximum_depth, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_block_lemma_stability_scan_shape(base, shape, maximum_depth, depth + 1)
                    proof_block_lemma_stability_scan_shape(predicate, shape, maximum_depth, depth + 1)
                _:
                    # Lowered matches, catches, blocks, and any future expression forms may
                    # expose operators after transformation. Reserve their worst bounded path.
                    proof_block_lemma_stability_mark_all(shape, maximum_depth)

        def proof_block_lemma_stability_add_product(first: usize, second: usize, third: usize, fourth: usize, total: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            product: mutable usize = 1
            for factor in [first, second, third, fourth] |factor, product, work, report, name, line|:
                if factor == 0:
                    return true
                if factor > PROOF_PURITY_WALK_WORK_LIMIT or product > PROOF_PURITY_WALK_WORK_LIMIT / factor:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                product <- product * factor
            if total > PROOF_PURITY_WALK_WORK_LIMIT - product:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            total <- total + product
            return true

        def proof_block_lemma_stability_cost_add(amount: usize, total: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            if amount > PROOF_PURITY_WALK_WORK_LIMIT or total > PROOF_PURITY_WALK_WORK_LIMIT - amount:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            total <- total + amount
            return true

        # Preflight the source rows inspected by enum witness resolution. The returned item and
        # name totals bound each later traversal; alias target terms are also measured because a
        # field operand follows aliases while deriving its nominal type head.
        def proof_block_lemma_stability_declaration_cost(declarations: darray[Ast::Decl]&, items: mutable usize&, name_bytes: mutable usize&, alias_target_cost: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32, depth: usize) -> bool:
            return true if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            if not proof_block_lemma_budget_charge(declarations.count, work, report, name, line) or not proof_block_lemma_stability_cost_add(declarations.count, items, work, report, name, line):
                return false
            for declaration in declarations |items, name_bytes, alias_target_cost, work, report, name, line, depth|:
                return false if not proof_block_lemma_budget_charge(1, work, report, name, line)
                match declaration:
                    Ast::Decl.Module(module_name, nested, _):
                        module_bytes: usize = sview_len(module_name)
                        return false if not proof_block_lemma_budget_charge(module_bytes, work, report, name, line) or not proof_block_lemma_stability_cost_add(module_bytes, name_bytes, work, report, name, line)
                        return false if not proof_block_lemma_stability_declaration_cost(nested, items, name_bytes, alias_target_cost, work, report, name, line, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_block_lemma_stability_declaration_cost(nested, items, name_bytes, alias_target_cost, work, report, name, line, depth + 1)
                    Ast::Decl.Alias(alias_name, target, _):
                        alias_bytes: usize = sview_len(alias_name)
                        return false if not proof_block_lemma_budget_charge(alias_bytes, work, report, name, line) or not proof_block_lemma_stability_cost_add(alias_bytes, name_bytes, work, report, name, line)
                        target_group: mutable usize = 0
                        target_total: mutable usize = 0
                        return false if not proof_block_lemma_source_cost(target, target_group, target_total, work, report, name, line)
                        return false if not proof_block_lemma_stability_cost_add(target_total, alias_target_cost, work, report, name, line)
                    Ast::Decl.Struct(type_name, _, _, _, _, _, _):
                        type_bytes: usize = sview_len(type_name)
                        return false if not proof_block_lemma_budget_charge(type_bytes, work, report, name, line) or not proof_block_lemma_stability_cost_add(type_bytes, name_bytes, work, report, name, line)
                    Ast::Decl.Enum(type_name, variants, _, _, _):
                        type_bytes: usize = sview_len(type_name)
                        return false if not proof_block_lemma_budget_charge(type_bytes, work, report, name, line) or not proof_block_lemma_stability_cost_add(type_bytes, name_bytes, work, report, name, line)
                        return false if not proof_block_lemma_budget_charge(variants.count, work, report, name, line) or not proof_block_lemma_stability_cost_add(variants.count, items, work, report, name, line)
                        for variant in variants |items, name_bytes, work, report, name, line|:
                            return false if not proof_block_lemma_budget_charge(1, work, report, name, line)
                            variant_bytes: usize = sview_len(variant.name)
                            return false if not proof_block_lemma_budget_charge(variant_bytes, work, report, name, line) or not proof_block_lemma_stability_cost_add(variant_bytes, name_bytes, work, report, name, line)
                    _:
                        pass
            return true

        # Plain enum field checks also search hierarchy annotations. Measure that vector under
        # the shared meter before reserving its repeated name comparisons.
        def proof_block_lemma_stability_annotation_cost(annotations: darray[Ast::EnumAnnotation]&, items: mutable usize&, name_bytes: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            if not proof_block_lemma_budget_charge(annotations.count, work, report, name, line) or not proof_block_lemma_stability_cost_add(annotations.count, items, work, report, name, line):
                return false
            for annotation in annotations |items, name_bytes, work, report, name, line|:
                return false if not proof_block_lemma_budget_charge(1, work, report, name, line)
                owner_bytes: usize = sview_len(annotation.owner)
                annotation_bytes: usize = sview_len(annotation.name)
                return false if not proof_block_lemma_budget_charge(owner_bytes, work, report, name, line) or not proof_block_lemma_stability_cost_add(owner_bytes, name_bytes, work, report, name, line)
                return false if not proof_block_lemma_budget_charge(annotation_bytes, work, report, name, line) or not proof_block_lemma_stability_cost_add(annotation_bytes, name_bytes, work, report, name, line)
            return true

        def proof_block_lemma_stability_operator_rows_cost(rows: darray[ProofOperatorImpl]&, items: mutable usize&, maximum_name_width: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            if not proof_block_lemma_budget_charge(rows.count, work, report, name, line) or not proof_block_lemma_stability_cost_add(rows.count, items, work, report, name, line):
                return false
            for implementation in rows |items, maximum_name_width, work, report, name, line|:
                return false if not proof_block_lemma_budget_charge(1, work, report, name, line)
                concrete_bytes: usize = sview_len(implementation.concrete)
                protocol_bytes: usize = sview_len(implementation.protocol)
                return false if not proof_block_lemma_budget_charge(concrete_bytes, work, report, name, line)
                return false if not proof_block_lemma_budget_charge(protocol_bytes, work, report, name, line)
                if concrete_bytes > PROOF_PURITY_WALK_WORK_LIMIT:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                if protocol_bytes > PROOF_PURITY_WALK_WORK_LIMIT - concrete_bytes:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                pair_name_width: usize = concrete_bytes + protocol_bytes
                maximum_name_width <- pair_name_width if pair_name_width > maximum_name_width
            return true

        def proof_block_lemma_stability_enum_reserve(shape: ProofBlockLemmaStabilityShape, mapped_cost: usize, depth: usize, functions: ProofFunctionTable&, extra: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            return true if not shape.scalar_query or (not shape.enum_shorthand_query and not shape.enum_field_query and not shape.call_query)
            return false if mapped_cost == 0
            declaration_items: mutable usize = 0
            declaration_name_bytes: mutable usize = 0
            alias_target_cost: mutable usize = 0
            if not proof_block_lemma_stability_declaration_cost(report.source_declarations, declaration_items, declaration_name_bytes, alias_target_cost, work, report, name, line, 0):
                return false
            call_type_cost: mutable usize = 0
            if shape.call_query:
                for return_type in functions.returns.return_types |call_type_cost, work, report, name, line|:
                    target_group: mutable usize = 0
                    target_total: mutable usize = 0
                    return false if not proof_block_lemma_source_cost(return_type, target_group, target_total, work, report, name, line)
                    call_type_cost <- target_total if target_total > call_type_cost

            # Operator roots have at most two operands. Parentheses can re-enter the operand
            # helper at every level, so query_count is bounded by 2*N*D. Shorthand ownership
            # uses four declaration passes; a field query uses two base passes plus up to two
            # alias passes per level in both type-head and operator-implementation name walks.
            # A call operand's return type follows up to D aliases (two passes apiece).
            enum_query_count: mutable usize = 0
            return false if not proof_block_lemma_stability_add_product(2, mapped_cost, depth, 1, enum_query_count, work, report, name, line)
            declaration_scans: mutable usize = 0
            if shape.enum_shorthand_query:
                return false if not proof_block_lemma_stability_add_product(enum_query_count, 4, 1, 1, declaration_scans, work, report, name, line)
            if shape.enum_field_query:
                field_scans: mutable usize = 0
                alias_depth: usize = PROOF_TYPE_AUDIT_DEPTH_LIMIT
                return false if not proof_block_lemma_stability_add_product(enum_query_count, 4, alias_depth, 1, field_scans, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(enum_query_count, 2, 1, 1, field_scans, work, report, name, line)
                if declaration_scans > PROOF_PURITY_WALK_WORK_LIMIT - field_scans:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                declaration_scans <- declaration_scans + field_scans
            if shape.call_query:
                call_scans: mutable usize = 0
                return false if not proof_block_lemma_stability_add_product(enum_query_count, 2, PROOF_TYPE_AUDIT_DEPTH_LIMIT, 1, call_scans, work, report, name, line)
                if declaration_scans > PROOF_PURITY_WALK_WORK_LIMIT - call_scans:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                declaration_scans <- declaration_scans + call_scans
            type_width: mutable usize = mapped_cost
            type_width <- call_type_cost if call_type_cost > type_width
            if alias_target_cost > PROOF_PURITY_WALK_WORK_LIMIT - type_width:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            type_width <- type_width + alias_target_cost
            return false if not proof_block_lemma_stability_add_product(declaration_scans, 2, declaration_items, 1, extra, work, report, name, line)
            return false if not proof_block_lemma_stability_add_product(declaration_scans, declaration_name_bytes, 1, 1, extra, work, report, name, line)
            return false if not proof_block_lemma_stability_add_product(declaration_scans, declaration_items, type_width, 1, extra, work, report, name, line)
            # Empty declaration vectors still incur iterator setup, and field type heads traverse
            # the mapped operand plus any alias target chain.
            return false if not proof_block_lemma_stability_add_product(declaration_scans, 1, 1, 1, extra, work, report, name, line)
            if shape.enum_shorthand_query or shape.enum_field_query:
                return false if not proof_block_lemma_stability_add_product(enum_query_count, mapped_cost, 1, 1, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(enum_query_count, alias_target_cost, 1, 1, extra, work, report, name, line)
            if shape.call_query:
                return false if not proof_block_lemma_stability_add_product(enum_query_count, call_type_cost, 1, 1, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(enum_query_count, alias_target_cost, 1, 1, extra, work, report, name, line)

            if shape.enum_field_query:
                annotation_items: mutable usize = 0
                annotation_name_bytes: mutable usize = 0
                return false if not proof_block_lemma_stability_annotation_cost(report.source_annotations, annotation_items, annotation_name_bytes, work, report, name, line)
                annotation_width: mutable usize = mapped_cost
                if alias_target_cost > PROOF_PURITY_WALK_WORK_LIMIT - annotation_width:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                annotation_width <- annotation_width + alias_target_cost
                return false if not proof_block_lemma_stability_add_product(enum_query_count, annotation_items, 1, 1, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(enum_query_count, annotation_name_bytes, 1, 1, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(enum_query_count, 2, annotation_items, annotation_width, extra, work, report, name, line)

            # Every built-in-operator query goes through the checked implementation index in a
            # completed proof check. Its builder rejects chains above 64 rows, so reserve those
            # probes (including exact candidate/query byte comparisons) here. The unchecked
            # annotation fallback is unreachable: proof_check_core returns if index build fails.
            implementation_rows: mutable usize = 0
            implementation_name_width: mutable usize = 0
            if not proof_block_lemma_stability_operator_rows_cost(report.operator_impls.rows, implementation_rows, implementation_name_width, work, report, name, line):
                return false
            lookup_width: mutable usize = type_width
            lookup_width <- declaration_name_bytes if declaration_name_bytes > lookup_width
            return false if not proof_block_lemma_stability_cost_add(3, lookup_width, work, report, name, line)
            probe_cost: mutable usize = 0
            return false if not proof_block_lemma_stability_add_product(PROOF_OPERATOR_IMPL_MAX_BUCKET, 2, lookup_width, 1, probe_cost, work, report, name, line)
            return false if not proof_block_lemma_stability_add_product(PROOF_OPERATOR_IMPL_MAX_BUCKET, 1, 1, 1, probe_cost, work, report, name, line)
            # Each bucket has at most 64 rows. Use the largest row-name pair as the per-candidate
            # width; summing all rows would charge unrelated buckets on every implementation probe.
            return false if not proof_block_lemma_stability_add_product(PROOF_OPERATOR_IMPL_MAX_BUCKET, implementation_name_width, 1, 1, probe_cost, work, report, name, line)
            return false if not proof_block_lemma_stability_add_product(lookup_width, 1, 1, 1, probe_cost, work, report, name, line)
            return false if not proof_block_lemma_stability_add_product(4, 1, 1, 1, probe_cost, work, report, name, line)
            implementation_probes: mutable usize = 0
            if shape.enum_shorthand_query:
                return false if not proof_block_lemma_stability_add_product(enum_query_count, 2, 1, 1, implementation_probes, work, report, name, line)
            if shape.enum_field_query:
                field_probe_levels: usize = PROOF_TYPE_AUDIT_DEPTH_LIMIT + 2
                return false if not proof_block_lemma_stability_add_product(enum_query_count, 2, field_probe_levels, 1, implementation_probes, work, report, name, line)
            if shape.call_query:
                return false if not proof_block_lemma_stability_add_product(enum_query_count, 2, 1, 1, implementation_probes, work, report, name, line)
            return false if not proof_block_lemma_stability_add_product(implementation_probes, probe_cost, 1, 1, extra, work, report, name, line)
            return true

        def proof_block_lemma_stability_reserve(shape: ProofBlockLemmaStabilityShape, mapped_cost: usize, facts_cost: usize, functions: ProofFunctionTable&, reserved: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            return true if not shape.scalar_query and not shape.index_query
            if facts_cost > PROOF_PURITY_WALK_WORK_LIMIT or mapped_cost > PROOF_PURITY_WALK_WORK_LIMIT - facts_cost:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            comparison_width: usize = mapped_cost + facts_cost
            depth: mutable usize = shape.expanded_depth
            depth <- 1 if depth == 0
            depth <- ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT if depth > ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            extra: mutable usize = 0
            return false if not proof_block_lemma_stability_enum_reserve(shape, mapped_cost, depth, functions, extra, work, report, name, line)
            return false if not proof_block_lemma_stability_add_product(8, mapped_cost, 1, 1, extra, work, report, name, line)
            if shape.scalar_query:
                # Each operator root checks its whole term and up to two operands. The recursive
                # runtime witness invokes the ordinary scalar witness at each visited node; the
                # sum of all such subterm walks is bounded by 3 * N * D^2. Each candidate term
                # equality admits and compares both complete expressions (five structural
                # passes), and each candidate list has at most F entries.
                visits: mutable usize = 0
                return false if not proof_block_lemma_stability_add_product(3, mapped_cost, depth, depth, visits, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(visits, 8, 1, 1, extra, work, report, name, line)
                # Identifier witnesses use the snapshot's open-addressed name table: fewer than
                # 4F probes are possible, and each string comparison is bounded by the argument
                # identifier bytes. Hashing the wanted identifier is covered by the same width.
                return false if not proof_block_lemma_stability_add_product(4, visits, facts_cost, mapped_cost, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(visits, mapped_cost, 1, 1, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(visits, facts_cost, comparison_width, 10, extra, work, report, name, line)
                if shape.element_lookup:
                    # Indexed/field witnesses can recurse through a path and re-check witnessed
                    # index terms. Bound the extra nested term visits and the per-level marker
                    # comparisons separately.
                    nested_visits: mutable usize = 0
                    return false if not proof_block_lemma_stability_add_product(visits, depth, mapped_cost, 1, nested_visits, work, report, name, line)
                    return false if not proof_block_lemma_stability_add_product(nested_visits, facts_cost, comparison_width, 10, extra, work, report, name, line)
                    return false if not proof_block_lemma_stability_add_product(visits, facts_cost, comparison_width, 5 * depth, extra, work, report, name, line)

                # A marker snapshot is rebuilt by every recursive runtime witness call. The
                # number of calls across all operator roots is at most 2 * N * D. Marker list
                # decoding is bounded by F, while the open-addressed marker-name table has fewer
                # than 4F slots and at most F insertions, each exact name comparison costing at
                # most F bytes. Thus 32 + 8F^3 covers one build, including empty/small snapshots.
                build_count: mutable usize = 0
                return false if not proof_block_lemma_stability_add_product(2, mapped_cost, depth + 1, 1, build_count, work, report, name, line)
                fact_square: mutable usize = 0
                fact_cube: mutable usize = 0
                return false if not proof_block_lemma_stability_add_product(facts_cost, facts_cost, 1, 1, fact_square, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(fact_square, facts_cost, 1, 1, fact_cube, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(build_count, 8, fact_cube, 1, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(build_count, 32, 1, 1, extra, work, report, name, line)

                # Each operator operand also performs four direct fact-table probes. Include
                # marker decoding and equality admission for every row in the coarse table pass.
                return false if not proof_block_lemma_stability_add_product(8, mapped_cost, facts_cost, facts_cost, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(40, mapped_cost, facts_cost, comparison_width, extra, work, report, name, line)

            if shape.index_query:
                # Built-in index admission scans each source fact once per index-shaped node.
                return false if not proof_block_lemma_stability_add_product(8, mapped_cost, 1, 1, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(mapped_cost, facts_cost, facts_cost, 1, extra, work, report, name, line)
                return false if not proof_block_lemma_stability_add_product(8, mapped_cost, facts_cost, comparison_width, extra, work, report, name, line)

            if reserved > PROOF_PURITY_WALK_WORK_LIMIT or extra > PROOF_PURITY_WALK_WORK_LIMIT - reserved:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            reserved <- reserved + extra
            return true

        def proof_block_lemma_stability_add_depth(shape: mutable ProofBlockLemmaStabilityShape&, expression_depth: usize) -> void:
            limit: usize = ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            if expression_depth >= limit:
                shape.expanded_depth <- limit
                return
            shape.expanded_depth <- expression_depth if expression_depth > shape.expanded_depth
