extend ElisaProof:
    private:
        def proof_index_dynamic_array_value_type(type_expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match type_expression:
                Ast::Expr.Paren(inner, _):
                    return proof_index_dynamic_array_value_type(inner, depth + 1)
                Ast::Expr.Index(Ast::Expr.Ident("darray", _), _, _):
                    return true
                Ast::Expr.IndexN(Ast::Expr.Ident("darray", _), arguments, _):
                    return arguments.count == 1
                _:
                    return false

        def proof_index_readonly_dynamic_array_type(type_expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match type_expression:
                Ast::Expr.Paren(inner, _):
                    return proof_index_readonly_dynamic_array_type(inner, depth + 1)
                Ast::Expr.Unary(TokenKind.Ampersand, inner, _):
                    return proof_index_dynamic_array_value_type(inner, depth + 1)
                _:
                    return false

        def proof_index_find_dynamic_array_parameter(declarations: darray[Ast::Decl]&, owner: sview, array_name: sview, matches: mutable usize&, valid: mutable bool&, depth: usize) -> void:
            return if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            for declaration in declarations |owner, array_name, matches, valid, depth|:
                match declaration:
                    Ast::Decl.Func(candidate, parameters, _, _, _, _, _):
                        if candidate == owner:
                            for parameter in parameters |array_name, matches, valid|:
                                if parameter.name == array_name:
                                    matches <- matches + 1
                                    valid <- not parameter.is_mutable and proof_index_readonly_dynamic_array_type(parameter.type_expression, 0)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_index_find_dynamic_array_parameter(nested, owner, array_name, matches, valid, depth + 1)
                    _:
                        pass

        def proof_index_source_dynamic_array_parameter(report: ProofReport&, owner: sview, array_name: sview) -> bool:
            matches: mutable usize = 0
            valid: mutable bool = false
            proof_index_find_dynamic_array_parameter(report.source_declarations, owner, array_name, matches, valid, 0)
            return matches == 1 and valid

        # Import only the exact upper bound carried by a post-return `if index >= array.count`
        # edge. The independent replay checks the source declaration, guard, and consumer site.
        def proof_index_upper_guard_array(goal: Ast::Expr, facts: darray[Ast::Expr]&) -> sview:
            match goal:
                Ast::Expr.Binary(Ast::Expr.Ident(bound_symbol, _), TokenKind.Lt, Ast::Expr.Field(Ast::Expr.Ident(array_name, _), "count", _), _):
                    return "" if bound_symbol == "" or array_name == "" or bound_symbol == array_name
                    for fact in facts |bound_symbol, array_name|:
                        match fact:
                            Ast::Expr.Unary(TokenKind.Not, Ast::Expr.Binary(Ast::Expr.Ident(guard_symbol, _), TokenKind.GtEq, Ast::Expr.Field(Ast::Expr.Ident(guard_array, _), "count", _), _), _):
                                return array_name if guard_symbol == bound_symbol and guard_array == array_name
                            _:
                                pass
                _:
                    pass
            return ""

        def proof_add_dynamic_array_guard_bound(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, goal: Ast::Expr, owner: sview, line: u32) -> void:
            array_name: sview = proof_index_upper_guard_array(goal, facts)
            return if array_name == "" or not proof_index_source_dynamic_array_parameter(report, owner, array_name)
            proof_add_type_bound_fact(facts, report, goal, line, owner)
