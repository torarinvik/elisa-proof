extend ElisaProof:
    private:
        # A call result is deliberately not a witnessed scalar term: two occurrences of the same
        # call text need not denote one value, so `r == need(c, s)` beside `need(c, s) <= s` never
        # gives `r <= s` through the linear tiers. When a scalar symbol is bound to the call, the
        # symbol is this call's result, so each of the call's summaries is instantiated again with
        # `result` bound to the symbol. That is the same summary the call site produced, with
        # the same parameter bindings and the same proven requires, so replay validates the new
        # trace exactly as it validates the first: by instantiating the callee's ensure.
        # The call term replaced by the bound symbol, also as the object of a field: an
        # aggregate result states `make(n).count <= 4`, which reads `p.count <= 4` once `p`
        # holds that result.
        def proof_replace_call_result(expression: Ast::Expr, call: Ast::Expr, bound: Ast::Expr, depth: usize) -> (changed: bool, value: Ast::Expr):
            return (false, expression) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Field(object, field, position):
                    replaced: (changed: bool, value: Ast::Expr) = proof_replace_call_result(object, call, bound, depth + 1)
                    return (replaced.changed, Ast::Expr.Field(replaced.value, field, position))
                Ast::Expr.Paren(inner, position):
                    replaced: (changed: bool, value: Ast::Expr) = proof_replace_call_result(inner, call, bound, depth + 1)
                    return (replaced.changed, Ast::Expr.Paren(replaced.value, position))
                Ast::Expr.Unary(operator, operand, position):
                    replaced: (changed: bool, value: Ast::Expr) = proof_replace_call_result(operand, call, bound, depth + 1)
                    return (replaced.changed, Ast::Expr.Unary(operator, replaced.value, position))
                Ast::Expr.Binary(left, operator, right, position):
                    left_replaced: (changed: bool, value: Ast::Expr) = proof_replace_call_result(left, call, bound, depth + 1)
                    right_replaced: (changed: bool, value: Ast::Expr) = proof_replace_call_result(right, call, bound, depth + 1)
                    return (left_replaced.changed or right_replaced.changed, Ast::Expr.Binary(left_replaced.value, operator, right_replaced.value, position))
                _:
                    return proof_replace_place(expression, call, bound, depth + 1)

        def proof_rebind_call_summaries(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, value: Ast::Expr, symbol: sview, line: u32, owner: sview, position: Ast::Pos) -> void:
            match value:
                Ast::Expr.Call(_, _, _, _):
                    pass
                _:
                    return
            return if symbol == "" or owner == ""
            bound: Ast::Expr = Ast::Expr.Ident(symbol, position)
            start: usize = report.fact_trace_active_start if report.fact_trace_active_start <= report.fact_traces.count else report.fact_traces.count
            limit: usize = report.fact_traces.count
            for index in start..<limit |index, facts, report, value, bound, line, owner|:
                trace: ProofFactTrace = report.fact_traces[index]
                continue if trace.kind != "function-summary" or trace.name != owner or trace.summary_bindings_count == 0
                continue if trace.summary_bindings_start + trace.summary_bindings_count > report.fact_trace_summary_values.count
                continue if trace.summary_requires_start + trace.summary_requires_count > report.fact_trace_summary_require_goal_ids.count
                # A call-entry reference snapshot, when present, is bound after `result`.
                has_call_old: bool = trace.summary_bindings_count >= 2 and report.fact_trace_summary_names[trace.summary_bindings_start + trace.summary_bindings_count - 1] == "__old_reference_state"
                parameter_count: usize = trace.summary_bindings_count - 2 if has_call_old else trace.summary_bindings_count - 1
                result_value: Ast::Expr = report.fact_trace_summary_values[trace.summary_bindings_start + parameter_count]
                call_old_value: Ast::Expr = report.fact_trace_summary_values[trace.summary_bindings_start + parameter_count + 1] if has_call_old else Ast::Expr.Absent
                continue if not proof_expr_equal(result_value, value)
                continue if not (any existing in facts where proof_expr_equal(existing, trace.expression))
                renamed: (changed: bool, value: Ast::Expr) = proof_replace_call_result(trace.expression, value, bound, 0)
                continue if not renamed.changed
                continue if any existing in facts where proof_expr_equal(existing, renamed.value)
                parameter_names: mutable darray[sview] = []
                argument_values: mutable darray[Ast::Expr] = []
                for offset in 0..<parameter_count |offset, report, trace, parameter_names, argument_values|:
                    parameter_names.push(report.fact_trace_summary_names[trace.summary_bindings_start + offset])
                    argument_values.push(report.fact_trace_summary_values[trace.summary_bindings_start + offset])
                require_goal_ids: mutable darray[usize] = []
                for offset in 0..<trace.summary_requires_count |offset, report, trace, require_goal_ids|:
                    require_goal_ids.push(report.fact_trace_summary_require_goal_ids[trace.summary_requires_start + offset])
                proof_add_function_summary_fact(facts, report, renamed.value, line, owner, trace.dependency, parameter_names, argument_values, bound, require_goal_ids, trace.summary_ensure_index, has_call_old, call_old_value, trace.owner_line)
