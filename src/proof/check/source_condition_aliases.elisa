# Path-sensitive aliases for short-circuit conditions and branch edges.
extend ElisaProof:
    private:
        def proof_source_condition_alias_intersection(left: ProofSourceRuntimeAliasSet, right: ProofSourceRuntimeAliasSet, report: mutable ProofReport&) -> (complete: bool, aliases: ProofSourceRuntimeAliasSet):
            aliases: mutable ProofSourceRuntimeAliasSet = proof_source_runtime_alias_set_empty()
            for candidate in left.names |candidate, right, aliases, report|:
                return (false, aliases) if not proof_source_index_work_charge(report, 1)
                lookup: (complete: bool, present: bool) = proof_source_runtime_alias_lookup(right, candidate, report)
                return (false, aliases) if not lookup.complete
                return (false, aliases) if lookup.present and not proof_source_runtime_alias_add(&aliases, candidate, report)
            return (true, aliases)

        def proof_source_condition_alias_paths_impl(condition: Ast::Expr, inherited: ProofSourceRuntimeAliasSet, report: mutable ProofReport&, depth: usize) -> (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet):
            true_aliases: mutable ProofSourceRuntimeAliasSet = proof_source_runtime_alias_set_empty()
            false_aliases: mutable ProofSourceRuntimeAliasSet = proof_source_runtime_alias_set_empty()
            return (false, true_aliases, false_aliases) if:
                depth >= PROOF_SOURCE_OPERATOR_AST_DEPTH_LIMIT
                not proof_source_index_work_charge(report, 1)
            match condition:
                Ast::Expr.Paren(inner, _):
                    return proof_source_condition_alias_paths_impl(inner, inherited, report, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    inner_paths: (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_paths_impl(inner, inherited, report, depth + 1)
                    return (inner_paths.complete, inner_paths.false_aliases, inner_paths.true_aliases)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    left_paths: (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_paths_impl(left, inherited, report, depth + 1)
                    return (false, true_aliases, left_paths.false_aliases) if not left_paths.complete
                    right_paths: (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_paths_impl(right, left_paths.true_aliases, report, depth + 1)
                    return (false, right_paths.true_aliases, right_paths.false_aliases) if not right_paths.complete
                    common_false: (complete: bool, aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_intersection(left_paths.false_aliases, right_paths.false_aliases, report)
                    return (false, right_paths.true_aliases, common_false.aliases) if not common_false.complete
                    return (true, right_paths.true_aliases, common_false.aliases)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    left_paths: (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_paths_impl(left, inherited, report, depth + 1)
                    return (false, left_paths.true_aliases, left_paths.false_aliases) if not left_paths.complete
                    right_paths: (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_paths_impl(right, left_paths.false_aliases, report, depth + 1)
                    return (false, right_paths.true_aliases, right_paths.false_aliases) if not right_paths.complete
                    common_true: (complete: bool, aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_intersection(left_paths.true_aliases, right_paths.true_aliases, report)
                    return (false, common_true.aliases, right_paths.false_aliases) if not common_true.complete
                    return (true, common_true.aliases, right_paths.false_aliases)
                Ast::Expr.Binary(_, TokenKind.Is, _, _) | Ast::Expr.Binary(_, TokenKind.As, _, _):
                    for alias in inherited.names |true_aliases, false_aliases, report|:
                        return (false, true_aliases, false_aliases) if:
                            not proof_source_runtime_alias_add(&true_aliases, alias, report)
                            not proof_source_runtime_alias_add(&false_aliases, alias, report)
                    condition_bindings: mutable darray[sview] = []
                    return (false, true_aliases, false_aliases) if not proof_structural_operator_guard_collect_expression_bindings(condition, &condition_bindings, report, depth + 1)
                    # Keep the established conservative treatment for condition-emitted
                    # locals until every backend condition form has edge-specific scope
                    # lowering. The collector excludes binders local to a nested value-if.
                    for alias in condition_bindings |true_aliases, false_aliases, report|:
                        return (false, true_aliases, false_aliases) if:
                            not proof_source_runtime_alias_add(&true_aliases, alias, report)
                            not proof_source_runtime_alias_add(&false_aliases, alias, report)
                    return (true, true_aliases, false_aliases)
                _:
                    for alias in inherited.names |true_aliases, false_aliases, report|:
                        return (false, true_aliases, false_aliases) if:
                            not proof_source_runtime_alias_add(&true_aliases, alias, report)
                            not proof_source_runtime_alias_add(&false_aliases, alias, report)
                    # Opaque boolean leaves can still lower pattern tests into the
                    # surrounding condition scope. Keep their binders opaque on both
                    # outcomes so an outer parameter cannot stand in for a payload.
                    condition_bindings: mutable darray[sview] = []
                    return (false, true_aliases, false_aliases) if not proof_structural_operator_guard_collect_expression_bindings(condition, &condition_bindings, report, depth + 1)
                    for alias in condition_bindings |true_aliases, false_aliases, report|:
                        return (false, true_aliases, false_aliases) if:
                            not proof_source_runtime_alias_add(&true_aliases, alias, report)
                            not proof_source_runtime_alias_add(&false_aliases, alias, report)
                    return (true, true_aliases, false_aliases)

        # Preserve the path equations for short-circuit operators, then conservatively account
        # for condition binders that older condition forms still leave in the generated scope.
        # Nested value-if binders are excluded by the scope-aware expression collector.
        def proof_source_condition_alias_paths(condition: Ast::Expr, inherited: ProofSourceRuntimeAliasSet, report: mutable ProofReport&, depth: usize) -> (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet):
            paths: (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_paths_impl(condition, inherited, report, depth)
            return paths if not paths.complete
            composed: mutable bool = false
            match condition:
                Ast::Expr.Paren(_, _) | Ast::Expr.Unary(TokenKind.Not, _, _) | Ast::Expr.Binary(_, TokenKind.And, _, _) | Ast::Expr.Binary(_, TokenKind.Or, _, _):
                    composed <- true
                _:
                    pass
            return paths if not composed
            bindings: mutable darray[sview] = []
            return (false, paths.true_aliases, paths.false_aliases) if not proof_structural_operator_guard_collect_expression_bindings(condition, &bindings, report, depth)
            return paths if bindings.count == 0
            true_copy: (complete: bool, aliases: ProofSourceRuntimeAliasSet) = proof_source_runtime_alias_set_clone_with_work(paths.true_aliases, report)
            return (false, true_copy.aliases, paths.false_aliases) if not true_copy.complete
            false_copy: (complete: bool, aliases: ProofSourceRuntimeAliasSet) = proof_source_runtime_alias_set_clone_with_work(paths.false_aliases, report)
            return (false, true_copy.aliases, false_copy.aliases) if not false_copy.complete
            true_aliases: mutable ProofSourceRuntimeAliasSet = true_copy.aliases
            false_aliases: mutable ProofSourceRuntimeAliasSet = false_copy.aliases
            for alias in bindings |alias, true_aliases, false_aliases, report|:
                return (false, true_aliases, false_aliases) if:
                    not proof_source_runtime_alias_add(&true_aliases, alias, report)
                    not proof_source_runtime_alias_add(&false_aliases, alias, report)
            return (true, true_aliases, false_aliases)

        def proof_source_condition_true_aliases_with_set(condition: Ast::Expr, inherited: ProofSourceRuntimeAliasSet, report: mutable ProofReport&) -> (complete: bool, aliases: ProofSourceRuntimeAliasSet):
            paths: (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_paths(condition, inherited, report, 0)
            return (paths.complete, paths.true_aliases)

        def proof_source_condition_false_aliases_with_set(condition: Ast::Expr, inherited: ProofSourceRuntimeAliasSet, report: mutable ProofReport&) -> (complete: bool, aliases: ProofSourceRuntimeAliasSet):
            paths: (complete: bool, true_aliases: ProofSourceRuntimeAliasSet, false_aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_alias_paths(condition, inherited, report, 0)
            return (paths.complete, paths.false_aliases)

        def proof_source_condition_true_aliases(condition: Ast::Expr, inherited: darray[sview], report: mutable ProofReport&) -> (complete: bool, aliases: darray[sview]):
            indexed_inherited: (complete: bool, aliases: ProofSourceRuntimeAliasSet) = proof_source_runtime_alias_set_from_names(inherited, report)
            return (false, []) if not indexed_inherited.complete
            aliases: (complete: bool, aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_true_aliases_with_set(condition, indexed_inherited.aliases, report)
            return (aliases.complete, aliases.aliases.names)

        def proof_source_condition_false_aliases(condition: Ast::Expr, inherited: darray[sview], report: mutable ProofReport&) -> (complete: bool, aliases: darray[sview]):
            indexed_inherited: (complete: bool, aliases: ProofSourceRuntimeAliasSet) = proof_source_runtime_alias_set_from_names(inherited, report)
            return (false, []) if not indexed_inherited.complete
            aliases: (complete: bool, aliases: ProofSourceRuntimeAliasSet) = proof_source_condition_false_aliases_with_set(condition, indexed_inherited.aliases, report)
            return (aliases.complete, aliases.aliases.names)
