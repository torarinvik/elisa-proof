# Work-bounded source readers for deterministic call-result witnesses.
extend ElisaProof:
    private:
        def proof_deterministic_term_occurs_with_work(term: Ast::Expr, expression: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if exhausted
            if depth > PROOF_TERM_OCCURS_DEPTH_LIMIT:
                exhausted <- true
                return false
            if not proof_linear_safety_work_charge(budget, exhausted, 1):
                return false
            equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(term, expression, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
            if not equal.complete:
                exhausted <- true
                return false
            return true if equal.matches
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_deterministic_term_occurs_with_work(term, inner, depth + 1, budget, exhausted)
                Ast::Expr.Unary(_, operand, _):
                    return proof_deterministic_term_occurs_with_work(term, operand, depth + 1, budget, exhausted)
                Ast::Expr.Binary(left, _, right, _):
                    return true if proof_deterministic_term_occurs_with_work(term, left, depth + 1, budget, exhausted)
                    return false if exhausted
                    return proof_deterministic_term_occurs_with_work(term, right, depth + 1, budget, exhausted)
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments |term, depth, budget, exhausted|:
                        return true if proof_deterministic_term_occurs_with_work(term, argument, depth + 1, budget, exhausted)
                        return false if exhausted
                    return false
                _:
                    return false

        def proof_deterministic_chain_arithmetic_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, links: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if links.count == 0
            return true if proof_deterministic_arithmetic_over_links_with_work(expression, links, false, 0, budget, exhausted)
            return false if exhausted
            for fact in facts |links, budget, exhausted|:
                return true if proof_deterministic_arithmetic_over_links_with_work(fact, links, false, 0, budget, exhausted)
                return false if exhausted
            return false

        def proof_deterministic_arithmetic_over_links_with_work(expression: Ast::Expr, links: darray[Ast::Expr]&, inside: bool, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if exhausted
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or not proof_linear_safety_work_charge(budget, exhausted, 1):
                exhausted <- true
                return false
            if inside:
                for link in links |expression, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(link, expression, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                    if not equal.complete:
                        exhausted <- true
                        return false
                    return true if equal.matches
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_deterministic_arithmetic_over_links_with_work(inner, links, inside, depth + 1, budget, exhausted)
                Ast::Expr.Unary(_, operand, _):
                    return proof_deterministic_arithmetic_over_links_with_work(operand, links, inside, depth + 1, budget, exhausted)
                Ast::Expr.Binary(left, operator, right, _):
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star
                    return true if proof_deterministic_arithmetic_over_links_with_work(left, links, inside or arithmetic, depth + 1, budget, exhausted)
                    return false if exhausted
                    return proof_deterministic_arithmetic_over_links_with_work(right, links, inside or arithmetic, depth + 1, budget, exhausted)
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments |links, inside, depth, budget, exhausted|:
                        return true if proof_deterministic_arithmetic_over_links_with_work(argument, links, inside, depth + 1, budget, exhausted)
                        return false if exhausted
                    return false
                _:
                    return false

        def proof_shared_fixed_parameter_with_work(report: ProofReport&, names: darray[sview]&, parameters: darray[sview]&, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if name == "" or exhausted
            fixed: mutable bool = false
            for candidate in report.aliases.shared_fixed_names |name, budget, exhausted, fixed|:
                if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(candidate)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name)):
                    return false
                if candidate == name:
                    fixed <- true
                    break
            return false if exhausted or not fixed
            index: mutable usize = names.count
            while index > 0 |index, names, parameters, name, budget, exhausted|:
                index <- index - 1
                if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(names[index])) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name)):
                    return false
                return index < parameters.count if names[index] == name
            return false

        def proof_add_deterministic_call_witness_with_work(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, caller_names: darray[sview]&, caller_parameters: darray[sview]&, budget: mutable usize&, exhausted: mutable bool&) -> void:
            return if exhausted or not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    pass
                _:
                    return
            witnessed_calls: mutable usize = 0
            links: mutable darray[Ast::Expr] = []
            for fact in facts |witnessed_calls, links, expression, budget, exhausted|:
                return if not proof_linear_safety_work_charge(budget, exhausted, 1)
                fact_shape: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return if not fact_shape.complete or exhausted
                callee_name: sview = proof_marker_callee_name(fact)
                return if not proof_linear_safety_work_charge(budget, exhausted, sview_len(callee_name))
                continue if callee_name != "__elisa_primitive_scalar_type"
                marker: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, "__elisa_primitive_scalar_type")
                continue if not marker.known
                match marker.term:
                    Ast::Expr.Call(_, _, _, _):
                        witnessed_calls <- witnessed_calls + 1
                        occurs: bool = proof_deterministic_term_occurs_with_work(marker.term, expression, 0, budget, exhausted)
                        return if exhausted
                        links.push(marker.term) if occurs
                    _:
                        pass
            return if exhausted
            if witnessed_calls >= PROOF_DETERMINISTIC_CALL_WITNESS_LIMIT:
                reads_arithmetic: bool = proof_deterministic_chain_arithmetic_with_work(expression, facts, links, budget, exhausted)
                return if exhausted or not reads_arithmetic
            return if witnessed_calls > PROOF_DETERMINISTIC_CALL_WITNESS_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, position):
                    called: usize = proof_function_index_for_callee(functions, callee)
                    return if called >= functions.summaries.deterministic.count or not functions.summaries.deterministic[called]
                    return if called < functions.summaries.pure.count and functions.summaries.pure[called]
                    return if called >= functions.summaries.verified.count or not functions.summaries.verified[called]
                    return if called >= functions.returns.return_scalar.count or not functions.returns.return_scalar[called]
                    markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                    return if not markers_result.complete or exhausted
                    marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, budget, exhausted)
                    return if not marker_scale.complete or exhausted
                    for argument in arguments |facts, report, caller_names, caller_parameters, markers_result, marker_scale, budget, exhausted|:
                        value_binding: (complete: bool, argument: bool) = proof_value_binding_argument_with_work(argument, report, 0, budget, exhausted)
                        return if not value_binding.complete or exhausted
                        continue if value_binding.argument
                        shared_fixed: bool = proof_shared_fixed_parameter_with_work(report, caller_names, caller_parameters, proof_ident_name(argument), budget, exhausted)
                        return if exhausted
                        continue if shared_fixed
                        witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(argument, markers_result.witnesses, marker_scale.scale, budget, exhausted)
                        return if not witnessed.complete or exhausted or not witnessed.matches
                    deterministic_marker: Ast::Expr = proof_scalar_term_marker(expression, position)
                    for existing in facts |deterministic_marker, budget, exhausted|:
                        equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(existing, deterministic_marker, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                        if not equal.complete or exhausted:
                            exhausted <- true
                            return
                        return if equal.matches
                    return if report.analysis_2.scalar_witness_facts >= PROOF_SCALAR_WITNESS_FUNCTION_BUDGET
                    report.analysis_2.scalar_witness_facts <- report.analysis_2.scalar_witness_facts + 1
                    output_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(deterministic_marker, budget, exhausted)
                    return if not output_cost.complete or exhausted
                    proof_add_traced_fact(facts, report, deterministic_marker, "deterministic-call", line, owner)
                    return if called >= functions.returns.return_types.count
                    width: i64 = proof_signed_type_width_with_work(functions.returns.return_types[called], report.source.source_declarations, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                    exhausted <- true if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    proof_add_scalar_type_witness(facts, report, proof_signed_place_marker(expression, width, position), line, owner) if width > 0
                _:
                    pass
