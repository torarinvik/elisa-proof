# Bounds on return-path analysis: statement steps and the size of each branch snapshot.
extend ElisaProof:
    private:
        const PROOF_CONTROL_FLOW_DEPTH_LIMIT: usize = 64
        const PROOF_RETURN_ANALYSIS_BUDGET: usize = 64
        const PROOF_RETURN_ANALYSIS_STEP_BUDGET_MAX: usize = 192
        const PROOF_KERNEL_REPLAY_EXPR_EQUAL_STEP_BUDGET: usize = 128
        const PROOF_RETURN_ANALYSIS_STEPS_PER_SOURCE_STATEMENT: usize = 2
        const PROOF_RETURN_ANALYSIS_STATEMENT_BUDGET_CEILING: usize = 64
        # Branch snapshots duplicate AST-backed symbolic state. Keep this bounded so malformed
        # or adversarial control flow terminates predictably; exhaustion is reported unsupported.
        const PROOF_RETURN_FACT_STATE_BUDGET: usize = 64
        # The unsigned-marker decoder validates several mutually dependent arena bounds,
        # identities, and payload facts in one bounded helper. Give only this kernel helper
        # extra snapshot headroom; it remains below the normal 128-fact entry cap.
        const PROOF_KERNEL_REPLAY_UNSIGNED_MARKER_FACT_STATE_BUDGET: usize = 128
        # Some typed arena parameters contribute more than the base fact count before body
        # analysis begins. Give those states bounded headroom without changing the separate
        # small-function policy; the ordinary 64-step control-flow budget remains unchanged.
        const PROOF_RETURN_FACT_STATE_ENTRY_CAP: usize = 128
        const PROOF_SMALL_FUNCTION_FACT_STATE_BUDGET: usize = 256
        const PROOF_SMALL_FUNCTION_BODY_LIMIT: usize = 4
        const PROOF_PARAMETER_HEAVY_PARAMETER_LIMIT: usize = 12
        const PROOF_PARAMETER_HEAVY_BODY_LIMIT: usize = 24
        const PROOF_CALL_SUMMARY_BODY_MIN: usize = 12
        const PROOF_CALL_SUMMARY_BODY_MAX: usize = 24
        const PROOF_CALL_SUMMARY_TARGET_MAX: usize = 4

        # Count resolved function identities, not call sites. Unknown or malformed
        # edges cannot qualify for the small-target dispatcher policy.
        def proof_return_analysis_call_target_count(functions: ProofFunctionTable&, function_index: usize) -> usize:
            denied: usize = PROOF_CALL_SUMMARY_TARGET_MAX + 1
            return denied if function_index >= functions.names.count or function_index >= functions.call_starts.count or function_index >= functions.call_counts.count
            start: usize = functions.call_starts[function_index]
            count: usize = functions.call_counts[function_index]
            return denied if count > PROOF_RETURN_ANALYSIS_STEP_BUDGET_MAX
            return denied if start > functions.all_call_targets.count or count > functions.all_call_targets.count - start
            targets: mutable darray[usize] = []
            for offset in 0..<count |functions, start, targets, denied|:
                target: usize = functions.all_call_targets[start + offset]
                return denied if target >= functions.names.count
                present: mutable bool = false
                for known in targets |target, present|:
                    present <- true if known == target
                if not present:
                    return denied if targets.count >= PROOF_CALL_SUMMARY_TARGET_MAX
                    targets.push(target)
            targets.count

        # Requires/ensure declarations are proof inputs, not executable dispatcher
        # statements. Other policies still use the complete body size.
        def proof_return_analysis_call_summary_body_count(body: darray[Ast::Stmt]) -> usize:
            return PROOF_RETURN_ANALYSIS_STEP_BUDGET_MAX if body.count > PROOF_RETURN_ANALYSIS_STEP_BUDGET_MAX
            count: mutable usize = 0
            for statement in body |count|:
                match statement:
                    Ast::Stmt.Contract(kind, _, _):
                        continue if kind == "requires" or kind == "ensure"
                    _:
                        pass
                count <- count + 1
            count

        def proof_return_analysis_fact_state_budget(name: sview, body_count: usize, parameter_count: usize, call_target_count: usize, call_body_count: usize) -> usize:
            return PROOF_SMALL_FUNCTION_FACT_STATE_BUDGET if body_count <= PROOF_SMALL_FUNCTION_BODY_LIMIT
            return PROOF_RETURN_FACT_STATE_ENTRY_CAP if parameter_count >= PROOF_PARAMETER_HEAVY_PARAMETER_LIMIT and body_count <= PROOF_PARAMETER_HEAVY_BODY_LIMIT
            # This non-recursive comparison uses a bounded worklist and already has a dedicated
            # 128-step cap. Its node-pair context also needs bounded headroom above the base cap.
            return PROOF_RETURN_FACT_STATE_ENTRY_CAP if name == "proof_kernel_replay_expr_equal"
            return PROOF_KERNEL_REPLAY_UNSIGNED_MARKER_FACT_STATE_BUDGET if name == "proof_kernel_replay_unsigned_marker_info"
            # A bounded dispatcher can have few parameters yet accumulate many facts from
            # repeated verified call summaries. Grant the same fixed headroom only to medium
            # bodies with a small, explicit call-target set; the independent step cap remains.
            return PROOF_RETURN_FACT_STATE_ENTRY_CAP if call_body_count >= PROOF_CALL_SUMMARY_BODY_MIN and call_body_count <= PROOF_CALL_SUMMARY_BODY_MAX and call_target_count > 0 and call_target_count <= PROOF_CALL_SUMMARY_TARGET_MAX
            return PROOF_RETURN_FACT_STATE_BUDGET

        def proof_return_analysis_step_budget(name: sview, body_count: usize) -> usize:
            # This non-recursive comparison has a dedicated bounded worklist cap.
            return PROOF_KERNEL_REPLAY_EXPR_EQUAL_STEP_BUDGET if name == "proof_kernel_replay_expr_equal" and body_count < PROOF_KERNEL_REPLAY_EXPR_EQUAL_STEP_BUDGET / PROOF_RETURN_ANALYSIS_STEPS_PER_SOURCE_STATEMENT
            # Path-sensitive checking may revisit a source statement while splitting
            # value-level control flow. Scale fuel by the function's syntactic body size,
            # but keep one absolute ceiling for every function and declaration name.
            # Check before multiplying so the arithmetic itself cannot overflow.
            return PROOF_RETURN_ANALYSIS_STEP_BUDGET_MAX if body_count >= PROOF_RETURN_ANALYSIS_STATEMENT_BUDGET_CEILING
            return PROOF_RETURN_ANALYSIS_BUDGET + body_count * PROOF_RETURN_ANALYSIS_STEPS_PER_SOURCE_STATEMENT

        def proof_return_analysis_budget_available(facts: darray[Ast::Expr]&, names: darray[sview]&, values: darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            step_budget: usize = PROOF_RETURN_ANALYSIS_BUDGET if report.budgets.return_step_budget == 0 else report.budgets.return_step_budget
            within_steps: bool = report.budgets.return_steps < step_budget
            fact_state_budget: usize = PROOF_RETURN_FACT_STATE_BUDGET if report.budgets.return_fact_state_budget == 0 else report.budgets.return_fact_state_budget
            within_facts: bool = facts.count <= fact_state_budget
            within_names: bool = names.count <= fact_state_budget
            within_values: bool = values.count <= fact_state_budget
            report.budgets.measured_live_facts_peak <- facts.count if facts.count > report.budgets.measured_live_facts_peak
            if within_steps and within_facts and within_names and within_values:
                report.budgets.measured_control_flow_steps <- report.budgets.measured_control_flow_steps + 1
                return true
            if not report.budgets.return_reported:
                report.budgets.return_reported <- true
                reason: mutable sview = "control-flow analysis exceeded its bounded symbolic-state budget"
                dimension: mutable sview = "state"
                observed: mutable usize = 0
                limit: mutable usize = 0
                if not within_steps:
                    reason <- "control-flow analysis exceeded its step budget"
                    dimension <- "steps"
                    # Include the statement whose analysis was denied; the completed-work
                    # counter itself correctly remains capped at the configured limit.
                    observed <- report.budgets.return_steps + 1
                    limit <- step_budget
                if within_steps and not within_facts:
                    reason <- "control-flow analysis exceeded its fact snapshot budget"
                    dimension <- "facts"
                    observed <- facts.count
                    limit <- fact_state_budget
                if within_steps and within_facts and not within_names:
                    reason <- "control-flow analysis exceeded its binding-name snapshot budget"
                    dimension <- "names"
                    observed <- names.count
                    limit <- fact_state_budget
                if within_steps and within_facts and within_names and not within_values:
                    reason <- "control-flow analysis exceeded its binding-value snapshot budget"
                    dimension <- "values"
                    observed <- values.count
                    limit <- fact_state_budget
                proof_add_budget_finding(report, "control-flow-analysis-budget", line, name, reason, dimension, observed, limit)
            return false
