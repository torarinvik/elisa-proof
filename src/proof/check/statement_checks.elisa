include "./value_block_assignments.elisa"
include "./value_block_declarations.elisa"
include "./index_safety_substitution.elisa"
include "./captured_block_checks.elisa"
include "./statement_catch_returns.elisa"

extend ElisaProof:
    private:
        def proof_check_index_safety(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: darray[Ast::Expr]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: mutable ProofFunctionTable&) -> void can[Global{Read,Write}]:
            # `proof_substitute` intentionally projects GetElse to its successful value for
            # ordinary symbolic reasoning. Preserve the control wrapper at this safety boundary
            # so a direct guarded index can emit its distinct checked-get certificate.
            match expression:
                Ast::Expr.GetElse(guarded, recovery, position):
                    source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
                    substituted_guarded: Ast::Expr = proof_substitute_index_safety(guarded, names, values, fixed_names, fixed_extents, &source_work, 0)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", position.line, name, "fixed-array place matching exceeded its shared source-work budget", "fixed-array-place-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return
                    preserved: Ast::Expr = Ast::Expr.GetElse(substituted_guarded, recovery, position)
                    (proof_check_index_safety_value(preserved, facts, fixed_names, fixed_extents, report, name, annotations, position.line, functions) can Global{Read,Write})
                Ast::Expr.Catch(guarded, arms, position):
                    # Catch arm values are evaluated in their own branch. This safety walk is
                    # intentionally expression-only; the value-position admission gate rejects
                    # arm statements that need a richer control-flow model.
                    (proof_check_index_safety(guarded, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                    guard_may_invalidate_facts: bool = facts.count > 0 and proof_index_safety_expression_may_invalidate_facts(guarded, functions, report, name, position.line)
                    for arm in arms |facts, names, values, fixed_names, fixed_extents, report, name, annotations, guard_may_invalidate_facts, functions|:
                        arm_value: (known: bool, value: Ast::Expr) = proof_catch_arm_value(arm)
                        if arm_value.known:
                            arm_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                            arm_facts.clear() if guard_may_invalidate_facts
                            (proof_check_index_safety(arm_value.value, arm_facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                _:
                    substituted: Ast::Expr = proof_substitute(expression, names, values)
                    (proof_check_index_safety_value(substituted, facts, fixed_names, fixed_extents, report, name, annotations, Ast::expr_pos(expression).line, functions) can Global{Read,Write})

        def proof_forget_index_state_before_operator(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: mutable darray[Ast::Expr]&, frame_parameters: darray[sview]&, report: mutable ProofReport&, name: sview, position: Ast::Pos) -> void:
            return if not proof_source_expression_has_overloaded_operator(expression, report.source.source_primitive_operator_mask, 0)
            proof_forget_values(names, values, position)
            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)

        def proof_check_statement_index_safety(statement: Ast::Stmt, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: mutable darray[Ast::Expr]&, frame_parameters: darray[sview]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: mutable ProofFunctionTable&) -> void can[Global{Read,Write}]:
            match statement:
                Ast::Stmt.Return(value, position):
                    proof_forget_index_state_before_operator(returned, facts, names, values, frame_parameters, report, name, position) if value is returned
                    (proof_check_index_safety(returned, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write}) if value is returned
                Ast::Stmt.Expr(expression, position):
                    proof_forget_index_state_before_operator(expression, facts, names, values, frame_parameters, report, name, position)
                    (proof_check_index_safety(expression, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Stmt.VarDecl(_, _, initializer, position):
                    proof_forget_index_state_before_operator(initializer, facts, names, values, frame_parameters, report, name, position)
                    (proof_check_index_safety(initializer, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Stmt.Assign(target, _, initializer, position):
                    proof_forget_index_state_before_operator(target, facts, names, values, frame_parameters, report, name, position)
                    (proof_check_index_safety(target, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                    proof_forget_index_state_before_operator(initializer, facts, names, values, frame_parameters, report, name, position)
                    (proof_check_index_safety(initializer, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Stmt.If(condition, _, _, position):
                    proof_forget_index_state_before_operator(condition, facts, names, values, frame_parameters, report, name, position)
                    (proof_check_index_safety(condition, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Stmt.While(condition, _, position):
                    proof_forget_index_state_before_operator(condition, facts, names, values, frame_parameters, report, name, position)
                    (proof_check_index_safety(condition, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Stmt.For(_, _, iterable, _, position):
                    proof_forget_index_state_before_operator(iterable, facts, names, values, frame_parameters, report, name, position)
                    (proof_check_index_safety(iterable, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Stmt.Match(scrutinee, arms, position):
                    proof_forget_index_state_before_operator(scrutinee, facts, names, values, frame_parameters, report, name, position)
                    (proof_check_index_safety(scrutinee, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                    for arm in arms |facts, names, values, fixed_names, fixed_extents, report, name, annotations|:
                        proof_forget_index_state_before_operator(arm.guard, facts, names, values, frame_parameters, report, name, position)
                        (proof_check_index_safety(arm.guard, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Stmt.Contract(kind, expression, position):
                    proof_forget_index_state_before_operator(expression, facts, names, values, frame_parameters, report, name, position) if kind == "assert"
                    (proof_check_index_safety(expression, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write}) if kind == "assert"
                _:
                    pass

        # A value match is a branch join, not a textual conditional. When an arm contains a
        # pure executable call, check that arm in an isolated proof state and route its value
        # through the ordinary return checker. This preserves call preconditions, callee
        # postconditions, pattern facts, and caller ensures without letting one arm's summary
        # facts justify another arm.
        def proof_check_value_match_return(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, position: Ast::Pos) -> void can[Global{Read,Write}]:
            scrutinee_has_overloaded_operator: bool = proof_source_expression_has_overloaded_operator(scrutinee, report.source.source_primitive_operator_mask, 0)
            scrutinee_has_call: bool = proof_frame_expression_has_call_with_work(scrutinee, report, name, position.line)
            if proof_frame_source_work_stop(report, name, position.line):
                report.proof_obligation(false)
                return
            if scrutinee_has_call:
                (proof_check_frame_calls_in_expression(scrutinee, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) can Global{Read,Write})
                if proof_frame_source_work_stop(report, name, position.line):
                    report.proof_obligation(false)
                    return
            scrutinee_value: Ast::Expr = proof_substitute(scrutinee, names, values)
            scrutinee_has_move: bool = proof_frame_expression_has_move_with_work(scrutinee_value, report, name, position.line)
            scrutinee_stable: bool = not scrutinee_has_overloaded_operator and not scrutinee_has_move and not proof_block_expression_has_fresh_value(scrutinee_value, 0) and (not scrutinee_has_call or (not proof_fact_expression_has_fresh_runtime_value(report, scrutinee) and proof_contract_calls_are_pure(scrutinee, functions)))
            if not scrutinee_stable:
                report.proof_obligation(false)
                proof_add_finding(report, "expression-unsupported", position.line, name, "value-match scrutinee is not a stable proof term")
            pattern_source: Ast::Expr = scrutinee_value if scrutinee_stable else Ast::Expr.Invalid
            pattern_type: Ast::Expr = proof_pattern_active_formal_type(report, name, scrutinee, pattern_source, names) if scrutinee_stable else Ast::Expr.Absent
            # Every earlier unguarded arm with an exact condition failed; guards here never call.
            refuted: mutable darray[Ast::Expr] = []
            for arm in arms |arms, names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, scrutinee_value, pattern_source, pattern_type, scrutinee_stable, position, refuted|:
                if not proof_return_analysis_budget_available(facts, names, values, report, name, position.line):
                    report.proof_obligation(false)
                    return
                report.analysis_1.budgets.return_steps <- report.analysis_1.budgets.return_steps + 1
                arm_names: mutable darray[sview] = proof_copy_names(names)
                arm_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                arm_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                arm_facts.clear() if not scrutinee_stable
                proof_forget_values(arm_names, arm_values, position) if not scrutinee_stable
                first_binding: usize = arm_values.count
                pattern_supported: bool = proof_match_closed_pattern(arm.pattern) and proof_bind_pattern(arm.pattern, position, pattern_source, &arm_names, &arm_values)
                proof_freshen_opaque_bindings(&arm_values, first_binding, pattern_source, report, position) if pattern_supported
                if not pattern_supported:
                    report.proof_obligation(false)
                    proof_add_finding(report, "pattern-unsupported", position.line, name, "value-match pattern cannot enter a verified proof state")
                pattern_condition: Ast::Expr? = proof_pattern_condition_using_type(arm.pattern, pattern_source, position, pattern_type, report) if pattern_supported and scrutinee_stable else null
                if pattern_supported and scrutinee_stable:
                    for earlier in refuted |earlier, arm_facts, report, name, position|:
                        proof_add_traced_fact(arm_facts, report, Ast::Expr.Unary(TokenKind.Not, earlier, position), "branch-condition", position.line, name)
                if pattern_condition is condition:
                    proof_add_traced_fact(arm_facts, report, condition, "branch-condition", position.line, name)
                    refuted.push(condition) if proof_pattern_condition_exact_using_type(arm.pattern, pattern_type, report) and arm.guard is Ast::Expr.Absent
                else:
                    match arm.pattern:
                        Ast::Pattern.Wildcard:
                            pass
                        _:
                            if pattern_supported:
                                report.proof_obligation(false)
                                proof_add_finding(report, "pattern-unsupported", position.line, name, "value-match pattern has no exact logical condition")
                match arm.guard:
                    Ast::Expr.Absent:
                        pass
                    _:
                        guard_has_effectful_operator: bool = proof_source_expression_has_overloaded_operator(arm.guard, report.source.source_primitive_operator_mask, 0)
                        guard_value: Ast::Expr = proof_substitute(arm.guard, arm_names, arm_values)
                        guard_has_call: bool = proof_frame_expression_has_call_with_work(arm.guard, report, name, position.line)
                        guard_has_move: bool = proof_frame_expression_has_move_with_work(guard_value, report, name, position.line)
                        guard_supported: bool = proof_expr_supported(arm.guard) and not guard_has_call and not guard_has_move and not proof_block_expression_has_fresh_value(guard_value, 0) and not guard_has_effectful_operator
                        if not guard_supported:
                            report.proof_obligation(false)
                            proof_add_finding(report, "expression-unsupported", position.line, name, "value-match guard cannot enter a verified proof state")
                            arm_facts.clear()
                            proof_forget_values(arm_names, arm_values, position) if guard_has_effectful_operator or guard_has_call or guard_has_move
                        else:
                            proof_add_traced_fact(arm_facts, report, guard_value, "branch-condition", position.line, name)
                if arm.body.count != 1:
                    report.proof_obligation(false)
                    proof_add_finding(report, "expression-unsupported", position.line, name, "value-match arms must contain exactly one expression")
                    continue
                arm_value: mutable Ast::Expr = Ast::Expr.Invalid
                arm_value_known: mutable bool = false
                match arm.body[0]:
                    Ast::Stmt.Expr(value, _):
                        arm_value <- value
                        arm_value_known <- true
                    _:
                        pass
                if not arm_value_known:
                    report.proof_obligation(false)
                    proof_add_finding(report, "expression-unsupported", position.line, name, "value-match arms must end in an expression")
                    continue
                synthetic_body: darray[Ast::Stmt] = [Ast::Stmt.Return(arm_value, position)]
                arm_flow: mutable ProofFlow = proof_empty_flow()
                (proof_check_returns(synthetic_body, &arm_names, &arm_values, &arm_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &arm_flow) can Global{Read,Write})

        # Check one exact loop back-edge. Every edge gets its own post-body facts; sharing the
        # entry context here would allow a condition or assertion from one branch to justify a
        # A captured block statement: `for x in xs |a, b|: ...` reaches the statement walker as an
        # expression statement holding a block with a capture list, not as `Ast::Stmt.For`. The
        # shape gate refuses such a block on purpose — a captured block writes back into its outer
        # bindings, and accepting it as a pure expression would let an outer fact survive a hidden
        # mutation. In *statement* position the value is discarded, so the write-back can simply be
        # modelled instead: check the body in a private state so no nested obligation is skipped,
        # then havoc the outer symbolic values and facts exactly as an opaque call boundary does.
        #
        # That is strictly better than refusing, which invalidates the whole enclosing path and so
        # costs every obligation after the loop as well as the function's own summary.
        def proof_captured_block_statement(statement: Ast::Stmt) -> (known: bool, body: darray[Ast::Stmt], captures: darray[sview], position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            empty: mutable darray[Ast::Stmt] = []
            empty_captures: mutable darray[sview] = []
            match statement:
                Ast::Stmt.Expr(expression, _):
                    match expression:
                        Ast::Expr.Block(statements, value, captures, position):
                            return (false, empty, empty_captures, position) if captures.count == 0
                            # The statement position discards the block's result, but the trailing
                            # value is still evaluated and may carry obligations of its own. Append
                            # it as an ordinary expression statement so the body walk checks it;
                            # `Absent` and `Invalid` are the parser's "no result" markers and carry
                            # nothing to check.
                            body: mutable darray[Ast::Stmt] = []
                            body.extend(statements)
                            match value:
                                Ast::Expr.Absent:
                                    pass
                                Ast::Expr.Invalid:
                                    pass
                                _:
                                    body.push(Ast::Stmt.Expr(value, position))
                            block_captures: mutable darray[sview] = []
                            block_captures.extend(captures)
                            return (true, body, block_captures, position)
                        _:
                            pass
                _:
                    pass
            return (false, empty, empty_captures, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        # different branch's termination step.
        def proof_check_decreases_step(measure_components: darray[Ast::Expr]&, decreases_components: darray[Ast::Expr]&, next_names: darray[sview]&, next_values: darray[Ast::Expr]&, next_facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, report: mutable ProofReport&, name: sview, position: Ast::Pos) -> bool can[Global{Read,Write}]:
            next_components: mutable darray[Ast::Expr] = []
            for component in decreases_components |next_components, next_names, next_values|:
                next_components.push(proof_substitute(component, next_names, next_values))
            next_nonnegative_proven: mutable bool = true
            for next_measure in next_components |next_facts, annotations, report, name, position, next_nonnegative_proven|:
                next_measure_nonnegative: Ast::Expr = Ast::Expr.Binary(next_measure, TokenKind.GtEq, Ast::Expr.IntLit(0, Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0}), Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0})
                next_component_proven: bool = (proof_certify_goal(next_facts, next_measure_nonnegative, report, position.line, name, annotations) can Global{Read,Write})
                report.proof_obligation(next_component_proven)
                next_nonnegative_proven <- false if not next_component_proven
                proof_add_latest_goal_finding(report, "loop-decreases-unproven", position.line, name, "decreases component is not proven nonnegative after one loop step") if not next_component_proven
            # Emit the descent goal even when a separate nonnegativity premise failed. Every
            # counted failure must have its own repairable goal rather than borrowing the ID of
            # the preceding component obligation.
            decreasing_proven: bool = (proof_lexicographic_smaller(measure_components, next_components, next_facts, annotations, Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0}, report, name) can Global{Read,Write})
            report.proof_obligation(decreasing_proven)
            proof_add_latest_goal_finding(report, "loop-decreases-unproven", position.line, name, "decreases lexicographic measure is not proven to strictly decrease") if not decreasing_proven
            return next_nonnegative_proven and decreasing_proven

        # Check a captured block once. The source forms `for x in xs |captures|:` and
        # `while c |captures|:` arrive as a block *around* the loop statement, so in statement
        # position the block is straight-line code that contains a loop, and the loop handler
        # inside it is what checks the iteration body for an arbitrary iteration. When a loop
        # handler finds its iteration body to be a block of its own it calls this with
        # `loop_entry` set: then every binding the body may rewrite becomes an opaque symbol at
        # entry (`proof_forget_loop_entry`) before the loop's entry facts -- the condition and
        # the invariants the loop established -- are added over that state. The body is checked
        # against the same postconditions, so a `return` inside it still has to establish them.
        # Its end state is handed back in `end_*` for the loop handler's preservation and
        # termination steps, its `break`/`continue` edges are propagated to the enclosing flow
        # so the loop handler sees them, and its write-back to the enclosing state is the havoc
        # over the capture list together with everything the body assigns or references.
        def proof_check_returns(body: darray[Ast::Stmt]&, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, flow: mutable ProofFlow&) -> void can[Global{Read,Write}]:
            # Stamp the finding inside the body so replay can attribute it to this declaration
            # row rather than to every same-named function.
            budget_line: u32 = proof_statement_position(body[0]).line if body.count > 0 else 0
            if not proof_return_analysis_budget_available(facts, names, values, report, name, budget_line):
                flow.normal <- false
                flow.valid <- false
                return
            report.analysis_1.budgets.return_steps <- report.analysis_1.budgets.return_steps + 1
            if loop_depth >= PROOF_CONTROL_FLOW_DEPTH_LIMIT:
                flow.normal <- false
                flow.valid <- false
                report.proof_obligation(false)
                proof_add_finding(report, "control-flow-unsupported", 0, name, "control-flow nesting exceeded the bounded proof-state depth")
                return
            flow.normal <- true
            flow.breaks <- false
            flow.continues <- false
            flow.valid <- true
            proof_clear_continue_states(flow)
            flattened: (known: bool, body: darray[Ast::Stmt]) = proof_flatten_value_block_declaration(body, names)
            if flattened.known:
                (proof_check_returns(flattened.body, names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, flow) can Global{Read,Write})
                return
            conditional_prior_work: usize = report.analysis_1.budgets.return_source_work
            conditional_remaining_work: mutable usize = 0
            if conditional_prior_work < PROOF_PURITY_WALK_WORK_LIMIT:
                conditional_remaining_work <- PROOF_PURITY_WALK_WORK_LIMIT - conditional_prior_work
            conditional_allowance: usize = min(conditional_remaining_work, PROOF_LINEAR_SAFETY_WORK_LIMIT)
            conditional_budget_start: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - conditional_allowance
            conditional_work: mutable usize = conditional_budget_start
            conditional_exhausted: mutable bool = false
            conditional: (known: bool, body: darray[Ast::Stmt]) = proof_split_conditional_value(body, functions, &conditional_work, &conditional_exhausted)
            conditional_work <- conditional_work - conditional_budget_start
            conditional_source_work: mutable ProofBlockPurityWork = ProofBlockPurityWork{used: conditional_prior_work, reported: report.analysis_1.budgets.return_source_reported, match_work_used: report.analysis_1.budgets.match_lowering_source_work}
            conditional_shared_work_ok: bool = proof_purity_work_charge(conditional_work, &conditional_source_work)
            report.analysis_1.budgets.return_source_work <- conditional_source_work.used
            report.analysis_1.budgets.return_source_reported <- conditional_source_work.reported
            report.analysis_1.budgets.match_lowering_source_work <- conditional_source_work.match_work_used
            if conditional_exhausted or not conditional_shared_work_ok:
                conditional_observed_work: usize = conditional_prior_work + conditional_work
                if conditional_exhausted:
                    if conditional_remaining_work < PROOF_LINEAR_SAFETY_WORK_LIMIT:
                        proof_purity_budget_finding(report, name, budget_line, "conditional-return-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &conditional_source_work)
                    else:
                        proof_purity_budget_finding(report, name, budget_line, "conditional-return-work", PROOF_LINEAR_SAFETY_WORK_LIMIT + 1, PROOF_LINEAR_SAFETY_WORK_LIMIT, &conditional_source_work)
                else:
                    proof_purity_budget_finding(report, name, budget_line, "conditional-return-source-work", conditional_observed_work, PROOF_PURITY_WALK_WORK_LIMIT, &conditional_source_work)
                report.analysis_1.budgets.return_source_work <- conditional_source_work.used
                report.analysis_1.budgets.return_source_reported <- conditional_source_work.reported
                flow.normal <- false
                flow.valid <- false
                report.proof_obligation(false)
                return
            if conditional.known:
                (proof_check_returns(conditional.body, names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, flow) can Global{Read,Write})
                return
            operator_work: mutable usize = 0
            for statement in body |names, values, facts, ensures, lemmas, functions, fixed_names, fixed_extents, report, name, lemma_steps, flow, operator_work|:
                # Once a path returns or transfers to a loop edge, later statements cannot
                # affect the state on that path. The compiler separately diagnoses unreachable
