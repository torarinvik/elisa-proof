extend ElisaProof:
    private:
        def proof_statement_lend_roots(expression: Ast::Expr, functions: ProofFunctionTable&) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            roots: mutable darray[sview] = []
            proof_collect_aliased_in_expression(expression, functions, &roots, false)
            return roots

        def proof_restore_call_stable_facts(source: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview, lends: darray[sview]) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            # What this call can reach: the lends that outlive their own call, together with the
            # ones this call itself performs. A caller that cannot name the expression passes the
            # whole aliased set, which leaves the union unchanged.
            blocked: mutable darray[sview] = []
            blocked.extend(report.escaping_names)
            for lent in lends |blocked|:
                proof_push_aliased(&blocked, lent)
            # Two kinds of term denote one value for the whole body although the stability walk
            # does not accept them: a qualified constant such as `Fade::FULL`, read from its
            # traced fact `PATH == literal`, and a fresh rebind symbol a literal call argument
            # was bound to, `__elisa_rebind_0 == 1000`. Source text can spell neither, and a
            # rebind symbol is never reissued within a body. The probe stands the literal in for
            # each; the original fact is what is kept.
            constant_paths: mutable darray[Ast::Expr] = []
            constant_values: mutable darray[Ast::Expr] = []
            for fact in source |constant_paths, constant_values, report, owner|:
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        symbol: sview = proof_ident_name(left)
                        constant_path: bool = symbol == "" and proof_fact_is_global_constant(report, fact, owner)
                        literal_symbol: mutable bool = false
                        if symbol != "" and proof_name_is_reserved_internal(symbol):
                            match right:
                                Ast::Expr.IntLit(_, _):
                                    literal_symbol <- true
                                _:
                                    pass
                        if constant_path or literal_symbol:
                            constant_paths.push(left)
                            constant_values.push(right)
                    _:
                        pass
            for fact in source |source, facts, names, parameters, report, blocked, constant_paths, constant_values|:
                # Most facts are stable as written; the rewrite copies the tree once per path, so
                # it runs only for a fact the plain walk refuses.
                stable: mutable bool = proof_expr_call_stable(fact, source, names, parameters, blocked, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                if not stable and constant_paths.count > 0:
                    probe: mutable Ast::Expr = fact
                    for path_index in 0..<constant_paths.count |path_index, probe, constant_paths, constant_values|:
                        replaced: (changed: bool, value: Ast::Expr) = proof_tactic_replace(probe, constant_paths[path_index], constant_values[path_index])
                        probe <- replaced.value if replaced.changed
                    stable <- proof_expr_call_stable(probe, source, names, parameters, blocked, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                continue if not stable
                continue if any existing in facts where proof_expr_equal(existing, fact)
                facts.push(fact)

        # Give a fresh opaque symbol only to the bindings a captured block can actually write.
        # The capture list is the block's whole reach, so an uncaptured binding keeps its symbolic
        # value — but only when that value is itself call-stable against the captured and aliased
        # names, otherwise a value recorded in terms of a binding the block does rewrite would
        # silently follow it. Without a usable alias set for this frame nothing is kept, which is
        # exactly the whole-state havoc this replaces.
        def proof_forget_captured_values(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: darray[Ast::Expr]&, captures: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview, position: Ast::Pos) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            if not analyzed or captures.count == 0:
                proof_forget_values(names, values, position)
                return
            blocked: mutable darray[sview] = []
            blocked.extend(report.aliased_names)
            blocked.extend(captures)
            for index in 0..<values.count |index, names, values, facts, parameters, blocked, position|:
                values[index] <- Ast::Expr.Invalid if index >= names.count
                continue if index >= names.count
                retained: bool = not (any name in blocked where name == names[index]) and proof_expr_call_stable(values[index], facts, names, parameters, blocked, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                values[index] <- Ast::Expr.Ident(names[index], position) if not retained

        # Give a fresh opaque symbol, at a call boundary, only to the bindings the callee can
        # reach. A callee reaches the caller's state through references and globals alone, so a
        # by-value scalar local that nothing in this body references keeps its recorded value --
        # but only when that value is itself call-stable against the aliased names, otherwise a
        # value recorded in terms of a binding the call does rewrite would silently follow it.
        # This is the same predicate the fact side of the boundary already applies, so a value
        # survives exactly where a fact over it would. Slots at or past `limit` are left alone
        # (a declaration's own new binding), and `keep` exempts the slot that receives the
        # call's result. Without a usable alias set for this frame nothing is kept, which is the
        # whole-state forget this replaces.
        def proof_forget_values_after_call(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: darray[Ast::Expr]&, parameters: darray[sview]&, report: ProofReport&, owner: sview, limit: usize, keep: usize, position: Ast::Pos) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            capped_limit: usize = limit if limit < values.count else values.count
            for index in 0..<capped_limit |index, names, values, facts, parameters, report, analyzed, keep, position|:
                continue if index == keep
                values[index] <- Ast::Expr.Invalid if index >= names.count
                continue if index >= names.count
                retained: bool = analyzed and not (any existing in report.aliased_names where existing == names[index]) and proof_expr_call_stable(values[index], facts, names, parameters, report.aliased_names, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                values[index] <- Ast::Expr.Ident(names[index], position) if not retained

        # Source-overloaded operators execute user code, but this proof state has no operator
        # effect summary. Refuse the enclosing function and havoc all mutable symbolic state
        # before any later obligation can consume facts from before the operator.
        def proof_invalidate_for_unmodeled_operator(expression: Ast::Expr, names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, position: Ast::Pos) -> bool:
            return false if not proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
            proof_forget_values(names, values, position)
            proof_clear_facts_keep_type_bounds(facts, names, parameters, report, owner)
            report.proof_obligation(false)
            proof_add_finding(report, "expression-unsupported", position.line, owner, "source-overloaded operator may mutate proof-visible state without a modeled effect summary")
            return true

        # The wrapper direction of the same shape: a captured block whose body is exactly one loop
        # statement. The source forms `for x in xs |captures|:` and `while c |captures|:` parse as
        # a block that carries the captures around the loop, so this is what a loop with a capture
        # list looks like in statement position. The loop inside is checked by the loop handler,
        # which models an arbitrary iteration and its own post-loop state exactly as it does for
        # the same loop written without a capture list, so the block around it introduces no
        # unmodeled step of its own.
        def proof_body_is_one_loop(body: darray[Ast::Stmt]&) -> bool:
            return false if body.count != 1
            match body[0]:
                Ast::Stmt.While(_, _, _):
                    return true
                Ast::Stmt.For(_, _, _, _, _):
                    return true
                _:
                    return false

        # The body of a loop statement when it is exactly one captured block, which is how the
        # source form `for x in xs |captures|:` and `while c |captures|:` arrive here.
        def proof_single_captured_block(body: darray[Ast::Stmt]&) -> (known: bool, body: darray[Ast::Stmt], captures: darray[sview], position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            empty: mutable darray[Ast::Stmt] = []
            empty_captures: mutable darray[sview] = []
            return (false, empty, empty_captures, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}) if body.count != 1
            return proof_captured_block_statement(body[0])

        def proof_replace_names(target: mutable darray[sview]&, source: darray[sview]&) -> void:
            target.clear()
            for entry in source |target|:
                target.push(entry)

        def proof_replace_exprs(target: mutable darray[Ast::Expr]&, source: darray[Ast::Expr]&) -> void:
            target.clear()
            for entry in source |target|:
                target.push(entry)

        def proof_copy_flow_into(target: mutable ProofFlow&, source: ProofFlow&) -> void:
            target.normal <- source.normal
            target.breaks <- source.breaks
            target.continues <- source.continues
            target.valid <- source.valid
            proof_clear_continue_states(target)
            proof_append_continue_states(target, source)

        # Re-establish, after a captured block in statement position, every fact the block could
        # not have falsified. The capture list is the block's whole reach: a binding it does not
        # name cannot be read or written inside it. Blocking the captured names alongside the
        # aliased ones reuses the call-stability rule unchanged, so a fact over an aliased or
        # unwitnessed binding is still refused and a captured reference cannot smuggle one back.
        def proof_restore_uncaptured_facts(source: darray[Ast::Expr]&, captures: darray[sview]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            return if captures.count == 0
            blocked: mutable darray[sview] = []
            blocked.extend(report.aliased_names)
            blocked.extend(captures)
            for fact in source |source, facts, names, parameters, blocked|:
                continue if not proof_expr_call_stable(fact, source, names, parameters, blocked, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                continue if any existing in facts where proof_expr_equal(existing, fact)
                facts.push(fact)

        # Re-establish, at a branch join, the recorded value of every binding whose value each
        # arm that reaches the join still carries, and that the reaching arms agree on. The arms
        # were executed symbolically, so a value standing at an arm's exit is the binding's value
        # on that path; a value both paths share is its value at the join, and when one arm alone
        # reaches the join its value is the whole state. An arm that introduced a binding of its
        # own is not imported from at all, and only a call-stable value is imported, so a value
        # recorded in terms of an arm-local, aliased or unwitnessed name cannot escape with it.
        def proof_restore_branch_values(values: mutable darray[Ast::Expr]&, names: darray[sview]&, then_values: darray[Ast::Expr]&, else_values: darray[Ast::Expr]&, then_reaches: bool, else_reaches: bool, limit: usize, facts: darray[Ast::Expr]&, parameters: darray[sview]&, report: ProofReport&, owner: sview) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            return if not then_reaches and not else_reaches
            capped: mutable usize = limit if limit < values.count else values.count
            capped <- names.count if names.count < capped
            capped <- then_values.count if then_reaches and then_values.count < capped
            capped <- else_values.count if else_reaches and else_values.count < capped
            for index in 0..<capped |index, values, names, then_values, else_values, then_reaches, else_reaches, facts, parameters, report|:
                candidate: Ast::Expr = then_values[index] if then_reaches else else_values[index]
                continue if then_reaches and else_reaches and not proof_expr_equal(then_values[index], else_values[index])
                continue if not proof_expr_call_stable(candidate, facts, names, parameters, report.aliased_names, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                values[index] <- candidate

        # Re-establish, at a branch join both arms reach, every fact that both arms still hold.
        # A fact standing at an arm's exit is true on that path, so one held on both paths is
        # true at the join. Only call-stable facts are imported, so an arm-local binding can
        # never escape with them, and an arm that assigns to a scalar has already purged the
        # facts over it, so a direct write inside the branch cannot survive here either.
        # When neither arm makes a call, nothing outside the arms' own statements ran, so a fact
        # that held before the branch and still stands at both exits needs no call-stability:
        # `k < xs.count` over a mutable reference survives `if xs[k] < p: lo <- lo + 1`. Being a
        # prior fact, it cannot read an arm-local binding.
        def proof_restore_branch_stable_facts(primary: darray[Ast::Expr]&, secondary: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview, prior: darray[Ast::Expr]&, arms_call_free: bool) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            for fact in primary |primary, secondary, facts, names, parameters, report, prior, arms_call_free|:
                continue if not (any other in secondary where proof_expr_equal(other, fact))
                held_before: bool = arms_call_free and (any earlier in prior where proof_expr_equal(earlier, fact))
                continue if not held_before and not proof_expr_call_stable(fact, primary, names, parameters, report.aliased_names, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                continue if any existing in facts where proof_expr_equal(existing, fact)
                facts.push(fact)

        # The facts of an arm that still read the same at the join. A binding the join forgot is
        # a fresh atom under its own name, so an arm fact over that name speaks of the joined value
        # only when the arm itself recorded the binding as that very atom. An arm that rebound it
        # to a fresh symbol, as `b <- b + 1` does, keeps `b` for the old value, and its facts over
        # `b` must not cross the join.
        def proof_join_reads(source: darray[Ast::Expr]&, values: darray[Ast::Expr]&, names: darray[sview]&, arm_values: darray[Ast::Expr]&, limit: usize) -> darray[Ast::Expr]:
            stale: mutable darray[sview] = []
            for index in 0..<names.count |index, values, names, arm_values, limit, stale|:
                continue if index >= limit or index >= values.count or proof_ident_name(values[index]) != names[index]
                stale.push(names[index]) if index >= arm_values.count or proof_ident_name(arm_values[index]) != names[index]
            kept: mutable darray[Ast::Expr] = []
            for fact in source |stale, kept|:
                kept.push(fact) if not (any name in stale where proof_expr_mentions_name(fact, name))
            return kept

        # Re-establish, at a join both arms reach, a fact that one arm states and the other arm
        # implies. A binding the join forgot is a fresh atom under its own name; on each path it
        # equals that arm's recorded value, so a candidate holds at the join when each arm proves
        # it with the forgotten names replaced by the arm's values. That holds even when both arms
        # record the same `b`: each arm reads its atoms in its own state, and on either path the
        # joined atom is that arm's value. A name the join kept keeps its atom and is not replaced.
        # A fact both arms state and read unchanged is left to the literal intersection, which bounds the search. `if flag: best <- slot` thus keeps `best <= CAP`: the
        # untouched arm states it and the other derives it from `best == slot` and `slot < CAP`.
        def proof_restore_branch_implied_facts(then_facts: mutable darray[Ast::Expr]&, else_facts: mutable darray[Ast::Expr]&, prior_facts: darray[Ast::Expr]&, then_names: darray[sview]&, else_names: darray[sview]&, then_values: darray[Ast::Expr]&, else_values: darray[Ast::Expr]&, values: darray[Ast::Expr]&, names: darray[sview]&, limit: usize, facts: mutable darray[Ast::Expr]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos, arms_call_free: bool) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            capped: mutable usize = limit if limit < values.count else values.count
            capped <- names.count if names.count < capped
            capped <- then_values.count if then_values.count < capped
            capped <- else_values.count if else_values.count < capped
            then_map: mutable darray[Ast::Expr] = []
            else_map: mutable darray[Ast::Expr] = []
            joined: mutable darray[sview] = []
            for index in 0..<names.count |index, names, values, then_values, else_values, capped, then_map, else_map, joined, position|:
                forgotten: bool = index < capped and proof_ident_name(values[index]) == names[index]
                then_map.push(then_values[index] if forgotten else Ast::Expr.Ident(names[index], position))
                else_map.push(else_values[index] if forgotten else Ast::Expr.Ident(names[index], position))
                joined.push(names[index]) if forgotten
            return if joined.count == 0
            candidates: mutable darray[Ast::Expr] = []
            candidates.extend(then_facts)
            candidates.extend(else_facts)
            # A fact that held before the branch, a loop invariant such as `cursor <= stop`
            # among them, is a candidate too, when both arms rebound a name it reads.
            candidates.extend(prior_facts)
            # An arm that steps a joined name by one leaves `L <= R` true only one step wider:
            # `if take: lo <- lo + 1` turns the invariant `lo <= k` into `lo <= k + 1`, which the
            # loop's later `k <- k + 1` closes. Each widening is still proved in both arms below.
            proof_push_widened_facts(&candidates, prior_facts, joined, position)
            # An arm that records a joined name as some other expression, `b: usize = best`,
            # states its facts over that expression; read them back over the name as well.
            for index in 0..<then_map.count |index, names, then_map, else_map, joined, then_facts, else_facts, candidates|:
                continue if not (any name in joined where name == names[index])
                proof_push_renamed_facts(&candidates, then_facts, then_map[index], names[index]) if proof_ident_name(then_map[index]) != names[index]
                proof_push_renamed_facts(&candidates, else_facts, else_map[index], names[index]) if proof_ident_name(else_map[index]) != names[index]
                proof_push_equal_renamings(&candidates, then_facts, names[index])
                proof_push_equal_renamings(&candidates, else_facts, names[index])
            accepted: mutable darray[Ast::Expr] = []
            then_steps: mutable darray[Ast::Expr] = []
            else_steps: mutable darray[Ast::Expr] = []
            for fact in candidates |candidates, then_facts, else_facts, facts, names, parameters, report, annotations, then_map, else_map, joined, accepted, then_steps, else_steps, prior_facts, arms_call_free|:
                continue if not (any name in joined where proof_expr_mentions_name(fact, name))
                # A local an arm declared ends with the arm, so only its steps may read one.
                continue if proof_expr_mentions_arm_local(fact, then_names, names.count) or proof_expr_mentions_arm_local(fact, else_names, names.count)
                continue if any existing in facts where proof_expr_equal(existing, fact)
                continue if any existing in accepted where proof_expr_equal(existing, fact)
                # As at the literal intersection, call-free arms need no call-stability for a
                # candidate that held before the branch, `forall i in 0..<lo: xs[i] < p` among them.
                held_before: bool = arms_call_free and (any earlier in prior_facts where proof_expr_equal(earlier, fact))
                # Call-free arms run nothing but their own statements, and each arm proves the
                # candidate below, so neither a prior fact nor an arm's own needs call-stability.
                continue if not held_before and not arms_call_free and not proof_expr_call_stable(fact, candidates, names, parameters, report.aliased_names, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                then_step: Ast::Expr = proof_substitute(fact, names, then_map)
                else_step: Ast::Expr = proof_substitute(fact, names, else_map)
                # Both arms stating the fact leave it to the literal intersection only when both
                # read it unchanged. An arm that rebound a name, `cursor <- cursor + 1`, states it
                # over the old value; the intersection drops that reading, so it is decided here.
                # The intersection takes only a prior or call-stable fact; any other is decided here.
                intersected: bool = held_before or proof_expr_call_stable(fact, candidates, names, parameters, report.aliased_names, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, 0)
                continue if intersected and proof_expr_equal(then_step, fact) and proof_expr_equal(else_step, fact) and (any other in then_facts where proof_expr_equal(other, fact)) and (any other in else_facts where proof_expr_equal(other, fact))
                # The joined fact is recorded through an arm whose own reading is the fact itself,
                # so its trace is that arm's kernel-checked step.
                continue if not proof_expr_equal(then_step, fact) and not proof_expr_equal(else_step, fact)
                continue if not proof_goal(then_facts, then_step, annotations)
                continue if not proof_goal(else_facts, else_step, annotations)
                accepted.push(fact)
                then_steps.push(then_step)
                else_steps.push(else_step)
            for index in 0..<accepted.count |index, accepted, then_steps, else_steps, then_facts, else_facts, facts, report, owner, position|:
                proof_add_derived_fact(then_facts, report, then_steps[index], "branch-join", position.line, owner) if not (any existing in then_facts where proof_expr_equal(existing, then_steps[index]))
                proof_add_derived_fact(else_facts, report, else_steps[index], "branch-join", position.line, owner) if not (any existing in else_facts where proof_expr_equal(existing, else_steps[index]))
                then_held: bool = any existing in then_facts where proof_expr_equal(existing, then_steps[index])
                else_held: bool = any existing in else_facts where proof_expr_equal(existing, else_steps[index])
                facts.push(accepted[index]) if then_held and else_held

        # An arm's names are the outer ones followed by the locals it declared. Its state joins
        # the outer one only when no local shadows an outer name, which would make a fact over
        # that name ambiguous.
        def proof_arm_names_extend(arm_names: darray[sview]&, names: darray[sview]&) -> bool:
            return false if arm_names.count < names.count
            for index in 0..<arm_names.count |index, arm_names, names|:
                if index < names.count:
                    return false if arm_names[index] != names[index]
                else:
                    return false if any name in names where name == arm_names[index]
            true

        def proof_expr_mentions_arm_local(fact: Ast::Expr, arm_names: darray[sview]&, outer_count: usize) -> bool:
            for index in outer_count..<arm_names.count |index, fact, arm_names|:
                return true if proof_expr_mentions_name(fact, arm_names[index])
            false

        def proof_push_renamed_facts(candidates: mutable darray[Ast::Expr]&, source: darray[Ast::Expr]&, value: Ast::Expr, name: sview) -> void:
            alias: Ast::Expr = Ast::Expr.Ident(name, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})
            for fact in source |candidates, value, alias|:
                renamed: (changed: bool, value: Ast::Expr) = proof_replace_place(fact, value, alias, 0)
                candidates.push(renamed.value) if renamed.changed

        def proof_push_widened_facts(candidates: mutable darray[Ast::Expr]&, source: darray[Ast::Expr]&, joined: darray[sview]&, position: Ast::Pos) -> void:
            for fact in source |candidates, joined, position|:
                match fact:
                    Ast::Expr.Binary(left, operator, right, _):
                        continue if operator != TokenKind.LtEq and operator != TokenKind.Lt
                        continue if not (any name in joined where proof_expr_mentions_name(left, name))
                        wider: Ast::Expr = Ast::Expr.Binary(right, TokenKind.Plus, Ast::Expr.IntLit(1, position), position)
                        candidates.push(Ast::Expr.Binary(left, TokenKind.LtEq, wider, position)) if operator == TokenKind.LtEq
                    Ast::Expr.Block(_, body, _, _):
                        # A range grows by one the same way: a bubble step turns the invariant
                        # `forall i in 0..<k: xs[i] <= m` into `... 0..<k + 1 ...` before `k <- k + 1`.
                        range: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(fact)
                        continue if not range.known
                        continue if not (any name in joined where proof_expr_mentions_name(body, name) or proof_expr_mentions_name(range.lower, name) or proof_expr_mentions_name(range.upper, name))
                        grown: (known: bool, value: Ast::Expr) = proof_widened_forall(fact, position)
                        candidates.push(grown.value) if grown.known
                    _:
                        continue

        # `forall i in a..<b: P` as `forall i in a..<b + 1: P`, keeping the binder's declaration.
        def proof_widened_forall(fact: Ast::Expr, position: Ast::Pos) -> (known: bool, value: Ast::Expr):
            range: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(fact)
            return (false, Ast::Expr.Invalid) if not range.known
            wider: Ast::Expr = Ast::Expr.Binary(range.lower, TokenKind.RangeLt, Ast::Expr.Binary(range.upper, TokenKind.Plus, Ast::Expr.IntLit(1, position), position), position)
            match fact:
                Ast::Expr.Block(statements, body, captures, block_position):
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, type_expression, _, statement_position):
                            grown: mutable darray[Ast::Stmt] = []
                            grown.push(Ast::Stmt.VarDecl(binder, type_expression, wider, statement_position))
                            return (true, Ast::Expr.Block(grown, body, captures, block_position))
                        _:
                            return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        # A binding recorded as `b == best` states the arm's other facts over `best`.
        def proof_push_equal_renamings(candidates: mutable darray[Ast::Expr]&, source: darray[Ast::Expr]&, name: sview) -> void:
            for fact in source |candidates, source, name|:
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        proof_push_renamed_facts(candidates, source, right, name) if proof_ident_name(left) == name and not proof_expr_mentions_name(right, name)
                    _:
                        continue

        # Havoc for an opaque call. Type bounds are kept as at every havoc point; in addition a
        # fact that is call-stable for the current function is kept. The alias set must belong
        # to this very owner, otherwise nothing but type bounds survives.
