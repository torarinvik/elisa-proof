extend ElisaProof:
    private:
        def proof_restore_call_stable_facts(source: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, lends: darray[sview]) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            # What this call can reach: the lends that outlive their own call, together with the
            # ones this call itself performs. A caller that cannot name the expression passes the
            # whole aliased set, which leaves the union unchanged.
            blocked: mutable darray[sview] = []
            blocked.extend(report.escaping_names)
            for lent in lends |blocked|:
                proof_push_aliased(&blocked, lent)
            # Terms whose source spelling the stability walk cannot resolve can still denote a
            # fixed value: a qualified constant backed by its source trace; a fresh rebind symbol
            # bound to a literal; or a compiler rebind symbol explicitly bound to a live local by
            # a local-binding trace. For the last case, the normal stability walk on that local
            # decides whether the call can reach it. These substitutions are probes only; the
            # original, independently traced fact is what is kept.
            constant_paths: mutable darray[Ast::Expr] = []
            constant_values: mutable darray[Ast::Expr] = []
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            for fact in source |constant_paths, constant_values, report, owner, source_work|:
                if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    report.source_effect_index.implicit_effect_work <- source_work
                    return
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        symbol: sview = proof_ident_name(left)
                        constant_path: bool = false
                        if symbol == "":
                            constant_path <- proof_fact_is_global_constant_with_work(report, fact, owner, &source_work)
                            if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                report.source_effect_index.implicit_effect_work <- source_work
                                return
                        literal_symbol: mutable bool = false
                        if symbol != "" and proof_name_is_reserved_internal(symbol):
                            match right:
                                Ast::Expr.IntLit(_, _):
                                    literal_symbol <- true
                                _:
                                    pass
                        if constant_path or literal_symbol:
                            constant_paths.push(left)
                            constant_values.push(right)
                        binding: (complete: bool, known: bool, path: Ast::Expr, value: Ast::Expr) = proof_local_rebind_binding_with_work(report, fact, owner, names, &source_work)
                        if not binding.complete:
                            report.source_effect_index.implicit_effect_work <- source_work
                            return
                        if binding.known:
                            constant_paths.push(binding.path)
                            constant_values.push(binding.value)
                    _:
                        pass
            report.source_effect_index.implicit_effect_work <- source_work
            for fact in source |source, facts, names, parameters, report, blocked, constant_paths, constant_values, source_work|:
                if not proof_replay_summary_expr_repeat_charge_with_work(fact, constant_paths.count + 2, &source_work):
                    facts.clear()
                    report.source_effect_index.implicit_effect_work <- source_work
                    return
                for path_index in 0..<constant_paths.count |path_index, constant_paths, constant_values, source_work|:
                    if not proof_replay_summary_expr_repeat_charge_with_work(constant_paths[path_index], 1, &source_work) or not proof_replay_summary_expr_repeat_charge_with_work(constant_values[path_index], 1, &source_work):
                        facts.clear()
                        report.source_effect_index.implicit_effect_work <- source_work
                        return
                # Most facts are stable as written; the rewrite copies the tree once per path, so
                # it runs only for a fact the plain walk refuses.
                stability: (complete: bool, stable: bool) = proof_expr_call_stable_with_work(fact, source, names, parameters, blocked, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, report, owner, 0, &source_work)
                if not stability.complete:
                    facts.clear()
                    report.source_effect_index.implicit_effect_work <- source_work
                    return
                stable: mutable bool = stability.stable
                if not stable and constant_paths.count > 0:
                    probe: mutable Ast::Expr = fact
                    for path_index in 0..<constant_paths.count |path_index, probe, constant_paths, constant_values|:
                        replaced: (changed: bool, value: Ast::Expr) = proof_tactic_replace(probe, constant_paths[path_index], constant_values[path_index])
                        probe <- replaced.value if replaced.changed
                    probe_stability: (complete: bool, stable: bool) = proof_expr_call_stable_with_work(probe, source, names, parameters, blocked, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, report, owner, 0, &source_work)
                    if not probe_stability.complete:
                        facts.clear()
                        report.source_effect_index.implicit_effect_work <- source_work
                        return
                    stable <- probe_stability.stable
                continue if not stable
                if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    facts.clear()
                    report.source_effect_index.implicit_effect_work <- source_work
                    return
                duplicate: mutable bool = false
                for existing in facts |existing, fact, duplicate, source_work, facts|:
                    if not proof_replay_summary_expr_repeat_charge_with_work(existing, 4, &source_work):
                        facts.clear()
                        report.source_effect_index.implicit_effect_work <- source_work
                        return
                    duplicate <- true if proof_expr_equal(existing, fact)
                continue if duplicate
                facts.push(fact)
            report.source_effect_index.implicit_effect_work <- source_work

        # Give a fresh opaque symbol only to the bindings a captured block can actually write.
        # The capture list is the block's whole reach, so an uncaptured binding keeps its symbolic
        # value — but only when that value is itself call-stable against the captured and aliased
        # names, otherwise a value recorded in terms of a binding the block does rewrite would
        # silently follow it. Without a usable alias set for this frame nothing is kept, which is
        # exactly the whole-state havoc this replaces.
        def proof_forget_captured_values(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: darray[Ast::Expr]&, captures: darray[sview]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, position: Ast::Pos) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            if not analyzed or captures.count == 0:
                proof_forget_values(names, values, position)
                return
            blocked: mutable darray[sview] = []
            blocked.extend(report.aliased_names)
            blocked.extend(captures)
            for index in 0..<values.count |index, names, values, facts, parameters, blocked, position|:
                values[index] <- Ast::Expr.Invalid if index >= names.count
                continue if index >= names.count
                retained: bool = not (any name in blocked where name == names[index]) and proof_expr_call_stable(values[index], facts, names, parameters, blocked, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, report, owner, 0)
                if not retained:
                    match values[index]:
                        Ast::Expr.Invalid:
                            pass
                        Ast::Expr.RecordUpdate(_, _, _):
                            values[index] <- Ast::Expr.Invalid
                        Ast::Expr.Ident(symbol, _):
                            # A local the call or block may rewrite whose value is a rebind symbol has had
                            # its own name's facts outlived: those describe the value before the
                            # update. Refuse the binding rather than fall back to that name.
                            values[index] <- Ast::Expr.Invalid if proof_internal_name_is_rebind(symbol)
                            values[index] <- Ast::Expr.Ident(names[index], position) if not proof_internal_name_is_rebind(symbol)
                        _:
                            values[index] <- Ast::Expr.Ident(names[index], position)

        # Give a fresh opaque symbol, at a call boundary, only to the bindings the callee can
        # reach. A callee reaches the caller's state through references and globals alone, so a
        # by-value scalar local that nothing in this body references keeps its recorded value --
        # but only when that value is itself call-stable against the aliased names, otherwise a
        # value recorded in terms of a binding the call does rewrite would silently follow it.
        # This is the same predicate the fact side of the boundary already applies, so a value
        # survives exactly where a fact over it would. Slots at or past `limit` are left alone
        # (a declaration's own new binding), and `keep` exempts the slot that receives the
        # call's result. Without a usable alias set for this frame nothing is kept, which is the
        # whole-state forget this replaces.
        def proof_forget_values_after_call_with_aliases(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: darray[Ast::Expr]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, limit: usize, keep: usize, position: Ast::Pos, extra_may_alias: darray[sview]&) -> void:
            proof_record_opaque_call_alias_roots(report, owner, extra_may_alias)
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            call_aliases: mutable darray[sview] = []
            call_aliases.extend(report.aliased_names)
            for root in extra_may_alias |call_aliases|:
                proof_push_aliased(&call_aliases, root)
            capped_limit: usize = limit if limit < values.count else values.count
            for index in 0..<capped_limit |index, names, values, facts, parameters, report, analyzed, keep, position, call_aliases|:
                continue if index == keep
                values[index] <- Ast::Expr.Invalid if index >= names.count
                continue if index >= names.count
                retained: bool = analyzed and not (any existing in call_aliases where existing == names[index]) and proof_expr_call_stable(values[index], facts, names, parameters, call_aliases, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, report, owner, 0)
                if not retained:
                    match values[index]:
                        Ast::Expr.Invalid:
                            pass
                        Ast::Expr.RecordUpdate(_, _, _):
                            values[index] <- Ast::Expr.Invalid
                        Ast::Expr.Ident(symbol, _):
                            # A local the call or block may rewrite whose value is a rebind symbol has had
                            # its own name's facts outlived: those describe the value before the
                            # update. Refuse the binding rather than fall back to that name.
                            values[index] <- Ast::Expr.Invalid if proof_internal_name_is_rebind(symbol)
                            values[index] <- Ast::Expr.Ident(names[index], position) if not proof_internal_name_is_rebind(symbol)
                        _:
                            values[index] <- Ast::Expr.Ident(names[index], position)

        def proof_forget_values_after_call(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: darray[Ast::Expr]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, limit: usize, keep: usize, position: Ast::Pos) -> void:
            no_extra_aliases: darray[sview] = []
            proof_forget_values_after_call_with_aliases(names, values, facts, parameters, report, owner, limit, keep, position, no_extra_aliases)
        # Source-overloaded operators execute user code, but this proof state has no operator
        # effect summary. Refuse the enclosing function and havoc all mutable symbolic state
        # before any later obligation can consume facts from before the operator.
        def proof_invalidate_for_unmodeled_operator(expression: Ast::Expr, names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, position: Ast::Pos) -> bool:
            return false if not proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
            proof_forget_values(names, values, position)
            proof_clear_facts_keep_type_bounds(facts, names, parameters, report, owner)
            report.proof_obligation(false)
            proof_add_finding(report, "expression-unsupported", position.line, owner, "source-overloaded operator may mutate proof-visible state without a modeled effect summary")
            return true

        # The body is checked against a separate one-iteration state, so its changed roots do
        # not appear as RecordUpdates in the outer post-loop state. Invalidate every mutable
        # reference parameter the body can reach before reusing that state after the loop.
        def proof_forget_loop_mutated_reference_parameters(names: darray[sview]&, values: mutable darray[Ast::Expr]&, body: darray[Ast::Stmt]&, functions: mutable ProofFunctionTable&, parameters: darray[sview]&, owner: sview, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&) -> void:
            written: mutable darray[sview] = []
            proof_collect_aliased_names(body, functions, &written, false, names)
            proof_collect_assignment_roots(body, &written)
            return if written.count == 0
            for index in 0..<values.count |index, names, values, body, functions, parameters, owner, written|:
                continue if index >= names.count
                root: sview = names[index]
                continue if not proof_current_parameter(names, parameters, root)
                continue if not proof_mutable_reference_parameter(owner, root, functions)
                # The caller discards mutable value facts separately. A declared
                # fixed array's identity/extent is not an element-value fact.
                current: Ast::Expr = Ast::Expr.Ident(root, Ast::pos_at_line(0))
                if proof_fixed_array_extent_for_object(current, fixed_names, fixed_extents) >= 0:
                    values[index] <- current
                    continue
                values[index] <- Ast::Expr.Invalid if any target in written where target == "*" or target == root

        # The wrapper direction of the same shape: a captured block whose body is exactly one loop
        # statement. The source forms `for x in xs |captures|:` and `while c |captures|:` parse as
        # a block that carries the captures around the loop, so this is what a loop with a capture
        # list looks like in statement position. The loop inside is checked by the loop handler,
        # which models an arbitrary iteration and its own post-loop state exactly as it does for
        # the same loop written without a capture list, so the block around it introduces no
        # unmodeled step of its own.
        def proof_body_is_one_loop(body: darray[Ast::Stmt]&) -> bool:
            return false if body.count != 1
            match body[0]:
                Ast::Stmt.While(_, _, _):
                    return true
                Ast::Stmt.For(_, _, _, _, _):
                    return true
                _:
                    return false

        # The body of a loop statement when it is exactly one captured block, which is how the
        # source form `for x in xs |captures|:` and `while c |captures|:` arrive here.
        def proof_single_captured_block(body: darray[Ast::Stmt]&) -> (known: bool, body: darray[Ast::Stmt], captures: darray[sview], position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            empty: mutable darray[Ast::Stmt] = []
            empty_captures: mutable darray[sview] = []
            return (false, empty, empty_captures, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}) if body.count != 1
            return proof_captured_block_statement(body[0])

        def proof_replace_names(target: mutable darray[sview]&, source: darray[sview]&) -> void:
            target.clear()
            for entry in source |target|:
                target.push(entry)

        def proof_replace_exprs(target: mutable darray[Ast::Expr]&, source: darray[Ast::Expr]&) -> void:
            target.clear()
            for entry in source |target|:
                target.push(entry)

        def proof_copy_flow_into(target: mutable ProofFlow&, source: ProofFlow&) -> void:
            target.normal <- source.normal
            target.breaks <- source.breaks
            target.continues <- source.continues
            target.valid <- source.valid
            proof_clear_continue_states(target)
            proof_append_continue_states(target, source)

        # Re-establish, after a captured block in statement position, every fact the block could
        # not have falsified. The capture list is the block's whole reach: a binding it does not
        # name cannot be read or written inside it. Blocking the captured names alongside the
        # aliased ones reuses the call-stability rule unchanged, so a fact over an aliased or
        # unwitnessed binding is still refused and a captured reference cannot smuggle one back.
        def proof_restore_uncaptured_facts(source: darray[Ast::Expr]&, captures: darray[sview]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            return if captures.count == 0
            blocked: mutable darray[sview] = []
            blocked.extend(report.aliased_names)
            blocked.extend(captures)
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            for fact in source |source, facts, names, parameters, blocked, source_work, report, owner|:
                stability: (complete: bool, stable: bool) = proof_expr_call_stable_with_work(fact, source, names, parameters, blocked, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, report, owner, 0, &source_work)
                if not stability.complete:
                    report.source_effect_index.implicit_effect_work <- source_work
                    return
                continue if not stability.stable
                duplicate: mutable bool = false
                for existing in facts |existing, fact, duplicate, source_work, facts|:
                    duplicate <- proof_replay_summary_expr_equal_with_limit(existing, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not duplicate
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.source_effect_index.implicit_effect_work <- source_work
                        return
                continue if duplicate
                facts.push(fact)
            report.source_effect_index.implicit_effect_work <- source_work

        # Re-establish, at a branch join, the recorded value of every binding whose value each
        # arm that reaches the join still carries, and that the reaching arms agree on. The arms
        # were executed symbolically, so a value standing at an arm's exit is the binding's value
        # on that path; a value both paths share is its value at the join, and when one arm alone
        # reaches the join its value is the whole state. An arm that introduced a binding of its
        # own is not imported from at all, and only a call-stable value is imported, so a value
        # recorded in terms of an arm-local, aliased or unwitnessed name cannot escape with it.
        def proof_restore_branch_values(values: mutable darray[Ast::Expr]&, names: darray[sview]&, then_values: darray[Ast::Expr]&, else_values: darray[Ast::Expr]&, then_reaches: bool, else_reaches: bool, limit: usize, facts: darray[Ast::Expr]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            return if not then_reaches and not else_reaches
            capped: mutable usize = limit if limit < values.count else values.count
            capped <- names.count if names.count < capped
            capped <- then_values.count if then_reaches and then_values.count < capped
            capped <- else_values.count if else_reaches and else_values.count < capped
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            for index in 0..<capped |index, values, names, then_values, else_values, then_reaches, else_reaches, facts, parameters, report, source_work, owner|:
                candidate: Ast::Expr = then_values[index] if then_reaches else else_values[index]
                branches_equal: mutable bool = true
                if then_reaches and else_reaches:
                    branches_equal <- proof_replay_summary_expr_equal_with_limit(then_values[index], else_values[index], source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        values[index] <- Ast::Expr.Invalid
                        report.source_effect_index.implicit_effect_work <- source_work
                        return
                if then_reaches and else_reaches and not branches_equal:
                    # A parameter root is the same source-level place before and after a
                    # mutation. Keeping its old identifier when the arms disagree would make
                    # `field == old(field)` reflexive even when one arm wrote that field.
                    # Lose the root's post-state at the join; only equal branch states survive.
                    values[index] <- Ast::Expr.Invalid if index < names.count and (any parameter in parameters where parameter == names[index])
                    continue
                stability: (complete: bool, stable: bool) = proof_expr_call_stable_with_work(candidate, facts, names, parameters, report.aliased_names, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, report, owner, 0, &source_work)
                if not stability.complete:
                    values[index] <- Ast::Expr.Invalid
                    report.source_effect_index.implicit_effect_work <- source_work
                    return
                continue if not stability.stable
                values[index] <- candidate
            report.source_effect_index.implicit_effect_work <- source_work

        # Re-establish, at a branch join both arms reach, every fact that both arms still hold.
        # A fact standing at an arm's exit is true on that path, so one held on both paths is
        # true at the join. Only call-stable facts are imported, so an arm-local binding can
        # never escape with them, and an arm that assigns to a scalar has already purged the
        # facts over it, so a direct write inside the branch cannot survive here either.
        # When neither arm makes a call, nothing outside the arms' own statements ran, so a fact
        # that held before the branch and still stands at both exits needs no call-stability:
        # `k < xs.count` over a mutable reference survives `if xs[k] < p: lo <- lo + 1`. Being a
        # prior fact, it cannot read an arm-local binding.
        def proof_restore_branch_stable_facts(primary: darray[Ast::Expr]&, secondary: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, prior: darray[Ast::Expr]&, arms_call_free: bool) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            for fact in primary |primary, secondary, facts, names, parameters, report, prior, arms_call_free, source_work, owner|:
                shared: mutable bool = false
                for other in secondary |other, fact, shared, source_work|:
                    shared <- proof_replay_summary_expr_equal_with_limit(other, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not shared
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.source_effect_index.implicit_effect_work <- source_work
                        return
                    break if shared
                continue if not shared
                held_before: mutable bool = false
                if arms_call_free:
                    for earlier in prior |earlier, fact, held_before, source_work|:
                        held_before <- proof_replay_summary_expr_equal_with_limit(earlier, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not held_before
                        if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            report.source_effect_index.implicit_effect_work <- source_work
                            return
                        break if held_before
                if not held_before:
                    stability: (complete: bool, stable: bool) = proof_expr_call_stable_with_work(fact, primary, names, parameters, report.aliased_names, report.shared_extent_names, report.shared_fixed_names, report.local_extent_names, report, owner, 0, &source_work)
                    if not stability.complete:
                        report.source_effect_index.implicit_effect_work <- source_work
                        return
                    continue if not stability.stable
                duplicate: mutable bool = false
                for existing in facts |existing, fact, duplicate, source_work|:
                    duplicate <- proof_replay_summary_expr_equal_with_limit(existing, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not duplicate
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.source_effect_index.implicit_effect_work <- source_work
                        return
                    break if duplicate
                continue if duplicate
                facts.push(fact)
            report.source_effect_index.implicit_effect_work <- source_work

        # The facts of an arm that still read the same at the join. A binding the join forgot is
        # a fresh atom under its own name, so an arm fact over that name speaks of the joined value
        # only when the arm itself recorded the binding as that very atom. An arm that rebound it
        # to a fresh symbol, as `b <- b + 1` does, keeps `b` for the old value, and its facts over
        # `b` must not cross the join.
