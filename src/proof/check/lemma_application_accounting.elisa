extend ElisaProof:
    private:
        def proof_block_lemma_budget_charge(amount: usize, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            return true if proof_purity_work_charge(amount, work)
            proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
            return false

        def proof_block_lemma_budget_estimate(amount: usize, repetitions: usize, reserved: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            return true if repetitions == 0 or amount == 0
            return false if work.used > PROOF_PURITY_WALK_WORK_LIMIT or reserved > PROOF_PURITY_WALK_WORK_LIMIT - work.used
            remaining: usize = PROOF_PURITY_WALK_WORK_LIMIT - work.used - reserved
            if amount > remaining / repetitions:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            reserved <- reserved + amount * repetitions
            return true

        def proof_block_lemma_source_cost(expression: Ast::Expr, group_cost: mutable usize&, total_cost: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            cost: mutable usize = 0
            remaining: usize = PROOF_PURITY_WALK_WORK_LIMIT - work.used if work.used <= PROOF_PURITY_WALK_WORK_LIMIT else 0
            scan_limit: mutable usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            scan_limit <- remaining if remaining < scan_limit
            if not proof_replay_summary_expr_cost_with_limit(expression, &cost, 0, scan_limit):
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            if not proof_block_lemma_budget_charge(cost, work, report, name, line):
                return false
            if cost > PROOF_PURITY_WALK_WORK_LIMIT - group_cost or cost > PROOF_PURITY_WALK_WORK_LIMIT - total_cost:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            group_cost <- group_cost + cost
            total_cost <- total_cost + cost
            return true

        def proof_block_lemma_resolver_volume(source_cost: usize, mapped_value_cost: usize, repetitions: usize, total: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            return true if repetitions == 0 or source_cost == 0
            if mapped_value_cost >= PROOF_PURITY_WALK_WORK_LIMIT or source_cost > PROOF_PURITY_WALK_WORK_LIMIT / (mapped_value_cost + 1):
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            expanded_cost: usize = source_cost * (mapped_value_cost + 1)
            if expanded_cost > PROOF_PURITY_WALK_WORK_LIMIT / repetitions:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            volume: usize = expanded_cost * repetitions
            if total > PROOF_PURITY_WALK_WORK_LIMIT - volume:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            total <- total + volume
            return true
