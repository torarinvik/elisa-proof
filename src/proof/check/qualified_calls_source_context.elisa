# Exact source-position recovery helpers factored from qualified_calls.elisa.
extend ElisaProof:
    private:
        def proof_function_enum_source_context_scan(declarations: darray[Ast::Decl]&, module_scope: mutable darray[sview]&, function_name: sview, declaration_line: u32, declaration_offset: u32, functions: mutable ProofFunctionTable&, found_declarations: mutable darray[Ast::Decl]&, found_scope: mutable darray[sview]&, matches: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT:
                functions.lookup.module_resolution_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                functions.lookup.module_resolution_work_exhausted <- true
                return false
            for declaration in declarations |declaration, module_scope, function_name, declaration_line, declaration_offset, functions, found_declarations, found_scope, matches, depth|:
                return false if not proof_qualify_enum_source_work_charge(functions, 1)
                match declaration:
                    Ast::Decl.Module(module_name, nested, _):
                        previous_count: usize = module_scope.count
                        return false if not proof_qualify_enum_source_work_charge(functions, sview_len(module_name)) or not proof_qualify_enum_source_work_charge(functions, module_scope.count)
                        module_scope <- proof_global_constant_scope_with_module(module_scope, module_name)
                        nested_complete: bool = proof_function_enum_source_context_scan(nested, module_scope, function_name, declaration_line, declaration_offset, functions, found_declarations, found_scope, matches, depth + 1)
                        module_scope.truncate(previous_count)
                        return false if not nested_complete
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_function_enum_source_context_scan(nested, module_scope, function_name, declaration_line, declaration_offset, functions, found_declarations, found_scope, matches, depth + 1)
                    Ast::Decl.Func(name, _, _, _, _, _, position):
                        return false if not proof_qualify_enum_source_work_charge(functions, sview_len(name)) or not proof_qualify_enum_source_work_charge(functions, sview_len(function_name))
                        if name == function_name and position.line == declaration_line and position.offset == declaration_offset:
                            matches <- matches + 1
                            if matches == 1:
                                found_declarations <- declarations
                                found_scope.clear()
                                found_scope.extend(module_scope)
                    _:
                        pass
            return true

        def proof_function_enum_module_scope_matches_owner(module_scope: darray[sview]&, owner_module: sview, functions: mutable ProofFunctionTable&) -> bool:
            return false if not proof_qualify_enum_source_work_charge(functions, sview_len(owner_module))
            owner_parts: mutable darray[sview] = []
            start: mutable usize = 0
            offset: mutable usize = 0
            while offset + 1 < sview_len(owner_module) |offset, start, owner_module, owner_parts, functions|:
                if sview_at(owner_module, offset) == 58 and sview_at(owner_module, offset + 1) == 58:
                    return false if not proof_qualify_enum_source_work_charge(functions, 1) or not proof_qualify_enum_source_work_charge(functions, offset - start)
                    owner_parts.push(string_view_slice(owner_module, start, (offset - start).i64()))
                    offset <- offset + 2
                    start <- offset
                else:
                    offset <- offset + 1
            if start < sview_len(owner_module):
                return false if not proof_qualify_enum_source_work_charge(functions, 1) or not proof_qualify_enum_source_work_charge(functions, sview_len(owner_module) - start)
                owner_parts.push(string_view_suffix(owner_module, start.i64()))
            return false if owner_parts.count != module_scope.count
            for part_index in 0..<owner_parts.count |part_index, owner_parts, module_scope, functions|:
                return false if not proof_qualify_enum_source_work_charge(functions, sview_len(owner_parts[part_index])) or not proof_qualify_enum_source_work_charge(functions, sview_len(module_scope[part_index]))
                return false if owner_parts[part_index] != module_scope[part_index]
            return true

        def proof_function_enum_context_for_source_declarations(source_declarations: darray[Ast::Decl]&, functions: mutable ProofFunctionTable&, function_name: sview, declaration_line: u32, declaration_offset: u32, owner_module: sview) -> (known: bool, declarations: darray[Ast::Decl], module_scope: darray[sview]):
            module_scope: mutable darray[sview] = []
            declarations: mutable darray[Ast::Decl] = []
            found_scope: mutable darray[sview] = []
            matches: mutable usize = 0
            complete: bool = proof_function_enum_source_context_scan(source_declarations, &module_scope, function_name, declaration_line, declaration_offset, functions, &declarations, &found_scope, &matches, 0)
            return (false, [], []) if not complete or matches != 1
            return (false, [], []) if not proof_function_enum_module_scope_matches_owner(found_scope, owner_module, functions)
            (true, declarations, found_scope)

        def proof_function_enum_context_for_source(file: Ast::File&, functions: mutable ProofFunctionTable&, row: usize, function_name: sview, declaration_line: u32, declaration_offset: u32, owner_module: sview) -> (known: bool, declarations: darray[Ast::Decl], module_scope: darray[sview]):
            if row < functions.lookup.names.count and row < functions.lookup.lines.count and row < functions.lookup.offsets.count:
                if functions.lookup.names[row] == function_name and functions.lookup.lines[row] == declaration_line and functions.lookup.offsets[row] == declaration_offset:
                    row_context: (known: bool, declarations: darray[Ast::Decl], module_scope: darray[sview]) = proof_function_enum_context(file, functions, row)
                    return row_context if row_context.known and proof_function_enum_module_scope_matches_owner(row_context.module_scope, owner_module, functions)
            proof_function_enum_context_for_source_declarations(file.top_decls, functions, function_name, declaration_line, declaration_offset, owner_module)
