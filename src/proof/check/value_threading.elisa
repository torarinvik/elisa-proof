# Value-threading for exclusive `&` parameters. A call `f(&x)` (or its value spelling
# `x <- f(x)`) whose callee takes `x` through a `mutable T&`/`lmut` parameter `p` is read as
# `x <- f(x)`: the callee's contract is instantiated with `p[0]` before the call as x's current
# value and `p[0]` after it as a fresh symbol S, x's binding moves to S, and nothing else about
# the caller is havocked beyond what an ordinary call already havocs (globals, other lends).
# Facts over x's old value stay: x's old symbol keeps denoting the value it had, the same rule a
# self-referential update follows (proof_bind_unsigned_symbol).
#
# The call is threaded only when every one of these holds; otherwise it keeps the opaque path:
#   - every reference parameter of the callee is a mutable one, each receiving a distinct
#     unsigned local of the caller, by `&x`, `mutable x`, `lmut x` or plain `x`, that no other
#     argument mentions, that is not a parameter, a reference local, or an escaping name;
#   - the callee returns no reference and the lend is confined (no region parameter or stored
#     borrow can keep the reference past the call);
#   - neither the callee nor anything it can reach declares an `Unsafe` effect or calls a
#     native (extern) function;
#   - every contract mentions each threaded parameter only as `p[0]` or `old(p[0])`.
extend ElisaProof:
    private:
        const PROOF_VALUE_THREAD_WALK_LIMIT: usize = 256
        const PROOF_VALUE_THREAD_WORK_LIMIT: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT

        struct ProofValueThreading:
            active: mutable bool
            parameters: mutable darray[sview]
            locals: mutable darray[sview]
            pre_values: mutable darray[Ast::Expr]
            post_symbols: mutable darray[sview]
            widths: mutable darray[i64]
            slots: mutable darray[usize]
            work_used: mutable usize

        def proof_value_threading_none() -> ProofValueThreading:
            return ProofValueThreading{active: false, parameters: [], locals: [], pre_values: [], post_symbols: [], widths: [], slots: [], work_used: 0}

        def proof_value_thread_charge_cost(cost: usize, passes: usize, work: mutable usize&) -> bool:
            return false if passes == 0 or work > PROOF_VALUE_THREAD_WORK_LIMIT or cost > (PROOF_VALUE_THREAD_WORK_LIMIT - work) / passes
            work <- work + cost * passes
            true

        def proof_value_thread_charge(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_VALUE_THREAD_WORK_LIMIT or amount > PROOF_VALUE_THREAD_WORK_LIMIT - work
            work <- work + amount
            true

        # Reserve one cost walk and one direct expression scan.
        def proof_value_thread_reserve_expr_scan(expression: Ast::Expr, work: mutable usize&) -> bool:
            cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost_with_limit(expression, &cost, work, PROOF_VALUE_THREAD_WORK_LIMIT)
            proof_value_thread_charge_cost(cost, 2, &work)

        def proof_value_thread_name_in_with_work(name: sview, names: darray[sview]&, passes: usize, work: mutable usize&) -> (complete: bool, found: bool):
            index: mutable usize = names.count
            while index > 0 |index, names, name, work|:
                index <- index - 1
                candidate: sview = names[index]
                return (false, false) if not proof_value_thread_charge_cost(1 + sview_len(candidate) + sview_len(name), passes, &work)
                return (true, true) if candidate == name
            return (true, false)

        def proof_value_thread_local_with_work(argument: Ast::Expr, caller_names: darray[sview]&, caller_parameters: darray[sview]&, report: ProofReport&, work: mutable usize&) -> (complete: bool, name: sview):
            return (false, "") if not proof_value_thread_reserve_expr_scan(argument, &work)
            lend: (known: bool, operand: Ast::Expr) = proof_explicit_lend_operand(argument)
            operand: Ast::Expr = proof_strip_parens(lend.operand if lend.known else argument)
            local_name: sview = proof_ident_name(operand)
            return (false, "") if not proof_value_thread_charge(&work, sview_len(local_name))
            return (true, "") if local_name == "" or proof_name_is_reserved_internal(local_name)
            caller: (complete: bool, found: bool) = proof_value_thread_name_in_with_work(local_name, caller_names, 1, &work)
            return (false, "") if not caller.complete
            return (true, "") if not caller.found
            parameter: (complete: bool, found: bool) = proof_value_thread_name_in_with_work(local_name, caller_parameters, 1, &work)
            return (false, "") if not parameter.complete
            return (true, "") if parameter.found
            binding: (complete: bool, found: bool) = proof_value_thread_name_in_with_work(local_name, report.aliases.value_binding_names, 1, &work)
            return (false, "") if not binding.complete
            return (true, "") if not binding.found
            reference: (complete: bool, found: bool) = proof_value_thread_name_in_with_work(local_name, report.aliases.reference_local_names, 1, &work)
            return (false, "") if not reference.complete
            return (true, "") if reference.found
            escaping: (complete: bool, found: bool) = proof_value_thread_name_in_with_work(local_name, report.aliases.escaping_names, 1, &work)
            return (false, "") if not escaping.complete or escaping.found
            return (true, local_name)

        def proof_value_thread_unsigned_width_with_work(facts: darray[Ast::Expr]&, name: sview, work: mutable usize&) -> (complete: bool, width: i64):
            width: mutable i64 = 0
            for fact in facts |fact, name, width, work|:
                cost: mutable usize = 0
                return (false, 0) if not proof_replay_summary_expr_cost_with_limit(fact, &cost, work, PROOF_VALUE_THREAD_WORK_LIMIT)
                return (false, 0) if not proof_value_thread_charge_cost(cost, 2, &work)
                return (false, 0) if not proof_value_thread_charge(&work, 1 + sview_len(name))
                marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                continue if not marker.known
                return (false, 0) if not proof_value_thread_charge(&work, sview_len(marker.name))
                continue if marker.name != name
                width <- marker.width if width == 0 or marker.width < width
            return (true, width)

        def proof_value_thread_effects_safe(functions: ProofFunctionTable&, index: usize, work: mutable usize&) -> bool:
            return false if index >= functions.summaries.effect_starts.count or index >= functions.summaries.effect_counts.count
            start: usize = functions.summaries.effect_starts[index]
            for offset in 0..<functions.summaries.effect_counts[index] |offset, functions, start, work|:
                return false if start + offset >= functions.summaries.all_effects.count
                effect: sview = functions.summaries.all_effects[start + offset]
                return false if not proof_value_thread_charge(&work, 1 + sview_len(effect))
                return false if sview_starts_with(effect, "Unsafe")
            return true

        # Every function the callee can reach declares no Unsafe effect and calls no extern.
        def proof_value_thread_callee_safe(functions: ProofFunctionTable&, callee: usize, work: mutable usize&) -> bool:
            pending: mutable darray[usize] = [callee]
            seen: mutable darray[usize] = []
            while pending.count > 0 |pending, seen, functions, work|:
                return false if seen.count >= PROOF_VALUE_THREAD_WALK_LIMIT
                return false if not proof_value_thread_charge(&work, 1)
                current: usize = pending[pending.count - 1]
                pending.pop()
                visited: mutable bool = false
                for candidate in seen |candidate, current, visited, work|:
                    return false if not proof_value_thread_charge(&work, 1)
                    visited <- true if candidate == current
                continue if visited
                seen.push(current)
                return false if:
                    not proof_value_thread_effects_safe(functions, current, &work)
                    current >= functions.call_graph.call_starts.count or current >= functions.call_graph.call_counts.count
                start: usize = functions.call_graph.call_starts[current]
                for offset in 0..<functions.call_graph.call_counts[current] |offset, functions, start, pending, work|:
                    return false if not proof_value_thread_charge(&work, 1)
                    slot: usize = start + offset
                    return false if slot >= functions.call_graph.all_call_targets.count or slot >= functions.call_graph.all_calls.count
                    target: usize = functions.call_graph.all_call_targets[slot]
                    if target < functions.lookup.source.names.count:
                        pending.push(target)
                    else:
                        called: sview = functions.call_graph.all_calls[slot]
                        external: mutable bool = false
                        for signature in functions.externs.extern_signatures |called, external, work|:
                            return false if not proof_value_thread_charge(&work, 1 + sview_len(signature.name) + sview_len(called))
                            external <- true if signature.name == called
                        return false if external
            return true

        # `p[0]` or a bare `p`: the referent of a scalar reference place, or "".
        def proof_value_thread_place(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Index(object, index, _):
                    match index:
                        Ast::Expr.IntLit(offset, _):
                            return proof_ident_name(object) if offset == 0
                            return ""
                        _:
                            return ""
                Ast::Expr.Ident(name, _):
                    return name
                _:
                    return ""

        # Read each threaded parameter's place as its exit symbol (or as the parameter, the entry
        # value, when `pre`), and `old(place)` as the parameter. Any other mention is invalid.
        def proof_value_thread_rewrite(expression: Ast::Expr, parameters: darray[sview]&, symbols: darray[sview]&, pre: bool, valid: mutable bool&, work: mutable usize&, depth: usize) -> Ast::Expr can[Memory.Allocate, Abort.Panic]:
            if work > PROOF_VALUE_THREAD_WORK_LIMIT or parameters.count >= PROOF_VALUE_THREAD_WORK_LIMIT:
                valid <- false
                return expression
            cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(expression, &cost, work, PROOF_VALUE_THREAD_WORK_LIMIT):
                work <- PROOF_VALUE_THREAD_WORK_LIMIT
                valid <- false
                return expression
            if not proof_value_thread_charge_cost(cost, parameters.count + 1, &work):
                work <- PROOF_VALUE_THREAD_WORK_LIMIT
                valid <- false
                return expression
            mentioned: mutable bool = false
            for parameter in parameters |expression, mentioned|:
                mentioned <- true if proof_expr_mentions_name(expression, parameter)
            return expression if not mentioned
            if depth >= PROOF_VALUE_THREAD_WALK_LIMIT:
                valid <- false
                return expression
            if parameters.count > (PROOF_VALUE_THREAD_WORK_LIMIT - 2) / 2 or not proof_value_thread_charge_cost(cost, parameters.count * 2 + 2, &work):
                work <- PROOF_VALUE_THREAD_WORK_LIMIT
                valid <- false
                return expression
            place: sview = proof_value_thread_place(expression)
            for index in 0..<parameters.count |index, parameters, symbols, place, pre, expression|:
                if parameters[index] == place and index < symbols.count:
                    return Ast::Expr.Ident(place, Ast::expr_pos(expression)) if pre
                    return Ast::Expr.Ident(symbols[index], Ast::expr_pos(expression))
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    if proof_ident_name(callee) == "old":
                        if not pre and arguments.count == 1:
                            entry: sview = proof_value_thread_place(arguments[0])
                            return Ast::Expr.Ident(entry, position) if entry != "" and (any parameter in parameters where parameter == entry)
                        valid <- false
                        return expression
                    rewritten: mutable darray[Ast::Expr] = []
                    for argument in arguments |rewritten, parameters, symbols, pre, valid, work, depth|:
                        rewritten.push(proof_value_thread_rewrite(argument, parameters, symbols, pre, valid, work, depth + 1))
                    return Ast::Expr.Call(proof_value_thread_rewrite(callee, parameters, symbols, pre, valid, work, depth + 1), rewritten, argument_names, position)
                Ast::Expr.Paren(inner, position):
                    return Ast::Expr.Paren(proof_value_thread_rewrite(inner, parameters, symbols, pre, valid, work, depth + 1), position)
                Ast::Expr.Unary(operator, inner, position):
                    return Ast::Expr.Unary(operator, proof_value_thread_rewrite(inner, parameters, symbols, pre, valid, work, depth + 1), position)
                Ast::Expr.Binary(left, operator, right, position):
                    return Ast::Expr.Binary(proof_value_thread_rewrite(left, parameters, symbols, pre, valid, work, depth + 1), operator, proof_value_thread_rewrite(right, parameters, symbols, pre, valid, work, depth + 1), position)
                Ast::Expr.If(condition, then_expression, else_expression, position):
                    return Ast::Expr.If(proof_value_thread_rewrite(condition, parameters, symbols, pre, valid, work, depth + 1), proof_value_thread_rewrite(then_expression, parameters, symbols, pre, valid, work, depth + 1), proof_value_thread_rewrite(else_expression, parameters, symbols, pre, valid, work, depth + 1), position)
                _:
                    valid <- false
                    return expression

        def proof_value_thread_contract(expression: Ast::Expr, threading: ProofValueThreading&, pre: bool) -> Ast::Expr can[Memory.Allocate, Abort.Panic]:
            return expression if not threading.active
            valid: mutable bool = true
            rewritten: Ast::Expr = proof_value_thread_rewrite(expression, threading.parameters, threading.post_symbols, pre, &valid, &threading.work_used, 0)
            return rewritten if valid
            return Ast::Expr.Invalid

        def proof_value_thread_plan(functions: ProofFunctionTable&, function_index: usize, mapped_arguments: darray[Ast::Expr]&, caller_names: darray[sview]&, caller_values: darray[Ast::Expr]&, caller_parameters: darray[sview]&, facts: darray[Ast::Expr]&, report: mutable ProofReport&) -> ProofValueThreading can[Memory.Allocate, Abort.Panic]:
            report.threading.threaded_names.clear()
            report.threading.threaded_values.clear()
            none: ProofValueThreading = proof_value_threading_none()
            # Only a call whose caller moves the locals afterwards (value_thread_apply) threads.
            return none if not report.threading.value_thread_site
            report.threading.value_thread_site <- false
            return none if:
                function_index >= functions.parameters.metadata.param_starts.count or function_index >= functions.parameters.metadata.param_counts.count
                function_index >= functions.returns.return_references.count or functions.returns.return_references[function_index]
            start: usize = functions.parameters.metadata.param_starts[function_index]
            count: usize = functions.parameters.metadata.param_counts[function_index]
            return none if count != mapped_arguments.count
            plan: mutable ProofValueThreading = proof_value_threading_none()
            # Nested calls would be checked inside this one and see a half-threaded state.
            for argument in mapped_arguments |argument, plan|:
                return none if not proof_value_thread_reserve_expr_scan(argument, &plan.work_used)
                return none if proof_expr_has_call(argument)
            for slot in 0..<count |slot, functions, start, mapped_arguments, caller_names, caller_values, caller_parameters, facts, report, plan|:
                param_slot: usize = start + slot
                return none if param_slot >= functions.parameters.metadata.all_parameter_references.count or param_slot >= functions.parameters.metadata.all_parameter_mutable_references.count
                continue if not functions.parameters.metadata.all_parameter_references[param_slot]
                return none if not functions.parameters.metadata.all_parameter_mutable_references[param_slot]
                local: (complete: bool, name: sview) = proof_value_thread_local_with_work(mapped_arguments[slot], caller_names, caller_parameters, report, &plan.work_used)
                return none if not local.complete
                local_name: sview = local.name
                return none if local_name == ""
                duplicate: (complete: bool, found: bool) = proof_value_thread_name_in_with_work(local_name, plan.locals, 1, &plan.work_used)
                return none if not duplicate.complete or duplicate.found
                for other in 0..<count |other, slot, mapped_arguments, local_name, plan|:
                    if other != slot:
                        return none if not proof_value_thread_reserve_expr_scan(mapped_arguments[other], &plan.work_used)
                        return none if proof_expr_mentions_name(mapped_arguments[other], local_name)
                return none if caller_names.count != caller_values.count
                # proof_substitute searches names from the end, so reserve its pass as well.
                caller_binding: (complete: bool, found: bool) = proof_value_thread_name_in_with_work(local_name, caller_names, 2, &plan.work_used)
                return none if not caller_binding.complete or not caller_binding.found
                return none if not proof_value_thread_charge(&plan.work_used, count)
                return none if not proof_call_lend_is_confined(functions, function_index, slot)
                pre_value: Ast::Expr = proof_substitute(Ast::Expr.Ident(local_name, Ast::expr_pos(mapped_arguments[slot])), caller_names, caller_values)
                pre_width: (complete: bool, width: i64) = proof_value_thread_unsigned_width_with_work(facts, proof_ident_name(pre_value), &plan.work_used)
                return none if not pre_width.complete
                width: mutable i64 = pre_width.width
                if width <= 0:
                    fallback_width: (complete: bool, width: i64) = proof_value_thread_unsigned_width_with_work(facts, local_name, &plan.work_used)
                    return none if not fallback_width.complete
                    width <- fallback_width.width
                return none if width <= 0
                plan.parameters.push(functions.parameters.metadata.all_params[param_slot])
                plan.locals.push(local_name)
                plan.pre_values.push(pre_value)
                plan.widths.push(width)
                plan.slots.push(slot)
            return none if plan.locals.count == 0 or not proof_value_thread_callee_safe(functions, function_index, &plan.work_used)
            plan.active <- true
            for _ in plan.locals |plan|:
                plan.post_symbols.push("")
            # Every contract must thread before any fresh symbol is spent.
            requires_start: usize = functions.contracts.obligations.requires_starts[function_index]
            for offset in 0..<functions.contracts.obligations.requires_counts[function_index] |offset, functions, requires_start, plan|:
                return none if proof_value_thread_contract(functions.contracts.obligations.all_requires[requires_start + offset], plan, true) is Ast::Expr.Invalid
            ensures_start: usize = functions.contracts.obligations.ensure_starts[function_index]
            for offset in 0..<functions.contracts.obligations.ensure_counts[function_index] |offset, functions, ensures_start, plan|:
                return none if proof_value_thread_contract(functions.contracts.obligations.all_ensures[ensures_start + offset], plan, false) is Ast::Expr.Invalid
            # Contract rewriting runs again when the call is checked/applied. Keep enough room
            # for that second pass so exhaustion cannot activate a half-threaded call.
            return none if plan.work_used > PROOF_VALUE_THREAD_WORK_LIMIT / 2
            for index in 0..<plan.locals.count |index, plan, report|:
                symbol: sview = proof_rebind_symbol(report)
                return none if symbol == ""
                plan.post_symbols[index] <- symbol
            return plan

        # A threaded statement call has no result binding; its summary records the resolved call
        # itself there, so replay can find the source call the summary instantiates.
        def proof_value_thread_summary_result(threading: ProofValueThreading&, result_value: Ast::Expr, expression: Ast::Expr, caller_names: darray[sview]&, caller_values: darray[Ast::Expr]&) -> Ast::Expr:
            return result_value if not threading.active or not (result_value is Ast::Expr.Absent)
            return expression

        # Threaded slots enter the contract with the local's current value, not its lend.
        def proof_value_thread_arguments(threading: ProofValueThreading&, argument_values: mutable darray[Ast::Expr]&) -> void:
            for index in 0..<threading.slots.count |index, threading, argument_values|:
                argument_values[threading.slots[index]] <- threading.pre_values[index] if threading.slots[index] < argument_values.count

        # Lends a threaded call performs on its threaded locals do not havoc their old values.
        def proof_value_thread_lends(threading: ProofValueThreading&, lends: darray[sview]) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            return lends if not threading.active
            kept: mutable darray[sview] = []
            for lent in lends |kept, threading|:
                kept.push(lent) if not (any local in threading.locals where local == lent)
            return kept

        # After the call's havoc: each exit symbol carries its local's unsigned width, and the
        # callers learn which locals now name which symbols.
        def proof_value_thread_post(threading: ProofValueThreading&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, position: Ast::Pos) -> void:
            return if not threading.active
            for index in 0..<threading.locals.count |index, threading, facts, report, owner, position|:
                symbol: sview = threading.post_symbols[index]
                proof_add_unsigned_binding_facts(facts, report, symbol, threading.widths[index], position.line, owner, position)
                report.threading.threaded_symbols.push(symbol)
                report.threading.threaded_names.push(threading.locals[index])
                report.threading.threaded_values.push(Ast::Expr.Ident(symbol, position))

        # The exit symbols ride on the summary traces recorded while `active` (bounds_and_facts).
        def proof_value_thread_record(threading: ProofValueThreading&, report: mutable ProofReport&, active: bool) -> void:
            report.threading.summary_threaded_symbols.clear()
            report.threading.summary_threaded_symbols.extend(threading.post_symbols) if active and threading.active

        # Callers move each threaded local to its exit symbol once the call's own value bookkeeping
        # is done. Returns whether `target` (an assignment's destination, or "") was threaded.
        def proof_value_thread_apply(names: darray[sview]&, values: mutable darray[Ast::Expr]&, report: mutable ProofReport&, target: sview) -> bool:
            threaded_target: mutable bool = false
            for index in 0..<report.threading.threaded_names.count |index, names, values, report, target, threaded_target|:
                local_name: sview = report.threading.threaded_names[index]
                threaded_target <- true if local_name == target
                # The innermost binding of the name is the live one.
                slot: mutable usize = names.count
                for candidate in 0..<names.count |candidate, names, local_name, slot|:
                    slot <- candidate if names[candidate] == local_name
                values[slot] <- report.threading.threaded_values[index] if slot < names.count and slot < values.count
            report.threading.threaded_names.clear()
            report.threading.threaded_values.clear()
            return threaded_target
