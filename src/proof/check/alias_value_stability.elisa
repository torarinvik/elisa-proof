# Bounded expression-shape and membership helpers used by call-stability analysis.
extend ElisaProof:
    private:
        # The argument root and any fields below it can carry a reference. A call may preserve
        # the argument's value only when the whole value path is stable and source-bounded.
        def proof_value_argument_shape_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, supported: bool, cost: usize, terminal_name: sview):
            return (true, false, 0, "") if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            return (false, false, 0, "") if not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, false, 0, "") if not proof_replay_source_work_charge_or_exhaust(sview_len(name), source_work)
                    return (true, name != "", 1 + sview_len(name), name)
                Ast::Expr.Field(object, field_name, _):
                    return (false, false, 0, "") if not proof_replay_source_work_charge_or_exhaust(sview_len(field_name), source_work)
                    return (true, false, 1 + sview_len(field_name), "") if field_name == ""
                    nested: (complete: bool, supported: bool, cost: usize, terminal_name: sview) = proof_value_argument_shape_with_work(object, source_work, depth + 1)
                    (nested.complete, nested.supported, nested.cost + 1 + sview_len(field_name), nested.terminal_name)
                Ast::Expr.Paren(inner, _):
                    nested: (complete: bool, supported: bool, cost: usize, terminal_name: sview) = proof_value_argument_shape_with_work(inner, source_work, depth + 1)
                    (nested.complete, nested.supported, nested.cost + 1, nested.terminal_name)
                _:
                    (true, false, 1, "")

        def proof_value_argument_stable(expression: Ast::Expr, names: darray[sview]&, parameters: darray[sview]&, aliased: darray[sview]&, local_extents: darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if:
                        name == "" or not (any owned in local_extents where owned == name)
                        any existing in aliased where existing == name
                    return (any candidate in names where candidate == name) or (any parameter in parameters where parameter == name) or proof_name_is_reserved_internal(name)
                Ast::Expr.Field(object, field_name, _):
                    return false if field_name == ""
                    return proof_value_argument_stable(object, names, parameters, aliased, local_extents, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_value_argument_stable(inner, names, parameters, aliased, local_extents, depth + 1)
                _:
                    return false

        # The binding a pure place names through fields alone, or "" for any other form.
        def proof_value_place_root(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, field_name, _):
                    return "" if field_name == ""
                    return proof_value_place_root(object, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_value_place_root(inner, depth + 1)
                _:
                    return ""
