# Source effect classification for retention; budget exhaustion is effectful.
extend ElisaProof:
    private:
        def proof_body_expression_has_effect(expression: Ast::Expr, operator_mask: usize, depth: usize, work: mutable usize&) -> bool:
            return true if depth >= 64 or work >= 4096
            work <- work + 1
            match expression:
                Ast::Expr.Block(statements, yielded, _, _):
                    return proof_body_has_effect_bounded(statements, operator_mask, depth + 1, work) or proof_body_expression_has_effect(yielded, operator_mask, depth + 1, work)
                Ast::Expr.Paren(inner, _):
                    return proof_body_expression_has_effect(inner, operator_mask, depth + 1, work)
                _:
                    return proof_expr_has_call(expression) or proof_expr_has_move(expression) or proof_source_expression_has_overloaded_operator(expression, operator_mask, 0)

        def proof_body_has_effect_bounded(body: darray[Ast::Stmt]&, operator_mask: usize, depth: usize, work: mutable usize&) -> bool:
            return true if depth >= 64 or body.count > 4096
            for statement in body |operator_mask, depth, work|:
                return true if work >= 4096
                work <- work + 1
                match statement:
                    Ast::Stmt.Assign(target, _, value, _):
                        return true if proof_body_expression_has_effect(target, operator_mask, depth + 1, work)
                        return true if proof_body_expression_has_effect(value, operator_mask, depth + 1, work)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_body_expression_has_effect(initializer, operator_mask, depth + 1, work)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_body_expression_has_effect(expression, operator_mask, depth + 1, work)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_body_has_effect_bounded(block_body, operator_mask, depth + 1, work)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_body_expression_has_effect(condition, operator_mask, depth + 1, work)
                        return true if proof_body_has_effect_bounded(then_body, operator_mask, depth + 1, work) or proof_body_has_effect_bounded(else_body, operator_mask, depth + 1, work)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_body_expression_has_effect(condition, operator_mask, depth + 1, work)
                        return true if proof_body_has_effect_bounded(while_body, operator_mask, depth + 1, work)
                    Ast::Stmt.For(bind, _, iterable, for_body, _):
                        return true if bind == "parallel"
                        return true if proof_body_expression_has_effect(iterable, operator_mask, depth + 1, work)
                        return true if proof_body_has_effect_bounded(for_body, operator_mask, depth + 1, work)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_body_expression_has_effect(scrutinee, operator_mask, depth + 1, work)
                        for arm in arms:
                            return true if proof_body_expression_has_effect(arm.guard, operator_mask, depth + 1, work) or proof_body_has_effect_bounded(arm.body, operator_mask, depth + 1, work)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and (proof_body_expression_has_effect(returned, operator_mask, depth + 1, work))
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_body_expression_has_effect(expression, operator_mask, depth + 1, work)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return true
            return false

