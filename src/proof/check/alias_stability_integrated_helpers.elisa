# Factored helpers retained by the branch integration.
extend ElisaProof:
    private:
        def proof_local_rebind_binding_with_work(report: ProofReport&, expression: Ast::Expr, owner: sview, names: darray[sview]&, source_work: mutable usize&) -> (complete: bool, known: bool, path: Ast::Expr, value: Ast::Expr):
            for trace in report.analysis_1.traces.records |expression, owner, source_work|:
                if not proof_replay_source_work_charge_or_exhaust(1, source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(trace.name), source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(trace.kind), source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(owner), source_work):
                    return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                continue if trace.name != owner or trace.kind != "local-binding"
                equal: bool = proof_replay_summary_expr_equal_with_limit(trace.expression, expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not equal and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                continue if not equal
                match expression:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        match left:
                            Ast::Expr.Ident(local_name, _):
                                match right:
                                    Ast::Expr.Ident(rebind_name, _):
                                        is_rebind: mutable bool = false
                                        for index in 0..<PROOF_INTERNAL_REBIND_SYMBOL_COUNT |index, rebind_name, is_rebind, source_work|:
                                            return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not proof_replay_source_work_charge_or_exhaust(1, source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(rebind_name), source_work)
                                            is_rebind <- true if rebind_name == proof_internal_rebind_name(index)
                                        if is_rebind:
                                            for live in names |live, local_name, source_work|:
                                                return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not proof_replay_source_work_charge_or_exhaust(1, source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(live), source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(local_name), source_work)
                                                return (true, true, right, left) if live == local_name
                                    _:
                                        pass
                            _:
                                pass
                    _:
                        pass
            return (true, false, Ast::Expr.Invalid, Ast::Expr.Invalid)

        # Copy only compiler-derived bounds for a statement snapshot; the copy shares the
        # report's source-work meter with subsequent restoration.
        def proof_copy_type_bound_facts(source: darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview) -> darray[Ast::Expr]:
            result: mutable darray[Ast::Expr] = []
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for fact in source |fact, result, report, owner, source_work|:
                if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or proof_fact_is_type_bound_with_work(report, fact, owner, &source_work):
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        result.clear()
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return result
                    result.push(fact)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    result.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return result
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return result

        def proof_callee_is_shadowed_local(callee: Ast::Expr, caller_names: darray[sview]&, depth: usize) -> bool:
            # The nesting cap must not turn an unresolved callable into a global summary hit.
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match callee:
                Ast::Expr.Ident(local_callee, _):
                    return any local in caller_names where local == local_callee
                Ast::Expr.Paren(inner, _):
                    return proof_callee_is_shadowed_local(inner, caller_names, depth + 1)
                _:
                    return false

        def proof_expression_has_opaque_callable_call(expression: Ast::Expr, functions: ProofFunctionTable&, caller_names: darray[sview]&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_callee_is_shadowed_local(callee, caller_names, 0)
                    if proof_callable_name(callee) == "":
                        return true if not proof_resource_collection_builtin(callee, functions).known and not proof_runtime_numeric_conversion(callee, arguments.count, functions).known
                    return true if proof_expression_has_opaque_callable_call(callee, functions, caller_names, depth + 1)
                    for argument in arguments |functions, caller_names, depth|:
                        return true if proof_expression_has_opaque_callable_call(argument, functions, caller_names, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_expression_has_opaque_callable_call(lowered.call, functions, caller_names, depth + 1) if lowered.known
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_expression_has_opaque_callable_call(inner, functions, caller_names, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return proof_expression_has_opaque_callable_call(left, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(right, functions, caller_names, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expression_has_opaque_callable_call(object, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(low, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(high, functions, caller_names, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expression_has_opaque_callable_call(object, functions, caller_names, depth + 1)
                    for argument in arguments |functions, caller_names, depth|:
                        return true if proof_expression_has_opaque_callable_call(argument, functions, caller_names, depth + 1)
                    return false
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |functions, caller_names, depth|:
                        return true if proof_expression_has_opaque_callable_call(element, functions, caller_names, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |functions, caller_names, depth|:
                        return true if proof_expression_has_opaque_callable_call(entry.key, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(entry.value, functions, caller_names, depth + 1)
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    return true if proof_expression_has_opaque_callable_call(type_expression, functions, caller_names, depth + 1)
                    for field in fields |functions, caller_names, depth|:
                        return true if proof_expression_has_opaque_callable_call(field.value, functions, caller_names, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expression_has_opaque_callable_call(base, functions, caller_names, depth + 1)
                    for field in fields |functions, caller_names, depth|:
                        return true if proof_expression_has_opaque_callable_call(field.value, functions, caller_names, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_expression_has_opaque_callable_call(condition, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(then_expression, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(else_expression, functions, caller_names, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expression_has_opaque_callable_call(iterable, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(condition, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(body, functions, caller_names, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expression_has_opaque_callable_call(base, functions, caller_names, depth + 1) or proof_expression_has_opaque_callable_call(predicate, functions, caller_names, depth + 1)
                Ast::Expr.Match(scrutinee, arms, position):
                    lowered: (known: bool, value: Ast::Expr) = proof_lower_value_match(expression)
                    return proof_expr_has_call(expression) if not lowered.known
                    return true if proof_expression_has_opaque_callable_call(scrutinee, functions, caller_names, depth + 1)
                    for arm in arms |arm, functions, caller_names, position, depth|:
                        arm_names: mutable darray[sview] = []
                        arm_values: mutable darray[Ast::Expr] = []
                        return true if not proof_bind_pattern(arm.pattern, position, scrutinee, &arm_names, &arm_values)
                        scoped_names: mutable darray[sview] = proof_copy_names(caller_names)
                        scoped_names.extend(arm_names)
                        return true if:
                            proof_expression_has_opaque_callable_call(arm.guard, functions, scoped_names, depth + 1)
                            arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expression_has_opaque_callable_call(value, functions, scoped_names, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.GetElse(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _):
                    # These forms need statement or binder scope to resolve callable identity.
                    # They are not logical-contract values, so calls inside them stay opaque.
                    return proof_expr_has_call(expression)
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                _:
                    return proof_expr_has_call(expression)

        def proof_statement_lend_roots(expression: Ast::Expr, functions: mutable ProofFunctionTable&, caller_names: darray[sview]&) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            roots: mutable darray[sview] = []
            no_value_roots: darray[sview] = []
            proof_collect_aliased_in_expression(expression, functions, &roots, false, no_value_roots)
            # A same-spelled global signature cannot classify arguments passed to a local
            # function-valued binding, so include every direct argument place.
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    local_callable: bool = proof_callee_is_shadowed_local(callee, caller_names, 0)
                    unknown_callable: bool = not local_callable and proof_callable_name(callee) == ""
                    return roots if not local_callable and not unknown_callable
                    for argument in arguments |roots|:
                        explicit_lend: (known: bool, operand: Ast::Expr) = proof_explicit_lend_operand(argument)
                        place: Ast::Expr = explicit_lend.operand if explicit_lend.known else argument
                        proof_push_aliased(&roots, proof_place_root_name(place, 0))
                _:
                    pass
            return roots

        def proof_opaque_call_extra_alias_roots(expression: Ast::Expr, functions: mutable ProofFunctionTable&, caller_names: darray[sview]&) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    local_callable: bool = proof_callee_is_shadowed_local(callee, caller_names, 0)
                    unknown_callable: mutable bool = false
                    if not local_callable and proof_callable_name(callee) == "":
                        unknown_callable <- not proof_resource_collection_builtin(callee, functions).known and not proof_runtime_numeric_conversion(callee, arguments.count, functions).known
                    return proof_statement_lend_roots(expression, functions, caller_names) if local_callable or unknown_callable
                Ast::Expr.GetElse(guarded, _, _) | Ast::Expr.Paren(guarded, _):
                    return proof_opaque_call_extra_alias_roots(guarded, functions, caller_names)
                _:
                    pass
            return []

        def proof_record_opaque_call_alias_roots(report: mutable ProofReport&, owner: sview, roots: darray[sview]&) -> void:
            return if report.aliases.aliased_owner != owner or owner == "" or roots.count == 0
            return if any existing in report.aliases.aliased_names where existing == "*"
            # An opaque callable may retain a reference it receives, so later calls and exits
            # must continue to treat these roots as reachable.
            for root in roots |report|:
                proof_push_aliased(&report.aliases.aliased_names, root)
                proof_push_aliased(&report.aliases.escaping_names, root)

        def proof_add_lemma_summary_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, functions: mutable ProofFunctionTable&, expression: Ast::Expr, line: u32, name: sview, dependency: sview, parameter_names: darray[sview]&, argument_values: darray[Ast::Expr]&, require_goal_ids: darray[usize]&, ensure_index: usize, source_call_position: Ast::Pos) -> void:
            return if proof_expression_has_fresh_runtime_value(expression, functions, 0) or not proof_contract_calls_are_pure(expression, functions)
            return if line == 0 or source_call_position.line != line or source_call_position.offset == 0 or source_call_position.end_offset <= source_call_position.offset
            for argument in argument_values:
                if proof_expr_has_call(argument):
                    return if proof_fact_expression_has_fresh_runtime_value(report, argument)
                else:
                    return if proof_expression_has_fresh_runtime_value(argument, functions, 0)
            return if not proof_kernel_expression_supported(expression)
            return if not proof_kernel_report_append_allowed(report, facts.count, 1, name)
            return if parameter_names.count != argument_values.count
            return if not proof_kernel_report_append_allowed(report, report.analysis_1.traces.records.count, 1, name)
            return if not proof_kernel_report_append_allowed(report, report.analysis_1.traces.summary_names.count, parameter_names.count, name)
            return if not proof_kernel_report_append_allowed(report, report.analysis_1.traces.summary_values.count, argument_values.count, name)
            return if not proof_kernel_report_append_allowed(report, report.analysis_1.traces.summary_require_goal_ids.count, require_goal_ids.count, name)
            encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(expression, report, name)
            return if not encoded.known
            facts.push(expression)
            bindings_start: usize = report.analysis_1.traces.summary_names.count
            report.analysis_1.traces.summary_names.extend(parameter_names)
            report.analysis_1.traces.summary_values.extend(argument_values)
            requires_start: usize = report.analysis_1.traces.summary_require_goal_ids.count
            report.analysis_1.traces.summary_require_goal_ids.extend(require_goal_ids)
            report.analysis_1.traces.records.push(ProofFactTrace{expression: expression, kernel_expression: encoded.root, kind: "lemma-summary", line: line, name: name, dependency: dependency, premises_start: report.analysis_1.traces.premises.count, premises_count: 0, kernel_premises_start: report.analysis_1.kernel.fact_trace_premises.count, kernel_premises_count: 0, summary_bindings_start: bindings_start, summary_bindings_count: parameter_names.count, summary_requires_start: requires_start, summary_requires_count: require_goal_ids.count, summary_ensure_index: ensure_index, owner_line: 0, source_call_position: source_call_position})

        def proof_type_bound_name(expression: Ast::Expr) -> sview:
            marker_name: sview = proof_unsigned_marker_name(expression)
            return marker_name if marker_name != ""
            match proof_marker_callee_name(expression):
                "__elisa_signed_type_bound":
                    signed_marker = proof_signed_marker_info(expression)
                    return proof_place_root_name(signed_marker.term, 0) if signed_marker.known
                "__elisa_builtin_operator_type":
                    builtin_marker = proof_builtin_operator_marker_info(expression)
                    return proof_place_root_name(builtin_marker.term, 0) if builtin_marker.known
                "__elisa_untrusted_operator_type":
                    untrusted_marker = proof_untrusted_operator_marker_info(expression)
                    return proof_place_root_name(untrusted_marker.term, 0) if untrusted_marker.known
                "__elisa_builtin_index_type":
                    index_marker = proof_builtin_index_marker_info(expression)
                    return proof_place_root_name(index_marker.term, 0) if index_marker.known
                _:
                    pass
            # A type witness may be keyed by a place rather than a name. Retention follows the
            # root symbol of that place, so `h.part`'s witness lives and dies with `h`.
            root_name: sview = proof_type_marker_root_name(expression)
            return root_name if root_name != ""
            match expression:
                Ast::Expr.Binary(Ast::Expr.Field(place, "count", _), TokenKind.EqEq, Ast::Expr.IntLit(extent, _), _):
                    return proof_place_root_name(place, 0) if extent >= 0
                Ast::Expr.Binary(left, TokenKind.LtEq, right, _):
                    match left:
                        Ast::Expr.IntLit(value, _):
                            match right:
                                Ast::Expr.Ident(name, _):
                                    return name if value == 0
                                _:
                                    pass
                        _:
                            pass
                    match right:
                        Ast::Expr.IntLit(_, _):
                            match left:
                                Ast::Expr.Ident(name, _):
                                    return name
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return ""

        def proof_fact_is_global_mutable_array_type_fact_with_work(report: ProofReport&, expression: Ast::Expr, owner: sview, source_work: mutable usize&) -> bool:
            for trace in report.analysis_1.traces.records |expression, owner, source_work|:
                return false if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(trace.name), source_work) or not proof_type_audit_work_charge(sview_len(trace.kind), source_work)
                continue if trace.name != owner or (trace.kind != "global-mutable-array-type" and trace.kind != "global-mutable-array-index-bound")
                equal: bool = proof_replay_summary_expr_equal_with_limit(trace.expression, expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return false if not equal and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return true if equal
            return false

        def proof_fact_is_global_mutable_array_type_fact(report: ProofReport&, expression: Ast::Expr, owner: sview) -> bool:
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            proof_fact_is_global_mutable_array_type_fact_with_work(report, expression, owner, &source_work)

        def proof_global_mutable_array_index_witness_with_work(facts: darray[Ast::Expr]&, report: ProofReport&, object: Ast::Expr, owner: sview, source_work: mutable usize&) -> (complete: bool, found: bool):
            return (false, false) if not proof_replay_summary_expr_charge_with_limit(object, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            for fact in facts |report, object, owner, source_work|:
                return (false, false) if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                continue if not proof_fact_is_global_mutable_array_type_fact_with_work(report, fact, owner, &source_work)
                return (false, false) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                marker: (known: bool, term: Ast::Expr) = proof_builtin_index_marker_info(fact)
                if marker.known:
                    equal: bool = proof_replay_summary_expr_equal_with_limit(marker.term, object, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return (false, false) if not equal and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return (true, true) if equal
            return (true, false)

        def proof_fact_is_type_bound_with_work(report: ProofReport&, expression: Ast::Expr, owner: sview, source_work: mutable usize&) -> bool:
            return false if:
                report.analysis_1.type_bounds.owner != owner
                not proof_replay_summary_expr_charge_with_limit(expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            if proof_type_bound_name(expression) == "":
                enum_member: bool = proof_unique_builtin_const_enum_member_witness_with_work(expression, report, source_work)
                return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                global_array: mutable bool = false
                if not enum_member:
                    for trace in report.analysis_1.traces.records |expression, owner, source_work, global_array|:
                        return false if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(trace.name), source_work) or not proof_type_audit_work_charge(sview_len(owner), source_work) or not proof_type_audit_work_charge(sview_len(trace.kind), source_work)
                        continue if trace.name != owner or (trace.kind != "global-mutable-array-type" and trace.kind != "global-mutable-array-index-bound")
                        equal: bool = proof_replay_summary_expr_equal_with_limit(trace.expression, expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return false if not equal and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        global_array <- true if equal
                return false if not enum_member and not global_array
                for trace in report.analysis_1.traces.records |expression, owner, source_work|:
                    return false if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(trace.name), source_work) or not proof_type_audit_work_charge(sview_len(owner), source_work) or not proof_type_audit_work_charge(sview_len(trace.kind), source_work)
                    continue if trace.name != owner or (trace.kind != "type-bound" and trace.kind != "global-mutable-array-type" and trace.kind != "global-mutable-array-index-bound")
                    equal: bool = proof_replay_summary_expr_equal_with_limit(trace.expression, expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return false if not equal and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return true if equal
                return false
            # Equal terms hash alike, so an entry with another hash cannot match.
            return false if not proof_replay_summary_expr_charge_with_limit(expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            hash: u32 = proof_expr_shape_hash(expression, 0)
            indexed: bool = report.analysis_1.type_bounds.seen_hashes.count == report.analysis_1.type_bounds.seen.count
            for index in 0..<report.analysis_1.type_bounds.seen.count |index, report, expression, hash, indexed, source_work|:
                return false if not proof_type_audit_work_charge(1, source_work)
                continue if indexed and report.analysis_1.type_bounds.seen_hashes[index] != hash
                equal: bool = proof_replay_summary_expr_equal_with_limit(report.analysis_1.type_bounds.seen[index], expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return false if not equal and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return true if equal
            return false

        def proof_fact_is_type_bound(report: ProofReport&, expression: Ast::Expr, owner: sview) -> bool:
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            proof_fact_is_type_bound_with_work(report, expression, owner, &source_work)

        # A qualified module constant is immutable independently of the function's alias
        # analysis. Preserve only the exact fact that entered through the source-constant
        # boundary; replay separately resolves that trace to one immutable declaration.
        def proof_source_global_constant_term_with_work(report: ProofReport&, term: Ast::Expr, owner: sview, source_work: mutable usize&) -> bool:
            for trace in report.analysis_1.traces.records |term, owner, source_work|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(trace.name), source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(trace.kind), source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(owner), source_work)
                continue if trace.name != owner or trace.kind != "global-constant-qualified"
                match trace.expression:
                    Ast::Expr.Binary(reference, TokenKind.EqEq, Ast::Expr.IntLit(_, _), _):
                        if proof_replay_summary_expr_equal_with_limit(reference, term, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                            return true
                        if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                            return false
                    _:
                        pass
            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1 if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return false

        def proof_fact_is_source_global_constant_with_work(report: ProofReport&, expression: Ast::Expr, owner: sview, source_work: mutable usize&) -> bool:
            return false if not proof_replay_summary_expr_charge_with_limit(expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            scalar_marker: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
            saw_type_bound: mutable bool = false
            saw_qualified_constant: mutable bool = false
            for trace in report.analysis_1.traces.records |expression, owner, scalar_marker, saw_type_bound, saw_qualified_constant, source_work|:
                return false if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(trace.name), source_work) or not proof_type_audit_work_charge(sview_len(trace.kind), source_work)
                continue if trace.name != owner
                if proof_replay_summary_expr_equal_with_limit(trace.expression, expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    return true if trace.kind in {"global-constant", "global-constant-qualified"}
                    saw_type_bound <- true if trace.kind == "type-bound"
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                if trace.kind == "global-constant-qualified" and scalar_marker.known:
                    match trace.expression:
                        Ast::Expr.Binary(reference, TokenKind.EqEq, Ast::Expr.IntLit(_, _), _):
                            saw_qualified_constant <- true if proof_replay_summary_expr_equal_with_limit(reference, scalar_marker.term, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        _:
                            pass
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return saw_type_bound and saw_qualified_constant

        def proof_fact_is_source_global_constant(report: ProofReport&, expression: Ast::Expr, owner: sview) -> bool:
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            proof_fact_is_source_global_constant_with_work(report, expression, owner, &source_work)

        # Type bounds come from the compiler's variable type, not from mutable program state.
        # Preserve only those explicitly traced facts across an opaque/recursive call, and only
        # while their lexical binding is still live. Move-containing calls are excluded because
        # ownership invalidation can remove the binding itself at the statement boundary.
        def proof_restore_type_bound_facts(source: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, report: mutable ProofReport&, owner: sview) -> void:
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for fact in source |fact, facts, names, report, owner, source_work|:
                if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                bound_name: sview = proof_type_bound_name(fact)
                global_array_fact: bool = proof_fact_is_global_mutable_array_type_fact_with_work(report, fact, owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                if not global_array_fact and bound_name != "":
                    live_name: mutable bool = false
                    for candidate in names |candidate, source_work, bound_name, live_name|:
                        if not proof_replay_source_work_charge_or_exhaust(1, source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(candidate), source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(bound_name), source_work):
                            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                            return
                        live_name <- true if candidate == bound_name
                    continue if not live_name
                continue if not global_array_fact and bound_name == ""
                continue if not proof_fact_is_type_bound_with_work(report, fact, owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                present: mutable bool = false
                for existing in facts |existing, fact, report, source_work, present|:
                    equal: bool = proof_replay_summary_expr_equal_with_limit(existing, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    present <- true if equal
                if not present:
                    facts.push(fact)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work

        def proof_restore_type_bound_facts_except(source: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, report: mutable ProofReport&, owner: sview, excluded: sview) -> void:
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for fact in source |fact, facts, names, report, owner, excluded, source_work|:
                if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                bound_name: sview = proof_type_bound_name(fact)
                global_array: bool = proof_fact_is_global_mutable_array_type_fact_with_work(report, fact, owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                if global_array:
                    continue if bound_name == excluded
                    present: mutable bool = false
                    for existing in facts |existing, fact, source_work, present|:
                        present <- true if proof_replay_summary_expr_equal_with_limit(existing, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                            return
                    if not present:
                        facts.push(fact)
                    continue
                continue if bound_name == "" or bound_name == excluded
                live_name: mutable bool = false
                for candidate in names |candidate, source_work, bound_name, live_name|:
                    if not proof_replay_source_work_charge_or_exhaust(1, source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(candidate), source_work) or not proof_replay_source_work_charge_or_exhaust(sview_len(bound_name), source_work):
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    live_name <- true if candidate == bound_name
                continue if not live_name
                continue if not proof_fact_is_type_bound_with_work(report, fact, owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                present: mutable bool = false
                for existing in facts |existing, fact, source_work, present|:
                    present <- true if proof_replay_summary_expr_equal_with_limit(existing, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                if not present:
                    facts.push(fact)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work

        # An imported qualified constant, `Limits::TOP == 8`, names an immutable declaration, so a
        # call cannot falsify it; its path is no binding the stability scan can read, so it is
        # restored by its trace, with the scalar witness of the same path.
        def proof_restore_global_constant_facts(source: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview) -> void:
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for fact in source |fact, source, facts, report, owner, source_work|:
                continue if not proof_fact_is_global_constant_with_work(report, fact, owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, _, position):
                        continue if proof_ident_name(left) != ""
                        fact_present: mutable bool = false
                        for existing in facts |existing, fact, source_work, fact_present|:
                            fact_present <- true if proof_replay_summary_expr_equal_with_limit(existing, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                            if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                                return
                        facts.push(fact) if not fact_present
                        witness: Ast::Expr = proof_scalar_term_marker(left, position)
                        witness_present: mutable bool = false
                        for candidate in source |candidate, witness, source_work, witness_present|:
                            witness_present <- true if proof_replay_summary_expr_equal_with_limit(candidate, witness, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                            if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                                return
                        if witness_present:
                            duplicate: mutable bool = false
                            for existing in facts |existing, witness, source_work, duplicate|:
                                duplicate <- true if proof_replay_summary_expr_equal_with_limit(existing, witness, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                                    return
                            facts.push(witness) if not duplicate
                    _:
                        pass
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work

        # A loop or pattern binder can shadow a name while the proof state still uses source
        # spellings. Remove inherited type facts for those spellings before entering the child
        # state; otherwise an outer `0 <= i` could be applied to an unrelated signed binder.
