# Compact, exact-name index of enum declarations for structural termination discovery.
const PROOF_ENUM_INDEX_ENTRY_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET

extend ElisaProof:
    private:
        def proof_enum_index_collect(declarations: darray[Ast::Decl]&, index: mutable ProofEnumIndex&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |index, depth|:
                match declaration:
                    Ast::Decl.Enum(name, _, _, _, _):
                        return false if index.names.count >= PROOF_ENUM_INDEX_ENTRY_LIMIT
                        index.names.push(name)
                        index.name_hashes.push(proof_name_hash(name))
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_enum_index_collect(&body, index, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_enum_index_collect(&body, index, depth + 1)
                    _:
                        pass
            return true

        def proof_build_enum_index(declarations: darray[Ast::Decl]&) -> ProofEnumIndex can[Memory.Allocate, Abort.Panic]:
            index: mutable ProofEnumIndex = ProofEnumIndex{names: [], name_hashes: [], bucket_heads: [], next_indices: [], complete: false}
            return index if not proof_enum_index_collect(declarations, &index, 0)
            count: usize = index.names.count
            capacity: usize = proof_index_capacity(count)
            if capacity == 0:
                index.complete <- true
                return index
            index.bucket_heads.resize(capacity)
            index.next_indices.resize(count)
            for slot in 0..<capacity |slot, count|:
                index.bucket_heads[slot] <- count
            for entry in 0..<count |entry, index, capacity, count|:
                hash: u32 = index.name_hashes[entry]
                slot: usize = (hash.i64() % capacity.i64()).usize()
                index.next_indices[entry] <- index.bucket_heads[slot]
                index.bucket_heads[slot] <- entry
            index.complete <- true
            return index
