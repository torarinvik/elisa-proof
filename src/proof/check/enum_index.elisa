# Compact, exact-name index of enum declarations for scalar classification and structural termination discovery.
const PROOF_ENUM_INDEX_ENTRY_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET

extend ElisaProof:
    private:
        def proof_enum_index_charge_work(amount: usize, source_work: mutable usize&) -> bool:
            if not proof_replay_source_work_charge(amount, source_work):
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            true

        def proof_enum_index_collect(declarations: darray[Ast::Decl]&, index: mutable ProofEnumIndex&, source_work: mutable usize&, depth: usize, root_level: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |index, source_work, depth|:
                return false if not proof_enum_index_charge_work(1, source_work)
                match declaration:
                    Ast::Decl.Enum(name, _, is_const, _, _):
                        return false if:
                            index.names.count >= PROOF_ENUM_INDEX_ENTRY_LIMIT
                            not proof_enum_index_charge_work(sview_len(name), source_work)
                        index.names.push(name)
                        index.name_hashes.push(proof_name_hash(name))
                        index.const_enums.push(is_const)
                        index.declarations.push(declaration)
                        index.root_level.push(root_level)
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_enum_index_collect(&body, index, source_work, depth + 1, false)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_enum_index_collect(&body, index, source_work, depth + 1, root_level)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        pass
            return true

        def proof_build_enum_index(declarations: darray[Ast::Decl]&, source_work: mutable usize&) -> ProofEnumIndex can[Memory.Allocate, Abort.Panic]:
            index: mutable ProofEnumIndex = ProofEnumIndex{names: [], name_hashes: [], const_enums: [], declarations: [], root_level: [], bucket_heads: [], next_indices: [], complete: false}
            return index if not proof_enum_index_collect(declarations, &index, source_work, 0, true)
            count: usize = index.names.count
            capacity: usize = proof_index_capacity(count)
            if capacity == 0:
                index.complete <- true
                return index
            return index if:
                not proof_enum_index_charge_work(capacity, source_work)
                not proof_enum_index_charge_work(count, source_work)
            index.bucket_heads.resize(capacity)
            bucket_sizes: mutable darray[usize] = []
            bucket_sizes.resize(capacity)
            index.next_indices.resize(count)
            for slot in 0..<capacity |slot, count, bucket_sizes|:
                index.bucket_heads[slot] <- count
                bucket_sizes[slot] <- 0
            for entry in 0..<count |entry, index, capacity, count, source_work|:
                return index if not proof_enum_index_charge_work(1, source_work)
                hash: u32 = index.name_hashes[entry]
                slot: usize = (hash.i64() % capacity.i64()).usize()
                bucket_sizes[slot] <- bucket_sizes[slot] + 1
                return index if bucket_sizes[slot] > PROOF_INDEX_MAX_CHAIN
                index.next_indices[entry] <- index.bucket_heads[slot]
                index.bucket_heads[slot] <- entry
            index.complete <- true
            return index
