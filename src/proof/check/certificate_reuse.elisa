extend ElisaProof:
    private:
        const PROOF_GOAL_MEMO_LOOKBACK: usize = 128

        # Memoize only an identical goal in an identical, fully traced premise state. This is
        # deliberately stricter than logical subsumption: it preserves both completeness and
        # provenance, while avoiding repeated model searches and duplicate kernel encodings.
        # Keep the cache scoped to the arithmetic index checks that dominate replay analysis;
        # quantifier/assertion goals may depend on declaration annotations not in this key.
        def proof_reuse_goal_attempt(facts: darray[Ast::Expr]&, goal: Ast::Expr, line: u32, name: sview, rule: sview, report: mutable ProofReport&) -> (found: bool, proven: bool):
            return (false, false) if:
                report.analysis_1.kernel.budget_exhausted or report.results.goal_attempts.count == 0
                rule != "index-lower" and rule != "index-upper"
            match goal:
                Ast::Expr.Binary(_, _, _, _):
                    pass
                _:
                    return (false, false)
            return (false, false) if report.results.goal_attempts[report.results.goal_attempts.count - 1].name != name
            lookback: usize = PROOF_GOAL_MEMO_LOOKBACK if report.results.goal_attempts.count >= PROOF_GOAL_MEMO_LOOKBACK else report.results.goal_attempts.count
            start: mutable usize = report.results.goal_attempts.count - lookback
            # Bound the function-boundary scan too; scanning the complete function
            # before applying the lookback made repeated goals quadratic in its size.
            cursor: mutable usize = report.results.goal_attempts.count
            while cursor > start |cursor, start, report, name|:
                cursor <- cursor - 1
                if report.results.goal_attempts[cursor].name != name:
                    start <- cursor + 1
                    break
            for candidate_index in start..<report.results.goal_attempts.count |candidate_index, facts, goal, name, rule, report, line|:
                candidate: ProofGoalAttempt = report.results.goal_attempts[candidate_index]
                continue if candidate.name != name or candidate.rule != rule or candidate.budget_exhausted
                continue if candidate.source_phase != report.context.current_loop_invariant_phase
                continue if not proof_expr_equal(candidate.goal, goal) or candidate.kernel_goal >= report.analysis_1.kernel.nodes.count
                continue if candidate.facts_start > report.analysis_1.certificate_facts.count or candidate.facts_count > report.analysis_1.certificate_facts.count - candidate.facts_start
                continue if candidate.kernel_facts_start > report.analysis_1.kernel.certificate_facts.count or candidate.kernel_facts_count > report.analysis_1.kernel.certificate_facts.count - candidate.kernel_facts_start
                continue if candidate.facts_count != facts.count or candidate.kernel_facts_count != facts.count
                exact_state: mutable bool = true
                for offset in 0..<facts.count |offset, facts, candidate, report, name, exact_state|:
                    current_fact: Ast::Expr = facts[offset]
                    if not proof_kernel_expression_supported(current_fact) or not proof_expr_equal(current_fact, report.analysis_1.certificate_facts[candidate.facts_start + offset]):
                        exact_state <- false
                        break
                    trace_index: usize = proof_certificate_fact_trace_index(report, current_fact, name)
                    if trace_index >= report.analysis_1.traces.records.count:
                        exact_state <- false
                        break
                    trace: ProofFactTrace = report.analysis_1.traces.records[trace_index]
                    if trace.kernel_expression != report.analysis_1.kernel.certificate_facts[candidate.kernel_facts_start + offset]:
                        exact_state <- false
                        break
                if not exact_state:
                    continue
                if candidate.proven:
                    continue if not candidate.has_certificate or candidate.certificate_index >= report.analysis_1.certificates.count
                    source_certificate: ProofGoalCertificate = report.analysis_1.certificates[candidate.certificate_index]
                    continue if source_certificate.name != name or source_certificate.rule != rule or not proof_expr_equal(source_certificate.goal, candidate.goal)
                    continue if source_certificate.source_phase != candidate.source_phase
                    continue if source_certificate.facts_start != candidate.facts_start or source_certificate.facts_count != candidate.facts_count
                    continue if source_certificate.kernel_goal != candidate.kernel_goal or source_certificate.kernel_facts_start != candidate.kernel_facts_start or source_certificate.kernel_facts_count != candidate.kernel_facts_count
                    continue if not proof_kernel_report_append_allowed(report, report.analysis_1.certificates.count, 1, name)
                    continue if not proof_kernel_report_append_allowed(report, report.results.goal_attempts.count, 1, name)
                    certificate_index: usize = report.analysis_1.certificates.count
                    report.analysis_1.certificates.push(ProofGoalCertificate{goal: goal, facts_start: candidate.facts_start, facts_count: candidate.facts_count, kernel_goal: candidate.kernel_goal, kernel_facts_start: candidate.kernel_facts_start, kernel_facts_count: candidate.kernel_facts_count, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, replayed: false})
                    report.results.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: candidate.facts_start, facts_count: candidate.facts_count, kernel_goal: candidate.kernel_goal, kernel_facts_start: candidate.kernel_facts_start, kernel_facts_count: candidate.kernel_facts_count, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, proven: true, has_certificate: true, certificate_index: certificate_index})
                    return (true, true)
                if not candidate.has_certificate and proof_kernel_report_append_allowed(report, report.results.goal_attempts.count, 1, name):
                    report.results.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: candidate.facts_start, facts_count: candidate.facts_count, kernel_goal: candidate.kernel_goal, kernel_facts_start: candidate.kernel_facts_start, kernel_facts_count: candidate.kernel_facts_count, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count})
                    return (true, false)
            return (false, false)
