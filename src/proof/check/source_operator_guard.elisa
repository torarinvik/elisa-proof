extend ElisaProof:
    private:
        const PROOF_SOURCE_OPERATOR_AST_DEPTH_LIMIT: usize = 64
        const PROOF_SOURCE_OPERATOR_MASK_EMPTY: usize = 0
        const PROOF_SOURCE_OPERATOR_EQUALITY_FLAG: usize = 1
        const PROOF_SOURCE_OPERATOR_ORDERING_FLAG: usize = 2
        const PROOF_SOURCE_OPERATOR_ADDITION_FLAG: usize = 4
        const PROOF_SOURCE_OPERATOR_SUBTRACTION_FLAG: usize = 8
        const PROOF_SOURCE_OPERATOR_MULTIPLICATION_FLAG: usize = 16
        const PROOF_SOURCE_OPERATOR_DIVISION_FLAG: usize = 32
        const PROOF_SOURCE_OPERATOR_NEGATION_FLAG: usize = 64
        const PROOF_SOURCE_OPERATOR_ALL_FLAGS: usize = 127

        # The backend rewrites these source members for operators. Keep the mapping here so
        # source admission, witness lookup, and replay use one protocol-independent dispatch
        # model while compiler dispatch is being made protocol-aware.
        def proof_source_operator_dunder_mask(name: sview) -> usize:
            if name == "__eq__": return PROOF_SOURCE_OPERATOR_EQUALITY_FLAG
            if name == "__cmp__": return PROOF_SOURCE_OPERATOR_ORDERING_FLAG
            if name == "__add__": return PROOF_SOURCE_OPERATOR_ADDITION_FLAG
            if name == "__sub__": return PROOF_SOURCE_OPERATOR_SUBTRACTION_FLAG
            if name == "__mul__": return PROOF_SOURCE_OPERATOR_MULTIPLICATION_FLAG
            if name == "__div__": return PROOF_SOURCE_OPERATOR_DIVISION_FLAG
            if name == "__neg__": return PROOF_SOURCE_OPERATOR_NEGATION_FLAG
            PROOF_SOURCE_OPERATOR_MASK_EMPTY

        def proof_source_operator_mask_for_protocol(protocol: sview) -> usize:
            return when protocol:
                "Eq" -> PROOF_SOURCE_OPERATOR_EQUALITY_FLAG
                "Ord" | "Less" -> PROOF_SOURCE_OPERATOR_ORDERING_FLAG
                "Add" -> PROOF_SOURCE_OPERATOR_ADDITION_FLAG
                "Sub" -> PROOF_SOURCE_OPERATOR_SUBTRACTION_FLAG
                "Mul" -> PROOF_SOURCE_OPERATOR_MULTIPLICATION_FLAG
                "Div" -> PROOF_SOURCE_OPERATOR_DIVISION_FLAG
                "Neg" -> PROOF_SOURCE_OPERATOR_NEGATION_FLAG
                _ -> PROOF_SOURCE_OPERATOR_MASK_EMPTY

        # Classify scalar spellings for drop/effect analysis. This does not authenticate the
        # receiver type of an AST operator and must not be used to narrow the type-erased
        # operator mask below.
        def proof_source_operator_guard_primitive(concrete: sview) -> bool:
            return true if:
                concrete in {"i8", "i16", "i32", "i64", "i128", "isize", "int"}
                concrete in {"u8", "u16", "u32", "u64", "u128", "usize", "uintptr", "byte"}
            return concrete in {"f32", "f64", "bool", "char", "sview", "cstr", "dstr"}

        def proof_source_primitive_operator_overloaded_with_work(annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> (complete: bool, overloaded: bool):
            # The parser emits each impl impl_scope immediately before its concrete marker. Use that
            # source-order identity rather than matching only by line, which can repeat after an
            # include or `#line` directive.
            for annotation_index in 0..<annotations.count |annotation_index, annotations, source_work|:
                annotation: Ast::EnumAnnotation = annotations[annotation_index]
                return (false, false) if:
                    not proof_report_source_work_charge(1, source_work)
                    not proof_report_source_work_charge(sview_len(annotation.owner), source_work)
                if annotation.owner == "__ext_concrete":
                    return (false, false) if not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                    return (true, true)
                if annotation.owner == "__impl_scope":
                    return (false, false) if annotation_index + 1 >= annotations.count
                    paired_concrete: Ast::EnumAnnotation = annotations[annotation_index + 1]
                    return (false, false) if not proof_report_source_work_charge(sview_len(paired_concrete.owner), source_work) or not proof_report_source_work_charge(sview_len(paired_concrete.name), source_work)
                    return (false, false) if paired_concrete.owner != "__impl_concrete" or paired_concrete.line != annotation.line or paired_concrete.name == ""
                    return (false, false) if paired_concrete.offset != 0 and annotation.offset != 0 and paired_concrete.offset != annotation.offset
                if annotation.owner == "__impl_concrete":
                    return (false, false) if annotation_index == 0
                    impl_scope: Ast::EnumAnnotation = annotations[annotation_index - 1]
                    return (false, false) if:
                        not proof_report_source_work_charge(1, source_work)
                        not proof_report_source_work_charge(sview_len(impl_scope.owner), source_work)
                        not proof_report_source_work_charge(sview_len(impl_scope.name), source_work)
                        not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                        impl_scope.owner != "__impl_scope" or impl_scope.line != annotation.line or impl_scope.name == ""
                        impl_scope.offset != 0 and annotation.offset != 0 and impl_scope.offset != annotation.offset
                    # The compiler currently dispatches each operator to a dunder method on
                    # the concrete receiver without checking that the impl's protocol is the
                    # corresponding operator protocol. The source-neutral proof walk has no
                    # receiver types, so any impl can shadow any operator it inspects.
                    return (true, true)
            return (true, false)

        def proof_source_primitive_operator_mask_with_work(annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> (complete: bool, mask: usize):
            mask: mutable usize = PROOF_SOURCE_OPERATOR_MASK_EMPTY
            any_override: (complete: bool, overloaded: bool) = proof_source_primitive_operator_overloaded_with_work(annotations, source_work)
            return (false, mask) if not any_override.complete
            if any_override.overloaded:
                mask <- mask | PROOF_SOURCE_OPERATOR_EQUALITY_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_ORDERING_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_ADDITION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_SUBTRACTION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_MULTIPLICATION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_DIVISION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_NEGATION_FLAG
            return (true, mask)

        # Derive both masks from the already-built flat source index in one bounded pass.
        # AST-only consumers have no authenticated receiver type, so their operator mask must
        # include custom concrete implementations as well as scalar ones. The protocol mask is
        # also type-erased and remains broad for the protocol-oriented guards.
        def proof_source_operator_masks_from_index(report: ProofReport&, source_work: mutable usize&) -> (complete: bool, primitive_mask: usize, protocol_mask: usize):
            primitive_mask: mutable usize = PROOF_SOURCE_OPERATOR_MASK_EMPTY
            protocol_mask: mutable usize = PROOF_SOURCE_OPERATOR_MASK_EMPTY
            return (false, primitive_mask, protocol_mask) if not report.analysis_1.operator_impls.valid
            primitive_mask <- primitive_mask | report.analysis_1.operator_impls.global_operator_mask
            protocol_mask <- protocol_mask | report.analysis_1.operator_impls.global_operator_mask
            for implementation in report.analysis_1.operator_impls.rows |implementation, report, primitive_mask, protocol_mask, source_work|:
                return (false, primitive_mask, protocol_mask) if:
                    not proof_report_source_work_charge(1, source_work)
                    not proof_report_source_work_charge(sview_len(implementation.concrete), source_work)
                    not proof_report_source_work_charge(sview_len(implementation.protocol), source_work)
                protocol_mask <- protocol_mask | implementation.operator_mask
                # Do not narrow this mask by concrete spelling: syntax-only checks cannot
                # establish that an expression's receiver is one of the primitive types.
                primitive_mask <- primitive_mask | implementation.operator_mask
            return (true, primitive_mask, protocol_mask)

        # Report-bound analysis has already built and validated this cache from the same
        # parser-origin annotation snapshot. Reuse it instead of rescanning annotations at
        # every branch, range, or counterexample query.
        def proof_source_primitive_operator_mask_from_report_with_work(report: ProofReport&, source_work: mutable usize&) -> (complete: bool, mask: usize):
            return (false, 0) if not report.analysis_1.operator_impls.valid or not report.source.source_operator_masks_valid
            return (false, 0) if not proof_report_source_work_charge(1, source_work)
            (true, report.source.source_primitive_operator_mask)

    public:
        # Reuse the report's parser-derived operator mask in source-bound clients that already
        # own a validated ProofReport. The standalone annotation API remains available for
        # contexts without a report snapshot.
        def proof_report_primitive_operator_mask_with_work(report: ProofReport&, source_work: mutable usize&) -> (complete: bool, mask: usize):
            proof_source_primitive_operator_mask_from_report_with_work(report, source_work)

    private:

        def proof_source_primitive_operator_mask(annotations: darray[Ast::EnumAnnotation]&) -> usize:
            source_work: mutable usize = 0
            result: (complete: bool, mask: usize) = proof_source_primitive_operator_mask_with_work(annotations, &source_work)
            if not result.complete:
                mask: mutable usize = PROOF_SOURCE_OPERATOR_EQUALITY_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_ORDERING_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_ADDITION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_SUBTRACTION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_MULTIPLICATION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_DIVISION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_NEGATION_FLAG
                return mask
            return result.mask

        def proof_source_primitive_operator_mask_has(mask: usize, protocol: sview) -> bool:
            return (mask & PROOF_SOURCE_OPERATOR_EQUALITY_FLAG) != 0 if protocol == "Eq"
            return (mask & PROOF_SOURCE_OPERATOR_ORDERING_FLAG) != 0 if protocol == "Ord"
            return (mask & PROOF_SOURCE_OPERATOR_ADDITION_FLAG) != 0 if protocol == "Add"
            return (mask & PROOF_SOURCE_OPERATOR_SUBTRACTION_FLAG) != 0 if protocol == "Sub"
            return (mask & PROOF_SOURCE_OPERATOR_MULTIPLICATION_FLAG) != 0 if protocol == "Mul"
            return (mask & PROOF_SOURCE_OPERATOR_DIVISION_FLAG) != 0 if protocol == "Div"
            return (mask & PROOF_SOURCE_OPERATOR_NEGATION_FLAG) != 0 if protocol == "Neg"
            return false

        # Compound assignments lower through scalar operations or the built-in dynamic-array
        # push path. Division, remainder, and shifts remain unsupported here because semantic
        # safety diagnostics currently inspect the RHS but not the compound operator itself.
        # The source-only scanner has no receiver types, while the typed structural scanner
        # accepts only proven scalar receivers or `darray +=`.
        def proof_source_compound_assignment_protocol(operator: TokenKind) -> sview:
            return when operator:
                TokenKind.PlusEq -> "Add"
                TokenKind.MinusEq -> "Sub"
                TokenKind.StarEq -> "Mul"
                TokenKind.SlashEq | TokenKind.PercentEq -> "?"
                TokenKind.CaretEq -> "BitXor"
                TokenKind.PipeEq -> "BitOr"
                TokenKind.AmpEq -> "BitAnd"
                TokenKind.LShiftEq | TokenKind.RShiftEq -> "?"
                TokenKind.QAssign -> "?"
                TokenKind.Assign | TokenKind.LArrow -> ""
                _ -> "?"

        # Structural termination must account for implicit operator calls on user types as
        # well as primitive overrides. This broader mask is used only to reject structural
        # certificates whose call graph would omit a possible overloaded dispatch.
        def proof_source_operator_protocol_mask_add(mask: mutable usize&, protocol: sview) -> void:
            if protocol == "":
                mask <- mask | PROOF_SOURCE_OPERATOR_EQUALITY_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_ORDERING_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_ADDITION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_SUBTRACTION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_MULTIPLICATION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_DIVISION_FLAG
                mask <- mask | PROOF_SOURCE_OPERATOR_NEGATION_FLAG
            if protocol == "Eq":
                mask <- mask | PROOF_SOURCE_OPERATOR_EQUALITY_FLAG
            # Source ordering implementations use the `Less` protocol for `<`; the proof
            # fragment groups all four comparison tokens under its broader `Ord` family.
            if protocol in {"Ord", "Less"}:
                mask <- mask | PROOF_SOURCE_OPERATOR_ORDERING_FLAG
            if protocol == "Add":
                mask <- mask | PROOF_SOURCE_OPERATOR_ADDITION_FLAG
            if protocol == "Sub":
                mask <- mask | PROOF_SOURCE_OPERATOR_SUBTRACTION_FLAG
            if protocol == "Mul":
                mask <- mask | PROOF_SOURCE_OPERATOR_MULTIPLICATION_FLAG
            if protocol == "Div":
                mask <- mask | PROOF_SOURCE_OPERATOR_DIVISION_FLAG
            if protocol == "Neg":
                mask <- mask | PROOF_SOURCE_OPERATOR_NEGATION_FLAG

        # Replay rebuilds this from source annotations instead of trusting the producer's
        # operator index or the cached report mask. Any recognized impl_scope marker is enough to
        # reject a matching structural operator; pairing it to a concrete marker would add a
        # quadratic scan here and only make the replay less conservative on malformed metadata.
        def proof_source_operator_protocol_mask_with_work(annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> (complete: bool, mask: usize):
            mask: mutable usize = PROOF_SOURCE_OPERATOR_MASK_EMPTY
            for annotation in annotations |annotation, source_work, mask|:
                return (false, mask) if:
                    not proof_report_source_work_charge(1, source_work)
                    not proof_report_source_work_charge(sview_len(annotation.owner), source_work)
                if annotation.owner == "__ext_concrete":
                    return (false, mask) if not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                    proof_source_operator_protocol_mask_add(&mask, "")
                if annotation.owner == "__impl_scope":
                    return (false, mask) if not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                    proof_source_operator_protocol_mask_add(&mask, "")
            return (true, mask)

        def proof_source_statements_have_overloaded_operator(statements: darray[Ast::Stmt], operator_mask: usize, depth: usize) -> bool:
            return true if depth >= PROOF_SOURCE_OPERATOR_AST_DEPTH_LIMIT
            for statement in statements |operator_mask, depth|:
                match statement:
                    Ast::Stmt.Invalid:
                        return true
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_source_expression_has_overloaded_operator(expression, operator_mask, depth + 1)
                    Ast::Stmt.Block(_, _, _, body, _):
                        return true if proof_source_statements_have_overloaded_operator(body, operator_mask, depth + 1)
                    Ast::Stmt.VarDecl(_, type_expression, value, _):
                        return true if proof_source_expression_has_overloaded_operator(type_expression, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(value, operator_mask, depth + 1)
                    Ast::Stmt.Assign(target, assignment_operator, value, _):
                        compound_protocol: sview = proof_source_compound_assignment_protocol(assignment_operator)
                        return true if:
                            compound_protocol == "?"
                            compound_protocol != "" and proof_source_primitive_operator_mask_has(operator_mask, compound_protocol)
                            proof_source_expression_has_overloaded_operator(target, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(value, operator_mask, depth + 1)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if:
                            proof_source_expression_has_overloaded_operator(condition, operator_mask, depth + 1)
                            proof_source_statements_have_overloaded_operator(then_body, operator_mask, depth + 1) or proof_source_statements_have_overloaded_operator(else_body, operator_mask, depth + 1)
                    Ast::Stmt.While(condition, body, _):
                        return true if proof_source_expression_has_overloaded_operator(condition, operator_mask, depth + 1) or proof_source_statements_have_overloaded_operator(body, operator_mask, depth + 1)
                    Ast::Stmt.For(_, _, iterable, body, _):
                        return true if proof_source_expression_has_overloaded_operator(iterable, operator_mask, depth + 1) or proof_source_statements_have_overloaded_operator(body, operator_mask, depth + 1)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_source_expression_has_overloaded_operator(returned, operator_mask, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_source_expression_has_overloaded_operator(scrutinee, operator_mask, depth + 1)
                        for arm in arms |operator_mask, depth|:
                            return true if proof_source_expression_has_overloaded_operator(arm.guard, operator_mask, depth + 1) or proof_source_statements_have_overloaded_operator(arm.body, operator_mask, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_source_expression_has_overloaded_operator(expression, operator_mask, depth + 1)
                    Ast::Stmt.Break(_, _):
                        pass
                    Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return true
            return false

        # The operator classifier above is a full AST walk. Reserve the cost of its scan from
        # the shared source-work meter before calling it on a whole function body.
        def proof_source_operator_expression_work_charge(expression: Ast::Expr, report: mutable ProofReport&) -> bool:
            work: usize = report.source_types.source_effect_index.work.implicit_effect_work
            if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            expression_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost(expression, &expression_cost, work, 0):
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            remaining: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            if expression_cost > remaining / 2:
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            return proof_source_index_work_charge(report, expression_cost * 2)

        def proof_source_operator_body_work_charge(statements: darray[Ast::Stmt]&, report: mutable ProofReport&) -> bool:
            work: usize = report.source_types.source_effect_index.work.implicit_effect_work
            if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            body_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_body(statements, &body_cost, work, 0):
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            remaining: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            if body_cost > remaining / 2:
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            return proof_source_index_work_charge(report, body_cost * 2)

        def proof_source_index_work_charge(report: mutable ProofReport&, amount: usize) -> bool:
            return false if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if not proof_report_source_work_charge(amount, &report.source_types.source_effect_index.work.implicit_effect_work):
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            return true

        # Detect a source operator whose dispatch may differ from the proof kernel's built-in
        # interpretation. Logical connectives are intentionally not listed: they are proposition
        # constructors, while the protocols below are the value-level operators that can be
        # implemented by Elisa source code. Walk every compound AST shape accepted at the
        # certificate boundary; otherwise an overloaded child inside a record, block, or recovery
        # body could be hidden behind an innocent-looking outer term.
        def proof_source_expression_has_overloaded_operator(expression: Ast::Expr, operator_mask: usize, depth: usize) -> bool:
            return true if depth >= PROOF_SOURCE_OPERATOR_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    protocol: sview = proof_builtin_unary_operator_protocol(operator)
                    return true if protocol != "" and proof_source_primitive_operator_mask_has(operator_mask, protocol)
                    return proof_source_expression_has_overloaded_operator(operand, operator_mask, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    protocol: sview = proof_builtin_operator_protocol(operator)
                    return true if protocol != "" and proof_source_primitive_operator_mask_has(operator_mask, protocol)
                    return proof_source_expression_has_overloaded_operator(left, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(right, operator_mask, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_source_expression_has_overloaded_operator(inner, operator_mask, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_source_expression_has_overloaded_operator(callee, operator_mask, depth + 1)
                    for argument in arguments |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(argument, operator_mask, depth + 1)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_source_expression_has_overloaded_operator(object, operator_mask, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_source_expression_has_overloaded_operator(base, operator_mask, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_source_expression_has_overloaded_operator(object, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(index, operator_mask, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_source_expression_has_overloaded_operator(object, operator_mask, depth + 1)
                    for argument in arguments |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(argument, operator_mask, depth + 1)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_source_expression_has_overloaded_operator(object, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(low, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(high, operator_mask, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_source_expression_has_overloaded_operator(condition, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(then_expression, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(else_expression, operator_mask, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_source_expression_has_overloaded_operator(base, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(predicate, operator_mask, depth + 1)
                Ast::Expr.Move(operand, _):
                    return proof_source_expression_has_overloaded_operator(operand, operator_mask, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_source_expression_has_overloaded_operator(operand, operator_mask, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_source_expression_has_overloaded_operator(iterable, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(condition, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(body, operator_mask, depth + 1)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_source_expression_has_overloaded_operator(guarded, operator_mask, depth + 1) or proof_source_statements_have_overloaded_operator(recovery, operator_mask, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(element, operator_mask, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(element, operator_mask, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(element, operator_mask, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(entry.key, operator_mask, depth + 1) or proof_source_expression_has_overloaded_operator(entry.value, operator_mask, depth + 1)
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    return true if proof_source_expression_has_overloaded_operator(type_expression, operator_mask, depth + 1)
                    for field in fields |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(field.value, operator_mask, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_source_expression_has_overloaded_operator(base, operator_mask, depth + 1)
                    for field in fields |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(field.value, operator_mask, depth + 1)
                    return false
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_source_expression_has_overloaded_operator(scrutinee, operator_mask, depth + 1)
                    for arm in arms |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(arm.guard, operator_mask, depth + 1) or proof_source_statements_have_overloaded_operator(arm.body, operator_mask, depth + 1)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_source_expression_has_overloaded_operator(guarded, operator_mask, depth + 1)
                    for arm in arms |operator_mask, depth|:
                        return true if proof_source_expression_has_overloaded_operator(arm.guard, operator_mask, depth + 1) or proof_source_statements_have_overloaded_operator(arm.body, operator_mask, depth + 1)
                    return false
                Ast::Expr.Lambda(_, body, _):
                    return proof_source_statements_have_overloaded_operator(body, operator_mask, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return true if proof_source_statements_have_overloaded_operator(statements, operator_mask, depth + 1)
                    return proof_source_expression_has_overloaded_operator(value, operator_mask, depth + 1)
                Ast::Expr.IntLit(_, _):
                    return false
                Ast::Expr.BoolLit(_, _):
                    return false
                Ast::Expr.FloatLit(_, _):
                    return false
                Ast::Expr.StringLit(_, _):
                    return false
                Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.Ident(_, _):
                    return false
                Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Absent:
                    return false
                _:
                    # Unknown or newly added expression shapes are not safe to classify as
                    # source-neutral. The proof kernel may reject them later, but this guard must
                    # not silently permit a future compound form to hide an overloaded child.
                    return true

        def proof_source_expression_has_overloaded_operator_in_source(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, depth: usize) -> bool:
            operator_mask: usize = proof_source_primitive_operator_mask(annotations)
            return proof_source_expression_has_overloaded_operator(expression, operator_mask, depth)

        def proof_source_arithmetic_operator_guard(goal: Ast::Expr, facts: darray[Ast::Expr]&, operator_mask: usize) -> bool:
            return false if proof_source_expression_has_overloaded_operator(goal, operator_mask, 0)
            for fact in facts |operator_mask|:
                return false if proof_source_expression_has_overloaded_operator(fact, operator_mask, 0)
            return true

        def proof_source_integer_conversion_evidence_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, integer: bool, has_width: bool):
            can Abort.Panic:
                expression_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
                return (false, false, false) if not expression_cost.complete
                markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                return (false, false, false) if not markers_result.complete
                marker_scan: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, budget, exhausted)
                return (false, false, false) if not marker_scan.complete
                fact_scan_cost: mutable usize = 0
                for fact in facts |fact, fact_scan_cost, budget, exhausted|:
                    cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                    return (false, false, false) if not cost.complete
                    if fact_scan_cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                        budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                        exhausted <- true
                        return (false, false, false)
                    remaining: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_scan_cost
                    if cost.cost >= remaining:
                        budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                        exhausted <- true
                        return (false, false, false)
                    fact_scan_cost <- fact_scan_cost + cost.cost + 1
                integer_term: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(expression, facts, markers_result.witnesses, marker_scan.scale, fact_scan_cost, 0, budget, exhausted)
                return (false, false, false) if not integer_term.complete
                return (true, false, false) if not integer_term.integer
                signed_width: i64 = proof_signed_width_in_expression_with_scale_work(expression, markers_result.witnesses, 0, marker_scan.scale, budget, exhausted)
                return (false, false, false) if proof_goal_bool_ref_value(exhausted)
                unsigned_width: i64 = proof_unsigned_width_in_expression_with_work(expression, markers_result.witnesses, budget, exhausted)
                return (false, false, false) if proof_goal_bool_ref_value(exhausted)
                return (true, true, signed_width > 0 or unsigned_width > 0)

extend ElisaProof:
    public:
        # Cross-module callers that admit source-bound tactic inputs need the same operator
        # boundary as the checker, without depending on this file's private recursive walker.
        def proof_source_tactic_expression_has_overloaded_operator(expression: Ast::Expr, operator_mask: usize) -> bool:
            proof_source_expression_has_overloaded_operator(expression, operator_mask, 0)
