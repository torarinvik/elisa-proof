extend ElisaProof:
    private:
        def proof_guard_call_summary_work_charge(amount: usize, work: mutable usize&) -> bool:
            return false if work > PROOF_MATCH_LOWERING_WORK_LIMIT
            if amount > PROOF_MATCH_LOWERING_WORK_LIMIT - work:
                work <- PROOF_MATCH_LOWERING_WORK_LIMIT + 1
                return false
            work <- work + amount
            true

        def proof_guard_call_summary_exhaust(work: mutable usize&) -> bool:
            work <- PROOF_MATCH_LOWERING_WORK_LIMIT + 1
            false

        def proof_guard_call_summary_measure_expression(expression: Ast::Expr, cost: mutable usize&, work: mutable usize&) -> bool:
            return false if work > PROOF_MATCH_LOWERING_WORK_LIMIT
            if not proof_replay_summary_expr_cost_with_limit(expression, &cost, work, PROOF_MATCH_LOWERING_WORK_LIMIT):
                work <- PROOF_MATCH_LOWERING_WORK_LIMIT + 1
                return false
            true

        def proof_guard_call_summary_seen(expression: Ast::Expr, summary_facts: darray[Ast::Expr]&, work: mutable usize&) -> (complete: bool, duplicate: bool):
            duplicate: mutable bool = false
            for existing in summary_facts |expression, work, duplicate|:
                equal: bool = proof_replay_summary_expr_proof_equal_with_limit(existing, expression, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                if not equal and work >= PROOF_MATCH_LOWERING_WORK_LIMIT:
                    work <- PROOF_MATCH_LOWERING_WORK_LIMIT + 1
                    return (false, false)
                if equal:
                    duplicate <- true
                    break
            (work <= PROOF_MATCH_LOWERING_WORK_LIMIT, duplicate)

        def proof_guard_call_summary_charge_name_search(expression: Ast::Expr, target: sview, work: mutable usize&) -> bool:
            cost: mutable usize = 0
            return false if not proof_guard_call_summary_measure_expression(expression, &cost, work)
            multiplier: usize = sview_len(target) + 2
            return false if work > PROOF_MATCH_LOWERING_WORK_LIMIT
            return proof_guard_call_summary_exhaust(work) if multiplier == 0 or cost > (PROOF_MATCH_LOWERING_WORK_LIMIT - work) / multiplier
            proof_guard_call_summary_work_charge(cost * multiplier, work)

        # Purity traversal resolves calls through the indexed function resolver. Reserve
        # bounded AST passes here, then charge the resolver's actual probe work at the call site.
        def proof_guard_call_summary_charge_purity(expression: Ast::Expr, work: mutable usize&) -> bool:
            cost: mutable usize = 0
            return false if not proof_guard_call_summary_measure_expression(expression, &cost, work)
            multiplier: usize = 4
            return false if work > PROOF_MATCH_LOWERING_WORK_LIMIT
            return proof_guard_call_summary_exhaust(work) if cost > (PROOF_MATCH_LOWERING_WORK_LIMIT - work) / multiplier
            proof_guard_call_summary_work_charge(cost * multiplier, work)

        # `proof_add_function_summary_fact` repeats freshness, call-purity, and kernel-support
        # scans after summary construction. Reserve those AST passes before entering the shared
        # helper; charge exact indexed callee-resolution probes from its shared resolver meter.
        def proof_guard_call_summary_charge_fact_admission(expression: Ast::Expr, arguments: darray[Ast::Expr]&, require_goal_ids: darray[usize]&, report: ProofReport&, work: mutable usize&) -> bool:
            expression_cost: mutable usize = 0
            return false if not proof_guard_call_summary_measure_expression(expression, &expression_cost, work)
            # The ensure also serves as the result value: reserve its freshness, purity,
            # result, and kernel-support traversals, plus the cost-measurement pass.
            expression_multiplier: usize = 8
            return false if work > PROOF_MATCH_LOWERING_WORK_LIMIT
            return proof_guard_call_summary_exhaust(work) if expression_cost > (PROOF_MATCH_LOWERING_WORK_LIMIT - work) / expression_multiplier
            return false if not proof_guard_call_summary_work_charge(expression_cost * expression_multiplier, work)
            # Mapped argument freshness follows a separate `has_call` scan.
            argument_multiplier: usize = 3
            for argument in arguments |argument, work|:
                argument_cost: mutable usize = 0
                return false if not proof_guard_call_summary_measure_expression(argument, &argument_cost, work)
                return false if work > PROOF_MATCH_LOWERING_WORK_LIMIT
                return proof_guard_call_summary_exhaust(work) if argument_cost > (PROOF_MATCH_LOWERING_WORK_LIMIT - work) / argument_multiplier
                return false if not proof_guard_call_summary_work_charge(argument_cost * argument_multiplier, work)
            row_work: mutable usize = 8
            return proof_guard_call_summary_exhaust(work) if arguments.count > (PROOF_MATCH_LOWERING_WORK_LIMIT - row_work) / 2
            row_work <- row_work + arguments.count * 2
            return proof_guard_call_summary_exhaust(work) if require_goal_ids.count > PROOF_MATCH_LOWERING_WORK_LIMIT - row_work
            row_work <- row_work + require_goal_ids.count
            threaded_count: usize = report.threading.summary_threaded_symbols.count
            return proof_guard_call_summary_exhaust(work) if threaded_count > (PROOF_MATCH_LOWERING_WORK_LIMIT - row_work) / 2
            row_work <- row_work + threaded_count * 2
            return false if not proof_guard_call_summary_work_charge(row_work, work)
            true

        def proof_guard_call_summary_map_arguments(parameters: darray[sview]&, has_defaults: darray[bool]&, defaults: darray[Ast::Expr]&, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, work: mutable usize&) -> bool:
            mapped.clear()
            return false if argument_names.count != 0 and argument_names.count != arguments.count
            return false if:
                not proof_guard_call_summary_work_charge(parameters.count, work)
                not proof_guard_call_summary_work_charge(arguments.count, work)
                not proof_guard_call_summary_work_charge(argument_names.count, work)
            used: mutable darray[bool] = []
            for parameter in parameters |mapped, used, work|:
                return false if not proof_guard_call_summary_work_charge(1, work)
                mapped.push(Ast::Expr.Absent)
                used.push(false)
            saw_named: mutable bool = false
            next_positional: mutable usize = 0
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, parameters, mapped, used, saw_named, next_positional, work|:
                label: sview = argument_names[argument_index] if argument_names.count == arguments.count else ""
                return false if not proof_guard_call_summary_work_charge(sview_len(label), work)
                parameter_index: mutable usize = parameters.count
                if label == "":
                    return false if saw_named
                    while next_positional < parameters.count |next_positional, used, work|:
                        return false if not proof_guard_call_summary_work_charge(1, work)
                        break if not used[next_positional]
                        next_positional <- next_positional + 1
                    return false if next_positional >= parameters.count
                    parameter_index <- next_positional
                    next_positional <- next_positional + 1
                else:
                    saw_named <- true
                    for candidate in 0..<parameters.count |candidate, parameters, label, parameter_index, work|:
                        return false if not proof_guard_call_summary_work_charge(1, work)
                        return false if not proof_guard_call_summary_work_charge(sview_len(label), work)
                        return false if not proof_guard_call_summary_work_charge(sview_len(parameters[candidate]), work)
                        if parameters[candidate] == label:
                            parameter_index <- candidate
                            break
                    return false if parameter_index >= parameters.count
                return false if used[parameter_index]
                mapped[parameter_index] <- arguments[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameters.count |parameter_index, used, parameters, has_defaults, defaults, mapped, functions, work|:
                return false if not proof_guard_call_summary_work_charge(1, work)
                if not used[parameter_index]:
                    return false if parameter_index >= has_defaults.count or parameter_index >= defaults.count or not has_defaults[parameter_index]
                    default_expression: Ast::Expr = defaults[parameter_index]
                    return false if not proof_expr_supported_with_work(default_expression, work)
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(default_expression, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT) or proof_expr_has_old(default_expression)
                    if parameter_index + 1 < parameters.count:
                        for later_index in parameter_index + 1..<parameters.count |later_index, parameters, default_expression, work|:
                            return false if not proof_guard_call_summary_charge_name_search(default_expression, parameters[later_index], work)
                            return false if proof_expr_mentions_name(default_expression, parameters[later_index])
                    resolved_default: Ast::Expr = proof_substitute_with_work(default_expression, parameters, mapped, work)
                    return false if proof_expr_is_invalid(resolved_default) or not proof_expr_supported_with_work(resolved_default, work)
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(resolved_default, 2, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if proof_expr_has_old(resolved_default)
                    has_call: bool = proof_expr_has_call(resolved_default)
                    if has_call:
                        return false if not proof_guard_call_summary_charge_purity(resolved_default, work)
                        lookup_work_before: usize = functions.lookup.work.module_resolution_work_used
                        pure_calls: bool = proof_contract_calls_are_pure(resolved_default, functions)
                        lookup_work_after: usize = functions.lookup.work.module_resolution_work_used
                        return false if lookup_work_after < lookup_work_before or not proof_guard_call_summary_work_charge(lookup_work_after - lookup_work_before, work)
                        return false if not pure_calls
                    mapped[parameter_index] <- resolved_default
                    used[parameter_index] <- true
            true

        # A short-circuit guard runs before its right operand, so every call the guard always
        # evaluates has returned by the time the operand runs. `live(t, s) and t.flags[s]` needs
        # the callee's summary `not live(t, s) or s < CAP` beside the guard itself; the statement
        # records that summary only after the whole expression, which is too late for the operand.
        # Only calls on the guard's unconditional path qualify: the right operand of a nested
        # `and`/`or`/`else` may not run, and neither may its callee's postcondition.
        def proof_add_guard_call_summaries(guard: Ast::Expr, facts: darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, annotations: darray[Ast::EnumAnnotation]&, guarded_facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, line: u32, depth: usize) -> bool can[Global{Read,Write}]:
            # Share one ceiling across all guards in this report. Otherwise many small guard
            # expressions could each spend the full substitution and summary budget.
            work: mutable usize = report.analysis_1.budgets.guard_call_summary_source_work
            (proof_add_guard_call_summaries_with_work(guard, facts, functions, annotations, guarded_facts, report, owner, depth, &work) can Global{Read,Write})
            report.analysis_1.budgets.guard_call_summary_source_work <- work
            if work > PROOF_MATCH_LOWERING_WORK_LIMIT and not report.analysis_1.budgets.guard_call_summary_reported:
                report.analysis_1.budgets.guard_call_summary_reported <- true
                proof_add_budget_finding(report, "resource-analysis-budget", line, owner, "guard call-summary expansion exceeded its shared source-work budget", "guard-call-summary-source-work", work, PROOF_MATCH_LOWERING_WORK_LIMIT)
            work <= PROOF_MATCH_LOWERING_WORK_LIMIT

        def proof_add_guard_call_summaries_with_work(guard: Ast::Expr, facts: darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, annotations: darray[Ast::EnumAnnotation]&, guarded_facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, depth: usize, work: mutable usize&) -> void can[Global{Read,Write}]:
            return if depth >= 16 or not proof_guard_call_summary_work_charge(1, work)
            match guard:
                Ast::Expr.Paren(inner, _):
                    (proof_add_guard_call_summaries_with_work(inner, facts, functions, annotations, guarded_facts, report, owner, depth + 1, work) can Global{Read,Write})
                Ast::Expr.Unary(_, operand, _):
                    (proof_add_guard_call_summaries_with_work(operand, facts, functions, annotations, guarded_facts, report, owner, depth + 1, work) can Global{Read,Write})
                Ast::Expr.Binary(left, operator, right, _):
                    (proof_add_guard_call_summaries_with_work(left, facts, functions, annotations, guarded_facts, report, owner, depth + 1, work) can Global{Read,Write})
                    if operator != TokenKind.And and operator != TokenKind.Or and operator != TokenKind.Else:
                        (proof_add_guard_call_summaries_with_work(right, facts, functions, annotations, guarded_facts, report, owner, depth + 1, work) can Global{Read,Write})
                Ast::Expr.Call(_, arguments, _, _):
                    return if not proof_guard_call_summary_work_charge(arguments.count, work)
                    for argument in arguments |facts, functions, annotations, guarded_facts, report, owner, depth, work|:
                        (proof_add_guard_call_summaries_with_work(argument, facts, functions, annotations, guarded_facts, report, owner, depth + 1, work) can Global{Read,Write})
                    (proof_add_call_summary_facts(guard, facts, functions, annotations, guarded_facts, report, owner, work) can Global{Read,Write})
                _:
                    pass

        # Every ensure of a verified pure callee whose requires hold at the guard, instantiated
        # with the call itself as `result`. Each fact is a function-summary trace, so replay
        # re-derives it from the callee's contract and the recorded precondition goals.
        def proof_add_call_summary_facts(expression: Ast::Expr, facts: darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, annotations: darray[Ast::EnumAnnotation]&, summary_facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, work: mutable usize&) -> void can[Global{Read,Write}]:
            return if not proof_guard_call_summary_work_charge(1, work)
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    function_name: sview = proof_callable_name(callee)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    return if function_name == "" or function_index >= functions.lookup.source.names.count
                    return if function_index >= functions.summaries.pure.count or not functions.summaries.pure[function_index]
                    return if function_index >= functions.summaries.verified.count or not functions.summaries.verified[function_index]
                    return if function_index >= functions.parameters.metadata.param_counts.count or arguments.count > functions.parameters.metadata.param_counts[function_index]
                    return if function_index >= functions.parameters.metadata.param_starts.count
                    parameter_count: usize = functions.parameters.metadata.param_counts[function_index]
                    parameter_start: usize = functions.parameters.metadata.param_starts[function_index]
                    return if:
                        parameter_start > functions.parameters.metadata.all_params.count
                        parameter_count > functions.parameters.metadata.all_params.count - parameter_start
                        parameter_start > functions.parameters.metadata.all_has_defaults.count
                        parameter_count > functions.parameters.metadata.all_has_defaults.count - parameter_start
                        parameter_start > functions.parameters.metadata.all_defaults.count
                        parameter_count > functions.parameters.metadata.all_defaults.count - parameter_start
                    return if:
                        not proof_guard_call_summary_work_charge(parameter_count, work)
                        not proof_guard_call_summary_work_charge(parameter_count, work)
                    parameter_names: mutable darray[sview] = []
                    for parameter_index in 0..<functions.parameters.metadata.param_counts[function_index] |parameter_names, functions, parameter_start|:
                        parameter_names.push(functions.parameters.metadata.all_params[parameter_start + parameter_index])
                    default_flags: mutable darray[bool] = []
                    default_values: mutable darray[Ast::Expr] = []
                    for parameter_index in 0..<functions.parameters.metadata.param_counts[function_index] |default_flags, default_values, functions, parameter_start|:
                        default_flags.push(functions.parameters.metadata.all_has_defaults[parameter_start + parameter_index])
                        default_values.push(functions.parameters.metadata.all_defaults[parameter_start + parameter_index])
                    mapped_arguments: mutable darray[Ast::Expr] = []
                    return if not proof_guard_call_summary_map_arguments(parameter_names, default_flags, default_values, arguments, argument_names, &mapped_arguments, functions, work)
                    requires_start: usize = functions.contracts.obligations.requires_starts[function_index] if function_index < functions.contracts.obligations.requires_starts.count else functions.contracts.obligations.all_requires.count
                    requires_count: usize = functions.contracts.obligations.requires_counts[function_index] if function_index < functions.contracts.obligations.requires_counts.count else 0
                    return if requires_start > functions.contracts.obligations.all_requires.count or requires_count > functions.contracts.obligations.all_requires.count - requires_start
                    return if not proof_guard_call_summary_work_charge(requires_count, work)
                    require_goal_ids: mutable darray[usize] = []
                    for requires_index in 0..<requires_count |requires_index, functions, requires_start, parameter_names, mapped_arguments, facts, annotations, report, position, owner, require_goal_ids, work|:
                        required: Ast::Expr = proof_substitute_with_work(functions.contracts.obligations.all_requires[requires_start + requires_index], parameter_names, mapped_arguments, work)
                        return if proof_expr_is_invalid(required) or not proof_replay_summary_expr_repeat_charge_with_limit(required, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT) or proof_expr_has_old(required)
                        return if not proof_guard_call_summary_work_charge(1, work)
                        required_proven: bool = (proof_certify_goal(facts, required, report, position.line, owner, annotations) can Global{Read,Write})
                        require_goal_ids.push(report.results.goal_attempts.count - 1) if report.results.goal_attempts.count > 0
                        return if not required_proven
                    ensures_start: usize = functions.contracts.obligations.ensure_starts[function_index] if function_index < functions.contracts.obligations.ensure_starts.count else functions.contracts.obligations.all_ensures.count
                    ensures_count: usize = functions.contracts.obligations.ensure_counts[function_index] if function_index < functions.contracts.obligations.ensure_counts.count else 0
                    return if ensures_start > functions.contracts.obligations.all_ensures.count or ensures_count > functions.contracts.obligations.all_ensures.count - ensures_start
                    return if not proof_guard_call_summary_work_charge(ensures_count, work)
                    result_name: darray[sview] = ["result"]
                    result_value: darray[Ast::Expr] = [expression]
                    for ensures_index in 0..<ensures_count |ensures_index, functions, ensures_start, parameter_names, mapped_arguments, result_name, result_value, expression, summary_facts, report, position, owner, function_name, require_goal_ids, work|:
                        ensured: Ast::Expr = proof_substitute_with_work(functions.contracts.obligations.all_ensures[ensures_start + ensures_index], parameter_names, mapped_arguments, work)
                        return if proof_expr_is_invalid(ensured) or not proof_replay_summary_expr_repeat_charge_with_limit(ensured, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                        continue if proof_expr_has_old(ensured)
                        instantiated: Ast::Expr = proof_substitute_with_work(ensured, result_name, result_value, work)
                        return if proof_expr_is_invalid(instantiated)
                        seen: (complete: bool, duplicate: bool) = proof_guard_call_summary_seen(instantiated, summary_facts, work)
                        return if not seen.complete
                        continue if seen.duplicate
                        return if not proof_guard_call_summary_charge_fact_admission(instantiated, mapped_arguments, require_goal_ids, report, work)
                        return if not proof_guard_call_summary_work_charge(1, work)
                        lookup_work_before: usize = functions.lookup.work.module_resolution_work_used
                        proof_add_function_summary_fact(summary_facts, report, functions, instantiated, position.line, owner, function_name, parameter_names, mapped_arguments, expression, require_goal_ids, ensures_index, false, Ast::Expr.Absent, functions.lookup.source.lines[function_index] if function_index < functions.lookup.source.lines.count else 0, position)
                        lookup_work_after: usize = functions.lookup.work.module_resolution_work_used
                        return if lookup_work_after < lookup_work_before or not proof_guard_call_summary_work_charge(lookup_work_after - lookup_work_before, work)
                _:
                    pass
