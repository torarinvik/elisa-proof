# Exact generic binder lookup by declaration line, owner source offset, and spelling.
extend ElisaProof:
    private:
        const PROOF_SOURCE_GENERIC_OWNER_PARAM_BOUND_LINE_FLAG: u32 = 2147483648

        def proof_source_generic_owner_param_line(encoded_line: u32) -> u32:
            return encoded_line if encoded_line < PROOF_SOURCE_GENERIC_OWNER_PARAM_BOUND_LINE_FLAG else encoded_line - PROOF_SOURCE_GENERIC_OWNER_PARAM_BOUND_LINE_FLAG

        def proof_source_generic_owner_param_key_hash(line: u32, owner_offset: u32, name: sview) -> u32:
            hash: u32 = proof_expr_shape_mix(proof_name_hash(name), line.i64())
            proof_expr_shape_mix(hash, owner_offset.i64())

        def proof_source_generic_owner_arity_hash(line: u32, owner_offset: u32) -> u32:
            # Binder coordinates are the complete key; avoid rescanning a fixed textual
            # salt for every generic row during this bounded index build.
            proof_expr_shape_mix(line, owner_offset.i64())

        def proof_source_generic_owner_arity_index_clear(generics: mutable ProofSourceEffectIndexGenerics&):
            generics.generic_owner_arity_index_hashes.clear()
            generics.generic_owner_arity_index_values.clear()
            generics.generic_owner_arity_index_counts.clear()
            generics.generic_owner_arity_index_lines.clear()
            generics.generic_owner_arity_index_offsets.clear()
            generics.generic_owner_arity_index_formal_counts.clear()
            generics.generic_owner_arity_index_entries <- 0
            generics.generic_owner_arity_index_formal_rows <- 0
            generics.generic_owner_arity_index_source_rows <- 0
            generics.generic_owner_arity_index_valid <- false

        # Aggregate source generic rows by exact binder identity once. Nominal declaration
        # collection then performs bounded hash lookups instead of rescanning every generic
        # row for every struct or enum.
        def proof_source_generic_owner_arity_index_build(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            generics: mutable ProofSourceEffectIndexGenerics& = &report.source_types.source_effect_index.generics
            source_rows: usize = report.source_types.source_generic_param_lines.count
            names_count: usize = report.source_types.source_generic_param_names.count
            offsets_count: usize = report.source_types.source_generic_param_owner_offsets.count
            if not report.source_types.source_generic_owner_params_valid or source_rows != names_count or source_rows != offsets_count:
                proof_source_generic_owner_arity_index_clear(generics)
                return true
            if generics.generic_owner_arity_index_valid and generics.generic_owner_arity_index_source_rows == source_rows:
                cached_entries: usize = generics.generic_owner_arity_index_entries
                cached_formal_rows: usize = generics.generic_owner_arity_index_formal_rows
                cached_capacity: usize = proof_name_index_capacity(cached_formal_rows)
                return true if:
                    cached_entries <= cached_formal_rows
                    (cached_formal_rows == 0 and cached_entries == 0) or (cached_formal_rows > 0 and cached_entries > 0)
                    generics.generic_owner_arity_index_hashes.count == cached_capacity
                    generics.generic_owner_arity_index_values.count == cached_capacity
                    generics.generic_owner_arity_index_counts.count == cached_capacity
                    generics.generic_owner_arity_index_lines.count == cached_formal_rows
                    generics.generic_owner_arity_index_offsets.count == cached_formal_rows
                    generics.generic_owner_arity_index_formal_counts.count == cached_formal_rows
            proof_source_generic_owner_arity_index_clear(generics)
            formal_rows: mutable usize = 0
            for row in 0..<source_rows |row, report, formal_rows, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                encoded_line: u32 = report.source_types.source_generic_param_lines[row]
                continue if encoded_line >= PROOF_SOURCE_GENERIC_OWNER_PARAM_BOUND_LINE_FLAG
                name: sview = report.source_types.source_generic_param_names[row]
                return false if encoded_line == 0 or name == "" or not proof_report_source_work_charge(sview_len(name), source_work)
                formal_rows <- formal_rows + 1
            capacity: usize = proof_name_index_capacity(formal_rows)
            if formal_rows == 0:
                proof_source_generic_owner_arity_index_clear(generics)
                generics.generic_owner_arity_index_source_rows <- source_rows
                generics.generic_owner_arity_index_valid <- true
                return true
            return false if capacity == 0
            return false if not proof_report_source_work_charge(capacity, source_work) or not proof_report_source_work_charge(capacity, source_work) or not proof_report_source_work_charge(capacity, source_work) or not proof_report_source_work_charge(formal_rows, source_work) or not proof_report_source_work_charge(formal_rows, source_work) or not proof_report_source_work_charge(formal_rows, source_work)
            generics.generic_owner_arity_index_hashes.resize(capacity)
            generics.generic_owner_arity_index_values.resize(capacity)
            generics.generic_owner_arity_index_counts.resize(capacity)
            generics.generic_owner_arity_index_lines.resize(formal_rows)
            generics.generic_owner_arity_index_offsets.resize(formal_rows)
            generics.generic_owner_arity_index_formal_counts.resize(formal_rows)
            for slot in 0..<capacity |slot, generics, formal_rows|:
                generics.generic_owner_arity_index_values[slot] <- formal_rows
                generics.generic_owner_arity_index_counts[slot] <- 0
            entries: mutable usize = 0
            for row in 0..<source_rows |row, report, generics, formal_rows, capacity, source_work, entries|:
                return false if not proof_report_source_work_charge(1, source_work)
                encoded_line: u32 = report.source_types.source_generic_param_lines[row]
                continue if encoded_line >= PROOF_SOURCE_GENERIC_OWNER_PARAM_BOUND_LINE_FLAG
                line: u32 = encoded_line
                offset: u32 = report.source_types.source_generic_param_owner_offsets[row]
                hash: u32 = proof_source_generic_owner_arity_hash(line, offset)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, line, offset, generics, formal_rows, capacity, source_work, entries, placed|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = generics.generic_owner_arity_index_values[slot]
                    if current == formal_rows:
                        return false if entries >= formal_rows or not proof_report_source_work_charge(3, source_work)
                        generics.generic_owner_arity_index_hashes[slot] <- hash
                        generics.generic_owner_arity_index_values[slot] <- entries
                        generics.generic_owner_arity_index_counts[slot] <- 1
                        generics.generic_owner_arity_index_lines[entries] <- line
                        generics.generic_owner_arity_index_offsets[entries] <- offset
                        generics.generic_owner_arity_index_formal_counts[entries] <- 1
                        entries <- entries + 1
                        placed <- true
                        break
                    return false if current >= entries
                    if generics.generic_owner_arity_index_hashes[slot] == hash:
                        return false if not proof_report_source_work_charge(2, source_work)
                        if generics.generic_owner_arity_index_lines[current] == line and generics.generic_owner_arity_index_offsets[current] == offset:
                            return false if generics.generic_owner_arity_index_formal_counts[current] == formal_rows
                            generics.generic_owner_arity_index_formal_counts[current] <- generics.generic_owner_arity_index_formal_counts[current] + 1
                            generics.generic_owner_arity_index_counts[slot] <- generics.generic_owner_arity_index_counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(generics.generic_owner_arity_index_values, formal_rows, source_work)
            return false if not cluster.complete or not cluster.bounded or entries > formal_rows
            generics.generic_owner_arity_index_entries <- entries
            generics.generic_owner_arity_index_formal_rows <- formal_rows
            generics.generic_owner_arity_index_source_rows <- source_rows
            generics.generic_owner_arity_index_valid <- true
            return true

        def proof_source_generic_owner_arity_lookup(line: u32, offset: u32, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, found: bool, arity: usize):
            generics: ProofSourceEffectIndexGenerics& = report.source_types.source_effect_index.generics
            return (false, false, 0) if line == 0 or not generics.generic_owner_arity_index_valid
            formal_rows: usize = generics.generic_owner_arity_index_formal_rows
            entries: usize = generics.generic_owner_arity_index_entries
            capacity: usize = proof_name_index_capacity(formal_rows)
            return (false, false, 0) if entries > formal_rows or generics.generic_owner_arity_index_source_rows != report.source_types.source_generic_param_lines.count or generics.generic_owner_arity_index_lines.count != formal_rows or generics.generic_owner_arity_index_offsets.count != formal_rows or generics.generic_owner_arity_index_formal_counts.count != formal_rows or generics.generic_owner_arity_index_hashes.count != capacity or generics.generic_owner_arity_index_values.count != capacity or generics.generic_owner_arity_index_counts.count != capacity
            return (true, false, 0) if formal_rows == 0
            return (false, false, 0) if entries == 0 or capacity == 0
            return (false, false, 0) if not proof_report_source_work_charge(1, source_work)
            wanted_hash: u32 = proof_source_generic_owner_arity_hash(line, offset)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, line, offset, generics, entries, formal_rows, capacity, source_work|:
                return (false, false, 0) if not proof_report_source_work_charge(1, source_work)
                current: usize = generics.generic_owner_arity_index_values[slot]
                return (true, false, 0) if current == formal_rows
                return (false, false, 0) if current >= entries or generics.generic_owner_arity_index_counts[slot] == 0
                if generics.generic_owner_arity_index_hashes[slot] == wanted_hash:
                    return (false, false, 0) if not proof_report_source_work_charge(2, source_work)
                    if generics.generic_owner_arity_index_lines[current] == line and generics.generic_owner_arity_index_offsets[current] == offset:
                        return (false, false, 0) if generics.generic_owner_arity_index_formal_counts[current] == 0 or generics.generic_owner_arity_index_formal_counts[current] != generics.generic_owner_arity_index_counts[slot]
                        return (true, true, generics.generic_owner_arity_index_formal_counts[current])
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, 0)

        def proof_source_generic_owner_param_index_clear(generics: mutable ProofSourceEffectIndexGenerics&):
            generics.generic_param_owner_row_index_hashes.clear()
            generics.generic_param_owner_row_index_values.clear()
            generics.generic_param_owner_row_index_counts.clear()
            generics.generic_param_owner_row_lines.clear()
            generics.generic_param_owner_row_offsets.clear()
            generics.generic_param_owner_row_names.clear()
            generics.generic_param_owner_row_index_entries <- 0
            generics.generic_param_owner_row_index_source_rows <- 0
            generics.generic_param_owner_row_index_valid <- false

        def proof_source_generic_owner_param_index_build(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            generics: mutable ProofSourceEffectIndexGenerics& = &report.source_types.source_effect_index.generics
            lines_count: usize = report.source_types.source_generic_param_lines.count
            names_count: usize = report.source_types.source_generic_param_names.count
            offsets_count: usize = report.source_types.source_generic_param_owner_offsets.count
            rows_aligned: bool = lines_count == names_count and lines_count == offsets_count
            if not report.source_types.source_generic_owner_params_valid or not rows_aligned:
                proof_source_generic_owner_param_index_clear(generics)
                return true
            # This report-owned source snapshot is immutable after its index is built. Check
            # the cached compact shape before recounting ordinary rows so every later exact
            # lookup stays constant-time even when bound rows share these parser arrays.
            if generics.generic_param_owner_row_index_valid:
                cached_count: usize = generics.generic_param_owner_row_index_entries
                cached_capacity: usize = proof_name_index_capacity(cached_count)
                if cached_count == 0:
                    return true if:
                        generics.generic_param_owner_row_index_source_rows == lines_count
                        generics.generic_param_owner_row_index_hashes.count == 0
                        generics.generic_param_owner_row_index_values.count == 0
                        generics.generic_param_owner_row_index_counts.count == 0
                        generics.generic_param_owner_row_lines.count == 0
                        generics.generic_param_owner_row_offsets.count == 0
                        generics.generic_param_owner_row_names.count == 0
                if generics.generic_param_owner_row_index_source_rows == lines_count and cached_count <= lines_count and cached_capacity != 0 and generics.generic_param_owner_row_index_hashes.count == cached_capacity and generics.generic_param_owner_row_index_values.count == cached_capacity and generics.generic_param_owner_row_index_counts.count == cached_capacity and generics.generic_param_owner_row_lines.count == cached_count and generics.generic_param_owner_row_offsets.count == cached_count and generics.generic_param_owner_row_names.count == cached_count:
                    return true
            count: mutable usize = 0
            for encoded_line in report.source_types.source_generic_param_lines |encoded_line, count, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                count <- count + 1 if encoded_line < PROOF_SOURCE_GENERIC_OWNER_PARAM_BOUND_LINE_FLAG
            capacity: usize = proof_name_index_capacity(count)
            if count == 0:
                proof_source_generic_owner_param_index_clear(generics)
                generics.generic_param_owner_row_index_entries <- 0
                generics.generic_param_owner_row_index_source_rows <- lines_count
                generics.generic_param_owner_row_index_valid <- true
                return true
            proof_source_generic_owner_param_index_clear(generics)
            return false if capacity == 0
            return false if:
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(count, source_work)
                not proof_report_source_work_charge(count, source_work)
                not proof_report_source_work_charge(count, source_work)
            generics.generic_param_owner_row_index_hashes.resize(capacity)
            generics.generic_param_owner_row_index_values.resize(capacity)
            generics.generic_param_owner_row_index_counts.resize(capacity)
            generics.generic_param_owner_row_lines.resize(count)
            generics.generic_param_owner_row_offsets.resize(count)
            generics.generic_param_owner_row_names.resize(count)
            for slot in 0..<capacity |slot, generics, count|:
                generics.generic_param_owner_row_index_values[slot] <- count
                generics.generic_param_owner_row_index_counts[slot] <- 0
            compact_row: mutable usize = 0
            for row in 0..<lines_count |row, report, generics, count, capacity, source_work, compact_row|:
                return false if not proof_report_source_work_charge(1, source_work)
                encoded_line: u32 = report.source_types.source_generic_param_lines[row]
                continue if encoded_line >= PROOF_SOURCE_GENERIC_OWNER_PARAM_BOUND_LINE_FLAG
                line: u32 = encoded_line
                owner_offset: u32 = report.source_types.source_generic_param_owner_offsets[row]
                name: sview = report.source_types.source_generic_param_names[row]
                return false if not proof_report_source_work_charge(4, source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                return false if compact_row >= count
                generics.generic_param_owner_row_lines[compact_row] <- line
                generics.generic_param_owner_row_offsets[compact_row] <- owner_offset
                generics.generic_param_owner_row_names[compact_row] <- name
                hash: u32 = proof_source_generic_owner_param_key_hash(line, owner_offset, name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, line, owner_offset, name, report, generics, count, capacity, source_work, compact_row, placed|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = generics.generic_param_owner_row_index_values[slot]
                    if current == count:
                        return false if not proof_report_source_work_charge(3, source_work)
                        generics.generic_param_owner_row_index_hashes[slot] <- hash
                        generics.generic_param_owner_row_index_values[slot] <- compact_row
                        generics.generic_param_owner_row_index_counts[slot] <- 1
                        placed <- true
                        break
                    if current < count and generics.generic_param_owner_row_index_hashes[slot] == hash:
                        return false if current >= generics.generic_param_owner_row_names.count or current >= generics.generic_param_owner_row_offsets.count or current >= generics.generic_param_owner_row_lines.count
                        current_line: u32 = generics.generic_param_owner_row_lines[current]
                        current_name: sview = generics.generic_param_owner_row_names[current]
                        return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(current_name), source_work)
                        if current_line == line and generics.generic_param_owner_row_offsets[current] == owner_offset and current_name == name:
                            return false if not proof_report_source_work_charge(1, source_work)
                            generics.generic_param_owner_row_index_counts[slot] <- generics.generic_param_owner_row_index_counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
                compact_row <- compact_row + 1
            return false if compact_row != count
            cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(generics.generic_param_owner_row_index_values, count, source_work)
            generics.generic_param_owner_row_index_entries <- count
            generics.generic_param_owner_row_index_source_rows <- lines_count
            generics.generic_param_owner_row_index_valid <- cluster.complete and cluster.bounded
            return generics.generic_param_owner_row_index_valid

        def proof_source_generic_owner_param_present_in_index_with_work(name: sview, owner_line: u32, owner_offset: u32, source_index: ProofSourceEffectIndex&, source_work: mutable usize&) -> (complete: bool, present: bool):
            generics: ProofSourceEffectIndexGenerics& = source_index.generics
            count: usize = generics.generic_param_owner_row_index_entries
            hashes_count: usize = generics.generic_param_owner_row_index_hashes.count
            rows_count: usize = generics.generic_param_owner_row_lines.count
            return (false, false) if owner_line == 0 or not generics.generic_param_owner_row_index_valid
            return (false, false) if rows_count != generics.generic_param_owner_row_offsets.count or rows_count != generics.generic_param_owner_row_names.count or rows_count != count
            return (false, false) if hashes_count != generics.generic_param_owner_row_index_values.count or hashes_count != generics.generic_param_owner_row_index_counts.count
            return (true, false) if count == 0 and hashes_count == 0
            expected_capacity: usize = proof_name_index_capacity(count)
            return (false, false) if count == 0 or expected_capacity == 0 or hashes_count != expected_capacity
            return (false, false) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
            wanted_hash: u32 = proof_source_generic_owner_param_key_hash(owner_line, owner_offset, name)
            slot: mutable usize = (wanted_hash.i64() % hashes_count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes_count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, owner_line, owner_offset, generics, count, hashes_count, source_work|:
                return (false, false) if not proof_report_source_work_charge(1, source_work)
                current: usize = generics.generic_param_owner_row_index_values[slot]
                return (true, false) if current == count
                return (false, false) if current > count or generics.generic_param_owner_row_index_counts[slot] == 0
                if generics.generic_param_owner_row_index_hashes[slot] == wanted_hash:
                    return (false, false) if current >= rows_count
                    current_name: sview = generics.generic_param_owner_row_names[current]
                    return (false, false) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(current_name), source_work)
                    if generics.generic_param_owner_row_lines[current] == owner_line and generics.generic_param_owner_row_offsets[current] == owner_offset and current_name == name:
                        return (false, false) if generics.generic_param_owner_row_index_counts[slot] != 1
                        return (true, true)
                slot <- (slot + 1) % hashes_count
                probes <- probes + 1
            return (false, false)

        def proof_source_generic_owner_param_present_with_work(name: sview, owner_line: u32, owner_offset: u32, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, present: bool):
            lines_count: usize = report.source_types.source_generic_param_lines.count
            names_count: usize = report.source_types.source_generic_param_names.count
            offsets_count: usize = report.source_types.source_generic_param_owner_offsets.count
            return (false, false) if owner_line == 0 or not report.source_types.source_generic_owner_params_valid or lines_count != names_count or lines_count != offsets_count
            return (false, false) if not proof_source_generic_owner_param_index_build(report, source_work)
            proof_source_generic_owner_param_present_in_index_with_work(name, owner_line, owner_offset, report.source_types.source_effect_index, source_work)
