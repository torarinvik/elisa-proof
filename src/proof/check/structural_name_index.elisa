extend ElisaProof:
    private:
        def proof_structural_name_lookup(report: mutable ProofReport&, wanted: sview) -> (complete: bool, found: bool, row: usize):
            name_count: usize = report.analysis_1.structural.names.count
            capacity: usize = report.analysis_1.structural.function_name_index_values.count
            return (false, false, name_count) if:
                not report.analysis_1.structural.function_name_index_valid
                capacity != report.analysis_1.structural.function_name_index_hashes.count or capacity != report.analysis_1.structural.function_name_index_ambiguous.count
            return (true, false, name_count) if wanted == "" or name_count == 0 and capacity == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, false, name_count) if:
                expected_capacity == 0 or capacity != expected_capacity
                not proof_source_index_work_charge(report, sview_len(wanted))
            wanted_hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, report, name_count, capacity|:
                return (false, false, name_count) if not proof_source_index_work_charge(report, 1)
                row: usize = report.analysis_1.structural.function_name_index_values[slot]
                return (true, false, name_count) if row == name_count
                return (false, false, name_count) if row > name_count
                if report.analysis_1.structural.function_name_index_hashes[slot] == wanted_hash:
                    return (false, false, name_count) if not proof_source_index_work_charge(report, sview_len(report.analysis_1.structural.names[row]))
                    if report.analysis_1.structural.names[row] == wanted:
                        # Structural SCC rows are keyed by declaration identity, but this
                        # transient index has only the leaf spelling. Do not let the first
                        # duplicate stand in for every declaration with that spelling.
                        return (false, false, name_count) if report.analysis_1.structural.function_name_index_ambiguous[slot]
                        return (true, true, row)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, name_count)

        # Component labels need only preserve equality: SCC construction may choose any
        # representative. Validate the parallel source arrays and labels before copying.
        def proof_structural_component_index_build(functions: ProofFunctionTable&, report: mutable ProofReport&) -> void:
            report.analysis_1.structural.component_ids.clear()
            count: usize = functions.lookup.names.count
            return if functions.summaries.recursive_component_ids.count != count or functions.summaries.recursive.count != count
            return if count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            return if not proof_report_source_work_charge(count * 2, &functions.lookup.module_resolution_work_used)
            for component in functions.summaries.recursive_component_ids |component, count|:
                return if component >= count
            report.analysis_1.structural.component_ids.extend(functions.summaries.recursive_component_ids)

        # Replay reconstructs this transient index from source-derived structural rows. The
        # ambiguity bit is authoritative: callers cannot resolve declaration identity from a
        # leaf spelling when more than one row has that name.
        def proof_structural_name_index_build(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            report.analysis_1.structural.function_name_index_hashes.clear()
            report.analysis_1.structural.function_name_index_values.clear()
            report.analysis_1.structural.function_name_index_ambiguous.clear()
            report.analysis_1.structural.function_name_index_valid <- false
            count: usize = report.analysis_1.structural.names.count
            return false if count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            capacity: usize = proof_name_index_capacity(count)
            return false if count > 0 and capacity == 0
            if count == 0:
                report.analysis_1.structural.function_name_index_valid <- true
                return true
            return false if:
                capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3
                not proof_report_source_work_charge(capacity * 3, &source_work)
            report.analysis_1.structural.function_name_index_hashes.resize(capacity)
            report.analysis_1.structural.function_name_index_values.resize(capacity)
            report.analysis_1.structural.function_name_index_ambiguous.resize(capacity)
            for slot in 0..<capacity |slot, report, count|:
                report.analysis_1.structural.function_name_index_values[slot] <- count
                report.analysis_1.structural.function_name_index_ambiguous[slot] <- false
            for row in 0..<count |row, report, count, capacity, source_work|:
                name: sview = report.analysis_1.structural.names[row]
                return false if not proof_report_source_work_charge(sview_len(name), &source_work)
                hash: u32 = proof_name_hash(name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, report, count, capacity, source_work, placed|:
                    return false if not proof_report_source_work_charge(1, &source_work)
                    current: usize = report.analysis_1.structural.function_name_index_values[slot]
                    if current == count:
                        report.analysis_1.structural.function_name_index_hashes[slot] <- hash
                        report.analysis_1.structural.function_name_index_values[slot] <- row
                        placed <- true
                        break
                    return false if current > count
                    if report.analysis_1.structural.function_name_index_hashes[slot] == hash:
                        return false if:
                            not proof_report_source_work_charge(sview_len(report.analysis_1.structural.names[current]), &source_work)
                            not proof_report_source_work_charge(sview_len(name), &source_work)
                        if report.analysis_1.structural.names[current] == name:
                            report.analysis_1.structural.function_name_index_ambiguous[slot] <- true
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(report.analysis_1.structural.function_name_index_values, count, source_work)
            return false if not cluster_status.complete or not cluster_status.bounded
            report.analysis_1.structural.function_name_index_valid <- true
            return true

        # Missing or exhausted lookup evidence means a possible callable shadow.
        def proof_structural_name_shadows_function(report: mutable ProofReport&, wanted: sview) -> bool:
            return false if wanted == ""
            lookup: (complete: bool, found: bool, row: usize) = proof_structural_name_lookup(report, wanted)
            return not lookup.complete or lookup.found
