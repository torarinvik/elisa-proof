extend ElisaProof:
    private:
        def proof_index_safety_preflight_expr_work(expression: Ast::Expr, passes: usize, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            # Share the existing per-function classification budget used by return, branch,
            # and frame analysis so all repeated expression walks are bounded together.
            proof_frame_expression_rechecks_with_work(expression, report, name, line, passes)

        const PROOF_INDEX_SAFETY_SCAN_LIMIT: usize = 16384

        def proof_check_index_safety_value(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, line: u32, functions: mutable ProofFunctionTable&) -> void can[Global.Read, Global.Write]:
            match expression:
                Ast::Expr.Index(object, index, position):
                    (proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    return if proof_is_type_cast_index(object)
                    (proof_check_index_safety_value(index, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_index_access(object, index, position, facts, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Expr.IndexN(object, arguments, position):
                    (proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    for argument in arguments |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        (proof_check_index_safety_value(argument, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_indexn_access(object, arguments, position, facts, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Expr.Paren(inner, _):
                    (proof_check_index_safety_value(inner, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Unary(_, operand, _):
                    (proof_check_index_safety_value(operand, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.GetElse(guarded, _, getelse_position):
                    # The recovery is checked in an isolated statement proof state. For a direct
                    # index, the runtime either loads an in-range element or takes that recovery,
                    # so ordinary lower/upper obligations would be false positives. Nested
                    # accesses in the receiver or index remain ordinary obligations.
                    match guarded:
                        Ast::Expr.Index(checked_object, checked_index_position, _):
                            proof_certify_checked_get(expression, report, name, getelse_position.line)
                            (proof_check_index_safety_value(checked_object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                            (proof_check_index_safety_value(checked_index_position, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                        _:
                            (proof_check_index_safety_value(guarded, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                # `get xs[i] else fallback` is lowered by the compiler to
                # `Binary(Index(xs, i), Else, fallback)`. The Else operator is the runtime
                # bounds guard itself: when the index is outside the collection no element
                # load occurs and the fallback is evaluated. Do not manufacture ordinary
                # `0 <= i` / `i < xs.count` obligations for the guarded access. Still walk
                # the receiver, index expression, and fallback so nested accesses, calls,
                # and unsupported forms cannot be hidden behind the outer recovery.
                Ast::Expr.Binary(checked_index, TokenKind.Else, checked_fallback, checked_position):
                    match checked_index:
                        Ast::Expr.Index(checked_object, checked_index_position, _):
                            proof_certify_checked_index(expression, report, name, checked_position.line)
                            (proof_check_index_safety_value(checked_object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                            (proof_check_index_safety_value(checked_index_position, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                            (proof_check_index_safety_value(checked_fallback, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                        _:
                            (proof_check_index_safety_value(checked_index, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                            (proof_check_index_safety_value(checked_fallback, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Binary(left, binary_operator, right, _):
                    (proof_check_index_safety_value(left, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    # `index < xs.count and xs[index] > 0` is the idiomatic guard, and the one
                    # every accessor over a parallel state array in this codebase is written with.
                    # The right operand of `and` is evaluated only when the left is true, and the
                    # right of `or` only when it is false, so an obligation inside it is discharged
                    # under that condition exactly as the body of an `if` is -- which already
                    # worked, and was the only spelling that did.
                    #
                    # The guard must be a stable term for the reason a branch condition must: a
                    # call in it is a second call when the fact is used, so a guard carrying one
                    # records nothing and the operand is checked against the facts already standing.
                    # The exception is a guard whose calls are all pure while the right operand
                    # calls nothing impure: no state changes between the guard and the access, so
                    # the call term denotes one value throughout -- the same value the callee's
                    # summary already describes -- and `live(t, s) and t.flags[s]` proves exactly
                    # as its `if` spelling does.
                    short_circuit: bool = binary_operator == TokenKind.And or binary_operator == TokenKind.Or
                    # The freshness classifier walks the term once for block-produced values
                    # and again for call-produced values; precharge both passes alongside the
                    # overloaded, move, call-presence, and supported-form scans.
                    guard_scan_complete: bool = not short_circuit or proof_index_safety_preflight_expr_work(left, 7, report, name, line)
                    guard_has_overloaded_operator: bool = true
                    guard_has_fresh_value: bool = true
                    guard_has_move: bool = true
                    guard_has_call: bool = true
                    guard_is_supported: bool = false
                    guard_calls_are_pure: bool = false
                    right_calls_are_pure: bool = false
                    if short_circuit and guard_scan_complete:
                        guard_has_overloaded_operator <- proof_source_expression_has_overloaded_operator(left, report.source.source_primitive_operator_mask, 0)
                        guard_has_fresh_value <- proof_expression_has_fresh_runtime_value(left, functions, 0)
                        scan_work: mutable usize = 0
                        guard_has_move <- proof_expr_has_move_with_work(left, &scan_work, PROOF_INDEX_SAFETY_SCAN_LIMIT)
                        scan_work <- 0
                        guard_has_call <- proof_expr_has_call_with_work(left, &scan_work, PROOF_INDEX_SAFETY_SCAN_LIMIT)
                        support_work: mutable usize = 0
                        guard_is_supported <- proof_expr_supported_with_work(left, &support_work)
                        if guard_has_call:
                            guard_calls_are_pure <- proof_runtime_calls_are_pure(left, functions)
                            right_calls_are_pure <- proof_runtime_calls_are_pure(right, functions)
                    stable_guard: bool = guard_scan_complete and not guard_has_overloaded_operator and not guard_has_fresh_value and not guard_has_move and (not guard_has_call or (guard_calls_are_pure and right_calls_are_pure))
                    guard_may_invalidate_state: bool = not guard_scan_complete or not guard_is_supported or guard_has_overloaded_operator or guard_has_move or guard_has_fresh_value or (guard_has_call and not guard_calls_are_pure)
                    if short_circuit and stable_guard and guard_is_supported:
                        guarded_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                        guard_position: Ast::Pos = Ast::Pos{line: line, column: 0, offset: 0, end_line: line, end_column: 0, end_offset: 0}
                        summaries_within_budget: mutable bool = true
                        if guard_has_call:
                            summaries_within_budget <- (proof_add_guard_call_summaries(left, facts, functions, annotations, guarded_facts, report, name, line, 0) can Global{Read,Write})
                            if not summaries_within_budget:
                                # Keep only the incoming facts after incomplete summary expansion.
                                # The branch condition is still added below as an independent premise.
                                guarded_facts <- proof_copy_exprs(facts)
                        if binary_operator == TokenKind.And:
                            proof_add_branch_condition_facts(guarded_facts, report, functions, left, line, name)
                        else:
                            proof_add_branch_condition_facts(guarded_facts, report, functions, proof_branch_negation(left, guard_position), line, name)
                        (proof_check_index_safety_value(right, guarded_facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    else:
                        if short_circuit and guard_may_invalidate_state:
                            # An unstable guard may have changed any value represented by the
                            # incoming facts before this short-circuit operand is evaluated.
                            # Keep only structural/type-derived bounds by checking with no facts.
                            no_stale_guard_facts: mutable darray[Ast::Expr] = []
                            (proof_check_index_safety_value(right, no_stale_guard_facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                        else:
                            (proof_check_index_safety_value(right, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Call(callee, arguments, _, _):
                    transition: (known: bool, operand: Ast::Expr) = proof_admitted_protocol_transition_operand(expression, report)
                    return if transition.known
                    (proof_check_index_safety_value(callee, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    for argument in arguments |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        (proof_check_index_safety_value(argument, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Field(object, _, _):
                    (proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Scope(base, _, _):
                    (proof_check_index_safety_value(base, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Slice(object, low, high, position):
                    (proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_index_safety_value(low, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_index_safety_value(high, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_slice_access(object, low, high, position, facts, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Expr.Move(operand, _):
                    (proof_check_index_safety_value(operand, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.RegionNew(operand, _, _):
                    (proof_check_index_safety_value(operand, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Array(elements, _):
                    for element in elements |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        (proof_check_index_safety_value(element, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Tuple(elements, _):
                    for element in elements |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        (proof_check_index_safety_value(element, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.SetLit(elements, _):
                    for element in elements |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        (proof_check_index_safety_value(element, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        (proof_check_index_safety_value(entry.key, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                        (proof_check_index_safety_value(entry.value, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        (proof_check_index_safety_value(field.value, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.RecordUpdate(base, fields, _):
                    (proof_check_index_safety_value(base, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    for field in fields |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        (proof_check_index_safety_value(field.value, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    (proof_check_index_safety_value(condition, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_index_safety_value(then_expr, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_index_safety_value(else_expr, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    (proof_check_index_safety_value(iterable, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_index_safety_value(condition, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_index_safety_value(body, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Refinement(base, predicate, _):
                    (proof_check_index_safety_value(base, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    (proof_check_index_safety_value(predicate, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                (proof_check_index_safety_value(initializer, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                            _:
                                pass
                    (proof_check_index_safety_value(value, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                _:
                    pass
