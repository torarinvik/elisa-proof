extend ElisaProof:
    private:
        const PROOF_INDEX_SAFETY_CERTIFICATE_FACT_PASSES: usize = 1
        const PROOF_INDEX_SAFETY_PROBE_FACT_PASSES: usize = 2
        const PROOF_INDEX_SAFETY_REQUIRES_FACT_PASSES: usize = 16

        def proof_index_safety_report_work_exhausted(report: mutable ProofReport&, name: sview, line: u32) -> void:
            report.analysis_1.budgets.index_safety_source_work <- PROOF_LINEAR_SAFETY_WORK_LIMIT
            if not report.analysis_1.budgets.index_safety_reported:
                report.analysis_1.budgets.index_safety_reported <- true
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", line, name, "index-safety guard classification exceeded its per-function source-work bound", "index-safety-source-work", PROOF_LINEAR_SAFETY_WORK_LIMIT, PROOF_LINEAR_SAFETY_WORK_LIMIT)

        def proof_index_safety_report_search_exhausted(report: mutable ProofReport&, name: sview, line: u32) -> void:
            if not report.analysis_1.budgets.index_safety_reported:
                report.analysis_1.budgets.index_safety_reported <- true
                report.proof_obligation(false)
                if report.analysis_1.budgets.index_safety_solver_work >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                    proof_add_budget_finding(report, "resource-analysis-budget", line, name, "index-safety shared proof search exceeded its per-function solver bound", "index-safety-solver-work", report.analysis_1.budgets.index_safety_solver_work, PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS)
                else:
                    proof_add_budget_finding(report, "resource-analysis-budget", line, name, "index-safety shared proof search exceeded its per-function tactic preflight bound", "index-safety-tactic-work", report.analysis_1.budgets.index_safety_tactic_preflight_work, PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT)

        def proof_index_safety_take_source_work(report: mutable ProofReport&, name: sview, line: u32, amount: usize) -> bool:
            work: usize = report.analysis_1.budgets.index_safety_source_work
            if work > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                proof_index_safety_report_work_exhausted(report, name, line)
                return false
            return true if amount == 0
            if work >= PROOF_LINEAR_SAFETY_WORK_LIMIT or amount > PROOF_LINEAR_SAFETY_WORK_LIMIT - work:
                proof_index_safety_report_work_exhausted(report, name, line)
                return false
            report.analysis_1.budgets.index_safety_source_work <- work + amount
            true

        def proof_index_safety_preflight_expr_work(expression: Ast::Expr, passes: usize, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            work: mutable usize = report.analysis_1.budgets.index_safety_source_work
            exhausted: mutable bool = false
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, &work, &exhausted)
            complete: mutable bool = cost.complete
            if complete and passes > 1:
                complete <- proof_linear_safety_work_charge_scaled(&work, &exhausted, cost.cost, passes - 1)
            complete <- false if complete and work > PROOF_LINEAR_SAFETY_WORK_LIMIT
            report.analysis_1.budgets.index_safety_source_work <- work
            if not complete:
                proof_index_safety_report_work_exhausted(report, name, line)
            complete

        # Facts used to prove an index remain valid across a subexpression only when its
        # evaluation is known not to mutate state or move a value. This walk is used at
        # sequencing boundaries (notably call arguments), where reusing the pre-expression
        # facts would otherwise let an earlier operand invalidate a later bounds proof.
        def proof_index_safety_expression_may_invalidate_facts(expression: Ast::Expr, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            match expression:
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Move(_, _) | Ast::Expr.Invalid:
                    return true
                _:
                    pass
            return true if proof_index_safety_expression_has_block_write_with_work(expression, report, name, line, 0)
            return true if not proof_index_safety_preflight_expr_work(expression, 5, report, name, line)
            call_scan: (complete: bool, has_call: bool) = proof_runtime_call_presence_scan(expression, functions)
            return true if not call_scan.complete
            has_move_work: mutable usize = 0
            has_move: bool = proof_expr_has_move_with_work(expression, &has_move_work, PROOF_INDEX_SAFETY_SCAN_LIMIT)
            return true if has_move_work > PROOF_INDEX_SAFETY_SCAN_LIMIT or has_move
            operator_work: mutable usize = 0
            operator_work_exhausted: mutable bool = false
            overloaded: bool = proof_source_expression_has_overloaded_operator_with_work(expression, report.source.source_primitive_operator_mask, &operator_work, &operator_work_exhausted)
            return true if operator_work_exhausted or overloaded
            return false if not call_scan.has_call
            not proof_runtime_calls_are_pure_with_known_presence(expression, functions, call_scan.has_call)

        # Walk operands in source evaluation order using a private fact snapshot. A possibly
        # effectful operand invalidates facts before every later operand and before the enclosing
        # operation (for example, the actual indexed read after evaluating object and index).
        def proof_check_index_safety_sequence(expressions: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, line: u32, functions: mutable ProofFunctionTable&) -> darray[Ast::Expr] can[Global{Read,Write}]:
            return [] if not proof_index_safety_take_source_work(report, name, line, facts.count)
            sequence_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            for operand in expressions |sequence_facts, expressions, fixed_names, fixed_extents, report, name, annotations, line, functions|:
                (proof_check_index_safety_value(operand, sequence_facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                if sequence_facts.count > 0 and proof_index_safety_expression_may_invalidate_facts(operand, functions, report, name, line):
                    sequence_facts.clear()
            sequence_facts

        # The cost walk below measures one future fact-context scan. Reserve every requested
        # solver pass at that measured cost before entering legacy fact readers.
        def proof_index_safety_preflight_fact_work(facts: darray[Ast::Expr]&, passes: usize, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            return true if passes == 0
            if report.analysis_1.budgets.index_safety_solver_work >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS or report.analysis_1.budgets.index_safety_tactic_preflight_work >= PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT:
                proof_index_safety_report_search_exhausted(report, name, line)
                return false
            work: mutable usize = report.analysis_1.budgets.index_safety_source_work
            exhausted: mutable bool = false
            fact_cost: mutable usize = facts.count
            if not proof_linear_safety_work_charge(&work, &exhausted, facts.count):
                report.analysis_1.budgets.index_safety_source_work <- work
                proof_index_safety_report_work_exhausted(report, name, line)
                return false
            for fact in facts |work, exhausted, fact_cost|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, &work, &exhausted)
                if not cost.complete or exhausted:
                    report.analysis_1.budgets.index_safety_source_work <- work
                    proof_index_safety_report_work_exhausted(report, name, line)
                    return false
                if cost.cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_cost:
                    report.analysis_1.budgets.index_safety_source_work <- work
                    proof_index_safety_report_work_exhausted(report, name, line)
                    return false
                fact_cost <- fact_cost + cost.cost
            if not proof_linear_safety_work_charge_scaled(&work, &exhausted, fact_cost, passes):
                report.analysis_1.budgets.index_safety_source_work <- work
                proof_index_safety_report_work_exhausted(report, name, line)
                return false
            report.analysis_1.budgets.index_safety_source_work <- work
            if exhausted or work > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                proof_index_safety_report_work_exhausted(report, name, line)
                return false
            true

        def proof_index_safety_goal_with_shared_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, report: mutable ProofReport&, name: sview, line: u32) -> bool can[Global{Read,Write}]:
            operator_mask: usize = report.source.source_primitive_operator_mask
            proven: bool = (proof_goal_with_shared_work(facts, goal, annotations, operator_mask, &report.analysis_1.budgets.index_safety_solver_work, &report.analysis_1.budgets.index_safety_tactic_preflight_work) can Global{Read,Write})
            if not proven and (report.analysis_1.budgets.index_safety_solver_work >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS or report.analysis_1.budgets.index_safety_tactic_preflight_work >= PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT):
                proof_index_safety_report_search_exhausted(report, name, line)
            proven

        # The support walk also charges its nested conversion/call scans and Match lowering
        # into the same `work` reference. Offset that counter so its existing 1 Mi ceiling
        # represents only the remaining per-function index-safety allowance; the shared source
        # cap is then enforced before each nested visit or reservation.
        def proof_index_safety_expr_supported_with_work(expression: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            work_before: usize = report.analysis_1.budgets.index_safety_source_work
            if work_before >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                proof_index_safety_report_work_exhausted(report, name, line)
                return false
            remaining: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - work_before
            support_work_start: usize = PROOF_MATCH_LOWERING_WORK_LIMIT - remaining
            support_work: mutable usize = support_work_start
            supported: bool = proof_expr_supported_with_work(expression, &support_work)
            if support_work > PROOF_MATCH_LOWERING_WORK_LIMIT or support_work < support_work_start:
                proof_index_safety_report_work_exhausted(report, name, line)
                return false
            support_cost: usize = support_work - support_work_start
            if support_cost > remaining:
                proof_index_safety_report_work_exhausted(report, name, line)
                return false
            report.analysis_1.budgets.index_safety_source_work <- work_before + support_cost
            return supported

        def proof_index_call_summary_fact_preflight(expression: Ast::Expr, parameter_names: darray[sview]&, argument_values: darray[Ast::Expr]&, result_value: Ast::Expr, require_goal_ids: darray[usize]&, has_call_old: bool, call_old_value: Ast::Expr, report: mutable ProofReport&, owner: sview, line: u32) -> bool:
            # Summary-fact publication repeats legacy admission walks after the indexed-call
            # candidate was already checked. Reserve the freshness, purity, and encoding walks;
            # the support walk below measures and reserves its own Match-lowering work.
            return false if not proof_index_safety_preflight_expr_work(expression, 7, report, owner, line)
            for argument in argument_values |report, owner, line|:
                return false if not proof_index_safety_preflight_expr_work(argument, 4, report, owner, line)
            return false if not proof_index_safety_preflight_expr_work(result_value, 4, report, owner, line)
            if has_call_old:
                return false if not proof_index_safety_preflight_expr_work(call_old_value, 4, report, owner, line)
            return false if:
                not proof_index_safety_take_source_work(report, owner, line, parameter_names.count)
                not proof_index_safety_take_source_work(report, owner, line, argument_values.count)
                not proof_index_safety_take_source_work(report, owner, line, require_goal_ids.count)
                not proof_index_safety_take_source_work(report, owner, line, report.threading.summary_threaded_symbols.count)
                not proof_index_safety_take_source_work(report, owner, line, 1)
            support_work_before: usize = report.analysis_1.budgets.index_safety_source_work
            if support_work_before >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                proof_index_safety_report_work_exhausted(report, owner, line)
                return false
            _ = proof_index_safety_expr_supported_with_work(expression, report, owner, line)
            support_work_after: usize = report.analysis_1.budgets.index_safety_source_work
            return false if support_work_after < support_work_before
            # The summary helper repeats this support check; reserve the measured traversal.
            return proof_index_safety_take_source_work(report, owner, line, support_work_after - support_work_before)

        def proof_index_call_expr_equal_with_work(left: Ast::Expr, right: Ast::Expr, report: mutable ProofReport&, owner: sview, line: u32) -> (complete: bool, equal: bool):
            work: mutable usize = report.analysis_1.budgets.index_safety_source_work
            if work >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                proof_index_safety_report_work_exhausted(report, owner, line)
                return (false, false)
            left_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(left, &left_cost, work, PROOF_LINEAR_SAFETY_WORK_LIMIT):
                proof_index_safety_report_work_exhausted(report, owner, line)
                return (false, false)
            work <- work + left_cost
            right_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(right, &right_cost, work, PROOF_LINEAR_SAFETY_WORK_LIMIT):
                report.analysis_1.budgets.index_safety_source_work <- work
                proof_index_safety_report_work_exhausted(report, owner, line)
                return (false, false)
            work <- work + right_cost
            comparison_cost: usize = left_cost + right_cost
            remaining: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - work
            if comparison_cost > remaining / 5:
                report.analysis_1.budgets.index_safety_source_work <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                proof_index_safety_report_work_exhausted(report, owner, line)
                return (false, false)
            # The five reserved term passes cover proof_expr_equal's quick prefilter,
            # two support checks, and structural comparison. The two sizing walks above
            # are charged separately; another support preflight here would count the same
            # comparator work a second time.
            work <- work + comparison_cost * 5
            report.analysis_1.budgets.index_safety_source_work <- work
            # A false result with `work == limit` is a completed non-match; callers can
            # distinguish it from the explicit incomplete result above.
            (true, proof_expr_equal(left, right))

        def proof_index_safety_add_branch_condition_facts(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, functions: mutable ProofFunctionTable&, condition: Ast::Expr, name: sview, line: u32) -> void:
            work: mutable usize = report.analysis_1.budgets.index_safety_source_work
            exhausted: mutable bool = false
            condition_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(condition, &work, &exhausted)
            if not condition_cost.complete or exhausted:
                report.analysis_1.budgets.index_safety_source_work <- work
                proof_index_safety_report_work_exhausted(report, name, line)
                return
            if not proof_linear_safety_work_charge_scaled(&work, &exhausted, condition_cost.cost, 10) or not proof_linear_safety_work_charge(&work, &exhausted, 4):
                report.analysis_1.budgets.index_safety_source_work <- work
                proof_index_safety_report_work_exhausted(report, name, line)
                return

            # Keep a whole, admissible branch premise even when conjunct expansion is too costly.
            # The legacy splitter examines at most sixteen worklist entries; each can
            # traverse a parenthesized path before producing its next component.
            components: mutable darray[Ast::Expr] = []
            if not proof_linear_safety_work_charge_scaled(&work, &exhausted, condition_cost.cost, 16):
                report.analysis_1.budgets.index_safety_source_work <- work
                proof_index_safety_report_work_exhausted(report, name, line)
                proof_add_branch_condition_facts_from_components(facts, report, functions, condition, components, false, line, name)
                return
            proof_conjunct_components(condition, &components)
            if components.count < 2:
                report.analysis_1.budgets.index_safety_source_work <- work
                proof_add_branch_condition_facts_from_components(facts, report, functions, condition, components, false, line, name)
                return

            facts_cost: mutable usize = 0
            if not proof_linear_safety_work_charge(&work, &exhausted, facts.count):
                exhausted <- true
            if not exhausted:
                for fact in facts |fact, work, exhausted, facts_cost|:
                    cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, &work, &exhausted)
                    if not cost.complete or exhausted or cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - facts_cost:
                        exhausted <- true
                        break
                    facts_cost <- facts_cost + cost.cost

            component_limit: usize = components.count
            condition_upper: usize = condition_cost.cost
            if condition_upper > PROOF_LINEAR_SAFETY_WORK_LIMIT - 3:
                exhausted <- true
            else:
                condition_upper <- condition_upper + 3
            appended_count: usize = component_limit + 1
            facts_upper: usize = facts.count
            if facts_upper > PROOF_LINEAR_SAFETY_WORK_LIMIT - appended_count:
                exhausted <- true
            else:
                facts_upper <- facts_upper + appended_count
            appended_cost: mutable usize = 0
            if not exhausted and condition_upper > PROOF_LINEAR_SAFETY_WORK_LIMIT / appended_count:
                exhausted <- true
            if not exhausted:
                appended_cost <- condition_upper * appended_count
                if facts_cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - appended_cost:
                    exhausted <- true
                else:
                    facts_cost <- facts_cost + appended_cost

            if not exhausted:
                if not proof_linear_safety_work_charge_product4_with_work(&work, &exhausted, component_limit, facts_cost, 1, 1, 5):
                    exhausted <- true
                if not exhausted:
                    if not proof_linear_safety_work_charge_product4_with_work(&work, &exhausted, component_limit, facts_upper, condition_upper, 1, 5):
                        exhausted <- true
                if not exhausted:
                    if not proof_linear_safety_work_charge_product4_with_work(&work, &exhausted, component_limit, condition_upper, 1, 1, 8):
                        exhausted <- true
                if not exhausted:
                    if not proof_linear_safety_work_charge_product4_with_work(&work, &exhausted, component_limit, condition_cost.cost, 1, 1, 4):
                        exhausted <- true
                if not exhausted:
                    if not proof_linear_safety_work_charge_scaled(&work, &exhausted, component_limit, 4):
                        exhausted <- true

            report.analysis_1.budgets.index_safety_source_work <- work
            if exhausted:
                proof_index_safety_report_work_exhausted(report, name, line)
                empty_components: darray[Ast::Expr] = []
                proof_add_branch_condition_facts_from_components(facts, report, functions, condition, empty_components, false, line, name)
            else:
                proof_add_branch_condition_facts_from_components(facts, report, functions, condition, components, true, line, name)

        const PROOF_INDEX_SAFETY_SCAN_LIMIT: usize = 16384

        def proof_check_index_safety_value(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, line: u32, functions: mutable ProofFunctionTable&) -> void can[Global{Read,Write}]:
            return if not proof_index_safety_take_source_work(report, name, line, 1)
            match expression:
                Ast::Expr.Index(object, index, position):
                    if proof_is_type_cast_index(object):
                        (proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                        return
                    operands: darray[Ast::Expr] = [object, index]
                    access_facts: darray[Ast::Expr] = (proof_check_index_safety_sequence(operands, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can[Global{Read,Write}])
                    (proof_check_index_access(object, index, position, access_facts, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Expr.IndexN(object, arguments, position):
                    operands: mutable darray[Ast::Expr] = [object]
                    operands.extend(arguments)
                    access_facts: darray[Ast::Expr] = (proof_check_index_safety_sequence(operands, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can[Global{Read,Write}])
                    (proof_check_indexn_access(object, arguments, position, access_facts, fixed_names, fixed_extents, report, name, annotations, functions) can Global{Read,Write})
                Ast::Expr.Paren(inner, _):
                    (proof_check_index_safety_value(inner, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Unary(_, operand, _):
                    (proof_check_index_safety_value(operand, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.GetElse(guarded, _, getelse_position):
                    # The recovery is checked in an isolated statement proof state. For a direct
                    # index, the runtime either loads an in-range element or takes that recovery,
                    # so ordinary lower/upper obligations would be false positives. Nested
                    # accesses in the receiver or index remain ordinary obligations.
                    match guarded:
                        Ast::Expr.Index(checked_object, checked_index_position, _):
                            return if not proof_index_safety_preflight_expr_work(expression, 2, report, name, line)
                            return if not proof_index_safety_take_source_work(report, name, line, 1)
                            proof_certify_checked_get(expression, report, name, getelse_position.line)
                            (proof_check_index_safety_value(checked_object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                            (proof_check_index_safety_value(checked_index_position, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                        _:
                            (proof_check_index_safety_value(guarded, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                # `get xs[i] else fallback` is lowered by the compiler to
                # `Binary(Index(xs, i), Else, fallback)`. The Else operator is the runtime
                # bounds guard itself: when the index is outside the collection no element
                # load occurs and the fallback is evaluated. Do not manufacture ordinary
                # `0 <= i` / `i < xs.count` obligations for the guarded access. Still walk
                # the receiver, index expression, and fallback so nested accesses, calls,
                # and unsupported forms cannot be hidden behind the outer recovery.
                Ast::Expr.Binary(checked_index, TokenKind.Else, checked_fallback, checked_position):
                    match checked_index:
                        Ast::Expr.Index(checked_object, checked_index_position, _):
                            return if not proof_index_safety_preflight_expr_work(expression, 2, report, name, line)
                            return if not proof_index_safety_take_source_work(report, name, line, 1)
                            proof_certify_checked_index(expression, report, name, checked_position.line)
                            guarded_operands: darray[Ast::Expr] = [checked_object, checked_index_position]
                            _ = (proof_check_index_safety_sequence(guarded_operands, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can[Global{Read,Write}])
                            # This arm runs only when the bounds guard failed. Incoming facts
                            # about this collection/index cannot be reused on the failure path.
                            fallback_facts: mutable darray[Ast::Expr] = []
                            (proof_check_index_safety_value(checked_fallback, fallback_facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                        _:
                            guarded_terms: darray[Ast::Expr] = [checked_index]
                            _ = (proof_check_index_safety_sequence(guarded_terms, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can[Global{Read,Write}])
                            fallback_facts: mutable darray[Ast::Expr] = []
                            (proof_check_index_safety_value(checked_fallback, fallback_facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                Ast::Expr.Binary(left, binary_operator, right, _):
                    (proof_check_index_safety_value(left, facts, fixed_names, fixed_extents, report, name, annotations, line, functions) can Global{Read,Write})
                    # `index < xs.count and xs[index] > 0` is the idiomatic guard, and the one
                    # every accessor over a parallel state array in this codebase is written with.
                    # The right operand of `and` is evaluated only when the left is true, and the
                    # right of `or` only when it is false, so an obligation inside it is discharged
