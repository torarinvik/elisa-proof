extend ElisaProof:
    private:
        # Only a mutable binding's count gets the explicit `0 <= xs.count` fact, which an
        # element-write loop needs to establish `k <= xs.count` at `k == 0`. As a premise over an
        # unbounded unsigned place it sends every goal of the function through place
        # generalization, where the renamed count then keeps congruence from running.
        def proof_count_fact_wanted(root: Ast::Expr, type_expression: Ast::Expr) -> bool:
            return false if not proof_parameter_type_is_mutable(type_expression)
            match root:
                Ast::Expr.Ident(_, _):
                    return true
                _:
                    return false

        # An element write `xs[k] <- v` changes exactly one cell of `xs` and leaves its extent
        # alone. The generic write path drops every fact that is not call-stable; this module
        # returns the facts the write cannot have changed and records the written cell.
        #
        # A fact survives only when every mention of `xs` is `xs.count`, a traced type marker
        # over `xs`, or a read `xs[e]` whose index is proved distinct from `k` -- below or above
        # it. Inside a range quantifier `forall i in c..<d`, the read must be `xs[i]` or
        # `xs[i + e]` for a literal e, and the range shifted by e must lie on one side of `k`. Any
        # other shape (a call, a read of another collection that might alias `xs`, a bare `xs`)
        # drops the fact.
        def proof_indexed_write_root(target: Ast::Expr) -> (known: bool, root: sview, index: Ast::Expr):
            match target:
                Ast::Expr.Index(Ast::Expr.Ident(root, _), index, _):
                    return (known: true, root: root, index: index)
                _:
                    return (known: false, root: "", index: Ast::Expr.Invalid)

        def proof_index_distinct(index: Ast::Expr, written: Ast::Expr, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos) -> bool:
            # A read of the written cell cannot survive the write. Sending the identical
            # indices through two failing strict-order searches repeatedly expands the
            # quantified context during swaps. Refusing preservation needs no proof search.
            return false if proof_expr_equal(index, written)
            return true if proof_goal(facts, Ast::Expr.Binary(index, TokenKind.Lt, written, position), annotations)
            return proof_goal(facts, Ast::Expr.Binary(written, TokenKind.Lt, index, position), annotations)

        def proof_write_preserves(expression: Ast::Expr, root: sview, written: Ast::Expr, binder: sview, low: Ast::Expr, high: Ast::Expr, inclusive: bool, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, depth: usize) -> bool:
            return false if depth > 32
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return name != root
                Ast::Expr.Paren(inner, _):
                    return proof_write_preserves(inner, root, written, binder, low, high, inclusive, facts, annotations, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_write_preserves(operand, root, written, binder, low, high, inclusive, facts, annotations, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_write_preserves(left, root, written, binder, low, high, inclusive, facts, annotations, depth + 1) and proof_write_preserves(right, root, written, binder, low, high, inclusive, facts, annotations, depth + 1)
                Ast::Expr.Field(Ast::Expr.Ident(object, _), field, _):
                    return object != root or field == "count"
                Ast::Expr.Field(object, _, _):
                    return proof_write_preserves(object, root, written, binder, low, high, inclusive, facts, annotations, depth + 1)
                Ast::Expr.Call(Ast::Expr.Ident(callee, _), _, _, _):
                    # Only the traced type markers; their arguments are terms, not reads.
                    return callee == "__elisa_primitive_integer_type" or callee == "__elisa_primitive_scalar_type" or callee == "__elisa_primitive_scalar_element" or callee == "__elisa_unsigned_type_bound" or callee == "__elisa_signed_type_bound" or callee == "__elisa_signed_place_type_bound" or callee == "__elisa_builtin_index_type" or callee == "__elisa_builtin_operator_type" or callee == "__elisa_untrusted_operator_type"
                Ast::Expr.Index(Ast::Expr.Ident(object, _), index, position):
                    return false if object != root
                    return false if not proof_write_preserves(index, root, written, binder, low, high, inclusive, facts, annotations, depth + 1)
                    if binder != "":
                        shift: (known: bool, offset: i64) = proof_binder_offset(index, binder)
                        if shift.known:
                            reach_high: Ast::Expr = high if shift.offset == 0 else Ast::Expr.Binary(high, TokenKind.Plus, Ast::Expr.IntLit(shift.offset, position), position)
                            reach_low: Ast::Expr = low if shift.offset == 0 else Ast::Expr.Binary(low, TokenKind.Plus, Ast::Expr.IntLit(shift.offset, position), position)
                            below_operator: TokenKind = TokenKind.Lt if inclusive else TokenKind.LtEq
                            return true if proof_goal(facts, Ast::Expr.Binary(reach_high, below_operator, written, position), annotations)
                            # A shift is non-negative, so a write below the range start is below every read.
                            return true if proof_goal(facts, Ast::Expr.Binary(written, TokenKind.Lt, low, position), annotations)
                            return shift.offset != 0 and proof_goal(facts, Ast::Expr.Binary(written, TokenKind.Lt, reach_low, position), annotations)
                        return false if proof_expr_mentions_name(index, binder)
                    return proof_index_distinct(index, written, facts, annotations, position)
                Ast::Expr.Block(statements, body, _, _):
                    return false if binder != "" or statements.count != 1
                    match statements[0]:
                        Ast::Stmt.VarDecl(name, _, Ast::Expr.Binary(range_low, range_operator, range_high, _), _):
                            return false if name == root or (range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe)
                            return false if proof_expr_mentions_name(written, name)
                            return false if not proof_write_preserves(range_low, root, written, "", low, high, inclusive, facts, annotations, depth + 1)
                            return false if not proof_write_preserves(range_high, root, written, "", low, high, inclusive, facts, annotations, depth + 1)
                            return proof_write_preserves(body, root, written, name, range_low, range_high, range_operator == TokenKind.RangeLe, facts, annotations, depth + 1)
                        _:
                            return false
                _:
                    return false

        # A read inside the range is `xs[i]` or `xs[i + e]` for a small literal e, reaching the
        # range's cells shifted by e; any other index over the binder is refused.
        def proof_binder_offset(index: Ast::Expr, binder: sview) -> (known: bool, offset: i64):
            match index:
                Ast::Expr.Ident(name, _):
                    return (name == binder, 0)
                Ast::Expr.Paren(inner, _):
                    return proof_binder_offset(inner, binder)
                Ast::Expr.Binary(left, TokenKind.Plus, right, _):
                    base: (known: bool, offset: i64) = proof_binder_offset(left, binder)
                    return (false, 0) if not base.known or base.offset != 0
                    return proof_binder_literal_offset(right)
                _:
                    return (false, 0)

        def proof_binder_literal_offset(expression: Ast::Expr) -> (known: bool, offset: i64):
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (value >= 0 and value <= 64, value)
                _:
                    return (false, 0)

        # A conjunction is restored conjunct by conjunct, so `k < xs.count and xs[k] == 3` keeps
        # its bound when the write lands on `xs[k]`. A split conjunct is derived from the whole
        # fact so replay re-checks the elimination instead of taking the conjunct as an axiom.
        def proof_restore_conjuncts(fact: Ast::Expr, whole: darray[Ast::Expr]&, root: sview, written: Ast::Expr, before: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, depth: usize) -> void:
            return if depth > 16
            return if any existing in facts where proof_expr_equal(existing, fact)
            if proof_write_preserves(fact, root, written, "", Ast::Expr.Invalid, Ast::Expr.Invalid, false, before, annotations, 0):
                if depth == 0:
                    facts.push(fact)
                else:
                    proof_add_derived_fact_from(facts, report, fact, whole, "branch-conjunct", line, name)
                return
            match fact:
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    proof_restore_conjuncts(left, whole, root, written, before, facts, report, annotations, name, line, depth + 1)
                    proof_restore_conjuncts(right, whole, root, written, before, facts, report, annotations, name, line, depth + 1)
                Ast::Expr.Paren(inner, _):
                    proof_restore_conjuncts(inner, whole, root, written, before, facts, report, annotations, name, line, depth + 1)
                Ast::Expr.Block(_, _, _, _):
                    proof_restore_narrowed(fact, root, written, before, facts, report, annotations, name, line)
                _:
                    return

        # A range fact the write lands in may still hold on the range less its first or last
        # cell: `forall i in c..<d: P` with `c < d` gives `forall i in c + 1..<d: P` (and
        # `c..<d - 1`), a cover step replay re-proves from the fact and the pre-write facts. It is
        # kept only when the narrower range itself survives the write.
        def proof_restore_narrowed(fact: Ast::Expr, root: sview, written: Ast::Expr, before: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32) -> void:
            range: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(fact)
            return if not range.known
            position: Ast::Pos = Ast::pos_at_line(line)
            return if not proof_goal(before, Ast::Expr.Binary(range.lower, TokenKind.Lt, range.upper, position), annotations)
            one: Ast::Expr = Ast::Expr.IntLit(1, position)
            raised: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(range.lower, TokenKind.Plus, one, position), TokenKind.RangeLt, range.upper, position)
            lowered: Ast::Expr = Ast::Expr.Binary(range.lower, TokenKind.RangeLt, Ast::Expr.Binary(range.upper, TokenKind.Minus, one, position), position)
            narrowings: darray[Ast::Expr] = [raised, lowered]
            for narrowing in narrowings |narrowing, fact, root, written, before, facts, report, annotations, name, line|:
                narrowed: (known: bool, value: Ast::Expr) = proof_forall_with_range(fact, narrowing)
                continue if not narrowed.known
                continue if any existing in facts where proof_expr_equal(existing, narrowed.value)
                continue if not proof_write_preserves(narrowed.value, root, written, "", Ast::Expr.Invalid, Ast::Expr.Invalid, false, before, annotations, 0)
                proof_add_derived_fact_from(facts, report, narrowed.value, before, "proof-step", line, name)

        # `forall i in a..<b: P` with its range replaced, keeping the binder's declaration.
        def proof_forall_with_range(fact: Ast::Expr, range: Ast::Expr) -> (known: bool, value: Ast::Expr):
            match fact:
                Ast::Expr.Block(statements, body, captures, block_position):
                    return (false, Ast::Expr.Invalid) if statements.count != 1
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, type_expression, _, statement_position):
                            narrowed: mutable darray[Ast::Stmt] = []
                            narrowed.push(Ast::Stmt.VarDecl(binder, type_expression, range, statement_position))
                            return (true, Ast::Expr.Block(narrowed, body, captures, block_position))
                        _:
                            return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        # The stored value is read before the write. `xs[k] == stored` still holds afterwards
        # when every read of `xs` in it is at an index provably distinct from `k`, or when it is
        # exactly one read `xs[e]`: for `e != k` that cell is untouched, and for `e == k` the
        # fact is `xs[k] == xs[k]`.
        def proof_stored_reads_survive(stored: Ast::Expr, root: sview, written: Ast::Expr, before: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return true if not proof_expr_mentions_name(stored, root)
            match stored:
                Ast::Expr.Index(Ast::Expr.Ident(object, _), index, _):
                    return true if object == root and not proof_expr_mentions_name(index, root)
                _:
                    pass
            return proof_write_preserves(stored, root, written, "", Ast::Expr.Invalid, Ast::Expr.Invalid, false, before, annotations, 0)

        # A local `t` bound to a value `v` that reads `xs` goes stale at the write, but what the
        # facts said about `v` still holds of `t`: `xs[i] == a` gives `t == a`. The binding
        # `t == v` is traced at the boundary and each carried fact is a proof step over it and
        # the facts before the write, so replay re-proves it. Carried facts must survive the
        # write themselves; at most PROOF_ALIAS_TRANSFER_BUDGET are carried per write.
        def proof_carry_stale_bindings(stale: darray[sview]&, root: sview, written: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, before: darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos, carried: mutable darray[Ast::Expr]&, premises: mutable darray[Ast::Expr]&) -> void:
            budget: mutable usize = PROOF_ALIAS_TRANSFER_BUDGET
            for stale_name in stale |stale_name, root, written, names, values, before, report, owner, annotations, position, carried, premises, budget|:
                for slot in 0..<names.count |slot, stale_name, root, written, names, values, before, report, owner, annotations, position, carried, premises, budget|:
                    continue if names[slot] != stale_name or slot >= values.count
                    value: Ast::Expr = values[slot]
                    alias: Ast::Expr = Ast::Expr.Ident(stale_name, position)
                    binding: Ast::Expr = Ast::Expr.Binary(alias, TokenKind.EqEq, value, position)
                    continue if not proof_trace_fact(report, binding, "local-binding", position.line, owner)
                    for original in before |original, binding, value, alias, root, annotations, carried, premises, budget|:
                        pieces: mutable darray[Ast::Expr] = []
                        proof_conjunct_components(original, pieces)
                        proof_push_cell_instance(original, value, pieces)
                        for fact in pieces |fact, original, binding, value, alias, root, annotations, carried, premises, budget|:
                            continue if budget == 0
                            replaced: (changed: bool, value: Ast::Expr) = proof_replace_place(fact, value, alias, 0)
                            continue if not replaced.changed or proof_expr_mentions_name(replaced.value, root)
                            continue if any existing in carried where proof_expr_equal(existing, replaced.value)
                            step: mutable darray[Ast::Expr] = proof_marker_facts(before)
                            step.push(binding)
                            step.push(original)
                            proof_push_unread_facts(before, root, step) if proof_symbolic_range(original).known
                            continue if not proof_goal(step, replaced.value, annotations)
                            budget <- budget - 1
                            carried.push(replaced.value)
                            premises.push(binding)
                            premises.push(original)

        # A comparison step needs the scalar witnesses of its operands; those are the traced
        # type-marker facts, which every step takes along with its two real premises.
        def proof_marker_facts(facts: darray[Ast::Expr]&) -> darray[Ast::Expr]:
            markers: mutable darray[Ast::Expr] = []
            for fact in facts |fact, markers|:
                match fact:
                    Ast::Expr.Call(Ast::Expr.Ident(_, _), _, _, _):
                        markers.push(fact)
                    _:
                        continue
            return markers

        # `xs[k] == xs[j]` dies at the next write to `xs[j]`; when a fact names the stored read's
        # value, `xs[j] == b`, the cell is also recorded as `xs[k] == b` -- a proof step over the
        # cell fact and that fact alone -- so a swap keeps both values.
        def proof_close_written_cell(cell: Ast::Expr, stored: Ast::Expr, root: sview, before: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, position: Ast::Pos) -> void:
            # A stored local, `xs[j] <- a`, also lends its facts to the cell: `p <= a` is
            # `p <= xs[j]`, which outlives `a` at the function's exit.
            stored_local: bool = proof_stored_local(stored)
            return if not stored_local and not proof_expr_mentions_name(stored, root)
            cell_fact: Ast::Expr = Ast::Expr.Binary(cell, TokenKind.EqEq, stored, position)
            # The facts over the stored value are the pre-write ones: a read the write may
            # alias, `xs[k]` beside a write to `xs[lo]`, is already gone from `facts`.
            originals: darray[Ast::Expr] = proof_copy_exprs(before)
            budget: mutable usize = PROOF_ALIAS_TRANSFER_BUDGET
            for original in originals |original, cell_fact, cell, stored, root, facts, report, annotations, owner, position, budget|:
                pieces: mutable darray[Ast::Expr] = []
                proof_conjunct_components(original, pieces)
                for piece in pieces |piece, original, cell_fact, cell, stored, root, facts, report, annotations, owner, position, budget|:
                    continue if budget == 0
                    # Any conjunct over the stored value speaks of the cell now: `xs[k] < p`
                    # before `xs[lo] <- xs[k]` gives `xs[lo] < p`, so long as the cell is the only
                    # read of `xs` left in it.
                    # The piece is a pre-write fact: a read of the cell itself is its old value, and
                    # renaming beside it would equate two states (`xs[k+1] < xs[k]` would close to
                    # `xs[k+1] < xs[k+1]`). Only the stored read may touch the collection.
                    unstored: (changed: bool, value: Ast::Expr) = proof_replace_place(piece, stored, Ast::Expr.IntLit(0, position), 0)
                    continue if proof_expr_mentions_name(unstored.value, root)
                    renamed: (changed: bool, value: Ast::Expr) = proof_replace_place(piece, stored, cell, 0)
                    continue if not renamed.changed
                    closed: Ast::Expr = renamed.value
                    masked: (changed: bool, value: Ast::Expr) = proof_replace_place(closed, cell, Ast::Expr.IntLit(0, position), 0)
                    continue if proof_expr_mentions_name(masked.value, root) or not proof_kernel_expression_supported(masked.value)
                    continue if any existing in facts where proof_expr_equal(existing, closed)
                    premises: mutable darray[Ast::Expr] = proof_marker_facts(facts)
                    premises.push(cell_fact)
                    premises.push(original)
                    continue if not proof_goal(premises, closed, annotations)
                    budget <- budget - 1
                    proof_add_derived_fact_from(facts, report, closed, premises, "proof-step", position.line, owner)

        # A local read from a cell, `t == xs[k]`, outlives a write that may hit the cell, and so
        # can the facts over the cell: `xs[k] < p` is also `t < p`, a proof step over the read
        # and that fact alone. A swap that reads `t` first keeps `t < p` for its last write.
        def proof_transfer_to_place_aliases(root: sview, before: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, annotations: darray[Ast::EnumAnnotation]&, owner: sview, position: Ast::Pos) -> void:
            originals: darray[Ast::Expr] = proof_copy_exprs(before)
            budget: mutable usize = PROOF_ALIAS_TRANSFER_BUDGET
            for read in originals |read, originals, root, facts, report, annotations, owner, position, budget|:
                match read:
                    Ast::Expr.Binary(alias, TokenKind.EqEq, place, _):
                        continue if proof_expr_mentions_name(alias, root) or not proof_expr_mentions_name(place, root)
                        continue if not proof_place_alias_shape(alias, place, originals)
                        for original in originals |original, read, alias, place, root, facts, report, annotations, owner, position, budget|:
                            continue if proof_expr_equal(original, read)
                            pieces: mutable darray[Ast::Expr] = []
                            proof_conjunct_components(original, pieces)
                            # A range fact speaks of the cell through its instance at the cell's
                            # index; the alias instance rule re-proves it from the read and the fact.
                            proof_push_cell_instance(original, place, pieces)
                            for piece in pieces |piece, original, read, alias, place, root, facts, report, annotations, owner, position, budget|:
                                continue if budget == 0
                                renamed: (changed: bool, value: Ast::Expr) = proof_replace_place(piece, place, alias, 0)
                                continue if not renamed.changed or proof_expr_mentions_name(renamed.value, root) or not proof_kernel_expression_supported(renamed.value)
                                continue if any existing in facts where proof_expr_equal(existing, renamed.value)
                                premises: mutable darray[Ast::Expr] = proof_marker_facts(facts)
                                premises.push(read)
                                premises.push(original)
                                # An instance needs the cell's index inside the range: the scalar
                                # facts that never read the collection bound it.
                                proof_push_unread_facts(originals, root, premises) if proof_symbolic_range(original).known
                                continue if not proof_goal(premises, renamed.value, annotations)
                                budget <- budget - 1
                                proof_add_derived_fact_from(facts, report, renamed.value, premises, "proof-step", position.line, owner)
                    _:
                        pass

        def proof_stored_local(stored: Ast::Expr) -> bool:
            match stored:
                Ast::Expr.Ident(_, _):
                    return true
                _:
                    return false

        def proof_push_unread_facts(originals: darray[Ast::Expr]&, root: sview, premises: mutable darray[Ast::Expr]&) -> void:
            for fact in originals |fact, root, premises|:
                continue if proof_expr_mentions_name(fact, root) or proof_symbolic_range(fact).known
                premises.push(fact)

        def proof_push_cell_instance(fact: Ast::Expr, place: Ast::Expr, pieces: mutable darray[Ast::Expr]&) -> void:
            match place:
                Ast::Expr.Index(_, index, _):
                    known: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(fact)
                    return if not known.known
                    names: darray[sview] = [known.binder]
                    values: darray[Ast::Expr] = [index]
                    pieces.push(proof_substitute(known.body, names, values))
                _:
                    return

        # Returns false when the write is not of the modeled shape; the caller then takes the
        # generic invalidation path. On true the caller has already cleared the generic way, and
        # this restores the provably untouched facts and adds `xs[k] == v`.
        def proof_apply_indexed_write(target: Ast::Expr, operator: TokenKind, initializer: Ast::Expr, before: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: mutable darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos) -> void:
            return if operator != TokenKind.LArrow and operator != TokenKind.Assign
            shape: (known: bool, root: sview, index: Ast::Expr) = proof_indexed_write_root(target)
            return if not shape.known
            return if proof_expr_has_call(shape.index) or proof_expr_has_call(initializer)
            # A local collection bound to a known value would keep that stale value.
            for slot in 0..<names.count |slot, names, values, shape|:
                if names[slot] == shape.root and slot < values.count:
                    match values[slot]:
                        Ast::Expr.Ident(current, _):
                            return if current != shape.root
                        _:
                            return
            written: Ast::Expr = proof_substitute(shape.index, names, values)
            stored: Ast::Expr = proof_substitute(initializer, names, values)
            return if proof_expr_mentions_name(written, shape.root)
            # A binding whose symbolic value reads the collection no longer denotes it.
            stale: mutable darray[sview] = []
            for slot in 0..<names.count |slot, names, values, stale, shape|:
                stale.push(names[slot]) if slot < values.count and names[slot] != shape.root and proof_expr_mentions_name(values[slot], shape.root)
            carried: mutable darray[Ast::Expr] = []
            carried_premises: mutable darray[Ast::Expr] = []
            proof_carry_stale_bindings(stale, shape.root, written, names, values, before, report, name, annotations, position, carried, carried_premises)
            for stale_name in stale |stale_name, names, values, facts, report, name, position|:
                proof_resymbolize_binding(names, values, facts, report, name, stale_name, position)
            for fact in before |fact, facts, shape, written, annotations, before, stale, report, name, position|:
                continue if any stale_name in stale where proof_expr_mentions_name(fact, stale_name)
                whole: darray[Ast::Expr] = [fact]
                proof_restore_conjuncts(fact, whole, shape.root, written, before, facts, report, annotations, name, position.line, 0)
            proof_transfer_to_place_aliases(shape.root, before, facts, report, annotations, name, position)
            for carried_index in 0..<carried.count |carried_index, carried, facts, report, name, carried_premises, position, before, shape|:
                continue if any existing in facts where proof_expr_equal(existing, carried[carried_index])
                step: mutable darray[Ast::Expr] = proof_marker_facts(before)
                step.push(carried_premises[2 * carried_index])
                step.push(carried_premises[2 * carried_index + 1])
                proof_push_unread_facts(before, shape.root, step) if proof_symbolic_range(carried_premises[2 * carried_index + 1]).known
                proof_add_derived_fact_from(facts, report, carried[carried_index], step, "proof-step", position.line, name)
            return if not proof_stored_reads_survive(stored, shape.root, written, before, annotations)
            return if proof_scalar_element_remaining(Ast::Expr.Ident(shape.root, position), facts, 0) != 1
            cell: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident(shape.root, position), written, position)
            proof_add_traced_fact(facts, report, Ast::Expr.Binary(cell, TokenKind.EqEq, stored, position), "indexed-write", position.line, name)
            proof_close_written_cell(cell, stored, shape.root, before, facts, report, annotations, name, position)
