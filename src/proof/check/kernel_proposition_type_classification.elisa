# Single-pass type-sort and reference-marker classification for proposition source typing.
extend ElisaProof:
    private:
        def proof_source_kernel_numeric_sort(type_name: sview) -> sview:
            return "character" if type_name == "char"
            return "integer" if type_name in {"i8", "i16", "i32", "i64", "i128", "u8", "u16", "u32", "u64", "u128", "usize", "isize", "uintptr", "int", "byte"}
            return "floating" if type_name in {"f16", "f32", "f64", "float"}
            return ""

        # Share one AST and alias walk between proposition sort projection and reference
        # markers. Return classification can demand sort only for by-value results, preserving
        # the reference-first early refusal for unsupported reference returns.
        def proof_source_kernel_type_classify_with_markers(type_expression: Ast::Expr, fallback_name: sview, declarations: darray[Ast::Decl]&, index: ProofSourceKernelTypeIndex, source_work: mutable usize&, depth: usize, collect_markers: bool, sort_if_by_value: bool, sort_required: bool, reference_known: mutable bool&, reference: mutable bool&, mutable_reference: mutable bool&, mutable: mutable bool&) -> (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) can[Memory.Allocate, Abort.Panic]:
            requires depth <= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            decreases PROOF_TYPE_AUDIT_DEPTH_LIMIT - depth
            reference_known <- false
            reference <- false
            mutable_reference <- false
            mutable <- false
            return (false, "", "", "", "", 0, 0) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_source_kernel_charge_expr_span(type_expression, source_work)
            reference_known <- true
            match type_expression:
                Ast::Expr.Absent | Ast::Expr.Invalid:
                    reference_known <- false
                _:
                    pass
            match type_expression:
                Ast::Expr.Paren(inner, _):
                    return proof_source_kernel_type_classify_with_markers(inner, fallback_name, declarations, index, source_work, depth + 1, collect_markers, sort_if_by_value, sort_required, reference_known, reference, mutable_reference, mutable)
                Ast::Expr.Refinement(base, _, _):
                    return proof_source_kernel_type_classify_with_markers(base, fallback_name, declarations, index, source_work, depth + 1, collect_markers, sort_if_by_value, sort_required, reference_known, reference, mutable_reference, mutable)
                Ast::Expr.Unary(operator, inner, _):
                    # `T&?` is a nullable pointer, not a value of the pointee type. Preserve
                    # that distinction in the source-neutral typing environment so replay can
                    # admit null and same-type pointer identity checks, but never numeric/order
                    # operators on the pointer value.
                    if operator == TokenKind.Question:
                        match inner:
                            Ast::Expr.Unary(TokenKind.Ampersand, _, _):
                                if sort_if_by_value and collect_markers and not sort_required:
                                    pointee_markers: (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) = proof_source_kernel_type_classify_with_markers(inner, fallback_name, declarations, index, source_work, depth + 1, true, true, false, reference_known, reference, mutable_reference, mutable)
                                    return (false, "", "", "", "", 0, 0) if pointee_markers.known
                                    reference <- false
                                    if not reference_known:
                                        mutable_reference <- false
                                        mutable <- false
                                    return (false, "", "", "", "", 0, 0)
                                pointee: mutable (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) = (false, "", "", "", "", 0, 0)
                                if sort_if_by_value and collect_markers:
                                    nullable_markers: (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) = proof_source_kernel_type_classify_with_markers(inner, fallback_name, declarations, index, source_work, depth + 1, true, true, false, reference_known, reference, mutable_reference, mutable)
                                    return (false, "", "", "", "", 0, 0) if nullable_markers.known
                                    if not reference_known or not reference:
                                        reference_known <- false
                                        reference <- false
                                        mutable_reference <- false
                                        mutable <- false
                                        return (false, "", "", "", "", 0, 0)
                                    # The exact nullable-reference shape still needs the pointee
                                    # sort. This second, bounded pass preserves the old early
                                    # rejection for malformed or nested reference shapes.
                                    pointee <- proof_source_kernel_type_classify_with_markers(inner, fallback_name, declarations, index, source_work, depth + 1, true, false, true, reference_known, reference, mutable_reference, mutable)
                                else:
                                    pointee <- proof_source_kernel_type_classify_with_markers(inner, fallback_name, declarations, index, source_work, depth + 1, collect_markers, sort_if_by_value, sort_required, reference_known, reference, mutable_reference, mutable)
                                if collect_markers:
                                    reference <- false
                                    if not reference_known:
                                        mutable_reference <- false
                                        mutable <- false
                                return (true, "nullable-reference", pointee.type_name, "", "", pointee.type_identity, 0) if pointee.known and pointee.sort == "named"
                                # Opaque allocator/FFI pointers use `void&?`: retain their
                                # nullability without inventing a pointee identity. Replay admits
                                # null checks and identity checks against another void pointer.
                                return (true, "nullable-opaque-reference", "void", "", "", 0, 0) if pointee.known and pointee.sort == "void"
                                return (false, "", "", "", "", 0, 0)
                            _:
                                reference_known <- false if collect_markers
                                return (false, "", "", "", "", 0, 0)
                    if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        nested_sort_required: bool = false if sort_if_by_value and collect_markers and (operator == TokenKind.Ampersand or operator == TokenKind.Lmut) else sort_required
                        nested_sort: (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) = proof_source_kernel_type_classify_with_markers(inner, fallback_name, declarations, index, source_work, depth + 1, collect_markers, sort_if_by_value, nested_sort_required, reference_known, reference, mutable_reference, mutable)
                        return nested_sort if not collect_markers
                        if operator == TokenKind.Ampersand or operator == TokenKind.Lmut:
                            if not reference_known or reference:
                                reference_known <- false
                                reference <- false
                                mutable_reference <- false
                                mutable <- false
                            else:
                                mutable_reference <- operator == TokenKind.Lmut or (operator == TokenKind.Ampersand and mutable) or mutable_reference
                                reference <- true
                        elif operator == TokenKind.Mutable:
                            if reference_known:
                                mutable_reference <- mutable_reference or reference
                                mutable <- true
                            else:
                                reference <- false
                                mutable_reference <- false
                                mutable <- false
                        return (false, "", "", "", "", 0, 0) if sort_if_by_value and (operator == TokenKind.Ampersand or operator == TokenKind.Lmut)
                        return nested_sort
                    reference_known <- true
                    reference <- false
                    mutable_reference <- false
                    mutable <- false
                _:
                    pass
            has_expression: bool = match type_expression:
                Ast::Expr.Absent: false
                Ast::Expr.Invalid: false
                _: true
            match type_expression:
                Ast::Expr.Tuple(_, tuple_position):
                    tuple_identity: usize = tuple_position.offset.usize() + PROOF_SOURCE_KERNEL_IDENTITY_OFFSET
                    return (tuple_identity != 0, "aggregate", "tuple", "", "", tuple_identity, 0) if sort_required
                    return (false, "", "", "", "", 0, 0)
                _:
                    pass
            if has_expression and sort_required:
                container_resolution_scope: mutable darray[sview] = []
                container_element: (known: bool, element: Ast::Expr) = proof_source_kernel_container_element_type(type_expression, index, declarations, &container_resolution_scope, source_work, 0)
                if container_element.known:
                    return (false, "", "", "", "", 0, 0) if:
                        not proof_source_kernel_charge_work(index.scope_path.count, source_work)
                        not proof_source_kernel_charge_work(container_resolution_scope.count, source_work)
                        not proof_source_kernel_charge_work(index.scope_path.count, source_work)
                    caller_scope: darray[sview] = proof_source_kernel_copy_scope(index.scope_path, index.entries)
                    index.scope_path.clear()
                    index.scope_path.extend(container_resolution_scope)
                    element_reference: (known: bool, is_reference: bool) = proof_source_kernel_type_is_reference(container_element.element, index, source_work, depth + 1)
                    container_sort: (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) = proof_source_kernel_type_sort(container_element.element, "", declarations, index, source_work, depth + 1) if element_reference.known and not element_reference.is_reference else (false, "", "", "", "", 0, 0)
                    index.scope_path.clear()
                    index.scope_path.extend(caller_scope)
                    container_name: sview = proof_source_type_spelling(type_expression, 0)
                    container_identity: usize = Ast::expr_pos(type_expression).offset.usize() + PROOF_SOURCE_KERNEL_IDENTITY_OFFSET
                    return (false, "", "", "", "", 0, 0) if not element_reference.known or element_reference.is_reference
                    return (container_sort.known and container_identity != 0, "container", container_name, container_sort.sort, container_sort.type_name, container_identity, container_sort.type_identity) if container_name != ""
                    return (false, "", "", "", "", 0, 0)
            type_name: sview = proof_source_type_spelling(type_expression, 0) if has_expression else fallback_name
            return (false, "", "", "", "", 0, 0) if type_name == ""
            if has_expression:
                match type_expression:
                    Ast::Expr.Call(_, _, _, _):
                        # Generic instantiations need their type arguments preserved in the
                        # kernel sort. Until that representation exists, they remain unadmitted.
                        return (false, "", "", "", "", 0, 0)
                    _:
                        pass
                selected_type: (count: usize, entry: usize) = proof_source_kernel_type_entry_for_type(index, type_expression, type_name, source_work)
                if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or selected_type.count > 1:
                    reference_known <- false
                    return (false, "", "", "", "", 0, 0)
                if selected_type.count == 1:
                    if selected_type.entry >= index.entries.count:
                        reference_known <- false
                        return (false, "", "", "", "", 0, 0)
                    selected_entry: ProofSourceKernelTypeEntry = index.entries[selected_type.entry]
                    if selected_entry.is_alias:
                        if not proof_source_kernel_charge_work(index.scope_path.count, source_work):
                            reference_known <- false
                            return (false, "", "", "", "", 0, 0)
                        if not proof_source_kernel_charge_work(selected_entry.owner_path.count, source_work):
                            reference_known <- false
                            return (false, "", "", "", "", 0, 0)
                        if not proof_source_kernel_charge_work(index.scope_path.count, source_work):
                            reference_known <- false
                            return (false, "", "", "", "", 0, 0)
                        caller_scope: darray[sview] = proof_source_kernel_copy_scope(index.scope_path, index.entries)
                        index.scope_path.clear()
                        index.scope_path.extend(selected_entry.owner_path)
                        alias_sort: (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) = proof_source_kernel_type_classify_with_markers(selected_entry.target, "", declarations, index, source_work, depth + 1, collect_markers, sort_if_by_value, sort_required, reference_known, reference, mutable_reference, mutable)
                        index.scope_path.clear()
                        index.scope_path.extend(caller_scope)
                        return alias_sort
                    return (true, "named", type_name, "", "", selected_entry.identity, 0) if sort_required and selected_entry.identity != 0
                    return (false, "", "", "", "", 0, 0) if not sort_required
                    return (false, "", "", "", "", 0, 0)
                is_qualified_type: bool = proof_source_kernel_type_is_qualified(type_expression, source_work)
                return (false, "", "", "", "", 0, 0) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or is_qualified_type
            if type_name == "bool":
                return (true, "boolean", "bool", "", "", 0, 0) if sort_required
                return (false, "", "", "", "", 0, 0)
            if type_name in {"cstr", "dstr", "sview"}:
                return (true, "string", type_name, "", "", 0, 0) if sort_required
                return (false, "", "", "", "", 0, 0)
            if type_name == "void":
                return (true, "void", "void", "", "", 0, 0) if sort_required
                return (false, "", "", "", "", 0, 0)
            if type_name == "tuple":
                # A bare spelling loses which named fields are actually present. The source
                # adapter must carry the original tuple type expression and its identity.
                return (false, "", "", "", "", 0, 0)
            if type_name in {"array", "darray", "view", "set", "dict"}:
                return (false, "", "", "", "", 0, 0)
            numeric_sort: sview = proof_source_kernel_numeric_sort(type_name)
            if numeric_sort != "":
                return (true, numeric_sort, type_name, "", "", 0, 0) if sort_required
                return (false, "", "", "", "", 0, 0)
            named_type: sview = proof_source_kernel_type_head_name(type_expression, index, source_work, 0) if has_expression else type_name
            if named_type != "":
                declared_type: (count: usize, identity: usize) = proof_source_kernel_named_type_lookup_at_path(index, type_expression, named_type, source_work)
                reference_known <- false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or declared_type.count != 1
                return (declared_type.count == 1 and declared_type.identity != 0, "named", named_type, "", "", declared_type.identity, 0) if sort_required and declared_type.count == 1
                return (false, "", "", "", "", 0, 0) if not sort_required
                return (false, "", "", "", "", 0, 0)
            return (false, "", "", "", "", 0, 0)

        def proof_source_kernel_type_sort(type_expression: Ast::Expr, fallback_name: sview, declarations: darray[Ast::Decl]&, index: ProofSourceKernelTypeIndex, source_work: mutable usize&, depth: usize) -> (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) can[Memory.Allocate, Abort.Panic]:
            reference_known: mutable bool = false
            reference: mutable bool = false
            mutable_reference: mutable bool = false
            mutable: mutable bool = false
            return proof_source_kernel_type_classify_with_markers(type_expression, fallback_name, declarations, index, source_work, depth, false, false, true, &reference_known, &reference, &mutable_reference, &mutable)
