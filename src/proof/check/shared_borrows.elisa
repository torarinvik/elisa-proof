extend ElisaProof:
    private:
        # A shared borrow excludes every *borrowed* mutable path to the same object, but not a
        # mutable global: a caller may lend one shared into this frame while a callee writes it
        # directly, and the compiler accepts that. So both rules below are withdrawn from the
        # whole program as soon as one mutable global is declared, rather than trying to decide
        # per call which globals a callee can reach.
        #
        # `shared_extent_names` holds every parameter bound by a shared borrow: its element count
        # is fixed for the frame. `shared_fixed_names` is the stronger claim that every field
        # place behind the borrow is fixed for the frame. It does not lean on borrow exclusivity,
        # which the language does not promise for fields: it holds by reachability. Code in this
        # frame, and every callee it reaches, can write caller storage only through a mutable
        # global or a mutable path the frame received. With no mutable global, and with every
        # parameter either a shared borrow or a value, each of whose types holds neither a
        # reference nor a borrowed view, the frame received no mutable path at all, and its own
        # locals are fresh storage that cannot name the caller's object.
        def proof_record_shared_borrows(parameters: darray[Ast::ParamDecl]&, declaration_line: u32, owner_offset: u32, exact_metadata_complete: bool, has_mutable_global: bool, report: mutable ProofReport&) -> void:
            report.aliases.shared_extent_names.clear()
            report.aliases.shared_fixed_names.clear()
            return if has_mutable_global
            closed_frame: mutable bool = true
            for parameter in parameters |report, closed_frame|:
                markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(parameter.type_expression, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, declaration_line, owner_offset, exact_metadata_complete, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work)
                if not markers.complete:
                    closed_frame <- false
                    continue
                reference: bool = markers.reference
                mutable_path: bool = markers.mutable_reference or markers.is_mutable
                pointee: Ast::Expr = proof_type_strip_reference(parameter.type_expression, 0) if reference else parameter.type_expression
                fixed: bool = not mutable_path and proof_type_is_reference_free_with_work(pointee, report.source.source_declarations, report.source.source_annotations, 0, &report.source_types.source_effect_index.work.implicit_effect_work) and not proof_type_contains_borrowed_view_with_work(pointee, report.source.source_declarations, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                closed_frame <- false if not fixed
                continue if not reference or mutable_path
                report.aliases.shared_extent_names.push(parameter.name)
                report.aliases.shared_fixed_names.push(parameter.name) if reference
            report.aliases.shared_fixed_names.clear() if not closed_frame

        def proof_shared_fixed_parameter(report: ProofReport&, names: darray[sview]&, parameters: darray[sview]&, name: sview) -> bool:
            return false if name == "" or not (any fixed in report.aliases.shared_fixed_names where fixed == name)
            proof_current_parameter(names, parameters, name)
