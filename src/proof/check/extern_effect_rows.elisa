# Extern signatures are not body/resource summaries. This decoder consumes only
# complete compiler metadata and never upgrades the legacy first-member hint.
extend ElisaProof:
    private:
        def proof_extern_effect_space(byte: u8) -> bool:
            return byte == 32 or byte == 9 or byte == 10 or byte == 13

        def proof_extern_effect_ident_start(byte: u8) -> bool:
            return byte == 95 or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)

        def proof_extern_effect_ident_continue(byte: u8) -> bool:
            return proof_extern_effect_ident_start(byte) or (byte >= 48 and byte <= 57)

        def proof_decode_extern_effect_text[@r](text: sview, members: mutable darray[sview]& @r) -> bool:
            # Bounded, transactional parsing: no partial row can escape on failure.
            length: usize = sview_len(text)
            return false if length > 4096
            parsed: mutable darray[sview] @r = []
            index: mutable usize = 0
            while index < length and proof_extern_effect_space(sview_at(text, index)):
                index <- index + 1
            if index == length:
                return true
            while index < length:
                return false if parsed.count >= 128 or not proof_extern_effect_ident_start(sview_at(text, index))
                start: usize = index
                index <- index + 1
                while index < length and proof_extern_effect_ident_continue(sview_at(text, index)):
                    index <- index + 1
                while index < length and sview_at(text, index) == 46:
                    index <- index + 1
                    return false if index == length or not proof_extern_effect_ident_start(sview_at(text, index))
                    index <- index + 1
                    while index < length and proof_extern_effect_ident_continue(sview_at(text, index)):
                        index <- index + 1
                member: sview = string_view_slice(text, start.i64(), index.i64())
                parsed.push(member) if not (any existing in parsed where existing == member)
                while index < length and proof_extern_effect_space(sview_at(text, index)):
                    index <- index + 1
                if index == length:
                    members.extend(parsed)
                    return true
                return false if sview_at(text, index) != 44
                index <- index + 1
                while index < length and proof_extern_effect_space(sview_at(text, index)):
                    index <- index + 1
                return false if index == length
            return false

        def proof_import_extern_effect_row[@r](annotations: darray[Ast::EnumAnnotation]&, owner: sview, line: u32, members: mutable darray[sview]& @r) -> bool:
            complete: mutable usize = 0
            rows: mutable usize = 0
            text: mutable sview = ""
            for annotation in annotations:
                continue if annotation.line != line
                complete <- complete + 1 if annotation.owner == owner and annotation.name == "__extern_effect_row_complete"
                if annotation.owner == "__extern_effect_row_text":
                    rows <- rows + 1
                    text <- annotation.name
            return false if owner == "" or complete != 1 or rows != 1
            parsed: mutable darray[sview] @r = []
            return false if not proof_decode_extern_effect_text(text, &parsed)
            # Additional implicit extern effects (for example @blocking) must not
            # disappear when the explicit can-row is imported.
            for annotation in annotations:
                continue if annotation.line != line or annotation.owner != "__extern_effect_ref"
                return false if not (any member in parsed where member == annotation.name)
            members.extend(parsed)
            return true
