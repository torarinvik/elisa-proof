# `pass` and `assert ?` reach the AST as the same invalid expression statement that parser
# recovery leaves for a construct it dropped. The node alone cannot say which one it is, so the
# report carries the lexer's `pass` offsets and the parsed file's hole spans to tell them apart.
extend ElisaProof:
    private:
        const PROOF_INERT_NONE: u8 = 0
        const PROOF_INERT_PASS: u8 = 1
        const PROOF_INERT_HOLE: u8 = 2

        # Lexer tokens are source ordered. Find a pass marker in logarithmic time rather than
        # rescanning every pass token for every invalid expression statement.
        def proof_inert_pass_offset_present(offset: u32, offsets: darray[u32]&) -> bool:
            low: mutable usize = 0
            high: mutable usize = offsets.count
            while low < high |low, high, offsets, offset|:
                middle: usize = low + (high - low) / 2
                if offsets[middle] < offset:
                    low <- middle + 1
                else:
                    high <- middle
            return low < offsets.count and offsets[low] == offset

        # Parsed hole spans normally follow source order. The snapshot validates strict offset
        # ordering once; retain an exact linear fallback if a compiler-produced file violates it.
        def proof_inert_hole_span_present(position: Ast::Pos, report: ProofReport&) -> bool:
            if report.source_syntax.assert_hole_positions_offset_ordered:
                low: mutable usize = 0
                high: mutable usize = report.source_syntax.assert_hole_positions.count
                while low < high |low, high, position, report|:
                    middle: usize = low + (high - low) / 2
                    if report.source_syntax.assert_hole_positions[middle].offset < position.offset:
                        low <- middle + 1
                    else:
                        high <- middle
                return false if low >= report.source_syntax.assert_hole_positions.count
                hole: Ast::Pos = report.source_syntax.assert_hole_positions[low]
                return hole.line == position.line and hole.offset == position.offset and hole.end_offset == position.end_offset
            for hole in report.source_syntax.assert_hole_positions |position|:
                return true if hole.line == position.line and hole.offset == position.offset and hole.end_offset == position.end_offset
            return false

        # A statement is `pass` only when it spans exactly one of the recorded `pass` tokens, and
        # an `assert ?` hole only at a recorded hole span. Every other invalid statement stays
        # unsupported, because it may stand for source that recovery dropped.
        def proof_inert_statement_kind(statement: Ast::Stmt, report: ProofReport&) -> u8:
            match statement:
                Ast::Stmt.Expr(expression, position):
                    match expression:
                        Ast::Expr.Invalid:
                            return PROOF_INERT_HOLE if proof_inert_hole_span_present(position, report)
                            return PROOF_INERT_NONE if position.end_offset < position.offset or position.end_offset - position.offset != 4
                            return PROOF_INERT_PASS if proof_inert_pass_offset_present(position.offset, report.source_syntax.pass_statement_offsets)
                            return PROOF_INERT_NONE
                        _:
                            return PROOF_INERT_NONE
                _:
                    return PROOF_INERT_NONE
