# Owner-scoped generic type-name index used by source proposition formation.
extend ElisaProof:
    private:
        struct ProofSourceKernelGenericParamIndex:
            lines: darray[u32]
            names: darray[sview]
            hashes: mutable darray[u32]
            values: mutable darray[usize]
            counts: mutable darray[usize]
            valid: mutable bool

        # The source effect pass already builds this exact pair index outside the bounded
        # proposition workspace. Borrow its arrays so proposition formation does not allocate
        # a second whole-file generic table inside that 1 MiB region.
        def proof_source_kernel_generic_param_index_from_source(generic_lines: darray[u32]&, generic_names: darray[sview]&, generic_valid: bool, source_generics: ProofSourceEffectIndexGenerics) -> ProofSourceKernelGenericParamIndex:
            index: mutable ProofSourceKernelGenericParamIndex = ProofSourceKernelGenericParamIndex{lines: generic_lines, names: generic_names, hashes: source_generics.generic_param_line_index_hashes, values: source_generics.generic_param_line_index_values, counts: source_generics.generic_param_line_index_counts, valid: false}
            count: usize = generic_lines.count
            return index if not generic_valid or count != generic_names.count
            if count == 0:
                index.valid <- index.hashes.count == 0 and index.values.count == 0 and index.counts.count == 0
                return index
            expected_capacity: usize = proof_name_index_capacity(count)
            index.valid <- expected_capacity != 0 and source_generics.generic_param_line_index_valid and index.hashes.count == expected_capacity and index.values.count == expected_capacity and index.counts.count == expected_capacity
            return index

        # Generic names live in parser side tables rather than the declaration AST. Build one
        # exact `(line, name)` index for the checker pass so every type leaf has bounded lookup
        # cost instead of rescanning all generic rows.
        def proof_source_kernel_generic_param_index_build(generic_lines: darray[u32]&, generic_names: darray[sview]&, generic_valid: bool, source_work: mutable usize&) -> ProofSourceKernelGenericParamIndex can[Memory.Allocate, Abort.Panic]:
            index: mutable ProofSourceKernelGenericParamIndex = ProofSourceKernelGenericParamIndex{lines: generic_lines, names: generic_names, hashes: [], values: [], counts: [], valid: false}
            count: usize = generic_lines.count
            return index if not generic_valid or count != generic_names.count
            if count == 0:
                index.valid <- true
                return index
            capacity: usize = proof_name_index_capacity(count)
            return index if capacity == 0 or not proof_source_kernel_charge_work(capacity, source_work) or not proof_source_kernel_charge_work(capacity, source_work) or not proof_source_kernel_charge_work(capacity, source_work) or not proof_source_kernel_charge_work(capacity, source_work) or not proof_source_kernel_charge_work(capacity, source_work) or not proof_source_kernel_charge_work(count, source_work)
            index.hashes.resize(capacity)
            index.values.resize(capacity)
            index.counts.resize(capacity)
            for slot in 0..<capacity |slot, index, count|:
                index.values[slot] <- count
                index.counts[slot] <- 0
            for row in 0..<count |row, index, count, capacity, source_work|:
                name: sview = index.names[row]
                return index if not proof_source_kernel_charge_work(1, source_work) or not proof_source_kernel_charge_work(sview_len(name), source_work)
                hash: u32 = proof_expr_shape_mix(proof_name_hash(name), index.lines[row].i64())
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, index, count, capacity, source_work, placed|:
                    return index if not proof_source_kernel_charge_work(1, source_work)
                    current: usize = index.values[slot]
                    if current == count:
                        return index if not proof_source_kernel_charge_work(3, source_work)
                        index.hashes[slot] <- hash
                        index.values[slot] <- row
                        index.counts[slot] <- 1
                        placed <- true
                        break
                    return index if current >= count
                    if index.hashes[slot] == hash:
                        current_name: sview = index.names[current]
                        return index if not proof_source_kernel_charge_work(1, source_work) or not proof_source_kernel_charge_work(sview_len(current_name), source_work)
                        if index.lines[current] == index.lines[row] and current_name == name:
                            return index if not proof_source_kernel_charge_work(1, source_work)
                            index.counts[slot] <- index.counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return index if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.values, count, source_work)
            index.valid <- cluster_status.complete and cluster_status.bounded
            return index

        # Check a generic spelling at its owning declaration before treating that spelling as a
        # primitive or named type. Hashes only select candidates; exact metadata equality is
        # still authoritative, and duplicate exact pairs remain ambiguous.
        def proof_source_kernel_generic_type_name_at_owner(name: sview, declaration_line: u32, index: ProofSourceKernelGenericParamIndex, source_work: mutable usize&) -> (complete: bool, matches: usize):
            count: usize = index.lines.count
            return (false, 0) if not index.valid or count != index.names.count
            return (true, 0) if count == 0 and index.hashes.count == 0 and index.values.count == 0 and index.counts.count == 0
            capacity: usize = index.hashes.count
            expected_capacity: usize = proof_name_index_capacity(count)
            return (false, 0) if capacity != index.values.count or capacity != index.counts.count or capacity != expected_capacity or capacity == 0
            return (false, 0) if not proof_source_kernel_charge_work(1, source_work) or not proof_source_kernel_charge_work(sview_len(name), source_work)
            wanted_hash: u32 = proof_expr_shape_mix(proof_name_hash(name), declaration_line.i64())
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, declaration_line, index, count, capacity, source_work|:
                return (false, 0) if not proof_source_kernel_charge_work(1, source_work)
                current: usize = index.values[slot]
                return (true, 0) if current == count
                return (false, 0) if current >= count or index.counts[slot] == 0
                if index.hashes[slot] == wanted_hash:
                    current_name: sview = index.names[current]
                    return (false, 0) if not proof_source_kernel_charge_work(1, source_work) or not proof_source_kernel_charge_work(sview_len(current_name), source_work)
                    if index.lines[current] == declaration_line and current_name == name:
                        return (false, 0) if index.counts[slot] != 1
                        return (true, 1)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, 0)

        def proof_source_kernel_type_mentions_owner_generic(expression: Ast::Expr, declaration_line: u32, generic_index: ProofSourceKernelGenericParamIndex, source_work: mutable usize&, depth: usize) -> (complete: bool, matches: bool) can[Memory.Allocate, Abort.Panic]:
            requires depth <= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            decreases PROOF_TYPE_AUDIT_DEPTH_LIMIT - depth
            return (false, false) if not generic_index.valid or generic_index.lines.count != generic_index.names.count
            return (true, false) if generic_index.lines.count == 0
            return (false, false) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_source_kernel_charge_work(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    lookup: (complete: bool, matches: usize) = proof_source_kernel_generic_type_name_at_owner(name, declaration_line, generic_index, source_work)
                    return (lookup.complete, lookup.matches != 0)
                Ast::Expr.Scope(base, name, _):
                    leaf: (complete: bool, matches: usize) = proof_source_kernel_generic_type_name_at_owner(name, declaration_line, generic_index, source_work)
                    return (false, false) if not leaf.complete
                    return (true, true) if leaf.matches != 0
                    return proof_source_kernel_type_mentions_owner_generic(base, declaration_line, generic_index, source_work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_source_kernel_type_mentions_owner_generic(inner, declaration_line, generic_index, source_work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    first: (complete: bool, matches: bool) = proof_source_kernel_type_mentions_owner_generic(base, declaration_line, generic_index, source_work, depth + 1)
                    return (false, false) if not first.complete
                    return (true, true) if first.matches
                    return proof_source_kernel_type_mentions_owner_generic(predicate, declaration_line, generic_index, source_work, depth + 1)
                Ast::Expr.Index(base, argument, _) | Ast::Expr.Binary(base, _, argument, _):
                    first: (complete: bool, matches: bool) = proof_source_kernel_type_mentions_owner_generic(base, declaration_line, generic_index, source_work, depth + 1)
                    return (false, false) if not first.complete
                    return (true, true) if first.matches
                    return proof_source_kernel_type_mentions_owner_generic(argument, declaration_line, generic_index, source_work, depth + 1)
                Ast::Expr.IndexN(base, arguments, _) | Ast::Expr.Call(base, arguments, _, _):
                    first: (complete: bool, matches: bool) = proof_source_kernel_type_mentions_owner_generic(base, declaration_line, generic_index, source_work, depth + 1)
                    return (false, false) if not first.complete
                    return (true, true) if first.matches
                    for argument in arguments |argument, declaration_line, generic_index, source_work, depth|:
                        nested: (complete: bool, matches: bool) = proof_source_kernel_type_mentions_owner_generic(argument, declaration_line, generic_index, source_work, depth + 1)
                        return (false, false) if not nested.complete
                        return (true, true) if nested.matches
                    return (true, false)
                Ast::Expr.Tuple(elements, _) | Ast::Expr.Array(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |element, declaration_line, generic_index, source_work, depth|:
                        nested: (complete: bool, matches: bool) = proof_source_kernel_type_mentions_owner_generic(element, declaration_line, generic_index, source_work, depth + 1)
                        return (false, false) if not nested.complete
                        return (true, true) if nested.matches
                    return (true, false)
                Ast::Expr.Construct(type_expression, _, _):
                    return proof_source_kernel_type_mentions_owner_generic(type_expression, declaration_line, generic_index, source_work, depth + 1)
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return (true, false)
                Ast::Expr.Absent:
                    return (true, false)
                Ast::Expr.Invalid:
                    return (false, false)
                _:
                    # Unknown AST forms may contain a generic name. Refuse to publish a
                    # primitive source type until this traversal explicitly covers them.
                    return (false, false)
