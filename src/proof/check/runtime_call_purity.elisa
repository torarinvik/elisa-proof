# Runtime purity walk for expressions that contain executable calls.
extend ElisaProof:
    private:
        def proof_runtime_calls_are_pure(expression: Ast::Expr, functions: mutable ProofFunctionTable&) -> bool:
            # Call-presence scans charge their actual visits. Only expressions with calls need
            # the additional fresh-result classifier and transitive purity reservations.
            source_work: mutable usize = functions.lookup.runtime_call_analysis_source_work
            has_call: bool = proof_expr_has_call_with_work(expression, &source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            functions.lookup.runtime_call_analysis_source_work <- source_work
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            proof_runtime_calls_are_pure_with_known_presence(expression, functions, has_call)

        # Admission callers that already scanned this expression can pass the result here to
        # avoid paying for a second identical call-presence traversal. The shared table meter
        # still covers all later classification and purity work.
        def proof_runtime_calls_are_pure_with_known_presence(expression: Ast::Expr, functions: mutable ProofFunctionTable&, has_call: bool) -> bool:
            source_work: mutable usize = functions.lookup.runtime_call_analysis_source_work
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true if not has_call
            work_complete: bool = proof_replay_summary_expr_repeat_charge_with_work(expression, 2, &source_work)
            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1 if not work_complete
            functions.lookup.runtime_call_analysis_source_work <- source_work
            return false if not work_complete
            has_fresh_call_result: bool = proof_expr_has_fresh_call_result_with_fallback_work(expression, functions, 0, &source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            functions.lookup.runtime_call_analysis_source_work <- source_work
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or has_fresh_call_result
            return proof_runtime_calls_are_pure_depth(expression, functions, 0)

        def proof_runtime_calls_are_pure_depth(expression: Ast::Expr, functions: mutable ProofFunctionTable&, depth: usize) -> bool:
            # Purity is used as an admission gate. An unvisited nested term must fail closed;
            # otherwise a deep impure call could disappear from the transitive purity check.
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return true
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.ShorthandMember(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    argument_names_valid: bool = argument_names.count == 0 or argument_names.count == arguments.count
                    unlabelled_arguments: mutable bool = argument_names_valid
                    if argument_names.count == arguments.count:
                        for label in argument_names |unlabelled_arguments|:
                            unlabelled_arguments <- false if label != ""
                    scalar_conversion: sview = proof_ident_name(proof_strip_parens(callee))
                    if scalar_conversion != "" and proof_builtin_scalar_type_name(scalar_conversion):
                        return false if not unlabelled_arguments or arguments.count != 1
                        return proof_runtime_calls_are_pure_depth(arguments[0], functions, depth + 1)
                    # Only the guarded classifier may establish that a method-shaped cast is
                    # builtin rather than a user `__cast__` hook.
                    conversion: (known: bool, receiver: Ast::Expr) = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                    return proof_runtime_calls_are_pure_depth(conversion.receiver, functions, depth + 1) if conversion.known and unlabelled_arguments
                    numeric_cast: (known: bool, receiver: Ast::Expr) = proof_runtime_builtin_numeric_cast(proof_strip_parens(callee), arguments.count, functions)
                    if numeric_cast.known and unlabelled_arguments:
                        match proof_strip_parens(callee):
                            Ast::Expr.Field(_, method, _):
                                return proof_runtime_calls_are_pure_depth(numeric_cast.receiver, functions, depth + 1) if proof_resource_pure_conversion(method)
                            _:
                                pass
                    called: sview = proof_callable_name(callee)
                    called_index: usize = proof_function_index_for_callee(functions, callee)
                    return false if called == "" or called_index >= functions.summaries.pure.count or not functions.summaries.pure[called_index]
                    # Syntactic purity is not enough to preserve facts across an executable
                    # call. The body may still be unsupported (for example, an overloaded
                    # operator can hide a global write), and a recursive component is only
                    # provisional while its members are being checked. Only a completed,
                    # independently verified summary may cross this state-preservation gate.
                    return false if:
                        called_index >= functions.summaries.verified.count or not functions.summaries.verified[called_index]
                        called_index >= functions.summaries.verification_reasons.count or functions.summaries.verification_reasons[called_index] == "pending"
                        not proof_runtime_calls_are_pure_depth(callee, functions, depth + 1)
                    for argument in arguments |functions|:
                        return false if not proof_runtime_calls_are_pure_depth(argument, functions, depth + 1)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_runtime_calls_are_pure_depth(inner, functions, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_runtime_calls_are_pure_depth(operand, functions, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_runtime_calls_are_pure_depth(left, functions, depth + 1) and proof_runtime_calls_are_pure_depth(right, functions, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_runtime_calls_are_pure_depth(object, functions, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_runtime_calls_are_pure_depth(base, functions, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_runtime_calls_are_pure_depth(object, functions, depth + 1) and proof_runtime_calls_are_pure_depth(index, functions, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_runtime_calls_are_pure_depth(object, functions, depth + 1) and proof_runtime_calls_are_pure_depth(low, functions, depth + 1) and proof_runtime_calls_are_pure_depth(high, functions, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_runtime_calls_are_pure_depth(object, functions, depth + 1)
                    for argument in arguments |functions|:
                        return false if not proof_runtime_calls_are_pure_depth(argument, functions, depth + 1)
                    return true
                Ast::Expr.Move(operand, _):
                    return proof_runtime_calls_are_pure_depth(operand, functions, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |functions|:
                        return false if not proof_runtime_calls_are_pure_depth(element, functions, depth + 1)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements |functions|:
                        return false if not proof_runtime_calls_are_pure_depth(element, functions, depth + 1)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements |functions|:
                        return false if not proof_runtime_calls_are_pure_depth(element, functions, depth + 1)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |functions|:
                        return false if not proof_runtime_calls_are_pure_depth(entry.key, functions, depth + 1) or not proof_runtime_calls_are_pure_depth(entry.value, functions, depth + 1)
                    return true
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |functions|:
                        return false if not proof_runtime_calls_are_pure_depth(field.value, functions, depth + 1)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_runtime_calls_are_pure_depth(base, functions, depth + 1)
                    for field in fields |functions|:
                        return false if not proof_runtime_calls_are_pure_depth(field.value, functions, depth + 1)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_runtime_calls_are_pure_depth(condition, functions, depth + 1) and proof_runtime_calls_are_pure_depth(then_expr, functions, depth + 1) and proof_runtime_calls_are_pure_depth(else_expr, functions, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return false if not proof_runtime_calls_are_pure_depth(scrutinee, functions, depth + 1)
                    for arm in arms |functions|:
                        return false if:
                            not proof_runtime_calls_are_pure_depth(arm.guard, functions, depth + 1)
                            arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return false if not proof_runtime_calls_are_pure_depth(value, functions, depth + 1)
                            _:
                                return false
                    return true
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_runtime_calls_are_pure_depth(iterable, functions, depth + 1) and proof_runtime_calls_are_pure_depth(condition, functions, depth + 1) and proof_runtime_calls_are_pure_depth(body, functions, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_runtime_calls_are_pure_depth(base, functions, depth + 1) and proof_runtime_calls_are_pure_depth(predicate, functions, depth + 1)
                Ast::Expr.GetElse(_, _, _):
                    # Recovery executes control flow outside this purity walk. The statement
                    # checker owns that boundary and must not inherit a blanket purity claim.
                    return false
                Ast::Expr.Catch(_, _, _):
                    # Catch arms have their own value/error-state checker; treating them as a
                    # pure expression here could hide a call in an arm that this walk does not
                    # model.
                    return false
                Ast::Expr.Lambda(_, _, _):
                    # Closures carry executable bodies and are not part of the pure expression
                    # fragment. Their body must never be accepted through this fallback.
                    return false
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return false if not proof_runtime_calls_are_pure_depth(initializer, functions, depth + 1)
                            _:
                                return false
                    return proof_runtime_calls_are_pure_depth(value, functions, depth + 1)
                _:
                    # New AST forms are not pure until their evaluation and call effects are
                    # represented explicitly above.
                    return false
