# A finite range search owns its fresh scalar result and writes no caller state.
extend ElisaProof:
    private:
        def proof_pure_search_read(expression: Ast::Expr, globals: darray[sview]&, report: ProofReport&) -> bool:
            return false if not proof_pure_expression_shape(expression) or proof_expr_has_call(expression) or proof_expr_has_move(expression)
            return false if proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
            return not proof_expr_mentions_any_global(expression, globals)

        def proof_pure_search_steps(body: darray[Ast::Stmt]&, accumulator: sview, binder: sview, globals: darray[sview]&, report: ProofReport&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64 or body.count > 4096
            for statement in body |accumulator, binder, globals, report, depth, work|:
                return false if work >= 4096
                work <- work + 1
                match statement:
                    Ast::Stmt.Contract("invariant", expression, _):
                        return false if not proof_pure_search_read(expression, globals, report)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if not proof_pure_search_read(condition, globals, report)
                        return false if not proof_pure_search_steps(yes, accumulator, binder, globals, report, depth + 1, work)
                        return false if not proof_pure_search_steps(no, accumulator, binder, globals, report, depth + 1, work)
                    Ast::Stmt.Assign(Ast::Expr.Ident(local, _), TokenKind.LArrow, Ast::Expr.Ident(value, _), _):
                        return false if local != accumulator or value != binder
                    Ast::Stmt.Break(label, _):
                        return false if label != ""
                    Ast::Stmt.Expr(expression, _):
                        return false if proof_inert_statement_kind(statement, report) != PROOF_INERT_PASS
                    _:
                        return false
            return true

        def proof_pure_search_value(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, globals: darray[sview]&, report: ProofReport&, depth: usize) -> bool:
            return false if depth >= 64
            match expression:
                Ast::Expr.Block(statements, yielded, captures, _):
                    return false if captures.count != 0
                    return proof_pure_search_value(yielded, parameters, globals, report, depth + 1) if statements.count == 0
                    return false if statements.count != 2
                    accumulator: mutable sview = ""
                    match statements[0]:
                        Ast::Stmt.VarDecl(local, type_expression, initializer, _):
                            return false if local == "" or proof_unsigned_type_width(type_expression, report.source_declarations, 0) <= 0
                            return false if any parameter in parameters where parameter.name == local
                            return false if any global_name in globals where global_name == local
                            return false if not proof_pure_search_read(initializer, globals, report)
                            accumulator <- local
                        _:
                            return false
                    return false if proof_ident_name(yielded) != accumulator
                    match statements[1]:
                        Ast::Stmt.For(bind, variables, iterable, body, _):
                            return false if bind != "" or variables.count != 1 or variables[0] == accumulator
                            return false if any parameter in parameters where parameter.name == variables[0]
                            return false if any global_name in globals where global_name == variables[0]
                            match iterable:
                                Ast::Expr.Binary(low, TokenKind.RangeLt, high, _):
                                    return false if not proof_pure_search_read(low, globals, report) or not proof_pure_search_read(high, globals, report)
                                    return false if proof_source_expression_has_overloaded_operator(iterable, report.source_primitive_operator_mask, 0)
                                _:
                                    return false
                            work: mutable usize = 0
                            return proof_pure_search_steps(body, accumulator, variables[0], globals, report, 0, &work)
                        _:
                            return false
                _:
                    return false

        def proof_pure_range_search_body(body: darray[Ast::Stmt]&, parameters: darray[Ast::ParamDecl]&, globals: darray[sview]&, report: ProofReport&) -> bool:
            return false if body.count > 64
            searches: mutable usize = 0
            for statement in body |parameters, globals, report, searches|:
                match statement:
                    Ast::Stmt.Contract(kind, expression, _):
                        return false if not proof_is_ensure_kind(kind) or not proof_pure_search_read(expression, globals, report)
                    Ast::Stmt.Expr(expression, _):
                        return false if not proof_pure_search_value(expression, parameters, globals, report, 0)
                        searches <- searches + 1
                    Ast::Stmt.Return(value, _):
                        if value is expression:
                            return false if not proof_pure_search_value(expression, parameters, globals, report, 0)
                            searches <- searches + 1
                        else:
                            return false
                    _:
                        return false
            return searches == 1
