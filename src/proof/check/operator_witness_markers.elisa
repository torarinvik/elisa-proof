extend ElisaProof:
    private:
        # String views are compiler-provided value types, but unlike integers they are still
        # eligible for a user `impl Eq for sview`. Keep their operator admission separate from
        # the arithmetic scalar witness relation: a marker here means only that this particular
        # protocol dispatch is absent from the imported source, not that a string is an integer
        # term the arithmetic kernel may evaluate.
        def proof_builtin_operator_type_name(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> sview can[Global.Read]:
            return "" if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name if name == "sview" or name == "cstr" or name == "dstr"
                    # Only float mode (syntactic goals) admits float operators; see proof_float_mode.
                    return name if (proof_float_mode can Global.Read) and (name == "f64" or name == "f32")
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return (proof_builtin_operator_type_name(alias.target, declarations, depth + 1) can Global.Read) if alias.count == 1
                    return ""
                Ast::Expr.Index(head, _, _):
                    return "cstr" if proof_ident_name(head) == "cstr"
                    return ""
                Ast::Expr.Paren(inner, _):
                    return (proof_builtin_operator_type_name(inner, declarations, depth + 1) can Global.Read)
                Ast::Expr.Refinement(base, _, _):
                    return (proof_builtin_operator_type_name(base, declarations, depth + 1) can Global.Read)
                Ast::Expr.Unary(operator, inner, _):
                    return (proof_builtin_operator_type_name(inner, declarations, depth + 1) can Global.Read) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                _:
                    return ""

        def proof_builtin_operator_protocol(operator: TokenKind) -> sview:
            return "Eq" if operator == TokenKind.EqEq or operator == TokenKind.BangEq
            return "Ord" if operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
            return "Add" if operator == TokenKind.Plus
            return "Sub" if operator == TokenKind.Minus
            return "Mul" if operator == TokenKind.Star
            return "Div" if operator == TokenKind.Slash
            return ""

        def proof_builtin_unary_operator_protocol(operator: TokenKind) -> sview:
            return "Neg" if operator == TokenKind.Minus
            return ""

        def proof_index_operator_protocol(protocol: sview) -> sview:
            return "Index.Eq" if protocol == "Eq"
            return "Index.Ord" if protocol == "Ord"
            return "Index.Add" if protocol == "Add"
            return "Index.Sub" if protocol == "Sub"
            return "Index.Mul" if protocol == "Mul"
            return "Index.Div" if protocol == "Div"
            return "Index.Neg" if protocol == "Neg"
            return ""

        def proof_builtin_operator_marker(term: Ast::Expr, protocol: sview, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term, Ast::Expr.StringLit(protocol, position)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_builtin_operator_type", position), arguments, [], position)

        def proof_untrusted_operator_marker(term: Ast::Expr, protocol: sview, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term, Ast::Expr.StringLit(protocol, position)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_untrusted_operator_type", position), arguments, [], position)

        def proof_builtin_index_marker(term: Ast::Expr, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_builtin_index_type", position), arguments, [], position)

        def proof_index_operator_marker(term: Ast::Expr, protocol: sview, position: Ast::Pos, trusted: bool) -> Ast::Expr:
            indexed_protocol: sview = proof_index_operator_protocol(protocol)
            return proof_builtin_operator_marker(term, indexed_protocol, position) if trusted
            return proof_untrusted_operator_marker(term, indexed_protocol, position)

        def proof_builtin_operator_marker_info(expression: Ast::Expr) -> (known: bool, term: Ast::Expr, protocol: sview):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid, "") if proof_ident_name(callee) != "__elisa_builtin_operator_type" or arguments.count != 2
                    return (false, Ast::Expr.Invalid, "") if argument_names.count != 0 and argument_names.count != arguments.count
                    match arguments[1]:
                        Ast::Expr.StringLit(protocol, _):
                            return (true, arguments[0], protocol) if protocol != ""
                        _:
                            pass
                    return (false, Ast::Expr.Invalid, "")
                _:
                    return (false, Ast::Expr.Invalid, "")

        def proof_untrusted_operator_marker_info(expression: Ast::Expr) -> (known: bool, term: Ast::Expr, protocol: sview):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid, "") if proof_ident_name(callee) != "__elisa_untrusted_operator_type" or arguments.count != 2
                    return (false, Ast::Expr.Invalid, "") if argument_names.count != 0 and argument_names.count != arguments.count
                    match arguments[1]:
                        Ast::Expr.StringLit(protocol, _):
                            return (true, arguments[0], protocol) if protocol != ""
                        _:
                            pass
                    return (false, Ast::Expr.Invalid, "")
                _:
                    return (false, Ast::Expr.Invalid, "")

        def proof_builtin_index_marker_info(expression: Ast::Expr) -> (known: bool, term: Ast::Expr):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid) if proof_ident_name(callee) != "__elisa_builtin_index_type" or arguments.count != 1
                    return (false, Ast::Expr.Invalid) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (true, arguments[0])
                _:
                    return (false, Ast::Expr.Invalid)
