# Indexed generic and type-alias name lookups shared by source conversion checks.
extend ElisaProof:
    private:
        def proof_source_conversion_generic_owner_key_hash(name: sview, declaration_line: u32, declaration_offset: usize) -> u32:
            hash: u32 = proof_expr_shape_mix(proof_name_hash(name), declaration_line.i64())
            proof_expr_shape_mix(hash, declaration_offset.i64())

        def proof_source_conversion_generic_function_key_hash(declaration_line: u32, declaration_offset: usize) -> u32:
            hash: u32 = proof_expr_shape_mix(0, declaration_line.i64())
            proof_expr_shape_mix(hash, declaration_offset.i64())

        # The parser emits this marker together with each function generic row. Unlike the
        # compatibility line/name arrays, its declaration offset distinguishes same-line owners.
        def proof_source_conversion_generic_owner_index_ensure(report: mutable ProofReport&) -> bool:
            index: mutable ProofSourceEffectIndexGenerics& = &report.source_types.source_effect_index.generics
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if index.generic_owner_index_attempted and index.generic_owner_index_report_identity == report_identity and index.generic_owner_index_source_identity == source_identity:
                return index.generic_owner_index_valid and index.generic_function_index_valid
            index.generic_owner_index_hashes.clear()
            index.generic_owner_index_values.clear()
            index.generic_owner_index_counts.clear()
            index.generic_owner_index_entries <- 0
            index.generic_function_index_hashes.clear()
            index.generic_function_index_values.clear()
            index.generic_function_index_counts.clear()
            index.generic_function_index_entries <- 0
            index.generic_function_index_valid <- false
            index.generic_owner_index_attempted <- true
            index.generic_owner_index_valid <- false
            index.generic_owner_index_report_identity <- report_identity
            index.generic_owner_index_source_identity <- source_identity
            annotations: darray[Ast::EnumAnnotation]& = report.source.source_annotations
            marker_count: mutable usize = 0
            function_count: mutable usize = 0
            for annotation in annotations |annotation, marker_count, function_count, report|:
                return false if not proof_source_index_work_charge(report, 1)
                if annotation.name == "__generic_param_identity" and annotation.line == 3900000131:
                    marker_count <- marker_count + 1
                if annotation.name == "__lsp_func_name":
                    function_count <- function_count + 1
            index.generic_owner_index_entries <- marker_count
            index.generic_function_index_entries <- function_count
            if marker_count == 0:
                index.generic_owner_index_valid <- true
            capacity: usize = proof_name_index_capacity(marker_count)
            return false if marker_count > 0 and capacity == 0
            if marker_count > 0:
                return false if not proof_source_index_work_charge(report, capacity) or not proof_source_index_work_charge(report, marker_count)
                index.generic_owner_index_hashes.resize(capacity)
                index.generic_owner_index_values.resize(capacity)
                index.generic_owner_index_counts.resize(capacity)
                for slot in 0..<capacity |slot, index, annotations|:
                    index.generic_owner_index_values[slot] <- annotations.count
                    index.generic_owner_index_counts[slot] <- 0
            if function_count == 0:
                index.generic_function_index_valid <- true
            function_capacity: usize = proof_name_index_capacity(function_count)
            return false if function_count > 0 and function_capacity == 0
            if function_count > 0:
                return false if not proof_source_index_work_charge(report, function_capacity) or not proof_source_index_work_charge(report, function_count)
                index.generic_function_index_hashes.resize(function_capacity)
                index.generic_function_index_values.resize(function_capacity)
                index.generic_function_index_counts.resize(function_capacity)
                for slot in 0..<function_capacity |slot, index, annotations|:
                    index.generic_function_index_values[slot] <- annotations.count
                    index.generic_function_index_counts[slot] <- 0
            if marker_count > 0 or function_count > 0:
                for annotation_index in 0..<annotations.count |annotation_index, annotations, index, capacity, function_capacity, report|:
                    annotation: Ast::EnumAnnotation = annotations[annotation_index]
                    return false if not proof_source_index_work_charge(report, 1)
                    if marker_count > 0 and annotation.name == "__generic_param_identity" and annotation.line == 3900000131:
                        return false if not proof_source_index_work_charge(report, sview_len(annotation.owner))
                        generic_hash: u32 = proof_source_conversion_generic_owner_key_hash(annotation.owner, annotation.detail_line, annotation.offset.usize())
                        generic_slot: mutable usize = (generic_hash.i64() % capacity.i64()).usize()
                        generic_probes: mutable usize = 0
                        generic_placed: mutable bool = false
                        while generic_probes < capacity and generic_probes <= PROOF_NAME_INDEX_MAX_CLUSTER |generic_probes, generic_slot, generic_hash, annotation_index, annotation, annotations, index, capacity, report, generic_placed|:
                            return false if not proof_source_index_work_charge(report, 1)
                            generic_current: usize = index.generic_owner_index_values[generic_slot]
                            if generic_current == annotations.count:
                                index.generic_owner_index_hashes[generic_slot] <- generic_hash
                                index.generic_owner_index_values[generic_slot] <- annotation_index
                                index.generic_owner_index_counts[generic_slot] <- 1
                                generic_placed <- true
                                break
                            return false if generic_current >= annotations.count
                            if index.generic_owner_index_hashes[generic_slot] == generic_hash:
                                generic_prior: Ast::EnumAnnotation = annotations[generic_current]
                                return false if not proof_source_index_work_charge(report, sview_len(generic_prior.owner))
                                if generic_prior.owner == annotation.owner and generic_prior.detail_line == annotation.detail_line and generic_prior.offset == annotation.offset:
                                    index.generic_owner_index_counts[generic_slot] <- index.generic_owner_index_counts[generic_slot] + 1
                                    generic_placed <- true
                                    break
                            generic_slot <- (generic_slot + 1) % capacity
                            generic_probes <- generic_probes + 1
                        return false if not generic_placed
                    if function_count > 0 and annotation.name == "__lsp_func_name":
                        function_hash: u32 = proof_source_conversion_generic_function_key_hash(annotation.line, annotation.offset.usize())
                        function_slot: mutable usize = (function_hash.i64() % function_capacity.i64()).usize()
                        function_probes: mutable usize = 0
                        function_placed: mutable bool = false
                        while function_probes < function_capacity and function_probes <= PROOF_NAME_INDEX_MAX_CLUSTER |function_probes, function_slot, function_hash, annotation_index, annotation, annotations, index, function_capacity, report, function_placed|:
                            return false if not proof_source_index_work_charge(report, 1)
                            function_current: usize = index.generic_function_index_values[function_slot]
                            if function_current == annotations.count:
                                index.generic_function_index_hashes[function_slot] <- function_hash
                                index.generic_function_index_values[function_slot] <- annotation_index
                                index.generic_function_index_counts[function_slot] <- 1
                                function_placed <- true
                                break
                            return false if function_current >= annotations.count
                            function_prior: Ast::EnumAnnotation = annotations[function_current]
                            if index.generic_function_index_hashes[function_slot] == function_hash and function_prior.line == annotation.line and function_prior.offset == annotation.offset:
                                index.generic_function_index_counts[function_slot] <- index.generic_function_index_counts[function_slot] + 1
                                function_placed <- true
                                break
                            function_slot <- (function_slot + 1) % function_capacity
                            function_probes <- function_probes + 1
                        return false if not function_placed
            if marker_count > 0:
                source_work: mutable usize = index.work.implicit_effect_work
                cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.generic_owner_index_values, annotations.count, &source_work)
                index.work.implicit_effect_work <- source_work
                index.generic_owner_index_valid <- cluster.complete and cluster.bounded and source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if function_count > 0:
                source_work: mutable usize = index.work.implicit_effect_work
                function_cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.generic_function_index_values, annotations.count, &source_work)
                index.work.implicit_effect_work <- source_work
                index.generic_function_index_valid <- function_cluster.complete and function_cluster.bounded and source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return index.generic_owner_index_valid and index.generic_function_index_valid

        def proof_source_conversion_generic_owner_lookup(name: sview, declaration_line: u32, declaration_offset: usize, report: mutable ProofReport&) -> (complete: bool, count: usize):
            return (false, 0) if not proof_source_conversion_generic_owner_index_ensure(report)
            index: ProofSourceEffectIndexGenerics& = report.source_types.source_effect_index.generics
            hashes_count: usize = index.generic_owner_index_hashes.count
            entries: usize = index.generic_owner_index_entries
            return (false, 0) if hashes_count != index.generic_owner_index_values.count or hashes_count != index.generic_owner_index_counts.count
            return (true, 0) if entries == 0 and hashes_count == 0
            expected_capacity: usize = proof_name_index_capacity(entries)
            return (false, 0) if entries == 0 or expected_capacity == 0 or hashes_count != expected_capacity or not index.generic_owner_index_valid
            return (false, 0) if not proof_source_index_work_charge(report, 1) or not proof_source_index_work_charge(report, sview_len(name))
            wanted_hash: u32 = proof_source_conversion_generic_owner_key_hash(name, declaration_line, declaration_offset)
            slot: mutable usize = (wanted_hash.i64() % hashes_count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes_count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, declaration_line, declaration_offset, report, index, hashes_count|:
                return (false, 0) if not proof_source_index_work_charge(report, 1)
                current: usize = index.generic_owner_index_values[slot]
                return (true, 0) if current == report.source.source_annotations.count
                return (false, 0) if current >= report.source.source_annotations.count or index.generic_owner_index_counts[slot] == 0
                if index.generic_owner_index_hashes[slot] == wanted_hash:
                    annotation: Ast::EnumAnnotation = report.source.source_annotations[current]
                    return (false, 0) if not proof_source_index_work_charge(report, sview_len(annotation.owner))
                    if annotation.owner == name and annotation.detail_line == declaration_line and annotation.offset.usize() == declaration_offset:
                        return (false, 0) if index.generic_owner_index_counts[slot] != 1
                        return (true, index.generic_owner_index_counts[slot])
                slot <- (slot + 1) % hashes_count
                probes <- probes + 1
            return (false, 0)

        def proof_source_conversion_generic_function_owner_lookup(declaration_line: u32, declaration_offset: usize, report: mutable ProofReport&) -> (complete: bool, found: bool):
            return (false, false) if not proof_source_conversion_generic_owner_index_ensure(report)
            index: ProofSourceEffectIndexGenerics& = report.source_types.source_effect_index.generics
            hashes_count: usize = index.generic_function_index_hashes.count
            entries: usize = index.generic_function_index_entries
            return (false, false) if hashes_count != index.generic_function_index_values.count or hashes_count != index.generic_function_index_counts.count
            return (true, false) if entries == 0 and hashes_count == 0
            expected_capacity: usize = proof_name_index_capacity(entries)
            return (false, false) if entries == 0 or expected_capacity == 0 or hashes_count != expected_capacity or not index.generic_function_index_valid
            return (false, false) if not proof_source_index_work_charge(report, 1)
            wanted_hash: u32 = proof_source_conversion_generic_function_key_hash(declaration_line, declaration_offset)
            slot: mutable usize = (wanted_hash.i64() % hashes_count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes_count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, declaration_line, declaration_offset, report, index, hashes_count|:
                return (false, false) if not proof_source_index_work_charge(report, 1)
                current: usize = index.generic_function_index_values[slot]
                return (true, false) if current == report.source.source_annotations.count
                return (false, false) if current >= report.source.source_annotations.count or index.generic_function_index_counts[slot] == 0
                if index.generic_function_index_hashes[slot] == wanted_hash:
                    annotation: Ast::EnumAnnotation = report.source.source_annotations[current]
                    if annotation.name == "__lsp_func_name" and annotation.line == declaration_line and annotation.offset.usize() == declaration_offset:
                        return (false, false) if index.generic_function_index_counts[slot] != 1
                        return (true, true)
                slot <- (slot + 1) % hashes_count
                probes <- probes + 1
            return (false, false)

        def proof_source_conversion_generic_line_lookup(name: sview, generic_owner_line: u32, report: mutable ProofReport&) -> (complete: bool, count: usize):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            count: usize = report.source_types.source_generic_param_lines.count
            return (false, 0) if not report.source_types.source_generic_params_valid or count != report.source_types.source_generic_param_names.count
            hashes_count: usize = index.generics.generic_param_line_index_hashes.count
            return (false, 0) if hashes_count != index.generics.generic_param_line_index_values.count or hashes_count != index.generics.generic_param_line_index_counts.count
            return (true, 0) if count == 0 and hashes_count == 0
            expected_capacity: usize = proof_name_index_capacity(count)
            return (false, 0) if:
                count == 0 or expected_capacity == 0 or hashes_count != expected_capacity or not index.generics.generic_param_line_index_valid
                not proof_source_index_work_charge(report, 1)
                not proof_source_index_work_charge(report, sview_len(name))
            wanted_hash: u32 = proof_expr_shape_mix(proof_name_hash(name), generic_owner_line.i64())
            slot: mutable usize = (wanted_hash.i64() % hashes_count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes_count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, generic_owner_line, report, index, count, hashes_count|:
                return (false, 0) if not proof_source_index_work_charge(report, 1)
                current: usize = index.generics.generic_param_line_index_values[slot]
                return (true, 0) if current == count
                return (false, 0) if current > count
                if index.generics.generic_param_line_index_hashes[slot] == wanted_hash:
                    return (false, 0) if current >= report.source_types.source_generic_param_names.count or current >= report.source_types.source_generic_param_lines.count
                    current_name: sview = report.source_types.source_generic_param_names[current]
                    return (false, 0) if not proof_source_index_work_charge(report, 1) or not proof_source_index_work_charge(report, sview_len(current_name))
                    if report.source_types.source_generic_param_lines[current] == generic_owner_line and current_name == name:
                        return (false, 0) if index.generics.generic_param_line_index_counts[slot] != 1
                        return (true, index.generics.generic_param_line_index_counts[slot])
                slot <- (slot + 1) % hashes_count
                probes <- probes + 1
            return (false, 0)

        def proof_source_conversion_generic_name(name: sview, generic_owner_line: u32, report: mutable ProofReport&, owner_known: bool = false) -> (complete: bool, count: usize):
            return (false, 0) if generic_owner_line == 0
            if report.context.current_goal_owner_line == generic_owner_line:
                exact: (complete: bool, count: usize) = proof_source_conversion_generic_owner_lookup(name, generic_owner_line, report.context.current_goal_owner_offset.usize(), report)
                return (false, 0) if not exact.complete
                return (false, 0) if exact.count > 1
                return exact if exact.count > 0
                function_owner: (complete: bool, found: bool) = proof_source_conversion_generic_function_owner_lookup(generic_owner_line, report.context.current_goal_owner_offset.usize(), report)
                return (false, 0) if not function_owner.complete
                return (true, 0) if function_owner.found
                # Function checking sets this context from the active declaration's
                # AST position. An exact owner miss must not fall through to the
                # line-only index, where another same-line function's binder could
                # shadow this function's type name.
                return (true, 0)
            # A known declaration owner must never use the line-only compatibility index:
            # distinct declarations can share a line, and that index cannot establish which
            # owner's generic binders are in scope. Callers without an owner may retain the
            # legacy unique-line lookup.
            return (false, 0) if owner_known
            return proof_source_conversion_generic_line_lookup(name, generic_owner_line, report)

        def proof_source_conversion_scope_root_name(head: Ast::Expr, report: mutable ProofReport&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_source_index_work_charge(report, 1)
            match head:
                Ast::Expr.Ident(name, _):
                    return (false, "") if not proof_source_index_work_charge(report, sview_len(name))
                    return (true, name)
                Ast::Expr.Scope(parent, _, _):
                    return proof_source_conversion_scope_root_name(parent, report, depth + 1)
                _:
                    return (true, "")

        # Stage1 applies module aliases to a bare qualified-type root before looking up the
        # type. Reuse the source-bound module index built for fact publication, and follow the
        # backend's first-global-alias chain with a cycle bound before hashing the scoped name.
        def proof_source_conversion_name_lookup(name: sview, names: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if:
                name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
                not proof_source_index_work_charge(report, sview_len(name))
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, names, hashes, values, counts, name_count, report|:
                return (false, 2, name_count) if not proof_source_index_work_charge(report, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == wanted_hash:
                    current_name: sview = names[current]
                    return (false, 2, name_count) if not proof_source_index_work_charge(report, sview_len(current_name))
                    if current_name == name:
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_source_conversion_name_lookup_work(name: sview, names: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, source_work: mutable usize&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if:
                name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
                not proof_report_source_work_charge(sview_len(name), source_work)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, names, hashes, values, counts, name_count, source_work|:
                return (false, 2, name_count) if not proof_report_source_work_charge(1, source_work)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == wanted_hash:
                    current_name: sview = names[current]
                    return (false, 2, name_count) if not proof_report_source_work_charge(sview_len(current_name), source_work)
                    if current_name == name:
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)
