extend ElisaProof:
    private:
        def proof_structural_check_body(body: darray[Ast::Stmt]&, own_name: sview, subject_position: usize, parameters: darray[Ast::ParamDecl]&, destructurable: darray[sview]&, smaller: darray[ProofStructuralSmaller]&, report: mutable ProofReport&, name: sview) -> void:
            current_destructurable: mutable darray[sview] = proof_copy_names(destructurable)
            current_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(smaller)
            for statement in body |own_name, subject_position, parameters, current_destructurable, current_smaller, report, name|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        proof_structural_check_expression(returned, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name) if value is returned
                    Ast::Stmt.Expr(expression, _):
                        proof_structural_check_expression(expression, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                    Ast::Stmt.VarDecl(local_name, _, initializer, position):
                        proof_structural_termination_finding(report, position.line, name, "a local binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, local_name)
                        proof_structural_check_expression(initializer, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        blocked: darray[sview] = [local_name]
                        current_destructurable <- proof_structural_without(current_destructurable, blocked)
                        current_smaller <- proof_structural_smaller_without(current_smaller, blocked)
                    Ast::Stmt.Assign(target, _, initializer, position):
                        target_name: sview = proof_ident_name(target)
                        proof_structural_termination_finding(report, position.line, name, "an assignment binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, target_name)
                        proof_structural_check_expression(target, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        proof_structural_check_expression(initializer, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        blocked: darray[sview] = [proof_ident_name(target)]
                        current_destructurable <- proof_structural_without(current_destructurable, blocked)
                        current_smaller <- proof_structural_smaller_without(current_smaller, blocked)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_structural_check_expression(condition, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        then_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        then_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(then_body, own_name, subject_position, parameters, &then_destructurable, &then_smaller, report, name)
                        else_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        else_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(else_body, own_name, subject_position, parameters, &else_destructurable, &else_smaller, report, name)
                        current_destructurable <- proof_structural_intersect(then_destructurable, else_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(then_smaller, else_smaller)
                    Ast::Stmt.While(condition, while_body, _):
                        proof_structural_check_expression(condition, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        loop_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        loop_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(while_body, own_name, subject_position, parameters, &loop_destructurable, &loop_smaller, report, name)
                        current_destructurable <- proof_structural_intersect(current_destructurable, loop_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(current_smaller, loop_smaller)
                    Ast::Stmt.For(_, loop_variables, iterable, for_body, position):
                        proof_structural_check_expression(iterable, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        for loop_variable in loop_variables |loop_variable, report, own_name, name, statement|:
                            proof_structural_termination_finding(report, position.line, name, "a loop binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, loop_variable)
                        loop_destructurable: mutable darray[sview] = proof_structural_without(current_destructurable, loop_variables)
                        loop_smaller: mutable darray[ProofStructuralSmaller] = proof_structural_smaller_without(current_smaller, loop_variables)
                        # Each element of a matched AST side-table is a strict subterm of the
                        # enclosing AST node. Promote loop variables only for an iterable already
                        # known to be such a subterm; ordinary user collections never enter this
                        # structural environment.
                        if proof_structural_argument_is_smaller(iterable, current_smaller):
                            iterable_subject: sview = proof_structural_argument_subject(iterable, current_smaller)
                            iterable_subject_identity: usize = proof_structural_argument_subject_identity(iterable, current_smaller)
                            for loop_variable in loop_variables |loop_variable, loop_smaller|:
                                loop_smaller.push(ProofStructuralSmaller{name: loop_variable, subject: iterable_subject, identity: proof_structural_fresh_identity(report), subject_identity: iterable_subject_identity}) if not any candidate in loop_smaller where candidate.name == loop_variable
                        proof_structural_check_body(for_body, own_name, subject_position, parameters, &loop_destructurable, &loop_smaller, report, name)
                        current_destructurable <- proof_structural_intersect(current_destructurable, loop_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(current_smaller, loop_smaller)
                    Ast::Stmt.Match(scrutinee, arms, position):
                        proof_structural_check_expression(scrutinee, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        merged_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        merged_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        first_arm: mutable bool = true
                        for arm in arms |own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, merged_destructurable, merged_smaller, first_arm|:
                            arm_bindings: mutable darray[sview] = []
                            proof_structural_pattern_bindings(arm.pattern, &arm_bindings)
                            for arm_binding in arm_bindings |arm_binding, report, name, position|:
                                proof_structural_termination_finding(report, position.line, name, "a pattern binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, arm_binding)
                            arm_destructurable: mutable darray[sview] = proof_structural_without(current_destructurable, arm_bindings)
                            arm_smaller: mutable darray[ProofStructuralSmaller] = proof_structural_smaller_without(current_smaller, arm_bindings)
                            scrutinee_name: sview = proof_ident_name(scrutinee)
                            if proof_structural_name_in(current_destructurable, scrutinee_name):
                                proof_structural_pattern_bindings(arm.pattern, &arm_destructurable)
                                proof_structural_pattern_subterms(arm.pattern, scrutinee_name, proof_structural_binding_identity(scrutinee, current_smaller, parameters), &arm_smaller, report)
                            proof_structural_check_expression(arm.guard, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name)
                            proof_structural_check_body(arm.body, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name)
                            arm_outer_destructurable: darray[sview] = proof_structural_intersect(current_destructurable, arm_destructurable)
                            arm_outer_smaller: darray[ProofStructuralSmaller] = proof_structural_smaller_intersect(current_smaller, arm_smaller)
                            if first_arm:
                                merged_destructurable <- arm_outer_destructurable
                                merged_smaller <- arm_outer_smaller
                                first_arm <- false
                            else:
                                merged_destructurable <- proof_structural_intersect(merged_destructurable, arm_outer_destructurable)
                                merged_smaller <- proof_structural_smaller_intersect(merged_smaller, arm_outer_smaller)
                        current_destructurable <- merged_destructurable if not first_arm
                        current_smaller <- merged_smaller if not first_arm
                    Ast::Stmt.Block(block_kind, _, _, block_body, position):
                        if block_kind == "assert_by" and block_body.count > 0:
                            match block_body[0]:
                                Ast::Stmt.Contract(_, goal, _):
                                    proof_structural_check_expression(goal, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                                _:
                                    pass
                        if block_kind != "assert_by":
                            block_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                            block_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                            match statement:
                                Ast::Stmt.Block(_, _, binding, _, _):
                                    blocked: darray[sview] = [binding]
                                    proof_structural_termination_finding(report, position.line, name, "a block binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, binding)
                                    block_destructurable <- proof_structural_without(block_destructurable, blocked) if binding != ""
                                    block_smaller <- proof_structural_smaller_without(block_smaller, blocked) if binding != ""
                                _:
                                    pass
                            proof_structural_check_body(block_body, own_name, subject_position, parameters, &block_destructurable, &block_smaller, report, name)
                            current_destructurable <- proof_structural_intersect(current_destructurable, block_destructurable)
                            current_smaller <- proof_structural_smaller_intersect(current_smaller, block_smaller)
                    Ast::Stmt.Contract(kind, expression, _):
                        proof_structural_check_expression(expression, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name) if kind == "assert"
                    _:
                        pass

        def proof_structural_signature_contract_table_valid(signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, source_work: mutable usize&) -> bool:
            contract_count: usize = signature_lines.count
            return false if:
                contract_count != signature_kinds.count or contract_count != signature_contracts.count
                not proof_report_source_work_charge(3, source_work)
            if contract_count > 1:
                for contract_index in 1..<contract_count |contract_index, signature_lines, source_work|:
                    return false if:
                        not proof_report_source_work_charge(1, source_work)
                        signature_lines[contract_index] < signature_lines[contract_index - 1]
            return true

        # Contract rows are source ordered. Validate that invariant once, then use two
        # bounded searches per function instead of rescanning the module's whole contract table.
        def proof_structural_signature_contract_range_for_line(signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, declaration_line: u32, source_work: mutable usize&) -> (complete: bool, start: usize, count: usize):
            contract_count: usize = signature_lines.count
            return (false, 0, 0) if contract_count != signature_kinds.count or contract_count != signature_contracts.count
            low: mutable usize = 0
            high: mutable usize = contract_count
            while low < high |low, high, signature_lines, declaration_line, source_work|:
                return (false, 0, 0) if not proof_report_source_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                if signature_lines[middle] < declaration_line:
                    low <- middle + 1
                else:
                    high <- middle
            start: usize = low
            high <- contract_count
            while low < high |low, high, signature_lines, declaration_line, source_work|:
                return (false, 0, 0) if not proof_report_source_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                if signature_lines[middle] <= declaration_line:
                    low <- middle + 1
                else:
                    high <- middle
            return (true, start, low - start)

        def proof_structural_function_has_implicit_dispatch_risk_range(function_name: sview, declaration_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, contract_start: usize, contract_count: usize, source_work: mutable usize&, report: mutable ProofReport&) -> bool:
            return true if:
                proof_source_function_has_drop_risk(function_name, declaration_line, parameters, body, report)
                proof_structural_typed_operator_defaults_have_overload(parameters, declaration_line, report)
                proof_structural_typed_operator_statements_have_overload(body, parameters, declaration_line, report, 0)
            for parameter in parameters |parameters, report|:
                return true if parameter.has_default and proof_source_expression_has_unsafe_runtime_index(parameter.default_value, parameters, report, 0, [])
            return true if:
                proof_source_statements_have_unsafe_runtime_index(body, parameters, report, 0, [])
                signature_lines.count != signature_kinds.count or signature_kinds.count != signature_contracts.count
                contract_start > signature_contracts.count or contract_count > signature_contracts.count - contract_start
            for offset in 0..<contract_count |offset, contract_start, declaration_line, signature_lines, signature_kinds, signature_contracts, report, source_work|:
                return true if not proof_report_source_work_charge(1, source_work)
                contract_index: usize = contract_start + offset
                return true if signature_lines[contract_index] != declaration_line
                kind: sview = signature_kinds[contract_index]
                return true if not proof_source_index_work_charge(report, 1 + sview_len(kind))
                continue if kind != "requires" and kind != "ensure"
                expression: Ast::Expr = signature_contracts[contract_index]
                return true if:
                    proof_source_expression_has_drop_risk(expression, parameters, declaration_line, report, 0)
                    proof_structural_typed_operator_expression_has_overload(expression, parameters, declaration_line, report, 0)
                    proof_source_expression_has_unsafe_runtime_index(expression, parameters, report, 0, [])
            return false

        # Source call-graph edges do not include operations lowered to implicit trait calls,
        # indexing hooks, or generated drops. Record those hazards per function so they can be
        # propagated only to structural callers that can reach the function.
        def proof_structural_function_has_implicit_dispatch_risk(function_name: sview, declaration_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, source_work: mutable usize&, report: mutable ProofReport&) -> bool:
            contract_range: (complete: bool, start: usize, count: usize) = proof_structural_signature_contract_range_for_line(signature_lines, signature_kinds, signature_contracts, declaration_line, source_work)
            return true if not contract_range.complete
            return proof_structural_function_has_implicit_dispatch_risk_range(function_name, declaration_line, parameters, body, signature_lines, signature_kinds, signature_contracts, contract_range.start, contract_range.count, source_work, report)

        def proof_structural_source_type_is_byte_darray(type_expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> bool:
            return false if depth >= 32 or not proof_source_index_work_charge(report, 1)
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_structural_source_type_is_byte_darray(inner, report, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_structural_source_type_is_byte_darray(inner, report, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return false
                Ast::Expr.Index(head, element, _):
                    return false if not proof_source_index_work_charge(report, sview_len(proof_ident_name(head)) + sview_len(proof_ident_name(element)))
                    return proof_ident_name(head) == "darray" and proof_ident_name(element) == "u8"
                Ast::Expr.IndexN(head, elements, _):
                    return false if elements.count != 1 or not proof_source_index_work_charge(report, sview_len(proof_ident_name(head)) + sview_len(proof_ident_name(elements[0])))
                    return proof_ident_name(head) == "darray" and proof_ident_name(elements[0]) == "u8"
                _:
                    return false

        def proof_structural_source_type_head_name(type_expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= 32
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_structural_source_type_head_name(inner, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_structural_source_type_head_name(inner, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                _:
                    return proof_head_name(type_expression)

        def proof_structural_field_conversion_type_supported(method: sview, receiver: Ast::Expr, parameters: darray[Ast::ParamDecl]&, declaration_line: u32, report: mutable ProofReport&) -> bool:
            receiver_type: (known: bool, type_expression: Ast::Expr) = proof_structural_source_value_type(receiver, parameters, report, 0, [])
            return false if not receiver_type.known
            active_aliases: mutable darray[usize] = []
            unwrapped_type: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(receiver_type.type_expression, declaration_line, true, "", report, &active_aliases, 0)
            return false if not unwrapped_type.complete
            if method == "as_sview":
                return false if not proof_structural_source_type_is_byte_darray(unwrapped_type.type_expression, report, 0)
                element: (known: bool, element: Ast::Expr) = proof_structural_builtin_container_element_type(unwrapped_type.type_expression, report)
                return element.known and proof_ident_name(element.element) == "u8"
            type_name: sview = proof_structural_source_type_head_name(unwrapped_type.type_expression, 0)
            return type_name in {"sview", "dstr", "cstr"} if method == "sview"
            return proof_builtin_scalar_type_name(type_name)

        def proof_check_structural_function(enum_index: ProofEnumIndex, function_name: sview, declaration_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], extern_contract_summary_complete: bool, reachable_extern_contract_unsafe: bool, reachable_unresolved_call: bool, signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, source_work: mutable usize&, report: mutable ProofReport&) -> void:
            if not report.structural.function_name_index_valid:
                proof_structural_termination_finding(report, declaration_line, function_name, "source callable name index was unavailable for structural checking")
                return
            if report.structural.component_ids.count != report.structural.names.count:
                proof_structural_termination_finding(report, declaration_line, function_name, "recursive component index was unavailable for structural checking")
                return
            decreases_clauses: darray[Ast::Expr] = proof_contracts(body, "decreases")
            components: mutable darray[Ast::Expr] = []
            proof_decreases_component_slice(decreases_clauses, &components)
            inferred_structural: mutable bool = false
            if components.count == 0:
                inferred: (known: bool, parameter: sview, position: usize, type_name: sview) = proof_infer_structural_decrease(enum_index, parameters)
                components.push(Ast::Expr.Ident(inferred.parameter, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})) if inferred.known
                inferred_structural <- inferred.known
            return if components.count != 1
            subject: sview = proof_ident_name(components[0])
            subject_position: mutable usize = proof_enum_parameter_position(enum_index, parameters, subject)
            return if subject_position >= parameters.count
            # A missing decreases clause on a function with several enum parameters denotes the
            # product ranking handled by the recursive-edge check above. Use the parameter-count
            # sentinel to select that mode without widening explicitly written rankings.
            enum_subjects: darray[sview] = proof_enum_parameter_names(enum_index, parameters)
            subject_position <- parameters.count if inferred_structural and enum_subjects.count > 1
            destructurable: mutable darray[sview] = [subject]
            destructurable <- enum_subjects if subject_position >= parameters.count
            smaller: mutable darray[ProofStructuralSmaller] = []
            own_lookup: (complete: bool, found: bool, row: usize) = proof_structural_name_lookup(report, function_name)
            if not own_lookup.complete or not own_lookup.found:
                proof_structural_termination_finding(report, declaration_line, function_name, "source callable name lookup exceeded its validated bound")
                return
            own_index: usize = own_lookup.row
            finding_start: usize = report.findings.count
            if not extern_contract_summary_complete:
                proof_structural_termination_finding(report, declaration_line, function_name, "reachable callable extern contracts could not be classified within their validated bound")
                return
            proof_structural_termination_finding(report, declaration_line, function_name, "a reachable callable extern contract may hide recursive edges") if reachable_extern_contract_unsafe
            proof_structural_termination_finding(report, declaration_line, function_name, "a reachable opaque call or implicit dispatch may hide a structural recursive edge") if reachable_unresolved_call
            proof_structural_termination_finding(report, declaration_line, function_name, "an unmodeled destructor or opaque source call in this structural function may hide recursive calls") if proof_source_function_has_drop_risk(function_name, declaration_line, parameters, body, report)
            # Operator implementations and user-defined indexers are implicit calls and are
            # absent from the current source call graph. Reject these paths unless a runtime
            # index receiver is statically known to be a built-in container.
            for parameter in parameters |parameter, report, function_name|:
                if parameter.has_default:
                    proof_structural_termination_finding(report, Ast::expr_pos(parameter.default_value).line, function_name, "overloaded operators in structural defaults may hide recursive calls") if proof_structural_typed_operator_expression_has_overload(parameter.default_value, parameters, declaration_line, report, 0)
                    proof_structural_termination_finding(report, Ast::expr_pos(parameter.default_value).line, function_name, "user-defined indexing in structural defaults may hide recursive calls") if proof_source_expression_has_unsafe_runtime_index(parameter.default_value, parameters, report, 0, [])
            if proof_structural_typed_operator_statements_have_overload(body, parameters, declaration_line, report, 0):
                proof_structural_termination_finding(report, 0, function_name, "overloaded operators in structural bodies may hide recursive calls")
            if proof_source_statements_have_unsafe_runtime_index(body, parameters, report, 0, []):
                proof_structural_termination_finding(report, 0, function_name, "user-defined indexing in structural bodies may hide recursive calls")
            contract_range: (complete: bool, start: usize, count: usize) = proof_structural_signature_contract_range_for_line(signature_lines, signature_kinds, signature_contracts, declaration_line, source_work)
            if not contract_range.complete or contract_range.start > signature_contracts.count or contract_range.count > signature_contracts.count - contract_range.start:
                proof_structural_termination_finding(report, declaration_line, function_name, "the signature contract source snapshot is malformed")
            else:
                for offset in 0..<contract_range.count |offset, contract_range, report, function_name, signature_kinds, signature_contracts, source_work|:
                    contract_index: usize = contract_range.start + offset
                    kind: sview = signature_kinds[contract_index]
                    if not proof_report_source_work_charge(1 + sview_len(kind), &source_work):
                        proof_structural_termination_finding(report, declaration_line, function_name, "signature contract source work exceeded its validated bound")
                        return
                    continue if kind != "requires" and kind != "ensure"
                    expression: Ast::Expr = signature_contracts[contract_index]
                    if not proof_replay_summary_expr_charge_with_work(expression, &source_work) or not proof_replay_summary_expr_charge_with_work(expression, &source_work) or not proof_replay_summary_expr_charge_with_work(expression, &source_work):
                        proof_structural_termination_finding(report, Ast::expr_pos(expression).line, function_name, "signature contract source work exceeded its validated bound")
                        return
                    if proof_structural_typed_operator_expression_has_overload(expression, parameters, declaration_line, report, 0) or proof_source_expression_has_unsafe_runtime_index(expression, parameters, report, 0, []):
                        proof_structural_termination_finding(report, Ast::expr_pos(expression).line, function_name, "implicit operator or index dispatch in structural signature contracts may hide recursive calls")
                    proof_structural_check_expression(expression, function_name, subject_position, parameters, destructurable, smaller, report, function_name)
            for parameter in parameters |parameter, report, function_name|:
                proof_structural_termination_finding(report, 0, function_name, "a parameter shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, parameter.name)
            # Defaults are evaluated at a call site before entering the function body. They do
            # not inherit any branch-local pattern evidence, so any recursive or mutual call in
            # a structural default must fail closed instead of being certified from body binds.
            for parameter in parameters |parameter, own_name, subject_position, parameters, destructurable, smaller, report, function_name|:
                proof_structural_check_expression(parameter.default_value, function_name, subject_position, parameters, destructurable, smaller, report, function_name) if parameter.has_default
            proof_structural_check_body(body, function_name, subject_position, parameters, destructurable, smaller, report, function_name)
            structural_failed: mutable bool = false
            for finding_index in finding_start..<report.findings.count |finding_index, report, function_name, structural_failed|:
                structural_failed <- true if report.findings[finding_index].kind == "structural-decreases-unproven" and report.findings[finding_index].name == function_name
            if not structural_failed:
                report.structural.verified_names.push(function_name)

        def proof_check_structural_termination(file: Ast::File&, declarations: darray[Ast::Decl], functions: ProofFunctionTable&, report: mutable ProofReport&, initialize: bool) -> void:
            # This routine recurses into nested modules/scopes. Publish the immutable
            # function-table metadata only for the outer invocation; clearing it in a nested
            # invocation would erase the accumulated structural certificates and repeat the
            # whole SCC comparison work.
            if initialize:
                report.structural.names.clear()
                report.structural.function_name_index_hashes.clear()
                report.structural.function_name_index_values.clear()
                report.structural.function_name_index_ambiguous.clear()
                report.structural.function_name_index_valid <- false
                report.structural.subject_positions.clear()
                report.structural.subject_types.clear()
                report.structural.component_ids.clear()
                report.structural.members.clear()
                proof_structural_component_index_build(functions, report)
                for index in 0..<functions.lookup.names.count |index, functions, report|:
                    report.structural.names.push(functions.lookup.names[index])
                    report.structural.subject_positions.push(functions.contracts.termination.structural_subject_positions[index] if index < functions.contracts.termination.structural_subject_positions.count else functions.parameters.metadata.param_counts[index])
                    report.structural.subject_types.push(functions.contracts.termination.structural_subject_types[index] if index < functions.contracts.termination.structural_subject_types.count else "")
                    report.structural.members.push(functions.contracts.termination.structural[index] if index < functions.contracts.termination.structural.count else false)
                index_count: usize = functions.lookup.index_values.count
                index_shape_valid: bool = index_count == functions.lookup.index_hashes.count and index_count == functions.lookup.index_ambiguous.count
                if functions.lookup.names.count == 0:
                    index_shape_valid <- index_shape_valid and index_count == 0
                else:
                    expected_capacity: usize = proof_name_index_capacity(functions.lookup.names.count)
                    index_shape_valid <- index_shape_valid and expected_capacity != 0 and index_count == expected_capacity
                index_shape_valid <- false if report.structural.names.count != functions.lookup.names.count
                if index_shape_valid:
                    if index_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3:
                        functions.lookup.module_resolution_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                    elif proof_report_source_work_charge(index_count * 3, &functions.lookup.module_resolution_work_used):
                        report.structural.function_name_index_hashes.extend(functions.lookup.index_hashes)
                        report.structural.function_name_index_values.extend(functions.lookup.index_values)
                        report.structural.function_name_index_ambiguous.extend(functions.lookup.index_ambiguous)
                        report.structural.function_name_index_valid <- true
                    else:
                        functions.lookup.module_resolution_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            for declaration in declarations |file, functions, report|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, position):
                        function_index: usize = proof_function_index_at_line(functions, name, position.line)
                        if function_index < functions.contracts.termination.structural.count and functions.contracts.termination.structural[function_index]:
                            unresolved_reachable: bool = function_index >= functions.call_graph.reachable_unresolved_calls.count or functions.call_graph.reachable_unresolved_calls[function_index]
                            saved_caller: usize = report.fact_call_shapes.active_caller
                            report.fact_call_shapes.active_caller <- function_index
                            proof_check_structural_function(functions.type_indexes.enum_index, name, position.line, parameters, body, functions.externs.extern_contract_analysis_complete and function_index < functions.externs.reachable_extern_contract_unsafe.count, functions.externs.extern_contract_analysis_complete and function_index < functions.externs.reachable_extern_contract_unsafe.count and functions.externs.reachable_extern_contract_unsafe[function_index], unresolved_reachable, report.source_signature_contract_lines, report.source_signature_contract_kinds, report.source_signature_contracts, functions.lookup.module_resolution_work_used, report)
                            report.fact_call_shapes.active_caller <- saved_caller
                    Ast::Decl.Module(_, module_body, _):
                        proof_check_structural_termination(file, module_body, functions, report, false)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_check_structural_termination(file, scoped_body, functions, report, false)
                    _:
                        pass

        # Determine whether a function can reach a target in the collected executable call
        # graph. This is deliberately finite and name-based; ambiguous/unknown targets are not
        # treated as edges, while an unsupported expression marks its own function opaque below.
        def proof_function_reaches(functions: ProofFunctionTable&, source: usize, target: usize) -> bool:
            return false if source >= functions.lookup.names.count or target >= functions.lookup.names.count
            reachable: mutable darray[usize] = [source]
            cursor: mutable usize = 0
            while cursor < reachable.count |cursor, reachable, functions, target|:
                current: usize = reachable[cursor]
                # A malformed flat-table alignment must fail closed: if this node is the
                # queried target, do not let missing graph metadata turn a possible self-edge
                # into an admitted summary.
                return true if current == target and (current >= functions.call_graph.call_starts.count or current >= functions.call_graph.call_counts.count)
                return false if current >= functions.call_graph.call_starts.count or current >= functions.call_graph.call_counts.count
                start: usize = functions.call_graph.call_starts[current]
                count: usize = functions.call_graph.call_counts[current]
                for offset in 0..<count |offset, start, functions, reachable, target|:
                    return true if current == target and start + offset >= functions.call_graph.all_calls.count
                    continue if start + offset >= functions.call_graph.all_calls.count
                    called: sview = functions.call_graph.all_calls[start + offset]
                    if called == "__opaque_call__":
                        return true if current == target
                    else:
                        next: usize = proof_function_call_target(functions, start + offset)
                        if next < functions.lookup.names.count:
                            return true if next == target
                            already_seen: bool = proof_usize_seen(reachable, next)
                            reachable.push(next) if not already_seen
                cursor <- cursor + 1
            return false

        def proof_functions_same_recursive_component(functions: ProofFunctionTable&, source: usize, target: usize) -> bool:
            return false if source >= functions.lookup.names.count or target >= functions.lookup.names.count
            return true if source == target
            return false if:
                source >= functions.summaries.recursive.count or target >= functions.summaries.recursive.count
                not functions.summaries.recursive[source] or not functions.summaries.recursive[target]
            if source < functions.summaries.recursive_component_ids.count and target < functions.summaries.recursive_component_ids.count:
                return functions.summaries.recursive_component_ids[source] == functions.summaries.recursive_component_ids[target]
            return proof_function_reaches(functions, source, target) and proof_function_reaches(functions, target, source)

        # Compute executable SCCs with iterative Kosaraju traversal. Summary scheduling and
        # structural recursion then use the stable component ids instead of re-running a full
        # transitive reachability search for every pair of functions.
        def proof_build_function_components(functions: mutable ProofFunctionTable&) -> void:
            count: usize = functions.lookup.names.count
            functions.summaries.recursive.clear()
            functions.summaries.recursive_component_ids.clear()
            return if count == 0
            reverse_counts: mutable darray[usize] = []
            reverse_counts.resize(count)
            self_edges: mutable darray[bool] = []
            self_edges.resize(count)
            for source in 0..<count |source, functions, reverse_counts, self_edges|:
                start: usize = functions.call_graph.call_starts[source] if source < functions.call_graph.call_starts.count else functions.call_graph.all_calls.count
                edge_count: usize = functions.call_graph.call_counts[source] if source < functions.call_graph.call_counts.count else 0
                valid_range: bool = start <= functions.call_graph.all_calls.count and edge_count <= functions.call_graph.all_calls.count - start
                continue if not valid_range
                for offset in 0..<edge_count |offset, source, start, functions, reverse_counts, self_edges|:
                    called: sview = functions.call_graph.all_calls[start + offset]
                    next: usize = proof_function_call_target(functions, start + offset)
                    continue if next >= count
                    reverse_counts[next] <- reverse_counts[next] + 1
                    self_edges[source] <- true if next == source
            reverse_starts: mutable darray[usize] = []
            reverse_cursor: mutable usize = 0
            for incoming in reverse_counts |reverse_starts, reverse_cursor|:
                reverse_starts.push(reverse_cursor)
                reverse_cursor <- reverse_cursor + incoming
            reverse_edges: mutable darray[usize] = []
            reverse_edges.resize(reverse_cursor)
            reverse_write: mutable darray[usize] = []
            reverse_write.extend(reverse_starts)
            for source in 0..<count |source, functions, reverse_write, reverse_edges|:
                start: usize = functions.call_graph.call_starts[source] if source < functions.call_graph.call_starts.count else functions.call_graph.all_calls.count
                edge_count: usize = functions.call_graph.call_counts[source] if source < functions.call_graph.call_counts.count else 0
                valid_range: bool = start <= functions.call_graph.all_calls.count and edge_count <= functions.call_graph.all_calls.count - start
                continue if not valid_range
                for offset in 0..<edge_count |offset, source, start, functions, reverse_write, reverse_edges|:
                    next: usize = proof_function_call_target(functions, start + offset)
                    continue if next >= count
                    slot: usize = reverse_write[next]
                    reverse_edges[slot] <- source
                    reverse_write[next] <- slot + 1
            visited: mutable darray[bool] = []
            visited.resize(count)
            order: mutable darray[usize] = []
            for source in 0..<count |source, visited, order, functions|:
                continue if visited[source]
                stack_nodes: mutable darray[usize] = [source]
                stack_offsets: mutable darray[usize] = [0]
                visited[source] <- true
                while stack_nodes.count > 0 |stack_nodes, stack_offsets, visited, order, functions|:
                    top: usize = stack_nodes.count - 1
                    current: usize = stack_nodes[top]
                    start: usize = functions.call_graph.call_starts[current] if current < functions.call_graph.call_starts.count else functions.call_graph.all_calls.count
                    edge_count: usize = functions.call_graph.call_counts[current] if current < functions.call_graph.call_counts.count else 0
                    valid_range: bool = start <= functions.call_graph.all_calls.count and edge_count <= functions.call_graph.all_calls.count - start
                    if valid_range and stack_offsets[top] < edge_count:
                        offset: usize = stack_offsets[top]
                        stack_offsets[top] <- offset + 1
                        next: usize = proof_function_call_target(functions, start + offset)
                        if next < count and not visited[next]:
                            visited[next] <- true
                            stack_nodes.push(next)
                            stack_offsets.push(0)
                    else:
                        order.push(current)
                        stack_nodes <- stack_nodes.truncate(top)
                        stack_offsets <- stack_offsets.truncate(top)
            component_ids: mutable darray[usize] = []
            component_ids.resize(count)
            for index in 0..<count |index, component_ids|:
                component_ids[index] <- count
            for order_index in 0..<order.count |order_index, order, component_ids, reverse_starts, reverse_counts, reverse_edges, count|:
                seed: usize = order[order.count - 1 - order_index]
                continue if component_ids[seed] < count
                component_ids[seed] <- seed
                component_work: mutable darray[usize] = [seed]
                while component_work.count > 0 |component_work, component_ids, reverse_starts, reverse_counts, reverse_edges, count|:
                    current: usize = component_work[component_work.count - 1]
                    component_work <- component_work.truncate(component_work.count - 1)
                    start: usize = reverse_starts[current]
                    edge_count: usize = reverse_counts[current]
                    for offset in 0..<edge_count |offset, start, reverse_edges, component_ids, component_work, current|:
                        predecessor: usize = reverse_edges[start + offset]
                        if component_ids[predecessor] == count:
                            component_ids[predecessor] <- seed
                            component_work.push(predecessor)
            component_sizes: mutable darray[usize] = []
            component_sizes.resize(count)
            for index in 0..<count |index, component_ids, component_sizes, count|:
                component_sizes[component_ids[index]] <- component_sizes[component_ids[index]] + 1
            for index in 0..<count |index, component_ids, component_sizes, self_edges, functions|:
                functions.summaries.recursive_component_ids.push(component_ids[index])
                functions.summaries.recursive.push(component_sizes[component_ids[index]] > 1 or self_edges[index])

        # Syntactic purity is intentionally a small total-function tier. It admits straight-line
        # value computation, pure conditionals, and only the finite built-in loops admitted by
        # purity_and_function_index. Assignments, hidden block scope, runtime assertions, and
        # ownership/region effects remain outside this tier. Calls are allowed only after the
        # declaration-independent fixed point below proves every reachable callee pure.
        def proof_pure_expression_shape(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return true
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_pure_expression_shape(callee)
                    for argument in arguments:
                        return false if not proof_pure_expression_shape(argument)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_pure_expression_shape(inner)
                Ast::Expr.Unary(_, operand, _):
                    return proof_pure_expression_shape(operand)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_pure_expression_shape(left) and proof_pure_expression_shape(right)
                Ast::Expr.Field(object, _, _):
                    return proof_pure_expression_shape(object)
                Ast::Expr.Scope(base, _, _):
                    return proof_pure_expression_shape(base)
                Ast::Expr.Index(object, index, _):
                    return proof_pure_expression_shape(object) and proof_pure_expression_shape(index)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_pure_expression_shape(object) and proof_pure_expression_shape(low) and proof_pure_expression_shape(high)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_pure_expression_shape(object)
                    for argument in arguments:
                        return false if not proof_pure_expression_shape(argument)
                    return true
                Ast::Expr.Move(_, _):
                    return false
                Ast::Expr.RegionNew(_, _, _):
                    return false
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return false if not proof_pure_expression_shape(element)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return false if not proof_pure_expression_shape(element)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return false if not proof_pure_expression_shape(element)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return false if not proof_pure_expression_shape(entry.key) or not proof_pure_expression_shape(entry.value)
                    return true
                Ast::Expr.Construct(type_expression, fields, _):
                    return false if not proof_pure_expression_shape(type_expression)
                    for field in fields:
                        return false if not proof_pure_expression_shape(field.value)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_pure_expression_shape(base)
                    for field in fields:
                        return false if not proof_pure_expression_shape(field.value)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_pure_expression_shape(condition) and proof_pure_expression_shape(then_expr) and proof_pure_expression_shape(else_expr)
                Ast::Expr.Match(_, _, _):
                    # The proof-safe value-match subset is lowered to a pure decision tree by
                    # proof_expr_supported; using that same gate here keeps pure-summary
                    # discovery aligned with the expression certificate boundary.
                    return proof_expr_supported(expression)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_pure_expression_shape(iterable) and proof_pure_expression_shape(condition) and proof_pure_expression_shape(body)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_pure_expression_shape(base) and proof_pure_expression_shape(predicate)
                Ast::Expr.Block(_, _, _, _):
                    # Even a currently supported value block has a separate local scope and
                    # can acquire hidden write-back semantics as the language evolves.
                    return false
                _:
                    return false

        # The parser stores canonical `x: mutable T` in the type expression; the separate
        # ParamDecl bit is only populated for the legacy leading `mutable x: T` spelling.
        # Mirror the compiler's recursive type mutability rule so both spellings affect purity.
