extend ElisaProof:
    private:
        def proof_structural_check_body(body: darray[Ast::Stmt]&, own_name: sview, subject_position: usize, parameters: darray[Ast::ParamDecl]&, destructurable: darray[sview]&, smaller: darray[ProofStructuralSmaller]&, report: mutable ProofReport&, name: sview, source_work: mutable usize&) -> void:
            if not proof_structural_environment_work_charge(parameters, destructurable, smaller, source_work, true):
                proof_structural_termination_finding(report, 0, name, "structural environment work exceeded its validated bound")
                return
            current_destructurable: mutable darray[sview] = proof_copy_names(destructurable)
            current_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(smaller)
            for statement in body |own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work|:
                if not proof_report_source_work_charge(1, source_work) or not proof_structural_environment_work_charge(parameters, current_destructurable, current_smaller, source_work, true):
                    proof_structural_termination_finding(report, 0, name, "structural environment work exceeded its validated bound")
                    return
                match statement:
                    Ast::Stmt.Return(value, _):
                        proof_structural_check_expression(returned, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work) if value is returned
                    Ast::Stmt.Expr(expression, _):
                        proof_structural_check_expression(expression, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                    Ast::Stmt.VarDecl(local_name, _, initializer, position):
                        proof_structural_termination_finding(report, position.line, name, "a local binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, local_name)
                        proof_structural_check_expression(initializer, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                        blocked: darray[sview] = [local_name]
                        current_destructurable <- proof_structural_without(current_destructurable, blocked, source_work)
                        current_smaller <- proof_structural_smaller_without(current_smaller, blocked, source_work)
                        if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            proof_structural_termination_finding(report, position.line, name, "structural shadow-filter work exceeded its validated bound")
                            return
                    Ast::Stmt.Assign(target, _, initializer, position):
                        target_name: sview = proof_ident_name(target)
                        proof_structural_termination_finding(report, position.line, name, "an assignment binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, target_name)
                        proof_structural_check_expression(target, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                        proof_structural_check_expression(initializer, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                        blocked: darray[sview] = [proof_ident_name(target)]
                        current_destructurable <- proof_structural_without(current_destructurable, blocked, source_work)
                        current_smaller <- proof_structural_smaller_without(current_smaller, blocked, source_work)
                        if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            proof_structural_termination_finding(report, position.line, name, "structural shadow-filter work exceeded its validated bound")
                            return
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_structural_check_expression(condition, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                        then_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        then_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(then_body, own_name, subject_position, parameters, &then_destructurable, &then_smaller, report, name, source_work)
                        else_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        else_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(else_body, own_name, subject_position, parameters, &else_destructurable, &else_smaller, report, name, source_work)
                        if not proof_structural_environment_join_work_charge(then_destructurable, then_smaller, else_destructurable, else_smaller, source_work):
                            proof_structural_termination_finding(report, 0, name, "structural branch join work exceeded its validated bound")
                            return
                        current_destructurable <- proof_structural_intersect(then_destructurable, else_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(then_smaller, else_smaller)
                    Ast::Stmt.While(condition, while_body, _):
                        proof_structural_check_expression(condition, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                        loop_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        loop_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(while_body, own_name, subject_position, parameters, &loop_destructurable, &loop_smaller, report, name, source_work)
                        if not proof_structural_environment_join_work_charge(current_destructurable, current_smaller, loop_destructurable, loop_smaller, source_work):
                            proof_structural_termination_finding(report, 0, name, "structural loop join work exceeded its validated bound")
                            return
                        current_destructurable <- proof_structural_intersect(current_destructurable, loop_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(current_smaller, loop_smaller)
                    Ast::Stmt.For(_, loop_variables, iterable, for_body, position):
                        proof_structural_check_expression(iterable, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                        for loop_variable in loop_variables |loop_variable, report, own_name, name, statement|:
                            proof_structural_termination_finding(report, position.line, name, "a loop binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, loop_variable)
                        loop_destructurable: mutable darray[sview] = proof_structural_without(current_destructurable, loop_variables, source_work)
                        loop_smaller: mutable darray[ProofStructuralSmaller] = proof_structural_smaller_without(current_smaller, loop_variables, source_work)
                        if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            proof_structural_termination_finding(report, position.line, name, "structural loop shadow-filter work exceeded its validated bound")
                            return
                        # Each element of a matched AST side-table is a strict subterm of the
                        # enclosing AST node. Promote loop variables only for an iterable already
                        # known to be such a subterm; ordinary user collections never enter this
                        # structural environment.
                        iterable_metadata: (complete: bool, root: sview, found: bool, subject: sview, identity: usize, subject_identity: usize) = proof_structural_argument_metadata(iterable, current_smaller, "", source_work)
                        if not iterable_metadata.complete:
                            proof_structural_termination_finding(report, position.line, name, "structural iterable subterm lookup exceeded its validated bound")
                            return
                        if iterable_metadata.found:
                            iterable_subject: sview = iterable_metadata.subject
                            iterable_subject_identity: usize = iterable_metadata.subject_identity
                            for loop_variable in loop_variables |loop_variable, loop_smaller, source_work, report, position, name, iterable_subject, iterable_subject_identity|:
                                existing_loop_binding: (complete: bool, found: bool) = proof_structural_smaller_has_name_with_work(loop_smaller, loop_variable, source_work)
                                if not existing_loop_binding.complete:
                                    proof_structural_termination_finding(report, position.line, name, "structural loop subterm lookup exceeded its validated bound")
                                    return
                                loop_smaller.push(ProofStructuralSmaller{name: loop_variable, subject: iterable_subject, identity: proof_structural_fresh_identity(report), subject_identity: iterable_subject_identity}) if not existing_loop_binding.found
                        proof_structural_check_body(for_body, own_name, subject_position, parameters, &loop_destructurable, &loop_smaller, report, name, source_work)
                        if not proof_structural_environment_join_work_charge(current_destructurable, current_smaller, loop_destructurable, loop_smaller, source_work):
                            proof_structural_termination_finding(report, position.line, name, "structural loop join work exceeded its validated bound")
                            return
                        current_destructurable <- proof_structural_intersect(current_destructurable, loop_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(current_smaller, loop_smaller)
                    Ast::Stmt.Match(scrutinee, arms, position):
                        proof_structural_check_expression(scrutinee, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                        merged_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        merged_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        first_arm: mutable bool = true
                        for arm in arms |own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, merged_destructurable, merged_smaller, first_arm, source_work|:
                            arm_bindings: mutable darray[sview] = []
                            arm_pattern_complete: bool = proof_structural_pattern_bindings_with_source_work(arm.pattern, &arm_bindings, source_work)
                            if not arm_pattern_complete:
                                proof_structural_termination_finding(report, position.line, name, "pattern binding analysis exceeded its validated bound")
                                return
                            for arm_binding in arm_bindings |arm_binding, report, name, position|:
                                proof_structural_termination_finding(report, position.line, name, "a pattern binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, arm_binding)
                            arm_destructurable: mutable darray[sview] = proof_structural_without(current_destructurable, arm_bindings, source_work)
                            arm_smaller: mutable darray[ProofStructuralSmaller] = proof_structural_smaller_without(current_smaller, arm_bindings, source_work)
                            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                proof_structural_termination_finding(report, position.line, name, "structural pattern shadow-filter work exceeded its validated bound")
                                return
                            scrutinee_name: sview = proof_ident_name(scrutinee)
                            if proof_structural_name_in(current_destructurable, scrutinee_name):
                                arm_destructurable_complete: bool = proof_structural_pattern_bindings_with_source_work(arm.pattern, &arm_destructurable, source_work)
                                binding_identity: (complete: bool, identity: usize) = proof_structural_binding_identity_with_work(scrutinee, current_smaller, parameters, source_work)
                                if not binding_identity.complete:
                                    proof_structural_termination_finding(report, position.line, name, "pattern subject identity lookup exceeded its validated bound")
                                    return
                                arm_subterms_complete: bool = proof_structural_pattern_subterms_with_source_work(arm.pattern, scrutinee_name, binding_identity.identity, &arm_smaller, report, source_work)
                                if not arm_destructurable_complete or not arm_subterms_complete:
                                    proof_structural_termination_finding(report, position.line, name, "pattern subterm analysis exceeded its validated bound")
                                    return
                            proof_structural_check_expression(arm.guard, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name, source_work)
                            proof_structural_check_body(arm.body, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name, source_work)
                            if not proof_structural_environment_join_work_charge(current_destructurable, current_smaller, arm_destructurable, arm_smaller, source_work):
                                proof_structural_termination_finding(report, position.line, name, "structural match join work exceeded its validated bound")
                                return
                            arm_outer_destructurable: darray[sview] = proof_structural_intersect(current_destructurable, arm_destructurable)
                            arm_outer_smaller: darray[ProofStructuralSmaller] = proof_structural_smaller_intersect(current_smaller, arm_smaller)
                            if first_arm:
                                merged_destructurable <- arm_outer_destructurable
                                merged_smaller <- arm_outer_smaller
                                first_arm <- false
                            else:
                                if not proof_structural_environment_join_work_charge(merged_destructurable, merged_smaller, arm_outer_destructurable, arm_outer_smaller, source_work):
                                    proof_structural_termination_finding(report, position.line, name, "structural match merge work exceeded its validated bound")
                                    return
                                merged_destructurable <- proof_structural_intersect(merged_destructurable, arm_outer_destructurable)
                                merged_smaller <- proof_structural_smaller_intersect(merged_smaller, arm_outer_smaller)
                        current_destructurable <- merged_destructurable if not first_arm
                        current_smaller <- merged_smaller if not first_arm
                    Ast::Stmt.Block(block_kind, _, _, block_body, position):
                        if block_kind == "assert_by" and block_body.count > 0:
                            match block_body[0]:
                                Ast::Stmt.Contract(_, goal, _):
                                    proof_structural_check_expression(goal, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work)
                                _:
                                    pass
                        if block_kind != "assert_by":
                            block_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                            block_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                            match statement:
                                Ast::Stmt.Block(_, _, binding, _, _):
                                    blocked: darray[sview] = [binding]
                                    proof_structural_termination_finding(report, position.line, name, "a block binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, binding)
                                    block_destructurable <- proof_structural_without(block_destructurable, blocked, source_work) if binding != ""
                                    block_smaller <- proof_structural_smaller_without(block_smaller, blocked, source_work) if binding != ""
                                _:
                                    pass
                            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                proof_structural_termination_finding(report, position.line, name, "structural block shadow-filter work exceeded its validated bound")
                                return
                            proof_structural_check_body(block_body, own_name, subject_position, parameters, &block_destructurable, &block_smaller, report, name, source_work)
                            if not proof_structural_environment_join_work_charge(current_destructurable, current_smaller, block_destructurable, block_smaller, source_work):
                                proof_structural_termination_finding(report, position.line, name, "structural block join work exceeded its validated bound")
                                return
                            current_destructurable <- proof_structural_intersect(current_destructurable, block_destructurable)
                            current_smaller <- proof_structural_smaller_intersect(current_smaller, block_smaller)
                    Ast::Stmt.Contract(kind, expression, _):
                        proof_structural_check_expression(expression, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, source_work) if kind == "assert"
                    _:
                        pass

        def proof_structural_signature_contract_table_valid(signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, source_work: mutable usize&) -> bool:
            contract_count: usize = signature_lines.count
            return false if:
                contract_count != signature_kinds.count or contract_count != signature_contracts.count
                not proof_report_source_work_charge(3, source_work)
            if contract_count > 1:
                for contract_index in 1..<contract_count |contract_index, signature_lines, source_work|:
                    return false if:
                        not proof_report_source_work_charge(1, source_work)
                        signature_lines[contract_index] < signature_lines[contract_index - 1]
            return true

        # Contract rows are source ordered. Validate that invariant once, then use two
        # bounded searches per function instead of rescanning the module's whole contract table.
        def proof_structural_signature_contract_range_for_line(signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, declaration_line: u32, source_work: mutable usize&) -> (complete: bool, start: usize, count: usize):
            contract_count: usize = signature_lines.count
            return (false, 0, 0) if contract_count != signature_kinds.count or contract_count != signature_contracts.count
            low: mutable usize = 0
            high: mutable usize = contract_count
            while low < high |low, high, signature_lines, declaration_line, source_work|:
                return (false, 0, 0) if not proof_report_source_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                if signature_lines[middle] < declaration_line:
                    low <- middle + 1
                else:
                    high <- middle
            start: usize = low
            high <- contract_count
            while low < high |low, high, signature_lines, declaration_line, source_work|:
                return (false, 0, 0) if not proof_report_source_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                if signature_lines[middle] <= declaration_line:
                    low <- middle + 1
                else:
                    high <- middle
            return (true, start, low - start)

        def proof_structural_function_has_implicit_dispatch_risk_range(function_name: sview, declaration_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, contract_start: usize, contract_count: usize, source_work: mutable usize&, report: mutable ProofReport&, caller_owner: sview = "", caller_owner_known: bool = false) -> bool:
            return true if:
                proof_source_function_has_drop_risk(function_name, declaration_line, parameters, body, report, caller_owner, caller_owner_known)
                proof_structural_typed_operator_defaults_have_overload(parameters, declaration_line, report, caller_owner, caller_owner_known)
                proof_structural_typed_operator_statements_have_overload(body, parameters, declaration_line, report, 0, caller_owner, caller_owner_known)
            for parameter in parameters |parameters, report, declaration_line, caller_owner, caller_owner_known|:
                return true if parameter.has_default and proof_source_expression_has_unsafe_runtime_index(parameter.default_value, parameters, report, 0, [], declaration_line, caller_owner, caller_owner_known)
            return true if:
                proof_source_statements_have_unsafe_runtime_index(body, parameters, report, 0, [], declaration_line, caller_owner, caller_owner_known)
                signature_lines.count != signature_kinds.count or signature_kinds.count != signature_contracts.count
                contract_start > signature_contracts.count or contract_count > signature_contracts.count - contract_start
            for offset in 0..<contract_count |offset, contract_start, declaration_line, signature_lines, signature_kinds, signature_contracts, report, source_work, caller_owner, caller_owner_known|:
                return true if not proof_report_source_work_charge(1, source_work)
                contract_index: usize = contract_start + offset
                return true if signature_lines[contract_index] != declaration_line
                kind: sview = signature_kinds[contract_index]
                return true if not proof_source_index_work_charge(report, 1) or not proof_source_index_work_charge(report, sview_len(kind))
                continue if kind != "requires" and kind != "ensure"
                expression: Ast::Expr = signature_contracts[contract_index]
                return true if:
                    proof_source_expression_has_drop_risk(expression, parameters, declaration_line, report, 0, caller_owner, caller_owner_known)
                    proof_structural_typed_operator_expression_has_overload(expression, parameters, declaration_line, report, 0, caller_owner, caller_owner_known)
                    proof_source_expression_has_unsafe_runtime_index(expression, parameters, report, 0, [], declaration_line, caller_owner, caller_owner_known)
            return false

        # Source call-graph edges do not include operations lowered to implicit trait calls,
        # indexing hooks, or generated drops. Record those hazards per function so they can be
        # propagated only to structural callers that can reach the function.
        def proof_structural_function_has_implicit_dispatch_risk(function_name: sview, declaration_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, source_work: mutable usize&, report: mutable ProofReport&, caller_owner: sview = "", caller_owner_known: bool = false) -> bool:
            contract_range: (complete: bool, start: usize, count: usize) = proof_structural_signature_contract_range_for_line(signature_lines, signature_kinds, signature_contracts, declaration_line, source_work)
            return true if not contract_range.complete
            return proof_structural_function_has_implicit_dispatch_risk_range(function_name, declaration_line, parameters, body, signature_lines, signature_kinds, signature_contracts, contract_range.start, contract_range.count, source_work, report, caller_owner, caller_owner_known)

        def proof_structural_source_type_is_byte_darray(type_expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> bool:
            return false if depth >= 32 or not proof_source_index_work_charge(report, 1)
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_structural_source_type_is_byte_darray(inner, report, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_structural_source_type_is_byte_darray(inner, report, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return false
                Ast::Expr.Index(head, element, _):
                    return false if not proof_source_index_work_charge(report, sview_len(proof_ident_name(head))) or not proof_source_index_work_charge(report, sview_len(proof_ident_name(element)))
                    return proof_ident_name(head) == "darray" and proof_ident_name(element) == "u8"
                Ast::Expr.IndexN(head, elements, _):
                    return false if elements.count != 1 or not proof_source_index_work_charge(report, sview_len(proof_ident_name(head))) or not proof_source_index_work_charge(report, sview_len(proof_ident_name(elements[0])))
                    return proof_ident_name(head) == "darray" and proof_ident_name(elements[0]) == "u8"
                _:
                    return false

        def proof_structural_source_type_head_name(type_expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= 32
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_structural_source_type_head_name(inner, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_structural_source_type_head_name(inner, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                _:
                    return proof_head_name(type_expression)

        def proof_structural_field_conversion_type_supported(method: sview, receiver: Ast::Expr, parameters: darray[Ast::ParamDecl]&, declaration_line: u32, report: mutable ProofReport&, caller_owner: sview = "", caller_owner_known: bool = false) -> bool:
            receiver_type: (known: bool, type_expression: Ast::Expr) = proof_structural_source_value_type(receiver, parameters, report, 0, [], declaration_line, caller_owner, caller_owner_known)
            return false if not receiver_type.known
            active_aliases: mutable darray[usize] = []
            unwrapped_type: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(receiver_type.type_expression, declaration_line, true, caller_owner, caller_owner_known, report, &active_aliases, 0)
            return false if not unwrapped_type.complete
            if method == "as_sview":
                return false if not proof_structural_source_type_is_byte_darray(unwrapped_type.type_expression, report, 0)
                element: (known: bool, element: Ast::Expr) = proof_structural_builtin_container_element_type(unwrapped_type.type_expression, report, declaration_line, caller_owner, caller_owner_known)
                return element.known and proof_ident_name(element.element) == "u8"
            type_name: sview = proof_structural_source_type_head_name(unwrapped_type.type_expression, 0)
            return type_name in {"sview", "dstr", "cstr"} if method == "sview"
            return proof_builtin_scalar_type_name(type_name)

        def proof_check_structural_function(enum_index: ProofEnumIndex, function_name: sview, declaration_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], extern_contract_summary_complete: bool, reachable_extern_contract_unsafe: bool, reachable_unresolved_call: bool, signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, source_work: mutable usize&, report: mutable ProofReport&, caller_owner: sview = "", caller_owner_known: bool = false) -> void:
            if not report.analysis_1.structural.function_name_index_valid:
                proof_structural_termination_finding(report, declaration_line, function_name, "source callable name index was unavailable for structural checking")
                return
            if report.analysis_1.structural.component_ids.count != report.analysis_1.structural.names.count:
                proof_structural_termination_finding(report, declaration_line, function_name, "recursive component index was unavailable for structural checking")
                return
            decreases_clauses: darray[Ast::Expr] = proof_contracts(body, "decreases")
            components: mutable darray[Ast::Expr] = []
            proof_decreases_component_slice(decreases_clauses, &components)
            inferred_structural: mutable bool = false
            if components.count == 0:
                inferred: (known: bool, parameter: sview, position: usize, type_name: sview) = proof_infer_structural_decrease(enum_index, parameters)
                components.push(Ast::Expr.Ident(inferred.parameter, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})) if inferred.known
                inferred_structural <- inferred.known
            return if components.count != 1
            subject: sview = proof_ident_name(components[0])
            subject_position: mutable usize = proof_enum_parameter_position(enum_index, parameters, subject)
            return if subject_position >= parameters.count
            # A missing decreases clause on a function with several enum parameters denotes the
            # product ranking handled by the recursive-edge check above. Use the parameter-count
            # sentinel to select that mode without widening explicitly written rankings.
            enum_subjects: darray[sview] = proof_enum_parameter_names(enum_index, parameters)
            subject_position <- parameters.count if inferred_structural and enum_subjects.count > 1
            destructurable: mutable darray[sview] = [subject]
            destructurable <- enum_subjects if subject_position >= parameters.count
            smaller: mutable darray[ProofStructuralSmaller] = []
            own_lookup: (complete: bool, found: bool, row: usize) = proof_structural_name_lookup(report, function_name)
            if not own_lookup.complete or not own_lookup.found:
                proof_structural_termination_finding(report, declaration_line, function_name, "source callable name lookup exceeded its validated bound")
                return
            own_index: usize = own_lookup.row
            finding_start: usize = report.results.findings.count
            if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_structural_termination_finding(report, declaration_line, function_name, "structural source work exceeded its validated bound")
                return
            body_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_body(body, &body_cost, source_work, 0):
                proof_structural_source_work_exhaust(source_work)
                proof_structural_termination_finding(report, declaration_line, function_name, "structural body source work exceeded its validated bound")
                return
            # Reserve the cost walk plus the three whole-body hazard classifiers below:
            # drop risk, overloaded operators, and unsafe runtime indexing. The structural
            # termination traversal itself charges each node and environment operation as it runs.
            if body_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 4:
                proof_structural_source_work_exhaust(source_work)
                proof_structural_termination_finding(report, declaration_line, function_name, "structural body source work exceeded its validated bound")
                return
            if not proof_report_source_work_charge(body_cost * 4, source_work):
                proof_structural_termination_finding(report, declaration_line, function_name, "structural body source work exceeded its validated bound")
                return
            if not extern_contract_summary_complete:
                proof_structural_termination_finding(report, declaration_line, function_name, "reachable callable extern contracts could not be classified within their validated bound")
                return
            proof_structural_termination_finding(report, declaration_line, function_name, "a reachable callable extern contract may hide recursive edges") if reachable_extern_contract_unsafe
            proof_structural_termination_finding(report, declaration_line, function_name, "a reachable opaque call or implicit dispatch may hide a structural recursive edge") if reachable_unresolved_call
            proof_structural_termination_finding(report, declaration_line, function_name, "an unmodeled destructor or opaque source call in this structural function may hide recursive calls") if proof_source_function_has_drop_risk(function_name, declaration_line, parameters, body, report, caller_owner, caller_owner_known)
            # Operator implementations and user-defined indexers are implicit calls and are
            # absent from the current source call graph. Reject these paths unless a runtime
            # index receiver is statically known to be a built-in container.
            for parameter in parameters |parameter, report, function_name, declaration_line, caller_owner, caller_owner_known|:
                if parameter.has_default:
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        proof_structural_termination_finding(report, Ast::expr_pos(parameter.default_value).line, function_name, "structural default source work exceeded its validated bound")
                        return
                    default_cost: mutable usize = 0
                    if not proof_replay_summary_expr_cost(parameter.default_value, &default_cost, source_work, 0):
                        proof_structural_source_work_exhaust(source_work)
                        proof_structural_termination_finding(report, Ast::expr_pos(parameter.default_value).line, function_name, "structural default source work exceeded its validated bound")
                        return
                    # The default cost walk and its operator/index hazard checks are precharged;
                    # the recursive termination expression walk charges its own visited nodes.
                    if default_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 3:
                        proof_structural_source_work_exhaust(source_work)
                        proof_structural_termination_finding(report, Ast::expr_pos(parameter.default_value).line, function_name, "structural default source work exceeded its validated bound")
                        return
                    if not proof_report_source_work_charge(default_cost * 3, source_work):
                        proof_structural_termination_finding(report, Ast::expr_pos(parameter.default_value).line, function_name, "structural default source work exceeded its validated bound")
                        return
                    proof_structural_termination_finding(report, Ast::expr_pos(parameter.default_value).line, function_name, "overloaded operators in structural defaults may hide recursive calls") if proof_structural_typed_operator_expression_has_overload(parameter.default_value, parameters, declaration_line, report, 0, caller_owner, caller_owner_known)
                    proof_structural_termination_finding(report, Ast::expr_pos(parameter.default_value).line, function_name, "user-defined indexing in structural defaults may hide recursive calls") if proof_source_expression_has_unsafe_runtime_index(parameter.default_value, parameters, report, 0, [], declaration_line, caller_owner, caller_owner_known)
            if proof_structural_typed_operator_statements_have_overload(body, parameters, declaration_line, report, 0, caller_owner, caller_owner_known):
                proof_structural_termination_finding(report, 0, function_name, "overloaded operators in structural bodies may hide recursive calls")
            if proof_source_statements_have_unsafe_runtime_index(body, parameters, report, 0, [], declaration_line, caller_owner, caller_owner_known):
                proof_structural_termination_finding(report, 0, function_name, "user-defined indexing in structural bodies may hide recursive calls")
            contract_range: (complete: bool, start: usize, count: usize) = proof_structural_signature_contract_range_for_line(signature_lines, signature_kinds, signature_contracts, declaration_line, source_work)
            if not contract_range.complete or contract_range.start > signature_contracts.count or contract_range.count > signature_contracts.count - contract_range.start:
                proof_structural_termination_finding(report, declaration_line, function_name, "the signature contract source snapshot is malformed")
            else:
                for offset in 0..<contract_range.count |offset, contract_range, report, function_name, signature_kinds, signature_contracts, source_work, declaration_line, caller_owner, caller_owner_known, parameters|:
                    contract_index: usize = contract_range.start + offset
                    kind: sview = signature_kinds[contract_index]
                    if not proof_report_source_work_charge(1, &source_work) or not proof_report_source_work_charge(sview_len(kind), &source_work):
                        proof_structural_termination_finding(report, declaration_line, function_name, "signature contract source work exceeded its validated bound")
                        return
                    continue if kind != "requires" and kind != "ensure"
                    expression: Ast::Expr = signature_contracts[contract_index]
                    if not proof_replay_summary_expr_charge_with_work(expression, &source_work) or not proof_replay_summary_expr_charge_with_work(expression, &source_work) or not proof_replay_summary_expr_charge_with_work(expression, &source_work):
                        proof_structural_termination_finding(report, Ast::expr_pos(expression).line, function_name, "signature contract source work exceeded its validated bound")
                        return
                    if proof_structural_typed_operator_expression_has_overload(expression, parameters, declaration_line, report, 0, caller_owner, caller_owner_known) or proof_source_expression_has_unsafe_runtime_index(expression, parameters, report, 0, [], declaration_line, caller_owner, caller_owner_known):
                        proof_structural_termination_finding(report, Ast::expr_pos(expression).line, function_name, "implicit operator or index dispatch in structural signature contracts may hide recursive calls")
                    proof_structural_check_expression(expression, function_name, subject_position, parameters, destructurable, smaller, report, function_name, source_work)
            for parameter in parameters |parameter, report, function_name|:
                proof_structural_termination_finding(report, 0, function_name, "a parameter shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, parameter.name)
            # Defaults are evaluated at a call site before entering the function body. They do
            # not inherit any branch-local pattern evidence, so any recursive or mutual call in
            # a structural default must fail closed instead of being certified from body binds.
            for parameter in parameters |parameter, own_name, subject_position, parameters, destructurable, smaller, report, function_name, source_work|:
                proof_structural_check_expression(parameter.default_value, function_name, subject_position, parameters, destructurable, smaller, report, function_name, source_work) if parameter.has_default
            proof_structural_check_body(body, function_name, subject_position, parameters, destructurable, smaller, report, function_name, source_work)
            structural_failed: mutable bool = false
            for finding_index in finding_start..<report.results.findings.count |finding_index, report, function_name, source_work, structural_failed|:
                finding: ProofFinding = report.results.findings[finding_index]
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(finding.kind), source_work) or not proof_report_source_work_charge(sview_len(finding.name), source_work) or not proof_report_source_work_charge(sview_len(finding.message), source_work):
                    proof_structural_termination_finding(report, declaration_line, function_name, "structural finding scan exceeded its validated bound")
                    return
                structural_failed <- true if finding.kind == "structural-decreases-unproven" and finding.name == function_name
            if not structural_failed:
                if not proof_structural_verified_member_publish(report, own_lookup.row, function_name, source_work):
                    proof_structural_termination_finding(report, declaration_line, function_name, "verified structural member publication exceeded its validated bound")
                    return

        def proof_check_structural_termination(file: Ast::File&, declarations: darray[Ast::Decl], functions: ProofFunctionTable&, report: mutable ProofReport&, initialize: bool) -> void:
            # This routine recurses into nested modules/scopes. Publish the immutable
            # function-table metadata only for the outer invocation; clearing it in a nested
            # invocation would erase the accumulated structural certificates and repeat the
            # whole SCC comparison work.
            if initialize:
                report.analysis_1.structural.names.clear()
                report.analysis_1.structural.function_name_index_hashes.clear()
                report.analysis_1.structural.function_name_index_values.clear()
                report.analysis_1.structural.function_name_index_ambiguous.clear()
                report.analysis_1.structural.function_name_index_valid <- false
                report.analysis_1.structural.subject_positions.clear()
                report.analysis_1.structural.subject_types.clear()
                report.analysis_1.structural.component_ids.clear()
                report.analysis_1.structural.members.clear()
                report.analysis_1.structural.verified_members.clear()
                report.analysis_1.structural.verified_names.clear()
                proof_structural_component_index_build(functions, report)
                for index in 0..<functions.lookup.source.names.count |index, functions, report|:
                    report.analysis_1.structural.names.push(functions.lookup.source.names[index])
                    report.analysis_1.structural.subject_positions.push(functions.contracts.termination.structural_subject_positions[index] if index < functions.contracts.termination.structural_subject_positions.count else functions.parameters.metadata.param_counts[index])
                    report.analysis_1.structural.subject_types.push(functions.contracts.termination.structural_subject_types[index] if index < functions.contracts.termination.structural_subject_types.count else "")
                    report.analysis_1.structural.members.push(functions.contracts.termination.structural[index] if index < functions.contracts.termination.structural.count else false)
                    report.analysis_1.structural.verified_members.push(false)
                index_count: usize = functions.lookup.indexes.index_values.count
                index_shape_valid: bool = index_count == functions.lookup.indexes.index_hashes.count and index_count == functions.lookup.indexes.index_ambiguous.count
                if functions.lookup.source.names.count == 0:
                    index_shape_valid <- index_shape_valid and index_count == 0
                else:
                    expected_capacity: usize = proof_name_index_capacity(functions.lookup.source.names.count)
                    index_shape_valid <- index_shape_valid and expected_capacity != 0 and index_count == expected_capacity
                index_shape_valid <- false if report.analysis_1.structural.names.count != functions.lookup.source.names.count
                if index_shape_valid:
                    if index_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3:
                        functions.lookup.work.module_resolution_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                    elif proof_report_source_work_charge(index_count * 3, &functions.lookup.work.module_resolution_work_used):
                        report.analysis_1.structural.function_name_index_hashes.extend(functions.lookup.indexes.index_hashes)
                        report.analysis_1.structural.function_name_index_values.extend(functions.lookup.indexes.index_values)
                        report.analysis_1.structural.function_name_index_ambiguous.extend(functions.lookup.indexes.index_ambiguous)
                        report.analysis_1.structural.function_name_index_valid <- true
                    else:
                        functions.lookup.work.module_resolution_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            for declaration in declarations |file, functions, report|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, position):
                        function_index: usize = proof_function_index_at_line(functions, name, position.line)
                        if function_index < functions.contracts.termination.structural.count and functions.contracts.termination.structural[function_index]:
                            unresolved_reachable: bool = function_index >= functions.call_graph.reachable_unresolved_calls.count or functions.call_graph.reachable_unresolved_calls[function_index]
                            saved_caller: usize = report.analysis_2.fact_call_shapes.status.active_caller
                            report.analysis_2.fact_call_shapes.status.active_caller <- function_index
                            proof_check_structural_function(functions.type_indexes.enum_index, name, position.line, parameters, body, functions.externs.extern_contract_analysis_complete and function_index < functions.externs.reachable_extern_contract_unsafe.count, functions.externs.extern_contract_analysis_complete and function_index < functions.externs.reachable_extern_contract_unsafe.count and functions.externs.reachable_extern_contract_unsafe[function_index], unresolved_reachable, report.source_contracts.source_signature_contract_lines, report.source_contracts.source_signature_contract_kinds, report.source_contracts.source_signature_contracts, functions.lookup.work.module_resolution_work_used, report, functions.lookup.source.owner_modules[function_index] if functions.lookup.source.owner_modules.count == functions.lookup.source.names.count else "", functions.lookup.source.owner_modules.count == functions.lookup.source.names.count)
                            report.analysis_2.fact_call_shapes.status.active_caller <- saved_caller
                    Ast::Decl.Module(_, module_body, _):
                        proof_check_structural_termination(file, module_body, functions, report, false)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_check_structural_termination(file, scoped_body, functions, report, false)
                    _:
                        pass

        # Determine whether a function can reach a target in the collected executable call
        # graph. This is deliberately finite and name-based; ambiguous/unknown targets are not
        # treated as edges, while an unsupported expression marks its own function opaque below.
        def proof_function_reaches(functions: ProofFunctionTable&, source: usize, target: usize) -> bool:
            return false if source >= functions.lookup.source.names.count or target >= functions.lookup.source.names.count
            reachable: mutable darray[usize] = [source]
            cursor: mutable usize = 0
            while cursor < reachable.count |cursor, reachable, functions, target|:
                current: usize = reachable[cursor]
                # A malformed flat-table alignment must fail closed: if this node is the
                # queried target, do not let missing graph metadata turn a possible self-edge
                # into an admitted summary.
                return true if current == target and (current >= functions.call_graph.call_starts.count or current >= functions.call_graph.call_counts.count)
                return false if current >= functions.call_graph.call_starts.count or current >= functions.call_graph.call_counts.count
                start: usize = functions.call_graph.call_starts[current]
                count: usize = functions.call_graph.call_counts[current]
                for offset in 0..<count |offset, start, functions, reachable, target|:
                    return true if current == target and start + offset >= functions.call_graph.all_calls.count
                    continue if start + offset >= functions.call_graph.all_calls.count
                    called: sview = functions.call_graph.all_calls[start + offset]
                    if called == "__opaque_call__":
                        return true if current == target
                    else:
                        next: usize = proof_function_call_target(functions, start + offset)
                        if next < functions.lookup.source.names.count:
                            return true if next == target
                            already_seen: bool = proof_usize_seen(reachable, next)
                            reachable.push(next) if not already_seen
                cursor <- cursor + 1
            return false

        def proof_functions_same_recursive_component(functions: ProofFunctionTable&, source: usize, target: usize) -> bool:
            return false if source >= functions.lookup.source.names.count or target >= functions.lookup.source.names.count
            return true if source == target
            return false if:
                source >= functions.summaries.recursive.count or target >= functions.summaries.recursive.count
                not functions.summaries.recursive[source] or not functions.summaries.recursive[target]
            if source < functions.summaries.recursive_component_ids.count and target < functions.summaries.recursive_component_ids.count:
                return functions.summaries.recursive_component_ids[source] == functions.summaries.recursive_component_ids[target]
            return proof_function_reaches(functions, source, target) and proof_function_reaches(functions, target, source)
