# Collect every expression-level move before the statement mutates symbolic state. An incomplete
# walk makes the caller forget the whole value state, so an omitted/new AST form cannot preserve a
# pre-move alias by accident.
extend ElisaProof:
    private:
        def proof_move_root_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, root: sview):
            return (false, "") if:
                depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
                not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, "") if not proof_replay_source_work_charge_or_exhaust(sview_len(name), source_work)
                    return (true, name)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Index(object, _, _) | Ast::Expr.IndexN(object, _, _) | Ast::Expr.Slice(object, _, _, _) | Ast::Expr.Paren(object, _) | Ast::Expr.Move(object, _) | Ast::Expr.Unary(_, object, _):
                    return proof_move_root_with_work(object, source_work, depth + 1)
                _:
                    return (true, "")

        def proof_move_root_add_with_work(operand: Ast::Expr, roots: mutable darray[sview]&, source_work: mutable usize&) -> bool:
            root_result: (complete: bool, root: sview) = proof_move_root_with_work(operand, source_work, 0)
            return false if not root_result.complete
            root: sview = root_result.root
            return true if root == ""
            for existing in roots |existing, root, source_work|:
                return false if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(existing) + sview_len(root), source_work)
                return true if existing == root
            roots.push(root)
            return true

        def proof_collect_move_roots_with_work(expression: Ast::Expr, roots: mutable darray[sview]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
                not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match expression:
                Ast::Expr.Move(operand, _):
                    return false if not proof_move_root_add_with_work(operand, roots, source_work)
                    return proof_collect_move_roots_with_work(operand, roots, source_work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_collect_move_roots_with_work(inner, roots, source_work, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not proof_collect_move_roots_with_work(left, roots, source_work, depth + 1)
                    return proof_collect_move_roots_with_work(right, roots, source_work, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _) | Ast::Expr.IndexN(callee, arguments, _):
                    return false if not proof_collect_move_roots_with_work(callee, roots, source_work, depth + 1)
                    for argument in arguments |roots, source_work, depth|:
                        return false if not proof_collect_move_roots_with_work(argument, roots, source_work, depth + 1)
                    return true
                Ast::Expr.Slice(object, low, high, _):
                    return false if:
                        not proof_collect_move_roots_with_work(object, roots, source_work, depth + 1)
                        not proof_collect_move_roots_with_work(low, roots, source_work, depth + 1)
                    return proof_collect_move_roots_with_work(high, roots, source_work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |roots, source_work, depth|:
                        return false if not proof_collect_move_roots_with_work(element, roots, source_work, depth + 1)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |roots, source_work, depth|:
                        return false if:
                            not proof_collect_move_roots_with_work(entry.key, roots, source_work, depth + 1)
                            not proof_collect_move_roots_with_work(entry.value, roots, source_work, depth + 1)
                    return true
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |roots, source_work, depth|:
                        return false if not proof_collect_move_roots_with_work(field.value, roots, source_work, depth + 1)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_collect_move_roots_with_work(base, roots, source_work, depth + 1)
                    for field in fields |roots, source_work, depth|:
                        return false if not proof_collect_move_roots_with_work(field.value, roots, source_work, depth + 1)
                    return true
                Ast::Expr.If(condition, then_value, else_value, _):
                    return false if:
                        not proof_collect_move_roots_with_work(condition, roots, source_work, depth + 1)
                        not proof_collect_move_roots_with_work(then_value, roots, source_work, depth + 1)
                    return proof_collect_move_roots_with_work(else_value, roots, source_work, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return false if not proof_collect_move_roots_with_work(scrutinee, roots, source_work, depth + 1)
                    for arm in arms |roots, source_work, depth|:
                        return false if:
                            not proof_collect_move_roots_with_work(arm.guard, roots, source_work, depth + 1)
                            not proof_collect_move_roots_from_statements_with_work(arm.body, roots, source_work, depth + 1)
                    return true
                Ast::Expr.Catch(guarded, arms, _):
                    return false if not proof_collect_move_roots_with_work(guarded, roots, source_work, depth + 1)
                    for arm in arms |roots, source_work, depth|:
                        return false if:
                            not proof_collect_move_roots_with_work(arm.guard, roots, source_work, depth + 1)
                            not proof_collect_move_roots_from_statements_with_work(arm.body, roots, source_work, depth + 1)
                    return true
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return false if:
                        not proof_collect_move_roots_with_work(iterable, roots, source_work, depth + 1)
                        not proof_collect_move_roots_with_work(condition, roots, source_work, depth + 1)
                    return proof_collect_move_roots_with_work(body, roots, source_work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_collect_move_roots_with_work(base, roots, source_work, depth + 1)
                    return proof_collect_move_roots_with_work(predicate, roots, source_work, depth + 1)
                Ast::Expr.GetElse(guarded, _, _):
                    # Recovery executes in its own cloned state; only the success expression
                    # contributes moves to the enclosing statement state.
                    return proof_collect_move_roots_with_work(guarded, roots, source_work, depth + 1)
                Ast::Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                    return false if not proof_collect_move_roots_with_work(effect_type, roots, source_work, depth + 1)
                    for candidate in candidates |roots, source_work, depth|:
                        return false if not proof_collect_move_roots_with_work(candidate.effect_type, roots, source_work, depth + 1)
                        for capture in candidate.captures |roots, source_work, depth|:
                            return false if not proof_collect_move_roots_with_work(capture, roots, source_work, depth + 1)
                    for argument in arguments |roots, source_work, depth|:
                        return false if not proof_collect_move_roots_with_work(argument, roots, source_work, depth + 1)
                    return true
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_collect_move_roots_from_statements_with_work(statements, roots, source_work, depth + 1)
                    return proof_collect_move_roots_with_work(value, roots, source_work, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    # A closure can run after this statement, so include its body conservatively.
                    return proof_collect_move_roots_from_statements_with_work(body, roots, source_work, depth + 1)
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return true
                _:
                    return false

        def proof_collect_move_roots_from_statements_with_work(statements: darray[Ast::Stmt]&, roots: mutable darray[sview]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            for statement in statements |roots, source_work, depth|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return false if not proof_collect_move_roots_with_work(returned, roots, source_work, depth + 1)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_collect_move_roots_with_work(expression, roots, source_work, depth + 1)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return false if not proof_collect_move_roots_with_work(initializer, roots, source_work, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if:
                            not proof_collect_move_roots_with_work(target, roots, source_work, depth + 1)
                            not proof_collect_move_roots_with_work(value, roots, source_work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if:
                            not proof_collect_move_roots_with_work(condition, roots, source_work, depth + 1)
                            not proof_collect_move_roots_from_statements_with_work(yes, roots, source_work, depth + 1)
                            not proof_collect_move_roots_from_statements_with_work(no, roots, source_work, depth + 1)
                    Ast::Stmt.While(condition, body, _) | Ast::Stmt.For(_, _, condition, body, _):
                        return false if:
                            not proof_collect_move_roots_with_work(condition, roots, source_work, depth + 1)
                            not proof_collect_move_roots_from_statements_with_work(body, roots, source_work, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return false if not proof_collect_move_roots_with_work(scrutinee, roots, source_work, depth + 1)
                        for arm in arms |roots, source_work, depth|:
                            return false if:
                                not proof_collect_move_roots_with_work(arm.guard, roots, source_work, depth + 1)
                                not proof_collect_move_roots_from_statements_with_work(arm.body, roots, source_work, depth + 1)
                    Ast::Stmt.Block(_, _, _, body, _):
                        return false if not proof_collect_move_roots_from_statements_with_work(body, roots, source_work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_statement_move_roots_with_work(statement: Ast::Stmt, roots: mutable darray[sview]&, source_work: mutable usize&) -> bool:
            statements: mutable darray[Ast::Stmt] = [statement]
            return proof_collect_move_roots_from_statements_with_work(statements, roots, source_work, 0)
