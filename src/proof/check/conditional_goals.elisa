extend ElisaProof:
    private:
        # A goal over `T = a if c else b` (G75: a while-loop invariant over a binding an if/else
        # joined as a conditional) is decided in three kernel-checked steps rather than one
        # deep case split. First `not c or G[a]` and `c or G[b]`, each from the current facts:
        # the solver assumes one side of `c`, so a guarded arm fact `not c or F` resolves without
        # a split. Then `G` itself from the facts plus those two, a conditional over two
        # disjunctions the kernel decides within its split depth. Each step is an ordinary
        # certified goal, so replay re-derives all three.
        # Only called once the goal failed as a whole; the final step, whose facts are exactly
        # the two cases, does not split again.
        def proof_certify_conditional_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, report: mutable ProofReport&, line: u32, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            conditionals: mutable darray[Ast::Expr] = []
            proof_goal_conditional_terms(goal, &conditionals, 0)
            return false if conditionals.count != 1
            match conditionals[0]:
                Ast::Expr.If(condition, then_expression, else_expression, position):
                    then_goal: (changed: bool, value: Ast::Expr) = proof_replace_place(goal, conditionals[0], then_expression, 0)
                    else_goal: (changed: bool, value: Ast::Expr) = proof_replace_place(goal, conditionals[0], else_expression, 0)
                    return false if not then_goal.changed or not else_goal.changed
                    then_case: Ast::Expr = Ast::Expr.Binary(proof_branch_negation(condition, position), TokenKind.Or, then_goal.value, position)
                    else_case: Ast::Expr = Ast::Expr.Binary(condition, TokenKind.Or, else_goal.value, position)
                    # The final step's facts end with the two cases.
                    return false if facts.count >= 2 and proof_expr_equal(facts[facts.count - 2], then_case) and proof_expr_equal(facts[facts.count - 1], else_case)
                    return false if not proof_certify_goal_with_rule(facts, then_case, report, line, name, annotations, "")
                    return false if not proof_certify_goal_with_rule(facts, else_case, report, line, name, annotations, "")
                    # The final step reads only the two cases: `G` follows from them alone, and
                    # every other disjunction in the facts would only cost the split its depth.
                    # Each case is recorded with the full facts as its premises.
                    staged: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                    premises: darray[Ast::Expr] = proof_copy_exprs(facts)
                    proof_add_derived_fact_from(&staged, report, then_case, premises, "proof-step", line, name)
                    proof_add_derived_fact_from(&staged, report, else_case, premises, "proof-step", line, name)
                    return false if staged.count != facts.count + 2
                    # Type markers stay: the width gates read them.
                    cases: mutable darray[Ast::Expr] = []
                    for fact in facts |cases|:
                        cases.push(fact) if proof_join_type_marker(fact)
                    cases.push(then_case)
                    cases.push(else_case)
                    return proof_certify_goal_with_rule(cases, goal, report, line, name, annotations, "")
                _:
                    return false

        # The conditional terms of a goal, at most two, outside other conditionals.
        def proof_goal_conditional_terms(expression: Ast::Expr, terms: mutable darray[Ast::Expr]&, depth: usize) -> void:
            return if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or terms.count >= 2
            match expression:
                Ast::Expr.If(_, _, _, _):
                    terms.push(expression) if not (any existing in terms where proof_expr_equal(existing, expression))
                Ast::Expr.Paren(inner, _):
                    proof_goal_conditional_terms(inner, terms, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    proof_goal_conditional_terms(operand, terms, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    proof_goal_conditional_terms(left, terms, depth + 1)
                    proof_goal_conditional_terms(right, terms, depth + 1)
                _:
                    return
