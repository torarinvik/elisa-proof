extend ElisaProof:
    private:
        def proof_certify_conditional_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, report: mutable ProofReport&, line: u32, name: sview, annotations: darray[Ast::EnumAnnotation]&, original_rule: sview) -> (split: bool, proven: bool):
            # A goal over `a if c else b` is decided by fewer rules than a fact `x == (a if c
            # else b)`, which every tier and the replay kernel split into its two cases. Give
            # each conditional term of the goal the reflexive fact `T == T`: it is that shape,
            # it holds outright, and replay re-derives it from no premises (G75: a while-loop
            # invariant over a binding an if/else joined as a conditional).
            conditionals: mutable darray[Ast::Expr] = []
            proof_goal_conditional_terms(goal, &conditionals, 0)
            if conditionals.count > 0:
                split_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                no_premises: darray[Ast::Expr] = []
                added: mutable bool = false
                for term in conditionals |split_facts, report, line, name, no_premises, added|:
                    reflexive: Ast::Expr = Ast::Expr.Binary(term, TokenKind.EqEq, term, Ast::expr_pos(term))
                    continue if any existing in split_facts where proof_expr_equal(existing, reflexive)
                    before: usize = split_facts.count
                    proof_add_derived_fact_from(&split_facts, report, reflexive, no_premises, "proof-step", line, name)
                    added <- true if split_facts.count > before
                return (true, proof_certify_goal_with_rule(split_facts, goal, report, line, name, annotations, original_rule)) if added
            return (false, false)

        # The outermost conditional terms of a goal, at most two: each costs a case split.
        def proof_goal_conditional_terms(expression: Ast::Expr, terms: mutable darray[Ast::Expr]&, depth: usize) -> void:
            return if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or terms.count >= 2
            match expression:
                Ast::Expr.If(_, _, _, _):
                    terms.push(expression) if not (any existing in terms where proof_expr_equal(existing, expression))
                Ast::Expr.Paren(inner, _):
                    proof_goal_conditional_terms(inner, terms, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    proof_goal_conditional_terms(operand, terms, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    proof_goal_conditional_terms(left, terms, depth + 1)
                    proof_goal_conditional_terms(right, terms, depth + 1)
                _:
                    return

