extend ElisaProof:
    private:
        const PROOF_OPERATOR_IMPL_MAX_BUCKET: usize = 64

        # Pair parser impl markers and build the lookup cache under the checker's shared
        # source-work budget. The nested pairing scan is retained to preserve source semantics,
        # but its work is now capped; long hash buckets fail closed before any witness lookup.
        def proof_build_operator_impl_index(report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, reason: sview, observed: usize, limit: usize) can[Memory.Allocate, Abort.Panic]:
            report.operator_impls.rows.clear()
            report.operator_impls.hashes.clear()
            report.operator_impls.bucket_heads.clear()
            report.operator_impls.next_indices.clear()
            report.operator_impls.valid <- false
            for concrete_annotation in report.source_annotations |report, source_work|:
                return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(concrete_annotation.owner), source_work)
                if concrete_annotation.owner == "__ext_concrete":
                    return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                    report.operator_impls.rows.push(ProofOperatorImpl{concrete: concrete_annotation.name, protocol: ""})
                if concrete_annotation.owner == "__impl_concrete":
                    for scope_annotation in report.source_annotations |concrete_annotation, report, source_work|:
                        return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                        return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(scope_annotation.owner), source_work)
                        continue if scope_annotation.owner != "__impl_scope" or scope_annotation.line != concrete_annotation.line
                        return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                        report.operator_impls.rows.push(ProofOperatorImpl{concrete: concrete_annotation.name, protocol: scope_annotation.name})
            implementation_count: usize = report.operator_impls.rows.count
            if implementation_count == 0:
                report.operator_impls.valid <- true
                return (true, "", 0, 0)
            capacity: usize = proof_name_index_capacity(implementation_count)
            return (false, "operator-index-entries", implementation_count, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2) if capacity == 0
            return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(capacity * 2, source_work)
            return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(implementation_count * 2, source_work)
            report.operator_impls.hashes.resize(implementation_count)
            report.operator_impls.bucket_heads.resize(capacity)
            report.operator_impls.next_indices.resize(implementation_count)
            bucket_sizes: mutable darray[usize] = []
            bucket_sizes.resize(capacity)
            for slot in 0..<capacity |slot, implementation_count, report, bucket_sizes, source_work|:
                return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                report.operator_impls.bucket_heads[slot] <- implementation_count
                bucket_sizes[slot] <- 0
            for index in 0..<implementation_count |index, implementation_count, report, capacity, bucket_sizes, source_work|:
                return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                implementation: ProofOperatorImpl = report.operator_impls.rows[index]
                return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(implementation.concrete), source_work)
                return (false, "operator-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(implementation.protocol), source_work)
                hash: u32 = proof_operator_impl_hash(implementation.concrete, implementation.protocol)
                slot: usize = (hash.i64() % capacity.i64()).usize()
                bucket_sizes[slot] <- bucket_sizes[slot] + 1
                return (false, "operator-index-cluster", bucket_sizes[slot], PROOF_OPERATOR_IMPL_MAX_BUCKET) if bucket_sizes[slot] > PROOF_OPERATOR_IMPL_MAX_BUCKET
                report.operator_impls.hashes[index] <- hash
                report.operator_impls.next_indices[index] <- report.operator_impls.bucket_heads[slot]
                report.operator_impls.bucket_heads[slot] <- index
            report.operator_impls.valid <- true
            return (true, "", 0, 0)
