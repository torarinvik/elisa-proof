# Source-annotation index for the proof kernel's named-tuple field projection.
extend ElisaProof:
    private:
        const PROOF_SOURCE_KERNEL_TUPLE_LABEL_LIMIT: usize = 2048

        struct ProofSourceKernelTupleLabelIndex:
            lines: mutable darray[u32]
            label_starts: mutable darray[usize]
            label_counts: mutable darray[usize]
            bucket_heads: mutable darray[usize]
            next_indices: mutable darray[usize]
            labels: mutable darray[sview]
            capacity: usize
            complete: mutable bool

        def proof_source_kernel_tuple_label_line(index: ProofSourceKernelTupleLabelIndex, line: u32) -> usize:
            return index.lines.count if index.capacity == 0 or index.bucket_heads.count != index.capacity or index.next_indices.count != index.lines.count
            slot: usize = (line.i64() % index.capacity.i64()).usize()
            entry: mutable usize = index.bucket_heads[slot]
            steps: mutable usize = 0
            while entry < index.lines.count and steps < PROOF_INDEX_MAX_CHAIN |entry, steps, line, index|:
                return entry if index.lines[entry] == line
                entry <- index.next_indices[entry]
                steps <- steps + 1
            return index.lines.count

        def proof_source_kernel_build_tuple_label_index(annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> ProofSourceKernelTupleLabelIndex can[Memory.Allocate, Abort.Panic]:
            empty: ProofSourceKernelTupleLabelIndex = ProofSourceKernelTupleLabelIndex{lines: [], label_starts: [], label_counts: [], bucket_heads: [], next_indices: [], labels: [], capacity: 0, complete: false}
            return empty if not proof_source_kernel_charge_work(annotations.count, source_work)
            label_count: mutable usize = 0
            for annotation in annotations:
                if annotation.owner == "__tuple_label":
                    return empty if label_count >= PROOF_SOURCE_KERNEL_TUPLE_LABEL_LIMIT
                    label_count <- label_count + 1
            capacity: usize = proof_index_capacity(label_count)
            index: mutable ProofSourceKernelTupleLabelIndex = ProofSourceKernelTupleLabelIndex{lines: [], label_starts: [], label_counts: [], bucket_heads: [], next_indices: [], labels: [], capacity: capacity, complete: false}
            if capacity == 0:
                index.complete <- true
                return index
            return index if not proof_source_kernel_charge_work(annotations.count, source_work)
            index.bucket_heads.resize(capacity)
            bucket_sizes: mutable darray[usize] = []
            bucket_sizes.resize(capacity)
            for slot in 0..<capacity |slot, label_count, bucket_sizes|:
                index.bucket_heads[slot] <- label_count
                bucket_sizes[slot] <- 0
            for annotation in annotations |index, label_count|:
                continue if annotation.owner != "__tuple_label"
                slot: usize = (annotation.line.i64() % capacity.i64()).usize()
                entry: mutable usize = index.bucket_heads[slot]
                steps: mutable usize = 0
                while entry < index.lines.count |entry, annotation, index|:
                    break if index.lines[entry] == annotation.line
                    entry <- index.next_indices[entry]
                    steps <- steps + 1
                    return index if steps > PROOF_INDEX_MAX_CHAIN
                if entry >= index.lines.count:
                    bucket_sizes[slot] <- bucket_sizes[slot] + 1
                    return index if bucket_sizes[slot] > PROOF_INDEX_MAX_CHAIN
                    entry <- index.lines.count
                    index.lines.push(annotation.line)
                    index.label_starts.push(0)
                    index.label_counts.push(0)
                    index.next_indices.push(index.bucket_heads[slot])
                    index.bucket_heads[slot] <- entry
                index.label_counts[entry] <- index.label_counts[entry] + 1
            total_labels: mutable usize = 0
            for entry in 0..<index.lines.count |entry, index, total_labels|:
                index.label_starts[entry] <- total_labels
                total_labels <- total_labels + index.label_counts[entry]
            index.labels.resize(total_labels)
            cursors: mutable darray[usize] = []
            cursors.resize(index.lines.count)
            for entry in 0..<index.lines.count |entry, index, cursors|:
                cursors[entry] <- index.label_starts[entry]
            return index if not proof_source_kernel_charge_work(annotations.count, source_work)
            for annotation in annotations |annotation, index, capacity, cursors|:
                continue if annotation.owner != "__tuple_label"
                slot: usize = (annotation.line.i64() % capacity.i64()).usize()
                entry: mutable usize = index.bucket_heads[slot]
                steps: mutable usize = 0
                while entry < index.lines.count |entry, annotation, index|:
                    break if index.lines[entry] == annotation.line
                    entry <- index.next_indices[entry]
                    steps <- steps + 1
                    return index if steps > PROOF_INDEX_MAX_CHAIN
                return index if entry >= index.lines.count
                label_index: usize = cursors[entry]
                index.labels[label_index] <- annotation.name
                cursors[entry] <- label_index + 1
            index.complete <- true
            return index

        def proof_source_kernel_tuple_label_count(index: ProofSourceKernelTupleLabelIndex, line: u32) -> usize:
            return 0 if not index.complete or index.label_starts.count != index.lines.count or index.label_counts.count != index.lines.count
            entry: usize = proof_source_kernel_tuple_label_line(index, line)
            return 0 if entry >= index.lines.count
            return index.label_counts[entry]

        def proof_source_kernel_tuple_label_at(index: ProofSourceKernelTupleLabelIndex, line: u32, requested: usize) -> sview:
            return "" if not index.complete or index.label_starts.count != index.lines.count or index.label_counts.count != index.lines.count
            entry: usize = proof_source_kernel_tuple_label_line(index, line)
            return "" if entry >= index.lines.count or requested >= index.label_counts[entry]
            start: usize = index.label_starts[entry]
            return "" if start > index.labels.count or requested >= index.labels.count - start
            return index.labels[start + requested]

        # The field labels of a named-tuple type in element order, or none. An element's label is
        # the one `__tuple_label` annotation between the previous element's start (the tuple's own
        # start for the first) and its own. An unnamed element, a second candidate or a repeated
        # label gives no labels at all, and `result.f` then stays an opaque field.
        def proof_return_tuple_labels(type_expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            labels: mutable darray[sview] = []
            match type_expression:
                Ast::Expr.Tuple(elements, tuple_position):
                    lower: mutable Ast::Pos = tuple_position
                    for element in elements |labels, lower, annotations|:
                        upper: Ast::Pos = Ast::expr_pos(element)
                        found: mutable sview = ""
                        candidates: mutable usize = 0
                        for annotation in annotations |lower, upper, found, candidates|:
                            continue if annotation.owner != "__tuple_label" or annotation.line < lower.line or annotation.line > upper.line
                            if annotation.offset >= lower.offset and annotation.offset < upper.offset:
                                candidates <- candidates + 1
                                found <- annotation.name
                        for earlier in labels |found, candidates|:
                            candidates <- 0 if earlier == found
                        if candidates != 1 or found == "":
                            labels.clear()
                            return labels
                        labels.push(found)
                        lower <- upper
                _:
                    pass
            return labels

        # A call result may be rebound to a named-tuple local only when the local preserves the
        # callee's field at every tuple position. Tuple assignment is positional, so matching
        # labels as a set (or just finding the same label somewhere) is not enough: a reordered
        # local would make `found.count` refer to a different value from `call.count`.
        def proof_tuple_call_labels_match_local(call_value: Ast::Expr, local_type: Ast::Expr, report: ProofReport&, functions: mutable ProofFunctionTable&) -> bool:
            match local_type:
                Ast::Expr.Tuple(_, _):
                    pass
                _:
                    return false
            match call_value:
                Ast::Expr.Call(callee, _, _, _):
                    called: usize = proof_function_index_for_callee(functions, callee)
                    return false if:
                        called >= functions.returns.return_label_counts.count or called >= functions.returns.return_label_starts.count
                        functions.returns.return_label_counts[called] == 0
                    local_labels: darray[sview] = proof_return_tuple_labels(local_type, report.source.source_annotations)
                    return false if local_labels.count != functions.returns.return_label_counts[called]
                    start: usize = functions.returns.return_label_starts[called]
                    return false if:
                        start > functions.returns.all_return_labels.count
                        local_labels.count > functions.returns.all_return_labels.count - start
                    for index in 0..<local_labels.count |index, local_labels, functions, start|:
                        return false if functions.returns.all_return_labels[start + index] != local_labels[index]
                    return true
                _:
                    return false

        # A tuple type whose every element is a primitive scalar.
        def proof_scalar_tuple_type(type_expression: Ast::Expr, functions: ProofFunctionTable&, report: mutable ProofReport&) -> bool:
            match type_expression:
                Ast::Expr.Tuple(elements, _):
                    return false if elements.count == 0
                    for element in elements |functions, report|:
                        return false if proof_scalar_type_kind_index(element, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_types.source_effect_index.work.implicit_effect_work) != 1
                    return true
                _:
                    return false

        # `f(args).label`, for a verified total-pure `f` whose declared return is a named tuple, is
        # one value just as a scalar call is (see `proof_add_pure_call_witnesses`), under the same
        # argument conditions. Each primitive scalar element's witness carries its declared width.
        def proof_add_tuple_field_call_witnesses_with_work(object: Ast::Expr, field: sview, facts: mutable darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, position: Ast::Pos, budget: mutable usize&, exhausted: mutable bool&) -> bool can[Memory.Allocate, Abort.Panic]:
            match object:
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if exhausted or not proof_linear_safety_work_charge(budget, exhausted, 1)
                    pure: bool = proof_contract_calls_are_pure_with_source_work(object, functions, true, budget)
                    exhausted <- true if budget > PROOF_LINEAR_SAFETY_WORK_LIMIT
                    return false if exhausted
                    return true if not pure
                    called: usize = proof_function_index_for_callee(functions, callee)
                    if functions.lookup.work.module_resolution_work_exhausted:
                        exhausted <- true
                        return false
                    return true if called >= functions.returns.return_label_counts.count
                    marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
                    return false if not marker_result.complete or exhausted
                    marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
                    return false if not marker_scale.complete or exhausted
                    for argument in arguments |facts, report, marker_result, marker_scale, budget, exhausted|:
                        value_binding: (complete: bool, argument: bool) = proof_value_binding_argument_with_work(argument, report, 0, budget, exhausted)
                        return false if not value_binding.complete or exhausted
                        continue if value_binding.argument
                        witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(argument, marker_result.witnesses, marker_scale.scale, budget, exhausted)
                        return false if not witnessed.complete or exhausted or not witnessed.matches
                    return true if called >= functions.returns.return_label_starts.count
                    return false if not proof_add_tuple_label_witnesses_with_work(object, called, field, true, facts, functions, report, line, owner, position, budget, exhausted)
                    exhausted <- true if report.source_types.source_effect_index.work.implicit_effect_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return false if exhausted
                _:
                    pass
            return not exhausted

        # A named-tuple call result bound to a local has the callee's declared field types at the
        # same positions. `object` is normally the local; a call-preserving tuple binding uses
        # the original call so witness terms follow the summary into the field projection.
        def proof_add_bound_tuple_label_witnesses(call_value: Ast::Expr, object: Ast::Expr, facts: mutable darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, position: Ast::Pos) -> void can[Memory.Allocate, Abort.Panic]:
            match call_value:
                Ast::Expr.Call(callee, _, _, _):
                    called: usize = proof_function_index_for_callee(functions, callee)
                    budget: mutable usize = report.analysis_1.budgets.frame_call_source_work
                    exhausted: mutable bool = false
                    complete: bool = proof_add_tuple_label_witnesses_with_work(object, called, "", true, facts, functions, report, line, owner, position, &budget, &exhausted)
                    report.analysis_1.budgets.frame_call_source_work <- budget
                    if not complete or exhausted:
                        proof_frame_source_work_report_exhaustion(report, owner, line, "tuple-call-witness-work", "tuple call-result witness insertion exceeded its bounded source-work budget")
                _:
                    pass

        # Call-derived tuple witnesses use the shared frame meter and exact term equality.
        # Unlike the legacy helper above, each fact insertion sees the facts emitted earlier
        # in this same tuple expansion and charges those comparisons directly.
        def proof_add_tuple_label_witnesses_with_work(object: Ast::Expr, called: usize, field: sview, ranges: bool, facts: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, position: Ast::Pos, budget: mutable usize&, exhausted: mutable bool&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if exhausted
            if called >= functions.returns.return_label_counts.count or called >= functions.returns.return_label_starts.count or called >= functions.returns.return_types.count:
                exhausted <- true
                return false
            match functions.returns.return_types[called]:
                Ast::Expr.Tuple(elements, _):
                    start: usize = functions.returns.return_label_starts[called]
                    count: usize = functions.returns.return_label_counts[called]
                    if elements.count != count or start > functions.returns.all_return_labels.count or count > functions.returns.all_return_labels.count - start:
                        exhausted <- true
                        return false
                    if field != "":
                        labeled_field: mutable bool = false
                        for index in 0..<count |index, start, field, functions, budget, exhausted, labeled_field|:
                            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            label: sview = functions.returns.all_return_labels[start + index]
                            return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(label))
                            return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(field))
                            labeled_field <- true if label == field
                        return true if not labeled_field
                    # Once the requested field is known to exist, preserve the legacy behavior:
                    # every scalar tuple component contributes its width witnesses.
                    for index in 0..<count |index, start, functions, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        label: sview = functions.returns.all_return_labels[start + index]
                        return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(label))
                        element: Ast::Expr = elements[index]
                        scalar_kind: i64 = proof_scalar_type_kind_index(element, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                        if report.source_types.source_effect_index.work.implicit_effect_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            exhausted <- true
                            return false
                        continue if scalar_kind != 1
                        labeled: Ast::Expr = Ast::Expr.Field(object, functions.returns.all_return_labels[start + index], position)
                        scalar_marker: Ast::Expr = proof_scalar_term_marker(labeled, position)
                        return false if not proof_pure_call_add_scalar_witness_with_work(facts, report, scalar_marker, line, owner, budget, exhausted)
                        source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
                        signed_width: i64 = proof_signed_type_width_with_work(element, report.source.source_declarations, 0, &source_work)
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            exhausted <- true
                            return false
                        if signed_width > 0:
                            signed_marker: Ast::Expr = proof_signed_place_marker(labeled, signed_width, position)
                            return false if not proof_pure_call_add_scalar_witness_with_work(facts, report, signed_marker, line, owner, budget, exhausted)
                        source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                        unsigned_width: i64 = proof_unsigned_type_width_with_work(element, report.source.source_declarations, 0, &source_work)
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            exhausted <- true
                            return false
                        if unsigned_width > 0:
                            unsigned_marker: Ast::Expr = proof_unsigned_place_marker(labeled, unsigned_width, position)
                            return false if not proof_pure_call_add_scalar_witness_with_work(facts, report, unsigned_marker, line, owner, budget, exhausted)
                        if ranges and signed_width > 0 and signed_width < PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH:
                            signed_max: i64 = ElisaProofKernelCore::proof_kernel_signed_width_max(signed_width)
                            signed_upper: Ast::Expr = Ast::Expr.Binary(labeled, TokenKind.LtEq, Ast::Expr.IntLit(signed_max, position), position)
                            return false if not proof_pure_call_add_type_fact_with_work(facts, report, signed_upper, line, owner, budget, exhausted)
                            magnitude: Ast::Expr = Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(signed_max, position), position)
                            floor: Ast::Expr = Ast::Expr.Binary(magnitude, TokenKind.Minus, Ast::Expr.IntLit(1, position), position)
                            signed_lower: Ast::Expr = Ast::Expr.Binary(floor, TokenKind.LtEq, labeled, position)
                            return false if not proof_pure_call_add_type_fact_with_work(facts, report, signed_lower, line, owner, budget, exhausted)
                        if ranges and unsigned_width > 0 and unsigned_width < PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH:
                            unsigned_lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, labeled, position)
                            return false if not proof_pure_call_add_type_fact_with_work(facts, report, unsigned_lower, line, owner, budget, exhausted)
                            unsigned_upper: Ast::Expr = Ast::Expr.Binary(labeled, TokenKind.LtEq, Ast::Expr.IntLit(proof_unsigned_width_max(unsigned_width), position), position)
                            return false if not proof_pure_call_add_type_fact_with_work(facts, report, unsigned_upper, line, owner, budget, exhausted)
                    return not exhausted
                _:
                    true
