# Source-annotation index for the proof kernel's named-tuple field projection.
extend ElisaProof:
    private:
        struct ProofSourceKernelTupleLabelIndex:
            lines: mutable darray[u32]
            label_starts: mutable darray[usize]
            label_counts: mutable darray[usize]
            bucket_heads: mutable darray[usize]
            next_indices: mutable darray[usize]
            labels: mutable darray[sview]
            capacity: usize
            complete: mutable bool

        def proof_source_kernel_tuple_label_line(index: ProofSourceKernelTupleLabelIndex, line: u32) -> usize:
            return index.lines.count if index.capacity == 0
            slot: usize = (line.i64() % index.capacity.i64()).usize()
            entry: mutable usize = index.bucket_heads[slot]
            while entry < index.lines.count |entry, line, index|:
                return entry if index.lines[entry] == line
                entry <- index.next_indices[entry]
            return index.lines.count

        def proof_source_kernel_build_tuple_label_index(annotations: darray[Ast::EnumAnnotation]&) -> ProofSourceKernelTupleLabelIndex can[Memory.Allocate, Abort.Panic]:
            label_count: mutable usize = 0
            for annotation in annotations:
                label_count <- label_count + 1 if annotation.owner == "__tuple_label"
            capacity: usize = proof_index_capacity(label_count)
            index: mutable ProofSourceKernelTupleLabelIndex = ProofSourceKernelTupleLabelIndex{lines: [], label_starts: [], label_counts: [], bucket_heads: [], next_indices: [], labels: [], capacity: capacity, complete: false}
            if capacity == 0:
                index.complete <- true
                return index
            index.bucket_heads.resize(capacity)
            for slot in 0..<capacity |slot, label_count|:
                index.bucket_heads[slot] <- label_count
            for annotation in annotations |index, label_count|:
                continue if annotation.owner != "__tuple_label"
                slot: usize = (annotation.line.i64() % capacity.i64()).usize()
                entry: mutable usize = index.bucket_heads[slot]
                while entry < index.lines.count |entry, annotation, index|:
                    break if index.lines[entry] == annotation.line
                    entry <- index.next_indices[entry]
                if entry >= index.lines.count:
                    entry <- index.lines.count
                    index.lines.push(annotation.line)
                    index.label_starts.push(0)
                    index.label_counts.push(0)
                    index.next_indices.push(index.bucket_heads[slot])
                    index.bucket_heads[slot] <- entry
                index.label_counts[entry] <- index.label_counts[entry] + 1
            total_labels: mutable usize = 0
            for entry in 0..<index.lines.count |entry, index, total_labels|:
                index.label_starts[entry] <- total_labels
                total_labels <- total_labels + index.label_counts[entry]
            index.labels.resize(total_labels)
            cursors: mutable darray[usize] = []
            cursors.resize(index.lines.count)
            for entry in 0..<index.lines.count |entry, index, cursors|:
                cursors[entry] <- index.label_starts[entry]
            for annotation in annotations |annotation, index, capacity, cursors|:
                continue if annotation.owner != "__tuple_label"
                slot: usize = (annotation.line.i64() % capacity.i64()).usize()
                entry: mutable usize = index.bucket_heads[slot]
                while entry < index.lines.count |entry, annotation, index|:
                    break if index.lines[entry] == annotation.line
                    entry <- index.next_indices[entry]
                return index if entry >= index.lines.count
                label_index: usize = cursors[entry]
                index.labels[label_index] <- annotation.name
                cursors[entry] <- label_index + 1
            index.complete <- true
            return index

        def proof_source_kernel_tuple_label_count(index: ProofSourceKernelTupleLabelIndex, line: u32) -> usize:
            return 0 if not index.complete
            entry: usize = proof_source_kernel_tuple_label_line(index, line)
            return 0 if entry >= index.lines.count
            return index.label_counts[entry]

        def proof_source_kernel_tuple_label_at(index: ProofSourceKernelTupleLabelIndex, line: u32, requested: usize) -> sview:
            return "" if not index.complete
            entry: usize = proof_source_kernel_tuple_label_line(index, line)
            return "" if entry >= index.lines.count or requested >= index.label_counts[entry]
            return index.labels[index.label_starts[entry] + requested]

        # The field labels of a named-tuple type in element order, or none. An element's label is
        # the one `__tuple_label` annotation between the previous element's start (the tuple's own
        # start for the first) and its own. An unnamed element, a second candidate or a repeated
        # label gives no labels at all, and `result.f` then stays an opaque field.
        def proof_return_tuple_labels(type_expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> darray[sview] can[Memory.Allocate, Abort.Panic]:
            labels: mutable darray[sview] = []
            match type_expression:
                Ast::Expr.Tuple(elements, tuple_position):
                    lower: mutable Ast::Pos = tuple_position
                    for element in elements |labels, lower, annotations|:
                        upper: Ast::Pos = Ast::expr_pos(element)
                        found: mutable sview = ""
                        candidates: mutable usize = 0
                        for annotation in annotations |lower, upper, found, candidates|:
                            continue if annotation.owner != "__tuple_label" or annotation.line < lower.line or annotation.line > upper.line
                            if annotation.offset >= lower.offset and annotation.offset < upper.offset:
                                candidates <- candidates + 1
                                found <- annotation.name
                        for earlier in labels |found, candidates|:
                            candidates <- 0 if earlier == found
                        if candidates != 1 or found == "":
                            labels.clear()
                            return labels
                        labels.push(found)
                        lower <- upper
                _:
                    pass
            return labels

        # A call result may be rebound to a named-tuple local only when the local preserves the
        # callee's field at every tuple position. Tuple assignment is positional, so matching
        # labels as a set (or just finding the same label somewhere) is not enough: a reordered
        # local would make `found.count` refer to a different value from `call.count`.
        def proof_tuple_call_labels_match_local(call_value: Ast::Expr, local_type: Ast::Expr, report: ProofReport&, functions: ProofFunctionTable&) -> bool:
            match local_type:
                Ast::Expr.Tuple(_, _):
                    pass
                _:
                    return false
            match call_value:
                Ast::Expr.Call(callee, _, _, _):
                    called: usize = proof_function_index_for_callee(functions, callee)
                    return false if called >= functions.return_label_counts.count or called >= functions.return_label_starts.count
                    return false if functions.return_label_counts[called] == 0
                    local_labels: darray[sview] = proof_return_tuple_labels(local_type, report.source_annotations)
                    return false if local_labels.count != functions.return_label_counts[called]
                    start: usize = functions.return_label_starts[called]
                    return false if start > functions.all_return_labels.count
                    return false if local_labels.count > functions.all_return_labels.count - start
                    for index in 0..<local_labels.count |index, local_labels, functions, start|:
                        return false if functions.all_return_labels[start + index] != local_labels[index]
                    return true
                _:
                    return false

        # A tuple type whose every element is a primitive scalar.
        def proof_scalar_tuple_type(type_expression: Ast::Expr, declarations: darray[Ast::Decl]&, functions: ProofFunctionTable&) -> bool:
            match type_expression:
                Ast::Expr.Tuple(elements, _):
                    return false if elements.count == 0
                    for element in elements |declarations, functions|:
                        return false if proof_scalar_type_kind_index(element, declarations, functions.type_audit_index, 0) != 1
                    return true
                _:
                    return false

        # `f(args).label`, for a verified total-pure `f` whose declared return is a named tuple, is
        # one value just as a scalar call is (see `proof_add_pure_call_witnesses`), under the same
        # argument conditions. Each primitive scalar element's witness carries its declared width.
        def proof_add_tuple_field_call_witnesses(object: Ast::Expr, field: sview, facts: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, position: Ast::Pos) -> void can[Memory.Allocate, Abort.Panic]:
            match object:
                Ast::Expr.Call(callee, arguments, _, _):
                    return if not proof_contract_calls_are_pure(object, functions)
                    callee_name: sview = proof_ident_name(callee)
                    return if callee_name == ""
                    called: usize = proof_function_index_for_callee(functions, callee)
                    return if called >= functions.return_label_counts.count
                    for argument in arguments |facts, report|:
                        continue if proof_value_binding_argument(argument, report, 0)
                        return if not proof_scalar_term_witnessed(argument, facts, 0)
                    proof_add_tuple_label_witnesses(object, callee_name, called, field, true, facts, functions, report, line, owner, position)
                _:
                    pass

        # A named-tuple call result bound to a local has the callee's declared field types at the
        # same positions. `object` is normally the local; a call-preserving tuple binding uses
        # the original call so witness terms follow the summary into the field projection.
        def proof_add_bound_tuple_label_witnesses(call_value: Ast::Expr, object: Ast::Expr, facts: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, position: Ast::Pos) -> void can[Memory.Allocate, Abort.Panic]:
            match call_value:
                Ast::Expr.Call(callee, _, _, _):
                    callee_name: sview = proof_ident_name(callee)
                    return if callee_name == ""
                    called: usize = proof_function_index_for_callee(functions, callee)
                    proof_add_tuple_label_witnesses(object, callee_name, called, "", true, facts, functions, report, line, owner, position)
                _:
                    pass

        # Type witnesses for every scalar label of `object`, a value of `callee_name`'s declared
        # named-tuple return type, when `field` is one of those labels (any label if empty). With
        # `ranges`, signed labels and narrow unsigned labels receive the type bounds used for parameters.
        def proof_add_tuple_label_witnesses(object: Ast::Expr, callee_name: sview, called: usize, field: sview, ranges: bool, facts: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, position: Ast::Pos) -> void can[Memory.Allocate, Abort.Panic]:
            return if called >= functions.return_label_counts.count or called >= functions.return_label_starts.count
            declared: (count: usize, type_expression: Ast::Expr) = proof_source_function_return_type(report.source_declarations, callee_name, 0)
            return if declared.count != 1
            match declared.type_expression:
                Ast::Expr.Tuple(elements, _):
                    return if elements.count != functions.return_label_counts[called]
                    start: usize = functions.return_label_starts[called]
                    labeled_field: mutable bool = field == ""
                    for index in 0..<elements.count |functions, start, field, labeled_field|:
                        labeled_field <- true if functions.all_return_labels[start + index] == field
                    return if not labeled_field
                    # Every scalar label is typed at once: a summary or branch condition
                    # over a sibling label is read under the same width guards.
                    for index in 0..<elements.count |elements, functions, start, object, ranges, facts, report, line, owner, position|:
                        element: Ast::Expr = elements[index]
                        continue if proof_scalar_type_kind_index(element, report.source_declarations, functions.type_audit_index, 0) != 1
                        labeled: Ast::Expr = Ast::Expr.Field(object, functions.all_return_labels[start + index], position)
                        proof_add_scalar_type_witness(facts, report, proof_scalar_term_marker(labeled, position), line, owner)
                        signed_width: i64 = proof_signed_type_width(element, report.source_declarations, 0)
                        proof_add_scalar_type_witness(facts, report, proof_signed_place_marker(labeled, signed_width, position), line, owner) if signed_width > 0
                        unsigned_width: i64 = proof_unsigned_type_width(element, report.source_declarations, 0)
                        proof_add_scalar_type_witness(facts, report, proof_unsigned_place_marker(labeled, unsigned_width, position), line, owner) if unsigned_width > 0
                        proof_add_signed_range_facts(facts, report, labeled, signed_width, line, owner, position) if ranges and signed_width > 0
                        continue if not ranges or unsigned_width <= 0 or unsigned_width >= PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH
                        proof_add_type_bound_fact(facts, report, Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, labeled, position), line, owner)
                        proof_add_type_bound_fact(facts, report, Ast::Expr.Binary(labeled, TokenKind.LtEq, Ast::Expr.IntLit(proof_unsigned_width_max(unsigned_width), position), position), line, owner)
                _:
                    pass
