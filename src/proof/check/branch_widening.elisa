# Widened and renamed facts carried across a branch join.
extend ElisaProof:
    private:
        def proof_push_widened_facts(candidates: mutable darray[Ast::Expr]&, source: darray[Ast::Expr]&, joined: darray[sview]&, position: Ast::Pos) -> void:
            for fact in source |candidates, joined, position|:
                match fact:
                    Ast::Expr.Binary(left, operator, right, _):
                        continue if operator != TokenKind.LtEq and operator != TokenKind.Lt
                        continue if not (any name in joined where proof_expr_mentions_name(left, name))
                        wider: Ast::Expr = Ast::Expr.Binary(right, TokenKind.Plus, Ast::Expr.IntLit(1, position), position)
                        candidates.push(Ast::Expr.Binary(left, TokenKind.LtEq, wider, position)) if operator == TokenKind.LtEq
                    Ast::Expr.Block(_, body, _, _):
                        # A range grows by one the same way: a bubble step turns the invariant
                        # `forall i in 0..<k: xs[i] <= m` into `... 0..<k + 1 ...` before `k <- k + 1`.
                        range: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(fact)
                        continue if not range.known
                        continue if not (any name in joined where proof_expr_mentions_name(body, name) or proof_expr_mentions_name(range.lower, name) or proof_expr_mentions_name(range.upper, name))
                        grown: (known: bool, value: Ast::Expr) = proof_widened_forall(fact, position)
                        candidates.push(grown.value) if grown.known
                    _:
                        continue

        # `forall i in a..<b: P` as `forall i in a..<b + 1: P`, keeping the binder's declaration.
        def proof_widened_forall(fact: Ast::Expr, position: Ast::Pos) -> (known: bool, value: Ast::Expr):
            range: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(fact)
            return (false, Ast::Expr.Invalid) if not range.known
            wider: Ast::Expr = Ast::Expr.Binary(range.lower, TokenKind.RangeLt, Ast::Expr.Binary(range.upper, TokenKind.Plus, Ast::Expr.IntLit(1, position), position), position)
            match fact:
                Ast::Expr.Block(statements, body, captures, block_position):
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, type_expression, _, statement_position):
                            grown: mutable darray[Ast::Stmt] = []
                            grown.push(Ast::Stmt.VarDecl(binder, type_expression, wider, statement_position))
                            return (true, Ast::Expr.Block(grown, body, captures, block_position))
                        _:
                            return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        # A binding recorded as `b == best` states the arm's other facts over `best`.
        def proof_push_equal_renamings(candidates: mutable darray[Ast::Expr]&, source: darray[Ast::Expr]&, name: sview) -> void:
            for fact in source |candidates, source, name|:
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        proof_push_renamed_facts(candidates, source, right, name) if proof_ident_name(left) == name and not proof_expr_mentions_name(right, name)
                    _:
                        continue

        # Havoc for an opaque call. Type bounds are kept as at every havoc point; in addition a
        # fact that is call-stable for the current function is kept. The alias set must belong
        # to this very owner, otherwise nothing but type bounds survives.
