extend ElisaProof:
    private:
        def proof_collect_extern_return_metadata(annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, head: sview) -> (valid: bool, reference: bool, optional: bool, mutable_return: bool):
            heads: mutable usize = 0
            references: mutable usize = 0
            optionals: mutable usize = 0
            mutables: mutable usize = 0
            valid: mutable bool = name != ""
            for annotation in annotations |name, line, head, heads, references, optionals, mutables, valid|:
                continue if annotation.line != line
                if annotation.owner == "__extern_return":
                    heads <- heads + 1
                    valid <- false if annotation.name != head
                if annotation.owner == "__extern_return_ptr":
                    references <- references + 1
                    valid <- false if annotation.name != name
                if annotation.owner == "__extern_return_optional":
                    optionals <- optionals + 1
                    valid <- false if annotation.name != name
                if annotation.owner == "__extern_return_mutable":
                    mutables <- mutables + 1
                    valid <- false if annotation.name != name
            valid <- valid and heads == (0 if head == "" else 1) and references <= 1 and optionals <= 1 and mutables <= 1
            valid <- false if head == "" and (references != 0 or optionals != 0 or mutables != 0)
            return (valid, references == 1, optionals == 1, mutables == 1)

        def proof_collect_extern_signature[@r](file: Ast::File&, name: sview, parameter_start: u32, arity: u32, variadic: bool, callable: bool, return_type_name: sview, source_decorators: darray[Ast::Annotation]&, position: Ast::Pos, signatures: mutable darray[ProofExternSignature]& @r) -> void:
            start: usize = parameter_start.usize()
            count: usize = arity.usize()
            valid: bool = start <= file.extern_params.count and count <= file.extern_params.count - start
            parameters: mutable darray[Ast::ExternParam] @r = []
            if valid:
                for offset in 0..<count |offset, file, start, parameters|:
                    parameters.push(file.extern_params[start + offset])
            effects: mutable darray[sview] @r = []
            complete: bool = proof_import_extern_effect_row(&file.enum_annotations, name, position.line, &effects)
            result = proof_collect_extern_return_metadata(&file.enum_annotations, name, position.line, return_type_name)
            decorators_valid: mutable bool = true
            decorators: mutable darray[Ast::Annotation] @r = []
            arguments: mutable darray[sview] @r = []
            for decorator in source_decorators |decorator, file, decorators_valid, decorators, arguments|:
                start: usize = decorator.arg_start.usize()
                count: usize = decorator.arg_count.usize()
                if start > file.annotation_args.count or count > file.annotation_args.count - start:
                    decorators_valid <- false
                    continue
                local_start: usize = arguments.count
                for offset in 0..<count |offset, file, start, arguments|:
                    arguments.push(file.annotation_args[start + offset])
                decorators.push(Ast::Annotation{name: decorator.name, arg_start: local_start.u32(), arg_count: decorator.arg_count, line: decorator.line, column: decorator.column})
            contracts_valid: mutable bool = file.signature_contract_lines.count == file.signature_contract_kinds.count and file.signature_contract_lines.count == file.signature_contract_exprs.count
            requirements: mutable darray[Ast::Expr] @r = []
            postconditions: mutable darray[Ast::Expr] @r = []
            if contracts_valid:
                for index in 0..<file.signature_contract_lines.count |index, file, position, contracts_valid, requirements, postconditions|:
                    continue if file.signature_contract_lines[index] != position.line
                    kind: sview = file.signature_contract_kinds[index]
                    if kind == "requires":
                        requirements.push(file.signature_contract_exprs[index])
                    elif kind == "ensure":
                        postconditions.push(file.signature_contract_exprs[index])
                    else:
                        contracts_valid <- false
            signatures.push(ProofExternSignature{name: name, line: position.line, callable: callable, variadic: variadic, return_type_name: return_type_name, return_metadata_valid: result.valid, return_reference: result.reference, return_optional: result.optional, return_mutable: result.mutable_return, declared_arity: count, parameters_valid: valid, parameters: parameters, decorators_valid: decorators_valid, decorators: decorators, decorator_arguments: arguments, contracts_valid: contracts_valid, requires_clauses: requirements, ensures_clauses: postconditions, effects_complete: complete, effects: effects})

        # Uniqueness among extern declarations only. Consumers must additionally reject
        # collisions with executable/erased declarations and lexical binders. Use the already
        # built bounded name index instead of rescanning every extern for each call site.
        def proof_extern_signature_index_with_work(functions: ProofFunctionTable&, name: sview, source_work: mutable usize&) -> (complete: bool, index: usize):
            count: usize = functions.externs.extern_signatures.count
            return (true, count) if name == "" or count == 0
            capacity: usize = functions.externs.extern_index_values.count
            return (false, count) if:
                capacity != functions.externs.extern_index_hashes.count or capacity != functions.externs.extern_index_ambiguous.count or capacity != functions.externs.extern_index_callable.count
                capacity == 0 or capacity != proof_name_index_capacity(count)
                source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                not proof_report_source_work_charge(1 + sview_len(name), source_work)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, functions, capacity, count, source_work|:
                return (false, count) if not proof_report_source_work_charge(1, source_work)
                current: usize = functions.externs.extern_index_values[slot]
                return (true, count) if current == count
                return (false, count) if current > count
                if functions.externs.extern_index_hashes[slot] == wanted_hash:
                    candidate: sview = functions.externs.extern_signatures[current].name
                    return (false, count) if not proof_report_source_work_charge(sview_len(candidate), source_work)
                    if candidate == name:
                        return (true, count) if functions.externs.extern_index_ambiguous[slot]
                        return (true, current)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, count)

        def proof_extern_signature_index_for_report(functions: ProofFunctionTable&, name: sview, report: mutable ProofReport&) -> usize:
            lookup: (complete: bool, index: usize) = proof_extern_signature_index_with_work(functions, name, &report.source_types.source_effect_index.work.implicit_effect_work)
            if not lookup.complete:
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return functions.externs.extern_signatures.count
            return lookup.index
