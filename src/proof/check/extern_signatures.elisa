extend ElisaProof:
    private:
        def proof_collect_extern_signature[@r](file: Ast::File&, name: sview, parameter_start: u32, arity: u32, variadic: bool, callable: bool, return_type_name: sview, position: Ast::Pos, signatures: mutable darray[ProofExternSignature]& @r) -> void:
            start: usize = parameter_start.usize()
            count: usize = arity.usize()
            valid: bool = start <= file.extern_params.count and count <= file.extern_params.count - start
            parameters: mutable darray[Ast::ExternParam] @r = []
            if valid:
                for offset in 0..<count |offset, file, start, parameters|:
                    parameters.push(file.extern_params[start + offset])
            effects: mutable darray[sview] @r = []
            complete: bool = proof_import_extern_effect_row(&file.enum_annotations, name, position.line, &effects)
            signatures.push(ProofExternSignature{name: name, line: position.line, callable: callable, variadic: variadic, return_type_name: return_type_name, declared_arity: count, parameters_valid: valid, parameters: parameters, effects_complete: complete, effects: effects})

        # Uniqueness among extern declarations only. Consumers must additionally
        # reject collisions with executable/erased declarations and lexical binders.
        # A missing or ambiguous signature never becomes an empty-row guarantee.
        def proof_extern_signature_index(signatures: darray[ProofExternSignature]&, name: sview) -> usize:
            selected: mutable usize = signatures.count
            return selected if name == ""
            for index in 0..<signatures.count |index, signatures, name, selected|:
                if signatures[index].name == name:
                    return signatures.count if selected < signatures.count
                    selected <- index
            return selected
