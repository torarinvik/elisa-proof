# Literal integer constants of a root module, named by their qualified path (`Limits::TOP`) from a
# function at the root. Only a constant a contract of the function names is imported, as an exact
# fact about the qualified term itself, so the qualified spelling stays one atom and no name is
# substituted. The independent replay validator resolves the same path from the source declarations.
extend ElisaProof:
    private:
        const PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT: usize = 32

        # The parser may record a nested module under its qualified spelling (`Outer::{name}`),
        # so a declared name matches when it is `name` or ends in `::name`.
        def proof_qualified_segment_matches(declared: sview, name: sview) -> bool:
            return true if declared == name
            declared_length: usize = sview_len(declared)
            name_length: usize = sview_len(name)
            return false if name_length == 0 or declared_length < name_length + 2
            start: usize = declared_length - name_length
            return false if sview_at(declared, start - 1) != 58 or sview_at(declared, start - 2) != 58
            for offset in 0..<name_length |offset, declared, name, start|:
                return false if sview_at(declared, start + offset) != sview_at(name, offset)
            return true

        # True when a module, enum or struct named `name` is declared below the root. From a
        # function inside a module such a namespace could be the nearer meaning of `name::X`, so a
        # nested function resolves a qualified path from the root only when none exists.
        def proof_qualified_nested_namespace(declarations: darray[Ast::Decl]&, name: sview, nested: bool, depth: usize) -> bool:
            return true if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT
            for declaration in declarations |name, nested, depth|:
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        return true if (nested or module_name != name) and proof_qualified_segment_matches(module_name, name)
                        return true if proof_qualified_nested_namespace(body, name, true, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return true if proof_qualified_nested_namespace(body, name, nested, depth + 1)
                    Ast::Decl.Enum(enum_name, _, _, _, _):
                        return true if (nested or enum_name != name) and proof_qualified_segment_matches(enum_name, name)
                    Ast::Decl.Struct(struct_name, _, _, _, _, _, _):
                        return true if (nested or struct_name != name) and proof_qualified_segment_matches(struct_name, name)
                    _:
                        pass
            return false

        def proof_qualified_constant_term(scope: darray[sview]&, name: sview, position: Ast::Pos) -> Ast::Expr:
            path: mutable Ast::Expr = Ast::Expr.Ident(scope[0], position)
            for index in 1..<scope.count |index, scope, position, path|:
                path <- Ast::Expr.Scope(path, scope[index], position)
            return Ast::Expr.Scope(path, name, position)

        def proof_qualified_constant_flatten(expression: Ast::Expr, path: mutable darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(identifier, _):
                    path.push(identifier)
                    return true
                Ast::Expr.Scope(base, leaf, _):
                    return false if not proof_qualified_constant_flatten(base, path, depth + 1)
                    path.push(leaf)
                    return true
                _:
                    return false

        # True when `expression` is exactly the path `scope::name`.
        def proof_qualified_constant_is_term(expression: Ast::Expr, scope: darray[sview]&, name: sview) -> bool:
            path: mutable darray[sview] = []
            return false if not proof_qualified_constant_flatten(expression, &path, 0)
            return false if path.count != scope.count + 1
            for index in 0..<scope.count |index, scope, path|:
                return false if path[index] != scope[index]
            return path[scope.count] == name

        def proof_qualified_constant_mentioned(expression: Ast::Expr, scope: darray[sview]&, name: sview, depth: usize) -> bool:
            return false if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT
            return true if proof_qualified_constant_is_term(expression, scope, name)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_qualified_constant_mentioned(inner, scope, name, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_qualified_constant_mentioned(operand, scope, name, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_qualified_constant_mentioned(left, scope, name, depth + 1) or proof_qualified_constant_mentioned(right, scope, name, depth + 1)
                Ast::Expr.If(condition, then_value, else_value, _):
                    return proof_qualified_constant_mentioned(condition, scope, name, depth + 1) or proof_qualified_constant_mentioned(then_value, scope, name, depth + 1) or proof_qualified_constant_mentioned(else_value, scope, name, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_qualified_constant_mentioned(object, scope, name, depth + 1) or proof_qualified_constant_mentioned(index, scope, name, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_qualified_constant_mentioned(object, scope, name, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    for argument in arguments |scope, name, depth|:
                        return true if proof_qualified_constant_mentioned(argument, scope, name, depth + 1)
                    return false
                _:
                    return false

        def proof_qualified_constant_declared_count(declarations: darray[Ast::Decl]&, scope: darray[sview]&, name: sview, current: darray[sview]&, depth: usize) -> usize:
            return 0 if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT
            in_scope: bool = proof_global_constant_scope_equal(scope, current)
            found: mutable usize = 0
            for declaration in declarations |scope, name, current, depth, in_scope, found|:
                match declaration:
                    Ast::Decl.Const(constant_name, _, _, _, _):
                        found <- found + 1 if in_scope and constant_name == name
                    Ast::Decl.Module(module_name, body, _):
                        next_scope: mutable darray[sview] = []
                        next_scope.extend(current)
                        next_scope.push(module_name)
                        found <- found + proof_qualified_constant_declared_count(body, scope, name, &next_scope, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        found <- found + proof_qualified_constant_declared_count(body, scope, name, current, depth + 1)
                    _:
                        pass
            return found

        # The value of a literal constant the replay validator would also accept, or no value.
        def proof_qualified_constant_value(constant_type: Ast::Expr, initializer: Ast::Expr) -> (known: bool, value: i64):
            type_name: sview = match constant_type:
                Ast::Expr.Ident(name, _): name
                _: ""
            return (false, 0) if type_name != "i64" and type_name != "usize" and type_name != "u8" and type_name != "u64"
            match initializer:
                Ast::Expr.IntLit(literal, _):
                    return (false, 0) if literal < 0 and type_name != "i64"
                    return (false, 0) if literal < 0
                    return (false, 0) if type_name == "u8" and literal > 255
                    return (true, literal)
                Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(magnitude, _), _):
                    return (type_name == "i64" and magnitude >= 0, 0 - magnitude)
                _:
                    return (false, 0)

        # Replace an occurrence of a qualified constant by its value, so the arithmetic engines see a literal;
        # the traced equality fact records why the replacement is sound. Unlisted shapes are left as written.
        def proof_qualified_constant_rewrite[@r](expression: Ast::Expr, scope: darray[sview]&, name: sview, value: Ast::Expr @r, depth: usize) -> Ast::Expr @r:
            return expression if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT
            return value if proof_qualified_constant_is_term(expression, scope, name)
            match expression:
                Ast::Expr.Binary(left, operator, right, position):
                    return Ast::Expr.Binary(proof_qualified_constant_rewrite(left, scope, name, value, depth + 1), operator, proof_qualified_constant_rewrite(right, scope, name, value, depth + 1), position)
                Ast::Expr.Unary(operator, operand, position):
                    return Ast::Expr.Unary(operator, proof_qualified_constant_rewrite(operand, scope, name, value, depth + 1), position)
                Ast::Expr.If(condition, then_expr, else_expr, position):
                    return Ast::Expr.If(proof_qualified_constant_rewrite(condition, scope, name, value, depth + 1), proof_qualified_constant_rewrite(then_expr, scope, name, value, depth + 1), proof_qualified_constant_rewrite(else_expr, scope, name, value, depth + 1), position)
                Ast::Expr.Paren(inner, position):
                    return Ast::Expr.Paren(proof_qualified_constant_rewrite(inner, scope, name, value, depth + 1), position)
                Ast::Expr.Call(callee, arguments, extra, position):
                    rewritten: mutable darray[Ast::Expr] @r = []
                    for argument in arguments |rewritten, scope, name, value, depth|:
                        rewritten.push(proof_qualified_constant_rewrite(argument, scope, name, value, depth + 1))
                    return Ast::Expr.Call(callee, rewritten, extra, position)
                _:
                    return expression

        # Body statements that carry a qualified constant: returns, local initializers, `if`,
        # `while` and `for` headers and bodies, assigned values and expression statements (call
        # arguments). Other statements are left as written, so their mentions stay unimported.
        def proof_qualified_body_mentioned(body: darray[Ast::Stmt]&, scope: darray[sview]&, name: sview, depth: usize) -> bool:
            return false if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT
            for statement in body |scope, name, depth|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return true if proof_qualified_constant_mentioned(returned, scope, name, 0)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_qualified_constant_mentioned(initializer, scope, name, 0)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_qualified_constant_mentioned(condition, scope, name, 0)
                        return true if proof_qualified_body_mentioned(then_body, scope, name, depth + 1)
                        return true if proof_qualified_body_mentioned(else_body, scope, name, depth + 1)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_qualified_constant_mentioned(condition, scope, name, 0)
                        return true if proof_qualified_body_mentioned(while_body, scope, name, depth + 1)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        return true if proof_qualified_constant_mentioned(iterable, scope, name, 0)
                        return true if proof_qualified_body_mentioned(for_body, scope, name, depth + 1)
                    Ast::Stmt.Assign(_, _, assigned, _):
                        return true if proof_qualified_constant_mentioned(assigned, scope, name, 0)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_qualified_constant_mentioned(expression, scope, name, 0)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_qualified_constant_mentioned(expression, scope, name, 0)
                    _:
                        pass
            return false

        # A local spelled like the module would make `Limits::TOP` name something else.
        def proof_qualified_body_declares(body: darray[Ast::Stmt]&, name: sview, depth: usize) -> bool:
            return true if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT
            for statement in body |name, depth|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, _, _, _):
                        return true if local_name == name
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return true if proof_qualified_body_declares(then_body, name, depth + 1) or proof_qualified_body_declares(else_body, name, depth + 1)
                    Ast::Stmt.While(_, while_body, _):
                        return true if proof_qualified_body_declares(while_body, name, depth + 1)
                    Ast::Stmt.For(_, variables, _, for_body, _):
                        return true if any variable in variables where variable == name
                        return true if proof_qualified_body_declares(for_body, name, depth + 1)
                    _:
                        pass
            return false

        def proof_qualified_body_rewrite[@r](body: darray[Ast::Stmt]& @r, scope: darray[sview]&, name: sview, value: Ast::Expr @r, depth: usize) -> darray[Ast::Stmt] @r:
            rewritten: mutable darray[Ast::Stmt] @r = []
            for statement in body |rewritten, scope, name, value, depth|:
                match statement:
                    Ast::Stmt.Return(returned_value, position):
                        if returned_value is returned and depth < PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT:
                            rewritten.push(Ast::Stmt.Return(proof_qualified_constant_rewrite(returned, scope, name, value, 0), position))
                        else:
                            rewritten.push(statement)
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                        rewritten.push(Ast::Stmt.VarDecl(local_name, type_expression, proof_qualified_constant_rewrite(initializer, scope, name, value, 0), position))
                    Ast::Stmt.If(condition, then_body, else_body, position):
                        if depth < PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT:
                            rewritten.push(Ast::Stmt.If(proof_qualified_constant_rewrite(condition, scope, name, value, 0), proof_qualified_body_rewrite(then_body, scope, name, value, depth + 1), proof_qualified_body_rewrite(else_body, scope, name, value, depth + 1), position))
                        else:
                            rewritten.push(statement)
                    Ast::Stmt.While(condition, while_body, position):
                        if depth < PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT:
                            rewritten.push(Ast::Stmt.While(proof_qualified_constant_rewrite(condition, scope, name, value, 0), proof_qualified_body_rewrite(while_body, scope, name, value, depth + 1), position))
                        else:
                            rewritten.push(statement)
                    Ast::Stmt.For(label, variables, iterable, for_body, position):
                        if depth < PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT:
                            rewritten.push(Ast::Stmt.For(label, variables, proof_qualified_constant_rewrite(iterable, scope, name, value, 0), proof_qualified_body_rewrite(for_body, scope, name, value, depth + 1), position))
                        else:
                            rewritten.push(statement)
                    Ast::Stmt.Assign(target, operator, assigned, position):
                        rewritten.push(Ast::Stmt.Assign(target, operator, proof_qualified_constant_rewrite(assigned, scope, name, value, 0), position))
                    Ast::Stmt.Expr(expression, position):
                        rewritten.push(Ast::Stmt.Expr(proof_qualified_constant_rewrite(expression, scope, name, value, 0), position))
                    Ast::Stmt.Contract(kind, expression, position):
                        rewritten.push(Ast::Stmt.Contract(kind, proof_qualified_constant_rewrite(expression, scope, name, value, 0), position))
                    _:
                        rewritten.push(statement)
            return rewritten

        def proof_qualified_constants_collect[@r](file: Ast::File&, declarations: darray[Ast::Decl]&, current: darray[sview]&, contracts: mutable darray[Ast::Expr]& @r, function_body: mutable darray[Ast::Stmt]& @r, parameters: darray[Ast::ParamDecl]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, function_name: sview, nested_function: bool, depth: usize) -> void:
            return if depth >= PROOF_QUALIFIED_CONSTANT_DEPTH_LIMIT
            for declaration in declarations |file, current, contracts, function_body, parameters, facts, report, function_name, nested_function, depth|:
                match declaration:
                    Ast::Decl.Const(constant_name, constant_type, initializer, constant_mutable, position):
                        if current.count > 0 and constant_mutable == false and (any parameter in parameters where parameter.name == current[0]) == false:
                            imported: (known: bool, value: i64) = proof_qualified_constant_value(constant_type, initializer)
                            mentioned: mutable bool = false
                            for contract in contracts |current, constant_name, mentioned|:
                                mentioned <- true if proof_qualified_constant_mentioned(contract, current, constant_name, 0)
                            mentioned <- true if proof_qualified_body_mentioned(function_body, current, constant_name, 0) and not proof_qualified_body_declares(function_body, current[0], 0)
                            counted_from: mutable darray[sview] = []
                            declared_once: bool = proof_qualified_constant_declared_count(file.top_decls, current, constant_name, &counted_from, 0) == 1
                            unshadowed: bool = not nested_function or not proof_qualified_nested_namespace(file.top_decls, current[0], false, 0)
                            if imported.known and mentioned and declared_once and unshadowed:
                                term: Ast::Expr = proof_qualified_constant_term(current, constant_name, position)
                                fact: Ast::Expr = Ast::Expr.Binary(term, TokenKind.EqEq, Ast::Expr.IntLit(imported.value, position), position)
                                proof_add_traced_fact(facts, report, fact, "global-constant", position.line, function_name)
                                proof_add_scalar_type_witness(facts, report, proof_scalar_term_marker(term, position), position.line, function_name)
                                # A negative value is substituted as `-magnitude`, the shape the arithmetic tiers read.
                                literal: Ast::Expr = Ast::Expr.IntLit(imported.value, position) if imported.value >= 0 else Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(0 - imported.value, position), position)
                                # Element-wise: the rewritten statements live in this call's region.
                                rewritten_body: darray[Ast::Stmt] = proof_qualified_body_rewrite(function_body, current, constant_name, literal, 0)
                                for body_index in 0..<rewritten_body.count |body_index, function_body, rewritten_body|:
                                    function_body[body_index] <- rewritten_body[body_index] if body_index < function_body.count
                                for contract_index in 0..<contracts.count |contract_index, contracts, current, constant_name, literal|:
                                    contracts[contract_index] <- proof_qualified_constant_rewrite(contracts[contract_index], current, constant_name, literal, 0)
                    Ast::Decl.Module(module_name, body, _):
                        next_scope: mutable darray[sview] = []
                        next_scope.extend(current)
                        next_scope.push(module_name)
                        proof_qualified_constants_collect(file, body, &next_scope, contracts, function_body, parameters, facts, report, function_name, nested_function, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_qualified_constants_collect(file, body, current, contracts, function_body, parameters, facts, report, function_name, nested_function, depth + 1)
                    _:
                        pass

        # A function, identified by name and declaration line, resolves its qualified paths from the root. One inside a module
        # does so only for a first segment no nested module, enum or struct could shadow.
        # The requires of every function this body calls, read only to decide which constants
        # to import: a call site must discharge `fade <= Fade::FULL` although the caller never
        # spells the path. A repeated bare name contributes every row so named; importing the
        # value of a constant the body does not need is harmless, since the fact is true.
        def proof_qualified_callee_requires(functions: ProofFunctionTable&, function_index: usize, contracts: mutable darray[Ast::Expr]&) -> void:
            return if function_index >= functions.call_starts.count or function_index >= functions.call_counts.count
            call_start: usize = functions.call_starts[function_index]
            call_count: usize = functions.call_counts[function_index]
            return if call_start > functions.all_calls.count or call_count > functions.all_calls.count - call_start
            for offset in 0..<call_count |offset, functions, call_start, contracts|:
                called: sview = functions.all_calls[call_start + offset]
                direct: usize = proof_function_index(functions, called)
                continue if direct >= functions.names.count and not proof_function_name_may_repeat(functions, called)
                first: usize = direct if direct < functions.names.count else 0
                last: usize = direct + 1 if direct < functions.names.count else functions.names.count
                for callee in first..<last |callee, functions, called, contracts|:
                    continue if functions.names[callee] != called or callee >= functions.requires_starts.count or callee >= functions.requires_counts.count
                    requires_start: usize = functions.requires_starts[callee]
                    requires_count: usize = functions.requires_counts[callee]
                    continue if requires_start > functions.all_requires.count or requires_count > functions.all_requires.count - requires_start
                    for requirement in 0..<requires_count |requirement, functions, requires_start, contracts|:
                        contracts.push(functions.all_requires[requires_start + requirement])

        # The requires and ensures row ranges of one table entry, empty when out of range.
        def proof_qualified_own_rows(functions: ProofFunctionTable&, function_index: usize) -> (requires_start: usize, requires_count: usize, ensures_start: usize, ensures_count: usize):
            requires_start: mutable usize = 0
            requires_count: mutable usize = 0
            ensures_start: mutable usize = 0
            ensures_count: mutable usize = 0
            if function_index < functions.requires_starts.count and function_index < functions.requires_counts.count:
                start: usize = functions.requires_starts[function_index]
                count: usize = functions.requires_counts[function_index]
                if start <= functions.all_requires.count and count <= functions.all_requires.count - start:
                    requires_start <- start
                    requires_count <- count
            if function_index < functions.ensure_starts.count and function_index < functions.ensure_counts.count:
                start: usize = functions.ensure_starts[function_index]
                count: usize = functions.ensure_counts[function_index]
                if start <= functions.all_ensures.count and count <= functions.all_ensures.count - start:
                    ensures_start <- start
                    ensures_count <- count
            return (requires_start, requires_count, ensures_start, ensures_count)

        def proof_import_qualified_constant_facts(file: Ast::File&, function_name: sview, parameters: darray[Ast::ParamDecl]&, preconditions: mutable darray[Ast::Expr]&, postconditions: mutable darray[Ast::Expr]&, function_body: mutable darray[Ast::Stmt]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, position: Ast::Pos, functions: mutable ProofFunctionTable&, function_index: usize) -> void:
            proof_qualify_repeated_calls(functions, function_index, parameters, preconditions, postconditions, function_body)
            function_scope: mutable darray[sview] = []
            root_scope: mutable darray[sview] = []
            name_matches: mutable usize = 0
            matches: mutable usize = 0
            proof_global_constant_find_function_scope(file.top_decls, function_name, position.line, &root_scope, &function_scope, &name_matches, &matches, 0)
            return if matches != 1
            report.trace_owner_line <- position.line
            contracts: mutable darray[Ast::Expr] = []
            contracts.extend(preconditions)
            contracts.extend(postconditions)
            proof_qualified_callee_requires(functions, function_index, &contracts)
            # This function's own table rows are the call-summary source its callers read.
            # Rewriting them with the same literals freezes a qualified constant there, as
            # `proof_resolve_global_constants_in_contracts` does for an unqualified one, so a
            # caller meets `x <= 10000000` rather than an untyped path `x <= Fade::MAX_FRAMES`.
            row_ranges: (requires_start: usize, requires_count: usize, ensures_start: usize, ensures_count: usize) = proof_qualified_own_rows(functions, function_index)
            rows_at: usize = contracts.count
            for row in 0..<row_ranges.requires_count |row, contracts, functions, row_ranges|:
                contracts.push(functions.all_requires[row_ranges.requires_start + row])
            for row in 0..<row_ranges.ensures_count |row, contracts, functions, row_ranges|:
                contracts.push(functions.all_ensures[row_ranges.ensures_start + row])
            proof_qualified_constants_collect(file, file.top_decls, &root_scope, &contracts, function_body, parameters, facts, report, function_name, function_scope.count > 0, 0)
            report.trace_owner_line <- 0
            for row in 0..<row_ranges.requires_count |row, contracts, functions, row_ranges, rows_at|:
                functions.all_requires[row_ranges.requires_start + row] <- contracts[rows_at + row]
            for row in 0..<row_ranges.ensures_count |row, contracts, functions, row_ranges, rows_at|:
                functions.all_ensures[row_ranges.ensures_start + row] <- contracts[rows_at + row_ranges.requires_count + row]
            for index in 0..<preconditions.count |index, preconditions, contracts|:
                preconditions[index] <- contracts[index]
            for index in 0..<postconditions.count |index, postconditions, contracts, preconditions|:
                postconditions[index] <- contracts[preconditions.count + index]
