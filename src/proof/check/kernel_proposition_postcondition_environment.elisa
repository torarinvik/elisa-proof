# Bounded source-derived type context for replaying direct body postconditions.
extend ElisaProof:
    private:
        struct ProofSourceKernelPostconditionModuleScope:
            path: darray[sview]
            constant_names: mutable darray[sview]
            constant_types: mutable darray[sview]
            constant_source_types: mutable darray[Ast::Expr]

        struct ProofSourceKernelPostconditionOwnerContext:
            name: sview
            line: u32
            offset: usize
            parameters: darray[Ast::ParamDecl]
            return_type: Ast::Expr?
            module_path: darray[sview]
            module_scope_index: usize
            same_line_functions: usize
            generic_metadata_ambiguous: bool

        struct ProofSourceKernelPostconditionLineSummary:
            line: u32
            function_count: usize
            generic_row_count: usize

        # This value is scoped to one source-analysis invocation. Its AST-backed slices and
        # expressions must never be retained in a process-global or report-owned cache.
        struct ProofSourceKernelPostconditionContextIndex:
            owners: mutable darray[ProofSourceKernelPostconditionOwnerContext]
            owner_index_hashes: mutable darray[u32]
            owner_index_values: mutable darray[usize]
            module_scopes: mutable darray[ProofSourceKernelPostconditionModuleScope]
            module_scope_index_hashes: mutable darray[u32]
            module_scope_index_values: mutable darray[usize]
            line_summaries: mutable darray[ProofSourceKernelPostconditionLineSummary]
            line_index_hashes: mutable darray[u32]
            line_index_values: mutable darray[usize]
            complete: bool

        def proof_source_kernel_postcondition_owner_key_hash(name: sview, line: u32, offset: usize, source_work: mutable usize&) -> (complete: bool, hash: u32):
            return (false, 0) if not proof_source_kernel_charge_work(sview_len(name), source_work)
            return (false, 0) if not proof_source_kernel_charge_work(2, source_work)
            hash: u32 = proof_expr_shape_mix(proof_name_hash(name), line.i64())
            hash <- proof_expr_shape_mix(hash, offset.i64())
            return (true, hash)

        def proof_source_kernel_postcondition_owner_index_slot(index: ProofSourceKernelPostconditionContextIndex&, name: sview, line: u32, offset: usize, wanted_hash: u32, source_work: mutable usize&) -> (complete: bool, found: bool, slot: usize, row: usize):
            missing: usize = index.owners.count
            capacity: usize = index.owner_index_values.count
            return (false, false, 0, missing) if:
                capacity == 0 or capacity != index.owner_index_hashes.count
                index.owner_index_values.count != capacity
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, name, line, offset, wanted_hash, index, capacity, source_work, missing|:
                return (false, false, 0, missing) if not proof_source_kernel_charge_work(1, source_work)
                value: usize = index.owner_index_values[slot]
                return (true, false, slot, missing) if value == 0
                return (false, false, 0, missing) if value > index.owners.count
                row: usize = value - 1
                if index.owner_index_hashes[slot] == wanted_hash:
                    return (false, false, 0, missing) if not proof_source_kernel_charge_work(sview_len(index.owners[row].name) + sview_len(name) + 2, source_work)
                    return (true, true, slot, row) if index.owners[row].line == line and index.owners[row].offset == offset and index.owners[row].name == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, 0, missing)

        def proof_source_kernel_postcondition_line_index_slot(index: ProofSourceKernelPostconditionContextIndex&, line: u32, source_work: mutable usize&) -> (complete: bool, found: bool, slot: usize, row: usize):
            missing: usize = index.line_summaries.count
            capacity: usize = index.line_index_values.count
            return (false, false, 0, missing) if:
                capacity == 0 or capacity != index.line_index_hashes.count
                index.line_index_values.count != capacity
            wanted_hash: u32 = proof_expr_shape_mix(0, line.i64())
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, line, wanted_hash, index, capacity, source_work, missing|:
                return (false, false, 0, missing) if not proof_source_kernel_charge_work(1, source_work)
                value: usize = index.line_index_values[slot]
                return (true, false, slot, missing) if value == 0
                return (false, false, 0, missing) if value > index.line_summaries.count
                row: usize = value - 1
                if index.line_index_hashes[slot] == wanted_hash and index.line_summaries[row].line == line:
                    return (true, true, slot, row)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, 0, missing)

        def proof_source_kernel_postcondition_module_scope_hash(path: darray[sview]&, source_work: mutable usize&) -> (complete: bool, hash: u32):
            hash: mutable u32 = 0
            for segment in path |segment, hash, source_work|:
                return (false, 0) if not proof_source_kernel_charge_work(1 + sview_len(segment), source_work)
                hash <- proof_expr_shape_mix(hash, proof_name_hash(segment).i64())
            return (true, hash)

        # Qualified nested module names replace the current path outright. Bare names are
        # relative and cause `proof_global_constant_scope_with_module` to extend a copy of it.
        def proof_source_kernel_postcondition_module_name_is_qualified(module_name: sview) -> bool:
            length: usize = sview_len(module_name)
            for index in 0..<length:
                return true if sview_at(module_name, index) == 58 and index + 1 < length and sview_at(module_name, index + 1) == 58
            false

        def proof_source_kernel_postcondition_module_scope_index_slot(index: ProofSourceKernelPostconditionContextIndex&, path: darray[sview]&, wanted_hash: u32, source_work: mutable usize&) -> (complete: bool, found: bool, slot: usize, row: usize):
            missing: usize = index.module_scopes.count
            capacity: usize = index.module_scope_index_values.count
            return (false, false, 0, missing) if:
                capacity == 0 or capacity != index.module_scope_index_hashes.count
                index.module_scope_index_values.count != capacity
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, path, wanted_hash, index, capacity, source_work, missing|:
                return (false, false, 0, missing) if not proof_source_kernel_charge_work(1, source_work)
                value: usize = index.module_scope_index_values[slot]
                return (true, false, slot, missing) if value == 0
                return (false, false, 0, missing) if value > index.module_scopes.count
                row: usize = value - 1
                if index.module_scope_index_hashes[slot] == wanted_hash:
                    # Compare the path in place. Copying the full path_scope row here would also
                    # copy its accumulated constant arrays on every repeated module lookup.
                    if proof_source_kernel_type_path_equal(index.module_scopes[row].path, path, source_work):
                        return (true, true, slot, row)
                    return (false, false, 0, missing) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, 0, missing)

        def proof_source_kernel_postcondition_module_scope_add(index: mutable ProofSourceKernelPostconditionContextIndex&, path: darray[sview]&, wanted_hash: u32, source_work: mutable usize&) -> (complete: bool, row: usize):
            slot_result: (complete: bool, found: bool, slot: usize, row: usize) = proof_source_kernel_postcondition_module_scope_index_slot(index, path, wanted_hash, &source_work)
            return (false, 0) if not slot_result.complete
            return (true, slot_result.row) if slot_result.found
            return (false, 0) if index.module_scopes.count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
            return (false, 0) if not proof_source_kernel_charge_work(1, source_work)
            return (false, 0) if not proof_source_kernel_charge_work(path.count, source_work)
            copied_path: mutable darray[sview] = []
            for segment in path |segment, source_work|:
                return (false, 0) if not proof_source_kernel_charge_work(sview_len(segment), source_work)
                copied_path.push(segment)
            row: usize = index.module_scopes.count
            index.module_scopes.push(ProofSourceKernelPostconditionModuleScope{path: copied_path, constant_names: [], constant_types: [], constant_source_types: []})
            index.module_scope_index_hashes[slot_result.slot] <- wanted_hash
            index.module_scope_index_values[slot_result.slot] <- row + 1
            return (true, row)

        def proof_source_kernel_postcondition_owner_contexts_collect(declarations: darray[Ast::Decl]&, index: mutable ProofSourceKernelPostconditionContextIndex&, module_path: mutable darray[sview]&, module_path_hash: u32, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT
            for declaration in declarations |index, module_path, module_path_hash, source_work, depth|:
                return false if not proof_source_kernel_charge_work(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, function_parameters, function_return_type, _, _, _, position):
                        return false if:
                            index.owners.count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                            function_parameters.count > PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                        key: (complete: bool, hash: u32) = proof_source_kernel_postcondition_owner_key_hash(name, position.line, position.offset.usize(), source_work)
                        return false if not key.complete
                        owner_slot: (complete: bool, found: bool, slot: usize, row: usize) = proof_source_kernel_postcondition_owner_index_slot(index, name, position.line, position.offset.usize(), key.hash, &source_work)
                        return false if not owner_slot.complete or owner_slot.found
                        line_slot: (complete: bool, found: bool, slot: usize, row: usize) = proof_source_kernel_postcondition_line_index_slot(index, position.line, &source_work)
                        return false if not line_slot.complete
                        if line_slot.found:
                            index.line_summaries[line_slot.row].function_count <- index.line_summaries[line_slot.row].function_count + 1
                        else:
                            index.line_summaries.push(ProofSourceKernelPostconditionLineSummary{line: position.line, function_count: 1, generic_row_count: 0})
                            index.line_index_hashes[line_slot.slot] <- proof_expr_shape_mix(0, position.line.i64())
                            index.line_index_values[line_slot.slot] <- index.line_summaries.count
                        parameters: mutable darray[Ast::ParamDecl] = []
                        return false if not proof_source_kernel_charge_work(function_parameters.count, source_work)
                        parameters.extend(function_parameters)
                        return false if not proof_source_kernel_charge_work(module_path.count, source_work)
                        copied_module_path: mutable darray[sview] = []
                        for segment in module_path |segment, source_work|:
                            return false if not proof_source_kernel_charge_work(sview_len(segment), source_work)
                            copied_module_path.push(segment)
                        module_scope_index: usize = PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                        if module_path.count != 0:
                            scope_hash: u32 = module_path_hash
                            path_scope: (complete: bool, row: usize) = proof_source_kernel_postcondition_module_scope_add(index, module_path, scope_hash, &source_work)
                            return false if not path_scope.complete
                            module_scope_index <- path_scope.row
                        index.owners.push(ProofSourceKernelPostconditionOwnerContext{name: name, line: position.line, offset: position.offset.usize(), parameters: parameters, return_type: function_return_type, module_path: copied_module_path, module_scope_index: module_scope_index, same_line_functions: 0, generic_metadata_ambiguous: false})
                        index.owner_index_hashes[owner_slot.slot] <- key.hash
                        index.owner_index_values[owner_slot.slot] <- index.owners.count
                    Ast::Decl.Module(module_name, nested, _):
                        return false if not proof_source_kernel_charge_work(1 + sview_len(module_name), source_work)
                        # Qualification inspection is a separate scan from path_scope construction.
                        return false if not proof_source_kernel_charge_work(sview_len(module_name), source_work)
                        qualified: bool = proof_source_kernel_postcondition_module_name_is_qualified(module_name)
                        # Relative names copy the current path with `result.extend(current)`;
                        # qualified names replace it and need no parent-path element debit.
                        # Reserve a second parent/name-width pass for possible geometric buffer
                        # growth while extending the newly built path.
                        return false if not qualified and not proof_source_kernel_charge_work(module_path.count, source_work)
                        return false if not qualified and not proof_source_kernel_charge_work(module_path.count, source_work)
                        return false if not qualified and not proof_source_kernel_charge_work(sview_len(module_name), source_work)
                        parent_path: darray[sview] = module_path
                        module_path <- proof_global_constant_scope_with_module(module_path, module_name)
                        nested_hash: (complete: bool, hash: u32) = proof_source_kernel_postcondition_module_scope_hash(module_path, source_work)
                        return false if not nested_hash.complete
                        complete: bool = proof_source_kernel_postcondition_owner_contexts_collect(nested, index, module_path, nested_hash.hash, source_work, depth + 1)
                        module_path <- parent_path
                        return false if not complete
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_source_kernel_postcondition_owner_contexts_collect(nested, index, module_path, module_path_hash, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_source_kernel_postcondition_constants_collect(declarations: darray[Ast::Decl]&, index: mutable ProofSourceKernelPostconditionContextIndex&, module_path: mutable darray[sview]&, module_path_hash: u32, module_scope_index: usize, source_work: mutable usize&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT
            for declaration in declarations |index, module_path, module_path_hash, module_scope_index, source_work, depth|:
                return false if not proof_source_kernel_charge_work(1, source_work)
                match declaration:
                    Ast::Decl.Const(constant_name, constant_type, _, _, _):
                        if module_scope_index < index.module_scopes.count:
                            has_type: bool = match constant_type:
                                Ast::Expr.Absent: false
                                _: true
                            if has_type:
                                return false if index.module_scopes[module_scope_index].constant_names.count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                                # The type-spelling projection below performs a second recursive
                                # walk after the cost walk; reserve both passes before projecting.
                                return false if not proof_replay_summary_expr_repeat_charge_with_limit(constant_type, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                type_name: sview = proof_source_type_spelling(constant_type, 0)
                                return false if not proof_source_kernel_charge_work(sview_len(constant_name), source_work)
                                return false if not proof_source_kernel_charge_work(sview_len(type_name), source_work)
                                index.module_scopes[module_scope_index].constant_names.push(constant_name)
                                index.module_scopes[module_scope_index].constant_types.push(type_name)
                                index.module_scopes[module_scope_index].constant_source_types.push(constant_type)
                    Ast::Decl.Module(module_name, nested, _):
                        return false if not proof_source_kernel_charge_work(1 + sview_len(module_name), source_work)
                        return false if not proof_source_kernel_charge_work(sview_len(module_name), source_work)
                        qualified: bool = proof_source_kernel_postcondition_module_name_is_qualified(module_name)
                        return false if not qualified and not proof_source_kernel_charge_work(module_path.count, source_work)
                        return false if not qualified and not proof_source_kernel_charge_work(module_path.count, source_work)
                        return false if not qualified and not proof_source_kernel_charge_work(sview_len(module_name), source_work)
                        parent_path: darray[sview] = module_path
                        module_path <- proof_global_constant_scope_with_module(module_path, module_name)
                        nested_hash: (complete: bool, hash: u32) = proof_source_kernel_postcondition_module_scope_hash(module_path, source_work)
                        return false if not nested_hash.complete
                        scope_slot: (complete: bool, found: bool, slot: usize, row: usize) = proof_source_kernel_postcondition_module_scope_index_slot(index, module_path, nested_hash.hash, &source_work)
                        return false if not scope_slot.complete
                        nested_scope: usize = scope_slot.row if scope_slot.found else PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                        complete: bool = proof_source_kernel_postcondition_constants_collect(nested, index, module_path, nested_hash.hash, nested_scope, source_work, depth + 1)
                        module_path <- parent_path
                        return false if not complete
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_source_kernel_postcondition_constants_collect(nested, index, module_path, module_path_hash, module_scope_index, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_source_kernel_postcondition_context_index_build(declarations: darray[Ast::Decl]&, generic_param_lines: darray[u32]&, generic_param_names: darray[sview]&, generic_params_valid: bool, source_work: mutable usize&) -> (complete: bool, index: ProofSourceKernelPostconditionContextIndex) can[Memory.Allocate, Abort.Panic]:
            empty: ProofSourceKernelPostconditionContextIndex = ProofSourceKernelPostconditionContextIndex{owners: [], owner_index_hashes: [], owner_index_values: [], module_scopes: [], module_scope_index_hashes: [], module_scope_index_values: [], line_summaries: [], line_index_hashes: [], line_index_values: [], complete: false}
            return (false, empty) if not generic_params_valid or generic_param_lines.count != generic_param_names.count
            capacity: usize = proof_name_index_capacity(PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT)
            return (false, empty) if capacity == 0
            return (false, empty) if not proof_source_kernel_charge_work(capacity * 6, source_work)
            return (false, empty) if not proof_source_kernel_charge_work(capacity, source_work) or not proof_source_kernel_charge_work(capacity, source_work) or not proof_source_kernel_charge_work(capacity, source_work)
            index: mutable ProofSourceKernelPostconditionContextIndex = empty
            index.owner_index_hashes.resize(capacity)
            index.owner_index_values.resize(capacity)
            index.module_scope_index_hashes.resize(capacity)
            index.module_scope_index_values.resize(capacity)
            index.line_index_hashes.resize(capacity)
            index.line_index_values.resize(capacity)
            for slot in 0..<capacity |slot, index|:
                index.owner_index_values[slot] <- 0
                index.module_scope_index_values[slot] <- 0
                index.line_index_values[slot] <- 0
            module_path: mutable darray[sview] = []
            return (false, empty) if not proof_source_kernel_postcondition_owner_contexts_collect(declarations, &index, &module_path, 0, &source_work, 0)
            if index.owners.count == 0:
                index.complete <- source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (index.complete, index)
            for generic_index in 0..<generic_param_lines.count |generic_index, generic_param_lines, generic_param_names, index, source_work|:
                return (false, empty) if not proof_source_kernel_charge_work(1, source_work)
                line_slot: (complete: bool, found: bool, slot: usize, row: usize) = proof_source_kernel_postcondition_line_index_slot(index, generic_param_lines[generic_index], &source_work)
                return (false, empty) if not line_slot.complete
                if line_slot.found:
                    return (false, empty) if not proof_source_kernel_charge_work(sview_len(generic_param_names[generic_index]), source_work)
                    index.line_summaries[line_slot.row].generic_row_count <- index.line_summaries[line_slot.row].generic_row_count + 1
            for owner_index in 0..<index.owners.count |owner_index, index, source_work|:
                return (false, empty) if not proof_source_kernel_charge_work(1, source_work)
                line_slot: (complete: bool, found: bool, slot: usize, row: usize) = proof_source_kernel_postcondition_line_index_slot(index, index.owners[owner_index].line, &source_work)
                return (false, empty) if not line_slot.complete or not line_slot.found
                summary: ProofSourceKernelPostconditionLineSummary = index.line_summaries[line_slot.row]
                index.owners[owner_index].same_line_functions <- summary.function_count
                index.owners[owner_index].generic_metadata_ambiguous <- summary.generic_row_count != 0 and summary.function_count != 1
            return (false, empty) if index.module_scopes.count != 0 and not proof_source_kernel_postcondition_constants_collect(declarations, &index, &module_path, 0, PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT, &source_work, 0)
            index.complete <- source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (index.complete, index)

        def proof_source_kernel_postcondition_environment_from_index(index: ProofSourceKernelPostconditionContextIndex&, owner_name: sview, owner_line: u32, owner_offset: usize, declarations: darray[Ast::Decl]&, type_index: ProofSourceKernelTypeIndex, tuple_label_index: ProofSourceKernelTupleLabelIndex, generic_param_index: ProofSourceKernelGenericParamIndex, global_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], generic_param_lines: darray[u32]&, generic_param_names: darray[sview]&, generic_params_valid: bool, source_work: mutable usize&, scoped_function_index: mutable ProofSourceKernelScopedFunctionIndex&) -> (known: bool, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) can[Memory.Allocate, Abort.Panic]:
            empty: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: global_bindings, bindings: []}
            return (false, empty) if:
                not index.complete or not generic_params_valid or generic_param_lines.count != generic_param_names.count
                index.owner_index_hashes.count != index.owner_index_values.count
            key: (complete: bool, hash: u32) = proof_source_kernel_postcondition_owner_key_hash(owner_name, owner_line, owner_offset, source_work)
            return (false, empty) if not key.complete
            owner_slot: (complete: bool, found: bool, slot: usize, row: usize) = proof_source_kernel_postcondition_owner_index_slot(index, owner_name, owner_line, owner_offset, key.hash, &source_work)
            return (false, empty) if not owner_slot.complete or not owner_slot.found
            owner_row: usize = owner_slot.row
            return (false, empty) if index.owners[owner_row].generic_metadata_ambiguous
            names: mutable darray[sview] = []
            types: mutable darray[sview] = []
            source_types: mutable darray[Ast::Expr] = []
            module_scope_row: usize = index.owners[owner_row].module_scope_index
            if module_scope_row != PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT:
                return (false, empty) if module_scope_row >= index.module_scopes.count
                return (false, empty) if index.module_scopes[module_scope_row].constant_names.count != index.module_scopes[module_scope_row].constant_types.count or index.module_scopes[module_scope_row].constant_names.count != index.module_scopes[module_scope_row].constant_source_types.count
                for constant_index in 0..<index.module_scopes[module_scope_row].constant_names.count |constant_index, index, module_scope_row, names, types, source_types, source_work|:
                    return (false, empty) if names.count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                    return (false, empty) if not proof_source_kernel_charge_work(1 + sview_len(index.module_scopes[module_scope_row].constant_names[constant_index]) + sview_len(index.module_scopes[module_scope_row].constant_types[constant_index]), source_work)
                    names.push(index.module_scopes[module_scope_row].constant_names[constant_index])
                    types.push(index.module_scopes[module_scope_row].constant_types[constant_index])
                    source_types.push(index.module_scopes[module_scope_row].constant_source_types[constant_index])
            for parameter in index.owners[owner_row].parameters |parameter, index, owner_row, names, types, source_types, source_work|:
                return (false, empty) if names.count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                # Charge both AST cost measurement and the recursive type-spelling projection.
                return (false, empty) if not proof_replay_summary_expr_repeat_charge_with_limit(parameter.type_expression, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                parameter_type_name: sview = proof_source_type_spelling(parameter.type_expression, 0)
                return (false, empty) if:
                    not proof_source_kernel_charge_work(sview_len(parameter.name), source_work)
                    not proof_source_kernel_charge_work(sview_len(parameter_type_name), source_work)
                    index.owners[owner_row].return_type is declared_return_type and parameter.name == "result"
                names.push(parameter.name)
                types.push(parameter_type_name)
                source_types.push(parameter.type_expression)
            if index.owners[owner_row].return_type is declared_return_type:
                return (false, empty) if names.count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                return (false, empty) if not proof_replay_summary_expr_repeat_charge_with_limit(declared_return_type, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                result_type_name: sview = proof_source_type_spelling(declared_return_type, 0)
                return (false, empty) if not proof_source_kernel_charge_work(sview_len("result") + sview_len(result_type_name), source_work)
                names.push("result")
                types.push(result_type_name)
                source_types.push(declared_return_type)
            workspace: mutable ProofSourceKernelFormationWorkspace = ProofSourceKernelFormationWorkspace{nodes: [], children: [], visible_name_slots: [], type_index: type_index, generic_param_index: generic_param_index, owner_declaration_line: index.owners[owner_row].line, owner_declaration_offset: index.owners[owner_row].offset, owner_context_epoch: 0, tuple_label_index: tuple_label_index, validation_workspace: ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new(), typing_workspace: ElisaProofKernelReplay::proof_kernel_replay_typing_workspace_new(), scoped_function_index: proof_source_kernel_scoped_function_index_new(), typing_work_used: 0, source_work_used: source_work, source_work_exhaustion_reported: false}
            formed: (known: bool, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) = proof_source_kernel_type_environment(names, types, source_types, index.owners[owner_row].module_path, global_bindings, &workspace, declarations, scoped_function_index)
            source_work <- workspace.source_work_used
            return (formed.known and source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, formed.environment)

        # Compatibility one-shot wrapper. Repeated replay should build once and use the index API.
        def proof_source_kernel_postcondition_environment(owner_name: sview, owner_line: u32, owner_offset: usize, declarations: darray[Ast::Decl]&, type_index: ProofSourceKernelTypeIndex, tuple_label_index: ProofSourceKernelTupleLabelIndex, global_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], generic_param_lines: darray[u32]&, generic_param_names: darray[sview]&, generic_params_valid: bool, source_work: mutable usize&) -> (known: bool, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) can[Memory.Allocate, Abort.Panic]:
            index_result: (complete: bool, index: ProofSourceKernelPostconditionContextIndex) = proof_source_kernel_postcondition_context_index_build(declarations, generic_param_lines, generic_param_names, generic_params_valid, &source_work)
            return (false, ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: global_bindings, bindings: []}) if not index_result.complete
            generic_param_index: ProofSourceKernelGenericParamIndex = proof_source_kernel_generic_param_index_build(generic_param_lines, generic_param_names, generic_params_valid, source_work)
            return (false, ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: global_bindings, bindings: []}) if not generic_param_index.valid
            scoped_function_index: mutable ProofSourceKernelScopedFunctionIndex = proof_source_kernel_scoped_function_index_new()
            proof_source_kernel_postcondition_environment_from_index(index_result.index, owner_name, owner_line, owner_offset, declarations, type_index, tuple_label_index, generic_param_index, global_bindings, generic_param_lines, generic_param_names, generic_params_valid, &source_work, &scoped_function_index)
