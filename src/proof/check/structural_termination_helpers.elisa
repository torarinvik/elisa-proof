# Shared structural-termination environment and name-index helpers.
extend ElisaProof:
    private:
        def proof_structural_source_work_exhaust(source_work: mutable usize&) -> bool:
            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            false

        def proof_structural_verified_member_publish(report: mutable ProofReport&, row: usize, name: sview, source_work: mutable usize&) -> bool:
            return false if row >= report.analysis_1.structural.verified_members.count
            return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(2, source_work)
            report.analysis_1.structural.verified_members[row] <- true
            report.analysis_1.structural.verified_names.push(name)
            true

        # Structural body/expression checking repeatedly copies and intersects these
        # environments. Reserve the quadratic upper bound before each AST visit so the
        # nested membership scans cannot escape the shared source-work ceiling.
        def proof_structural_environment_work_charge(parameters: darray[Ast::ParamDecl]&, destructurable: darray[sview]&, smaller: darray[ProofStructuralSmaller]&, source_work: mutable usize&, quadratic: bool) -> bool:
            limit: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return proof_structural_source_work_exhaust(source_work) if source_work >= limit
            return proof_structural_source_work_exhaust(source_work) if parameters.count > limit or destructurable.count > limit - parameters.count
            environment_count: mutable usize = parameters.count + destructurable.count
            return proof_structural_source_work_exhaust(source_work) if smaller.count > limit - environment_count
            environment_count <- environment_count + smaller.count
            environment_count <- 1 if environment_count == 0
            text_bytes: mutable usize = 0
            for parameter in parameters |text_bytes, limit, source_work|:
                parameter_bytes: usize = sview_len(parameter.name)
                return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(1, source_work)
                return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(parameter_bytes, source_work)
                return proof_structural_source_work_exhaust(source_work) if parameter_bytes > limit - text_bytes
                text_bytes <- text_bytes + parameter_bytes
            for candidate in destructurable |text_bytes, limit, source_work|:
                candidate_bytes: usize = sview_len(candidate)
                return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(1, source_work)
                return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(candidate_bytes, source_work)
                return proof_structural_source_work_exhaust(source_work) if candidate_bytes > limit - text_bytes
                text_bytes <- text_bytes + candidate_bytes
            for candidate in smaller |text_bytes, limit, source_work|:
                name_bytes: usize = sview_len(candidate.name)
                return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(1, source_work)
                return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(name_bytes, source_work)
                return proof_structural_source_work_exhaust(source_work) if name_bytes > limit - text_bytes
                text_bytes <- text_bytes + name_bytes
                subject_bytes: usize = sview_len(candidate.subject)
                return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(subject_bytes, source_work)
                return proof_structural_source_work_exhaust(source_work) if subject_bytes > limit - text_bytes
                text_bytes <- text_bytes + subject_bytes
            amount: mutable usize = environment_count
            remaining: mutable usize = limit - source_work
            return proof_structural_source_work_exhaust(source_work) if amount > remaining
            return proof_structural_source_work_exhaust(source_work) if text_bytes > remaining - amount
            amount <- amount + text_bytes
            if quadratic:
                remaining <- remaining - amount
                return proof_structural_source_work_exhaust(source_work) if environment_count > remaining / environment_count
                square: usize = environment_count * environment_count
                amount <- amount + square
                remaining <- remaining - square
                return proof_structural_source_work_exhaust(source_work) if text_bytes > remaining / environment_count
                amount <- amount + text_bytes * environment_count
            return true if proof_report_source_work_charge(amount, source_work)
            proof_structural_source_work_exhaust(source_work)

        def proof_structural_environment_metrics(destructurable: darray[sview]&, smaller: darray[ProofStructuralSmaller]&, source_work: mutable usize&) -> (complete: bool, destructurable_count: usize, smaller_count: usize, destructurable_name_bytes: usize, smaller_name_bytes: usize, smaller_subject_bytes: usize):
            limit: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if source_work >= limit or destructurable.count > limit or smaller.count > limit:
                proof_structural_source_work_exhaust(source_work)
                return (false, 0, 0, 0, 0, 0)
            destructurable_name_bytes: mutable usize = 0
            smaller_name_bytes: mutable usize = 0
            smaller_subject_bytes: mutable usize = 0
            for name in destructurable |destructurable_name_bytes, limit, source_work|:
                name_length: usize = sview_len(name)
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(name_length, source_work) or name_length > limit - destructurable_name_bytes:
                    proof_structural_source_work_exhaust(source_work)
                    return (false, 0, 0, 0, 0, 0)
                destructurable_name_bytes <- destructurable_name_bytes + name_length
            for candidate in smaller |smaller_name_bytes, smaller_subject_bytes, limit, source_work|:
                candidate_name_length: usize = sview_len(candidate.name)
                candidate_subject_length: usize = sview_len(candidate.subject)
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(candidate_name_length, source_work) or not proof_report_source_work_charge(candidate_subject_length, source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, 0, 0, 0, 0, 0)
                if candidate_name_length > limit - smaller_name_bytes or candidate_subject_length > limit - smaller_subject_bytes:
                    proof_structural_source_work_exhaust(source_work)
                    return (false, 0, 0, 0, 0, 0)
                smaller_name_bytes <- smaller_name_bytes + candidate_name_length
                smaller_subject_bytes <- smaller_subject_bytes + candidate_subject_length
            return (true, destructurable.count, smaller.count, destructurable_name_bytes, smaller_name_bytes, smaller_subject_bytes)

        def proof_structural_source_work_product_charge(left: usize, right: usize, source_work: mutable usize&) -> bool:
            return true if left == 0 or right == 0
            limit: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return proof_structural_source_work_exhaust(source_work) if source_work >= limit
            remaining: usize = limit - source_work
            return proof_structural_source_work_exhaust(source_work) if left > remaining / right
            return true if proof_report_source_work_charge(left * right, source_work)
            proof_structural_source_work_exhaust(source_work)

        # A join runs name intersection and provenance intersection over the left/right pair.
        # Reserve the category-specific cross products and compared bytes before either traversal.
        def proof_structural_environment_join_work_charge(left_destructurable: darray[sview]&, left_smaller: darray[ProofStructuralSmaller]&, right_destructurable: darray[sview]&, right_smaller: darray[ProofStructuralSmaller]&, source_work: mutable usize&) -> bool:
            left: (complete: bool, destructurable_count: usize, smaller_count: usize, destructurable_name_bytes: usize, smaller_name_bytes: usize, smaller_subject_bytes: usize) = proof_structural_environment_metrics(left_destructurable, left_smaller, source_work)
            return false if not left.complete
            right: (complete: bool, destructurable_count: usize, smaller_count: usize, destructurable_name_bytes: usize, smaller_name_bytes: usize, smaller_subject_bytes: usize) = proof_structural_environment_metrics(right_destructurable, right_smaller, source_work)
            return false if not right.complete
            limit: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return proof_structural_source_work_exhaust(source_work) if source_work >= limit
            if left.smaller_count > limit - left.destructurable_count:
                return proof_structural_source_work_exhaust(source_work)
            outer_count: usize = left.destructurable_count + left.smaller_count
            return proof_structural_source_work_exhaust(source_work) if outer_count > limit
            return proof_structural_source_work_exhaust(source_work) if not proof_report_source_work_charge(outer_count, source_work)
            return false if not proof_structural_source_work_product_charge(left.destructurable_count, right.destructurable_count, source_work)
            return false if not proof_structural_source_work_product_charge(left.smaller_count, right.smaller_count, source_work)
            return false if not proof_structural_source_work_product_charge(right.destructurable_count, left.destructurable_name_bytes, source_work)
            return false if not proof_structural_source_work_product_charge(left.destructurable_count, right.destructurable_name_bytes, source_work)
            return false if not proof_structural_source_work_product_charge(right.smaller_count, left.smaller_name_bytes, source_work)
            return false if not proof_structural_source_work_product_charge(left.smaller_count, right.smaller_name_bytes, source_work)
            return false if not proof_structural_source_work_product_charge(right.smaller_count, left.smaller_subject_bytes, source_work)
            return proof_structural_source_work_product_charge(left.smaller_count, right.smaller_subject_bytes, source_work)

        def proof_structural_name_in(names: darray[sview]&, wanted: sview) -> bool:
            return wanted != "" and (any candidate in names where candidate == wanted)

        # A value block may capture mutable loop state that is unrelated to the
        # structural subject. Such a capture does not affect termination evidence unless
        # it is itself one of the strict-subterm binders used by a recursive edge. Keep
        # the conservative rejection for captures that overlap those binders, but do not
        # let an accumulator or parser cursor hide an otherwise checked descent.
        def proof_structural_captures_overlap(captures: darray[sview]&, smaller: darray[ProofStructuralSmaller]&, source_work: mutable usize&) -> (complete: bool, overlaps: bool):
            for capture in captures |smaller, source_work|:
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(capture), source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, false)
                for candidate in smaller |capture, source_work|:
                    if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(capture), source_work) or not proof_report_source_work_charge(sview_len(candidate.name), source_work):
                        proof_structural_source_work_exhaust(source_work)
                        return (false, false)
                    return (true, true) if candidate.name == capture
            return (true, false)

        # Structural termination environments are name-based because the compiler AST does not
        # expose stable binding identities. Remove every outer fact shadowed by a nested binder;
        # retaining the spelling would let an unrelated local masquerade as a strict subterm.
        def proof_structural_without(source: darray[sview]&, blocked: darray[sview]&, source_work: mutable usize&) -> darray[sview]:
            result: mutable darray[sview] = []
            for candidate in source |result, blocked, source_work|:
                if not proof_report_source_work_charge(1, source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return []
                shadowed: mutable bool = false
                if candidate != "":
                    for blocked_name in blocked |candidate, result, shadowed, source_work|:
                        if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(candidate), source_work) or not proof_report_source_work_charge(sview_len(blocked_name), source_work):
                            proof_structural_source_work_exhaust(source_work)
                            return []
                        shadowed <- true if blocked_name == candidate
                        break if shadowed
                result.push(candidate) if not shadowed
            return result

        # After a branch or loop, a structural binding remains usable only if both the incoming
        # state and every normal path preserve it. Newly introduced arm/block locals are never
        # merged because they are outside the enclosing lexical scope.
        def proof_structural_intersect(left: darray[sview]&, right: darray[sview]&) -> darray[sview]:
            result: mutable darray[sview] = []
            for candidate in left |result, right|:
                result.push(candidate) if proof_structural_name_in(right, candidate)
            return result

        def proof_structural_smaller_without(source: darray[ProofStructuralSmaller]&, blocked: darray[sview]&, source_work: mutable usize&) -> darray[ProofStructuralSmaller]:
            result: mutable darray[ProofStructuralSmaller] = []
            for candidate in source |result, blocked, source_work|:
                if not proof_report_source_work_charge(1, source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return []
                shadowed: mutable bool = false
                if candidate.name != "":
                    for blocked_name in blocked |candidate, result, shadowed, source_work|:
                        if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(candidate.name), source_work) or not proof_report_source_work_charge(sview_len(blocked_name), source_work):
                            proof_structural_source_work_exhaust(source_work)
                            return []
                        shadowed <- true if blocked_name == candidate.name
                        break if shadowed
                result.push(candidate) if not shadowed
            return result

        # Branch joins retain a mapped subterm only when both paths preserve the same origin
        # subject. Matching names with different subjects would recreate the product-ranking bug
        # this provenance exists to prevent.
        def proof_structural_smaller_intersect(left: darray[ProofStructuralSmaller]&, right: darray[ProofStructuralSmaller]&) -> darray[ProofStructuralSmaller]:
            result: mutable darray[ProofStructuralSmaller] = []
            for candidate in left |result, right|:
                result.push(candidate) if any other in right where other.name == candidate.name and other.subject == candidate.subject and other.identity == candidate.identity and other.subject_identity == candidate.subject_identity
            return result

        def proof_structural_smaller_has_name_with_work(smaller: darray[ProofStructuralSmaller]&, wanted: sview, source_work: mutable usize&) -> (complete: bool, found: bool):
            for candidate in smaller |wanted, source_work|:
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(candidate.name), source_work) or not proof_report_source_work_charge(sview_len(wanted), source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, false)
                return (true, true) if candidate.name == wanted
            return (true, false)

        # A recursive AST walker often reaches a child through a compiler-owned side table:
        # `for argument in arguments: visit(argument)`. The loop variable is a strict subterm of
        # the matched enum value when the iterable itself is a matched subterm. Direct projections
        # from that element (for example `field.value`) are strict as well. The compiler has
        # already type-checked the recursive call; this helper recognizes only the structural
        # shape and never infers a type from a spelling.
        def proof_structural_argument_root_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, root: sview):
            if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or not proof_report_source_work_charge(1, source_work):
                proof_structural_source_work_exhaust(source_work)
                return (false, "")
            match expression:
                Ast::Expr.Ident(name, _):
                    return (true, name)
                Ast::Expr.Paren(inner, _):
                    return proof_structural_argument_root_with_work(inner, source_work, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_structural_argument_root_with_work(object, source_work, depth + 1)
                Ast::Expr.Index(object, _, _):
                    return proof_structural_argument_root_with_work(object, source_work, depth + 1)
                Ast::Expr.IndexN(object, _, _):
                    return proof_structural_argument_root_with_work(object, source_work, depth + 1)
                _:
                    return (true, "")

        # Strip a projection chain once, then collect all witness metadata in one metered scan.
        # A requested subject keeps equal binder names from distinct matches from aliasing.
        def proof_structural_argument_metadata(expression: Ast::Expr, smaller: darray[ProofStructuralSmaller]&, requested_subject: sview, source_work: mutable usize&) -> (complete: bool, root: sview, found: bool, subject: sview, identity: usize, subject_identity: usize):
            root_result: (complete: bool, root: sview) = proof_structural_argument_root_with_work(expression, source_work, 0)
            return (false, "", false, "", 0, 0) if not root_result.complete
            return (true, root_result.root, false, "", 0, 0) if root_result.root == ""
            for candidate in smaller |root_result, smaller, requested_subject, source_work|:
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(root_result.root), source_work) or not proof_report_source_work_charge(sview_len(candidate.name), source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, "", false, "", 0, 0)
                if requested_subject != "" and (not proof_report_source_work_charge(sview_len(requested_subject), source_work) or not proof_report_source_work_charge(sview_len(candidate.subject), source_work)):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, "", false, "", 0, 0)
                if candidate.name == root_result.root and (requested_subject == "" or candidate.subject == requested_subject):
                    return (true, root_result.root, true, candidate.subject, candidate.identity, candidate.subject_identity)
            return (true, root_result.root, false, "", 0, 0)

        def proof_structural_binding_identity_with_work(expression: Ast::Expr, smaller: darray[ProofStructuralSmaller]&, parameters: darray[Ast::ParamDecl]&, source_work: mutable usize&) -> (complete: bool, identity: usize):
            metadata: (complete: bool, root: sview, found: bool, subject: sview, identity: usize, subject_identity: usize) = proof_structural_argument_metadata(expression, smaller, "", source_work)
            return (false, 0) if not metadata.complete
            return (true, metadata.identity) if metadata.identity != 0
            return (true, 0) if metadata.root == ""
            return proof_structural_parameter_identity_with_work(parameters, metadata.root, source_work)

        def proof_structural_parameter_identity_with_work(parameters: darray[Ast::ParamDecl]&, wanted: sview, source_work: mutable usize&) -> (complete: bool, identity: usize):
            for index in 0..<parameters.count |index, parameters, wanted, source_work|:
                parameter_name: sview = parameters[index].name
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(parameter_name), source_work) or not proof_report_source_work_charge(sview_len(wanted), source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, 0)
                return (true, index + 1) if parameter_name == wanted and index + 1 < PROOF_STRUCTURAL_FRESH_ID_BASE
            return (true, 0)

        def proof_structural_call_argument(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, parameters: darray[Ast::ParamDecl]&, position: usize, source_work: mutable usize&) -> (complete: bool, argument: Ast::Expr):
            return (true, Ast::Expr.Invalid) if position >= parameters.count
            if argument_names.count == 0:
                if position < arguments.count:
                    return (true, arguments[position])
                return (true, Ast::Expr.Invalid)
            return (true, Ast::Expr.Invalid) if argument_names.count != arguments.count
            has_named: mutable bool = false
            has_positional: mutable bool = false
            matching_index: mutable usize = arguments.count
            matching_count: mutable usize = 0
            target_name: sview = parameters[position].name
            for argument_index in 0..<argument_names.count |argument_index, argument_names, target_name, has_named, has_positional, matching_index, matching_count, source_work|:
                label: sview = argument_names[argument_index]
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(label), source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, Ast::Expr.Invalid)
                if label == "":
                    has_positional <- true
                else:
                    has_named <- true
                    if not proof_report_source_work_charge(sview_len(target_name), source_work):
                        proof_structural_source_work_exhaust(source_work)
                        return (false, Ast::Expr.Invalid)
                    if label == target_name:
                        matching_index <- argument_index
                        matching_count <- matching_count + 1
            return (true, Ast::Expr.Invalid) if has_named and has_positional
            if not has_named:
                if position < arguments.count:
                    return (true, arguments[position])
                return (true, Ast::Expr.Invalid)
            return (true, arguments[matching_index]) if matching_count == 1 and matching_index < arguments.count
            return (true, Ast::Expr.Invalid)

        def proof_structural_call_has_named_argument(argument_names: darray[sview]&, source_work: mutable usize&) -> (complete: bool, has_named: bool):
            has_named: mutable bool = false
            for label in argument_names |label, has_named, source_work|:
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(label), source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, false)
                has_named <- true if label != ""
            return (true, has_named)

        def proof_parameter_position(parameters: darray[Ast::ParamDecl]&, wanted: sview, source_work: mutable usize&) -> (complete: bool, position: usize):
            for index in 0..<parameters.count |index, parameters, wanted, source_work|:
                parameter_name: sview = parameters[index].name
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(parameter_name), source_work) or not proof_report_source_work_charge(sview_len(wanted), source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, parameters.count)
                return (true, index) if parameter_name == wanted
            return (true, parameters.count)

        # The structural walker receives the currently live destructurable names. At the entry
        # of an inferred multi-subject function those names are exactly its enum parameters; a
        # shadowing declaration or pattern removes the name before any recursive edge is
        # inspected. Explicitly annotated single-subject functions do not use this helper.
        def proof_enum_parameter_names_from_parameters(parameters: darray[Ast::ParamDecl]&, destructurable: darray[sview]&, source_work: mutable usize&) -> (complete: bool, names: darray[sview]):
            result: mutable darray[sview] = []
            for parameter in parameters |result, destructurable, source_work|:
                if not proof_report_source_work_charge(1, source_work):
                    proof_structural_source_work_exhaust(source_work)
                    return (false, result)
                found: mutable bool = false
                for candidate in destructurable |parameter, source_work, found|:
                    if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(parameter.name), source_work) or not proof_report_source_work_charge(sview_len(candidate), source_work):
                        proof_structural_source_work_exhaust(source_work)
                        return (false, result)
                    found <- true if candidate == parameter.name
                result.push(parameter.name) if found
            return (true, result)

        # A local/formal with the same spelling as any source function can shadow a direct
        # callable leaf. The structural checker has no owner-aware local callable resolver, so
        # such functions fail closed instead of treating a callback as recursion.
        def proof_structural_report_same_component(report: ProofReport&, left: usize, right: usize) -> bool:
            return false if left >= report.analysis_1.structural.component_ids.count or right >= report.analysis_1.structural.component_ids.count
            return report.analysis_1.structural.component_ids[left] == report.analysis_1.structural.component_ids[right]

        def proof_structural_termination_finding(report: mutable ProofReport&, line: u32, name: sview, message: sview) -> void:
            report.proof_obligation(false)
            proof_add_finding(report, "structural-decreases-unproven", line, name, message)

        # Once a structural function has a termination finding, arithmetic fallback on the same
        # recursive edge only creates duplicate diagnostics. It is still rejected by the
        # recorded structural obligation; this helper merely keeps the report focused and does
        # not authorize the edge as a summary.
        def proof_structural_report_failed(report: ProofReport&, wanted: sview, work: mutable usize&) -> bool:
            for finding in report.results.findings |work|:
                return true if:
                    not proof_report_source_work_charge(1, work)
                    not proof_report_source_work_charge(sview_len(finding.kind), work)
                    not proof_report_source_work_charge(sview_len(finding.name), work)
                    not proof_report_source_work_charge(sview_len(wanted), work)
                return true if finding.kind == "structural-decreases-unproven" and finding.name == wanted
            return false

        # Check every recursive edge in one structural function with its lexical match
        # environment. The environment is copied for each arm, so a binder from one branch can
        # never justify a call in a sibling or after the match. Mutual structural edges use the
        # callee's own decreasing-parameter position, but still require the same enum subject
        # type and a binder from the caller's matched strict subterms.
