extend ElisaProof:
    private:
        def proof_source_kernel_projection_budget_refusal(report: mutable ProofReport&, name: sview, line: u32, kernel_workspace: mutable ProofSourceKernelFormationWorkspace&) -> void:
            kernel_workspace.source_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            if not kernel_workspace.source_work_exhaustion_reported:
                kernel_workspace.source_work_exhaustion_reported <- true
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", line, name, "kernel proposition source projection exceeded its validated work bound", "kernel-source-projection-work", kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_source_collect_scope_constants(declarations: darray[Ast::Decl]&, module_path: darray[sview]&, level: usize, names: mutable darray[sview]&, types: mutable darray[sview]&, source_types: mutable darray[Ast::Expr]&, source_work: mutable usize&, local_count: usize, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT
            for declaration in declarations |module_path, level, names, types, source_types, source_work, local_count, depth|:
                return false if not proof_source_kernel_charge_work(1, source_work)
                match declaration:
                    Ast::Decl.Const(constant_name, constant_type, _, _, _):
                        if level == module_path.count:
                            has_type: bool = match constant_type:
                                Ast::Expr.Absent: false
                                _: true
                            if has_type:
                                return false if names.count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                                return false if local_count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT - names.count
                                return false if not proof_replay_summary_expr_repeat_charge_with_limit(constant_type, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                type_name: sview = proof_source_type_spelling(constant_type, 0)
                                return false if not proof_source_kernel_charge_work(3 + sview_len(constant_name) + sview_len(type_name), source_work)
                                names.push(constant_name)
                                types.push(type_name)
                                source_types.push(constant_type)
                    Ast::Decl.Module(module_name, body, _):
                        return false if not proof_source_kernel_charge_work(sview_len(module_name), source_work)
                        if level < module_path.count and module_name == module_path[level]:
                            return false if not proof_source_collect_scope_constants(body, module_path, level + 1, names, types, source_types, source_work, local_count, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_source_collect_scope_constants(body, module_path, level, names, types, source_types, source_work, local_count, depth + 1)
                    _:
                        pass
            return true

        def proof_source_proposition_contracts_with_work(body: darray[Ast::Stmt]&, kind: sview, source_work: mutable usize&) -> (complete: bool, expressions: darray[Ast::Expr]) can[Memory.Allocate, Abort.Panic]:
            expressions: mutable darray[Ast::Expr] = []
            for statement in body |kind, expressions, source_work|:
                return (false, expressions) if not proof_source_kernel_charge_work(1, source_work)
                match statement:
                    Ast::Stmt.Contract(contract_kind, expression, _):
                        if contract_kind == kind or (kind == "ensure" and proof_is_ensure_kind(contract_kind)):
                            return (false, expressions) if not proof_source_kernel_charge_work(1, source_work)
                            expressions.push(expression)
                    _:
                        pass
            return (true, expressions)

        def proof_source_proposition_parameters_with_work(parameters: darray[Ast::ParamDecl]&, names: mutable darray[sview]&, types: mutable darray[sview]&, source_types: mutable darray[Ast::Expr]&, source_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            for parameter in parameters |parameter, names, types, source_types, source_work|:
                return false if names.count >= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
                return false if not proof_source_kernel_charge_work(3 + sview_len(parameter.name), source_work)
                return false if not proof_replay_summary_expr_repeat_charge_with_limit(parameter.type_expression, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                type_name: sview = proof_source_type_spelling(parameter.type_expression, 0)
                return false if not proof_source_kernel_charge_work(sview_len(type_name), source_work)
                names.push(parameter.name)
                types.push(type_name)
                source_types.push(parameter.type_expression)
            return true

        def proof_source_proposition_context_fits(existing_count: usize, added_count: usize) -> bool:
            return false if existing_count > PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT
            return added_count <= PROOF_SOURCE_KERNEL_CONTEXT_NAME_LIMIT - existing_count
