# Owner-aware witnesses for owner-neutral shorthand enum terms.
extend ElisaProof:
        # Keep root_declarations immutable through nested module walks: variant ambiguity is
        # global to the source tree, not local to the subtree containing the declared enum.
        def proof_add_const_enum_shorthand_witnesses(declarations: darray[Ast::Decl]&, root_declarations: darray[Ast::Decl]&, enum_owner: sview, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, line: u32, owner: sview, position: Ast::Pos, budget: mutable usize&, depth: usize, source_work: mutable usize&) -> void:
            return if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or budget == 0 or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for declaration in declarations |root_declarations, enum_owner, facts, report, line, owner, position, budget, depth, source_work|:
                return if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Enum(name, variants, is_const, _, _):
                        return if not proof_type_audit_work_charge(sview_len(name) + sview_len(enum_owner), source_work)
                        if name == enum_owner and is_const:
                            # The report lookup lazily builds one complete index for all enums.
                            # Total matches include non-const variants, which still collide.
                            for variant in variants |name, facts, report, line, owner, position, budget, root_declarations, source_work|:
                                return if budget == 0
                                return if not proof_type_audit_work_charge(1 + sview_len(variant.name), source_work)
                                budget <- budget - 1
                                resolution: (complete: bool, matches: usize, const_matches: usize, owner: sview, fieldless: bool) = proof_report_const_enum_member_collision_lookup_with_work(report, variant.name, source_work)
                                return if not resolution.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                continue if resolution.matches != 1 or resolution.const_matches != 1 or not resolution.fieldless or resolution.owner != name
                                shorthand: Ast::Expr = Ast::Expr.ShorthandMember([variant.name], position)
                                return if not proof_type_audit_work_charge(facts.count + report.type_bounds.seen.count + report.traces.records.count, source_work)
                                proof_add_scalar_type_witness(facts, report, proof_scalar_term_marker(shorthand, position), line, owner)
                                return if budget == 0
                    Ast::Decl.Module(_, body, _):
                        proof_add_const_enum_shorthand_witnesses(body, root_declarations, enum_owner, facts, report, line, owner, position, budget, depth + 1, source_work)
                    Ast::Decl.Scoped(body, _):
                        proof_add_const_enum_shorthand_witnesses(body, root_declarations, enum_owner, facts, report, line, owner, position, budget, depth + 1, source_work)
                    _:
                        pass
