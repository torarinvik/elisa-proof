extend ElisaProof:
    private:
        def proof_clear_facts_after_call(facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview) -> void can[Global.Read, Global.Write]:
            no_extra_aliases: darray[sview] = []
            proof_clear_facts_after_call_with_aliases(facts, names, parameters, report, owner, no_extra_aliases) can Global{Read,Write}

        def proof_clear_facts_after_call_with_aliases(facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview, extra_may_alias: darray[sview]&) -> void can[Global.Read, Global.Write]:
            proof_record_opaque_call_alias_roots(report, owner, extra_may_alias)
            analyzed: bool = report.aliases.aliased_owner == owner and owner != "" and not (any existing in report.aliases.aliased_names where existing == "*")
            call_aliases: mutable darray[sview] = []
            call_aliases.extend(report.aliases.aliased_names)
            for root in extra_may_alias |call_aliases|:
                proof_push_aliased(&call_aliases, root)
            source: darray[Ast::Expr] = proof_copy_exprs(facts)
            rebind_paths: mutable darray[Ast::Expr] = []
            rebind_values: mutable darray[Ast::Expr] = []
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for fact in source |rebind_paths, rebind_values, source, names, report, owner, source_work|:
                if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                binding: (complete: bool, known: bool, path: Ast::Expr, value: Ast::Expr) = proof_local_rebind_binding_with_work(report, fact, owner, names, &source_work)
                if not binding.complete:
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                if binding.known:
                    rebind_paths.push(binding.path)
                    rebind_values.push(binding.value)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            # A compiler rebind symbol can have a verified range summary while the source local
            # is represented separately by local == __elisa_rebind_N. Materialize the
            # equality-substituted summary through the ordinary proof-step path before applying
            # the call frame; downstream goals can then use the local directly, and replay
            # checks both the source facts and the equality. The later stability filter still
            # drops this fact whenever the call can reach that local.
            annotations: darray[Ast::EnumAnnotation] = []
            budget: mutable usize = PROOF_ALIAS_TRANSFER_BUDGET
            source_work <- report.source_types.source_effect_index.work.implicit_effect_work
            for fact in source |fact, source, rebind_paths, rebind_values, facts, report, owner, annotations, budget, source_work|:
                continue if budget == 0
                probe: mutable Ast::Expr = fact
                changed: mutable bool = false
                for path_index in 0..<rebind_paths.count |path_index, probe, changed, rebind_paths, rebind_values|:
                    if not proof_replay_summary_expr_repeat_charge_with_work(fact, 2, &source_work):
                        facts.clear()
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    replaced: (changed: bool, value: Ast::Expr) = proof_tactic_replace(probe, rebind_paths[path_index], rebind_values[path_index])
                    changed <- changed or replaced.changed
                    probe <- replaced.value if replaced.changed
                continue if not changed
                duplicate: mutable bool = false
                for existing in facts |existing, probe, duplicate, source_work, facts|:
                    if not proof_replay_summary_expr_repeat_charge_with_work(existing, 4, &source_work):
                        facts.clear()
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    duplicate <- true if proof_expr_equal(existing, probe)
                continue if duplicate
                if not proof_replay_summary_expr_repeat_charge_with_work(probe, 4, &source_work):
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                for premise in source |premise, probe, source_work, source|:
                    if not proof_replay_summary_expr_repeat_charge_with_work(premise, 4, &source_work):
                        facts.clear()
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                if not proof_replay_summary_expr_charge_with_limit(probe, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                continue if not (proof_goal(source, probe, annotations) can Global{Read,Write})
                budget <- budget - 1
                proof_add_derived_fact_from(facts, report, probe, source, "proof-step", Ast::expr_pos(fact).line, owner)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            original: darray[Ast::Expr] = proof_copy_exprs(facts)
            keep: mutable darray[bool] = []
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for fact in original |keep, original, names, parameters, report, owner, analyzed, rebind_paths, rebind_values, call_aliases, source_work|:
                bound_name: sview = proof_type_bound_name(fact)
                retained: mutable bool = false
                retained <- true if bound_name != "" and ((any candidate in names where candidate == bound_name) or (any parameter in parameters where parameter == bound_name)) and proof_fact_is_type_bound_with_work(report, fact, owner, &source_work)
                enum_witness: bool = proof_unique_builtin_const_enum_member_witness_with_work(fact, report, &source_work) if not retained
                retained <- true if not retained and enum_witness and proof_fact_is_type_bound_with_work(report, fact, owner, &source_work)
                retained <- true if not retained and proof_fact_is_global_mutable_array_type_fact_with_work(report, fact, owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                retained <- true if not retained and proof_fact_is_source_global_constant_with_work(report, fact, owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                stability: (complete: bool, stable: bool) = proof_expr_call_stable_with_work(fact, original, names, parameters, call_aliases, report.aliases.shared_extent_names, report.aliases.shared_fixed_names, report.aliases.local_extent_names, report, owner, 0, &source_work) if analyzed
                if analyzed and not stability.complete:
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                stable: mutable bool = analyzed and stability.stable
                if not retained and analyzed and not stable and rebind_paths.count > 0:
                    probe: mutable Ast::Expr = fact
                    for path_index in 0..<rebind_paths.count |path_index, probe, rebind_paths, rebind_values|:
                        if not proof_replay_summary_expr_repeat_charge_with_work(probe, 2, &source_work):
                            facts.clear()
                            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                            return
                        replaced: (changed: bool, value: Ast::Expr) = proof_tactic_replace(probe, rebind_paths[path_index], rebind_values[path_index])
                        probe <- replaced.value if replaced.changed
                    probe_stability: (complete: bool, stable: bool) = proof_expr_call_stable_with_work(probe, original, names, parameters, call_aliases, report.aliases.shared_extent_names, report.aliases.shared_fixed_names, report.aliases.local_extent_names, report, owner, 0, &source_work)
                    if not probe_stability.complete:
                        facts.clear()
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    stable <- probe_stability.stable
                retained <- true if not retained and stable
                keep.push(retained)
            write_index: mutable usize = 0
            for read_index in 0..<original.count |facts, original, keep, write_index|:
                continue if not keep[read_index]
                facts[write_index] <- original[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work

        # An element or field write drops every fact that is not call-stable. A disjunctive call
        # summary such as `not live(t, s) or s < CAP` is dropped with it, even when a standing
        # guard `live(t, s)` already refutes one side and the other side mentions only stable
        # values. Resolve such pairs before the write so the surviving side becomes a derivation
        # over exactly those two premises; replay re-proves it, and the clear that follows keeps
        # it only if it is call-stable in its own right.
        def proof_resolve_disjunctive_facts(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, line: u32, name: sview) -> void:
            original: darray[Ast::Expr] = proof_copy_exprs(facts)
            for outer in 0..<original.count |facts, report, original, line, name|:
                match original[outer]:
                    Ast::Expr.Binary(left, TokenKind.Or, right, _):
                        for inner in 0..<original.count |facts, report, original, outer, left, right, line, name|:
                            continue if inner == outer
                            derived: mutable Ast::Expr = Ast::Expr.Invalid
                            known: mutable bool = false
                            if proof_fact_refutes(original[inner], left):
                                derived <- right
                                known <- true
                            elif proof_fact_refutes(original[inner], right):
                                derived <- left
                                known <- true
                            continue if not known
                            continue if any existing in facts where proof_expr_equal(existing, derived)
                            premises: darray[Ast::Expr] = [original[outer], original[inner]]
                            proof_add_derived_fact_from(facts, report, derived, premises, "unit-resolution", line, name)
                    _:
                        pass

        # `fact` refutes `side` when one is the syntactic negation of the other.
        def proof_fact_refutes(fact: Ast::Expr, side: Ast::Expr) -> bool:
            match side:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return true if proof_expr_equal(inner, fact)
                _:
                    pass
            match fact:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_expr_equal(inner, side)
                _:
                    return false
        def proof_clear_facts_for_mutated_root(facts: mutable darray[Ast::Expr]&, root: sview, report: mutable ProofReport&, owner: sview) -> void:
            return if root == ""
            original_count: usize = facts.count
            write_index: mutable usize = 0
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for read_index in 0..<original_count |facts, root, report, owner, original_count, write_index, source_work|:
                fact: Ast::Expr = facts[read_index]
                if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                if not proof_replay_source_work_charge_or_exhaust(sview_len(root), source_work):
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                mentions: bool = proof_expr_mentions_name(fact, root)
                if mentions:
                    is_type_bound: bool = proof_fact_is_type_bound_with_work(report, fact, owner, &source_work)
                    is_global_constant: bool = false if is_type_bound or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT else proof_fact_is_source_global_constant_with_work(report, fact, owner, &source_work)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        facts.clear()
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    continue if not is_type_bound and not is_global_constant
                facts[write_index] <- fact
                write_index <- write_index + 1
            facts.resize(write_index)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work

        def proof_clear_facts_keep_type_bounds(facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: mutable ProofReport&, owner: sview) -> void:
            original_count: usize = facts.count
            write_index: mutable usize = 0
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for read_index in 0..<original_count |facts, names, parameters, report, owner, original_count, write_index, source_work|:
                if not proof_replay_summary_expr_charge_with_limit(facts[read_index], source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                if proof_fact_is_global_constant_with_work(report, facts[read_index], owner, &source_work):
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        facts.clear()
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    facts[write_index] <- facts[read_index]
                    write_index <- write_index + 1
                    continue
                fact: Ast::Expr = facts[read_index]
                if proof_fact_is_global_mutable_array_type_fact_with_work(report, fact, owner, &source_work):
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        facts.clear()
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    facts[write_index] <- fact
                    write_index <- write_index + 1
                    continue
                bound_name: sview = proof_type_bound_name(fact)
                enum_member_witness: bool = proof_unique_builtin_const_enum_member_witness_with_work(fact, report, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                continue if bound_name == "" and not enum_member_witness
                if bound_name != "":
                    live_name: mutable bool = false
                    for candidate in names |candidate, parameters, source_work, bound_name, live_name|:
                        if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(candidate) + sview_len(bound_name), source_work):
                            facts.clear()
                            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                            return
                        live_name <- true if candidate == bound_name
                    if not live_name:
                        for parameter in parameters |parameter, source_work, bound_name, live_name|:
                            if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(parameter) + sview_len(bound_name), source_work):
                                facts.clear()
                                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                                return
                            live_name <- true if parameter == bound_name
                    continue if not live_name
                is_bound: bool = proof_fact_is_type_bound_with_work(report, fact, owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    facts.clear()
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return
                continue if not is_bound
                facts[write_index] <- fact
                write_index <- write_index + 1
            facts.resize(write_index)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work

        def proof_fact_is_global_constant_with_work(report: ProofReport&, fact: Ast::Expr, owner: sview, source_work: mutable usize&) -> bool:
            match fact:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    return false if not proof_replay_summary_expr_charge_with_limit(left, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    # A qualified import names its constant by path, `Limits::TOP == 8`.
                    path: mutable darray[sview] = []
                    return false if proof_ident_name(left) == "" and not proof_qualified_constant_flatten(left, &path, 0)
                    match right:
                        Ast::Expr.IntLit(_, _):
                            pass
                        Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(magnitude, _), _):
                            return false if magnitude < 0
                        _:
                            return false
                _:
                    return false
            for index in report.analysis_2.global_constant_trace_ids |index, report, fact, owner, source_work|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                continue if index < report.analysis_1.traces.active_start or index >= report.analysis_1.traces.records.count
                trace: ProofFactTrace = report.analysis_1.traces.records[index]
                return false if not proof_replay_source_work_charge_or_exhaust(sview_len(trace.kind) + sview_len(trace.name), source_work)
                continue if trace.kind != "global-constant" or trace.name != owner
                equal: bool = proof_replay_summary_expr_equal_with_limit(trace.expression, fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return false if not equal and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return true if equal
            return false

        def proof_fact_is_global_constant(report: ProofReport&, fact: Ast::Expr, owner: sview) -> bool:
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            proof_fact_is_global_constant_with_work(report, fact, owner, &source_work)

        def proof_resymbolize_budget_admitted(names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, target: sview, position: Ast::Pos) -> bool can[Global.Read, Global.Write]:
            work: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            if names.count >= PROOF_LINEAR_SAFETY_WORK_LIMIT or values.count >= PROOF_LINEAR_SAFETY_WORK_LIMIT or facts.count >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                report.analysis_1.budgets.frame_call_source_work <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                proof_frame_source_work_report_exhaustion(report, owner, position.line, "resymbolize-work", "binding resymbolization exceeded its bounded source-work budget")
                return false
            value_cost: mutable usize = values.count
            for value in values |value, work, exhausted, value_cost|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(value, &work, &exhausted)
                if not cost.complete or exhausted or cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - value_cost:
                    report.analysis_1.budgets.frame_call_source_work <- work
                    proof_frame_source_work_report_exhaustion(report, owner, position.line, "resymbolize-work", "binding resymbolization exceeded its bounded source-work budget")
                    return false
                value_cost <- value_cost + cost.cost
            fact_cost: mutable usize = facts.count
            for fact in facts |fact, work, exhausted, fact_cost|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, &work, &exhausted)
                if not cost.complete or exhausted or cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_cost:
                    report.analysis_1.budgets.frame_call_source_work <- work
                    proof_frame_source_work_report_exhaustion(report, owner, position.line, "resymbolize-work", "binding resymbolization exceeded its bounded source-work budget")
                    return false
                fact_cost <- fact_cost + cost.cost
            name_cost: mutable usize = names.count
            target_length: usize = sview_len(target)
            if target_length > PROOF_LINEAR_SAFETY_WORK_LIMIT - name_cost or not proof_linear_safety_work_charge(&work, &exhausted, names.count):
                report.analysis_1.budgets.frame_call_source_work <- work
                proof_frame_source_work_report_exhaustion(report, owner, position.line, "resymbolize-work", "binding resymbolization exceeded its bounded source-work budget")
                return false
            name_cost <- name_cost + target_length
            for name in names |name, work, exhausted, name_cost|:
                name_length: usize = sview_len(name)
                if name_length > PROOF_LINEAR_SAFETY_WORK_LIMIT - name_cost or not proof_linear_safety_work_charge(&work, &exhausted, name_length):
                    report.analysis_1.budgets.frame_call_source_work <- work
                    proof_frame_source_work_report_exhaustion(report, owner, position.line, "resymbolize-work", "binding resymbolization exceeded its bounded source-work budget")
                    return false
                name_cost <- name_cost + name_length
            target_capacity: usize = names.count + 1
            complete: bool = proof_linear_safety_work_charge_scaled(&work, &exhausted, value_cost, target_capacity)
            complete <- complete and proof_linear_safety_work_charge_scaled(&work, &exhausted, fact_cost, target_capacity * 2)
            complete <- complete and proof_linear_safety_work_charge_scaled(&work, &exhausted, name_cost, target_capacity * 3)
            complete <- complete and proof_linear_safety_work_charge_scaled(&work, &exhausted, 1, names.count + values.count + target_capacity * 2)
            report.analysis_1.budgets.frame_call_source_work <- work
            if not complete or exhausted:
                proof_frame_source_work_report_exhaustion(report, owner, position.line, "resymbolize-work", "binding resymbolization exceeded its bounded source-work budget")
                return false
            return not proof_frame_source_work_stop(report, owner, position.line)

        # A binding becomes an opaque symbol again whenever its new value is not expressible in
        # terms of the existing symbols: a declaration reuses a spelling, an unsigned local is
        # bound or rebound, or any binding is updated by a compound assignment. Every fact that
        # mentions the old symbol, and every other binding whose recorded value mentions it,
        # would otherwise silently describe the new value. Purge both transitively. A worklist
        # visits each newly found name once, avoiding repeated whole-environment fixed-point scans.
        # Only compiler type facts of cascaded bindings are re-established; their types are unchanged.
        def proof_resymbolize_binding(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, target: sview, position: Ast::Pos) -> void can[Global.Read, Global.Write]:
            return if target == ""
            if not proof_resymbolize_budget_admitted(names, values, facts, report, owner, target, position):
                facts.clear()
                for index in 0..<values.count |index, names, values, position|:
                    values[index] <- Ast::Expr.Ident(names[index], position) if index < names.count
                return
            targets: mutable darray[sview] = [target]
            target_seen: mutable darray[bool] = [false for _slot in 0..<names.count]
            for index in 0..<names.count |index, names, target_seen, target|:
                target_seen[index] <- true if names[index] == target
            target_index: mutable usize = 0
            while target_index < targets.count |target_index, targets, target_seen, names, values|:
                candidate: sview = targets[target_index]
                for index in 0..<values.count |index, names, values, target_seen, targets, candidate|:
                    continue if index >= names.count or target_seen[index]
                    if proof_expr_mentions_name(values[index], candidate):
                        target_name: sview = names[index]
                        targets.push(target_name)
                        for duplicate_index in 0..<names.count |duplicate_index, names, target_seen, target_name|:
                            if names[duplicate_index] == target_name:
                                target_seen[duplicate_index] <- true
                target_index <- target_index + 1
            cascaded_widths: mutable darray[i64] = []
            for candidate in targets |candidate, facts, cascaded_widths|:
                cascaded_widths.push(proof_unsigned_marker_width_for_name(facts, candidate))
            original_count: usize = facts.count
            write_index: mutable usize = 0
            for read_index in 0..<original_count |facts, targets, original_count, write_index|:
                mentions: mutable bool = false
                for candidate in targets |candidate, facts, read_index, mentions|:
                    mentions <- true if proof_expr_mentions_name(facts[read_index], candidate)
                continue if mentions
                facts[write_index] <- facts[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)
            for index in 0..<values.count |index, names, values, target_seen, position|:
                values[index] <- Ast::Expr.Ident(names[index], position) if index < names.count and target_seen[index]
            for target_index in 0..<targets.count |target_index, targets, cascaded_widths, facts, report, owner, position|:
                continue if target_index == 0 or target_index >= cascaded_widths.count
                proof_add_unsigned_binding_facts(facts, report, targets[target_index], cascaded_widths[target_index], position.line, owner, position)

        # Keep unsigned locals as symbols so their compiler width stays visible; record an
        # initializer only when it is range-safe, and otherwise keep the value opaque.
        # Self-referential updates get a fresh symbol so old facts still describe the old value.
        # Names come from a reserved per-function pool; exhaustion forgets rather than assumes.
        def proof_rebind_symbol(report: mutable ProofReport&) -> sview:
            index: usize = report.threading.rebind_symbols
            return "" if index >= PROOF_INTERNAL_REBIND_SYMBOL_COUNT
            report.threading.rebind_symbols <- index + 1
            return proof_internal_rebind_name(index)

        # A negative i64 payload can be an unsuffixed positive literal above INT64_MAX. When
        # context assigns it to u64, the source compiler has type information that is not
        # retained in the proof kernel's source-neutral integer node. Keep the typed local and
        # its range marker, but do not export an untyped `name == -1` equation to arithmetic.
        # Explicitly sorted literals already encode as typed-int and retain their exact value.
        def proof_contextual_u64_high_bit_literal(expression: Ast::Expr, width: i64, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if width != 64
            match expression:
                Ast::Expr.IntLit(value, position):
                    return false if value >= 0 or proof_integer_literal_tag(expression, annotations) != ""
                    return not proof_replay_numeric_literal_sort(annotations, position.line, position.column, value).known
                _:
                    return false

        def proof_bind_unsigned_symbol(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, functions: mutable ProofFunctionTable&, owner: sview, slot: usize, width: i64, value: Ast::Expr, position: Ast::Pos, annotations: darray[Ast::EnumAnnotation]&) -> void can[Global.Read, Global.Write]:
            return if slot >= names.count or slot >= values.count or width <= 0
            declared: sview = names[slot]
            value_known: mutable bool = true
            match value:
                Ast::Expr.Invalid:
                    value_known <- false
                Ast::Expr.Absent:
                    value_known <- false
                _:
                    pass
            # Only a self-referential value needs a fresh symbol, and only then is the old symbol
            # left standing. Every other rebind keeps the source name as its symbol, so the facts
            # over the old value -- which that name would otherwise still denote -- are dropped.
            fresh: sview = proof_unsigned_rebind_symbol(report, owner, width, value, position) if value_known and proof_expr_mentions_name(value, declared) else ""
            symbol: sview = declared if fresh == "" else fresh
            (proof_transfer_facts_to_alias(names, values, facts, report, owner, declared, position) can Global{Read,Write}) if fresh == ""
            proof_resymbolize_binding(names, values, facts, report, owner, declared, position) if fresh == ""
            values[slot] <- Ast::Expr.Ident(symbol, position)
            proof_add_unsigned_binding_facts(facts, report, symbol, width, position.line, owner, position)
            return if not value_known or proof_expr_mentions_name(value, symbol)
            proof_rebind_call_summaries(facts, report, functions, value, symbol, position.line, owner, position)
            return if not proof_unsigned_expression_safe(value, facts) and not proof_unsigned_named_subtraction_value(value, width, facts)
            return if not proof_unsigned_constants_fit(value, width, 0)
            return if proof_contextual_u64_high_bit_literal(value, width, annotations)
            binding: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident(symbol, position), TokenKind.EqEq, value, position)
            proof_add_traced_fact(facts, report, binding, "local-binding", position.line, owner)
            (proof_add_binding_range(facts, report, symbol, value, owner, position, annotations) can Global{Read,Write})

        # A scalar local whose initializer is opaque still denotes one value. Keep its own name as
        # the symbol instead of the unexpressible initializer, so `reading == reading` is decided
        # over the witnessed binding rather than over two copies of an unknown. Nothing about the
        # value is assumed: an opaque initializer contributes no binding fact.
        def proof_bind_scalar_symbol(names: darray[sview]&, values: mutable darray[Ast::Expr]&, slot: usize, position: Ast::Pos) -> void:
            return if slot >= names.count or slot >= values.count
            match values[slot]:
                Ast::Expr.Invalid:
                    values[slot] <- Ast::Expr.Ident(names[slot], position)
                Ast::Expr.Absent:
                    values[slot] <- Ast::Expr.Ident(names[slot], position)
                _:
                    pass

        def proof_statement_declared_name(statement: Ast::Stmt) -> sview:
            match statement:
                Ast::Stmt.VarDecl(local_name, _, _, _):
                    return local_name
                _:
                    return ""

        # Return the binding root affected by a move. Field and index moves consume the
        # containing binding from this kernel's name-based state; precise subfield ownership is
        # intentionally left to the compiler's affine checker until the proof state has binding
        # identities rather than source spellings.
        def proof_move_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _):
                    return proof_move_root(object)
                Ast::Expr.Index(object, _, _):
                    return proof_move_root(object)
                Ast::Expr.IndexN(object, _, _):
                    return proof_move_root(object)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_move_root(object)
                Ast::Expr.Paren(inner, _):
                    return proof_move_root(inner)
                Ast::Expr.Move(operand, _):
                    return proof_move_root(operand)
                _:
                    return ""

        # A move invalidates all symbolic values conservatively, then marks the consumed root as
        # unavailable. This makes a later use substitute to Invalid and prevents the proof
        # checker from proving a post-move property from a pre-move alias. The compiler's own
        # affine/linear/region passes remain the authority for exact ownership legality.
        def proof_invalidate_moved_roots(roots: darray[sview], names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, position: Ast::Pos) -> void:
            return if roots.count == 0
            proof_forget_values(names, values, position)
            # A transfer invalidates what is known about the moved roots, not the declared type of
            # every other binding: an unrelated `y: i64` is still an `i64` afterwards. Keep the
            # traced type bounds of live, unmoved names and discard everything else, which is the
            # same retention rule used at call and control-flow havoc points.
            original_count: usize = facts.count
            write_index: mutable usize = 0
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            for read_index in 0..<original_count |facts, names, roots, report, owner, original_count, write_index, source_work|:
                if not proof_replay_summary_expr_charge_with_limit(facts[read_index], source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    facts.resize(write_index)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    for index in 0..<values.count |index, values|:
                        values[index] <- Ast::Expr.Invalid
                    return
                bound_name: sview = proof_type_bound_name(facts[read_index])
                continue if bound_name == ""
                moved_root: mutable bool = false
                for root in roots |root, source_work, bound_name, moved_root|:
                    if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(root) + sview_len(bound_name), source_work):
                        facts.resize(write_index)
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        for index in 0..<values.count |index, values|:
                            values[index] <- Ast::Expr.Invalid
                        return
                    moved_root <- true if root == bound_name
                continue if moved_root
                live_name: mutable bool = false
                for candidate in names |candidate, source_work, bound_name, live_name|:
                    if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(candidate) + sview_len(bound_name), source_work):
                        facts.resize(write_index)
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        for index in 0..<values.count |index, values|:
                            values[index] <- Ast::Expr.Invalid
                        return
                    live_name <- true if candidate == bound_name
                continue if not live_name
                is_bound: bool = proof_fact_is_type_bound_with_work(report, facts[read_index], owner, &source_work)
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    facts.resize(write_index)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    for index in 0..<values.count |index, values|:
                        values[index] <- Ast::Expr.Invalid
                    return
                continue if not is_bound
                facts[write_index] <- facts[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            for root in roots |root, names, values|:
                for index in 0..<names.count |index, names, values, root|:
                    if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(root) + sview_len(names[index]), source_work):
                        for invalid_index in 0..<values.count |invalid_index, values|:
                            values[invalid_index] <- Ast::Expr.Invalid
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return
                    values[index] <- Ast::Expr.Invalid if names[index] == root
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work

        # The parser keeps a body contract's head verbatim, and `ensures` is the plural
        # spelling of the postcondition head, so both spellings are one contract kind.
        def proof_is_ensure_kind(kind: sview) -> bool:
            return kind in {"ensure", "ensures"}

        def proof_contracts(body: darray[Ast::Stmt]&, kind: sview) -> darray[Ast::Expr]:
            result: mutable darray[Ast::Expr] = []
            for statement in body |result, kind|:
                match statement:
                    Ast::Stmt.Contract(contract_kind, expression, _):
                        result.push(expression) if contract_kind == kind or (kind == "ensure" and proof_is_ensure_kind(contract_kind))
                    _:
                        pass
            return result

        # Contract calls require proven total purity; `old(...)` is modeled separately.
        # Preconditions, mutable parameters, writes, or opaque transitive calls make a call unstable.
