# Shared conversion classifier factored from runtime_support_and_calls.elisa.
extend ElisaProof:
    private:
        def proof_runtime_builtin_numeric_cast(callee: Ast::Expr, argument_count: usize, functions: ProofFunctionTable&) -> (known: bool, receiver: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            return (false, Ast::Expr.Invalid) if argument_count != 0
            match callee:
                Ast::Expr.Field(receiver, target, _):
                    target_index: usize = proof_fact_numeric_cast_target_index(target)
                    return (false, Ast::Expr.Invalid) if target_index >= PROOF_FACT_NUMERIC_CAST_TARGET_COUNT
                    return (false, Ast::Expr.Invalid) if proof_runtime_custom_cast_hook_present(functions)
                    return (true, receiver)
                _:
                    return (false, Ast::Expr.Invalid)
