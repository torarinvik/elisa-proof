# Source annotations preserving syntax erased from Ast::Decl.Func, such as an explicit `can[]`.
extend ElisaProof:
    private:
        const PROOF_FUNCTION_EFFECT_ROW_MARKER_LINE: u32 = 3900000132

        struct ProofFunctionEffectRowMarkerIndex:
            hashes: mutable darray[u32]
            values: mutable darray[usize]
            offsets: mutable darray[u32]
            counts: mutable darray[usize]
            marker_count: usize
            valid: bool

        const PROOF_FUNCTION_EFFECT_ROW_MARKER_INDEX_EMPTY: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1

        def proof_function_effect_row_marker_hash(offset: u32) -> u32:
            proof_expr_shape_mix(3900000132, offset.i64())

        def proof_function_effect_row_marker_index_build(annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> ProofFunctionEffectRowMarkerIndex can[Memory.Allocate, Abort.Panic]:
            marker_count: mutable usize = 0
            for annotation in annotations |annotations, marker_count, source_work|:
                return ProofFunctionEffectRowMarkerIndex{hashes: [], values: [], offsets: [], counts: [], marker_count: 0, valid: false} if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                marker_count <- marker_count + 1 if annotation.name == "__function_effect_row_declared" and annotation.line == PROOF_FUNCTION_EFFECT_ROW_MARKER_LINE
            empty: ProofFunctionEffectRowMarkerIndex = ProofFunctionEffectRowMarkerIndex{hashes: [], values: [], offsets: [], counts: [], marker_count: 0, valid: true}
            return empty if marker_count == 0
            capacity: usize = proof_name_index_capacity(marker_count)
            return ProofFunctionEffectRowMarkerIndex{hashes: [], values: [], offsets: [], counts: [], marker_count: 0, valid: false} if capacity == 0 or marker_count > capacity / 2 or not proof_report_source_work_charge(capacity, source_work) or not proof_report_source_work_charge(marker_count, source_work)
            index: mutable ProofFunctionEffectRowMarkerIndex = ProofFunctionEffectRowMarkerIndex{hashes: [], values: [], offsets: [], counts: [], marker_count: marker_count, valid: true}
            index.hashes.resize(capacity)
            index.values.resize(capacity)
            index.offsets.resize(capacity)
            index.counts.resize(capacity)
            for slot in 0..<capacity |slot, index|:
                index.values[slot] <- PROOF_FUNCTION_EFFECT_ROW_MARKER_INDEX_EMPTY
                index.counts[slot] <- 0
            for row in 0..<annotations.count |row, annotations, index, capacity, source_work|:
                annotation: Ast::EnumAnnotation = annotations[row]
                return ProofFunctionEffectRowMarkerIndex{hashes: [], values: [], offsets: [], counts: [], marker_count: 0, valid: false} if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                continue if annotation.name != "__function_effect_row_declared" or annotation.line != PROOF_FUNCTION_EFFECT_ROW_MARKER_LINE
                hash: u32 = proof_function_effect_row_marker_hash(annotation.offset)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, row, hash, annotation, index, capacity, source_work, placed|:
                    return ProofFunctionEffectRowMarkerIndex{hashes: [], values: [], offsets: [], counts: [], marker_count: 0, valid: false} if not proof_report_source_work_charge(1, source_work)
                    current: usize = index.values[slot]
                    if current == PROOF_FUNCTION_EFFECT_ROW_MARKER_INDEX_EMPTY:
                        index.hashes[slot] <- hash
                        index.values[slot] <- row
                        index.offsets[slot] <- annotation.offset
                        index.counts[slot] <- 1
                        placed <- true
                        break
                    return ProofFunctionEffectRowMarkerIndex{hashes: [], values: [], offsets: [], counts: [], marker_count: 0, valid: false} if current >= annotations.count
                    if index.hashes[slot] == hash and index.offsets[slot] == annotation.offset:
                        index.counts[slot] <- index.counts[slot] + 1
                        placed <- true
                        break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return ProofFunctionEffectRowMarkerIndex{hashes: [], values: [], offsets: [], counts: [], marker_count: 0, valid: false} if not placed
            index

        def proof_function_effect_row_marker_index_lookup(index: ProofFunctionEffectRowMarkerIndex, annotations: darray[Ast::EnumAnnotation]&, function_name: sview, function_line: u32, function_offset: u32, source_work: mutable usize&) -> (complete: bool, present: bool):
            return (false, false) if not index.valid or not proof_report_source_work_charge(sview_len(function_name), source_work)
            return (true, false) if index.marker_count == 0
            capacity: usize = index.hashes.count
            return (false, false) if capacity == 0 or index.values.count != capacity or index.offsets.count != capacity or index.counts.count != capacity
            hash: u32 = proof_function_effect_row_marker_hash(function_offset)
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, index, capacity, annotations, function_name, function_line, function_offset, source_work|:
                return (false, false) if not proof_report_source_work_charge(1, source_work)
                row: usize = index.values[slot]
                return (true, false) if row == PROOF_FUNCTION_EFFECT_ROW_MARKER_INDEX_EMPTY
                return (false, false) if row >= annotations.count
                if index.hashes[slot] == hash and index.offsets[slot] == function_offset:
                    return (false, false) if index.counts[slot] != 1
                    annotation: Ast::EnumAnnotation = annotations[row]
                    return (false, false) if not proof_report_source_work_charge(sview_len(annotation.name), source_work) or not proof_report_source_work_charge(sview_len(annotation.owner), source_work)
                    return (false, false) if annotation.name != "__function_effect_row_declared" or annotation.line != PROOF_FUNCTION_EFFECT_ROW_MARKER_LINE or annotation.offset != function_offset or annotation.owner != function_name or annotation.detail_line != function_line
                    return (true, true)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false)

