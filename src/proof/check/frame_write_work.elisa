extend ElisaProof:
    private:
        def proof_frame_write_place_text_work(place: ProofFramePlace, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            amount: mutable usize = 1
            length: mutable usize = sview_len(place.root)
            return false if length > PROOF_LINEAR_SAFETY_WORK_LIMIT - amount
            amount <- amount + length
            length <- sview_len(place.field)
            return false if length > PROOF_LINEAR_SAFETY_WORK_LIMIT - amount
            amount <- amount + length
            length <- sview_len(place.field2)
            return false if length > PROOF_LINEAR_SAFETY_WORK_LIMIT - amount
            amount <- amount + length
            length <- sview_len(place.field3)
            return false if length > PROOF_LINEAR_SAFETY_WORK_LIMIT - amount
            amount <- amount + length
            return false if amount > PROOF_LINEAR_SAFETY_WORK_LIMIT / 4
            proof_frame_source_work_take(report, name, line, amount * 4, "frame-write-place-work", "frame write path comparison exceeded its bounded source-work budget")

        def proof_frame_write_places_text_reserve(changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            for place in changes |place, report, name, line|:
                return false if not proof_frame_write_place_text_work(place, report, name, line)
            for place in preserves |place, report, name, line|:
                return false if not proof_frame_write_place_text_work(place, report, name, line)
            true

        def proof_frame_write_scan_refusal(report: mutable ProofReport&, name: sview, line: u32) -> void:
            report.proof_frame_obligation(false)
            proof_add_finding(report, "frame-write-opaque", line, name, "frame write classification exceeded its bounded source-work budget")

        def proof_frame_write_expression_cost(target: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32) -> (complete: bool, cost: usize):
            budget: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            measured: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(target, &budget, &exhausted)
            report.analysis_1.budgets.frame_call_source_work <- budget
            if not measured.complete:
                proof_frame_source_work_report_exhaustion(report, name, line, "frame-write-expression-cost", "frame write target cost exceeded its bounded source-work budget")
                return (false, 0)
            (true, measured.cost)

        def proof_frame_write_expression_passes_reserve(cost: usize, passes: usize, report: mutable ProofReport&, name: sview, line: u32, dimension: sview) -> bool:
            budget: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            complete: bool = proof_linear_safety_work_charge_scaled(&budget, &exhausted, cost, passes)
            report.analysis_1.budgets.frame_call_source_work <- budget
            if not complete:
                proof_frame_source_work_report_exhaustion(report, name, line, dimension, "frame write classification exceeded its bounded source-work budget")
            complete

        # The fallback calls proof_frame_place from each recursive mention-check. That helper
        # can rescan each remaining subtree for calls/support and block checks, so reserve eight
        # quadratic AST passes per changes/preserves row to cover their nested rescans.
        def proof_frame_write_alias_scan_reserve(cost: usize, place_count: usize, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            budget: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            complete: mutable bool = proof_linear_safety_work_charge_scaled(&budget, &exhausted, cost, 2)
            if complete:
                complete <- proof_linear_safety_work_charge_product4_with_work(&budget, &exhausted, place_count, cost, cost, 1, 8)
            report.analysis_1.budgets.frame_call_source_work <- budget
            if not complete:
                proof_frame_source_work_report_exhaustion(report, name, line, "frame-write-alias-work", "frame alias classification exceeded its bounded quadratic source-work budget")
            complete
