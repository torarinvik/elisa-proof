extend ElisaProof:
    private:
        def proof_remove_type_bound_facts_for_names(facts: mutable darray[Ast::Expr]&, names: darray[sview]&) -> void:
            # Compact in place. A temporary AST value in a fresh darray would acquire the
            # inferred auto region of this helper; stage1 correctly rejects storing that value
            # into the longer-lived fact set. The source and destination are the same arena-owned
            # array, so compaction preserves both the AST views and the proof-state lifetime.
            original_count: usize = facts.count
            write_index: mutable usize = 0
            for read_index in 0..<original_count |facts, names, original_count, write_index|:
                bound_name: sview = proof_type_bound_name(facts[read_index])
                continue if bound_name != "" and (any candidate in names where candidate == bound_name)
                facts[write_index] <- facts[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)

        # Replaces `facts.clear()` at every state-invalidation point of symbolic execution.
        # Type-bound facts describe the compiler type of a binding, not mutable program state,
        # so they remain true across an invalidation while that binding is lexically live. A
        # redeclaration purges them explicitly before establishing the new declaration's type.
        # Without this, a cleared unsigned marker would let later arithmetic on the binding be
        # folded as unbounded signed arithmetic.
        def proof_drop_local_extent(report: mutable ProofReport&, name: sview) -> void:
            return if name == ""
            write_index: mutable usize = 0
            original_count: usize = report.aliases.local_extent_names.count
            for read_index in 0..<original_count |read_index, write_index, report, name|:
                existing: sview = report.aliases.local_extent_names[read_index]
                continue if existing == name
                report.aliases.local_extent_names[write_index] <- existing
                write_index <- write_index + 1
            report.aliases.local_extent_names.resize(write_index)
            value_count: usize = report.aliases.value_binding_names.count
            write_index <- 0
            for read_index in 0..<value_count |read_index, write_index, report, name|:
                existing: sview = report.aliases.value_binding_names[read_index]
                continue if existing == name
                report.aliases.value_binding_names[write_index] <- existing
                write_index <- write_index + 1
            report.aliases.value_binding_names.resize(write_index)

        def proof_push_aliased(aliased: mutable darray[sview]&, name: sview) -> void:
            return if name == ""
            return if any existing in aliased where existing == name
            aliased.push(name)

        # The locals of a function body that may be referenced: a place under `&`, `mutable` or
        # `move`, the receiver of a method call, and a bare name passed to a parameter that is a
        # reference (Elisa references such an argument implicitly) or to a callee whose signature
        # is not imported. A lambda body is not analyzed; it disables the analysis for the whole
        # function through the `*` sentinel. Everything else is a by-value scalar a callee cannot
        # reach.
        def proof_collect_aliased_names(body: darray[Ast::Stmt]&, functions: mutable ProofFunctionTable&, aliased: mutable darray[sview]&, confinable: bool, value_roots: darray[sview]&) -> void:
            for statement in body |functions, aliased, confinable, value_roots|:
                match statement:
                    Ast::Stmt.Expr(expression, _):
                        proof_collect_aliased_in_expression(expression, functions, aliased, confinable, value_roots)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        proof_collect_aliased_names(block_body, functions, aliased, confinable, value_roots)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        proof_collect_aliased_in_expression(initializer, functions, aliased, confinable, value_roots)
                    Ast::Stmt.Assign(target, _, value, _):
                        proof_collect_aliased_in_expression(target, functions, aliased, confinable, value_roots)
                        proof_collect_aliased_in_expression(value, functions, aliased, confinable, value_roots)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_collect_aliased_in_expression(condition, functions, aliased, confinable, value_roots)
                        proof_collect_aliased_names(then_body, functions, aliased, confinable, value_roots)
                        proof_collect_aliased_names(else_body, functions, aliased, confinable, value_roots)
                    Ast::Stmt.While(condition, while_body, _):
                        proof_collect_aliased_in_expression(condition, functions, aliased, confinable, value_roots)
                        proof_collect_aliased_names(while_body, functions, aliased, confinable, value_roots)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        proof_collect_aliased_in_expression(iterable, functions, aliased, confinable, value_roots)
                        proof_collect_aliased_names(for_body, functions, aliased, confinable, value_roots)
                    Ast::Stmt.Return(value, _):
                        proof_collect_aliased_in_expression(returned, functions, aliased, confinable, value_roots) if value is returned
                    Ast::Stmt.Match(scrutinee, arms, _):
                        proof_collect_aliased_in_expression(scrutinee, functions, aliased, confinable, value_roots)
                        for arm in arms |functions, aliased, confinable, value_roots|:
                            proof_collect_aliased_in_expression(arm.guard, functions, aliased, confinable, value_roots)
                            proof_collect_aliased_names(arm.body, functions, aliased, confinable, value_roots)
                    Ast::Stmt.Contract(_, expression, _):
                        proof_collect_aliased_in_expression(expression, functions, aliased, confinable, value_roots)
                    _:
                        pass

        def proof_strip_parens(expression: Ast::Expr) -> Ast::Expr:
            return proof_strip_parens_depth(expression, 0)

        def proof_strip_parens_depth(expression: Ast::Expr, depth: usize) -> Ast::Expr:
            # Parentheses are removed before place/name classification. Return an invalid term at
            # the shared boundary instead of allowing an imported parenthesis chain to exhaust
            # the verifier stack.
            return Ast::Expr.Invalid if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_strip_parens_depth(inner, depth + 1)
                _:
                    return expression

        # Whether a reference handed to this callee's parameter `lent_slot` can outlive the call.
        # It cannot when nothing the callee can store into, that its caller still sees, has a type
        # able to hold a reference: its other parameters' storage, and its return. A lifetime
        # parameter is the one way a callee names a region longer-lived than the call, so a callee
        # that declares one is refused outright, as is one that returns a reference or a region.
        #
        # The boundary is fixed by compiled probes rather than by argument. A callee with a second
        # parameter of type `mutable darray[darray[usize]&]&` does store the lend into it, and one
        # that returns a by-value `darray[darray[usize]&]` holding it does too; the compiler
        # accepts both. Storing into an ordinary field is what its region checker refuses. So the
        # test has to be over types, and it is deliberately conservative: an unresolvable name, an
        # ambiguous alias and a form it does not recognize all count as able to hold a reference.
        def proof_call_lend_is_confined(functions: ProofFunctionTable&, callee_index: usize, lent_slot: usize) -> bool:
            return false if:
                callee_index >= functions.parameters.metadata.param_starts.count or callee_index >= functions.parameters.metadata.param_counts.count
                callee_index >= functions.parameters.regions.region_param_counts.count or functions.parameters.regions.region_param_counts[callee_index] != 0
                callee_index >= functions.returns.return_references.count or functions.returns.return_references[callee_index]
                callee_index >= functions.returns.return_regions.count or functions.returns.return_regions[callee_index] != ""
                callee_index >= functions.returns.return_reference_free.count or not functions.returns.return_reference_free[callee_index]
                callee_index >= functions.returns.return_type_marker_complete.count or not functions.returns.return_type_marker_complete[callee_index]
            parameter_start: usize = functions.parameters.metadata.param_starts[callee_index]
            parameter_count: usize = functions.parameters.metadata.param_counts[callee_index]
            for offset in 0..<parameter_count |offset, functions, parameter_start, lent_slot|:
                continue if offset == lent_slot
                slot: usize = parameter_start + offset
                return false if:
                    slot >= functions.parameters.metadata.all_parameter_type_marker_complete.count or not functions.parameters.metadata.all_parameter_type_marker_complete[slot]
                    slot >= functions.parameters.metadata.all_parameter_target_reference_free.count
                    not functions.parameters.metadata.all_parameter_target_reference_free[slot]
            return true

        def proof_collect_aliased_call_arguments(callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, functions: mutable ProofFunctionTable&, aliased: mutable darray[sview]&, confinable: bool, value_roots: darray[sview]&) -> usize:
            called: sview = proof_callable_name(callee)
            index: usize = proof_function_index_for_callee(functions, callee)
            known: bool = called != "" and index < functions.lookup.names.count
            # A method call's receiver is not among its arguments, so it is recorded here by name.
            # A collection builtin is the exception the confinement rule already covers by another
            # route: `xs.push(v)` writes `xs` during the call and leaves nothing behind that a
            # later call could reach, exactly as a confined lend does. Recording it as escaping
            # made a collection this frame only ever pushed to unreachable-by-nothing yet aliased
            # forever, and every loop over `xs.count` afterwards lost its own range fact.
            builtin: (known: bool, receiver: Ast::Expr) = proof_resource_collection_builtin(callee, functions)
            # An unshadowed integer conversion copies its receiver's value and lends nothing.
            conversion: bool = proof_runtime_numeric_conversion(callee, arguments.count, functions).known
            match callee:
                Ast::Expr.Field(receiver, _, _):
                    proof_push_aliased(aliased, proof_ident_name(proof_strip_parens(receiver))) if not (confinable and builtin.known) and not conversion
                _:
                    pass
            # A builtin on a value collection copies its arguments into storage that cannot hold
            # a reference, so none of them is lent (`proof_collect_value_collections`).
            value_builtin: bool = builtin.known and (any root in value_roots where root == proof_place_root_name(builtin.receiver, 0))
            for position in 0..<arguments.count |position, arguments, argument_names, functions, aliased, known, index, confinable, value_roots, value_builtin|:
                argument_name: sview = proof_ident_name(proof_strip_parens(arguments[position]))
                continue if argument_name == "" or value_builtin
                if not known:
                    proof_push_aliased(aliased, argument_name)
                    continue
                parameter_start: usize = functions.parameters.metadata.param_starts[index]
                parameter_count: usize = functions.parameters.metadata.param_counts[index]
                slot: usize = proof_call_argument_slot(functions, index, argument_names, position, arguments.count)
                if slot >= parameter_count or parameter_start + slot >= functions.parameters.metadata.all_parameter_references.count or parameter_start + slot >= functions.parameters.metadata.all_parameter_type_marker_complete.count or not functions.parameters.metadata.all_parameter_type_marker_complete[parameter_start + slot]:
                    proof_push_aliased(aliased, argument_name)
                    continue
                continue if not functions.parameters.metadata.all_parameter_references[parameter_start + slot]
                continue if confinable and proof_call_lend_is_confined(functions, index, slot)
                proof_push_aliased(aliased, argument_name)
            return index

        # Which formal an actual lands on: its position, or the formal a named argument names.
        # `parameter_count` means the actual could not be placed.
        def proof_call_argument_slot(functions: ProofFunctionTable&, callee_index: usize, argument_names: darray[sview]&, position: usize, argument_count: usize) -> usize:
            return 0 if callee_index >= functions.parameters.metadata.param_starts.count or callee_index >= functions.parameters.metadata.param_counts.count
            parameter_start: usize = functions.parameters.metadata.param_starts[callee_index]
            parameter_count: usize = functions.parameters.metadata.param_counts[callee_index]
            slot: mutable usize = parameter_count
            if argument_names.count == argument_count and position < argument_names.count and argument_names[position] != "":
                for offset in 0..<parameter_count |offset, functions, parameter_start, argument_names, position, slot|:
                    slot <- offset if parameter_start + offset < functions.parameters.metadata.all_params.count and functions.parameters.metadata.all_params[parameter_start + offset] == argument_names[position]
            else:
                slot <- position if position < parameter_count
            return slot

        # `&x`, `mutable x` or `lmut x` written out at a call site, and the place it lends.
        def proof_explicit_lend_operand(expression: Ast::Expr) -> (known: bool, operand: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(expression):
                Ast::Expr.Unary(operator, operand, _):
                    return (true, operand) if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        def proof_collect_aliased_in_expression(expression: Ast::Expr, functions: mutable ProofFunctionTable&, aliased: mutable darray[sview]&, confinable: bool, value_roots: darray[sview]&) -> void:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    proof_push_aliased(aliased, proof_place_root_name(operand, 0)) if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    proof_collect_aliased_in_expression(operand, functions, aliased, confinable, value_roots)
                Ast::Expr.Move(operand, _):
                    proof_push_aliased(aliased, proof_place_root_name(operand, 0))
                    proof_collect_aliased_in_expression(operand, functions, aliased, confinable, value_roots)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_push_aliased(aliased, proof_place_root_name(operand, 0))
                    proof_collect_aliased_in_expression(operand, functions, aliased, confinable, value_roots)
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    called_index: usize = proof_collect_aliased_call_arguments(callee, arguments, argument_names, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(callee, functions, aliased, confinable, value_roots)
                    # An explicit `&x` at a call site is the same lend the implicit form above
                    # decides on, so it gets the same decision. When the lend is confined the
                    # walk descends into the lent place instead of the lend, which records
                    # anything nested inside it without recording the lend itself.
                    called_name: sview = proof_callable_name(callee)
                    callee_known: bool = called_name != "" and called_index < functions.lookup.names.count
                    for position in 0..<arguments.count |position, arguments, argument_names, functions, aliased, confinable, callee_known, called_index|:
                        argument: Ast::Expr = arguments[position]
                        lend: (known: bool, operand: Ast::Expr) = proof_explicit_lend_operand(argument)
                        confined: mutable bool = false
                        if confinable and callee_known and lend.known:
                            slot: usize = proof_call_argument_slot(functions, called_index, argument_names, position, arguments.count)
                            confined <- slot < functions.parameters.metadata.param_counts[called_index] and proof_call_lend_is_confined(functions, called_index, slot)
                        proof_collect_aliased_in_expression(lend.operand, functions, aliased, confinable, value_roots) if confined
                        proof_collect_aliased_in_expression(argument, functions, aliased, confinable, value_roots) if not confined
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    proof_collect_aliased_in_expression(lowered.call, functions, aliased, confinable, value_roots) if lowered.known
                    if not lowered.known:
                        proof_push_aliased(aliased, "*")
                Ast::Expr.Field(object, _, _):
                    proof_collect_aliased_in_expression(object, functions, aliased, confinable, value_roots)
                Ast::Expr.Scope(base, _, _):
                    proof_collect_aliased_in_expression(base, functions, aliased, confinable, value_roots)
                Ast::Expr.Index(object, index, _):
                    proof_collect_aliased_in_expression(object, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(index, functions, aliased, confinable, value_roots)
                Ast::Expr.Slice(object, low, high, _):
                    proof_collect_aliased_in_expression(object, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(low, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(high, functions, aliased, confinable, value_roots)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_collect_aliased_in_expression(object, functions, aliased, confinable, value_roots)
                    for argument in arguments |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(argument, functions, aliased, confinable, value_roots)
                Ast::Expr.Binary(left, _, right, _):
                    proof_collect_aliased_in_expression(left, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(right, functions, aliased, confinable, value_roots)
                Ast::Expr.Paren(inner, _):
                    proof_collect_aliased_in_expression(inner, functions, aliased, confinable, value_roots)
                Ast::Expr.Array(elements, _):
                    for element in elements |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(element, functions, aliased, confinable, value_roots)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(element, functions, aliased, confinable, value_roots)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(element, functions, aliased, confinable, value_roots)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(entry.key, functions, aliased, confinable, value_roots)
                        proof_collect_aliased_in_expression(entry.value, functions, aliased, confinable, value_roots)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(field.value, functions, aliased, confinable, value_roots)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_collect_aliased_in_expression(base, functions, aliased, confinable, value_roots)
                    for field in fields |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(field.value, functions, aliased, confinable, value_roots)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    proof_collect_aliased_in_expression(condition, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(then_expression, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(else_expression, functions, aliased, confinable, value_roots)
                Ast::Expr.Match(scrutinee, arms, _):
                    proof_collect_aliased_in_expression(scrutinee, functions, aliased, confinable, value_roots)
                    for arm in arms |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(arm.guard, functions, aliased, confinable, value_roots)
                        proof_collect_aliased_names(arm.body, functions, aliased, confinable, value_roots)
                Ast::Expr.Catch(guarded, arms, _):
                    proof_collect_aliased_in_expression(guarded, functions, aliased, confinable, value_roots)
                    for arm in arms |functions, aliased, confinable, value_roots|:
                        proof_collect_aliased_in_expression(arm.guard, functions, aliased, confinable, value_roots)
                        proof_collect_aliased_names(arm.body, functions, aliased, confinable, value_roots)
                Ast::Expr.Comprehension(_, iterable, condition, comprehension_body, _):
                    proof_collect_aliased_in_expression(iterable, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(condition, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(comprehension_body, functions, aliased, confinable, value_roots)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_collect_aliased_in_expression(base, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(predicate, functions, aliased, confinable, value_roots)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_collect_aliased_in_expression(guarded, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_names(recovery, functions, aliased, confinable, value_roots)
                Ast::Expr.Lambda(_, _, _):
                    proof_push_aliased(aliased, "*")
                Ast::Expr.Block(statements, value, _, _):
                    proof_collect_aliased_names(statements, functions, aliased, confinable, value_roots)
                    proof_collect_aliased_in_expression(value, functions, aliased, confinable, value_roots)
                _:
                    pass

        # A fact a call cannot falsify: a proposition over literals and by-value scalar locals
        # and parameters of the current function that are never referenced. A callee reaches
        # its caller's state only through references and globals, so such a fact holds after
        # the call exactly as before it. Anything else — a field, an element, a container, a
        # call, a name the body may reference — is not stable.
        def proof_call_stable_scalar_term_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
            return witnessed.complete and witnessed.matches

        def proof_expr_call_stable(expression: Ast::Expr, facts: darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, aliased: darray[sview]&, shared_extents: darray[sview]&, shared_fixed: darray[sview]&, local_extents: darray[sview]&, report: mutable ProofReport&, owner: sview, depth: usize) -> bool:
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            result: (complete: bool, stable: bool) = proof_expr_call_stable_with_work(expression, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth, source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            result.complete and result.stable

        def proof_expr_call_stable_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, aliased: darray[sview]&, shared_extents: darray[sview]&, shared_fixed: darray[sview]&, local_extents: darray[sview]&, report: ProofReport&, owner: sview, depth: usize, source_work: mutable usize&) -> (complete: bool, stable: bool):
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                return (true, false)
            if not proof_replay_summary_expr_charge_with_limit(expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                return (false, false)
            # The recursive classifier has bounded scans over each of these name lists. Charge
            # their whole byte cost at each visited expression node before using the legacy
            # membership predicates, so repeated nested queries share one source-work limit.
            name_scan_cost: mutable usize = 0
            name_scan_entries: mutable usize = 0
            for name in names |source_work, name_scan_cost, name_scan_entries|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(name), source_work)
                name_scan_cost <- name_scan_cost + 1 + sview_len(name)
                name_scan_entries <- name_scan_entries + 1
            for name in parameters |source_work, name_scan_cost, name_scan_entries|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(name), source_work)
                name_scan_cost <- name_scan_cost + 1 + sview_len(name)
                name_scan_entries <- name_scan_entries + 1
            for name in aliased |source_work, name_scan_cost, name_scan_entries|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(name), source_work)
                name_scan_cost <- name_scan_cost + 1 + sview_len(name)
                name_scan_entries <- name_scan_entries + 1
            for name in shared_extents |source_work, name_scan_cost, name_scan_entries|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(name), source_work)
                name_scan_cost <- name_scan_cost + 1 + sview_len(name)
                name_scan_entries <- name_scan_entries + 1
            for name in shared_fixed |source_work, name_scan_cost, name_scan_entries|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(name), source_work)
                name_scan_cost <- name_scan_cost + 1 + sview_len(name)
                name_scan_entries <- name_scan_entries + 1
            for name in local_extents |source_work, name_scan_cost, name_scan_entries|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(name), source_work)
                name_scan_cost <- name_scan_cost + 1 + sview_len(name)
                name_scan_entries <- name_scan_entries + 1
            for name in report.threading.threaded_symbols |source_work, name_scan_cost, name_scan_entries|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(name), source_work)
                name_scan_cost <- name_scan_cost + 1 + sview_len(name)
                name_scan_entries <- name_scan_entries + 1
            return (false, false) if:
                name_scan_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 8
                not proof_replay_source_work_charge_or_exhaust(name_scan_cost * 8, source_work)
            for fact in facts |source_work|:
                return (false, false) if not proof_replay_summary_expr_charge_with_limit(fact, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            # The scalar witness builders use the linear-work ceiling internally. Seed that
            # counter with the part of the ceiling already unavailable to this shared source
            # walk, then charge only the delta below into source_work.
            source_remaining: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            linear_budget_start: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - source_remaining if source_remaining < PROOF_LINEAR_SAFETY_WORK_LIMIT else 0
            linear_budget: mutable usize = linear_budget_start
            exhausted: mutable bool = false
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, linear_budget, exhausted)
            if not markers_result.complete or exhausted:
                proof_replay_source_work_charge_or_exhaust(linear_budget - linear_budget_start, source_work)
                return (false, false)
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, linear_budget, exhausted)
            if not marker_scale.complete or exhausted:
                proof_replay_source_work_charge_or_exhaust(linear_budget - linear_budget_start, source_work)
                return (false, false)
            stable: bool = proof_expr_call_stable_core_with_work(expression, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth, markers_result.witnesses, marker_scale.scale, linear_budget, exhausted, source_work, name_scan_cost)
            if not proof_replay_source_work_charge_or_exhaust(linear_budget - linear_budget_start, source_work):
                return (false, false)
            return (false, false) if exhausted or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, stable)

        def proof_expr_call_stable_core_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, aliased: darray[sview]&, shared_extents: darray[sview]&, shared_fixed: darray[sview]&, local_extents: darray[sview]&, report: ProofReport&, owner: sview, depth: usize, markers: ProofScalarWitnesses&, marker_scale: usize, linear_budget: mutable usize&, exhausted: mutable bool&, source_work: mutable usize&, name_scan_cost: usize) -> bool:
            return false if:
                depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
                name_scan_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 8 or not proof_replay_source_work_charge_or_exhaust(name_scan_cost * 8, source_work)
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.ShorthandMember(parts, _):
                    return parts.count == 1 and parts[0] != ""
                Ast::Expr.Ident(name, _):
                    # A parameter bound by a shared borrow in a closed frame names storage nothing
                    # can write for the whole frame (`proof_record_shared_borrows`), so a term over
                    # it, `range_delta(t, ranges)`, is as stable as its other arguments (G75).
                    return true if (any fixed in shared_fixed where fixed == name) and proof_current_parameter(names, parameters, name)
                    return false if any existing in aliased where existing == name
                    # The exit symbol of a threaded call names that call's post value forever.
                    return true if any threaded in report.threading.threaded_symbols where threaded == name
                    # A registered match payload symbol is a constant of this frame's own storage.
                    payload_symbol: bool = proof_name_is_reserved_internal(name) and (any owned in local_extents where owned == name)
                    return false if not (any candidate in names where candidate == name) and not (any parameter in parameters where parameter == name) and not payload_symbol
                    # Such a symbol is registered only over a by-value, reference-free scrutinee,
                    # no source text can spell or assign it, and the payload tree it denotes is
                    # immutable, so it names one value whatever its type -- a sibling binder's
                    # value survives a structural recursive call on the other.
                    return true if payload_symbol
                    return proof_scalar_witnesses_name(markers, name)
                Ast::Expr.Scope(_, _, _):
                    return proof_source_global_constant_term_with_work(report, expression, owner, source_work)
                Ast::Expr.Tuple(_, _):
                    # A loop binder's atom `(name, offset)`: the binder is a local of this body.
                    binder: sview = proof_place_root_name(expression, 0)
                    return false if:
                        binder == ""
                        any existing in aliased where existing == binder
                        not (any candidate in names where candidate == binder)
                    return proof_call_stable_scalar_term_with_work(expression, markers, marker_scale, linear_budget, exhausted)
                Ast::Expr.Field(_, field_name, _):
                    return false if field_name == ""
                    root: sview = proof_place_root_name(expression, 0)
                    return false if root == ""
                    # A binding that holds its value rather than a reference to one, and that is
                    # named by no reference, receiver or opaque argument, is a binding no callee
                    # can reach at all -- the same argument the by-value scalar case above makes,
                    # applied to a field of it. `proof_collect_aliased_names` records a method
                    # receiver, so a collection a `push` is called on is excluded by its own use.
                    # This is what carries `node.children_start` across a call: `node` is a struct
                    # a callee has no path to, so its fields are as stable as a scalar local.
                    value_root: bool = (any owned in local_extents where owned == root) and not (any existing in aliased where existing == root) and (any candidate in names where candidate == root)
                    # The other place a call cannot change: the element count of a parameter bound
                    # by a shared borrow. Nothing may write through a shared borrow for its
                    # lifetime, and the borrow rule the compiler enforces means no mutable path to
                    # the same object coexists with it, so no callee -- whether or not it receives
                    # the borrow -- can push, pop or resize it.
                    shared_extent: bool = field_name == "count" and (any shared in shared_extents where shared == root)
                    # A shared borrow whose pointee holds no reference fixes every field under it,
                    # not only the count (`proof_record_shared_borrows`). The spelling must still
                    # be the parameter, not a local shadowing it.
                    shared_field: bool = (any fixed in shared_fixed where fixed == root) and proof_current_parameter(names, parameters, root)
                    return false if not value_root and not shared_extent and not shared_field
                    # The witness is still required, so a place that was never established as a
                    # scalar term is refused here exactly as an unwitnessed name is.
                    return proof_call_stable_scalar_term_with_work(expression, markers, marker_scale, linear_budget, exhausted)
                Ast::Expr.Array(elements, _):
                    # A literal collection is a value, not storage. Nothing a callee can reach
                    # makes `[]` hold something else, so a binding recorded as one keeps that
                    # record -- subject to the same reachability test on the binding itself that
                    # every other retained value passes.
                    for element in elements |facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost|:
                        return false if not proof_expr_call_stable_core_with_work(element, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost)
                    return true
                Ast::Expr.Call(_, arguments, _, _):
                    # A scalar-term marker is a statement about a term's *type*, so it is worth
                    # exactly what the term's identity is worth: if the term still denotes the same
                    # value after the call, the type statement about it still holds.
                    marker: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
                    return proof_expr_call_stable_core_with_work(marker.term, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost) if marker.known
                    # A width marker is the same kind of type statement, with a literal width.
                    width_marker_name: sview = proof_marker_callee_name(expression)
                    # A place width marker over a call result, `f(x)` typed from its declared return,
                    # is worth what that call term is worth, like the others.
                    if (width_marker_name in {"__elisa_unsigned_type_bound", "__elisa_signed_type_bound", "__elisa_signed_place_type_bound"}) and arguments.count == 2:
                        match arguments[1]:
                            Ast::Expr.IntLit(_, _):
                                return proof_expr_call_stable_core_with_work(arguments[0], facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost)
                            _:
                                return false
                    # A tracked scalar-reference state is a private symbolic binding, not an
                    # executable call. Branch joins may carry it only when its frozen scalar
                    # payload is independently stable. Calls that can reach the reference clear
                    # its binding in proof_forget_values_after_call before this restoration runs.
                    reference_state: (known: bool, value: Ast::Expr) = proof_scalar_reference_state_value(expression)
                    return proof_expr_call_stable_core_with_work(reference_state.value, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost) if reference_state.known
                    # An ordinary call term keeps its value across another call when a pure-call
                    # witness says it denotes one value, and its arguments are themselves stable
                    # so the same text still names the same arguments. This is what carries a
                    # callee's summary -- `not f(...) or p` -- past the next call in the body,
                    # together with the witness recorded beside that fact when it is built.
                    return false if not proof_call_stable_scalar_term_with_work(expression, markers, marker_scale, linear_budget, exhausted)
                    for argument in arguments |facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost, name_scan_entries|:
                        value_shape: (complete: bool, supported: bool, cost: usize, terminal_name: sview) = proof_value_argument_shape_with_work(argument, source_work, 0)
                        return false if not value_shape.complete
                        if value_shape.supported:
                            # The shape walk already paid for one AST pass. The value shortcut
                            # traverses that chain once more and scans membership lists only at
                            # its terminal identifier, so reserve one chain cost plus one bounded
                            # list scan instead of multiplying every field/paren by list size.
                            reserved_name_entries: usize = name_scan_entries + PROOF_INTERNAL_REBIND_SYMBOL_COUNT + 24
                            terminal_name_bytes: usize = sview_len(value_shape.terminal_name)
                            return false if terminal_name_bytes != 0 and reserved_name_entries > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / terminal_name_bytes
                            membership_work: usize = name_scan_cost + terminal_name_bytes * reserved_name_entries
                            return false if value_shape.cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                            remaining_after_chain: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work - value_shape.cost
                            return false if membership_work > remaining_after_chain
                            return false if not proof_replay_source_work_charge_or_exhaust(value_shape.cost + membership_work, source_work)
                            continue if proof_value_argument_stable(argument, names, parameters, aliased, local_extents, 0)
                        return false if not proof_expr_call_stable_core_with_work(argument, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_call_stable_core_with_work(inner, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost)
                Ast::Expr.Unary(operator, operand, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Not
                    return proof_expr_call_stable_core_with_work(operand, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost)
                Ast::Expr.Binary(left, operator, right, _):
                    # A formed nullable value's null test is not a scalar
                    # pointee read. Keep only a bare live binding that no call
                    # can reach; aliased/lent roots remain invalidated. Source
                    # proposition formation and replay check null-test typing.
                    if operator == TokenKind.EqEq or operator == TokenKind.BangEq:
                        a: sview = proof_ident_name(left)
                        b: sview = proof_ident_name(right)
                        tested: sview = b if a == "null" else a
                        if (a == "null" or b == "null") and tested != "" and tested != "null":
                            return not (any blocked in aliased where blocked == tested) and ((any live in names where live == tested) or (any parameter in parameters where parameter == tested))
                    return proof_expr_call_stable_core_with_work(left, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost) and proof_expr_call_stable_core_with_work(right, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_expr_call_stable_core_with_work(condition, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost) and proof_expr_call_stable_core_with_work(then_expression, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost) and proof_expr_call_stable_core_with_work(else_expression, facts, names, parameters, aliased, shared_extents, shared_fixed, local_extents, report, owner, depth + 1, markers, marker_scale, linear_budget, exhausted, source_work, name_scan_cost)
                _:
                    return false

        # A by-value, reference-free binding no reference, receiver or opaque argument names is
        # storage no callee can reach, so it denotes the same value after a call whatever its
        # type: an enum or struct argument keeps a pure callee's summary term meaningful exactly
        # as a scalar one does. The binding is a current local or parameter, or a match payload
        # symbol `proof_freshen_opaque_bindings` registered because its scrutinee is such a
        # binding. A field chain under it is part of the same value. An index is not followed:
        # its subscript is a separate term with its own stability question.
        # First recognize the narrow place-chain subset. Complex arguments are rejected by the
        # value shortcut at their root, so charging a full repeated AST/list scan for them would
        # spend budget on work the classifier never performs. This bounded prefix scan is charged
        # independently; supported chains reserve one metered shortcut traversal and terminal
        # membership scan.
        def proof_value_argument_shape_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, supported: bool, cost: usize, terminal_name: sview):
            return (true, false, 0, "") if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            return (false, false, 0, "") if not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, false, 0, "") if not proof_replay_source_work_charge_or_exhaust(sview_len(name), source_work)
                    return (true, name != "", 1 + sview_len(name), name)
                Ast::Expr.Field(object, field_name, _):
                    return (false, false, 0, "") if not proof_replay_source_work_charge_or_exhaust(sview_len(field_name), source_work)
                    return (true, false, 1 + sview_len(field_name), "") if field_name == ""
                    nested: (complete: bool, supported: bool, cost: usize, terminal_name: sview) = proof_value_argument_shape_with_work(object, source_work, depth + 1)
                    (nested.complete, nested.supported, nested.cost + 1 + sview_len(field_name), nested.terminal_name)
                Ast::Expr.Paren(inner, _):
                    nested: (complete: bool, supported: bool, cost: usize, terminal_name: sview) = proof_value_argument_shape_with_work(inner, source_work, depth + 1)
                    (nested.complete, nested.supported, nested.cost + 1, nested.terminal_name)
                _:
                    (true, false, 1, "")

        def proof_value_argument_stable(expression: Ast::Expr, names: darray[sview]&, parameters: darray[sview]&, aliased: darray[sview]&, local_extents: darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if:
                        name == "" or not (any owned in local_extents where owned == name)
                        any existing in aliased where existing == name
                    return (any candidate in names where candidate == name) or (any parameter in parameters where parameter == name) or proof_name_is_reserved_internal(name)
                Ast::Expr.Field(object, field_name, _):
                    return false if field_name == ""
                    return proof_value_argument_stable(object, names, parameters, aliased, local_extents, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_value_argument_stable(inner, names, parameters, aliased, local_extents, depth + 1)
                _:
                    return false

        # The binding a pure place names through fields alone, or "" for any other form.
        def proof_value_place_root(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, field_name, _):
                    return "" if field_name == ""
                    return proof_value_place_root(object, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_value_place_root(inner, depth + 1)
                _:
                    return ""

        # Re-establish, after a nested opaque call, every pre-call fact that is call-stable for
        # the current function. Witnesses are read from the pre-call state, which still holds
        # every type bound the call could not remove.
        # The roots one expression lends. A lend that ends with its call is a write during that
        # call and nothing afterwards, so the call performing it is the one place its binding has
        # to be treated as reachable. Collected without the confinement refinement, which is the
        # point: this is the lend itself.

include "./alias_stability_integrated_helpers.elisa"
