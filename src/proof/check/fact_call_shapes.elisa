# The generic fact publishers do not have the live ProofFunctionTable in their API.
# Keep the minimal source-derived resolver data in the report so every publisher can
# apply the same return-shape rule without trusting an unqualified leaf-name map.
extend ElisaProof:
    private:
        const PROOF_FACT_CALL_SHADOW_QUERY_LIMIT: usize = 4096
        const PROOF_FACT_CALL_SHADOW_QUERY_INDEX_CAPACITY: usize = 8192
        const PROOF_FACT_NUMERIC_CAST_TARGET_COUNT: usize = 14

        def proof_fact_numeric_cast_target_index(target: sview) -> usize:
            return when target:
                "i8" -> 0
                "i16" -> 1
                "i32" -> 2
                "i64" -> 3
                "int" -> 4
                "isize" -> 5
                "u8" -> 6
                "u16" -> 7
                "u32" -> 8
                "u64" -> 9
                "usize" -> 10
                "uintptr" -> 11
                "f32" -> 12
                "f64" -> 13
                _ -> PROOF_FACT_NUMERIC_CAST_TARGET_COUNT

        def proof_fact_extern_name_declared(functions: ProofFunctionTable&, name: sview) -> bool:
            count: usize = functions.externs.extern_signatures.count
            return false if count == 0
            capacity: usize = functions.externs.extern_index_values.count
            return true if capacity == 0 or capacity != functions.externs.extern_index_hashes.count or capacity != functions.externs.extern_index_ambiguous.count or capacity != functions.externs.extern_index_callable.count or capacity != proof_name_index_capacity(count)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, functions, capacity, count|:
                current: usize = functions.externs.extern_index_values[slot]
                return false if current == count
                return true if current > count
                if functions.externs.extern_index_hashes[slot] == wanted_hash:
                    return true if current >= functions.externs.extern_signatures.count
                    signature: ProofExternSignature = functions.externs.extern_signatures[current]
                    if signature.name == name:
                        return true
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return true

        def proof_build_fact_call_shape_indexes(functions: mutable ProofFunctionTable&, source_work: mutable usize&) -> (complete: bool, reason: sview, observed: usize, limit: usize):
            functions.externs.extern_index_hashes.clear()
            functions.externs.extern_index_values.clear()
            functions.externs.extern_index_ambiguous.clear()
            functions.externs.extern_index_callable.clear()
            extern_count: usize = functions.externs.extern_signatures.count
            if extern_count > 0:
                capacity: usize = proof_name_index_capacity(extern_count)
                return (false, "extern-name-index-entries", extern_count, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2) if capacity == 0
                return (false, "extern-name-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                    not proof_report_source_work_charge(capacity, source_work)
                    not proof_report_source_work_charge(extern_count, source_work)
                functions.externs.extern_index_hashes.resize(capacity)
                functions.externs.extern_index_values.resize(capacity)
                functions.externs.extern_index_ambiguous.resize(capacity)
                functions.externs.extern_index_callable.resize(capacity)
                for slot in 0..<capacity |slot, functions, extern_count|:
                    functions.externs.extern_index_values[slot] <- extern_count
                    functions.externs.extern_index_ambiguous[slot] <- false
                    functions.externs.extern_index_callable[slot] <- false
                for index in 0..<extern_count |index, functions, capacity, extern_count|:
                    signature: ProofExternSignature = functions.externs.extern_signatures[index]
                    return (false, "extern-name-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(signature.name), source_work)
                    hash: u32 = proof_name_hash(signature.name)
                    slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                    probes: mutable usize = 0
                    placed: mutable bool = false
                    while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, index, functions, capacity, extern_count, placed|:
                        return (false, "extern-name-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                        current: usize = functions.externs.extern_index_values[slot]
                        if current == extern_count:
                            functions.externs.extern_index_hashes[slot] <- hash
                            functions.externs.extern_index_values[slot] <- index
                            functions.externs.extern_index_callable[slot] <- signature.callable
                            placed <- true
                            break
                        if current < extern_count and functions.externs.extern_index_hashes[slot] == hash:
                            current_name: sview = functions.externs.extern_signatures[current].name
                            return (false, "extern-name-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(current_name), source_work)
                            if current_name == signature.name:
                                functions.externs.extern_index_ambiguous[slot] <- true
                                functions.externs.extern_index_callable[slot] <- true if signature.callable
                                placed <- true
                                break
                        slot <- (slot + 1) % capacity
                        probes <- probes + 1
                    return (false, "extern-name-index-insertion", probes, capacity) if not placed
                cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(functions.externs.extern_index_values, extern_count, source_work)
                return (false, "extern-name-index-work", cluster_status.observed, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not cluster_status.complete
                return (false, "extern-name-index-cluster", cluster_status.observed, PROOF_NAME_INDEX_MAX_CLUSTER) if not cluster_status.bounded

            functions.externs.custom_cast_hook_present <- false
            if functions.lookup.names.count > 0:
                source_hook: usize = proof_function_index(functions, "__cast__")
                functions.externs.custom_cast_hook_present <- source_hook < functions.lookup.names.count or proof_function_name_may_repeat(functions, "__cast__")
            for signature in functions.externs.extern_signatures |functions, source_work|:
                return (false, "numeric-cast-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                    not proof_report_source_work_charge(1, source_work)
                    not proof_report_source_work_charge(sview_len(signature.name), source_work)
                functions.externs.custom_cast_hook_present <- true if signature.name == "__cast__" and signature.declared_arity == 1 and signature.callable
            return (true, "", 0, 0)

        def proof_fact_call_shape_snapshot_reset(snapshot: mutable ProofFactCallShapeSnapshot&) -> void:
            snapshot.status.initialized <- false
            snapshot.status.complete <- false
            snapshot.status.source_check_active <- false
            snapshot.status.source_identity <- 0
            snapshot.status.source_fingerprint <- 0
            snapshot.status.active_caller <- 0
            snapshot.status.active_caller_line <- 0
            snapshot.status.lookup_work_used <- 0
            snapshot.status.lookup_work_exhausted <- false
            snapshot.status.lookup_budget_reported <- false
            snapshot.functions.function_names.clear()
            snapshot.functions.function_lines.clear()
            snapshot.functions.owner_modules.clear()
            snapshot.functions.module_aliases.names.clear()
            snapshot.functions.module_aliases.targets.clear()
            snapshot.functions.module_aliases.scopes.clear()
            snapshot.functions.module_aliases.lines.clear()
            snapshot.functions.module_aliases.offsets.clear()
            snapshot.functions.module_aliases.alias_lookup_hashes.clear()
            snapshot.functions.module_aliases.alias_lookup_values.clear()
            snapshot.functions.module_aliases.alias_lookup_ambiguous.clear()
            snapshot.functions.module_aliases.global_alias_lookup_hashes.clear()
            snapshot.functions.module_aliases.global_alias_lookup_values.clear()
            snapshot.functions.module_aliases.function_lookup_hashes.clear()
            snapshot.functions.module_aliases.function_lookup_values.clear()
            snapshot.functions.module_aliases.function_lookup_ambiguous.clear()
            snapshot.functions.module_aliases.function_lookup_complete <- false
            snapshot.functions.module_aliases.complete <- false
            snapshot.functions.module_prefixes.clear()
            snapshot.functions.declaration_path_starts.clear()
            snapshot.functions.declaration_path_counts.clear()
            snapshot.functions.all_declaration_path.clear()
            snapshot.functions.name_hashes.clear()
            snapshot.functions.index_hashes.clear()
            snapshot.functions.index_values.clear()
            snapshot.functions.index_ambiguous.clear()
            snapshot.returns.return_scalar.clear()
            snapshot.returns.return_pure.clear()
            snapshot.returns.return_deterministic.clear()
            snapshot.returns.return_verified.clear()
            snapshot.returns.return_verification_reasons.clear()
            snapshot.signatures.param_starts.clear()
            snapshot.signatures.param_counts.clear()
            snapshot.signatures.all_params.clear()
            snapshot.signatures.signature_contract_starts.clear()
            snapshot.signatures.signature_contract_counts.clear()
            snapshot.signatures.all_signature_contracts.clear()
            snapshot.externs.extern_names.clear()
            snapshot.externs.extern_arities.clear()
            snapshot.externs.extern_callable.clear()
            snapshot.externs.extern_index_hashes.clear()
            snapshot.externs.extern_index_values.clear()
            snapshot.externs.extern_index_ambiguous.clear()
            snapshot.externs.extern_index_callable.clear()
            snapshot.status.custom_cast_hook_present <- false
            snapshot.shadow_queries.shadow_query_callers.clear()
            snapshot.shadow_queries.shadow_query_hashes.clear()
            snapshot.shadow_queries.shadow_query_offsets.clear()
            snapshot.shadow_queries.shadow_query_names.clear()
            snapshot.shadow_queries.shadow_query_results.clear()
            snapshot.shadow_queries.shadow_query_index.clear()

        def proof_fact_call_shape_charge(snapshot: mutable ProofFactCallShapeSnapshot&, amount: usize) -> bool:
            if snapshot.status.lookup_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                snapshot.status.lookup_work_exhausted <- true
                return false
            if amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - snapshot.status.lookup_work_used:
                snapshot.status.lookup_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                snapshot.status.lookup_work_exhausted <- true
                return false
            snapshot.status.lookup_work_used <- snapshot.status.lookup_work_used + amount
            true

        def proof_fact_call_shape_begin_caller(report: mutable ProofReport&, functions: mutable ProofFunctionTable&, target: usize) -> usize:
            saved_caller: usize = functions.call_graph.current_caller
            functions.call_graph.current_caller <- target
            report.analysis_2.fact_call_shapes.status.active_caller <- target
            report.analysis_2.fact_call_shapes.status.active_caller_line <- functions.lookup.lines[target] if target < functions.lookup.lines.count else 0
            report.analysis_2.finding_function <- functions.lookup.names[target]
            report.analysis_2.finding_owner <- functions.lookup.owner_modules[target]
            report.analysis_2.finding_line <- functions.lookup.lines[target] if target < functions.lookup.lines.count else 0
            report.analysis_2.finding_offset <- functions.lookup.offsets[target] if target < functions.lookup.offsets.count else 0
            report.analysis_2.finding_caller_index <- target
            return saved_caller

        def proof_fact_call_shape_end_caller(report: mutable ProofReport&, functions: mutable ProofFunctionTable&, saved_caller: usize) -> void:
            report.analysis_2.finding_function <- ""
            report.analysis_2.finding_owner <- ""
            report.analysis_2.finding_line <- 0
            report.analysis_2.finding_offset <- 0
            report.analysis_2.finding_caller_index <- functions.lookup.names.count
            functions.call_graph.current_caller <- saved_caller
            report.analysis_2.fact_call_shapes.status.active_caller <- functions.lookup.names.count
            report.analysis_2.fact_call_shapes.status.active_caller_line <- 0

        # Called by proof_check_core after function resolution and before any function body can
        # publish a fact. The source identity is pre-stamped only by the checked source entry
        # point; compatibility checks therefore keep call-bearing generic facts disabled.
        def proof_build_fact_call_shape_snapshot(file: Ast::File&, report: mutable ProofReport&, functions: ProofFunctionTable&, source_work: mutable usize&) -> (complete: bool, reason: sview, observed: usize, limit: usize):
            snapshot: mutable ProofFactCallShapeSnapshot& = &report.analysis_2.fact_call_shapes
            source_identity: uintptr = snapshot.status.source_identity if snapshot.status.source_check_active else 0
            source_fingerprint: u32 = snapshot.status.source_fingerprint if snapshot.status.source_check_active else 0
            snapshot.status.initialized <- false
            snapshot.status.complete <- false
            snapshot.status.source_identity <- source_identity
            snapshot.status.source_fingerprint <- source_fingerprint
            snapshot.status.active_caller <- functions.lookup.names.count
            snapshot.status.active_caller_line <- 0
            snapshot.status.lookup_work_used <- 0
            snapshot.status.lookup_work_exhausted <- false
            snapshot.status.lookup_budget_reported <- false
            snapshot.functions.function_names.clear()
            snapshot.functions.function_lines.clear()
            snapshot.functions.owner_modules.clear()
            snapshot.functions.module_aliases.names.clear()
            snapshot.functions.module_aliases.targets.clear()
            snapshot.functions.module_aliases.scopes.clear()
            snapshot.functions.module_aliases.lines.clear()
            snapshot.functions.module_aliases.offsets.clear()
            snapshot.functions.module_aliases.alias_lookup_hashes.clear()
            snapshot.functions.module_aliases.alias_lookup_values.clear()
            snapshot.functions.module_aliases.alias_lookup_ambiguous.clear()
            snapshot.functions.module_aliases.global_alias_lookup_hashes.clear()
            snapshot.functions.module_aliases.global_alias_lookup_values.clear()
            snapshot.functions.module_aliases.function_lookup_hashes.clear()
            snapshot.functions.module_aliases.function_lookup_values.clear()
            snapshot.functions.module_aliases.function_lookup_ambiguous.clear()
            snapshot.functions.module_aliases.function_lookup_complete <- false
            snapshot.functions.module_aliases.complete <- false
            snapshot.functions.module_prefixes.clear()
            snapshot.functions.declaration_path_starts.clear()
            snapshot.functions.declaration_path_counts.clear()
            snapshot.functions.all_declaration_path.clear()
            snapshot.functions.name_hashes.clear()
            snapshot.functions.index_hashes.clear()
            snapshot.functions.index_values.clear()
            snapshot.functions.index_ambiguous.clear()
            snapshot.returns.return_scalar.clear()
            snapshot.returns.return_pure.clear()
            snapshot.returns.return_deterministic.clear()
            snapshot.returns.return_verified.clear()
            snapshot.returns.return_verification_reasons.clear()
            snapshot.signatures.param_starts.clear()
            snapshot.signatures.param_counts.clear()
            snapshot.signatures.all_params.clear()
            snapshot.signatures.signature_contract_starts.clear()
            snapshot.signatures.signature_contract_counts.clear()
            snapshot.signatures.all_signature_contracts.clear()
            snapshot.externs.extern_names.clear()
            snapshot.externs.extern_arities.clear()
            snapshot.externs.extern_callable.clear()
            snapshot.externs.extern_index_hashes.clear()
            snapshot.externs.extern_index_values.clear()
            snapshot.externs.extern_index_ambiguous.clear()
            snapshot.externs.extern_index_callable.clear()
            snapshot.shadow_queries.shadow_query_callers.clear()
            snapshot.shadow_queries.shadow_query_hashes.clear()
            snapshot.shadow_queries.shadow_query_offsets.clear()
            snapshot.shadow_queries.shadow_query_names.clear()
            snapshot.shadow_queries.shadow_query_results.clear()
            snapshot.shadow_queries.shadow_query_index.clear()
            return (false, "fact-call-shape-table", functions.lookup.names.count, 0) if functions.lookup.names.count != functions.lookup.lines.count or functions.lookup.names.count != functions.lookup.offsets.count or functions.lookup.names.count != functions.lookup.owner_modules.count or functions.lookup.names.count != functions.lookup.module_prefixes.count or functions.lookup.names.count != functions.lookup.declaration_path_starts.count or functions.lookup.names.count != functions.lookup.declaration_path_counts.count or functions.lookup.names.count != functions.returns.return_scalar.count or functions.lookup.names.count != functions.parameters.metadata.param_starts.count or functions.lookup.names.count != functions.parameters.metadata.param_counts.count
            return (false, "fact-call-shape-index", functions.lookup.index_values.count, functions.lookup.index_hashes.count) if functions.lookup.index_values.count != functions.lookup.index_hashes.count or functions.lookup.index_values.count != functions.lookup.index_ambiguous.count
            extern_count: usize = functions.externs.extern_signatures.count
            extern_capacity: usize = functions.externs.extern_index_values.count
            return (false, "fact-call-shape-extern-index", extern_capacity, functions.externs.extern_index_hashes.count) if extern_capacity != functions.externs.extern_index_hashes.count or extern_capacity != functions.externs.extern_index_ambiguous.count or extern_capacity != functions.externs.extern_index_callable.count
            return (false, "fact-call-shape-extern-index", extern_count, extern_capacity) if (extern_count == 0 and extern_capacity != 0) or (extern_count > 0 and (extern_capacity == 0 or extern_capacity != proof_name_index_capacity(extern_count)))
            return (false, "fact-call-shape-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                functions.lookup.names.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 10
                extern_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3
                extern_capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                not proof_report_source_work_charge(functions.lookup.names.count * 10, source_work)
                not proof_report_source_work_charge(functions.lookup.all_declaration_path.count, source_work)
                not proof_report_source_work_charge(functions.parameters.metadata.all_params.count, source_work)
                not proof_report_source_work_charge(functions.externs.extern_signatures.count * 3, source_work)
                not proof_report_source_work_charge(extern_capacity * 4, source_work)
            snapshot.functions.function_names.extend(functions.lookup.names)
            snapshot.functions.function_lines.extend(functions.lookup.lines)
            snapshot.functions.owner_modules.extend(functions.lookup.owner_modules)
            if functions.lookup.module_aliases.names.count != functions.lookup.module_aliases.targets.count or functions.lookup.module_aliases.names.count != functions.lookup.module_aliases.scopes.count or functions.lookup.module_aliases.names.count != functions.lookup.module_aliases.lines.count or functions.lookup.module_aliases.names.count != functions.lookup.module_aliases.offsets.count:
                return (false, "fact-call-shape-alias-table", functions.lookup.module_aliases.names.count, functions.lookup.module_aliases.targets.count)
            alias_capacity: usize = functions.lookup.module_aliases.alias_lookup_values.count
            return (false, "fact-call-shape-alias-index", alias_capacity, functions.lookup.module_aliases.alias_lookup_hashes.count) if alias_capacity != functions.lookup.module_aliases.alias_lookup_hashes.count or alias_capacity != functions.lookup.module_aliases.alias_lookup_ambiguous.count or alias_capacity != proof_name_index_capacity(functions.lookup.module_aliases.names.count)
            global_alias_capacity: usize = functions.lookup.module_aliases.global_alias_lookup_values.count
            return (false, "fact-call-shape-global-alias-index", global_alias_capacity, functions.lookup.module_aliases.global_alias_lookup_hashes.count) if global_alias_capacity != functions.lookup.module_aliases.global_alias_lookup_hashes.count or global_alias_capacity != alias_capacity
            function_capacity: usize = functions.lookup.module_aliases.function_lookup_values.count
            return (false, "fact-call-shape-function-index", function_capacity, functions.lookup.module_aliases.function_lookup_hashes.count) if not functions.lookup.module_aliases.function_lookup_complete or function_capacity != functions.lookup.module_aliases.function_lookup_hashes.count or function_capacity != functions.lookup.module_aliases.function_lookup_ambiguous.count or function_capacity != proof_name_index_capacity(functions.lookup.names.count)
            return (false, "fact-call-shape-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                functions.lookup.module_aliases.names.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 5
                not proof_report_source_work_charge(functions.lookup.module_aliases.names.count * 5, source_work)
            for alias_index in 0..<functions.lookup.module_aliases.names.count |alias_index, functions, source_work|:
                return (false, "fact-call-shape-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                    not proof_report_source_work_charge(sview_len(functions.lookup.module_aliases.names[alias_index]), source_work)
                    not proof_report_source_work_charge(sview_len(functions.lookup.module_aliases.targets[alias_index]), source_work)
                    not proof_report_source_work_charge(sview_len(functions.lookup.module_aliases.scopes[alias_index]), source_work)
            snapshot.functions.module_aliases.names.extend(functions.lookup.module_aliases.names)
            snapshot.functions.module_aliases.targets.extend(functions.lookup.module_aliases.targets)
            snapshot.functions.module_aliases.scopes.extend(functions.lookup.module_aliases.scopes)
            snapshot.functions.module_aliases.lines.extend(functions.lookup.module_aliases.lines)
            snapshot.functions.module_aliases.offsets.extend(functions.lookup.module_aliases.offsets)
            return (false, "fact-call-shape-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                alias_capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3 or global_alias_capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2 or function_capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3
                not proof_report_source_work_charge(alias_capacity * 3, source_work) or not proof_report_source_work_charge(global_alias_capacity * 2, source_work) or not proof_report_source_work_charge(function_capacity * 3, source_work)
            snapshot.functions.module_aliases.alias_lookup_hashes.extend(functions.lookup.module_aliases.alias_lookup_hashes)
            snapshot.functions.module_aliases.alias_lookup_values.extend(functions.lookup.module_aliases.alias_lookup_values)
            snapshot.functions.module_aliases.alias_lookup_ambiguous.extend(functions.lookup.module_aliases.alias_lookup_ambiguous)
            snapshot.functions.module_aliases.global_alias_lookup_hashes.extend(functions.lookup.module_aliases.global_alias_lookup_hashes)
            snapshot.functions.module_aliases.global_alias_lookup_values.extend(functions.lookup.module_aliases.global_alias_lookup_values)
            snapshot.functions.module_aliases.function_lookup_hashes.extend(functions.lookup.module_aliases.function_lookup_hashes)
            snapshot.functions.module_aliases.function_lookup_values.extend(functions.lookup.module_aliases.function_lookup_values)
            snapshot.functions.module_aliases.function_lookup_ambiguous.extend(functions.lookup.module_aliases.function_lookup_ambiguous)
            snapshot.functions.module_aliases.function_lookup_complete <- functions.lookup.module_aliases.function_lookup_complete
            snapshot.functions.module_aliases.complete <- functions.lookup.module_aliases.complete
            snapshot.functions.module_prefixes.extend(functions.lookup.module_prefixes)
            snapshot.functions.declaration_path_starts.extend(functions.lookup.declaration_path_starts)
            snapshot.functions.declaration_path_counts.extend(functions.lookup.declaration_path_counts)
            snapshot.functions.all_declaration_path.extend(functions.lookup.all_declaration_path)
            snapshot.functions.name_hashes.extend(functions.lookup.name_hashes)
            snapshot.functions.index_hashes.extend(functions.lookup.index_hashes)
            snapshot.functions.index_values.extend(functions.lookup.index_values)
            snapshot.functions.index_ambiguous.extend(functions.lookup.index_ambiguous)
            snapshot.returns.return_scalar.extend(functions.returns.return_scalar)
            snapshot.returns.return_pure.resize(functions.lookup.names.count)
            snapshot.returns.return_deterministic.resize(functions.lookup.names.count)
            snapshot.returns.return_verified.resize(functions.lookup.names.count)
            snapshot.returns.return_verification_reasons.resize(functions.lookup.names.count)
            snapshot.signatures.param_starts.extend(functions.parameters.metadata.param_starts)
            snapshot.signatures.param_counts.extend(functions.parameters.metadata.param_counts)
            snapshot.signatures.all_params.extend(functions.parameters.metadata.all_params)
            contract_rows: usize = file.signature_contract_lines.count
            return (false, "fact-call-shape-contract-table", contract_rows, file.signature_contract_exprs.count) if contract_rows != file.signature_contract_kinds.count or contract_rows != file.signature_contract_exprs.count
            contract_cursor: mutable usize = 0
            previous_contract_line: mutable u32 = 0
            contract_line_seen: mutable bool = false
            pending_contract_row_charged: mutable bool = false
            previous_function_line: mutable u32 = 0
            function_line_seen: mutable bool = false
            active_group_line: mutable u32 = 0
            active_group_start: mutable usize = 0
            active_group_count: mutable usize = 0
            active_group_seen: mutable bool = false
            for caller in 0..<functions.lookup.names.count |caller, functions, file, snapshot, contract_rows, source_work, contract_cursor, previous_contract_line, contract_line_seen, pending_contract_row_charged, previous_function_line, function_line_seen, active_group_line, active_group_start, active_group_count, active_group_seen|:
                return (false, "fact-call-shape-contract-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                return (false, "fact-call-shape-contract-table", caller, functions.lookup.lines.count) if caller >= functions.lookup.lines.count
                function_line: u32 = functions.lookup.lines[caller]
                return (false, "fact-call-shape-function-line-order", function_line, previous_function_line) if function_line_seen and function_line < previous_function_line
                previous_function_line <- function_line
                function_line_seen <- true
                if not active_group_seen or function_line != active_group_line:
                    active_group_seen <- true
                    active_group_line <- function_line
                    active_group_start <- snapshot.signatures.all_signature_contracts.count
                    active_group_count <- 0
                    while contract_cursor < contract_rows |contract_cursor, file, snapshot, contract_rows, source_work, previous_contract_line, contract_line_seen, pending_contract_row_charged, function_line, active_group_count|:
                        row_line: u32 = file.signature_contract_lines[contract_cursor]
                        return (false, "fact-call-shape-contract-line-order", row_line, previous_contract_line) if contract_line_seen and row_line < previous_contract_line
                        previous_contract_line <- row_line
                        contract_line_seen <- true
                        kind: sview = file.signature_contract_kinds[contract_cursor]
                        if not pending_contract_row_charged:
                            return (false, "fact-call-shape-contract-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                                not proof_report_source_work_charge(1, source_work)
                                not proof_report_source_work_charge(sview_len(kind), source_work)
                            pending_contract_row_charged <- true
                        if row_line > function_line:
                            break
                        if row_line == function_line and (kind in {"requires", "ensure"}):
                            expression: Ast::Expr = file.signature_contract_exprs[contract_cursor]
                            position: Ast::Pos = Ast::expr_pos(expression)
                            expression_span: (valid: bool, contains: bool) = proof_fact_call_shape_source_span_contains(position, position.offset)
                            return (false, "fact-call-shape-contract-span", contract_cursor, contract_rows) if not expression_span.valid
                            return (false, "fact-call-shape-contract-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                                position.end_offset < position.offset
                                not proof_report_source_work_charge((position.end_offset - position.offset).usize(), source_work)
                            snapshot.signatures.all_signature_contracts.push(expression)
                            active_group_count <- active_group_count + 1
                        contract_cursor <- contract_cursor + 1
                        pending_contract_row_charged <- false
                return (false, "fact-call-shape-contract-range", active_group_start, snapshot.signatures.all_signature_contracts.count) if active_group_start > snapshot.signatures.all_signature_contracts.count
                return (false, "fact-call-shape-contract-range", active_group_count, snapshot.signatures.all_signature_contracts.count - active_group_start) if active_group_count > snapshot.signatures.all_signature_contracts.count - active_group_start
                snapshot.signatures.signature_contract_starts.push(active_group_start)
                snapshot.signatures.signature_contract_counts.push(active_group_count)
            while contract_cursor < contract_rows |contract_cursor, file, contract_rows, source_work, previous_contract_line, contract_line_seen, pending_contract_row_charged|:
                row_line: u32 = file.signature_contract_lines[contract_cursor]
                return (false, "fact-call-shape-contract-line-order", row_line, previous_contract_line) if contract_line_seen and row_line < previous_contract_line
                previous_contract_line <- row_line
                contract_line_seen <- true
                kind: sview = file.signature_contract_kinds[contract_cursor]
                if not pending_contract_row_charged:
                    return (false, "fact-call-shape-contract-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                        not proof_report_source_work_charge(1, source_work)
                        not proof_report_source_work_charge(sview_len(kind), source_work)
                contract_cursor <- contract_cursor + 1
                pending_contract_row_charged <- false
            return (false, "fact-call-shape-contract-shape", snapshot.signatures.signature_contract_starts.count, functions.lookup.names.count) if snapshot.signatures.signature_contract_starts.count != functions.lookup.names.count or snapshot.signatures.signature_contract_counts.count != functions.lookup.names.count
            for signature in functions.externs.extern_signatures |snapshot, source_work|:
                return (false, "fact-call-shape-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                    not proof_report_source_work_charge(1, source_work)
                    not proof_report_source_work_charge(sview_len(signature.name), source_work)
                snapshot.externs.extern_names.push(signature.name)
                snapshot.externs.extern_arities.push(signature.declared_arity)
                snapshot.externs.extern_callable.push(signature.callable)
            snapshot.externs.extern_index_hashes.extend(functions.externs.extern_index_hashes)
            snapshot.externs.extern_index_values.extend(functions.externs.extern_index_values)
            snapshot.externs.extern_index_ambiguous.extend(functions.externs.extern_index_ambiguous)
            snapshot.externs.extern_index_callable.extend(functions.externs.extern_index_callable)
            snapshot.status.custom_cast_hook_present <- functions.externs.custom_cast_hook_present
            snapshot.status.complete <- source_identity != 0
            snapshot.status.initialized <- true
            return (true, "", 0, 0)

        def proof_fact_call_shape_snapshot_purity(snapshot: mutable ProofFactCallShapeSnapshot&, functions: ProofFunctionTable&, source_work: mutable usize&) -> (complete: bool, reason: sview, observed: usize, limit: usize):
            count: usize = snapshot.functions.function_names.count
            return (true, "", 0, 0) if not snapshot.status.complete
            return (false, "fact-call-shape-purity", functions.summaries.pure.count, count) if functions.summaries.pure.count != count or functions.summaries.deterministic.count != count or snapshot.returns.return_pure.count != count or snapshot.returns.return_deterministic.count != count
            return (false, "fact-call-shape-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2 or not proof_report_source_work_charge(count * 2, source_work)
            for index in 0..<count |index, snapshot, functions|:
                snapshot.returns.return_pure[index] <- functions.summaries.pure[index]
                snapshot.returns.return_deterministic[index] <- functions.summaries.deterministic[index]
            return (true, "", 0, 0)

        def proof_fact_call_shape_update_verification(report: mutable ProofReport&, functions: ProofFunctionTable&, function_index: usize) -> void:
            snapshot: mutable ProofFactCallShapeSnapshot& = &report.analysis_2.fact_call_shapes
            return if not snapshot.status.complete or not snapshot.status.source_check_active or function_index >= snapshot.returns.return_verified.count or function_index >= snapshot.returns.return_verification_reasons.count
            return if function_index >= functions.summaries.verified.count or function_index >= functions.summaries.verification_reasons.count
            snapshot.returns.return_verified[function_index] <- functions.summaries.verified[function_index]
            snapshot.returns.return_verification_reasons[function_index] <- functions.summaries.verification_reasons[function_index]

        def proof_fact_call_shape_function_index(snapshot: mutable ProofFactCallShapeSnapshot&, name: sview) -> usize:
            count: usize = snapshot.functions.function_names.count
            return count if:
                snapshot.functions.index_values.count == 0 or snapshot.functions.index_values.count != snapshot.functions.index_hashes.count or snapshot.functions.index_values.count != snapshot.functions.index_ambiguous.count
                not proof_fact_call_shape_charge(snapshot, sview_len(name))
            wanted_hash: u32 = proof_name_hash(name)
            capacity: usize = snapshot.functions.index_values.count
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, snapshot, capacity, count|:
                return count if not proof_fact_call_shape_charge(snapshot, 1)
                current: usize = snapshot.functions.index_values[slot]
                return count if current == count or current > count
                if snapshot.functions.index_hashes[slot] == wanted_hash:
                    return count if:
                        snapshot.functions.index_ambiguous[slot]
                        not proof_fact_call_shape_charge(snapshot, sview_len(snapshot.functions.function_names[current]))
                    return current if snapshot.functions.function_names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return count

        def proof_fact_call_shape_same_module(snapshot: mutable ProofFactCallShapeSnapshot&, row: usize, caller: usize) -> bool:
            return false if row >= snapshot.functions.module_prefixes.count or caller >= snapshot.functions.module_prefixes.count
            prefix: usize = snapshot.functions.module_prefixes[row]
            return false if prefix != snapshot.functions.module_prefixes[caller]
            return proof_fact_call_shape_path_prefix_equal(snapshot, row, caller, prefix)

        def proof_fact_call_shape_in_enclosing_module(snapshot: mutable ProofFactCallShapeSnapshot&, row: usize, caller: usize) -> bool:
            return false if row >= snapshot.functions.module_prefixes.count or caller >= snapshot.functions.module_prefixes.count
            prefix: usize = snapshot.functions.module_prefixes[row]
            return false if prefix == 0 or prefix >= snapshot.functions.module_prefixes[caller]
            return proof_fact_call_shape_path_prefix_equal(snapshot, row, caller, prefix)

        def proof_fact_call_shape_path_prefix_equal(snapshot: mutable ProofFactCallShapeSnapshot&, row: usize, caller: usize, prefix: usize) -> bool:
            return false if:
                row >= snapshot.functions.declaration_path_starts.count or caller >= snapshot.functions.declaration_path_starts.count
                row >= snapshot.functions.declaration_path_counts.count or caller >= snapshot.functions.declaration_path_counts.count
                snapshot.functions.declaration_path_counts[row] < prefix or snapshot.functions.declaration_path_counts[caller] < prefix
            row_start: usize = snapshot.functions.declaration_path_starts[row]
            caller_start: usize = snapshot.functions.declaration_path_starts[caller]
            return false if row_start + prefix > snapshot.functions.all_declaration_path.count or caller_start + prefix > snapshot.functions.all_declaration_path.count
            for offset in 0..<prefix |offset, snapshot, row_start, caller_start|:
                return false if:
                    not proof_fact_call_shape_charge(snapshot, 1)
                    snapshot.functions.all_declaration_path[row_start + offset] != snapshot.functions.all_declaration_path[caller_start + offset]
            return true

        def proof_fact_call_shape_resolve(snapshot: mutable ProofFactCallShapeSnapshot&, callee: Ast::Expr) -> usize:
            name: sview = proof_callable_name(callee)
            count: usize = snapshot.functions.function_names.count
            return count if name == ""
            match callee:
                Ast::Expr.Scope(_, _, _):
                    caller: usize = snapshot.status.active_caller
                    return count if caller >= count or caller >= snapshot.functions.owner_modules.count
                    resolved: (complete: bool, row: usize) = proof_module_function_index_for_callee(snapshot.functions.function_names, snapshot.functions.owner_modules, snapshot.functions.module_aliases, snapshot.functions.owner_modules[caller], callee, &snapshot.status.lookup_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    if not resolved.complete:
                        snapshot.status.lookup_work_exhausted <- true
                        return count
                    return resolved.row
                _:
                    pass
            direct: usize = proof_fact_call_shape_function_index(snapshot, name)
            return direct if direct < count
            caller: usize = snapshot.status.active_caller
            return count if caller >= count
            found: mutable usize = count
            for index in 0..<count |index, snapshot, name, caller, found|:
                return count if not proof_fact_call_shape_charge(snapshot, 1 + sview_len(name))
                continue if snapshot.functions.function_names[index] != name
                if proof_fact_call_shape_same_module(snapshot, index, caller):
                    return count if found < count
                    found <- index
            return found if found < count
            for index in 0..<count |index, snapshot, name, caller|:
                return count if not proof_fact_call_shape_charge(snapshot, 1 + sview_len(name))
                continue if snapshot.functions.function_names[index] != name
                return count if proof_fact_call_shape_in_enclosing_module(snapshot, index, caller)
            for index in 0..<count |index, snapshot, name, found|:
                return count if not proof_fact_call_shape_charge(snapshot, 1 + sview_len(name))
                continue if snapshot.functions.function_names[index] != name or index >= snapshot.functions.module_prefixes.count
                if snapshot.functions.module_prefixes[index] == 0:
                    return count if found < count
                    found <- index
            return found

        def proof_fact_call_shape_extern_declared(snapshot: mutable ProofFactCallShapeSnapshot&, name: sview) -> bool:
            count: usize = snapshot.externs.extern_names.count
            capacity: usize = snapshot.externs.extern_index_values.count
            return true if:
                count != snapshot.externs.extern_arities.count or count != snapshot.externs.extern_callable.count
                capacity != snapshot.externs.extern_index_hashes.count or capacity != snapshot.externs.extern_index_ambiguous.count or capacity != snapshot.externs.extern_index_callable.count
            return capacity != 0 if count == 0
            return true if capacity == 0 or capacity != proof_name_index_capacity(count)
            return false if count == 0
            return true if not proof_fact_call_shape_charge(snapshot, sview_len(name))
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, snapshot, capacity, count|:
                return true if not proof_fact_call_shape_charge(snapshot, 1)
                current: usize = snapshot.externs.extern_index_values[slot]
                return false if current == count
                return true if current > count
                if snapshot.externs.extern_index_hashes[slot] == wanted_hash:
                    return true if:
                        current >= count
                        not proof_fact_call_shape_charge(snapshot, sview_len(snapshot.externs.extern_names[current]))
                        snapshot.externs.extern_names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return true

        def proof_fact_call_shape_builtin_numeric_cast(snapshot: ProofFactCallShapeSnapshot&, callee: Ast::Expr, argument_count: usize) -> bool:
            return false if argument_count != 0 or snapshot.status.custom_cast_hook_present
            match callee:
                Ast::Expr.Field(_, target, _):
                    index: usize = proof_fact_numeric_cast_target_index(target)
                    return false if index >= PROOF_FACT_NUMERIC_CAST_TARGET_COUNT
                    return true
                _:
                    return false

        def proof_fact_call_shape_active_caller_matches(report: ProofReport&, snapshot: ProofFactCallShapeSnapshot&) -> bool:
            caller: usize = snapshot.status.active_caller
            return false if:
                caller >= snapshot.functions.function_names.count or caller >= snapshot.functions.owner_modules.count or caller >= snapshot.functions.function_lines.count
                report.analysis_2.finding_function == "" or report.analysis_2.finding_function != snapshot.functions.function_names[caller]
                report.analysis_2.finding_owner != snapshot.functions.owner_modules[caller] or report.analysis_2.finding_line != snapshot.functions.function_lines[caller]
                report.analysis_2.finding_caller_index != caller
                snapshot.status.active_caller_line != snapshot.functions.function_lines[caller]
            true
