extend ElisaProof:
    private:
        # The members of the struct `struct_name`, read in one walk of the declaration tree.
        # The walk and its count are those of `proof_struct_field_names` (a module nested past the
        # audit depth counts as ambiguous). With a count of one, `proof_struct_field_type` of each
        # member's name is that struct's last member of the name, which
        # `proof_struct_member_type` reads from the list, so the tree is no longer walked again
        # for every field of a struct-typed binding.
        def proof_struct_members(declarations: darray[Ast::Decl]&, struct_name: sview, depth: usize, members: mutable darray[Ast::StructMember]&) -> usize:
            return 2 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |struct_name, depth, count, members|:
                match declaration:
                    Ast::Decl.Struct(name, struct_members, _, _, _, _, _):
                        if name == struct_name:
                            count <- count + 1
                            members.extend(struct_members)
                    Ast::Decl.Module(_, body, _):
                        count <- count + proof_struct_members(body, struct_name, depth + 1, members)
                    Ast::Decl.Scoped(body, _):
                        count <- count + proof_struct_members(body, struct_name, depth + 1, members)
                    _:
                        pass
            return count

        # `proof_struct_field_type` of a struct whose members, from `proof_struct_members` with a
        # count of one, are `members`: the last member of the name, else Invalid. A found type is
        # returned as it is, so the common answer builds no term.
        def proof_struct_member_type(members: darray[Ast::StructMember]&, field_name: sview) -> (count: usize, type_expression: Ast::Expr):
            found: mutable usize = members.count
            for index in 0..<members.count |index, members, field_name, found|:
                found <- index if members[index].name == field_name
            return (1, members[found].type_expression) if found < members.count
            return (1, Ast::Expr.Invalid)

        # Which declarations answer to a struct name, and the declared type of one of its fields;
        # a caller reads the type only when the count is exactly one. That case is answered from
        # the struct's members without building a term per walked module, as the full walk does
        # (`proof_struct_field_type_walk`, which still answers every other count).
        def proof_struct_field_type(declarations: darray[Ast::Decl]&, struct_name: sview, field_name: sview, depth: usize) -> (count: usize, type_expression: Ast::Expr):
            members: mutable darray[Ast::StructMember] = []
            return proof_struct_member_type(members, field_name) if proof_struct_members(declarations, struct_name, depth, &members) == 1
            return proof_struct_field_type_walk(declarations, struct_name, field_name, depth)
