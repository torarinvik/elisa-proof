# Lexical module lookup shared by operator-enum witness analysis.
extend ElisaProof:
    private:
        def proof_operator_enum_generic_identity_key_hash(name: sview, declaration_line: u32, declaration_offset: usize, owner_module: sview) -> u32:
            hash: mutable u32 = proof_expr_shape_mix(proof_name_hash(name), declaration_line.i64())
            hash <- proof_expr_shape_mix(hash, declaration_offset.i64())
            proof_expr_shape_mix(hash, proof_name_hash(owner_module).i64())

        def proof_operator_enum_generic_identity_index_ensure(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            identity: mutable ProofGenericDeclarationIdentityIndex& = &report.source_types.source_effect_index.generics.generic_identity_index
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if identity.attempted and identity.report_identity == report_identity and identity.source_identity == source_identity:
                return identity.valid
            identity.hashes.clear()
            identity.rows.clear()
            identity.counts.clear()
            identity.entries <- 0
            identity.attempted <- true
            identity.valid <- false
            identity.report_identity <- report_identity
            identity.source_identity <- source_identity
            markers: mutable usize = 0
            for annotation_index in 0..<report.source.source_annotations.count |annotation_index, report, identity, markers, source_work|:
                annotation: Ast::EnumAnnotation = report.source.source_annotations[annotation_index]
                return false if:
                    not proof_type_audit_work_charge(1, source_work)
                    not proof_type_audit_work_charge(sview_len(annotation.name), source_work)
                if annotation.name == "__generic_param_identity" and annotation.line == 3900000131:
                    return false if:
                        not proof_type_audit_work_charge(sview_len(annotation.owner), source_work)
                        not proof_type_audit_work_charge(sview_len(annotation.name), source_work)
                        not proof_type_audit_work_charge(sview_len(annotation.module), source_work)
                    markers <- markers + 1
            return false if markers > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            capacity: usize = proof_name_index_capacity(markers)
            return false if markers > 0 and capacity == 0
            return false if not proof_type_audit_work_charge(capacity, source_work) or not proof_type_audit_work_charge(markers, source_work)
            identity.hashes.resize(capacity)
            identity.rows.resize(capacity)
            identity.counts.resize(capacity)
            annotation_count: usize = report.source.source_annotations.count
            for slot in 0..<capacity |slot, identity, annotation_count|:
                identity.rows[slot] <- annotation_count
                identity.counts[slot] <- 0
            for annotation_index in 0..<report.source.source_annotations.count |annotation_index, report, identity, markers, capacity, source_work|:
                annotation: Ast::EnumAnnotation = report.source.source_annotations[annotation_index]
                return false if:
                    not proof_type_audit_work_charge(1, source_work)
                    not proof_type_audit_work_charge(sview_len(annotation.name), source_work)
                continue if annotation.name != "__generic_param_identity" or annotation.line != 3900000131
                return false if:
                    not proof_type_audit_work_charge(sview_len(annotation.owner), source_work)
                    not proof_type_audit_work_charge(sview_len(annotation.name), source_work)
                    not proof_type_audit_work_charge(sview_len(annotation.module), source_work)
                hash: u32 = proof_operator_enum_generic_identity_key_hash(annotation.owner, annotation.detail_line, annotation.offset.usize(), annotation.module)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, annotation_index, annotation, identity, markers, capacity, hash, report, source_work, placed|:
                    return false if not proof_type_audit_work_charge(1, source_work)
                    current: usize = identity.rows[slot]
                    if current == annotation_count:
                        identity.hashes[slot] <- hash
                        identity.rows[slot] <- annotation_index
                        identity.counts[slot] <- 1
                        placed <- true
                        break
                    return false if current >= report.source.source_annotations.count
                    prior: Ast::EnumAnnotation = report.source.source_annotations[current]
                    return false if:
                        not proof_type_audit_work_charge(sview_len(prior.owner), source_work)
                        not proof_type_audit_work_charge(sview_len(prior.module), source_work)
                        not proof_type_audit_work_charge(sview_len(annotation.owner), source_work)
                        not proof_type_audit_work_charge(sview_len(annotation.module), source_work)
                    if identity.hashes[slot] == hash and prior.owner == annotation.owner and prior.detail_line == annotation.detail_line and prior.offset == annotation.offset and prior.module == annotation.module:
                        identity.counts[slot] <- identity.counts[slot] + 1
                        placed <- true
                        break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            identity.entries <- markers
            cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(identity.rows, annotation_count, source_work)
            identity.valid <- cluster.complete and cluster.bounded
            return identity.valid

        def proof_operator_enum_generic_identity_count_with_work(name: sview, declaration_line: u32, declaration_offset: usize, owner_module: sview, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, count: usize):
            return (false, 0) if declaration_line == 0 or not proof_operator_enum_generic_identity_index_ensure(report, source_work)
            identity: ProofGenericDeclarationIdentityIndex& = report.source_types.source_effect_index.generics.generic_identity_index
            return (false, 0) if not identity.valid or identity.hashes.count != identity.rows.count or identity.hashes.count != identity.counts.count
            markers: usize = identity.entries
            return (false, 0) if markers > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            expected_capacity: usize = proof_name_index_capacity(markers)
            return (false, 0) if identity.rows.count != expected_capacity
            return (true, 0) if markers == 0
            return (false, 0) if identity.rows.count == 0
            return (false, 0) if:
                not proof_type_audit_work_charge(sview_len(name), source_work)
                not proof_type_audit_work_charge(sview_len(owner_module), source_work)
            wanted_hash: u32 = proof_operator_enum_generic_identity_key_hash(name, declaration_line, declaration_offset, owner_module)
            slot: mutable usize = (wanted_hash.i64() % identity.rows.count.i64()).usize()
            probes: mutable usize = 0
            while probes < identity.rows.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, declaration_line, declaration_offset, owner_module, report, identity, markers, source_work|:
                return (false, 0) if not proof_type_audit_work_charge(1, source_work)
                current: usize = identity.rows[slot]
                return (true, 0) if current == report.source.source_annotations.count
                return (false, 0) if current >= report.source.source_annotations.count
                annotation: Ast::EnumAnnotation = report.source.source_annotations[current]
                if identity.hashes[slot] == wanted_hash:
                    return (false, 0) if:
                        not proof_type_audit_work_charge(sview_len(annotation.owner), source_work)
                        not proof_type_audit_work_charge(sview_len(annotation.module), source_work)
                    if annotation.owner == name and annotation.detail_line == declaration_line and annotation.offset.usize() == declaration_offset and annotation.module == owner_module:
                        return (true, identity.counts[slot])
                slot <- (slot + 1) % identity.rows.count
                probes <- probes + 1
            (false, 0)

        # After a simple qualified head misses an exact alias, Stage1's alias-kind
        # lookup checks root aliases before any nominal-type fallback.
        def proof_operator_enum_named_type_root_fallback_with_work(name: sview, position: Ast::Pos, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize):
            root: (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize) = proof_operator_enum_named_type_lookup_with_work(name, [], position, report, source_work)
            return (false, 2, 0, 2, 0) if not root.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, root.aliases, root.alias_row, 0, 0) if root.aliases > 0
            return (true, 0, 0, root.types, root.type_row) if root.types > 0
            (true, 0, 0, 0, 0)

        # Cache the imported-module annotation owners once per checked report. Name lookup still
        # visits every import row so duplicate-import behavior remains unchanged, while repeated
        # type candidates avoid rescanning unrelated source annotations.
        def proof_operator_enum_import_owners_ensure(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            cache: mutable ProofOperatorEnumImportOwnerIndex& = &report.source_types.source_effect_index.operator_enum_import_owners
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if cache.attempted and cache.report_identity == report_identity and cache.source_identity == source_identity:
                return cache.valid
            cache.owners.clear()
            cache.attempted <- true
            cache.valid <- false
            cache.report_identity <- report_identity
            cache.source_identity <- source_identity
            for annotation in report.source.source_annotations |annotation, cache, source_work|:
                return false if:
                    not proof_type_audit_work_charge(1, source_work)
                    not proof_type_audit_work_charge(sview_len(annotation.owner), source_work)
                    not proof_type_audit_work_charge(sview_len(annotation.name), source_work)
                continue if annotation.name != "__using" and annotation.name != "__using_alias_target"
                return false if annotation.owner == ""
                cache.owners.push(annotation.owner)
            cache.valid <- true
            return true

        # Stage1's enum-kind lookup consults the file-wide imported-module table before root
        # and global symbols. Count every imported module row, including duplicate imports, so
        # a root enum cannot preempt a same-named imported enum.
        def proof_operator_enum_imported_enum_census_with_work(name: sview, index: ProofEnumIndex&, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, count: usize, owner: sview):
            total: mutable usize = 0
            owner: mutable sview = ""
            cache: ProofOperatorEnumImportOwnerIndex& = report.source_types.source_effect_index.operator_enum_import_owners
            return (false, 0, "") if not proof_operator_enum_import_owners_ensure(report, source_work)
            for imported_owner in cache.owners |imported_owner, name, index, total, owner, source_work|:
                return (false, 0, "") if:
                    not proof_type_audit_work_charge(1, source_work)
                    not proof_type_audit_work_charge(sview_len(imported_owner), source_work)
                candidate: (complete: bool, exact_count: usize, root_count: usize, all_count: usize, all_owner: sview) = proof_operator_enum_named_enum_census_with_work(name, imported_owner, index, source_work)
                return (false, 0, "") if not candidate.complete
                if candidate.exact_count > 0:
                    owner <- imported_owner if total == 0
                    total <- total + candidate.exact_count
            return (true, total, owner)

        # Alias-kind lookup follows Stage1's same exact-owner then imported-module
        # ranking. Keep duplicate import rows significant and use the source alias
        # index to identify the declaration without rescanning the AST.
        def proof_operator_enum_imported_alias_census_with_work(name: sview, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, count: usize, row: usize):
            total: mutable usize = 0
            found_row: mutable usize = 0
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, 0, 0) if not index.aliases.alias_index_valid or index.aliases.alias_names.count != index.aliases.alias_owners.count
            cache: ProofOperatorEnumImportOwnerIndex& = report.source_types.source_effect_index.operator_enum_import_owners
            return (false, 0, 0) if not proof_operator_enum_import_owners_ensure(report, source_work)
            for imported_owner in cache.owners |imported_owner, name, source_work, total, found_row, index|:
                return (false, 0, 0) if:
                    not proof_type_audit_work_charge(1, source_work)
                    not proof_type_audit_work_charge(sview_len(imported_owner), source_work)
                # Scoped lookup uses the shared index meter stored on the report.
                index.work.implicit_effect_work <- source_work
                imported: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_owner_lookup(name, imported_owner, index.aliases.alias_names, index.aliases.alias_owners, index.aliases.alias_scope_index_hashes, index.aliases.alias_scope_index_values, index.aliases.alias_scope_index_counts, index.aliases.alias_scope_index_valid, report)
                source_work <- index.work.implicit_effect_work
                return (false, 0, 0) if not imported.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                if imported.count > 0:
                    found_row <- imported.row if total == 0
                    total <- total + imported.count
            return (true, total, found_row)

        # Enum-kind census runs before this alias-kind fallback. Within the alias
        # lookup, exact-owner aliases precede file-wide imports, root aliases, and
        # the globally unique alias fallback; nominal declarations do not mask an
        # alias at a later rank.
        def proof_operator_enum_named_type_lexical_lookup_with_work(name: sview, owner_module: sview, position: Ast::Pos, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize, resolved_owner: sview):
            return (false, 2, 0, 2, 0, "") if not proof_type_audit_work_charge(sview_len(owner_module), source_work)
            owner_scope: darray[sview] = proof_global_constant_scope_with_module([], owner_module)
            owner_lookup: (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize) = proof_operator_enum_named_type_lookup_with_work(name, owner_scope, position, report, source_work)
            return (false, 2, 0, 2, 0, "") if not owner_lookup.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            enums: (complete: bool, exact_count: usize, root_count: usize, all_count: usize, all_owner: sview) = proof_operator_enum_named_enum_census_with_work(name, owner_module, report.source_types.source_effect_index.enum_index, source_work)
            return (false, 2, 0, 2, 0, "") if not enums.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, 0, 0, 1, 0, owner_module) if enums.exact_count == 1
            # Stage1 treats an ambiguous enum rank as a failed enum lookup, then
            # tries the alias kind from its first rank. Do not fall through to a
            # lower enum rank after ambiguity, but do let alias lookup proceed.
            if enums.exact_count == 0:
                imported_enums: (complete: bool, count: usize, owner: sview) = proof_operator_enum_imported_enum_census_with_work(name, report.source_types.source_effect_index.enum_index, report, source_work)
                return (false, 2, 0, 2, 0, "") if not imported_enums.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (true, 0, 0, 1, 0, imported_enums.owner) if imported_enums.count == 1
                if imported_enums.count == 0:
                    if owner_module != "":
                        return (true, 0, 0, 1, 0, "") if enums.root_count == 1
                        if enums.root_count == 0:
                            return (true, 0, 0, 1, 0, enums.all_owner) if enums.all_count == 1
                    else:
                        return (true, 0, 0, 1, 0, enums.all_owner) if enums.all_count == 1
            return (true, owner_lookup.aliases, owner_lookup.alias_row, 0, 0, owner_module) if owner_module != "" and owner_lookup.aliases > 0
            imported_aliases: (complete: bool, count: usize, row: usize) = proof_operator_enum_imported_alias_census_with_work(name, report, source_work)
            return (false, 2, 0, 2, 0, "") if not imported_aliases.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, 0, 0, 0, 0, "") if imported_aliases.count > 1
            return (false, 2, 0, 2, 0, "") if imported_aliases.count == 1 and imported_aliases.row >= report.source_types.source_effect_index.aliases.alias_has_formals.count
            return (true, 0, 0, 0, 0, "") if imported_aliases.count == 1 and report.source_types.source_effect_index.aliases.alias_has_formals[imported_aliases.row]
            return (true, 1, imported_aliases.row, 0, 0, report.source_types.source_effect_index.aliases.alias_owners[imported_aliases.row]) if imported_aliases.count == 1
            if owner_module == "":
                return (true, owner_lookup.aliases, owner_lookup.alias_row, 0, 0, "") if owner_lookup.aliases > 0
            if owner_module != "":
                root_lookup: (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize) = proof_operator_enum_named_type_lookup_with_work(name, [], position, report, source_work)
                return (false, 2, 0, 2, 0, "") if not root_lookup.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (true, root_lookup.aliases, root_lookup.alias_row, 0, 0, "") if root_lookup.aliases > 0
            # Stage1's final bare-name fallback accepts a globally unique alias after
            # exact/root lookup. The shared classifier rejects concrete-name conflicts.
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, 2, 0, 2, 0, "") if not index.aliases.alias_index_valid
            index.work.implicit_effect_work <- source_work
            global_alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_source_conversion_alias_target(name, report)
            source_work <- index.work.implicit_effect_work
            return (false, 2, 0, 2, 0, "") if not global_alias.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (false, 2, 0, 2, 0, "") if global_alias.count > 1
            return (true, 0, 0, 0, 0, "") if global_alias.count == 0
            return (false, 2, 0, 2, 0, "") if global_alias.row >= index.aliases.alias_owners.count or global_alias.row >= index.aliases.alias_has_formals.count
            return (true, 0, 0, 0, 0, "") if index.aliases.alias_has_formals[global_alias.row]
            return (false, 2, 0, 2, 0, "") if not proof_type_audit_work_charge(sview_len(index.aliases.alias_owners[global_alias.row]), source_work)
            index.work.implicit_effect_work <- source_work
            return (true, 1, global_alias.row, 0, 0, index.aliases.alias_owners[global_alias.row])
