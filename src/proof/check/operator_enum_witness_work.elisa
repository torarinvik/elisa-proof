# Bounded const-enum facts used by primitive operator witness generation.
extend ElisaProof:
    private:
        def proof_operator_enum_fact_exists_with_work(facts: darray[Ast::Expr]&, wanted: Ast::Expr, source_work: mutable usize&) -> (complete: bool, found: bool):
            return (true, false) if facts.count == 0
            wanted_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(wanted, &wanted_cost, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (false, false)
            for existing in facts |wanted, source_work|:
                return (false, false) if not proof_type_audit_work_charge(1, source_work)
                existing_cost: mutable usize = 0
                if not proof_replay_summary_expr_cost_with_limit(existing, &existing_cost, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return (false, false)
                remaining: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                passes_available: usize = remaining / 5
                if wanted_cost > passes_available or existing_cost > passes_available - wanted_cost:
                    source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return (false, false)
                comparison_cost: usize = (wanted_cost + existing_cost) * 5
                source_work <- source_work + comparison_cost
                equal: bool = proof_expr_equal(existing, wanted)
                return (true, true) if equal
            return (true, false)

        def proof_add_operator_enum_scalar_witness_with_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, owner: sview, source_work: mutable usize&) -> bool:
            present: (complete: bool, found: bool) = proof_operator_enum_fact_exists_with_work(facts, expression, source_work)
            return false if not present.complete
            return true if present.found or report.analysis_2.scalar_witness_facts >= PROOF_SCALAR_WITNESS_FUNCTION_BUDGET
            type_bound: bool = proof_fact_is_type_bound_with_work(report, expression, owner, source_work)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if not type_bound:
                already_seen: mutable bool = false
                for existing in report.analysis_1.type_bounds.seen |expression, source_work, already_seen|:
                    equal: bool = proof_replay_summary_expr_equal_with_limit(existing, expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return false if not equal and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    already_seen <- true if equal
                report.analysis_1.type_bounds.seen.push(expression) if not already_seen
                report.analysis_1.type_bounds.seen_hashes.push(proof_expr_shape_hash(expression, 0)) if not already_seen
            report.analysis_2.scalar_witness_facts <- report.analysis_2.scalar_witness_facts + 1
            proof_add_traced_fact(facts, report, expression, "type-bound", line, owner)
            source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT

        def proof_unique_const_enum_member_owner_with_work(name: sview, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, known: bool, owner: sview, fieldless: bool):
            return (true, false, "", false) if name == ""
            member: (complete: bool, known: bool, owner: sview, fieldless: bool) = proof_report_const_enum_member_lookup_with_work(report, name, source_work)
            return (false, false, "", false) if not member.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, false, "", false) if not member.known or member.owner == ""
            aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(report.source.source_declarations, member.owner, 0, source_work)
            return (false, false, "", false) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, false, "", false) if aggregates.enums != 0 or aggregates.const_enums != 1 or aggregates.structs != 0
            alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_with_work(report.source.source_declarations, member.owner, 0, source_work)
            return (false, false, "", false) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, false, "", false) if alias.count != 0
            return (true, true, member.owner, member.fieldless)

        def proof_operator_enum_scope_matches_with_work(current: darray[sview]&, target: darray[sview]&, source_work: mutable usize&) -> bool:
            return false if target.count == 0 or current.count + 1 != target.count
            for index in 0..<current.count |index, current, target, source_work|:
                return false if:
                    not proof_type_audit_work_charge(sview_len(current[index]) + sview_len(target[index]), source_work)
                    current[index] != target[index]
            return true

        def proof_operator_enum_paths_equal_with_work(left: darray[sview]&, right: darray[sview]&, source_work: mutable usize&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |index, left, right, source_work|:
                return false if:
                    not proof_type_audit_work_charge(sview_len(left[index]) + sview_len(right[index]), source_work)
                    left[index] != right[index]
            return true

        def proof_operator_enum_path_append_with_work(path: mutable darray[sview]&, owner: darray[sview]&, name: sview, source_work: mutable usize&) -> bool:
            return false if not proof_type_audit_work_charge(owner.count + 1, source_work)
            for segment in owner |path, source_work|:
                return false if not proof_type_audit_work_charge(sview_len(segment), source_work)
                path.push(segment)
            return false if not proof_type_audit_work_charge(sview_len(name), source_work)
            path.push(name)
            return true

        def proof_operator_enum_empty_module_alias_index() -> ProofModuleAliasIndex:
            ProofModuleAliasIndex{names: [], targets: [], scopes: [], lines: [], offsets: [], alias_lookup_hashes: [], alias_lookup_values: [], alias_lookup_ambiguous: [], global_alias_lookup_hashes: [], global_alias_lookup_values: [], function_lookup_hashes: [], function_lookup_values: [], function_lookup_ambiguous: [], function_lookup_complete: false, complete: true}

        # Resolve only a root using-alias when one exists. Source lookup is paired with the
        # backend's effective global mapping and every alias hop must agree before the target
        # module path is used to admit a source enum witness.
        def proof_operator_enum_alias_owner_with_work(aliases: ProofModuleAliasIndex&, caller_module: sview, segments: darray[sview]&, source_work: mutable usize&) -> (complete: bool, known: bool, owner: darray[sview]):
            empty_owner: darray[sview] = []
            return (true, false, empty_owner) if segments.count < 2
            lexical: (complete: bool, matched: bool, valid: bool, target: sview, scope: sview) = proof_module_alias_target(aliases, caller_module, segments[0], source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            return (false, false, empty_owner) if not lexical.complete
            backend: (complete: bool, matched: bool, valid: bool, row: usize) = proof_module_alias_lookup_global(aliases, segments[0], source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            return (false, false, empty_owner) if not backend.complete
            if not lexical.matched:
                return (true, false, empty_owner) if backend.matched
                unaliased_owner: mutable darray[sview] = []
                for index in 0..<segments.count - 1 |index, segments, unaliased_owner, source_work|:
                    return (false, false, empty_owner) if not proof_type_audit_work_charge(sview_len(segments[index]), source_work)
                    unaliased_owner.push(segments[index])
                return (true, true, unaliased_owner)
            return (true, false, empty_owner) if not lexical.valid or not backend.matched or not backend.valid or backend.row >= aliases.targets.count
            return (false, false, empty_owner) if not proof_type_audit_work_charge(sview_len(lexical.target) + sview_len(aliases.targets[backend.row]), source_work)
            return (true, false, empty_owner) if lexical.target != aliases.targets[backend.row]
            compatible: (complete: bool, compatible: bool, target: sview) = proof_module_alias_targets_compatible(aliases, lexical.scope, lexical.target, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            return (false, false, empty_owner) if not compatible.complete
            return (true, false, empty_owner) if not compatible.compatible
            return (false, false, empty_owner) if not proof_type_audit_work_charge(sview_len(compatible.target), source_work)
            aliased_owner: mutable darray[sview] = proof_global_constant_scope_with_module([], compatible.target)
            for index in 1..<segments.count - 1 |index, segments, aliased_owner, source_work|:
                return (false, false, empty_owner) if not proof_type_audit_work_charge(sview_len(segments[index]), source_work)
                aliased_owner.push(segments[index])
            return (true, true, aliased_owner)

        def proof_operator_enum_owner_expression_with_work(owner: darray[sview]&, position: Ast::Pos, source_work: mutable usize&) -> (complete: bool, expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if:
                owner.count == 0
                not proof_type_audit_work_charge(owner.count, source_work)
                not proof_type_audit_work_charge(sview_len(owner[0]), source_work)
            expression: mutable Ast::Expr = Ast::Expr.Ident(owner[0], position)
            for index in 1..<owner.count |index, owner, expression, position, source_work|:
                return (false, Ast::Expr.Invalid) if not proof_type_audit_work_charge(sview_len(owner[index]), source_work)
                expression <- Ast::Expr.Scope(expression, owner[index], position)
            return (true, expression)

        def proof_operator_enum_current_function_scope_with_work(functions: ProofFunctionTable&, report: ProofReport&, function_name: sview, source_work: mutable usize&) -> (complete: bool, known: bool, scope: darray[sview], declaration_line: u32, module_name: sview):
            empty_scope: darray[sview] = []
            declaration_line: u32 = report.analysis_2.trace_owner_line
            return (true, false, empty_scope, 0, "") if declaration_line == 0
            count: usize = functions.lookup.names.count
            return (false, false, empty_scope, 0, "") if count != functions.lookup.lines.count or count != functions.lookup.owner_modules.count
            row: usize = functions.call_graph.current_caller
            return (true, false, empty_scope, 0, "") if row >= count
            return (false, false, empty_scope, 0, "") if not proof_type_audit_work_charge(1 + sview_len(functions.lookup.names[row]) + sview_len(function_name), source_work)
            return (true, false, empty_scope, 0, "") if functions.lookup.names[row] != function_name or functions.lookup.lines[row] != declaration_line
            module_name: sview = functions.lookup.owner_modules[row]
            return (false, false, empty_scope, 0, "") if not proof_type_audit_work_charge(sview_len(module_name), source_work)
            scope: darray[sview] = proof_global_constant_scope_with_module(empty_scope, module_name)
            return (true, true, scope, declaration_line, module_name)

        def proof_operator_enum_type_path_segments(expression: Ast::Expr, segments: mutable darray[sview]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if name == "" or not proof_type_audit_work_charge(sview_len(name), source_work)
                    segments.push(name)
                    return true
                Ast::Expr.Scope(parent, name, _):
                    return false if:
                        name == "" or not proof_operator_enum_type_path_segments(parent, segments, source_work, depth + 1)
                        not proof_type_audit_work_charge(sview_len(name), source_work)
                    segments.push(name)
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_operator_enum_type_path_segments(inner, segments, source_work, depth + 1)
                _:
                    return false

        def proof_operator_enum_root_name_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, "") if name == "" or not proof_type_audit_work_charge(sview_len(name), source_work)
                    return (true, name)
                Ast::Expr.Scope(parent, _, _) | Ast::Expr.Paren(parent, _) | Ast::Expr.Refinement(parent, _, _):
                    return proof_operator_enum_root_name_with_work(parent, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_operator_enum_root_name_with_work(inner, source_work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    pass
            return (true, "")

        def proof_operator_enum_named_type_lookup_with_work(name: sview, owner: darray[sview]&, position: Ast::Pos, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, 2, 0, 2, 0) if:
                index.aliases.alias_names.count != index.aliases.alias_targets.count or index.aliases.alias_names.count != index.aliases.alias_owners.count or index.aliases.alias_names.count != index.aliases.alias_lines.count or index.aliases.alias_names.count != index.aliases.alias_has_formals.count
                index.types.declared_types.count != index.types.declared_type_owners.count
            if owner.count == 0:
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                alias: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_source_conversion_alias_target_in_owner(name, "", report)
                source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                return (false, 2, 0, 2, 0) if:
                    not alias.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    not proof_type_audit_work_charge(sview_len(name), source_work)
                type: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup(name, index.types.declared_types, index.types.declared_type_index_hashes, index.types.declared_type_index_values, index.types.declared_type_index_counts, index.types.declared_type_index_valid, report)
                source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                return (false, 2, 0, 2, 0) if not type.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (true, alias.count, alias.row, type.count, type.row)
            owner_expression: (complete: bool, expression: Ast::Expr) = proof_operator_enum_owner_expression_with_work(owner, position, source_work)
            return (false, 2, 0, 2, 0) if not owner_expression.complete
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            aliases: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_lookup(name, owner_expression.expression, index.aliases.alias_names, index.aliases.alias_owners, index.aliases.alias_scope_index_hashes, index.aliases.alias_scope_index_values, index.aliases.alias_scope_index_counts, index.aliases.alias_scope_index_valid, report)
            source_work <- report.source_types.source_effect_index.work.implicit_effect_work
            return (false, 2, 0, 2, 0) if not aliases.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            types: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_lookup(name, owner_expression.expression, index.types.declared_types, index.types.declared_type_owners, index.types.declared_type_scope_index_hashes, index.types.declared_type_scope_index_values, index.types.declared_type_scope_index_counts, index.types.declared_type_scope_index_valid, report)
            source_work <- report.source_types.source_effect_index.work.implicit_effect_work
            return (false, 2, 0, 2, 0) if not types.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, aliases.count, aliases.row, types.count, types.row)

        def proof_operator_enum_type_path_in_with_work(expression: Ast::Expr, caller_scope: darray[sview]&, resolution_scope: darray[sview]&, declaration_line: u32, resolution_module: sview, module_aliases: ProofModuleAliasIndex&, report: mutable ProofReport&, active_alias_rows: mutable darray[usize]&, path: mutable darray[sview]&, source_work: mutable usize&, depth: usize, caller_expression: bool) -> (complete: bool, known: bool):
            return (false, false) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_operator_enum_type_path_in_with_work(inner, caller_scope, resolution_scope, declaration_line, resolution_module, module_aliases, report, active_alias_rows, path, source_work, depth + 1, caller_expression)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_operator_enum_type_path_in_with_work(inner, caller_scope, resolution_scope, declaration_line, resolution_module, module_aliases, report, active_alias_rows, path, source_work, depth + 1, caller_expression) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return (true, false)
                Ast::Expr.Ident(name, position):
                    return (false, false) if name == "" or not proof_type_audit_work_charge(sview_len(name), source_work)
                    return (true, false) if proof_scalar_primitive_type_name(name)
                    lookup: (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize) = proof_operator_enum_named_type_lookup_with_work(name, resolution_scope, position, report, source_work)
                    return (false, false) if not lookup.complete or lookup.aliases > 1 or lookup.types > 1 or (lookup.aliases > 0 and lookup.types > 0)
                    if lookup.aliases == 1:
                        index: ProofSourceEffectIndex& = report.source_types.source_effect_index
                        return (false, false) if lookup.alias_row >= index.aliases.alias_targets.count or lookup.alias_row >= index.aliases.alias_owners.count or lookup.alias_row >= index.aliases.alias_has_formals.count or index.aliases.alias_has_formals[lookup.alias_row]
                        for active in active_alias_rows |active, lookup, source_work|:
                            return (false, false) if:
                                not proof_type_audit_work_charge(1, source_work)
                                active == lookup.alias_row
                        mark: usize = active_alias_rows.count
                        active_alias_rows.push(lookup.alias_row)
                        return (false, false) if not proof_type_audit_work_charge(sview_len(index.aliases.alias_owners[lookup.alias_row]), source_work)
                        alias_scope: darray[sview] = proof_global_constant_scope_with_module([], index.aliases.alias_owners[lookup.alias_row])
                        alias_module: sview = index.aliases.alias_owners[lookup.alias_row]
                        resolved: (complete: bool, known: bool) = proof_operator_enum_type_path_in_with_work(index.aliases.alias_targets[lookup.alias_row], caller_scope, alias_scope, declaration_line, alias_module, module_aliases, report, active_alias_rows, path, source_work, depth + 1, false)
                        active_alias_rows.resize(mark)
                        return resolved
                    if lookup.types == 1:
                        type_owner: darray[sview] = resolution_scope
                        index: ProofSourceEffectIndex& = report.source_types.source_effect_index
                        if resolution_scope.count == 0:
                            return (false, false) if:
                                lookup.type_row >= index.types.declared_type_owners.count
                                not proof_type_audit_work_charge(sview_len(index.types.declared_type_owners[lookup.type_row]), source_work)
                            type_owner <- proof_global_constant_scope_with_module([], index.types.declared_type_owners[lookup.type_row])
                        return (false, false) if not proof_operator_enum_path_append_with_work(path, type_owner, name, source_work)
                        return (true, true)
                    if caller_expression and resolution_scope.count > 0:
                        return (true, false) if not report.source_types.source_effect_index.aliases.bare_alias_root_fallback_valid
                        empty_scope: darray[sview] = []
                        root_alias: (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize) = proof_operator_enum_named_type_lookup_with_work(name, empty_scope, position, report, source_work)
                        return (false, false) if not root_alias.complete or root_alias.aliases > 1 or root_alias.types > 1
                        return (true, false) if root_alias.aliases == 0 or root_alias.types != 0
                        index: ProofSourceEffectIndex& = report.source_types.source_effect_index
                        return (false, false) if root_alias.alias_row >= index.aliases.alias_targets.count or root_alias.alias_row >= index.aliases.alias_owners.count or root_alias.alias_row >= index.aliases.alias_has_formals.count or index.aliases.alias_has_formals[root_alias.alias_row] or index.aliases.alias_owners[root_alias.alias_row] != ""
                        for active in active_alias_rows |active, root_alias, source_work|:
                            return (false, false) if:
                                not proof_type_audit_work_charge(1, source_work)
                                active == root_alias.alias_row
                        mark: usize = active_alias_rows.count
                        active_alias_rows.push(root_alias.alias_row)
                        resolved: (complete: bool, known: bool) = proof_operator_enum_type_path_in_with_work(index.aliases.alias_targets[root_alias.alias_row], caller_scope, empty_scope, declaration_line, "", module_aliases, report, active_alias_rows, path, source_work, depth + 1, false)
                        active_alias_rows.resize(mark)
                        return resolved
                    return (true, false)
                Ast::Expr.Scope(_, _, position):
                    segments: mutable darray[sview] = []
                    return (false, false) if not proof_operator_enum_type_path_segments(expression, &segments, source_work, 0) or segments.count < 2
                    resolved_owner: (complete: bool, known: bool, owner: darray[sview]) = proof_operator_enum_alias_owner_with_work(module_aliases, resolution_module, segments, source_work)
                    return (false, false) if not resolved_owner.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return (true, false) if not resolved_owner.known
                    owner: darray[sview] = resolved_owner.owner
                    name: sview = segments[segments.count - 1]
                    lookup: (complete: bool, aliases: usize, alias_row: usize, types: usize, type_row: usize) = proof_operator_enum_named_type_lookup_with_work(name, owner, position, report, source_work)
                    return (false, false) if not lookup.complete or lookup.aliases > 1 or lookup.types > 1 or (lookup.aliases > 0 and lookup.types > 0)
                    if lookup.aliases == 1:
                        index: ProofSourceEffectIndex& = report.source_types.source_effect_index
                        return (false, false) if lookup.alias_row >= index.aliases.alias_targets.count or lookup.alias_row >= index.aliases.alias_owners.count or lookup.alias_row >= index.aliases.alias_has_formals.count or index.aliases.alias_has_formals[lookup.alias_row]
                        for active in active_alias_rows |active, lookup, source_work|:
                            return (false, false) if:
                                not proof_type_audit_work_charge(1, source_work)
                                active == lookup.alias_row
                        mark: usize = active_alias_rows.count
                        active_alias_rows.push(lookup.alias_row)
                        return (false, false) if not proof_type_audit_work_charge(sview_len(index.aliases.alias_owners[lookup.alias_row]), source_work)
                        alias_scope: darray[sview] = proof_global_constant_scope_with_module([], index.aliases.alias_owners[lookup.alias_row])
                        alias_module: sview = index.aliases.alias_owners[lookup.alias_row]
                        resolved: (complete: bool, known: bool) = proof_operator_enum_type_path_in_with_work(index.aliases.alias_targets[lookup.alias_row], caller_scope, alias_scope, declaration_line, alias_module, module_aliases, report, active_alias_rows, path, source_work, depth + 1, false)
                        active_alias_rows.resize(mark)
                        return resolved
                    if lookup.types == 1:
                        return (false, false) if not proof_operator_enum_path_append_with_work(path, owner, name, source_work)
                        return (true, true)
                    return (true, false)
                _:
                    return (true, false)

        def proof_operator_enum_type_path_with_aliases_work(expression: Ast::Expr, caller_scope: darray[sview]&, declaration_line: u32, caller_module: sview, module_aliases: ProofModuleAliasIndex&, report: mutable ProofReport&, path: mutable darray[sview]&, source_work: mutable usize&) -> (complete: bool, known: bool):
            root: (complete: bool, name: sview) = proof_operator_enum_root_name_with_work(expression, source_work, 0)
            return (false, false) if not root.complete
            if root.name != "" and declaration_line != 0:
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                generic: (complete: bool, count: usize) = proof_source_conversion_generic_name(root.name, declaration_line, report)
                source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                return (false, false) if not generic.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (true, false) if generic.count > 0
            active_alias_rows: mutable darray[usize] = []
            return proof_operator_enum_type_path_in_with_work(expression, caller_scope, caller_scope, declaration_line, caller_module, module_aliases, report, &active_alias_rows, path, source_work, 0, true)

        def proof_operator_enum_type_path_with_work(expression: Ast::Expr, caller_scope: darray[sview]&, declaration_line: u32, report: mutable ProofReport&, path: mutable darray[sview]&, source_work: mutable usize&) -> (complete: bool, known: bool):
            empty_aliases: ProofModuleAliasIndex = proof_operator_enum_empty_module_alias_index()
            proof_operator_enum_type_path_with_aliases_work(expression, caller_scope, declaration_line, "", empty_aliases, report, path, source_work)

        def proof_exact_const_enum_member_in_scope_with_work(declarations: darray[Ast::Decl]&, target: darray[sview]&, current: darray[sview]&, member_name: sview, depth: usize, source_work: mutable usize&) -> (types: usize, members: usize, owner: sview, fieldless: bool):
            return (2, 2, "", false) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            types: mutable usize = 0
            members: mutable usize = 0
            owner: mutable sview = ""
            fieldless: mutable bool = false
            for declaration in declarations |target, current, member_name, depth, source_work, types, members, owner, fieldless|:
                return (2, 2, "", false) if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        return (2, 2, "", false) if:
                            not proof_type_audit_work_charge(sview_len(module_name), source_work)
                            not proof_type_audit_work_charge(current.count + 1, source_work)
                        nested_scope: darray[sview] = proof_global_constant_scope_with_module(current, module_name)
                        nested: (types: usize, members: usize, owner: sview, fieldless: bool) = proof_exact_const_enum_member_in_scope_with_work(body, target, nested_scope, member_name, depth + 1, source_work)
                        return (2, 2, "", false) if nested.types > 1 or nested.members > 1
                        types <- types + nested.types
                        members <- members + nested.members
                        owner <- nested.owner if nested.types > 0
                        fieldless <- nested.fieldless if nested.types > 0
                    Ast::Decl.Scoped(body, _):
                        nested: (types: usize, members: usize, owner: sview, fieldless: bool) = proof_exact_const_enum_member_in_scope_with_work(body, target, current, member_name, depth + 1, source_work)
                        return (2, 2, "", false) if nested.types > 1 or nested.members > 1
                        types <- types + nested.types
                        members <- members + nested.members
                        owner <- nested.owner if nested.types > 0
                        fieldless <- nested.fieldless if nested.types > 0
                    Ast::Decl.Enum(enum_name, variants, is_const, _, _):
                        matches_scope: bool = proof_operator_enum_scope_matches_with_work(current, target, source_work)
                        return (2, 2, "", false) if:
                            source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            not proof_type_audit_work_charge(sview_len(enum_name) + sview_len(target[target.count - 1]), source_work)
                        if is_const and matches_scope and target[target.count - 1] == enum_name:
                            types <- types + 1
                            owner <- enum_name
                            for variant in variants |member_name, source_work, members, fieldless|:
                                return (2, 2, "", false) if not proof_type_audit_work_charge(1 + sview_len(member_name) + sview_len(variant.name), source_work)
                                if variant.name == member_name:
                                    members <- members + 1
                                    fieldless <- variant.fields.count == 0
                    _:
                        pass
                return (2, 2, "", false) if types > 1 or members > 1
            return (types, members, owner, fieldless)

        def proof_exact_const_enum_member_owner_with_work(enum_type: Ast::Expr, member_name: sview, declarations: darray[Ast::Decl]&, caller_scope: darray[sview]&, caller_module: sview, module_aliases: ProofModuleAliasIndex&, declaration_line: u32, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, known: bool, owner: sview, fieldless: bool):
            path: mutable darray[sview] = []
            resolved_path: (complete: bool, known: bool) = proof_operator_enum_type_path_with_aliases_work(enum_type, caller_scope, declaration_line, caller_module, module_aliases, report, &path, source_work)
            return (false, false, "", false) if not resolved_path.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, false, "", false) if not resolved_path.known or path.count < 2
            return (false, false, "", false) if not proof_type_audit_work_charge(path.count + sview_len(member_name), source_work)
            for part in path |source_work|:
                return (false, false, "", false) if not proof_type_audit_work_charge(sview_len(part), source_work)
            root_scope: darray[sview] = []
            found: (types: usize, members: usize, owner: sview, fieldless: bool) = proof_exact_const_enum_member_in_scope_with_work(declarations, path, root_scope, member_name, 0, source_work)
            return (false, false, "", false) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, false, "", false) if found.types != 1 or found.members != 1 or found.owner == ""
            return (true, true, found.owner, found.fieldless)

        def proof_const_enum_alias_operator_override_in_with_work(enum_path: darray[sview]&, module_aliases: ProofModuleAliasIndex&, report: mutable ProofReport&, source_work: mutable usize&) -> (complete: bool, overridden: bool):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, false) if index.aliases.alias_names.count != index.aliases.alias_targets.count or index.aliases.alias_names.count != index.aliases.alias_owners.count or index.aliases.alias_names.count != index.aliases.alias_lines.count or index.aliases.alias_names.count != index.aliases.alias_has_formals.count
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
            for alias_row in 0..<index.aliases.alias_names.count |alias_row, index, enum_path, report, source_work, protocols|:
                return (false, false) if not proof_type_audit_work_charge(1, source_work)
                alias_name: sview = index.aliases.alias_names[alias_row]
                has_operator: mutable bool = false
                for protocol in protocols |alias_name, report, source_work, has_operator|:
                    implementation: (complete: bool, exists: bool) = proof_report_builtin_operator_impl_exists_with_work(report, alias_name, protocol, source_work)
                    return (false, false) if not implementation.complete
                    has_operator <- true if implementation.exists
                continue if not has_operator
                # The operator index stores aliases by source spelling. The declaration index
                # supplies the owner path, so only aliases resolving to this exact enum block
                # its built-in member witnesses.
                return (true, true) if index.aliases.alias_has_formals[alias_row]
                return (false, false) if not proof_type_audit_work_charge(sview_len(index.aliases.alias_owners[alias_row]), source_work)
                alias_scope: darray[sview] = proof_global_constant_scope_with_module([], index.aliases.alias_owners[alias_row])
                target_path: mutable darray[sview] = []
                resolved: (complete: bool, known: bool) = proof_operator_enum_type_path_with_aliases_work(index.aliases.alias_targets[alias_row], alias_scope, index.aliases.alias_lines[alias_row], index.aliases.alias_owners[alias_row], module_aliases, report, &target_path, source_work)
                return (false, false) if not resolved.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                # If an overloaded alias cannot be resolved, it may still target this enum.
                # Suppress generation instead of treating a missing path as unrelated.
                return (true, true) if:
                    not resolved.known
                    proof_operator_enum_paths_equal_with_work(target_path, enum_path, source_work)
                return (false, false) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, false)

        def proof_unique_builtin_const_enum_member_witness_with_context_work(expression: Ast::Expr, report: ProofReport&, caller_module: sview, module_aliases: ProofModuleAliasIndex&, declaration_line: u32, source_work: mutable usize&) -> bool:
            marker: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
            return false if not marker.known
            caller_scope: darray[sview] = proof_global_constant_scope_with_module([], caller_module)
            member: mutable (complete: bool, known: bool, owner: sview, fieldless: bool) = (false, false, "", false)
            resolved_type: mutable Ast::Expr = Ast::Expr.Absent
            match marker.term:
                Ast::Expr.ShorthandMember(parts, position):
                    return false if parts.count != 1
                    member <- proof_unique_const_enum_member_owner_with_work(parts[0], report, source_work)
                    return false if not member.complete or not member.known
                    resolved_type <- Ast::Expr.Ident(member.owner, position)
                Ast::Expr.Field(enum_type, member_name, _):
                    exact: (complete: bool, known: bool, owner: sview, fieldless: bool) = proof_exact_const_enum_member_owner_with_work(enum_type, member_name, report.source.source_declarations, caller_scope, caller_module, module_aliases, declaration_line, report, source_work)
                    return false if not exact.complete
                    member <- exact if exact.known else proof_unique_const_enum_member_owner_with_work(member_name, report, source_work)
                    return false if not member.complete
                    resolved_type <- enum_type
                _:
                    return false
            return false if not member.complete or not member.known or not member.fieldless
            enum_path: mutable darray[sview] = []
            resolved: (complete: bool, known: bool) = proof_operator_enum_type_path_with_aliases_work(resolved_type, caller_scope, declaration_line, caller_module, module_aliases, report, &enum_path, source_work)
            return false if not resolved.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or not resolved.known
            aliases: (complete: bool, overridden: bool) = proof_const_enum_alias_operator_override_in_with_work(enum_path, module_aliases, report, source_work)
            return false if not aliases.complete or aliases.overridden
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
            for protocol in protocols |report, member, source_work|:
                implementation: (complete: bool, exists: bool) = proof_report_builtin_operator_impl_exists_with_work(report, member.owner, protocol, source_work)
                return false if not implementation.complete or implementation.exists
            return true

        # Context-free retention checks remain conservative for scoped module aliases. Source
        # witness production uses the caller-aware entrypoint above, matching replay's lookup.
        def proof_unique_builtin_const_enum_member_witness_with_work(expression: Ast::Expr, report: ProofReport&, source_work: mutable usize&) -> bool:
            empty_aliases: ProofModuleAliasIndex = proof_operator_enum_empty_module_alias_index()
            proof_unique_builtin_const_enum_member_witness_with_context_work(expression, report, "", empty_aliases, 0, source_work)

        def proof_add_const_enum_member_scalar_witnesses_in_with_work(declarations: darray[Ast::Decl]&, current_scope: darray[sview]&, target_path: darray[sview]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, type_expression: Ast::Expr, line: u32, owner: sview, position: Ast::Pos, depth: usize, source_work: mutable usize&) -> bool:
            return false if:
                depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
                target_path.count == 0
            for declaration in declarations |current_scope, target_path, facts, report, type_expression, line, owner, position, depth, source_work|:
                return false if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Enum(declared_name, variants, is_const, _, _):
                        exact_owner: bool = proof_operator_enum_scope_matches_with_work(current_scope, target_path, source_work)
                        return false if:
                            source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            not proof_type_audit_work_charge(sview_len(declared_name) + sview_len(target_path[target_path.count - 1]), source_work)
                        if exact_owner and declared_name == target_path[target_path.count - 1] and is_const:
                            for variant in variants |facts, report, target_path, type_expression, line, owner, position, source_work|:
                                return true if report.analysis_2.scalar_witness_facts >= PROOF_SCALAR_WITNESS_FUNCTION_BUDGET
                                return false if not proof_type_audit_work_charge(1 + sview_len(variant.name), source_work)
                                continue if variant.fields.count != 0
                                member_expression: Ast::Expr = Ast::Expr.Field(type_expression, variant.name, position)
                                return false if not proof_add_operator_enum_scalar_witness_with_work(facts, report, proof_scalar_term_marker(member_expression, position), line, owner, source_work)
                                unique: (complete: bool, known: bool, member_owner: sview, fieldless: bool) = proof_unique_const_enum_member_owner_with_work(variant.name, report, source_work)
                                return false if not unique.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                if unique.known and unique.fieldless and unique.member_owner == target_path[target_path.count - 1]:
                                    shorthand: Ast::Expr = Ast::Expr.ShorthandMember([variant.name], position)
                                    return false if not proof_add_operator_enum_scalar_witness_with_work(facts, report, proof_scalar_term_marker(shorthand, position), line, owner, source_work)
                    Ast::Decl.Module(module_name, body, _):
                        return false if not proof_type_audit_work_charge(sview_len(module_name) + current_scope.count, source_work)
                        nested_scope: darray[sview] = proof_global_constant_scope_with_module(current_scope, module_name)
                        return false if not proof_add_const_enum_member_scalar_witnesses_in_with_work(body, nested_scope, target_path, facts, report, type_expression, line, owner, position, depth + 1, source_work)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_add_const_enum_member_scalar_witnesses_in_with_work(body, current_scope, target_path, facts, report, type_expression, line, owner, position, depth + 1, source_work)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        pass
            return true

        def proof_add_const_enum_member_scalar_witnesses_with_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, type_expression: Ast::Expr, caller_scope: darray[sview]&, caller_module: sview, module_aliases: ProofModuleAliasIndex&, declaration_line: u32, line: u32, owner: sview, position: Ast::Pos, source_work: mutable usize&) -> bool:
            return false if not report.analysis_1.operator_impls.valid
            enum_path: mutable darray[sview] = []
            resolved_path: (complete: bool, known: bool) = proof_operator_enum_type_path_with_aliases_work(type_expression, caller_scope, declaration_line, caller_module, module_aliases, report, &enum_path, source_work)
            return false if not resolved_path.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true if not resolved_path.known or enum_path.count == 0
            aliases: (complete: bool, overridden: bool) = proof_const_enum_alias_operator_override_in_with_work(enum_path, module_aliases, report, source_work)
            return false if not aliases.complete
            return true if aliases.overridden
            concrete_name: sview = enum_path[enum_path.count - 1]
            for protocol in ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"] |report, enum_path, source_work, concrete_name|:
                implementation: (complete: bool, exists: bool) = proof_report_builtin_operator_impl_exists_with_work(report, concrete_name, protocol, source_work)
                return false if not implementation.complete
                return true if implementation.exists
            type_names: mutable darray[sview] = []
            return false if not proof_type_operator_impl_names(type_expression, report, &type_names, 0, source_work)
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
            for protocol in protocols |report, type_names, source_work|:
                for type_name in type_names |report, protocol, source_work|:
                    return false if not proof_type_audit_work_charge(1 + sview_len(type_name) + sview_len(protocol), source_work)
                    implementation: (complete: bool, exists: bool) = proof_report_builtin_operator_impl_exists_with_work(report, type_name, protocol, source_work)
                    return false if not implementation.complete
                    return true if implementation.exists
            empty_scope: darray[sview] = []
            return proof_add_const_enum_member_scalar_witnesses_in_with_work(report.source.source_declarations, empty_scope, enum_path, facts, report, type_expression, line, owner, position, 0, source_work)

        def proof_add_const_enum_value_exclusions_in_with_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, enum_name: sview, position: Ast::Pos, declarations: darray[Ast::Decl]&, depth: usize, found: mutable bool&, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            for declaration in declarations |facts, report, root, type_expression, enum_name, position, depth, found, source_work|:
                return false if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Enum(declared_name, variants, is_const, _, _):
                        return false if not proof_type_audit_work_charge(sview_len(declared_name) + sview_len(enum_name), source_work)
                        if declared_name == enum_name and is_const:
                            found <- true
                            eligible_names: mutable darray[sview] = []
                            eligible_values: mutable darray[i64] = []
                            for variant in variants |variant, eligible_names, eligible_values, report, enum_name, source_work|:
                                return false if not proof_type_audit_work_charge(1, source_work)
                                variant_value: (known: bool, value: i64) = match variant.value_expr:
                                    Ast::Expr.IntLit(value, _): (true, value)
                                    _: (false, 0)
                                continue if not variant_value.known or variant.fields.count != 0
                                member: (complete: bool, known: bool, owner: sview, fieldless: bool) = proof_report_const_enum_member_lookup_with_work(report, variant.name, source_work)
                                return false if not member.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                continue if not member.known or not member.fieldless or member.owner != enum_name
                                return false if not proof_type_audit_work_charge(1 + sview_len(variant.name), source_work)
                                eligible_names.push(variant.name)
                                eligible_values.push(variant_value.value)
                            for first_index in 0..<eligible_names.count |first_index, eligible_names, eligible_values, facts, report, root, type_expression, position, source_work|:
                                first_name: sview = eligible_names[first_index]
                                first_value: i64 = eligible_values[first_index]
                                return false if not proof_type_audit_work_charge(1, source_work)
                                for second_index in first_index + 1..<eligible_names.count |second_index, eligible_names, eligible_values, facts, report, root, type_expression, position, first_name, first_value, source_work|:
                                    second_name: sview = eligible_names[second_index]
                                    second_value: i64 = eligible_values[second_index]
                                    return false if not proof_type_audit_work_charge(1, source_work)
                                    if first_value != second_value:
                                        first_test: Ast::Expr = Ast::Expr.Binary(root, TokenKind.EqEq, Ast::Expr.Field(type_expression, first_name, position), position)
                                        second_test: Ast::Expr = Ast::Expr.Binary(root, TokenKind.EqEq, Ast::Expr.Field(type_expression, second_name, position), position)
                                        exclusion: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, first_test, position), TokenKind.Or, Ast::Expr.Unary(TokenKind.Not, second_test, position), position)
                                        if not proof_replay_summary_expr_charge_with_work(exclusion, source_work):
                                            return false
                                        present: (complete: bool, found: bool) = proof_operator_enum_fact_exists_with_work(facts, exclusion, source_work)
                                        return false if not present.complete
                                        proof_add_traced_fact(facts, report, exclusion, "const-enum-exclusion", position.line, report.analysis_1.type_bounds.owner) if not present.found
                                    member_operator: TokenKind = TokenKind.EqEq if first_value == second_value else TokenKind.BangEq
                                    member_comparison: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Field(type_expression, first_name, position), member_operator, Ast::Expr.Field(type_expression, second_name, position), position)
                                    return false if not proof_replay_summary_expr_charge_with_work(member_comparison, source_work)
                                    member_present: (complete: bool, found: bool) = proof_operator_enum_fact_exists_with_work(facts, member_comparison, source_work)
                                    return false if not member_present.complete
                                    proof_add_traced_fact(facts, report, member_comparison, "const-enum-member-value", position.line, report.analysis_1.type_bounds.owner) if not member_present.found
                                    if first_value != second_value:
                                        reverse_comparison: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Field(type_expression, second_name, position), TokenKind.BangEq, Ast::Expr.Field(type_expression, first_name, position), position)
                                        return false if not proof_replay_summary_expr_charge_with_work(reverse_comparison, source_work)
                                        reverse_present: (complete: bool, found: bool) = proof_operator_enum_fact_exists_with_work(facts, reverse_comparison, source_work)
                                        return false if not reverse_present.complete
                                        proof_add_traced_fact(facts, report, reverse_comparison, "const-enum-member-value", position.line, report.analysis_1.type_bounds.owner) if not reverse_present.found
                    Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                        return false if not proof_add_const_enum_value_exclusions_in_with_work(facts, report, root, type_expression, enum_name, position, body, depth + 1, found, source_work)
                    _:
                        pass
            return true

        def proof_add_const_enum_value_exclusions_with_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, position: Ast::Pos, source_work: mutable usize&) -> bool:
            enum_name: sview = proof_type_head_name_with_work(type_expression, report.source.source_declarations, 0, source_work)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true if enum_name == ""
            aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(report.source.source_declarations, enum_name, 0, source_work)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true if aggregates.enums != 0 or aggregates.const_enums != 1 or aggregates.structs != 0
            type_alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_with_work(report.source.source_declarations, enum_name, 0, source_work)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true if type_alias.count != 0
            hierarchy: bool = proof_enum_in_hierarchy_with_work(report.source.source_annotations, enum_name, source_work)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true if hierarchy
            type_names: mutable darray[sview] = []
            return false if not proof_type_operator_impl_names(type_expression, report, &type_names, 0, source_work)
            for type_name in type_names |report, source_work|:
                equality_impl: (complete: bool, exists: bool) = proof_report_builtin_operator_impl_exists_with_work(report, type_name, "Eq", source_work)
                return false if not equality_impl.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return true if equality_impl.exists
            match root:
                Ast::Expr.Field(root_type, root_member, _):
                    root_name: sview = proof_type_head_name_with_work(root_type, report.source.source_declarations, 0, source_work)
                    root_owner: (complete: bool, known: bool, owner: sview, fieldless: bool) = proof_unique_const_enum_member_owner_with_work(root_member, report, source_work)
                    return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or not root_owner.complete
                    return true if root_owner.known and root_owner.fieldless and root_owner.owner == enum_name and root_name == enum_name
                _:
                    pass
            found: mutable bool = false
            return false if not proof_add_const_enum_value_exclusions_in_with_work(facts, report, root, type_expression, enum_name, position, report.source.source_declarations, 0, &found, source_work)
            return found and source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
