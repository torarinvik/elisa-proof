# Exact module-path ownership records shared by source projection and replay.
extend ElisaProof:
    private:
        def proof_source_kernel_module_path_matches(bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding]&, module_scope: darray[sview]&, owner_identity: usize) -> bool:
            return false if module_scope.count == 0 or owner_identity == 0
            for index in 0..<module_scope.count |index, bindings, module_scope, owner_identity|:
                found: mutable bool = false
                for binding in bindings |binding, index, module_scope, owner_identity, found|:
                    continue if binding.kind != "module-owner-segment" or binding.owner_type_identity != owner_identity or binding.parameter_index != index
                    return false if found or binding.parameter_count != module_scope.count or binding.name != module_scope[index]
                    found <- true
                return false if not found
            return true

        def proof_source_kernel_register_module_owner(bindings: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding]&, module_scope: darray[sview]&, declared_identity: usize) -> (known: bool, identity: usize):
            return (false, 0) if module_scope.count == 0 or declared_identity == 0
            selected: mutable usize = 0
            found: mutable bool = false
            for binding in bindings |binding, module_scope, selected, found|:
                continue if binding.kind != "module-owner-segment" or binding.parameter_index != 0 or binding.parameter_count != module_scope.count
                if proof_source_kernel_module_path_matches(bindings, module_scope, binding.owner_type_identity):
                    return (false, 0) if found and selected != binding.owner_type_identity
                    selected <- binding.owner_type_identity
                    found <- true
            if found:
                return (true, selected)
            for binding in bindings:
                return (false, 0) if binding.kind == "module-owner-segment" and binding.owner_type_identity == declared_identity
            for index in 0..<module_scope.count |index, bindings, module_scope, declared_identity|:
                return (false, 0) if bindings.count >= ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
                bindings.push(ElisaProofKernelCore::ProofKernelTypingBinding{kind: "module-owner-segment", name: module_scope[index], owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: declared_identity, element_type_identity: 0, signature_identity: 0, parameter_index: index, parameter_count: module_scope.count, parameter_has_default: false, parameter_by_reference: false})
            return (true, declared_identity)

        def proof_source_kernel_module_owner_identity(module_path: darray[sview]&, global_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding]) -> (known: bool, identity: usize):
            return (true, 0) if module_path.count == 0
            selected: mutable usize = 0
            found: mutable bool = false
            for binding in global_bindings |binding, module_path, selected, found|:
                continue if binding.kind != "module-owner-segment" or binding.parameter_index != 0 or binding.parameter_count != module_path.count
                if proof_source_kernel_module_path_matches(global_bindings, module_path, binding.owner_type_identity):
                    return (false, 0) if found and selected != binding.owner_type_identity
                    selected <- binding.owner_type_identity
                    found <- true
            return (found, selected)
