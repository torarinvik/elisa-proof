# Bounded transparent type-alias expansion for source-derived builtin conversions.
extend ElisaProof:
    private:
        def proof_source_conversion_generic_line_index_build(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            index: mutable ProofSourceEffectIndex& = &report.source_types.source_effect_index
            source_valid: bool = report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count
            count: usize = report.source_types.source_generic_param_lines.count
            if source_valid and count == 0:
                return index.generics.generic_param_line_index_hashes.count == 0 and index.generics.generic_param_line_index_values.count == 0 and index.generics.generic_param_line_index_counts.count == 0
            if source_valid and index.generics.generic_param_line_index_valid:
                expected_capacity: usize = proof_name_index_capacity(count)
                return expected_capacity != 0 and index.generics.generic_param_line_index_hashes.count == expected_capacity and index.generics.generic_param_line_index_values.count == expected_capacity and index.generics.generic_param_line_index_counts.count == expected_capacity
            index.generics.generic_param_line_index_valid <- false
            index.generics.generic_param_line_index_hashes.clear()
            index.generics.generic_param_line_index_values.clear()
            index.generics.generic_param_line_index_counts.clear()
            return true if:
                not source_valid
                count == 0
            capacity: usize = proof_name_index_capacity(count)
            return false if:
                capacity == 0
                not proof_report_source_work_charge(capacity * 5, source_work) or not proof_report_source_work_charge(count, source_work)
            index.generics.generic_param_line_index_hashes.resize(capacity)
            index.generics.generic_param_line_index_values.resize(capacity)
            index.generics.generic_param_line_index_counts.resize(capacity)
            for slot in 0..<capacity |slot, index, count|:
                index.generics.generic_param_line_index_values[slot] <- count
                index.generics.generic_param_line_index_counts[slot] <- 0
            for row in 0..<count |row, report, index, capacity, count, source_work|:
                name: sview = report.source_types.source_generic_param_names[row]
                line: u32 = report.source_types.source_generic_param_lines[row]
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                hash: u32 = proof_expr_shape_mix(proof_name_hash(name), line.i64())
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, report, index, capacity, count, source_work, placed|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = index.generics.generic_param_line_index_values[slot]
                    if current == count:
                        return false if not proof_report_source_work_charge(3, source_work)
                        index.generics.generic_param_line_index_hashes[slot] <- hash
                        index.generics.generic_param_line_index_values[slot] <- row
                        index.generics.generic_param_line_index_counts[slot] <- 1
                        placed <- true
                        break
                    if current < count and index.generics.generic_param_line_index_hashes[slot] == hash:
                        current_name: sview = report.source_types.source_generic_param_names[current]
                        return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(current_name), source_work)
                        if report.source_types.source_generic_param_lines[current] == line and current_name == name:
                            return false if not proof_report_source_work_charge(1, source_work)
                            index.generics.generic_param_line_index_counts[slot] <- index.generics.generic_param_line_index_counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.generics.generic_param_line_index_values, count, source_work)
            index.generics.generic_param_line_index_valid <- cluster_status.complete and cluster_status.bounded
            return index.generics.generic_param_line_index_valid

        # Build the persistent generic indexes once, before drop fixed-point expansion. Later
        # conversion and replay consumers reuse them after constant-time shape checks.
        def proof_source_conversion_generic_indexes_build(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            index: mutable ProofSourceEffectIndex& = &report.source_types.source_effect_index
            return false if not proof_source_generic_owner_param_index_build(report, source_work)
            return false if not proof_source_generic_owner_arity_index_build(report, source_work)
            source_valid: bool = report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count
            count: usize = report.source_types.source_generic_param_lines.count
            if not source_valid:
                index.generics.generic_param_names.clear()
                index.generics.generic_param_index_hashes.clear()
                index.generics.generic_param_index_values.clear()
                index.generics.generic_param_index_counts.clear()
                index.generics.generic_param_index_valid <- false
                index.generics.generic_param_encoded_line_present <- false
                index.generics.generic_param_line_index_hashes.clear()
                index.generics.generic_param_line_index_values.clear()
                index.generics.generic_param_line_index_counts.clear()
                index.generics.generic_param_line_index_valid <- false
                return true
            if index.generics.generic_param_index_valid:
                name_count: usize = index.generics.generic_param_names.count
                name_capacity: usize = proof_name_index_capacity(name_count)
                line_capacity: usize = proof_name_index_capacity(count)
                name_shape_valid: bool = index.generics.generic_param_index_hashes.count == index.generics.generic_param_index_values.count and index.generics.generic_param_index_hashes.count == index.generics.generic_param_index_counts.count
                name_shape_valid <- name_shape_valid and ((name_count == 0 and index.generics.generic_param_index_hashes.count == 0) or (name_count > 0 and name_capacity != 0 and index.generics.generic_param_index_hashes.count == name_capacity))
                line_shape_valid: bool = count == 0 and index.generics.generic_param_line_index_hashes.count == 0 and index.generics.generic_param_line_index_values.count == 0 and index.generics.generic_param_line_index_counts.count == 0
                line_shape_valid <- line_shape_valid or (count > 0 and line_capacity != 0 and index.generics.generic_param_line_index_valid and index.generics.generic_param_line_index_hashes.count == line_capacity and index.generics.generic_param_line_index_values.count == line_capacity and index.generics.generic_param_line_index_counts.count == line_capacity)
                return true if name_shape_valid and line_shape_valid
            index.generics.generic_param_names.clear()
            index.generics.generic_param_index_hashes.clear()
            index.generics.generic_param_index_values.clear()
            index.generics.generic_param_index_counts.clear()
            index.generics.generic_param_index_valid <- false
            index.generics.generic_param_encoded_line_present <- false
            for row in 0..<count |row, report, index, source_work|:
                name: sview = report.source_types.source_generic_param_names[row]
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                if report.source_types.source_generic_param_lines[row] < 2147483648:
                    return false if not proof_report_source_work_charge(2, source_work)
                    index.generics.generic_param_names.push(name)
                else:
                    index.generics.generic_param_encoded_line_present <- true
            return false if not proof_source_conversion_name_index_build(index.generics.generic_param_names, &index.generics.generic_param_index_hashes, &index.generics.generic_param_index_values, &index.generics.generic_param_index_counts, source_work)
            index.generics.generic_param_index_valid <- true
            return proof_source_conversion_generic_line_index_build(report, source_work)

        def proof_source_conversion_hash_text(value: sview, hash: mutable i64&, work: mutable usize&) -> bool:
            return false if not proof_report_source_work_charge(sview_len(value), work)
            for index in 0..<sview_len(value) |index, value, hash, work|:
                hash <- ((hash ^ sview_at(value, index).i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return true

        def proof_source_conversion_hash_scope_path(expression: Ast::Expr, hash: mutable i64&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_report_source_work_charge(1, work)
            match expression:
                Ast::Expr.Ident(root, _):
                    return proof_source_conversion_hash_text(root, hash, work)
                Ast::Expr.Scope(parent, member, _):
                    return false if:
                        not proof_source_conversion_hash_scope_path(parent, hash, work, depth + 1)
                        not proof_report_source_work_charge(2, work)
                    hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
                    hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
                    return proof_source_conversion_hash_text(member, hash, work)
                _:
                    return false

        def proof_source_conversion_scope_key_hash(owner: sview, name: sview, work: mutable usize&) -> (complete: bool, hash: u32):
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            return (false, 0) if:
                not proof_source_conversion_hash_text(owner, &hash, work)
                not proof_report_source_work_charge(2, work)
            hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return (false, 0) if not proof_source_conversion_hash_text(name, &hash, work)
            return (true, hash.u32())

        def proof_source_conversion_scope_expression_key_hash(owner: Ast::Expr, name: sview, work: mutable usize&) -> (complete: bool, hash: u32):
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            return (false, 0) if:
                not proof_source_conversion_hash_scope_path(owner, &hash, work, 0)
                not proof_report_source_work_charge(2, work)
            hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return (false, 0) if not proof_source_conversion_hash_text(name, &hash, work)
            return (true, hash.u32())

        def proof_source_conversion_scope_matches_owner(head: Ast::Expr, owner: sview, end: usize, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_report_source_work_charge(1, work)
            match head:
                Ast::Expr.Ident(root, _):
                    return false if sview_len(root) != end or not proof_report_source_work_charge(end, work)
                    for index in 0..<end |index, root, owner, work|:
                        return false if sview_at(root, index) != sview_at(owner, index)
                    return true
                Ast::Expr.Scope(parent, member, _):
                    length: usize = sview_len(member)
                    return false if end < length + 2 or not proof_report_source_work_charge(length + 2, work)
                    start: usize = end - length
                    return false if sview_at(owner, start - 1) != 58 or sview_at(owner, start - 2) != 58
                    for index in 0..<length |index, member, owner, start|:
                        return false if sview_at(owner, start + index) != sview_at(member, index)
                    return proof_source_conversion_scope_matches_owner(parent, owner, start - 2, work, depth + 1)
                _:
                    return false

        def proof_source_conversion_scoped_index_build(names: darray[sview]&, owners: darray[sview]&, hashes: mutable darray[u32]&, values: mutable darray[usize]&, counts: mutable darray[usize]&, source_work: mutable usize&) -> bool:
            hashes.clear()
            values.clear()
            counts.clear()
            name_count: usize = names.count
            return false if owners.count != name_count
            return true if name_count == 0
            capacity: usize = proof_name_index_capacity(name_count)
            return false if:
                capacity == 0
                not proof_report_source_work_charge(capacity * 5, source_work) or not proof_report_source_work_charge(name_count, source_work)
            hashes.resize(capacity)
            values.resize(capacity)
            counts.resize(capacity)
            for slot in 0..<capacity |slot, values, counts, name_count|:
                values[slot] <- name_count
                counts[slot] <- 0
            for row in 0..<name_count |row, names, owners, hashes, values, counts, name_count, capacity, source_work|:
                key: (complete: bool, hash: u32) = proof_source_conversion_scope_key_hash(owners[row], names[row], source_work)
                return false if not key.complete
                slot: mutable usize = (key.hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, row, names, owners, hashes, values, counts, name_count, capacity, source_work, placed|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = values[slot]
                    if current == name_count:
                        return false if not proof_report_source_work_charge(3, source_work)
                        hashes[slot] <- key.hash
                        values[slot] <- row
                        counts[slot] <- 1
                        placed <- true
                        break
                    if hashes[slot] == key.hash and current < name_count:
                        owner_length: usize = sview_len(owners[current])
                        name_length: usize = sview_len(names[current])
                        return false if not proof_report_source_work_charge(owner_length, source_work) or not proof_report_source_work_charge(name_length, source_work) or not proof_report_source_work_charge(sview_len(owners[row]), source_work) or not proof_report_source_work_charge(sview_len(names[row]), source_work)
                        if owners[current] == owners[row] and names[current] == names[row]:
                            return false if not proof_report_source_work_charge(1, source_work)
                            counts[slot] <- counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(values, name_count, source_work)
            return cluster_status.complete and cluster_status.bounded

        def proof_source_conversion_alias_formal_index_build(annotations: darray[Ast::EnumAnnotation]&, formals: mutable darray[Ast::EnumAnnotation]&, hashes: mutable darray[u32]&, values: mutable darray[usize]&, counts: mutable darray[usize]&, formal_names: mutable darray[sview]&, formal_starts: mutable darray[usize]&, formal_counts: mutable darray[usize]&, source_work: mutable usize&) -> bool:
            formals.clear()
            hashes.clear()
            values.clear()
            counts.clear()
            formal_names.clear()
            formal_starts.clear()
            formal_counts.clear()
            active_owner: mutable usize = 0
            for annotation in annotations |formals, source_work|:
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.owner), source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                if annotation.owner == "__alias_owner":
                    return false if annotation.identity_id == 0 or annotation.identity_id.u64() != annotation.offset.u64() + 1u64
                    formals.push(annotation)
                    formal_starts.push(formal_names.count)
                    formal_counts.push(0)
                    active_owner <- formals.count - 1
                elif annotation.owner == "__alias_param":
                    return false if:
                        active_owner >= formals.count
                        annotation.identity_id == 0
                        annotation.identity_id != formals[active_owner].identity_id
                        annotation.line != formals[active_owner].line
                        annotation.offset != formals[active_owner].offset
                        annotation.name == ""
                    duplicate: mutable bool = false
                    for prior in formal_starts[active_owner]..<(formal_starts[active_owner] + formal_counts[active_owner]) |prior, formal_names, annotation, source_work, duplicate|:
                        return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(formal_names[prior]), source_work)
                        duplicate <- true if formal_names[prior] == annotation.name
                    return false if duplicate
                    formal_names.push(annotation.name)
                    formal_counts[active_owner] <- formal_counts[active_owner] + 1
                else:
                    active_owner <- formals.count
            count: usize = formals.count
            return true if count == 0
            capacity: usize = proof_name_index_capacity(count)
            return false if capacity == 0 or not proof_report_source_work_charge(capacity * 5, source_work)
            hashes.resize(capacity)
            values.resize(capacity)
            counts.resize(capacity)
            for slot in 0..<capacity |slot, values, counts, count|:
                values[slot] <- count
                counts[slot] <- 0
            for row in 0..<count |row, formals, hashes, values, counts, count, capacity, source_work|:
                annotation: Ast::EnumAnnotation = formals[row]
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                hash: u32 = proof_expr_shape_mix(proof_expr_shape_mix(proof_name_hash(annotation.name), annotation.line.i64()), annotation.offset.i64())
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, formals, hashes, values, counts, count, capacity, source_work, placed|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = values[slot]
                    if current == count:
                        return false if not proof_report_source_work_charge(3, source_work)
                        hashes[slot] <- hash
                        values[slot] <- row
                        counts[slot] <- 1
                        placed <- true
                        break
                    if current < count and hashes[slot] == hash:
                        existing: Ast::EnumAnnotation = formals[current]
                        return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(existing.name), source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                        if existing.line == annotation.line and existing.offset == annotation.offset and existing.name == annotation.name:
                            return false if not proof_report_source_work_charge(1, source_work)
                            counts[slot] <- counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(values, count, source_work)
            return cluster.complete and cluster.bounded

        def proof_source_conversion_alias_has_formals(name: sview, line: u32, offset: u32, formals: darray[Ast::EnumAnnotation]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, source_work: mutable usize&) -> (complete: bool, found: bool):
            count: usize = formals.count
            return (false, false) if hashes.count != values.count or hashes.count != counts.count
            return (true, false) if count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(count)
            return (false, false) if:
                count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
                not proof_report_source_work_charge(1, source_work)
                not proof_report_source_work_charge(sview_len(name), source_work)
            hash: u32 = proof_expr_shape_mix(proof_expr_shape_mix(proof_name_hash(name), line.i64()), offset.i64())
            slot: mutable usize = (hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, line, formals, hashes, values, counts, count, source_work|:
                return (false, false) if not proof_report_source_work_charge(1, source_work)
                current: usize = values[slot]
                return (true, false) if current == count
                return (false, false) if current > count
                if hashes[slot] == hash:
                    annotation: Ast::EnumAnnotation = formals[current]
                    return (false, false) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                    if annotation.line == line and annotation.offset == offset and annotation.name == name:
                        return (false, false) if counts[slot] != 1
                        return (true, true)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, false)
