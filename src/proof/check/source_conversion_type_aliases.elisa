# Bounded transparent type-alias expansion for source-derived builtin conversions.
extend ElisaProof:
    private:
        def proof_source_conversion_generic_line_index_build(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            index: mutable ProofSourceEffectIndex& = &report.source_types.source_effect_index
            source_valid: bool = report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count
            count: usize = report.source_types.source_generic_param_lines.count
            if source_valid and count == 0:
                return index.generics.generic_param_line_index_hashes.count == 0 and index.generics.generic_param_line_index_values.count == 0 and index.generics.generic_param_line_index_counts.count == 0
            if source_valid and index.generics.generic_param_line_index_valid:
                expected_capacity: usize = proof_name_index_capacity(count)
                return expected_capacity != 0 and index.generics.generic_param_line_index_hashes.count == expected_capacity and index.generics.generic_param_line_index_values.count == expected_capacity and index.generics.generic_param_line_index_counts.count == expected_capacity
            index.generics.generic_param_line_index_valid <- false
            index.generics.generic_param_line_index_hashes.clear()
            index.generics.generic_param_line_index_values.clear()
            index.generics.generic_param_line_index_counts.clear()
            return true if:
                not source_valid
                count == 0
            capacity: usize = proof_name_index_capacity(count)
            return false if:
                capacity == 0
                not proof_report_source_work_charge(capacity, source_work) or not proof_report_source_work_charge(count, source_work)
            index.generics.generic_param_line_index_hashes.resize(capacity)
            index.generics.generic_param_line_index_values.resize(capacity)
            index.generics.generic_param_line_index_counts.resize(capacity)
            for slot in 0..<capacity |slot, index, count|:
                index.generics.generic_param_line_index_values[slot] <- count
                index.generics.generic_param_line_index_counts[slot] <- 0
            for row in 0..<count |row, report, index, capacity, count, source_work|:
                name: sview = report.source_types.source_generic_param_names[row]
                line: u32 = report.source_types.source_generic_param_lines[row]
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                hash: u32 = proof_expr_shape_mix(proof_name_hash(name), line.i64())
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, report, index, capacity, count, source_work, placed|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = index.generics.generic_param_line_index_values[slot]
                    if current == count:
                        index.generics.generic_param_line_index_hashes[slot] <- hash
                        index.generics.generic_param_line_index_values[slot] <- row
                        index.generics.generic_param_line_index_counts[slot] <- 1
                        placed <- true
                        break
                    if current < count and index.generics.generic_param_line_index_hashes[slot] == hash:
                        current_name: sview = report.source_types.source_generic_param_names[current]
                        return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(current_name), source_work)
                        if report.source_types.source_generic_param_lines[current] == line and current_name == name:
                            index.generics.generic_param_line_index_counts[slot] <- index.generics.generic_param_line_index_counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.generics.generic_param_line_index_values, count, source_work)
            index.generics.generic_param_line_index_valid <- cluster_status.complete and cluster_status.bounded
            return index.generics.generic_param_line_index_valid

        # Build the persistent generic indexes once, before drop fixed-point expansion. Later
        # conversion and replay consumers reuse them after constant-time shape checks.
        def proof_source_conversion_generic_indexes_build(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            index: mutable ProofSourceEffectIndex& = &report.source_types.source_effect_index
            source_valid: bool = report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count
            count: usize = report.source_types.source_generic_param_lines.count
            if not source_valid:
                index.generics.generic_param_names.clear()
                index.generics.generic_param_index_hashes.clear()
                index.generics.generic_param_index_values.clear()
                index.generics.generic_param_index_counts.clear()
                index.generics.generic_param_index_valid <- false
                index.generics.generic_param_encoded_line_present <- false
                index.generics.generic_param_line_index_hashes.clear()
                index.generics.generic_param_line_index_values.clear()
                index.generics.generic_param_line_index_counts.clear()
                index.generics.generic_param_line_index_valid <- false
                return true
            if index.generics.generic_param_index_valid:
                name_count: usize = index.generics.generic_param_names.count
                name_capacity: usize = proof_name_index_capacity(name_count)
                line_capacity: usize = proof_name_index_capacity(count)
                name_shape_valid: bool = index.generics.generic_param_index_hashes.count == index.generics.generic_param_index_values.count and index.generics.generic_param_index_hashes.count == index.generics.generic_param_index_counts.count
                name_shape_valid <- name_shape_valid and ((name_count == 0 and index.generics.generic_param_index_hashes.count == 0) or (name_count > 0 and name_capacity != 0 and index.generics.generic_param_index_hashes.count == name_capacity))
                line_shape_valid: bool = count == 0 and index.generics.generic_param_line_index_hashes.count == 0 and index.generics.generic_param_line_index_values.count == 0 and index.generics.generic_param_line_index_counts.count == 0
                line_shape_valid <- line_shape_valid or (count > 0 and line_capacity != 0 and index.generics.generic_param_line_index_valid and index.generics.generic_param_line_index_hashes.count == line_capacity and index.generics.generic_param_line_index_values.count == line_capacity and index.generics.generic_param_line_index_counts.count == line_capacity)
                return true if name_shape_valid and line_shape_valid
            index.generics.generic_param_names.clear()
            index.generics.generic_param_index_hashes.clear()
            index.generics.generic_param_index_values.clear()
            index.generics.generic_param_index_counts.clear()
            index.generics.generic_param_index_valid <- false
            index.generics.generic_param_encoded_line_present <- false
            for row in 0..<count |row, report, index, source_work|:
                name: sview = report.source_types.source_generic_param_names[row]
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                if report.source_types.source_generic_param_lines[row] < 2147483648:
                    index.generics.generic_param_names.push(name)
                else:
                    index.generics.generic_param_encoded_line_present <- true
            return false if not proof_source_conversion_name_index_build(index.generics.generic_param_names, &index.generics.generic_param_index_hashes, &index.generics.generic_param_index_values, &index.generics.generic_param_index_counts, source_work)
            index.generics.generic_param_index_valid <- true
            return proof_source_conversion_generic_line_index_build(report, source_work)

        def proof_source_conversion_hash_text(value: sview, hash: mutable i64&, work: mutable usize&) -> bool:
            return false if not proof_report_source_work_charge(sview_len(value), work)
            for index in 0..<sview_len(value) |index, value, hash, work|:
                hash <- ((hash ^ sview_at(value, index).i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return true

        def proof_source_conversion_hash_scope_path(expression: Ast::Expr, hash: mutable i64&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_report_source_work_charge(1, work)
            match expression:
                Ast::Expr.Ident(root, _):
                    return proof_source_conversion_hash_text(root, hash, work)
                Ast::Expr.Scope(parent, member, _):
                    return false if:
                        not proof_source_conversion_hash_scope_path(parent, hash, work, depth + 1)
                        not proof_report_source_work_charge(2, work)
                    hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
                    hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
                    return proof_source_conversion_hash_text(member, hash, work)
                _:
                    return false

        def proof_source_conversion_scope_key_hash(owner: sview, name: sview, work: mutable usize&) -> (complete: bool, hash: u32):
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            return (false, 0) if:
                not proof_source_conversion_hash_text(owner, &hash, work)
                not proof_report_source_work_charge(2, work)
            hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return (false, 0) if not proof_source_conversion_hash_text(name, &hash, work)
            return (true, hash.u32())

        def proof_source_conversion_scope_expression_key_hash(owner: Ast::Expr, name: sview, work: mutable usize&) -> (complete: bool, hash: u32):
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            return (false, 0) if:
                not proof_source_conversion_hash_scope_path(owner, &hash, work, 0)
                not proof_report_source_work_charge(2, work)
            hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            hash <- ((hash ^ 58) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return (false, 0) if not proof_source_conversion_hash_text(name, &hash, work)
            return (true, hash.u32())

        def proof_source_conversion_scope_matches_owner(head: Ast::Expr, owner: sview, end: usize, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_report_source_work_charge(1, work)
            match head:
                Ast::Expr.Ident(root, _):
                    return false if sview_len(root) != end or not proof_report_source_work_charge(end, work)
                    for index in 0..<end |index, root, owner, work|:
                        return false if sview_at(root, index) != sview_at(owner, index)
                    return true
                Ast::Expr.Scope(parent, member, _):
                    length: usize = sview_len(member)
                    return false if end < length + 2 or not proof_report_source_work_charge(length + 2, work)
                    start: usize = end - length
                    return false if sview_at(owner, start - 1) != 58 or sview_at(owner, start - 2) != 58
                    for index in 0..<length |index, member, owner, start|:
                        return false if sview_at(owner, start + index) != sview_at(member, index)
                    return proof_source_conversion_scope_matches_owner(parent, owner, start - 2, work, depth + 1)
                _:
                    return false

        def proof_source_conversion_scoped_index_build(names: darray[sview]&, owners: darray[sview]&, hashes: mutable darray[u32]&, values: mutable darray[usize]&, counts: mutable darray[usize]&, source_work: mutable usize&) -> bool:
            hashes.clear()
            values.clear()
            counts.clear()
            name_count: usize = names.count
            return false if owners.count != name_count
            return true if name_count == 0
            capacity: usize = proof_name_index_capacity(name_count)
            return false if:
                capacity == 0
                not proof_report_source_work_charge(capacity, source_work) or not proof_report_source_work_charge(name_count, source_work)
            hashes.resize(capacity)
            values.resize(capacity)
            counts.resize(capacity)
            for slot in 0..<capacity |slot, values, counts, name_count|:
                values[slot] <- name_count
                counts[slot] <- 0
            for row in 0..<name_count |row, names, owners, hashes, values, counts, name_count, capacity, source_work|:
                key: (complete: bool, hash: u32) = proof_source_conversion_scope_key_hash(owners[row], names[row], source_work)
                return false if not key.complete
                slot: mutable usize = (key.hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, row, names, owners, hashes, values, counts, name_count, capacity, source_work, placed|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = values[slot]
                    if current == name_count:
                        hashes[slot] <- key.hash
                        values[slot] <- row
                        counts[slot] <- 1
                        placed <- true
                        break
                    if hashes[slot] == key.hash and current < name_count:
                        owner_length: usize = sview_len(owners[current])
                        name_length: usize = sview_len(names[current])
                        return false if not proof_report_source_work_charge(owner_length, source_work) or not proof_report_source_work_charge(name_length, source_work) or not proof_report_source_work_charge(sview_len(owners[row]), source_work) or not proof_report_source_work_charge(sview_len(names[row]), source_work)
                        if owners[current] == owners[row] and names[current] == names[row]:
                            counts[slot] <- counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(values, name_count, source_work)
            return cluster_status.complete and cluster_status.bounded

        def proof_source_conversion_alias_formal_index_build(annotations: darray[Ast::EnumAnnotation]&, formals: mutable darray[Ast::EnumAnnotation]&, hashes: mutable darray[u32]&, values: mutable darray[usize]&, counts: mutable darray[usize]&, source_work: mutable usize&) -> bool:
            formals.clear()
            hashes.clear()
            values.clear()
            counts.clear()
            for annotation in annotations |formals, source_work|:
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.owner), source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                formals.push(annotation) if annotation.owner == "__alias_owner"
            count: usize = formals.count
            return true if count == 0
            capacity: usize = proof_name_index_capacity(count)
            return false if capacity == 0 or not proof_report_source_work_charge(capacity, source_work)
            hashes.resize(capacity)
            values.resize(capacity)
            counts.resize(capacity)
            for slot in 0..<capacity |slot, values, counts, count|:
                values[slot] <- count
                counts[slot] <- 0
            for row in 0..<count |row, formals, hashes, values, counts, count, capacity, source_work|:
                annotation: Ast::EnumAnnotation = formals[row]
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                hash: u32 = proof_expr_shape_mix(proof_name_hash(annotation.name), annotation.line.i64())
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, formals, hashes, values, counts, count, capacity, source_work, placed|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = values[slot]
                    if current == count:
                        hashes[slot] <- hash
                        values[slot] <- row
                        counts[slot] <- 1
                        placed <- true
                        break
                    if current < count and hashes[slot] == hash:
                        existing: Ast::EnumAnnotation = formals[current]
                        return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(existing.name), source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                        if existing.line == annotation.line and existing.name == annotation.name:
                            counts[slot] <- counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(values, count, source_work)
            return cluster.complete and cluster.bounded

        def proof_source_conversion_alias_has_formals(name: sview, line: u32, formals: darray[Ast::EnumAnnotation]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, source_work: mutable usize&) -> (complete: bool, found: bool):
            count: usize = formals.count
            return (false, false) if hashes.count != values.count or hashes.count != counts.count
            return (true, false) if count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(count)
            return (false, false) if:
                count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
                not proof_report_source_work_charge(1, source_work)
                not proof_report_source_work_charge(sview_len(name), source_work)
            hash: u32 = proof_expr_shape_mix(proof_name_hash(name), line.i64())
            slot: mutable usize = (hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, line, formals, hashes, values, counts, count, source_work|:
                return (false, false) if not proof_report_source_work_charge(1, source_work)
                current: usize = values[slot]
                return (true, false) if current == count
                return (false, false) if current > count
                if hashes[slot] == hash:
                    annotation: Ast::EnumAnnotation = formals[current]
                    return (false, false) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                    if annotation.line == line and annotation.name == name:
                        return (false, false) if counts[slot] == 0
                        return (true, true)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, false)

        def proof_source_conversion_opaque_seen_init(max_count: usize, seen: mutable ProofSourceOpaqueExternSeen&, source_work: mutable usize&) -> bool:
            seen.names.clear()
            seen.hashes.clear()
            seen.values.clear()
            seen.root_names.clear()
            seen.root_hashes.clear()
            seen.root_values.clear()
            seen.capacity <- proof_name_index_capacity(max_count)
            seen.valid <- false
            return false if max_count > 0 and seen.capacity == 0
            return true if max_count == 0
            return false if not proof_report_source_work_charge(seen.capacity, source_work) or not proof_report_source_work_charge(seen.capacity, source_work)
            seen.hashes.resize(seen.capacity)
            seen.values.resize(seen.capacity)
            seen.root_hashes.resize(seen.capacity)
            seen.root_values.resize(seen.capacity)
            for slot in 0..<seen.capacity |slot, seen.values, seen.capacity|:
                seen.values[slot] <- seen.capacity
            for slot in 0..<seen.capacity |slot, seen.root_values, seen.capacity|:
                seen.root_values[slot] <- seen.capacity
            seen.valid <- true
            return true

        # Inserts into a fixed-capacity table so registering E opaque externs is O(E),
        # without rebuilding the entire source alias index after each declaration.
        def proof_source_conversion_opaque_seen_update(name: sview, names: mutable darray[sview]&, hashes: mutable darray[u32]&, values: mutable darray[usize]&, capacity: usize, insert_missing: bool, source_work: mutable usize&) -> (complete: bool, already_seen: bool):
            return (false, false) if capacity == 0 or values.count != capacity or hashes.count != capacity or names.count > capacity
            return (false, false) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, names, hashes, values, capacity, insert_missing, source_work|:
                return (false, false) if not proof_report_source_work_charge(1, source_work)
                current: usize = values[slot]
                if current == capacity:
                    return (true, false) if not insert_missing
                    return (false, false) if names.count >= capacity
                    names.push(name)
                    hashes[slot] <- wanted_hash
                    values[slot] <- names.count - 1
                    return (true, false)
                return (false, false) if current >= names.count
                if hashes[slot] == wanted_hash:
                    current_name: sview = names[current]
                    return (false, false) if not proof_report_source_work_charge(sview_len(current_name), source_work)
                    return (true, true) if current_name == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false)

        # Stage1 registers a bare, untyped, non-callable extern as an opaque alias.
        # Export metadata keeps the same AST declaration shape but does not register a type.
        def proof_source_conversion_opaque_extern_alias(name: sview, arity: u32, callable: bool, return_type_name: sview, owner: sview, registration_visible: bool, source_alias_index: ProofSourceEffectIndexAliases&, seen: mutable ProofSourceOpaqueExternSeen&, source_work: mutable usize&) -> (complete: bool, opaque_alias: bool):
            return (false, false) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work) or not proof_report_source_work_charge(sview_len(return_type_name), source_work)
            return (true, false) if not registration_visible
            return (true, false) if callable or arity != 0
            return (true, false) if return_type_name != ""
            return (false, false) if not source_alias_index.source_alias_index_valid or not source_alias_index.source_root_alias_index_valid or not source_alias_index.opaque_extern_export_owner_index_valid
            existing_source_alias: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup_work(name, source_alias_index.source_alias_names, source_alias_index.source_alias_index_hashes, source_alias_index.source_alias_index_values, source_alias_index.source_alias_index_counts, source_work)
            return (false, false) if not existing_source_alias.complete
            root_source_alias: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup_work(name, source_alias_index.source_root_alias_names, source_alias_index.source_root_alias_index_hashes, source_alias_index.source_root_alias_index_values, source_alias_index.source_root_alias_index_counts, source_work)
            return (false, false) if not root_source_alias.complete
            return (true, false) if root_source_alias.count > 0 or existing_source_alias.count == 1
            root_opaque_seen: (complete: bool, already_seen: bool) = proof_source_conversion_opaque_seen_update(name, &seen.root_names, &seen.root_hashes, &seen.root_values, seen.capacity, false, source_work)
            return (false, false) if not root_opaque_seen.complete
            return (true, false) if root_opaque_seen.already_seen
            export_marker: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup_work(name, source_alias_index.opaque_extern_export_owners, source_alias_index.opaque_extern_export_owner_index_hashes, source_alias_index.opaque_extern_export_owner_index_values, source_alias_index.opaque_extern_export_owner_index_counts, source_work)
            return (false, false) if not export_marker.complete
            return (true, false) if export_marker.count > 0
            if existing_source_alias.count > 1:
                if owner == "":
                    root_insert: (complete: bool, already_seen: bool) = proof_source_conversion_opaque_seen_update(name, &seen.root_names, &seen.root_hashes, &seen.root_values, seen.capacity, true, source_work)
                    return (false, false) if not root_insert.complete
                return (true, true)
            seen_status: (complete: bool, already_seen: bool) = proof_source_conversion_opaque_seen_update(name, &seen.names, &seen.hashes, &seen.values, seen.capacity, true, source_work)
            return (false, false) if not seen_status.complete
            return (true, false) if seen_status.already_seen
            return (true, true)

        def proof_source_conversion_owner_rows_collect(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, source_alias_index: ProofSourceEffectIndexAliases&, seen: mutable ProofSourceOpaqueExternSeen&, formals: darray[Ast::EnumAnnotation]&, formal_hashes: darray[u32]&, formal_values: darray[usize]&, formal_counts: darray[usize]&, alias_lines: mutable darray[u32]&, alias_owners: mutable darray[sview]&, alias_has_formals: mutable darray[bool]&, declared_type_owners: mutable darray[sview]&, registration_visible: bool, owner: sview, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT
            for declaration in declarations |annotations, source_alias_index, seen, formals, formal_hashes, formal_values, formal_counts, alias_lines, alias_owners, alias_has_formals, declared_type_owners, registration_visible, owner, source_work, depth|:
                return false if not proof_report_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _):
                        return false if not proof_report_source_work_charge(sview_len(owner), source_work)
                        declared_type_owners.push(owner)
                    Ast::Decl.Alias(alias_name, _, position):
                        return false if not proof_report_source_work_charge(sview_len(owner), source_work)
                        has_formals: (complete: bool, found: bool) = proof_source_conversion_alias_has_formals(alias_name, position.line, formals, formal_hashes, formal_values, formal_counts, source_work)
                        return false if not has_formals.complete
                        alias_lines.push(position.line)
                        alias_owners.push(owner)
                        alias_has_formals.push(has_formals.found)
                    Ast::Decl.Extern(alias_name, _, arity, _, callable, return_type_name, _, position):
                        opaque: (complete: bool, opaque_alias: bool) = proof_source_conversion_opaque_extern_alias(alias_name, arity, callable, return_type_name, owner, registration_visible, source_alias_index, seen, source_work)
                        return false if not opaque.complete
                        if opaque.opaque_alias:
                            return false if not proof_report_source_work_charge(sview_len(owner), source_work)
                            alias_lines.push(position.line)
                            alias_owners.push(owner)
                            # The target is intentionally absent: this row shadows wider
                            # lookups but cannot be expanded as a source type alias.
                            alias_has_formals.push(true)
                    Ast::Decl.Module(module_name, body, _):
                        module_registration_visible: bool = registration_visible and depth == 0
                        return false if:
                            not proof_report_source_work_charge(sview_len(module_name), source_work)
                            not proof_source_conversion_owner_rows_collect(body, annotations, source_alias_index, seen, formals, formal_hashes, formal_values, formal_counts, alias_lines, alias_owners, alias_has_formals, declared_type_owners, module_registration_visible, module_name, source_work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_source_conversion_owner_rows_collect(body, annotations, source_alias_index, seen, formals, formal_hashes, formal_values, formal_counts, alias_lines, alias_owners, alias_has_formals, declared_type_owners, false, owner, source_work, depth + 1)
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Law(_, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Const(_, _, _, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            if depth == 0:
                # The drop/type collector appends extern-resource type names after all AST
                # declarations. They have no declaration path in the source tree, so retain
                # their existing root-level name semantics in the parallel owner table.
                for annotation in annotations |declared_type_owners, source_work|:
                    return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                    if annotation.name == "__extern_resource":
                        return false if not proof_report_source_work_charge(sview_len(annotation.owner), source_work)
                        declared_type_owners.push("")
            return true

        # Resource marker classification asks whether a source type name is a unique alias,
        # nominal type, or ambiguous declaration. Flatten that exact AST view once so repeated
        # marker queries use the bounded hash index rather than rescanning all declarations.
        def proof_source_conversion_marker_type_rows_collect(declarations: darray[Ast::Decl]&, names: mutable darray[sview]&, targets: mutable darray[Ast::Expr]&, is_alias: mutable darray[bool]&, nested_scope: mutable darray[bool]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT
            for declaration in declarations |names, targets, is_alias, nested_scope, source_work, depth|:
                return false if not proof_report_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Alias(name, target, _):
                        return false if not proof_report_source_work_charge(sview_len(name), source_work)
                        names.push(name)
                        targets.push(target)
                        is_alias.push(true)
                        nested_scope.push(depth > 0)
                    Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        return false if not proof_report_source_work_charge(sview_len(name), source_work)
                        names.push(name)
                        targets.push(Ast::Expr.Absent)
                        is_alias.push(false)
                        nested_scope.push(depth > 0)
                    Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                        return false if not proof_source_conversion_marker_type_rows_collect(body, names, targets, is_alias, nested_scope, source_work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Law(_, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _):
                        pass
                    _:
                        return false
            return true

        def proof_source_conversion_indexes_build(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            index: mutable ProofSourceEffectIndex& = &report.source_types.source_effect_index
            return false if not proof_source_conversion_generic_indexes_build(report, source_work)
            index.markers.resource_marker_type_index_valid <- false
            index.markers.resource_marker_type_names.clear()
            index.markers.resource_marker_type_targets.clear()
            index.markers.resource_marker_type_is_alias.clear()
            index.markers.resource_marker_type_nested_scope.clear()
            index.markers.resource_marker_type_index_hashes.clear()
            index.markers.resource_marker_type_index_values.clear()
            index.markers.resource_marker_type_index_counts.clear()
            marker_rows_complete: bool = proof_source_conversion_marker_type_rows_collect(report.source.source_declarations, &index.markers.resource_marker_type_names, &index.markers.resource_marker_type_targets, &index.markers.resource_marker_type_is_alias, &index.markers.resource_marker_type_nested_scope, source_work, 0)
            if marker_rows_complete:
                return false if:
                    index.markers.resource_marker_type_names.count != index.markers.resource_marker_type_targets.count or index.markers.resource_marker_type_names.count != index.markers.resource_marker_type_is_alias.count or index.markers.resource_marker_type_names.count != index.markers.resource_marker_type_nested_scope.count
                    not proof_source_conversion_name_index_build(index.markers.resource_marker_type_names, &index.markers.resource_marker_type_index_hashes, &index.markers.resource_marker_type_index_values, &index.markers.resource_marker_type_index_counts, source_work)
                index.markers.resource_marker_type_index_valid <- true
            else:
                # A malformed or excessively nested AST only disables this classifier. Do not
                # let an unused marker index poison unrelated source-effect facts.
                return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            alias_index_reusable: bool = index.aliases.alias_index_valid
            index.aliases.alias_index_valid <- false
            index.aliases.alias_scope_index_valid <- false
            index.types.declared_type_index_valid <- false
            index.types.declared_type_scope_index_valid <- false
            index.aliases.alias_has_formals.clear()
            return false if index.aliases.alias_names.count != index.aliases.alias_targets.count
            index.aliases.alias_lines.clear()
            index.aliases.alias_owners.clear()
            index.types.declared_type_owners.clear()
            alias_formals: mutable darray[Ast::EnumAnnotation] = []
            formal_hashes: mutable darray[u32] = []
            formal_values: mutable darray[usize] = []
            formal_counts: mutable darray[usize] = []
            seen_opaque_externs: mutable ProofSourceOpaqueExternSeen = ProofSourceOpaqueExternSeen{}
            return false if:
                not proof_source_conversion_alias_formal_index_build(report.source.source_annotations, &alias_formals, &formal_hashes, &formal_values, &formal_counts, source_work)
                not index.aliases.source_alias_index_valid
                not proof_source_conversion_opaque_seen_init(index.aliases.source_opaque_extern_count, &seen_opaque_externs, source_work)
                not proof_source_conversion_owner_rows_collect(report.source.source_declarations, report.source.source_annotations, index.aliases, seen_opaque_externs, alias_formals, formal_hashes, formal_values, formal_counts, &index.aliases.alias_lines, &index.aliases.alias_owners, &index.aliases.alias_has_formals, &index.types.declared_type_owners, true, "", source_work, 0)
                index.aliases.alias_lines.count != index.aliases.alias_names.count or index.aliases.alias_owners.count != index.aliases.alias_names.count or index.aliases.alias_has_formals.count != index.aliases.alias_names.count or index.types.declared_type_owners.count != index.types.declared_types.count
            if alias_index_reusable:
                alias_capacity: usize = proof_name_index_capacity(index.aliases.alias_names.count)
                return false if (index.aliases.alias_names.count > 0 and alias_capacity == 0) or index.aliases.alias_index_hashes.count != alias_capacity or index.aliases.alias_index_values.count != alias_capacity or index.aliases.alias_index_counts.count != alias_capacity
            else:
                return false if not proof_source_conversion_name_index_build(index.aliases.alias_names, &index.aliases.alias_index_hashes, &index.aliases.alias_index_values, &index.aliases.alias_index_counts, source_work)
            return false if:
                not proof_source_conversion_name_index_build(index.types.declared_types, &index.types.declared_type_index_hashes, &index.types.declared_type_index_values, &index.types.declared_type_index_counts, source_work)
                not proof_source_conversion_scoped_index_build(index.aliases.alias_names, index.aliases.alias_owners, &index.aliases.alias_scope_index_hashes, &index.aliases.alias_scope_index_values, &index.aliases.alias_scope_index_counts, source_work)
                not proof_source_conversion_scoped_index_build(index.types.declared_types, index.types.declared_type_owners, &index.types.declared_type_scope_index_hashes, &index.types.declared_type_scope_index_values, &index.types.declared_type_scope_index_counts, source_work)
                not proof_source_conversion_scoped_index_build(index.callables.callable_names, index.callables.callable_owners, &index.callables.callable_scope_index_hashes, &index.callables.callable_scope_index_values, &index.callables.callable_scope_index_counts, source_work)
            index.aliases.alias_index_valid <- true
            index.aliases.alias_scope_index_valid <- true
            index.types.declared_type_index_valid <- true
            index.types.declared_type_scope_index_valid <- true
            index.callables.callable_scope_index_valid <- true
            return true
