extend ElisaProof:
    private:
        # The unique alias of `name` in a declaration tree: `(0, Absent)` when there is none,
        # `(1, target)` for exactly one, and `(PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Invalid)` when
        # there are several or the walk meets a module nested past the audit depth.
        #
        # Every type audit asks this, often for every binding, and each ask walks the whole tree.
        # The walk therefore builds no term: a term value is a fresh record in the AST store that
        # is never reclaimed, and starting each level of the walk with one used to grow memory by
        # gigabytes over a large source. The counting walk below allocates nothing; only a unique
        # alias is looked up again for its target.
        def proof_find_type_alias(declarations: darray[Ast::Decl]&, name: sview, depth: usize) -> (count: usize, target: Ast::Expr):
            count: usize = proof_type_alias_count(declarations, name, depth)
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if count > 1
            return (0, Ast::Expr.Absent) if count == 0
            target: mutable Ast::Expr = Ast::Expr.Absent
            proof_type_alias_target(declarations, name, depth, &target)
            return (1, target)

        # The shared-work counterpart used by source analyses that may perform several type
        # lookups for one proof query. Charge both declaration visits and spelling comparisons in
        # both passes; an incomplete walk is represented as ambiguity so callers fail closed.
        def proof_type_alias_count_with_work(declarations: darray[Ast::Decl]&, name: sview, depth: usize, source_work: mutable usize&) -> usize:
            return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |name, depth, count, source_work|:
                return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Alias(alias_name, _, _):
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if not proof_type_audit_work_charge(sview_len(name), source_work)
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if not proof_type_audit_work_charge(sview_len(alias_name), source_work)
                        count <- count + 1 if alias_name == name
                    Ast::Decl.Module(_, body, _):
                        nested: usize = proof_type_alias_count_with_work(body, name, depth + 1, source_work)
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if nested > 1
                        count <- count + nested
                    Ast::Decl.Scoped(body, _):
                        nested: usize = proof_type_alias_count_with_work(body, name, depth + 1, source_work)
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if nested > 1
                        count <- count + nested
                    Ast::Decl.Invalid:
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT
                    _:
                        pass
                return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if count > 1
            return count

        # Scoped declarations retain their enclosing owner; Module establishes a new owner.
        def proof_type_alias_root_count_with_work(declarations: darray[Ast::Decl]&, name: sview, depth: usize, source_work: mutable usize&) -> usize:
            return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |name, depth, count, source_work|:
                return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Alias(alias_name, _, _):
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if not proof_type_audit_work_charge(sview_len(name) + sview_len(alias_name), source_work)
                        count <- count + 1 if alias_name == name
                    Ast::Decl.Scoped(body, _):
                        nested: usize = proof_type_alias_root_count_with_work(body, name, depth + 1, source_work)
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if nested > 1
                        count <- count + nested
                    Ast::Decl.Invalid:
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT
                    _:
                        pass
                return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if count > 1
            return count

        def proof_type_alias_target_with_work(declarations: darray[Ast::Decl]&, name: sview, depth: usize, target: mutable Ast::Expr&, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |name, depth, target, source_work|:
                return false if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Alias(alias_name, alias_target, _):
                        return false if not proof_type_audit_work_charge(sview_len(name), source_work)
                        return false if not proof_type_audit_work_charge(sview_len(alias_name), source_work)
                        if alias_name == name:
                            target <- alias_target
                            return true
                    Ast::Decl.Module(_, body, _):
                        return true if proof_type_alias_target_with_work(body, name, depth + 1, target, source_work)
                    Ast::Decl.Scoped(body, _):
                        return true if proof_type_alias_target_with_work(body, name, depth + 1, target, source_work)
                    _:
                        pass
            return false

        def proof_find_type_alias_with_work(declarations: darray[Ast::Decl]&, name: sview, depth: usize, source_work: mutable usize&) -> (count: usize, target: Ast::Expr):
            count: usize = proof_type_alias_count_with_work(declarations, name, depth, source_work)
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if count > 1
            return (0, Ast::Expr.Absent) if count == 0
            target: mutable Ast::Expr = Ast::Expr.Absent
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if not proof_type_alias_target_with_work(declarations, name, depth, &target, source_work)
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (1, target)

        # The count of the original single walk: an alias adds one, a nested module adds its own
        # count, a module past the depth limit counts as ambiguous, and the walk stops as soon as
        # the count passes one.
        def proof_type_alias_count(declarations: darray[Ast::Decl]&, name: sview, depth: usize) -> usize:
            return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |name, depth, count|:
                match declaration:
                    Ast::Decl.Alias(alias_name, _, _):
                        count <- count + 1 if alias_name == name
                    Ast::Decl.Module(_, body, _):
                        count <- count + proof_type_alias_count(body, name, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        count <- count + proof_type_alias_count(body, name, depth + 1)
                    Ast::Decl.Invalid:
                        return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT
                    _:
                        pass
                return PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT if count > 1
            return count

        # The target of the one alias of `name`, for a tree whose count is one.
        def proof_type_alias_target(declarations: darray[Ast::Decl]&, name: sview, depth: usize, target: mutable Ast::Expr&) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |name, depth, target|:
                match declaration:
                    Ast::Decl.Alias(alias_name, alias_target, _):
                        if alias_name == name:
                            target <- alias_target
                            return true
                    Ast::Decl.Module(_, body, _):
                        return true if proof_type_alias_target(body, name, depth + 1, target)
                    Ast::Decl.Scoped(body, _):
                        return true if proof_type_alias_target(body, name, depth + 1, target)
                    _:
                        pass
            return false
