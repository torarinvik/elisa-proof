extend ElisaProof:
    private:
        def proof_function_call_edge_sources_charge(body: darray[Ast::Stmt]&, parameters: darray[Ast::ParamDecl]&, signature_requires: darray[Ast::Expr]&, signature_ensures: darray[Ast::Expr]&, source_work: mutable usize&) -> bool:
            body_cost: mutable usize = 0
            return false if:
                not proof_replay_summary_expr_cost_body(body, &body_cost, source_work, 0)
                source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + body_cost
            for requirement in signature_requires |source_work|:
                return false if not proof_replay_summary_expr_charge_with_work(requirement, source_work)
            for ensure in signature_ensures |source_work|:
                return false if not proof_replay_summary_expr_charge_with_work(ensure, source_work)
            for parameter in parameters |source_work|:
                return false if parameter.has_default and not proof_replay_summary_expr_charge_with_work(parameter.default_value, source_work)
            return true

        def proof_deterministic_summary_work_abort(functions: mutable ProofFunctionTable&, source_work: mutable usize&) -> void:
            functions.summaries.deterministic.clear()
            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            functions.lookup.module_resolution_work_used <- source_work

        def proof_mark_deterministic_functions(functions: mutable ProofFunctionTable&, source_work: mutable usize&) -> void:
            node_count: usize = functions.lookup.names.count
            if functions.summaries.deterministic.count != node_count or functions.summaries.pure.count != node_count or functions.summaries.recursive.count != node_count:
                functions.summaries.deterministic.clear()
                return
            for index in 0..<node_count |functions, source_work|:
                if not proof_report_source_work_charge(1, &source_work):
                    proof_deterministic_summary_work_abort(functions, source_work)
                    return
                pure: bool = functions.summaries.pure[index]
                functions.summaries.deterministic[index] <- false if functions.summaries.recursive[index] and not pure
                functions.summaries.deterministic[index] <- true if pure
            if functions.call_graph.call_starts.count != node_count or functions.call_graph.call_counts.count != node_count or functions.call_graph.all_calls.count != functions.call_graph.all_call_targets.count:
                for index in 0..<node_count |functions, source_work|:
                    if not proof_report_source_work_charge(1, &source_work):
                        proof_deterministic_summary_work_abort(functions, source_work)
                        return
                    functions.summaries.deterministic[index] <- false if not functions.summaries.pure[index]
                functions.lookup.module_resolution_work_used <- source_work
                return

            # Build the reverse call graph once. Starting from directly nondeterministic
            # callees, invalidate each deterministic caller at most once instead of
            # rescanning every function on every fixed-point round.
            reverse_counts: mutable darray[usize] = []
            reverse_starts: mutable darray[usize] = []
            reverse_edges: mutable darray[usize] = []
            reverse_write: mutable darray[usize] = []
            if not proof_report_source_work_charge(node_count, &source_work):
                proof_deterministic_summary_work_abort(functions, source_work)
                return
            reverse_counts.resize(node_count)
            invalid: mutable darray[usize] = []
            for caller in 0..<node_count |caller, functions, reverse_counts, invalid, source_work|:
                if not proof_report_source_work_charge(1, &source_work):
                    proof_deterministic_summary_work_abort(functions, source_work)
                    return
                start: usize = functions.call_graph.call_starts[caller]
                count: usize = functions.call_graph.call_counts[caller]
                if start > functions.call_graph.all_calls.count or count > functions.call_graph.all_calls.count - start:
                    if functions.summaries.deterministic[caller] and not functions.summaries.pure[caller]:
                        functions.summaries.deterministic[caller] <- false
                        invalid.push(caller)
                    continue
                for offset in 0..<count |offset, start, caller, functions, reverse_counts, invalid, source_work|:
                    if not proof_report_source_work_charge(1, &source_work):
                        proof_deterministic_summary_work_abort(functions, source_work)
                        return
                    edge: usize = start + offset
                    called: sview = functions.call_graph.all_calls[edge]
                    if not proof_report_source_work_charge(sview_len(called), &source_work):
                        proof_deterministic_summary_work_abort(functions, source_work)
                        return
                    continue if called == ""
                    target: usize = functions.call_graph.all_call_targets[edge]
                    if called == "__opaque_call__" or target >= node_count:
                        if functions.summaries.deterministic[caller] and not functions.summaries.pure[caller]:
                            functions.summaries.deterministic[caller] <- false
                            invalid.push(caller)
                        continue
                    reverse_counts[target] <- reverse_counts[target] + 1
                    if not functions.summaries.deterministic[target] and functions.summaries.deterministic[caller] and not functions.summaries.pure[caller]:
                        functions.summaries.deterministic[caller] <- false
                        invalid.push(caller)

            reverse_cursor: mutable usize = 0
            for count in reverse_counts |reverse_starts, reverse_cursor, source_work|:
                if not proof_report_source_work_charge(1, &source_work):
                    proof_deterministic_summary_work_abort(functions, source_work)
                    return
                reverse_starts.push(reverse_cursor)
                reverse_cursor <- reverse_cursor + count
            if not proof_report_source_work_charge(reverse_cursor, &source_work) or not proof_report_source_work_charge(node_count, &source_work):
                proof_deterministic_summary_work_abort(functions, source_work)
                return
            reverse_edges.resize(reverse_cursor)
            reverse_write.extend(reverse_starts)
            for caller in 0..<node_count |caller, functions, reverse_write, reverse_edges, source_work|:
                if not proof_report_source_work_charge(1, &source_work):
                    proof_deterministic_summary_work_abort(functions, source_work)
                    return
                start: usize = functions.call_graph.call_starts[caller]
                count: usize = functions.call_graph.call_counts[caller]
                continue if start > functions.call_graph.all_calls.count or count > functions.call_graph.all_calls.count - start
                for offset in 0..<count |offset, start, caller, functions, reverse_write, reverse_edges, source_work|:
                    if not proof_report_source_work_charge(1, &source_work):
                        proof_deterministic_summary_work_abort(functions, source_work)
                        return
                    edge: usize = start + offset
                    called: sview = functions.call_graph.all_calls[edge]
                    if not proof_report_source_work_charge(sview_len(called), &source_work):
                        proof_deterministic_summary_work_abort(functions, source_work)
                        return
                    continue if called == ""
                    target: usize = functions.call_graph.all_call_targets[edge]
                    continue if target >= node_count
                    slot: usize = reverse_write[target]
                    reverse_edges[slot] <- caller
                    reverse_write[target] <- slot + 1

            pending_index: mutable usize = 0
            while pending_index < invalid.count |pending_index, invalid, reverse_starts, reverse_counts, reverse_edges, functions, source_work|:
                if not proof_report_source_work_charge(1, &source_work):
                    proof_deterministic_summary_work_abort(functions, source_work)
                    return
                failed: usize = invalid[pending_index]
                pending_index <- pending_index + 1
                start: usize = reverse_starts[failed]
                count: usize = reverse_counts[failed]
                for offset in 0..<count |offset, start, reverse_edges, invalid, functions, source_work|:
                    if not proof_report_source_work_charge(1, &source_work):
                        proof_deterministic_summary_work_abort(functions, source_work)
                        return
                    caller: usize = reverse_edges[start + offset]
                    if functions.summaries.deterministic[caller] and not functions.summaries.pure[caller]:
                        functions.summaries.deterministic[caller] <- false
                        invalid.push(caller)
            functions.lookup.module_resolution_work_used <- source_work

        # Runtime calls may materialize a default that invokes a verified pure function. This is
        # separate from the lemma mapper because erased lemma defaults remain intentionally
        # call-free. Evaluation is left-to-right: every missing formal can depend only on earlier
        # formals, and the resolved default must contain no unresolved formal or old-state read.
        def proof_map_runtime_call_arguments(parameters: darray[sview]&, has_defaults: darray[bool]&, defaults: darray[Ast::Expr]&, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&, functions: mutable ProofFunctionTable&) -> bool:
            local_work: mutable usize = 0
            return proof_map_runtime_call_arguments_with_work(parameters, has_defaults, defaults, arguments, argument_names, mapped, functions, &local_work, PROOF_LINEAR_SAFETY_WORK_LIMIT, false)

        def proof_runtime_call_mapping_charge(work: mutable usize&, work_limit: usize, amount: usize, metered: bool) -> bool:
            return true if not metered
            if work > work_limit or amount > work_limit - work:
                work <- work_limit + 1
                return false
            work <- work + amount
            true

        # The index-safety caller shares its per-function meter across mapping, default
        # validation, substitution, and contract replay. Other callers use the same rules with
        # their original local expression-work limits.
        def proof_map_runtime_call_arguments_with_work(parameters: darray[sview]&, has_defaults: darray[bool]&, defaults: darray[Ast::Expr]&, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, work: mutable usize&, work_limit: usize, metered: bool) -> bool:
            mapped.clear()
            return false if argument_names.count != 0 and argument_names.count != arguments.count
            used: mutable darray[bool] = []
            for parameter in parameters |mapped, used, work, work_limit, metered|:
                return false if not proof_runtime_call_mapping_charge(&work, work_limit, 1 + sview_len(parameter), metered)
                mapped.push(Ast::Expr.Absent)
                used.push(false)
            saw_named: mutable bool = false
            next_positional: mutable usize = 0
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, parameters, mapped, used, saw_named, next_positional, work, work_limit, metered|:
                label: sview = argument_names[argument_index] if argument_names.count == arguments.count else ""
                return false if not proof_runtime_call_mapping_charge(&work, work_limit, 1 + sview_len(label), metered)
                parameter_index: mutable usize = parameters.count
                if label == "":
                    return false if saw_named
                    while next_positional < parameters.count and used[next_positional] |next_positional, used, parameters, work, work_limit, metered|:
                        return false if not proof_runtime_call_mapping_charge(&work, work_limit, 1, metered)
                        next_positional <- next_positional + 1
                    return false if next_positional >= parameters.count
                    parameter_index <- next_positional
                    next_positional <- next_positional + 1
                else:
                    saw_named <- true
                    parameter_index <- 0
                    while parameter_index < parameters.count |parameter_index, parameters, label, work, work_limit, metered|:
                        parameter_name: sview = parameters[parameter_index]
                        return false if not proof_runtime_call_mapping_charge(&work, work_limit, 1 + sview_len(parameter_name) + sview_len(label), metered)
                        break if parameter_name == label
                        parameter_index <- parameter_index + 1
                    return false if parameter_index >= parameters.count
                return false if used[parameter_index]
                mapped[parameter_index] <- arguments[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameters.count |parameter_index, used, parameters, has_defaults, defaults, mapped, functions, work, work_limit, metered|:
                return false if not proof_runtime_call_mapping_charge(&work, work_limit, 1, metered)
                if not used[parameter_index]:
                    return false if parameter_index >= has_defaults.count or parameter_index >= defaults.count or not has_defaults[parameter_index]
                    default_expression: Ast::Expr = defaults[parameter_index]
                    if metered:
                        return false if not proof_expr_supported_with_work_limit(default_expression, work, work_limit) or work > work_limit
                        default_has_old: bool = proof_expr_has_old_with_work(default_expression, work, work_limit)
                        return false if work > work_limit or default_has_old
                    else:
                        return false if not proof_expr_supported(default_expression) or proof_expr_has_old(default_expression)
                    if parameter_index + 1 < parameters.count:
                        default_shape_cost: mutable usize = 0
                        shape_exhausted: mutable bool = false
                        if metered:
                            default_shape: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(default_expression, &work, &shape_exhausted)
                            return false if not default_shape.complete or shape_exhausted
                            default_shape_cost <- default_shape.cost
                        for later_index in parameter_index + 1..<parameters.count |later_index, parameters, default_expression, work, work_limit, metered, default_shape_cost, shape_exhausted|:
                            if metered:
                                later_name: sview = parameters[later_index]
                                return false if not proof_linear_safety_work_charge_scaled(&work, &shape_exhausted, default_shape_cost, 1 + sview_len(later_name))
                            return false if proof_expr_mentions_name(default_expression, parameters[later_index])
                    resolved_default: Ast::Expr = proof_substitute(default_expression, parameters, mapped) if not metered else proof_substitute_with_work_limit(default_expression, parameters, mapped, work, work_limit)
                    return false if proof_expr_is_invalid(resolved_default)
                    if metered:
                        return false if not proof_expr_supported_with_work_limit(resolved_default, work, work_limit) or work > work_limit
                        resolved_has_old: bool = proof_expr_has_old_with_work(resolved_default, work, work_limit)
                        return false if work > work_limit or resolved_has_old
                        resolved_has_call: bool = proof_expr_has_call_with_work(resolved_default, work, work_limit)
                        return false if work > work_limit
                        if resolved_has_call:
                            return false if not proof_contract_calls_are_pure_with_source_work(resolved_default, functions, true, work)
                    else:
                        return false if not proof_expr_supported(resolved_default) or proof_expr_has_old(resolved_default)
                        return false if proof_expr_has_call(resolved_default) and not proof_contract_calls_are_pure(resolved_default, functions)
                    mapped[parameter_index] <- resolved_default
                    used[parameter_index] <- true
            return true

        # The hash index stores whether this exact name is duplicated. Hash collisions with
        # another name never trigger the slower owner or line scan. A missing or malformed
        # index answers true, which keeps that scan conservative.
        def proof_function_name_may_repeat(functions: ProofFunctionTable&, name: sview) -> bool:
            return true if functions.lookup.index_values.count == 0 or functions.lookup.index_values.count != functions.lookup.index_hashes.count or functions.lookup.index_values.count != functions.lookup.index_ambiguous.count
            wanted_hash: u32 = proof_name_hash(name)
            capacity: usize = functions.lookup.index_values.count
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, functions, capacity|:
                current: usize = functions.lookup.index_values[slot]
                return false if current == functions.lookup.names.count
                return true if current >= functions.lookup.names.count
                return functions.lookup.index_ambiguous[slot] if functions.lookup.index_hashes[slot] == wanted_hash and functions.lookup.names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return true

        # Collect executable function contracts for modular call checking. The callee's
        # contract is the only fact an ordinary call may contribute; its body is checked in the
        # same report, so an invalid summary still makes the whole command fail.
        def proof_collect_functions(file: Ast::File&, declarations: darray[Ast::Decl], lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, generic_index: ProofSourceEffectIndex&, generic_metadata_valid: bool, region_index: ProofLocalRegionAnnotationIndex&, declaration_path: mutable darray[usize]&, owner_module: sview, module_prefix: usize, source_work: mutable usize&) -> void:
            for declaration_index in 0..<declarations.count |declaration_index, file, lemmas, functions, generic_index, generic_metadata_valid, region_index, declaration_path, owner_module, module_prefix, source_work|:
                declaration: Ast::Decl = declarations[declaration_index]
                declaration_path.push(declaration_index)
                match declaration:
                    Ast::Decl.Extern(name, start, arity, variadic, callable, return_type, decorators, position):
                        proof_collect_extern_signature(file, name, start, arity, variadic, callable, return_type, &decorators, position, &functions.externs.extern_signatures)
                    Ast::Decl.Func(name, parameters, return_type, body, declared_effects, _, position):
                        # Lemmas are erased proof declarations, never executable summaries.
                        # Keeping them out of this table prevents a runtime assignment or
                        # return from manufacturing facts through a proof-only call.
                        lemma_source: (complete: bool, index: usize, declared: bool) = proof_lemma_source_row_with_work(lemmas, name, position.line, position.offset, source_work)
                        if not lemma_source.complete or lemma_source.declared:
                            declaration_path <- declaration_path.truncate(declaration_path.count - 1)
                            continue
                        functions.lookup.names <- functions.lookup.names.push(name)
                        functions.lookup.lines <- functions.lookup.lines.push(position.line)
                        functions.lookup.offsets <- functions.lookup.offsets.push(position.offset)
                        functions.lookup.owner_modules <- functions.lookup.owner_modules.push(owner_module)
                        functions.lookup.module_prefixes <- functions.lookup.module_prefixes.push(module_prefix)
                        functions.lookup.declaration_path_starts <- functions.lookup.declaration_path_starts.push(functions.lookup.all_declaration_path.count)
                        functions.lookup.declaration_path_counts <- functions.lookup.declaration_path_counts.push(declaration_path.count)
                        functions.lookup.all_declaration_path.extend(declaration_path)
                        functions.lookup.name_hashes <- functions.lookup.name_hashes.push(proof_name_hash(name))
                        functions.parameters.metadata.param_starts <- functions.parameters.metadata.param_starts.push(functions.parameters.metadata.all_params.count)
                        functions.parameters.metadata.param_counts <- functions.parameters.metadata.param_counts.push(parameters.count)
                        functions.parameters.regions.region_param_starts <- functions.parameters.regions.region_param_starts.push(functions.parameters.regions.all_region_params.count)
                        region_parameter_count: mutable usize = 0
                        region_params: (complete: bool, head: usize, tail: usize) = proof_local_region_annotation_lookup(position.line, "__region_param", file.local_region_annotations, region_index, source_work, false)
                        if not region_params.complete:
                            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                            return
                        region_row: mutable usize = region_params.head
                        region_steps: mutable usize = 0
                        region_last: mutable usize = region_index.annotation_count
                        while region_row < region_index.annotation_count and region_steps < region_index.annotation_count |region_row, region_steps, region_last, region_params, region_index, file, functions, region_parameter_count, position, source_work|:
                            if region_row >= file.local_region_annotations.count:
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            return if not proof_report_source_work_charge(1, source_work)
                            annotation: Ast::EnumAnnotation = file.local_region_annotations[region_row]
                            if annotation.name != "__region_param" or annotation.line != position.line:
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            return if not proof_report_source_work_charge(sview_len(annotation.name), source_work) or not proof_report_source_work_charge(sview_len(annotation.region), source_work)
                            functions.parameters.regions.all_region_params <- functions.parameters.regions.all_region_params.push(annotation.region)
                            region_parameter_count <- region_parameter_count + 1
                            region_last <- region_row
                            region_row <- region_index.next_rows[region_row]
                            region_steps <- region_steps + 1
                        if region_row != region_index.annotation_count or region_last != region_params.tail:
                            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                            return
                        functions.parameters.regions.region_param_counts <- functions.parameters.regions.region_param_counts.push(region_parameter_count)
                        functions.parameters.regions.all_param_region_starts <- functions.parameters.regions.all_param_region_starts.push(functions.parameters.regions.all_param_regions.count)
                        for parameter in parameters |functions, generic_index, source_work|:
                            functions.parameters.metadata.all_params <- functions.parameters.metadata.all_params.push(parameter.name)
                            parameter_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(parameter.type_expression, file.top_decls, file.generic_param_lines, file.generic_param_names, position.line, position.offset, generic_index.generics.generic_param_owner_row_index_valid, generic_index, generic_metadata_valid, source_work)
                            functions.parameters.metadata.all_parameter_references <- functions.parameters.metadata.all_parameter_references.push(parameter_markers.reference)
                            functions.parameters.metadata.all_parameter_mutable_references <- functions.parameters.metadata.all_parameter_mutable_references.push(parameter_markers.mutable_reference)
                            functions.parameters.metadata.all_parameter_type_marker_complete <- functions.parameters.metadata.all_parameter_type_marker_complete.push(parameter_markers.complete)
                            parameter_has_generic: bool = proof_resource_type_mentions_owner_generic_at_owner_with_work(parameter.type_expression, position.line, position.offset, generic_index.generics.generic_param_owner_row_index_valid, file.generic_param_lines, file.generic_param_names, generic_index, generic_metadata_valid, source_work, 0)
                            functions.parameters.metadata.all_parameter_may_contain_float <- functions.parameters.metadata.all_parameter_may_contain_float.push(parameter_has_generic or proof_type_may_contain_float(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, source_work))
                            functions.parameters.metadata.all_parameter_signed_widths <- functions.parameters.metadata.all_parameter_signed_widths.push(proof_literal_parameter_signed_width(parameter.type_expression, functions.type_indexes.type_audit_index))
                            functions.parameters.metadata.all_parameter_target_reference_free <- functions.parameters.metadata.all_parameter_target_reference_free.push(not parameter_has_generic and proof_parameter_target_is_reference_free(parameter.type_expression, file, source_work))
                            functions.parameters.metadata.all_parameter_mutable <- functions.parameters.metadata.all_parameter_mutable.push(parameter.is_mutable)
                            functions.parameters.metadata.all_has_defaults <- functions.parameters.metadata.all_has_defaults.push(parameter.has_default)
                            functions.parameters.metadata.all_defaults <- functions.parameters.metadata.all_defaults.push(parameter.default_value)
                            parameter_region: mutable sview = ""
                            parameter_region_rows: (complete: bool, head: usize, tail: usize) = proof_local_region_annotation_lookup(position.line, parameter.name, file.local_region_annotations, region_index, source_work, false)
                            if not parameter_region_rows.complete:
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            if parameter_region_rows.head < region_index.annotation_count:
                                if parameter_region_rows.tail >= file.local_region_annotations.count:
                                    source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                    return
                                region_annotation: Ast::EnumAnnotation = file.local_region_annotations[parameter_region_rows.tail]
                                if region_annotation.name != parameter.name or region_annotation.line != position.line:
                                    source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                    return
                                return if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(region_annotation.name), source_work) or not proof_report_source_work_charge(sview_len(region_annotation.region), source_work)
                                parameter_region <- region_annotation.region
                            functions.parameters.regions.all_param_regions <- functions.parameters.regions.all_param_regions.push(parameter_region)
                        # Types resolve against the whole file, not the enclosing module body: an
                        # `extend` block is a separate module declaration and must still see the
                        # structs and aliases its sibling blocks declare.
                        if return_type is declared_return_type:
                            return_generic: bool = proof_resource_type_mentions_owner_generic_at_owner_with_work(declared_return_type, position.line, position.offset, generic_index.generics.generic_param_owner_row_index_valid, file.generic_param_lines, file.generic_param_names, generic_index, generic_metadata_valid, source_work, 0)
                            functions.returns.return_scalar <- functions.returns.return_scalar.push(not return_generic and proof_scalar_type_kind_index(declared_return_type, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, source_work) == 1)
                            return_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(declared_return_type, file.top_decls, file.generic_param_lines, file.generic_param_names, position.line, position.offset, generic_index.generics.generic_param_owner_row_index_valid, generic_index, generic_metadata_valid, source_work)
                            functions.returns.return_references <- functions.returns.return_references.push(return_markers.reference)
                            return_reference_free: bool = proof_type_is_reference_free_with_work(declared_return_type, file.top_decls, file.enum_annotations, 0, source_work)
                            functions.returns.return_reference_free <- functions.returns.return_reference_free.push(not return_generic and return_reference_free)
                            functions.returns.return_mutable_references <- functions.returns.return_mutable_references.push(return_markers.mutable_reference)
                            functions.returns.return_type_marker_complete <- functions.returns.return_type_marker_complete.push(return_markers.complete)
                            functions.returns.return_reference_parameters <- functions.returns.return_reference_parameters.push(proof_resource_reference_return_parameter(parameters, return_type, body, file.top_decls, file.generic_param_lines, file.generic_param_names, position.line, position.offset, generic_index.generics.generic_param_owner_row_index_valid, generic_index, generic_metadata_valid, source_work))
                            functions.returns.return_sviews <- functions.returns.return_sviews.push(proof_resource_type_is_sview(declared_return_type))
                            functions.returns.return_types <- functions.returns.return_types.push(declared_return_type)
                            functions.returns.return_label_starts <- functions.returns.return_label_starts.push(functions.returns.all_return_labels.count)
                            return_labels: darray[sview] = proof_return_tuple_labels(declared_return_type, file.enum_annotations)
                            functions.returns.return_label_counts <- functions.returns.return_label_counts.push(return_labels.count)
                            for label in return_labels |functions|:
                                functions.returns.all_return_labels <- functions.returns.all_return_labels.push(label)
                        else:
                            functions.returns.return_scalar <- functions.returns.return_scalar.push(false)
                            functions.returns.return_references <- functions.returns.return_references.push(false)
                            functions.returns.return_reference_free <- functions.returns.return_reference_free.push(true)
                            functions.returns.return_mutable_references <- functions.returns.return_mutable_references.push(false)
                            # No declared return type is the language's unit return, so there is
                            # no unresolved marker to classify.
                            functions.returns.return_type_marker_complete <- functions.returns.return_type_marker_complete.push(true)
                            functions.returns.return_reference_parameters <- functions.returns.return_reference_parameters.push(parameters.count)
                            functions.returns.return_sviews <- functions.returns.return_sviews.push(false)
                            functions.returns.return_types <- functions.returns.return_types.push(Ast::Expr.Invalid)
                            functions.returns.return_label_starts <- functions.returns.return_label_starts.push(functions.returns.all_return_labels.count)
                            functions.returns.return_label_counts <- functions.returns.return_label_counts.push(0)
                        return_region: mutable sview = ""
                        return_region_rows: (complete: bool, head: usize, tail: usize) = proof_local_region_annotation_lookup(position.line, "__region_return", file.local_region_annotations, region_index, source_work, false)
                        if not return_region_rows.complete:
                            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                            return
                        if return_region_rows.head < region_index.annotation_count:
                            if return_region_rows.tail >= file.local_region_annotations.count:
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            region_annotation: Ast::EnumAnnotation = file.local_region_annotations[return_region_rows.tail]
                            if region_annotation.name != "__region_return" or region_annotation.line != position.line:
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            return if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(region_annotation.name), source_work) or not proof_report_source_work_charge(sview_len(region_annotation.region), source_work)
                            return_region <- region_annotation.region
                        functions.returns.return_regions <- functions.returns.return_regions.push(return_region)
                        functions.summaries.effect_starts <- functions.summaries.effect_starts.push(functions.summaries.all_effects.count)
                        functions.summaries.effect_counts <- functions.summaries.effect_counts.push(declared_effects.count)
                        functions.summaries.effects_declared <- functions.summaries.effects_declared.push(declared_effects.count > 0)
                        for effect in declared_effects |functions|:
                            functions.summaries.all_effects <- functions.summaries.all_effects.push(effect)
                        functions.call_graph.call_starts <- functions.call_graph.call_starts.push(functions.call_graph.all_calls.count)
                        call_names: mutable darray[sview] = []
                        call_qualifiers: mutable darray[sview] = []
                        call_sources: mutable darray[Ast::Expr] = []
                        signature_contracts: (complete: bool, preconditions: darray[Ast::Expr], postconditions: darray[Ast::Expr]) = proof_signature_contracts_for_line_with_work(file, position.line, source_work)
                        source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1 if not signature_contracts.complete
                        signature_requires: darray[Ast::Expr] = signature_contracts.preconditions
                        signature_ensures: darray[Ast::Expr] = signature_contracts.postconditions
                        if proof_function_call_edge_sources_charge(body, parameters, signature_requires, signature_ensures, source_work):
                            proof_collect_body_call_edges(body, &call_names, &call_qualifiers, &call_sources)
                            for parameter in parameters |call_names, call_qualifiers, call_sources|:
                                if parameter.has_default:
                                    proof_collect_call_edges(parameter.default_value, &call_names, &call_qualifiers, &call_sources)
                            for requirement in signature_requires |call_names, call_qualifiers, call_sources|:
                                proof_collect_call_edges(requirement, &call_names, &call_qualifiers, &call_sources)
                            for ensure in signature_ensures |call_names, call_qualifiers, call_sources|:
                                proof_collect_call_edges(ensure, &call_names, &call_qualifiers, &call_sources)
                        else:
                            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        for called in call_names |functions|:
                            functions.call_graph.all_calls <- functions.call_graph.all_calls.push(called)
                        for qualifier in call_qualifiers |functions|:
                            functions.call_graph.all_call_qualifiers <- functions.call_graph.all_call_qualifiers.push(qualifier)
                        for source in call_sources |functions|:
                            functions.call_graph.all_call_callee_sources <- functions.call_graph.all_call_callee_sources.push(source)
                        functions.call_graph.call_counts <- functions.call_graph.call_counts.push(call_names.count)
                        functions.contracts.obligations.requires_starts <- functions.contracts.obligations.requires_starts.push(functions.contracts.obligations.all_requires.count)
                        functions.contracts.obligations.ensure_starts <- functions.contracts.obligations.ensure_starts.push(functions.contracts.obligations.all_ensures.count)
                        functions.contracts.frames.changes_starts <- functions.contracts.frames.changes_starts.push(functions.contracts.frames.all_changes.count)
                        functions.contracts.frames.preserves_starts <- functions.contracts.frames.preserves_starts.push(functions.contracts.frames.all_preserves.count)
                        functions.contracts.termination.decreases_starts <- functions.contracts.termination.decreases_starts.push(functions.contracts.termination.all_decreases.count)
                        decreases_components: mutable darray[Ast::Expr] = []
                        has_unbounded_decreases: mutable bool = false
                        for statement in body |functions, decreases_components, has_unbounded_decreases|:
                            match statement:
                                Ast::Stmt.Contract(kind, expression, _):
                                    if kind == "decreases":
                                        proof_decreases_components(expression, &decreases_components)
                                    if kind == "decreases*":
                                        has_unbounded_decreases <- true
                                _:
                                    pass
                        if decreases_components.count == 0 and not has_unbounded_decreases:
                            inferred: (known: bool, parameter: sview, position: usize, type_name: sview) = proof_infer_structural_decrease(functions.type_indexes.enum_index, parameters)
                            if inferred.known:
                                decreases_components.push(Ast::Expr.Ident(inferred.parameter, position))
                        functions.contracts.termination.all_decreases.extend(decreases_components)
                        functions.contracts.termination.decreases_counts <- functions.contracts.termination.decreases_counts.push(decreases_components.count)
                        functions.contracts.termination.decreases_unbounded <- functions.contracts.termination.decreases_unbounded.push(has_unbounded_decreases)
                        structural_measure: mutable bool = false
                        structural_subject_position: mutable usize = parameters.count
                        structural_subject_type: mutable sview = ""
                        if decreases_components.count == 1:
                            structural_subject: sview = proof_ident_name(decreases_components[0])
                            structural_subject_position <- proof_enum_parameter_position(functions.type_indexes.enum_index, parameters, structural_subject)
                            structural_measure <- structural_subject_position < parameters.count
                            structural_subject_type <- proof_head_name(parameters[structural_subject_position].type_expression) if structural_measure
                        functions.contracts.termination.structural <- functions.contracts.termination.structural.push(structural_measure)
                        functions.contracts.termination.structural_subject_positions <- functions.contracts.termination.structural_subject_positions.push(structural_subject_position)
                        functions.contracts.termination.structural_subject_types <- functions.contracts.termination.structural_subject_types.push(structural_subject_type)
                        requires_count: mutable usize = 0
                        ensures_count: mutable usize = 0
                        for statement in body |functions, requires_count, ensures_count|:
                            match statement:
                                Ast::Stmt.Contract(kind, expression, _):
                                    if kind == "requires":
                                        functions.contracts.obligations.all_requires <- functions.contracts.obligations.all_requires.push(expression)
                                        requires_count <- requires_count + 1
                                    if proof_is_ensure_kind(kind):
                                        functions.contracts.obligations.all_ensures <- functions.contracts.obligations.all_ensures.push(expression)
                                        ensures_count <- ensures_count + 1
                                _:
                                    pass
                        functions.contracts.obligations.all_requires.extend(signature_requires)
                        functions.contracts.obligations.all_ensures.extend(signature_ensures)
                        requires_count <- requires_count + signature_requires.count
                        ensures_count <- ensures_count + signature_ensures.count
                        if ensures_count == 0:
                            unfolded_ensures: darray[Ast::Expr] = proof_unfolded_ensures(parameters, body, return_type, file.top_decls, source_work)
                            functions.contracts.obligations.all_ensures.extend(unfolded_ensures)
                            ensures_count <- unfolded_ensures.count
                        functions.contracts.obligations.requires_counts <- functions.contracts.obligations.requires_counts.push(requires_count)
                        functions.contracts.obligations.ensure_counts <- functions.contracts.obligations.ensure_counts.push(ensures_count)
                        changes_before: usize = functions.contracts.frames.all_changes.count
                        preserves_before: usize = functions.contracts.frames.all_preserves.count
                        for statement in body |functions|:
                            match statement:
                                Ast::Stmt.Contract(contract_kind, expression, _):
                                    decoded: (known: bool, place: ProofFramePlace) = proof_frame_place(expression)
                                    functions.contracts.frames.all_changes <- functions.contracts.frames.all_changes.push(decoded.place) if contract_kind == "changes" and decoded.known
                                    functions.contracts.frames.all_preserves <- functions.contracts.frames.all_preserves.push(decoded.place) if contract_kind == "preserves" and decoded.known
                                _:
                                    pass
                        proof_frame_collect_annotations(file, functions.type_indexes.frame_annotation_index, name, &functions.contracts.frames.all_changes, &functions.contracts.frames.all_preserves)
                        functions.contracts.frames.changes_counts <- functions.contracts.frames.changes_counts.push(functions.contracts.frames.all_changes.count - changes_before)
                        functions.contracts.frames.preserves_counts <- functions.contracts.frames.preserves_counts.push(functions.contracts.frames.all_preserves.count - preserves_before)
                    Ast::Decl.Module(module_name, module_body, _):
                        proof_collect_functions(file, module_body, lemmas, functions, generic_index, generic_metadata_valid, region_index, declaration_path, module_name, declaration_path.count, source_work)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_collect_functions(file, scoped_body, lemmas, functions, generic_index, generic_metadata_valid, region_index, declaration_path, owner_module, module_prefix, source_work)
                    _:
                        pass
                declaration_path <- declaration_path.truncate(declaration_path.count - 1)

        # Apply an executable call summary. An explicit, checked `changes` frame allows facts
        # about disjoint places to survive; an unframed or lossy summary clears them. The caller's
        # own frame and preserves clauses are checked at the same boundary, so modular proofs
        # cannot smuggle an out-of-frame write through an opaque call. A summary edge inside a
        # recursive component is exceptional: it is available only after both functions provide
        # checked decreases measures, with the callee measure nonnegative and strictly smaller.
        # `result_value` is `Absent` for a statement call and the call expression for an assigned
        # or returned value.
