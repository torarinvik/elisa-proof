extend ElisaProof:
    private:
        struct ProofEffectContainmentNameIndex:
            hashes: mutable darray[u32] = []
            slots: mutable darray[usize] = []

        def proof_effect_containment_name_index_place(names: darray[sview]&, index: mutable ProofEffectContainmentNameIndex&, wanted: sview, wanted_hash: u32, value_index: usize, source_work: mutable usize&) -> (complete: bool, inserted: bool):
            capacity: usize = index.slots.count
            return (false, false) if capacity == 0
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, value_index, names, index, capacity, source_work|:
                return (false, false) if not proof_report_source_work_charge(1, source_work)
                current: usize = index.slots[slot]
                if current == 0:
                    index.slots[slot] <- value_index + 1
                    return (true, true)
                existing: usize = current - 1
                return (false, false) if existing >= names.count or existing >= index.hashes.count
                if index.hashes[existing] == wanted_hash:
                    candidate: sview = names[existing]
                    return (false, false) if not proof_report_source_work_charge(sview_len(candidate), source_work)
                    return (true, false) if candidate == wanted
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false)

        def proof_effect_containment_name_index_rebuild(names: darray[sview]&, index: mutable ProofEffectContainmentNameIndex&, capacity: usize, source_work: mutable usize&) -> bool:
            return false if:
                capacity == 0 or names.count > capacity / 2 or names.count != index.hashes.count
                not proof_report_source_work_charge(capacity, source_work)
            index.slots.clear()
            index.slots.resize(capacity)
            for slot in 0..<capacity |slot, index|:
                index.slots[slot] <- 0
            for item_index in 0..<names.count |item_index, names, index, capacity, source_work|:
                placed: (complete: bool, inserted: bool) = proof_effect_containment_name_index_place(names, index, names[item_index], index.hashes[item_index], item_index, source_work)
                return false if not placed.complete or not placed.inserted
            return true

        def proof_effect_containment_name_index_add(names: mutable darray[sview]&, index: mutable ProofEffectContainmentNameIndex&, wanted: sview, source_work: mutable usize&) -> bool:
            return false if names.count != index.hashes.count or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if names.count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            next_count: usize = names.count + 1
            if index.slots.count == 0 or next_count > index.slots.count / 2:
                capacity: usize = proof_name_index_capacity(next_count)
                return false if capacity == 0 or not proof_effect_containment_name_index_rebuild(names, index, capacity, source_work)
            return false if not proof_report_source_work_charge(sview_len(wanted), source_work)
            wanted_hash: u32 = proof_name_hash(wanted)
            placed: (complete: bool, inserted: bool) = proof_effect_containment_name_index_place(names, index, wanted, wanted_hash, names.count, source_work)
            return false if not placed.complete
            if placed.inserted:
                return false if not proof_report_source_work_charge(2, source_work)
                names.push(wanted)
                index.hashes.push(wanted_hash)
            return true

        def proof_effect_containment_name_index_find(names: darray[sview]&, index: ProofEffectContainmentNameIndex&, wanted: sview, source_work: mutable usize&) -> (complete: bool, found: bool, row: usize):
            capacity: usize = index.slots.count
            return (false, false, names.count) if names.count != index.hashes.count
            return (true, false, names.count) if names.count == 0 and capacity == 0
            return (false, false, names.count) if capacity == 0 or not proof_report_source_work_charge(sview_len(wanted), source_work)
            wanted_hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, names, index, capacity, source_work|:
                return (false, false, names.count) if not proof_report_source_work_charge(1, source_work)
                current: usize = index.slots[slot]
                return (true, false, names.count) if current == 0
                existing: usize = current - 1
                return (false, false, names.count) if existing >= names.count or existing >= index.hashes.count
                if index.hashes[existing] == wanted_hash:
                    candidate: sview = names[existing]
                    return (false, false, names.count) if not proof_report_source_work_charge(sview_len(candidate), source_work)
                    return (true, true, existing) if candidate == wanted
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, names.count)

        def proof_effect_containment_row_validation_charge(effects: darray[sview]&, source_work: mutable usize&) -> bool:
            return false if not proof_report_source_work_charge(effects.count, source_work)
            for effect in effects |source_work|:
                return false if not proof_report_source_work_charge(sview_len(effect), source_work)
            return true

        def proof_check_effect_containment(functions: ProofFunctionTable&, report: mutable ProofReport&, function_name: sview, line: u32, offset: u32, caller: usize) -> void:
            return if caller >= functions.lookup.source.names.count or caller >= functions.lookup.source.lines.count or caller >= functions.lookup.source.offsets.count
            return if functions.lookup.source.names[caller] != function_name or functions.lookup.source.lines[caller] != line or functions.lookup.source.offsets[caller] != offset
            return if caller >= functions.summaries.effects_declared.count or not functions.summaries.effects_declared[caller]
            return if caller >= functions.summaries.effect_starts.count or caller >= functions.summaries.effect_counts.count
            declared_start: usize = functions.summaries.effect_starts[caller]
            declared_count: usize = functions.summaries.effect_counts[caller]
            return if declared_start > functions.summaries.all_effects.count or declared_count > functions.summaries.all_effects.count - declared_start
            declared: mutable darray[sview] = []
            declared_index: mutable ProofEffectContainmentNameIndex = ProofEffectContainmentNameIndex{}
            if not proof_report_source_work_charge(declared_count, &report.source_types.source_effect_index.work.implicit_effect_work):
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "effect-row scan exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            for offset in 0..<declared_count |offset, functions, declared, declared_index, declared_start, report, line, function_name|:
                effect: sview = functions.summaries.all_effects[declared_start + offset]
                if not proof_effect_containment_name_index_add(&declared, &declared_index, effect, &report.source_types.source_effect_index.work.implicit_effect_work):
                    if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "effect-row indexing exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    else:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "the declared effect row exceeded its bounded exact-name index")
                    return
            if not proof_effect_containment_row_validation_charge(declared, &report.source_types.source_effect_index.work.implicit_effect_work):
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "declared effect-row validation exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if proof_effect_row_is_abstract(declared):
                proof_add_finding(report, "effect-row-abstract", line, function_name, "an abstract effect row has no comparable members")
                return
            return if caller >= functions.call_graph.call_starts.count or caller >= functions.call_graph.call_counts.count
            call_start: usize = functions.call_graph.call_starts[caller]
            call_count: usize = functions.call_graph.call_counts[caller]
            return if functions.call_graph.all_calls.count != functions.call_graph.all_call_targets.count or functions.call_graph.all_calls.count != functions.call_graph.all_call_positions.count or functions.call_graph.all_calls.count != functions.call_graph.all_call_expressions.count or call_start > functions.call_graph.all_calls.count or call_count > functions.call_graph.all_calls.count - call_start
            if not proof_report_source_work_charge(call_count, &report.source_types.source_effect_index.work.implicit_effect_work):
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "effect call-set scan exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            callee_names: mutable darray[sview] = []
            callee_name_index: mutable ProofEffectContainmentNameIndex = ProofEffectContainmentNameIndex{}
            callee_targets: mutable darray[usize] = []
            callee_starts: mutable darray[usize] = []
            callee_counts: mutable darray[usize] = []
            callee_effects: mutable darray[sview] = []
            for offset in 0..<call_count |offset, functions, call_start, callee_names, callee_name_index, callee_targets, callee_starts, callee_counts, callee_effects, report, function_name, line, declared|:
                name: sview = functions.call_graph.all_calls[call_start + offset]
                continue if name == ""
                callee: usize = functions.call_graph.all_call_targets[call_start + offset]
                return if callee > functions.lookup.source.names.count
                identity: (complete: bool, found: bool, row: usize) = proof_effect_containment_name_index_find(callee_names, callee_name_index, name, &report.source_types.source_effect_index.work.implicit_effect_work)
                if not identity.complete:
                    if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "effect target identity lookup exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    else:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "the bounded effect target identity index is incomplete")
                    return
                if identity.found:
                    if identity.row >= callee_targets.count:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "the effect call target index is inconsistent")
                        return
                    if callee_targets[identity.row] != callee:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "same-spelled callees resolve to distinct source declarations that this certificate format cannot distinguish")
                        return
                    continue
                previous_count: usize = callee_names.count
                if not proof_effect_containment_name_index_add(&callee_names, &callee_name_index, name, &report.source_types.source_effect_index.work.implicit_effect_work):
                    if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "effect call-set indexing exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    else:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "the effect call set exceeded its bounded exact-name index")
                    return
                continue if callee_names.count == previous_count
                row: mutable darray[sview] = []
                if callee < functions.lookup.source.names.count:
                    if callee >= functions.summaries.effect_starts.count or callee >= functions.summaries.effect_counts.count:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "a called function has incomplete effect metadata")
                        return
                    start: usize = functions.summaries.effect_starts[callee]
                    count: usize = functions.summaries.effect_counts[callee]
                    if start > functions.summaries.all_effects.count or count > functions.summaries.all_effects.count - start:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "a called function has an invalid effect metadata range")
                        return
                    row_index: mutable ProofEffectContainmentNameIndex = ProofEffectContainmentNameIndex{}
                    if not proof_report_source_work_charge(count, &report.source_types.source_effect_index.work.implicit_effect_work):
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "callee effect-row scan exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return
                    for member in 0..<count |member, start, functions, row, row_index, report, line, function_name|:
                        effect: sview = functions.summaries.all_effects[start + member]
                        if not proof_effect_containment_name_index_add(&row, &row_index, effect, &report.source_types.source_effect_index.work.implicit_effect_work):
                            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                report.proof_obligation(false)
                                proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "callee effect-row indexing exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                            else:
                                proof_add_finding(report, "effect-call-opaque", line, function_name, "the called effect row exceeded its bounded exact-name index")
                            return
                else:
                    imported_lookup: (complete: bool, index: usize) = proof_extern_signature_index_with_work(functions, name, &report.source_types.source_effect_index.work.implicit_effect_work)
                    if not imported_lookup.complete:
                        report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "extern signature lookup exceeded its shared source-work bound", "extern-signature-index-lookup-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return
                    imported: usize = imported_lookup.index
                    if imported >= functions.externs.extern_signatures.count:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "a called function has no unambiguous imported effect row")
                        return
                    signature: ProofExternSignature = functions.externs.extern_signatures[imported]
                    identity = proof_replay_extern_declaration_identity_with_work(&report.source.source_declarations, &report.source_contracts.source_extern_parameters, &report.source.source_annotations, &signature, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                    if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "extern declaration identity exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return
                    if not signature.callable or not signature.parameters_valid or not signature.effects_complete or not identity.valid:
                        proof_add_finding(report, "effect-call-opaque", line, function_name, "an extern effect row lacks complete source-bound declaration metadata")
                        return
                    row.extend(signature.effects)
                if not proof_effect_containment_row_validation_charge(&row, &report.source_types.source_effect_index.work.implicit_effect_work):
                    report.proof_obligation(false)
                    proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "callee effect-row validation exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
                if proof_effect_row_is_abstract(&row):
                    proof_add_finding(report, "effect-row-abstract", line, function_name, "a called function has an abstract effect row")
                    return
                if not proof_replay_effect_cross_row_work_charge(&row, &declared, &report.source_types.source_effect_index.work.implicit_effect_work):
                    report.proof_obligation(false)
                    proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "effect containment comparison exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
                for effect in row |effect, declared, report, function_name, line|:
                    if not (any member in declared where member == effect):
                        proof_add_finding(report, "effect-row-exceeded", line, function_name, "a called function declares an effect outside this function's row")
                        return
                callee_starts.push(callee_effects.count)
                callee_counts.push(row.count)
                callee_effects.extend(row)
                callee_targets.push(callee)
            needed_nodes: usize = declared.count + callee_effects.count + 2 * callee_names.count + 2
            needed_children: usize = declared.count + callee_effects.count + callee_names.count
            if not proof_resource_kernel_capacity(report, needed_nodes, needed_children, function_name):
                proof_kernel_budget_note(report, function_name)
                proof_add_effect_goal_attempt(report, report.analysis_1.kernel.nodes.count, line, function_name)
                return
            declared_roots: mutable darray[usize] = []
            for effect in declared |effect, report, declared_roots|:
                declared_roots.push(proof_kernel_add_node(&report.analysis_1.kernel.nodes, "effect", "", 0, 0, 0, 0, 0, 0, effect, ""))
            declared_children_start: usize = report.analysis_1.kernel.children.count
            report.analysis_1.kernel.children.extend(declared_roots)
            declared_row: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "effect-row", "", 0, 0, 0, declared_children_start, declared_roots.count, 0, "", "")
            call_roots: mutable darray[usize] = []
            for callee in 0..<callee_names.count |callee, callee_names, callee_starts, callee_counts, callee_effects, report, call_roots|:
                callee_effect_roots: mutable darray[usize] = []
                for member in 0..<callee_counts[callee] |member, callee, callee_starts, callee_effects, report, callee_effect_roots|:
                    callee_effect_roots.push(proof_kernel_add_node(&report.analysis_1.kernel.nodes, "effect", "", 0, 0, 0, 0, 0, 0, callee_effects[callee_starts[callee] + member], ""))
                callee_children_start: usize = report.analysis_1.kernel.children.count
                report.analysis_1.kernel.children.extend(callee_effect_roots)
                callee_row: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "effect-row", "", 0, 0, 0, callee_children_start, callee_effect_roots.count, 0, "", "")
                call_roots.push(proof_kernel_add_node(&report.analysis_1.kernel.nodes, "effect-call", "", callee_row, 0, 0, 0, 0, 0, callee_names[callee], ""))
            containment_children_start: usize = report.analysis_1.kernel.children.count
            report.analysis_1.kernel.children.extend(call_roots)
            containment: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "effect-containment", "", declared_row, line.usize(), 0, containment_children_start, call_roots.count, offset.i64(), function_name, "")
            if not proof_replay_effect_source_valid_with_work(&report.source.source_declarations, &report.source.source_annotations, &report.source_contracts.source_extern_parameters, &report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, containment, function_name, line, &report.source_types.source_effect_index.work.implicit_effect_work):
                if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    report.proof_obligation(false)
                    proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "effect trace source binding exceeded its shared source-work bound", "effect-containment-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                else:
                    proof_add_finding(report, "effect-call-opaque", line, function_name, "the emitted effect trace failed independent source binding")
                return
            proof_add_effect_goal_attempt(report, containment, line, function_name)
