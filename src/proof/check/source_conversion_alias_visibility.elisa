# Keep the global alias fallback aligned with Stage1's source alias table.
extend ElisaProof:
    private:
        def proof_source_conversion_root_alias_visibility_scan(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&, depth: usize) -> (complete: bool, safe: bool):
            return (false, false) if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT
            safe: mutable bool = true
            for declaration in declarations |annotations, source_work, depth, safe|:
                return (false, false) if not proof_report_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Import(_, _):
                        # Imports do not add rows to Stage1's source alias table. Its final
                        # fallback is global and uniqueness-based, so an unrelated import
                        # must not disable that fallback for every bare alias.
                        pass
                    Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                        nested: (complete: bool, safe: bool) = proof_source_conversion_root_alias_visibility_scan(body, annotations, source_work, depth + 1)
                        return (false, false) if not nested.complete
                        safe <- false if not nested.safe
                    Ast::Decl.Invalid:
                        return (false, false)
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _):
                        pass
                    _:
                        return (false, false)
            if depth == 0:
                for annotation in annotations |source_work, safe|:
                    return (false, false) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.owner), source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                    safe <- false if annotation.owner in {"__from_src", "__from_member"} or annotation.name in {"__using", "__using_member", "__using_alias", "__using_alias_target", "__binding_wildcard_import"}
            return (true, safe)
