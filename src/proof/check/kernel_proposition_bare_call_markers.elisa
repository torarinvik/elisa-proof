# Emit one source-selected owner marker per name while preserving local-shadow evidence.
extend ElisaProof:
    private:
        def proof_source_kernel_add_bare_call_owner_markers(scoped_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], local_bindings: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding]&, source_work: mutable usize&) -> bool:
            capacity: usize = proof_index_capacity(scoped_bindings.count)
            return false if capacity == 0 and scoped_bindings.count > 0
            hashes: mutable darray[u32] = []
            slots: mutable darray[usize] = []
            names: mutable darray[sview] = []
            if capacity > 0:
                return false if not proof_source_kernel_charge_work(capacity * 2, source_work)
                hashes.resize(capacity)
                slots.resize(capacity)
                for slot in 0..<capacity |slot, slots, source_work|:
                    return false if not proof_source_kernel_charge_work(1, source_work)
                    slots[slot] <- 0
            for visible in scoped_bindings |visible, local_bindings, hashes, slots, names, capacity, source_work|:
                return false if not proof_source_kernel_charge_work(1, source_work)
                if visible.kind == "local-call-shadow":
                    return false if:
                        not proof_source_kernel_charge_work(sview_len(visible.name), source_work)
                        local_bindings.count >= PROOF_SOURCE_KERNEL_GLOBAL_BINDING_LIMIT
                    local_bindings.push(visible)
                    continue
                continue if visible.kind != "function" and visible.kind != "function-incomplete"
                return false if capacity == 0 or not proof_source_kernel_charge_work(sview_len(visible.name), source_work)
                hash: u32 = proof_name_hash(visible.name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                is_new: mutable bool = false
                recorded: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, visible, hash, slot, capacity, hashes, slots, names, source_work, is_new, recorded|:
                    return false if not proof_source_kernel_charge_work(1, source_work)
                    value: usize = slots[slot]
                    if value == 0:
                        return false if not proof_source_kernel_charge_work(3, source_work)
                        slots[slot] <- names.count + 1
                        hashes[slot] <- hash
                        names.push(visible.name)
                        is_new <- true
                        recorded <- true
                        break
                    return false if value > names.count
                    if hashes[slot] == hash:
                        prior: sview = names[value - 1]
                        return false if not proof_source_kernel_charge_text_comparison(prior, visible.name, source_work)
                        if prior == visible.name:
                            recorded <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not recorded
                continue if not is_new
                return false if:
                    not proof_source_kernel_charge_work(1, source_work)
                    local_bindings.count >= PROOF_SOURCE_KERNEL_GLOBAL_BINDING_LIMIT
                local_bindings.push(ElisaProofKernelCore::ProofKernelTypingBinding{kind: "bare-call-owner", name: visible.name, owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: visible.owner_type_identity, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false})
            return true
