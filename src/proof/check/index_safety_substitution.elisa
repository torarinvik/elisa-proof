# Keep declared fixed-array places only at the bounds-check boundary. Ordinary
# symbolic evaluation continues to invalidate mutated record values.
extend ElisaProof:
    private:
        def proof_substitute_index_safety(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, depth: usize) -> Ast::Expr:
            return proof_substitute(expression, names, values) if depth >= 64
            match expression:
                Ast::Expr.Index(object, index, position):
                    receiver: mutable Ast::Expr = proof_substitute(object, names, values)
                    if not proof_indexable_object(receiver) and proof_fixed_array_extent_for_object(object, fixed_names, fixed_extents) >= 0:
                        # This restores a type-level extent, never a field value.
                        # Calls, moves and non-place receivers stay opaque.
                        receiver <- object if proof_indexable_object(object) and not proof_expr_has_call(object) and not proof_expr_has_move(object)
                    return Ast::Expr.Index(receiver, proof_substitute_index_safety(index, names, values, fixed_names, fixed_extents, depth + 1), position)
                Ast::Expr.Slice(object, low, high, position):
                    receiver: mutable Ast::Expr = proof_substitute(object, names, values)
                    if not proof_indexable_object(receiver) and proof_fixed_array_extent_for_object(object, fixed_names, fixed_extents) >= 0:
                        receiver <- object if proof_indexable_object(object) and not proof_expr_has_call(object) and not proof_expr_has_move(object)
                    return Ast::Expr.Slice(receiver, proof_substitute_index_safety(low, names, values, fixed_names, fixed_extents, depth + 1), proof_substitute_index_safety(high, names, values, fixed_names, fixed_extents, depth + 1), position)
                Ast::Expr.If(condition, then_expr, else_expr, position):
                    return Ast::Expr.If(proof_substitute_index_safety(condition, names, values, fixed_names, fixed_extents, depth + 1), proof_substitute_index_safety(then_expr, names, values, fixed_names, fixed_extents, depth + 1), proof_substitute_index_safety(else_expr, names, values, fixed_names, fixed_extents, depth + 1), position)
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    substituted: mutable darray[Ast::Expr] = []
                    for argument in arguments |substituted|:
                        substituted.push(proof_substitute_index_safety(argument, names, values, fixed_names, fixed_extents, depth + 1))
                    return Ast::Expr.Call(proof_substitute(callee, names, values), substituted, argument_names, position)
                Ast::Expr.Binary(left, operator, right, position):
                    return Ast::Expr.Binary(proof_substitute_index_safety(left, names, values, fixed_names, fixed_extents, depth + 1), operator, proof_substitute_index_safety(right, names, values, fixed_names, fixed_extents, depth + 1), position)
                Ast::Expr.Unary(operator, operand, position):
                    return Ast::Expr.Unary(operator, proof_substitute_index_safety(operand, names, values, fixed_names, fixed_extents, depth + 1), position)
                Ast::Expr.Paren(inner, position):
                    return Ast::Expr.Paren(proof_substitute_index_safety(inner, names, values, fixed_names, fixed_extents, depth + 1), position)
                Ast::Expr.Field(object, field, position):
                    # Preserve normal record-update projection for field values.
                    return proof_substitute(expression, names, values)
                _:
                    return proof_substitute(expression, names, values)
