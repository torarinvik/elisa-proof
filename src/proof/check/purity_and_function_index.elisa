extend ElisaProof:
    private:
        def proof_parameter_type_is_mutable(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    return proof_parameter_type_is_mutable(operand)
                Ast::Expr.Binary(left, _, _, _):
                    return proof_parameter_type_is_mutable(left)
                Ast::Expr.Paren(inner, _):
                    return proof_parameter_type_is_mutable(inner)
                Ast::Expr.Refinement(base, _, _):
                    return proof_parameter_type_is_mutable(base)
                _:
                    return false

        def proof_expr_mentions_any_global(expression: Ast::Expr, mutable_globals: darray[sview]&) -> bool:
            for global_name in mutable_globals:
                return true if proof_expr_mentions_name(expression, global_name)
            return false

        # Purity may ignore pattern forms that test values, and a variant test whose payloads are
        # only named or skipped. Such a binder can move a payload out of the callee's own
        # argument, but that is an ownership effect inside the callee: a summary is used only for
        # a verified callee, whose body the resource checker has already certified, and a logical
        # contract call never executes. Struct, tuple, `as` and pinned patterns stay outside this
        # tier.
        def proof_pure_match_pattern(pattern: Ast::Pattern) -> bool:
            match pattern:
                Ast::Pattern.Variant(_, fields):
                    for field in fields:
                        match field:
                            Ast::Pattern.Wildcard:
                                pass
                            Ast::Pattern.Binding(binding):
                                return false if binding == ""
                            Ast::Pattern.Field(selector, inner):
                                return false if selector == "" or inner.count != 1
                                match inner[0]:
                                    Ast::Pattern.Binding(binding):
                                        return false if binding == ""
                                    _:
                                        return false if not proof_pure_match_pattern(inner[0])
                            _:
                                return false
                    return true
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options:
                        return false if not proof_pure_match_pattern(option)
                    return true
                _:
                    return false

        # A total pure summary cannot observe mutable ambient state. The compiler parser records
        # `global mutable` declarations in its annotation side table; reject those names in every
        # expression of the candidate body/defaults. Name collisions with a local are rejected
        # conservatively because this kernel does not carry binding identities through the AST.
        def proof_pure_body_reads_mutable_global(body: darray[Ast::Stmt]&, mutable_globals: darray[sview]&) -> bool:
            for statement in body:
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return true if proof_expr_mentions_any_global(returned, mutable_globals)
                    Ast::Stmt.Expr(expression, _):
                        if expression is Ast::Expr.Block(statements, value, captures, _):
                            return true if value is not Ast::Expr.Invalid and proof_expr_mentions_any_global(value, mutable_globals)
                            for captured_name in captures |mutable_globals|:
                                return true if any global_name in mutable_globals where global_name == captured_name
                            return true if proof_pure_body_reads_mutable_global(statements, mutable_globals)
                        return true if proof_expr_mentions_any_global(expression, mutable_globals)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_expr_mentions_any_global(initializer, mutable_globals)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_expr_mentions_any_global(condition, mutable_globals) or proof_pure_body_reads_mutable_global(then_body, mutable_globals) or proof_pure_body_reads_mutable_global(else_body, mutable_globals)
                    Ast::Stmt.For(_, _, iterable, loop_body, _):
                        return true if proof_expr_mentions_any_global(iterable, mutable_globals) or proof_pure_body_reads_mutable_global(loop_body, mutable_globals)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_expr_mentions_any_global(scrutinee, mutable_globals)
                        for arm in arms |mutable_globals|:
                            return true if not proof_pure_match_pattern(arm.pattern)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    return true if proof_expr_mentions_any_global(arm.guard, mutable_globals)
                            return true if proof_pure_body_reads_mutable_global(arm.body, mutable_globals)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_expr_mentions_any_global(expression, mutable_globals)
                    _:
                        return true
            return false

        def proof_pure_parameter_is_darray(type_expression: Ast::Expr) -> bool:
            match type_expression:
                Ast::Expr.Paren(inner, _):
                    return proof_pure_parameter_is_darray(inner)
                Ast::Expr.Refinement(base, _, _):
                    return proof_pure_parameter_is_darray(base)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_pure_parameter_is_darray(inner) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable
                    return false
                Ast::Expr.Index(head, _, _):
                    return proof_ident_name(head) == "darray"
                _:
                    return false

        def proof_pure_body_shadows_name(body: darray[Ast::Stmt]&, target: sview) -> bool:
            for statement in body:
                match statement:
                    Ast::Stmt.VarDecl(name, _, _, _):
                        return true if name == target
                    Ast::Stmt.For(_, variables, _, loop_body, _):
                        return true if any variable in variables where variable == target
                        return true if proof_pure_body_shadows_name(loop_body, target)
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return true if proof_pure_body_shadows_name(then_body, target) or proof_pure_body_shadows_name(else_body, target)
                    Ast::Stmt.Expr(Ast::Expr.Block(statements, _, _, _), _):
                        return proof_pure_body_shadows_name(statements, target)
                    Ast::Stmt.Match(_, _, _):
                        # Pattern binders are a separate source namespace; without a typed
                        # binding identity, decline a name-based iterable check around a match.
                        return true
                    Ast::Stmt.While(_, _, _):
                        return true
                    Ast::Stmt.Block(_, _, _, _, _):
                        return true
                    _:
                        pass
            return false

        def proof_pure_loop_iterable_supported(iterable: Ast::Expr, parameters: darray[Ast::ParamDecl]&, root_body: darray[Ast::Stmt]&) -> bool:
            match iterable:
                Ast::Expr.Binary(low, operator, high, _):
                    return (operator == TokenKind.RangeLt or operator == TokenKind.RangeLe) and proof_expr_supported(low) and proof_pure_expression_shape(low) and proof_expr_supported(high) and proof_pure_expression_shape(high)
                Ast::Expr.Ident(name, _):
                    for parameter in parameters:
                        if parameter.name == name:
                            return proof_pure_parameter_is_darray(parameter.type_expression) and not proof_pure_body_shadows_name(root_body, name)
                    return false
                _:
                    return false

        def proof_pure_loop_captures_are_parameters(captures: darray[sview]&, parameters: darray[Ast::ParamDecl]&) -> bool:
            return false if captures.count == 0
            for capture_index in 0..<captures.count |capture_index, captures, parameters|:
                capture_name: sview = captures[capture_index]
                return false if capture_name == ""
                for prior in 0..<capture_index:
                    return false if captures[prior] == capture_name
                parameter_matches: mutable usize = 0
                for parameter in parameters |capture_name, parameter_matches|:
                    if parameter.name == capture_name:
                        parameter_matches <- parameter_matches + 1
                        return false if parameter.is_mutable or proof_parameter_type_is_mutable(parameter.type_expression) or not proof_pure_parameter_is_darray(parameter.type_expression)
                return false if parameter_matches != 1
            return true

        def proof_pure_body_direct(body: darray[Ast::Stmt]&, root_body: darray[Ast::Stmt]&, parameters: darray[Ast::ParamDecl]&, report: ProofReport&) -> bool:
            for statement in body:
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return false if not proof_expr_supported(returned)
                            return false if not proof_pure_expression_shape(returned)
                    Ast::Stmt.Expr(expression, position):
                        continue if proof_inert_statement_kind(statement, report) == PROOF_INERT_PASS
                        if expression is Ast::Expr.Block(statements, value, captures, _):
                            # A for-loop header with captures lowers to a block expression. Admit
                            # only its no-yield, single-loop form with immutable darray formals;
                            # arbitrary block scopes and hidden write-back remain refused.
                            return false if value is not Ast::Expr.Invalid or statements.count != 1 or not proof_pure_loop_captures_are_parameters(captures, parameters)
                            return proof_pure_body_direct(statements, root_body, parameters, report)
                        if not proof_expr_supported(expression) or not proof_pure_expression_shape(expression):
                            return false
                    Ast::Stmt.VarDecl(_, _, initializer, position):
                        if not proof_expr_supported(initializer) or not proof_pure_expression_shape(initializer):
                            return false
                    Ast::Stmt.Assign(_, _, _, position):
                        return false
                    Ast::Stmt.If(condition, then_body, else_body, position):
                        if not proof_expr_supported(condition) or not proof_pure_expression_shape(condition):
                            return false
                        if not proof_pure_body_direct(then_body, root_body, parameters, report) or not proof_pure_body_direct(else_body, root_body, parameters, report):
                            return false
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return false if not proof_expr_supported(scrutinee)
                        return false if not proof_pure_expression_shape(scrutinee)
                        for arm in arms:
                            return false if not proof_pure_match_pattern(arm.pattern)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    return false if proof_expr_has_old(arm.guard) or not proof_expr_supported(arm.guard) or not proof_pure_expression_shape(arm.guard)
                            return false if not proof_pure_body_direct(arm.body, root_body, parameters, report)
                    Ast::Stmt.While(_, _, position):
                        return false
                    Ast::Stmt.For(_, variables, iterable, loop_body, position):
                        if not proof_pure_loop_iterable_supported(iterable, parameters, root_body):
                            return false
                        if iterable is Ast::Expr.Ident(iterable_name, _):
                            return false if any variable in variables where variable == iterable_name
                        if not proof_pure_body_direct(loop_body, root_body, parameters, report):
                            return false
                    Ast::Stmt.Block(_, _, _, _, _):
                        return false
                    Ast::Stmt.Contract(kind, expression, _):
                        return false if kind != "requires" and not proof_is_ensure_kind(kind) and kind != "decreases" and kind != "decreases*"
                        # An entry-state reference in a postcondition describes the pure
                        # function's contract; it does not make its executable body effectful.
                        # Keep old(...) out of every other contract kind. Calls in postconditions
                        # are logical dependencies rather than executable body effects; the
                        # contract-call checker separately requires each one to be verified,
                        # total, and pure before its summary can be used.
                        return false if not proof_is_ensure_kind(kind) and proof_expr_has_old(expression)
                        return false if proof_expr_has_executable_call(expression) and not proof_is_ensure_kind(kind)
                        return false if not proof_expr_supported(expression)
                    Ast::Stmt.Break(_, _):
                        return false
                    Ast::Stmt.Continue(_, _):
                        return false
                    Ast::Stmt.Invalid:
                        return false
                    _:
                        return false
            return true

        # `allow_requires` asks only whether the body is deterministic: a precondition makes the
        # function partial, so it may not be a total contract term, but every call that runs
        # has proved its precondition and still reads nothing but its by-value arguments.
        def proof_function_is_directly_pure(functions: ProofFunctionTable&, function_index: usize, parameters: darray[Ast::ParamDecl]&, effects: darray[sview]&, body: darray[Ast::Stmt]&, mutable_globals: darray[sview]&, report: ProofReport&, allow_requires: bool) -> bool:
            return false if function_index >= functions.param_starts.count or function_index >= functions.param_counts.count
            return false if function_index >= functions.requires_counts.count or function_index >= functions.changes_counts.count or function_index >= functions.preserves_counts.count
            return false if (functions.requires_counts[function_index] > 0 and not allow_requires) or functions.changes_counts[function_index] > 0 or functions.preserves_counts[function_index] > 0
            return false if effects.count > 0
            param_start: usize = functions.param_starts[function_index]
            return false if function_index >= functions.param_counts.count or functions.param_counts[function_index] != parameters.count
            for parameter_index in 0..<parameters.count |parameter_index, functions, param_start|:
                slot: usize = param_start + parameter_index
                return false if slot >= functions.all_parameter_mutable.count or functions.all_parameter_mutable[slot] or parameter_index >= parameters.count or parameters[parameter_index].is_mutable or proof_parameter_type_is_mutable(parameters[parameter_index].type_expression)
                if parameters[parameter_index].has_default:
                    # Defaults execute when the argument is omitted. Their call edges are added
                    # to the same fixed-point graph as body calls, so only verified pure calls
                    # can participate in a pure function's default computation.
                    return false if not proof_expr_supported(parameters[parameter_index].default_value)
                    return false if not proof_pure_expression_shape(parameters[parameter_index].default_value)
                    return false if proof_expr_has_old(parameters[parameter_index].default_value)
                    return false if proof_expr_mentions_any_global(parameters[parameter_index].default_value, mutable_globals)
            return true if proof_pure_range_search_body(body, parameters, mutable_globals, report)
            return false if proof_pure_body_reads_mutable_global(body, mutable_globals)
            return proof_pure_body_direct(body, body, parameters, report)

        def proof_recursive_purity_eligible(functions: ProofFunctionTable&, function_index: usize) -> bool:
            return false if function_index >= functions.recursive.count or not functions.recursive[function_index]
            return false if function_index >= functions.decreases_counts.count or function_index >= functions.decreases_unbounded.count or function_index >= functions.decreases_starts.count
            return false if functions.decreases_counts[function_index] == 0 or functions.decreases_unbounded[function_index]
            return proof_decreases_range_valid(functions.decreases_starts[function_index], functions.decreases_counts[function_index], functions.all_decreases.count)

        # Recursive purity is a component certificate, not a per-edge shortcut. In particular,
        # one locally pure member must not become pure by pointing at another member whose body
        # reaches an unknown or effectful function. Inspect every member and every outgoing edge
        # together before allowing any recursive summary edge in the fixed point.
        def proof_recursive_component_is_pure_candidate(functions: ProofFunctionTable&, source: usize) -> bool:
            return false if source >= functions.names.count
            member_index: mutable usize = 0
            while member_index < functions.names.count |member_index, functions, source|:
                if proof_functions_same_recursive_component(functions, source, member_index):
                    return false if member_index >= functions.direct_pure.count or not functions.direct_pure[member_index]
                    return false if not proof_recursive_purity_eligible(functions, member_index)
                    return false if member_index >= functions.call_starts.count or member_index >= functions.call_counts.count
                    member_start: usize = functions.call_starts[member_index]
                    member_count: usize = functions.call_counts[member_index]
                    return false if member_start > functions.all_calls.count or member_count > functions.all_calls.count - member_start
                    for call_offset in 0..<member_count |call_offset, member_start, functions, source|:
                        called: sview = functions.all_calls[member_start + call_offset]
                        return false if called == "__opaque_call__"
                        called_index: usize = proof_function_call_target(functions, member_start + call_offset)
                        return false if called_index >= functions.names.count
                        if not proof_functions_same_recursive_component(functions, source, called_index):
                            return false if called_index >= functions.pure.count or not functions.pure[called_index]
                member_index <- member_index + 1
            return true

        # A recursive pure function may use calls within its own SCC as total values only when
        # every recursive member has an explicit bounded decreases tuple and a declaration-local
        # purity certificate. The ordinary call checker still proves each edge's nonnegativity
        # and strict descent while checking the bodies; this helper only opens the summary fixed
        # point for that already-certified recursive component.
        def proof_function_calls_are_pure(functions: ProofFunctionTable&, function_index: usize, allow_recursive_component: bool) -> bool:
            return false if function_index >= functions.call_starts.count or function_index >= functions.call_counts.count
            start: usize = functions.call_starts[function_index]
            count: usize = functions.call_counts[function_index]
            return false if start > functions.all_calls.count or count > functions.all_calls.count - start
            for offset in 0..<count |offset, start, functions, function_index, allow_recursive_component|:
                called: sview = functions.all_calls[start + offset]
                called_index: usize = proof_function_call_target(functions, start + offset)
                return false if called == "__opaque_call__"
                continue if called_index < functions.pure.count and functions.pure[called_index]
                recursive_member: bool = allow_recursive_component and called_index < functions.recursive.count and functions.recursive[called_index] and proof_functions_same_recursive_component(functions, function_index, called_index)
                continue if recursive_member and proof_recursive_component_is_pure_candidate(functions, function_index)
                return false
            return true

        # Compute declaration-local purity before the call-graph fixed point. This pass must cover
        # the complete table first: otherwise a mutually recursive pair would be classified based
        # on declaration order rather than on the properties of the entire component.
        def proof_mark_direct_pure_functions_pass(file: Ast::File&, declarations: darray[Ast::Decl], functions: mutable ProofFunctionTable&, cursor: mutable usize&, mutable_globals: darray[sview]&, report: ProofReport&) -> void:
            for declaration in declarations |file, functions, cursor, mutable_globals, report|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, effects, _, position):
                        # The executable table already excludes lemmas. Resolve the declaration
                        # through that indexed table by name and line, so a bare name repeated
                        # in another module neither skips this row nor shifts later rows.
                        function_index: usize = proof_function_index_at_line(functions, name, position.line)
                        continue if function_index >= functions.names.count
                        cursor <- cursor + 1
                        if function_index < functions.direct_pure.count:
                            functions.direct_pure[function_index] <- proof_function_is_directly_pure(functions, function_index, parameters, effects, body, mutable_globals, report, false)
                        if function_index < functions.deterministic.count:
                            functions.deterministic[function_index] <- proof_function_is_directly_pure(functions, function_index, parameters, effects, body, mutable_globals, report, true)
                    Ast::Decl.Module(_, module_body, _):
                        proof_mark_direct_pure_functions_pass(file, module_body, functions, cursor, mutable_globals, report)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_mark_direct_pure_functions_pass(file, scoped_body, functions, cursor, mutable_globals, report)
                    _:
                        pass

        # Populate purity after the complete function table exists. The fixed point admits an
        # acyclic chain of pure calls, plus recursive SCCs whose ordinary body checker will prove
        # bounded decreases on every edge.
        def proof_mark_pure_functions_pass(file: Ast::File&, declarations: darray[Ast::Decl], functions: mutable ProofFunctionTable&, cursor: mutable usize&, changed: mutable bool&) -> void:
            for declaration in declarations |file, functions, cursor, changed|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, effects, _, position):
                        # The executable table already excludes lemmas. Resolve the declaration
                        # through that indexed table by name and line, so a bare name repeated
                        # in another module neither skips this row nor shifts later rows.
                        function_index: usize = proof_function_index_at_line(functions, name, position.line)
                        continue if function_index >= functions.names.count
                        cursor <- cursor + 1
                        candidate: mutable bool = function_index < functions.direct_pure.count and functions.direct_pure[function_index]
                        recursive_allowed: bool = proof_recursive_purity_eligible(functions, function_index)
                        candidate <- false if function_index < functions.recursive.count and functions.recursive[function_index] and not recursive_allowed
                        candidate <- false if not proof_function_calls_are_pure(functions, function_index, recursive_allowed)
                        if candidate and function_index < functions.pure.count and not functions.pure[function_index]:
                            functions.pure[function_index] <- true
                            changed <- true
                    Ast::Decl.Module(_, module_body, _):
                        proof_mark_pure_functions_pass(file, module_body, functions, cursor, changed)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_mark_pure_functions_pass(file, scoped_body, functions, cursor, changed)
                    _:
                        pass

        def proof_mark_pure_functions(file: Ast::File&, declarations: darray[Ast::Decl], functions: mutable ProofFunctionTable&, report: ProofReport&) -> void:
            functions.direct_pure.clear()
            functions.deterministic.clear()
            for _ in 0..<functions.names.count |functions|:
                functions.direct_pure.push(false)
                functions.deterministic.push(false)
            mutable_global_names: mutable darray[sview] = []
            for annotation in file.enum_annotations |mutable_global_names|:
                if annotation.name == "__global_mutable" and not (any existing in mutable_global_names where existing == annotation.owner):
                    mutable_global_names.push(annotation.owner)
            direct_cursor: mutable usize = 0
            proof_mark_direct_pure_functions_pass(file, declarations, functions, direct_cursor, mutable_global_names, report)
            functions.pure.clear()
            for _ in 0..<functions.names.count |functions|:
                functions.pure.push(false)
            changed: mutable bool = true
            pass_index: mutable usize = 0
            while changed and pass_index <= functions.names.count |functions, declarations, changed, pass_index|:
                changed <- false
                cursor: mutable usize = 0
                proof_mark_pure_functions_pass(file, declarations, functions, cursor, changed)
                pass_index <- pass_index + 1
            proof_mark_deterministic_functions(functions)

        # Deterministic functions: pure ones, plus non-recursive functions that are directly pure
        # except for a precondition and call only deterministic functions. Start from the direct
        # classification and remove any function with another kind of call until nothing
        # changes; with recursion excluded this is the least fixed point as well.
