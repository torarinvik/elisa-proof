extend ElisaProof:
    private:
        def proof_report_snapshot_source_metadata(file: Ast::File&, report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            report.source_generic_param_lines.clear()
            report.source_generic_param_names.clear()
            report.source_generic_params_valid <- file.generic_param_lines.count == file.generic_param_names.count
            if report.source_generic_params_valid:
                for index in 0..<file.generic_param_lines.count |index, report, file, source_work|:
                    generic_name: sview = file.generic_param_names[index]
                    if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(generic_name), source_work):
                        proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "generic-parameter source snapshot exceeded its validated work bound", "generic-parameter-snapshot-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return false
                    report.source_generic_param_lines.push(file.generic_param_lines[index])
                    report.source_generic_param_names.push(generic_name)
            # Contract quantifier syntax is erased from the AST. Preserve the exact compiler-owned
            # annotations so a source-bound tactic store cannot substitute quantifier kinds.
            report.source_annotations.clear()
            for annotation in file.enum_annotations |report|:
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.owner), source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source annotation snapshot exceeded its validated work bound", "annotation-snapshot-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return false
                report.source_annotations.push(annotation)
            report.source_annotation_args.clear()
            for argument in file.annotation_args |report, source_work|:
                if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(argument), source_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source decorator argument snapshot exceeded its validated work bound", "annotation-argument-snapshot-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return false
                report.source_annotation_args.push(argument)
            report.assert_hole_positions.clear()
            for hole in file.assert_hole_positions |report|:
                if not proof_report_source_work_charge(1, source_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source assertion-hole snapshot exceeded its validated work bound", "assert-hole-snapshot-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return false
                report.assert_hole_positions.push(hole)
            true
