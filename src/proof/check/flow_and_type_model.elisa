include "./reference_free_enums.elisa"
extend ElisaProof:
    private:
        const PROOF_STRUCTURAL_FRESH_ID_BASE: usize = ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
        # Flow is tracked separately from the symbolic state. A loop-control statement does not
        # have a normal successor, but it can still carry a proof obligation for the nearest
        # loop's invariant. Keeping these exits explicit prevents a `break` path from being
        # mistaken for the loop's ordinary fallthrough state. Continue states are retained per
        # path so termination can check each back edge independently. The snapshots are flattened
        # into parallel arrays because nested dynamic arrays would violate Elisa region lifetimes
        # when a state is stored in a flow collection.
        struct ProofFlow:
            normal: mutable bool
            breaks: mutable bool
            continues: mutable bool
            valid: mutable bool
            continue_name_starts: mutable darray[usize]
            continue_name_counts: mutable darray[usize]
            continue_names: mutable darray[sview]
            continue_value_starts: mutable darray[usize]
            continue_value_counts: mutable darray[usize]
            continue_values: mutable darray[Ast::Expr]
            continue_fact_starts: mutable darray[usize]
            continue_fact_counts: mutable darray[usize]
            continue_facts: mutable darray[Ast::Expr]

        # Structural subterms are tracked with their origin subject, not only their binder name.
        # This distinction is essential for inferred product rankings: a subterm of `left` may
        # not be silently passed as the decreasing argument for `right`.
        struct ProofStructuralSmaller:
            name: sview
            subject: sview
            identity: usize
            subject_identity: usize

        # One source-neutral witness for a recursive edge. `same` records the unchanged
        # component of an inferred product ranking; `strict` records the component that came
        # from a matched strict subterm. The kernel checks the relation shape independently of
        # the AST walker that discovered it.
        struct ProofStructuralWitness:
            subject: sview
            argument: sview
            strict: bool
            subject_identity: usize
            argument_identity: usize

        # Names are presentation data; identities carry lexical binding provenance through
        # shadowing. A zero identity is reserved for malformed/uninitialized witnesses.
        def proof_structural_fresh_identity(report: mutable ProofReport&) -> usize:
            return 0 if report.structural.identity_next >= PROOF_STRUCTURAL_FRESH_ID_BASE
            report.structural.identity_next <- report.structural.identity_next + 1
            return PROOF_STRUCTURAL_FRESH_ID_BASE + report.structural.identity_next

        def proof_structural_parameter_identity(parameters: darray[Ast::ParamDecl]&, wanted: sview) -> usize:
            for index in 0..<parameters.count |index, parameters, wanted|:
                return index + 1 if parameters[index].name == wanted and index + 1 < PROOF_STRUCTURAL_FRESH_ID_BASE
            return 0

        def proof_add_structural_edge_attempt(report: mutable ProofReport&, caller: sview, callee: sview, witnesses: darray[ProofStructuralWitness]&, line: u32, call_offset: usize) -> void:
            if caller == "" or callee == "" or witnesses.count == 0:
                report.proof_obligation(false)
                proof_add_finding(report, "kernel-certificate-invalid", line, caller, "structural certificate has no valid recursive edge witness")
                return
            for witness in witnesses |witness|:
                if witness.subject == "" or witness.argument == "" or witness.subject_identity == 0 or witness.argument_identity == 0 or (not witness.strict and (witness.subject != witness.argument or witness.subject_identity != witness.argument_identity)) or (witness.strict and witness.subject_identity == witness.argument_identity):
                    report.proof_obligation(false)
                    proof_add_finding(report, "kernel-certificate-invalid", line, caller, "structural certificate contains an invalid recursive edge witness")
                    return
            if not proof_resource_kernel_capacity(report, witnesses.count + 2, witnesses.count + 1, caller):
                proof_kernel_budget_note(report, caller)
                proof_add_structural_goal_attempt(report, report.kernel.nodes.count, line, caller, call_offset)
                return
            witness_start: usize = report.kernel.children.count
            witness_nodes: mutable darray[usize] = []
            for witness in witnesses |witness, report, witness_nodes|:
                witness_nodes.push(proof_kernel_add_node(&report.kernel.nodes, "structural-argument", "strict" if witness.strict else "same", 0, 0, witness.argument_identity, 0, 0, witness.subject_identity, witness.subject, witness.argument))
            report.kernel.children.extend(witness_nodes)
            edge_start: usize = report.kernel.children.count
            edge: usize = proof_kernel_add_node(&report.kernel.nodes, "structural-edge", "", 0, 0, witnesses.count, witness_start, witnesses.count, 0, caller, callee)
            report.kernel.children.push(edge)
            root: usize = proof_kernel_add_node(&report.kernel.nodes, "structural-safety", "", call_offset, 0, 0, edge_start, 1, 0, caller, "structural-v2")
            proof_add_structural_goal_attempt(report, root, line, caller, call_offset)

        def proof_empty_flow() -> ProofFlow:
            return ProofFlow{normal: true, breaks: false, continues: false, valid: true, continue_name_starts: [], continue_name_counts: [], continue_names: [], continue_value_starts: [], continue_value_counts: [], continue_values: [], continue_fact_starts: [], continue_fact_counts: [], continue_facts: []}

        def proof_copy_names(source: darray[sview]&) -> darray[sview]:
            result: mutable darray[sview] = []
            result.extend(source)
            return result

        def proof_copy_structural_smaller(source: darray[ProofStructuralSmaller]&) -> darray[ProofStructuralSmaller]:
            result: mutable darray[ProofStructuralSmaller] = []
            result.extend(source)
            return result

        def proof_copy_exprs[@r](source: darray[Ast::Expr]& @r) -> darray[Ast::Expr] @r:
            result: mutable darray[Ast::Expr] @r = []
            result.extend(source)
            return result

        def proof_clear_continue_states(flow: mutable ProofFlow&) -> void:
            flow.continue_name_starts.clear()
            flow.continue_name_counts.clear()
            flow.continue_names.clear()
            flow.continue_value_starts.clear()
            flow.continue_value_counts.clear()
            flow.continue_values.clear()
            flow.continue_fact_starts.clear()
            flow.continue_fact_counts.clear()
            flow.continue_facts.clear()

        # Copy path snapshots with fresh offsets. The source and target arrays remain flat, so no
        # nested container crosses the region boundary of a branch-local flow value.
        def proof_append_continue_states(target: mutable ProofFlow&, source: ProofFlow&) -> void:
            for state_index in 0..<source.continue_name_starts.count |state_index, target, source|:
                name_start: usize = source.continue_name_starts[state_index]
                name_count: usize = source.continue_name_counts[state_index]
                value_start: usize = source.continue_value_starts[state_index]
                value_count: usize = source.continue_value_counts[state_index]
                fact_start: usize = source.continue_fact_starts[state_index]
                fact_count: usize = source.continue_fact_counts[state_index]
                target.continue_name_starts.push(target.continue_names.count)
                target.continue_name_counts.push(name_count)
                for offset in 0..<name_count |offset, target, source, name_start|:
                    target.continue_names.push(source.continue_names[name_start + offset])
                target.continue_value_starts.push(target.continue_values.count)
                target.continue_value_counts.push(value_count)
                for offset in 0..<value_count |offset, target, source, value_start|:
                    target.continue_values.push(source.continue_values[value_start + offset])
                target.continue_fact_starts.push(target.continue_facts.count)
                target.continue_fact_counts.push(fact_count)
                for offset in 0..<fact_count |offset, target, source, fact_start|:
                    target.continue_facts.push(source.continue_facts[fact_start + offset])

        def proof_record_continue_state(flow: mutable ProofFlow&, names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&) -> void:
            flow.continue_name_starts.push(flow.continue_names.count)
            flow.continue_name_counts.push(names.count)
            flow.continue_names.extend(names)
            flow.continue_value_starts.push(flow.continue_values.count)
            flow.continue_value_counts.push(values.count)
            flow.continue_values.extend(values)
            flow.continue_fact_starts.push(flow.continue_facts.count)
            flow.continue_fact_counts.push(facts.count)
            flow.continue_facts.extend(facts)

        # Elisa's unsigned primitive types carry a compiler-level lower bound of zero. Keep
        # this import deliberately narrow: only bare primitive spellings are recognized here;
        # aliases, refinements, and opaque wrappers must provide an explicit proof instead of
        # being guessed from a name. This is a source-semantic fact, not an axiom supplied by a
        # proof author, and is recorded as `type-bound` provenance for replay.
        def proof_unsigned_primitive_type(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uint"
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_primitive_type(inner)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_unsigned_primitive_type(inner) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return false
                _:
                    return false

        def proof_unsigned_primitive_width(expression: Ast::Expr) -> i64:
            match expression:
                Ast::Expr.Ident(name, _):
                    return ElisaProofKernelCore::PROOF_KERNEL_U8_WIDTH if name == "u8"
                    return ElisaProofKernelCore::PROOF_KERNEL_U16_WIDTH if name == "u16"
                    return ElisaProofKernelCore::PROOF_KERNEL_U32_WIDTH if name == "u32"
                    return ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS if name == "u64" or name == "usize" or name == "uint"
                    return 0
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_primitive_width(inner)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_unsigned_primitive_width(inner) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                _:
                    return 0

        def proof_signed_primitive_width(expression: Ast::Expr) -> i64:
            match expression:
                Ast::Expr.Ident(name, _):
                    return ElisaProofKernelCore::PROOF_KERNEL_I8_WIDTH if name == "i8"
                    return ElisaProofKernelCore::PROOF_KERNEL_I16_WIDTH if name == "i16"
                    return ElisaProofKernelCore::PROOF_KERNEL_I32_WIDTH if name == "i32"
                    return ElisaProofKernelCore::PROOF_KERNEL_I64_WIDTH if name == "i64" or name == "isize" or name == "int"
                Ast::Expr.Paren(inner, _):
                    return proof_signed_primitive_width(inner)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_signed_primitive_width(inner) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    pass
            return 0

        # The primitive scalar types. Equality, arithmetic, and ordering on these are the
        # language's own operators; only a struct operand dispatches to a user protocol method.
        # Floating point is deliberately absent: it is excluded from the certificate term
        # language entirely because arithmetic can produce NaN, which is not reflexive.
        def proof_scalar_primitive_type_name(name: sview) -> bool:
            return true if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize" or name == "int"
            return true if name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uint"
            return true if name == "bool" or name == "char"
            return false

        # The per-import audit index is built once from the complete declaration tree. Preserve
        # the linear walk's ambiguity and incompleteness behavior while following only the exact
        # hash bucket; the hash selects candidates and never substitutes for name equality.
        def proof_find_type_alias_index(index: ProofTypeAuditIndex, name: sview) -> (count: usize, target: Ast::Expr):
            empty_target: Ast::Expr = Ast::Expr.Absent
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if not index.complete or index.entries.count != index.next_indices.count
            return (0, empty_target) if index.entries.count == 0
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if index.bucket_heads.count == 0
            hash: u32 = proof_name_hash(name)
            slot: usize = (hash.i64() % index.bucket_heads.count.i64()).usize()
            entry: mutable usize = index.bucket_heads[slot]
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if entry > index.entries.count
            steps: mutable usize = 0
            count: mutable usize = 0
            target: mutable Ast::Expr = Ast::Expr.Absent
            while entry < index.entries.count and steps < PROOF_INDEX_MAX_CHAIN |entry, steps, index, hash, name, count, target|:
                return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if entry >= index.next_indices.count
                row: ProofTypeAuditDeclaration = index.entries[entry]
                if row.name_hash == hash:
                    match row.declaration:
                        Ast::Decl.Alias(alias_name, alias_target, _):
                            if alias_name == name:
                                count <- count + 1
                                target <- alias_target
                        _:
                            pass
                return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if count > 1
                next_entry: usize = index.next_indices[entry]
                return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if next_entry > index.entries.count
                entry <- next_entry
                steps <- steps + 1
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid) if entry < index.entries.count
            return (count, target)

        # Report-backed indexed queries charge the input spelling and every bucket probe. The
        # prebuilt index keeps lookup proportional to the bounded collision chain without letting
        # repeated queries evade the caller's aggregate source-work budget.
        def proof_find_type_alias_index_with_work(index: ProofTypeAuditIndex, name: sview, source_work: mutable usize&) -> (count: usize, target: Ast::Expr, type_count: usize, root_alias_count: usize, root_type_count: usize):
            empty_target: Ast::Expr = Ast::Expr.Absent
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if not index.complete or index.entries.count != index.next_indices.count
            capacity: usize = proof_index_capacity(index.entries.count)
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if index.bucket_heads.count != capacity
            return (0, empty_target, 0, 0, 0) if index.entries.count == 0
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if not proof_type_audit_work_charge(sview_len(name), source_work)
            hash: u32 = proof_name_hash(name)
            slot: usize = (hash.i64() % index.bucket_heads.count.i64()).usize()
            entry: mutable usize = index.bucket_heads[slot]
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if entry > index.entries.count
            steps: mutable usize = 0
            count: mutable usize = 0
            type_count: mutable usize = 0
            root_alias_count: mutable usize = 0
            root_type_count: mutable usize = 0
            target: mutable Ast::Expr = Ast::Expr.Absent
            while entry < index.entries.count and steps < PROOF_INDEX_MAX_CHAIN |entry, steps, index, hash, name, count, type_count, root_alias_count, root_type_count, target, source_work|:
                return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if not proof_type_audit_work_charge(1, source_work)
                return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if entry >= index.next_indices.count
                row: ProofTypeAuditDeclaration = index.entries[entry]
                if row.name_hash == hash:
                    row_name: sview = proof_type_audit_declaration_name(row.declaration)
                    return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if row_name == ""
                    return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if not proof_type_audit_work_charge(sview_len(row_name) + sview_len(name), source_work)
                    if row_name == name:
                        type_count <- type_count + 1
                        root_type_count <- root_type_count + 1 if row.root_level
                        match row.declaration:
                            Ast::Decl.Alias(alias_name, alias_target, _):
                                count <- count + 1
                                root_alias_count <- root_alias_count + 1 if row.root_level
                                target <- alias_target if row.root_level
                            _:
                                pass
                return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if count > 1
                next_entry: usize = index.next_indices[entry]
                return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if next_entry > index.entries.count
                entry <- next_entry
                steps <- steps + 1
            return (PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, Ast::Expr.Invalid, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT, PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT) if entry < index.entries.count
            return (count, target, type_count, root_alias_count, root_type_count)

        # The enum index is built once per source import. Keep scalar classification on its
        # collision-safe bucket instead of rescanning every declaration for each type query.
        def proof_count_enums_index_with_work(index: ProofEnumIndex, name: sview, source_work: mutable usize&) -> (count: usize, const_count: usize, root_count: usize, root_const_count: usize):
            return (2, 2, 2, 2) if not index.complete or index.names.count != index.name_hashes.count or index.names.count != index.const_enums.count or index.names.count != index.declarations.count or index.names.count != index.root_level.count or index.names.count != index.next_indices.count
            capacity: usize = proof_index_capacity(index.names.count)
            return (2, 2, 2, 2) if index.bucket_heads.count != capacity
            return (0, 0, 0, 0) if index.names.count == 0
            return (2, 2, 2, 2) if not proof_type_audit_work_charge(sview_len(name), source_work)
            hash: u32 = proof_name_hash(name)
            slot: usize = (hash.i64() % capacity.i64()).usize()
            entry: mutable usize = index.bucket_heads[slot]
            return (2, 2, 2, 2) if entry > index.names.count
            steps: mutable usize = 0
            count: mutable usize = 0
            const_count: mutable usize = 0
            root_count: mutable usize = 0
            root_const_count: mutable usize = 0
            while entry < index.names.count and steps < PROOF_INDEX_MAX_CHAIN |entry, steps, index, hash, name, count, const_count, root_count, root_const_count, source_work|:
                return (2, 2, 2, 2) if not proof_type_audit_work_charge(1, source_work)
                return (2, 2, 2, 2) if entry >= index.next_indices.count
                if index.name_hashes[entry] == hash:
                    return (2, 2, 2, 2) if not proof_type_audit_work_charge(sview_len(index.names[entry]) + sview_len(name), source_work)
                    if index.names[entry] == name:
                        count <- count + 1
                        const_count <- const_count + 1 if index.const_enums[entry]
                        if index.root_level[entry]:
                            root_count <- root_count + 1
                            root_const_count <- root_const_count + 1 if index.const_enums[entry]
                next_entry: usize = index.next_indices[entry]
                return (2, 2, 2, 2) if next_entry > index.names.count
                entry <- next_entry
                steps <- steps + 1
            return (2, 2, 2, 2) if entry < index.names.count
            return (count, const_count, root_count, root_const_count)

        def proof_scalar_type_kind_index(expression: Ast::Expr, index: ProofTypeAuditIndex, enum_index: ProofEnumIndex, depth: usize, source_work: mutable usize&) -> i64:
            return -1 if not proof_type_audit_work_charge(1, source_work)
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not index.complete
            match expression:
                Ast::Expr.Ident(name, _):
                    return -1 if not proof_type_audit_work_charge(sview_len(name), source_work)
                    alias: (count: usize, target: Ast::Expr, type_count: usize, root_alias_count: usize, root_type_count: usize) = proof_find_type_alias_index_with_work(index, name, source_work)
                    enums: (count: usize, const_count: usize, root_count: usize, root_const_count: usize) = proof_count_enums_index_with_work(enum_index, name, source_work)
                    if proof_scalar_primitive_type_name(name):
                        return -1 if alias.type_count > 0 or enums.count > 0
                        return 1
                    return -1 if alias.count != alias.root_alias_count or alias.type_count != alias.root_type_count
                    return -1 if enums.count != enums.root_count or enums.const_count != enums.root_const_count
                    return -1 if alias.root_alias_count > 1 or alias.root_type_count > 1
                    return -1 if enums.root_count > 1 or (alias.root_type_count > 0 and enums.root_count > 0)
                    return proof_scalar_type_kind_index(alias.target, index, enum_index, depth + 1, source_work) if alias.root_alias_count == 1
                    return 0 if alias.root_type_count == 1
                    return 1 if enums.root_count == 1 and enums.root_const_count == 1
                    return 0
                Ast::Expr.Paren(inner, _):
                    return proof_scalar_type_kind_index(inner, index, enum_index, depth + 1, source_work)
                Ast::Expr.Refinement(base, _, _):
                    return proof_scalar_type_kind_index(base, index, enum_index, depth + 1, source_work)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_scalar_type_kind_index(inner, index, enum_index, depth + 1, source_work) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                Ast::Expr.Scope(_, _, _):
                    return -1
                _:
                    return 0

        # The declared type of one field of a named struct. The count reports how many struct
        # declarations answer to the name; anything but exactly one is refused by the caller.
        def proof_struct_field_type_walk(declarations: darray[Ast::Decl]&, struct_name: sview, field_name: sview, depth: usize) -> (count: usize, type_expression: Ast::Expr):
            return (2, Ast::Expr.Invalid) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            for declaration in declarations |struct_name, field_name, depth, count, found|:
                match declaration:
                    Ast::Decl.Struct(name, members, _, _, _, _, _):
                        if name == struct_name:
                            count <- count + 1
                            for member in members |field_name, found|:
                                found <- member.type_expression if member.name == field_name
                    Ast::Decl.Module(_, body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_struct_field_type_walk(body, struct_name, field_name, depth + 1)
                        count <- count + nested.count
                        found <- nested.type_expression if nested.count > 0
                    Ast::Decl.Scoped(body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_struct_field_type_walk(body, struct_name, field_name, depth + 1)
                        count <- count + nested.count
                        found <- nested.type_expression if nested.count > 0
                    _:
                        pass
            return (count, found)

        def proof_struct_field_names(declarations: darray[Ast::Decl]&, struct_name: sview, depth: usize, names: mutable darray[sview]&) -> usize:
            return 2 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |struct_name, depth, count, names|:
                match declaration:
                    Ast::Decl.Struct(name, members, _, _, _, _, _):
                        if name == struct_name:
                            count <- count + 1
                            for member in members |names|:
                                names.push(member.name)
                    Ast::Decl.Module(_, body, _):
                        count <- count + proof_struct_field_names(body, struct_name, depth + 1, names)
                    Ast::Decl.Scoped(body, _):
                        count <- count + proof_struct_field_names(body, struct_name, depth + 1, names)
                    _:
                        pass
            return count

        # The struct a declared type names, after stripping storage qualifiers, references,
        # parentheses, refinements, and a unique alias. A reference is followed here because a
        # field read through `p: Pair&` still has the field's declared type; what is refused for
        # a scalar (`&T` compares by address) does not arise for a projection out of it.
        def proof_type_head_name(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> sview:
            return "" if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return "" if proof_scalar_primitive_type_name(name)
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return "" if alias.count > 1
                    return proof_type_head_name(alias.target, declarations, depth + 1) if alias.count == 1
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_type_head_name(inner, declarations, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_type_head_name(base, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_type_head_name(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                Ast::Expr.Scope(_, _, _):
                    # Without owner-qualified type lookup, a leaf name could select an unrelated
                    # declaration. Do not expose a head for this type.
                    return ""
                _:
                    return ""

        # The element type of a built-in container spelling: `darray[T]`, `view[T]`,
        # `array[T, N]`, or `T[N]`. Only built-in containers are recognized, because a subscript
        # on a struct is an `__index__` protocol call whose result is whatever the author chose.
        # Whether a declared type can hold a reference anywhere inside it. Conservative in both
        # directions a mistake could go: a form this does not recognize, an ambiguous name, and a
        # type that is too deep all count as able to hold one.
        #
        # This is what decides whether a lend can outlive the call it was passed to. A reference
        # can only be stored into a place whose type can hold one, and the places a callee can
        # reach that its caller still sees are exactly its other parameters and its return. Three
        # compiled probes fix the boundary: a callee with a second parameter of type
        # `mutable darray[darray[usize]&]&` does store the lend into it and the compiler accepts
        # that; so does one that returns a by-value `darray[darray[usize]&]` holding it; while
        # storing into a plain field is refused by the region checker. So neither "returns no
        # reference" nor "has one reference parameter" is enough on its own, and the type test is.
        def proof_type_is_reference_free_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, depth: usize, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_type_is_reference_free_with_work(inner, declarations, annotations, depth + 1, source_work)
                Ast::Expr.Refinement(base, _, _):
                    return proof_type_is_reference_free_with_work(base, declarations, annotations, depth + 1, source_work)
                Ast::Expr.Unary(operator, inner, _):
                    # `&` and `lmut` are references. `mutable` and the storage qualifiers are modes
                    # on a by-value binding and change nothing about what the type can hold.
                    return false if operator != TokenKind.Mutable and operator != TokenKind.Static and operator != TokenKind.Heap and operator != TokenKind.Stack and operator != TokenKind.Tail
                    return proof_type_is_reference_free_with_work(inner, declarations, annotations, depth + 1, source_work)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |declarations, annotations, depth, source_work|:
                        return false if not proof_type_is_reference_free_with_work(element, declarations, annotations, depth + 1, source_work)
                    return true
                Ast::Expr.Index(head, argument, _):
                    return false if not (head is Ast::Expr.Ident(_, _))
                    head_name: sview = proof_ident_name(head)
                    if head_name == "darray" or head_name == "view" or head_name == "set":
                        return false if proof_builtin_type_name_shadowed_with_work(declarations, head_name, source_work)
                        return proof_type_is_reference_free_with_work(argument, declarations, annotations, depth + 1, source_work)
                    # `u8[CAP]`: over a scalar head the shorthand is always a fixed array whatever
                    # the extent spells (`proof_fixed_array_primitive_head`), so it holds scalars.
                    if proof_fixed_array_primitive_head(head_name):
                        return true if not proof_builtin_type_name_shadowed_with_work(declarations, head_name, source_work)
                    extent: (known: bool, value: i64) = proof_fixed_extent_constant_with_work(argument, declarations, source_work, 0)
                    return extent.known and proof_type_is_reference_free_with_work(head, declarations, annotations, depth + 1, source_work)
                Ast::Expr.IndexN(head, arguments, _):
                    return false if not (head is Ast::Expr.Ident(_, _))
                    return false if proof_ident_name(head) != "array" or arguments.count != 2
                    return false if proof_builtin_type_name_shadowed_with_work(declarations, "array", source_work)
                    match arguments[1]:
                        Ast::Expr.IntLit(_, _):
                            return proof_type_is_reference_free_with_work(arguments[0], declarations, annotations, depth + 1, source_work)
                        _:
                            return false
                Ast::Expr.Ident(name, _):
                    return false if not proof_type_audit_work_charge(sview_len(name), source_work)
                    if proof_scalar_primitive_type_name(name) or name == "sview" or name == "void" or name == "f32" or name == "f64":
                        return false if proof_builtin_type_name_shadowed_with_work(declarations, name, source_work)
                        return true
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_with_work(declarations, name, 0, source_work)
                    return false if alias.count > 1
                    return false if alias.count == 1 and proof_type_alias_root_count_with_work(declarations, name, 0, source_work) != 1
                    return false if alias.count == 1 and proof_unscoped_alias_aggregate_collision_with_work(declarations, name, source_work)
                    return proof_type_is_reference_free_with_work(alias.target, declarations, annotations, depth + 1, source_work) if alias.count == 1
                    aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(declarations, name, 0, source_work)
                    return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    if aggregates.enums + aggregates.const_enums + aggregates.structs > 0:
                        root_aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_root_named_aggregates_with_work(declarations, name, 0, source_work)
                        return false if root_aggregates.enums != aggregates.enums or root_aggregates.const_enums != aggregates.const_enums or root_aggregates.structs != aggregates.structs
                    return true if aggregates.enums == 0 and aggregates.const_enums == 1 and aggregates.structs == 0
                    return proof_named_aggregate_is_reference_free(name, declarations, annotations, depth + 1, source_work)
                Ast::Expr.Scope(_, _, _):
                    # The current source indexes do not retain the full owner path for type
                    # declarations. Resolving by leaf name can select an unrelated aggregate.
                    return false
                _:
                    return false

        def proof_type_is_reference_free(expression: Ast::Expr, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, depth: usize) -> bool:
            source_work: mutable usize = 0
            return proof_type_is_reference_free_with_work(expression, declarations, annotations, depth, &source_work)

        # The storage a declared type names: the type with one outer reference removed, seen
        # through parentheses, refinements and the storage qualifiers. A by-value type is returned
        # unchanged. This is what a callee can store *into* through that parameter.
        def proof_type_strip_reference(expression: Ast::Expr, depth: usize) -> Ast::Expr:
            return expression if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_type_strip_reference(inner, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_type_strip_reference(base, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_type_strip_reference(inner, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return expression
                _:
                    return expression

        # `proof_type_is_reference_free` answers whether a value can STORE references in its
        # elements/fields; a `view[T]` has no such storage but is itself a borrowed window into
        # external storage. Local call-stability needs the stronger property: no path through the
        # value may reach borrowed storage. Unknown or ambiguous type shapes fail closed.
        def proof_type_contains_borrowed_view_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize, source_work: mutable usize&) -> bool:
            return true if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return true if not proof_type_audit_work_charge(sview_len(name), source_work)
                    return true if name == "sview"
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_with_work(declarations, name, 0, source_work)
                    return true if alias.count > 1
                    return true if alias.count == 1 and proof_type_alias_root_count_with_work(declarations, name, 0, source_work) != 1
                    return true if alias.count == 1 and proof_unscoped_alias_aggregate_collision_with_work(declarations, name, source_work)
                    return proof_type_contains_borrowed_view_with_work(alias.target, declarations, depth + 1, source_work) if alias.count == 1
                    if proof_scalar_primitive_type_name(name) or name == "void" or name == "f32" or name == "f64":
                        return proof_builtin_type_name_shadowed_with_work(declarations, name, source_work)
                    aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(declarations, name, 0, source_work)
                    return true if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    if aggregates.enums + aggregates.const_enums + aggregates.structs > 0:
                        root_aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_root_named_aggregates_with_work(declarations, name, 0, source_work)
                        return true if root_aggregates.enums != aggregates.enums or root_aggregates.const_enums != aggregates.const_enums or root_aggregates.structs != aggregates.structs
                    return false if aggregates.enums == 0 and aggregates.const_enums == 1 and aggregates.structs == 0
                    return true if aggregates.enums + aggregates.const_enums + aggregates.structs > 1
                    return proof_struct_contains_borrowed_view(name, declarations, depth + 1, source_work)
                Ast::Expr.Scope(_, _, _):
                    # No qualified-owner index exists yet; an unscoped leaf lookup could inspect
                    # a different module's struct and incorrectly prove storage lifetime.
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_type_contains_borrowed_view_with_work(inner, declarations, depth + 1, source_work)
                Ast::Expr.Refinement(base, _, _):
                    return proof_type_contains_borrowed_view_with_work(base, declarations, depth + 1, source_work)
                Ast::Expr.Unary(operator, inner, _):
                    return true if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                    return proof_type_contains_borrowed_view_with_work(inner, declarations, depth + 1, source_work) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements |declarations, depth, source_work|:
                        return true if proof_type_contains_borrowed_view_with_work(element, declarations, depth + 1, source_work)
                    return false
                Ast::Expr.Index(head, argument, _):
                    return true if not (head is Ast::Expr.Ident(_, _))
                    head_name: sview = proof_ident_name(head)
                    return true if head_name == "view"
                    if head_name == "darray" or head_name == "set":
                        return true if proof_builtin_type_name_shadowed_with_work(declarations, head_name, source_work)
                        return proof_type_contains_borrowed_view_with_work(argument, declarations, depth + 1, source_work)
                    if proof_fixed_array_primitive_head(head_name):
                        return false if not proof_builtin_type_name_shadowed_with_work(declarations, head_name, source_work)
                    extent: (known: bool, value: i64) = proof_fixed_extent_constant_with_work(argument, declarations, source_work, 0)
                    return not extent.known or proof_type_contains_borrowed_view_with_work(head, declarations, depth + 1, source_work)
                Ast::Expr.IndexN(head, arguments, _):
                    return true if not (head is Ast::Expr.Ident(_, _))
                    return true if proof_ident_name(head) != "array" or arguments.count != 2
                    return true if proof_builtin_type_name_shadowed_with_work(declarations, "array", source_work)
                    match arguments[1]:
                        Ast::Expr.IntLit(_, _):
                            return proof_type_contains_borrowed_view_with_work(arguments[0], declarations, depth + 1, source_work)
                        _:
                            return true
                _:
                    return true
        def proof_type_contains_borrowed_view(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> bool:
            source_work: mutable usize = 0
            return proof_type_contains_borrowed_view_with_work(expression, declarations, depth, &source_work)
