extend ElisaProof:
    private:
        def proof_add_builtin_operator_witnesses_with_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, concrete: sview, position: Ast::Pos, source_work: mutable usize&) -> bool:
            return false if concrete == "" or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
            overrides: mutable darray[bool] = []
            any_override: mutable bool = false
            for protocol in protocols |report, concrete, source_work, overrides, any_override|:
                return false if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(concrete), source_work) or not proof_type_audit_work_charge(sview_len(protocol), source_work)
                implementation: (complete: bool, exists: bool) = proof_report_kernel_operator_impl_exists_with_work(report, concrete, protocol, source_work)
                return false if not implementation.complete
                overrides.push(implementation.exists)
                any_override <- true if implementation.exists
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if not any_override:
                proof_add_type_bound_fact(facts, report, proof_builtin_operator_marker(root, "All", position), position.line, report.analysis_1.type_bounds.owner)
            else:
                for protocol_index in 0..<protocols.count |facts, report, root, protocols, overrides, position, protocol_index|:
                    protocol: sview = protocols[protocol_index]
                    marker: Ast::Expr = proof_untrusted_operator_marker(root, protocol, position) if overrides[protocol_index] else proof_builtin_operator_marker(root, protocol, position)
                    proof_add_type_bound_fact(facts, report, marker, position.line, report.analysis_1.type_bounds.owner)
            # The kernel also treats bitwise operators as congruent binary functions.
            # These protocols are not in the scalar All-marker set, so record only
            # actual overrides as negative admission facts.
            for protocol in ["BitAnd", "BitOr", "BitXor"] |facts, report, root, concrete, position, source_work|:
                return false if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(concrete), source_work) or not proof_type_audit_work_charge(sview_len(protocol), source_work)
                implementation: (complete: bool, exists: bool) = proof_report_kernel_operator_impl_exists_with_work(report, concrete, protocol, source_work)
                return false if not implementation.complete
                if implementation.exists:
                    marker: Ast::Expr = proof_untrusted_operator_marker(root, protocol, position)
                    proof_add_type_bound_fact(facts, report, marker, position.line, report.analysis_1.type_bounds.owner)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            proof_add_builtin_index_witness(facts, report, root, position)
            return true
