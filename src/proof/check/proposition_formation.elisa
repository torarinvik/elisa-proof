# This projects compiler-checked declarations and lexical types into the source-neutral kernel's
# typing environment. Proposition admission is decided by that typed kernel, not by a duplicate
# source-side Boolean classifier; the independent replay checks the resulting derivation.
extend ElisaProof:
    private:
        const PROOF_PROPOSITION_TYPE_DEPTH_LIMIT: usize = 127

        def proof_source_type_spelling(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Scope(_, name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_source_type_spelling(inner, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_source_type_spelling(base, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return proof_source_type_spelling(inner, depth + 1)
                    return ""
                Ast::Expr.Index(base, _, _):
                    return proof_source_type_spelling(base, depth + 1)
                Ast::Expr.IndexN(base, _, _):
                    return proof_source_type_spelling(base, depth + 1)
                _:
                    return ""

        def proof_source_inferred_type_spelling(inferred: Semantic::InferType) -> sview:
            if inferred.name != "":
                return inferred.name
            return when inferred.kind:
                Semantic::SemTypeKind.Bool -> "bool"
                Semantic::SemTypeKind.Int -> "i64"
                Semantic::SemTypeKind.Float -> "f64"
                Semantic::SemTypeKind.Char -> "char"
                Semantic::SemTypeKind.String -> "cstr"
                Semantic::SemTypeKind.Named -> inferred.name
                Semantic::SemTypeKind.Container -> inferred.name
                Semantic::SemTypeKind.Tuple -> "tuple"
                _ -> ""

        # Preserve a compiler-declared tuple signature when a local's type is inferred from a
        # direct call. The kernel needs the declaration's tuple identity and named field map;
        # the coarse semantic `Tuple` family alone intentionally does not carry either.
        def proof_source_function_return_type_with_work(declarations: darray[Ast::Decl]&, function_name: sview, source_work: mutable usize&, depth: usize) -> (count: usize, type_expression: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            requires depth <= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT
            decreases PROOF_PROPOSITION_TYPE_DEPTH_LIMIT - depth
            return (2, Ast::Expr.Absent) if depth >= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT
            count: mutable usize = 0
            selected: mutable Ast::Expr = Ast::Expr.Absent
            for declaration in declarations |function_name, source_work, depth, count, selected|:
                return (2, Ast::Expr.Absent) if not proof_source_kernel_charge_work(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, return_type, _, _, _, _):
                        return (2, Ast::Expr.Absent) if not proof_source_kernel_charge_text_comparison(name, function_name, source_work)
                        if name == function_name:
                            if return_type is declared_return_type:
                                selected <- declared_return_type
                            else:
                                selected <- Ast::Expr.Ident("void", Ast::pos_at_line(0))
                            count <- count + 1
                    Ast::Decl.Module(_, body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_source_function_return_type_with_work(body, function_name, source_work, depth + 1)
                        return (2, Ast::Expr.Absent) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        count <- count + nested.count
                        selected <- nested.type_expression if nested.count == 1
                    Ast::Decl.Scoped(body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_source_function_return_type_with_work(body, function_name, source_work, depth + 1)
                        return (2, Ast::Expr.Absent) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        count <- count + nested.count
                        selected <- nested.type_expression if nested.count == 1
                    _:
                        pass
            return (count, selected)

        # Compatibility callers get the same per-query ceiling; source preparation below passes
        # its report-wide meter through the work-aware helper instead.
        def proof_source_function_return_type(declarations: darray[Ast::Decl]&, function_name: sview, depth: usize) -> (count: usize, type_expression: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            source_work: mutable usize = 0
            proof_source_function_return_type_with_work(declarations, function_name, &source_work, depth)

        def proof_source_inferred_tuple_type_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, local_names: darray[sview]&, source_work: mutable usize&, depth: usize) -> Ast::Expr can[Memory.Allocate, Abort.Panic]:
            requires depth <= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT
            decreases PROOF_PROPOSITION_TYPE_DEPTH_LIMIT - depth
            return Ast::Expr.Absent if:
                not proof_source_kernel_charge_work(1, source_work)
                depth >= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(Ast::Expr.Ident(function_name, _), _, _, _):
                    # Lexical bindings take precedence over same-spelled declarations.
                    # A local callable needs its own resolved signature; never borrow
                    # a global function's tuple type for an opaque or invalid call.
                    for local_name in local_names |function_name, source_work|:
                        return Ast::Expr.Absent if:
                            not proof_source_kernel_charge_work(1, source_work) or not proof_source_kernel_charge_text_comparison(local_name, function_name, source_work)
                            local_name == function_name
                    found: (count: usize, type_expression: Ast::Expr) = proof_source_function_return_type_with_work(declarations, function_name, source_work, 0)
                    return found.type_expression if found.count == 1
                    return Ast::Expr.Absent
                Ast::Expr.Paren(inner, _):
                    return proof_source_inferred_tuple_type_with_work(inner, declarations, local_names, source_work, depth + 1)
                _:
                    return Ast::Expr.Absent

        # Compatibility callers get a per-query ceiling. Source proposition preparation passes
        # its report-wide source-work counter to the work-aware helper directly.
        def proof_source_inferred_tuple_type(expression: Ast::Expr, declarations: darray[Ast::Decl]&, local_names: darray[sview]&, depth: usize) -> Ast::Expr can[Memory.Allocate, Abort.Panic]:
            source_work: mutable usize = 0
            proof_source_inferred_tuple_type_with_work(expression, declarations, local_names, &source_work, depth)

        def proof_source_range_element_type(range: Ast::Expr, names: darray[sview]&, types: darray[sview]&, table: Semantic::SymbolTable&) -> sview can[Memory.Allocate, Abort.Panic]:
            match range:
                Ast::Expr.Array(elements, _):
                    return "" if elements.count == 0
                    inferred: Semantic::InferType = Semantic::infer_expression_type_for_proof(elements[0], names, types, table)
                    return proof_source_inferred_type_spelling(inferred)
                Ast::Expr.Binary(_, operator, _, _):
                    if operator == TokenKind.RangeLt or operator == TokenKind.RangeLe:
                        return "i64"
                    return ""
                _:
                    return ""

        def proof_source_binding_type(name: sview, names: darray[sview]&, source_types: darray[Ast::Expr]&, source_work: mutable usize&) -> Ast::Expr:
            found: mutable Ast::Expr = Ast::Expr.Absent
            return found if names.count != source_types.count
            for index in 0..<names.count |index, names, source_types, name, found, source_work|:
                return Ast::Expr.Absent if not proof_source_kernel_charge_work(1, source_work) or not proof_source_kernel_charge_text_comparison(names[index], name, source_work)
                found <- source_types[index] if names[index] == name
            return found

        # A tiny source-type projection used only when the compiler's conservative inference
        # returns Unknown for a supported container element or declared struct field. It reads
        # declaration types; it never guesses from the kernel node kind.
        def proof_source_expression_type_hint(expression: Ast::Expr, names: darray[sview]&, source_types: darray[Ast::Expr]&, declarations: darray[Ast::Decl]&, source_work: mutable usize&, depth: usize) -> Ast::Expr can[Memory.Allocate, Abort.Panic]:
            return Ast::Expr.Absent if depth >= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT or not proof_source_kernel_charge_work(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return proof_source_binding_type(name, names, source_types, source_work)
                Ast::Expr.Paren(inner, _):
                    return proof_source_expression_type_hint(inner, names, source_types, declarations, source_work, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_source_expression_type_hint(base, names, source_types, declarations, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_source_expression_type_hint(inner, names, source_types, declarations, source_work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return Ast::Expr.Absent
                Ast::Expr.Field(object, field, _):
                    base_type: Ast::Expr = proof_source_expression_type_hint(object, names, source_types, declarations, source_work, depth + 1)
                    head: sview = proof_type_head_name_with_work(base_type, declarations, 0, source_work)
                    return Ast::Expr.Absent if head == ""
                    members: mutable darray[Ast::StructMember] = []
                    return Ast::Expr.Absent if proof_struct_members_with_work(declarations, head, 0, &members, source_work) != 1
                    resolved: (count: usize, type_expression: Ast::Expr) = proof_struct_member_type_with_work(members, field, source_work)
                    return resolved.type_expression if head != "" and resolved.count == 1
                    return Ast::Expr.Absent
                Ast::Expr.Index(object, _, _):
                    container_type: Ast::Expr = proof_source_expression_type_hint(object, names, source_types, declarations, source_work, depth + 1)
                    element: (known: bool, element: Ast::Expr) = proof_container_element_type_with_work(container_type, declarations, 0, source_work)
                    return element.element if element.known
                    return Ast::Expr.Absent
                Ast::Expr.IndexN(object, arguments, _):
                    indexed_type: mutable Ast::Expr = proof_source_expression_type_hint(object, names, source_types, declarations, source_work, depth + 1)
                    for _ in arguments |indexed_type, declarations, source_work|:
                        element: (known: bool, element: Ast::Expr) = proof_container_element_type_with_work(indexed_type, declarations, 0, source_work)
                        return Ast::Expr.Absent if not element.known
                        indexed_type <- element.element
                    return indexed_type
                Ast::Expr.Construct(type_expression, _, _):
                    return type_expression
                Ast::Expr.RecordUpdate(base, _, _):
                    return proof_source_expression_type_hint(base, names, source_types, declarations, source_work, depth + 1)
                _:
                    return Ast::Expr.Absent

        def proof_source_validate_context_proposition[@r](expression: Ast::Expr, name: sview, names: darray[sview]&, types: darray[sview]&, source_types: darray[Ast::Expr]&, module_path: darray[sview]&, global_kernel_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], kernel_workspace: mutable ProofSourceKernelFormationWorkspace& @r, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace& @r, file: Ast::File&, table: Semantic::SymbolTable&, report: mutable ProofReport&) -> void can[Memory.Allocate, Abort.Panic]:
            return if kernel_workspace.source_work_exhaustion_reported
            if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_source_kernel_projection_budget_refusal(report, name, Ast::expr_pos(expression).line, kernel_workspace)
                return
            kernel_failure: mutable sview = ""
            kernel_formed: bool = proof_source_kernel_proposition_formed(expression, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, file, &kernel_failure)
            if not kernel_formed:
                source_position: Ast::Pos = Ast::expr_pos(expression)
                if kernel_failure == "kernel source work budget exceeded":
                    proof_source_kernel_projection_budget_refusal(report, name, source_position.line, kernel_workspace)
                    return
                report.proof_obligation(false)
                diagnostic: sview = "kernel post-state result binding absent" if kernel_failure == "post-result-binding-missing" else "kernel context binding absent" if kernel_failure == "local-context-binding-missing" else "kernel context sort mismatch" if kernel_failure == "local-context-sort-mismatch" else "kernel context type-name mismatch" if kernel_failure == "local-context-name-mismatch" else "kernel context element-sort mismatch" if kernel_failure == "local-context-element-mismatch" else "kernel typing environment unrepresentable" if kernel_failure == "local-context-unrepresented" else kernel_failure if kernel_failure != "" and kernel_failure != "term-sort-or-operator-rejected" else "kernel proposition formation rejected the term or operator"
                proof_add_finding(report, "contract-proposition-type", source_position.line, name, diagnostic) if kernel_failure != "kernel source work budget exceeded"

        def proof_source_for_element_type(iterable: Ast::Expr, names: darray[sview]&, types: darray[sview]&, source_types: darray[Ast::Expr]&, declarations: darray[Ast::Decl]&, table: Semantic::SymbolTable&, source_work: mutable usize&) -> sview can[Memory.Allocate, Abort.Panic]:
            range_element: sview = proof_source_range_element_type(iterable, names, types, table)
            return range_element if range_element != ""
            iterable_type: Ast::Expr = proof_source_expression_type_hint(iterable, names, source_types, declarations, source_work, 0)
            element: (known: bool, element: Ast::Expr) = proof_container_element_type_with_work(iterable_type, declarations, 0, source_work)
            return proof_source_type_spelling(element.element, 0) if element.known
            return ""

        # Statement guards, match guards, assertions, and loop invariants become assumptions
        # or goals in later proof passes. Validate those at import time too; otherwise a direct
        # proof_check consumer could report a function verified even though the CLI separately
        # rejects its non-Boolean guard. Nested lexical scopes reuse these arrays and restore
        # their entry marks, so shadowing stays explicit without copying the outer context.
        def proof_source_validate_statement_propositions[@r](file: Ast::File&, name: sview, statements: darray[Ast::Stmt]&, names: mutable darray[sview]&, types: mutable darray[sview]&, source_types: mutable darray[Ast::Expr]&, module_path: darray[sview]&, global_kernel_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], kernel_workspace: mutable ProofSourceKernelFormationWorkspace& @r, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace& @r, table: Semantic::SymbolTable&, report: mutable ProofReport&, depth: usize) -> void can[Memory.Allocate, Abort.Panic]:
            return if statements.count == 0 or kernel_workspace.source_work_exhaustion_reported
            if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statements[0]).line, kernel_workspace)
                return
            if depth >= PROOF_PROPOSITION_TYPE_DEPTH_LIMIT:
                position: Ast::Pos = proof_statement_position(statements[0])
                report.proof_obligation(false)
                proof_add_finding(report, "contract-proposition-type", position.line, name, "kernel proposition statement nesting exceeded its bounded representation")
                return
            for statement in statements |file, name, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, depth|:
                if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                    return
                if not proof_source_kernel_charge_work(1, kernel_workspace.source_work_used):
                    position: Ast::Pos = proof_statement_position(statement)
                    proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                    return
                match statement:
                    Ast::Stmt.VarDecl(local_name, declared_type, initializer, _):
                        if not proof_source_proposition_context_fits(names.count, 1):
                            report.proof_obligation(false)
                            proof_add_finding(report, "contract-proposition-type", proof_statement_position(statement).line, name, "kernel proposition context exceeds its bounded name capacity")
                            return
                        has_declared_type: bool = match declared_type:
                            Ast::Expr.Absent: false
                            _: true
                        if has_declared_type and not proof_replay_summary_expr_repeat_charge_with_limit(declared_type, 1, kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                            proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                            return
                        type_name: mutable sview = proof_source_type_spelling(declared_type, 0)
                        context_type: mutable Ast::Expr = declared_type
                        if not has_declared_type:
                            if not proof_replay_summary_expr_repeat_charge_with_limit(initializer, 1, kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                                proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                                return
                            inferred: Semantic::InferType = Semantic::infer_expression_type_for_proof(initializer, names, types, table)
                            type_name <- proof_source_inferred_type_spelling(inferred)
                            context_type <- proof_source_inferred_tuple_type_with_work(initializer, file.top_decls, names, kernel_workspace.source_work_used, 0) if inferred.kind == Semantic::SemTypeKind.Tuple
                            if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                                return
                        if not proof_source_kernel_charge_work(3, kernel_workspace.source_work_used):
                            proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                            return
                        names.push(local_name)
                        proof_source_kernel_context_changed(kernel_workspace)
                        types.push(type_name)
                        source_types.push(context_type)
                    Ast::Stmt.Assign(target, TokenKind.Assign, initializer, _):
                        # The parser represents inferred `name = value` declarations
                        # as assignments. Enter their type before validating later
                        # guards, using the same semantic inference as unannotated
                        # VarDecls. This grants a sort, never an executable fact.
                        local_name: sview = proof_ident_name(target)
                        if local_name != "":
                            if not proof_source_proposition_context_fits(names.count, 1):
                                report.proof_obligation(false)
                                proof_add_finding(report, "contract-proposition-type", proof_statement_position(statement).line, name, "kernel proposition context exceeds its bounded name capacity")
                                return
                            if not proof_replay_summary_expr_repeat_charge_with_limit(initializer, 1, kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                                proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                                return
                            inferred: Semantic::InferType = Semantic::infer_expression_type_for_proof(initializer, names, types, table)
                            declared_return: Ast::Expr = proof_source_inferred_tuple_type_with_work(initializer, file.top_decls, names, kernel_workspace.source_work_used, 0)
                            if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                                return
                            context_type: mutable Ast::Expr = Ast::Expr.Absent
                            type_name: mutable sview = proof_source_inferred_type_spelling(inferred)
                            match declared_return:
                                Ast::Expr.Tuple(_, _):
                                    context_type <- declared_return
                                    type_name <- "tuple"
                                _:
                                    pass
                            if not proof_source_kernel_charge_work(3, kernel_workspace.source_work_used):
                                proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                                return
                            names.push(local_name)
                            proof_source_kernel_context_changed(kernel_workspace)
                            types.push(type_name)
                            source_types.push(context_type)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_source_validate_context_proposition(condition, name, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, file, table, report)
                        then_name_mark: usize = names.count
                        then_type_mark: usize = types.count
                        then_source_type_mark: usize = source_types.count
                        proof_source_validate_statement_propositions(file, name, then_body, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, depth + 1)
                        names <- names.truncate(then_name_mark)
                        proof_source_kernel_context_changed(kernel_workspace)
                        types <- types.truncate(then_type_mark)
                        source_types <- source_types.truncate(then_source_type_mark)
                        else_name_mark: usize = names.count
                        else_type_mark: usize = types.count
                        else_source_type_mark: usize = source_types.count
                        proof_source_validate_statement_propositions(file, name, else_body, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, depth + 1)
                        names <- names.truncate(else_name_mark)
                        proof_source_kernel_context_changed(kernel_workspace)
                        types <- types.truncate(else_type_mark)
                        source_types <- source_types.truncate(else_source_type_mark)
                    Ast::Stmt.While(condition, loop_body, _):
                        proof_source_validate_context_proposition(condition, name, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, file, table, report)
                        loop_name_mark: usize = names.count
                        loop_type_mark: usize = types.count
                        loop_source_type_mark: usize = source_types.count
                        proof_source_validate_statement_propositions(file, name, loop_body, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, depth + 1)
                        names <- names.truncate(loop_name_mark)
                        proof_source_kernel_context_changed(kernel_workspace)
                        types <- types.truncate(loop_type_mark)
                        source_types <- source_types.truncate(loop_source_type_mark)
                    Ast::Stmt.For(_, variables, iterable, loop_body, _):
                        loop_name_mark: usize = names.count
                        loop_type_mark: usize = types.count
                        loop_source_type_mark: usize = source_types.count
                        if not proof_replay_summary_expr_repeat_charge_with_limit(iterable, 2, kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                            proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                            return
                        element_type: sview = proof_source_for_element_type(iterable, names, types, source_types, file.top_decls, table, kernel_workspace.source_work_used)
                        if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                            return
                        if not proof_source_proposition_context_fits(names.count, variables.count):
                            report.proof_obligation(false)
                            proof_add_finding(report, "contract-proposition-type", proof_statement_position(statement).line, name, "kernel proposition context exceeds its bounded name capacity")
                            return
                        if not proof_source_kernel_charge_work(variables.count * 3, kernel_workspace.source_work_used):
                            proof_source_kernel_projection_budget_refusal(report, name, proof_statement_position(statement).line, kernel_workspace)
                            return
                        for variable in variables |names, types, source_types, element_type|:
                            names.push(variable)
                            proof_source_kernel_context_changed(kernel_workspace)
                            types.push(element_type)
                            source_types.push(Ast::Expr.Absent)
                        proof_source_validate_statement_propositions(file, name, loop_body, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, depth + 1)
                        names <- names.truncate(loop_name_mark)
                        proof_source_kernel_context_changed(kernel_workspace)
                        types <- types.truncate(loop_type_mark)
                        source_types <- source_types.truncate(loop_source_type_mark)
                    Ast::Stmt.Match(scrutinee, arms, position):
                        for arm in arms |file, name, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, depth, scrutinee, position|:
                            return if kernel_workspace.source_work_exhaustion_reported
                            if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                                return
                            pattern_cost: mutable usize = 0
                            if not proof_replay_summary_pattern_cost(arm.pattern, &pattern_cost, kernel_workspace.source_work_used, 0) or pattern_cost == 0 or not proof_source_kernel_charge_work(pattern_cost, kernel_workspace.source_work_used):
                                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                                return
                            arm_name_mark: usize = names.count
                            arm_type_mark: usize = types.count
                            arm_source_type_mark: usize = source_types.count
                            binding_names: mutable darray[sview] = []
                            binding_values: mutable darray[Ast::Expr] = []
                            proof_bind_pattern(arm.pattern, position, scrutinee, &binding_names, &binding_values)
                            if not proof_source_proposition_context_fits(names.count, binding_names.count):
                                report.proof_obligation(false)
                                proof_add_finding(report, "contract-proposition-type", position.line, name, "kernel proposition context exceeds its bounded name capacity")
                                return
                            if not proof_source_kernel_charge_work(binding_names.count * 3, kernel_workspace.source_work_used):
                                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                                return
                            # A positional payload binder has no source place to take a type
                            # from; its declared payload field gives it one.
                            payload_types: mutable darray[Ast::Expr] = []
                            payload_typed: bool = proof_payload_binder_types(arm.pattern, file.top_decls, file.enum_annotations, &payload_types, kernel_workspace.source_work_used) and payload_types.count == binding_names.count
                            if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                                return
                            for binding_index in 0..<binding_names.count |binding_index, binding_names, binding_values, names, types, source_types, table, file, payload_typed, payload_types|:
                                binding_work: usize = names.count + types.count + source_types.count + 1
                                if not proof_source_kernel_charge_work(binding_work, kernel_workspace.source_work_used) or not proof_replay_summary_expr_repeat_charge_with_limit(binding_values[binding_index], 3, kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                                    proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                                    return
                                binding_source_type: Ast::Expr = payload_types[binding_index] if payload_typed else proof_source_expression_type_hint(binding_values[binding_index], names, source_types, file.top_decls, kernel_workspace.source_work_used, 0)
                                binding_type_name: mutable sview = proof_source_type_spelling(binding_source_type, 0)
                                if binding_type_name == "":
                                    inferred_binding: Semantic::InferType = Semantic::infer_expression_type_for_proof(binding_values[binding_index], names, types, table)
                                    binding_type_name <- proof_source_inferred_type_spelling(inferred_binding)
                                if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                    proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                                    return
                                names.push(binding_names[binding_index])
                                proof_source_kernel_context_changed(kernel_workspace)
                                types.push(binding_type_name)
                                source_types.push(binding_source_type)
                            has_guard: bool = match arm.guard:
                                Ast::Expr.Absent: false
                                _: true
                            proof_source_validate_context_proposition(arm.guard, name, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, file, table, report) if has_guard
                            proof_source_validate_statement_propositions(file, name, arm.body, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, depth + 1)
                            names <- names.truncate(arm_name_mark)
                            proof_source_kernel_context_changed(kernel_workspace)
                            types <- types.truncate(arm_type_mark)
                            source_types <- source_types.truncate(arm_source_type_mark)
                    Ast::Stmt.Block(_, _, _, nested_body, _):
                        block_name_mark: usize = names.count
                        block_type_mark: usize = types.count
                        block_source_type_mark: usize = source_types.count
                        proof_source_validate_statement_propositions(file, name, nested_body, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, depth + 1)
                        names <- names.truncate(block_name_mark)
                        proof_source_kernel_context_changed(kernel_workspace)
                        types <- types.truncate(block_type_mark)
                        source_types <- source_types.truncate(block_source_type_mark)
                    Ast::Stmt.Contract(kind, expression, _):
                        if kind == "assert":
                            proof_source_validate_context_proposition(expression, name, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, file, table, report)
                        if kind == "invariant":
                            proof_source_validate_context_proposition(expression, name, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, file, table, report)
                    _:
                        pass

        def proof_validate_function_propositions[@r](file: Ast::File&, name: sview, parameters: darray[Ast::ParamDecl]&, return_type: Ast::Expr?, body: darray[Ast::Stmt]&, position: Ast::Pos, module_path: darray[sview]&, global_kernel_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], kernel_workspace: mutable ProofSourceKernelFormationWorkspace& @r, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace& @r, table: Semantic::SymbolTable&, report: mutable ProofReport&) -> void can[Memory.Allocate, Abort.Panic]:
            return if kernel_workspace.source_work_exhaustion_reported
            kernel_workspace.typing_work_used <- 0
            kernel_workspace.owner_declaration_line <- position.line
            kernel_workspace.owner_declaration_offset <- position.offset.usize()
            kernel_workspace.type_index.scope_path.clear()
            kernel_workspace.type_index.scope_path.extend(module_path)
            if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            names: mutable darray[sview] = []
            types: mutable darray[sview] = []
            source_types: mutable darray[Ast::Expr] = []
            constants_complete: bool = true
            if module_path.count != 0:
                constants_complete <- proof_source_collect_scope_constants(file.top_decls, module_path, 0, &names, &types, &source_types, kernel_workspace.source_work_used, parameters.count, 0)
                kernel_workspace.source_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1 if not constants_complete
                if not constants_complete:
                    proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                    return
            parameters_complete: bool = proof_source_proposition_parameters_with_work(parameters, names, types, source_types, kernel_workspace.source_work_used)
            if not parameters_complete:
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            requirement_inventory: (complete: bool, expressions: darray[Ast::Expr]) = proof_source_proposition_contracts_with_work(body, "requires", kernel_workspace.source_work_used)
            requirements: mutable darray[Ast::Expr] = requirement_inventory.expressions
            if not requirement_inventory.complete:
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            signature_contracts: (complete: bool, preconditions: darray[Ast::Expr], postconditions: darray[Ast::Expr]) = proof_signature_contracts_for_line_with_work(file, position.line, kernel_workspace.source_work_used)
            if not signature_contracts.complete:
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            if not proof_source_kernel_charge_work(signature_contracts.preconditions.count, kernel_workspace.source_work_used):
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            requirements.extend(signature_contracts.preconditions)
            for requirement in requirements |names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, table, file, report, name|:
                kernel_failure: mutable sview = ""
                kernel_formed: bool = proof_source_kernel_proposition_formed(requirement, names, types, source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, file, &kernel_failure)
                if not kernel_formed:
                    if kernel_failure == "kernel source work budget exceeded":
                        proof_source_kernel_projection_budget_refusal(report, name, Ast::expr_pos(requirement).line, kernel_workspace)
                        return
                    report.proof_obligation(false)
                    source_position: Ast::Pos = Ast::expr_pos(requirement)
                    diagnostic: sview = "kernel post-state result binding absent" if kernel_failure == "post-result-binding-missing" else "kernel context binding absent" if kernel_failure == "local-context-binding-missing" else "kernel context sort mismatch" if kernel_failure == "local-context-sort-mismatch" else "kernel context type-name mismatch" if kernel_failure == "local-context-name-mismatch" else "kernel context element-sort mismatch" if kernel_failure == "local-context-element-mismatch" else "kernel typing environment unrepresentable" if kernel_failure == "local-context-unrepresented" else kernel_failure if kernel_failure != "" and kernel_failure != "term-sort-or-operator-rejected" else "kernel proposition formation rejected the term or operator"
                    proof_add_finding(report, "contract-proposition-type", source_position.line, name, diagnostic) if kernel_failure != "kernel source work budget exceeded"
            post_names: mutable darray[sview] = []
            post_types: mutable darray[sview] = []
            post_source_types: mutable darray[Ast::Expr] = []
            if not proof_source_kernel_charge_work(names.count * 3, kernel_workspace.source_work_used):
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            post_names.extend(names)
            proof_source_kernel_context_changed(kernel_workspace)
            post_types.extend(types)
            post_source_types.extend(source_types)
            if return_type is declared_return_type:
                if not proof_replay_summary_expr_repeat_charge_with_limit(declared_return_type, 1, kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                    proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                    return
                if not proof_source_proposition_context_fits(post_names.count, 1):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-proposition-type", position.line, name, "kernel proposition context exceeds its bounded name capacity")
                    return
                post_names.push("result")
                proof_source_kernel_context_changed(kernel_workspace)
                post_types.push(proof_source_type_spelling(declared_return_type, 0))
                post_source_types.push(declared_return_type)
            postcondition_inventory: (complete: bool, expressions: darray[Ast::Expr]) = proof_source_proposition_contracts_with_work(body, "ensure", kernel_workspace.source_work_used)
            postconditions: mutable darray[Ast::Expr] = postcondition_inventory.expressions
            if not postcondition_inventory.complete:
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            if not proof_source_kernel_charge_work(signature_contracts.postconditions.count, kernel_workspace.source_work_used):
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            postconditions.extend(signature_contracts.postconditions)
            if postconditions.count == 0:
                unfolded_ensures: darray[Ast::Expr] = proof_unfolded_ensures(parameters, body, return_type, file.top_decls, &kernel_workspace.source_work_used)
                if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                    return
                if not proof_source_kernel_charge_work(unfolded_ensures.count, kernel_workspace.source_work_used):
                    proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                    return
                postconditions.extend(unfolded_ensures)
            for postcondition in postconditions |post_names, post_types, post_source_types, module_path, global_kernel_bindings, kernel_workspace, table, file, report, name|:
                kernel_failure: mutable sview = ""
                kernel_formed: bool = proof_source_kernel_proposition_formed(postcondition, post_names, post_types, post_source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, file, &kernel_failure)
                if not kernel_formed:
                    if kernel_failure == "kernel source work budget exceeded":
                        proof_source_kernel_projection_budget_refusal(report, name, Ast::expr_pos(postcondition).line, kernel_workspace)
                        return
                    report.proof_obligation(false)
                    source_position: Ast::Pos = Ast::expr_pos(postcondition)
                    diagnostic: sview = "kernel post-state result binding absent" if kernel_failure == "post-result-binding-missing" else "kernel context binding absent" if kernel_failure == "local-context-binding-missing" else "kernel context sort mismatch" if kernel_failure == "local-context-sort-mismatch" else "kernel context type-name mismatch" if kernel_failure == "local-context-name-mismatch" else "kernel context element-sort mismatch" if kernel_failure == "local-context-element-mismatch" else "kernel typing environment unrepresentable" if kernel_failure == "local-context-unrepresented" else kernel_failure if kernel_failure != "" and kernel_failure != "term-sort-or-operator-rejected" else "kernel proposition formation rejected the term or operator"
                    proof_add_finding(report, "contract-proposition-type", source_position.line, name, diagnostic) if kernel_failure != "kernel source work budget exceeded"
            body_names: mutable darray[sview] = []
            body_types: mutable darray[sview] = []
            body_source_types: mutable darray[Ast::Expr] = []
            if not proof_source_kernel_charge_work(names.count * 3, kernel_workspace.source_work_used):
                proof_source_kernel_projection_budget_refusal(report, name, position.line, kernel_workspace)
                return
            body_names.extend(names)
            body_types.extend(types)
            body_source_types.extend(source_types)
            proof_source_validate_statement_propositions(file, name, body, &body_names, &body_types, &body_source_types, module_path, global_kernel_bindings, kernel_workspace, validation_workspace, table, report, 0)

        def proof_validate_propositions_in_declarations[@r](file: Ast::File&, declarations: darray[Ast::Decl]&, global_kernel_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], kernel_workspace: mutable ProofSourceKernelFormationWorkspace& @r, table: Semantic::SymbolTable&, report: mutable ProofReport&) -> void can[Memory.Allocate, Abort.Panic]:
            module_path: mutable darray[sview] = []
            proof_validate_propositions_in_scope(file, declarations, &module_path, global_kernel_bindings, kernel_workspace, table, report)

        # G68: kernel typing owns module constants by exact module path, so an unqualified
        # constant in a contract resolves through this owner-module context. Matching `Scoped`
        # blocks (including extends) at that exact path contribute constants; ancestor modules
        # are not searched. Root-scope fallback is resolved separately. Parameters and locals
        # are appended later so they shadow constants in the owner module.
        def proof_validate_propositions_in_scope[@r](file: Ast::File&, declarations: darray[Ast::Decl]&, module_path: darray[sview]&, global_kernel_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], kernel_workspace: mutable ProofSourceKernelFormationWorkspace& @r, table: Semantic::SymbolTable&, report: mutable ProofReport&) -> void can[Memory.Allocate, Abort.Panic]:
            for declaration in declarations |file, declarations, module_path, global_kernel_bindings, kernel_workspace, table, report|:
                match declaration:
                    Ast::Decl.Func(name, parameters, return_type, body, _, _, position):
                        report.analysis_2.finding_function <- name
                        report.analysis_2.finding_owner <- module_path[module_path.count - 1] if module_path.count > 0 else ""
                        report.analysis_2.finding_line <- position.line
                        report.analysis_2.finding_offset <- position.offset
                        proof_validate_function_propositions(file, name, parameters, return_type, body, position, module_path, global_kernel_bindings, kernel_workspace, &kernel_workspace.validation_workspace, table, report)
                        report.analysis_2.finding_function <- ""
                        report.analysis_2.finding_owner <- ""
                        report.analysis_2.finding_line <- 0
                        report.analysis_2.finding_offset <- 0
                    Ast::Decl.Module(module_name, body, _):
                        next_scope: mutable darray[sview] = proof_global_constant_scope_with_module(module_path, module_name)
                        proof_validate_propositions_in_scope(file, body, &next_scope, global_kernel_bindings, kernel_workspace, table, report)
                    Ast::Decl.Scoped(body, _):
                        proof_validate_propositions_in_scope(file, body, module_path, global_kernel_bindings, kernel_workspace, table, report)
                    _:
                        pass
