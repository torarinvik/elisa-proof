extend ElisaProof:
    private:
        def proof_source_analysis_indexes_reset(report: mutable ProofReport&) -> void:
            report.source_primitive_operator_mask <- PROOF_SOURCE_OPERATOR_MASK_EMPTY
            report.source_operator_protocol_mask <- 0
            proof_const_enum_member_index_reset(report.source_const_enum_members)
            report.operator_impls.rows.clear()
            report.operator_impls.hashes.clear()
            report.operator_impls.bucket_heads.clear()
            report.operator_impls.next_indices.clear()
            report.operator_impls.valid <- false
            report.source_effect_index.declared_types.clear()
            report.source_effect_index.declared_type_owners.clear()
            report.source_effect_index.declared_type_scope_index_hashes.clear()
            report.source_effect_index.declared_type_scope_index_values.clear()
            report.source_effect_index.declared_type_scope_index_counts.clear()
            report.source_effect_index.declared_type_scope_index_valid <- false
            report.source_effect_index.drop_hook_types.clear()
            report.source_effect_index.drop_hook_index_hashes.clear()
            report.source_effect_index.drop_hook_index_values.clear()
            report.source_effect_index.drop_hook_index_counts.clear()
            report.source_effect_index.drop_hook_index_valid <- false
            report.source_effect_index.alias_names.clear()
            report.source_effect_index.alias_targets.clear()
            report.source_effect_index.alias_lines.clear()
            report.source_effect_index.alias_owners.clear()
            report.source_effect_index.resource_marker_type_names.clear()
            report.source_effect_index.resource_marker_type_targets.clear()
            report.source_effect_index.resource_marker_type_is_alias.clear()
            report.source_effect_index.resource_marker_type_nested_scope.clear()
            report.source_effect_index.resource_marker_type_index_hashes.clear()
            report.source_effect_index.resource_marker_type_index_values.clear()
            report.source_effect_index.resource_marker_type_index_counts.clear()
            report.source_effect_index.resource_marker_type_index_valid <- false
            report.source_effect_index.bare_alias_root_fallback_valid <- false
            report.source_effect_index.alias_scope_index_hashes.clear()
            report.source_effect_index.alias_scope_index_values.clear()
            report.source_effect_index.alias_scope_index_counts.clear()
            report.source_effect_index.alias_scope_index_valid <- false
            report.source_effect_index.alias_index_hashes.clear()
            report.source_effect_index.alias_index_values.clear()
            report.source_effect_index.alias_index_counts.clear()
            report.source_effect_index.alias_index_valid <- false
            report.source_effect_index.generic_param_index_hashes.clear()
            report.source_effect_index.generic_param_index_values.clear()
            report.source_effect_index.generic_param_index_counts.clear()
            report.source_effect_index.generic_param_index_valid <- false
            report.source_effect_index.generic_param_encoded_line_present <- false
            report.source_effect_index.generic_param_line_index_hashes.clear()
            report.source_effect_index.generic_param_line_index_values.clear()
            report.source_effect_index.generic_param_line_index_counts.clear()
            report.source_effect_index.generic_param_line_index_valid <- false
            report.source_effect_index.generic_param_names.clear()
            report.source_effect_index.alias_has_formals.clear()
            report.source_effect_index.declared_type_index_hashes.clear()
            report.source_effect_index.declared_type_index_values.clear()
            report.source_effect_index.declared_type_index_counts.clear()
            report.source_effect_index.declared_type_index_valid <- false
            report.source_effect_index.callable_names.clear()
            report.source_effect_index.callable_return_types.clear()
            report.source_effect_index.callable_lines.clear()
            report.source_effect_index.callable_index_hashes.clear()
            report.source_effect_index.callable_index_values.clear()
            report.source_effect_index.callable_index_counts.clear()
            report.source_effect_index.callable_index_valid <- false
            report.source_effect_index.field_conversion_names.clear()
            report.source_effect_index.field_conversion_index_hashes.clear()
            report.source_effect_index.field_conversion_index_values.clear()
            report.source_effect_index.field_conversion_index_counts.clear()
            report.source_effect_index.field_conversion_index_valid <- false
            report.source_effect_index.field_conversion_custom_cast_present <- false
            report.source_effect_index.extern_contract_names.clear()
            report.source_effect_index.extern_contract_lines.clear()
            report.source_effect_index.extern_contract_unsafe.clear()
            report.source_effect_index.extern_contract_hashes.clear()
            report.source_effect_index.extern_contract_slots.clear()
            report.source_effect_index.extern_contract_ambiguous.clear()
            report.source_effect_index.extern_contract_index_valid <- false
            report.source_effect_index.declaration_count <- 0
            report.source_effect_index.implicit_effect_work <- 0
