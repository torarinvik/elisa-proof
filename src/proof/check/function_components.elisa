extend ElisaProof:
    private:
        # Compute executable SCCs with iterative Kosaraju traversal. Charge every graph and
        # component traversal to the same source meter used for call resolution and scheduling.
        def proof_build_function_components(functions: mutable ProofFunctionTable&, source_work: mutable usize&) -> bool:
            count: usize = functions.lookup.source.names.count
            edge_total: usize = functions.call_graph.all_calls.count
            functions.summaries.recursive.clear()
            functions.summaries.recursive_component_ids.clear()
            return true if count == 0 and edge_total == 0 and functions.call_graph.call_starts.count == 0 and functions.call_graph.call_counts.count == 0 and functions.call_graph.all_call_targets.count == 0
            return false if:
                count == 0 or functions.call_graph.call_starts.count != count or functions.call_graph.call_counts.count != count
                functions.call_graph.all_call_targets.count != edge_total
            edge_cursor: mutable usize = 0
            for source in 0..<count |source, functions, source_work, edge_cursor|:
                return false if not proof_report_source_work_charge(1, source_work)
                start: usize = functions.call_graph.call_starts[source]
                edge_count: usize = functions.call_graph.call_counts[source]
                return false if start != edge_cursor or start > edge_total or edge_count > edge_total - start
                return false if not proof_report_source_work_charge(edge_count, source_work)
                edge_cursor <- edge_cursor + edge_count
            return false if edge_cursor != edge_total
            return false if not proof_report_source_work_charge(count, source_work)
            return false if not proof_report_source_work_charge(count, source_work)
            reverse_counts: mutable darray[usize] = []
            reverse_counts.resize(count)
            self_edges: mutable darray[bool] = []
            self_edges.resize(count)
            for source in 0..<count |source, functions, reverse_counts, self_edges, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                start: usize = functions.call_graph.call_starts[source]
                edge_count: usize = functions.call_graph.call_counts[source]
                for offset in 0..<edge_count |offset, source, start, functions, reverse_counts, self_edges, source_work|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    next: usize = functions.call_graph.all_call_targets[start + offset]
                    return false if next > count
                    continue if next >= count
                    reverse_counts[next] <- reverse_counts[next] + 1
                    self_edges[source] <- true if next == source
            reverse_starts: mutable darray[usize] = []
            reverse_cursor: mutable usize = 0
            for incoming in reverse_counts |reverse_starts, reverse_cursor, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                reverse_starts.push(reverse_cursor)
                reverse_cursor <- reverse_cursor + incoming
            return false if not proof_report_source_work_charge(reverse_cursor, source_work)
            reverse_edges: mutable darray[usize] = []
            reverse_edges.resize(reverse_cursor)
            return false if not proof_report_source_work_charge(count, source_work)
            reverse_write: mutable darray[usize] = []
            reverse_write.extend(reverse_starts)
            for source in 0..<count |source, functions, reverse_write, reverse_edges, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                start: usize = functions.call_graph.call_starts[source]
                edge_count: usize = functions.call_graph.call_counts[source]
                for offset in 0..<edge_count |offset, source, start, functions, reverse_write, reverse_edges, source_work|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    next: usize = functions.call_graph.all_call_targets[start + offset]
                    return false if next > count
                    continue if next >= count
                    slot: usize = reverse_write[next]
                    reverse_edges[slot] <- source
                    reverse_write[next] <- slot + 1
            return false if not proof_report_source_work_charge(count, source_work)
            visited: mutable darray[bool] = []
            visited.resize(count)
            order: mutable darray[usize] = []
            stack_nodes: mutable darray[usize] = []
            stack_offsets: mutable darray[usize] = []
            for source in 0..<count |source, visited, order, stack_nodes, stack_offsets, functions, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                continue if visited[source]
                stack_nodes.clear()
                stack_offsets.clear()
                stack_nodes.push(source)
                stack_offsets.push(0)
                visited[source] <- true
                while stack_nodes.count > 0 |stack_nodes, stack_offsets, visited, order, functions, source_work|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    top: usize = stack_nodes.count - 1
                    current: usize = stack_nodes[top]
                    start: usize = functions.call_graph.call_starts[current]
                    edge_count: usize = functions.call_graph.call_counts[current]
                    if stack_offsets[top] < edge_count:
                        offset: usize = stack_offsets[top]
                        stack_offsets[top] <- offset + 1
                        return false if not proof_report_source_work_charge(1, source_work)
                        next: usize = functions.call_graph.all_call_targets[start + offset]
                        return false if next > count
                        if next < count and not visited[next]:
                            visited[next] <- true
                            stack_nodes.push(next)
                            stack_offsets.push(0)
                    else:
                        order.push(current)
                        stack_nodes <- stack_nodes.truncate(top)
                        stack_offsets <- stack_offsets.truncate(top)
            return false if not proof_report_source_work_charge(count, source_work)
            component_ids: mutable darray[usize] = []
            component_ids.resize(count)
            for index in 0..<count |index, component_ids, count, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                component_ids[index] <- count
            component_work: mutable darray[usize] = []
            for order_index in 0..<order.count |order_index, order, component_ids, reverse_starts, reverse_counts, reverse_edges, component_work, count, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                seed: usize = order[order.count - 1 - order_index]
                continue if component_ids[seed] < count
                component_ids[seed] <- seed
                component_work.clear()
                component_work.push(seed)
                while component_work.count > 0 |component_work, component_ids, reverse_starts, reverse_counts, reverse_edges, count, source_work|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    current: usize = component_work[component_work.count - 1]
                    component_work <- component_work.truncate(component_work.count - 1)
                    start: usize = reverse_starts[current]
                    edge_count: usize = reverse_counts[current]
                    for offset in 0..<edge_count |offset, start, reverse_edges, component_ids, component_work, current, count, source_work|:
                        return false if not proof_report_source_work_charge(1, source_work)
                        predecessor: usize = reverse_edges[start + offset]
                        if component_ids[predecessor] == count:
                            component_ids[predecessor] <- seed
                            component_work.push(predecessor)
            return false if not proof_report_source_work_charge(count, source_work)
            component_sizes: mutable darray[usize] = []
            component_sizes.resize(count)
            for index in 0..<count |index, component_ids, component_sizes, count, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                component_sizes[component_ids[index]] <- component_sizes[component_ids[index]] + 1
            return false if not proof_report_source_work_charge(count, source_work)
            for index in 0..<count |index, component_ids, component_sizes, self_edges, functions|:
                functions.summaries.recursive_component_ids.push(component_ids[index])
                functions.summaries.recursive.push(component_sizes[component_ids[index]] > 1 or self_edges[index])
            return true

        def proof_build_function_components_or_report(functions: mutable ProofFunctionTable&, source_work: mutable usize&, report: mutable ProofReport&) -> bool:
            built: bool = proof_build_function_components(functions, source_work)
            functions.lookup.work.module_resolution_work_used <- source_work
            return true if built
            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "function component analysis exceeded its shared source-work bound", "function-component-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            else:
                proof_add_finding(report, "function-dependency-graph-invalid", 0, "", "function component analysis rejected malformed call-graph metadata")
            return false
