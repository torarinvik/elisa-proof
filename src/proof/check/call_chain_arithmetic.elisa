extend ElisaProof:
    private:
        # Whether a call's arguments compute anything: `land(t + step_at(t), end)` does,
        # `step(step(x))` does not. A chain whose links carry arithmetic needs each link as a
        # generalizable place before the wrap guard can read the sums inside it, which is what
        # lets `proof_add_deterministic_call_witness` spend one more witness on it.
        def proof_call_arguments_have_arithmetic(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments:
                        return true if proof_expr_has_arithmetic_depth(argument, 0)
                    return false
                _:
                    return false

        def proof_expr_has_arithmetic_depth(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_expr_has_arithmetic_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_has_arithmetic_depth(operand, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return true if operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star
                    return proof_expr_has_arithmetic_depth(left, depth + 1) or proof_expr_has_arithmetic_depth(right, depth + 1)
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments |depth|:
                        return true if proof_expr_has_arithmetic_depth(argument, depth + 1)
                    return false
                _:
                    return false
