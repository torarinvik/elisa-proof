extend ElisaProof:
    private:
        # Whether a call chain carries arithmetic over one of its links: in the call itself,
        # `land(t + step_at(t), end)`, or in a fact already recorded about it, `advance(t, d) ==
        # t + d` before `clamp(advance(t, d), end)`. Such a chain needs each link as a
        # generalizable place before the wrap guard can read the sums over it, which is what
        # lets `proof_add_deterministic_call_witness` spend one more witness on it. A chain of
        # bare comparisons, `step(step(x)) <= 100`, does not qualify.
        def proof_chain_reads_arithmetic(expression: Ast::Expr, facts: darray[Ast::Expr]&, links: darray[Ast::Expr]&) -> bool:
            return false if links.count == 0
            return true if proof_arithmetic_over_links(expression, links, false, 0)
            for fact in facts |links|:
                return true if proof_arithmetic_over_links(fact, links, false, 0)
            return false

        # `inside` is set below an arithmetic operator; a link met there is read as a number.
        def proof_arithmetic_over_links(expression: Ast::Expr, links: darray[Ast::Expr]&, inside: bool, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            if inside:
                for link in links |expression|:
                    return true if proof_expr_equal(link, expression)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_arithmetic_over_links(inner, links, inside, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_arithmetic_over_links(operand, links, inside, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star
                    return proof_arithmetic_over_links(left, links, inside or arithmetic, depth + 1) or proof_arithmetic_over_links(right, links, inside or arithmetic, depth + 1)
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments |links, inside, depth|:
                        return true if proof_arithmetic_over_links(argument, links, inside, depth + 1)
                    return false
                _:
                    return false
