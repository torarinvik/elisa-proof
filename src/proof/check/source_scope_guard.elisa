# Source name and binder checks shared by purity and structural admission.
extend ElisaProof:
    private:
        def proof_source_parameter_name_shadow(parameters: darray[Ast::ParamDecl]&, name: sview, report: mutable ProofReport&) -> bool:
            return true if not proof_source_index_work_charge(report, sview_len(name))
            for parameter in parameters |name, report|:
                return true if not proof_source_index_work_charge(report, 1 + sview_len(parameter.name))
                return true if parameter.name == name
            return false

        def proof_source_pattern_shadows_parameter(pattern: Ast::Pattern, parameters: darray[Ast::ParamDecl]&, report: mutable ProofReport&, depth: usize) -> bool:
            return true if depth >= PROOF_SOURCE_OPERATOR_AST_DEPTH_LIMIT
            return true if not proof_source_index_work_charge(report, 1)
            match pattern:
                Ast::Pattern.Binding(name) | Ast::Pattern.Rest(name):
                    return proof_source_parameter_name_shadow(parameters, name, report)
                Ast::Pattern.TypeBind(_, name):
                    return proof_source_parameter_name_shadow(parameters, name, report)
                Ast::Pattern.As(name, inner):
                    return proof_source_parameter_name_shadow(parameters, name, report) or proof_source_pattern_shadows_parameter(inner, parameters, report, depth + 1)
                Ast::Pattern.Variant(_, fields) | Ast::Pattern.Struct(_, fields) | Ast::Pattern.Tuple(fields) | Ast::Pattern.Or(fields):
                    for field in fields |parameters, report, depth|:
                        return true if proof_source_pattern_shadows_parameter(field, parameters, report, depth + 1)
                    return false
                Ast::Pattern.Field(_, fields):
                    for field in fields |parameters, report, depth|:
                        return true if proof_source_pattern_shadows_parameter(field, parameters, report, depth + 1)
                    return false
                Ast::Pattern.Wildcard | Ast::Pattern.Literal(_) | Ast::Pattern.Range(_, _, _):
                    return false
                _:
                    return true

        def proof_source_pattern_shadows_type_or_callable(pattern: Ast::Pattern, report: mutable ProofReport&, depth: usize) -> bool:
            return true if depth >= PROOF_SOURCE_OPERATOR_AST_DEPTH_LIMIT
            return true if not proof_source_index_work_charge(report, 1)
            match pattern:
                Ast::Pattern.Binding(name) | Ast::Pattern.Rest(name):
                    return proof_source_name_is_type_or_callable(name, report)
                Ast::Pattern.TypeBind(_, name):
                    return proof_source_name_is_type_or_callable(name, report)
                Ast::Pattern.As(name, inner):
                    return proof_source_name_is_type_or_callable(name, report) or proof_source_pattern_shadows_type_or_callable(inner, report, depth + 1)
                Ast::Pattern.Variant(_, fields) | Ast::Pattern.Struct(_, fields) | Ast::Pattern.Tuple(fields) | Ast::Pattern.Or(fields) | Ast::Pattern.Field(_, fields):
                    for field in fields |report, depth|:
                        return true if proof_source_pattern_shadows_type_or_callable(field, report, depth + 1)
                    return false
                Ast::Pattern.Wildcard | Ast::Pattern.Literal(_) | Ast::Pattern.Range(_, _, _):
                    return false
                _:
                    return true

        def proof_source_expression_is_int_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                _:
                    return false

        def proof_source_name_is_type_or_callable(name: sview, report: mutable ProofReport&) -> bool:
            return false if name == ""
            callable_count: usize = proof_source_effect_name_count(report.source_effect_index.callable_names, name, &report.source_effect_index.implicit_effect_work)
            type_count: usize = proof_source_effect_name_count(report.source_effect_index.declared_types, name, &report.source_effect_index.implicit_effect_work)
            return callable_count > 0 or type_count > 0

        def proof_source_name_is_unique_type_or_callable(name: sview, report: mutable ProofReport&) -> bool:
            return false if name == ""
            callable_count: usize = proof_source_effect_name_count(report.source_effect_index.callable_names, name, &report.source_effect_index.implicit_effect_work)
            type_count: usize = proof_source_effect_name_count(report.source_effect_index.declared_types, name, &report.source_effect_index.implicit_effect_work)
            return (callable_count == 1 and type_count == 0) or (callable_count == 0 and type_count == 1)

        def proof_source_callable_type_application(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, report: mutable ProofReport&) -> bool:
            match expression:
                Ast::Expr.Index(head, _, _) | Ast::Expr.IndexN(head, _, _):
                    name: sview = proof_source_type_application_head_name(head)
                    return false if name == "" or proof_source_parameter_name_shadow(parameters, name, report)
                    return proof_source_name_is_unique_type_or_callable(name, report)
                _:
                    return false

        def proof_source_type_application_head_name(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Scope(_, name, _) | Ast::Expr.Field(_, name, _):
                    return name
                _:
                    return ""

        def proof_source_fresh_assignment_shadows_parameter(target: Ast::Expr, parameters: darray[Ast::ParamDecl]&, report: mutable ProofReport&, depth: usize) -> bool:
            return true if depth >= PROOF_SOURCE_OPERATOR_AST_DEPTH_LIMIT
            match target:
                Ast::Expr.Ident(name, _):
                    return proof_source_parameter_name_shadow(parameters, name, report) or proof_source_name_is_type_or_callable(name, report)
                Ast::Expr.Paren(inner, _):
                    return proof_source_fresh_assignment_shadows_parameter(inner, parameters, report, depth + 1)
                Ast::Expr.Tuple(elements, _) | Ast::Expr.Array(elements, _):
                    for element in elements |parameters, report, depth|:
                        return true if proof_source_fresh_assignment_shadows_parameter(element, parameters, report, depth + 1)
                    return false
                _:
                    return true
