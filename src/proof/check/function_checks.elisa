extend ElisaProof:
    private:
        def proof_check_function_with_goal_owner(file: Ast::File&, function_name: sview, parameters: darray[Ast::ParamDecl]&, return_type: Ast::Expr?, body: darray[Ast::Stmt]&, position: Ast::Pos, is_lemma: bool, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> void can[Global.Read, Global.Write]:
            saved_line: u32 = report.context.current_goal_owner_line
            saved_offset: u32 = report.context.current_goal_owner_offset
            saved_caller: usize = functions.call_graph.current_caller
            saved_caller_is_lemma: bool = functions.call_graph.current_caller_is_lemma
            saved_caller_module: sview = functions.call_graph.current_caller_module
            report.context.current_goal_owner_line <- position.line
            report.context.current_goal_owner_offset <- position.offset
            functions.call_graph.current_caller_is_lemma <- is_lemma
            if is_lemma:
                # A lemma has a distinct identity table. Keep executable caller based helpers
                # from borrowing whichever function row the scheduler checked previously.
                functions.call_graph.current_caller <- functions.lookup.names.count
            proof_check_function(file, function_name, parameters, return_type, body, position, is_lemma, lemmas, functions, report)
            functions.call_graph.current_caller <- saved_caller
            functions.call_graph.current_caller_is_lemma <- saved_caller_is_lemma
            functions.call_graph.current_caller_module <- saved_caller_module
            report.context.current_goal_owner_line <- saved_line
            report.context.current_goal_owner_offset <- saved_offset

        def proof_check_function(file: Ast::File&, function_name: sview, parameters: darray[Ast::ParamDecl]&, return_type: Ast::Expr?, body: darray[Ast::Stmt]&, position: Ast::Pos, is_lemma: bool, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> void can[Global.Read, Global.Write]:
            # The logical kernel currently models ordinary equality and integer arithmetic,
            # not IEEE NaN or rounding. Erasing a floating parameter to an untyped identifier
            # would make even x == x an unsound theorem. Stop before publishing obligations
            # that a source-bound tactic could otherwise repair under the wrong semantics.
            # Lemmas are not executable-function rows. Never borrow a same-named executable
            # caller row for their parameter, recursion, or owner metadata. A lemma's exact module
            # identity is installed below so callee resolution can still use verified executable
            # contracts in that source scope.
            function_index: mutable usize = functions.lookup.names.count if is_lemma else proof_function_index_at_line(functions, function_name, position.line)
            # Scheduled executable checks know their exact declaration row. Prefer it over the
            # name+line lookup when all three identity fields agree.
            scheduled_caller: usize = functions.call_graph.current_caller
            if not is_lemma and scheduled_caller < functions.lookup.names.count and scheduled_caller < functions.lookup.lines.count and scheduled_caller < functions.lookup.offsets.count:
                if functions.lookup.names[scheduled_caller] == function_name and functions.lookup.lines[scheduled_caller] == position.line and functions.lookup.offsets[scheduled_caller] == position.offset:
                    function_index <- scheduled_caller
            caller_scope: mutable darray[sview] = proof_global_constant_scope_with_module([], functions.lookup.owner_modules[function_index]) if function_index < functions.lookup.owner_modules.count else []
            caller_module: mutable sview = functions.lookup.owner_modules[function_index] if function_index < functions.lookup.owner_modules.count else ""
            caller_declaration_line: mutable u32 = position.line if function_index < functions.lookup.owner_modules.count else 0
            if is_lemma:
                # Lemma checking may run while `current_caller` still names the last executable
                # function. Resolve the lemma by its own source identity before selecting scope.
                lemma_source: (complete: bool, index: usize, declared: bool) = proof_lemma_source_row_with_work(lemmas, function_name, position.line, position.offset, &functions.lookup.module_resolution_work_used)
                if not lemma_source.complete or not lemma_source.declared or lemma_source.index >= lemmas.identity.owner_modules.count or lemmas.identity.owner_modules.count != lemmas.identity.names.count or lemmas.identity.lines.count != lemmas.identity.names.count or lemmas.identity.offsets.count != lemmas.identity.names.count:
                    report.proof_obligation(false)
                    proof_add_finding(report, "lemma-owner-unavailable", position.line, function_name, "lemma declaration owner could not be resolved exactly")
                    return
                caller_module <- lemmas.identity.owner_modules[lemma_source.index]
                functions.call_graph.current_caller_module <- caller_module
                caller_scope <- proof_global_constant_scope_with_module([], caller_module)
                caller_declaration_line <- position.line
            enum_context: (known: bool, declarations: darray[Ast::Decl], module_scope: darray[sview]) = proof_function_enum_context_for_source(file, functions, function_index, function_name, position.line, position.offset, caller_module)
            if not enum_context.known:
                report.proof_obligation(false)
                proof_add_finding(report, "function-enum-context-unavailable", position.line, function_name, "function enum qualification context could not be resolved to the exact source declaration")
                return
            report.context.current_return_signed_width <- 0
            can Global.Write:
                proof_float_mode <- false
                report.context.current_float_mode <- false
            # Source functions enter this checker through the direct API as well as the
            # structural-purity and termination passes. Reject operator dispatch that the
            # proof model cannot represent before publishing any obligations; in particular,
            # semantic analysis permits Named compound targets as possible overloads even
            # though the backend has no compound-operator dispatch path.
            unsupported_default_operator: mutable bool = proof_structural_typed_operator_defaults_have_overload(parameters, position.line, report, caller_module, caller_declaration_line != 0)
            unsupported_default_index: mutable bool = false
            for parameter in parameters |parameters, report, unsupported_default_index, position, caller_module, caller_declaration_line|:
                unsupported_default_index <- true if parameter.has_default and proof_source_expression_has_unsafe_runtime_index(parameter.default_value, parameters, report, 0, [], position.line, caller_module, caller_declaration_line != 0)
            if unsupported_default_operator or unsupported_default_index or proof_structural_typed_operator_statements_have_overload(body, parameters, position.line, report, 0, caller_module, caller_declaration_line != 0) or proof_source_statements_have_unsafe_runtime_index(body, parameters, report, 0, [], position.line, caller_module, caller_declaration_line != 0):
                report.proof_obligation(false)
                proof_add_finding(report, "source-operator-unsupported", position.line, function_name, "function body contains operator or indexing dispatch that is not modeled by source proof admission")
                return
            if return_type is declared_return_type:
                return_has_generic: bool = proof_resource_type_mentions_owner_generic_at_owner_with_work(declared_return_type, position.line, position.offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work, 0)
                # Float-aware reasoning is function scoped. A float return can reach a
                # postcondition even when no parameter has a float type.
                if proof_type_may_contain_float(declared_return_type, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, &report.source_types.source_effect_index.work.implicit_effect_work):
                    can Global.Write:
                        proof_float_mode <- true
                        report.context.current_float_mode <- true
                report.context.current_return_unsigned_width <- 0 if return_has_generic
                report.context.current_return_unsigned_width <- proof_unsigned_type_width_index_with_work(declared_return_type, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_types.source_effect_index.work.implicit_effect_work) if not return_has_generic
                report.context.current_return_signed_width <- 0 if return_has_generic
                report.context.current_return_signed_width <- proof_signed_type_width_index_with_work(declared_return_type, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_types.source_effect_index.work.implicit_effect_work) if not return_has_generic
            if report.context.current_return_unsigned_width < 0:
                report.proof_obligation(false)
                proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "return numeric type alias cannot be resolved uniquely")
                report.context.current_return_unsigned_width <- 0
                return
            parameter_start: usize = functions.parameters.metadata.param_starts[function_index] if function_index < functions.parameters.metadata.param_starts.count else functions.parameters.metadata.all_parameter_may_contain_float.count
            parameter_slot: mutable usize = 0
            for parameter in parameters |report, function_index, functions, parameter_start, parameter_slot, function_name, position|:
                parameter_has_generic: bool = proof_resource_type_mentions_owner_generic_at_owner_with_work(parameter.type_expression, position.line, position.offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work, 0)
                if not parameter_has_generic and proof_unsigned_type_width_index_with_work(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_types.source_effect_index.work.implicit_effect_work) < 0:
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "parameter numeric type alias cannot be resolved uniquely")
                    return
                contains_float: mutable bool = false
                if function_index < functions.parameters.metadata.param_starts.count and parameter_start + parameter_slot < functions.parameters.metadata.all_parameter_may_contain_float.count:
                    contains_float <- functions.parameters.metadata.all_parameter_may_contain_float[parameter_start + parameter_slot]
                else:
                    contains_float <- proof_type_may_contain_float(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, &report.source_types.source_effect_index.work.implicit_effect_work)
                # Floating parameters switch the function to syntactic fact containment
                # (see proof_float_mode); no arithmetic, ordering or rewriting rule applies.
                if contains_float:
                    can Global.Write:
                        proof_float_mode <- true
                        report.context.current_float_mode <- true
                parameter_slot <- parameter_slot + 1
            preconditions: mutable darray[Ast::Expr] = proof_contracts(body, "requires")
            signature_contracts: (complete: bool, preconditions: darray[Ast::Expr], postconditions: darray[Ast::Expr]) = proof_signature_contracts_for_line_with_work(file, position.line, functions.lookup.module_resolution_work_used)
            functions.lookup.module_resolution_work_exhausted <- true if not signature_contracts.complete
            signature_requires: darray[Ast::Expr] = signature_contracts.preconditions
            preconditions.extend(signature_requires)
            postconditions: mutable darray[Ast::Expr] = proof_contracts(body, "ensure")
            body_postcondition_count: usize = postconditions.count
            signature_ensures: darray[Ast::Expr] = signature_contracts.postconditions
            postconditions.extend(signature_ensures)
            for index in 0..<postconditions.count |index, postconditions, file, functions, function_index|:
                postconditions[index] <- proof_qualify_function_enum_contract_in_context(enum_context.declarations, enum_context.module_scope, functions, function_index, parameters, postconditions[index], file.enum_annotations)
                if functions.lookup.module_resolution_work_exhausted:
                    proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "qualified source rewriting exceeded its shared source-work bound", "module-call-resolution-work", functions.lookup.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
            postconditions.extend(proof_unfolded_ensures(parameters, body, return_type, file.top_decls, &report.source_types.source_effect_index.work.implicit_effect_work)) if postconditions.count == 0
            if proof_structural_typed_operator_contracts_have_overload(signature_requires, parameters, position.line, report, caller_module, caller_declaration_line != 0) or proof_structural_typed_operator_contracts_have_overload(signature_ensures, parameters, position.line, report, caller_module, caller_declaration_line != 0):
                report.proof_obligation(false)
                proof_add_finding(report, "source-operator-unsupported", position.line, function_name, "signature contract contains operator dispatch that is not modeled by source proof admission")
                return
            for contract in signature_requires |parameters, report, position, caller_module, caller_declaration_line|:
                if proof_source_expression_has_unsafe_runtime_index(contract, parameters, report, 0, [], position.line, caller_module, caller_declaration_line != 0):
                    report.proof_obligation(false)
                    proof_add_finding(report, "source-operator-unsupported", Ast::expr_pos(contract).line, function_name, "signature contract contains indexing dispatch that is not modeled by source proof admission")
                    return
            for contract in signature_ensures |parameters, report, position, caller_module, caller_declaration_line|:
                if proof_source_expression_has_unsafe_runtime_index(contract, parameters, report, 0, [], position.line, caller_module, caller_declaration_line != 0):
                    report.proof_obligation(false)
                    proof_add_finding(report, "source-operator-unsupported", Ast::expr_pos(contract).line, function_name, "signature contract contains indexing dispatch that is not modeled by source proof admission")
                    return
            contract_caller_names: mutable darray[sview] = []
            for parameter in parameters |contract_caller_names|:
                contract_caller_names.push(parameter.name)
            proof_check_logical_contract_calls(body, functions, report, function_name, file.enum_annotations, contract_caller_names)
            proof_check_contract_placement(body, PROOF_CONTRACT_PLACE_FUNCTION, report, function_name)
            for signature_requirement in signature_requires |report, function_name, position|:
                if proof_expr_has_move(signature_requirement):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-resource-unsupported", position.line, function_name, "logical contracts may not perform ownership transfers")
                elif not proof_logical_contract_supported(signature_requirement, file.enum_annotations, functions):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "logical contract uses an unsupported expression form")
                elif proof_source_expression_has_overloaded_operator(signature_requirement, report.source.source_primitive_operator_mask, 0):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "logical contracts may use only operators with kernel-modeled primitive semantics")
                elif proof_expr_has_executable_call(signature_requirement) and (proof_expression_has_opaque_callable_call(signature_requirement, functions, contract_caller_names, 0) or proof_fact_expression_has_fresh_runtime_value(report, signature_requirement) or not proof_contract_calls_are_pure(signature_requirement, functions)):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-call-unsupported", position.line, function_name, "logical contracts may use old(...) or calls to verified total pure functions")
            for signature_ensure in signature_ensures |report, function_name, position|:
                if proof_expr_has_move(signature_ensure):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-resource-unsupported", position.line, function_name, "logical contracts may not perform ownership transfers")
                elif not proof_logical_contract_supported(signature_ensure, file.enum_annotations, functions):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "logical contract uses an unsupported expression form")
                elif proof_source_expression_has_overloaded_operator(signature_ensure, report.source.source_primitive_operator_mask, 0):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "logical contracts may use only operators with kernel-modeled primitive semantics")
                elif proof_expr_has_executable_call(signature_ensure) and (proof_expression_has_opaque_callable_call(signature_ensure, functions, contract_caller_names, 0) or proof_fact_expression_has_fresh_runtime_value(report, signature_ensure) or not proof_contract_calls_are_pure(signature_ensure, functions)):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-call-unsupported", position.line, function_name, "logical contracts may use old(...) or calls to verified total pure functions")
            names: mutable darray[sview] = []
            values: mutable darray[Ast::Expr] = []
            frame_parameters: mutable darray[sview] = []
            fixed_names: mutable darray[Ast::Expr] = []
            fixed_extents: mutable darray[i64] = []
            extent_constants: mutable darray[sview] = []
            fixed_budget: mutable usize = PROOF_FIXED_PLACE_BUDGET
            for parameter in parameters |names, values, fixed_names, fixed_extents, extent_constants, fixed_budget|:
                names.push(parameter.name)
                values.push(Ast::Expr.Ident(parameter.name, position))
                frame_parameters.push(parameter.name)
                fixed_before: usize = fixed_names.count
                proof_collect_fixed_array_places_with_work(Ast::Expr.Ident(parameter.name, position), parameter.type_expression, report.source.source_declarations, &fixed_names, &fixed_extents, &extent_constants, 0, &fixed_budget, &report.source_types.source_effect_index.work.implicit_effect_work)
                if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    report.proof_obligation(false)
                    proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "fixed-array place collection exceeded its shared source-work budget", "fixed-array-place-collection-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
                # A reference to a single scalar is a one-element place, so `x[0]` reads and writes it.
                scalar_reference: (known: bool, target: Ast::Expr) = proof_scalar_reference_target_type_with_work(parameter.type_expression, report.source.source_declarations, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                # Scalar-reference entries use the remaining collection visits and the global
                # entry cap; they cannot grow a parameter-sized vector outside either bound.
                if fixed_names.count == fixed_before and scalar_reference.known and fixed_budget > 0 and fixed_names.count < PROOF_FIXED_PLACE_ENTRY_LIMIT:
                    fixed_names.push(Ast::Expr.Ident(parameter.name, position))
                    fixed_extents.push(1)
                    fixed_budget <- fixed_budget - 1
            old_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
            proof_initialize_old_parameter_values_with_work(parameters, &old_values, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, position.line, position.offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, position, &report.source_types.source_effect_index.work.implicit_effect_work)
            changes: mutable darray[ProofFramePlace] = proof_frame_body_places(body, "changes")
            preserves: mutable darray[ProofFramePlace] = proof_frame_body_places(body, "preserves")
            header_changes: mutable darray[ProofFramePlace] = []
            header_preserves: mutable darray[ProofFramePlace] = []
            proof_frame_collect_annotations(file, functions.type_indexes.frame_annotation_index, function_name, &header_changes, &header_preserves)
            changes.extend(header_changes)
            preserves.extend(header_preserves)
            if not proof_emit_prepared_frame_events(report, function_name, position.line, position.offset):
                proof_check_frame_specs(body, changes, preserves, frame_parameters, report, function_name)
                proof_check_header_frame_specs(header_changes, header_preserves, frame_parameters, report, function_name)
            facts: mutable darray[Ast::Expr] = []
            # Certificate construction may use only facts introduced during this function. The
            # report keeps older traces for replay and provenance, but they are not part of this
            # function's symbolic context.
            report.analysis_1.traces.active_start <- report.analysis_1.traces.records.count
            report.aliases.aliased_names.clear()
            report.aliases.aliased_owner <- function_name
            report.analysis_1.type_bounds.seen.clear()
            report.analysis_1.type_bounds.seen_hashes.clear()
            report.analysis_1.type_bounds.owner <- function_name
            report.threading.rebind_symbols <- 0
            report.threading.threaded_symbols.clear()
            report.threading.value_thread_site <- false
            report.analysis_2.scalar_witness_facts <- 0
            for postcondition in postconditions |facts, report, position, function_name|:
                proof_add_qualified_enum_member_witnesses(postcondition, facts, report, position.line, position.offset.usize(), function_name, caller_module, functions.lookup.module_aliases, 0)
            report.analysis_1.budgets.frame_call_steps <- 0
            report.analysis_1.budgets.frame_call_source_work <- 0
            report.analysis_1.budgets.frame_call_reported <- false
            report.analysis_1.budgets.index_safety_source_work <- 0
            report.analysis_1.budgets.index_safety_reported <- false
            report.analysis_1.budgets.index_safety_solver_work <- 0
            report.analysis_1.budgets.index_safety_tactic_preflight_work <- 0
            report.analysis_1.budgets.alias_transfer_tactic_preflight_work <- 0
            report.analysis_1.budgets.alias_transfer_tactic_reported <- false
            report.analysis_1.budgets.resource_steps <- 0
            report.analysis_1.budgets.resource_reported <- false
            report.analysis_1.budgets.resource_pattern_work <- 0
            report.analysis_1.budgets.resource_pattern_reported <- false
            report.analysis_1.budgets.return_steps <- 0
            report.analysis_1.budgets.return_step_budget <- proof_return_analysis_step_budget(function_name, body.count)
            report.analysis_1.budgets.return_reported <- false
            report.analysis_1.budgets.return_source_work <- 0
            report.analysis_1.budgets.return_source_reported <- false
            report.analysis_1.budgets.assert_by_source_work <- 0
            report.analysis_1.budgets.assert_by_source_reported <- false
            # Share bounded headroom with medium functions that reuse a small set of call summaries.
            call_target_count: usize = proof_return_analysis_call_target_count(functions, function_index) if function_index < functions.lookup.names.count else proof_return_analysis_lemma_call_target_count(functions, body, parameters, signature_requires, signature_ensures)
            report.analysis_1.budgets.return_fact_state_budget <- proof_return_analysis_fact_state_budget(
                function_name, body.count, parameters.count, call_target_count, proof_return_analysis_call_summary_body_count(body)
            )
            # A mutable global is a place any callee can reach without being handed anything, so a
            # lend could be stored there and outlive its call. The confinement rule is withdrawn
            # from the whole program as soon as one is declared, the same way the shared-extent
            # rule below is.
            frame_has_mutable_global: mutable bool = false
            for annotation in file.enum_annotations |frame_has_mutable_global|:
                frame_has_mutable_global <- true if annotation.name == "__global_mutable"
            # This is the frame-wide question -- can a callee reach this binding *later* -- so a
            # lend that cannot outlive its own call does not belong in the answer. The loop-entry
            # and captured-block walks ask whether the body can change the binding while it runs,
            # and a confined lend still writes during its call, so they collect without it.
            proof_collect_value_collections(body, parameters, report)
            proof_collect_aliased_names(body, functions, &report.aliases.aliased_names, false, report.aliases.value_collection_names)
            proof_seed_closed_record_entry(body, parameters, names, frame_parameters, &old_values, functions, report, function_name, position)
            report.aliases.escaping_names.clear()
            proof_collect_aliased_names(body, functions, &report.aliases.escaping_names, not frame_has_mutable_global, report.aliases.value_collection_names)
            proof_record_shared_borrows(parameters, position.line, position.offset, report.source_types.source_generic_owner_params_valid, frame_has_mutable_global, report)
            report.aliases.local_extent_names.clear()
            report.aliases.value_binding_names.clear()
            report.aliases.reference_local_names.clear()
            # A parameter passed by value is this frame's own storage only when its type contains
            # neither a reference nor a borrowed view. An aggregate containing either still
            # reaches external storage, which an unrelated callee may mutate through another
            # path. Such a root must not justify call-stable field/count facts.
            for parameter in parameters |report|:
                parameter_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(parameter.type_expression, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, position.line, position.offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work)
                parameter_has_generic: bool = proof_resource_type_mentions_owner_generic_at_owner_with_work(parameter.type_expression, position.line, position.offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work, 0)
                local_value: bool = not parameter_has_generic and not parameter_markers.reference and proof_type_is_reference_free_with_work(parameter.type_expression, report.source.source_declarations, report.source.source_annotations, 0, &report.source_types.source_effect_index.work.implicit_effect_work) and not proof_type_contains_borrowed_view_with_work(parameter.type_expression, report.source.source_declarations, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                plain_value: bool = not parameter_has_generic and not parameter_markers.reference and proof_value_binding_type(parameter.type_expression, report, 0)
                report.aliases.local_extent_names.push(parameter.name) if local_value or plain_value
                report.aliases.value_binding_names.push(parameter.name) if plain_value
            for parameter in parameters |facts, report, function_name, position, caller_scope, caller_declaration_line|:
                parameter_has_generic: bool = proof_resource_type_mentions_owner_generic_at_owner_with_work(parameter.type_expression, position.line, position.offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work, 0)
                proof_add_required_reference_parameter_fact(facts, report, parameter, function_name, position, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index)
                unsigned_width: i64 = 0 if parameter_has_generic else proof_unsigned_type_width_index_with_work(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                proof_add_unsigned_binding_facts(facts, report, parameter.name, unsigned_width, position.line, function_name, position) if unsigned_width > 0
                signed_width: i64 = 0 if parameter_has_generic else proof_signed_type_width_index_with_work(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                proof_add_type_bound_fact(facts, report, proof_signed_type_marker(Ast::Expr.Ident(parameter.name, position), signed_width, position), position.line, function_name) if signed_width > 0
                proof_add_signed_upper_bound_fact(facts, report, parameter.name, signed_width, position.line, function_name, position)
                proof_add_primitive_operator_witnesses_in_scope_with_aliases(facts, report, Ast::Expr.Ident(parameter.name, position), parameter.type_expression, position, caller_scope, caller_module, functions.lookup.module_aliases, caller_declaration_line, position.offset.usize())
                # An unsigned width marker already witnesses a primitive scalar type, so only the
                # remaining scalar parameters need the narrower marker. Congruence consumes it to
                # establish that this name's operators cannot be a user protocol implementation.
                scalar_kind: i64 = 0 if parameter_has_generic else proof_scalar_type_kind_index(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                proof_add_scalar_type_witness(facts, report, proof_scalar_type_marker(parameter.name, position), position.line, function_name) if scalar_kind == 1 and unsigned_width <= 0
                # A unique zero-payload const-enum parameter supplies precise owner context for
                # shorthand values. The producer records only globally unambiguous variants;
                # replay checks the same member and owner identity in its source type environment.
                enum_owner: sview = proof_type_head_name_with_work(parameter.type_expression, report.source.source_declarations, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                if report.source_types.source_effect_index.work.implicit_effect_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT and scalar_kind == 1 and enum_owner != "" and not proof_scalar_primitive_type_name(enum_owner):
                    enum_counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(report.source.source_declarations, enum_owner, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                    if enum_counts.enums == 0 and enum_counts.const_enums == 1 and enum_counts.structs == 0:
                        shorthand_budget: mutable usize = PROOF_SCALAR_WITNESS_BUDGET
                        proof_add_const_enum_shorthand_witnesses(report.source.source_declarations, report.source.source_declarations, enum_owner, facts, report, position.line, function_name, position, &shorthand_budget, 0, &report.source_types.source_effect_index.work.implicit_effect_work)
                witness_budget: mutable usize = PROOF_SCALAR_WITNESS_BUDGET
                (proof_add_scalar_witnesses(facts, report, Ast::Expr.Ident(parameter.name, position), parameter.type_expression, position.line, function_name, position, caller_scope, caller_module, functions.lookup.module_aliases, caller_declaration_line, position.offset.usize(), &witness_budget, 0) can Global.Read) if scalar_kind != 1
            checked_body: mutable darray[Ast::Stmt] = []
            checked_body.extend(body)
            checked_body <- proof_qualify_function_enum_body_in_source_context(enum_context.declarations, enum_context.module_scope, functions, function_index, parameters, checked_body, file.enum_annotations, 0)
            if functions.lookup.module_resolution_work_exhausted:
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "qualified source rewriting exceeded its shared source-work bound", "module-call-resolution-work", functions.lookup.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            proof_add_qualified_enum_member_body_witnesses(checked_body, facts, report, position.line, position.offset.usize(), function_name, caller_module, functions.lookup.module_aliases, 0)
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "function-entry witness preparation exceeded its shared source-work budget", "function-entry-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            facts_before_constants: usize = facts.count
            proof_import_global_constant_facts(file, function_name, parameters, body, extent_constants, &names, &values, &facts, report, position, functions.type_indexes.type_audit_index)
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "global constant witness import exceeded its shared source-work budget", "global-constant-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            proof_import_global_mutable_array_facts(file, function_name, parameters, body, &fixed_names, &fixed_extents, &facts, report, position)
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "global mutable-array witness import exceeded its shared source-work budget", "global-array-witness-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            proof_import_qualified_constant_facts(file, function_name, parameters, &preconditions, &postconditions, &checked_body, &facts, report, position, functions, function_index)
            proof_resolve_global_constants_in_contracts(&preconditions, &postconditions, names, values, functions, function_index)
            # Counted before the preconditions, which are body facts and not constants.
            constant_facts: usize = facts.count - facts_before_constants if facts.count >= facts_before_constants else 0
            for requirement in preconditions |facts, names, values, report, function_name, position, functions, contract_caller_names|:
                proof_add_precondition_fact(facts, report, requirement, position.line, function_name, functions, contract_caller_names)
            # Resources are checked after entry facts so symbolic-index separation can be justified;
            # the state clears across mutations and calls, and replay checks each certificate.
            proof_seed_entry_counts(parameters, postconditions, &old_values, &facts, report, function_name, position)
            (proof_check_resource_safety(file, parameters, body, facts, report, function_name, position.line, position.offset, functions) can Global{Read,Write})
            proof_check_effect_containment(functions, report, function_name, position.line)
            lemma_steps: bool = is_lemma
            if lemma_steps:
                report.analysis_1.budgets.lemma_purity_source_work <- 0
                report.analysis_1.budgets.lemma_purity_source_reported <- false
                lemma_purity_work: mutable ProofBlockPurityWork = ProofBlockPurityWork{match_work_used: report.analysis_1.budgets.match_lowering_source_work}
                proof_check_lemma_purity(body, functions, lemmas, report, function_name, lemma_purity_work, 0)
                report.analysis_1.budgets.lemma_purity_source_work <- lemma_purity_work.used
                report.analysis_1.budgets.lemma_purity_source_reported <- lemma_purity_work.reported
                report.analysis_1.budgets.match_lowering_source_work <- lemma_purity_work.match_work_used
            empty_loop_invariants: mutable darray[Ast::Expr] = []
            # Each module constant buys four facts of headroom (its fact plus the comparisons it
            # feeds), up to the entry cap; the whole cap for every such body was ~3x slower.
            if report.analysis_1.budgets.return_fact_state_budget == PROOF_RETURN_FACT_STATE_BUDGET and facts.count > PROOF_RETURN_FACT_STATE_BUDGET and facts.count <= PROOF_RETURN_FACT_STATE_ENTRY_CAP:
                report.analysis_1.budgets.return_fact_state_budget <- PROOF_RETURN_FACT_STATE_ENTRY_CAP
            elif report.analysis_1.budgets.return_fact_state_budget == PROOF_RETURN_FACT_STATE_BUDGET and constant_facts > 0:
                headroom: usize = constant_facts * 4 + PROOF_RETURN_FACT_STATE_BUDGET
                report.analysis_1.budgets.return_fact_state_budget <- headroom if headroom < PROOF_RETURN_FACT_STATE_ENTRY_CAP else PROOF_RETURN_FACT_STATE_ENTRY_CAP
            function_flow: mutable ProofFlow = proof_empty_flow()
            # Bind signature ensures as well as body ensures. Their source obligation indices
            # follow the same body-then-signature order used by `postconditions` below.
            report.context.current_source_postcondition_count <- body_postcondition_count + signature_ensures.count
            report.context.current_source_postcondition_line <- position.line
            report.context.current_source_postcondition_name <- function_name
            report.context.current_source_postcondition_offset <- position.offset
            report.analysis_2.trace_owner_line <- position.line
            (proof_check_returns(checked_body, &names, &values, &facts, postconditions, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, function_name, lemma_steps, file.enum_annotations, 0, "", empty_loop_invariants, 0, &function_flow) can Global{Read,Write})
            report.analysis_2.trace_owner_line <- 0
            # A cutoff leaves the function body unsupported. Do not spend time attempting
            # postconditions on the conservative placeholder flow, and never infer that they
            # held merely because an abandoned branch was represented as terminal.
            if report.analysis_1.budgets.return_reported:
                function_flow.normal <- false
                function_flow.valid <- false
            if not function_flow.normal:
                for source_index in 0..<report.context.current_source_postcondition_count |source_index, report, position, function_name|:
                    found: mutable bool = false
                    for obligation in report.results.obligation_inventory |source_index, position, function_name, found|:
                        found <- true if obligation.source_kind == "postcondition" and obligation.source_line == position.line and obligation.source_name == function_name and obligation.source_function_offset == position.offset and obligation.source_obligation_index == source_index
                    report.proof_obligation_for_source(false, position.line, function_name, "postcondition", source_index) if not found
            if function_flow.normal:
                postcondition_index: mutable usize = 0
                for ensure in postconditions |facts, report, function_name, names, values, body_postcondition_count, postcondition_index, position|:
                    normal_goal: Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, values, old_values)
                    goal_has_call: bool = proof_frame_expression_has_call_with_work(normal_goal, report, function_name, position.line)
                    (proof_add_quantified_call_summaries(normal_goal, facts, functions, file.enum_annotations, report, function_name) can Global{Read,Write}) if goal_has_call
                    witness_complete: bool = not goal_has_call or proof_add_pure_call_witnesses(normal_goal, facts, functions, report, position.line, function_name, 0)
                    proven: bool = witness_complete and (proof_certify_goal_with_rule(facts, normal_goal, report, position.line, function_name, file.enum_annotations, "") can Global{Read,Write})
                    if postcondition_index < report.context.current_source_postcondition_count:
                        report.proof_obligation_for_source(proven, position.line, function_name, "postcondition", postcondition_index)
                    else:
                        report.proof_obligation(proven)
                    postcondition_index <- postcondition_index + 1
                    proof_add_goal_failure(report, "ensure-unproven", position.line, function_name, "normal completion does not establish ensure", facts, normal_goal) if not proven
            report.context.current_source_postcondition_count <- 0
            report.context.current_source_postcondition_line <- 0
            report.context.current_source_postcondition_name <- ""
            report.context.current_source_postcondition_offset <- 0

            report.analysis_1.frame_producer.active_name <- ""
