extend ElisaProof:
    private:
        const PROOF_TYPE_AUDIT_DEPTH_LIMIT: usize = 64
        const PROOF_TYPE_AUDIT_AMBIGUOUS_COUNT: usize = 2

        def proof_type_audit_charge_work(amount: usize, source_work: mutable usize&) -> bool:
            if not proof_replay_source_work_charge(amount, source_work):
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            true

        # Name de-duplication is quadratic in the number of distinct names, so charge every
        # length-aware comparison as well as the AST nodes visited by the collector.
        def proof_type_name_add(names: mutable darray[sview]&, name: sview, source_work: mutable usize&) -> bool:
            return true if name == ""
            return false if not proof_type_audit_charge_work(sview_len(name), source_work)
            for existing in names |name, source_work|:
                return false if not proof_type_audit_charge_work(sview_len(existing) + sview_len(name), source_work)
                return true if existing == name
            names.push(name)
            true

        def proof_type_scope_path_charge(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_charge_work(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return proof_type_audit_charge_work(sview_len(name), source_work)
                Ast::Expr.Scope(base, name, _):
                    return false if not proof_type_audit_charge_work(sview_len(name), source_work)
                    return proof_type_scope_path_charge(base, source_work, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_type_scope_path_charge(inner, source_work, depth + 1)
                _:
                    return false

        # Type expressions can be wide even when their recursive depth is small. Stop at the
        # first unknown form or exhausted source budget; the caller treats either as potentially
        # floating, and an over-budget counter makes the overall report incomplete.
        def proof_collect_type_names(expression: Ast::Expr, names: mutable darray[sview]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_charge_work(1, source_work)
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return false
                Ast::Expr.Ident(name, _):
                    return proof_type_name_add(names, name, source_work)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Field(inner, _, _):
                    return proof_collect_type_names(inner, names, source_work, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not proof_collect_type_names(left, names, source_work, depth + 1)
                    return proof_collect_type_names(right, names, source_work, depth + 1)
                Ast::Expr.Call(head, arguments, _, _) | Ast::Expr.IndexN(head, arguments, _):
                    return false if not proof_collect_type_names(head, names, source_work, depth + 1)
                    for argument in arguments |names, source_work, depth|:
                        return false if not proof_collect_type_names(argument, names, source_work, depth + 1)
                    return true
                Ast::Expr.Scope(base, scoped_name, _):
                    # The leaf names the qualified type; module-path segments are not type references.
                    return false if not proof_type_scope_path_charge(base, source_work, depth + 1)
                    return proof_type_name_add(names, scoped_name, source_work)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_collect_type_names(object, names, source_work, depth + 1)
                    return false if not proof_collect_type_names(low, names, source_work, depth + 1)
                    return proof_collect_type_names(high, names, source_work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |names, source_work, depth|:
                        return false if not proof_collect_type_names(element, names, source_work, depth + 1)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |names, source_work, depth|:
                        return false if not proof_collect_type_names(entry.key, names, source_work, depth + 1)
                        return false if not proof_collect_type_names(entry.value, names, source_work, depth + 1)
                    return true
                Ast::Expr.Construct(type_name, fields, _):
                    return false if not proof_collect_type_names(type_name, names, source_work, depth + 1)
                    for field in fields |names, source_work, depth|:
                        return false if not proof_collect_type_names(field.value, names, source_work, depth + 1)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_collect_type_names(base, names, source_work, depth + 1)
                    for field in fields |names, source_work, depth|:
                        return false if not proof_collect_type_names(field.value, names, source_work, depth + 1)
                    return true
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_collect_type_names(base, names, source_work, depth + 1)
                    return proof_collect_type_names(predicate, names, source_work, depth + 1)
                _:
                    return false

        def proof_type_audit_declaration_name(declaration: Ast::Decl) -> sview:
            match declaration:
                Ast::Decl.Alias(name, _, _):
                    return name
                Ast::Decl.Struct(name, _, _, _, _, _, _):
                    return name
                _:
                    return ""

        def proof_type_audit_collect_declarations(declarations: darray[Ast::Decl]&, index: mutable ProofTypeAuditIndex&, source_work: mutable usize&, depth: usize, root_level: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |index, source_work, depth|:
                return false if not proof_type_audit_charge_work(1, source_work)
                match declaration:
                    Ast::Decl.Alias(name, _, _):
                        return false if index.entries.count >= ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
                        return false if not proof_type_audit_charge_work(sview_len(name), source_work)
                        index.entries <- index.entries.push(ProofTypeAuditDeclaration{declaration: declaration, name_hash: proof_name_hash(name), root_level: root_level})
                    Ast::Decl.Struct(name, _, _, _, _, _, _):
                        return false if index.entries.count >= ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
                        return false if not proof_type_audit_charge_work(sview_len(name), source_work)
                        index.entries <- index.entries.push(ProofTypeAuditDeclaration{declaration: declaration, name_hash: proof_name_hash(name), root_level: root_level})
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_type_audit_collect_declarations(&body, index, source_work, depth + 1, false)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_type_audit_collect_declarations(&body, index, source_work, depth + 1, root_level)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        pass
            return true

        def proof_type_audit_index(declarations: darray[Ast::Decl]&, source_work: mutable usize&) -> ProofTypeAuditIndex can[Memory.Allocate, Abort.Panic]:
            index: mutable ProofTypeAuditIndex = ProofTypeAuditIndex{entries: [], bucket_heads: [], next_indices: [], complete: false}
            return index if not proof_type_audit_collect_declarations(declarations, &index, source_work, 0, true)
            count: usize = index.entries.count
            capacity: usize = proof_index_capacity(count)
            if capacity == 0:
                index.complete <- true
                return index
            return index if not proof_type_audit_charge_work(capacity, source_work)
            return index if not proof_type_audit_charge_work(count, source_work)
            index.bucket_heads.resize(capacity)
            bucket_sizes: mutable darray[usize] = []
            bucket_sizes.resize(capacity)
            index.next_indices.resize(count)
            for slot in 0..<capacity |slot, count, bucket_sizes|:
                index.bucket_heads[slot] <- count
                bucket_sizes[slot] <- 0
            for entry in 0..<count |entry, index, capacity, count, source_work|:
                return index if not proof_type_audit_charge_work(1, source_work)
                hash: u32 = index.entries[entry].name_hash
                slot: usize = (hash.i64() % capacity.i64()).usize()
                bucket_sizes[slot] <- bucket_sizes[slot] + 1
                return index if bucket_sizes[slot] > PROOF_INDEX_MAX_CHAIN
                index.next_indices[entry] <- index.bucket_heads[slot]
                index.bucket_heads[slot] <- entry
            index.complete <- true
            return index

        # Alias spelling must not hide a floating parameter from the proof-language gate.
        # Search every exact-name match in the collision-safe declaration index, charging the
        # expression walk, visited-name comparisons, and index probes to the shared source budget.
        def proof_type_may_contain_float_depth(expression: Ast::Expr, index: ProofTypeAuditIndex, enum_index: ProofEnumIndex, depth: usize, visited: mutable darray[sview]&, source_work: mutable usize&) -> bool:
            return true if not index.complete or depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            return true if index.entries.count != index.next_indices.count or index.bucket_heads.count != proof_index_capacity(index.entries.count)
            return true if not enum_index.complete or enum_index.names.count != enum_index.name_hashes.count or enum_index.names.count != enum_index.const_enums.count or enum_index.names.count != enum_index.declarations.count or enum_index.names.count != enum_index.next_indices.count
            return true if enum_index.bucket_heads.count != proof_index_capacity(enum_index.names.count)
            type_names: mutable darray[sview] = []
            return true if not proof_collect_type_names(expression, &type_names, source_work, 0)
            for referenced in type_names |source_work|:
                return true if not proof_type_audit_charge_work(1 + sview_len(referenced), source_work)
                return true if referenced in {"f16", "f32", "f64", "float"}
            for referenced in type_names |referenced, index, enum_index, depth, visited, source_work|:
                already_visited: mutable bool = false
                for seen in visited |referenced, source_work, already_visited|:
                    return true if not proof_type_audit_charge_work(1 + sview_len(seen) + sview_len(referenced), source_work)
                    already_visited <- true if seen == referenced
                continue if already_visited
                return true if not proof_type_audit_charge_work(sview_len(referenced), source_work)
                type_hash: u32 = proof_name_hash(referenced)
                type_entry: mutable usize = index.entries.count
                type_matches: mutable usize = 0
                if index.bucket_heads.count > 0:
                    type_slot: usize = (type_hash.i64() % index.bucket_heads.count.i64()).usize()
                    type_cursor: mutable usize = index.bucket_heads[type_slot]
                    type_steps: mutable usize = 0
                    return true if type_cursor > index.entries.count
                    while type_cursor < index.entries.count and type_steps < PROOF_INDEX_MAX_CHAIN |type_cursor, type_steps, type_hash, referenced, index, type_entry, type_matches, source_work|:
                        return true if not proof_type_audit_charge_work(1, source_work)
                        return true if type_cursor >= index.next_indices.count
                        audit_entry: ProofTypeAuditDeclaration = index.entries[type_cursor]
                        if audit_entry.name_hash == type_hash:
                            entry_name: sview = proof_type_audit_declaration_name(audit_entry.declaration)
                            return true if entry_name == "" or not proof_type_audit_charge_work(sview_len(entry_name) + sview_len(referenced), source_work)
                            if entry_name == referenced:
                                type_matches <- type_matches + 1
                                return true if type_matches > 1
                                type_entry <- type_cursor
                        next_entry: usize = index.next_indices[type_cursor]
                        return true if next_entry > index.entries.count
                        type_cursor <- next_entry
                        type_steps <- type_steps + 1
                    return true if type_cursor < index.entries.count

                enum_hash: u32 = proof_name_hash(referenced)
                enum_entry: mutable usize = enum_index.names.count
                enum_matches: mutable usize = 0
                if enum_index.bucket_heads.count > 0:
                    enum_slot: usize = (enum_hash.i64() % enum_index.bucket_heads.count.i64()).usize()
                    enum_cursor: mutable usize = enum_index.bucket_heads[enum_slot]
                    enum_steps: mutable usize = 0
                    return true if enum_cursor > enum_index.names.count
                    while enum_cursor < enum_index.names.count and enum_steps < PROOF_INDEX_MAX_CHAIN |enum_cursor, enum_steps, enum_hash, referenced, enum_index, enum_entry, enum_matches, source_work|:
                        return true if not proof_type_audit_charge_work(1, source_work)
                        return true if enum_cursor >= enum_index.next_indices.count or enum_cursor >= enum_index.declarations.count
                        if enum_index.name_hashes[enum_cursor] == enum_hash:
                            enum_name: sview = enum_index.names[enum_cursor]
                            return true if not proof_type_audit_charge_work(sview_len(enum_name) + sview_len(referenced), source_work)
                            if enum_name == referenced:
                                enum_matches <- enum_matches + 1
                                return true if enum_matches > 1
                                enum_entry <- enum_cursor
                        next_entry: usize = enum_index.next_indices[enum_cursor]
                        return true if next_entry > enum_index.names.count
                        enum_cursor <- next_entry
                        enum_steps <- enum_steps + 1
                    return true if enum_cursor < enum_index.names.count

                return true if type_matches + enum_matches > 1
                visited_count: usize = visited.count
                return true if not proof_type_audit_charge_work(1, source_work)
                visited.push(referenced)
                if type_matches == 1:
                    type_declaration: Ast::Decl = index.entries[type_entry].declaration
                    match type_declaration:
                        Ast::Decl.Alias(_, target, _):
                            if proof_type_may_contain_float_depth(target, index, enum_index, depth + 1, visited, source_work):
                                return true
                        Ast::Decl.Struct(_, fields, _, _, _, _, _):
                            for field in fields |index, enum_index, depth, visited, source_work|:
                                return true if not proof_type_audit_charge_work(1, source_work)
                                if proof_type_may_contain_float_depth(field.type_expression, index, enum_index, depth + 1, visited, source_work):
                                    return true
                        _:
                            return true
                if enum_matches == 1:
                    enum_declaration: Ast::Decl = enum_index.declarations[enum_entry]
                    match enum_declaration:
                        Ast::Decl.Enum(declared_name, variants, _, _, _):
                            return true if not proof_type_audit_work_charge(sview_len(declared_name) + sview_len(referenced), source_work) or declared_name != referenced
                            for variant in variants |index, enum_index, depth, visited, source_work|:
                                return true if not proof_type_audit_charge_work(1, source_work)
                                for field in variant.fields |index, enum_index, depth, visited, source_work|:
                                    return true if not proof_type_audit_charge_work(1, source_work)
                                    if proof_type_may_contain_float_depth(field.type_expression, index, enum_index, depth + 1, visited, source_work):
                                        return true
                        _:
                            return true
                visited.resize(visited_count)
            return false

        def proof_type_may_contain_float(expression: Ast::Expr, index: ProofTypeAuditIndex, enum_index: ProofEnumIndex, source_work: mutable usize&) -> bool:
            visited: mutable darray[sview] = []
            return proof_type_may_contain_float_depth(expression, index, enum_index, 0, visited, source_work)

        def proof_add_qualified_enum_member_body_witnesses(body: darray[Ast::Stmt]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, line: u32, owner: sview, caller_module: sview, module_aliases: ProofModuleAliasIndex&, depth: usize) -> void:
            return if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for statement in body |facts, report, line, owner, caller_module, module_aliases, depth|:
                return if not proof_type_audit_work_charge(1, &report.source_effect_index.implicit_effect_work)
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            proof_add_qualified_enum_member_witnesses(returned, facts, report, line, owner, caller_module, module_aliases, 0)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        proof_add_qualified_enum_member_witnesses(initializer, facts, report, line, owner, caller_module, module_aliases, 0)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_add_qualified_enum_member_witnesses(condition, facts, report, line, owner, caller_module, module_aliases, 0)
                        proof_add_qualified_enum_member_body_witnesses(then_body, facts, report, line, owner, caller_module, module_aliases, depth + 1)
                        proof_add_qualified_enum_member_body_witnesses(else_body, facts, report, line, owner, caller_module, module_aliases, depth + 1)
                    Ast::Stmt.While(condition, while_body, _):
                        proof_add_qualified_enum_member_witnesses(condition, facts, report, line, owner, caller_module, module_aliases, 0)
                        proof_add_qualified_enum_member_body_witnesses(while_body, facts, report, line, owner, caller_module, module_aliases, depth + 1)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        proof_add_qualified_enum_member_witnesses(iterable, facts, report, line, owner, caller_module, module_aliases, 0)
                        proof_add_qualified_enum_member_body_witnesses(for_body, facts, report, line, owner, caller_module, module_aliases, depth + 1)
                    Ast::Stmt.Assign(_, _, assigned, _):
                        proof_add_qualified_enum_member_witnesses(assigned, facts, report, line, owner, caller_module, module_aliases, 0)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        proof_add_qualified_enum_member_witnesses(expression, facts, report, line, owner, caller_module, module_aliases, 0)
                    _:
                        pass

        def proof_check_function(file: Ast::File&, function_name: sview, parameters: darray[Ast::ParamDecl]&, return_type: Ast::Expr?, body: darray[Ast::Stmt]&, position: Ast::Pos, is_lemma: bool, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> void can[Global.Read, Global.Write]:
            # The logical kernel currently models ordinary equality and integer arithmetic,
            # not IEEE NaN or rounding. Erasing a floating parameter to an untyped identifier
            # would make even x == x an unsound theorem. Stop before publishing obligations
            # that a source-bound tactic could otherwise repair under the wrong semantics.
            function_index: usize = proof_function_index_at_line(functions, function_name, position.line)
            caller_scope: darray[sview] = proof_global_constant_scope_with_module([], functions.lookup.owner_modules[function_index]) if function_index < functions.lookup.owner_modules.count else []
            caller_module: sview = functions.lookup.owner_modules[function_index] if function_index < functions.lookup.owner_modules.count else ""
            caller_declaration_line: u32 = position.line if function_index < functions.lookup.owner_modules.count else 0
            report.current_return_signed_width <- 0
            can Global.Write:
                proof_float_mode <- false
            # Source functions enter this checker through the direct API as well as the
            # structural-purity and termination passes. Reject operator dispatch that the
            # proof model cannot represent before publishing any obligations; in particular,
            # semantic analysis permits Named compound targets as possible overloads even
            # though the backend has no compound-operator dispatch path.
            unsupported_default_operator: mutable bool = proof_structural_typed_operator_defaults_have_overload(parameters, position.line, report)
            unsupported_default_index: mutable bool = false
            for parameter in parameters |report, unsupported_default_index|:
                unsupported_default_index <- true if parameter.has_default and proof_source_expression_has_unsafe_runtime_index(parameter.default_value, parameters, report, 0, [])
            if unsupported_default_operator or unsupported_default_index or proof_structural_typed_operator_statements_have_overload(body, parameters, position.line, report, 0) or proof_source_statements_have_unsafe_runtime_index(body, parameters, report, 0, []):
                report.proof_obligation(false)
                proof_add_finding(report, "source-operator-unsupported", position.line, function_name, "function body contains operator or indexing dispatch that is not modeled by source proof admission")
                return
            if return_type is declared_return_type:
                return_has_generic: bool = proof_resource_type_mentions_owner_generic_with_work(declared_return_type, position.line, report.source_generic_param_lines, report.source_generic_param_names, report.source_effect_index, report.source_generic_params_valid and report.source_generic_param_lines.count == report.source_generic_param_names.count, &report.source_effect_index.implicit_effect_work, 0)
                report.current_return_unsigned_width <- 0 if return_has_generic
                report.current_return_unsigned_width <- proof_unsigned_type_width_index_with_work(declared_return_type, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_effect_index.implicit_effect_work) if not return_has_generic
                report.current_return_signed_width <- 0 if return_has_generic
                report.current_return_signed_width <- proof_signed_type_width_index_with_work(declared_return_type, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_effect_index.implicit_effect_work) if not return_has_generic
            if report.current_return_unsigned_width < 0:
                report.proof_obligation(false)
                proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "return numeric type alias cannot be resolved uniquely")
                report.current_return_unsigned_width <- 0
                return
            parameter_start: usize = functions.parameters.metadata.param_starts[function_index] if function_index < functions.parameters.metadata.param_starts.count else functions.parameters.metadata.all_parameter_may_contain_float.count
            parameter_slot: mutable usize = 0
            for parameter in parameters |report, function_index, functions, parameter_start, parameter_slot, function_name, position|:
                parameter_has_generic: bool = proof_resource_type_mentions_owner_generic_with_work(parameter.type_expression, position.line, report.source_generic_param_lines, report.source_generic_param_names, report.source_effect_index, report.source_generic_params_valid and report.source_generic_param_lines.count == report.source_generic_param_names.count, &report.source_effect_index.implicit_effect_work, 0)
                if not parameter_has_generic and proof_unsigned_type_width_index_with_work(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_effect_index.implicit_effect_work) < 0:
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "parameter numeric type alias cannot be resolved uniquely")
                    return
                contains_float: mutable bool = false
                if function_index < functions.parameters.metadata.param_starts.count and parameter_start + parameter_slot < functions.parameters.metadata.all_parameter_may_contain_float.count:
                    contains_float <- functions.parameters.metadata.all_parameter_may_contain_float[parameter_start + parameter_slot]
                else:
                    contains_float <- proof_type_may_contain_float(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, &report.source_effect_index.implicit_effect_work)
                # Floating parameters switch the function to syntactic fact containment
                # (see proof_float_mode); no arithmetic, ordering or rewriting rule applies.
                if contains_float:
                    can Global.Write:
                        proof_float_mode <- true
                parameter_slot <- parameter_slot + 1
            preconditions: mutable darray[Ast::Expr] = proof_contracts(body, "requires")
            signature_contracts: (complete: bool, preconditions: darray[Ast::Expr], postconditions: darray[Ast::Expr]) = proof_signature_contracts_for_line_with_work(file, position.line, functions.lookup.module_resolution_work_used)
            functions.lookup.module_resolution_work_exhausted <- true if not signature_contracts.complete
            signature_requires: darray[Ast::Expr] = signature_contracts.preconditions
            preconditions.extend(signature_requires)
            postconditions: mutable darray[Ast::Expr] = proof_contracts(body, "ensure")
            body_postcondition_count: usize = postconditions.count
            signature_ensures: darray[Ast::Expr] = signature_contracts.postconditions
            postconditions.extend(signature_ensures)
            for index in 0..<postconditions.count |index, postconditions, file, functions, function_index|:
                postconditions[index] <- proof_qualify_function_enum_contract(file, functions, function_index, postconditions[index])
                if functions.lookup.module_resolution_work_exhausted:
                    proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "qualified source rewriting exceeded its shared source-work bound", "module-call-resolution-work", functions.lookup.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
            postconditions.extend(proof_unfolded_ensures(parameters, body, return_type, file.top_decls, &report.source_effect_index.implicit_effect_work)) if postconditions.count == 0
            if proof_structural_typed_operator_contracts_have_overload(signature_requires, parameters, position.line, report) or proof_structural_typed_operator_contracts_have_overload(signature_ensures, parameters, position.line, report):
                report.proof_obligation(false)
                proof_add_finding(report, "source-operator-unsupported", position.line, function_name, "signature contract contains operator dispatch that is not modeled by source proof admission")
                return
            for contract in signature_requires |parameters, report|:
                if proof_source_expression_has_unsafe_runtime_index(contract, parameters, report, 0, []):
                    report.proof_obligation(false)
                    proof_add_finding(report, "source-operator-unsupported", Ast::expr_pos(contract).line, function_name, "signature contract contains indexing dispatch that is not modeled by source proof admission")
                    return
            for contract in signature_ensures |parameters, report|:
                if proof_source_expression_has_unsafe_runtime_index(contract, parameters, report, 0, []):
                    report.proof_obligation(false)
                    proof_add_finding(report, "source-operator-unsupported", Ast::expr_pos(contract).line, function_name, "signature contract contains indexing dispatch that is not modeled by source proof admission")
                    return
            contract_caller_names: mutable darray[sview] = []
            for parameter in parameters |contract_caller_names|:
                contract_caller_names.push(parameter.name)
            proof_check_logical_contract_calls(body, functions, report, function_name, file.enum_annotations, contract_caller_names)
            proof_check_contract_placement(body, PROOF_CONTRACT_PLACE_FUNCTION, report, function_name)
            for signature_requirement in signature_requires |report, function_name, position|:
                if proof_expr_has_move(signature_requirement):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-resource-unsupported", position.line, function_name, "logical contracts may not perform ownership transfers")
                elif not proof_logical_contract_supported(signature_requirement, file.enum_annotations, functions):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "logical contract uses an unsupported expression form")
                elif proof_source_expression_has_overloaded_operator(signature_requirement, report.source_primitive_operator_mask, 0):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "logical contracts may use only operators with kernel-modeled primitive semantics")
                elif proof_expr_has_executable_call(signature_requirement) and (proof_expression_has_opaque_callable_call(signature_requirement, functions, contract_caller_names, 0) or proof_fact_expression_has_fresh_runtime_value(report, signature_requirement) or not proof_contract_calls_are_pure(signature_requirement, functions)):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-call-unsupported", position.line, function_name, "logical contracts may use old(...) or calls to verified total pure functions")
            for signature_ensure in signature_ensures |report, function_name, position|:
                if proof_expr_has_move(signature_ensure):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-resource-unsupported", position.line, function_name, "logical contracts may not perform ownership transfers")
                elif not proof_logical_contract_supported(signature_ensure, file.enum_annotations, functions):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "logical contract uses an unsupported expression form")
                elif proof_source_expression_has_overloaded_operator(signature_ensure, report.source_primitive_operator_mask, 0):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-expression-unsupported", position.line, function_name, "logical contracts may use only operators with kernel-modeled primitive semantics")
                elif proof_expr_has_executable_call(signature_ensure) and (proof_expression_has_opaque_callable_call(signature_ensure, functions, contract_caller_names, 0) or proof_fact_expression_has_fresh_runtime_value(report, signature_ensure) or not proof_contract_calls_are_pure(signature_ensure, functions)):
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-call-unsupported", position.line, function_name, "logical contracts may use old(...) or calls to verified total pure functions")
            names: mutable darray[sview] = []
            values: mutable darray[Ast::Expr] = []
            frame_parameters: mutable darray[sview] = []
            fixed_names: mutable darray[Ast::Expr] = []
            fixed_extents: mutable darray[i64] = []
            extent_constants: mutable darray[sview] = []
            fixed_budget: mutable usize = PROOF_FIXED_PLACE_BUDGET
            for parameter in parameters |names, values, fixed_names, fixed_extents, extent_constants, fixed_budget|:
                names.push(parameter.name)
                values.push(Ast::Expr.Ident(parameter.name, position))
                frame_parameters.push(parameter.name)
                fixed_before: usize = fixed_names.count
                proof_collect_fixed_array_places_with_work(Ast::Expr.Ident(parameter.name, position), parameter.type_expression, report.source_declarations, &fixed_names, &fixed_extents, &extent_constants, 0, &fixed_budget, &report.source_effect_index.implicit_effect_work)
                # A reference to a single scalar is a one-element place, so `x[0]` reads and writes it.
                scalar_reference: (known: bool, target: Ast::Expr) = proof_scalar_reference_target_type_with_work(parameter.type_expression, report.source_declarations, 0, &report.source_effect_index.implicit_effect_work)
                if fixed_names.count == fixed_before and scalar_reference.known:
                    fixed_names.push(Ast::Expr.Ident(parameter.name, position))
                    fixed_extents.push(1)
            old_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
            proof_initialize_old_parameter_values_with_work(parameters, &old_values, report.source_declarations, report.source_effect_index, report.source_generic_params_valid and report.source_generic_param_lines.count == report.source_generic_param_names.count, position, &report.source_effect_index.implicit_effect_work)
            changes: mutable darray[ProofFramePlace] = proof_frame_body_places(body, "changes")
            preserves: mutable darray[ProofFramePlace] = proof_frame_body_places(body, "preserves")
            header_changes: mutable darray[ProofFramePlace] = []
            header_preserves: mutable darray[ProofFramePlace] = []
            proof_frame_collect_annotations(file, functions.type_indexes.frame_annotation_index, function_name, &header_changes, &header_preserves)
            changes.extend(header_changes)
            preserves.extend(header_preserves)
            if not proof_emit_prepared_frame_events(report, function_name, position.line):
                proof_check_frame_specs(body, changes, preserves, frame_parameters, report, function_name)
                proof_check_header_frame_specs(header_changes, header_preserves, frame_parameters, report, function_name)
            facts: mutable darray[Ast::Expr] = []
            # Certificate construction may use only facts introduced during this function. The
            # report keeps older traces for replay and provenance, but they are not part of this
            # function's symbolic context.
            report.traces.active_start <- report.traces.records.count
            report.aliased_names.clear()
            report.aliased_owner <- function_name
            report.type_bounds.seen.clear()
            report.type_bounds.seen_hashes.clear()
            report.type_bounds.owner <- function_name
            report.rebind_symbols <- 0
            report.threaded_symbols.clear()
            report.value_thread_site <- false
            report.scalar_witness_facts <- 0
            for postcondition in postconditions |facts, report, position, function_name|:
                proof_add_qualified_enum_member_witnesses(postcondition, facts, report, position.line, function_name, caller_module, functions.lookup.module_aliases, 0)
            report.budgets.frame_call_steps <- 0
            report.budgets.frame_call_reported <- false
            report.budgets.resource_steps <- 0
            report.budgets.resource_reported <- false
            report.budgets.resource_pattern_work <- 0
            report.budgets.resource_pattern_reported <- false
            report.budgets.return_steps <- 0
            report.budgets.return_step_budget <- proof_return_analysis_step_budget(function_name, body.count)
            report.budgets.return_reported <- false
            report.budgets.return_source_work <- 0
            report.budgets.return_source_reported <- false
            report.budgets.assert_by_source_work <- 0
            report.budgets.assert_by_source_reported <- false
            # Share bounded headroom with medium functions that reuse a small set of call summaries.
            call_target_count: usize = proof_return_analysis_call_target_count(functions, function_index)
            report.budgets.return_fact_state_budget <- proof_return_analysis_fact_state_budget(
                function_name, body.count, parameters.count, call_target_count, proof_return_analysis_call_summary_body_count(body)
            )
            # A mutable global is a place any callee can reach without being handed anything, so a
            # lend could be stored there and outlive its call. The confinement rule is withdrawn
            # from the whole program as soon as one is declared, the same way the shared-extent
            # rule below is.
            frame_has_mutable_global: mutable bool = false
            for annotation in file.enum_annotations |frame_has_mutable_global|:
                frame_has_mutable_global <- true if annotation.name == "__global_mutable"
            # This is the frame-wide question -- can a callee reach this binding *later* -- so a
            # lend that cannot outlive its own call does not belong in the answer. The loop-entry
            # and captured-block walks ask whether the body can change the binding while it runs,
            # and a confined lend still writes during its call, so they collect without it.
            proof_collect_value_collections(body, parameters, report)
            proof_collect_aliased_names(body, functions, &report.aliased_names, false, report.value_collection_names)
            proof_seed_closed_record_entry(body, parameters, names, frame_parameters, &old_values, functions, report, function_name, position)
            report.escaping_names.clear()
            proof_collect_aliased_names(body, functions, &report.escaping_names, not frame_has_mutable_global, report.value_collection_names)
            proof_record_shared_borrows(parameters, position.line, frame_has_mutable_global, report)
            report.local_extent_names.clear()
            report.value_binding_names.clear()
            report.reference_local_names.clear()
            # A parameter passed by value is this frame's own storage only when its type contains
            # neither a reference nor a borrowed view. An aggregate containing either still
            # reaches external storage, which an unrelated callee may mutate through another
            # path. Such a root must not justify call-stable field/count facts.
            for parameter in parameters |report|:
                parameter_markers: (reference: bool, mutable_reference: bool, mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_with_work(parameter.type_expression, report.source_declarations, report.source_generic_param_lines, report.source_generic_param_names, position.line, report.source_effect_index, report.source_generic_params_valid and report.source_generic_param_lines.count == report.source_generic_param_names.count, &report.source_effect_index.implicit_effect_work)
                parameter_has_generic: bool = proof_resource_type_mentions_owner_generic_with_work(parameter.type_expression, position.line, report.source_generic_param_lines, report.source_generic_param_names, report.source_effect_index, report.source_generic_params_valid and report.source_generic_param_lines.count == report.source_generic_param_names.count, &report.source_effect_index.implicit_effect_work, 0)
                local_value: bool = not parameter_has_generic and not parameter_markers.reference and proof_type_is_reference_free_with_work(parameter.type_expression, report.source_declarations, report.source_annotations, 0, &report.source_effect_index.implicit_effect_work) and not proof_type_contains_borrowed_view_with_work(parameter.type_expression, report.source_declarations, 0, &report.source_effect_index.implicit_effect_work)
                plain_value: bool = not parameter_has_generic and not parameter_markers.reference and proof_value_binding_type(parameter.type_expression, report, 0)
                report.local_extent_names.push(parameter.name) if local_value or plain_value
                report.value_binding_names.push(parameter.name) if plain_value
            for parameter in parameters |facts, report, function_name, position, caller_scope, caller_declaration_line|:
                parameter_has_generic: bool = proof_resource_type_mentions_owner_generic_with_work(parameter.type_expression, position.line, report.source_generic_param_lines, report.source_generic_param_names, report.source_effect_index, report.source_generic_params_valid and report.source_generic_param_lines.count == report.source_generic_param_names.count, &report.source_effect_index.implicit_effect_work, 0)
                proof_add_required_reference_parameter_fact(facts, report, parameter, function_name, position, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index)
                unsigned_width: i64 = 0 if parameter_has_generic else proof_unsigned_type_width_index_with_work(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_effect_index.implicit_effect_work)
                proof_add_unsigned_binding_facts(facts, report, parameter.name, unsigned_width, position.line, function_name, position) if unsigned_width > 0
                signed_width: i64 = 0 if parameter_has_generic else proof_signed_type_width_index_with_work(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_effect_index.implicit_effect_work)
                proof_add_type_bound_fact(facts, report, proof_signed_type_marker(Ast::Expr.Ident(parameter.name, position), signed_width, position), position.line, function_name) if signed_width > 0
                proof_add_signed_upper_bound_fact(facts, report, parameter.name, signed_width, position.line, function_name, position)
                proof_add_primitive_operator_witnesses_in_scope_with_aliases(facts, report, Ast::Expr.Ident(parameter.name, position), parameter.type_expression, position, caller_scope, caller_module, functions.lookup.module_aliases, caller_declaration_line)
                # An unsigned width marker already witnesses a primitive scalar type, so only the
                # remaining scalar parameters need the narrower marker. Congruence consumes it to
                # establish that this name's operators cannot be a user protocol implementation.
                scalar_kind: i64 = 0 if parameter_has_generic else proof_scalar_type_kind_index(parameter.type_expression, functions.type_indexes.type_audit_index, functions.type_indexes.enum_index, 0, &report.source_effect_index.implicit_effect_work)
                proof_add_scalar_type_witness(facts, report, proof_scalar_type_marker(parameter.name, position), position.line, function_name) if scalar_kind == 1 and unsigned_width <= 0
                # A unique zero-payload const-enum parameter supplies precise owner context for
                # shorthand values. The producer records only globally unambiguous variants;
                # replay checks the same member and owner identity in its source type environment.
                enum_owner: sview = proof_type_head_name_with_work(parameter.type_expression, report.source_declarations, 0, &report.source_effect_index.implicit_effect_work)
                if report.source_effect_index.implicit_effect_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT and scalar_kind == 1 and enum_owner != "" and not proof_scalar_primitive_type_name(enum_owner):
                    enum_counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(report.source_declarations, enum_owner, 0, &report.source_effect_index.implicit_effect_work)
                    if enum_counts.enums == 0 and enum_counts.const_enums == 1 and enum_counts.structs == 0:
                        shorthand_budget: mutable usize = PROOF_SCALAR_WITNESS_BUDGET
                        proof_add_const_enum_shorthand_witnesses(report.source_declarations, report.source_declarations, enum_owner, facts, report, position.line, function_name, position, &shorthand_budget, 0, &report.source_effect_index.implicit_effect_work)
                witness_budget: mutable usize = PROOF_SCALAR_WITNESS_BUDGET
                (proof_add_scalar_witnesses(facts, report, Ast::Expr.Ident(parameter.name, position), parameter.type_expression, position.line, function_name, position, caller_scope, caller_module, functions.lookup.module_aliases, caller_declaration_line, &witness_budget, 0) can Global.Read) if scalar_kind != 1
            checked_body: mutable darray[Ast::Stmt] = []
            checked_body.extend(body)
            checked_body <- proof_qualify_function_enum_body(file, functions, function_index, checked_body, 0)
            if functions.lookup.module_resolution_work_exhausted:
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "qualified source rewriting exceeded its shared source-work bound", "module-call-resolution-work", functions.lookup.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            proof_add_qualified_enum_member_body_witnesses(checked_body, facts, report, position.line, function_name, caller_module, functions.lookup.module_aliases, 0)
            facts_before_constants: usize = facts.count
            proof_import_global_constant_facts(file, function_name, parameters, body, extent_constants, &names, &values, &facts, report, position, functions.type_indexes.type_audit_index)
            proof_import_global_mutable_array_facts(file, function_name, parameters, body, &fixed_names, &fixed_extents, &facts, report, position)
            proof_import_qualified_constant_facts(file, function_name, parameters, &preconditions, &postconditions, &checked_body, &facts, report, position, functions, function_index)
            proof_resolve_global_constants_in_contracts(&preconditions, &postconditions, names, values, functions, function_index)
            # Counted before the preconditions, which are body facts and not constants.
            constant_facts: usize = facts.count - facts_before_constants if facts.count >= facts_before_constants else 0
            for requirement in preconditions |facts, names, values, report, function_name, position, functions, contract_caller_names|:
                proof_add_precondition_fact(facts, report, requirement, position.line, function_name, functions, contract_caller_names)
            # Resources are checked after entry facts so symbolic-index separation can be justified;
            # the state clears across mutations and calls, and replay checks each certificate.
            proof_seed_entry_counts(parameters, postconditions, &old_values, &facts, report, function_name, position)
            (proof_check_resource_safety(file, parameters, body, facts, report, function_name, position.line, functions) can Global{Read,Write})
            proof_check_effect_containment(functions, report, function_name, position.line)
            lemma_steps: bool = is_lemma
            if lemma_steps:
                report.budgets.lemma_purity_source_work <- 0
                report.budgets.lemma_purity_source_reported <- false
                lemma_purity_work: mutable ProofBlockPurityWork = ProofBlockPurityWork{}
                proof_check_lemma_purity(body, functions, lemmas, report, function_name, lemma_purity_work, 0)
                report.budgets.lemma_purity_source_work <- lemma_purity_work.used
                report.budgets.lemma_purity_source_reported <- lemma_purity_work.reported
            empty_loop_invariants: mutable darray[Ast::Expr] = []
            # Each module constant buys four facts of headroom (its fact plus the comparisons it
            # feeds), up to the entry cap; the whole cap for every such body was ~3x slower.
            if report.budgets.return_fact_state_budget == PROOF_RETURN_FACT_STATE_BUDGET and facts.count > PROOF_RETURN_FACT_STATE_BUDGET and facts.count <= PROOF_RETURN_FACT_STATE_ENTRY_CAP:
                report.budgets.return_fact_state_budget <- PROOF_RETURN_FACT_STATE_ENTRY_CAP
            elif report.budgets.return_fact_state_budget == PROOF_RETURN_FACT_STATE_BUDGET and constant_facts > 0:
                headroom: usize = constant_facts * 4 + PROOF_RETURN_FACT_STATE_BUDGET
                report.budgets.return_fact_state_budget <- headroom if headroom < PROOF_RETURN_FACT_STATE_ENTRY_CAP else PROOF_RETURN_FACT_STATE_ENTRY_CAP
            function_flow: mutable ProofFlow = proof_empty_flow()
            report.current_source_postcondition_count <- body_postcondition_count
            report.current_source_postcondition_line <- position.line
            report.current_source_postcondition_name <- function_name
            report.trace_owner_line <- position.line
            (proof_check_returns(checked_body, &names, &values, &facts, postconditions, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, function_name, lemma_steps, file.enum_annotations, 0, "", empty_loop_invariants, 0, &function_flow) can Global{Read,Write})
            report.trace_owner_line <- 0
            report.current_source_postcondition_count <- 0
            report.current_source_postcondition_line <- 0
            report.current_source_postcondition_name <- ""
            # A cutoff leaves the function body unsupported. Do not spend time attempting
            # postconditions on the conservative placeholder flow, and never infer that they
            # held merely because an abandoned branch was represented as terminal.
            if report.budgets.return_reported:
                function_flow.normal <- false
                function_flow.valid <- false
            if not function_flow.normal:
                for source_index in 0..<body_postcondition_count |source_index, report, position, function_name|:
                    found: mutable bool = false
                    for obligation in report.obligation_inventory |source_index, position, function_name, found|:
                        found <- true if obligation.source_kind == "postcondition" and obligation.source_line == position.line and obligation.source_name == function_name and obligation.source_obligation_index == source_index
                    report.proof_obligation_for_source(false, position.line, function_name, "postcondition", source_index) if not found
            if function_flow.normal:
                postcondition_index: mutable usize = 0
                for ensure in postconditions |facts, report, function_name, names, values, body_postcondition_count, postcondition_index, position|:
                    normal_goal: Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, values, old_values)
                    (proof_add_quantified_call_summaries(normal_goal, facts, functions, file.enum_annotations, report, function_name) can Global{Read,Write}) if proof_expr_has_call(normal_goal)
                    proof_add_pure_call_witnesses(normal_goal, facts, functions, report, position.line, function_name, 0) if proof_expr_has_call(normal_goal)
                    proven: bool = (proof_certify_goal_with_rule(facts, normal_goal, report, position.line, function_name, file.enum_annotations, proof_quantifier_rule(ensure, file.enum_annotations)) can Global{Read,Write})
                    if postcondition_index < body_postcondition_count:
                        report.proof_obligation_for_source(proven, position.line, function_name, "postcondition", postcondition_index)
                    else:
                        report.proof_obligation(proven)
                    postcondition_index <- postcondition_index + 1
                    proof_add_goal_failure(report, "ensure-unproven", position.line, function_name, "normal completion does not establish ensure", facts, normal_goal) if not proven

            report.frame_producer.active_name <- ""
