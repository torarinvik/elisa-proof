extend ElisaProof:
    private:
        const PROOF_ASCII_DIGIT_ZERO: u8 = 48
        const PROOF_ASCII_DIGIT_NINE: u8 = 57
        const PROOF_ASCII_UPPER_A: u8 = 65
        const PROOF_ASCII_UPPER_Z: u8 = 90
        const PROOF_ASCII_LOWER_A: u8 = 97
        const PROOF_ASCII_LOWER_Z: u8 = 122
        const PROOF_ASCII_UNDERSCORE: u8 = 95
        const PROOF_ASCII_DECIMAL_POINT: u8 = 46
        const PROOF_PATTERN_DELIMITER_WIDTH: usize = 1
        const PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT: usize = 64
        const PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT: usize = 16384

        # Rebuild a variant path as the same AST shape the compiler parser uses for an `is`
        # test. Preserve `::` as Scope and `.` as Field; flattening a qualified scope into an
        # identifier creates a proposition that is textually similar but not logically equal.
        # Pattern paths are source-backed views, so slicing keeps their components borrowed.
        def proof_pattern_path_expression(path: sview, position: Ast::Pos) -> Ast::Expr:
            return Ast::Expr.Invalid if sview_len(path) == 0
            length: usize = sview_len(path)
            first_delimiter: mutable usize = length
            first_is_scope: mutable bool = false
            for index in 0..<length |index, path, first_delimiter, first_is_scope|:
                if sview_at(path, index) == PROOF_ASCII_DECIMAL_POINT:
                    first_delimiter <- index
                    break
                if sview_at(path, index) == ':' and index + 1 < length and sview_at(path, index + 1) == ':':
                    first_delimiter <- index
                    first_is_scope <- true
                    break
            # A lone variant name has lost its leading dot in the Pattern AST. Keep it as
            # ShorthandMember so owner-aware enum resolution can disambiguate its enum type.
            return Ast::Expr.ShorthandMember([path], position) if first_delimiter == length
            result: mutable Ast::Expr = Ast::Expr.Ident(string_view_slice(path, 0, first_delimiter.i64()), position)
            segment_start: mutable usize = first_delimiter + (2 if first_is_scope else PROOF_PATTERN_DELIMITER_WIDTH)
            delimiter_is_scope: mutable bool = first_is_scope
            while segment_start < length |segment_start, length, path, result, position, delimiter_is_scope|:
                segment_end: mutable usize = segment_start
                while segment_end < length and sview_at(path, segment_end) != PROOF_ASCII_DECIMAL_POINT and sview_at(path, segment_end) != ':' |segment_end, length, path|:
                    segment_end <- segment_end + 1
                segment: sview = string_view_slice(path, segment_start.i64(), segment_end.i64())
                result <- Ast::Expr.Scope(result, segment, position) if delimiter_is_scope
                result <- Ast::Expr.Field(result, segment, position) if not delimiter_is_scope
                break if segment_end == length
                delimiter_is_scope <- sview_at(path, segment_end) == ':'
                return Ast::Expr.Invalid if delimiter_is_scope and (segment_end + 1 >= length or sview_at(path, segment_end + 1) != ':')
                segment_start <- segment_end + (2 if delimiter_is_scope else PROOF_PATTERN_DELIMITER_WIDTH)
            return result

        # Pattern.Literal erases whether source text came from a string or scalar token.
        # Admit only the spelling subset that cannot collide with Boolean, numeric, or null
        # literals. Every other payload must wait for token-kind preservation.
        def proof_pattern_unambiguous_string_literal(text: sview) -> bool:
            reserved_literal_spelling: bool = when text:
                "true" | "false" | "null" -> true
                _ -> false
            return false if reserved_literal_spelling
            length: usize = sview_len(text)
            return false if length == 0
            for index in 0..<length |index, text|:
                character: u8 = sview_at(text, index)
                letter: bool = (character >= PROOF_ASCII_UPPER_A and character <= PROOF_ASCII_UPPER_Z) or (character >= PROOF_ASCII_LOWER_A and character <= PROOF_ASCII_LOWER_Z)
                identifier_character: bool = letter or character == PROOF_ASCII_UNDERSCORE or (index > 0 and character >= PROOF_ASCII_DIGIT_ZERO and character <= PROOF_ASCII_DIGIT_NINE)
                return false if not identifier_character
            return true

        # Produce modeled facts without type context. Pattern.Literal erases whether the source
        # token was a string or scalar, so no literal equality is admissible here. Ranges also
        # require authenticated width and signedness semantics.
        def proof_pattern_condition(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos) -> Ast::Expr?:
            match pattern:
                Ast::Pattern.As(_, inner):
                    return proof_pattern_condition(inner[0], scrutinee, position) if inner.count == 1
                Ast::Pattern.Variant(path, _):
                    target: Ast::Expr = proof_pattern_path_expression(path, position)
                    null return if target is Ast::Expr.Invalid
                    return Ast::Expr.Binary(scrutinee, TokenKind.Is, target, position)
                Ast::Pattern.Literal(_):
                    return null
                Ast::Pattern.Pin(_):
                    # Replay does not yet authenticate pin resolution or primitive equality.
                    return null
                Ast::Pattern.Range(_, _, _):
                    return null
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    conditions: mutable darray[Ast::Expr] = []
                    for option in options |conditions, scrutinee, position|:
                        condition: Ast::Expr? = proof_pattern_condition(option, scrutinee, position)
                        if condition is known_condition:
                            conditions.push(known_condition)
                        else:
                            return null
                    result: mutable Ast::Expr = conditions[0]
                    for index in 1..<conditions.count |index, conditions, result, position|:
                        result <- Ast::Expr.Binary(result, TokenKind.Or, conditions[index], position)
                    return result
                _:
                    pass
            return null

        # The shared local-declaration visitor supports the summary-wide budget. Seed its
        # counter so its reservation preflight and actual scan fit inside this narrower pattern
        # budget before allowing a negative (no-shadow) result to escape.
        def proof_pattern_source_body_declares_with_work(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, work: mutable usize&) -> bool:
            return true if work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
            remaining: usize = PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            seed: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - remaining
            bounded_work: mutable usize = seed
            if not proof_replay_source_touch_query_reserve(declarations, body, name, false, &bounded_work):
                work <- PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                return true
            reserved_work: usize = bounded_work - seed
            if reserved_work > remaining:
                work <- PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                return true
            work <- work + reserved_work
            return proof_replay_source_body_declares(declarations, body, name)

        # Only a bare builtin identifier, optionally parenthesized, is eligible as string
        # evidence. Do not collapse aliases, references, refinements, or indexed applications.
        def proof_pattern_direct_type_name(type_expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT
            match type_expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_pattern_direct_type_name(inner, depth + 1)
                _:
                    return ""

        def proof_pattern_type_name(type_expression: Ast::Expr) -> sview:
            return proof_pattern_direct_type_name(type_expression, 0)

        def proof_pattern_source_string_type_shadowed(declarations: darray[Ast::Decl]&, wanted: sview, work: mutable usize&, shadowed: mutable bool&, complete: mutable bool&, depth: usize) -> void:
            if depth >= PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT or work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT:
                complete <- false
                return
            for declaration in declarations |wanted, work, shadowed, complete, depth|:
                if work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT:
                    complete <- false
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Alias(name, _, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        if sview_len(name) > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work:
                            work <- PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                            complete <- false
                            return
                        work <- work + sview_len(name)
                        if name == wanted:
                            shadowed <- true
                            return
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_pattern_source_string_type_shadowed(nested, wanted, work, shadowed, complete, depth + 1)
                        return if shadowed or not complete
                    Ast::Decl.Import(_, _):
                        complete <- false
                        return
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        complete <- false
                        return
                    _:
                        complete <- false
                        return

        # Find a direct parameter's source type only when both the function and parameter
        # spelling are unique in the imported source tree. Ambiguous overloads, aliases not
        # handled by the source type projector, and an exhausted declaration walk fail closed.
        def proof_pattern_source_type_text_equal_with_work(left: sview, right: sview, work: mutable usize&) -> (complete: bool, equal: bool):
            return (false, false) if work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
            work <- work + 1
            left_length: usize = sview_len(left)
            return (false, false) if left_length > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            work <- work + left_length
            right_length: usize = sview_len(right)
            return (false, false) if right_length > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            work <- work + right_length
            return (true, left == right)

        def proof_pattern_source_formal_type_find(declarations: darray[Ast::Decl]&, function_name: sview, parameter: sview, found: mutable Ast::Expr&, function_matches: mutable usize&, parameter_matches: mutable usize&, work: mutable usize&, complete: mutable bool&, depth: usize) -> void:
            if depth >= PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT or work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT:
                complete <- false
                return
            for declaration in declarations |function_name, parameter, found, function_matches, parameter_matches, work, complete, depth|:
                if work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT:
                    complete <- false
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, _):
                        same_function: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(name, function_name, work)
                        if not same_function.complete:
                            complete <- false
                            return
                        if same_function.equal:
                            function_matches <- function_matches + 1
                            for candidate in parameters |parameter, found, parameter_matches, work, complete|:
                                same_parameter: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(candidate.name, parameter, work)
                                if not same_parameter.complete:
                                    complete <- false
                                    return
                                if same_parameter.equal:
                                    parameter_matches <- parameter_matches + 1
                                    found <- candidate.type_expression
                            # A same-named local, loop variable, or pattern binding shadows the
                            # formal for at least one possible match site. Treat any such body
                            # declaration, or an exhausted bounded scan, as unavailable type data.
                            complete <- false if proof_pattern_source_body_declares_with_work(declarations, body, parameter, work)
                    Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                        proof_pattern_source_formal_type_find(body, function_name, parameter, found, function_matches, parameter_matches, work, complete, depth + 1)
                    _:
                        pass

        def proof_pattern_source_formal_type(report: ProofReport&, function_name: sview, scrutinee: Ast::Expr, work: mutable usize&) -> Ast::Expr:
            parameter: sview = ""
            match proof_strip_parens(scrutinee):
                Ast::Expr.Ident(name, _):
                    parameter <- name
                _:
                    return Ast::Expr.Absent
            return Ast::Expr.Absent if parameter == "" or function_name == ""
            found: mutable Ast::Expr = Ast::Expr.Absent
            function_matches: mutable usize = 0
            parameter_matches: mutable usize = 0
            complete: mutable bool = true
            proof_pattern_source_formal_type_find(report.source_declarations, function_name, parameter, &found, &function_matches, &parameter_matches, work, &complete, 0)
            return Ast::Expr.Absent if not complete or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT or function_matches != 1 or parameter_matches != 1
            if proof_pattern_is_string_type(found):
                type_name: sview = proof_pattern_type_name(found)
                shadowed: mutable bool = false
                proof_pattern_source_string_type_shadowed(report.source_declarations, type_name, work, &shadowed, &complete, 0)
                return Ast::Expr.Absent if shadowed or not complete or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
            return found

        def proof_pattern_active_formal_type(report: ProofReport&, function_name: sview, source_scrutinee: Ast::Expr, symbolic_scrutinee: Ast::Expr, names: darray[sview]&) -> Ast::Expr:
            parameter: sview = ""
            work: mutable usize = 0
            match proof_strip_parens(source_scrutinee):
                Ast::Expr.Ident(name, _):
                    parameter <- name
                _:
                    return Ast::Expr.Absent
            match proof_strip_parens(symbolic_scrutinee):
                Ast::Expr.Ident(name, _):
                    same_symbol: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(name, parameter, work)
                    return Ast::Expr.Absent if not same_symbol.complete or not same_symbol.equal
                _:
                    return Ast::Expr.Absent
            active_bindings: mutable usize = 0
            for name in names |parameter, active_bindings, work|:
                same_binding: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(name, parameter, work)
                return Ast::Expr.Absent if not same_binding.complete
                active_bindings <- active_bindings + 1 if same_binding.equal
            return Ast::Expr.Absent if active_bindings != 1
            return proof_pattern_source_formal_type(report, function_name, source_scrutinee, &work)

        def proof_pattern_is_string_type(type_expression: Ast::Expr) -> bool:
            type_name: sview = proof_pattern_type_name(type_expression)
            return when type_name:
                # Only these representations have a string-match lowering in the pinned
                # compiler. `dstr` is a dynamic byte array and does not share that path.
                "sview" | "cstr" -> true
                _ -> false

        def proof_pattern_typed_literal_expression(text: sview, position: Ast::Pos, type_expression: Ast::Expr) -> Ast::Expr?:
            if proof_pattern_is_string_type(type_expression) and proof_pattern_unambiguous_string_literal(text):
                return Ast::Expr.StringLit(text, position)
            return null

        def proof_pattern_condition_typed(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, type_expression: Ast::Expr) -> Ast::Expr?:
            match pattern:
                Ast::Pattern.As(_, inner):
                    return proof_pattern_condition_typed(inner[0], scrutinee, position, type_expression) if inner.count == 1
                Ast::Pattern.Literal(text):
                    literal: Ast::Expr? = proof_pattern_typed_literal_expression(text, position, type_expression)
                    if literal is value:
                        return Ast::Expr.Binary(scrutinee, TokenKind.EqEq, value, position)
                Ast::Pattern.Range(_, _, _):
                    # Until authenticated source typing and signed/unsigned comparison
                    # semantics are shared with replay, even type-directed ranges fail closed.
                    return null
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    conditions: mutable darray[Ast::Expr] = []
                    for option in options |conditions, scrutinee, position, type_expression|:
                        condition: Ast::Expr? = proof_pattern_condition_typed(option, scrutinee, position, type_expression)
                        if condition is known_condition:
                            conditions.push(known_condition)
                        else:
                            return null
                    result: mutable Ast::Expr = conditions[0]
                    for index in 1..<conditions.count |index, conditions, result, position|:
                        result <- Ast::Expr.Binary(result, TokenKind.Or, conditions[index], position)
                    return result
                _:
                    return proof_pattern_condition(pattern, scrutinee, position)
            return null

        def proof_pattern_condition_using_type(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, type_expression: Ast::Expr) -> Ast::Expr?:
            return proof_pattern_condition(pattern, scrutinee, position) if type_expression is Ast::Expr.Absent
            return proof_pattern_condition_typed(pattern, scrutinee, position, type_expression)

        def proof_pattern_condition_exact_using_type(pattern: Ast::Pattern, type_expression: Ast::Expr) -> bool:
            return proof_pattern_condition_exact(pattern) if type_expression is Ast::Expr.Absent
            return proof_pattern_condition_exact_typed(pattern, type_expression)

        def proof_pattern_condition_with_source(pattern: Ast::Pattern, source_scrutinee: Ast::Expr, symbolic_scrutinee: Ast::Expr, position: Ast::Pos, report: ProofReport&, function_name: sview, names: darray[sview]&) -> Ast::Expr?:
            type_expression: Ast::Expr = proof_pattern_active_formal_type(report, function_name, source_scrutinee, symbolic_scrutinee, names)
            if not (type_expression is Ast::Expr.Absent):
                return proof_pattern_condition_typed(pattern, symbolic_scrutinee, position, type_expression)
            return proof_pattern_condition(pattern, symbolic_scrutinee, position)

        def proof_pattern_condition_exact_with_source(pattern: Ast::Pattern, source_scrutinee: Ast::Expr, symbolic_scrutinee: Ast::Expr, report: ProofReport&, function_name: sview, names: darray[sview]&) -> bool:
            type_expression: Ast::Expr = proof_pattern_active_formal_type(report, function_name, source_scrutinee, symbolic_scrutinee, names)
            if not (type_expression is Ast::Expr.Absent):
                return proof_pattern_condition_exact_typed(pattern, type_expression)
            return proof_pattern_condition_exact(pattern)

        def proof_pattern_condition_exact_typed(pattern: Ast::Pattern, type_expression: Ast::Expr) -> bool:
            match pattern:
                Ast::Pattern.As(_, inner):
                    return inner.count == 1 and proof_pattern_condition_exact_typed(inner[0], type_expression)
                Ast::Pattern.Variant(_, fields):
                    for field in fields |fields|:
                        return false if not proof_pattern_irrefutable(field)
                    return true
                Ast::Pattern.Literal(text):
                    return proof_pattern_is_string_type(type_expression) and proof_pattern_unambiguous_string_literal(text)
                Ast::Pattern.Range(_, _, _):
                    return false
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |options|:
                        return false if not proof_pattern_condition_exact_typed(option, type_expression)
                    return true
                _:
                    return false

        # OR-patterns are admitted only for closed alternatives. This gives the proof state one
        # precise disjunctive match fact while avoiding the unsound choice of a payload binding
        # that exists in only one alternative or has different projections in each alternative.
        def proof_pattern_or_closed(pattern: Ast::Pattern) -> bool:
            match pattern:
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Variant(_, fields):
                    return fields.count == 0
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |pattern|:
                        return false if not proof_pattern_or_closed(option)
                    return true
                _:
                    return false

        # Install lexical bindings introduced by a runtime pattern. A binder now receives a
        # symbolic projection of the matched scrutinee whenever the syntax identifies that
        # projection (`Struct{field: value}` / `Variant(field: value)`). This is a definitional
        # environment update, not an axiom: later substitution can only use the projection that
        # the compiler's pattern itself selected. Positional enum payloads remain conservative
        # because the lowered AST does not expose their stable field names here.
        def proof_bind_pattern(pattern: Ast::Pattern, position: Ast::Pos, source: Ast::Expr, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&) -> bool:
            match pattern:
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Pin(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Binding(binding):
                    return false if binding == ""
                    names.push(binding)
                    values.push(source)
                    return true
                Ast::Pattern.Rest(binding):
                    return true if binding == ""
                    names.push(binding)
                    values.push(Ast::Expr.Invalid)
                    return true
                Ast::Pattern.TypeBind(_, binding):
                    return false if binding == ""
                    names.push(binding)
                    values.push(source)
                    return true
                Ast::Pattern.As(binding, inner):
                    return false if binding == ""
                    names.push(binding)
                    values.push(source)
                    return false if inner.count != 1
                    return proof_bind_pattern(inner[0], position, source, names, values)
                Ast::Pattern.Variant(_, fields):
                    for field in fields |names, values, position, source|:
                        match field:
                            Ast::Pattern.Field(selector, inner):
                                return false if selector == "" or inner.count != 1
                                field_source: Ast::Expr = Ast::Expr.Field(source, selector, position)
                                return false if not proof_bind_pattern(inner[0], position, field_source, names, values)
                            Ast::Pattern.Wildcard:
                                pass
                            Ast::Pattern.Binding(binding):
                                # The payload ordinal-to-field map is not carried by this
                                # compiler AST layer. Keep the binder in lexical scope for the
                                # structural-recursion checker, but leave its value opaque so it
                                # cannot be mistaken for the whole enum or an invented field.
                                return false if binding == ""
                                names.push(binding)
                                values.push(Ast::Expr.Invalid)
                            _:
                                # Positional variant payloads need the compiler's lowered
                                # ordinal-to-field map; guessing a field name would be unsound.
                                return false
                    return true
                Ast::Pattern.Struct(_, fields):
                    for field in fields |names, values, position, source|:
                        match field:
                            Ast::Pattern.Field(selector, inner):
                                return false if selector == "" or inner.count != 1
                                field_source: Ast::Expr = Ast::Expr.Field(source, selector, position)
                                return false if not proof_bind_pattern(inner[0], position, field_source, names, values)
                            Ast::Pattern.Binding(binding):
                                return false if binding == ""
                                names.push(binding)
                                values.push(Ast::Expr.Field(source, binding, position))
                            Ast::Pattern.Wildcard:
                                pass
                            _:
                                return false
                    return true
                Ast::Pattern.Field(_, inner):
                    return false if inner.count != 1
                    return proof_bind_pattern(inner[0], position, source, names, values)
                Ast::Pattern.Tuple(elements):
                    for index in 0..<elements.count |index, elements, names, values, position, source|:
                        element_source: Ast::Expr = Ast::Expr.Index(source, Ast::Expr.IntLit(index.i64(), position), position)
                        return false if not proof_bind_pattern(elements[index], position, element_source, names, values)
                    return true
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |position|:
                        return false if not proof_pattern_or_closed(option)
                    return true
                Ast::Pattern.Other(_):
                    return false

