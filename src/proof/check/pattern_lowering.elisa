extend ElisaProof:
    private:
        const PROOF_ASCII_DIGIT_ZERO: u8 = 48
        const PROOF_ASCII_DIGIT_NINE: u8 = 57
        const PROOF_ASCII_UPPER_A: u8 = 65
        const PROOF_ASCII_UPPER_Z: u8 = 90
        const PROOF_ASCII_LOWER_A: u8 = 97
        const PROOF_ASCII_LOWER_Z: u8 = 122
        const PROOF_ASCII_UNDERSCORE: u8 = 95
        const PROOF_ASCII_DECIMAL_POINT: u8 = 46
        const PROOF_ASCII_SINGLE_QUOTE: u8 = 39
        const PROOF_ASCII_BACKSLASH: u8 = 92
        const PROOF_PATTERN_DELIMITER_WIDTH: usize = 1
        const PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT: usize = 64
        const PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
        const PROOF_PATTERN_STRING_LITERAL_SCAN_LIMIT: usize = 16384

        # Rebuild a variant path as the same AST shape the compiler parser uses for an `is`
        # test. Preserve `::` as Scope and `.` as Field; flattening a qualified scope into an
        # identifier creates a proposition that is textually similar but not logically equal.
        # Pattern paths are source-backed views, so slicing keeps their components borrowed.
        def proof_pattern_path_expression(path: sview, position: Ast::Pos) -> Ast::Expr:
            return Ast::Expr.Invalid if sview_len(path) == 0
            length: usize = sview_len(path)
            return Ast::Expr.Invalid if length > PROOF_PATTERN_WALK_WORK_LIMIT
            first_delimiter: mutable usize = length
            first_is_scope: mutable bool = false
            for index in 0..<length |index, path, first_delimiter, first_is_scope|:
                if sview_at(path, index) == PROOF_ASCII_DECIMAL_POINT:
                    first_delimiter <- index
                    break
                if sview_at(path, index) == ':' and index + 1 < length and sview_at(path, index + 1) == ':':
                    first_delimiter <- index
                    first_is_scope <- true
                    break
            # A lone variant name has lost its leading dot in the Pattern AST. Keep it as
            # ShorthandMember so owner-aware enum resolution can disambiguate its enum type.
            return Ast::Expr.ShorthandMember([path], position) if first_delimiter == length
            result: mutable Ast::Expr = Ast::Expr.Ident(string_view_slice(path, 0, first_delimiter.i64()), position)
            segment_start: mutable usize = first_delimiter + (2 if first_is_scope else PROOF_PATTERN_DELIMITER_WIDTH)
            delimiter_is_scope: mutable bool = first_is_scope
            while segment_start < length |segment_start, length, path, result, position, delimiter_is_scope|:
                segment_end: mutable usize = segment_start
                while segment_end < length and sview_at(path, segment_end) != PROOF_ASCII_DECIMAL_POINT and sview_at(path, segment_end) != ':' |segment_end, length, path|:
                    segment_end <- segment_end + 1
                segment: sview = string_view_slice(path, segment_start.i64(), segment_end.i64())
                result <- Ast::Expr.Scope(result, segment, position) if delimiter_is_scope
                result <- Ast::Expr.Field(result, segment, position) if not delimiter_is_scope
                break if segment_end == length
                delimiter_is_scope <- sview_at(path, segment_end) == ':'
                return Ast::Expr.Invalid if delimiter_is_scope and (segment_end + 1 >= length or sview_at(path, segment_end + 1) != ':')
                segment_start <- segment_end + (2 if delimiter_is_scope else PROOF_PATTERN_DELIMITER_WIDTH)
            return result

        # Pattern.Literal erases token kind. Under an authenticated string scrutinee, the
        # compiler's sview/cstr lowering compares the retained literal bytes as string content,
        # including digit-leading and keyword-like text. Keep escapes/non-ASCII/control bytes
        # out until their source decoding is authenticated.
        def proof_pattern_charge_source_type_work(amount: usize, work: mutable usize&) -> bool:
            return false if:
                work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                amount > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            work <- work + amount
            true
        def proof_pattern_unambiguous_string_literal_with_work(text: sview, work: mutable usize&) -> bool:
            length: usize = sview_len(text)
            # Refuse oversized literals before comparing or walking their attacker-controlled
            # contents, then charge every bounded scan against the report-wide pattern budget.
            return false if:
                length > PROOF_PATTERN_STRING_LITERAL_SCAN_LIMIT
                not proof_pattern_charge_source_type_work(length * 4 + 1, work)
            return true if length == 0
            for index in 0..<length |index, text|:
                character: u8 = sview_at(text, index)
                return false if:
                    character < 32 or character > 126
                    character == 34 or character == PROOF_ASCII_BACKSLASH
            return true
        def proof_pattern_unambiguous_string_literal(text: sview) -> bool:
            work: mutable usize = 0
            proof_pattern_unambiguous_string_literal_with_work(text, &work)
        # Char patterns retain their surrounding quotes in the compiler AST. Keep the proof
        # subset to one printable ASCII byte or one explicitly supported single-byte escape;
        # multi-byte and unknown escapes wait for authenticated compiler literal decoding.
        def proof_pattern_unambiguous_char_literal(text: sview) -> bool:
            length: usize = sview_len(text)
            return false if:
                length < 3
                sview_at(text, 0) != PROOF_ASCII_SINGLE_QUOTE or sview_at(text, length - 1) != PROOF_ASCII_SINGLE_QUOTE
            interior_length: usize = length - 2
            if interior_length == 1:
                character: u8 = sview_at(text, 1)
                return character >= 32 and character <= 126 and character != PROOF_ASCII_SINGLE_QUOTE and character != PROOF_ASCII_BACKSLASH
            if interior_length == 2 and sview_at(text, 1) == PROOF_ASCII_BACKSLASH:
                escaped: u8 = sview_at(text, 2)
                return escaped == 110 or escaped == 116 or escaped == 114 or escaped == PROOF_ASCII_DIGIT_ZERO or escaped == PROOF_ASCII_BACKSLASH or escaped == PROOF_ASCII_SINGLE_QUOTE
            return false

        # Produce modeled facts without type context. Pattern.Literal erases whether the source
        # token was a string or scalar, so no literal equality is admissible here. Ranges also
        # require authenticated width and signedness semantics.
        def proof_pattern_condition(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos) -> Ast::Expr?:
            work: mutable usize = 0
            return proof_pattern_condition_depth(pattern, scrutinee, position, 0, &work)

        def proof_pattern_condition_depth(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, depth: usize, work: mutable usize&) -> Ast::Expr?:
            return null if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.As(_, inner):
                    return proof_pattern_condition_depth(inner[0], scrutinee, position, depth + 1, work) if inner.count == 1
                Ast::Pattern.Variant(path, _):
                    target: Ast::Expr = proof_pattern_path_expression(path, position)
                    null return if target is Ast::Expr.Invalid
                    return Ast::Expr.Binary(scrutinee, TokenKind.Is, target, position)
                Ast::Pattern.Literal(_):
                    return null
                Ast::Pattern.Pin(_):
                    # Replay does not yet authenticate pin resolution or primitive equality.
                    return null
                Ast::Pattern.Range(_, _, _):
                    return null
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    conditions: mutable darray[Ast::Expr] = []
                    for option in options |conditions, scrutinee, position, depth, work|:
                        condition: Ast::Expr? = proof_pattern_condition_depth(option, scrutinee, position, depth + 1, work)
                        if condition is known_condition:
                            conditions.push(known_condition)
                        else:
                            return null
                    result: mutable Ast::Expr = conditions[0]
                    for index in 1..<conditions.count |index, conditions, result, position|:
                        result <- Ast::Expr.Binary(result, TokenKind.Or, conditions[index], position)
                    return result
                _:
                    pass
            return null

        # The shared local-declaration visitor supports the summary-wide budget. Seed its
        # counter so its reservation preflight and actual scan fit inside this narrower pattern
        # budget before allowing a negative (no-shadow) result to escape.
        def proof_pattern_source_body_declares_with_work(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, work: mutable usize&) -> bool:
            return true if work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
            remaining: usize = PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            seed: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - remaining
            bounded_work: mutable usize = seed
            if not proof_replay_source_touch_query_reserve(declarations, body, name, false, &bounded_work):
                work <- PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                return true
            reserved_work: usize = bounded_work - seed
            if reserved_work > remaining:
                work <- PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                return true
            work <- work + reserved_work
            return proof_replay_source_body_declares(declarations, body, name)

        # Only a bare builtin identifier, optionally parenthesized, is eligible as string or
        # character representation evidence. Do not collapse aliases, references, refinements,
        # or indexed applications.
        def proof_pattern_direct_type_name(type_expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT
            match type_expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_pattern_direct_type_name(inner, depth + 1)
                _:
                    return ""

        def proof_pattern_type_name(type_expression: Ast::Expr) -> sview:
            return proof_pattern_direct_type_name(type_expression, 0)

        def proof_pattern_source_type_text_equal_with_work(left: sview, right: sview, work: mutable usize&) -> (complete: bool, equal: bool):
            return (false, false) if work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
            work <- work + 1
            left_length: usize = sview_len(left)
            return (false, false) if left_length > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            work <- work + left_length
            right_length: usize = sview_len(right)
            return (false, false) if right_length > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            work <- work + right_length
            return (true, left == right)

        def proof_pattern_source_formal_type_find(declarations: darray[Ast::Decl]&, function_name: sview, parameter: sview, found: mutable Ast::Expr&, function_line: mutable u32&, function_offset: mutable usize&, function_module: mutable sview&, declaration_module: mutable sview&, module_path: mutable darray[sview]&, function_module_path: mutable darray[sview]&, function_matches: mutable usize&, parameter_matches: mutable usize&, work: mutable usize&, complete: mutable bool&, depth: usize) -> void:
            if depth >= PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT or work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT:
                complete <- false
                return
            for declaration in declarations |function_name, parameter, found, function_line, function_offset, function_module, declaration_module, module_path, function_module_path, function_matches, parameter_matches, work, complete, depth|:
                if work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT:
                    complete <- false
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, position):
                        same_function: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(name, function_name, work)
                        if not same_function.complete:
                            complete <- false
                            return
                        if same_function.equal:
                            function_matches <- function_matches + 1
                            function_line <- position.line
                            function_offset <- position.offset.usize()
                            declaration_module <- function_module
                            function_module_path.clear()
                            for module_segment in module_path |module_segment, function_module_path, work, complete|:
                                if not proof_pattern_charge_source_type_work(sview_len(module_segment), work):
                                    complete <- false
                                    return
                                function_module_path.push(module_segment)
                            matching_parameters: mutable usize = 0
                            for candidate in parameters |parameter, found, parameter_matches, matching_parameters, work, complete|:
                                same_parameter: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(candidate.name, parameter, work)
                                if not same_parameter.complete:
                                    complete <- false
                                    return
                                if same_parameter.equal:
                                    matching_parameters <- matching_parameters + 1
                                    parameter_matches <- parameter_matches + 1
                                    found <- candidate.type_expression
                            # A same-named local, loop variable, or pattern binding shadows the
                            # formal for at least one possible match site. Treat any such body
                            # declaration, or an exhausted bounded scan, as unavailable type data.
                            complete <- false if matching_parameters != 0 and proof_pattern_source_body_declares_with_work(declarations, body, parameter, work)
                    Ast::Decl.Module(module_name, body, _):
                        prior_module: sview = function_module
                        function_module <- module_name
                        module_bytes: usize = sview_len(module_name)
                        if work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT or module_bytes > (PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work) / 3:
                            complete <- false
                            return
                        if not proof_pattern_charge_source_type_work(module_bytes * 3 + module_path.count, work):
                            complete <- false
                            return
                        nested_path: darray[sview] = proof_global_constant_scope_with_module(module_path, module_name)
                        proof_pattern_source_formal_type_find(body, function_name, parameter, found, function_line, function_offset, function_module, declaration_module, nested_path, function_module_path, function_matches, parameter_matches, work, complete, depth + 1)
                        function_module <- prior_module
                    Ast::Decl.Scoped(body, _):
                        proof_pattern_source_formal_type_find(body, function_name, parameter, found, function_line, function_offset, function_module, declaration_module, module_path, function_module_path, function_matches, parameter_matches, work, complete, depth + 1)
                    _:
                        pass

        # A generic type binder may legally reuse a builtin spelling. Do not use that
        # spelling as representation evidence for a typed string or character pattern fact.
        def proof_pattern_source_generic_type_shadowed(report: mutable ProofReport&, declaration_line: u32, declaration_offset: usize, declaration_module: sview, wanted: sview, work: mutable usize&) -> (complete: bool, shadowed: bool):
            return (false, false) if:
                work >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                sview_len(wanted) >= PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            work <- work + 1 + sview_len(wanted)
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            generic: (complete: bool, count: usize) = proof_operator_enum_generic_identity_count_with_work(wanted, declaration_line, declaration_offset, declaration_module, report, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return (false, false) if not generic.complete or generic.count > 1
            return (true, generic.count == 1)

        # Check root declarations and declarations along the exact module path. Sibling module
        # names cannot shadow this formal's unqualified type spelling.
        def proof_pattern_source_builtin_name_shadowed(declarations: darray[Ast::Decl]&, wanted: sview, owner_path: darray[sview]&, current_path: mutable darray[sview]&, work: mutable usize&, depth: usize) -> (complete: bool, shadowed: bool):
            return (false, false) if depth >= PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT
            for declaration in declarations |wanted, owner_path, current_path, work, depth|:
                return (false, false) if not proof_pattern_charge_source_type_work(1, work)
                match declaration:
                    Ast::Decl.Alias(name, _, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        return (false, false) if:
                            not proof_pattern_charge_source_type_work(sview_len(name), work)
                            not proof_pattern_charge_source_type_work(sview_len(wanted), work)
                        return (true, true) if name == wanted
                    Ast::Decl.Module(module_name, nested, _):
                        module_bytes: usize = sview_len(module_name)
                        if work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT or module_bytes > (PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work) / 3:
                            return (false, false)
                        if not proof_pattern_charge_source_type_work(module_bytes * 3 + current_path.count, work):
                            return (false, false)
                        nested_path: darray[sview] = proof_global_constant_scope_with_module(current_path, module_name)
                        continue if nested_path.count > owner_path.count
                        path_matches: mutable bool = true
                        for index in 0..<nested_path.count |index, nested_path, owner_path, work, path_matches|:
                            if not proof_pattern_charge_source_type_work(sview_len(nested_path[index]) + sview_len(owner_path[index]), work):
                                return (false, false)
                            path_matches <- false if nested_path[index] != owner_path[index]
                        continue if not path_matches
                        nested_status: (complete: bool, shadowed: bool) = proof_pattern_source_builtin_name_shadowed(nested, wanted, owner_path, nested_path, work, depth + 1)
                        return nested_status if not nested_status.complete or nested_status.shadowed
                    Ast::Decl.Scoped(nested, _):
                        nested_status: (complete: bool, shadowed: bool) = proof_pattern_source_builtin_name_shadowed(nested, wanted, owner_path, current_path, work, depth + 1)
                        return nested_status if not nested_status.complete or nested_status.shadowed
                    Ast::Decl.Invalid:
                        return (false, false)
                    _:
                        pass
            return (true, false)

        # Qualified import scopes can be matched exactly. A simple module spelling may be
        # shared by siblings, so keep the conservative any-ancestor match for that case.
        def proof_pattern_source_import_scope_visible(owner_path: darray[sview]&, import_module: sview, work: mutable usize&) -> (complete: bool, visible: bool):
            if import_module == "":
                return (true, true)
            module_bytes: usize = sview_len(import_module)
            if work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT or module_bytes > (PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work) / 3:
                return (false, false)
            return (false, false) if not proof_pattern_charge_source_type_work(module_bytes * 3, work)
            import_scope: darray[sview] = proof_global_constant_scope_with_module([], import_module)
            if import_scope.count > 1:
                return (true, false) if owner_path.count < import_scope.count
                for index in 0..<import_scope.count |index, owner_path, import_scope, work|:
                    same_module: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(owner_path[index], import_scope[index], work)
                    return (false, false) if not same_module.complete
                    return (true, false) if not same_module.equal
                return (true, true)
            for segment in owner_path |segment, import_module, work|:
                same_module: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(segment, import_module, work)
                return (false, false) if not same_module.complete
                return (true, true) if same_module.equal
            (true, false)

        def proof_pattern_source_builtin_import_shadowed(annotations: darray[Ast::EnumAnnotation]&, wanted: sview, owner_path: darray[sview]&, work: mutable usize&) -> (complete: bool, shadowed: bool):
            for annotation in annotations |wanted, work|:
                return (false, false) if not proof_pattern_charge_source_type_work(1, work)
                return (false, false) if:
                    not proof_pattern_charge_source_type_work(sview_len(annotation.name), work)
                    not proof_pattern_charge_source_type_work(sview_len("__binding_wildcard_import"), work)
                if annotation.name == "__binding_wildcard_import":
                    wildcard_scope: (complete: bool, visible: bool) = proof_pattern_source_import_scope_visible(owner_path, annotation.module, work)
                    return (false, false) if not wildcard_scope.complete
                    return (false, false) if wildcard_scope.visible
                    continue
                return (false, false) if:
                    not proof_pattern_charge_source_type_work(sview_len(annotation.owner), work)
                    not proof_pattern_charge_source_type_work(sview_len("__from_member"), work)
                imported_name: sview = annotation.name if annotation.owner == "__from_member"
                return (false, false) if:
                    not proof_pattern_charge_source_type_work(sview_len(annotation.name), work)
                    not proof_pattern_charge_source_type_work(sview_len("__using_alias"), work)
                imported_name <- annotation.owner if annotation.name == "__using_alias"
                return (false, false) if:
                    not proof_pattern_charge_source_type_work(sview_len(annotation.name), work)
                    not proof_pattern_charge_source_type_work(sview_len("__using_member"), work)
                # __using_member is paired with __from_member at the same source token;
                # the latter carries the importer's module scope.
                return (false, false) if:
                    not proof_pattern_charge_source_type_work(sview_len(imported_name), work)
                    not proof_pattern_charge_source_type_work(sview_len(wanted), work)
                if imported_name != "" and imported_name == wanted:
                    imported_scope: (complete: bool, visible: bool) = proof_pattern_source_import_scope_visible(owner_path, annotation.module, work)
                    return (false, false) if not imported_scope.complete
                    return (true, true) if imported_scope.visible
            return (true, false)

        def proof_pattern_source_formal_type(report: ProofReport&, function_name: sview, scrutinee: Ast::Expr, work: mutable usize&) -> Ast::Expr:
            parameter: mutable sview = ""
            match proof_strip_parens(scrutinee):
                Ast::Expr.Ident(name, _):
                    parameter <- name
                _:
                    return Ast::Expr.Absent
            return Ast::Expr.Absent if parameter == "" or function_name == ""
            found: mutable Ast::Expr = Ast::Expr.Absent
            function_line: mutable u32 = 0
            function_offset: mutable usize = 0
            function_module: mutable sview = ""
            declaration_module: mutable sview = ""
            module_path: mutable darray[sview] = []
            function_module_path: mutable darray[sview] = []
            function_matches: mutable usize = 0
            parameter_matches: mutable usize = 0
            complete: mutable bool = true
            proof_pattern_source_formal_type_find(report.source.source_declarations, function_name, parameter, &found, &function_line, &function_offset, &function_module, &declaration_module, &module_path, &function_module_path, &function_matches, &parameter_matches, work, &complete, 0)
            return Ast::Expr.Absent if not complete or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT or function_matches != 1 or parameter_matches != 1
            if proof_pattern_is_string_type(found) or proof_pattern_is_char_type(found):
                type_name: sview = proof_pattern_type_name(found)
                generic_shadow: (complete: bool, shadowed: bool) = proof_pattern_source_generic_type_shadowed(report, function_line, function_offset, declaration_module, type_name, work)
                return Ast::Expr.Absent if not generic_shadow.complete or generic_shadow.shadowed or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                declaration_shadow: (complete: bool, shadowed: bool) = proof_pattern_source_builtin_name_shadowed(report.source.source_declarations, type_name, function_module_path, &module_path, work, 0)
                return Ast::Expr.Absent if not declaration_shadow.complete or declaration_shadow.shadowed
                import_shadow: (complete: bool, shadowed: bool) = proof_pattern_source_builtin_import_shadowed(report.source.source_annotations, type_name, function_module_path, work)
                return Ast::Expr.Absent if not import_shadow.complete or import_shadow.shadowed or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
            return found

        def proof_pattern_active_formal_type_with_work(report: ProofReport&, function_name: sview, source_scrutinee: Ast::Expr, symbolic_scrutinee: Ast::Expr, names: darray[sview]&, work: mutable usize&) -> Ast::Expr:
            parameter: mutable sview = ""
            match proof_strip_parens(source_scrutinee):
                Ast::Expr.Ident(name, _):
                    parameter <- name
                _:
                    return Ast::Expr.Absent
            match proof_strip_parens(symbolic_scrutinee):
                Ast::Expr.Ident(name, _):
                    same_symbol: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(name, parameter, work)
                    return Ast::Expr.Absent if not same_symbol.complete or not same_symbol.equal
                _:
                    return Ast::Expr.Absent
            active_bindings: mutable usize = 0
            for name in names |parameter, active_bindings, work|:
                same_binding: (complete: bool, equal: bool) = proof_pattern_source_type_text_equal_with_work(name, parameter, work)
                return Ast::Expr.Absent if not same_binding.complete
                active_bindings <- active_bindings + 1 if same_binding.equal
            return Ast::Expr.Absent if active_bindings != 1
            return proof_pattern_source_formal_type(report, function_name, source_scrutinee, work)

        # Reuse one source-type scan budget across the whole check. Exhaustion
        # only drops type-directed facts; it cannot turn an incomplete lookup into evidence.
        def proof_pattern_active_formal_type(report: mutable ProofReport&, function_name: sview, source_scrutinee: Ast::Expr, symbolic_scrutinee: Ast::Expr, names: darray[sview]&) -> Ast::Expr:
            work: mutable usize = report.analysis_1.budgets.pattern_source_type_work
            type_expression: Ast::Expr = proof_pattern_active_formal_type_with_work(report, function_name, source_scrutinee, symbolic_scrutinee, names, &work)
            report.analysis_1.budgets.pattern_source_type_work <- work
            type_expression

        def proof_pattern_is_string_type(type_expression: Ast::Expr) -> bool:
            type_name: sview = proof_pattern_type_name(type_expression)
            return when type_name:
                # Only these representations have a string-match lowering in the pinned
                # compiler. `dstr` is a dynamic byte array and does not share that path.
                "sview" | "cstr" -> true
                _ -> false

        def proof_pattern_is_char_type(type_expression: Ast::Expr) -> bool:
            return proof_pattern_type_name(type_expression) == "char"

        def proof_pattern_typed_literal_expression(text: sview, position: Ast::Pos, type_expression: Ast::Expr, source_work: mutable usize&) -> Ast::Expr?:
            if proof_pattern_is_string_type(type_expression) and proof_pattern_unambiguous_string_literal_with_work(text, source_work):
                return Ast::Expr.StringLit(text, position)
            if proof_pattern_is_char_type(type_expression) and proof_pattern_unambiguous_char_literal(text):
                return Ast::Expr.CharLit(string_view_slice(text, 1, sview_len(text) - 1), position)
            return null

        def proof_pattern_condition_typed(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, type_expression: Ast::Expr) -> Ast::Expr?:
            work: mutable usize = 0
            source_work: mutable usize = 0
            return proof_pattern_condition_typed_depth(pattern, scrutinee, position, type_expression, 0, &work, &source_work)

        def proof_pattern_condition_typed_with_report(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, type_expression: Ast::Expr, report: mutable ProofReport&) -> Ast::Expr?:
            work: mutable usize = 0
            source_work: mutable usize = report.analysis_1.budgets.pattern_source_type_work
            condition: Ast::Expr? = proof_pattern_condition_typed_depth(pattern, scrutinee, position, type_expression, 0, &work, &source_work)
            report.analysis_1.budgets.pattern_source_type_work <- source_work
            condition

        def proof_pattern_condition_typed_depth(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, type_expression: Ast::Expr, depth: usize, work: mutable usize&, source_work: mutable usize&) -> Ast::Expr?:
            return null if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.As(_, inner):
                    return proof_pattern_condition_typed_depth(inner[0], scrutinee, position, type_expression, depth + 1, work, source_work) if inner.count == 1
                Ast::Pattern.Literal(text):
                    literal: Ast::Expr? = proof_pattern_typed_literal_expression(text, position, type_expression, source_work)
                    if literal is value:
                        return Ast::Expr.Binary(scrutinee, TokenKind.EqEq, value, position)
                Ast::Pattern.Range(_, _, _):
                    # Until authenticated source typing and signed/unsigned comparison
                    # semantics are shared with replay, even type-directed ranges fail closed.
                    return null
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    conditions: mutable darray[Ast::Expr] = []
                    for option in options |conditions, scrutinee, position, type_expression, depth, work, source_work|:
                        condition: Ast::Expr? = proof_pattern_condition_typed_depth(option, scrutinee, position, type_expression, depth + 1, work, source_work)
                        if condition is known_condition:
                            conditions.push(known_condition)
                        else:
                            return null
                    result: mutable Ast::Expr = conditions[0]
                    for index in 1..<conditions.count |index, conditions, result, position|:
                        result <- Ast::Expr.Binary(result, TokenKind.Or, conditions[index], position)
                    return result
                _:
                    return proof_pattern_condition_depth(pattern, scrutinee, position, depth, work)
            return null

        def proof_pattern_condition_using_type(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, type_expression: Ast::Expr, report: mutable ProofReport&) -> Ast::Expr?:
            return proof_pattern_condition(pattern, scrutinee, position) if type_expression is Ast::Expr.Absent
            return proof_pattern_condition_typed_with_report(pattern, scrutinee, position, type_expression, report)

        def proof_pattern_condition_exact_using_type(pattern: Ast::Pattern, type_expression: Ast::Expr, report: mutable ProofReport&) -> bool:
            return proof_pattern_condition_exact(pattern) if type_expression is Ast::Expr.Absent
            return proof_pattern_condition_exact_typed_with_report(pattern, type_expression, report)

        def proof_pattern_condition_with_source(pattern: Ast::Pattern, source_scrutinee: Ast::Expr, symbolic_scrutinee: Ast::Expr, position: Ast::Pos, report: mutable ProofReport&, function_name: sview, names: darray[sview]&) -> Ast::Expr?:
            type_expression: Ast::Expr = proof_pattern_active_formal_type(report, function_name, source_scrutinee, symbolic_scrutinee, names)
            if not (type_expression is Ast::Expr.Absent):
                return proof_pattern_condition_typed_with_report(pattern, symbolic_scrutinee, position, type_expression, report)
            return proof_pattern_condition(pattern, symbolic_scrutinee, position)

        def proof_pattern_condition_exact_with_source(pattern: Ast::Pattern, source_scrutinee: Ast::Expr, symbolic_scrutinee: Ast::Expr, report: mutable ProofReport&, function_name: sview, names: darray[sview]&) -> bool:
            type_expression: Ast::Expr = proof_pattern_active_formal_type(report, function_name, source_scrutinee, symbolic_scrutinee, names)
            if not (type_expression is Ast::Expr.Absent):
                return proof_pattern_condition_exact_typed_with_report(pattern, type_expression, report)
            return proof_pattern_condition_exact(pattern)

        def proof_pattern_condition_exact_typed(pattern: Ast::Pattern, type_expression: Ast::Expr) -> bool:
            work: mutable usize = 0
            source_work: mutable usize = 0
            return proof_pattern_condition_exact_typed_depth(pattern, type_expression, 0, &work, &source_work)

        def proof_pattern_condition_exact_typed_with_report(pattern: Ast::Pattern, type_expression: Ast::Expr, report: mutable ProofReport&) -> bool:
            work: mutable usize = 0
            source_work: mutable usize = report.analysis_1.budgets.pattern_source_type_work
            exact: bool = proof_pattern_condition_exact_typed_depth(pattern, type_expression, 0, &work, &source_work)
            report.analysis_1.budgets.pattern_source_type_work <- source_work
            exact

        def proof_pattern_condition_exact_typed_depth(pattern: Ast::Pattern, type_expression: Ast::Expr, depth: usize, work: mutable usize&, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.As(_, inner):
                    return inner.count == 1 and proof_pattern_condition_exact_typed_depth(inner[0], type_expression, depth + 1, work, source_work)
                Ast::Pattern.Variant(_, fields):
                    for field in fields |fields, depth, work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_pattern_irrefutable_depth(field, depth + 1, work)
                    return true
                Ast::Pattern.Literal(text):
                    return (proof_pattern_is_string_type(type_expression) and proof_pattern_unambiguous_string_literal_with_work(text, source_work)) or (proof_pattern_is_char_type(type_expression) and proof_pattern_unambiguous_char_literal(text))
                Ast::Pattern.Range(_, _, _):
                    return false
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |options, depth, work, source_work|:
                        return false if not proof_pattern_condition_exact_typed_depth(option, type_expression, depth + 1, work, source_work)
                    return true
                _:
                    return false

        # OR-patterns are admitted only for closed alternatives. This gives the proof state one
        # precise disjunctive match fact while avoiding the unsound choice of a payload binding
        # that exists in only one alternative or has different projections in each alternative.
        def proof_pattern_or_closed(pattern: Ast::Pattern) -> bool:
            work: mutable usize = 0
            return proof_pattern_or_closed_depth(pattern, 0, &work)

        def proof_pattern_or_closed_depth(pattern: Ast::Pattern, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Variant(_, fields):
                    return fields.count == 0
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |pattern, depth, work|:
                        return false if not proof_pattern_or_closed_depth(option, depth + 1, work)
                    return true
                _:
                    return false

        # Install lexical bindings introduced by a runtime pattern. A binder now receives a
        # symbolic projection of the matched scrutinee whenever the syntax identifies that
        # projection (`Struct{field: value}` / `Variant(field: value)`). This is a definitional
        # environment update, not an axiom: later substitution can only use the projection that
        # the compiler's pattern itself selected. Positional enum payloads remain conservative
        # because the lowered AST does not expose their stable field names here.
