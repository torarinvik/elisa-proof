# Bounded source-level function call resolution and graph admission.
extend ElisaProof:
    private:
        # True when rows `row` and `caller` sit directly in the same module, which is the
        # top level when both module prefixes are 0.
        def proof_function_same_module(functions: ProofFunctionTable&, row: usize, caller: usize, work: mutable usize&, limit: usize) -> (complete: bool, same: bool):
            return (false, false) if row >= functions.lookup.source.module_prefixes.count or caller >= functions.lookup.source.module_prefixes.count
            prefix: usize = functions.lookup.source.module_prefixes[row]
            return (true, false) if prefix != functions.lookup.source.module_prefixes[caller]
            return proof_function_path_prefix_equal(functions, row, caller, prefix, work, limit)

        # True when `row` sits directly in a module that strictly encloses the caller's module.
        def proof_function_in_enclosing_module(functions: ProofFunctionTable&, row: usize, caller: usize, work: mutable usize&, limit: usize) -> (complete: bool, enclosing: bool):
            return (false, false) if row >= functions.lookup.source.module_prefixes.count or caller >= functions.lookup.source.module_prefixes.count
            prefix: usize = functions.lookup.source.module_prefixes[row]
            return (true, false) if prefix == 0 or prefix >= functions.lookup.source.module_prefixes[caller]
            return proof_function_path_prefix_equal(functions, row, caller, prefix, work, limit)

        def proof_function_path_prefix_equal(functions: ProofFunctionTable&, row: usize, caller: usize, prefix: usize, work: mutable usize&, limit: usize) -> (complete: bool, equal: bool):
            return (false, false) if:
                row >= functions.lookup.source.declaration_path_starts.count or caller >= functions.lookup.source.declaration_path_starts.count
                row >= functions.lookup.source.declaration_path_counts.count or caller >= functions.lookup.source.declaration_path_counts.count
                functions.lookup.source.declaration_path_counts[row] < prefix or functions.lookup.source.declaration_path_counts[caller] < prefix
            row_start: usize = functions.lookup.source.declaration_path_starts[row]
            caller_start: usize = functions.lookup.source.declaration_path_starts[caller]
            return (false, false) if:
                row_start > functions.lookup.source.all_declaration_path.count or caller_start > functions.lookup.source.all_declaration_path.count
                prefix > functions.lookup.source.all_declaration_path.count - row_start or prefix > functions.lookup.source.all_declaration_path.count - caller_start
            for offset in 0..<prefix |offset, functions, row_start, caller_start, work, limit|:
                row_segment: usize = functions.lookup.source.all_declaration_path[row_start + offset]
                caller_segment: usize = functions.lookup.source.all_declaration_path[caller_start + offset]
                return (false, false) if not proof_function_graph_charge(1, work, limit)
                return (true, false) if row_segment != caller_segment
            return (true, true)

        def proof_function_graph_charge(amount: usize, work: mutable usize&, limit: usize) -> bool:
            if work > limit or amount > limit - work:
                work <- limit + 1
                return false
            work <- work + amount
            return true

        # The primary name index stores the first row for compatibility. Repeated-name
        # resolution walks only the source-ordered duplicate chain attached to that slot.
        # Every link and exact-name check is charged; malformed, cyclic, or incomplete chains
        # make the call unresolved instead of falling back to a whole-table guess.
        def proof_function_name_candidates_with_work(functions: ProofFunctionTable&, name: sview, work: mutable usize&, limit: usize) -> (complete: bool, rows: darray[usize]):
            rows: mutable darray[usize] = []
            count: usize = functions.lookup.source.names.count
            capacity: usize = functions.lookup.indexes.index_values.count
            if count == 0:
                return (false, rows) if:
                    functions.lookup.source.owner_modules.count != 0 or functions.lookup.indexes.name_hashes.count != 0
                    capacity != 0 or functions.lookup.indexes.index_hashes.count != 0 or functions.lookup.indexes.index_ambiguous.count != 0
                    functions.lookup.indexes.index_duplicate_tails.count != 0 or functions.lookup.indexes.index_duplicate_next.count != 0
                return (true, rows)
            return (false, rows) if:
                functions.lookup.source.owner_modules.count != count or functions.lookup.indexes.name_hashes.count != count
                capacity == 0 or capacity != functions.lookup.indexes.index_hashes.count or capacity != functions.lookup.indexes.index_ambiguous.count
                capacity != functions.lookup.indexes.index_duplicate_tails.count or functions.lookup.indexes.index_duplicate_next.count != count
            indexed: (complete: bool, row: usize, repeated: bool) = proof_function_name_lookup_with_work(functions, name, work)
            return (false, rows) if not indexed.complete or work > limit
            if not indexed.repeated:
                return (true, rows) if indexed.row == count
                return (false, rows) if indexed.row > count or not proof_function_graph_charge(1, work, limit)
                rows.push(indexed.row)
                return (true, rows)
            return (false, rows) if indexed.row >= count
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            found_slot: mutable usize = capacity
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, functions, capacity, count, work, limit, found_slot|:
                return (false, rows) if not proof_function_graph_charge(1, work, limit)
                first: usize = functions.lookup.indexes.index_values[slot]
                return (false, rows) if first > count
                return (false, rows) if first == count
                if functions.lookup.indexes.index_hashes[slot] == wanted_hash:
                    return (false, rows) if first >= count or not proof_function_graph_charge(sview_len(functions.lookup.source.names[first]), work, limit)
                    if functions.lookup.source.names[first] == name:
                        found_slot <- slot
                        break
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, rows) if found_slot >= capacity
            return (false, rows) if:
                functions.lookup.indexes.index_values[found_slot] != indexed.row
                not functions.lookup.indexes.index_ambiguous[found_slot]
            current: mutable usize = indexed.row
            visits: mutable usize = 0
            last: mutable usize = count
            while current < count and visits < count |current, visits, last, rows, functions, name, wanted_hash, count, work, limit|:
                return (false, rows) if current >= functions.lookup.indexes.name_hashes.count
                candidate: sview = functions.lookup.source.names[current]
                return (false, rows) if not proof_function_graph_charge(1, work, limit) or not proof_function_graph_charge(sview_len(name), work, limit) or not proof_function_graph_charge(sview_len(candidate), work, limit)
                return (false, rows) if:
                    functions.lookup.indexes.name_hashes[current] != wanted_hash or candidate != name
                    rows.count > 0 and current <= last
                rows.push(current)
                last <- current
                next: usize = functions.lookup.indexes.index_duplicate_next[current]
                return (false, rows) if next > count
                break if next == count
                current <- next
                visits <- visits + 1
            return (false, rows) if current >= count or visits >= count
            return (false, rows) if rows.count < 2 or last != functions.lookup.indexes.index_duplicate_tails[found_slot]
            return (true, rows)

        # Bare-call graph resolution uses one meter shared across every edge. It mirrors the
        # caller-module, nearest enclosing-module, and top-level search order without allowing
        # each repeated-name fallback to restart an unbounded whole-table scan.
        def proof_function_resolve_bare_call_bounded(functions: ProofFunctionTable&, caller: usize, name: sview, work: mutable usize&, limit: usize) -> (complete: bool, row: usize, repeated: bool):
            count: usize = functions.lookup.source.names.count
            return (true, count, false) if name == ""
            return (false, count, false) if functions.lookup.source.names.count != functions.lookup.source.owner_modules.count
            candidate_status: (complete: bool, rows: darray[usize]) = proof_function_name_candidates_with_work(functions, name, work, limit)
            return (false, count, false) if not candidate_status.complete
            matches: darray[usize] = candidate_status.rows
            return (true, count, false) if matches.count == 0
            return (true, matches[0], false) if matches.count == 1
            return (true, count, true) if caller >= count or caller >= functions.lookup.source.owner_modules.count
            found: mutable usize = count
            for row in matches |row, matches, functions, caller, found, work, limit|:
                return (false, count, true) if row >= functions.lookup.source.owner_modules.count or not proof_function_graph_charge(1, work, limit) or not proof_function_graph_charge(sview_len(functions.lookup.source.owner_modules[row]), work, limit) or not proof_function_graph_charge(sview_len(functions.lookup.source.owner_modules[caller]), work, limit)
                same_module: (complete: bool, same: bool) = proof_function_same_module(functions, row, caller, work, limit)
                return (false, count, true) if not same_module.complete
                if same_module.same:
                    return (true, count, true) if found < count
                    found <- row
            return (true, found, true) if found < count
            enclosing_found: mutable usize = count
            enclosing_prefix: mutable usize = 0
            enclosing_matches: mutable usize = 0
            for row in matches |row, matches, functions, caller, enclosing_found, enclosing_prefix, enclosing_matches, work, limit|:
                return (false, count, true) if row >= functions.lookup.source.owner_modules.count or not proof_function_graph_charge(1, work, limit) or not proof_function_graph_charge(sview_len(functions.lookup.source.owner_modules[row]), work, limit) or not proof_function_graph_charge(sview_len(functions.lookup.source.owner_modules[caller]), work, limit)
                enclosing: (complete: bool, enclosing: bool) = proof_function_in_enclosing_module(functions, row, caller, work, limit)
                return (false, count, true) if not enclosing.complete
                if enclosing.enclosing:
                    candidate_prefix: usize = functions.lookup.source.module_prefixes[row]
                    if candidate_prefix > enclosing_prefix:
                        enclosing_prefix <- candidate_prefix
                        enclosing_found <- row
                        enclosing_matches <- 1
                    elif candidate_prefix == enclosing_prefix:
                        enclosing_found <- row
                        enclosing_matches <- enclosing_matches + 1
            return (true, count, true) if enclosing_matches > 1
            return (true, enclosing_found, true) if enclosing_matches == 1
            found <- count
            for row in matches |__function_match_loop_unit = false, row, matches, functions, found, work, limit| -> __function_match_loop_unit:
                return (false, count, true) if row >= functions.lookup.source.module_prefixes.count or not proof_function_graph_charge(1, work, limit)
                if functions.lookup.source.module_prefixes[row] == 0:
                    return (true, count, true) if found < count
                    found <- row
            return (true, found, true)

        def proof_function_resolve_exact_owner_bounded(functions: ProofFunctionTable&, name: sview, owner: sview, work: mutable usize&, limit: usize) -> (complete: bool, row: usize):
            count: usize = functions.lookup.source.names.count
            return (false, count) if count != functions.lookup.source.owner_modules.count
            return (true, count) if count == 0
            candidate_status: (complete: bool, rows: darray[usize]) = proof_function_name_candidates_with_work(functions, name, work, limit)
            return (false, count) if not candidate_status.complete
            found: mutable usize = count
            for candidate_index in 0..<candidate_status.rows.count |candidate_index, candidate_status, functions, owner, found, work, limit|:
                index: usize = candidate_status.rows[candidate_index]
                return (false, count) if index >= count or index >= functions.lookup.source.owner_modules.count
                candidate_owner: sview = functions.lookup.source.owner_modules[index]
                return (false, count) if not proof_function_graph_charge(1, work, limit) or not proof_function_graph_charge(sview_len(owner), work, limit) or not proof_function_graph_charge(sview_len(candidate_owner), work, limit)
                if candidate_owner == owner:
                    return (true, count) if found < count
                    found <- index
            return (true, found)

        # The proof call graph contains executable source functions only. Always resolve a
        # matching source function so a same-name extern cannot erase its graph edge. The
        # reachability pass separately marks calls matching untrusted or function-valued
        # externs unresolved; trusted callable externs remain an explicit boundary.
        # Lemmas have no executable row, but their exact source owner still determines which
        # executable contracts are visible. Preserve globally unique bare-call resolution; for
        # repeated names, search the lemma's module and then its enclosing modules and root.
        # Every candidate comparison shares the caller's resolution meter and ambiguity fails
        # closed, just like the row-based executable resolver.
        def proof_function_resolve_bare_call_for_module_bounded(functions: ProofFunctionTable&, caller_module: sview, name: sview, work: mutable usize&, limit: usize) -> (complete: bool, row: usize):
            count: usize = functions.lookup.source.names.count
            return (false, count) if count != functions.lookup.source.owner_modules.count
            return (true, count) if name == ""
            candidate_status: (complete: bool, rows: darray[usize]) = proof_function_name_candidates_with_work(functions, name, work, limit)
            return (false, count) if not candidate_status.complete
            candidates: darray[usize] = candidate_status.rows
            matches: usize = candidates.count
            return (true, count) if matches == 0
            return (true, candidates[0]) if matches == 1
            path_scope: mutable sview = caller_module
            scope_complete: mutable bool = true
            while scope_complete |path_scope, caller_module, name, functions, candidates, count, work, limit, scope_complete|:
                found: mutable usize = count
                found_count: mutable usize = 0
                for candidate_index in 0..<candidates.count |candidate_index, candidates, path_scope, name, functions, found, found_count, work, limit|:
                    row: usize = candidates[candidate_index]
                    return (false, count) if row >= count
                    owner: sview = functions.lookup.source.owner_modules[row]
                    return (false, count) if not proof_function_graph_charge(1, work, limit) or not proof_function_graph_charge(sview_len(name), work, limit) or not proof_function_graph_charge(sview_len(functions.lookup.source.names[row]), work, limit) or not proof_function_graph_charge(sview_len(owner), work, limit) or not proof_function_graph_charge(sview_len(path_scope), work, limit)
                    if functions.lookup.source.names[row] == name and owner == path_scope:
                        found <- row
                        found_count <- found_count + 1
                return (true, count) if found_count > 1
                return (true, found) if found_count == 1
                if path_scope == "":
                    scope_complete <- false
                else:
                    path_scope <- proof_module_parent_scope(path_scope)
            return (true, count)

        def proof_function_index_for_callee_with_module_work(functions: ProofFunctionTable&, caller_module: sview, callee: Ast::Expr, work: mutable usize&, limit: usize) -> (complete: bool, row: usize):
            name: sview = proof_callable_name(callee)
            count: usize = functions.lookup.source.names.count
            return (true, count) if name == ""
            match callee:
                Ast::Expr.Scope(_, _, _):
                    return proof_module_function_index_for_callee(functions.lookup.source.names, functions.lookup.source.owner_modules, functions.lookup.source.module_aliases, caller_module, callee, work, limit)
                _:
                    return proof_function_resolve_bare_call_for_module_bounded(functions, caller_module, name, work, limit)

        def proof_function_index_for_callee_with_work(functions: ProofFunctionTable&, caller: usize, callee: Ast::Expr, work: mutable usize&, limit: usize) -> (complete: bool, row: usize):
            name: sview = proof_callable_name(callee)
            count: usize = functions.lookup.source.names.count
            return (true, count) if name == ""
            match callee:
                Ast::Expr.Scope(_, _, _):
                    caller_module: sview = functions.lookup.source.owner_modules[caller] if caller < functions.lookup.source.owner_modules.count else ""
                    return (false, count) if caller >= functions.lookup.source.owner_modules.count
                    return proof_module_function_index_for_callee(functions.lookup.source.names, functions.lookup.source.owner_modules, functions.lookup.source.module_aliases, caller_module, callee, work, limit)
                _:
                    bare: (complete: bool, row: usize, repeated: bool) = proof_function_resolve_bare_call_bounded(functions, caller, name, work, limit)
                    return (bare.complete, bare.row)

        def proof_function_local_callee_base_name(callee: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match callee:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Scope(base, _, _) | Ast::Expr.Paren(base, _):
                    return proof_function_local_callee_base_name(base, depth + 1)
                _:
                    return ""

        # Method-shaped conversions have no callable leaf for the name graph. Admit only
        # compiler conversions that are independently recognized by the resource checker,
        # are not shadowed by a source declaration, and fit the shared resolution budget.
        def proof_function_call_name_is_declared_bounded(functions: ProofFunctionTable&, name: sview, work: mutable usize&, limit: usize) -> (complete: bool, declared: bool):
            function_count: usize = functions.lookup.source.names.count
            function_declared: mutable bool = false
            if function_count > 0:
                capacity: usize = functions.lookup.indexes.index_values.count
                return (false, true) if:
                    capacity == 0 or capacity != functions.lookup.indexes.index_hashes.count or capacity != functions.lookup.indexes.index_ambiguous.count or capacity != proof_name_index_capacity(function_count)
                    not proof_function_graph_charge(sview_len(name), work, limit)
                wanted_hash: u32 = proof_name_hash(name)
                slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |__function_name_probe_loop_unit = false, probes, slot, wanted_hash, name, functions, capacity, function_count, work, limit, function_declared| -> __function_name_probe_loop_unit:
                    return (false, true) if not proof_function_graph_charge(1, work, limit)
                    current: usize = functions.lookup.indexes.index_values[slot]
                    return (false, true) if current > function_count
                    break if current == function_count
                    if functions.lookup.indexes.index_hashes[slot] == wanted_hash:
                        return (false, true) if current >= function_count
                        candidate: sview = functions.lookup.source.names[current]
                        return (false, true) if not proof_function_graph_charge(sview_len(candidate), work, limit)
                        if candidate == name:
                            function_declared <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                    yield __function_name_probe_loop_unit
                return (false, true) if probes >= capacity
            return (true, true) if function_declared
            return (false, true) if functions.externs.extern_signatures.count > 0 and (functions.externs.extern_index_values.count == 0 or functions.externs.extern_index_values.count != functions.externs.extern_index_hashes.count or functions.externs.extern_index_values.count != functions.externs.extern_index_ambiguous.count or functions.externs.extern_index_values.count != functions.externs.extern_index_callable.count or functions.externs.extern_index_values.count != proof_name_index_capacity(functions.externs.extern_signatures.count))
            extern_count: usize = functions.externs.extern_signatures.count
            return (true, false) if extern_count == 0
            return (false, true) if not proof_function_graph_charge(sview_len(name), work, limit)
            wanted_hash: u32 = proof_name_hash(name)
            capacity: usize = functions.externs.extern_index_values.count
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, functions, capacity, extern_count, work, limit|:
                return (false, true) if not proof_function_graph_charge(1, work, limit)
                current: usize = functions.externs.extern_index_values[slot]
                return (false, true) if current > extern_count
                return (true, false) if current == extern_count
                if functions.externs.extern_index_hashes[slot] == wanted_hash:
                    return (false, true) if current >= extern_count
                    candidate: sview = functions.externs.extern_signatures[current].name
                    return (false, true) if not proof_function_graph_charge(sview_len(candidate), work, limit)
                    if candidate == name:
                        # Preserve the compiler's declaration-shadow rule: any exact
                        # extern spelling blocks this intrinsic conversion.
                        return (true, true)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, true)

        def proof_function_conversion_receiver_root_name(receiver: Ast::Expr, depth: usize, work: mutable usize&, limit: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or not proof_function_graph_charge(1, work, limit)
            match receiver:
                Ast::Expr.Ident(name, _):
                    return (false, "") if not proof_function_graph_charge(sview_len(name), work, limit)
                    return (true, name)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_function_conversion_receiver_root_name(inner, depth + 1, work, limit)
                Ast::Expr.Index(object, _, _) | Ast::Expr.IndexN(object, _, _):
                    return proof_function_conversion_receiver_root_name(object, depth + 1, work, limit)
                _:
                    return (true, "")

        # Conversion typing follows a formal only while that formal is the active
        # receiver binding. Reconstruct local binders at the call offset so a same-named
        # local record cannot inherit the formal's builtin conversion type.
        def proof_function_conversion_receiver_shadowed(report: mutable ProofReport&, snapshot: mutable ProofFactCallShapeSnapshot&, functions: ProofFunctionTable&, caller: usize, receiver: Ast::Expr, call_position: Ast::Pos, work: mutable usize&, limit: usize) -> (complete: bool, shadowed: bool):
            root: (complete: bool, name: sview) = proof_function_conversion_receiver_root_name(receiver, 0, work, limit)
            return (false, true) if not root.complete
            return (true, true) if root.name == ""
            call_offset: u32 = call_position.offset
            return (false, true) if snapshot.signatures.signature_contract_starts.count != snapshot.functions.function_names.count or snapshot.signatures.signature_contract_counts.count != snapshot.functions.function_names.count or caller >= snapshot.functions.function_names.count
            contract_start: usize = snapshot.signatures.signature_contract_starts[caller]
            contract_count: usize = snapshot.signatures.signature_contract_counts[caller]
            return (false, true) if contract_start > snapshot.signatures.all_signature_contracts.count or contract_count > snapshot.signatures.all_signature_contracts.count - contract_start
            contract_matches: mutable usize = 0
            contract_shadowed: mutable bool = false
            contract_located: mutable bool = false
            for index in 0..<contract_count |index, contract_start, snapshot, call_offset, contract_matches, contract_shadowed, contract_located, report, root|:
                expression: Ast::Expr = snapshot.signatures.all_signature_contracts[contract_start + index]
                state: (valid: bool, contains: bool) = proof_fact_call_shape_expr_contains_offset(snapshot, expression, call_offset)
                return (false, true) if not state.valid
                continue if not state.contains
                contract_matches <- contract_matches + 1
                return (false, true) if:
                    contract_matches > 1
                    not proof_fact_call_shape_local_shadow_expr_at(report, snapshot, expression, root.name, call_offset, &contract_shadowed, &contract_located, 0, true)
            if contract_matches > 0:
                return (true, not contract_located or contract_matches != 1 or contract_shadowed)

            body: (known: bool, parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt]) = proof_fact_call_shape_function_body(report, snapshot, caller)
            return (false, true) if not body.known
            body_state: (valid: bool, contains: bool) = proof_fact_call_shape_body_contains_offset(snapshot, body.body, call_offset)
            return (false, true) if not body_state.valid
            if body_state.contains:
                shadowed: mutable bool = false
                located: mutable bool = false
                return (false, true) if not proof_fact_call_shape_local_shadow_body_at(report, snapshot, body.body, root.name, call_offset, &shadowed, &located, 0, true)
                return (true, not located or shadowed)

            # Defaults are executable in the caller's lexical context too. Search only
            # this declaration's bounded parameter slice and fail closed on ambiguous spans.
            return (false, true) if:
                caller >= functions.parameters.metadata.param_starts.count or caller >= functions.parameters.metadata.param_counts.count
                functions.parameters.metadata.all_defaults.count != functions.parameters.metadata.all_has_defaults.count or functions.parameters.metadata.all_defaults.count != functions.parameters.metadata.all_params.count
            param_start: usize = functions.parameters.metadata.param_starts[caller]
            param_count: usize = functions.parameters.metadata.param_counts[caller]
            return (false, true) if param_start > functions.parameters.metadata.all_defaults.count or param_count > functions.parameters.metadata.all_defaults.count - param_start
            matches: mutable usize = 0
            shadowed: mutable bool = false
            located: mutable bool = false
            for offset in 0..<param_count |offset, param_start, functions, snapshot, call_offset, matches, shadowed, located, report, root, work, limit|:
                slot: usize = param_start + offset
                return (false, true) if not proof_function_graph_charge(1, work, limit)
                continue if not functions.parameters.metadata.all_has_defaults[slot]
                expression: Ast::Expr = functions.parameters.metadata.all_defaults[slot]
                state: (valid: bool, contains: bool) = proof_fact_call_shape_expr_contains_offset(snapshot, expression, call_offset)
                return (false, true) if not state.valid
                continue if not state.contains
                matches <- matches + 1
                return (false, true) if:
                    matches > 1
                    not proof_fact_call_shape_local_shadow_expr_at(report, snapshot, expression, root.name, call_offset, &shadowed, &located, 0, true)
            return (true, not located or matches != 1 or shadowed)

        # An empty graph name is reserved for a small set of intrinsic conversions. Every
        # other call whose callee cannot be resolved as a named declaration is made opaque.
        def proof_function_unclassified_call_is_intrinsic(functions: ProofFunctionTable&, snapshot: mutable ProofFactCallShapeSnapshot&, caller: usize, expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, report: mutable ProofReport&, work: mutable usize&, limit: usize) -> (complete: bool, intrinsic: bool):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    if argument_names.count != 0 and argument_names.count != arguments.count:
                        return (true, false)
                    for label in argument_names |label, work, limit|:
                        return (false, false) if not proof_function_graph_charge(1 + sview_len(label), work, limit)
                        return (true, false) if label != ""
                    plain_callee: Ast::Expr = proof_strip_parens(callee)
                    scalar_name: sview = proof_ident_name(plain_callee)
                    if scalar_name != "":
                        return (false, false) if not proof_function_graph_charge(1 + sview_len(scalar_name), work, limit)
                        return (true, arguments.count == 1) if proof_builtin_scalar_type_name(scalar_name)
                    return (true, false) if arguments.count != 0
                    match plain_callee:
                        Ast::Expr.Field(receiver, method, _):
                            return (false, false) if caller >= functions.lookup.source.lines.count or caller >= functions.lookup.source.offsets.count or caller >= functions.lookup.source.owner_modules.count or functions.lookup.source.owner_modules.count != functions.lookup.source.names.count or functions.lookup.source.offsets.count != functions.lookup.source.names.count
                            declaration_line: u32 = functions.lookup.source.lines[caller]
                            caller_owner: sview = functions.lookup.source.owner_modules[caller]
                            return (true, false) if not proof_resource_pure_conversion(method)
                            return (false, false) if not proof_function_graph_charge(1 + sview_len(method), work, limit)
                            receiver_shadow: (complete: bool, shadowed: bool) = proof_function_conversion_receiver_shadowed(report, snapshot, functions, caller, receiver, position, work, limit)
                            return (false, false) if not receiver_shadow.complete
                            return (true, false) if receiver_shadow.shadowed
                            numeric: (known: bool, receiver: Ast::Expr) = proof_runtime_builtin_numeric_cast(plain_callee, 0, functions)
                            if numeric.known:
                                return (true, false) if report.source_types.source_effect_index.conversions.field_conversion_custom_cast_present
                                return (true, proof_structural_field_conversion_type_supported(method, numeric.receiver, parameters, declaration_line, report, caller_owner, true))
                            if method == "as_sview":
                                conversion: (complete: bool, count: usize, row: usize) = proof_source_effect_field_conversion_lookup(report, method)
                                return (false, false) if:
                                    not conversion.complete or conversion.count != 0
                                    report.source_types.source_effect_index.conversions.field_conversion_custom_cast_present
                                    report.source_types.source_effect_index.conversions.field_dispatch_imports_present
                                return (true, proof_structural_field_conversion_type_supported(method, receiver, parameters, declaration_line, report, caller_owner, true))
                            return (true, false) if proof_expr_numeric_cast_target(method)
                            # The non-numeric conversions use the same no-shadowing rule as
                            # method builtins. A custom cast hook also makes dispatch opaque.
                            return (true, false) if functions.externs.custom_cast_hook_present
                            declaration: (complete: bool, declared: bool) = proof_function_call_name_is_declared_bounded(functions, method, work, limit)
                            return (false, false) if not declaration.complete
                            return (true, not declaration.declared and proof_structural_field_conversion_type_supported(method, receiver, parameters, declaration_line, report, caller_owner, true))
                        _:
                            return (true, false)
                _:
                    return (true, false)

        # Parameter defaults are collected in the call graph but do not live in the function
        # body or contract snapshot. Locate those edges directly from the indexed default ASTs
        # so a plain global helper call in a default keeps its summary, while an earlier formal
        # or nested default-expression binder that shadows it remains opaque.
        def proof_function_default_call_shadow(report: mutable ProofReport&, snapshot: mutable ProofFactCallShapeSnapshot&, functions: ProofFunctionTable&, caller: usize, callee: Ast::Expr, call_position: Ast::Pos, work: mutable usize&, limit: usize) -> (complete: bool, is_default: bool, shadowed: bool):
            if caller >= functions.parameters.metadata.param_starts.count or caller >= functions.parameters.metadata.param_counts.count:
                return (false, false, false)
            return (false, false, false) if functions.parameters.metadata.all_defaults.count != functions.parameters.metadata.all_has_defaults.count or functions.parameters.metadata.all_defaults.count != functions.parameters.metadata.all_params.count
            param_start: usize = functions.parameters.metadata.param_starts[caller]
            param_count: usize = functions.parameters.metadata.param_counts[caller]
            return (false, false, false) if param_start > functions.parameters.metadata.all_defaults.count or param_count > functions.parameters.metadata.all_defaults.count - param_start
            default_slot: mutable usize = functions.parameters.metadata.all_defaults.count
            for offset in 0..<param_count |offset, param_start, functions, call_position, default_slot, work, limit|:
                slot: usize = param_start + offset
                return (false, false, false) if not proof_function_graph_charge(1, work, limit)
                continue if not functions.parameters.metadata.all_has_defaults[slot]
                default_position: Ast::Pos = Ast::expr_pos(functions.parameters.metadata.all_defaults[slot])
                span: (valid: bool, contains: bool) = proof_fact_call_shape_source_span_contains(default_position, call_position.offset)
                return (false, false, false) if not span.valid
                if span.contains:
                    return (false, false, false) if default_slot < functions.parameters.metadata.all_defaults.count
                    default_slot <- slot
            return (true, false, false) if default_slot == functions.parameters.metadata.all_defaults.count
            local_name: sview = proof_function_local_callee_base_name(callee, 0)
            return (true, true, true) if local_name == ""
            shadowed: mutable bool = false
            prior_count: usize = default_slot - param_start
            for offset in 0..<prior_count |offset, param_start, functions, local_name, shadowed, work, limit|:
                slot: usize = param_start + offset
                prior_name: sview = functions.parameters.metadata.all_params[slot]
                return (false, true, false) if not proof_function_graph_charge(1, work, limit) or not proof_function_graph_charge(sview_len(local_name), work, limit) or not proof_function_graph_charge(sview_len(prior_name), work, limit)
                shadowed <- true if prior_name == local_name
            return (true, true, true) if shadowed
            located: mutable bool = false
            if not proof_fact_call_shape_local_shadow_expr_at(report, snapshot, functions.parameters.metadata.all_defaults[default_slot], local_name, call_position.offset, &shadowed, &located, 0) or not located:
                return (true, true, true)
            return (true, true, shadowed)

        # Resolve every collected call edge from its own caller once the table is complete.
        def proof_resolve_function_call_targets(report: mutable ProofReport&, functions: mutable ProofFunctionTable&, source_work: mutable usize&) -> (complete: bool, reason: sview, observed: usize, limit: usize):
            functions.call_graph.current_caller <- functions.lookup.source.names.count
            functions.call_graph.all_call_targets.clear()
            functions.call_graph.direct_unresolved_calls.clear()
            functions.call_graph.direct_unresolved_calls.resize(functions.lookup.source.names.count)
            return (false, "call-graph-callee-source-table", functions.call_graph.all_call_callee_sources.count, functions.call_graph.all_calls.count) if functions.call_graph.all_call_callee_sources.count != functions.call_graph.all_calls.count
            shadow_snapshot: mutable ProofFactCallShapeSnapshot& = &report.analysis_2.fact_call_shapes
            return (false, "call-graph-resolution-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_function_graph_charge(functions.call_graph.all_calls.count, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            for _ in 0..<functions.call_graph.all_calls.count |functions|:
                functions.call_graph.all_call_targets.push(functions.lookup.source.names.count)
            for caller in 0..<functions.lookup.source.names.count |caller, functions, source_work, report, shadow_snapshot|:
                source_parameters: mutable darray[Ast::ParamDecl] = []
                source_parameters_loaded: mutable bool = false
                continue if caller >= functions.call_graph.call_starts.count or caller >= functions.call_graph.call_counts.count
                start: usize = functions.call_graph.call_starts[caller]
                count: usize = functions.call_graph.call_counts[caller]
                continue if start > functions.call_graph.all_calls.count or count > functions.call_graph.all_calls.count - start
                for offset in 0..<count |offset, start, caller, functions, source_work, report, shadow_snapshot, source_parameters, source_parameters_loaded|:
                    called: sview = functions.call_graph.all_calls[start + offset]
                    if called == "__opaque_call__":
                        functions.call_graph.direct_unresolved_calls[caller] <- true
                        continue
                    source: Ast::Expr = functions.call_graph.all_call_callee_sources[start + offset]
                    return (false, "call-graph-callee-source", start + offset, functions.call_graph.all_calls.count) if source is Ast::Expr.Invalid
                    if called == "":
                        if not source_parameters_loaded:
                            caller_source: (known: bool, parameters: darray[Ast::ParamDecl], body: darray[Ast::Stmt]) = proof_fact_call_shape_function_body(report, shadow_snapshot, caller)
                            return (false, "call-graph-caller-source", caller, functions.lookup.source.names.count) if not caller_source.known
                            source_parameters.extend(caller_source.parameters)
                            source_parameters_loaded <- true
                        intrinsic: (complete: bool, intrinsic: bool) = proof_function_unclassified_call_is_intrinsic(functions, shadow_snapshot, caller, source, source_parameters, report, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return (false, "call-graph-resolution-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not intrinsic.complete
                        if not intrinsic.intrinsic:
                            functions.call_graph.all_calls[start + offset] <- "__opaque_call__"
                            functions.call_graph.direct_unresolved_calls[caller] <- true
                        continue
                    source_position: Ast::Pos = Ast::expr_pos(source)
                    default_shadow: (complete: bool, is_default: bool, shadowed: bool) = proof_function_default_call_shadow(report, shadow_snapshot, functions, caller, source, source_position, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return (false, "call-graph-resolution-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not default_shadow.complete
                    shadowed_local: bool = default_shadow.shadowed if default_shadow.is_default else proof_fact_call_shape_local_scope_shadowed(report, shadow_snapshot, caller, source, source_position, 0)
                    if shadowed_local:
                        # A local callable (including a formal parameter) does not inherit the
                        # purity, termination or effects of a same-spelled global declaration.
                        # Keep the edge opaque for every graph consumer.
                        functions.call_graph.all_calls[start + offset] <- "__opaque_call__"
                        functions.call_graph.direct_unresolved_calls[caller] <- true
                        continue
                    resolved: (complete: bool, row: usize) = proof_function_index_for_callee_with_work(functions, caller, source, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return (false, "call-graph-resolution-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not resolved.complete
                    functions.call_graph.all_call_targets[start + offset] <- resolved.row
                    # A field call may resolve by leaf name for general call-graph consumers,
                    # but structural recursion cannot rely on that name alone: the receiver
                    # may hold a callback with a hidden edge back into the recursive component.
                    # Keep the ordinary edge intact while recording this separate hazard.
                    match proof_strip_parens(source):
                        Ast::Expr.Field(_, _, _):
                            functions.call_graph.direct_unresolved_calls[caller] <- true
                        _:
                            pass
            resolved_work: usize = source_work
            functions.lookup.work.module_resolution_work_used <- resolved_work
            return (true, "", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        # Scheduler consumers use the resolved row directly. The sentinel names.count means
        # unresolved or opaque; larger values and mismatched edge arrays are malformed.
        def proof_scheduled_call_target(functions: ProofFunctionTable&, edge: usize) -> (complete: bool, row: usize):
            count: usize = functions.lookup.source.names.count
            return (false, count) if:
                functions.call_graph.all_calls.count != functions.call_graph.all_call_targets.count
                edge >= functions.call_graph.all_calls.count
            target: usize = functions.call_graph.all_call_targets[edge]
            return (false, count) if target > count
            return (true, target)

        # The resolved target table is canonical after call resolution. Never reconstruct a
        # missing row from its spelling: that would hide malformed metadata and add a linear scan.
        def proof_function_call_target(functions: ProofFunctionTable&, edge: usize) -> usize:
            target: (complete: bool, row: usize) = proof_scheduled_call_target(functions, edge)
            return target.row if target.complete
            return functions.lookup.source.names.count

        # The row of the function whose body is being checked, by its name. A repeated name
        # resolves to the scheduled caller when it bears that name.
        def proof_function_index_of_current(functions: ProofFunctionTable&, name: sview) -> usize:
            return functions.lookup.source.names.count if functions.call_graph.current_caller_is_lemma
            direct: usize = proof_function_index(functions, name)
            return direct if direct < functions.lookup.source.names.count
            return functions.call_graph.current_caller if functions.call_graph.current_caller < functions.lookup.source.names.count and functions.lookup.source.names[functions.call_graph.current_caller] == name
            return functions.lookup.source.names.count

        # Resolve a call's callee from the function whose body is being checked.
        def proof_function_index_for_callee(functions: mutable ProofFunctionTable&, callee: Ast::Expr) -> usize:
            return functions.lookup.source.names.count if functions.lookup.work.module_resolution_work_exhausted
            resolved: (complete: bool, row: usize) = proof_function_index_for_callee_with_module_work(functions, functions.call_graph.current_caller_module, callee, functions.lookup.work.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if functions.call_graph.current_caller_is_lemma else proof_function_index_for_callee_with_work(functions, functions.call_graph.current_caller, callee, functions.lookup.work.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            if not resolved.complete:
                functions.lookup.work.module_resolution_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                functions.lookup.work.module_resolution_work_exhausted <- true
                return functions.lookup.source.names.count
            return resolved.row
