extend ElisaProof:
    private:
        # A struct-level `invariant EXPR` promises every value of the type satisfies EXPR. Neither
        # the compiler's semantic checks nor this checker establish that promise at construction
        # or preserve it across field writes yet, so a file that declares one cannot be reported
        # as verified: the reader of the source would take the invariant as proven. Refuse it
        # until the obligations are generated.
        def proof_refuse_struct_invariants(declaration: Ast::Decl, report: mutable ProofReport&) -> void:
            match declaration:
                Ast::Decl.Struct(name, _, _, _, _, invariants, position):
                    if invariants.count > 0:
                        report.proof_obligation(false)
                        proof_add_finding(report, "declaration-unsupported", position.line, name, "struct invariant is not verified: it is neither established at construction nor preserved by field writes")
                _:
                    pass
