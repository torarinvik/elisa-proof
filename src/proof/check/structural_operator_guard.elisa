extend ElisaProof:
    private:
        const PROOF_STRUCTURAL_OPERATOR_GUARD_BUCKET_LIMIT: usize = 64

        # Check aliases and underlying names. The name index also checks same-named nominal
        # declarations; aliases without a known caller owner may expand only from root.
        def proof_structural_operator_guard_expand_aliases(name: sview, names: mutable darray[sview]&, report: mutable ProofReport&, depth: usize, caller_owner: sview, caller_owner_known: bool) -> bool:
            return false if:
                depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT or name == ""
                not proof_source_index_work_charge(report, 1)
            for existing in names |name, names, report|:
                return false if:
                    not proof_source_index_work_charge(report, 1)
                    not proof_source_index_work_charge(report, sview_len(name))
                    not proof_source_index_work_charge(report, sview_len(existing))
                    existing == name
            names.push(name)
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            alias_row: mutable usize = index.aliases.alias_names.count
            alias_target: mutable Ast::Expr = Ast::Expr.Absent
            alias_found: mutable bool = false
            if caller_owner_known:
                owner_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_source_conversion_alias_target_in_owner(name, caller_owner, report)
                return false if not owner_target.complete or owner_target.count > 1
                if owner_target.count == 1:
                    return false if owner_target.row >= index.aliases.alias_owners.count or index.aliases.alias_owners.count != index.aliases.alias_names.count or index.aliases.alias_owners[owner_target.row] != caller_owner
                    alias_row <- owner_target.row
                    alias_target <- owner_target.target
                    alias_found <- true
                elif owner_target.nominal or owner_target.blocks_parent:
                    return true
                if not alias_found and caller_owner != "":
                    root_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_source_conversion_alias_target_in_owner(name, "", report)
                    return false if not root_target.complete or root_target.count > 1
                    if root_target.count == 1:
                        return false if root_target.row >= index.aliases.alias_owners.count or index.aliases.alias_owners.count != index.aliases.alias_names.count or index.aliases.alias_owners[root_target.row] != ""
                        alias_row <- root_target.row
                        alias_target <- root_target.target
                        alias_found <- true
                    elif root_target.nominal or root_target.blocks_parent:
                        return true
                if not alias_found:
                    global_target: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_source_conversion_alias_target(name, report)
                    return false if not global_target.complete or global_target.count > 1
                    return true if global_target.count == 0
                    return false if global_target.row >= index.aliases.alias_owners.count or index.aliases.alias_owners.count != index.aliases.alias_names.count
                    alias_row <- global_target.row
                    alias_target <- global_target.target
                    alias_found <- true
            else:
                target: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_source_conversion_alias_target(name, report)
                return false if not target.complete or target.count > 1
                return true if target.count == 0
                return false if target.row >= index.aliases.alias_owners.count or index.aliases.alias_owners.count != index.aliases.alias_names.count
                # A synthetic caller can only use an unambiguous root alias.
                return false if index.aliases.alias_owners[target.row] != ""
                alias_row <- target.row
                alias_target <- target.target
                alias_found <- true
            return true if not alias_found or alias_row >= index.aliases.alias_lines.count or alias_row >= index.aliases.alias_offsets.count
            return false if index.aliases.alias_lines.count != index.aliases.alias_names.count or index.aliases.alias_offsets.count != index.aliases.alias_names.count
            alias_owner: sview = index.aliases.alias_owners[alias_row]
            target_name: sview = proof_structural_operator_guard_type_name(alias_target, report, depth + 1)
            return false if target_name == ""
            return proof_structural_operator_guard_expand_aliases(target_name, names, report, depth + 1, alias_owner, true)

        def proof_structural_operator_guard_generic_bound_matches(bound: sview, protocol: sview) -> bool:
            return true if bound in {"", "All"} or bound == protocol
            return protocol == "Ord" and bound == "Less"

        def proof_structural_operator_guard_generic_bound_overloaded(report: mutable ProofReport&, concrete: sview, protocol: sview, all_receivers: bool) -> bool:
            for annotation in report.source.source_annotations |concrete, protocol, all_receivers, report|:
                return true if:
                    not proof_source_index_work_charge(report, 1)
                    not proof_source_index_work_charge(report, sview_len(annotation.owner))
                    not proof_source_index_work_charge(report, sview_len(annotation.name))
                    not all_receivers and not proof_source_index_work_charge(report, sview_len(concrete))
                    not proof_source_index_work_charge(report, sview_len(protocol))
                continue if annotation.line != 3900000130
                continue if not all_receivers and annotation.owner != concrete
                return true if proof_structural_operator_guard_generic_bound_matches(annotation.name, protocol)
            return false

        def proof_structural_operator_guard_global_overloaded(report: mutable ProofReport&, protocol: sview) -> bool:
            return true if proof_source_primitive_operator_mask_has(report.source.source_operator_protocol_mask, protocol)
            return proof_structural_operator_guard_generic_bound_overloaded(report, "", protocol, true)

        # Newest local binding wins. Typed field and built-in container projections retain their
        # declared result type; inferred locals and ambiguous projections remain unknown.
        def proof_structural_operator_guard_receiver_name(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, shadowed: darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&, depth: usize) -> (known: bool, name: sview):
            receiver: (known: bool, type_expression: Ast::Expr) = proof_structural_operator_guard_receiver_type(expression, parameters, shadowed, report, depth)
            return (false, "") if not receiver.known
            name: sview = proof_structural_operator_guard_type_name(receiver.type_expression, report, 0)
            return (false, "") if name == ""
            return (true, name)

        def proof_structural_operator_guard_type_name(type_expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> sview:
            return "" if:
                depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT
                not proof_source_index_work_charge(report, 1)
            match type_expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Index(head, _, _):
                    return "darray" if proof_ident_name(head) == "darray"
                    return ""
                # Do not erase the qualifier. A module-scoped nominal type can share a
                # primitive's final spelling; treating `module::i32` as scalar would admit
                # compound assignment even though the backend only lowers scalar targets.
                Ast::Expr.Scope(_, _, _):
                    return ""
                Ast::Expr.Paren(inner, _):
                    return proof_structural_operator_guard_type_name(inner, report, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_structural_operator_guard_type_name(base, report, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_structural_operator_guard_type_name(inner, report, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                _:
                    return ""

        def proof_structural_operator_guard_pattern_shadow(pattern: Ast::Pattern, shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT
                not proof_source_index_work_charge(report, 1)
            match pattern:
                Ast::Pattern.Binding(name) | Ast::Pattern.Rest(name):
                    return false if not proof_structural_operator_guard_add_binding(name, &shadowed, report)
                Ast::Pattern.As(name, inner):
                    return false if not proof_structural_operator_guard_add_binding(name, &shadowed, report)
                    for subpattern in inner |shadowed, report, depth|:
                        return false if not proof_structural_operator_guard_pattern_shadow(subpattern, &shadowed, report, depth + 1)
                Ast::Pattern.TypeBind(_, binder):
                    return false if not proof_structural_operator_guard_add_binding(binder, &shadowed, report)
                Ast::Pattern.Variant(_, fields) | Ast::Pattern.Struct(_, fields) | Ast::Pattern.Field(_, fields) | Ast::Pattern.Tuple(fields) | Ast::Pattern.Or(fields):
                    for subpattern in fields |shadowed, report, depth|:
                        return false if not proof_structural_operator_guard_pattern_shadow(subpattern, &shadowed, report, depth + 1)
                Ast::Pattern.Wildcard | Ast::Pattern.Literal(_) | Ast::Pattern.Pin(_) | Ast::Pattern.Range(_, _, _):
                    pass
                _:
                    return false
            return true
        # Preserve Is/As binders as unknown typed locals, shadowing older formals and locals.
        def proof_structural_operator_guard_add_aliases(aliases: darray[sview], shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&) -> bool:
            for alias in aliases |alias, shadowed, report|:
                return false if not proof_structural_operator_guard_add_binding(alias, &shadowed, report)
            return true

        def proof_structural_operator_guard_add_condition_aliases(condition: Ast::Expr, shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&) -> bool:
            aliases: (complete: bool, aliases: darray[sview]) = proof_source_condition_true_aliases(condition, [], report)
            return false if not aliases.complete
            proof_structural_operator_guard_add_aliases(aliases.aliases, &shadowed, report)

        def proof_structural_operator_guard_add_false_condition_aliases(condition: Ast::Expr, shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&) -> bool:
            aliases: (complete: bool, aliases: darray[sview]) = proof_source_condition_false_aliases(condition, [], report)
            return false if not aliases.complete
            proof_structural_operator_guard_add_aliases(aliases.aliases, &shadowed, report)

        def proof_structural_operator_guard_add_comprehension_aliases(variable: sview, position: Ast::Pos, parameters: darray[Ast::ParamDecl]&, shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&) -> bool:
            inherited: mutable darray[sview] = []
            for binding in shadowed |inherited, report|:
                return false if:
                    not proof_source_index_work_charge(report, 1)
                    not proof_source_index_work_charge(report, sview_len(binding.name))
                inherited.push(binding.name)
            aliases: (complete: bool, aliases: darray[sview]) = proof_source_comprehension_aliases(variable, position, inherited, parameters, report)
            return false if not aliases.complete
            proof_structural_operator_guard_add_aliases(aliases.aliases, &shadowed, report)

        def proof_structural_operator_guard_add_typed_binding(name: sview, type_expression: Ast::Expr, shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&) -> bool:
            return false if name == ""
            type_name: sview = proof_structural_operator_guard_type_name(type_expression, report, 0)
            return false if:
                report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                not proof_source_index_work_charge(report, 1)
                not proof_source_index_work_charge(report, sview_len(name))
                not proof_source_index_work_charge(report, sview_len(type_name))
            shadowed.push(ProofStructuralOperatorBinding{name: name, type_name: type_name, type_expression: type_expression})
            return true

        def proof_structural_operator_guard_current_scope_has_binding(shadowed: darray[ProofStructuralOperatorBinding]&, name: sview, scope_start: usize, report: mutable ProofReport&) -> (complete: bool, found: bool):
            return (false, false) if scope_start > shadowed.count
            index: mutable usize = shadowed.count
            while index > scope_start |index, shadowed, name, report|:
                index <- index - 1
                binding: ProofStructuralOperatorBinding = shadowed[index]
                return (false, false) if:
                    not proof_source_index_work_charge(report, 1)
                    not proof_source_index_work_charge(report, sview_len(name))
                    not proof_source_index_work_charge(report, sview_len(binding.name))
                return (true, true) if binding.name == name
            return (true, false)

        # `=` introduces an inferred local when the target is not already bound in this
        # statement scope. This walk cannot establish that local's type, so the unknown entry
        # must shadow outer typed bindings before subsequent expressions are checked.
        def proof_structural_operator_guard_add_fresh_assignment_bindings(target: Ast::Expr, parameters: darray[Ast::ParamDecl]&, shadowed: mutable darray[ProofStructuralOperatorBinding]&, scope_start: usize, report: mutable ProofReport&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT
                not proof_source_index_work_charge(report, 1)
            match target:
                Ast::Expr.Ident(name, _):
                    return false if name == ""
                    current_scope: (complete: bool, found: bool) = proof_structural_operator_guard_current_scope_has_binding(shadowed, name, scope_start, report)
                    return false if not current_scope.complete
                    return true if current_scope.found
                    return false if proof_source_fresh_assignment_shadows_parameter(target, parameters, report, depth + 1)
                    return proof_structural_operator_guard_add_binding(name, &shadowed, report)
                Ast::Expr.Paren(inner, _):
                    return proof_structural_operator_guard_add_fresh_assignment_bindings(inner, parameters, &shadowed, scope_start, report, depth + 1)
                Ast::Expr.Tuple(elements, _) | Ast::Expr.Array(elements, _):
                    for element in elements |parameters, shadowed, scope_start, report, depth|:
                        return false if not proof_structural_operator_guard_add_fresh_assignment_bindings(element, parameters, &shadowed, scope_start, report, depth + 1)
                    return true
                _:
                    return false

        def proof_structural_operator_guard_pair_work_charge(report: mutable ProofReport&, concrete: sview) -> bool:
            return false if:
                not report.analysis_1.operator_impls.valid or report.analysis_1.operator_impls.rows.count != report.analysis_1.operator_impls.hashes.count or report.analysis_1.operator_impls.rows.count != report.analysis_1.operator_impls.next_indices.count or report.analysis_1.operator_impls.bucket_heads.count == 0
                not proof_source_index_work_charge(report, 1)
                not proof_source_index_work_charge(report, sview_len(concrete))
            hash: u32 = proof_operator_impl_hash(concrete, "")
            capacity: usize = report.analysis_1.operator_impls.bucket_heads.count
            slot: usize = (hash.i64() % capacity.i64()).usize()
            entry: mutable usize = report.analysis_1.operator_impls.bucket_heads[slot]
            return false if entry > report.analysis_1.operator_impls.rows.count
            steps: mutable usize = 0
            maximum_concrete_width: mutable usize = 0
            while entry < report.analysis_1.operator_impls.rows.count and steps < PROOF_STRUCTURAL_OPERATOR_GUARD_BUCKET_LIMIT |entry, steps, report, concrete|:
                return false if:
                    entry >= report.analysis_1.operator_impls.next_indices.count
                    not proof_source_index_work_charge(report, 1)
                implementation: ProofOperatorImpl = report.analysis_1.operator_impls.rows[entry]
                concrete_width: usize = sview_len(implementation.concrete)
                return false if:
                    not proof_source_index_work_charge(report, concrete_width)
                maximum_concrete_width <- concrete_width if concrete_width > maximum_concrete_width
                next_entry: usize = report.analysis_1.operator_impls.next_indices[entry]
                return false if next_entry > report.analysis_1.operator_impls.rows.count
                entry <- next_entry
                steps <- steps + 1
            return false if entry < report.analysis_1.operator_impls.rows.count
            # The indexed lookup repeats the hash and follows the same bounded chain. Reserve
            # its full candidate name comparisons before calling the shared lookup helper.
            return false if:
                not proof_source_index_work_charge(report, 1)
                not proof_source_index_work_charge(report, sview_len(concrete))
            for _probe in 0..<steps |steps, report, concrete|:
                return false if:
                    not proof_source_index_work_charge(report, 1)
                    not proof_source_index_work_charge(report, sview_len(concrete))
                    not proof_source_index_work_charge(report, maximum_concrete_width)
            return true

        def proof_structural_operator_guard_lookup_work_charge(report: mutable ProofReport&, concrete: sview) -> bool:
            proof_structural_operator_guard_pair_work_charge(report, concrete)

        # Known parameter types use their own implementation rows; unknowns use global fallback.
        def proof_structural_operator_guard_overloaded_for_receiver(receiver: Ast::Expr, protocol: sview, parameters: darray[Ast::ParamDecl]&, shadowed: darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&, depth: usize, declaration_line: u32, caller_owner: sview, caller_owner_known: bool) -> bool:
            return true if:
                depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT
                report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            concrete: (known: bool, name: sview) = proof_structural_operator_guard_receiver_name(receiver, parameters, shadowed, report, depth + 1)
            return true if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return proof_structural_operator_guard_global_overloaded(report, protocol) if not concrete.known
            concrete_names: mutable darray[sview] = []
            generic: (complete: bool, count: usize) = proof_source_conversion_generic_name(concrete.name, declaration_line, report, caller_owner_known)
            return true if not generic.complete
            if generic.count > 0:
                concrete_names.push(concrete.name)
            else:
                return proof_structural_operator_guard_global_overloaded(report, protocol) if not proof_structural_operator_guard_expand_aliases(concrete.name, &concrete_names, report, 0, caller_owner, caller_owner_known)
            return true if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for concrete_name in concrete_names |concrete_name, protocol, report|:
                return true if proof_structural_operator_guard_generic_bound_overloaded(report, concrete_name, protocol, false)
            return true if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return proof_structural_operator_guard_global_overloaded(report, protocol) if not report.analysis_1.operator_impls.valid
            return false if report.analysis_1.operator_impls.rows.count == 0
            for concrete_name in concrete_names |concrete_name, protocol, report|:
                return true if:
                    not proof_structural_operator_guard_lookup_work_charge(report, concrete_name)
                    report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    proof_report_builtin_operator_impl_exists(report, concrete_name, protocol)
            return false

        def proof_structural_operator_guard_numeric_compound_type(name: sview) -> bool:
            return true if:
                name in {"i8", "i16", "i32", "i64", "i128", "isize", "int"}
                name in {"u8", "u16", "u32", "u64", "u128", "usize", "uintptr", "byte"}
            return name in {"f32", "f64", "char"}

        def proof_structural_operator_guard_integer_compound_type(name: sview) -> bool:
            return true if:
                name in {"i8", "i16", "i32", "i64", "i128", "isize", "int"}
                name in {"u8", "u16", "u32", "u64", "u128", "usize", "uintptr", "byte"}
            return name == "char"

        # Compound assignment has no source-protocol dispatch in codegen. Accept only a
        # receiver whose compiler lowering is known: numeric scalars, or the built-in darray
        # push form for +=. Unknown/Named types are rejected because semantic checking can
        # accept them as possible overloads even though the backend does not lower one.
        def proof_structural_operator_guard_direct_darray_shape(type_expression: Ast::Expr, declaration_line: u32, report: mutable ProofReport&, depth: usize, caller_owner: sview, caller_owner_known: bool) -> bool:
            return false if:
                depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT
                not proof_source_index_work_charge(report, 1)
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _) | Ast::Expr.Unary(TokenKind.Mutable, inner, _) | Ast::Expr.Unary(TokenKind.Ampersand, inner, _) | Ast::Expr.Unary(TokenKind.Lmut, inner, _) | Ast::Expr.Unary(TokenKind.Static, inner, _) | Ast::Expr.Unary(TokenKind.Heap, inner, _) | Ast::Expr.Unary(TokenKind.Stack, inner, _) | Ast::Expr.Unary(TokenKind.Tail, inner, _):
                    return proof_structural_operator_guard_direct_darray_shape(inner, declaration_line, report, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.Index(head, _, _):
                    seen: mutable darray[usize] = []
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(head, declaration_line, true, caller_owner, caller_owner_known, report, &seen, 0)
                    match unwrapped_head.type_expression:
                        Ast::Expr.Ident(name, _):
                            return unwrapped_head.complete and name == "darray"
                        _:
                            return false
                Ast::Expr.IndexN(head, arguments, _):
                    return false if arguments.count != 1
                    seen: mutable darray[usize] = []
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(head, declaration_line, true, caller_owner, caller_owner_known, report, &seen, 0)
                    match unwrapped_head.type_expression:
                        Ast::Expr.Ident(name, _):
                            return unwrapped_head.complete and name == "darray"
                        _:
                            return false
                _:
                    return false

        def proof_structural_operator_guard_compound_unsupported(receiver: Ast::Expr, protocol: sview, parameters: darray[Ast::ParamDecl]&, shadowed: darray[ProofStructuralOperatorBinding]&, declaration_line: u32, report: mutable ProofReport&, caller_owner: sview, caller_owner_known: bool) -> bool:
            concrete: (known: bool, type_expression: Ast::Expr) = proof_structural_operator_guard_receiver_type(receiver, parameters, shadowed, report, 0)
            return true if not concrete.known
            seen: mutable darray[usize] = []
            unwrapped: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(concrete.type_expression, declaration_line, true, caller_owner, caller_owner_known, report, &seen, 0)
            if unwrapped.complete:
                match unwrapped.type_expression:
                    Ast::Expr.Ident(name, _):
                        return true if:
                            not proof_structural_operator_guard_numeric_compound_type(name)
                            (protocol in {"BitXor", "BitOr", "BitAnd"}) and not proof_structural_operator_guard_integer_compound_type(name)
                        # The pinned backend lowers scalar compound assignments through
                        # `emit_binary` directly. Operator implementation rows only affect
                        # struct operands in ordinary binary expressions, and the aggregate
                        # primitive mask would reject this scalar for an unrelated type's impl.
                        return false
                    Ast::Expr.Index(head, _, _):
                        head_is_darray: bool = match head:
                            Ast::Expr.Ident(name, _): name == "darray"
                            _: false
                        return false if protocol == "Add" and head_is_darray
                    Ast::Expr.IndexN(head, arguments, _):
                        head_is_darray: bool = match head:
                            Ast::Expr.Ident(name, _): name == "darray"
                            _: false
                        return false if protocol == "Add" and head_is_darray and arguments.count == 1
                    _:
                        pass
            if protocol == "Add" and proof_structural_operator_guard_direct_darray_shape(concrete.type_expression, declaration_line, report, 0, caller_owner, caller_owner_known):
                return false
            return true

        def proof_structural_typed_operator_expression_inner(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&, declaration_line: u32, depth: usize, caller_owner: sview, caller_owner_known: bool) -> bool:
            return true if:
                depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT
                not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    protocol: sview = proof_builtin_unary_operator_protocol(operator)
                    return true if protocol != "" and proof_structural_operator_guard_overloaded_for_receiver(operand, protocol, parameters, shadowed, report, 0, declaration_line, caller_owner, caller_owner_known)
                    return proof_structural_typed_operator_expression_inner(operand, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.Binary(_, TokenKind.And, _, _) | Ast::Expr.Binary(_, TokenKind.Or, _, _):
                    return proof_structural_typed_operator_condition_inner(expression, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.Binary(left, operator, right, _):
                    protocol: sview = proof_builtin_operator_protocol(operator)
                    return true if protocol != "" and proof_structural_operator_guard_overloaded_for_receiver(left, protocol, parameters, shadowed, report, 0, declaration_line, caller_owner, caller_owner_known)
                    return proof_structural_typed_operator_expression_inner(left, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known) or proof_structural_typed_operator_expression_inner(right, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_structural_typed_operator_expression_inner(inner, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_structural_typed_operator_expression_inner(base, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known) or proof_structural_typed_operator_expression_inner(predicate, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_structural_typed_operator_expression_inner(callee, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    for argument in arguments |parameters, shadowed, report, depth, caller_owner, caller_owner_known|:
                        return true if proof_structural_typed_operator_expression_inner(argument, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    return false
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                    return proof_structural_typed_operator_expression_inner(object, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.Index(object, index, _):
                    return proof_structural_typed_operator_expression_inner(object, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known) or proof_structural_typed_operator_expression_inner(index, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_structural_typed_operator_expression_inner(object, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    for argument in arguments |parameters, shadowed, report, depth, caller_owner, caller_owner_known|:
                        return true if proof_structural_typed_operator_expression_inner(argument, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_structural_typed_operator_expression_inner(object, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known) or proof_structural_typed_operator_expression_inner(low, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known) or proof_structural_typed_operator_expression_inner(high, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return true if proof_structural_typed_operator_condition_inner(condition, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    saved_count: usize = shadowed.count
                    return true if not proof_structural_operator_guard_add_condition_aliases(condition, &shadowed, report)
                    found: bool = proof_structural_typed_operator_expression_inner(then_expression, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    while shadowed.count > saved_count |shadowed, saved_count|:
                        shadowed.pop()
                    return true if found
                    else_count: usize = shadowed.count
                    return true if not proof_structural_operator_guard_add_false_condition_aliases(condition, &shadowed, report)
                    else_found: bool = proof_structural_typed_operator_expression_inner(else_expression, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    while shadowed.count > else_count |shadowed, else_count|:
                        shadowed.pop()
                    else_found
                Ast::Expr.Comprehension(variable, iterable, condition, body, position):
                    return true if proof_structural_typed_operator_expression_inner(iterable, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    shadow_count: usize = shadowed.count
                    return true if not proof_structural_operator_guard_add_comprehension_aliases(variable, position, parameters, &shadowed, report)
                    filter_test: mutable Ast::Expr = condition
                    filter_guard: mutable Ast::Expr = Ast::Expr.Absent
                    match condition:
                        Ast::Expr.Binary(left, TokenKind.And, right, _):
                            bare_pattern: (complete: bool, matches: bool) = proof_source_bare_variant_filter_shape(left, report)
                            return true if not bare_pattern.complete
                            is_pattern_test: mutable bool = bare_pattern.matches
                            match left:
                                Ast::Expr.Binary(_, TokenKind.Is, _, _):
                                    is_pattern_test <- true
                                _:
                                    pass
                            if is_pattern_test:
                                filter_test <- left
                                filter_guard <- right
                        _:
                            pass
                    return true if proof_structural_typed_operator_expression_inner(filter_test, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    filter_bindings: mutable darray[sview] = []
                    return true if not proof_structural_operator_guard_collect_refinement_bindings(filter_test, &filter_bindings, report)
                    for binding in filter_bindings |shadowed, report|:
                        return true if not proof_structural_operator_guard_add_binding(binding, &shadowed, report)
                    return true if proof_structural_typed_operator_expression_inner(filter_guard, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    found: bool = proof_structural_typed_operator_expression_inner(body, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    while shadowed.count > shadow_count |shadowed, shadow_count|:
                        shadowed.pop()
                    return found
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_structural_typed_operator_expression_inner(guarded, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known) or proof_structural_typed_operator_statements_inner(recovery, parameters, &shadowed, report, declaration_line, depth + 1, true, caller_owner, caller_owner_known)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |parameters, shadowed, report, depth, caller_owner, caller_owner_known|:
                        return true if proof_structural_typed_operator_expression_inner(element, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |parameters, shadowed, report, depth, caller_owner, caller_owner_known|:
                        return true if proof_structural_typed_operator_expression_inner(entry.key, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known) or proof_structural_typed_operator_expression_inner(entry.value, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    return true if proof_structural_typed_operator_expression_inner(type_expression, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    for field in fields |parameters, shadowed, report, depth, caller_owner, caller_owner_known|:
                        return true if proof_structural_typed_operator_expression_inner(field.value, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_structural_typed_operator_expression_inner(base, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    for field in fields |parameters, shadowed, report, depth, caller_owner, caller_owner_known|:
                        return true if proof_structural_typed_operator_expression_inner(field.value, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    return false
                Ast::Expr.Match(scrutinee, arms, _) | Ast::Expr.Catch(scrutinee, arms, _):
                    return true if proof_structural_typed_operator_expression_inner(scrutinee, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    for arm in arms |parameters, shadowed, report, depth, caller_owner, caller_owner_known|:
                        saved_count: usize = shadowed.count
                        return true if:
                            not proof_structural_operator_guard_pattern_shadow(arm.pattern, &shadowed, report, 0)
                            proof_structural_typed_operator_expression_inner(arm.guard, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                        found: bool = proof_structural_typed_operator_statements_inner(arm.body, parameters, &shadowed, report, declaration_line, depth + 1, true, caller_owner, caller_owner_known)
                        while shadowed.count > saved_count |shadowed, saved_count|:
                            shadowed.pop()
                        return true if found
                    return false
                Ast::Expr.Lambda(_, body, _):
                    empty_parameters: darray[Ast::ParamDecl] = []
                    empty_shadowed: mutable darray[ProofStructuralOperatorBinding] = []
                    return proof_structural_typed_operator_statements_inner(body, empty_parameters, &empty_shadowed, report, declaration_line, depth + 1, true, caller_owner, caller_owner_known)
                Ast::Expr.Block(statements, value, _, _):
                    saved_count: usize = shadowed.count
                    return true if proof_structural_typed_operator_statements_inner(statements, parameters, &shadowed, report, declaration_line, depth + 1, false, caller_owner, caller_owner_known)
                    found: bool = proof_structural_typed_operator_expression_inner(value, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    while shadowed.count > saved_count |shadowed, saved_count|:
                        shadowed.pop()
                    return found
                Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Absent:
                    return false
                _:
                    return true

        def proof_structural_typed_operator_condition_inner(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&, declaration_line: u32, depth: usize, caller_owner: sview, caller_owner_known: bool) -> bool:
            return true if depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return true if not proof_source_index_work_charge(report, 1)
                    return proof_structural_typed_operator_condition_inner(inner, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_structural_typed_operator_expression_inner(expression, parameters, &shadowed, report, declaration_line, depth, caller_owner, caller_owner_known) if operator != TokenKind.And and operator != TokenKind.Or
                    return true if not proof_source_index_work_charge(report, 1)
                    protocol: sview = proof_builtin_operator_protocol(operator)
                    return true if:
                        protocol != "" and proof_structural_operator_guard_overloaded_for_receiver(left, protocol, parameters, shadowed, report, 0, declaration_line, caller_owner, caller_owner_known)
                        proof_structural_typed_operator_condition_inner(left, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    if operator == TokenKind.And:
                        saved_count: usize = shadowed.count
                        return true if not proof_structural_operator_guard_add_condition_aliases(left, &shadowed, report)
                        found: bool = proof_structural_typed_operator_condition_inner(right, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                        while shadowed.count > saved_count |shadowed, saved_count|:
                            shadowed.pop()
                        return found
                    saved_count: usize = shadowed.count
                    return true if not proof_structural_operator_guard_add_false_condition_aliases(left, &shadowed, report)
                    found: bool = proof_structural_typed_operator_condition_inner(right, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    while shadowed.count > saved_count |shadowed, saved_count|:
                        shadowed.pop()
                    return found
                _:
                    return proof_structural_typed_operator_expression_inner(expression, parameters, &shadowed, report, declaration_line, depth, caller_owner, caller_owner_known)
