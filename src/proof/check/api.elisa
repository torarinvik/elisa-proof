const PROOF_SEMANTIC_DIAGNOSTIC_LIMIT: usize = 64
const PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT: usize = 64
# Guarded arm facts imported per arm at a conditional join (G75); each costs a disjunction.
const PROOF_JOIN_GUARDED_FACT_LIMIT: usize = 8
const PROOF_SOURCE_KERNEL_WORKSPACE_ARENA_BYTES: usize = 1048576

extend ElisaProof:
    public:
        # Reuse the caller-owned report storage while making every verification run independent.
        # Clearing in place is deliberately used instead of assigning a fresh report: the report
        # contains compiler-owned AST values, and stage0 correctly rejects a whole-struct
        # assignment that could move those values across an inferred region boundary.
        def proof_reset_report(report: mutable ProofReport&) -> void:
            report.frame_producer.names.clear()
            report.frame_producer.lines.clear()
            report.frame_producer.starts.clear()
            report.frame_producer.counts.clear()
            report.frame_producer.rows.clear()
            report.frame_producer.active_name <- ""
            report.declarations <- 0
            report.obligations <- 0
            report.proven <- 0
            report.failed <- 0
            report.source_annotations.clear()
            report.source_primitive_operator_mask <- PROOF_SOURCE_OPERATOR_MASK_EMPTY
            report.operator_impls.rows.clear()
            report.operator_impls.hashes.clear()
            report.operator_impls.bucket_heads.clear()
            report.operator_impls.next_indices.clear()
            report.operator_impls.valid <- false
            report.source_declarations.clear()
            report.protocol_transition_positions.clear()
            report.source_extern_parameters.clear()
            report.source_region_param_lines.clear()
            report.findings.clear()
            report.focused_unrequested_findings.clear()
            report.counterexample_facts.clear()
            report.goal_attempts.clear()
            report.obligation_inventory.clear()
            report.focused_function <- ""
            report.certificates.clear()
            report.certificate_facts.clear()
            report.kernel.nodes.clear()
            report.kernel.children.clear()
            report.kernel.budget_exhausted <- false
            report.kernel.budget_reported <- false
            report.kernel.arena_validated <- false
            report.kernel.certificate_facts.clear()
            report.kernel.fact_trace_premises.clear()
            report.traces.records.clear()
            report.global_constant_trace_ids.clear()
            report.traces.origin_indices.clear()
            report.traces.index_hashes.clear()
            report.traces.index_values.clear()
            report.traces.next_indices.clear()
            proof_goal_cache_reset(report)
            report.type_bounds.seen.clear()
            report.type_bounds.seen_hashes.clear()
            report.type_bounds.owner <- ""
            report.traces.active_start <- 0
            report.budgets.frame_call_steps <- 0
            report.budgets.frame_call_reported <- false
            report.budgets.resource_steps <- 0
            report.budgets.resource_reported <- false
            report.budgets.return_steps <- 0
            report.budgets.return_step_budget <- 0
            report.budgets.return_reported <- false
            report.budgets.return_fact_state_budget <- 0
            report.current_return_unsigned_width <- 0
            report.current_return_signed_width <- 0
            report.traces.premises.clear()
            report.traces.summary_names.clear()
            report.traces.summary_values.clear()
            report.traces.summary_require_goal_ids.clear()
            report.executables.parameter_references.clear()
            report.declaration_details.clear()
            report.declaration_parameters.clear()
            report.theorems.summaries.clear()
            report.theorems.parameters.clear()
            report.theorems.parameter_types.clear()
            report.theorems.parameter_has_defaults.clear()
            report.theorems.parameter_defaults.clear()
            report.theorems.requires.clear()
            report.theorems.ensures.clear()
            report.theorems.decreases.clear()
            report.theorems.proof_goal_ids.clear()
            report.executables.summaries.clear()
            report.executables.parameters.clear()
            report.executables.requires.clear()
            report.executables.ensures.clear()
            report.structural.names.clear()
            report.structural.subject_positions.clear()
            report.structural.subject_types.clear()
            report.structural.component_ids.clear()
            report.structural.members.clear()
            report.structural.verified_names.clear()
            report.structural.identity_next <- 0
            report.declaration_effects.clear()
            report.aliased_names.clear()
            report.escaping_names.clear()
            report.shared_extent_names.clear()
            report.shared_fixed_names.clear()
            report.local_extent_names.clear()
            report.value_binding_names.clear()
            report.reference_local_names.clear()
            report.aliased_owner <- ""
            report.rebind_symbols <- 0
            report.threaded_symbols.clear()
            report.value_thread_site <- false
            report.scalar_witness_facts <- 0
            report.replayed <- 0
            report.replay_gaps <- 0

        # The semantic table is deliberately consumed only by this short source-formation
        # phase.  The table owns a large collection of compiler indexes; keeping it alive while
        # the proof schedules, checks, and records every declaration made full-file audits retain
        # two whole-program working sets at once.  Returning before the proof phase lets Elisa
        # release those indexes without weakening the source-typing boundary.
        def proof_prepare_source(file: Ast::File&, report: mutable ProofReport&, source_types: Semantic::SymbolTable&) -> bool:
            # A report is a complete verification transaction, not an append-only session. Reset
            # every arena and counter before importing a new file; retaining certificates or
            # provenance from a previous file could make a later report observe stale proof state.
            proof_reset_report(report)
            report.source_declarations.extend(file.top_decls)
            report.source_extern_parameters.extend(file.extern_params)
            # Lines of functions with region parameters: a lend to one may outlive the call.
            for annotation in file.local_region_annotations |report|:
                report.source_region_param_lines.push(annotation.line) if annotation.name == "__region_param"
            for transition_position in source_types.protocol_transition_admitted |report|:
                report.protocol_transition_positions.push(transition_position)
            # The source-neutral kernel does not know whether a call, field, or index denotes a
            # Boolean in Elisa. Reuse the compiler's parsed-program type context and reject
            # ill-formed source contracts before they can seed hypotheses or certificates.
            internal_name: (found: bool, name: sview, line: u32) = proof_find_internal_name_collision(source_types)
            if internal_name.found:
                proof_add_finding(report, "proof-internal-name", internal_name.line, internal_name.name, "source identifier collides with a proof-system internal name")
                return false
            region r(PROOF_SOURCE_KERNEL_WORKSPACE_ARENA_BYTES):
                kernel_global_bindings: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding] = []
                kernel_type_entries: mutable darray[ProofSourceKernelTypeEntry] = []
                kernel_type_index_known: bool = proof_source_kernel_collect_type_index(file.top_decls, &kernel_type_entries, 0)
                kernel_type_index: mutable ProofSourceKernelTypeIndex = proof_source_kernel_build_type_index(kernel_type_entries)
                tuple_label_index: ProofSourceKernelTupleLabelIndex = proof_source_kernel_build_tuple_label_index(file.enum_annotations)
                kernel_workspace: mutable ProofSourceKernelFormationWorkspace = ProofSourceKernelFormationWorkspace{nodes: [], children: [], type_index: kernel_type_index, tuple_label_index: tuple_label_index, validation_workspace: ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new(), typing_workspace: ElisaProofKernelReplay::proof_kernel_replay_typing_workspace_new(), typing_work_used: 0}
                kernel_bindings_known: mutable bool = false
                if kernel_type_index_known:
                    kernel_bindings_known <- proof_source_kernel_global_bindings(file.top_decls, file.enum_annotations, tuple_label_index, kernel_type_index, &kernel_global_bindings)
                if kernel_bindings_known:
                    kernel_bindings_known <- ElisaProofKernelReplay::proof_kernel_replay_typing_workspace_prepare_globals(kernel_global_bindings, &kernel_workspace.typing_workspace)
                if kernel_bindings_known:
                    proof_validate_propositions_in_declarations(file, file.top_decls, kernel_global_bindings, &kernel_workspace, source_types, report)
                else:
                    report.proof_obligation(false)
                    proof_add_finding(report, "contract-proposition-type", 0, "", "kernel typing declaration environment exceeded its bounded representation")
            return true

        # This is the large, source-independent proof phase.  It must not receive or retain the
        # compiler SymbolTable: all source proposition formation that needs it is complete above.
        def proof_check_core(file: Ast::File&, report: mutable ProofReport&, focus_function: sview) -> void:
            report.focused_function <- focus_function
            # Contract quantifier syntax is erased from the AST and recovered through this
            # compiler-owned side table. Preserve the exact source annotations in the report so
            # a source-bound tactic store cannot substitute script-supplied quantifier kinds.
            report.source_annotations.clear()
            for annotation in file.enum_annotations |report|:
                report.source_annotations.push(annotation)
            report.assert_hole_positions.clear()
            for hole in file.assert_hole_positions |report|:
                report.assert_hole_positions.push(hole)
            proof_build_operator_impl_index(report)
            report.source_primitive_operator_mask <- proof_source_primitive_operator_mask(report.source_annotations)
            lemmas: mutable ProofLemmaTable = proof_empty_lemmas()
            functions: mutable ProofFunctionTable = proof_empty_functions()
            lemma_markers: ProofLemmaAnnotationIndex = proof_lemma_annotation_index(file)
            proof_collect_lemmas(file, file.top_decls, lemma_markers, &lemmas)
            proof_build_lemma_index(&lemmas)
            proof_build_lemma_components(&lemmas)
            functions.type_audit_index <- proof_type_audit_index(file.top_decls)
            functions.enum_index <- proof_build_enum_index(file.top_decls)
            functions.frame_annotation_index <- proof_frame_annotation_index(file)
            proof_collect_local_region_bindings(file, &functions)
            proof_collect_mutable_local_bindings(file, &functions)
            proof_collect_loop_accumulators(file, &functions)
            declaration_path: mutable darray[usize] = []
            proof_collect_functions(file, file.top_decls, lemmas, &functions, &declaration_path, "", 0)
            proof_build_function_index(&functions)
            proof_resolve_function_call_targets(&functions)
            proof_qualify_repeated_contract_rows(file, &functions)
            proof_build_function_components(&functions)
            proof_mark_pure_functions(file, file.top_decls, &functions, report)
            proof_check_structural_termination(file, file.top_decls, functions, report, true)
            proof_compute_verified_lemmas(file, file.top_decls, &lemmas, functions, report)
            proof_compute_verified_functions(file, file.top_decls, lemmas, &functions, report, focus_function)
            proof_record_declarations(file, file.top_decls, lemmas, functions, report)

        # Public compatibility wrapper for standalone proof consumers.  The semantic table is
        # owned by this short helper and is gone before the larger proof core begins.
        def proof_check(file: Ast::File&, report: mutable ProofReport&) -> void:
            ready: bool = proof_prepare_semantic_source(file, report)
            proof_check_core(file, report, "") if ready

        # Build compiler semantics once, prepare source propositions, and copy only structured
        # diagnostics. Returning releases the large compiler symbol table before the proof core,
        # replay, and JSON rendering retain their own working sets.
        def proof_check_with_semantic_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> void:
            ready: bool = proof_prepare_semantic_source_with_diagnostics(file, report, diagnostics)
            proof_check_core(file, report, "") if ready

        # Focused runs retain whole-file semantic/type context and the ordinary call-summary
        # scheduler, but spend the bounded proof arena only on the requested function and its
        # transitive executable callees. Unselected functions never gain verified summaries.
        def proof_check_focused_with_semantic_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&, focus_function: sview) -> void:
            ready: bool = proof_prepare_semantic_source_with_diagnostics(file, report, diagnostics)
            proof_check_core(file, report, focus_function) if ready

    private:
        def proof_semantic_diagnostic_refutes_obligation(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.LocalWhereRefinementViolated:
                    return true
                Semantic::DiagnosticKind.ParametricIndexViolated:
                    return true
                Semantic::DiagnosticKind.PreconditionProvablyViolated:
                    return true
                Semantic::DiagnosticKind.PreconditionViolated:
                    return true
                Semantic::DiagnosticKind.RefinementBoundViolated:
                    return true
                Semantic::DiagnosticKind.StructFieldRefinementViolated:
                    return true
                Semantic::DiagnosticKind.UsesPreconditionViolated:
                    return true
                Semantic::DiagnosticKind.WhereRefinementReassignViolated:
                    return true
                _:
                    return false
            return false

        def proof_semantic_diagnostic_leaves_obligation_open(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.LocalRefinementUnproven:
                    return true
                Semantic::DiagnosticKind.PreconditionUnproven:
                    return true
                Semantic::DiagnosticKind.QuantifiedRefinementUnproven:
                    return true
                Semantic::DiagnosticKind.RefinementArgNotProven:
                    return true
                Semantic::DiagnosticKind.RefinementReturnNotProven:
                    return true
                _:
                    return false
            return false

        def proof_semantic_diagnostic_is_non_exhaustive(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.NonExhaustiveMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveOptionalMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveScalarMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveOpenExternEnum:
                    return true
                _:
                    return false
            return false

        # Preserve the compiler driver's stage0-compatible diagnostic policy while sharing the
        # one semantic table with proof formation. Refuted obligations supersede weaker
        # "unproven" messages, non-exhaustive matches supersede a derived missing-return message,
        # and repeated ensure findings are collapsed by the same source identity as the compiler.
        def proof_copy_normalized_semantic_diagnostics(source: darray[Semantic::Diagnostic]&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> void:
            refuted_lines: mutable darray[u32] = []
            for diagnostic in source |refuted_lines|:
                refuted_lines.push(diagnostic.line) if proof_semantic_diagnostic_refutes_obligation(diagnostic.kind)
            ensure_violated_names: mutable darray[sview] = []
            ensure_violated_lines: mutable darray[u32] = []
            for diagnostic in source |ensure_violated_names, ensure_violated_lines|:
                if diagnostic.kind == Semantic::DiagnosticKind.EnsureNotProven and diagnostic.detail == "violated":
                    ensure_violated_names.push(diagnostic.name)
                    ensure_violated_lines.push(diagnostic.line)
            ensure_seen_names: mutable darray[sview] = []
            ensure_seen_lines: mutable darray[u32] = []
            ensure_seen_details: mutable darray[sview] = []
            for diagnostic in source |diagnostics, refuted_lines, ensure_violated_names, ensure_violated_lines, ensure_seen_names, ensure_seen_lines, ensure_seen_details|:
                skip: mutable bool = false
                if diagnostic.kind == Semantic::DiagnosticKind.MissingReturnValue:
                    for candidate in source |skip, diagnostic|:
                        skip <- true if candidate.line == diagnostic.line and proof_semantic_diagnostic_is_non_exhaustive(candidate.kind)
                if proof_semantic_diagnostic_leaves_obligation_open(diagnostic.kind):
                    for refuted_line in refuted_lines |skip, diagnostic|:
                        skip <- true if refuted_line == diagnostic.line
                if diagnostic.kind == Semantic::DiagnosticKind.EnsureNotProven:
                    ensure_seen: mutable bool = false
                    for index in 0..<ensure_seen_names.count |index, ensure_seen, ensure_seen_names, ensure_seen_lines, ensure_seen_details, diagnostic|:
                        ensure_seen <- true if ensure_seen_names[index] == diagnostic.name and ensure_seen_lines[index] == diagnostic.line and ensure_seen_details[index] == diagnostic.detail
                    if diagnostic.detail != "violated":
                        for index in 0..<ensure_violated_names.count |index, ensure_seen, ensure_violated_names, ensure_violated_lines, diagnostic|:
                            ensure_seen <- true if ensure_violated_names[index] == diagnostic.name and ensure_violated_lines[index] == diagnostic.line
                    if not ensure_seen:
                        ensure_seen_names.push(diagnostic.name)
                        ensure_seen_lines.push(diagnostic.line)
                        ensure_seen_details.push(diagnostic.detail)
                    skip <- true if ensure_seen
                diagnostics.push(diagnostic) if not skip

        def proof_prepare_semantic_source(file: Ast::File&, report: mutable ProofReport&) -> bool:
            source_types: mutable Semantic::SymbolTable = Semantic::SymbolTable()
            source_types <- Semantic::check_full_into(file, source_types, false, false, false, false, true, false, false, false, false, false, PROOF_SEMANTIC_DIAGNOSTIC_LIMIT, false, false)
            return proof_prepare_semantic_source_checked(file, report, source_types)

        def proof_prepare_semantic_source_with_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool:
            source_types: mutable Semantic::SymbolTable = Semantic::SymbolTable()
            source_types <- Semantic::check_full_into(file, source_types, false, false, false, false, true, false, false, false, false, false, PROOF_SEMANTIC_DIAGNOSTIC_LIMIT, false, false)
            ready: bool = proof_prepare_semantic_source_checked(file, report, source_types)
            proof_copy_normalized_semantic_diagnostics(source_types.diagnostics, diagnostics)
            return ready

        def proof_prepare_semantic_source_checked(file: Ast::File&, report: mutable ProofReport&, source_types: Semantic::SymbolTable&) -> bool:
            for diagnostic in source_types.diagnostics:
                match diagnostic.kind:
                    Semantic::DiagnosticKind.ExpressionAnalysisDepthExceeded:
                        # The compiler has proved that part of this AST was not semantically
                        # checked. Do not run the proof core over that unexamined subtree: it
                        # can neither establish a valid source judgment nor produce a trustworthy
                        # proof. Keep the rejection explicit and let CLI reporting preserve the
                        # compiler diagnostic; certificate replay on the empty report stays clean.
                        proof_reset_report(report)
                        proof_add_finding(report, "semantic-analysis-depth", diagnostic.line, "", "compiler semantic analysis reached its safe expression-depth limit; proof checking was skipped")
                        return false
                    _:
                        pass
            return proof_prepare_source(file, report, source_types)
