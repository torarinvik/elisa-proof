const PROOF_SEMANTIC_DIAGNOSTIC_LIMIT: usize = 64
const PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT: usize = 64
# Guarded arm facts imported per arm at a conditional join (G75); each costs a disjunction.
const PROOF_JOIN_GUARDED_FACT_LIMIT: usize = 8
const PROOF_SOURCE_KERNEL_WORKSPACE_ARENA_BYTES: usize = 1048576

extend ElisaProof:
    public:
        # Reuse the caller-owned report storage while making every verification run independent.
        # Clearing in place is deliberately used instead of assigning a fresh report: the report
        # contains compiler-owned AST values, and stage0 correctly rejects a whole-struct
        # assignment that could move those values across an inferred region boundary.
        def proof_reset_report(report: mutable ProofReport&) -> void:
            report.analysis_1.frame_producer.names.clear()
            report.analysis_1.frame_producer.lines.clear()
            report.analysis_1.frame_producer.offsets.clear()
            report.analysis_1.frame_producer.starts.clear()
            report.analysis_1.frame_producer.counts.clear()
            report.analysis_1.frame_producer.rows.clear()
            report.analysis_1.frame_producer.owner_lookup_hashes.clear()
            report.analysis_1.frame_producer.owner_lookup_slots.clear()
            report.analysis_1.frame_producer.owner_lookup_valid <- false
            report.analysis_1.frame_producer.owner_lookup_work_used <- 0
            report.analysis_1.frame_producer.source_preparation_complete <- false
            report.analysis_1.frame_producer.active_name <- ""
            report.results.declarations <- 0
            report.results.obligations <- 0
            report.results.producer_proven_count <- 0
            report.results.failed <- 0
            report.source.source_annotations.clear()
            report.source.source_annotation_args.clear()
            proof_source_analysis_indexes_reset(report)
            report.source.source_declarations.clear()
            report.source_types.source_generic_param_lines.clear()
            report.source_types.source_generic_param_names.clear()
            report.source_types.source_generic_params_valid <- false
            report.source_types.source_metadata_work_used <- 0
            report.source_contracts.source_signature_contract_lines.clear()
            report.source_contracts.source_signature_contract_kinds.clear()
            report.source_contracts.source_signature_contracts.clear()
            report.source_syntax.protocol_transition_positions.clear()
            report.source_contracts.source_extern_parameters.clear()
            report.source_contracts.source_region_param_lines.clear()
            report.results.findings.clear()
            report.results.focused_unrequested_findings.clear()
            report.results.counterexample_facts.clear()
            report.results.goal_attempts.clear()
            report.results.obligation_inventory.clear()
            report.source_syntax.assert_hole_positions.clear()
            report.source_syntax.assert_hole_positions_offset_ordered <- false
            report.context.focused_function <- ""
            report.context.focused_function_offset <- 0
            report.context.focused_function_identity_valid <- false
            report.context.current_source_postcondition_offset <- 0
            report.source.source_file_identity <- 0
            report.source.source_analysis_bound <- false
            proof_fact_call_shape_snapshot_reset(report.analysis_2.fact_call_shapes)
            report.analysis_1.certificates.clear()
            report.analysis_1.certificate_facts.clear()
            report.analysis_1.kernel.nodes.clear()
            report.analysis_1.kernel.children.clear()
            report.analysis_1.kernel.budget_exhausted <- false
            report.analysis_1.kernel.budget_reported <- false
            report.analysis_1.kernel.arena_validated <- false
            report.analysis_1.kernel.certificate_facts.clear()
            report.analysis_1.kernel.fact_trace_premises.clear()
            report.analysis_1.traces.records.clear()
            report.analysis_2.global_constant_trace_ids.clear()
            report.analysis_1.traces.origin_indices.clear()
            report.analysis_1.traces.origin_snapshots.clear()
            report.analysis_1.traces.index_hashes.clear()
            report.analysis_1.traces.index_values.clear()
            report.analysis_1.traces.next_indices.clear()
            report.analysis_1.traces.expression_index_hashes.clear()
            report.analysis_1.traces.expression_index_values.clear()
            report.analysis_1.traces.expression_hashes.clear()
            report.analysis_1.traces.next_expression_indices.clear()
            report.analysis_1.traces.lookup_work_used <- 0
            proof_goal_cache_reset(report)
            proof_linear_hint_index_reset(report)
            report.analysis_1.type_bounds.seen.clear()
            report.analysis_1.type_bounds.seen_hashes.clear()
            report.analysis_1.type_bounds.owner <- ""
            report.analysis_1.traces.active_start <- 0
            report.analysis_1.budgets.frame_call_steps <- 0
            report.analysis_1.budgets.frame_call_source_work <- 0
            report.analysis_1.budgets.frame_call_reported <- false
            report.analysis_1.budgets.resource_steps <- 0
            report.analysis_1.budgets.resource_reported <- false
            report.analysis_1.budgets.resource_pattern_work <- 0
            report.analysis_1.budgets.resource_pattern_reported <- false
            report.analysis_1.budgets.return_steps <- 0
            report.analysis_1.budgets.return_step_budget <- 0
            report.analysis_1.budgets.return_reported <- false
            report.analysis_1.budgets.return_fact_state_budget <- 0
            report.analysis_1.budgets.return_source_work <- 0
            report.analysis_1.budgets.return_source_reported <- false
            report.analysis_1.budgets.pattern_source_type_work <- 0
            report.analysis_1.budgets.lemma_purity_source_work <- 0
            report.analysis_1.budgets.lemma_purity_source_reported <- false
            report.analysis_1.budgets.assert_by_source_work <- 0
            report.analysis_1.budgets.assert_by_source_reported <- false
            report.context.current_return_unsigned_width <- 0
            report.context.current_return_signed_width <- 0
            report.analysis_1.traces.premises.clear()
            report.analysis_1.traces.summary_names.clear()
            report.analysis_1.traces.summary_values.clear()
            report.analysis_1.traces.summary_require_goal_ids.clear()
            report.analysis_1.executables.parameter_references.clear()
            report.analysis_1.declaration_details.clear()
            report.analysis_1.declaration_parameters.clear()
            report.analysis_1.theorems.summaries.clear()
            report.analysis_1.theorems.parameters.clear()
            report.analysis_1.theorems.parameter_types.clear()
            report.analysis_1.theorems.parameter_has_defaults.clear()
            report.analysis_1.theorems.parameter_defaults.clear()
            report.analysis_1.theorems.requires.clear()
            report.analysis_1.theorems.ensures.clear()
            report.analysis_1.theorems.decreases.clear()
            report.analysis_1.theorems.proof_goal_ids.clear()
            report.analysis_1.executables.summaries.clear()
            report.analysis_1.executables.parameters.clear()
            report.analysis_1.executables.requires.clear()
            report.analysis_1.executables.ensures.clear()
            report.analysis_1.structural.names.clear()
            report.analysis_1.structural.function_name_index_hashes.clear()
            report.analysis_1.structural.function_name_index_values.clear()
            report.analysis_1.structural.function_name_index_ambiguous.clear()
            report.analysis_1.structural.function_name_index_valid <- false
            report.analysis_1.structural.subject_positions.clear()
            report.analysis_1.structural.subject_types.clear()
            report.analysis_1.structural.component_ids.clear()
            report.analysis_1.structural.members.clear()
            report.analysis_1.structural.verified_members.clear()
            report.analysis_1.structural.verified_names.clear()
            report.analysis_1.structural.identity_next <- 0
            report.analysis_1.declaration_effects.clear()
            report.aliases.aliased_names.clear()
            report.aliases.escaping_names.clear()
            report.aliases.shared_extent_names.clear()
            report.aliases.shared_fixed_names.clear()
            report.aliases.local_extent_names.clear()
            report.aliases.value_binding_names.clear()
            report.aliases.reference_local_names.clear()
            report.aliases.value_collection_names.clear()
            report.aliases.aliased_owner <- ""
            report.threading.rebind_symbols <- 0
            report.threading.threaded_names.clear()
            report.threading.threaded_values.clear()
            report.threading.threaded_symbols.clear()
            report.threading.summary_threaded_symbols.clear()
            report.threading.value_thread_site <- false
            report.context.conditional_split_active <- false
            report.analysis_2.scalar_witness_facts <- 0
            report.analysis_2.replayed <- 0
            report.analysis_2.replay_gaps <- 0
            report.context.current_source_postcondition_count <- 0
            report.context.current_source_postcondition_line <- 0
            report.context.current_source_postcondition_name <- ""
            report.analysis_2.trace_owner_line <- 0
            report.analysis_2.trace_consumer_certificate_index <- 0
            report.analysis_2.trace_consumer_attempt_index <- 0
            report.analysis_2.replay_owner_line <- 0
            report.analysis_2.replay_owner_offset <- 0
            report.analysis_2.replay_owner_offset_valid <- false
            report.analysis_2.finding_function <- ""
            report.analysis_2.finding_owner <- ""
            report.analysis_2.finding_line <- 0
            report.analysis_2.finding_offset <- 0
            report.analysis_2.finding_caller_index <- 0

        # The semantic table is deliberately consumed only by this short source-formation
        # phase.  The table owns a large collection of compiler indexes; keeping it alive while
        # the proof schedules, checks, and records every declaration made full-file audits retain
        # two whole-program working sets at once.  Returning before the proof phase lets Elisa
        # release those indexes without weakening the source-typing boundary.
        def proof_prepare_source(file: Ast::File&, report: mutable ProofReport&, source_types: Semantic::SymbolTable&) -> bool:
            # A report is a complete verification transaction, not an append-only session. Reset
            # every arena and counter before importing a new file; retaining certificates or
            # provenance from a previous file could make a later report observe stale proof state.
            source_call_identity: uintptr = report.analysis_2.fact_call_shapes.status.source_identity if report.analysis_2.fact_call_shapes.status.source_check_active else 0
            source_call_fingerprint: u32 = report.analysis_2.fact_call_shapes.status.source_fingerprint if report.analysis_2.fact_call_shapes.status.source_check_active else 0
            source_call_active: bool = report.analysis_2.fact_call_shapes.status.source_check_active
            proof_reset_report(report)
            if source_call_active and source_call_identity != 0:
                report.analysis_2.fact_call_shapes.status.source_identity <- source_call_identity
                report.analysis_2.fact_call_shapes.status.source_fingerprint <- source_call_fingerprint
                report.analysis_2.fact_call_shapes.status.source_check_active <- true
                report.source.source_file_identity <- source_call_identity
            report.source.source_declarations.extend(file.top_decls)
            return false if not proof_prepare_source_metadata_snapshot(file, report)
            signature_contract_work: mutable usize = 0
            signature_contract_rows: usize = file.signature_contract_lines.count
            if signature_contract_rows != file.signature_contract_kinds.count or signature_contract_rows != file.signature_contract_exprs.count:
                proof_add_finding(report, "source-validation-incomplete", 0, "", "signature contract source snapshot is malformed")
                return false
            for contract_index in 0..<signature_contract_rows |contract_index, file, report, signature_contract_work|:
                contract_kind: sview = file.signature_contract_kinds[contract_index]
                if not proof_report_source_work_charge(1, &signature_contract_work) or not proof_report_source_work_charge(sview_len(contract_kind), &signature_contract_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "signature contract source snapshot exceeded its validated work bound", "signature-contract-snapshot-work", signature_contract_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return false
                report.source_contracts.source_signature_contract_lines.push(file.signature_contract_lines[contract_index])
                report.source_contracts.source_signature_contract_kinds.push(contract_kind)
                report.source_contracts.source_signature_contracts.push(file.signature_contract_exprs[contract_index])
            report.source_contracts.source_extern_parameters.extend(file.extern_params)
            # Lines of functions with region parameters: a lend to one may outlive the call.
            for annotation in file.local_region_annotations |report|:
                report.source_contracts.source_region_param_lines.push(annotation.line) if annotation.name == "__region_param"
            for transition_position in source_types.protocol_transition_admitted |report|:
                report.source_syntax.protocol_transition_positions.push(transition_position)
            # The source-neutral kernel does not know whether a call, field, or index denotes a
            # Boolean in Elisa. Reuse the compiler's parsed-program type context and reject
            # ill-formed source contracts before they can seed hypotheses or certificates.
            internal_name: (found: bool, name: sview, line: u32) = proof_find_internal_name_collision(source_types)
            if internal_name.found:
                proof_add_finding(report, "proof-internal-name", internal_name.line, internal_name.name, "source identifier collides with a proof-system internal name")
                return false
            region r(PROOF_SOURCE_KERNEL_WORKSPACE_ARENA_BYTES):
                kernel_global_bindings: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding] = []
                kernel_type_source_work: mutable usize = 0
                base_context: (known: bool, type_index: ProofSourceKernelTypeIndex, tuple_label_index: ProofSourceKernelTupleLabelIndex, global_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding]) = proof_source_kernel_base_context(file.top_decls, file.enum_annotations, file.generic_param_lines, file.generic_param_names, file.generic_param_lines.count == file.generic_param_names.count and report.source_types.source_generic_params_valid, &kernel_type_source_work)
                kernel_type_index_known: mutable bool = base_context.known
                kernel_type_index: mutable ProofSourceKernelTypeIndex = base_context.type_index
                tuple_label_index: ProofSourceKernelTupleLabelIndex = base_context.tuple_label_index
                kernel_global_bindings.extend(base_context.global_bindings)
                kernel_workspace: mutable ProofSourceKernelFormationWorkspace = ProofSourceKernelFormationWorkspace{nodes: [], children: [], visible_name_slots: [], type_index: kernel_type_index, generic_param_lines: file.generic_param_lines, generic_param_names: file.generic_param_names, generic_params_valid: file.generic_param_lines.count == file.generic_param_names.count and report.source_types.source_generic_params_valid, owner_declaration_line: 0, tuple_label_index: tuple_label_index, validation_workspace: ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new(), typing_workspace: ElisaProofKernelReplay::proof_kernel_replay_typing_workspace_new(), scoped_function_index: proof_source_kernel_scoped_function_index_new(), typing_work_used: 0, source_work_used: kernel_type_source_work}
                kernel_bindings_known: mutable bool = false
                if kernel_type_index_known:
                    kernel_bindings_known <- true
                kernel_bindings_known <- false if kernel_type_source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                kernel_workspace.source_work_used <- kernel_type_source_work
                if kernel_bindings_known:
                    kernel_bindings_known <- ElisaProofKernelReplay::proof_kernel_replay_typing_workspace_prepare_globals(kernel_global_bindings, &kernel_workspace.typing_workspace)
                if kernel_bindings_known:
                    proof_validate_propositions_in_declarations(file, file.top_decls, kernel_global_bindings, &kernel_workspace, source_types, report)
                    if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "kernel proposition source projection exceeded its validated work bound", "kernel-source-projection-work", kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                else:
                    report.proof_obligation(false)
                    if kernel_type_source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "kernel type index exceeded its validated work bound", "kernel-type-index-work", kernel_type_source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    else:
                        proof_add_finding(report, "contract-proposition-type", 0, "", "kernel typing declaration environment exceeded its bounded representation")
            return true

        # This is the large, source-independent proof phase.  It must not receive or retain the
        # compiler SymbolTable: all source proposition formation that needs it is complete above.
    private:
        def proof_check_core(file: Ast::File&, report: mutable ProofReport&, focus_function: sview) -> void:
            report.context.focused_function <- focus_function
            name_index_work: mutable usize = report.source_types.source_metadata_work_used
            operator_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_operator_impl_index(report, &name_index_work)
            if not operator_index_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "operator-implementation index could not be built within its validated bounds", operator_index_status.reason, operator_index_status.observed, operator_index_status.limit)
                return
            source_operator_masks_status: (complete: bool, primitive_mask: usize, protocol_mask: usize) = proof_source_operator_masks_from_index(report, &name_index_work)
            if not source_operator_masks_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source operator masks exceeded their validated work bound", "source-operator-mask-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            report.source.source_primitive_operator_mask <- source_operator_masks_status.primitive_mask
            report.source.source_operator_protocol_mask <- source_operator_masks_status.protocol_mask
            if not proof_source_effect_index_build(report, &name_index_work):
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source destructor type index exceeded its validated work bound", "source-drop-type-index-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if not proof_source_callable_extern_contract_index_build(report.source.source_declarations, report.source_contracts.source_extern_parameters, report.source_contracts.source_signature_contract_lines, report.source_contracts.source_signature_contract_kinds, report.source_contracts.source_signature_contracts, report, &name_index_work):
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "callable extern contract index exceeded its validated work bound", "extern-contract-index-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            lemmas: mutable ProofLemmaTable = proof_empty_lemmas()
            functions: mutable ProofFunctionTable = proof_empty_functions()
            lemma_marker_build: (index: ProofLemmaAnnotationIndex, complete: bool, reason: sview, observed: usize, limit: usize) = proof_lemma_annotation_index(file, &name_index_work)
            if not lemma_marker_build.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma-annotation index could not be built within its validated bounds", lemma_marker_build.reason, lemma_marker_build.observed, lemma_marker_build.limit)
                return
            lemma_markers: ProofLemmaAnnotationIndex = lemma_marker_build.index
            proof_collect_lemmas(file, file.top_decls, lemma_markers, "", &lemmas, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma metadata collection exceeded its validated work bound", "lemma-metadata-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            lemma_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_lemma_index(&lemmas, &name_index_work)
            if not lemma_index_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma-name index could not be built within its validated bounds", lemma_index_status.reason, lemma_index_status.observed, lemma_index_status.limit)
                return
            return if not proof_build_lemma_components_or_report(&lemmas, &name_index_work, &report)
            functions.type_indexes.type_audit_index <- proof_type_audit_index(file.top_decls, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "type audit index exceeded its validated work bound", "type-audit-index-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            functions.type_indexes.enum_index <- proof_build_enum_index(file.top_decls, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "enum index exceeded its validated work bound", "enum-index-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            report.source_types.source_effect_index.enum_index <- functions.type_indexes.enum_index
            frame_annotation_build: (index: ProofFrameAnnotationIndex, complete: bool, reason: sview, observed: usize, limit: usize) = proof_frame_annotation_index(file, &name_index_work)
            if not frame_annotation_build.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "frame-annotation index could not be built within its validated bounds", frame_annotation_build.reason, frame_annotation_build.observed, frame_annotation_build.limit)
                return
            functions.type_indexes.frame_annotation_index <- frame_annotation_build.index
            proof_collect_local_region_bindings(file, &functions, &name_index_work)
            proof_collect_mutable_local_bindings(file, &functions, &name_index_work)
            proof_collect_loop_accumulators(file, &functions, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "local binding metadata collection exceeded its validated work bound", "local-binding-metadata-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            declaration_path: mutable darray[usize] = []
            proof_collect_functions(file, file.top_decls, lemmas, &functions, report.source_types.source_effect_index, report.source_types.source_generic_params_valid, &declaration_path, "", 0, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "function collection could not classify lemma names within its validated work bound", "lemma-name-lookup-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            function_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_function_index(&functions, &name_index_work)
            if not function_index_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "function-name index could not be built within its validated bounds", function_index_status.reason, function_index_status.observed, function_index_status.limit)
                return
            function_alias_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_function_module_aliases(file.enum_annotations, &functions, &name_index_work)
            if not function_alias_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "module-alias index could not be built within its validated bounds", function_alias_status.reason, function_alias_status.observed, function_alias_status.limit)
                return
            fact_call_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_fact_call_shape_indexes(&functions, &name_index_work)
            if not fact_call_index_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "fact call-shape indexes could not be built within their validated bounds", fact_call_index_status.reason, fact_call_index_status.observed, fact_call_index_status.limit)
                return
            fact_call_snapshot_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_fact_call_shape_snapshot(file, report, functions, &name_index_work)
            if not fact_call_snapshot_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "fact call-shape snapshot could not be built within its validated bounds", fact_call_snapshot_status.reason, fact_call_snapshot_status.observed, fact_call_snapshot_status.limit)
                return
            call_target_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_resolve_function_call_targets(report, &functions, &name_index_work)
            if not call_target_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "call graph targets could not be resolved within their validated bounds", call_target_status.reason, call_target_status.observed, call_target_status.limit)
                return
            functions.lookup.module_resolution_work_used <- name_index_work
            if not proof_function_extern_contract_reachability_build(report, &functions, &name_index_work):
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "reachable callable extern contracts exceeded their validated work bound", "extern-contract-reachability-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            functions.lookup.module_resolution_work_used <- name_index_work
            proof_qualify_repeated_contract_rows(file, &functions)
            if functions.lookup.module_resolution_work_exhausted:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "qualified contract call resolution exceeded its shared source-work bound", "module-call-resolution-work", functions.lookup.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            name_index_work <- functions.lookup.module_resolution_work_used
            return if not proof_build_function_components_or_report(&functions, &name_index_work, &report)
            proof_mark_pure_functions(file, file.top_decls, &functions, report)
            name_index_work <- functions.lookup.module_resolution_work_used
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source purity analysis exceeded its shared source-work bound", "module-call-resolution-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source purity and implicit-effect analysis exceeded their shared work bound", "source-implicit-effect-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            fact_call_purity_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_fact_call_shape_snapshot_purity(&report.analysis_2.fact_call_shapes, functions, &name_index_work)
            if not fact_call_purity_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "fact call-shape purity data could not be bound within its validated bounds", fact_call_purity_status.reason, fact_call_purity_status.observed, fact_call_purity_status.limit)
                return
            functions.lookup.module_resolution_work_used <- name_index_work
            proof_check_structural_termination(file, file.top_decls, functions, report, true)
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "structural implicit-effect analysis exceeded its shared work bound", "source-implicit-effect-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if functions.lookup.module_resolution_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "structural source contract analysis exceeded its shared work bound", "structural-source-contract-work", functions.lookup.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            (proof_compute_verified_lemmas(file, file.top_decls, &lemmas, functions, report) can Global{Read,Write})
            (proof_compute_verified_functions(file, file.top_decls, lemmas, &functions, report, focus_function) can Global{Read,Write})
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source function proof analysis exceeded its shared work bound", "source-implicit-effect-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            name_index_work <- functions.lookup.module_resolution_work_used
            proof_record_declarations(file, file.top_decls, lemmas, functions, report, &name_index_work)
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source declaration reporting exceeded its shared work bound", "source-implicit-effect-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if functions.lookup.module_resolution_work_exhausted:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "function call resolution exceeded its shared source-work bound", "module-call-resolution-work", functions.lookup.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "declaration reporting could not classify lemma names within its validated work bound", "lemma-name-lookup-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        # A direct API caller receives a report only after every supported simple source
        # postcondition has a matching goal attempt and, when proven, a matching certificate
        # claim. Kernel replay remains an explicit follow-up operation for compatibility.
        def proof_api_source_binding_consistent(source_literal_ensures: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, report: ProofReport&) -> bool:
            return proof_source_literal_ensure_binding_coverage(source_literal_ensures, report)

        def proof_api_add_assert_by_inventory_finding(inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, report: mutable ProofReport&) -> void:
            proof_add_finding(report, "source-obligation-inventory", 0, "", "an assert-by target or proof step is unsupported, omitted, duplicated, falsely claimed, or unreplayed")
            report.results.findings[report.results.findings.count - 1].status <- "unsupported" if proof_source_assert_by_inventory_has_unsupported(inventory) and report.results.findings.count > 0

    public:
        # Public compatibility wrapper; `ProofGoalAttempt.producer_proven` is producer search only.
        # Acceptance consumers must use proof_check_and_replay_with_source and ProofCheckedView.
        def proof_check(file: Ast::File&, report: mutable ProofReport&) -> void:
            source_literal_ensures: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(file.top_decls)
            source_assert_by_goals: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = proof_source_assert_by_inventory(file.top_decls)
            ready: bool = (proof_prepare_semantic_source(file, report) can Global{Read,Write})
            if ready:
                (proof_check_core(file, report, "") can Global{Read,Write})
                if not proof_api_source_binding_consistent(source_literal_ensures, report):
                    proof_add_finding(report, "source-obligation-inventory", 0, "", "a supported source postcondition has no distinct source-bound proof attempt")
                if not proof_source_assert_by_attempt_coverage(source_assert_by_goals, report):
                    proof_api_add_assert_by_inventory_finding(source_assert_by_goals, report)

        # Build compiler semantics once, prepare source propositions, and copy only structured
        # diagnostics. Returning releases the large compiler symbol table before the proof core,
        # replay, and JSON rendering retain their own working sets.
        def proof_check_with_semantic_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> void:
            source_literal_ensures: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(file.top_decls)
            source_assert_by_goals: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = proof_source_assert_by_inventory(file.top_decls)
            ready: bool = (proof_prepare_semantic_source_with_diagnostics(file, report, diagnostics) can Global{Read,Write})
            if ready:
                proof_prepare_frame_producer_context(report, file, tokens, source, source_length)
                (proof_check_core(file, report, "") can Global{Read,Write})
                if not proof_api_source_binding_consistent(source_literal_ensures, report):
                    proof_add_finding(report, "source-obligation-inventory", 0, "", "a supported source postcondition has no distinct source-bound proof attempt")
                if not proof_source_assert_by_attempt_coverage(source_assert_by_goals, report):
                    proof_api_add_assert_by_inventory_finding(source_assert_by_goals, report)

        # Focused runs retain whole-file semantic/type context and the ordinary call-summary
        # scheduler, but spend the bounded proof arena only on the requested function and its
        # transitive executable callees. Unselected functions never gain verified summaries.
        def proof_check_focused_with_semantic_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&, focus_function: sview, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> void:
            source_literal_ensures: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(file.top_decls)
            source_assert_by_goals: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = proof_source_assert_by_inventory(file.top_decls)
            ready: bool = (proof_prepare_semantic_source_with_diagnostics(file, report, diagnostics) can Global{Read,Write})
            if ready:
                proof_prepare_frame_producer_context(report, file, tokens, source, source_length)
                (proof_check_core(file, report, focus_function) can Global{Read,Write})
                if not proof_api_focused_source_inventory_consistent(source_literal_ensures, source_assert_by_goals, report):
                    proof_add_finding(report, "source-obligation-inventory", 0, focus_function, "a focused source obligation has no distinct source-bound proof attempt")

    private:
        # Source-analysis entry point. It performs the check itself against the same
        # parser-owned Ast::File captured by the source capability, then records that exact
        # file identity in private report state. A report built through a compatibility checker
        # cannot be retroactively stamped as belonging to an unrelated source.
        def proof_check_with_source_analysis[@r](report: mutable ProofReport& @r, diagnostics: mutable darray[Semantic::Diagnostic]& @r, source: ProofSourceAnalysis[r], focus_function: sview) -> bool can[Memory.Allocate, Global.Read, Global.Write]:
            return false if:
                not source.issued
                report.source.source_analysis_bound or report.source.source_file_identity != 0
                report.results.goal_attempts.count > 0 or report.analysis_1.certificates.count > 0 or report.source.source_declarations.count > 0
            source_file_identity: uintptr = source.file_identity
            file: Ast::File& = source.file
            proof_fact_call_shape_snapshot_reset(report.analysis_2.fact_call_shapes)
            report.analysis_2.fact_call_shapes.status.source_identity <- source_file_identity
            report.analysis_2.fact_call_shapes.status.source_fingerprint <- source.source_fingerprint
            report.analysis_2.fact_call_shapes.status.source_check_active <- true
            report.source.source_file_identity <- source_file_identity
            if focus_function == "":
                (proof_check_with_semantic_diagnostics(file, report, diagnostics, source.tokens, &source.source[0], source.source_bytes) can Global{Read,Write})
            else:
                (proof_check_focused_with_semantic_diagnostics(file, report, diagnostics, focus_function, source.tokens, &source.source[0], source.source_bytes) can Global{Read,Write})
            report.analysis_2.fact_call_shapes.status.source_check_active <- false
            report.source.source_analysis_bound <- true
            return true

    private:
        def proof_semantic_diagnostic_refutes_obligation(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.LocalWhereRefinementViolated:
                    return true
                Semantic::DiagnosticKind.ParametricIndexViolated:
                    return true
                Semantic::DiagnosticKind.PreconditionProvablyViolated:
                    return true
                Semantic::DiagnosticKind.PreconditionViolated:
                    return true
                Semantic::DiagnosticKind.RefinementBoundViolated:
                    return true
                Semantic::DiagnosticKind.StructFieldRefinementViolated:
                    return true
                Semantic::DiagnosticKind.UsesPreconditionViolated:
                    return true
                Semantic::DiagnosticKind.WhereRefinementReassignViolated:
                    return true
                _:
                    return false
            return false

        def proof_semantic_diagnostic_leaves_obligation_open(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.LocalRefinementUnproven:
                    return true
                Semantic::DiagnosticKind.PreconditionUnproven:
                    return true
                Semantic::DiagnosticKind.QuantifiedRefinementUnproven:
                    return true
                Semantic::DiagnosticKind.RefinementArgNotProven:
                    return true
                Semantic::DiagnosticKind.RefinementReturnNotProven:
                    return true
                _:
                    return false
            return false

        def proof_semantic_diagnostic_is_non_exhaustive(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.NonExhaustiveMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveOptionalMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveScalarMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveOpenExternEnum:
                    return true
                _:
                    return false
            return false

        # Preserve the compiler driver's stage0-compatible diagnostic policy while sharing the
        # one semantic table with proof formation. Refuted obligations supersede weaker
        # "unproven" messages, non-exhaustive matches supersede a derived missing-return message,
        # and repeated ensure findings are collapsed by the same source identity as the compiler.
        def proof_copy_normalized_semantic_diagnostics(source: darray[Semantic::Diagnostic]&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> void:
            refuted_lines: mutable darray[u32] = []
            for diagnostic in source |refuted_lines|:
                refuted_lines.push(diagnostic.line) if proof_semantic_diagnostic_refutes_obligation(diagnostic.kind)
            ensure_violated_names: mutable darray[sview] = []
            ensure_violated_lines: mutable darray[u32] = []
            for diagnostic in source |ensure_violated_names, ensure_violated_lines|:
                if diagnostic.kind == Semantic::DiagnosticKind.EnsureNotProven and diagnostic.detail == "violated":
                    ensure_violated_names.push(diagnostic.name)
                    ensure_violated_lines.push(diagnostic.line)
            ensure_seen_names: mutable darray[sview] = []
            ensure_seen_lines: mutable darray[u32] = []
            ensure_seen_details: mutable darray[sview] = []
            for diagnostic in source |diagnostics, refuted_lines, ensure_violated_names, ensure_violated_lines, ensure_seen_names, ensure_seen_lines, ensure_seen_details|:
                skip: mutable bool = false
                if diagnostic.kind == Semantic::DiagnosticKind.MissingReturnValue:
                    for candidate in source |skip, diagnostic|:
                        skip <- true if candidate.line == diagnostic.line and proof_semantic_diagnostic_is_non_exhaustive(candidate.kind)
                if proof_semantic_diagnostic_leaves_obligation_open(diagnostic.kind):
                    for refuted_line in refuted_lines |skip, diagnostic|:
                        skip <- true if refuted_line == diagnostic.line
                if diagnostic.kind == Semantic::DiagnosticKind.EnsureNotProven:
                    ensure_seen: mutable bool = false
                    for index in 0..<ensure_seen_names.count |index, ensure_seen, ensure_seen_names, ensure_seen_lines, ensure_seen_details, diagnostic|:
                        ensure_seen <- true if ensure_seen_names[index] == diagnostic.name and ensure_seen_lines[index] == diagnostic.line and ensure_seen_details[index] == diagnostic.detail
                    if diagnostic.detail != "violated":
                        for index in 0..<ensure_violated_names.count |index, ensure_seen, ensure_violated_names, ensure_violated_lines, diagnostic|:
                            ensure_seen <- true if ensure_violated_names[index] == diagnostic.name and ensure_violated_lines[index] == diagnostic.line
                    if not ensure_seen:
                        ensure_seen_names.push(diagnostic.name)
                        ensure_seen_lines.push(diagnostic.line)
                        ensure_seen_details.push(diagnostic.detail)
                    skip <- true if ensure_seen
                diagnostics.push(diagnostic) if not skip

        def proof_prepare_semantic_source(file: Ast::File&, report: mutable ProofReport&) -> bool can[Global.Read, Global.Write]:
            source_types: mutable Semantic::SymbolTable = Semantic::SymbolTable()
            source_types <- (Semantic::check_full_into(file, source_types, false, false, false, false, true, false, false, false, false, false, PROOF_SEMANTIC_DIAGNOSTIC_LIMIT, true, true, false) can Global{Read,Write})
            return proof_prepare_semantic_source_checked(file, report, source_types)

        def proof_prepare_semantic_source_with_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can[Global.Read, Global.Write]:
            source_types: mutable Semantic::SymbolTable = Semantic::SymbolTable()
            source_types <- (Semantic::check_full_into(file, source_types, false, false, false, false, true, false, false, false, false, false, PROOF_SEMANTIC_DIAGNOSTIC_LIMIT, true, true, false) can Global{Read,Write})
            ready: bool = proof_prepare_semantic_source_checked(file, report, source_types)
            proof_copy_normalized_semantic_diagnostics(source_types.diagnostics, diagnostics)
            return ready
        def proof_prepare_semantic_source_checked(file: Ast::File&, report: mutable ProofReport&, source_types: Semantic::SymbolTable&) -> bool:
            for diagnostic in source_types.diagnostics:
                if proof_semantic_diagnostic_refutes_arithmetic_safety(diagnostic.kind):
                    proof_reset_report(report)
                    proof_add_finding(report, "arithmetic-safety-refuted", diagnostic.line, "", "compiler identified a definite division, modulo, or shift safety failure; verification was skipped")
                    return false
                if proof_semantic_diagnostic_requires_permission(diagnostic.kind):
                    proof_reset_report(report)
                    proof_add_finding(report, "semantic-permission-ungranted", diagnostic.line, "", "a required panic, effect, pointer, buffer, pointer-arithmetic, index, alias, global or parallel permission is missing; verification was skipped")
                    return false
                match diagnostic.kind:
                    Semantic::DiagnosticKind.ExpressionAnalysisDepthExceeded:
                        # The compiler has proved that part of this AST was not semantically
                        # checked. Do not run the proof core over that unexamined subtree: it
                        # can neither establish a valid source judgment nor produce a trustworthy
                        # proof. Keep the rejection explicit and let CLI reporting preserve the
                        # compiler diagnostic; certificate replay on the empty report stays clean.
                        proof_reset_report(report)
                        proof_add_finding(report, "semantic-analysis-depth", diagnostic.line, "", "compiler semantic analysis reached its safe expression-depth limit; proof checking was skipped")
                        return false
                    _:
                        pass
                if Semantic::diagnostic_severity(diagnostic) == 1 and not proof_semantic_diagnostic_is_deferred_proof(diagnostic):
                    # A source judgment with a mandatory compiler error is not admissible,
                    # even when another declaration has an independently provable goal.
                    # Use caller-independent text: diagnostic views remain compiler-owned.
                    proof_reset_report(report)
                    proof_add_finding(report, "semantic-source-inadmissible", diagnostic.line, "", "compiler reported a mandatory semantic error; proof checking was skipped")
                    return false
            return proof_prepare_source(file, report, source_types)
