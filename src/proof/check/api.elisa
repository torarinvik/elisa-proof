const PROOF_SEMANTIC_DIAGNOSTIC_LIMIT: usize = 64
const PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT: usize = 64
# Guarded arm facts imported per arm at a conditional join (G75); each costs a disjunction.
const PROOF_JOIN_GUARDED_FACT_LIMIT: usize = 8
const PROOF_SOURCE_KERNEL_WORKSPACE_ARENA_BYTES: usize = 1048576

extend ElisaProof:
    public:
        # Reuse the caller-owned report storage while making every verification run independent.
        # Clearing in place is deliberately used instead of assigning a fresh report: the report
        # contains compiler-owned AST values, and stage0 correctly rejects a whole-struct
        # assignment that could move those values across an inferred region boundary.
        def proof_reset_report(report: mutable ProofReport&) -> void:
            report.frame_producer.names.clear()
            report.frame_producer.lines.clear()
            report.frame_producer.starts.clear()
            report.frame_producer.counts.clear()
            report.frame_producer.rows.clear()
            report.frame_producer.active_name <- ""
            report.declarations <- 0
            report.obligations <- 0
            report.proven <- 0
            report.failed <- 0
            report.source_annotations.clear()
            report.source_primitive_operator_mask <- PROOF_SOURCE_OPERATOR_MASK_EMPTY
            report.operator_impls.rows.clear()
            report.operator_impls.hashes.clear()
            report.operator_impls.bucket_heads.clear()
            report.operator_impls.next_indices.clear()
            report.operator_impls.valid <- false
            report.source_declarations.clear()
            report.source_signature_contract_lines.clear()
            report.source_signature_contract_kinds.clear()
            report.source_signature_contracts.clear()
            report.protocol_transition_positions.clear()
            report.source_extern_parameters.clear()
            report.source_region_param_lines.clear()
            report.findings.clear()
            report.focused_unrequested_findings.clear()
            report.counterexample_facts.clear()
            report.goal_attempts.clear()
            report.obligation_inventory.clear()
            report.assert_hole_positions.clear()
            report.focused_function <- ""
            report.source_file_identity <- 0
            report.source_analysis_bound <- false
            proof_fact_call_shape_snapshot_reset(report.fact_call_shapes)
            report.certificates.clear()
            report.certificate_facts.clear()
            report.kernel.nodes.clear()
            report.kernel.children.clear()
            report.kernel.budget_exhausted <- false
            report.kernel.budget_reported <- false
            report.kernel.arena_validated <- false
            report.kernel.certificate_facts.clear()
            report.kernel.fact_trace_premises.clear()
            report.traces.records.clear()
            report.global_constant_trace_ids.clear()
            report.traces.origin_indices.clear()
            report.traces.origin_snapshots.clear()
            report.traces.index_hashes.clear()
            report.traces.index_values.clear()
            report.traces.next_indices.clear()
            report.traces.expression_index_hashes.clear()
            report.traces.expression_index_values.clear()
            report.traces.expression_hashes.clear()
            report.traces.next_expression_indices.clear()
            report.traces.lookup_work_used <- 0
            proof_goal_cache_reset(report)
            proof_linear_hint_index_reset(report)
            report.type_bounds.seen.clear()
            report.type_bounds.seen_hashes.clear()
            report.type_bounds.owner <- ""
            report.traces.active_start <- 0
            report.budgets.frame_call_steps <- 0
            report.budgets.frame_call_reported <- false
            report.budgets.resource_steps <- 0
            report.budgets.resource_reported <- false
            report.budgets.resource_pattern_work <- 0
            report.budgets.resource_pattern_reported <- false
            report.budgets.return_steps <- 0
            report.budgets.return_step_budget <- 0
            report.budgets.return_reported <- false
            report.budgets.return_fact_state_budget <- 0
            report.budgets.return_source_work <- 0
            report.budgets.return_source_reported <- false
            report.budgets.pattern_source_type_work <- 0
            report.budgets.lemma_purity_source_work <- 0
            report.budgets.lemma_purity_source_reported <- false
            report.budgets.assert_by_source_work <- 0
            report.budgets.assert_by_source_reported <- false
            report.current_return_unsigned_width <- 0
            report.current_return_signed_width <- 0
            report.traces.premises.clear()
            report.traces.summary_names.clear()
            report.traces.summary_values.clear()
            report.traces.summary_require_goal_ids.clear()
            report.executables.parameter_references.clear()
            report.declaration_details.clear()
            report.declaration_parameters.clear()
            report.theorems.summaries.clear()
            report.theorems.parameters.clear()
            report.theorems.parameter_types.clear()
            report.theorems.parameter_has_defaults.clear()
            report.theorems.parameter_defaults.clear()
            report.theorems.requires.clear()
            report.theorems.ensures.clear()
            report.theorems.decreases.clear()
            report.theorems.proof_goal_ids.clear()
            report.executables.summaries.clear()
            report.executables.parameters.clear()
            report.executables.requires.clear()
            report.executables.ensures.clear()
            report.structural.names.clear()
            report.structural.subject_positions.clear()
            report.structural.subject_types.clear()
            report.structural.component_ids.clear()
            report.structural.members.clear()
            report.structural.verified_names.clear()
            report.structural.identity_next <- 0
            report.declaration_effects.clear()
            report.aliased_names.clear()
            report.escaping_names.clear()
            report.shared_extent_names.clear()
            report.shared_fixed_names.clear()
            report.local_extent_names.clear()
            report.value_binding_names.clear()
            report.reference_local_names.clear()
            report.value_collection_names.clear()
            report.aliased_owner <- ""
            report.rebind_symbols <- 0
            report.threaded_names.clear()
            report.threaded_values.clear()
            report.threaded_symbols.clear()
            report.summary_threaded_symbols.clear()
            report.value_thread_site <- false
            report.conditional_split_active <- false
            report.scalar_witness_facts <- 0
            report.replayed <- 0
            report.replay_gaps <- 0
            report.current_source_postcondition_count <- 0
            report.current_source_postcondition_line <- 0
            report.current_source_postcondition_name <- ""
            report.trace_owner_line <- 0
            report.trace_consumer_certificate_index <- 0
            report.replay_owner_line <- 0
            report.finding_function <- ""
            report.finding_owner <- ""
            report.finding_line <- 0
            report.finding_caller_index <- 0

        # The semantic table is deliberately consumed only by this short source-formation
        # phase.  The table owns a large collection of compiler indexes; keeping it alive while
        # the proof schedules, checks, and records every declaration made full-file audits retain
        # two whole-program working sets at once.  Returning before the proof phase lets Elisa
        # release those indexes without weakening the source-typing boundary.
        def proof_prepare_source(file: Ast::File&, report: mutable ProofReport&, source_types: Semantic::SymbolTable&) -> bool:
            # A report is a complete verification transaction, not an append-only session. Reset
            # every arena and counter before importing a new file; retaining certificates or
            # provenance from a previous file could make a later report observe stale proof state.
            source_call_identity: uintptr = report.fact_call_shapes.source_identity if report.fact_call_shapes.source_check_active else 0
            source_call_fingerprint: u32 = report.fact_call_shapes.source_fingerprint if report.fact_call_shapes.source_check_active else 0
            source_call_active: bool = report.fact_call_shapes.source_check_active
            proof_reset_report(report)
            if source_call_active and source_call_identity != 0:
                report.fact_call_shapes.source_identity <- source_call_identity
                report.fact_call_shapes.source_fingerprint <- source_call_fingerprint
                report.fact_call_shapes.source_check_active <- true
                report.source_file_identity <- source_call_identity
            report.source_declarations.extend(file.top_decls)
            signature_contract_work: mutable usize = 0
            signature_contract_rows: usize = file.signature_contract_lines.count
            if signature_contract_rows != file.signature_contract_kinds.count or signature_contract_rows != file.signature_contract_exprs.count:
                proof_add_finding(report, "source-validation-incomplete", 0, "", "signature contract source snapshot is malformed")
                return false
            for contract_index in 0..<signature_contract_rows |contract_index, file, report, signature_contract_work|:
                contract_kind: sview = file.signature_contract_kinds[contract_index]
                if not proof_report_source_work_charge(1 + sview_len(contract_kind), &signature_contract_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "signature contract source snapshot exceeded its validated work bound", "signature-contract-snapshot-work", signature_contract_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return false
                report.source_signature_contract_lines.push(file.signature_contract_lines[contract_index])
                report.source_signature_contract_kinds.push(contract_kind)
                report.source_signature_contracts.push(file.signature_contract_exprs[contract_index])
            report.source_extern_parameters.extend(file.extern_params)
            # Lines of functions with region parameters: a lend to one may outlive the call.
            for annotation in file.local_region_annotations |report|:
                report.source_region_param_lines.push(annotation.line) if annotation.name == "__region_param"
            for transition_position in source_types.protocol_transition_admitted |report|:
                report.protocol_transition_positions.push(transition_position)
            # The source-neutral kernel does not know whether a call, field, or index denotes a
            # Boolean in Elisa. Reuse the compiler's parsed-program type context and reject
            # ill-formed source contracts before they can seed hypotheses or certificates.
            internal_name: (found: bool, name: sview, line: u32) = proof_find_internal_name_collision(source_types)
            if internal_name.found:
                proof_add_finding(report, "proof-internal-name", internal_name.line, internal_name.name, "source identifier collides with a proof-system internal name")
                return false
            region r(PROOF_SOURCE_KERNEL_WORKSPACE_ARENA_BYTES):
                kernel_global_bindings: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding] = []
                kernel_type_entries: mutable darray[ProofSourceKernelTypeEntry] = []
                root_module_path: darray[sview] = []
                kernel_type_source_work: mutable usize = 0
                kernel_owner_path_segments: mutable usize = 0
                kernel_type_index_known: mutable bool = proof_source_kernel_collect_type_index(file.top_decls, &kernel_type_entries, root_module_path, &kernel_type_source_work, &kernel_owner_path_segments, 0)
                kernel_type_index: mutable ProofSourceKernelTypeIndex = proof_source_kernel_build_type_index(kernel_type_entries, &kernel_type_source_work)
                kernel_type_index_known <- false if kernel_type_source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or not kernel_type_index.complete
                tuple_label_index: ProofSourceKernelTupleLabelIndex = proof_source_kernel_build_tuple_label_index(file.enum_annotations, &kernel_type_source_work)
                kernel_workspace: mutable ProofSourceKernelFormationWorkspace = ProofSourceKernelFormationWorkspace{nodes: [], children: [], visible_name_slots: [], type_index: kernel_type_index, tuple_label_index: tuple_label_index, validation_workspace: ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new(), typing_workspace: ElisaProofKernelReplay::proof_kernel_replay_typing_workspace_new(), typing_work_used: 0, source_work_used: kernel_type_source_work}
                kernel_bindings_known: mutable bool = false
                if kernel_type_index_known:
                    kernel_bindings_known <- proof_source_kernel_global_bindings(file.top_decls, file.enum_annotations, tuple_label_index, kernel_type_index, &kernel_global_bindings, &kernel_type_source_work)
                kernel_bindings_known <- false if kernel_type_source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                kernel_workspace.source_work_used <- kernel_type_source_work
                if kernel_bindings_known:
                    kernel_bindings_known <- ElisaProofKernelReplay::proof_kernel_replay_typing_workspace_prepare_globals(kernel_global_bindings, &kernel_workspace.typing_workspace)
                if kernel_bindings_known:
                    proof_validate_propositions_in_declarations(file, file.top_decls, kernel_global_bindings, &kernel_workspace, source_types, report)
                    if kernel_workspace.source_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "kernel proposition source projection exceeded its validated work bound", "kernel-source-projection-work", kernel_workspace.source_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                else:
                    report.proof_obligation(false)
                    if kernel_type_source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "kernel type index exceeded its validated work bound", "kernel-type-index-work", kernel_type_source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    else:
                        proof_add_finding(report, "contract-proposition-type", 0, "", "kernel typing declaration environment exceeded its bounded representation")
            return true

        # This is the large, source-independent proof phase.  It must not receive or retain the
        # compiler SymbolTable: all source proposition formation that needs it is complete above.
    private:
        def proof_check_core(file: Ast::File&, report: mutable ProofReport&, focus_function: sview) -> void:
            report.focused_function <- focus_function
            name_index_work: mutable usize = 0
            # Contract quantifier syntax is erased from the AST and recovered through this
            # compiler-owned side table. Preserve the exact source annotations in the report so
            # a source-bound tactic store cannot substitute script-supplied quantifier kinds.
            report.source_annotations.clear()
            for annotation in file.enum_annotations |report|:
                if not proof_report_source_work_charge(1, name_index_work) or not proof_report_source_work_charge(sview_len(annotation.owner), name_index_work) or not proof_report_source_work_charge(sview_len(annotation.name), name_index_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source annotation snapshot exceeded its validated work bound", "annotation-snapshot-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
                report.source_annotations.push(annotation)
            report.assert_hole_positions.clear()
            for hole in file.assert_hole_positions |report|:
                if not proof_report_source_work_charge(1, name_index_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "source assertion-hole snapshot exceeded its validated work bound", "assert-hole-snapshot-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
                report.assert_hole_positions.push(hole)
            operator_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_operator_impl_index(report, &name_index_work)
            if not operator_index_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "operator-implementation index could not be built within its validated bounds", operator_index_status.reason, operator_index_status.observed, operator_index_status.limit)
                return
            source_operator_mask_status: (complete: bool, mask: usize) = proof_source_primitive_operator_mask_from_index(report, &name_index_work)
            if not source_operator_mask_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "primitive operator admission mask exceeded its validated work bound", "primitive-operator-mask-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            report.source_primitive_operator_mask <- source_operator_mask_status.mask
            lemmas: mutable ProofLemmaTable = proof_empty_lemmas()
            functions: mutable ProofFunctionTable = proof_empty_functions()
            lemma_marker_build: (index: ProofLemmaAnnotationIndex, complete: bool, reason: sview, observed: usize, limit: usize) = proof_lemma_annotation_index(file, &name_index_work)
            if not lemma_marker_build.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma-annotation index could not be built within its validated bounds", lemma_marker_build.reason, lemma_marker_build.observed, lemma_marker_build.limit)
                return
            lemma_markers: ProofLemmaAnnotationIndex = lemma_marker_build.index
            proof_collect_lemmas(file, file.top_decls, lemma_markers, &lemmas, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma metadata collection exceeded its validated work bound", "lemma-metadata-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            lemma_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_lemma_index(&lemmas, &name_index_work)
            if not lemma_index_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma-name index could not be built within its validated bounds", lemma_index_status.reason, lemma_index_status.observed, lemma_index_status.limit)
                return
            proof_build_lemma_components(&lemmas)
            functions.type_audit_index <- proof_type_audit_index(file.top_decls, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "type audit index exceeded its validated work bound", "type-audit-index-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            functions.enum_index <- proof_build_enum_index(file.top_decls, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "enum index exceeded its validated work bound", "enum-index-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            frame_annotation_build: (index: ProofFrameAnnotationIndex, complete: bool, reason: sview, observed: usize, limit: usize) = proof_frame_annotation_index(file, &name_index_work)
            if not frame_annotation_build.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "frame-annotation index could not be built within its validated bounds", frame_annotation_build.reason, frame_annotation_build.observed, frame_annotation_build.limit)
                return
            functions.frame_annotation_index <- frame_annotation_build.index
            proof_collect_local_region_bindings(file, &functions, &name_index_work)
            proof_collect_mutable_local_bindings(file, &functions, &name_index_work)
            proof_collect_loop_accumulators(file, &functions, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "local binding metadata collection exceeded its validated work bound", "local-binding-metadata-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            declaration_path: mutable darray[usize] = []
            proof_collect_functions(file, file.top_decls, lemmas, &functions, &declaration_path, "", 0, &name_index_work)
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "function collection could not classify lemma names within its validated work bound", "lemma-name-lookup-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            function_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_function_index(&functions, &name_index_work)
            if not function_index_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "function-name index could not be built within its validated bounds", function_index_status.reason, function_index_status.observed, function_index_status.limit)
                return
            function_alias_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_function_module_aliases(file.enum_annotations, &functions, &name_index_work)
            if not function_alias_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "module-alias index could not be built within its validated bounds", function_alias_status.reason, function_alias_status.observed, function_alias_status.limit)
                return
            fact_call_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_fact_call_shape_indexes(&functions, &name_index_work)
            if not fact_call_index_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "fact call-shape indexes could not be built within their validated bounds", fact_call_index_status.reason, fact_call_index_status.observed, fact_call_index_status.limit)
                return
            fact_call_snapshot_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_fact_call_shape_snapshot(file, report, functions, &name_index_work)
            if not fact_call_snapshot_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "fact call-shape snapshot could not be built within its validated bounds", fact_call_snapshot_status.reason, fact_call_snapshot_status.observed, fact_call_snapshot_status.limit)
                return
            call_target_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_resolve_function_call_targets(report, &functions, &name_index_work)
            if not call_target_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "call graph targets could not be resolved within their validated bounds", call_target_status.reason, call_target_status.observed, call_target_status.limit)
                return
            functions.module_resolution_work_used <- name_index_work
            proof_qualify_repeated_contract_rows(file, &functions)
            if functions.module_resolution_work_exhausted:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "qualified contract call resolution exceeded its shared source-work bound", "module-call-resolution-work", functions.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            name_index_work <- functions.module_resolution_work_used
            proof_build_function_components(&functions)
            proof_mark_pure_functions(file, file.top_decls, &functions, report)
            fact_call_purity_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_fact_call_shape_snapshot_purity(&report.fact_call_shapes, functions, &name_index_work)
            if not fact_call_purity_status.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "fact call-shape purity data could not be bound within its validated bounds", fact_call_purity_status.reason, fact_call_purity_status.observed, fact_call_purity_status.limit)
                return
            functions.module_resolution_work_used <- name_index_work
            proof_check_structural_termination(file, file.top_decls, functions, report, true)
            (proof_compute_verified_lemmas(file, file.top_decls, &lemmas, functions, report) can Global{Read,Write})
            (proof_compute_verified_functions(file, file.top_decls, lemmas, &functions, report, focus_function) can Global{Read,Write})
            name_index_work <- functions.module_resolution_work_used
            proof_record_declarations(file, file.top_decls, lemmas, functions, report, &name_index_work)
            if functions.module_resolution_work_exhausted:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "function call resolution exceeded its shared source-work bound", "module-call-resolution-work", functions.module_resolution_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if name_index_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "declaration reporting could not classify lemma names within its validated work bound", "lemma-name-lookup-work", name_index_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        # A direct API caller receives a report only after every supported simple source
        # postcondition has a matching goal attempt and, when proven, a matching certificate
        # claim. Kernel replay remains an explicit follow-up operation for compatibility.
        def proof_api_source_binding_consistent(source_literal_ensures: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, report: ProofReport&) -> bool:
            return proof_source_literal_ensure_binding_coverage(source_literal_ensures, report)

        def proof_api_add_assert_by_inventory_finding(inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, report: mutable ProofReport&) -> void:
            proof_add_finding(report, "source-obligation-inventory", 0, "", "an assert-by target or proof step is unsupported, omitted, duplicated, falsely claimed, or unreplayed")
            report.findings[report.findings.count - 1].status <- "unsupported" if proof_source_assert_by_inventory_has_unsupported(inventory) and report.findings.count > 0

    public:
        # Public compatibility wrapper for standalone proof consumers.  The semantic table is
        # owned by this short helper and is gone before the larger proof core begins.
        def proof_check(file: Ast::File&, report: mutable ProofReport&) -> void:
            source_literal_ensures: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(file.top_decls)
            source_assert_by_goals: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = proof_source_assert_by_inventory(file.top_decls)
            ready: bool = (proof_prepare_semantic_source(file, report) can Global{Read,Write})
            if ready:
                (proof_check_core(file, report, "") can Global{Read,Write})
                if not proof_api_source_binding_consistent(source_literal_ensures, report):
                    proof_add_finding(report, "source-obligation-inventory", 0, "", "a supported source postcondition has no distinct source-bound proof attempt")
                if not proof_source_assert_by_attempt_coverage(source_assert_by_goals, report):
                    proof_api_add_assert_by_inventory_finding(source_assert_by_goals, report)

        # Build compiler semantics once, prepare source propositions, and copy only structured
        # diagnostics. Returning releases the large compiler symbol table before the proof core,
        # replay, and JSON rendering retain their own working sets.
        def proof_check_with_semantic_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> void:
            source_literal_ensures: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(file.top_decls)
            source_assert_by_goals: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = proof_source_assert_by_inventory(file.top_decls)
            ready: bool = (proof_prepare_semantic_source_with_diagnostics(file, report, diagnostics) can Global{Read,Write})
            if ready:
                (proof_check_core(file, report, "") can Global{Read,Write})
                if not proof_api_source_binding_consistent(source_literal_ensures, report):
                    proof_add_finding(report, "source-obligation-inventory", 0, "", "a supported source postcondition has no distinct source-bound proof attempt")
                if not proof_source_assert_by_attempt_coverage(source_assert_by_goals, report):
                    proof_api_add_assert_by_inventory_finding(source_assert_by_goals, report)

        # Focused runs retain whole-file semantic/type context and the ordinary call-summary
        # scheduler, but spend the bounded proof arena only on the requested function and its
        # transitive executable callees. Unselected functions never gain verified summaries.
        def proof_check_focused_with_semantic_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&, focus_function: sview) -> void:
            ready: bool = (proof_prepare_semantic_source_with_diagnostics(file, report, diagnostics) can Global{Read,Write})
            if ready:
                (proof_check_core(file, report, focus_function) can Global{Read,Write})
                if not proof_report_focused_source_literal_ensures_bound(report):
                    proof_add_finding(report, "source-obligation-inventory", 0, focus_function, "a supported focused source postcondition has no distinct source-bound proof attempt")

    private:
        # Source-analysis entry point. It performs the check itself against the same
        # parser-owned Ast::File captured by the source capability, then records that exact
        # file identity in private report state. A report built through a compatibility checker
        # cannot be retroactively stamped as belonging to an unrelated source.
        def proof_check_with_source_analysis[@r](report: mutable ProofReport& @r, diagnostics: mutable darray[Semantic::Diagnostic]& @r, source: ProofSourceAnalysis[r], focus_function: sview) -> bool can[Memory.Allocate, Global.Read, Global.Write]:
            return false if not source.issued
            return false if report.source_analysis_bound or report.source_file_identity != 0
            return false if report.goal_attempts.count > 0 or report.certificates.count > 0 or report.source_declarations.count > 0
            source_file_identity: uintptr = source.file_identity
            file: Ast::File& = source.file
            proof_fact_call_shape_snapshot_reset(report.fact_call_shapes)
            report.fact_call_shapes.source_identity <- source_file_identity
            report.fact_call_shapes.source_fingerprint <- source.source_fingerprint
            report.fact_call_shapes.source_check_active <- true
            report.source_file_identity <- source_file_identity
            if focus_function == "":
                (proof_check_with_semantic_diagnostics(file, report, diagnostics) can Global{Read,Write})
            else:
                (proof_check_focused_with_semantic_diagnostics(file, report, diagnostics, focus_function) can Global{Read,Write})
            report.fact_call_shapes.source_check_active <- false
            report.source_analysis_bound <- true
            return true

    private:
        def proof_semantic_diagnostic_refutes_obligation(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.LocalWhereRefinementViolated:
                    return true
                Semantic::DiagnosticKind.ParametricIndexViolated:
                    return true
                Semantic::DiagnosticKind.PreconditionProvablyViolated:
                    return true
                Semantic::DiagnosticKind.PreconditionViolated:
                    return true
                Semantic::DiagnosticKind.RefinementBoundViolated:
                    return true
                Semantic::DiagnosticKind.StructFieldRefinementViolated:
                    return true
                Semantic::DiagnosticKind.UsesPreconditionViolated:
                    return true
                Semantic::DiagnosticKind.WhereRefinementReassignViolated:
                    return true
                _:
                    return false
            return false

        def proof_semantic_diagnostic_leaves_obligation_open(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.LocalRefinementUnproven:
                    return true
                Semantic::DiagnosticKind.PreconditionUnproven:
                    return true
                Semantic::DiagnosticKind.QuantifiedRefinementUnproven:
                    return true
                Semantic::DiagnosticKind.RefinementArgNotProven:
                    return true
                Semantic::DiagnosticKind.RefinementReturnNotProven:
                    return true
                _:
                    return false
            return false

        def proof_semantic_diagnostic_is_non_exhaustive(kind: Semantic::DiagnosticKind) -> bool:
            match kind:
                Semantic::DiagnosticKind.NonExhaustiveMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveOptionalMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveScalarMatch:
                    return true
                Semantic::DiagnosticKind.NonExhaustiveOpenExternEnum:
                    return true
                _:
                    return false
            return false

        # Preserve the compiler driver's stage0-compatible diagnostic policy while sharing the
        # one semantic table with proof formation. Refuted obligations supersede weaker
        # "unproven" messages, non-exhaustive matches supersede a derived missing-return message,
        # and repeated ensure findings are collapsed by the same source identity as the compiler.
        def proof_copy_normalized_semantic_diagnostics(source: darray[Semantic::Diagnostic]&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> void:
            refuted_lines: mutable darray[u32] = []
            for diagnostic in source |refuted_lines|:
                refuted_lines.push(diagnostic.line) if proof_semantic_diagnostic_refutes_obligation(diagnostic.kind)
            ensure_violated_names: mutable darray[sview] = []
            ensure_violated_lines: mutable darray[u32] = []
            for diagnostic in source |ensure_violated_names, ensure_violated_lines|:
                if diagnostic.kind == Semantic::DiagnosticKind.EnsureNotProven and diagnostic.detail == "violated":
                    ensure_violated_names.push(diagnostic.name)
                    ensure_violated_lines.push(diagnostic.line)
            ensure_seen_names: mutable darray[sview] = []
            ensure_seen_lines: mutable darray[u32] = []
            ensure_seen_details: mutable darray[sview] = []
            for diagnostic in source |diagnostics, refuted_lines, ensure_violated_names, ensure_violated_lines, ensure_seen_names, ensure_seen_lines, ensure_seen_details|:
                skip: mutable bool = false
                if diagnostic.kind == Semantic::DiagnosticKind.MissingReturnValue:
                    for candidate in source |skip, diagnostic|:
                        skip <- true if candidate.line == diagnostic.line and proof_semantic_diagnostic_is_non_exhaustive(candidate.kind)
                if proof_semantic_diagnostic_leaves_obligation_open(diagnostic.kind):
                    for refuted_line in refuted_lines |skip, diagnostic|:
                        skip <- true if refuted_line == diagnostic.line
                if diagnostic.kind == Semantic::DiagnosticKind.EnsureNotProven:
                    ensure_seen: mutable bool = false
                    for index in 0..<ensure_seen_names.count |index, ensure_seen, ensure_seen_names, ensure_seen_lines, ensure_seen_details, diagnostic|:
                        ensure_seen <- true if ensure_seen_names[index] == diagnostic.name and ensure_seen_lines[index] == diagnostic.line and ensure_seen_details[index] == diagnostic.detail
                    if diagnostic.detail != "violated":
                        for index in 0..<ensure_violated_names.count |index, ensure_seen, ensure_violated_names, ensure_violated_lines, diagnostic|:
                            ensure_seen <- true if ensure_violated_names[index] == diagnostic.name and ensure_violated_lines[index] == diagnostic.line
                    if not ensure_seen:
                        ensure_seen_names.push(diagnostic.name)
                        ensure_seen_lines.push(diagnostic.line)
                        ensure_seen_details.push(diagnostic.detail)
                    skip <- true if ensure_seen
                diagnostics.push(diagnostic) if not skip

        def proof_prepare_semantic_source(file: Ast::File&, report: mutable ProofReport&) -> bool can[Global.Read, Global.Write]:
            source_types: mutable Semantic::SymbolTable = Semantic::SymbolTable()
            source_types <- (Semantic::check_full_into(file, source_types, false, false, false, false, true, false, false, false, false, false, PROOF_SEMANTIC_DIAGNOSTIC_LIMIT, true, true, false) can Global{Read,Write})
            return proof_prepare_semantic_source_checked(file, report, source_types)

        def proof_prepare_semantic_source_with_diagnostics(file: Ast::File&, report: mutable ProofReport&, diagnostics: mutable darray[Semantic::Diagnostic]&) -> bool can[Global.Read, Global.Write]:
            source_types: mutable Semantic::SymbolTable = Semantic::SymbolTable()
            source_types <- (Semantic::check_full_into(file, source_types, false, false, false, false, true, false, false, false, false, false, PROOF_SEMANTIC_DIAGNOSTIC_LIMIT, true, true, false) can Global{Read,Write})
            ready: bool = proof_prepare_semantic_source_checked(file, report, source_types)
            proof_copy_normalized_semantic_diagnostics(source_types.diagnostics, diagnostics)
            return ready

        # These legacy compiler proof checks can be superseded only after the custom
        # kernel discharges their exact obligations. They are not malformed-source errors.
        def proof_semantic_diagnostic_is_deferred_proof(diagnostic: Semantic::Diagnostic) -> bool:
            match diagnostic.kind:
                Semantic::DiagnosticKind.EnsureNotProven:
                    return diagnostic.detail != "violated"
                Semantic::DiagnosticKind.AssertByUnproven:
                    return true
                Semantic::DiagnosticKind.MutualDecreasesCycle:
                    return true
                _:
                    return false
            return false

        # Ordinary compilation keeps these definite traps as warnings for compatibility.
        # Verification cannot admit them as discharged safety obligations.
        def proof_semantic_diagnostic_refutes_arithmetic_safety(kind: Semantic::DiagnosticKind) -> bool:
            return kind == Semantic::DiagnosticKind.DivisionByZero or kind == Semantic::DiagnosticKind.ModuloByZero or kind == Semantic::DiagnosticKind.OversizedShift or kind == Semantic::DiagnosticKind.NegativeShift

        # Compatibility warnings do not discharge permission obligations.
        def proof_semantic_diagnostic_requires_permission(kind: Semantic::DiagnosticKind) -> bool:
            return kind == Semantic::DiagnosticKind.UngrantedPanic or kind == Semantic::DiagnosticKind.UngrantedEffectCall or kind == Semantic::DiagnosticKind.UngrantedPointerCast or kind == Semantic::DiagnosticKind.UngrantedBufferReinterpret or kind == Semantic::DiagnosticKind.UncheckedIndexUngranted or kind == Semantic::DiagnosticKind.MutableAliasUngranted or kind == Semantic::DiagnosticKind.UngrantedParallelFor

        def proof_prepare_semantic_source_checked(file: Ast::File&, report: mutable ProofReport&, source_types: Semantic::SymbolTable&) -> bool:
            for diagnostic in source_types.diagnostics:
                if proof_semantic_diagnostic_refutes_arithmetic_safety(diagnostic.kind):
                    proof_reset_report(report)
                    proof_add_finding(report, "arithmetic-safety-refuted", diagnostic.line, "", "compiler identified a definite division, modulo, or shift safety failure; verification was skipped")
                    report.findings[report.findings.count - 1].status <- "disproved"
                    return false
                if proof_semantic_diagnostic_requires_permission(diagnostic.kind):
                    proof_reset_report(report)
                    proof_add_finding(report, "semantic-permission-ungranted", diagnostic.line, "", "a required panic, effect, pointer, buffer, index, alias or parallel permission is missing; verification was skipped")
                    return false
                match diagnostic.kind:
                    Semantic::DiagnosticKind.ExpressionAnalysisDepthExceeded:
                        # The compiler has proved that part of this AST was not semantically
                        # checked. Do not run the proof core over that unexamined subtree: it
                        # can neither establish a valid source judgment nor produce a trustworthy
                        # proof. Keep the rejection explicit and let CLI reporting preserve the
                        # compiler diagnostic; certificate replay on the empty report stays clean.
                        proof_reset_report(report)
                        proof_add_finding(report, "semantic-analysis-depth", diagnostic.line, "", "compiler semantic analysis reached its safe expression-depth limit; proof checking was skipped")
                        return false
                    _:
                        pass
                if Semantic::diagnostic_severity(diagnostic) == 1 and not proof_semantic_diagnostic_is_deferred_proof(diagnostic):
                    # A source judgment with a mandatory compiler error is not admissible,
                    # even when another declaration has an independently provable goal.
                    # Use caller-independent text: diagnostic views remain compiler-owned.
                    proof_reset_report(report)
                    proof_add_finding(report, "semantic-source-inadmissible", diagnostic.line, "", "compiler reported a mandatory semantic error; proof checking was skipped")
                    return false
            return proof_prepare_source(file, report, source_types)
