# Fixed-array places. A fixed array's element count is part of its type (`T[N]`,
# `array[T, N]`), and an assignment replaces elements, never the extent, so a place of that
# type holds exactly N elements for its whole lifetime. The index checker uses this to turn a
# proved `index < N` into `index < place.count`. The places are a parameter and the fields
# reachable from it through uniquely declared structs; the compiler rejects a local that
# reuses a parameter's name, so a place rooted at a parameter spelling always denotes it.
extend ElisaProof:
    private:
        const PROOF_FIXED_PLACE_DEPTH_LIMIT: usize = 3
        const PROOF_FIXED_PLACE_BUDGET: usize = 64
        const PROOF_FIXED_PLACE_MATCH_DEPTH_LIMIT: usize = 64
        const PROOF_FIXED_EXTENT_SEARCH_DEPTH_LIMIT: usize = 64
        # Each budgeted shape visit may emit up to one row per nested extent. Reserve the
        # worst-case collection, scalar-reference rows, and global mutable-array imports.
        const PROOF_FIXED_PLACE_ENTRY_LIMIT: usize = 4224

        # Primitive fixed-array element heads. Concrete records are checked separately
        # by declaration identity; a generic-looking head alone is insufficient.
        def proof_fixed_array_primitive_head(head: sview) -> bool:
            return head in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr", "f32", "f64", "bool", "char"}

        # Metered twin used while projecting source types into the proof kernel. The ordinary
        # checker helper above remains available to its existing per-function callers; this
        # variant counts every declaration and every spelling comparison before deciding that a
        # non-primitive head names one unaliased struct.
        def proof_fixed_array_source_work_charge(amount: usize, source_work: mutable usize&) -> bool:
            if not proof_replay_source_work_charge(amount, source_work):
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            true

        def proof_fixed_array_source_shape_counts(declarations: darray[Ast::Decl]&, head: sview, source_work: mutable usize&, alias_count: mutable usize&, struct_count: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT:
                alias_count <- 1
                struct_count <- 2
                return true
            for declaration in declarations |head, source_work, alias_count, struct_count, depth|:
                return false if not proof_fixed_array_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Alias(name, _, _):
                        return false if:
                            not proof_fixed_array_source_work_charge(sview_len(head), source_work)
                            not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                        alias_count <- alias_count + 1 if name == head
                        return true if alias_count > 0
                    Ast::Decl.Struct(name, _, _, _, _, _, _):
                        return false if:
                            not proof_fixed_array_source_work_charge(sview_len(head), source_work)
                            not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                        struct_count <- struct_count + 1 if name == head
                        return true if struct_count > 1
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_fixed_array_source_shape_counts(body, head, source_work, alias_count, struct_count, depth + 1)
                        return true if alias_count > 0 or struct_count > 1
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_fixed_array_source_shape_counts(body, head, source_work, alias_count, struct_count, depth + 1)
                        return true if alias_count > 0 or struct_count > 1
                    _:
                        pass
            return true

        def proof_fixed_array_source_head_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, source_work: mutable usize&) -> bool:
            head: sview = proof_ident_name(expression)
            for comparison in 0..<16 |comparison, head, source_work|:
                return false if not proof_fixed_array_source_work_charge(sview_len(head), source_work)
            return true if proof_fixed_array_primitive_head(head)
            return false if head == ""
            alias_count: mutable usize = 0
            struct_count: mutable usize = 0
            return false if not proof_fixed_array_source_shape_counts(declarations, head, source_work, &alias_count, &struct_count, 0)
            return alias_count == 0 and struct_count == 1

        def proof_fixed_array_alias_target_with_work(declarations: darray[Ast::Decl]&, wanted: sview, count: mutable usize&, target: mutable Ast::Expr&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |wanted, count, target, source_work, depth|:
                return false if not proof_fixed_array_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Alias(name, value, _):
                        return false if:
                            not proof_fixed_array_source_work_charge(sview_len(wanted), source_work)
                            not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                        if name == wanted:
                            count <- count + 1
                            target <- value
                            return true if count > 1
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_fixed_array_alias_target_with_work(body, wanted, count, target, source_work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_fixed_array_alias_target_with_work(body, wanted, count, target, source_work, depth + 1)
                    _:
                        pass
            return true

        # The collector's type-head resolver mirrors proof_type_head_name while charging each
        # alias census. This avoids an unmetered whole-source scan before the field walk begins.
        def proof_fixed_array_type_head_name_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, source_work: mutable usize&, depth: usize) -> sview:
            return "" if:
                depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
                not proof_fixed_array_source_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    for comparison in 0..<14 |comparison, name, source_work|:
                        return "" if not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                    return "" if proof_scalar_primitive_type_name(name)
                    aliases: mutable usize = 0
                    target: mutable Ast::Expr = Ast::Expr.Invalid
                    return "" if:
                        not proof_fixed_array_alias_target_with_work(declarations, name, &aliases, &target, source_work, 0)
                        aliases > 1
                    return proof_fixed_array_type_head_name_with_work(target, declarations, source_work, depth + 1) if aliases == 1
                    return name
                Ast::Expr.Scope(_, name, _):
                    for comparison in 0..<14 |comparison, name, source_work|:
                        return "" if not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                    return "" if proof_scalar_primitive_type_name(name)
                    aliases: mutable usize = 0
                    target: mutable Ast::Expr = Ast::Expr.Invalid
                    return "" if not proof_fixed_array_alias_target_with_work(declarations, name, &aliases, &target, source_work, 0)
                    # The AST retains the qualified spelling, but this declaration snapshot has
                    # no owner for a leaf-only alias result. A same-named alias in another module
                    # must not rewrite this type; keep qualified aliases opaque until ownership is
                    # available, while a globally unique struct leaf can still be checked below.
                    return "" if aliases > 0
                    return name
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_fixed_array_type_head_name_with_work(inner, declarations, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_fixed_array_type_head_name_with_work(inner, declarations, source_work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    pass
            return ""

        def proof_fixed_array_shape_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, extents: mutable darray[i64]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_FIXED_EXTENT_SEARCH_DEPTH_LIMIT
                not proof_fixed_array_source_work_charge(1, source_work)
            match expression:
                Ast::Expr.Unary(_, operand, _):
                    return proof_fixed_array_shape_with_work(operand, declarations, extents, source_work, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_array_shape_with_work(inner, declarations, extents, source_work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    head: sview = proof_head_name(object)
                    return false if:
                        not proof_fixed_array_source_work_charge(sview_len(head), source_work)
                        head != "array" or arguments.count != 2
                    extent: (known: bool, value: i64) = proof_fixed_extent_constant_with_work(arguments[1], declarations, source_work, 0)
                    return false if not extent.known
                    if extents.count >= PROOF_FIXED_PLACE_ENTRY_LIMIT:
                        source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return false
                    extents.push(extent.value)
                    nested: mutable darray[i64] = []
                    nested_is_shape: bool = proof_fixed_array_shape_with_work(arguments[0], declarations, &nested, source_work, depth + 1)
                    return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    if nested_is_shape and nested.count > PROOF_FIXED_PLACE_ENTRY_LIMIT - extents.count:
                        source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return false
                    extents.extend(nested) if nested_is_shape
                    return true
                Ast::Expr.Index(object, extent_expression, _):
                    return false if not proof_fixed_array_source_head_with_work(object, declarations, source_work)
                    extent: (known: bool, value: i64) = proof_fixed_extent_constant_with_work(extent_expression, declarations, source_work, 0)
                    return false if not extent.known
                    if extents.count >= PROOF_FIXED_PLACE_ENTRY_LIMIT:
                        source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return false
                    extents.push(extent.value)
                    return true
                _:
                    return false

        def proof_collect_fixed_extent_names_with_work(expression: Ast::Expr, names: mutable darray[sview]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_FIXED_EXTENT_SEARCH_DEPTH_LIMIT
                not proof_fixed_array_source_work_charge(1, source_work)
            extent: mutable Ast::Expr = Ast::Expr.Invalid
            match expression:
                Ast::Expr.Unary(_, operand, _):
                    return proof_collect_fixed_extent_names_with_work(operand, names, source_work, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_collect_fixed_extent_names_with_work(inner, names, source_work, depth + 1)
                Ast::Expr.IndexN(_, arguments, _):
                    if arguments.count == 2:
                        return false if not proof_collect_fixed_extent_names_with_work(arguments[0], names, source_work, depth + 1)
                        extent <- arguments[1]
                Ast::Expr.Index(_, extent_expression, _):
                    extent <- extent_expression
                _:
                    pass
            match extent:
                Ast::Expr.Scope(_, constant_name, _):
                    found: mutable bool = false
                    for existing in names |existing, constant_name, source_work, found|:
                        return false if:
                            not proof_fixed_array_source_work_charge(1, source_work)
                            not proof_fixed_array_source_work_charge(sview_len(existing), source_work)
                            not proof_fixed_array_source_work_charge(sview_len(constant_name), source_work)
                        found <- true if existing == constant_name
                    names.push(constant_name) if not found
                _:
                    pass
            return true

        # Collect one uniquely named struct's members under the same meter as type resolution.
        # Returning `complete = false` or a declaration count other than one admits no fields.
        def proof_fixed_array_struct_members_with_work(declarations: darray[Ast::Decl]&, struct_name: sview, members: mutable darray[Ast::StructMember]&, source_work: mutable usize&, depth: usize) -> (complete: bool, count: usize):
            return (false, 2) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |struct_name, members, source_work, depth, count|:
                return (false, 2) if not proof_fixed_array_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Struct(name, struct_members, _, _, _, _, _):
                        return (false, 2) if:
                            not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                            not proof_fixed_array_source_work_charge(sview_len(struct_name), source_work)
                        if name == struct_name:
                            count <- count + 1
                            return (true, 2) if count > 1
                            for member in struct_members |members, source_work|:
                                return (false, 2) if:
                                    not proof_fixed_array_source_work_charge(1, source_work)
                                    not proof_fixed_array_source_work_charge(sview_len(member.name), source_work)
                                members.push(member)
                    Ast::Decl.Module(_, body, _):
                        nested: (complete: bool, count: usize) = proof_fixed_array_struct_members_with_work(body, struct_name, members, source_work, depth + 1)
                        return (false, 2) if not nested.complete
                        count <- count + nested.count
                        return (true, 2) if count > 1
                    Ast::Decl.Scoped(body, _):
                        nested: (complete: bool, count: usize) = proof_fixed_array_struct_members_with_work(body, struct_name, members, source_work, depth + 1)
                        return (false, 2) if not nested.complete
                        count <- count + nested.count
                        return (true, 2) if count > 1
                    _:
                        pass
            return (true, count)

        # A reverse, metered open-addressed pass marks the last occurrence of each field name.
        # The prior field-type helper also selected the last repeated name; retaining only that
        # row preserves its meaning while avoiding one linear member scan per declaration.
        def proof_fixed_array_latest_members_with_work(members: darray[Ast::StructMember]&, latest: mutable darray[bool]&, source_work: mutable usize&) -> bool:
            latest.clear()
            member_count: usize = members.count
            if member_count == 0:
                return true
            capacity: usize = proof_name_index_capacity(member_count)
            return false if:
                capacity == 0
                not proof_fixed_array_source_work_charge(capacity, source_work)
                not proof_fixed_array_source_work_charge(capacity, source_work)
                not proof_fixed_array_source_work_charge(capacity, source_work)
                not proof_fixed_array_source_work_charge(member_count, source_work)
                not proof_fixed_array_source_work_charge(member_count, source_work)
            hashes: mutable darray[u32] = []
            values: mutable darray[usize] = []
            hashes.resize(capacity)
            values.resize(capacity)
            latest.resize(member_count)
            for row in 0..<member_count |row, latest|:
                latest[row] <- false
            for slot in 0..<capacity |slot, values, member_count|:
                values[slot] <- member_count
            row: mutable usize = member_count
            while row > 0 |row, members, latest, hashes, values, capacity, member_count, source_work|:
                row <- row - 1
                name: sview = members[row].name
                return false if not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                hash: u32 = proof_name_hash(name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, name, members, latest, hashes, values, capacity, member_count, source_work, placed|:
                    return false if not proof_fixed_array_source_work_charge(1, source_work)
                    current: usize = values[slot]
                    if current == member_count:
                        hashes[slot] <- hash
                        values[slot] <- row
                        latest[row] <- true
                        placed <- true
                        break
                    if hashes[slot] == hash:
                        current_name: sview = members[current].name
                        return false if not proof_fixed_array_source_work_charge(sview_len(current_name), source_work)
                        if current_name == name:
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            return true

        def proof_fixed_extent_integer_type(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Absent:
                    return true
                Ast::Expr.Ident(name, _):
                    return name in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize"}
                _:
                    return false

        def proof_fixed_extent_find_constant_with_work(declarations: darray[Ast::Decl]&, module_name: sview, constant_name: sview, inside: bool, matches: mutable usize&, value: mutable i64&, source_work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_FIXED_EXTENT_SEARCH_DEPTH_LIMIT:
                matches <- matches + 2
                return true
            for declaration in declarations |module_name, constant_name, inside, matches, value, source_work, depth|:
                return false if not proof_fixed_array_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Const(name, type_expression, initializer, is_mutable, _):
                        if inside:
                            return false if:
                                not proof_fixed_array_source_work_charge(sview_len(constant_name), source_work)
                                not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                            if name == constant_name:
                                matches <- matches + 1
                                value <- -1
                                if not is_mutable:
                                    match type_expression:
                                        Ast::Expr.Ident(type_name, _):
                                            for comparison in 0..<11 |comparison, type_name, source_work|:
                                                return false if not proof_fixed_array_source_work_charge(sview_len(type_name), source_work)
                                        _:
                                            pass
                                    if proof_fixed_extent_integer_type(type_expression):
                                        match initializer:
                                            Ast::Expr.IntLit(literal, _):
                                                value <- literal if literal >= 0
                                            _:
                                                pass
                    Ast::Decl.Module(name, body, _):
                        return false if:
                            not proof_fixed_array_source_work_charge(sview_len(module_name), source_work)
                            not proof_fixed_array_source_work_charge(sview_len(name), source_work)
                        next_inside: bool = proof_qualified_segment_matches(name, module_name)
                        return false if not proof_fixed_extent_find_constant_with_work(body, module_name, constant_name, next_inside, matches, value, source_work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_fixed_extent_find_constant_with_work(body, module_name, constant_name, inside, matches, value, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_fixed_extent_constant_eval_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (known: bool, value: i64):
            return (false, 0) if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
                not proof_fixed_array_source_work_charge(1, source_work)
            match expression:
                Ast::Expr.IntLit(literal, _):
                    return (true, literal)
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_extent_constant_eval_with_work(inner, source_work, depth + 1)
                Ast::Expr.Field(object, field_name, _):
                    return (false, 0) if:
                        not proof_fixed_array_source_work_charge(sview_len(field_name), source_work)
                        field_name != "count"
                        not proof_fixed_array_source_work_charge(1, source_work)
                    match object:
                        Ast::Expr.Array(elements, _):
                            return proof_small_literal_count(elements.count)
                        _:
                            return (false, 0)
                Ast::Expr.Unary(operator, operand, _):
                    found: (known: bool, value: i64) = proof_fixed_extent_constant_eval_with_work(operand, source_work, depth + 1)
                    if found.known and operator == TokenKind.Minus:
                        return (true, 0 - found.value) if found.value != proof_i64_min()
                    if found.known and operator == TokenKind.Plus:
                        return found
                    return (false, 0)
                Ast::Expr.Binary(left, operator, right, _):
                    a: (known: bool, value: i64) = proof_fixed_extent_constant_eval_with_work(left, source_work, depth + 1)
                    b: (known: bool, value: i64) = proof_fixed_extent_constant_eval_with_work(right, source_work, depth + 1)
                    return (false, 0) if not a.known or not b.known
                    if operator == TokenKind.Plus:
                        return proof_add_safe(a.value, b.value)
                    if operator == TokenKind.Minus:
                        return proof_sub_safe(a.value, b.value)
                    if operator == TokenKind.Star:
                        return proof_mul_safe(a.value, b.value)
                    if operator == TokenKind.Slash:
                        return proof_div_safe(a.value, b.value)
                    if operator == TokenKind.Percent:
                        return proof_mod_safe(a.value, b.value)
                    if operator == TokenKind.Ampersand:
                        return (true, a.value & b.value)
                    if operator == TokenKind.Pipe:
                        return (true, a.value | b.value)
                    if operator == TokenKind.Caret:
                        return (true, a.value ^ b.value)
                    if operator == TokenKind.LShift:
                        return proof_shift_safe(a.value, b.value, true)
                    if operator == TokenKind.RShift:
                        return proof_shift_safe(a.value, b.value, false)
                    return (false, 0)
                _:
                    return (false, 0)

        # Kernel source projection uses the same fixed-array semantics while charging each
        # expression node and each declaration examined for a qualified extent constant.
        def proof_fixed_extent_constant_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, source_work: mutable usize&, depth: usize) -> (known: bool, value: i64):
            return (false, 0) if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
                not proof_fixed_array_source_work_charge(1, source_work)
            match expression:
                Ast::Expr.IntLit(literal, _):
                    return (true, literal) if literal >= 0
                    return (false, 0)
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_extent_constant_with_work(inner, declarations, source_work, depth + 1)
                Ast::Expr.Scope(base, constant_name, _):
                    module_name: sview = proof_head_name(base)
                    return (false, 0) if:
                        module_name == ""
                        not proof_fixed_array_source_work_charge(sview_len(module_name), source_work)
                        not proof_fixed_array_source_work_charge(sview_len(constant_name), source_work)
                    matches: mutable usize = 0
                    value: mutable i64 = -1
                    return (false, 0) if not proof_fixed_extent_find_constant_with_work(declarations, module_name, constant_name, false, &matches, &value, source_work, 0)
                    return (true, value) if matches == 1 and value >= 0
                    return (false, 0)
                _:
                    literal: (known: bool, value: i64) = proof_fixed_extent_constant_eval_with_work(expression, source_work, 0)
                    return literal if literal.known and literal.value >= 0
                    return (false, 0)

        # The leaf names of the qualified extent constants a fixed-array type spells. The
        # function-boundary importer unfolds the same constant where the body spells it bare.
        def proof_collect_fixed_extent_names(expression: Ast::Expr, names: mutable darray[sview]&, depth: usize) -> void:
            return if depth >= PROOF_FIXED_EXTENT_SEARCH_DEPTH_LIMIT
            extent: mutable Ast::Expr = Ast::Expr.Invalid
            match expression:
                Ast::Expr.Unary(_, operand, _):
                    proof_collect_fixed_extent_names(operand, names, depth + 1)
                Ast::Expr.Paren(inner, _):
                    proof_collect_fixed_extent_names(inner, names, depth + 1)
                Ast::Expr.IndexN(_, arguments, _):
                    if arguments.count == 2:
                        proof_collect_fixed_extent_names(arguments[0], names, depth + 1)
                        extent <- arguments[1]
                Ast::Expr.Index(_, extent_expression, _):
                    extent <- extent_expression
                _:
                    pass
            match extent:
                Ast::Expr.Scope(_, constant_name, _):
                    names.push(constant_name) if not (any existing in names where existing == constant_name)
                _:
                    pass

        # The outermost extent of a declared fixed-array type, or -1 for any other type.
        def proof_local_fixed_extent_with_work(type_expression: Ast::Expr, declarations: darray[Ast::Decl]&, source_work: mutable usize&) -> i64:
            shape: mutable darray[i64] = []
            return -1 if not proof_fixed_array_shape_with_work(type_expression, declarations, &shape, source_work, 0) or shape.count == 0
            shape[0]

        # Meter every row and recursive shape comparison used to match a tracked place. A
        # failed charge poisons the shared source-work counter so callers cannot keep using a
        # partial lookup as evidence.
        def proof_fixed_place_matches_with_work(object: Ast::Expr, place: Ast::Expr, depth: usize, source_work: mutable usize&) -> (complete: bool, matches: bool):
            return (false, false) if depth >= PROOF_FIXED_PLACE_MATCH_DEPTH_LIMIT or not proof_fixed_array_source_work_charge(1, source_work)
            match object:
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_place_matches_with_work(inner, place, depth + 1, source_work)
                Ast::Expr.Ident(object_name, _):
                    match place:
                        Ast::Expr.Ident(place_name, _):
                            return (false, false) if not proof_fixed_array_source_work_charge(sview_len(object_name), source_work)
                            return (false, false) if not proof_fixed_array_source_work_charge(sview_len(place_name), source_work)
                            return (true, object_name == place_name)
                        _:
                            return (true, false)
                Ast::Expr.Field(object_base, object_field, _):
                    match place:
                        Ast::Expr.Field(place_base, place_field, _):
                            return (false, false) if not proof_fixed_array_source_work_charge(sview_len(object_field), source_work)
                            return (false, false) if not proof_fixed_array_source_work_charge(sview_len(place_field), source_work)
                            return (true, false) if object_field != place_field
                            return proof_fixed_place_matches_with_work(object_base, place_base, depth + 1, source_work)
                        _:
                            return (true, false)
                _:
                    return (true, false)

        # Collect fixed-array places under two independent limits: `budget` caps emitted places,
        # while `source_work` charges every source/declaration/member scan used to derive them.
        def proof_collect_fixed_array_places_with_work(root: Ast::Expr, type_expression: Ast::Expr, declarations: darray[Ast::Decl]&, places: mutable darray[Ast::Expr]&, extents: mutable darray[i64]&, constant_names: mutable darray[sview]&, depth: usize, budget: mutable usize&, source_work: mutable usize&) -> void:
            return if depth >= PROOF_FIXED_PLACE_DEPTH_LIMIT or budget == 0
            return if not proof_fixed_array_source_work_charge(1, source_work)
            budget <- budget - 1
            shape: mutable darray[i64] = []
            if proof_fixed_array_shape_with_work(type_expression, declarations, &shape, source_work, 0):
                if places.count > PROOF_FIXED_PLACE_ENTRY_LIMIT or shape.count > PROOF_FIXED_PLACE_ENTRY_LIMIT - places.count:
                    source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                    return
                new_names: mutable darray[sview] = []
                return if not proof_collect_fixed_extent_names_with_work(type_expression, &new_names, source_work, 0)
                return if shape.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
                return if not proof_fixed_array_source_work_charge(shape.count, source_work) or not proof_fixed_array_source_work_charge(shape.count, source_work)
                for new_name in new_names |new_name, constant_names, source_work|:
                    found: mutable bool = false
                    for existing in constant_names |existing, new_name, source_work, found|:
                        return if not proof_fixed_array_source_work_charge(1, source_work)
                        return if not proof_fixed_array_source_work_charge(sview_len(existing), source_work)
                        return if not proof_fixed_array_source_work_charge(sview_len(new_name), source_work)
                        found <- true if existing == new_name
                    constant_names.push(new_name) if not found
                for extent in shape |places, extents, root|:
                    places.push(root)
                    extents.push(extent)
                return
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            struct_name: sview = proof_fixed_array_type_head_name_with_work(type_expression, declarations, source_work, 0)
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return if struct_name == ""
            members: mutable darray[Ast::StructMember] = []
            member_scan: (complete: bool, count: usize) = proof_fixed_array_struct_members_with_work(declarations, struct_name, &members, source_work, 0)
            return if not member_scan.complete or member_scan.count != 1
            latest: mutable darray[bool] = []
            return if not proof_fixed_array_latest_members_with_work(members, &latest, source_work)
            position: Ast::Pos = Ast::expr_pos(root)
            for index in 0..<members.count |index, root, declarations, places, extents, constant_names, depth, budget, source_work, members, latest, position|:
                return if budget == 0
                return if not proof_fixed_array_source_work_charge(1, source_work)
                continue if index >= latest.count or not latest[index]
                field: Ast::StructMember = members[index]
                return if not proof_fixed_array_source_work_charge(sview_len(field.name), source_work)
                proof_collect_fixed_array_places_with_work(Ast::Expr.Field(root, field.name, position), field.type_expression, declarations, places, extents, constant_names, depth + 1, budget, source_work)
