const module ProofUnfoldLimit:
    NODES: usize = 24
    PATHS: usize = 16

extend ElisaProof:
    private:
        # Pure function unfolding (BACKLOG D-04). Small, straight-line conditional-return
        # functions can expose one guarded result equation per return path. The synthesized
        # ensures are checked through the ordinary return checker and summaries are consumed only
        # for verified total-pure callees. Loops, mutation, indexing and non-local names stay out.
        def proof_unfold_term_nodes(expression: Ast::Expr, depth: usize) -> usize:
            return ProofUnfoldLimit::NODES + 1 if depth > ProofUnfoldLimit::NODES
            match expression:
                Ast::Expr.IntLit(_, _):
                    return 1
                Ast::Expr.BoolLit(_, _):
                    return 1
                Ast::Expr.Ident(name, _):
                    return ProofUnfoldLimit::NODES + 1 if name == "" or name == "result"
                    return 1
                Ast::Expr.Paren(inner, _):
                    return proof_unfold_term_nodes(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return 1 + proof_unfold_term_nodes(operand, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return ProofUnfoldLimit::NODES + 1 if operator == TokenKind.RangeLt
                    return 1 + proof_unfold_term_nodes(left, depth + 1) + proof_unfold_term_nodes(right, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return 1 + proof_unfold_term_nodes(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return 1 + proof_unfold_term_nodes(base, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    nodes: mutable usize = 1 + proof_unfold_term_nodes(callee, depth + 1)
                    for argument in arguments |nodes, depth|:
                        nodes <- nodes + proof_unfold_term_nodes(argument, depth + 1)
                    return nodes
                _:
                    return ProofUnfoldLimit::NODES + 1

        def proof_unfold_primitive_type(return_type: Ast::Expr?) -> bool:
            if return_type is declared:
                match declared:
                    Ast::Expr.Ident(name, _):
                        return name == "bool" or name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "isize" or name == "usize"
                    _:
                        return false
            return false

        def proof_unfold_named_enum_type(type_expression: Ast::Expr?, declarations: darray[Ast::Decl]&) -> bool:
            if type_expression is declared:
                match declared:
                    Ast::Expr.Ident(name, _):
                        counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(declarations, name, 0)
                        return counts.enums == 0 and counts.const_enums == 1 and counts.structs == 0
                    _:
                        return false
            return false

        def proof_unfold_named_struct_type(type_expression: Ast::Expr?, declarations: darray[Ast::Decl]&) -> bool:
            if type_expression is declared:
                match declared:
                    Ast::Expr.Ident(name, _):
                        counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(declarations, name, 0)
                        return counts.enums == 0 and counts.const_enums == 0 and counts.structs == 1
                    _:
                        return false
            return false

        def proof_unfold_value_type(type_expression: Ast::Expr?, declarations: darray[Ast::Decl]&, allow_struct: bool) -> bool:
            return true if proof_unfold_primitive_type(type_expression) or proof_unfold_named_enum_type(type_expression, declarations)
            return allow_struct and proof_unfold_named_struct_type(type_expression, declarations)

        def proof_unfold_collect_names(expression: Ast::Expr, names: mutable darray[sview]&, depth: usize) -> void:
            return if depth > ProofUnfoldLimit::NODES
            match expression:
                Ast::Expr.Ident(name, _):
                    if name != "" and proof_diagnostic_counterexample_name_index(names, name) == names.count:
                        names.push(name)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Field(inner, _, _):
                    proof_unfold_collect_names(inner, names, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    proof_unfold_collect_names(left, names, depth + 1)
                    proof_unfold_collect_names(right, names, depth + 1)
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments |names, depth|:
                        proof_unfold_collect_names(argument, names, depth + 1)
                Ast::Expr.Index(object, index, _):
                    proof_unfold_collect_names(object, names, depth + 1)
                    proof_unfold_collect_names(index, names, depth + 1)
                Ast::Expr.Scope(_, _, _):
                    pass
                _:
                    pass

        def proof_unfold_path_expression(prefix: Ast::Expr, has_prefix: bool, condition: Ast::Expr, position: Ast::Pos) -> Ast::Expr:
            return condition if not has_prefix
            return Ast::Expr.Binary(prefix, TokenKind.And, condition, position)

        def proof_unfold_guarded_ensures(result: mutable darray[Ast::Expr]&, value: Ast::Expr, guard: Ast::Expr, position: Ast::Pos, bool_result: bool) -> void:
            subject: Ast::Expr = Ast::Expr.Ident("result", position)
            equality: Ast::Expr = Ast::Expr.Binary(subject, TokenKind.EqEq, value, position)
            if bool_result:
                result.push(Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, guard, position), TokenKind.Or, Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, subject, position), TokenKind.Or, value, position), position))
                result.push(Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, guard, position), TokenKind.Or, Ast::Expr.Binary(subject, TokenKind.Or, Ast::Expr.Unary(TokenKind.Not, value, position), position), position))
            else:
                result.push(Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, guard, position), TokenKind.Or, equality, position))

        def proof_unfold_append_value_ensures(result: mutable darray[Ast::Expr]&, value: Ast::Expr, guard: Ast::Expr?, position: Ast::Pos, bool_result: bool) -> bool:
            return false if proof_unfold_term_nodes(value, 0) > ProofUnfoldLimit::NODES
            if guard is path:
                return false if proof_unfold_term_nodes(path, 0) > ProofUnfoldLimit::NODES
                proof_unfold_guarded_ensures(result, value, path, position, bool_result)
                return true
            if bool_result:
                subject: Ast::Expr = Ast::Expr.Ident("result", position)
                result.push(Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, subject, position), TokenKind.Or, value, position))
                result.push(Ast::Expr.Binary(subject, TokenKind.Or, Ast::Expr.Unary(TokenKind.Not, value, position), position))
            else:
                result.push(Ast::Expr.Binary(Ast::Expr.Ident("result", position), TokenKind.EqEq, value, position))
            return true

        def proof_unfold_bool_type(return_type: Ast::Expr?) -> bool:
            if return_type is declared:
                return proof_ident_name(declared) == "bool"
            return false

        def proof_unfolded_ensures(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, return_type: Ast::Expr?, declarations: darray[Ast::Decl]&) -> darray[Ast::Expr]:
            result: mutable darray[Ast::Expr] = []
            return result if not proof_unfold_value_type(return_type, declarations, false)
            # By-value admitted scalar/const-enum/struct parameters only. Reference parameters
            # would make the summary an equation over a place rather than a value.
            for parameter in parameters |result|:
                return result if parameter.has_default or not proof_unfold_value_type(parameter.type_expression, declarations, true)
            prefix: mutable Ast::Expr = Ast::Expr.BoolLit(true, proof_resource_default_position())
            has_prefix: mutable bool = false
            paths: mutable usize = 0
            names: mutable darray[sview] = []
            for index in 0..<body.count |index, body, result, prefix, has_prefix, paths, names, return_type|:
                statement: Ast::Stmt = body[index]
                match statement:
                    Ast::Stmt.If(condition, then_body, else_body, if_position):
                        return [] if paths >= ProofUnfoldLimit::PATHS or then_body.count != 1 or else_body.count != 0
                        match then_body[0]:
                            Ast::Stmt.Return(returned_value, return_position):
                                if returned_value is returned:
                                    guard: Ast::Expr = proof_unfold_path_expression(prefix, has_prefix, condition, if_position)
                                    return [] if not proof_unfold_append_value_ensures(&result, returned, guard, return_position, proof_unfold_bool_type(return_type))
                                    proof_unfold_collect_names(condition, &names, 0)
                                    proof_unfold_collect_names(returned, &names, 0)
                                    paths <- paths + 1
                                    prefix <- Ast::Expr.Binary(prefix, TokenKind.And, Ast::Expr.Unary(TokenKind.Not, condition, if_position), if_position) if has_prefix
                                    prefix <- Ast::Expr.Unary(TokenKind.Not, condition, if_position) if not has_prefix
                                    has_prefix <- true
                                else:
                                    return []
                            _:
                                return []
                    Ast::Stmt.Return(returned_value, return_position):
                        return [] if index + 1 < body.count or paths >= ProofUnfoldLimit::PATHS
                        if returned_value is returned:
                            guard: mutable Ast::Expr? = null
                            guard <- prefix if has_prefix
                            return [] if not proof_unfold_append_value_ensures(&result, returned, guard, return_position, proof_unfold_bool_type(return_type))
                            proof_unfold_collect_names(returned, &names, 0)
                            paths <- paths + 1
                        else:
                            return []
                    Ast::Stmt.Expr(tail_value, tail_position):
                        return [] if index + 1 < body.count or paths >= ProofUnfoldLimit::PATHS
                        return [] if not proof_unfold_append_value_ensures(&result, tail_value, prefix if has_prefix else Ast::Expr.Absent, tail_position, proof_unfold_bool_type(return_type))
                        proof_unfold_collect_names(tail_value, &names, 0)
                        paths <- paths + 1
                    _:
                        return []
            return [] if paths == 0
            # Closed bodies gain nothing a caller cannot already see. Names in a scoped constant
            # are not variables; the source proposition checker still resolves every such path.
            return result if names.count == 0
            for used in names |result, parameters|:
                bound: mutable bool = false
                for parameter in parameters |bound, used|:
                    bound <- true if parameter.name == used
                return result if not bound
            return result

        # Entry facts unfold too: a precondition such as `is_digit(c)` is opaque until the
        # callee's summary is instantiated at its call. Only a verified, total-pure callee with
        # no requires qualifies, so each instance is the same `function-summary` fact a real call
        # would produce, replayed against the callee's checked ensures.
        def proof_add_precondition_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, requirement: Ast::Expr, line: u32, name: sview, functions: ProofFunctionTable&) -> void:
            proof_add_traced_fact(facts, report, requirement, "precondition", line, name)
            proof_unfold_contract_calls(requirement, facts, report, line, name, functions, 0)

        def proof_unfold_contract_calls(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, line: u32, name: sview, functions: ProofFunctionTable&, depth: usize) -> void:
            return if depth > ProofUnfoldLimit::NODES
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_unfold_contract_calls(inner, facts, report, line, name, functions, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    proof_unfold_contract_calls(operand, facts, report, line, name, functions, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    proof_unfold_contract_calls(left, facts, report, line, name, functions, depth + 1)
                    proof_unfold_contract_calls(right, facts, report, line, name, functions, depth + 1)
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return if not proof_contract_calls_are_pure(expression, functions)
                    for argument_name in argument_names:
                        return if argument_name != ""
                    for argument in arguments:
                        return if proof_expr_has_executable_call(argument)
                    called: usize = proof_function_index_for_callee(functions, callee)
                    return if called >= functions.names.count or called >= functions.pure.count or not functions.pure[called]
                    return if called >= functions.verified.count or not functions.verified[called]
                    return if called >= functions.requires_counts.count or functions.requires_counts[called] != 0
                    return if called >= functions.param_counts.count or functions.param_counts[called] != arguments.count
                    return if called >= functions.ensure_counts.count
                    parameter_names: mutable darray[sview] = []
                    for parameter_index in 0..<arguments.count |parameter_names, functions, called|:
                        parameter_names.push(functions.all_params[functions.param_starts[called] + parameter_index])
                    argument_values: mutable darray[Ast::Expr] = []
                    argument_values.extend(arguments)
                    result_names: mutable darray[sview] = ["result"]
                    result_values: mutable darray[Ast::Expr] = [expression]
                    no_requires: mutable darray[usize] = []
                    for ensure_index in 0..<functions.ensure_counts[called] |facts, report, line, name, functions, called, parameter_names, argument_values, result_names, result_values, no_requires, expression|:
                        source_ensure: Ast::Expr = functions.all_ensures[functions.ensure_starts[called] + ensure_index]
                        continue if proof_expr_has_old(source_ensure)
                        ensured: Ast::Expr = proof_substitute(proof_substitute(source_ensure, parameter_names, argument_values), result_names, result_values)
                        known: mutable bool = false
                        for fact in facts |known, ensured|:
                            known <- true if proof_expr_equal(fact, ensured)
                        continue if known
                        proof_add_function_summary_fact(facts, report, ensured, line, name, functions.names[called], parameter_names, argument_values, expression, no_requires, ensure_index, false, Ast::Expr.Absent, functions.lines[called] if called < functions.lines.count else 0)
                    proof_add_pure_call_witnesses(expression, facts, functions, report, line, name, 0)
                _:
                    return
