extend ElisaProof:
    private:
        def proof_structural_typed_operator_statements_inner(statements: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl]&, shadowed: mutable darray[ProofStructuralOperatorBinding]&, report: mutable ProofReport&, declaration_line: u32, depth: usize, scoped: bool, caller_owner: sview, caller_owner_known: bool) -> bool:
            return true if depth >= PROOF_STRUCTURAL_OPERATOR_GUARD_DEPTH_LIMIT
            saved_count: usize = shadowed.count
            for statement in statements |parameters, shadowed, report, depth, saved_count, caller_owner, caller_owner_known|:
                return true if not proof_source_index_work_charge(report, 1)
                match statement:
                    Ast::Stmt.Invalid:
                        return true
                    Ast::Stmt.Expr(expression, _):
                        return true if:
                            proof_structural_typed_operator_expression_inner(expression, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                            not proof_structural_operator_guard_add_expression_bindings(expression, &shadowed, report)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_structural_typed_operator_expression_inner(returned, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    Ast::Stmt.Block(kind, _, binding, body, _):
                        for _kind_probe in 0..<9 |kind, report|:
                            return true if not proof_source_index_work_charge(report, sview_len(kind))
                        block_scoped: bool = body.count > 0 and (kind in {"region", "in", "can", "trusted", "with", "pool", "nursery", "scope", "lock"})
                        block_count: usize = shadowed.count
                        if binding != "":
                            return true if not proof_structural_operator_guard_add_binding(binding, &shadowed, report)
                        found: bool = proof_structural_typed_operator_statements_inner(body, parameters, &shadowed, report, declaration_line, depth + 1, block_scoped, caller_owner, caller_owner_known)
                        if block_scoped:
                            while shadowed.count > block_count |shadowed, block_count|:
                                shadowed.pop()
                        return true if found
                    Ast::Stmt.VarDecl(name, type_expression, initializer, _):
                        return true if:
                            proof_structural_typed_operator_expression_inner(type_expression, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known) or proof_structural_typed_operator_expression_inner(initializer, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                            not proof_structural_operator_guard_add_expression_bindings(initializer, &shadowed, report)
                            not proof_structural_operator_guard_add_typed_binding(name, type_expression, &shadowed, report)
                    Ast::Stmt.Assign(target, operator, value, _):
                        return true if:
                            proof_structural_typed_operator_expression_inner(value, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                            not proof_structural_operator_guard_add_expression_bindings(value, &shadowed, report)
                        compound_protocol: sview = proof_source_compound_assignment_protocol(operator)
                        return true if:
                            compound_protocol == "?"
                            compound_protocol != "" and proof_structural_operator_guard_compound_unsupported(target, compound_protocol, parameters, shadowed, declaration_line, report, caller_owner, caller_owner_known)
                            proof_structural_typed_operator_expression_inner(target, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                            operator == TokenKind.Assign and not proof_structural_operator_guard_add_fresh_assignment_bindings(target, parameters, &shadowed, saved_count, report, depth + 1)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_structural_typed_operator_condition_inner(condition, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                        saved_count: usize = shadowed.count
                        return true if not proof_structural_operator_guard_add_condition_aliases(condition, &shadowed, report)
                        found: bool = proof_structural_typed_operator_statements_inner(then_body, parameters, &shadowed, report, declaration_line, depth + 1, true, caller_owner, caller_owner_known)
                        while shadowed.count > saved_count |shadowed, saved_count|:
                            shadowed.pop()
                        return true if found
                        else_count: usize = shadowed.count
                        return true if not proof_structural_operator_guard_add_false_condition_aliases(condition, &shadowed, report)
                        else_found: bool = proof_structural_typed_operator_statements_inner(else_body, parameters, &shadowed, report, declaration_line, depth + 1, true, caller_owner, caller_owner_known)
                        while shadowed.count > else_count |shadowed, else_count|:
                            shadowed.pop()
                        else_found
                    Ast::Stmt.While(condition, body, _):
                        return true if proof_structural_typed_operator_condition_inner(condition, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                        saved_count: usize = shadowed.count
                        return true if not proof_structural_operator_guard_add_condition_aliases(condition, &shadowed, report)
                        found: bool = proof_structural_typed_operator_statements_inner(body, parameters, &shadowed, report, declaration_line, depth + 1, true, caller_owner, caller_owner_known)
                        while shadowed.count > saved_count |shadowed, saved_count|:
                            shadowed.pop()
                        return found
                    Ast::Stmt.For(_, variables, iterable, body, _):
                        predicates: mutable darray[Ast::Expr] = []
                        base_iterable: mutable Ast::Expr = iterable
                        while predicates.count < 3 |base_iterable, predicates, report|:
                            match base_iterable:
                                Ast::Expr.Refinement(base, predicate, _):
                                    return true if not proof_source_index_work_charge(report, 1)
                                    predicates.push(predicate)
                                    base_iterable <- base
                                _:
                                    break
                        return true if:
                            predicates.count > 2
                            proof_structural_typed_operator_expression_inner(base_iterable, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                        loop_count: usize = shadowed.count
                        for variable in variables |shadowed|:
                            return true if not proof_structural_operator_guard_add_binding(variable, &shadowed, report)
                        if predicates.count > 0:
                            inner_filter: Ast::Expr = predicates[predicates.count - 1]
                            return true if proof_structural_typed_operator_expression_inner(inner_filter, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                            filter_bindings: mutable darray[sview] = []
                            return true if not proof_structural_operator_guard_collect_refinement_bindings(inner_filter, &filter_bindings, report)
                            for binding in filter_bindings |shadowed, report|:
                                return true if not proof_structural_operator_guard_add_binding(binding, &shadowed, report)
                        if predicates.count == 2:
                            return true if proof_structural_typed_operator_expression_inner(predicates[0], parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                        found: bool = proof_structural_typed_operator_statements_inner(body, parameters, &shadowed, report, declaration_line, depth + 1, true, caller_owner, caller_owner_known)
                        while shadowed.count > loop_count |shadowed, loop_count|:
                            shadowed.pop()
                        return true if found
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_structural_typed_operator_expression_inner(scrutinee, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                        for arm in arms |parameters, shadowed, report, depth, caller_owner, caller_owner_known|:
                            arm_count: usize = shadowed.count
                            return true if:
                                not proof_structural_operator_guard_pattern_shadow(arm.pattern, &shadowed, report, 0)
                                proof_structural_typed_operator_expression_inner(arm.guard, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                            found: bool = proof_structural_typed_operator_statements_inner(arm.body, parameters, &shadowed, report, declaration_line, depth + 1, true, caller_owner, caller_owner_known)
                            while shadowed.count > arm_count |shadowed, arm_count|:
                                shadowed.pop()
                            return true if found
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_structural_typed_operator_expression_inner(expression, parameters, &shadowed, report, declaration_line, depth + 1, caller_owner, caller_owner_known)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return true
            if scoped:
                while shadowed.count > saved_count |shadowed, saved_count|:
                    shadowed.pop()
            return false

        # Checker entry points charge AST visits and lookup work through the shared meter.
        def proof_structural_typed_operator_expression_has_overload(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, declaration_line: u32, report: mutable ProofReport&, depth: usize, caller_owner: sview = "", caller_owner_known: bool = false) -> bool:
            shadowed: mutable darray[ProofStructuralOperatorBinding] = []
            proof_structural_typed_operator_expression_inner(expression, parameters, &shadowed, report, declaration_line, depth, caller_owner, caller_owner_known)

        def proof_structural_typed_operator_statements_have_overload(statements: darray[Ast::Stmt], parameters: darray[Ast::ParamDecl]&, declaration_line: u32, report: mutable ProofReport&, depth: usize, caller_owner: sview = "", caller_owner_known: bool = false) -> bool:
            shadowed: mutable darray[ProofStructuralOperatorBinding] = []
            proof_structural_typed_operator_statements_inner(statements, parameters, &shadowed, report, declaration_line, depth, false, caller_owner, caller_owner_known)

        def proof_structural_typed_operator_defaults_have_overload(parameters: darray[Ast::ParamDecl]&, declaration_line: u32, report: mutable ProofReport&, caller_owner: sview = "", caller_owner_known: bool = false) -> bool:
            for parameter in parameters |parameters, report, caller_owner, caller_owner_known|:
                return true if:
                    not proof_source_index_work_charge(report, 1)
                    parameter.has_default and proof_structural_typed_operator_expression_has_overload(parameter.default_value, parameters, declaration_line, report, 0, caller_owner, caller_owner_known)
            return false

        def proof_structural_typed_operator_contracts_have_overload(contracts: darray[Ast::Expr]&, parameters: darray[Ast::ParamDecl]&, declaration_line: u32, report: mutable ProofReport&, caller_owner: sview = "", caller_owner_known: bool = false) -> bool:
            for contract in contracts |parameters, report, caller_owner, caller_owner_known|:
                return true if:
                    not proof_source_index_work_charge(report, 1)
                    proof_structural_typed_operator_expression_has_overload(contract, parameters, declaration_line, report, 0, caller_owner, caller_owner_known)
            return false
