extend ElisaProof:
    private:
        struct ProofBlockSubstitutionSummary:
            binding_scan_cost: mutable usize = 0
            value_scan_cost: mutable usize = 0
            ready: mutable bool = false

        def proof_block_publish_nested_goal(facts: mutable darray[Ast::Expr]&, premises: darray[Ast::Expr]&, report: mutable ProofReport&, goal: Ast::Expr, line: u32, name: sview) -> bool:
            previous_fact_count: usize = facts.count
            proof_add_derived_fact_from(facts, report, goal, premises, "proof-step", line, name)
            return true if facts.count == previous_fact_count + 1
            report.proof_obligation(false)
            proof_add_finding(report, "proof-malformed", line, name, "nested assert-by goal could not be recorded with replayable premises")
            return false

        # Argument stability descends into calls and resolves their full function names. Charge
        # the worst table fallback per possible call node, even if the fast index is available.
        def proof_block_lemma_function_lookup_reserve(functions: ProofFunctionTable&, argument_nodes: usize, requires_cost: usize, requires_count: usize, decreases_cost: usize, decreases_count: usize, caller_decreases_cost: usize, caller_decreases_count: usize, ensures_cost: usize, ensure_count: usize, mapped_value_cost: usize, reserved: mutable usize&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            name_bytes: mutable usize = 0
            owner_bytes: mutable usize = 0
            for function_name in functions.lookup.source.names |function_name, name_bytes, work, report, name, line|:
                bytes: usize = sview_len(function_name)
                if bytes >= PROOF_PURITY_WALK_WORK_LIMIT:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                if not proof_block_lemma_budget_charge(1 + bytes, work, report, name, line):
                    return false
                if name_bytes > PROOF_PURITY_WALK_WORK_LIMIT - bytes:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                name_bytes <- name_bytes + bytes
            for index in 0..<functions.lookup.source.owner_modules.count |index, functions, owner_bytes, work, report, name, line|:
                bytes: usize = sview_len(functions.lookup.source.owner_modules[index])
                if bytes >= PROOF_PURITY_WALK_WORK_LIMIT:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                if not proof_block_lemma_budget_charge(1 + bytes, work, report, name, line):
                    return false
                if owner_bytes > PROOF_PURITY_WALK_WORK_LIMIT - bytes:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                owner_bytes <- owner_bytes + bytes
            path_count: usize = functions.lookup.source.all_declaration_path.count
            count: usize = functions.lookup.source.names.count
            if count > PROOF_PURITY_WALK_WORK_LIMIT / 8 or name_bytes > PROOF_PURITY_WALK_WORK_LIMIT / 8 or owner_bytes > PROOF_PURITY_WALK_WORK_LIMIT / 8 or (count > 0 and path_count > PROOF_PURITY_WALK_WORK_LIMIT / count / 4):
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            per_lookup: usize = 16 + count * 8 + name_bytes * 8 + owner_bytes * 8 + count * path_count * 4
            if per_lookup > PROOF_PURITY_WALK_WORK_LIMIT:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            if ensure_count >= PROOF_PURITY_WALK_WORK_LIMIT / 3:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            argument_passes: usize = (ensure_count + 1) * 3
            if argument_nodes > 0 and argument_nodes > PROOF_PURITY_WALK_WORK_LIMIT / argument_passes:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            resolver_nodes: mutable usize = 0
            return false if not proof_block_lemma_resolver_volume(argument_nodes, 0, argument_passes, resolver_nodes, work, report, name, line)
            if requires_count > PROOF_PURITY_WALK_WORK_LIMIT / 8 or decreases_count > PROOF_PURITY_WALK_WORK_LIMIT / 16 or caller_decreases_count > PROOF_PURITY_WALK_WORK_LIMIT / 16 or ensure_count > PROOF_PURITY_WALK_WORK_LIMIT / 4:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            return false if:
                not proof_block_lemma_resolver_volume(requires_cost, mapped_value_cost, requires_count * 8, resolver_nodes, work, report, name, line)
                not proof_block_lemma_resolver_volume(decreases_cost, mapped_value_cost, decreases_count * 16, resolver_nodes, work, report, name, line)
                not proof_block_lemma_resolver_volume(caller_decreases_cost, mapped_value_cost, caller_decreases_count * 16, resolver_nodes, work, report, name, line)
                not proof_block_lemma_resolver_volume(ensures_cost, mapped_value_cost, ensure_count * 4, resolver_nodes, work, report, name, line)
                not proof_block_lemma_budget_estimate(per_lookup, resolver_nodes, reserved, work, report, name, line)
            return true

        # Mirror the bounded name-index lookup while charging both this row selection and the
        # repeated lookup inside proof_apply_lemma. Exact string comparisons remain authoritative.
        def proof_block_lemma_index_for_apply(lemmas: ProofLemmaTable&, wanted: sview, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> usize:
            capacity: usize = lemmas.identity.index_values.count
            return lemmas.identity.names.count if capacity == 0 or capacity != lemmas.identity.index_hashes.count or capacity != lemmas.identity.index_ambiguous.count
            wanted_len: usize = sview_len(wanted)
            if not proof_block_lemma_budget_charge(wanted_len, work, report, name, line) or not proof_block_lemma_budget_charge(wanted_len, work, report, name, line):
                return lemmas.identity.names.count
            wanted_hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes < PROOF_NAME_INDEX_MAX_CLUSTER + 1 |probes, slot, wanted_hash, wanted, wanted_len, lemmas, capacity, work, report, name, line|:
                if not proof_block_lemma_budget_charge(1, work, report, name, line) or not proof_block_lemma_budget_charge(1, work, report, name, line):
                    return lemmas.identity.names.count
                current: usize = lemmas.identity.index_values[slot]
                return lemmas.identity.names.count if current == lemmas.identity.names.count or current >= lemmas.identity.names.count
                if lemmas.identity.index_hashes[slot] == wanted_hash:
                    candidate_len: usize = sview_len(lemmas.identity.names[current])
                    if not proof_block_lemma_budget_charge(candidate_len, work, report, name, line) or not proof_block_lemma_budget_charge(wanted_len, work, report, name, line) or not proof_block_lemma_budget_charge(candidate_len, work, report, name, line) or not proof_block_lemma_budget_charge(wanted_len, work, report, name, line):
                        return lemmas.identity.names.count
                    if lemmas.identity.names[current] == wanted:
                        return lemmas.identity.names.count if lemmas.identity.index_ambiguous[slot]
                        return current
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return lemmas.identity.names.count

        def proof_block_lemma_malformed(report: mutable ProofReport&, name: sview, line: u32) -> bool:
            proof_add_finding(report, "proof-malformed", line, name, "lemma summary row is malformed during assert-by analysis")
            return false

        def proof_block_lemma_application_reserve(expression: Ast::Expr, substitution_binding_cost: usize, substitution_value_cost: usize, facts: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: ProofFunctionTable&, work: mutable ProofBlockPurityWork&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            return false if work.reported
            call_name: mutable sview = ""
            arguments: mutable darray[Ast::Expr] = []
            argument_names: mutable darray[sview] = []
            match expression:
                Ast::Expr.Call(callee, call_arguments, call_argument_names, _):
                    return true if proof_callable_is_scoped(callee)
                    call_name <- proof_callable_name(callee)
                    arguments <- call_arguments
                    argument_names <- call_argument_names
                _:
                    return true
            return true if call_name == ""
            lemma_index: usize = proof_block_lemma_index_for_apply(lemmas, call_name, work, report, name, line)
            return false if work.reported
            return true if lemma_index >= lemmas.identity.names.count

            return proof_block_lemma_malformed(report, name, line) if lemma_index >= lemmas.parameters.param_starts.count or lemma_index >= lemmas.parameters.param_counts.count or lemma_index >= lemmas.contracts.requires_starts.count or lemma_index >= lemmas.contracts.requires_counts.count or lemma_index >= lemmas.contracts.ensure_starts.count or lemma_index >= lemmas.contracts.ensure_counts.count or lemma_index >= lemmas.termination.decreases_starts.count or lemma_index >= lemmas.termination.decreases_counts.count or lemma_index >= lemmas.termination.decreases_unbounded.count or lemma_index >= lemmas.termination.recursive.count or lemma_index >= lemmas.verification.verified.count or lemma_index >= lemmas.verification.unqualified_usable.count

            param_start: usize = lemmas.parameters.param_starts[lemma_index]
            param_count: usize = lemmas.parameters.param_counts[lemma_index]
            requires_start: usize = lemmas.contracts.requires_starts[lemma_index]
            requires_count: usize = lemmas.contracts.requires_counts[lemma_index]
            ensure_start: usize = lemmas.contracts.ensure_starts[lemma_index]
            ensure_count: usize = lemmas.contracts.ensure_counts[lemma_index]
            decreases_start: usize = lemmas.termination.decreases_starts[lemma_index]
            decreases_count: usize = lemmas.termination.decreases_counts[lemma_index]
            return proof_block_lemma_malformed(report, name, line) if:
                param_start > lemmas.parameters.all_params.count or param_count > lemmas.parameters.all_params.count - param_start or param_start > lemmas.parameters.all_has_defaults.count or param_count > lemmas.parameters.all_has_defaults.count - param_start or param_start > lemmas.parameters.all_defaults.count or param_count > lemmas.parameters.all_defaults.count - param_start
                requires_start > lemmas.contracts.all_requires.count or requires_count > lemmas.contracts.all_requires.count - requires_start or ensure_start > lemmas.contracts.all_ensures.count or ensure_count > lemmas.contracts.all_ensures.count - ensure_start or decreases_start > lemmas.termination.all_decreases.count or decreases_count > lemmas.termination.all_decreases.count - decreases_start

            reserved: mutable usize = 0
            parameter_name_cost: mutable usize = 0
            default_cost: mutable usize = 0
            requires_cost: mutable usize = 0
            decreases_cost: mutable usize = 0
            ensures_cost: mutable usize = 0
            caller_decreases_cost: mutable usize = 0
            caller_decreases_count: mutable usize = 0
            source_cost: mutable usize = 0
            default_costs: mutable darray[usize] = []
            for parameter_index in 0..<param_count |parameter_index, param_start, lemmas, parameter_name_cost, default_cost, source_cost, default_costs, work, report, name, line|:
                parameter_name: sview = lemmas.parameters.all_params[param_start + parameter_index]
                parameter_bytes: usize = sview_len(parameter_name)
                if parameter_bytes > PROOF_PURITY_WALK_WORK_LIMIT or parameter_name_cost > PROOF_PURITY_WALK_WORK_LIMIT - parameter_bytes or source_cost > PROOF_PURITY_WALK_WORK_LIMIT - parameter_bytes:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                parameter_name_cost <- parameter_name_cost + parameter_bytes
                source_cost <- source_cost + parameter_bytes
                if not proof_block_lemma_budget_charge(1 + parameter_bytes, work, report, name, line) or not proof_block_lemma_budget_charge(1 + parameter_bytes, work, report, name, line):
                    return false
                cost_before: usize = default_cost
                if not proof_block_lemma_source_cost(lemmas.parameters.all_defaults[param_start + parameter_index], default_cost, source_cost, work, report, name, line):
                    return false
                default_costs.push(default_cost - cost_before)

            for requires_index in 0..<requires_count |requires_index, requires_start, lemmas, requires_cost, source_cost, work, report, name, line|:
                return false if not proof_block_lemma_source_cost(lemmas.contracts.all_requires[requires_start + requires_index], requires_cost, source_cost, work, report, name, line)
            for decreases_index in 0..<decreases_count |decreases_index, decreases_start, lemmas, decreases_cost, source_cost, work, report, name, line|:
                return false if not proof_block_lemma_source_cost(lemmas.termination.all_decreases[decreases_start + decreases_index], decreases_cost, source_cost, work, report, name, line)
            for ensure_index in 0..<ensure_count |ensure_index, ensure_start, lemmas, ensures_cost, source_cost, work, report, name, line|:
                return false if not proof_block_lemma_source_cost(lemmas.contracts.all_ensures[ensure_start + ensure_index], ensures_cost, source_cost, work, report, name, line)

            argument_costs: mutable darray[usize] = []
            argument_total: mutable usize = 0
            for argument in arguments |argument, argument_costs, argument_total, source_cost, work, report, name, line|:
                cost_before: usize = argument_total
                if not proof_block_lemma_source_cost(argument, argument_total, source_cost, work, report, name, line):
                    return false
                argument_costs.push(argument_total - cost_before)

            facts_cost: mutable usize = 0
            for fact in facts |fact, facts_cost, source_cost, work, report, name, line|:
                return false if not proof_block_lemma_source_cost(fact, facts_cost, source_cost, work, report, name, line)

            # Reproduce the parameter/argument matching bound before proof_apply_lemma can
            # allocate the mapped vector or scan names. Each charged comparison covers this
            # preflight plus the equivalent comparison in proof_map_call_arguments.
            used: mutable darray[bool] = []
            mapped_costs: mutable darray[usize] = []
            for _ in 0..<param_count |used, mapped_costs, work, report, name, line|:
                if not proof_block_lemma_budget_charge(1, work, report, name, line) or not proof_block_lemma_budget_charge(1, work, report, name, line):
                    return false
                used.push(false)
                mapped_costs.push(0)
            mapping_valid: mutable bool = argument_names.count == 0 or argument_names.count == arguments.count
            saw_named: mutable bool = false
            next_positional: mutable usize = 0
            if mapping_valid:
                for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, lemmas, param_start, param_count, used, mapped_costs, argument_costs, saw_named, next_positional, mapping_valid, work, report, name, line|:
                    if not proof_block_lemma_budget_charge(1, work, report, name, line) or not proof_block_lemma_budget_charge(1, work, report, name, line):
                        return false
                    label: sview = argument_names[argument_index] if argument_names.count == arguments.count else ""
                    parameter_slot: mutable usize = param_count
                    if label == "":
                        if saw_named:
                            mapping_valid <- false
                            break
                        while next_positional < param_count and used[next_positional] |next_positional, used, work, report, name, line, mapping_valid|:
                            if not proof_block_lemma_budget_charge(1, work, report, name, line) or not proof_block_lemma_budget_charge(1, work, report, name, line):
                                return false
                            next_positional <- next_positional + 1
                        if next_positional >= param_count:
                            mapping_valid <- false
                            break
                        parameter_slot <- next_positional
                        next_positional <- next_positional + 1
                    else:
                        saw_named <- true
                        for candidate in 0..<param_count |candidate, lemmas, param_start, label, parameter_slot, work, report, name, line|:
                            candidate_name: sview = lemmas.parameters.all_params[param_start + candidate]
                            compare_cost: usize = 1 + sview_len(label) + sview_len(candidate_name)
                            if not proof_block_lemma_budget_charge(compare_cost, work, report, name, line) or not proof_block_lemma_budget_charge(compare_cost, work, report, name, line):
                                return false
                            if candidate_name == label:
                                parameter_slot <- candidate
                                break
                    if parameter_slot >= param_count or used[parameter_slot]:
                        mapping_valid <- false
                        break
                    used[parameter_slot] <- true
                    mapped_costs[parameter_slot] <- argument_costs[argument_index]

            mapped_value_cost: mutable usize = 0
            for mapped_cost in mapped_costs |mapped_cost, mapped_value_cost, work, report, name, line|:
                if mapped_value_cost > PROOF_PURITY_WALK_WORK_LIMIT - mapped_cost:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                mapped_value_cost <- mapped_value_cost + mapped_cost

            # Defaults are checked and substituted in parameter order. Bound copied values with
            # a recurrence so chained defaults cannot expand beyond the shared work allowance.
            if mapping_valid:
                for parameter_index in 0..<param_count |parameter_index, param_start, lemmas, used, default_costs, parameter_name_cost, mapped_costs, mapped_value_cost, reserved, work, report, name, line|:
                    continue if used[parameter_index] or not lemmas.parameters.all_has_defaults[param_start + parameter_index]
                    current_default_cost: usize = default_costs[parameter_index]
                    if parameter_name_cost > PROOF_PURITY_WALK_WORK_LIMIT - 4 or mapped_value_cost > PROOF_PURITY_WALK_WORK_LIMIT - 4 - parameter_name_cost:
                        proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                        return false
                    substitution_factor: usize = 4 + parameter_name_cost + mapped_value_cost
                    return false if:
                        not proof_block_lemma_budget_estimate(current_default_cost, substitution_factor, reserved, work, report, name, line)
                        not proof_block_lemma_budget_estimate(current_default_cost, param_count + 3, reserved, work, report, name, line)
                    if mapped_value_cost >= PROOF_PURITY_WALK_WORK_LIMIT or current_default_cost > PROOF_PURITY_WALK_WORK_LIMIT / (mapped_value_cost + 1):
                        proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                        return false
                    resolved_default_cost: usize = current_default_cost * (mapped_value_cost + 1)
                    return false if not proof_block_lemma_budget_estimate(resolved_default_cost, param_count + 3, reserved, work, report, name, line)
                    if mapped_value_cost > PROOF_PURITY_WALK_WORK_LIMIT - resolved_default_cost:
                        proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                        return false
                    mapped_value_cost <- mapped_value_cost + resolved_default_cost
                    mapped_costs[parameter_index] <- resolved_default_cost

            if parameter_name_cost > PROOF_PURITY_WALK_WORK_LIMIT - 4 or mapped_value_cost > PROOF_PURITY_WALK_WORK_LIMIT - 4 - parameter_name_cost:
                proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                return false
            contract_substitution_factor: usize = 4 + parameter_name_cost + mapped_value_cost
            call_name_len: usize = sview_len(call_name)
            if substitution_binding_cost > 0:
                if call_name_len >= PROOF_PURITY_WALK_WORK_LIMIT:
                    proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                    return false
                return false if not proof_block_lemma_budget_estimate(substitution_binding_cost, call_name_len + 1, reserved, work, report, name, line)
            return false if:
                not proof_block_lemma_budget_estimate(requires_cost, contract_substitution_factor + facts.count + 8, reserved, work, report, name, line)
                not proof_block_lemma_budget_estimate(ensures_cost, contract_substitution_factor + facts.count + 4, reserved, work, report, name, line)
                not proof_block_lemma_budget_estimate(decreases_cost, contract_substitution_factor + facts.count + 16, reserved, work, report, name, line)
                not proof_block_lemma_budget_estimate(facts_cost, requires_count + ensure_count + decreases_count * 2, reserved, work, report, name, line)

            # Classify only the mapped argument/default shapes, then reserve the expensive
            # witness path only if they contain unary/binary or indexing syntax. Charge the
            # shape scan once before entering it; mapped_value_cost includes explicit inputs and
            # every expanded default, so it bounds the nodes examined here.
            stability_shape: mutable ProofBlockLemmaStabilityShape = ProofBlockLemmaStabilityShape{scalar_query: false, index_query: false, element_lookup: false, enum_shorthand_query: false, enum_field_query: false, call_query: false, expanded_depth: 0}
            if not mapping_valid:
                stability_shape.scalar_query <- true
                stability_shape.index_query <- true
                stability_shape.element_lookup <- true
                stability_shape.enum_shorthand_query <- true
                stability_shape.enum_field_query <- true
                stability_shape.call_query <- true
                stability_shape.expanded_depth <- ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            else:
                if not proof_block_lemma_budget_charge(mapped_value_cost, work, report, name, line):
                    return false
                for argument in arguments |argument, stability_shape, work, report, name, line|:
                    expression_depth: mutable usize = 0
                    proof_block_lemma_stability_scan_shape(argument, stability_shape, expression_depth, 0)
                    proof_block_lemma_stability_add_depth(stability_shape, expression_depth)
                for parameter_index in 0..<param_count |parameter_index, param_start, lemmas, used, stability_shape|:
                    continue if used[parameter_index] or not lemmas.parameters.all_has_defaults[param_start + parameter_index]
                    expression_depth: mutable usize = 0
                    proof_block_lemma_stability_scan_shape(lemmas.parameters.all_defaults[param_start + parameter_index], stability_shape, expression_depth, 0)
                    proof_block_lemma_stability_add_depth(stability_shape, expression_depth)
            return false if not proof_block_lemma_stability_reserve(stability_shape, mapped_value_cost, facts_cost, functions, reserved, work, report, name, line)

            if lemma_index < lemmas.termination.recursive.count and lemmas.termination.recursive[lemma_index]:
                caller_index: usize = proof_block_lemma_index_for_apply(lemmas, name, work, report, name, line)
                return false if work.reported
                if caller_index < lemmas.identity.names.count and caller_index < lemmas.termination.recursive.count and lemmas.termination.recursive[caller_index]:
                    return proof_block_lemma_malformed(report, name, line) if caller_index >= lemmas.parameters.param_starts.count or caller_index >= lemmas.parameters.param_counts.count or caller_index >= lemmas.termination.decreases_starts.count or caller_index >= lemmas.termination.decreases_counts.count or caller_index >= lemmas.termination.decreases_unbounded.count
                    caller_param_start: usize = lemmas.parameters.param_starts[caller_index]
                    caller_param_count: usize = lemmas.parameters.param_counts[caller_index]
                    caller_dec_start: usize = lemmas.termination.decreases_starts[caller_index]
                    caller_dec_count: usize = lemmas.termination.decreases_counts[caller_index]
                    return proof_block_lemma_malformed(report, name, line) if caller_param_start > lemmas.parameters.all_params.count or caller_param_count > lemmas.parameters.all_params.count - caller_param_start or caller_dec_start > lemmas.termination.all_decreases.count or caller_dec_count > lemmas.termination.all_decreases.count - caller_dec_start
                    caller_parameter_cost: mutable usize = 0
                    caller_decreases_count <- caller_dec_count
                    for caller_parameter in 0..<caller_param_count |caller_parameter, caller_param_start, lemmas, caller_parameter_cost, work, report, name, line|:
                        bytes: usize = sview_len(lemmas.parameters.all_params[caller_param_start + caller_parameter])
                        if bytes > PROOF_PURITY_WALK_WORK_LIMIT or caller_parameter_cost > PROOF_PURITY_WALK_WORK_LIMIT - bytes:
                            proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                            return false
                        caller_parameter_cost <- caller_parameter_cost + bytes
                        if not proof_block_lemma_budget_charge(1 + bytes, work, report, name, line) or not proof_block_lemma_budget_charge(1 + bytes, work, report, name, line):
                            return false
                    for caller_component in 0..<caller_dec_count |caller_component, caller_dec_start, lemmas, caller_decreases_cost, source_cost, work, report, name, line|:
                        return false if not proof_block_lemma_source_cost(lemmas.termination.all_decreases[caller_dec_start + caller_component], caller_decreases_cost, source_cost, work, report, name, line)
                    if substitution_binding_cost > PROOF_PURITY_WALK_WORK_LIMIT - 4 or substitution_value_cost > PROOF_PURITY_WALK_WORK_LIMIT - 4 - substitution_binding_cost:
                        proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                        return false
                    caller_value_factor: usize = 4 + substitution_binding_cost + substitution_value_cost
                    return false if not proof_block_lemma_budget_estimate(caller_param_count, caller_value_factor, reserved, work, report, name, line)
                    if caller_param_count > 0 and substitution_value_cost > PROOF_PURITY_WALK_WORK_LIMIT / caller_param_count:
                        proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                        return false
                    caller_mapped_value_cost: usize = caller_param_count * substitution_value_cost
                    if caller_parameter_cost > PROOF_PURITY_WALK_WORK_LIMIT - 4 or caller_mapped_value_cost > PROOF_PURITY_WALK_WORK_LIMIT - 4 - caller_parameter_cost:
                        proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                        return false
                    caller_measure_factor: usize = 4 + caller_parameter_cost + caller_mapped_value_cost
                    return false if:
                        not proof_block_lemma_budget_estimate(caller_decreases_cost, caller_measure_factor + facts.count + 16, reserved, work, report, name, line)
                        not proof_block_lemma_budget_estimate(facts_cost, (caller_dec_count + decreases_count) * 2, reserved, work, report, name, line)

                    ids_available: bool = caller_index < lemmas.termination.recursive_component_ids.count and lemma_index < lemmas.termination.recursive_component_ids.count
                    if not ids_available:
                        return proof_block_lemma_malformed(report, name, line) if lemmas.termination.call_starts.count < lemmas.identity.names.count or lemmas.termination.call_counts.count < lemmas.identity.names.count
                        if lemmas.identity.names.count > PROOF_PURITY_WALK_WORK_LIMIT - 131:
                            proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                            return false
                        max_name_bytes: mutable usize = 0
                        for graph_index in 0..<lemmas.identity.names.count |graph_index, lemmas, max_name_bytes, work, report, name, line|:
                            if graph_index >= lemmas.termination.call_starts.count or graph_index >= lemmas.termination.call_counts.count:
                                return proof_block_lemma_malformed(report, name, line)
                            graph_start: usize = lemmas.termination.call_starts[graph_index]
                            graph_count: usize = lemmas.termination.call_counts[graph_index]
                            if graph_start > lemmas.termination.all_calls.count or graph_count > lemmas.termination.all_calls.count - graph_start:
                                return proof_block_lemma_malformed(report, name, line)
                            lemma_name: sview = lemmas.identity.names[graph_index]
                            name_bytes: usize = sview_len(lemma_name)
                            if not proof_block_lemma_budget_charge(1 + name_bytes, work, report, name, line):
                                return false
                            max_name_bytes <- name_bytes if name_bytes > max_name_bytes
                        max_call_bytes: mutable usize = 0
                        for called_name in lemmas.termination.all_calls |called_name, max_call_bytes, work, report, name, line|:
                            call_bytes: usize = sview_len(called_name)
                            if not proof_block_lemma_budget_charge(1 + call_bytes, work, report, name, line):
                                return false
                            max_call_bytes <- call_bytes if call_bytes > max_call_bytes
                        if max_name_bytes > (PROOF_PURITY_WALK_WORK_LIMIT - 131 - lemmas.identity.names.count) / 65 or max_call_bytes > (PROOF_PURITY_WALK_WORK_LIMIT - 131 - lemmas.identity.names.count - max_name_bytes * 65) / 2:
                            proof_purity_budget_finding(report, name, line, "proof-purity-source-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, work)
                            return false
                        edge_cost: mutable usize = 131 + max_name_bytes * 65 + max_call_bytes * 2
                        edge_cost <- edge_cost + lemmas.identity.names.count
                        return false if:
                            not proof_block_lemma_budget_estimate(lemmas.identity.names.count, 2, reserved, work, report, name, line)
                            not proof_block_lemma_budget_estimate(edge_cost, lemmas.termination.all_calls.count * 2, reserved, work, report, name, line)

            return false if:
                not proof_block_lemma_function_lookup_reserve(functions, mapped_value_cost, requires_cost, requires_count, decreases_cost, decreases_count, caller_decreases_cost, caller_decreases_count, ensures_cost, ensure_count, mapped_value_cost, reserved, work, report, name, line)
                not proof_block_lemma_budget_charge(reserved, work, report, name, line)
            return true

        def proof_block_lemma_return_call_prepare(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: ProofFunctionTable&, report: mutable ProofReport&, name: sview, line: u32) -> (ready: bool, expression: Ast::Expr) can[Global{Read,Write}]:
            work: mutable ProofBlockPurityWork = ProofBlockPurityWork{used: report.analysis_1.budgets.lemma_purity_source_work, reported: report.analysis_1.budgets.lemma_purity_source_reported, match_work_used: report.analysis_1.budgets.match_lowering_source_work}
            return (false, expression) if work.reported
            substitution: mutable ProofBlockSubstitutionSummary = ProofBlockSubstitutionSummary{}
            source_reserved: bool = proof_block_substitution_summary(names, values, substitution, work, report, name, line, false) and proof_block_substitution_reserve(expression, substitution, work, report, name, line, false)
            if not source_reserved:
                report.analysis_1.budgets.lemma_purity_source_work <- work.used
                report.analysis_1.budgets.lemma_purity_source_reported <- work.reported
                report.analysis_1.budgets.match_lowering_source_work <- work.match_work_used
                return (false, expression)
            substituted: Ast::Expr = proof_substitute_with_work(expression, names, values, &work.match_work_used)
            ready: bool = proof_block_lemma_application_reserve(substituted, substitution.binding_scan_cost, substitution.value_scan_cost, facts, lemmas, functions, work, report, name, line)
            report.analysis_1.budgets.lemma_purity_source_work <- work.used
            report.analysis_1.budgets.lemma_purity_source_reported <- work.reported
            report.analysis_1.budgets.match_lowering_source_work <- work.match_work_used
            return (ready, substituted)

        def proof_return_substitution_prepare(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, line: u32) -> (ready: bool, expression: Ast::Expr):
            work: mutable ProofBlockPurityWork = ProofBlockPurityWork{used: report.analysis_1.budgets.return_source_work, reported: report.analysis_1.budgets.return_source_reported, match_work_used: report.analysis_1.budgets.match_lowering_source_work}
            return (false, expression) if work.reported
            substitution: mutable ProofBlockSubstitutionSummary = ProofBlockSubstitutionSummary{}
            source_reserved: bool = proof_block_substitution_summary(names, values, substitution, work, report, name, line, true) and proof_block_substitution_reserve(expression, substitution, work, report, name, line, true)
            report.analysis_1.budgets.return_source_work <- work.used
            report.analysis_1.budgets.return_source_reported <- work.reported
            return (false, expression) if not source_reserved
            substituted: Ast::Expr = proof_substitute_with_work(expression, names, values, &work.match_work_used)
            report.analysis_1.budgets.match_lowering_source_work <- work.match_work_used
            return (true, substituted)

        # Runtime assertion admission makes independent structural passes after substitution
        # (call, move, freshness, and operator classification). One charge includes the AST-cost
        # preflight and one consumer traversal; callers with multiple readers charge each one.
        def proof_return_rewrite_bound_add_product(left: usize, right: usize, accumulated: mutable usize&, limit: usize) -> bool:
            return false if accumulated > limit or left > 0 and right > (limit - accumulated) / left
            accumulated <- accumulated + left * right
            true

        def proof_return_pure_call_rewrite_reserve(expression: Ast::Expr, facts: darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            work: mutable ProofBlockPurityWork = ProofBlockPurityWork{used: report.analysis_1.budgets.return_source_work, reported: report.analysis_1.budgets.return_source_reported, match_work_used: report.analysis_1.budgets.match_lowering_source_work}
            return false if work.reported
            cost_work: mutable usize = 0
            expression_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(expression, &expression_cost, cost_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or expression_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - cost_work:
                proof_purity_budget_finding(report, name, line, "return-call-summary-rewrite-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &work)
                report.analysis_1.budgets.return_source_reported <- work.reported
                return false
            cost_work <- cost_work + expression_cost
            facts_cost: mutable usize = 0
            for fact in facts |fact, facts_cost, cost_work, report, name, line, work|:
                fact_cost: mutable usize = 0
                if not proof_replay_summary_expr_cost_with_limit(fact, &fact_cost, cost_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or fact_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - cost_work:
                    proof_purity_budget_finding(report, name, line, "return-call-summary-rewrite-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &work)
                    report.analysis_1.budgets.return_source_reported <- work.reported
                    return false
                cost_work <- cost_work + fact_cost
                facts_cost <- facts_cost + fact_cost
            combined_cost: usize = expression_cost + facts_cost
            available: mutable usize = PROOF_PURITY_WALK_WORK_LIMIT - work.used if work.used <= PROOF_PURITY_WALK_WORK_LIMIT else 0
            if cost_work > available:
                proof_purity_budget_finding(report, name, line, "return-call-summary-rewrite-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &work)
                report.analysis_1.budgets.return_source_reported <- work.reported
                return false
            available <- available - cost_work
            # The rewrite visits at most the combined expression/fact AST size per depth.
            # Each call node performs at most two replacement scans. A scan may compare three
            # endpoints per fact (including the repeated left-side selection check), and each
            # proof_expr_equal performs quick-difference, two support, and structural walks.
            # Its occurrence guard compares against each fact subtree twice; bound repeated
            # query cost by expression size and nested-subtree cost by the term depth limit.
            # Bound these costs separately, then multiply by rewrite fuel.
            # Visited call nodes are at most the combined expression/fact AST size because each
            # AST node costs at least one. Every product below is
            # checked against the remaining allowance before multiplication.
            depth: usize = PROOF_PURE_CALL_REWRITE_DEPTH_LIMIT
            if expression_cost == 0 or available / depth < combined_cost:
                proof_purity_budget_finding(report, name, line, "return-call-summary-rewrite-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &work)
                report.analysis_1.budgets.return_source_reported <- work.reported
                return false
            per_depth_allowance: usize = (available / depth - combined_cost) / combined_cost
            per_call_cost: mutable usize = 0
            if not proof_return_rewrite_bound_add_product(facts.count, expression_cost * 24, &per_call_cost, per_depth_allowance) or not proof_return_rewrite_bound_add_product(facts_cost, 30, &per_call_cost, per_depth_allowance) or not proof_return_rewrite_bound_add_product(facts_cost, expression_cost * 8, &per_call_cost, per_depth_allowance) or not proof_return_rewrite_bound_add_product(facts_cost, (PROOF_TERM_OCCURS_DEPTH_LIMIT + 1) * 8, &per_call_cost, per_depth_allowance) or not proof_return_rewrite_bound_add_product(combined_cost, 16, &per_call_cost, per_depth_allowance):
                proof_purity_budget_finding(report, name, line, "return-call-summary-rewrite-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &work)
                report.analysis_1.budgets.return_source_reported <- work.reported
                return false
            per_depth_cost: usize = combined_cost + combined_cost * per_call_cost
            rewrite_cost: usize = per_depth_cost * depth
            total_cost: usize = cost_work + rewrite_cost
            if not proof_purity_work_charge(total_cost, &work):
                proof_purity_budget_finding(report, name, line, "return-call-summary-rewrite-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &work)
                report.analysis_1.budgets.return_source_work <- work.used
                report.analysis_1.budgets.return_source_reported <- work.reported
                return false
            report.analysis_1.budgets.return_source_work <- work.used
            report.analysis_1.budgets.return_source_reported <- work.reported
            report.analysis_1.budgets.match_lowering_source_work <- work.match_work_used
            true

        def proof_return_expression_scan_charge(expression: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32) -> bool:
            work: mutable ProofBlockPurityWork = ProofBlockPurityWork{used: report.analysis_1.budgets.return_source_work, reported: report.analysis_1.budgets.return_source_reported, match_work_used: report.analysis_1.budgets.match_lowering_source_work}
            return false if work.reported
            # The replay AST cost walker has a stricter 1 Mi per-expression ceiling than the
            # aggregate return-source meter. Measure from zero under its own limit, then debit
            # the full preflight plus one reader pass to the shared per-function budget.
            scan_work: mutable usize = 0
            if not proof_replay_summary_expr_repeat_charge_with_limit(expression, 1, &scan_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                proof_purity_budget_finding(report, name, line, "return-expression-scan-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &work)
                report.analysis_1.budgets.return_source_work <- work.used
                report.analysis_1.budgets.return_source_reported <- work.reported
                return false
            if not proof_purity_work_charge(scan_work, &work):
                proof_purity_budget_finding(report, name, line, "return-expression-scan-work", PROOF_PURITY_WALK_WORK_LIMIT + 1, PROOF_PURITY_WALK_WORK_LIMIT, &work)
                report.analysis_1.budgets.return_source_work <- work.used
                report.analysis_1.budgets.return_source_reported <- work.reported
                return false
            report.analysis_1.budgets.return_source_work <- work.used
            report.analysis_1.budgets.return_source_reported <- work.reported
            report.analysis_1.budgets.match_lowering_source_work <- work.match_work_used
            true

        def proof_block_lemma_return_expression_prepare(expression: Ast::Expr, lemma_steps: bool, names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: ProofFunctionTable&, report: mutable ProofReport&, name: sview, line: u32) -> (ready: bool, expression: Ast::Expr) can[Global{Read,Write}]:
            match expression:
                Ast::Expr.Call(callee, _, _, _) if proof_callable_name(callee) == "assert":
                    # The runtime statement path checks nested calls first, then substitutes the
                    # assertion argument against their resulting state. The argument is reserved
                    # and prepared at that point, so avoid an unused early copy here.
                    return (true, expression)
                Ast::Expr.Call(callee, _, _, _) if lemma_steps and proof_callable_name(callee) != "assert":
                    return proof_block_lemma_return_call_prepare(expression, names, values, facts, lemmas, functions, report, name, line) can Global{Read,Write}
                Ast::Expr.Call(_, _, _, _):
                    return proof_return_substitution_prepare(expression, names, values, report, name, line)
                _:
                    # This expression form is either unused by the statement-call path or is
                    # substituted after nested calls have updated the symbolic environment.
                    return (true, expression)
