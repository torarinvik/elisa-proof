# Resolution and bounded expansion of indexed source type aliases.
extend ElisaProof:
    private:
        def proof_source_conversion_scoped_lookup(name: sview, head: Ast::Expr, names: darray[sview]&, owners: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid or owners.count != name_count
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
            key: (complete: bool, hash: u32) = proof_source_conversion_scope_expression_key_hash(head, name, &report.source_types.source_effect_index.work.implicit_effect_work)
            return (false, 2, name_count) if not key.complete
            slot: mutable usize = (key.hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, head, name, names, owners, hashes, values, counts, name_count, report|:
                return (false, 2, name_count) if not proof_source_index_work_charge(report, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == key.hash:
                    current_name: sview = names[current]
                    return (false, 2, name_count) if not proof_source_index_work_charge(report, sview_len(current_name))
                    if current_name == name and proof_source_conversion_scope_matches_owner(head, owners[current], sview_len(owners[current]), &report.source_types.source_effect_index.work.implicit_effect_work, 0):
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_source_conversion_scoped_owner_lookup(name: sview, owner: sview, names: darray[sview]&, owners: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid or owners.count != name_count
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
            key: (complete: bool, hash: u32) = proof_source_conversion_scope_key_hash(owner, name, &report.source_types.source_effect_index.work.implicit_effect_work)
            return (false, 2, name_count) if not key.complete
            slot: mutable usize = (key.hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, owner, name, names, owners, hashes, values, counts, name_count, report|:
                return (false, 2, name_count) if not proof_source_index_work_charge(report, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == key.hash:
                    current_name: sview = names[current]
                    current_owner: sview = owners[current]
                    return (false, 2, name_count) if not proof_source_index_work_charge(report, sview_len(current_name) + sview_len(name) + sview_len(current_owner) + sview_len(owner))
                    if current_name == name and current_owner == owner:
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_source_conversion_builtin_type_name(name: sview) -> bool:
            return true if proof_builtin_scalar_type_name(name)
            return name in {"darray", "view", "array", "sview", "cstr", "dstr", "str", "void", "never", "type"}

        def proof_source_conversion_alias_target(name: sview, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if index.aliases.alias_names.count != index.aliases.alias_targets.count
            alias: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup(name, index.aliases.alias_names, index.aliases.alias_index_hashes, index.aliases.alias_index_values, index.aliases.alias_index_counts, index.aliases.alias_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
            nominal: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup(name, index.types.declared_types, index.types.declared_type_index_hashes, index.types.declared_type_index_values, index.types.declared_type_index_counts, index.types.declared_type_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if:
                not nominal.complete
                alias.count == 0 and nominal.count > 0 and proof_source_conversion_builtin_type_name(name)
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Invalid) if alias.count == 0
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if:
                nominal.count > 0 or proof_source_conversion_builtin_type_name(name)
                index.aliases.alias_has_formals.count != index.aliases.alias_names.count
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Invalid) if index.aliases.alias_has_formals[alias.row]
            return (true, 1, alias.row, index.aliases.alias_targets[alias.row])

        def proof_source_conversion_qualified_alias_target(head: Ast::Expr, name: sview, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            alias: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_lookup(name, head, index.aliases.alias_names, index.aliases.alias_owners, index.aliases.alias_scope_index_hashes, index.aliases.alias_scope_index_values, index.aliases.alias_scope_index_counts, index.aliases.alias_scope_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
            nominal: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_lookup(name, head, index.types.declared_types, index.types.declared_type_owners, index.types.declared_type_scope_index_hashes, index.types.declared_type_scope_index_values, index.types.declared_type_scope_index_counts, index.types.declared_type_scope_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if:
                not nominal.complete
                nominal.count > 0
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Invalid) if alias.count == 0
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if index.aliases.alias_has_formals.count != index.aliases.alias_names.count
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Invalid) if index.aliases.alias_has_formals[alias.row]
            return (true, 1, alias.row, index.aliases.alias_targets[alias.row])

        def proof_source_conversion_alias_target_in_owner(name: sview, owner: sview, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            aliases: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_owner_lookup(name, owner, index.aliases.alias_names, index.aliases.alias_owners, index.aliases.alias_scope_index_hashes, index.aliases.alias_scope_index_values, index.aliases.alias_scope_index_counts, index.aliases.alias_scope_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid, false, false) if not aliases.complete or aliases.count > 1
            nominals: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_owner_lookup(name, owner, index.types.declared_types, index.types.declared_type_owners, index.types.declared_type_scope_index_hashes, index.types.declared_type_scope_index_values, index.types.declared_type_scope_index_counts, index.types.declared_type_scope_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid, false, false) if not nominals.complete or nominals.count > 1 or (aliases.count > 0 and nominals.count > 0)
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Absent, true, true) if nominals.count == 1
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Absent, false, false) if aliases.count == 0
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid, false, false) if:
                index.aliases.alias_has_formals.count != index.aliases.alias_names.count or aliases.row >= index.aliases.alias_has_formals.count
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Absent, false, true) if index.aliases.alias_has_formals[aliases.row]
            return (true, 1, aliases.row, index.aliases.alias_targets[aliases.row], false, true)

        def proof_source_conversion_alias_parent_owner(owner: sview, report: mutable ProofReport&) -> (complete: bool, parent: sview):
            length: usize = sview_len(owner)
            return (true, "") if length == 0
            return (false, "") if not proof_source_index_work_charge(report, length)
            cursor: mutable usize = length
            while cursor >= 2 |cursor, owner, report|:
                return (false, "") if not proof_source_index_work_charge(report, 1)
                cursor <- cursor - 1
                if sview_at(owner, cursor) == 58 and sview_at(owner, cursor - 1) == 58:
                    return (true, string_view_slice(owner, 0, (cursor - 1).i64()))
            return (true, "")

        def proof_source_conversion_alias_expand(row: usize, target: Ast::Expr, report: mutable ProofReport&, seen: mutable darray[usize]&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, Ast::Expr.Invalid) if row >= index.aliases.alias_names.count or index.aliases.alias_lines.count != index.aliases.alias_names.count or index.aliases.alias_owners.count != index.aliases.alias_names.count
            for active in seen |active, row, report|:
                return (false, Ast::Expr.Invalid) if:
                    not proof_source_index_work_charge(report, 1)
                    active == row
            mark: usize = seen.count
            return (false, Ast::Expr.Invalid) if not proof_source_index_work_charge(report, 1)
            seen.push(row)
            # Generic shadowing applies to explicit call-site syntax. Once an alias is entered,
            # bare names in its RHS resolve in the alias's declaring module.
            expanded: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(target, index.aliases.alias_lines[row], false, index.aliases.alias_owners[row], report, seen, depth + 1)
            seen.resize(mark)
            return expanded

        def proof_source_conversion_type_alias_unwrap(expression: Ast::Expr, declaration_line: u32, check_caller_generics: bool, resolution_owner: sview, report: mutable ProofReport&, seen: mutable darray[usize]&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if:
                depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT
                not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    if check_caller_generics:
                        generic: (complete: bool, count: usize) = proof_source_conversion_generic_name(name, declaration_line, report)
                        return (false, Ast::Expr.Invalid) if not generic.complete or generic.count > 0
                    if resolution_owner != "" or not check_caller_generics:
                        owner_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_source_conversion_alias_target_in_owner(name, resolution_owner, report)
                        return (false, Ast::Expr.Invalid) if not owner_target.complete or (owner_target.nominal and proof_source_conversion_builtin_type_name(name))
                        return (true, expression) if owner_target.nominal
                        if owner_target.count == 1:
                            return (true, expression) if resolution_owner == "" and not report.source_types.source_effect_index.aliases.bare_alias_root_fallback_valid
                            return proof_source_conversion_alias_expand(owner_target.row, owner_target.target, report, seen, depth)
                        return (true, expression) if owner_target.blocks_parent
                        index: ProofSourceEffectIndex& = report.source_types.source_effect_index
                        if resolution_owner != "":
                            parent_owner: mutable sview = resolution_owner
                            while parent_owner != "" |parent_owner, name, expression, report, seen, depth|:
                                parent_scope: (complete: bool, parent: sview) = proof_source_conversion_alias_parent_owner(parent_owner, report)
                                return (false, Ast::Expr.Invalid) if not parent_scope.complete
                                parent_owner <- parent_scope.parent
                                return (true, expression) if parent_owner == "" and not index.aliases.bare_alias_root_fallback_valid
                                parent_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_source_conversion_alias_target_in_owner(name, parent_owner, report)
                                return (false, Ast::Expr.Invalid) if not parent_target.complete or (parent_target.nominal and proof_source_conversion_builtin_type_name(name))
                                return (true, expression) if parent_target.nominal
                                return proof_source_conversion_alias_expand(parent_target.row, parent_target.target, report, seen, depth) if parent_target.count == 1
                                return (true, expression) if parent_target.blocks_parent or parent_owner == ""
                        return (true, expression)
                    alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_source_conversion_alias_target(name, report)
                    return (false, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
                    return (true, expression) if alias.count == 0
                    index: ProofSourceEffectIndex& = report.source_types.source_effect_index
                    return (false, Ast::Expr.Invalid) if alias.row >= index.aliases.alias_owners.count or index.aliases.alias_owners.count != index.aliases.alias_names.count
                    return (true, expression) if index.aliases.alias_owners[alias.row] != "" or not index.aliases.bare_alias_root_fallback_valid
                    return proof_source_conversion_alias_expand(alias.row, alias.target, report, seen, depth)
                Ast::Expr.Scope(head, name, _):
                    root: (complete: bool, name: sview) = proof_source_conversion_scope_root_name(head, report, 0)
                    return (false, Ast::Expr.Invalid) if not root.complete
                    if root.name != "" and check_caller_generics:
                        generic: (complete: bool, count: usize) = proof_source_conversion_generic_name(root.name, declaration_line, report)
                        return (false, Ast::Expr.Invalid) if not generic.complete or generic.count > 0
                    alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_source_conversion_qualified_alias_target(head, name, report)
                    return (false, Ast::Expr.Invalid) if not alias.complete or alias.count != 1
                    return proof_source_conversion_alias_expand(alias.row, alias.target, report, seen, depth)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_source_conversion_type_alias_unwrap(inner, declaration_line, check_caller_generics, resolution_owner, report, seen, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_source_conversion_type_alias_unwrap(inner, declaration_line, check_caller_generics, resolution_owner, report, seen, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return (true, expression)
                Ast::Expr.Index(head, element, position):
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(head, declaration_line, check_caller_generics, resolution_owner, report, seen, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_head.complete
                    unwrapped_element: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(element, declaration_line, check_caller_generics, resolution_owner, report, seen, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_element.complete
                    return (true, Ast::Expr.Index(unwrapped_head.type_expression, unwrapped_element.type_expression, position))
                Ast::Expr.IndexN(head, arguments, position):
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(head, declaration_line, check_caller_generics, resolution_owner, report, seen, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_head.complete
                    unwrapped_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |report, seen, unwrapped_arguments, depth, declaration_line, check_caller_generics|:
                        unwrapped: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(argument, declaration_line, check_caller_generics, resolution_owner, report, seen, depth + 1)
                        return (false, Ast::Expr.Invalid) if not unwrapped.complete
                        unwrapped_arguments.push(unwrapped.type_expression)
                    return (true, Ast::Expr.IndexN(unwrapped_head.type_expression, unwrapped_arguments, position))
                Ast::Expr.Field(_, _, _):
                    return (false, Ast::Expr.Invalid)
                _:
                    return (true, expression)
