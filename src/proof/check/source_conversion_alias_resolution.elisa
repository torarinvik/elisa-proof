# Resolution and bounded expansion of indexed source type aliases.
extend ElisaProof:
    private:
        def proof_source_conversion_scoped_lookup(name: sview, head: Ast::Expr, names: darray[sview]&, owners: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid or owners.count != name_count
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
            key: (complete: bool, hash: u32) = proof_source_conversion_scope_expression_key_hash(head, name, &report.source_types.source_effect_index.work.implicit_effect_work)
            return (false, 2, name_count) if not key.complete
            slot: mutable usize = (key.hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, head, name, names, owners, hashes, values, counts, name_count, report|:
                return (false, 2, name_count) if not proof_source_index_work_charge(report, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == key.hash:
                    current_name: sview = names[current]
                    return (false, 2, name_count) if not proof_source_index_work_charge(report, sview_len(current_name))
                    if current_name == name and proof_source_conversion_scope_matches_owner(head, owners[current], sview_len(owners[current]), &report.source_types.source_effect_index.work.implicit_effect_work, 0):
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_source_conversion_scoped_owner_lookup(name: sview, owner: sview, names: darray[sview]&, owners: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid or owners.count != name_count
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
            key: (complete: bool, hash: u32) = proof_source_conversion_scope_key_hash(owner, name, &report.source_types.source_effect_index.work.implicit_effect_work)
            return (false, 2, name_count) if not key.complete
            slot: mutable usize = (key.hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, owner, name, names, owners, hashes, values, counts, name_count, report|:
                return (false, 2, name_count) if not proof_source_index_work_charge(report, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == key.hash:
                    current_name: sview = names[current]
                    current_owner: sview = owners[current]
                    return (false, 2, name_count) if:
                        not proof_source_index_work_charge(report, sview_len(current_name))
                        not proof_source_index_work_charge(report, sview_len(name))
                        not proof_source_index_work_charge(report, sview_len(current_owner))
                        not proof_source_index_work_charge(report, sview_len(owner))
                    if current_name == name and current_owner == owner:
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        # Names that Stage1 resolves before aliases in annotation_ident_value_type.
        # This exact table is also used for alias-versus-nominal ambiguity checks;
        # don't use the broader proof-kernel builtin predicate, which includes names
        # like arbitrary iN spellings that this backend leaves available to aliases.
        def proof_source_conversion_builtin_type_name(name: sview) -> bool:
            return proof_stage1_annotation_builtin_type_name(name)

        def proof_source_conversion_alias_target(name: sview, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if not proof_source_index_work_charge(report, sview_len(name))
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if index.aliases.alias_names.count != index.aliases.alias_targets.count
            alias: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup(name, index.aliases.alias_names, index.aliases.alias_index_hashes, index.aliases.alias_index_values, index.aliases.alias_index_counts, index.aliases.alias_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
            nominal: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup(name, index.types.declared_types, index.types.declared_type_index_hashes, index.types.declared_type_index_values, index.types.declared_type_index_counts, index.types.declared_type_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if:
                not nominal.complete
                alias.count == 0 and nominal.count > 0 and proof_source_conversion_builtin_type_name(name)
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Invalid) if alias.count == 0
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if:
                nominal.count > 0 or proof_source_conversion_builtin_type_name(name)
                index.aliases.alias_has_formals.count != index.aliases.alias_names.count
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid) if index.aliases.alias_has_formals[alias.row]
            return (true, 1, alias.row, index.aliases.alias_targets[alias.row])

        def proof_source_conversion_module_alias_root(name: sview, caller_owner: sview, caller_owner_known: bool, report: mutable ProofReport&) -> (complete: bool, name: sview):
            aliases: ProofModuleAliasIndex& = report.analysis_2.fact_call_shapes.functions.module_aliases
            return (false, "") if not aliases.complete
            resolved: mutable sview = name
            steps: mutable usize = 0
            while steps <= aliases.names.count |steps, aliases, resolved, report|:
                if caller_owner_known:
                    lexical: (complete: bool, matched: bool, valid: bool, target: sview, scope: sview) = proof_module_alias_target(aliases, caller_owner, resolved, &report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return (false, "") if not lexical.complete
                    if lexical.matched:
                        return (false, "") if not lexical.valid
                        compatible: (complete: bool, compatible: bool, target: sview) = proof_module_alias_targets_compatible(aliases, lexical.scope, lexical.target, &report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return (false, "") if not compatible.complete or not compatible.compatible
                        return (true, compatible.target)
                lookup: (complete: bool, matched: bool, valid: bool, row: usize) = proof_module_alias_lookup_global(aliases, resolved, &report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return (false, "") if not lookup.complete
                return (true, resolved) if not lookup.matched
                return (false, "") if not lookup.valid or lookup.row >= aliases.targets.count
                next: sview = aliases.targets[lookup.row]
                return (false, "") if next == "" or not proof_source_index_work_charge(report, sview_len(next))
                resolved <- next
                steps <- steps + 1
            return (false, "")

        def proof_source_conversion_module_alias_head(head: Ast::Expr, caller_owner: sview, caller_owner_known: bool, report: mutable ProofReport&) -> (complete: bool, head: Ast::Expr):
            match head:
                Ast::Expr.Ident(name, position):
                    resolved: (complete: bool, name: sview) = proof_source_conversion_module_alias_root(name, caller_owner, caller_owner_known, report)
                    return (false, Ast::Expr.Invalid) if not resolved.complete
                    return (true, head) if resolved.name == name
                    return (true, Ast::Expr.Ident(resolved.name, position))
                Ast::Expr.Scope(parent, member, position):
                    normalized_parent: (complete: bool, head: Ast::Expr) = proof_source_conversion_module_alias_head(parent, caller_owner, caller_owner_known, report)
                    return (true, Ast::Expr.Scope(normalized_parent.head, member, position)) if normalized_parent.complete
                    return (false, Ast::Expr.Invalid)
                _:
                    return (true, head)

        def proof_source_conversion_qualified_alias_target(head: Ast::Expr, name: sview, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal_count: usize, nominal_formal_count: usize):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            type_count: usize = index.types.declared_types.count
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid, 0, 0) if:
                index.aliases.alias_targets.count != index.aliases.alias_names.count
                index.aliases.alias_lines.count != index.aliases.alias_names.count
                index.aliases.alias_offsets.count != index.aliases.alias_names.count
                index.aliases.alias_owners.count != index.aliases.alias_names.count
                index.aliases.alias_has_formals.count != index.aliases.alias_names.count
                not index.types.declared_type_generic_formal_counts_valid
                type_count != index.types.declared_type_generic_formal_counts.count
            alias: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_lookup(name, head, index.aliases.alias_names, index.aliases.alias_owners, index.aliases.alias_scope_index_hashes, index.aliases.alias_scope_index_values, index.aliases.alias_scope_index_counts, index.aliases.alias_scope_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid, 0, 0) if not alias.complete or alias.count > 1
            nominal: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_lookup(name, head, index.types.declared_types, index.types.declared_type_owners, index.types.declared_type_scope_index_hashes, index.types.declared_type_scope_index_values, index.types.declared_type_scope_index_counts, index.types.declared_type_scope_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid, 0, 0) if not nominal.complete or (nominal.count == 1 and nominal.row >= type_count)
            nominal_formal_count: usize = index.types.declared_type_generic_formal_counts[nominal.row] if nominal.count == 1 else 0
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Invalid, nominal.count, nominal_formal_count) if alias.count == 0
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid, nominal.count, nominal_formal_count) if index.aliases.alias_has_formals.count != index.aliases.alias_names.count or alias.row >= index.aliases.alias_has_formals.count
            return (true, 1, alias.row, index.aliases.alias_targets[alias.row], nominal.count, nominal_formal_count)

        # Resolve a nominal type's exact generic arity under the same owner rules used by
        # source alias conversion. Generic aliases have their own formal-count table; this
        # lookup covers only struct/enum declarations.
        def proof_source_conversion_nominal_generic_arity(head: Ast::Expr, owner: sview, owner_known: bool, report: mutable ProofReport&) -> (complete: bool, found: bool, arity: usize):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            declared_count: usize = index.types.declared_types.count
            formal_counts: darray[usize]& = index.types.declared_type_generic_formal_counts
            return (false, false, 0) if formal_counts.count != declared_count or not index.types.declared_type_generic_formal_counts_valid
            return (true, false, 0) if declared_count == 0
            match head:
                Ast::Expr.Ident(name, _):
                    if owner_known:
                        local: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_owner_lookup(name, owner, index.types.declared_types, index.types.declared_type_owners, index.types.declared_type_scope_index_hashes, index.types.declared_type_scope_index_values, index.types.declared_type_scope_index_counts, index.types.declared_type_scope_index_valid, report)
                        return (false, false, 0) if not local.complete or local.count > 1
                        if local.count == 1:
                            return (false, false, 0) if local.row >= declared_count
                            return (true, true, formal_counts[local.row])
                        if owner != "":
                            root: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_owner_lookup(name, "", index.types.declared_types, index.types.declared_type_owners, index.types.declared_type_scope_index_hashes, index.types.declared_type_scope_index_values, index.types.declared_type_scope_index_counts, index.types.declared_type_scope_index_valid, report)
                            return (false, false, 0) if not root.complete or root.count > 1
                            if root.count == 1:
                                return (false, false, 0) if root.row >= declared_count
                                return (true, true, formal_counts[root.row])
                        return (true, false, 0)
                    global_type: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup(name, index.types.declared_types, index.types.declared_type_index_hashes, index.types.declared_type_index_values, index.types.declared_type_index_counts, index.types.declared_type_index_valid, report)
                    return (false, false, 0) if not global_type.complete or global_type.count > 1
                    return (true, false, 0) if global_type.count == 0
                    return (false, false, 0) if global_type.row >= declared_count
                    return (true, true, formal_counts[global_type.row])
                Ast::Expr.Scope(parent, name, _):
                    normalized: (complete: bool, head: Ast::Expr) = proof_source_conversion_module_alias_head(parent, owner, owner_known, report)
                    return (false, false, 0) if not normalized.complete
                    qualified: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_lookup(name, normalized.head, index.types.declared_types, index.types.declared_type_owners, index.types.declared_type_scope_index_hashes, index.types.declared_type_scope_index_values, index.types.declared_type_scope_index_counts, index.types.declared_type_scope_index_valid, report)
                    return (false, false, 0) if not qualified.complete or qualified.count > 1
                    return (true, false, 0) if qualified.count == 0
                    return (false, false, 0) if qualified.row >= declared_count
                    return (true, true, formal_counts[qualified.row])
                _:
                    return (true, false, 0)

        def proof_source_conversion_alias_target_in_owner(name: sview, owner: sview, report: mutable ProofReport&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            alias_count: usize = index.aliases.alias_names.count
            return (false, 2, alias_count, Ast::Expr.Invalid, false, false) if not proof_source_index_work_charge(report, sview_len(name))
            return (false, 2, alias_count, Ast::Expr.Invalid, false, false) if:
                index.aliases.alias_targets.count != alias_count
                index.aliases.alias_lines.count != alias_count
                index.aliases.alias_offsets.count != alias_count
                index.aliases.alias_owners.count != alias_count
                index.aliases.alias_has_formals.count != alias_count
            aliases: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_owner_lookup(name, owner, index.aliases.alias_names, index.aliases.alias_owners, index.aliases.alias_scope_index_hashes, index.aliases.alias_scope_index_values, index.aliases.alias_scope_index_counts, index.aliases.alias_scope_index_valid, report)
            return (false, 2, alias_count, Ast::Expr.Invalid, false, false) if not aliases.complete or aliases.count > 1 or (aliases.count == 1 and aliases.row >= alias_count)
            nominals: (complete: bool, count: usize, row: usize) = proof_source_conversion_scoped_owner_lookup(name, owner, index.types.declared_types, index.types.declared_type_owners, index.types.declared_type_scope_index_hashes, index.types.declared_type_scope_index_values, index.types.declared_type_scope_index_counts, index.types.declared_type_scope_index_valid, report)
            return (false, 2, index.aliases.alias_names.count, Ast::Expr.Invalid, false, false) if not nominals.complete or nominals.count > 1
            # Compiler order differs at module and file scope. A module-owned alias wins
            # before that module's concrete type; at root, concrete declarations win first.
            if owner == "" and nominals.count == 1:
                return (true, 0, index.aliases.alias_names.count, Ast::Expr.Absent, true, true)
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Absent, true, true) if owner != "" and aliases.count == 0 and nominals.count == 1
            return (true, 0, index.aliases.alias_names.count, Ast::Expr.Absent, false, false) if aliases.count == 0
            return (false, 2, alias_count, Ast::Expr.Invalid, false, false) if aliases.row >= index.aliases.alias_has_formals.count
            return (true, 1, aliases.row, index.aliases.alias_targets[aliases.row], false, true)

        # Resolve only the head of an application. The caller already established Index
        def proof_source_conversion_alias_expand(row: usize, target: Ast::Expr, report: mutable ProofReport&, seen: mutable darray[usize]&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, Ast::Expr.Invalid) if row >= index.aliases.alias_names.count or index.aliases.alias_lines.count != index.aliases.alias_names.count or index.aliases.alias_offsets.count != index.aliases.alias_names.count or index.aliases.alias_owners.count != index.aliases.alias_names.count or target is Ast::Expr.Invalid or target is Ast::Expr.Absent
            return (false, Ast::Expr.Invalid) if index.aliases.alias_has_formals.count != index.aliases.alias_names.count or index.aliases.alias_has_formals[row]
            for active in seen |active, row, report|:
                return (false, Ast::Expr.Invalid) if:
                    not proof_source_index_work_charge(report, 1)
                    active == row
            mark: usize = seen.count
            return (false, Ast::Expr.Invalid) if not proof_source_index_work_charge(report, 1)
            seen.push(row)
            # Generic shadowing applies to explicit call-site syntax. Once an alias is entered,
            # bare names in its RHS resolve in the alias's declaring module.
            expanded: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap(target, index.aliases.alias_lines[row], false, index.aliases.alias_owners[row], true, report, seen, depth + 1)
            seen.resize(mark)
            return expanded

        def proof_source_conversion_type_alias_unwrap(expression: Ast::Expr, declaration_line: u32, check_caller_generics: bool, resolution_owner: sview, resolution_owner_known: bool, report: mutable ProofReport&, seen: mutable darray[usize]&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            no_formals: darray[Ast::Expr] = []
            return proof_source_conversion_type_alias_unwrap_with_formals(expression, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, index.aliases.alias_names.count, no_formals, false, report, seen, depth)

        def proof_source_conversion_type_alias_expand_applied(row: usize, target: Ast::Expr, actuals: darray[Ast::Expr]&, report: mutable ProofReport&, seen: mutable darray[usize]&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            alias_count: usize = index.aliases.alias_names.count
            return (false, Ast::Expr.Invalid) if:
                row >= alias_count or target is Ast::Expr.Invalid or target is Ast::Expr.Absent
                index.aliases.alias_has_formals.count != alias_count
                index.aliases.alias_generic_application_valid.count != alias_count
                index.aliases.alias_generic_formal_starts.count != alias_count
                index.aliases.alias_generic_formal_counts.count != alias_count
                index.aliases.alias_has_formals[row] == false
                index.aliases.alias_generic_application_valid[row] == false
                actuals.count != index.aliases.alias_generic_formal_counts[row]
                index.aliases.alias_generic_formal_starts[row] > index.aliases.alias_generic_formal_names.count
                actuals.count > index.aliases.alias_generic_formal_names.count - index.aliases.alias_generic_formal_starts[row]
                index.aliases.alias_lines.count != alias_count or index.aliases.alias_offsets.count != alias_count or index.aliases.alias_owners.count != alias_count
            for active in seen |active, row, report|:
                return (false, Ast::Expr.Invalid) if not proof_source_index_work_charge(report, 1) or active == row
            return (false, Ast::Expr.Invalid) if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_source_index_work_charge(report, 1)
            mark: usize = seen.count
            seen.push(row)
            # Actuals were normalized in the caller's context before this boundary. The
            # alias RHS receives them by exact formal position and must not resolve them
            # again under the alias owner's lexical module.
            expanded: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap_with_formals(target, index.aliases.alias_lines[row], false, index.aliases.alias_owners[row], true, row, actuals, false, report, seen, depth + 1)
            seen.resize(mark)
            return expanded

        def proof_source_conversion_type_alias_unwrap_with_formals(expression: Ast::Expr, declaration_line: u32, check_caller_generics: bool, resolution_owner: sview, resolution_owner_known: bool, formal_owner_row: usize, formal_actuals: darray[Ast::Expr]&, allow_caller_generic_actual: bool, report: mutable ProofReport&, seen: mutable darray[usize]&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            return (false, Ast::Expr.Invalid) if:
                depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT
                not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, Ast::Expr.Invalid) if not proof_source_index_work_charge(report, sview_len(name))
                    if formal_owner_row < index.aliases.alias_names.count:
                        return (false, Ast::Expr.Invalid) if:
                            index.aliases.alias_generic_formal_starts.count != index.aliases.alias_names.count
                            index.aliases.alias_generic_formal_counts.count != index.aliases.alias_names.count
                            index.aliases.alias_generic_application_valid.count != index.aliases.alias_names.count
                            index.aliases.alias_generic_application_valid[formal_owner_row] == false
                            formal_actuals.count != index.aliases.alias_generic_formal_counts[formal_owner_row]
                            index.aliases.alias_generic_formal_starts[formal_owner_row] > index.aliases.alias_generic_formal_names.count
                            formal_actuals.count > index.aliases.alias_generic_formal_names.count - index.aliases.alias_generic_formal_starts[formal_owner_row]
                        start: usize = index.aliases.alias_generic_formal_starts[formal_owner_row]
                        formal: (complete: bool, found: bool, count: usize, flat_index: usize) = proof_source_conversion_alias_formal_name_lookup(name, formal_owner_row, report)
                        return (false, Ast::Expr.Invalid) if not formal.complete or formal.count > 1
                        if formal.found:
                            return (false, Ast::Expr.Invalid) if formal.flat_index < start or formal.flat_index - start >= formal_actuals.count
                            return (true, formal_actuals[formal.flat_index - start])
                    if check_caller_generics:
                        generic: (complete: bool, count: usize) = proof_source_conversion_generic_name(name, declaration_line, report, resolution_owner_known)
                        return (false, Ast::Expr.Invalid) if not generic.complete
                        return (true, expression) if allow_caller_generic_actual and generic.count == 1
                        return (false, Ast::Expr.Invalid) if generic.count > 0
                    # Stage1 resolves scalar and builtin names before consulting aliases.
                    # Keep this rule for bare names only; qualified paths are handled below.
                    return (true, expression) if proof_source_conversion_builtin_type_name(name)
                    if resolution_owner_known:
                        owner_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_source_conversion_alias_target_in_owner(name, resolution_owner, report)
                        return (false, Ast::Expr.Invalid) if not owner_target.complete or (owner_target.nominal and proof_source_conversion_builtin_type_name(name))
                        return (true, expression) if owner_target.nominal
                        if owner_target.count == 1:
                            return proof_source_conversion_alias_expand(owner_target.row, owner_target.target, report, seen, depth)
                        return (true, expression) if owner_target.blocks_parent
                        # Stage1 checks the exact owner, then root declarations. It does not
                        # search enclosing module aliases before root aliases or global types.
                        if resolution_owner != "":
                            root_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_source_conversion_alias_target_in_owner(name, "", report)
                            return (false, Ast::Expr.Invalid) if not root_target.complete or (root_target.nominal and proof_source_conversion_builtin_type_name(name))
                            return (true, expression) if root_target.nominal
                            return proof_source_conversion_alias_expand(root_target.row, root_target.target, report, seen, depth) if root_target.count == 1
                            return (true, expression) if root_target.blocks_parent
                        # The compiler's final legacy fallback accepts only a globally unique
                        # module alias, after concrete type registries. The index declines when
                        # a nominal spelling could take precedence.
                        global_alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_source_conversion_alias_target(name, report)
                        return (false, Ast::Expr.Invalid) if not global_alias.complete or global_alias.count > 1
                        return (true, expression) if global_alias.count == 0
                        return proof_source_conversion_alias_expand(global_alias.row, global_alias.target, report, seen, depth)
                    # This path has no caller module owner, so require a globally unique alias
                    # before expanding.
                    alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_source_conversion_alias_target(name, report)
                    return (false, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
                    return (true, expression) if alias.count == 0
                    index: ProofSourceEffectIndex& = report.source_types.source_effect_index
                    return (false, Ast::Expr.Invalid) if alias.row >= index.aliases.alias_owners.count or index.aliases.alias_owners.count != index.aliases.alias_names.count
                    return proof_source_conversion_alias_expand(alias.row, alias.target, report, seen, depth)
                Ast::Expr.Scope(head, name, position):
                    root: (complete: bool, name: sview) = proof_source_conversion_scope_root_name(head, report, 0)
                    return (false, Ast::Expr.Invalid) if not root.complete
                    if root.name != "" and check_caller_generics:
                        generic: (complete: bool, count: usize) = proof_source_conversion_generic_name(root.name, declaration_line, report, resolution_owner_known)
                        return (false, Ast::Expr.Invalid) if not generic.complete or generic.count > 0
                    normalized_head: (complete: bool, head: Ast::Expr) = proof_source_conversion_module_alias_head(head, resolution_owner, resolution_owner_known, report)
                    return (false, Ast::Expr.Invalid) if not normalized_head.complete
                    alias: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal_count: usize, nominal_formal_count: usize) = proof_source_conversion_qualified_alias_target(normalized_head.head, name, report)
                    return (false, Ast::Expr.Invalid) if not alias.complete
                    return proof_source_conversion_alias_expand(alias.row, alias.target, report, seen, depth) if alias.count == 1
                    return (false, Ast::Expr.Invalid) if alias.nominal_count > 1
                    return (true, expression) if alias.nominal_count == 1
                    if check_caller_generics:
                        generic_leaf: (complete: bool, count: usize) = proof_source_conversion_generic_name(name, declaration_line, report, resolution_owner_known)
                        return (false, Ast::Expr.Invalid) if not generic_leaf.complete
                        return (true, expression) if allow_caller_generic_actual and generic_leaf.count == 1
                        return (false, Ast::Expr.Invalid) if generic_leaf.count > 0
                    return (false, Ast::Expr.Invalid) if not proof_source_index_work_charge(report, sview_len(name))
                    return (true, Ast::Expr.Ident(name, position)) if proof_source_conversion_builtin_type_name(name)
                    simple_module_head: bool = match normalized_head.head:
                        Ast::Expr.Ident(_, _): true
                        _: false
                    if simple_module_head:
                        root_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_source_conversion_alias_target_in_owner(name, "", report)
                        return (false, Ast::Expr.Invalid) if not root_target.complete
                        return (true, expression) if root_target.nominal
                        return proof_source_conversion_alias_expand(root_target.row, root_target.target, report, seen, depth) if root_target.count == 1
                        return (false, Ast::Expr.Invalid) if root_target.count != 0 or root_target.blocks_parent
                        # Stage1's last alias fallback is global and unique. The helper
                        # also declines when any concrete type could take precedence.
                        global_alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_source_conversion_alias_target(name, report)
                        return (false, Ast::Expr.Invalid) if not global_alias.complete or global_alias.count > 1
                        return (true, expression) if global_alias.count == 0
                        return proof_source_conversion_alias_expand(global_alias.row, global_alias.target, report, seen, depth)
                    return (false, Ast::Expr.Invalid)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_source_conversion_type_alias_unwrap_with_formals(inner, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, allow_caller_generic_actual, report, seen, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_source_conversion_type_alias_unwrap_with_formals(inner, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, allow_caller_generic_actual, report, seen, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return (true, expression)
                Ast::Expr.Index(head, element, position):
                    generic_head: mutable bool = false
                    if formal_owner_row < index.aliases.alias_names.count:
                        root: (complete: bool, name: sview) = proof_source_conversion_scope_root_name(head, report, 0)
                        return (false, Ast::Expr.Invalid) if not root.complete
                        formal_head: (complete: bool, found: bool) = proof_source_conversion_alias_formal_head(root.name, formal_owner_row, report)
                        return (false, Ast::Expr.Invalid) if not formal_head.complete or formal_head.found
                    if check_caller_generics:
                        root: (complete: bool, name: sview) = proof_source_conversion_scope_root_name(head, report, 0)
                        return (false, Ast::Expr.Invalid) if not root.complete
                        if root.name != "":
                            generic: (complete: bool, count: usize) = proof_source_conversion_generic_name(root.name, declaration_line, report, resolution_owner_known)
                            return (false, Ast::Expr.Invalid) if not generic.complete
                            generic_head <- generic.count > 0
                    application: (complete: bool, found: bool, row: usize, target: Ast::Expr) = (true, false, index.aliases.alias_names.count, Ast::Expr.Invalid) if generic_head else proof_source_conversion_alias_application_target(head, resolution_owner, resolution_owner_known, report)
                    return (false, Ast::Expr.Invalid) if not application.complete
                    if application.found:
                        return (false, Ast::Expr.Invalid) if application.row >= index.aliases.alias_generic_formal_counts.count or index.aliases.alias_generic_formal_counts[application.row] != 1
                        actual_used: mutable darray[bool] = []
                        if formal_owner_row < index.aliases.alias_names.count:
                            return (false, Ast::Expr.Invalid) if not proof_source_index_work_charge(report, formal_actuals.count)
                            actual_used.resize(formal_actuals.count)
                        for actual_index in 0..<actual_used.count |actual_index, actual_used|:
                            actual_used[actual_index] <- false
                        return (false, Ast::Expr.Invalid) if not proof_source_conversion_alias_type_expression_safe(element, formal_owner_row, &actual_used, seen, resolution_owner, declaration_line, check_caller_generics, resolution_owner_known, report, depth + 1)
                        actual: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap_with_formals(element, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, true, report, seen, depth + 1)
                        return (false, Ast::Expr.Invalid) if not actual.complete or not proof_source_index_work_charge(report, 1)
                        actuals: darray[Ast::Expr] = [actual.type_expression]
                        return proof_source_conversion_type_alias_expand_applied(application.row, application.target, actuals, report, seen, depth)
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap_with_formals(head, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, allow_caller_generic_actual, report, seen, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_head.complete
                    unwrapped_element: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap_with_formals(element, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, allow_caller_generic_actual, report, seen, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_element.complete
                    return (true, Ast::Expr.Index(unwrapped_head.type_expression, unwrapped_element.type_expression, position))
                Ast::Expr.IndexN(head, arguments, position):
                    generic_head: mutable bool = false
                    if formal_owner_row < index.aliases.alias_names.count:
                        root: (complete: bool, name: sview) = proof_source_conversion_scope_root_name(head, report, 0)
                        return (false, Ast::Expr.Invalid) if not root.complete
                        formal_head: (complete: bool, found: bool) = proof_source_conversion_alias_formal_head(root.name, formal_owner_row, report)
                        return (false, Ast::Expr.Invalid) if not formal_head.complete or formal_head.found
                    if check_caller_generics:
                        root: (complete: bool, name: sview) = proof_source_conversion_scope_root_name(head, report, 0)
                        return (false, Ast::Expr.Invalid) if not root.complete
                        if root.name != "":
                            generic: (complete: bool, count: usize) = proof_source_conversion_generic_name(root.name, declaration_line, report, resolution_owner_known)
                            return (false, Ast::Expr.Invalid) if not generic.complete
                            generic_head <- generic.count > 0
                    application: (complete: bool, found: bool, row: usize, target: Ast::Expr) = (true, false, index.aliases.alias_names.count, Ast::Expr.Invalid) if generic_head else proof_source_conversion_alias_application_target(head, resolution_owner, resolution_owner_known, report)
                    return (false, Ast::Expr.Invalid) if not application.complete
                    if application.found:
                        return (false, Ast::Expr.Invalid) if application.row >= index.aliases.alias_generic_formal_counts.count or index.aliases.alias_generic_formal_counts[application.row] != arguments.count
                        actuals: mutable darray[Ast::Expr] = []
                        for argument in arguments |actuals, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, report, seen, depth|:
                            actual_used: mutable darray[bool] = []
                            if formal_owner_row < report.source_types.source_effect_index.aliases.alias_names.count:
                                return (false, Ast::Expr.Invalid) if not proof_source_index_work_charge(report, formal_actuals.count)
                                actual_used.resize(formal_actuals.count)
                            for actual_index in 0..<actual_used.count |actual_index, actual_used|:
                                actual_used[actual_index] <- false
                            return (false, Ast::Expr.Invalid) if not proof_source_conversion_alias_type_expression_safe(argument, formal_owner_row, &actual_used, seen, resolution_owner, declaration_line, check_caller_generics, resolution_owner_known, report, depth + 1)
                            actual: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap_with_formals(argument, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, true, report, seen, depth + 1)
                            return (false, Ast::Expr.Invalid) if not actual.complete or not proof_source_index_work_charge(report, 1)
                            actuals.push(actual.type_expression)
                        return proof_source_conversion_type_alias_expand_applied(application.row, application.target, actuals, report, seen, depth)
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap_with_formals(head, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, allow_caller_generic_actual, report, seen, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_head.complete
                    unwrapped_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |report, seen, unwrapped_arguments, depth, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals|:
                        unwrapped: (complete: bool, type_expression: Ast::Expr) = proof_source_conversion_type_alias_unwrap_with_formals(argument, declaration_line, check_caller_generics, resolution_owner, resolution_owner_known, formal_owner_row, formal_actuals, allow_caller_generic_actual, report, seen, depth + 1)
                        return (false, Ast::Expr.Invalid) if not unwrapped.complete or not proof_source_index_work_charge(report, 1)
                        unwrapped_arguments.push(unwrapped.type_expression)
                    return (true, Ast::Expr.IndexN(unwrapped_head.type_expression, unwrapped_arguments, position))
                Ast::Expr.Field(_, _, _):
                    return (false, Ast::Expr.Invalid)
                _:
                    return (true, expression)
