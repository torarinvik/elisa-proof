extend ElisaProof:
    private:
        const PROOF_NAME_INDEX_MAX_CLUSTER: usize = 64
        const PROOF_INDEX_MAX_CHAIN: usize = 64

        # Build an open-addressed name index after collection is complete. Exact name equality
        # remains the authority; stored hashes only choose a probe path. Keep the first row for
        # duplicate names and store ambiguity separately, so collisions remain distinguishable.
        def proof_index_capacity(count: usize) -> usize:
            return 0 if count == 0
            capacity: mutable usize = 1
            while capacity < count |capacity, count|:
                capacity <- capacity * 2
            return capacity

        # Name indexes reserve at least one empty slot per entry. This keeps ordinary negative
        # lookups short while the explicit work budget below bounds deliberate collision chains.
        def proof_name_index_capacity(count: usize) -> usize:
            return 0 if count == 0 or count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            proof_index_capacity(count * 2)

        # These indexes feed older consumers that do not carry a work counter. Refuse a table
        # whose final occupied run would let one lookup inspect an input-sized collision cluster.
        def proof_name_index_cluster_status(index_values: darray[usize]&, missing: usize, source_work: mutable usize&) -> (complete: bool, bounded: bool, observed: usize):
            capacity: usize = index_values.count
            return (true, true, 0) if capacity == 0
            empty_slot: mutable usize = capacity
            for slot in 0..<capacity |slot, index_values, source_work, empty_slot, missing|:
                return (false, false, source_work) if not proof_report_source_work_charge(1, source_work)
                if index_values[slot] == missing:
                    empty_slot <- slot
                    break
            return (true, false, capacity) if empty_slot == capacity
            cluster: mutable usize = 0
            for offset in 0..<capacity |offset, index_values, source_work, empty_slot, cluster, missing, capacity|:
                return (false, false, source_work) if not proof_report_source_work_charge(1, source_work)
                slot: usize = (empty_slot + 1 + offset) % capacity
                if index_values[slot] == missing:
                    cluster <- 0
                else:
                    cluster <- cluster + 1
                    return (true, false, cluster) if cluster > PROOF_NAME_INDEX_MAX_CLUSTER
            return (true, true, cluster)

        def proof_build_lemma_index(lemmas: mutable ProofLemmaTable&, source_work: mutable usize&) -> (complete: bool, reason: sview, observed: usize, limit: usize):
            lemmas.identity.index_hashes.clear()
            lemmas.identity.index_values.clear()
            lemmas.identity.index_ambiguous.clear()
            return (false, "lemma-index-shape", lemmas.identity.name_hashes.count, lemmas.identity.names.count) if lemmas.identity.name_hashes.count != lemmas.identity.names.count
            return (true, "", 0, 0) if lemmas.identity.names.count == 0
            capacity: usize = proof_name_index_capacity(lemmas.identity.names.count)
            return (false, "name-index-entries", lemmas.identity.names.count, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2) if capacity == 0
            return (false, "name-index-build-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(lemmas.identity.names.count, source_work)
            lemmas.identity.index_hashes.resize(capacity)
            lemmas.identity.index_values.resize(capacity)
            lemmas.identity.index_ambiguous.resize(capacity)
            for slot in 0..<capacity |slot, lemmas|:
                lemmas.identity.index_values[slot] <- lemmas.identity.names.count
                lemmas.identity.index_ambiguous[slot] <- false
            for name_index in 0..<lemmas.identity.names.count |name_index, lemmas, capacity|:
                return (false, "name-index-build-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(lemmas.identity.names[name_index]), source_work)
                hash: u32 = lemmas.identity.name_hashes[name_index]
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name_index, lemmas, capacity|:
                    return (false, "name-index-build-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                    current: usize = lemmas.identity.index_values[slot]
                    if current == lemmas.identity.names.count:
                        lemmas.identity.index_hashes[slot] <- hash
                        lemmas.identity.index_values[slot] <- name_index
                        placed <- true
                        break
                    if current < lemmas.identity.names.count and lemmas.identity.index_hashes[slot] == hash:
                        return (false, "name-index-build-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(lemmas.identity.names[current]), source_work)
                        if lemmas.identity.names[current] == lemmas.identity.names[name_index]:
                            lemmas.identity.index_ambiguous[slot] <- true
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return (false, "name-index-insertion", probes, capacity) if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(lemmas.identity.index_values, lemmas.identity.names.count, source_work)
            return (false, "name-index-build-work", cluster_status.observed, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not cluster_status.complete
            return (false, "name-index-cluster", cluster_status.observed, PROOF_NAME_INDEX_MAX_CLUSTER) if not cluster_status.bounded
            return (true, "", 0, 0)

        # Find an exact function name in the primary index while charging the actual probe
        # path and equality work. The row is the first declaration, with `repeated` preserving
        # the ambiguity bit used by declaration-line resolution.
        def proof_function_name_lookup_with_work(functions: ProofFunctionTable&, name: sview, source_work: mutable usize&) -> (complete: bool, row: usize, repeated: bool):
            missing: usize = functions.lookup.names.count
            capacity: usize = functions.lookup.index_values.count
            return (false, missing, false) if capacity != functions.lookup.index_hashes.count or capacity != functions.lookup.index_ambiguous.count
            expected_capacity: usize = proof_name_index_capacity(missing)
            return (false, missing, false) if capacity != expected_capacity
            return (true, missing, false) if missing == 0
            return (false, missing, false) if:
                capacity == 0
                source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                not proof_report_source_work_charge(1, source_work)
                not proof_report_source_work_charge(sview_len(name), source_work)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, functions, capacity, missing, source_work|:
                return (false, missing, false) if not proof_report_source_work_charge(1, source_work)
                current: usize = functions.lookup.index_values[slot]
                return (true, missing, false) if current == missing
                return (false, missing, false) if current >= missing
                if functions.lookup.index_hashes[slot] == wanted_hash:
                    return (false, missing, false) if not proof_report_source_work_charge(sview_len(functions.lookup.names[current]), source_work)
                    if functions.lookup.names[current] == name:
                        # Keep the first row available to the duplicate-chain walker; the
                        # repeated bit separately prevents callers from treating it as unique.
                        return (true, current, true) if functions.lookup.index_ambiguous[slot]
                        return (true, current, false)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, missing, false)

        # Build a secondary `(name, declaration line)` index only for rows whose bare name
        # repeats. Exact name and line equality remain authoritative after hash matches; a
        # repeated exact pair is stored as ambiguous and resolves to the caller's sentinel.
        def proof_build_function_declaration_line_index(functions: mutable ProofFunctionTable&, source_work: mutable usize&) -> (complete: bool, reason: sview, observed: usize, limit: usize):
            functions.lookup.declaration_line_index_hashes.clear()
            functions.lookup.declaration_line_index_values.clear()
            functions.lookup.declaration_line_index_ambiguous.clear()
            functions.lookup.declaration_line_index_count <- 0
            functions.lookup.declaration_line_index_valid <- false
            duplicate_rows: mutable usize = 0
            for row in 0..<functions.lookup.names.count |row, functions, duplicate_rows, source_work|:
                return (false, "function-line-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                continue if row >= functions.lookup.lines.count
                lookup: (complete: bool, row: usize, repeated: bool) = proof_function_name_lookup_with_work(functions, functions.lookup.names[row], source_work)
                return (false, "function-line-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not lookup.complete
                duplicate_rows <- duplicate_rows + 1 if lookup.repeated
            functions.lookup.declaration_line_index_count <- duplicate_rows
            if duplicate_rows == 0:
                functions.lookup.declaration_line_index_valid <- true
                return (true, "", 0, 0)
            capacity: usize = proof_name_index_capacity(duplicate_rows)
            return (false, "function-line-index-entries", duplicate_rows, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2) if capacity == 0
            return (false, "function-line-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3
                not proof_report_source_work_charge(capacity * 3, source_work)
            functions.lookup.declaration_line_index_hashes.resize(capacity)
            functions.lookup.declaration_line_index_values.resize(capacity)
            functions.lookup.declaration_line_index_ambiguous.resize(capacity)
            for slot in 0..<capacity |slot, functions, capacity|:
                functions.lookup.declaration_line_index_values[slot] <- functions.lookup.names.count
                functions.lookup.declaration_line_index_ambiguous[slot] <- false
            for row in 0..<functions.lookup.names.count |row, functions, source_work, capacity|:
                return (false, "function-line-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                continue if row >= functions.lookup.lines.count
                name: sview = functions.lookup.names[row]
                lookup: (complete: bool, row: usize, repeated: bool) = proof_function_name_lookup_with_work(functions, name, source_work)
                return (false, "function-line-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not lookup.complete
                continue if not lookup.repeated
                return (false, "function-line-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                hash: u32 = proof_expr_shape_mix(proof_name_hash(name), functions.lookup.lines[row].i64())
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, row, functions, capacity, source_work, placed|:
                    return (false, "function-line-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                    current: usize = functions.lookup.declaration_line_index_values[slot]
                    if current == functions.lookup.names.count:
                        functions.lookup.declaration_line_index_hashes[slot] <- hash
                        functions.lookup.declaration_line_index_values[slot] <- row
                        placed <- true
                        break
                    return (false, "function-line-index-shape", current, functions.lookup.names.count) if current >= functions.lookup.names.count or current >= functions.lookup.lines.count
                    if functions.lookup.declaration_line_index_hashes[slot] == hash:
                        current_name: sview = functions.lookup.names[current]
                        return (false, "function-line-index-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(current_name), source_work)
                        if functions.lookup.lines[current] == functions.lookup.lines[row] and current_name == name:
                            functions.lookup.declaration_line_index_ambiguous[slot] <- true
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return (false, "function-line-index-insertion", probes, capacity) if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(functions.lookup.declaration_line_index_values, functions.lookup.names.count, source_work)
            return (false, "function-line-index-work", cluster_status.observed, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not cluster_status.complete
            return (false, "function-line-index-cluster", cluster_status.observed, PROOF_NAME_INDEX_MAX_CLUSTER) if not cluster_status.bounded
            functions.lookup.declaration_line_index_valid <- true
            return (true, "", 0, 0)

        def proof_build_function_index(functions: mutable ProofFunctionTable&, source_work: mutable usize&) -> (complete: bool, reason: sview, observed: usize, limit: usize):
            functions.lookup.index_hashes.clear()
            functions.lookup.index_values.clear()
            functions.lookup.index_ambiguous.clear()
            functions.lookup.index_duplicate_next.clear()
            functions.lookup.index_duplicate_tails.clear()
            functions.lookup.declaration_line_index_hashes.clear()
            functions.lookup.declaration_line_index_values.clear()
            functions.lookup.declaration_line_index_ambiguous.clear()
            functions.lookup.declaration_line_index_count <- 0
            functions.lookup.declaration_line_index_valid <- false
            return (false, "function-index-shape", functions.lookup.name_hashes.count, functions.lookup.names.count) if functions.lookup.name_hashes.count != functions.lookup.names.count
            if functions.lookup.names.count == 0:
                functions.lookup.declaration_line_index_valid <- true
                return (true, "", 0, 0)
            capacity: usize = proof_name_index_capacity(functions.lookup.names.count)
            return (false, "name-index-entries", functions.lookup.names.count, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2) if capacity == 0
            # Precharge four slot arrays and the row-sized duplicate-link array before growth and
            # initialization, so allocation/initialization cost is independent of later probes.
            return (false, "name-index-build-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if:
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(functions.lookup.names.count, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
            functions.lookup.index_hashes.resize(capacity)
            functions.lookup.index_values.resize(capacity)
            functions.lookup.index_ambiguous.resize(capacity)
            functions.lookup.index_duplicate_tails.resize(capacity)
            functions.lookup.index_duplicate_next.resize(functions.lookup.names.count)
            for slot in 0..<capacity |slot, functions|:
                functions.lookup.index_values[slot] <- functions.lookup.names.count
                functions.lookup.index_ambiguous[slot] <- false
                functions.lookup.index_duplicate_tails[slot] <- functions.lookup.names.count
            for row in 0..<functions.lookup.names.count |row, functions|:
                functions.lookup.index_duplicate_next[row] <- functions.lookup.names.count
            for name_index in 0..<functions.lookup.names.count |name_index, functions, capacity|:
                return (false, "name-index-build-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(functions.lookup.names[name_index]), source_work)
                hash: u32 = functions.lookup.name_hashes[name_index]
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name_index, functions, capacity|:
                    return (false, "name-index-build-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(1, source_work)
                    current: usize = functions.lookup.index_values[slot]
                    if current == functions.lookup.names.count:
                        functions.lookup.index_hashes[slot] <- hash
                        functions.lookup.index_values[slot] <- name_index
                        functions.lookup.index_duplicate_tails[slot] <- name_index
                        placed <- true
                        break
                    if current < functions.lookup.names.count and functions.lookup.index_hashes[slot] == hash:
                        return (false, "name-index-build-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not proof_report_source_work_charge(sview_len(functions.lookup.names[current]), source_work)
                        if functions.lookup.names[current] == functions.lookup.names[name_index]:
                            functions.lookup.index_ambiguous[slot] <- true
                            bucket_tail: usize = functions.lookup.index_duplicate_tails[slot]
                            return (false, "name-index-duplicate-chain", bucket_tail, functions.lookup.names.count) if bucket_tail >= functions.lookup.names.count
                            functions.lookup.index_duplicate_next[bucket_tail] <- name_index
                            functions.lookup.index_duplicate_tails[slot] <- name_index
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return (false, "name-index-insertion", probes, capacity) if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(functions.lookup.index_values, functions.lookup.names.count, source_work)
            return (false, "name-index-build-work", cluster_status.observed, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) if not cluster_status.complete
            return (false, "name-index-cluster", cluster_status.observed, PROOF_NAME_INDEX_MAX_CLUSTER) if not cluster_status.bounded
            line_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_function_declaration_line_index(functions, source_work)
            return line_index_status if not line_index_status.complete
            return (true, "", 0, 0)

        # Resolve a repeated function name by its declaration line through the bounded
        # secondary index. A repeated `(name, line)` or a miss keeps the legacy names.count
        # sentinel. Incomplete state is distinct so callers can fail closed on work exhaustion.
        def proof_function_index_at_line_with_work(functions: ProofFunctionTable&, name: sview, line: u32, source_work: mutable usize&) -> (complete: bool, row: usize):
            missing: usize = functions.lookup.names.count
            name_lookup: (complete: bool, row: usize, repeated: bool) = proof_function_name_lookup_with_work(functions, name, source_work)
            return (false, missing) if not name_lookup.complete
            if not name_lookup.repeated:
                return (true, missing) if name_lookup.row == missing
                return (false, missing) if name_lookup.row >= functions.lookup.lines.count
                return (true, name_lookup.row) if functions.lookup.lines[name_lookup.row] == line
                return (true, missing)
            return (false, missing) if not functions.lookup.declaration_line_index_valid
            capacity: usize = functions.lookup.declaration_line_index_values.count
            return (false, missing) if capacity != functions.lookup.declaration_line_index_hashes.count or capacity != functions.lookup.declaration_line_index_ambiguous.count
            if functions.lookup.declaration_line_index_count == 0:
                return (true, missing) if capacity == 0
                return (false, missing)
            expected_capacity: usize = proof_name_index_capacity(functions.lookup.declaration_line_index_count)
            return (false, missing) if:
                expected_capacity == 0 or capacity != expected_capacity
                source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                not proof_report_source_work_charge(1, source_work)
                not proof_report_source_work_charge(sview_len(name), source_work)
            wanted_hash: u32 = proof_expr_shape_mix(proof_name_hash(name), line.i64())
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, line, functions, capacity, missing, source_work|:
                return (false, missing) if not proof_report_source_work_charge(1, source_work)
                current: usize = functions.lookup.declaration_line_index_values[slot]
                return (true, missing) if current == missing
                return (false, missing) if current >= missing or current >= functions.lookup.lines.count
                if functions.lookup.declaration_line_index_hashes[slot] == wanted_hash and functions.lookup.lines[current] == line:
                    return (false, missing) if not proof_report_source_work_charge(sview_len(functions.lookup.names[current]), source_work)
                    if functions.lookup.names[current] == name:
                        return (true, missing) if functions.lookup.declaration_line_index_ambiguous[slot]
                        return (true, current)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, missing)
