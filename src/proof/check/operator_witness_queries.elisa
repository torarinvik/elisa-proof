# Read-only operator-witness queries and runtime operand admission.
extend ElisaProof:
    private:
        def proof_cast_target_name(callee: Ast::Expr) -> sview:
            match callee:
                Ast::Expr.Field(_, target, _):
                    return target
                _:
                    return ""

        def proof_builtin_operator_term_witnessed(expression: Ast::Expr, protocol: sview, facts: darray[Ast::Expr]&) -> bool:
            match expression:
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_builtin_operator_term_witnessed(inner, protocol, facts)
                _:
                    pass
            for fact in facts:
                continue if not proof_marker_has_callee(fact, "__elisa_builtin_operator_type")
                marker: (known: bool, term: Ast::Expr, protocol: sview) = proof_builtin_operator_marker_info(fact)
                return true if marker.known and marker.protocol == protocol and proof_expr_equal(marker.term, expression)
            return false

        def proof_index_operator_term_witnessed(expression: Ast::Expr, protocol: sview, facts: darray[Ast::Expr]&, trusted: bool) -> bool:
            object: mutable Ast::Expr = expression
            match expression:
                Ast::Expr.Index(indexed_object, _, _):
                    object <- indexed_object
                Ast::Expr.IndexN(indexed_object, _, _):
                    object <- indexed_object
                Ast::Expr.Paren(inner, _):
                    return proof_index_operator_term_witnessed(inner, protocol, facts, trusted)
                _:
                    return false
            wanted_protocol: sview = proof_index_operator_protocol(protocol)
            wanted_marker: sview = "__elisa_builtin_operator_type" if trusted else "__elisa_untrusted_operator_type"
            for fact in facts:
                continue if not proof_marker_has_callee(fact, wanted_marker)
                marker: (known: bool, term: Ast::Expr, protocol: sview) = proof_builtin_operator_marker_info(fact) if trusted else proof_untrusted_operator_marker_info(fact)
                return true if marker.known and marker.protocol == wanted_protocol and proof_expr_equal(marker.term, object)
            return false

        def proof_builtin_index_expression_witnessed(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_builtin_index_expression_witnessed(inner, facts)
                Ast::Expr.Index(object, _, _):
                    for fact in facts:
                        continue if not proof_marker_has_callee(fact, "__elisa_builtin_index_type")
                        marker: (known: bool, term: Ast::Expr) = proof_builtin_index_marker_info(fact)
                        return true if marker.known and proof_expr_equal(marker.term, object)
                    return false
                Ast::Expr.IndexN(object, _, _):
                    for fact in facts:
                        continue if not proof_marker_has_callee(fact, "__elisa_builtin_index_type")
                        marker: (known: bool, term: Ast::Expr) = proof_builtin_index_marker_info(fact)
                        return true if marker.known and proof_expr_equal(marker.term, object)
                    return false
                _:
                    return false

        def proof_const_enum_shorthand_has_builtin_equality(expression: Ast::Expr, protocol: sview, report: ProofReport&) -> bool:
            return false if protocol != "Eq"
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_const_enum_shorthand_has_builtin_equality(inner, protocol, report)
                Ast::Expr.ShorthandMember(parts, _):
                    return false if parts.count != 1
                    member: (known: bool, owner: sview) = proof_unique_const_enum_member_owner(parts[0], report.source_declarations)
                    return member.known and not proof_report_builtin_operator_impl_exists(report, member.owner, protocol)
                _:
                    return false

        def proof_runtime_operator_operand_untrusted(expression: Ast::Expr, protocol: sview, facts: darray[Ast::Expr]&, report: ProofReport&, functions: ProofFunctionTable&, depth: usize) -> bool:
            return false if proof_scalar_runtime_term_witnessed(expression, facts, functions, depth)
            return false if proof_const_enum_shorthand_has_builtin_equality(expression, protocol, report)
            return false if proof_builtin_operator_term_witnessed(expression, protocol, facts)
            return false if proof_index_operator_term_witnessed(expression, protocol, facts, true)
            for fact in facts:
                continue if not proof_marker_has_callee(fact, "__elisa_untrusted_operator_type")
                marker: (known: bool, term: Ast::Expr, protocol: sview) = proof_untrusted_operator_marker_info(fact)
                return true if marker.known and marker.protocol == protocol and proof_expr_equal(marker.term, expression)
            return true if proof_index_operator_term_witnessed(expression, protocol, facts, false)
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_runtime_operator_operand_untrusted(inner, protocol, facts, report, functions, depth + 1)
                Ast::Expr.StringLit(_, _):
                    return false
                Ast::Expr.FloatLit(_, _):
                    return not (proof_float_mode can Global.Read)
                Ast::Expr.Call(callee, arguments, _, _):
                    # An integer conversion no source function shadows yields a primitive
                    # integer, which cannot be a struct protocol receiver.
                    return false if proof_runtime_numeric_conversion(callee, arguments.count, functions).known
                    called: sview = proof_callable_name(callee)
                    called_index: usize = proof_function_index_for_callee(functions, callee)
                    # The call's effects are handled by the explicit call-state traversal. For
                    # overload admission we only need its result shape: a scalar-returning call
                    # cannot itself be a struct protocol receiver. Purity remains required by the
                    # separate scalar-congruence witness relation, where repeated calls must also
                    # denote the same value.
                    return false if called_index < functions.return_scalar.count and functions.return_scalar[called_index]
                    return true
                Ast::Expr.Index(_, _, _):
                    return true
                Ast::Expr.IndexN(_, _, _):
                    return true
                # Built-in aggregate expressions do not dispatch the scalar operator protocols.
                # Their equality is intentionally left to the ordinary kernel expression gate so
                # unsupported slice/collection goals are still encoded and independently replayed.
                Ast::Expr.Slice(_, _, _, _):
                    return false
                Ast::Expr.Array(_, _):
                    return false
                Ast::Expr.Tuple(_, _):
                    return false
                Ast::Expr.SetLit(_, _):
                    return false
                Ast::Expr.DictLit(_, _):
                    return false
                Ast::Expr.Move(_, _):
                    return true
                Ast::Expr.RegionNew(_, _, _):
                    return true
                Ast::Expr.Construct(_, _, _):
                    return true
                Ast::Expr.RecordUpdate(_, _, _):
                    return true
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_expr_has_unmodeled_operator(guarded, facts, report, functions, depth + 1)
                    for arm in arms |facts, functions, depth|:
                        return true if proof_expr_has_unmodeled_operator(arm.guard, facts, report, functions, depth + 1)
                        for arm_statement in arm.body |facts, functions|:
                            return true if proof_statement_has_unmodeled_operator(arm_statement, facts, report, functions)
                    return false
                Ast::Expr.Lambda(_, _, _):
                    return true
                Ast::Expr.Match(_, _, _):
                    return true
                Ast::Expr.Unary(_, _, _):
                    return false
                Ast::Expr.Binary(_, _, _, _):
                    return false
                Ast::Expr.If(_, _, _, _):
                    return false
                Ast::Expr.Ident(_, _):
                    return false
                Ast::Expr.Field(_, _, _):
                    return false
                Ast::Expr.Scope(_, _, _):
                    return false
                _:
                    return true

        def proof_runtime_operator_expression_witnessed(expression: Ast::Expr, facts: darray[Ast::Expr]&, report: ProofReport&, functions: ProofFunctionTable&, depth: usize) -> bool:
            return true if proof_scalar_runtime_term_witnessed(expression, facts, functions, depth)
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    protocol: sview = proof_builtin_unary_operator_protocol(operator)
                    return not proof_runtime_operator_operand_untrusted(operand, protocol, facts, report, functions, depth + 1) if operator == TokenKind.Plus or operator == TokenKind.Not
                    return protocol != "" and not proof_runtime_operator_operand_untrusted(operand, protocol, facts, report, functions, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    protocol: sview = proof_builtin_operator_protocol(operator)
                    return not proof_runtime_operator_operand_untrusted(left, protocol, facts, report, functions, depth + 1) and not proof_runtime_operator_operand_untrusted(right, protocol, facts, report, functions, depth + 1) if protocol == "" and proof_congruent_binary_operator(operator)
                    return protocol != "" and not proof_runtime_operator_operand_untrusted(left, protocol, facts, report, functions, depth + 1) and not proof_runtime_operator_operand_untrusted(right, protocol, facts, report, functions, depth + 1)
                _:
                    return false

        # Expression witnesses are optional completeness data for the congruence fragment. Keep
        # their number bounded per checked function: every witness is copied through branch and
        # call state, so an unbounded set would turn a finite proof into quadratic or worse fact
        # churn. Spending this budget only removes a witness and can therefore only make a goal
        # decline; it never changes an accepted theorem into an unsound one.
