# Payload enums as frame-owned values. Both compilers refuse a write to an enum payload field
# ("field is immutable"), and a payload field cannot be declared `mutable`, so an enum value --
# inline or a handle into a region-backed packed store -- denotes one immutable tree for its
# whole lifetime. A by-value binding of such a type that nothing references is therefore storage
# no callee can change, the same argument `proof_type_is_reference_free` makes for a struct.
#
# The admitted payloads are deliberately narrow: primitive scalars, floats, const enums, structs
# of such fields and further admitted enums. A container or view payload is refused even when
# the reference-free predicate would accept it, because a binder over it is a second path to the
# payload's heap storage. An enum in a refinement hierarchy (`is Parent`) or carrying `common:`
# fields is refused: a value of the parent type may hold any refinement's payload.
const PROOF_ENUM_HIERARCHY_PARENT_TAG: u32 = 3900000008

extend ElisaProof:
    private:
        def proof_enum_in_hierarchy_with_work(annotations: darray[Ast::EnumAnnotation]&, name: sview, source_work: mutable usize&) -> bool:
            for annotation in annotations |name, source_work|:
                return true if not proof_type_audit_work_charge(1, source_work)
                return true if not proof_type_audit_work_charge(sview_len(name), source_work)
                return true if not proof_type_audit_work_charge(sview_len(annotation.owner), source_work)
                return true if not proof_type_audit_work_charge(sview_len(annotation.name), source_work)
                return true if annotation.line == PROOF_ENUM_HIERARCHY_PARENT_TAG and (annotation.owner == name or annotation.name == name)
                return true if annotation.name == "__has_common" and annotation.owner == name
            return false

        def proof_count_named_aggregates_with_work(declarations: darray[Ast::Decl]&, name: sview, depth: usize, source_work: mutable usize&) -> (enums: usize, const_enums: usize, structs: usize):
            return (2, 2, 2) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            enums: mutable usize = 0
            const_enums: mutable usize = 0
            structs: mutable usize = 0
            for declaration in declarations |name, depth, source_work, enums, const_enums, structs|:
                return (2, 2, 2) if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Enum(enum_name, _, is_const, _, _):
                        return (2, 2, 2) if not proof_type_audit_work_charge(sview_len(name), source_work)
                        return (2, 2, 2) if not proof_type_audit_work_charge(sview_len(enum_name), source_work)
                        if enum_name == name:
                            if is_const:
                                const_enums <- const_enums + 1
                            else:
                                enums <- enums + 1
                    Ast::Decl.Struct(struct_name, _, _, _, _, _, _):
                        return (2, 2, 2) if not proof_type_audit_work_charge(sview_len(name), source_work)
                        return (2, 2, 2) if not proof_type_audit_work_charge(sview_len(struct_name), source_work)
                        structs <- structs + 1 if struct_name == name
                    Ast::Decl.Module(_, body, _):
                        nested: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(body, name, depth + 1, source_work)
                        return (2, 2, 2) if nested.enums > 1 or nested.const_enums > 1 or nested.structs > 1
                        enums <- enums + nested.enums
                        const_enums <- const_enums + nested.const_enums
                        structs <- structs + nested.structs
                    Ast::Decl.Scoped(body, _):
                        nested: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(body, name, depth + 1, source_work)
                        return (2, 2, 2) if nested.enums > 1 or nested.const_enums > 1 or nested.structs > 1
                        enums <- enums + nested.enums
                        const_enums <- const_enums + nested.const_enums
                        structs <- structs + nested.structs
                    Ast::Decl.Invalid:
                        return (2, 2, 2)
                    _:
                        pass
            return (enums, const_enums, structs)

        # For callers without an owner path, distinguish root declarations from a unique match
        # hidden in a nested module. Nested-only leaf matches cannot classify an unqualified type.
        def proof_count_root_named_aggregates_with_work(declarations: darray[Ast::Decl]&, name: sview, depth: usize, source_work: mutable usize&) -> (enums: usize, const_enums: usize, structs: usize):
            return (2, 2, 2) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            enums: mutable usize = 0
            const_enums: mutable usize = 0
            structs: mutable usize = 0
            for declaration in declarations |name, depth, source_work, enums, const_enums, structs|:
                return (2, 2, 2) if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Enum(enum_name, _, is_const, _, _):
                        return (2, 2, 2) if not proof_type_audit_work_charge(sview_len(name) + sview_len(enum_name), source_work)
                        if enum_name == name:
                            const_enums <- const_enums + 1 if is_const
                            enums <- enums + 1 if not is_const
                    Ast::Decl.Scoped(body, _):
                        nested: (enums: usize, const_enums: usize, structs: usize) = proof_count_root_named_aggregates_with_work(body, name, depth + 1, source_work)
                        return (2, 2, 2) if nested.enums > 1 or nested.const_enums > 1 or nested.structs > 1
                        enums <- enums + nested.enums
                        const_enums <- const_enums + nested.const_enums
                        structs <- structs + nested.structs
                    Ast::Decl.Struct(struct_name, _, _, _, _, _, _):
                        return (2, 2, 2) if not proof_type_audit_work_charge(sview_len(name) + sview_len(struct_name), source_work)
                        structs <- structs + 1 if struct_name == name
                    Ast::Decl.Invalid:
                        return (2, 2, 2)
                    _:
                        pass
                return (2, 2, 2) if enums > 1 or const_enums > 1 or structs > 1
            return (enums, const_enums, structs)

        def proof_enum_scope_path(expression: Ast::Expr, path: mutable darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if name == ""
                    path.push(name)
                    return true
                Ast::Expr.Scope(base, name, _):
                    return false if name == "" or not proof_enum_scope_path(base, path, depth + 1)
                    path.push(name)
                    return true
                _:
                    return false
            return false

        def proof_add_qualified_enum_member_witnesses_in(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, line: u32, owner: sview, caller_module: sview, module_aliases: ProofModuleAliasIndex&, depth: usize, source_work: mutable usize&) -> void:
            return if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Field(_, field_name, position):
                    return if not proof_type_audit_work_charge(sview_len(field_name), source_work)
                    marker: Ast::Expr = proof_scalar_term_marker(expression, position)
                    if proof_unique_builtin_const_enum_member_witness_with_context_work(marker, report, caller_module, module_aliases, line, source_work):
                        return if not proof_type_audit_work_charge(facts.count + report.type_bounds.seen.count + report.traces.records.count, source_work)
                        proof_add_scalar_type_witness(facts, report, marker, line, owner)
                        # The root here is this exact enum member, not an arbitrary runtime
                        # value. Pairwise source-backed member comparisons below already cover
                        # every exclusion needed for that constant; emitting a root-specific
                        # exclusion set for every occurrence multiplies identical enum facts in
                        # large contracts. The generic operator path retains exclusions for
                        # arbitrary typed roots.
                Ast::Expr.Binary(left, _, right, _) :
                    proof_add_qualified_enum_member_witnesses_in(left, facts, report, line, owner, caller_module, module_aliases, depth + 1, source_work)
                    proof_add_qualified_enum_member_witnesses_in(right, facts, report, line, owner, caller_module, module_aliases, depth + 1, source_work)
                Ast::Expr.Unary(_, operand, _) | Ast::Expr.Paren(operand, _):
                    proof_add_qualified_enum_member_witnesses_in(operand, facts, report, line, owner, caller_module, module_aliases, depth + 1, source_work)
                Ast::Expr.If(condition, then_value, else_value, _):
                    proof_add_qualified_enum_member_witnesses_in(condition, facts, report, line, owner, caller_module, module_aliases, depth + 1, source_work)
                    proof_add_qualified_enum_member_witnesses_in(then_value, facts, report, line, owner, caller_module, module_aliases, depth + 1, source_work)
                    proof_add_qualified_enum_member_witnesses_in(else_value, facts, report, line, owner, caller_module, module_aliases, depth + 1, source_work)
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_add_qualified_enum_member_witnesses_in(callee, facts, report, line, owner, caller_module, module_aliases, depth + 1, source_work)
                    for argument in arguments |facts, report, line, owner, caller_module, module_aliases, depth|:
                        proof_add_qualified_enum_member_witnesses_in(argument, facts, report, line, owner, caller_module, module_aliases, depth + 1, source_work)
                _:
                    pass

        def proof_add_qualified_enum_member_witnesses(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, line: u32, owner: sview, caller_module: sview, module_aliases: ProofModuleAliasIndex&, depth: usize) -> void:
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            proof_add_qualified_enum_member_witnesses_in(expression, facts, report, line, owner, caller_module, module_aliases, depth, &source_work)
            report.source_effect_index.implicit_effect_work <- source_work

        # A binding's declared type admits it to the frame's own storage as a plain value.
        # `mutable` is a mode on the by-value binding, not part of what the value can reach.
        def proof_value_binding_type(expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> bool:
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            plain: bool = proof_value_binding_type_with_work(expression, report, depth, &source_work)
            report.source_effect_index.implicit_effect_work <- source_work
            return plain

        # A call argument that names a plain value binding of this frame, or a field chain under
        # one. The same text denotes the same immutable value wherever the binding is unchanged,
        # which the ordinary assignment and call-boundary rules already track by the root name.
        def proof_value_binding_argument(expression: Ast::Expr, report: ProofReport&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if name == "" or not (any owned in report.value_binding_names where owned == name)
                    return not (any existing in report.aliased_names where existing == name or existing == "*")
                Ast::Expr.Field(object, field_name, _):
                    return field_name != "" and proof_value_binding_argument(object, report, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_value_binding_argument(inner, report, depth + 1)
                _:
                    return false

        # The declared payload types of `Enum.Variant`, for the one plain enum of that bare name.
        # A qualified or dotless path, a hierarchy member and anything but one match is unknown.
        def proof_payload_variant_field_types(declarations: darray[Ast::Decl]&, all: darray[Ast::Decl]&, enum_name: sview, variant_name: sview, fields: mutable darray[Ast::Expr]&, depth: usize, source_work: mutable usize&) -> usize:
            return 2 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            found: mutable usize = 0
            for declaration in declarations |all, enum_name, variant_name, fields, depth, source_work, found|:
                return 2 if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Enum(name, variants, is_const, _, _):
                        return 2 if not proof_type_audit_work_charge(sview_len(enum_name) + sview_len(name), source_work)
                        if name == enum_name and not is_const:
                            for variant in variants |variant_name, fields, source_work, found|:
                                return 2 if not proof_type_audit_work_charge(1 + sview_len(variant_name) + sview_len(variant.name), source_work)
                                if variant.name == variant_name:
                                    found <- found + 1
                                    return 2 if not proof_type_audit_work_charge(variant.fields.count, source_work)
                                    fields.clear()
                                    fields.extend(variant.fields)
                    Ast::Decl.Module(_, body, _):
                        found <- found + proof_payload_variant_field_types(body, all, enum_name, variant_name, fields, depth + 1, source_work)
                    Ast::Decl.Scoped(body, _):
                        found <- found + proof_payload_variant_field_types(body, all, enum_name, variant_name, fields, depth + 1, source_work)
                    _:
                        pass
            return found

        # The declared type of each binder a payload pattern pushes, in push order. The compiler
        # binds a positional payload binder to the field at the same position, the wildcards
        # included, so only a pattern of bare binders and wildcards is read.
        def proof_payload_binder_types(pattern: Ast::Pattern, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, types: mutable darray[Ast::Expr]&, source_work: mutable usize&) -> bool:
            types.clear()
            match pattern:
                Ast::Pattern.Variant(path, pattern_fields):
                    return false if not proof_type_audit_work_charge(sview_len(path), source_work)
                    dots: mutable usize = 0
                    split: mutable usize = 0
                    for offset in 0..<sview_len(path) |offset, path, dots, split|:
                        if sview_at(path, offset) == PROOF_ASCII_DECIMAL_POINT:
                            dots <- dots + 1
                            split <- offset
                    return false if dots != 1 or split == 0 or split + PROOF_PATTERN_DELIMITER_WIDTH >= sview_len(path)
                    enum_name: sview = string_view_slice(path, 0, split.i64())
                    variant_name: sview = string_view_slice(path, (split + PROOF_PATTERN_DELIMITER_WIDTH).i64(), sview_len(path).i64())
                    counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(declarations, enum_name, 0, source_work)
                    return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or counts.enums != 1 or counts.const_enums != 0 or counts.structs != 0
                    return false if proof_enum_in_hierarchy_with_work(annotations, enum_name, source_work) or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    field_types: mutable darray[Ast::Expr] = []
                    return false if proof_payload_variant_field_types(declarations, declarations, enum_name, variant_name, &field_types, 0, source_work) != 1 or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return false if field_types.count != pattern_fields.count
                    for position_index in 0..<pattern_fields.count |position_index, pattern_fields, field_types, types, source_work|:
                        return false if not proof_type_audit_work_charge(1, source_work)
                        match pattern_fields[position_index]:
                            Ast::Pattern.Binding(_):
                                types.push(field_types[position_index])
                            Ast::Pattern.Wildcard:
                                pass
                            _:
                                types.clear()
                                return false
                    return true
                _:
                    return false

        # A payload binder that took a fresh symbol has the declared type of its payload field.
        # The field type must be a primitive scalar spelled directly: an alias or a name could
        # be a type parameter in disguise. The facts are the ones a declared local receives.
        def proof_add_payload_binder_type_facts(pattern: Ast::Pattern, values: darray[Ast::Expr]&, first: usize, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, index: ProofTypeAuditIndex, enum_index: ProofEnumIndex, owner: sview, position: Ast::Pos) -> void:
            types: mutable darray[Ast::Expr] = []
            source_work: mutable usize = report.source_effect_index.implicit_effect_work
            payload_types_complete: bool = proof_payload_binder_types(pattern, report.source_declarations, report.source_annotations, &types, &source_work)
            report.source_effect_index.implicit_effect_work <- source_work
            return if not payload_types_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return if first > values.count or values.count - first != types.count
            for offset in 0..<types.count |offset, types, values, first, facts, report, index, enum_index, owner, position|:
                proof_add_payload_symbol_type_facts(values[first + offset], types[offset], facts, report, index, enum_index, owner, position)

        def proof_add_payload_symbol_type_facts(value: Ast::Expr, type_expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, index: ProofTypeAuditIndex, enum_index: ProofEnumIndex, owner: sview, position: Ast::Pos) -> void:
            symbol: mutable sview = ""
            match value:
                Ast::Expr.Ident(name, _):
                    symbol <- name
                _:
                    return
            fresh: mutable bool = false
            for pool_index in 0..<PROOF_INTERNAL_REBIND_SYMBOL_COUNT |pool_index, symbol, fresh|:
                fresh <- true if symbol == proof_internal_rebind_name(pool_index)
            return if not fresh
            match type_expression:
                Ast::Expr.Ident(type_name, _):
                    return if not proof_scalar_primitive_type_name(type_name)
                _:
                    return
            unsigned_width: i64 = proof_unsigned_type_width_index_with_work(type_expression, index, enum_index, 0, &report.source_effect_index.implicit_effect_work)
            proof_add_unsigned_binding_facts(facts, report, symbol, unsigned_width, position.line, owner, position) if unsigned_width > 0
            signed_width: i64 = proof_signed_type_width_index_with_work(type_expression, index, enum_index, 0, &report.source_effect_index.implicit_effect_work)
            proof_add_type_bound_fact(facts, report, proof_signed_type_marker(Ast::Expr.Ident(symbol, position), signed_width, position), position.line, owner) if signed_width > 0
            proof_add_primitive_operator_witnesses(facts, report, Ast::Expr.Ident(symbol, position), type_expression, position)
            proof_add_scalar_type_witness(facts, report, proof_scalar_type_marker(symbol, position), position.line, owner) if unsigned_width <= 0
