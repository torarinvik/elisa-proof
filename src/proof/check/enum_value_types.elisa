# Payload enums as frame-owned values. Both compilers refuse a write to an enum payload field
# ("field is immutable"), and a payload field cannot be declared `mutable`, so an enum value --
# inline or a handle into a region-backed packed store -- denotes one immutable tree for its
# whole lifetime. A by-value binding of such a type that nothing references is therefore storage
# no callee can change, the same argument `proof_type_is_reference_free` makes for a struct.
#
# The admitted payloads are deliberately narrow: primitive scalars, floats, const enums, structs
# of such fields and further admitted enums. A container or view payload is refused even when
# the reference-free predicate would accept it, because a binder over it is a second path to the
# payload's heap storage. An enum in a refinement hierarchy (`is Parent`) or carrying `common:`
# fields is refused: a value of the parent type may hold any refinement's payload.
const PROOF_ENUM_HIERARCHY_PARENT_TAG: u32 = 3900000008

extend ElisaProof:
    private:
        def proof_enum_in_hierarchy(annotations: darray[Ast::EnumAnnotation]&, name: sview) -> bool:
            for annotation in annotations |name|:
                return true if annotation.line == PROOF_ENUM_HIERARCHY_PARENT_TAG and (annotation.owner == name or annotation.name == name)
                return true if annotation.name == "__has_common" and annotation.owner == name
            return false

        # Every enum and struct declaration answering to a bare name, anywhere in the program. A
        # bare-name search cannot tell modules apart, so anything but one match is refused.
        def proof_count_named_aggregates(declarations: darray[Ast::Decl]&, name: sview, depth: usize) -> (enums: usize, const_enums: usize, structs: usize):
            return (2, 2, 2) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            enums: mutable usize = 0
            const_enums: mutable usize = 0
            structs: mutable usize = 0
            for declaration in declarations |name, depth, enums, const_enums, structs|:
                match declaration:
                    Ast::Decl.Enum(enum_name, _, is_const, _, _):
                        enums <- enums + 1 if enum_name == name and not is_const
                        const_enums <- const_enums + 1 if enum_name == name and is_const
                    Ast::Decl.Struct(struct_name, _, _, _, _, _, _):
                        structs <- structs + 1 if struct_name == name
                    Ast::Decl.Module(_, body, _):
                        nested: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(body, name, depth + 1)
                        enums <- enums + nested.enums
                        const_enums <- const_enums + nested.const_enums
                        structs <- structs + nested.structs
                    Ast::Decl.Scoped(body, _):
                        nested: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(body, name, depth + 1)
                        enums <- enums + nested.enums
                        const_enums <- const_enums + nested.const_enums
                        structs <- structs + nested.structs
                    _:
                        pass
            return (enums, const_enums, structs)

        # A shorthand member is safe to classify without its local typing context only when its
        # spelling identifies exactly one enum member in the complete imported program, and that
        # member belongs to one uniquely named const enum. Ambiguous spellings remain unknown;
        # replay still performs the contextual owner check for every admitted proposition.
        def proof_count_enum_member_spellings(declarations: darray[Ast::Decl]&, wanted: sview, depth: usize) -> (matches: usize, const_matches: usize, owner: sview):
            return (2, 2, "") if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            matches: mutable usize = 0
            const_matches: mutable usize = 0
            owner: mutable sview = ""
            for declaration in declarations |wanted, depth, matches, const_matches, owner|:
                match declaration:
                    Ast::Decl.Enum(enum_name, variants, is_const, _, _):
                        for variant in variants |wanted, enum_name, is_const, matches, const_matches, owner|:
                            if variant.name == wanted:
                                matches <- matches + 1
                                if is_const:
                                    const_matches <- const_matches + 1
                                    owner <- enum_name
                    Ast::Decl.Module(_, body, _):
                        nested: (matches: usize, const_matches: usize, owner: sview) = proof_count_enum_member_spellings(body, wanted, depth + 1)
                        matches <- matches + nested.matches
                        const_matches <- const_matches + nested.const_matches
                        owner <- nested.owner if nested.const_matches > 0
                    Ast::Decl.Scoped(body, _):
                        nested: (matches: usize, const_matches: usize, owner: sview) = proof_count_enum_member_spellings(body, wanted, depth + 1)
                        matches <- matches + nested.matches
                        const_matches <- const_matches + nested.const_matches
                        owner <- nested.owner if nested.const_matches > 0
                    _:
                        pass
            return (matches, const_matches, owner)

        def proof_unique_const_enum_member_owner(name: sview, declarations: darray[Ast::Decl]&) -> (known: bool, owner: sview):
            return (false, "") if name == ""
            member: (matches: usize, const_matches: usize, owner: sview) = proof_count_enum_member_spellings(declarations, name, 0)
            return (false, "") if member.matches != 1 or member.const_matches != 1 or member.owner == ""
            aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(declarations, member.owner, 0)
            return (false, "") if aggregates.enums != 0 or aggregates.const_enums != 1 or aggregates.structs != 0
            # Nested enum declarations are safe only after the whole declaration tree has
            # established one owner type and one member spelling. The counts above reject
            # same-named enums or variants in sibling scopes; do not infer ownership from the
            # short name alone when the source is ambiguous.
            alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, member.owner, 0)
            return (false, "") if alias.count != 0
            return (true, member.owner)

        def proof_enum_scope_path(expression: Ast::Expr, path: mutable darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if name == ""
                    path.push(name)
                    return true
                Ast::Expr.Scope(base, name, _):
                    return false if name == "" or not proof_enum_scope_path(base, path, depth + 1)
                    path.push(name)
                    return true
                _:
                    return false
            return false

        def proof_enum_scope_matches(current: darray[sview]&, target: darray[sview]&) -> bool:
            return false if target.count == 0 or current.count + 1 != target.count
            for index in 0..<current.count |index, current, target|:
                return false if current[index] != target[index]
            return true

        def proof_exact_const_enum_member_in_scope(declarations: darray[Ast::Decl]&, target: darray[sview]&, current: darray[sview]&, member_name: sview, depth: usize) -> (types: usize, members: usize, owner: sview):
            return (2, 2, "") if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            types: mutable usize = 0
            members: mutable usize = 0
            owner: mutable sview = ""
            for declaration in declarations |target, current, member_name, depth, types, members, owner|:
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        nested_scope: mutable darray[sview] = []
                        nested_scope.extend(current)
                        nested_scope.push(module_name)
                        nested: (types: usize, members: usize, owner: sview) = proof_exact_const_enum_member_in_scope(body, target, nested_scope, member_name, depth + 1)
                        types <- types + nested.types
                        members <- members + nested.members
                        owner <- nested.owner if nested.types > 0
                    Ast::Decl.Scoped(body, _):
                        nested: (types: usize, members: usize, owner: sview) = proof_exact_const_enum_member_in_scope(body, target, current, member_name, depth + 1)
                        types <- types + nested.types
                        members <- members + nested.members
                        owner <- nested.owner if nested.types > 0
                    Ast::Decl.Enum(enum_name, variants, is_const, _, _):
                        if is_const and proof_enum_scope_matches(current, target) and target[target.count - 1] == enum_name:
                            types <- types + 1
                            owner <- enum_name
                            for variant in variants |member_name, members|:
                                members <- members + 1 if variant.name == member_name
                    _:
                        pass
            return (types, members, owner)

        def proof_exact_const_enum_member_owner(enum_type: Ast::Expr, member_name: sview, declarations: darray[Ast::Decl]&) -> (known: bool, owner: sview):
            path: mutable darray[sview] = []
            return (false, "") if not proof_enum_scope_path(enum_type, &path, 0) or path.count < 2
            root_scope: darray[sview] = []
            found: (types: usize, members: usize, owner: sview) = proof_exact_const_enum_member_in_scope(declarations, path, root_scope, member_name, 0)
            return (false, "") if found.types != 1 or found.members != 1 or found.owner == ""
            return (true, found.owner)

        # State invalidation may retain this fact only when it is the exact marker shape the
        # producer creates for an exact const-enum member with no source operator overrides.
        # The marker is immutable and has no place root, so ordinary name-based type-fact
        # retention would otherwise discard it even though it remains valid across every write.
        def proof_unique_builtin_const_enum_member_witness(expression: Ast::Expr, report: ProofReport&) -> bool:
            marker: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
            return false if not marker.known
            match marker.term:
                Ast::Expr.ShorthandMember(parts, _):
                    return false if parts.count != 1
                    member: (known: bool, owner: sview) = proof_unique_const_enum_member_owner(parts[0], report.source_declarations)
                    return false if not member.known
                    protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
                    for protocol in protocols |report, member|:
                        return false if proof_report_builtin_operator_impl_exists(report, member.owner, protocol)
                    return true
                Ast::Expr.Field(enum_type, member_name, _):
                    exact_member: (known: bool, owner: sview) = proof_exact_const_enum_member_owner(enum_type, member_name, report.source_declarations)
                    member: (known: bool, owner: sview) = exact_member if exact_member.known else proof_unique_const_enum_member_owner(member_name, report.source_declarations)
                    return false if not member.known
                    return false if not exact_member.known and proof_type_head_name(enum_type, report.source_declarations, 0) != member.owner
                    protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
                    for protocol in protocols |report, member|:
                        return false if proof_report_builtin_operator_impl_exists(report, member.owner, protocol)
                    return true
                _:
                    return false

        # Record scalar witnesses for the unique members of a declared const enum when the
        # function has a value of that enum type. This lets congruence reason about comparisons
        # that contain `.Variant` without treating arbitrary shorthand or overloaded Eq as
        # primitive. If any value operator is implemented for the enum, no member is witnessed.
        def proof_add_const_enum_member_scalar_witnesses_in(declarations: darray[Ast::Decl]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, enum_name: sview, type_expression: Ast::Expr, line: u32, owner: sview, position: Ast::Pos, depth: usize) -> void:
            return if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |facts, report, enum_name, type_expression, line, owner, position, depth|:
                match declaration:
                    Ast::Decl.Enum(declared_name, variants, is_const, _, _):
                        if declared_name == enum_name and is_const:
                            for variant in variants |facts, report, enum_name, type_expression, line, owner, position|:
                                member: (known: bool, owner: sview) = proof_unique_const_enum_member_owner(variant.name, report.source_declarations)
                                if member.known and member.owner == enum_name:
                                    member_expression: Ast::Expr = Ast::Expr.Field(type_expression, variant.name, position)
                                    marker: Ast::Expr = proof_scalar_term_marker(member_expression, position)
                                    proof_add_scalar_type_witness(facts, report, marker, line, owner)
                                    shorthand: Ast::Expr = Ast::Expr.ShorthandMember([variant.name], position)
                                    shorthand_marker: Ast::Expr = proof_scalar_term_marker(shorthand, position)
                                    proof_add_scalar_type_witness(facts, report, shorthand_marker, line, owner)
                    Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                        proof_add_const_enum_member_scalar_witnesses_in(body, facts, report, enum_name, type_expression, line, owner, position, depth + 1)
                    _:
                        pass

        def proof_add_const_enum_member_scalar_witnesses(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, type_expression: Ast::Expr, line: u32, owner: sview, position: Ast::Pos) -> void:
            enum_name: sview = proof_type_head_name(type_expression, report.source_declarations, 0)
            return if enum_name == ""
            aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(report.source_declarations, enum_name, 0)
            return if aggregates.enums != 0 or aggregates.const_enums != 1 or aggregates.structs != 0
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
            for protocol in protocols |report, enum_name|:
                return if proof_report_builtin_operator_impl_exists(report, enum_name, protocol)
            proof_add_const_enum_member_scalar_witnesses_in(report.source_declarations, facts, report, enum_name, type_expression, line, owner, position, 0)

        def proof_const_enum_member_value_in_scope(declarations: darray[Ast::Decl]&, target: darray[sview]&, current: darray[sview]&, member_name: sview, depth: usize) -> (types: usize, const_types: usize, members: usize, known: bool, value: i64):
            return (2, 2, 2, false, 0) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            types: mutable usize = 0
            const_types: mutable usize = 0
            members: mutable usize = 0
            known: mutable bool = false
            value: mutable i64 = 0
            for declaration in declarations |target, current, member_name, depth, types, const_types, members, known, value|:
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        nested_scope: mutable darray[sview] = []
                        nested_scope.extend(current)
                        nested_scope.push(module_name)
                        nested: (types: usize, const_types: usize, members: usize, known: bool, value: i64) = proof_const_enum_member_value_in_scope(body, target, nested_scope, member_name, depth + 1)
                        types <- types + nested.types
                        const_types <- const_types + nested.const_types
                        members <- members + nested.members
                        if nested.known:
                            known <- true
                            value <- nested.value
                    Ast::Decl.Scoped(body, _):
                        nested: (types: usize, const_types: usize, members: usize, known: bool, value: i64) = proof_const_enum_member_value_in_scope(body, target, current, member_name, depth + 1)
                        types <- types + nested.types
                        const_types <- const_types + nested.const_types
                        members <- members + nested.members
                        if nested.known:
                            known <- true
                            value <- nested.value
                    Ast::Decl.Enum(enum_name, variants, is_const, _, _):
                        if proof_enum_scope_matches(current, target) and target[target.count - 1] == enum_name:
                            types <- types + 1
                            const_types <- const_types + 1 if is_const
                            for variant in variants |member_name, is_const, members, known, value|:
                                if variant.name == member_name and variant.fields.count == 0:
                                    members <- members + 1
                                    if is_const:
                                        match variant.value_expr:
                                            Ast::Expr.IntLit(tag, _):
                                                known <- true
                                                value <- tag
                                            _:
                                                pass
                    _:
                        pass
            return (types, const_types, members, known, value)

        # Constructor relationships are emitted only when the source expression actually
        # compares two exact constructors. The previous whole-domain expansion added every
        # pair for each constructor mention, even when the proof never queried those pairs.
        # Replay independently re-derives the exact enum owner and integer tags for this fact.
        def proof_add_qualified_const_enum_member_pair(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, left: Ast::Expr, right: Ast::Expr, position: Ast::Pos) -> void:
            match left:
                Ast::Expr.Field(left_type, left_member, _):
                    match right:
                        Ast::Expr.Field(right_type, right_member, _):
                            return if left_member == "" or right_member == "" or not proof_expr_equal(left_type, right_type)
                            path: mutable darray[sview] = []
                            return if not proof_enum_scope_path(left_type, &path, 0) or path.count < 2
                            enum_name: sview = path[path.count - 1]
                            return if proof_report_builtin_operator_impl_exists(report, enum_name, "Eq")
                            root_scope: darray[sview] = []
                            left_value: (types: usize, const_types: usize, members: usize, known: bool, value: i64) = proof_const_enum_member_value_in_scope(report.source_declarations, path, root_scope, left_member, 0)
                            right_value: (types: usize, const_types: usize, members: usize, known: bool, value: i64) = proof_const_enum_member_value_in_scope(report.source_declarations, path, root_scope, right_member, 0)
                            return if left_value.types != 1 or left_value.const_types != 1 or left_value.members != 1 or not left_value.known
                            return if right_value.types != 1 or right_value.const_types != 1 or right_value.members != 1 or not right_value.known
                            operator: TokenKind = TokenKind.EqEq if left_value.value == right_value.value else TokenKind.BangEq
                            comparison: Ast::Expr = Ast::Expr.Binary(left, operator, right, position)
                            proof_add_traced_fact(facts, report, comparison, "const-enum-member-value", position.line, report.type_bounds.owner) if facts.count < PROOF_RETURN_FACT_STATE_ENTRY_CAP and not (any existing in facts where proof_expr_equal(existing, comparison))
                        _:
                            pass
                _:
                    pass

        def proof_add_qualified_enum_pair_demands(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, depth: usize) -> void:
            return if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Binary(left, operator, right, position):
                    proof_add_qualified_const_enum_member_pair(facts, report, left, right, position) if operator == TokenKind.EqEq or operator == TokenKind.BangEq
                    proof_add_qualified_enum_pair_demands(left, facts, report, depth + 1)
                    proof_add_qualified_enum_pair_demands(right, facts, report, depth + 1)
                Ast::Expr.Unary(_, operand, _) | Ast::Expr.Paren(operand, _):
                    proof_add_qualified_enum_pair_demands(operand, facts, report, depth + 1)
                Ast::Expr.If(condition, then_value, else_value, _):
                    proof_add_qualified_enum_pair_demands(condition, facts, report, depth + 1)
                    proof_add_qualified_enum_pair_demands(then_value, facts, report, depth + 1)
                    proof_add_qualified_enum_pair_demands(else_value, facts, report, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_add_qualified_enum_pair_demands(callee, facts, report, depth + 1)
                    for argument in arguments |facts, report, depth|:
                        proof_add_qualified_enum_pair_demands(argument, facts, report, depth + 1)
                _:
                    pass

        def proof_add_qualified_enum_member_witnesses(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, line: u32, owner: sview, depth: usize) -> void:
            return if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Field(enum_type, _, position):
                    marker: Ast::Expr = proof_scalar_term_marker(expression, position)
                    if proof_unique_builtin_const_enum_member_witness(marker, report):
                        proof_add_scalar_type_witness(facts, report, marker, line, owner)
                        proof_add_const_enum_value_exclusions(facts, report, expression, enum_type, position)
                Ast::Expr.Binary(left, operator, right, position):
                    proof_add_qualified_const_enum_member_pair(facts, report, left, right, position) if operator == TokenKind.EqEq or operator == TokenKind.BangEq
                    proof_add_qualified_enum_member_witnesses(left, facts, report, line, owner, depth + 1)
                    proof_add_qualified_enum_member_witnesses(right, facts, report, line, owner, depth + 1)
                Ast::Expr.Unary(_, operand, _) | Ast::Expr.Paren(operand, _):
                    proof_add_qualified_enum_member_witnesses(operand, facts, report, line, owner, depth + 1)
                Ast::Expr.If(condition, then_value, else_value, _):
                    proof_add_qualified_enum_member_witnesses(condition, facts, report, line, owner, depth + 1)
                    proof_add_qualified_enum_member_witnesses(then_value, facts, report, line, owner, depth + 1)
                    proof_add_qualified_enum_member_witnesses(else_value, facts, report, line, owner, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_add_qualified_enum_member_witnesses(callee, facts, report, line, owner, depth + 1)
                    for argument in arguments |facts, report, line, owner, depth|:
                        proof_add_qualified_enum_member_witnesses(argument, facts, report, line, owner, depth + 1)
                _:
                    pass

        # Whether every payload field of the one payload enum named `name` is a plain value.
        # `visiting` already holds `name`, so a recursive mention is admitted coinductively.
        def proof_enum_payloads_plain(declarations: darray[Ast::Decl]&, all: darray[Ast::Decl]&, name: sview, annotations: darray[Ast::EnumAnnotation]&, visiting: darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |all, name, annotations, visiting, depth|:
                match declaration:
                    Ast::Decl.Enum(enum_name, variants, is_const, _, _):
                        if enum_name == name and not is_const:
                            for variant in variants |all, annotations, visiting, depth|:
                                for field in variant.fields |all, annotations, visiting, depth|:
                                    return false if not proof_plain_value_type(field, all, annotations, visiting, depth + 1)
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_enum_payloads_plain(body, all, name, annotations, visiting, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_enum_payloads_plain(body, all, name, annotations, visiting, depth + 1)
                    _:
                        pass
            return true

        def proof_plain_named_type(name: sview, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, visiting: darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or name == ""
            return true if proof_scalar_primitive_type_name(name) or name == "f32" or name == "f64"
            return true if any open in visiting where open == name
            alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
            return false if alias.count != 0
            counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(declarations, name, 0)
            return counts.enums == 0 and counts.structs == 0 if counts.const_enums == 1
            return false if counts.const_enums != 0
            if counts.structs == 1 and counts.enums == 0:
                field_names: mutable darray[sview] = []
                return false if proof_struct_field_names(declarations, name, 0, &field_names) != 1
                for field_name in field_names |name, declarations, annotations, visiting, depth|:
                    field: (count: usize, type_expression: Ast::Expr) = proof_struct_field_type(declarations, name, field_name, 0)
                    return false if field.count != 1 or not proof_plain_value_type(field.type_expression, declarations, annotations, visiting, depth + 1)
                return true
            return false if counts.enums != 1 or counts.structs != 0 or proof_enum_in_hierarchy(annotations, name)
            inner: mutable darray[sview] = proof_copy_names(visiting)
            inner.push(name)
            return proof_enum_payloads_plain(declarations, declarations, name, annotations, inner, depth + 1)

        def proof_plain_value_type(expression: Ast::Expr, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, visiting: darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_plain_value_type(inner, declarations, annotations, visiting, depth + 1)
                Ast::Expr.Ident(name, _):
                    return proof_plain_named_type(name, declarations, annotations, visiting, depth + 1)
                Ast::Expr.Scope(_, name, _):
                    return proof_plain_named_type(name, declarations, annotations, visiting, depth + 1)
                _:
                    return false

        # A binding's declared type admits it to the frame's own storage as a plain value.
        # `mutable` is a mode on the by-value binding, not part of what the value can reach.
        def proof_value_binding_type(expression: Ast::Expr, report: ProofReport&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(operator, inner, _):
                    return operator == TokenKind.Mutable and proof_value_binding_type(inner, report, depth + 1)
                _:
                    pass
            visiting: darray[sview] = []
            return proof_plain_value_type(expression, report.source_declarations, report.source_annotations, visiting, 0)

        # A call argument that names a plain value binding of this frame, or a field chain under
        # one. The same text denotes the same immutable value wherever the binding is unchanged,
        # which the ordinary assignment and call-boundary rules already track by the root name.
        def proof_value_binding_argument(expression: Ast::Expr, report: ProofReport&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if name == "" or not (any owned in report.value_binding_names where owned == name)
                    return not (any existing in report.aliased_names where existing == name or existing == "*")
                Ast::Expr.Field(object, field_name, _):
                    return field_name != "" and proof_value_binding_argument(object, report, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_value_binding_argument(inner, report, depth + 1)
                _:
                    return false

        # The declared payload types of `Enum.Variant`, for the one plain enum of that bare name.
        # A qualified or dotless path, a hierarchy member and anything but one match is unknown.
        def proof_payload_variant_field_types(declarations: darray[Ast::Decl]&, all: darray[Ast::Decl]&, enum_name: sview, variant_name: sview, fields: mutable darray[Ast::Expr]&, depth: usize) -> usize:
            return 2 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            found: mutable usize = 0
            for declaration in declarations |all, enum_name, variant_name, fields, depth, found|:
                match declaration:
                    Ast::Decl.Enum(name, variants, is_const, _, _):
                        if name == enum_name and not is_const:
                            for variant in variants |variant_name, fields, found|:
                                if variant.name == variant_name:
                                    found <- found + 1
                                    fields.clear()
                                    fields.extend(variant.fields)
                    Ast::Decl.Module(_, body, _):
                        found <- found + proof_payload_variant_field_types(body, all, enum_name, variant_name, fields, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        found <- found + proof_payload_variant_field_types(body, all, enum_name, variant_name, fields, depth + 1)
                    _:
                        pass
            return found

        # The declared type of each binder a payload pattern pushes, in push order. The compiler
        # binds a positional payload binder to the field at the same position, the wildcards
        # included, so only a pattern of bare binders and wildcards is read.
        def proof_payload_binder_types(pattern: Ast::Pattern, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, types: mutable darray[Ast::Expr]&) -> bool:
            types.clear()
            match pattern:
                Ast::Pattern.Variant(path, pattern_fields):
                    dots: mutable usize = 0
                    split: mutable usize = 0
                    for offset in 0..<sview_len(path) |offset, path, dots, split|:
                        if sview_at(path, offset) == PROOF_ASCII_DECIMAL_POINT:
                            dots <- dots + 1
                            split <- offset
                    return false if dots != 1 or split == 0 or split + PROOF_PATTERN_DELIMITER_WIDTH >= sview_len(path)
                    enum_name: sview = string_view_slice(path, 0, split.i64())
                    variant_name: sview = string_view_slice(path, (split + PROOF_PATTERN_DELIMITER_WIDTH).i64(), sview_len(path).i64())
                    counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(declarations, enum_name, 0)
                    return false if counts.enums != 1 or counts.const_enums != 0 or counts.structs != 0 or proof_enum_in_hierarchy(annotations, enum_name)
                    field_types: mutable darray[Ast::Expr] = []
                    return false if proof_payload_variant_field_types(declarations, declarations, enum_name, variant_name, &field_types, 0) != 1
                    return false if field_types.count != pattern_fields.count
                    for position_index in 0..<pattern_fields.count |position_index, pattern_fields, field_types, types|:
                        match pattern_fields[position_index]:
                            Ast::Pattern.Binding(_):
                                types.push(field_types[position_index])
                            Ast::Pattern.Wildcard:
                                pass
                            _:
                                types.clear()
                                return false
                    return true
                _:
                    return false

        # A payload binder that took a fresh symbol has the declared type of its payload field.
        # The field type must be a primitive scalar spelled directly: an alias or a name could
        # be a type parameter in disguise. The facts are the ones a declared local receives.
        def proof_add_payload_binder_type_facts(pattern: Ast::Pattern, values: darray[Ast::Expr]&, first: usize, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, index: ProofTypeAuditIndex, owner: sview, position: Ast::Pos) -> void:
            types: mutable darray[Ast::Expr] = []
            return if not proof_payload_binder_types(pattern, report.source_declarations, report.source_annotations, &types)
            return if first > values.count or values.count - first != types.count
            for offset in 0..<types.count |offset, types, values, first, facts, report, index, owner, position|:
                proof_add_payload_symbol_type_facts(values[first + offset], types[offset], facts, report, index, owner, position)

        def proof_add_payload_symbol_type_facts(value: Ast::Expr, type_expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, index: ProofTypeAuditIndex, owner: sview, position: Ast::Pos) -> void:
            symbol: mutable sview = ""
            match value:
                Ast::Expr.Ident(name, _):
                    symbol <- name
                _:
                    return
            fresh: mutable bool = false
            for pool_index in 0..<PROOF_INTERNAL_REBIND_SYMBOL_COUNT |pool_index, symbol, fresh|:
                fresh <- true if symbol == proof_internal_rebind_name(pool_index)
            return if not fresh
            match type_expression:
                Ast::Expr.Ident(type_name, _):
                    return if not proof_scalar_primitive_type_name(type_name)
                _:
                    return
            unsigned_width: i64 = proof_unsigned_type_width_index(type_expression, index, 0)
            proof_add_unsigned_binding_facts(facts, report, symbol, unsigned_width, position.line, owner, position) if unsigned_width > 0
            signed_width: i64 = proof_signed_type_width_index(type_expression, index, 0)
            proof_add_type_bound_fact(facts, report, proof_signed_type_marker(Ast::Expr.Ident(symbol, position), signed_width, position), position.line, owner) if signed_width > 0
            proof_add_primitive_operator_witnesses(facts, report, Ast::Expr.Ident(symbol, position), type_expression, position)
            proof_add_scalar_type_witness(facts, report, proof_scalar_type_marker(symbol, position), position.line, owner) if unsigned_width <= 0
