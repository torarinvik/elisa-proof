# Factored helpers retained by the branch integration.
extend ElisaProof:
    private:
        def proof_contract_calls_are_pure(expression: Ast::Expr, functions: mutable ProofFunctionTable&) -> bool:
            return false if proof_expr_has_call(expression) and proof_expr_has_fresh_call_result(expression, functions, 0)
            return proof_contract_calls_are_pure_depth(expression, functions, 0)

        # A pure call can still allocate a fresh aggregate. The kernel has structural equality,
        # so retain call terms only when the resolved return summary proves a scalar result.
        # Unknown, duplicated, external, or malformed call targets fail closed.
        def proof_expr_has_fresh_call_result(expression: Ast::Expr, functions: mutable ProofFunctionTable&, depth: usize) -> bool:
            fallback_work: mutable usize = 0
            return proof_expr_has_fresh_call_result_core(expression, functions, depth, &fallback_work, false, PROOF_EXPR_HAS_CALL_WORK_LIMIT)

        # Runtime-call purity precharges this classifier's AST traversal. Opaque forms may
        # perform an additional full call-presence scan, which must consume the same table meter.
        def proof_expr_has_fresh_call_result_with_fallback_work(expression: Ast::Expr, functions: mutable ProofFunctionTable&, depth: usize, work: mutable usize&, limit: usize) -> bool:
            proof_expr_has_fresh_call_result_core(expression, functions, depth, work, true, limit)

        def proof_expr_has_fresh_call_result_core(expression: Ast::Expr, functions: mutable ProofFunctionTable&, depth: usize, work: mutable usize&, meter_fallback: bool, limit: usize) -> bool:
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    called: sview = proof_callable_name(callee)
                    scalar_name: sview = proof_ident_name(proof_strip_parens(callee))
                    scalar_conversion: mutable bool = scalar_name != "" and proof_builtin_scalar_type_name(scalar_name) and arguments.count == 1 and (argument_names.count == 0 or argument_names.count == arguments.count)
                    if scalar_conversion and argument_names.count == arguments.count:
                        for label in argument_names |scalar_conversion|:
                            scalar_conversion <- false if label != ""
                    internal_scalar: bool = called in {"__elisa_unsigned_type_bound", "__elisa_signed_type_bound", "__elisa_signed_place_type_bound", "__elisa_builtin_index_type", "__elisa_builtin_operator_type", "__elisa_untrusted_operator_type", "__elisa_primitive_integer_type", "__elisa_primitive_scalar_type", "__elisa_primitive_scalar_element", "__elisa_verified_total_bool_atom", "__elisa_linear_certificate"}
                    if called != "old" and called != "__elisa_proof_entry_state" and not internal_scalar and not scalar_conversion:
                        called_index: usize = proof_function_index_for_callee(functions, callee)
                        if called_index < functions.lookup.names.count:
                            return true if called_index >= functions.returns.return_scalar.count or not functions.returns.return_scalar[called_index]
                        return true if not proof_fresh_call_is_builtin_numeric_cast(callee, arguments.count, functions)
                    return true if proof_expr_has_fresh_call_result_core(callee, functions, depth + 1, work, meter_fallback, limit)
                    for argument in arguments:
                        return true if proof_expr_has_fresh_call_result_core(argument, functions, depth + 1, work, meter_fallback, limit)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_expr_has_fresh_call_result_core(inner, functions, depth + 1, work, meter_fallback, limit)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return proof_expr_has_fresh_call_result_core(left, functions, depth + 1, work, meter_fallback, limit) or proof_expr_has_fresh_call_result_core(right, functions, depth + 1, work, meter_fallback, limit)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_has_fresh_call_result_core(object, functions, depth + 1, work, meter_fallback, limit) or proof_expr_has_fresh_call_result_core(low, functions, depth + 1, work, meter_fallback, limit) or proof_expr_has_fresh_call_result_core(high, functions, depth + 1, work, meter_fallback, limit)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_has_fresh_call_result_core(object, functions, depth + 1, work, meter_fallback, limit)
                    for argument in arguments:
                        return true if proof_expr_has_fresh_call_result_core(argument, functions, depth + 1, work, meter_fallback, limit)
                    return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_expr_has_fresh_call_result_core(condition, functions, depth + 1, work, meter_fallback, limit) or proof_expr_has_fresh_call_result_core(then_expression, functions, depth + 1, work, meter_fallback, limit) or proof_expr_has_fresh_call_result_core(else_expression, functions, depth + 1, work, meter_fallback, limit)
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Absent:
                    return false
                _:
                    # New expression forms containing calls are opaque until their result and
                    # evaluation behavior have an explicit source-level summary.
                    if meter_fallback:
                        return proof_expr_has_call_with_work(expression, work, limit)
                    return proof_expr_has_call(expression)

        def proof_expression_has_fresh_runtime_value(expression: Ast::Expr, functions: mutable ProofFunctionTable&, depth: usize) -> bool:
            return true if proof_block_expression_has_fresh_value(expression, depth)
            return proof_expr_has_fresh_call_result(expression, functions, depth)

        def proof_fresh_call_is_builtin_numeric_cast(callee: Ast::Expr, argument_count: usize, functions: ProofFunctionTable&) -> bool:
            return false if argument_count != 0
            match proof_strip_parens(callee):
                Ast::Expr.Field(_, target, _):
                    index: usize = proof_fact_numeric_cast_target_index(target)
                    return false if:
                        index >= PROOF_FACT_NUMERIC_CAST_TARGET_COUNT
                        functions.externs.custom_cast_hook_present
                    return true
                _:
                    return false

        def proof_contract_calls_are_pure_depth(expression: Ast::Expr, functions: mutable ProofFunctionTable&, depth: usize) -> bool:
            # Contract-call admission is a trusted boundary. If traversal stops, reject the
            # expression rather than allowing an unvisited effectful call to look pure.
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return true
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.ShorthandMember(parts, _):
                    # A compiler-resolved one-segment const-enum member is a closed value. A
                    # qualified path is not source-neutral here because the certificate term does
                    # not carry its owner identity.
                    return parts.count == 1 and parts[0] != ""
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    if proof_ident_name(callee) == "old" and arguments.count == 1:
                        return proof_contract_calls_are_pure_depth(arguments[0], functions, depth + 1)
                    scalar_name: sview = proof_ident_name(proof_strip_parens(callee))
                    if scalar_name != "" and proof_builtin_scalar_type_name(scalar_name):
                        return false if arguments.count != 1 or (argument_names.count != 0 and argument_names.count != arguments.count)
                        no_labels: mutable bool = true
                        for label in argument_names |no_labels|:
                            no_labels <- false if label != ""
                        return false if not no_labels
                        return proof_contract_calls_are_pure_depth(arguments[0], functions, depth + 1)
                    unlabelled_arguments: mutable bool = argument_names.count == 0 or argument_names.count == arguments.count
                    if argument_names.count == arguments.count:
                        for label in argument_names |unlabelled_arguments|:
                            unlabelled_arguments <- false if label != ""
                    numeric_cast: (known: bool, receiver: Ast::Expr) = proof_runtime_builtin_numeric_cast(proof_strip_parens(callee), arguments.count, functions)
                    if numeric_cast.known and unlabelled_arguments:
                        match proof_strip_parens(callee):
                            Ast::Expr.Field(_, method, _):
                                return proof_contract_calls_are_pure_depth(numeric_cast.receiver, functions, depth + 1) if proof_resource_pure_conversion(method)
                            _:
                                pass
                    called: sview = proof_callable_name(callee)
                    called_index: usize = proof_function_index_for_callee(functions, callee)
                    return false if called == "" or called_index >= functions.summaries.pure.count or not functions.summaries.pure[called_index]
                    # Purity is a syntactic/fixed-point classification, not a proof result.
                    # A function whose body failed verification must not be smuggled into a
                    # logical contract merely because it has the right effect shape.
                    return false if:
                        called_index >= functions.summaries.verified.count or not functions.summaries.verified[called_index]
                        not proof_contract_calls_are_pure_depth(callee, functions, depth + 1)
                    for argument in arguments |functions|:
                        return false if not proof_contract_calls_are_pure_depth(argument, functions, depth + 1)
                    return true
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_contract_calls_are_pure_depth(lowered.call, functions, depth + 1) if lowered.known
                    return false
                Ast::Expr.Paren(inner, _):
                    return proof_contract_calls_are_pure_depth(inner, functions, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_contract_calls_are_pure_depth(operand, functions, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_contract_calls_are_pure_depth(left, functions, depth + 1) and proof_contract_calls_are_pure_depth(right, functions, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_contract_calls_are_pure_depth(object, functions, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_contract_calls_are_pure_depth(base, functions, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_contract_calls_are_pure_depth(object, functions, depth + 1) and proof_contract_calls_are_pure_depth(index, functions, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_contract_calls_are_pure_depth(object, functions, depth + 1) and proof_contract_calls_are_pure_depth(low, functions, depth + 1) and proof_contract_calls_are_pure_depth(high, functions, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_contract_calls_are_pure_depth(object, functions, depth + 1)
                    for argument in arguments |functions|:
                        return false if not proof_contract_calls_are_pure_depth(argument, functions, depth + 1)
                    return true
                Ast::Expr.Move(operand, _):
                    return proof_contract_calls_are_pure_depth(operand, functions, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_contract_calls_are_pure_depth(operand, functions, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |functions|:
                        return false if not proof_contract_calls_are_pure_depth(element, functions, depth + 1)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements |functions|:
                        return false if not proof_contract_calls_are_pure_depth(element, functions, depth + 1)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements |functions|:
                        return false if not proof_contract_calls_are_pure_depth(element, functions, depth + 1)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |functions|:
                        return false if not proof_contract_calls_are_pure_depth(entry.key, functions, depth + 1) or not proof_contract_calls_are_pure_depth(entry.value, functions, depth + 1)
                    return true
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |functions|:
                        return false if not proof_contract_calls_are_pure_depth(field.value, functions, depth + 1)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_contract_calls_are_pure_depth(base, functions, depth + 1)
                    for field in fields |functions|:
                        return false if not proof_contract_calls_are_pure_depth(field.value, functions, depth + 1)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_contract_calls_are_pure_depth(condition, functions, depth + 1) and proof_contract_calls_are_pure_depth(then_expr, functions, depth + 1) and proof_contract_calls_are_pure_depth(else_expr, functions, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return false if not proof_contract_calls_are_pure_depth(scrutinee, functions, depth + 1)
                    for arm in arms |functions|:
                        return false if:
                            not proof_contract_calls_are_pure_depth(arm.guard, functions, depth + 1)
                            arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return false if not proof_contract_calls_are_pure_depth(value, functions, depth + 1)
                            _:
                                return false
                    return true
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_contract_calls_are_pure_depth(iterable, functions, depth + 1) and proof_contract_calls_are_pure_depth(condition, functions, depth + 1) and proof_contract_calls_are_pure_depth(body, functions, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_contract_calls_are_pure_depth(base, functions, depth + 1) and proof_contract_calls_are_pure_depth(predicate, functions, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return false if not proof_contract_calls_are_pure_depth(initializer, functions, depth + 1)
                            _:
                                return false
                    return proof_contract_calls_are_pure_depth(value, functions, depth + 1)
                _:
                    return false

        # A fact produced by a runtime assertion may outlive the expression evaluation. A
        # substituted call term is therefore safe to publish only when it denotes a certified pure
        # value; an unresolved/effectful call may have a different result on its next execution.
