extend ElisaProof:
    private:
        def proof_add_builtin_index_witness(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, position: Ast::Pos) -> void:
            marker: Ast::Expr = proof_builtin_index_marker(root, position)
            proof_add_type_bound_fact(facts, report, marker, position.line, report.analysis_1.type_bounds.owner)

        def proof_add_index_operator_witnesses(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, element: Ast::Expr, position: Ast::Pos, element_is_owner_generic: bool, source_work: mutable usize&) -> bool can[Global.Read]:
            element_is_builtin: bool = not element_is_owner_generic and (proof_scalar_type_kind_with_work(element, report.source.source_declarations, 0, source_work) == 1 or (proof_builtin_operator_type_name_with_work(element, report.source.source_declarations, 0, source_work) can Global.Read) != "")
            element_container: (known: bool, element: Ast::Expr) = proof_container_element_type_with_work(element, report.source.source_declarations, 0, source_work)
            element_is_container: bool = element_container.known
            element_is_named: bool = proof_type_head_name_with_work(element, report.source.source_declarations, 0, source_work) != ""
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true if not element_is_builtin and not element_is_container and not element_is_named
            has_operator_override: mutable bool = false
            if element_is_builtin:
                names: mutable darray[sview] = []
                return false if not proof_type_operator_impl_names(element, report, &names, 0, source_work)
                for protocol in ["Eq", "Ord", "Less", "Add", "Sub", "Mul", "Div", "Neg", "BitAnd", "BitOr", "BitXor"] |report, names, source_work, has_operator_override|:
                    return false if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(protocol), source_work)
                    for name in names |report, protocol, source_work, has_operator_override|:
                        return false if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(name), source_work)
                        implementation: (complete: bool, exists: bool) = proof_report_kernel_operator_impl_exists_with_work(report, name, protocol, source_work)
                        return false if not implementation.complete
                        has_operator_override <- true if implementation.exists
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            # One fact preserves the same complete indexed protocol set.
            marker: Ast::Expr = proof_builtin_operator_marker(root, "Index.All", position) if element_is_builtin and not has_operator_override else proof_untrusted_operator_marker(root, "Index.All", position)
            proof_add_type_bound_fact(facts, report, marker, position.line, report.analysis_1.type_bounds.owner)
            return true
