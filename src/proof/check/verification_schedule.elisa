extend ElisaProof:
    private:
        const PROOF_LEMMA_DECLARATION_DEPTH_LIMIT: usize = 64

        # Parser import annotations are source bindings too. Since current lemma summaries are
        # indexed by leaf name, imported visible leaves can shadow a candidate declared in a
        # nested module. Resolve those leaves once during summary setup with the shared work budget;
        # never perform an unbounded annotation scan at each proof call.
        def proof_lemma_import_bindings_usable(annotations: darray[Ast::EnumAnnotation]&, lemmas: mutable ProofLemmaTable&, work: mutable usize&) -> (complete: bool, has_unresolved_import: bool):
            from_source: mutable sview = ""
            from_line: mutable u32 = 0
            from_offset: mutable u32 = 0
            from_has_member: mutable bool = false
            index: mutable usize = 0
            while index < annotations.count |index, annotations, lemmas, work, from_source, from_line, from_offset, from_has_member|:
                annotation: Ast::EnumAnnotation = annotations[index]
                return (false, false) if:
                    not proof_report_source_work_charge(1, work)
                    not proof_report_source_work_charge(sview_len(annotation.owner), work)
                    not proof_report_source_work_charge(sview_len(annotation.name), work)
                # A bare `using` can expose an unknown leaf set. Namespace aliases are
                # qualified-only, but must be paired with their exact target metadata.
                if annotation.name == "__binding_wildcard_import":
                    return (true, true)
                if annotation.name == "__using":
                    return (true, true) if index + 2 >= annotations.count
                    return (false, false) if not proof_report_source_work_charge(2, work)
                    alias: Ast::EnumAnnotation = annotations[index + 1]
                    alias_target: Ast::EnumAnnotation = annotations[index + 2]
                    return (false, false) if:
                        not proof_report_source_work_charge(sview_len(alias.owner), work)
                        not proof_report_source_work_charge(sview_len(alias.name), work)
                        not proof_report_source_work_charge(sview_len(alias.module), work)
                        not proof_report_source_work_charge(sview_len(alias_target.owner), work)
                        not proof_report_source_work_charge(sview_len(alias_target.name), work)
                        not proof_report_source_work_charge(sview_len(alias_target.module), work)
                    alias_pair: bool = alias.name == "__using_alias" and alias_target.name == "__using_alias_target" and alias.owner != "" and alias_target.owner == annotation.owner and alias.module == alias_target.module and alias.line == annotation.line and alias_target.line == annotation.line and alias.offset == alias_target.offset and alias.offset > annotation.offset
                    return (true, true) if not alias_pair
                    index <- index + 3
                    continue
                if annotation.owner == "__from_src" or annotation.name == "__using_member":
                    return (true, true)
                # Orphan alias metadata is incomplete source binding evidence.
                if annotation.name in {"__using_alias", "__using_alias_target"}:
                    return (true, true)
                if annotation.name == "__from_decl":
                    return (true, true) if from_source != "" and not from_has_member
                    from_source <- annotation.owner
                    from_line <- annotation.line
                    from_offset <- annotation.offset
                    from_has_member <- false
                    index <- index + 1
                    continue
                if annotation.owner == "__from_member":
                    return (true, true) if index + 1 >= annotations.count
                    return (false, false) if not proof_report_source_work_charge(1, work)
                    source: Ast::EnumAnnotation = annotations[index + 1]
                    return (false, false) if:
                        not proof_report_source_work_charge(sview_len(source.owner), work)
                        not proof_report_source_work_charge(sview_len(source.name), work)
                        not proof_report_source_work_charge(sview_len(source.module), work)
                    exact_source_pair: bool = source.owner == "__from_src" and source.line == annotation.line and source.offset == annotation.offset and source.module == annotation.module
                    return (true, true) if not exact_source_pair or source.name == ""
                    using_member: mutable bool = false
                    if index + 2 < annotations.count:
                        return (false, false) if not proof_report_source_work_charge(1, work)
                        possible_using: Ast::EnumAnnotation = annotations[index + 2]
                        return (false, false) if not proof_report_source_work_charge(sview_len(possible_using.name), work)
                        if possible_using.name == "__using_member":
                            using: Ast::EnumAnnotation = possible_using
                            return (false, false) if:
                                not proof_report_source_work_charge(sview_len(using.owner), work)
                                not proof_report_source_work_charge(sview_len(using.module), work)
                            using_member <- using.owner == source.name and using.module == annotation.name and using.line == annotation.line and using.offset == annotation.offset
                            return (true, true) if not using_member
                            using_member <- true
                    if not using_member:
                        from_pair: bool = from_source == source.name and from_line == annotation.line and from_offset < annotation.offset
                        return (true, true) if not from_pair
                        from_has_member <- true
                    lookup: (complete: bool, index: usize, declared: bool, ambiguous: bool) = proof_lemma_index_with_work(lemmas, annotation.name, work)
                    return (false, false) if not lookup.complete
                    lemmas.verification.unqualified_usable[lookup.index] <- false if lookup.index < lemmas.verification.unqualified_usable.count
                    if using_member:
                        index <- index + 3
                    else:
                        index <- index + 2
                    continue
                index <- index + 1
            return (true, true) if from_source != "" and not from_has_member
            return (true, false)

        # Count every source function row for lemma leaves, including declarations that the
        # executable function table omits because a same-leaf lemma marker matched by name.
        def proof_lemma_source_function_name_counts(declarations: darray[Ast::Decl]&, lemmas: ProofLemmaTable&, counts: mutable darray[usize]&, source_functions: mutable darray[Ast::Decl]&, work: mutable usize&, depth: usize) -> bool:
            return true if lemmas.identity.names.count == 0
            return false if depth >= PROOF_LEMMA_DECLARATION_DEPTH_LIMIT
            for declaration in declarations |lemmas, counts, source_functions, work, depth|:
                return false if not proof_report_source_work_charge(1, work)
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, _):
                        lookup: (complete: bool, index: usize, declared: bool, ambiguous: bool) = proof_lemma_index_with_work(lemmas, name, work)
                        return false if not lookup.complete
                        lemma_index: usize = lookup.index
                        if lemma_index < lemmas.identity.names.count:
                            return false if lemma_index >= counts.count or lemma_index >= source_functions.count
                            source_functions[lemma_index] <- declaration if counts[lemma_index] == 0
                            counts[lemma_index] <- counts[lemma_index] + 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_lemma_source_function_name_counts(nested, lemmas, counts, source_functions, work, depth + 1)
                    _:
                        pass
            return true

        # A lemma has no state to widen. Its body may contain only contracts, proof calls and
        # assert-by blocks, so neither construct above can appear in one without `lemma-impure`
        # beside it -- but the lemma scheduler is kept on the strict rule rather than left to rest
        # on that coincidence. The relaxation is justified by a havocked execution state, and a
        # lemma has none.
        # Same-named functions can share both a leaf name and an innermost module. The stamped
        # source declaration position keeps row-level findings tied to the function that emitted them.
        def proof_check_function_path(file: Ast::File&, declarations: darray[Ast::Decl]&, path: darray[usize]&, path_start: usize, path_count: usize, path_offset: usize, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> bool can[Global.Read, Global.Write]:
            return false if:
                path_count == 0 or path_offset >= path_count
                path_start > path.count or path_count > path.count - path_start
            declaration_index: usize = path[path_start + path_offset]
            return false if declaration_index >= declarations.count
            declaration: Ast::Decl = declarations[declaration_index]
            if path_offset + 1 == path_count:
                match declaration:
                    Ast::Decl.Func(name, parameters, return_type, body, _, _, position):
                        (proof_check_function_with_goal_owner(file, name, parameters, return_type, body, position, false, lemmas, functions, report) can Global{Read,Write})
                        can Global.Write:
                            proof_float_mode <- false
                            report.context.current_float_mode <- false
                        return true
                    _:
                        return false
            match declaration:
                Ast::Decl.Module(_, module_body, _):
                    return (proof_check_function_path(file, module_body, path, path_start, path_count, path_offset + 1, lemmas, functions, report) can Global{Read,Write})
                Ast::Decl.Scoped(scoped_body, _):
                    return (proof_check_function_path(file, scoped_body, path, path_start, path_count, path_offset + 1, lemmas, functions, report) can Global{Read,Write})
                _:
                    return false

        def proof_check_scheduled_function(file: Ast::File&, declarations: darray[Ast::Decl]&, target: usize, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, function_findings: ProofFunctionFindingSummary&, schedule_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if:
                target >= functions.lookup.names.count
                target >= functions.lookup.declaration_path_starts.count or target >= functions.lookup.declaration_path_counts.count
                target >= functions.lookup.owner_modules.count
            has_contract_type_finding: bool = proof_function_finding_row_contract_type(function_findings, target, &schedule_work)
            return true if has_contract_type_finding
            # Unqualified calls in this body resolve from its own module.
            saved_caller: usize = proof_fact_call_shape_begin_caller(report, functions, target)
            found: bool = (proof_check_function_path(file, declarations, functions.lookup.all_declaration_path, functions.lookup.declaration_path_starts[target], functions.lookup.declaration_path_counts[target], 0, lemmas, functions, report) can Global{Read,Write})
            proof_fact_call_shape_end_caller(report, functions, saved_caller)
            return found

        # On exhaustion, remove the summary arrays altogether. Consumers require complete
        # row alignment, so missing rows fail closed without an unmetered cleanup traversal.
        def proof_lemma_schedule_work_abort(lemmas: mutable ProofLemmaTable&, report: mutable ProofReport&, source_work: usize) -> void:
            lemmas.verification.verified.clear()
            lemmas.verification.verification_reasons.clear()
            lemmas.verification.unqualified_usable.clear()
            proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma dependency scheduling exceeded its validated work bound", "lemma-schedule-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_lemma_schedule_invalid(lemmas: mutable ProofLemmaTable&, report: mutable ProofReport&, message: sview) -> void:
            lemmas.verification.verified.clear()
            lemmas.verification.verification_reasons.clear()
            lemmas.verification.unqualified_usable.clear()
            proof_add_finding(report, "lemma-summary-unverified", 0, "", message)

        def proof_check_scheduled_lemma(file: Ast::File&, target: usize, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, lemma_findings: ProofLemmaFindingSummary&, source_scan_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if:
                target >= lemmas.verification.unqualified_usable.count or not lemmas.verification.unqualified_usable[target]
                target >= lemmas.verification.source_functions.count
            match lemmas.verification.source_functions[target]:
                Ast::Decl.Func(name, parameters, return_type, body, _, _, position):
                    return false if name != lemmas.identity.names[target]
                    if return_type is lemma_return_type:
                        proof_add_finding(report, "lemma-return", position.line, name, "lemmas are proof-only and may not return runtime values")
                    return false if target >= lemma_findings.contract_type.count
                    has_contract_type_finding: bool = lemma_findings.contract_type[target]
                    return true if has_contract_type_finding
                    (proof_check_function_with_goal_owner(file, name, parameters, return_type, body, position, true, lemmas, functions, report) can Global{Read,Write})
                    can Global.Write:
                        proof_float_mode <- false
                        report.context.current_float_mode <- false
                    return true
                _:
                    return false

        def proof_compute_verified_lemmas(file: Ast::File&, declarations: darray[Ast::Decl]&, lemmas: mutable ProofLemmaTable&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> void can[Global.Read, Global.Write]:
            # Clear prior admission before any metered setup that may return early. This also
            # makes repeated checker use fail closed if a later run exhausts its source budget.
            lemmas.verification.unqualified_usable.clear()
            lemmas.verification.verified.clear()
            lemmas.verification.verification_reasons.clear()
            lemmas.verification.source_functions.clear()
            if lemmas.identity.names.count == 0:
                return
            source_scan_work: mutable usize = 0
            if not proof_report_source_work_charge(lemmas.identity.names.count, &source_scan_work):
                lemmas.verification.unqualified_usable.clear()
                lemmas.verification.verified.clear()
                lemmas.verification.verification_reasons.clear()
                lemmas.verification.source_functions.clear()
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma schedule setup exceeded its validated work bound", "lemma-schedule-work", source_scan_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            source_function_counts: mutable darray[usize] = []
            lemmas.verification.source_functions.clear()
            for _ in 0..<lemmas.identity.names.count |lemmas|:
                lemmas.verification.source_functions.push(Ast::Decl.Invalid)
            source_function_counts_complete: mutable bool = proof_report_source_work_charge(lemmas.identity.names.count, &source_scan_work)
            if source_function_counts_complete:
                for _ in 0..<lemmas.identity.names.count |source_function_counts|:
                    source_function_counts.push(0)
                source_function_counts_complete <- proof_lemma_source_function_name_counts(declarations, lemmas, &source_function_counts, &lemmas.verification.source_functions, &source_scan_work, 0)
            identity_lookups_complete: mutable bool = source_function_counts_complete
            lemmas.verification.unqualified_usable.clear()
            for lemma_index in 0..<lemmas.identity.names.count |lemma_index, lemmas, functions, source_function_counts, source_function_counts_complete, identity_lookups_complete, source_scan_work|:
                if not proof_report_source_work_charge(1, &source_scan_work):
                    identity_lookups_complete <- false
                    break
                lemma_name: sview = lemmas.identity.names[lemma_index]
                ordinary_row: mutable usize = functions.lookup.names.count
                repeated_ordinary_name: mutable bool = true
                unique_lemma_row: mutable bool = false
                if identity_lookups_complete:
                    function_identity: (complete: bool, index: usize, repeated: bool) = proof_function_identity_with_work(functions, lemma_name, &source_scan_work)
                    if not function_identity.complete:
                        identity_lookups_complete <- false
                    else:
                        lemma_identity: (complete: bool, index: usize, declared: bool, ambiguous: bool) = proof_lemma_index_with_work(lemmas, lemma_name, &source_scan_work)
                        if not lemma_identity.complete:
                            identity_lookups_complete <- false
                        else:
                            ordinary_row <- function_identity.index
                            repeated_ordinary_name <- function_identity.repeated
                            unique_lemma_row <- lemma_identity.index < lemmas.identity.names.count
                source_function_count: usize = source_function_counts[lemma_index] if lemma_index < source_function_counts.count else 0
                one_source_function: bool = source_function_counts_complete and source_function_count == 1
                lemmas.verification.unqualified_usable.push(identity_lookups_complete and unique_lemma_row and one_source_function and ordinary_row >= functions.lookup.names.count and not repeated_ordinary_name)
            if source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                lemmas.verification.unqualified_usable.clear()
                proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma identity admission exceeded its validated work bound", "lemma-identity-work", source_scan_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if identity_lookups_complete:
                import_bindings: (complete: bool, has_unresolved_import: bool) = proof_lemma_import_bindings_usable(file.enum_annotations, lemmas, &source_scan_work)
                identity_lookups_complete <- false if not import_bindings.complete
                if import_bindings.has_unresolved_import:
                    if not proof_report_source_work_charge(lemmas.verification.unqualified_usable.count, &source_scan_work):
                        identity_lookups_complete <- false
                    else:
                        for lemma_index in 0..<lemmas.verification.unqualified_usable.count |lemma_index, lemmas|:
                            lemmas.verification.unqualified_usable[lemma_index] <- false
            # Extern declarations use a separate index, so resolve their leaves through the
            # same charged helper before allowing any summary to remain usable.
            if identity_lookups_complete:
                for signature in functions.externs.extern_signatures |signature, functions, lemmas, identity_lookups_complete, source_scan_work|:
                    if not proof_report_source_work_charge(1, &source_scan_work):
                        identity_lookups_complete <- false
                        break
                    lookup: (complete: bool, index: usize, declared: bool, ambiguous: bool) = proof_lemma_index_with_work(lemmas, signature.name, &source_scan_work)
                    if not lookup.complete:
                        identity_lookups_complete <- false
                        break
                    elif lookup.index < lemmas.identity.names.count and lookup.index < lemmas.verification.unqualified_usable.count:
                        lemmas.verification.unqualified_usable[lookup.index] <- false
            if not identity_lookups_complete:
                lemmas.verification.unqualified_usable.clear()
                if not proof_report_source_work_charge(lemmas.identity.names.count, &source_scan_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma identity fallback exceeded its validated work bound", "lemma-identity-work", source_scan_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
                for _ in 0..<lemmas.identity.names.count |lemmas|:
                    lemmas.verification.unqualified_usable.push(false)
            lemmas.verification.verified.clear()
            lemmas.verification.verification_reasons.clear()
            if not proof_report_source_work_charge(lemmas.identity.names.count, &source_scan_work) or not proof_report_source_work_charge(lemmas.identity.names.count, &source_scan_work):
                proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                return
            for _ in 0..<lemmas.identity.names.count |lemmas|:
                lemmas.verification.verified.push(false)
                lemmas.verification.verification_reasons.push("pending")
            scheduled: mutable darray[bool] = []
            if not proof_report_source_work_charge(lemmas.identity.names.count, &source_scan_work):
                proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                return
            for _ in 0..<lemmas.identity.names.count |scheduled|:
                scheduled.push(false)
            scheduled_count: mutable usize = 0
            if not identity_lookups_complete:
                reason: sview = "source-identity-work-limit" if source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT else "source-identity-index-incomplete"
                if not proof_report_source_work_charge(lemmas.identity.names.count, &source_scan_work):
                    proof_add_budget_finding(report, "resource-analysis-budget", 0, "", "lemma identity failure reporting exceeded its validated work bound", "lemma-schedule-work", source_scan_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return
                for lemma_index in 0..<lemmas.identity.names.count |lemma_index, lemmas, scheduled, scheduled_count, reason|:
                    lemmas.verification.verification_reasons[lemma_index] <- reason
                    scheduled[lemma_index] <- true
                    scheduled_count <- scheduled_count + 1
                proof_add_finding(report, "lemma-summary-unverified", 0, "", "lemma owner identities could not be established from bounded source indexes")
            else:
                for lemma_index in 0..<lemmas.identity.names.count |lemma_index, lemmas, scheduled, scheduled_count, report, source_scan_work|:
                    if not proof_report_source_work_charge(1, &source_scan_work):
                        proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                        return
                    continue if lemma_index >= lemmas.verification.unqualified_usable.count or lemmas.verification.unqualified_usable[lemma_index]
                    lemmas.verification.verification_reasons[lemma_index] <- "owner-ambiguous"
                    proof_add_finding(report, "lemma-summary-unverified", 0, lemmas.identity.names[lemma_index], "lemma name resolves to multiple function declarations without an owner-aware summary lookup")
                    scheduled[lemma_index] <- true
                    scheduled_count <- scheduled_count + 1
                if source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                    return
            return if scheduled_count == lemmas.identity.names.count
            lemma_finding_build: (complete: bool, summary: ProofLemmaFindingSummary) = proof_lemma_finding_summary_build(report, lemmas, &source_scan_work)
            if not lemma_finding_build.complete:
                proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                return
            lemma_findings: mutable ProofLemmaFindingSummary = lemma_finding_build.summary
            component_schedule: ProofComponentSchedule = proof_build_component_schedule(lemmas.termination.recursive_component_ids, lemmas.termination.call_starts, lemmas.termination.call_counts, lemmas.termination.all_call_targets, lemmas.identity.names.count, &source_scan_work)
            if not component_schedule.valid:
                if source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                else:
                    proof_lemma_schedule_invalid(lemmas, report, "lemma SCC schedule rejected malformed component or call-graph metadata")
                return
            component: mutable darray[usize] = []
            component_order_index: mutable usize = 0
            while component_order_index < component_schedule.order.count and scheduled_count < lemmas.identity.names.count |component_order_index, component_schedule, scheduled_count, scheduled, lemmas, source_scan_work|:
                if not proof_report_source_work_charge(1, &source_scan_work):
                    source_scan_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                    proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                    return
                component_id: usize = component_schedule.order[component_order_index]
                component_order_index <- component_order_index + 1
                component.clear()
                if component_id >= component_schedule.starts.count or component_id >= component_schedule.counts.count:
                    proof_lemma_schedule_invalid(lemmas, report, "lemma SCC schedule component row is invalid")
                    return
                component_start: usize = component_schedule.starts[component_id]
                component_count: usize = component_schedule.counts[component_id]
                if component_start > component_schedule.members.count or component_count > component_schedule.members.count - component_start:
                    proof_lemma_schedule_invalid(lemmas, report, "lemma SCC schedule member range is invalid")
                    return
                for member_offset in 0..<component_count |member_offset, component_start, component_schedule, lemmas, scheduled, component, source_scan_work|:
                    if not proof_report_source_work_charge(1, &source_scan_work):
                        source_scan_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        break
                    lemma_index: usize = component_schedule.members[component_start + member_offset]
                    if lemma_index >= scheduled.count or lemma_index >= lemmas.verification.verified.count or lemma_index >= lemmas.verification.verification_reasons.count:
                        proof_lemma_schedule_invalid(lemmas, report, "lemma SCC schedule member index is invalid")
                        return
                    if not scheduled[lemma_index]:
                        component.push(lemma_index)
                        lemmas.verification.verified[lemma_index] <- true
                        lemmas.verification.verification_reasons[lemma_index] <- "pending"
                if source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                    return
                continue if component.count == 0
                if component.count != component_count:
                    proof_lemma_schedule_invalid(lemmas, report, "lemma dependency admission selected only part of a recursive component")
                    return
                bodies_checked: mutable bool = true
                for member in component |member, component, file, lemmas, functions, report, lemma_findings, bodies_checked, source_scan_work|:
                    if not proof_report_source_work_charge(1, &source_scan_work):
                        bodies_checked <- false
                        break
                    found: bool = (proof_check_scheduled_lemma(file, member, lemmas, functions, report, lemma_findings, &source_scan_work) can Global{Read,Write})
                    lemmas.verification.verification_reasons[member] <- "body-missing" if not found
                    bodies_checked <- false if not found
                if source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                    return
                if not proof_lemma_finding_summary_extend(report, lemmas, &lemma_findings, &source_scan_work):
                    proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                    return
                # A body that was never checked produced no finding, so a clean report alone must
                # not verify it (a lemma whose name is declared twice is never found by index).
                component_ok: mutable bool = bodies_checked
                for member in component |member, component, lemmas, lemma_findings, report, component_ok, source_scan_work|:
                    if not proof_report_source_work_charge(1, &source_scan_work):
                        component_ok <- false
                        break
                    member_clean: bool = member < lemma_findings.clean.count and lemma_findings.clean[member]
                    component_ok <- false if not member_clean or source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                if source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                    return
                for member in component |member, component, lemmas, lemma_findings, component_ok, report, source_scan_work|:
                    if not proof_report_source_work_charge(1, &source_scan_work):
                        component_ok <- false
                        break
                    lemmas.verification.verified[member] <- component_ok
                    lemmas.verification.verification_reasons[member] <- "verified" if component_ok
                    lemmas.verification.verification_reasons[member] <- "recursive-component-unverified" if not component_ok and lemmas.verification.verification_reasons[member] == "pending"
                    lemmas.verification.verification_reasons[member] <- "body-unverified" if not component_ok and not lemmas.termination.recursive[member] and lemmas.verification.verification_reasons[member] != "body-missing"
                    has_unverified_dependency: bool = lemma_findings.lemma_unverified[member] if not component_ok and member < lemma_findings.lemma_unverified.count else false
                    lemmas.verification.verification_reasons[member] <- "dependency-unverified" if not component_ok and has_unverified_dependency
                    scheduled[member] <- true
                    scheduled_count <- scheduled_count + 1
                if source_scan_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    proof_lemma_schedule_work_abort(lemmas, report, source_scan_work)
                    return
