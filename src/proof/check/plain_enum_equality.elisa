# Nominal zero-payload enums have built-in equality unless source overrides it.
# This witness admits Eq only; it never models enum values as arithmetic scalars.
extend ElisaProof:
    private:
        def proof_zero_payload_enum_in(declarations: darray[Ast::Decl]&, name: sview, member: sview, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations:
                match declaration:
                    Ast::Decl.Enum(enum_name, variants, is_const, _, _):
                        if enum_name == name and not is_const:
                            return false if variants.count == 0
                            found: mutable bool = member == ""
                            for variant in variants |found, member|:
                                return false if variant.fields.count != 0
                                found <- true if variant.name == member
                            return found
                    Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                        return true if proof_zero_payload_enum_in(body, name, member, depth + 1)
                    _:
                        pass
            false

        # Only a unique nominal enum with no payload or hierarchy is reference-free.
        def proof_parameter_target_is_reference_free(expression: Ast::Expr, file: Ast::File&) -> bool:
            target: Ast::Expr = proof_type_strip_reference(expression, 0)
            return true if proof_type_is_reference_free(target, file.top_decls, file.enum_annotations, 0)
            name: sview = proof_type_head_name(target, file.top_decls, 0)
            return false if name == "" or proof_enum_in_hierarchy(file.enum_annotations, name)
            counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(file.top_decls, name, 0)
            return false if counts.enums != 1 or counts.const_enums != 0 or counts.structs != 0
            return proof_zero_payload_enum_in(file.top_decls, name, "", 0)

        def proof_zero_payload_enum_type(type_expression: Ast::Expr, member: sview, report: ProofReport&) -> sview:
            name: sview = proof_type_head_name(type_expression, report.source_declarations, 0)
            return "" if name == "" or proof_enum_in_hierarchy(report.source_annotations, name)
            counts: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates(report.source_declarations, name, 0)
            return "" if counts.enums != 1 or counts.const_enums != 0 or counts.structs != 0
            name if proof_zero_payload_enum_in(report.source_declarations, name, member, 0) else ""

        def proof_plain_enum_member_has_builtin_equality(expression: Ast::Expr, protocol: sview, report: ProofReport&) -> bool:
            return false if protocol != "Eq"
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_plain_enum_member_has_builtin_equality(inner, protocol, report)
                Ast::Expr.Field(enum_type, member, _):
                    return proof_plain_enum_builtin_equality_type(enum_type, member, report) != ""
                _:
                    return false

        def proof_plain_enum_builtin_equality_type(type_expression: Ast::Expr, member: sview, report: ProofReport&) -> sview:
            name: sview = proof_zero_payload_enum_type(type_expression, member, report)
            return "" if name == "" or proof_report_builtin_operator_impl_exists(report, name, "Eq")
            aliases: mutable darray[sview] = []
            proof_type_operator_impl_names(type_expression, report, &aliases, 0)
            return "" if any alias in aliases where proof_report_builtin_operator_impl_exists(report, alias, "Eq")
            name

        def proof_add_plain_enum_comparison_result_witness(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&, report: mutable ProofReport&, owner: sview, position: Ast::Pos) -> void:
            return if proof_expr_has_call(expression) or proof_report_builtin_operator_impl_exists(report, "bool", "Eq")
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return if operator != TokenKind.EqEq and operator != TokenKind.BangEq
                    return if not proof_plain_enum_member_has_builtin_equality(left, "Eq", report) and not proof_plain_enum_member_has_builtin_equality(right, "Eq", report)
                    return if not proof_runtime_operator_expression_witnessed(expression, facts, report, functions, 0)
                    # Only the comparison result is Boolean. No enum operand gains a scalar witness.
                    marker: Ast::Expr = proof_scalar_term_marker(expression, position)
                    proof_add_scalar_type_witness(facts, report, marker, position.line, owner)
                _:
                    pass
