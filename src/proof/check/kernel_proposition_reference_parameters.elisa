extend ElisaProof:
    private:
        struct ProofSourceKernelReferenceParameterIndex:
            hashes: mutable darray[u32]
            lines: mutable darray[u32]
            names: mutable darray[sview]
            occupied: mutable darray[bool]

        def proof_source_kernel_reference_parameter_index(annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> (index: ProofSourceKernelReferenceParameterIndex, complete: bool) can[Memory.Allocate]:
            index: mutable ProofSourceKernelReferenceParameterIndex = ProofSourceKernelReferenceParameterIndex{hashes: [], lines: [], names: [], occupied: []}
            count: mutable usize = 0
            for annotation in annotations |count, source_work|:
                return (index, false) if not proof_source_kernel_charge_work(1, source_work)
                continue if annotation.name != "__typestate_ref_param"
                return (index, false) if:
                    annotation.owner == ""
                    not proof_source_kernel_charge_work(sview_len(annotation.owner), source_work)
                count <- count + 1
            return (index, true) if count == 0
            capacity: usize = proof_name_index_capacity(count)
            return (index, false) if capacity == 0 or not proof_source_kernel_charge_work(capacity * 4, source_work)
            index.hashes.resize(capacity)
            index.lines.resize(capacity)
            index.names.resize(capacity)
            index.occupied.resize(capacity)
            for slot in 0..<capacity |slot, index, source_work|:
                return (index, false) if not proof_source_kernel_charge_work(1, source_work)
                index.hashes[slot] <- 0
                index.lines[slot] <- 0
                index.names[slot] <- ""
                index.occupied[slot] <- false
            for annotation in annotations |index, capacity, source_work|:
                return (index, false) if not proof_source_kernel_charge_work(1, source_work)
                continue if annotation.name != "__typestate_ref_param"
                return (index, false) if:
                    annotation.owner == ""
                    not proof_source_kernel_charge_work(sview_len(annotation.owner), source_work)
                hash: u32 = proof_expr_shape_mix(proof_name_hash(annotation.owner), annotation.line.i64())
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, annotation, index, capacity, source_work, placed|:
                    return (index, false) if not proof_source_kernel_charge_work(1, source_work)
                    if not index.occupied[slot]:
                        index.hashes[slot] <- hash
                        index.lines[slot] <- annotation.line
                        index.names[slot] <- annotation.owner
                        index.occupied[slot] <- true
                        placed <- true
                        break
                    if index.hashes[slot] == hash and index.lines[slot] == annotation.line:
                        return (index, false) if not proof_source_kernel_charge_work(sview_len(annotation.owner), source_work)
                        if index.names[slot] == annotation.owner:
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return (index, false) if not placed
            return (index, true)

        def proof_source_kernel_parameter_by_reference(index: ProofSourceKernelReferenceParameterIndex, function_line: u32, parameter_name: sview, source_work: mutable usize&) -> (complete: bool, present: bool):
            capacity: usize = index.hashes.count
            return (false, false) if capacity != index.lines.count or capacity != index.names.count or capacity != index.occupied.count
            return (true, false) if capacity == 0
            return (false, false) if not proof_source_kernel_charge_work(1 + sview_len(parameter_name), source_work)
            wanted_hash: u32 = proof_expr_shape_mix(proof_name_hash(parameter_name), function_line.i64())
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, function_line, parameter_name, index, capacity, source_work|:
                return (false, false) if not proof_source_kernel_charge_work(1, source_work)
                return (true, false) if not index.occupied[slot]
                if index.hashes[slot] == wanted_hash and index.lines[slot] == function_line:
                    return (false, false) if not proof_source_kernel_charge_work(sview_len(index.names[slot]), source_work)
                    return (true, true) if index.names[slot] == parameter_name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false)
