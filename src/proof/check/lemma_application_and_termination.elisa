extend ElisaProof:
    private:
        def proof_lemmas_same_recursive_component(lemmas: ProofLemmaTable&, source: usize, target: usize) -> bool:
            return false if source >= lemmas.identity.names.count or target >= lemmas.identity.names.count
            return true if source == target
            return false if:
                source >= lemmas.termination.recursive.count or target >= lemmas.termination.recursive.count
                not lemmas.termination.recursive[source] or not lemmas.termination.recursive[target]
            if source < lemmas.termination.recursive_component_ids.count and target < lemmas.termination.recursive_component_ids.count:
                return lemmas.termination.recursive_component_ids[source] == lemmas.termination.recursive_component_ids[target]
            return proof_lemma_reaches(lemmas, source, target) and proof_lemma_reaches(lemmas, target, source)

        # Map actual arguments to formal parameters using Elisa's named-argument rules. The
        # compiler stores labels separately from values, so positional substitution is not
        # sufficient: `f(second: y, first: x)` must instantiate the same summary as `f(x, y)`.
        # Missing/defaulted parameters are declined here until summary metadata carries a
        # validated default-value substitution; this is conservative and avoids guessing.
        def proof_parameter_index(parameters: darray[sview]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < parameters.count |index, parameters, name|:
                return index if parameters[index] == name
                index <- index + 1
            return parameters.count

        def proof_map_call_arguments(parameters: darray[sview]&, has_defaults: darray[bool]&, defaults: darray[Ast::Expr]&, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&) -> bool:
            mapped.clear()
            return false if argument_names.count != 0 and argument_names.count != arguments.count
            used: mutable darray[bool] = []
            for parameter in parameters |mapped, used|:
                mapped.push(Ast::Expr.Absent)
                used.push(false)
            saw_named: mutable bool = false
            next_positional: mutable usize = 0
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, parameters, mapped, used, saw_named, next_positional|:
                label: sview = argument_names[argument_index] if argument_names.count == arguments.count else ""
                parameter_index: mutable usize = parameters.count
                if label == "":
                    return false if saw_named
                    while next_positional < parameters.count and used[next_positional] |next_positional, used, parameters|:
                        next_positional <- next_positional + 1
                    return false if next_positional >= parameters.count
                    parameter_index <- next_positional
                    next_positional <- next_positional + 1
                else:
                    saw_named <- true
                    parameter_index <- proof_parameter_index(parameters, label)
                    return false if parameter_index >= parameters.count
                return false if used[parameter_index]
                mapped[parameter_index] <- arguments[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameters.count |parameter_index, used|:
                if not used[parameter_index]:
                    # Defaults are executable expressions. To keep the summary boundary
                    # proof-safe, only pure defaults are materialized here; calls, `old`, and
                    # unresolved later-formal dependencies require a future effect-aware call
                    # evaluator and therefore decline conservatively.
                    return false if parameter_index >= has_defaults.count or parameter_index >= defaults.count or not has_defaults[parameter_index]
                    default_expression: Ast::Expr = defaults[parameter_index]
                    return false if proof_expr_has_call(default_expression) or proof_expr_has_old(default_expression)
                    if parameter_index + 1 < parameters.count:
                        for later_index in parameter_index + 1..<parameters.count |later_index, parameters, default_expression|:
                            return false if proof_expr_mentions_name(default_expression, parameters[later_index])
                    resolved_default: Ast::Expr = proof_substitute(default_expression, parameters, mapped)
                    return false if proof_expr_has_call(resolved_default) or proof_expr_has_old(resolved_default)
                    for formal_name in parameters |formal_name, resolved_default|:
                        return false if proof_expr_mentions_name(resolved_default, formal_name)
                    mapped[parameter_index] <- resolved_default
                    used[parameter_index] <- true
            return true

        # A lemma leaf is usable only when it identifies one function declaration row; the
        # current summary table has no owner path, so ambiguous names fail closed.
        def proof_lemma_unqualified_usable(lemmas: ProofLemmaTable&, name: sview) -> bool:
            index: usize = proof_lemma_index(lemmas, name)
            return false if index >= lemmas.identity.names.count or index >= lemmas.verification.unqualified_usable.count
            lemmas.verification.unqualified_usable[index]

        def proof_apply_lemma(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&, caller_names: darray[sview]&, caller_values: darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    return false if proof_callable_is_scoped(callee)
                    lemma_name: sview = proof_callable_name(callee)
                    lemma_index: usize = proof_lemma_index(lemmas, lemma_name)
                    return false if lemma_name == "" or lemma_index >= lemmas.identity.names.count
                    # A parameter or local callable shadows the global leaf exactly as it does
                    # in source resolution. Never reinterpret that local call as a ghost lemma.
                    for bound_name in caller_names |lemma_name|:
                        return false if bound_name == lemma_name
                    return false if lemma_index >= lemmas.verification.unqualified_usable.count or not lemmas.verification.unqualified_usable[lemma_index]
                    if lemma_index >= lemmas.verification.verified.count or not lemmas.verification.verified[lemma_index]:
                        report.proof_obligation(false)
                        proof_add_finding(report, "lemma-summary-unverified", position.line, name, "lemma body has not established a verified proof summary")
                        return false
                    return false if lemma_index >= lemmas.parameters.param_counts.count or arguments.count > lemmas.parameters.param_counts[lemma_index]
                    parameter_names: mutable darray[sview] = []
                    argument_values: mutable darray[Ast::Expr] = []
                    param_start: usize = lemmas.parameters.param_starts[lemma_index]
                    for argument_index in 0..<lemmas.parameters.param_counts[lemma_index] |parameter_names, arguments, lemmas, param_start|:
                        parameter_names.push(lemmas.parameters.all_params[param_start + argument_index])
                    mapped_arguments: mutable darray[Ast::Expr] = []
                    default_start: usize = lemmas.parameters.param_starts[lemma_index]
                    default_flags: mutable darray[bool] = []
                    default_values: mutable darray[Ast::Expr] = []
                    for parameter_index in 0..<lemmas.parameters.param_counts[lemma_index] |default_flags, default_values, lemmas, default_start|:
                        default_flags.push(lemmas.parameters.all_has_defaults[default_start + parameter_index])
                        default_values.push(lemmas.parameters.all_defaults[default_start + parameter_index])
                    return false if not proof_map_call_arguments(parameter_names, default_flags, default_values, arguments, argument_names, &mapped_arguments)
                    # Actual and defaulted arguments become logical terms when lemma summaries
                    # are substituted. Admit them only through the same state-stability boundary
                    # used by assert-by propositions, before checking requires or adding facts.
                    for argument in mapped_arguments |facts, report, functions, position, name|:
                        argument_stable: bool = (proof_block_assertion_expression_stable(argument, facts, report, functions) can Global.Read)
                        if not argument_stable:
                            report.proof_obligation(false)
                            proof_add_finding(report, "proof-impure", position.line, name, "lemma arguments may use only verified total pure calls and source-witnessed stable expressions")
                            return false
                    argument_values.extend(mapped_arguments)
                    requires_ok: mutable bool = true
                    require_goal_ids: mutable darray[usize] = []
                    requires_start: usize = lemmas.contracts.requires_starts[lemma_index]
                    requires_count: usize = lemmas.contracts.requires_counts[lemma_index]
                    for requires_index in 0..<requires_count |requires_ok, facts, parameter_names, argument_values, lemmas, requires_start|:
                        required: Ast::Expr = proof_substitute(lemmas.contracts.all_requires[requires_start + requires_index], parameter_names, argument_values)
                        require_attempt_start: usize = report.results.goal_attempts.count
                        required_proven: bool = (proof_certify_goal(facts, required, report, position.line, name, annotations) can Global{Read,Write})
                        if report.results.goal_attempts.count <= require_attempt_start:
                            required_proven <- false
                        else:
                            goal_id: usize = report.results.goal_attempts.count - 1
                            report.results.goal_attempts[goal_id].source_call_position <- position
                            require_goal_ids.push(goal_id)
                            if not report.results.goal_attempts[goal_id].producer_proven or not report.results.goal_attempts[goal_id].has_certificate:
                                required_proven <- false
                            else:
                                if report.results.goal_attempts[goal_id].certificate_index >= report.analysis_1.certificates.count:
                                    required_proven <- false
                                else:
                                    report.analysis_1.certificates[report.results.goal_attempts[goal_id].certificate_index].source_call_position <- position
                        report.proof_obligation(required_proven)
                        requires_ok <- false if not required_proven
                        proof_add_latest_goal_finding(report, "lemma-requires-unproven", position.line, name, "lemma precondition is not established at the call") if not required_proven
                    return false if not requires_ok
                    if lemma_index < lemmas.termination.recursive.count and lemmas.termination.recursive[lemma_index]:
                        caller_lemma_index: usize = proof_lemma_index(lemmas, name)
                        same_recursive_component: bool = caller_lemma_index < lemmas.identity.names.count and proof_lemmas_same_recursive_component(lemmas, caller_lemma_index, lemma_index)
                        if same_recursive_component:
                            caller_has_measure: bool = caller_lemma_index < lemmas.termination.decreases_counts.count and caller_lemma_index < lemmas.termination.decreases_starts.count and caller_lemma_index < lemmas.termination.decreases_unbounded.count and lemmas.termination.decreases_counts[caller_lemma_index] > 0 and not lemmas.termination.decreases_unbounded[caller_lemma_index] and proof_decreases_range_valid(lemmas.termination.decreases_starts[caller_lemma_index], lemmas.termination.decreases_counts[caller_lemma_index], lemmas.termination.all_decreases.count)
                            callee_has_measure: bool = lemma_index < lemmas.termination.decreases_counts.count and lemma_index < lemmas.termination.decreases_starts.count and lemma_index < lemmas.termination.decreases_unbounded.count and lemmas.termination.decreases_counts[lemma_index] > 0 and not lemmas.termination.decreases_unbounded[lemma_index] and proof_decreases_range_valid(lemmas.termination.decreases_starts[lemma_index], lemmas.termination.decreases_counts[lemma_index], lemmas.termination.all_decreases.count)
                            same_measure_arity: bool = caller_has_measure and callee_has_measure and lemmas.termination.decreases_counts[caller_lemma_index] == lemmas.termination.decreases_counts[lemma_index]
                            if not same_measure_arity:
                                report.proof_obligation(false)
                                proof_add_finding(report, "lemma-recursive-unsupported", position.line, name, "recursive lemma summaries require matching checked lexicographic termination measures")
                                return false
                            caller_param_names: mutable darray[sview] = []
                            caller_param_values: mutable darray[Ast::Expr] = []
                            caller_param_start: usize = lemmas.parameters.param_starts[caller_lemma_index]
                            caller_param_count: usize = lemmas.parameters.param_counts[caller_lemma_index]
                            for parameter_index in 0..<caller_param_count |caller_param_names, caller_param_values, lemmas, caller_param_start, caller_names, caller_values, position|:
                                parameter_name: sview = lemmas.parameters.all_params[caller_param_start + parameter_index]
                                caller_param_names.push(parameter_name)
                                caller_param_values.push(proof_substitute(Ast::Expr.Ident(parameter_name, position), caller_names, caller_values))
                            current_components: mutable darray[Ast::Expr] = []
                            recursive_components: mutable darray[Ast::Expr] = []
                            caller_measure_start: usize = lemmas.termination.decreases_starts[caller_lemma_index]
                            callee_measure_start: usize = lemmas.termination.decreases_starts[lemma_index]
                            for component_index in 0..<lemmas.termination.decreases_counts[caller_lemma_index] |component_index, current_components, lemmas, caller_measure_start, caller_param_names, caller_param_values|:
                                current_components.push(proof_substitute(lemmas.termination.all_decreases[caller_measure_start + component_index], caller_param_names, caller_param_values))
                            for component_index in 0..<lemmas.termination.decreases_counts[lemma_index] |component_index, recursive_components, lemmas, callee_measure_start, parameter_names, argument_values|:
                                recursive_components.push(proof_substitute(lemmas.termination.all_decreases[callee_measure_start + component_index], parameter_names, argument_values))
                            current_nonnegative_proven: mutable bool = true
                            recursive_nonnegative_proven: mutable bool = true
                            for component in current_components |facts, annotations, report, name, position, current_nonnegative_proven|:
                                current_nonnegative: Ast::Expr = Ast::Expr.Binary(component, TokenKind.GtEq, Ast::Expr.IntLit(0, position), position)
                                component_expressions: mutable darray[Ast::Expr] = []
                                component_expressions.push(component)
                                relevant_facts: darray[Ast::Expr] = proof_relevant_facts_for_expressions(facts, component_expressions)
                                component_proven: bool = (proof_certify_goal(relevant_facts, current_nonnegative, report, position.line, name, annotations) can Global{Read,Write})
                                report.proof_obligation(component_proven)
                                current_nonnegative_proven <- false if not component_proven
                                proof_add_latest_goal_finding(report, "lemma-recursive-decreases-unproven", position.line, name, "recursive lemma decreases component is not proven nonnegative") if not component_proven
                            for component in recursive_components |facts, annotations, report, name, position, recursive_nonnegative_proven|:
                                recursive_nonnegative: Ast::Expr = Ast::Expr.Binary(component, TokenKind.GtEq, Ast::Expr.IntLit(0, position), position)
                                component_expressions: mutable darray[Ast::Expr] = []
                                component_expressions.push(component)
                                relevant_facts: darray[Ast::Expr] = proof_relevant_facts_for_expressions(facts, component_expressions)
                                component_proven: bool = (proof_certify_goal(relevant_facts, recursive_nonnegative, report, position.line, name, annotations) can Global{Read,Write})
                                report.proof_obligation(component_proven)
                                recursive_nonnegative_proven <- false if not component_proven
                                proof_add_latest_goal_finding(report, "lemma-recursive-decreases-unproven", position.line, name, "recursive lemma callee measure is not proven nonnegative") if not component_proven
                            smaller_proven: bool = (proof_lexicographic_smaller(current_components, recursive_components, facts, annotations, position, report, name) can Global{Read,Write})
                            report.proof_obligation(smaller_proven)
                            proof_add_latest_goal_finding(report, "lemma-recursive-decreases-unproven", position.line, name, "recursive lemma lexicographic measure is not proven to strictly decrease") if not smaller_proven
                            return false if not current_nonnegative_proven or not recursive_nonnegative_proven or not smaller_proven
                    ensures_start: usize = lemmas.contracts.ensure_starts[lemma_index]
                    ensures_count: usize = lemmas.contracts.ensure_counts[lemma_index]
                    for ensure_index in 0..<ensures_count |facts, parameter_names, argument_values, lemmas, ensures_start, report, name, position|:
                        ensure_expression: Ast::Expr = lemmas.contracts.all_ensures[ensures_start + ensure_index]
                        # A statement-form lemma call has no result slot to substitute. Do not
                        # let a bare `result` from a returning lemma become a caller fact.
                        if proof_expr_mentions_name(ensure_expression, "result"):
                            report.proof_obligation(false)
                            proof_add_finding(report, "lemma-result-unbound", position.line, name, "returning lemma ensure cannot be used without a result binding")
                            return false
                        proof_add_lemma_summary_fact(facts, report, functions, proof_substitute(ensure_expression, parameter_names, argument_values), position.line, name, lemma_name, parameter_names, argument_values, require_goal_ids, ensure_index, position)
                    return true
                _:
                    return false

        # Resolve a declaration by name and declaration line, for rows whose bare name repeats.
        def proof_function_index_at_line(functions: ProofFunctionTable&, name: sview, line: u32) -> usize:
            return functions.lookup.names.count if functions.lookup.module_resolution_work_exhausted
            resolved: (complete: bool, row: usize) = proof_function_index_at_line_with_work(functions, name, line, &functions.lookup.module_resolution_work_used)
            if not resolved.complete:
                functions.lookup.module_resolution_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                functions.lookup.module_resolution_work_exhausted <- true
                return functions.lookup.names.count
            return resolved.row

        def proof_function_index(functions: ProofFunctionTable&, name: sview) -> usize:
            if functions.lookup.index_values.count > 0 and functions.lookup.index_values.count == functions.lookup.index_hashes.count and functions.lookup.index_values.count == functions.lookup.index_ambiguous.count:
                wanted_hash: u32 = proof_name_hash(name)
                capacity: usize = functions.lookup.index_values.count
                slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, functions, capacity|:
                    current: usize = functions.lookup.index_values[slot]
                    return functions.lookup.names.count if:
                        current == functions.lookup.names.count
                        current >= functions.lookup.names.count
                    if functions.lookup.index_hashes[slot] == wanted_hash and functions.lookup.names[current] == name:
                        return functions.lookup.names.count if functions.lookup.index_ambiguous[slot]
                        return current
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return functions.lookup.names.count
            index: mutable usize = 0
            found: mutable usize = functions.lookup.names.count
            wanted_hash: u32 = proof_name_hash(name)
            while index < functions.lookup.names.count |index, functions, name|:
                if index >= functions.lookup.name_hashes.count or functions.lookup.name_hashes[index] == wanted_hash:
                    if functions.lookup.names[index] == name:
                        return functions.lookup.names.count if found < functions.lookup.names.count
                        found <- index
                index <- index + 1
            return found

        def proof_structural_check_expression(expression: Ast::Expr, own_name: sview, subject_position: usize, parameters: darray[Ast::ParamDecl]&, destructurable: darray[sview]&, smaller: darray[ProofStructuralSmaller]&, report: mutable ProofReport&, name: sview, source_work: mutable usize&) -> void:
            if not proof_report_source_work_charge(1, source_work) or not proof_structural_environment_work_charge(parameters, destructurable, smaller, source_work, false):
                proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural expression source work exceeded its validated bound")
                return
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    called_name: sview = proof_callable_name(callee)
                    if proof_callable_is_scoped(callee):
                        proof_structural_termination_finding(report, position.line, name, "scoped calls are not structurally certified without source-resolved callee identity")
                    own_lookup: (complete: bool, found: bool, row: usize) = proof_structural_name_lookup(report, own_name)
                    called_lookup: (complete: bool, found: bool, row: usize) = proof_structural_name_lookup(report, called_name)
                    own_index: usize = own_lookup.row if own_lookup.complete and own_lookup.found else report.analysis_1.structural.names.count
                    called_index: usize = called_lookup.row if called_lookup.complete and called_lookup.found else report.analysis_1.structural.names.count
                    direct_recursive: bool = called_name == own_name
                    lookup_failed: bool = not own_lookup.complete or not own_lookup.found or not called_lookup.complete or direct_recursive and not called_lookup.found
                    proof_structural_termination_finding(report, position.line, name, "source callable name lookup exceeded its validated bound") if lookup_failed
                    direct_recursive <- false if lookup_failed
                    mutual_recursive: bool = not direct_recursive and own_index < report.analysis_1.structural.names.count and called_index < report.analysis_1.structural.names.count and proof_structural_report_same_component(report, own_index, called_index) and own_index < report.analysis_1.structural.subject_types.count and called_index < report.analysis_1.structural.subject_types.count and report.analysis_1.structural.subject_types[own_index] != "" and report.analysis_1.structural.subject_types[own_index] == report.analysis_1.structural.subject_types[called_index]
                    if direct_recursive or mutual_recursive:
                        # The caller's formal list cannot interpret named arguments for a
                        # different callee: its decreasing parameter position indexes the
                        # callee's signature. Until callee formal names are available here,
                        # reject named mutual edges rather than proving descent on the wrong
                        # actual argument.
                        named_argument_scan: (complete: bool, has_named: bool) = proof_structural_call_has_named_argument(argument_names, source_work) if mutual_recursive else (true, false)
                        if not named_argument_scan.complete:
                            proof_structural_termination_finding(report, position.line, name, "recursive call argument-label scan exceeded its validated bound")
                            return
                        if mutual_recursive and named_argument_scan.has_named:
                            proof_structural_termination_finding(report, position.line, name, "named arguments on mutual structural calls are not supported")
                        elif subject_position >= parameters.count and direct_recursive:
                            # When the ranking was inferred from an unannotated function with
                            # multiple enum parameters, use the sum of their constructor heights.
                            # Every subject must be passed unchanged or as a known strict subterm,
                            # and at least one subject must be strict. This is the only place where
                            # a multi-parameter product ranking is admitted; explicit `decreases`
                            # clauses retain their exact single-subject meaning.
                            enum_subject_scan: (complete: bool, names: darray[sview]) = proof_enum_parameter_names_from_parameters(parameters, destructurable, source_work)
                            if not enum_subject_scan.complete:
                                proof_structural_termination_finding(report, position.line, name, "recursive subject enumeration exceeded its validated bound")
                                return
                            enum_subjects: darray[sview] = enum_subject_scan.names
                            multi_valid: mutable bool = enum_subjects.count > 0
                            multi_strict: mutable bool = false
                            witnesses: mutable darray[ProofStructuralWitness] = []
                            for subject in enum_subjects |subject, arguments, argument_names, parameters, smaller, multi_valid, multi_strict, witnesses, source_work, report, name, position|:
                                resolved_subject_index: (complete: bool, position: usize) = proof_parameter_position(parameters, subject, source_work)
                                if not resolved_subject_index.complete:
                                    proof_structural_termination_finding(report, position.line, name, "recursive subject lookup exceeded its validated bound")
                                    return
                                subject_index: usize = resolved_subject_index.position
                                mapped_argument: (complete: bool, argument: Ast::Expr) = proof_structural_call_argument(arguments, argument_names, parameters, subject_index, source_work)
                                if not mapped_argument.complete:
                                    proof_structural_termination_finding(report, position.line, name, "recursive call argument mapping exceeded its validated bound")
                                    return
                                recursive_argument: Ast::Expr = mapped_argument.argument
                                recursive_name: sview = proof_ident_name(recursive_argument)
                                argument_metadata: (complete: bool, root: sview, found: bool, subject: sview, identity: usize, subject_identity: usize) = proof_structural_argument_metadata(recursive_argument, smaller, subject, source_work)
                                if not argument_metadata.complete:
                                    proof_structural_termination_finding(report, position.line, name, "recursive argument subterm lookup exceeded its validated bound")
                                    return
                                if argument_metadata.found:
                                    multi_strict <- true
                                    witnesses.push(ProofStructuralWitness{subject: subject, argument: argument_metadata.root, strict: true, subject_identity: argument_metadata.subject_identity, argument_identity: argument_metadata.identity}) if argument_metadata.root != ""
                                elif recursive_name != subject:
                                    multi_valid <- false
                                else:
                                    parameter_identity: (complete: bool, identity: usize) = proof_structural_parameter_identity_with_work(parameters, subject, source_work)
                                    if not parameter_identity.complete:
                                        proof_structural_termination_finding(report, position.line, name, "recursive subject identity lookup exceeded its validated bound")
                                        return
                                    subject_identity: usize = parameter_identity.identity
                                    witnesses.push(ProofStructuralWitness{subject: subject, argument: subject, strict: false, subject_identity: subject_identity, argument_identity: subject_identity})
                            if multi_valid and multi_strict:
                                proof_add_structural_edge_attempt(report, own_name, called_name, witnesses, position.line, position.offset.usize())
                            else:
                                proof_structural_termination_finding(report, position.line, name, "recursive call must preserve or strictly descend every inferred enum subject")
                        else:
                            recursive_position: mutable usize = subject_position
                            recursive_position <- report.analysis_1.structural.subject_positions[called_index] if mutual_recursive and called_index < report.analysis_1.structural.subject_positions.count
                            mapped_argument: (complete: bool, argument: Ast::Expr) = proof_structural_call_argument(arguments, argument_names, parameters, recursive_position, source_work)
                            if not mapped_argument.complete:
                                proof_structural_termination_finding(report, position.line, name, "recursive call argument mapping exceeded its validated bound")
                                return
                            recursive_argument: Ast::Expr = mapped_argument.argument
                            recursive_name: sview = proof_ident_name(recursive_argument)
                            argument_metadata: (complete: bool, root: sview, found: bool, subject: sview, identity: usize, subject_identity: usize) = proof_structural_argument_metadata(recursive_argument, smaller, "", source_work)
                            if not argument_metadata.complete:
                                proof_structural_termination_finding(report, position.line, name, "recursive argument subterm lookup exceeded its validated bound")
                                return
                            if argument_metadata.found:
                                argument_root: sview = argument_metadata.root
                                witness_subject: mutable sview = argument_metadata.subject
                                witness_subject <- parameters[recursive_position].name if witness_subject == "" and recursive_position < parameters.count
                                witnesses: darray[ProofStructuralWitness] = [ProofStructuralWitness{subject: witness_subject, argument: argument_root, strict: true, subject_identity: argument_metadata.subject_identity, argument_identity: argument_metadata.identity}]
                                proof_add_structural_edge_attempt(report, own_name, called_name, witnesses, position.line, position.offset.usize())
                            else:
                                proof_structural_termination_finding(report, position.line, name, "recursive call does not pass a binder from a matched strict subterm")
                    match callee:
                        Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                            pass
                        _:
                            proof_structural_check_expression(callee, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    for argument in arguments |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, position.line, name, "structural call argument work exceeded its validated bound")
                            return
                        proof_structural_check_expression(argument, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Ident(value_name, position):
                    proof_structural_termination_finding(report, position.line, name, "a source callable value may escape structural call-graph checking") if proof_structural_name_shadows_function(report, value_name)
                Ast::Expr.Paren(inner, _):
                    proof_structural_check_expression(inner, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Unary(_, operand, _):
                    proof_structural_check_expression(operand, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Binary(left, _, right, _):
                    proof_structural_check_expression(left, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_check_expression(right, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Field(object, _, _):
                    proof_structural_check_expression(object, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Scope(base, scoped_name, position):
                    proof_structural_termination_finding(report, position.line, name, "a scoped callable value may escape structural call-graph checking") if proof_structural_name_shadows_function(report, scoped_name)
                    proof_structural_check_expression(base, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Index(object, index, _):
                    proof_structural_check_expression(object, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_check_expression(index, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Slice(object, low, high, _):
                    proof_structural_check_expression(object, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_check_expression(low, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_check_expression(high, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_structural_check_expression(object, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    for argument in arguments |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural index argument work exceeded its validated bound")
                            return
                        proof_structural_check_expression(argument, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Move(operand, _):
                    proof_structural_check_expression(operand, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_structural_check_expression(operand, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Array(elements, _):
                    for element in elements |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural collection work exceeded its validated bound")
                            return
                        proof_structural_check_expression(element, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural collection work exceeded its validated bound")
                            return
                        proof_structural_check_expression(element, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural collection work exceeded its validated bound")
                            return
                        proof_structural_check_expression(element, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural dictionary work exceeded its validated bound")
                            return
                        proof_structural_check_expression(entry.key, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                        proof_structural_check_expression(entry.value, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural constructor field work exceeded its validated bound")
                            return
                        proof_structural_check_expression(field.value, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_structural_check_expression(base, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    for field in fields |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural record update work exceeded its validated bound")
                            return
                        proof_structural_check_expression(field.value, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    proof_structural_check_expression(condition, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_check_expression(then_expr, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_check_expression(else_expr, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Comprehension(variable, iterable, condition, body, _):
                    proof_structural_check_expression(iterable, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "a comprehension binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, variable)
                    comprehension_blocked: darray[sview] = [variable]
                    comprehension_destructurable: darray[sview] = proof_structural_without(destructurable, comprehension_blocked, source_work)
                    comprehension_smaller: darray[ProofStructuralSmaller] = proof_structural_smaller_without(smaller, comprehension_blocked, source_work)
                    if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural comprehension shadow-filter work exceeded its validated bound")
                        return
                    proof_structural_check_expression(condition, own_name, subject_position, parameters, comprehension_destructurable, comprehension_smaller, report, name, source_work)
                    proof_structural_check_expression(body, own_name, subject_position, parameters, comprehension_destructurable, comprehension_smaller, report, name, source_work)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_structural_check_expression(base, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_check_expression(predicate, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.Match(scrutinee, arms, _):
                    proof_structural_check_expression(scrutinee, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    for arm in arms |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural match arm work exceeded its validated bound")
                            return
                        arm_bindings: mutable darray[sview] = []
                        arm_pattern_complete: bool = proof_structural_pattern_bindings_with_source_work(arm.pattern, &arm_bindings, source_work)
                        if not arm_pattern_complete:
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "match pattern binding analysis exceeded its validated bound")
                            return
                        for arm_binding in arm_bindings |arm_binding, report, name, expression|:
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "a match binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, arm_binding)
                        arm_destructurable: mutable darray[sview] = proof_structural_without(destructurable, arm_bindings, source_work)
                        arm_smaller: mutable darray[ProofStructuralSmaller] = proof_structural_smaller_without(smaller, arm_bindings, source_work)
                        if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural match shadow-filter work exceeded its validated bound")
                            return
                        scrutinee_name: sview = proof_ident_name(scrutinee)
                        if proof_structural_name_in(destructurable, scrutinee_name):
                            arm_destructurable_complete: bool = proof_structural_pattern_bindings_with_source_work(arm.pattern, &arm_destructurable, source_work)
                            binding_identity: (complete: bool, identity: usize) = proof_structural_binding_identity_with_work(scrutinee, smaller, parameters, source_work)
                            if not binding_identity.complete:
                                proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "match subject identity lookup exceeded its validated bound")
                                return
                            arm_subterms_complete: bool = proof_structural_pattern_subterms_with_source_work(arm.pattern, scrutinee_name, binding_identity.identity, &arm_smaller, report, source_work)
                            if not arm_destructurable_complete or not arm_subterms_complete:
                                proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "match pattern subterm analysis exceeded its validated bound")
                                return
                        proof_structural_check_expression(arm.guard, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name, source_work)
                        proof_structural_check_body(arm.body, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name, source_work)
                Ast::Expr.Catch(guarded, arms, _):
                    proof_structural_check_expression(guarded, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    for arm in arms |own_name, subject_position, parameters, destructurable, smaller, report, name, source_work|:
                        if not proof_report_source_work_charge(1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "structural catch arm work exceeded its validated bound")
                            return
                        arm_bindings: mutable darray[sview] = []
                        arm_pattern_complete: bool = proof_structural_pattern_bindings_with_source_work(arm.pattern, &arm_bindings, source_work)
                        if not arm_pattern_complete:
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "catch pattern binding analysis exceeded its validated bound")
                            return
                        for arm_binding in arm_bindings |arm_binding, report, name, expression|:
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "a catch binding shadows a source callable used by structural recursion") if proof_structural_name_shadows_function(report, arm_binding)
                        proof_structural_check_expression(arm.guard, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                        proof_structural_check_body(arm.body, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_structural_check_expression(guarded, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    proof_structural_check_body(recovery, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                Ast::Expr.ShorthandMember(_, _):
                    # A leading-dot const-enum member is a closed value atom and cannot hide a
                    # recursive call or structural projection.
                    pass
                Ast::Expr.Block(statements, value, captures, _):
                    block_destructurable: darray[sview] = proof_copy_names(destructurable)
                    block_smaller: darray[ProofStructuralSmaller] = proof_copy_structural_smaller(smaller)
                    proof_structural_check_body(statements, own_name, subject_position, parameters, &block_destructurable, &block_smaller, report, name, source_work)
                    proof_structural_check_expression(value, own_name, subject_position, parameters, block_destructurable, block_smaller, report, name, source_work)
                    if captures.count > 0:
                        # The cost walk below reserves the separate `proof_expr_has_call` scan.
                        # Nested captured blocks repeat this whole-subtree predicate, so account
                        # for both passes at every block instead of charging only one.
                        if not proof_replay_summary_expr_repeat_charge_with_work(expression, 1, source_work):
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "captured value block source work exceeded its validated bound")
                            return
                        if proof_expr_has_call(expression):
                            capture_overlap: (complete: bool, overlaps: bool) = proof_structural_captures_overlap(captures, block_smaller, source_work)
                            if not capture_overlap.complete:
                                proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "captured value block overlap analysis exceeded its validated bound")
                                return
                            proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "captured value block is not structurally certified") if capture_overlap.overlaps
                Ast::Expr.Lambda(_, _, position):
                    proof_structural_termination_finding(report, position.line, name, "recursive calls inside a closure are not structurally certified")
                Ast::Expr.StaticEffectCall(_, _, _, _, _, position):
                    # A singleton candidate has an exact backend-equivalent callee and
                    # capture-plus-argument list. Reuse ordinary call analysis for it; an
                    # unresolved candidate set remains fail-closed because its target and
                    # structural parameter positions are not uniquely known here.
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    if lowered.known:
                        proof_structural_check_expression(lowered.call, own_name, subject_position, parameters, destructurable, smaller, report, name, source_work)
                    else:
                        proof_structural_termination_finding(report, position.line, name, "unsupported expression may hide a structural recursive call")
                _:
                    proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "unsupported expression may hide a structural recursive call") if proof_expr_has_call(expression)
