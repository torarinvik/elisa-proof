extend ElisaProof:
    private:
        # Pattern bindings feed the structural recursion check. An incomplete walk cannot
        # establish shadowing or a decrease, so the caller must treat it as unsupported.
        def proof_structural_pattern_bindings(pattern: Ast::Pattern, bindings: mutable darray[sview]&) -> bool:
            source_work: mutable usize = 0
            return proof_structural_pattern_bindings_with_source_work(pattern, bindings, &source_work)

        def proof_structural_pattern_bindings_with_source_work(pattern: Ast::Pattern, bindings: mutable darray[sview]&, source_work: mutable usize&) -> bool:
            return proof_structural_pattern_bindings_with_source_limit(pattern, bindings, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_structural_pattern_bindings_with_source_limit(pattern: Ast::Pattern, bindings: mutable darray[sview]&, source_work: mutable usize&, source_limit: usize) -> bool:
            mark: usize = bindings.count
            work: mutable usize = 0
            complete: bool = proof_structural_pattern_bindings_with_budget(pattern, bindings, 0, &work, source_work, source_limit)
            if not complete:
                bindings <- bindings.truncate(mark)
            return complete

        def proof_structural_pattern_bindings_with_budget(pattern: Ast::Pattern, bindings: mutable darray[sview]&, depth: usize, work: mutable usize&, source_work: mutable usize&, source_limit: usize) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            if source_work >= source_limit or not proof_structural_pattern_source_work_charge(1, source_work, source_limit):
                source_work <- source_limit + 1
                return false
            work <- work + 1
            match pattern:
                Ast::Pattern.Binding(name):
                    bindings.push(name) if name != ""
                Ast::Pattern.As(name, inner):
                    bindings.push(name) if name != ""
                    for subpattern in inner |bindings, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_bindings_with_budget(subpattern, bindings, depth + 1, work, source_work, source_limit)
                Ast::Pattern.TypeBind(_, binder):
                    bindings.push(binder) if binder != ""
                Ast::Pattern.Variant(_, fields):
                    for subpattern in fields |bindings, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_bindings_with_budget(subpattern, bindings, depth + 1, work, source_work, source_limit)
                Ast::Pattern.Struct(_, fields):
                    for subpattern in fields |bindings, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_bindings_with_budget(subpattern, bindings, depth + 1, work, source_work, source_limit)
                Ast::Pattern.Field(_, inner):
                    for subpattern in inner |bindings, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_bindings_with_budget(subpattern, bindings, depth + 1, work, source_work, source_limit)
                Ast::Pattern.Tuple(elements):
                    for subpattern in elements |bindings, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_bindings_with_budget(subpattern, bindings, depth + 1, work, source_work, source_limit)
                Ast::Pattern.Rest(name):
                    bindings.push(name) if name != ""
                Ast::Pattern.Or(options):
                    for option in options |bindings, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_bindings_with_budget(option, bindings, depth + 1, work, source_work, source_limit)
                _:
                    pass
            return true

        # Only payload and field binders are strict subterms. Or-patterns remain opaque because
        # an alternative may not bind the same names as the others.
        def proof_structural_pattern_subterms(pattern: Ast::Pattern, subject: sview, subject_identity: usize, subterms: mutable darray[ProofStructuralSmaller]&, report: mutable ProofReport&) -> bool:
            source_work: mutable usize = 0
            return proof_structural_pattern_subterms_with_source_work(pattern, subject, subject_identity, subterms, report, &source_work)

        def proof_structural_pattern_subterms_with_source_work(pattern: Ast::Pattern, subject: sview, subject_identity: usize, subterms: mutable darray[ProofStructuralSmaller]&, report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            return proof_structural_pattern_subterms_with_source_limit(pattern, subject, subject_identity, subterms, report, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_structural_pattern_subterms_with_source_limit(pattern: Ast::Pattern, subject: sview, subject_identity: usize, subterms: mutable darray[ProofStructuralSmaller]&, report: mutable ProofReport&, source_work: mutable usize&, source_limit: usize) -> bool:
            mark: usize = subterms.count
            work: mutable usize = 0
            complete: bool = proof_structural_pattern_subterms_with_budget(pattern, subject, subject_identity, subterms, report, 0, false, &work, source_work, source_limit)
            if not complete:
                subterms <- subterms.truncate(mark)
            return complete

        def proof_structural_pattern_subterms_with_budget(pattern: Ast::Pattern, subject: sview, subject_identity: usize, subterms: mutable darray[ProofStructuralSmaller]&, report: mutable ProofReport&, depth: usize, strict_context: bool, work: mutable usize&, source_work: mutable usize&, source_limit: usize) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            if source_work >= source_limit or not proof_structural_pattern_source_work_charge(1, source_work, source_limit):
                source_work <- source_limit + 1
                return false
            work <- work + 1
            match pattern:
                Ast::Pattern.Variant(_, fields):
                    for subpattern in fields |subterms, report, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_subterms_with_budget(subpattern, subject, subject_identity, subterms, report, depth + 1, true, work, source_work, source_limit)
                Ast::Pattern.Struct(_, fields):
                    for subpattern in fields |subterms, report, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_subterms_with_budget(subpattern, subject, subject_identity, subterms, report, depth + 1, true, work, source_work, source_limit)
                Ast::Pattern.Field(_, inner):
                    for subpattern in inner |subterms, report, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_subterms_with_budget(subpattern, subject, subject_identity, subterms, report, depth + 1, true, work, source_work, source_limit)
                Ast::Pattern.Tuple(elements):
                    for subpattern in elements |subterms, report, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_subterms_with_budget(subpattern, subject, subject_identity, subterms, report, depth + 1, true, work, source_work, source_limit)
                Ast::Pattern.Binding(name):
                    subterms.push(ProofStructuralSmaller{name: name, subject: subject, identity: proof_structural_fresh_identity(report), subject_identity: subject_identity}) if strict_context and name != ""
                Ast::Pattern.TypeBind(_, binder):
                    subterms.push(ProofStructuralSmaller{name: binder, subject: subject, identity: proof_structural_fresh_identity(report), subject_identity: subject_identity}) if strict_context and binder != ""
                Ast::Pattern.As(name, inner):
                    subterms.push(ProofStructuralSmaller{name: name, subject: subject, identity: proof_structural_fresh_identity(report), subject_identity: subject_identity}) if strict_context and name != ""
                    for subpattern in inner |subterms, report, depth, work, source_work, source_limit|:
                        return false if not proof_structural_pattern_subterms_with_budget(subpattern, subject, subject_identity, subterms, report, depth + 1, strict_context, work, source_work, source_limit)
                _:
                    pass
            return true

        def proof_structural_pattern_source_work_charge(amount: usize, source_work: mutable usize&, source_limit: usize) -> bool:
            return false if source_work >= source_limit or amount > source_limit - source_work
            source_work <- source_work + amount
            true
