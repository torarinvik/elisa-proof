# Annotation comparison kept separate so source-gate and compiler backends can lower its
# field reads independently from the rest of the goal-cache implementation.
extend ElisaProof:
    private:
        def proof_goal_cache_annotation_same(left: Ast::EnumAnnotation, right: Ast::EnumAnnotation) -> bool:
            left_line: u32 = left.line
            right_line: u32 = right.line
            return false if left_line != right_line
            left_offset: u32 = left.offset
            right_offset: u32 = right.offset
            return false if left_offset != right_offset
            left_detail_line: u32 = left.detail_line
            right_detail_line: u32 = right.detail_line
            return false if left_detail_line != right_detail_line
            left_identity: u32 = left.identity_id
            right_identity: u32 = right.identity_id
            return false if left_identity != right_identity
            left_arg_start: u32 = left.arg_start
            right_arg_start: u32 = right.arg_start
            return false if left_arg_start != right_arg_start
            left_arg_count: u32 = left.arg_count
            right_arg_count: u32 = right.arg_count
            return false if left_arg_count != right_arg_count
            left_pos: Ast::Pos = left.pos
            right_pos: Ast::Pos = right.pos
            return false if not proof_goal_cache_pos_same(left_pos, right_pos)
            left_owner: sview = left.owner
            right_owner: sview = right.owner
            return false if left_owner != right_owner
            left_name: sview = left.name
            right_name: sview = right.name
            return false if left_name != right_name
            left_module: sview = left.module
            right_module: sview = right.module
            return false if left_module != right_module
            left_detail_name: sview = left.detail_name
            right_detail_name: sview = right.detail_name
            return left_detail_name == right_detail_name

        def proof_goal_cache_annotation_text_byte_add(text: sview, bytes: mutable usize&) -> bool:
            text_bytes: usize = sview_len(text)
            return false if text_bytes > PROOF_GOAL_CACHE_ANNOTATION_WORK_LIMIT - bytes
            bytes <- bytes + text_bytes
            true

        # Bound the preflight walk as well as the exact compare. The four text fields account
        # for the variable-length work in annotation equality; scalar fields cost one per row.
        def proof_goal_cache_annotation_text_bytes(annotations: darray[Ast::EnumAnnotation]&, bytes: mutable usize&) -> bool:
            for annotation in annotations |annotation, bytes|:
                owner: sview = annotation.owner
                name: sview = annotation.name
                module: sview = annotation.module
                detail_name: sview = annotation.detail_name
                return false if not proof_goal_cache_annotation_text_byte_add(owner, bytes)
                return false if not proof_goal_cache_annotation_text_byte_add(name, bytes)
                return false if not proof_goal_cache_annotation_text_byte_add(module, bytes)
                return false if not proof_goal_cache_annotation_text_byte_add(detail_name, bytes)
            true
