extend ElisaProof:
    private:
        def proof_count_const_enums_with_work(declarations: darray[Ast::Decl]&, name: sview, depth: usize, source_work: mutable usize&) -> usize:
            return 2 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |name, depth, count, source_work|:
                return 2 if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Enum(enum_name, _, is_const, _, _):
                        if is_const:
                            return 2 if:
                                not proof_type_audit_work_charge(sview_len(name), source_work)
                                not proof_type_audit_work_charge(sview_len(enum_name), source_work)
                            count <- count + 1 if enum_name == name
                    Ast::Decl.Module(_, body, _):
                        nested: usize = proof_count_const_enums_with_work(body, name, depth + 1, source_work)
                        return 2 if nested > 1
                        count <- count + nested
                    Ast::Decl.Scoped(body, _):
                        nested: usize = proof_count_const_enums_with_work(body, name, depth + 1, source_work)
                        return 2 if nested > 1
                        count <- count + nested
                    Ast::Decl.Invalid:
                        return 2
                    _:
                        pass
                return 2 if count > 1
            return count

        # Alias lookups below are still leaf-name based. Until they carry the declaration
        # scope, refuse to follow an alias whose spelling also names an enum or struct anywhere
        # in the source tree; otherwise an unrelated sibling declaration can change its type.
        def proof_unscoped_alias_aggregate_collision_with_work(declarations: darray[Ast::Decl]&, name: sview, source_work: mutable usize&) -> bool:
            aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(declarations, name, 0, source_work)
            return true if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return aggregates.enums != 0 or aggregates.const_enums != 0 or aggregates.structs != 0

        def proof_builtin_type_name_shadowed_with_work(declarations: darray[Ast::Decl]&, name: sview, source_work: mutable usize&) -> bool:
            alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_with_work(declarations, name, 0, source_work)
            return true if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or alias.count != 0
            aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(declarations, name, 0, source_work)
            return true if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return aggregates.enums != 0 or aggregates.const_enums != 0 or aggregates.structs != 0

        def proof_type_head_name_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize, source_work: mutable usize&) -> sview:
            return "" if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return "" if:
                        not proof_type_audit_work_charge(sview_len(name), source_work)
                        proof_scalar_primitive_type_name(name)
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_with_work(declarations, name, 0, source_work)
                    return "" if:
                        alias.count > 1
                        alias.count == 1 and proof_unscoped_alias_aggregate_collision_with_work(declarations, name, source_work)
                    return proof_type_head_name_with_work(alias.target, declarations, depth + 1, source_work) if alias.count == 1
                    aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_named_aggregates_with_work(declarations, name, 0, source_work)
                    return "" if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    root_aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_count_root_named_aggregates_with_work(declarations, name, 0, source_work)
                    return "" if:
                        source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        aggregates.enums + aggregates.const_enums + aggregates.structs != root_aggregates.enums + root_aggregates.const_enums + root_aggregates.structs
                        root_aggregates.enums + root_aggregates.const_enums + root_aggregates.structs > 1
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_type_head_name_with_work(inner, declarations, depth + 1, source_work)
                Ast::Expr.Refinement(base, _, _):
                    return proof_type_head_name_with_work(base, declarations, depth + 1, source_work)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_type_head_name_with_work(inner, declarations, depth + 1, source_work) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                Ast::Expr.Scope(_, name, _):
                    return ""
                _:
                    return ""
