# User identifiers must not overlap the checker's compiler-generated witness or SSA-like
# rebinding names. Those spellings are represented as ordinary AST identifiers, so allowing a
# source declaration to claim the same namespace would erase the distinction at proof time.
extend ElisaProof:
    private:
        def proof_name_uses_internal_namespace(name: sview) -> bool:
            return false if sview_len(name) < 8
            return false if sview_at(name, 0) != 95
            return false if sview_at(name, 1) != 95
            return false if sview_at(name, 2) != 101
            return false if sview_at(name, 3) != 108
            return false if sview_at(name, 4) != 105
            return false if sview_at(name, 5) != 115
            return false if sview_at(name, 6) != 97
            return false if sview_at(name, 7) != 95
            return true

        def proof_source_function_line(table: Semantic::SymbolTable&, name: sview) -> u32:
            for symbol in table.symbols:
                return symbol.line if symbol.name == name
            return 0

        # Semantic::check_full records globals/types, all function parameters, and local
        # binders/references in these source-owned tables. A collision anywhere in the imported
        # program is enough to make the proof namespace ambiguous, so fail closed.
        def proof_find_internal_name_collision(table: Semantic::SymbolTable&) -> (found: bool, name: sview, line: u32):
            for symbol in table.symbols |table|:
                return (true, symbol.name, symbol.line) if proof_name_uses_internal_namespace(symbol.name)
            for index in 0..<table.function_param_name.count:
                parameter_name: sview = table.function_param_name[index]
                if proof_name_uses_internal_namespace(parameter_name):
                    owner: sview = table.function_param_owner[index] if index < table.function_param_owner.count else ""
                    return (true, parameter_name, proof_source_function_line(table, owner))
            for index in 0..<table.ref_name.count:
                if proof_name_uses_internal_namespace(table.ref_name[index]):
                    line: u32 = table.ref_line[index] if index < table.ref_line.count else 0
                    return (true, table.ref_name[index], line)
            return (false, "", 0)
