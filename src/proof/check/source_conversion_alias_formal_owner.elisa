# Owner lookup for parser-stamped generic alias formals.
extend ElisaProof:
    private:
        def proof_source_conversion_alias_formal_owner(name: sview, line: u32, offset: u32, formals: darray[Ast::EnumAnnotation]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, formal_names: darray[sview]&, formal_starts: darray[usize]&, formal_counts: darray[usize]&, source_work: mutable usize&) -> (complete: bool, found: bool, owner_row: usize, start: usize, count: usize):
            owner_count: usize = formals.count
            not_found: usize = owner_count
            return (false, false, not_found, 0, 0) if hashes.count != values.count or hashes.count != counts.count or owner_count != formal_starts.count or owner_count != formal_counts.count
            return (true, false, not_found, 0, 0) if owner_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(owner_count)
            return (false, false, not_found, 0, 0) if:
                owner_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
                not proof_report_source_work_charge(1, source_work)
                not proof_report_source_work_charge(sview_len(name), source_work)
            hash: u32 = proof_expr_shape_mix(proof_expr_shape_mix(proof_name_hash(name), line.i64()), offset.i64())
            slot: mutable usize = (hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, line, offset, formals, hashes, values, counts, owner_count, formal_names, formal_starts, formal_counts, source_work|:
                return (false, false, not_found, 0, 0) if not proof_report_source_work_charge(1, source_work)
                current: usize = values[slot]
                return (true, false, not_found, 0, 0) if current == owner_count
                return (false, false, not_found, 0, 0) if current > owner_count
                if hashes[slot] == hash:
                    annotation: Ast::EnumAnnotation = formals[current]
                    return (false, false, not_found, 0, 0) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.name), source_work)
                    if annotation.line == line and annotation.offset == offset and annotation.name == name:
                        return (false, false, not_found, 0, 0) if counts[slot] != 1 or formal_starts[current] > formal_names.count or formal_counts[current] > formal_names.count - formal_starts[current]
                        return (true, true, current, formal_starts[current], formal_counts[current])
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, false, not_found, 0, 0)

        def proof_source_conversion_alias_formal_head(name: sview, owner_row: usize, report: mutable ProofReport&) -> (complete: bool, found: bool):
            index: ProofSourceEffectIndex& = report.source_types.source_effect_index
            alias_count: usize = index.aliases.alias_names.count
            return (false, false) if:
                owner_row >= alias_count
                index.aliases.alias_generic_formal_starts.count != alias_count
                index.aliases.alias_generic_formal_counts.count != alias_count
                index.aliases.alias_generic_application_valid.count != alias_count
                not index.aliases.alias_generic_application_valid[owner_row]
            start: usize = index.aliases.alias_generic_formal_starts[owner_row]
            count: usize = index.aliases.alias_generic_formal_counts[owner_row]
            return (false, false) if start > index.aliases.alias_generic_formal_names.count or count > index.aliases.alias_generic_formal_names.count - start
            for formal_index in 0..<count |formal_index, name, start, index, report|:
                formal_name: sview = index.aliases.alias_generic_formal_names[start + formal_index]
                return (false, false) if not proof_source_index_work_charge(report, sview_len(formal_name))
                return (true, true) if formal_name == name
            return (true, false)
