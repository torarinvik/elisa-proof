extend ElisaProof:
    private:
        const PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH: i64 = ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
        const PROOF_MAX_PATH_COMPONENTS: usize = 8
        def proof_fixed_array_shape(expression: Ast::Expr, declarations: darray[Ast::Decl]&, extents: mutable darray[i64]&) -> bool:
            match expression:
                Ast::Expr.Unary(_, operand, _):
                    return proof_fixed_array_shape(operand, declarations, extents)
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_array_shape(inner, declarations, extents)
                Ast::Expr.IndexN(object, arguments, _):
                    head: sview = proof_callable_name(object)
                    return false if head != "array" or arguments.count != 2
                    extent: (known: bool, value: i64) = proof_fixed_extent_constant(arguments[1], declarations)
                    return false if not extent.known or extent.value < 0
                    extents.push(extent.value)
                    nested: mutable darray[i64] = []
                    proof_fixed_array_shape(arguments[0], declarations, &nested)
                    extents.extend(nested)
                    return true
                Ast::Expr.Index(object, extent_expression, _):
                    # The compiler's shorthand form is only a fixed array when the element head
                    # is a primitive scalar. Generic `T[N]`-shaped syntax must not be
                    # reinterpreted as a storage bound by the proof importer.
                    return false if not proof_fixed_array_primitive_head(proof_callable_name(object))
                    extent: (known: bool, value: i64) = proof_fixed_extent_constant(extent_expression, declarations)
                    return false if not extent.known or extent.value < 0
                    extents.push(extent.value)
                    return true
                _:
                    return false

        # The ordinary index path uses the first dimension of a collected place: a parameter,
        # or a field chain rooted at one (fixed_array_places.elisa). Calls and arbitrary paths
        # are excluded until their storage identity and aliasing are modeled.
        def proof_fixed_array_extent_for_object(expression: Ast::Expr, places: darray[Ast::Expr]&, extents: darray[i64]&) -> i64:
            return proof_fixed_array_dimension_extent(expression, 0, places, extents)

        # Multi-index expressions select the dimension by occurrence, so a place repeated in the
        # flat shape is deliberate and preserves the exact nesting order.
        def proof_fixed_array_dimension_extent(expression: Ast::Expr, dimension: usize, places: darray[Ast::Expr]&, extents: darray[i64]&) -> i64:
            limit: usize = places.count if places.count <= extents.count else extents.count
            occurrence: mutable usize = 0
            for index in 0..<limit |index, places, extents, expression, dimension, occurrence|:
                if proof_fixed_place_matches(expression, places[index]):
                    return extents[index] if occurrence == dimension
                    occurrence <- occurrence + 1
            return -1

        def proof_quantifier_rule(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> sview:
            kind: sview = proof_quantifier_kind(expression, annotations)
            return "quantifier-forall" if kind == "forall"
            return "quantifier-exists" if kind == "exists"
            return ""

        # Keep the decision procedure and certificate emission together. Only successful goals
        # enter the certificate stream; failed goals remain ordinary report findings.
        def proof_certify_goal_with_rule(facts: darray[Ast::Expr]&, goal: Ast::Expr, report: mutable ProofReport&, line: u32, name: sview, annotations: darray[Ast::EnumAnnotation]&, original_rule: sview) -> bool:
            exhausted: mutable bool = false
            rule: mutable sview = original_rule
            quantifier_kind: mutable sview = ""
            quantifier_kind <- proof_quantifier_kind(goal, annotations) if original_rule == ""
            rule <- "goal" if rule == ""
            rule <- "quantifier-forall" if quantifier_kind == "forall"
            rule <- "quantifier-exists" if quantifier_kind == "exists"
            goal_supported: bool = proof_kernel_expression_supported(goal)
            operator_mask: usize = report.source_primitive_operator_mask
            if not report.kernel_budget_exhausted and goal_supported:
                memoized: (found: bool, proven: bool) = proof_reuse_goal_attempt(facts, goal, line, name, rule, report)
                return memoized.proven if memoized.found
            # The mocap in-kernel Fourier-Motzkin tier must not stand in for a linear
            # certificate. An empty `__elisa_linear_certificate` marker switches that tier off
            # without being a valid certificate, so a goal with a certificate is first decided
            # without it; one that needs it takes main's certificate route, and the tier only
            # after that. The certificate search is a pure function of the facts and the goal and
            # is cheap, so it runs first: without a certificate a goal ends in the full decision
            # anyway, so that decision runs once rather than after a failing probe (a probe falls
            # into the exhaustive case splits the tier would have pruned).
            proven: mutable bool = false
            if not report.kernel_budget_exhausted and goal_supported:
                if rule == "goal":
                    first: (found: bool, certificate: Ast::Expr) = proof_linear_certificate_search(facts, goal, line)
                    no_arguments: darray[Ast::Expr] = []
                    no_names: darray[sview] = []
                    position: Ast::Pos = Ast::pos_at_line(line)
                    if first.found:
                        probe: mutable darray[Ast::Expr] = []
                        for fact in facts |fact, probe|:
                            probe.push(fact)
                        probe.push(Ast::Expr.Call(Ast::Expr.Ident("__elisa_linear_certificate", position), no_arguments, no_names, position))
                        proven <- proof_goal_cached(report, probe, goal, annotations, operator_mask, &exhausted)
                        if not proven and not report.kernel_budget_exhausted:
                            first_extended: mutable darray[Ast::Expr] = []
                            for fact in facts |fact, first_extended|:
                                first_extended.push(fact)
                            proof_add_traced_fact(&first_extended, report, first.certificate, "linear-certificate", line, name)
                            first_exhausted: mutable bool = false
                            if proof_goal_cached(report, first_extended, goal, annotations, operator_mask, &first_exhausted):
                                proof_add_goal_attempt(report, first_extended, goal, line, name, rule, true)
                                return not report.kernel_budget_exhausted
                            exhausted <- false
                            proven <- not report.kernel_budget_exhausted and proof_goal_cached(report, facts, goal, annotations, operator_mask, &exhausted)
                    else:
                        proven <- proof_goal_cached(report, facts, goal, annotations, operator_mask, &exhausted)
                        if not proven and not report.kernel_budget_exhausted:
                            # Keep the probe's verdict exactly: the marker is one more fact.
                            probe: mutable darray[Ast::Expr] = []
                            for fact in facts |fact, probe|:
                                probe.push(fact)
                            probe.push(Ast::Expr.Call(Ast::Expr.Ident("__elisa_linear_certificate", position), no_arguments, no_names, position))
                            probe_exhausted: mutable bool = false
                            if proof_goal_cached(report, probe, goal, annotations, operator_mask, &probe_exhausted):
                                proven <- true
                                exhausted <- probe_exhausted
                else:
                    proven <- proof_goal_cached(report, facts, goal, annotations, operator_mask, &exhausted)
            if not proven and goal_supported and not report.kernel_budget_exhausted and rule == "goal":
                # A linear certificate is one more traced fact; the goal is then decided again,
                # by the same tiers, so the checker -- not the search -- admits it.
                # The search already ran (and failed) above, before the in-kernel tier; only hints remain.
                search: mutable (found: bool, certificate: Ast::Expr) = (false, Ast::Expr.BoolLit(false, Ast::pos_at_line(line)))
                search <- proof_linear_hint_certificate(facts, report, line, name) if not search.found and report.linear_hints.count > 0
                if search.found:
                    extended: mutable darray[Ast::Expr] = []
                    for fact in facts |fact, extended|:
                        extended.push(fact)
                    proof_add_traced_fact(&extended, report, search.certificate, "linear-certificate", line, name)
                    certified_exhausted: mutable bool = false
                    if proof_goal_cached(report, extended, goal, annotations, operator_mask, &certified_exhausted):
                        proof_add_goal_attempt(report, extended, goal, line, name, rule, true)
                        return not report.kernel_budget_exhausted
            if not proven and goal_supported and not report.kernel_budget_exhausted and rule == "goal":
                # A goal over a conditional term may still follow case by case (G75).
                return true if proof_certify_conditional_goal(facts, goal, report, line, name, annotations)
            proof_add_goal_attempt(report, facts, goal, line, name, rule, proven)
            proof_mark_latest_attempt_exhausted(report, exhausted and not proven)
            return proven and not report.kernel_budget_exhausted

        def proof_certify_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, report: mutable ProofReport&, line: u32, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_certify_goal_with_rule(facts, goal, report, line, name, annotations, "")

        # Return expressions inherit the declared result type. A closed arithmetic subtree in an
        # unsigned return must fit that width before the general `i64` decision procedure may
        # fold it; otherwise `255 + 1 : u8` can be mistaken for the mathematical value 256.
        # Record the failed attempt through the same certificate path so diagnostics and replay
        # retain a complete obligation history.
        def proof_certify_return_goal(facts: darray[Ast::Expr]&, return_value: Ast::Expr, goal: Ast::Expr, report: mutable ProofReport&, line: u32, name: sview, annotations: darray[Ast::EnumAnnotation]&, original_rule: sview) -> bool:
            width: i64 = report.current_return_unsigned_width
            # A call's argument widths are independent of its result width.
            # Only an exact same-width result witness exempts this call value;
            # arithmetic around a call still takes the ordinary overflow gates.
            witnessed_call: bool = match proof_strip_parens(return_value):
                Ast::Expr.Call(_, _, _, _): proof_unsigned_place_marker_width(facts, return_value) == width
                _: false
            # Apply the return-type boundary to the returned value, not every literal in its
            # postcondition. A u8 result may be constrained by a u32 parameter compared with
            # 1000; that threshold is not itself a u8 value. Checking the substituted whole goal
            # incorrectly rejected such valid contracts and could prevent logical rules (for
            # example, disjunction introduction) from running at all.
            if width > 0 and not witnessed_call and not proof_unsigned_constants_fit(return_value, width, 0) and not proof_closed_typed_return_fits(return_value, width, annotations) and not proof_typed_constant_comparison(goal, annotations):
                rule: mutable sview = original_rule
                quantifier_kind: mutable sview = ""
                quantifier_kind <- proof_quantifier_kind(goal, annotations) if original_rule == ""
                rule <- "goal" if rule == ""
                rule <- "quantifier-forall" if quantifier_kind == "forall"
                rule <- "quantifier-exists" if quantifier_kind == "exists"
                proof_add_goal_attempt(report, facts, goal, line, name, rule, false)
                return false
            return proof_certify_goal_with_rule(facts, goal, report, line, name, annotations, original_rule)

        # A termination clause may spell a lexicographic ranking either as one tuple
        # (`decreases (outer, inner)`) or as several clauses. Flatten only the explicit tuple
        # shell; each resulting component is still checked as an ordinary fixed-width integer
        # expression. Empty/nested unsupported shapes remain represented by their expression and
        # therefore fail closed in the arithmetic obligation instead of becoming an assumption.
        def proof_decreases_components(expression: Ast::Expr, components: mutable darray[Ast::Expr]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_decreases_components(inner, components)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |components|:
                        proof_decreases_components(element, components)
                _:
                    components.push(expression)

        def proof_decreases_component_slice(expressions: darray[Ast::Expr]&, components: mutable darray[Ast::Expr]&) -> void:
            for expression in expressions |components|:
                proof_decreases_components(expression, components)

        # Infer the ordinary structural ranking used by algebraic-data-type traversals when the
        # author omits an explicit `decreases` clause. This is deliberately narrow: there must be
        # at least one enum-typed parameter, and the existing structural checker must still prove
        # every recursive edge descends in one of the enum parameters while leaving every other
        # enum parameter unchanged or descending. This is a product-of-subterms ranking: the sum
        # of the finite constructor heights strictly decreases. No integer or opaque/reference
        # parameter is inferred, so this cannot turn arbitrary recursion into a termination
        # certificate.
        def proof_infer_structural_decrease(enum_index: ProofEnumIndex, parameters: darray[Ast::ParamDecl]&) -> (known: bool, parameter: sview, position: usize, type_name: sview):
            candidate: mutable sview = ""
            candidate_position: mutable usize = parameters.count
            candidate_type: mutable sview = ""
            for index in 0..<parameters.count |index, parameters, candidate, candidate_position, candidate_type, enum_index|:
                type_name: sview = proof_callable_name(parameters[index].type_expression)
                if type_name != "" and proof_declaration_has_enum(enum_index, type_name):
                    if candidate == "":
                        candidate <- parameters[index].name
                        candidate_position <- index
                        candidate_type <- type_name
            return (candidate != "", candidate, candidate_position, candidate_type)

        def proof_enum_parameter_names(enum_index: ProofEnumIndex, parameters: darray[Ast::ParamDecl]&) -> darray[sview]:
            result: mutable darray[sview] = []
            for parameter in parameters |result, enum_index|:
                type_name: sview = proof_callable_name(parameter.type_expression)
                result.push(parameter.name) if type_name != "" and proof_declaration_has_enum(enum_index, type_name)
            return result

        def proof_decreases_range_valid(start: usize, count: usize, total: usize) -> bool:
            return start <= total and count <= total - start

        def proof_declaration_has_enum(index: ProofEnumIndex, wanted: sview) -> bool:
            return false if not index.complete or index.bucket_heads.count == 0 or wanted == ""
            hash: u32 = proof_name_hash(wanted)
            slot: usize = (hash.i64() % index.bucket_heads.count.i64()).usize()
            entry: mutable usize = index.bucket_heads[slot]
            while entry < index.names.count |entry, hash, wanted, index|:
                return true if index.name_hashes[entry] == hash and index.names[entry] == wanted
                entry <- index.next_indices[entry]
            return false

        # Termination goals usually sit inside a large symbolic state accumulated by the body
        # checker. Carrying unrelated facts into the arithmetic solver and into every certificate
        # attempt is both expensive and unnecessary. Keep only premises that mention a name from
        # the ranking expressions. If the small name collector cannot see a name (for example in
        # an expression form outside the arithmetic fragment), retain the complete context: that
        # preserves completeness while the kernel still validates every retained premise.
        def proof_relevant_facts_for_expressions(facts: darray[Ast::Expr]&, expressions: darray[Ast::Expr]&) -> darray[Ast::Expr]:
            names: mutable darray[sview] = []
            for expression in expressions |names|:
                proof_counterexample_collect_names(expression, &names, facts)
            result: mutable darray[Ast::Expr] = []
            if names.count == 0:
                result.extend(facts)
                return result
            for fact in facts |fact, names, result|:
                relevant: mutable bool = false
                for target in names |target, fact, relevant|:
                    relevant <- true if proof_expr_mentions_name(fact, target)
                result.push(fact) if relevant
            return result

        def proof_enum_parameter_position(enum_index: ProofEnumIndex, parameters: darray[Ast::ParamDecl]&, subject: sview) -> usize:
            index: mutable usize = 0
            for parameter in parameters |index, enum_index|:
                type_name: sview = proof_callable_name(parameter.type_expression)
                return index if parameter.name == subject and proof_declaration_has_enum(enum_index, type_name)
                index <- index + 1
            return parameters.count

        # Prove lexicographic descent over nonnegative components. Earlier components must be
        # equal and the first component that differs must strictly decrease. Every component's
        # nonnegativity is checked by the caller, so this relation is a well-founded ranking over
        # fixed-width naturals rather than an unchecked tuple comparison.
        def proof_lexicographic_smaller(current_components: darray[Ast::Expr]&, next_components: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos, report: mutable ProofReport&, name: sview) -> bool:
            return false if current_components.count == 0 or current_components.count != next_components.count
            # Build one proposition instead of emitting speculative component goals while
            # searching for the first decrease. For (a,b), this is a'<a || (a'==a && b'<b).
            # Consequently every exported goal attempt is a real obligation and a successful
            # lexicographic proof cannot leave abandoned failures in the repair queue.
            relation: mutable Ast::Expr = Ast::Expr.Invalid
            cursor: mutable usize = current_components.count
            while cursor > 0 |cursor, current_components, next_components, position, relation|:
                cursor <- cursor - 1
                smaller: Ast::Expr = Ast::Expr.Binary(next_components[cursor], TokenKind.Lt, current_components[cursor], position)
                if proof_expr_is_invalid(relation):
                    relation <- smaller
                else:
                    equal: Ast::Expr = Ast::Expr.Binary(next_components[cursor], TokenKind.EqEq, current_components[cursor], position)
                    suffix: Ast::Expr = Ast::Expr.Binary(equal, TokenKind.And, relation, position)
                    relation <- Ast::Expr.Binary(smaller, TokenKind.Or, suffix, position)
            ranking_expressions: mutable darray[Ast::Expr] = []
            ranking_expressions.extend(current_components)
            ranking_expressions.extend(next_components)
            relevant_facts: darray[Ast::Expr] = proof_relevant_facts_for_expressions(facts, ranking_expressions)
            return proof_certify_goal(relevant_facts, relation, report, position.line, name, annotations)

        # A branch/loop join may have changed a local on only some paths. Retaining its old
        # symbolic value would let a later return silently use the pre-join expression. Forget
        # such values by replacing them with opaque current identifiers; invariants or explicit
        # facts may reintroduce relationships after the join.
        def proof_forget_values(names: darray[sview]&, values: mutable darray[Ast::Expr]&, position: Ast::Pos) -> void:
            for index in 0..<values.count |index, names, values, position|:
                if index < names.count:
                    match values[index]:
                        Ast::Expr.Invalid:
                            pass
                        Ast::Expr.RecordUpdate(_, _, _):
                            values[index] <- Ast::Expr.Invalid
                        _:
                            values[index] <- Ast::Expr.Ident(names[index], position)
                values[index] <- Ast::Expr.Invalid if index >= names.count

        # An else path after `if not condition` carries condition itself, not a redundant
        # double negation. This matters for early-return guards: the surviving path can then
        # publish the predicate that justified a later access or postcondition.
        # A conjunctive branch condition entails each of its conjuncts. Recording the conjuncts
        # alongside the whole costs nothing logically and makes each one survive on its own
        # merits: `not f(x) and depth < 127` is discarded wholesale at the next call because of
        # the call, while its second conjunct is over a by-value scalar and remains true. The
        # walk is a bounded worklist so a deeply nested condition cannot blow up the fact set.
        def proof_conjunct_components(expression: Ast::Expr, components: mutable darray[Ast::Expr]&) -> void:
            pending: mutable darray[Ast::Expr] = [expression]
            cursor: mutable usize = 0
            while cursor < pending.count and components.count < PROOF_MAX_PATH_COMPONENTS |cursor, pending, components|:
                current: Ast::Expr = proof_strip_parens(pending[cursor])
                cursor <- cursor + 1
                room: bool = pending.count < 16
                split: mutable bool = false
                match current:
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        if room:
                            pending.push(left)
                            pending.push(right)
                            split <- true
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        # De Morgan only where it makes progress; a negated comparison is
                        # already atomic and must not be pushed back onto the worklist.
                        inner: Ast::Expr = proof_strip_parens(operand)
                        match inner:
                            Ast::Expr.Binary(_, TokenKind.Or, _, _):
                                # `not (X or Y)` is the conjunction `not X and not Y`. The dual
                                # form `not (X and Y)` is a disjunction and is left whole: it is
                                # not a conjunct and the kernel would not re-derive it.
                                if room:
                                    pending.push(proof_branch_negation(inner, Ast::expr_pos(current)))
                                    split <- true
                            Ast::Expr.Unary(TokenKind.Not, double, _):
                                if room:
                                    pending.push(double)
                                    split <- true
                            _:
                                pass
                    _:
                        pass
                components.push(current) if not split

        # Record a branch condition and, separately, every conjunct it entails. The conjuncts are
        # derived facts: replay revalidates each one from the premises standing at this point
        # rather than accepting it as a second assumption.


        def proof_add_fact(facts: mutable darray[Ast::Expr]&, expression: Ast::Expr) -> void:
            facts.push(expression)

        def proof_trace_fact(report: mutable ProofReport&, expression: Ast::Expr, kind: sview, line: u32, name: sview) -> bool:
            # The checked encoder deliberately returns an arena node even for an unsupported
            # source shape so diagnostics can retain the attempted term. That node is not a fact
            # boundary: accepting it here would put an `Invalid`-containing expression in the live
            # source context while the report later filters it from certificate premises. Keep the
            # producer and replay views identical by rejecting unsupported facts before encoding.
            return false if not proof_kernel_expression_supported(expression)
            return false if not proof_kernel_report_append_allowed(report, report.fact_traces.count, 1, name)
            encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(expression, report, name)
            return false if not encoded.known
            report.fact_traces <- report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: encoded.root, kind: kind, line: line, name: name, dependency: "", premises_start: report.fact_trace_premises.count, premises_count: 0, kernel_premises_start: report.kernel_fact_trace_premises.count, kernel_premises_count: 0, summary_bindings_start: report.fact_trace_summary_names.count, summary_bindings_count: 0, summary_requires_start: report.fact_trace_summary_require_goal_ids.count, summary_requires_count: 0, summary_ensure_index: 0, owner_line: report.trace_owner_line if (kind == "global-constant" or kind == "global-constant-qualified") else 0})
            report.global_constant_trace_ids.push(report.fact_traces.count - 1) if (kind == "global-constant" or kind == "global-constant-qualified")
            return true

        def proof_add_traced_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, kind: sview, line: u32, name: sview) -> void:
            return if not proof_kernel_report_append_allowed(report, facts.count, 1, name)
            return if not proof_trace_fact(report, expression, kind, line, name)
            facts.push(expression)

        # A derived fact records the current logical context before it is added. Replay can then
        # recursively validate proof-step facts instead of treating their source assertion as an
        # axiom. Runtime facts and imported contract summaries continue to use proof_trace_fact;
        # they are explicit semantic assumptions at this boundary.
        def proof_add_derived_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, kind: sview, line: u32, name: sview) -> void:
            return if not proof_kernel_expression_supported(expression)
            return if not proof_kernel_report_append_allowed(report, facts.count, 1, name)
            return if not proof_kernel_report_append_allowed(report, report.fact_traces.count, 1, name)
            return if not proof_kernel_report_append_allowed(report, report.fact_trace_premises.count, facts.count, name)
            return if not proof_kernel_report_append_allowed(report, report.kernel_fact_trace_premises.count, facts.count, name)
            premises: darray[Ast::Expr] = proof_copy_exprs(facts)
            node_start: usize = report.kernel_nodes.count
            child_start: usize = report.kernel_children.count
            premises_start: usize = report.fact_trace_premises.count
            kernel_premises_start: usize = report.kernel_fact_trace_premises.count
            kernel_premises: mutable darray[usize] = []
            for premise in premises |premise, report|:
                encoded_premise: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(premise, report, name)
                if not encoded_premise.known:
                    report.kernel_nodes <- report.kernel_nodes.truncate(node_start)
                    report.kernel_children <- report.kernel_children.truncate(child_start)
                    return
                kernel_premises.push(encoded_premise.root)
            encoded_expression: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(expression, report, name)
            if not encoded_expression.known:
                report.kernel_nodes <- report.kernel_nodes.truncate(node_start)
                report.kernel_children <- report.kernel_children.truncate(child_start)
                return
            facts.push(expression)
            report.fact_trace_premises.extend(premises)
            report.kernel_fact_trace_premises.extend(kernel_premises)
            report.fact_traces <- report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: encoded_expression.root, kind: kind, line: line, name: name, dependency: "", premises_start: premises_start, premises_count: premises.count, kernel_premises_start: kernel_premises_start, kernel_premises_count: premises.count, summary_bindings_start: report.fact_trace_summary_names.count, summary_bindings_count: 0, summary_requires_start: report.fact_trace_summary_require_goal_ids.count, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 0})

        # The same trace, but over an explicit premise list rather than the whole current context.
        # A step whose justification is a single named fact records exactly that fact, so replay
        # revalidates a small, precise derivation instead of the entire ambient state.
        def proof_add_derived_fact_from(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, premises: darray[Ast::Expr]&, kind: sview, line: u32, name: sview) -> void:
            # A derivation is only as good as its premises. One the kernel cannot represent can
            # never be validated by replay, so a fact derived from it would certify at the
            # producer and gap at the kernel. Refuse the derivation instead; the fact is simply
            # not available, which is the conservative direction.
            return if not proof_kernel_expression_supported(expression)
            for premise in premises:
                return if not proof_kernel_expression_supported(premise)
            return if not proof_kernel_report_append_allowed(report, facts.count, 1, name)
            return if not proof_kernel_report_append_allowed(report, report.fact_traces.count, 1, name)
            return if not proof_kernel_report_append_allowed(report, report.fact_trace_premises.count, premises.count, name)
            return if not proof_kernel_report_append_allowed(report, report.kernel_fact_trace_premises.count, premises.count, name)
            node_start: usize = report.kernel_nodes.count
            child_start: usize = report.kernel_children.count
            premises_start: usize = report.fact_trace_premises.count
            kernel_premises_start: usize = report.kernel_fact_trace_premises.count
            kernel_premises: mutable darray[usize] = []
            for premise in premises |premise, report|:
                encoded_premise: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(premise, report, name)
                if not encoded_premise.known:
                    report.kernel_nodes <- report.kernel_nodes.truncate(node_start)
                    report.kernel_children <- report.kernel_children.truncate(child_start)
                    return
                kernel_premises.push(encoded_premise.root)
            encoded_expression: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(expression, report, name)
            if not encoded_expression.known:
                report.kernel_nodes <- report.kernel_nodes.truncate(node_start)
                report.kernel_children <- report.kernel_children.truncate(child_start)
                return
            facts.push(expression)
            report.fact_trace_premises.extend(premises)
            report.kernel_fact_trace_premises.extend(kernel_premises)
            report.fact_traces <- report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: encoded_expression.root, kind: kind, line: line, name: name, dependency: "", premises_start: premises_start, premises_count: premises.count, kernel_premises_start: kernel_premises_start, kernel_premises_count: premises.count, summary_bindings_start: report.fact_trace_summary_names.count, summary_bindings_count: 0, summary_requires_start: report.fact_trace_summary_require_goal_ids.count, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 0})

        def proof_add_function_summary_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, name: sview, dependency: sview, parameter_names: darray[sview]&, argument_values: darray[Ast::Expr]&, result_value: Ast::Expr, require_goal_ids: darray[usize]&, ensure_index: usize, has_call_old: bool, call_old_value: Ast::Expr, dependency_line: u32) -> void:
            return if not proof_kernel_expression_supported(expression)
            return if not proof_kernel_report_append_allowed(report, facts.count, 1, name)
            return if parameter_names.count != argument_values.count
            return if parameter_names.count >= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            binding_count: mutable usize = parameter_names.count + 1
            binding_count <- binding_count + 1 if has_call_old
            return if not proof_kernel_report_append_allowed(report, report.fact_traces.count, 1, name)
            return if not proof_kernel_report_append_allowed(report, report.fact_trace_summary_names.count, binding_count, name)
            return if not proof_kernel_report_append_allowed(report, report.fact_trace_summary_values.count, binding_count, name)
            return if not proof_kernel_report_append_allowed(report, report.fact_trace_summary_require_goal_ids.count, require_goal_ids.count, name)
            encoded: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(expression, report, name)
            return if not encoded.known
            facts.push(expression)
            bindings_start: usize = report.fact_trace_summary_names.count
            report.fact_trace_summary_names.extend(parameter_names)
            report.fact_trace_summary_values.extend(argument_values)
            report.fact_trace_summary_names.push("result")
            report.fact_trace_summary_values.push(result_value)
            report.fact_trace_summary_names.push("__old_reference_state") if has_call_old
            report.fact_trace_summary_values.push(call_old_value) if has_call_old
            requires_start: usize = report.fact_trace_summary_require_goal_ids.count
            report.fact_trace_summary_require_goal_ids.extend(require_goal_ids)
            report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: encoded.root, kind: "function-summary", line: line, name: name, dependency: dependency, premises_start: report.fact_trace_premises.count, premises_count: 0, kernel_premises_start: report.kernel_fact_trace_premises.count, kernel_premises_count: 0, summary_bindings_start: bindings_start, summary_bindings_count: binding_count, summary_requires_start: requires_start, summary_requires_count: require_goal_ids.count, summary_ensure_index: ensure_index, owner_line: dependency_line})

include "./bounds_and_facts_integrated_helpers.elisa"
