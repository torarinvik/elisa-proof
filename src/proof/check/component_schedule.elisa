extend ElisaProof:
    private:
        # A dependency-first order of SCCs plus a flat member table. `starts` and `counts`
        # index `members` by dense component id; `order` contains those ids in verification
        # order, so callers never rediscover ready components by rescanning the graph.
        struct ProofComponentSchedule:
            order: mutable darray[usize] = []
            starts: mutable darray[usize] = []
            counts: mutable darray[usize] = []
            members: mutable darray[usize] = []
            valid: bool = false

        def proof_build_component_schedule(component_ids: darray[usize]&, edge_starts: darray[usize]&, edge_counts: darray[usize]&, edge_targets: darray[usize]&, node_count: usize, work: mutable usize&) -> ProofComponentSchedule:
            schedule: mutable ProofComponentSchedule = ProofComponentSchedule{}
            if node_count == 0 and component_ids.count == 0 and edge_starts.count == 0 and edge_counts.count == 0 and edge_targets.count == 0:
                schedule.valid <- true
                return schedule
            return schedule if component_ids.count != node_count or edge_starts.count != node_count or edge_counts.count != node_count

            edge_cursor: mutable usize = 0
            for node in 0..<node_count |node, edge_starts, edge_counts, work, edge_cursor|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                start: usize = edge_starts[node]
                count: usize = edge_counts[node]
                return ProofComponentSchedule{} if start != edge_cursor or start > edge_targets.count or count > edge_targets.count - start
                edge_cursor <- edge_cursor + count
            return ProofComponentSchedule{} if edge_cursor != edge_targets.count

            dense_by_old: mutable darray[usize] = []
            return ProofComponentSchedule{} if not proof_report_source_work_charge(node_count, work)
            dense_by_old.resize(node_count)
            for old_id in 0..<node_count |old_id, dense_by_old, node_count|:
                dense_by_old[old_id] <- node_count
            node_components: mutable darray[usize] = []
            return ProofComponentSchedule{} if not proof_report_source_work_charge(node_count, work)
            node_components.resize(node_count)
            component_count: mutable usize = 0
            for node in 0..<node_count |node, component_ids, dense_by_old, node_components, component_count, node_count, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                old_id: usize = component_ids[node]
                return ProofComponentSchedule{} if old_id >= node_count
                if dense_by_old[old_id] == node_count:
                    dense_by_old[old_id] <- component_count
                    component_count <- component_count + 1
                node_components[node] <- dense_by_old[old_id]
            return ProofComponentSchedule{} if component_count == 0

            dependency_counts: mutable darray[usize] = []
            reverse_counts: mutable darray[usize] = []
            return ProofComponentSchedule{} if not proof_report_source_work_charge(component_count, work)
            return ProofComponentSchedule{} if not proof_report_source_work_charge(component_count, work)
            dependency_counts.resize(component_count)
            reverse_counts.resize(component_count)
            for source in 0..<node_count |source, edge_starts, edge_counts, edge_targets, node_components, dependency_counts, reverse_counts, node_count, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                start: usize = edge_starts[source]
                count: usize = edge_counts[source]
                source_component: usize = node_components[source]
                for offset in 0..<count |offset, start, edge_targets, node_components, dependency_counts, reverse_counts, source_component, node_count, work|:
                    return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                    target: usize = edge_targets[start + offset]
                    return ProofComponentSchedule{} if target > node_count
                    continue if target == node_count
                    target_component: usize = node_components[target]
                    continue if source_component == target_component
                    dependency_counts[source_component] <- dependency_counts[source_component] + 1
                    reverse_counts[target_component] <- reverse_counts[target_component] + 1

            reverse_starts: mutable darray[usize] = []
            reverse_cursor: mutable usize = 0
            for incoming in reverse_counts |reverse_starts, reverse_cursor, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                reverse_starts.push(reverse_cursor)
                reverse_cursor <- reverse_cursor + incoming
            reverse_edges: mutable darray[usize] = []
            reverse_write: mutable darray[usize] = []
            return ProofComponentSchedule{} if not proof_report_source_work_charge(reverse_cursor, work)
            return ProofComponentSchedule{} if not proof_report_source_work_charge(component_count, work)
            reverse_edges.resize(reverse_cursor)
            reverse_write.extend(reverse_starts)
            for source in 0..<node_count |source, edge_starts, edge_counts, edge_targets, node_components, reverse_write, reverse_edges, node_count, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                start: usize = edge_starts[source]
                count: usize = edge_counts[source]
                source_component: usize = node_components[source]
                for offset in 0..<count |offset, start, edge_targets, node_components, reverse_write, reverse_edges, source_component, node_count, work|:
                    return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                    target: usize = edge_targets[start + offset]
                    continue if target == node_count
                    target_component: usize = node_components[target]
                    continue if source_component == target_component
                    slot: usize = reverse_write[target_component]
                    reverse_edges[slot] <- source_component
                    reverse_write[target_component] <- slot + 1

            pending: mutable darray[usize] = []
            for component in 0..<component_count |component, dependency_counts, pending, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                pending.push(component) if dependency_counts[component] == 0
            schedule.order.clear()
            pending_index: mutable usize = 0
            while pending_index < pending.count |pending_index, pending, schedule, dependency_counts, reverse_starts, reverse_counts, reverse_edges, component_count, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                ready: usize = pending[pending_index]
                pending_index <- pending_index + 1
                schedule.order.push(ready)
                start: usize = reverse_starts[ready]
                count: usize = reverse_counts[ready]
                for offset in 0..<count |offset, start, reverse_edges, pending, dependency_counts, component_count, work|:
                    return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                    caller: usize = reverse_edges[start + offset]
                    return ProofComponentSchedule{} if caller >= component_count or dependency_counts[caller] == 0
                    dependency_counts[caller] <- dependency_counts[caller] - 1
                    pending.push(caller) if dependency_counts[caller] == 0
            return ProofComponentSchedule{} if schedule.order.count != component_count

            member_counts: mutable darray[usize] = []
            return ProofComponentSchedule{} if not proof_report_source_work_charge(node_count, work)
            member_counts.resize(component_count)
            for node in 0..<node_count |node, node_components, member_counts, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                member_counts[node_components[node]] <- member_counts[node_components[node]] + 1
            schedule.starts.clear()
            schedule.counts.clear()
            member_cursor: mutable usize = 0
            for component in 0..<component_count |component, schedule, member_counts, member_cursor, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                schedule.starts.push(member_cursor)
                schedule.counts.push(member_counts[component])
                member_cursor <- member_cursor + member_counts[component]
            member_write: mutable darray[usize] = []
            return ProofComponentSchedule{} if not proof_report_source_work_charge(node_count, work)
            return ProofComponentSchedule{} if not proof_report_source_work_charge(component_count, work)
            member_write.extend(schedule.starts)
            schedule.members.resize(node_count)
            for node in 0..<node_count |node, node_components, member_write, schedule, work|:
                return ProofComponentSchedule{} if not proof_report_source_work_charge(1, work)
                component: usize = node_components[node]
                slot: usize = member_write[component]
                schedule.members[slot] <- node
                member_write[component] <- slot + 1
            schedule.valid <- true
            return schedule
