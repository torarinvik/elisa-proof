# Shared finite-work helpers for call-derived witnesses.
extend ElisaProof:
    private:
        def proof_pure_call_fact_seen_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, seen: bool):
            return (true, false) if facts.count == 0
            expression_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return (false, false) if not expression_cost.complete or exhausted
            for existing in facts |existing, expression, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                existing_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(existing, budget, exhausted)
                return (false, false) if not existing_cost.complete or exhausted
                if expression_cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - existing_cost.cost:
                    budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                    exhausted <- true
                    return (false, false)
                comparison_cost: usize = existing_cost.cost + expression_cost.cost
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, comparison_cost)
                equal: bool = proof_replay_expr_equal_depth(existing, expression, 0)
                return (true, true) if equal
            return (true, false)

        def proof_pure_call_add_scalar_witness_with_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, owner: sview, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if exhausted
            if report.source_types.source_effect_index.work.implicit_effect_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                exhausted <- true
                return false
            # Once the per-function witness cap is full, both duplicate and new candidates
            # are no-ops. Avoid scanning a potentially large fact list for work that cannot
            # change the facts; source-work exhaustion above still propagates independently.
            return true if report.analysis_2.scalar_witness_facts >= PROOF_SCALAR_WITNESS_FUNCTION_BUDGET
            duplicate: (complete: bool, seen: bool) = proof_pure_call_fact_seen_with_work(expression, facts, budget, exhausted)
            return false if not duplicate.complete or exhausted
            if not duplicate.seen:
                report.analysis_2.scalar_witness_facts <- report.analysis_2.scalar_witness_facts + 1
                proof_add_type_bound_fact_known_unique(facts, report, expression, line, owner)
            if report.source_types.source_effect_index.work.implicit_effect_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                exhausted <- true
                return false
            true

        def proof_pure_call_add_type_fact_with_work(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, owner: sview, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            duplicate: (complete: bool, seen: bool) = proof_pure_call_fact_seen_with_work(expression, facts, budget, exhausted)
            return false if not duplicate.complete or exhausted
            if not duplicate.seen:
                proof_add_type_bound_fact_known_unique(facts, report, expression, line, owner)
            if report.source_types.source_effect_index.work.implicit_effect_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                exhausted <- true
                return false
            true
