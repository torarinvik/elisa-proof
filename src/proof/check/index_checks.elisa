extend ElisaProof:
    private:
        def proof_statement_has_unmodeled_operator(statement: Ast::Stmt, facts: darray[Ast::Expr]&, report: mutable ProofReport&, functions: mutable ProofFunctionTable&) -> bool can[Global.Read]:
            work: mutable usize = 0
            return (proof_statement_has_unmodeled_operator_with_work(statement, facts, report, functions, &work) can Global.Read)

        def proof_statement_has_unmodeled_operator_with_work(statement: Ast::Stmt, facts: darray[Ast::Expr]&, report: mutable ProofReport&, functions: mutable ProofFunctionTable&, work: mutable usize&) -> bool can[Global.Read]:
            return true if not proof_match_lowering_charge(1, work)
            match statement:
                Ast::Stmt.Expr(expression, _):
                    return (proof_expr_has_unmodeled_operator_with_work(expression, facts, report, functions, 0, work) can Global.Read)
                Ast::Stmt.VarDecl(_, _, initializer, _):
                    return (proof_expr_has_unmodeled_operator_with_work(initializer, facts, report, functions, 0, work) can Global.Read)
                Ast::Stmt.Assign(target, _, initializer, _):
                    return (proof_expr_has_unmodeled_operator_with_work(target, facts, report, functions, 0, work) can Global.Read) or (proof_expr_has_unmodeled_operator_with_work(initializer, facts, report, functions, 0, work) can Global.Read)
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        return (proof_expr_has_unmodeled_operator_with_work(returned, facts, report, functions, 0, work) can Global.Read)
                    return false
                Ast::Stmt.If(condition, _, _, _):
                    return (proof_expr_has_unmodeled_operator_with_work(condition, facts, report, functions, 0, work) can Global.Read)
                Ast::Stmt.While(condition, _, _):
                    return (proof_expr_has_unmodeled_operator_with_work(condition, facts, report, functions, 0, work) can Global.Read)
                Ast::Stmt.For(_, _, iterable, _, _):
                    return (proof_expr_has_unmodeled_operator_with_work(iterable, facts, report, functions, 0, work) can Global.Read)
                Ast::Stmt.Match(scrutinee, arms, _):
                    return true if (proof_expr_has_unmodeled_operator_with_work(scrutinee, facts, report, functions, 0, work) can Global.Read)
                    for arm in arms |facts, functions, work|:
                        return true if (proof_expr_has_unmodeled_operator_with_work(arm.guard, facts, report, functions, 0, work) can Global.Read)
                    return false
                Ast::Stmt.Block(block_kind, _, _, block_body, _):
                    if block_kind == "assert_by" and block_body.count > 0:
                        match block_body[0]:
                            Ast::Stmt.Contract(_, goal, _):
                                return (proof_expr_has_unmodeled_operator_with_work(goal, facts, report, functions, 0, work) can Global.Read)
                            _:
                                return true
                    return false
                Ast::Stmt.Contract(kind, expression, _):
                    return kind == "assert" and (proof_expr_has_unmodeled_operator_with_work(expression, facts, report, functions, 0, work) can Global.Read)
                Ast::Stmt.Break(_, _):
                    return false
                Ast::Stmt.Continue(_, _):
                    return false
                Ast::Stmt.Invalid:
                    return true
                _:
                    # A newly added statement may carry executable operators or state effects.
                    # It must be modeled explicitly before it can cross the proof-state boundary.
                    return true
        def proof_statement_expressions_supported(statement: Ast::Stmt, functions: mutable ProofFunctionTable&, report: ProofReport&) -> bool:
            match statement:
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        return proof_statement_value_supported(returned, functions, report)
                    return true
                Ast::Stmt.Expr(expression, _):
                    return proof_statement_value_supported(expression, functions, report)
                Ast::Stmt.VarDecl(_, _, initializer, _):
                    return proof_statement_value_supported(initializer, functions, report)
                Ast::Stmt.Assign(target, _, initializer, _):
                    return proof_expr_supported(target) and proof_statement_value_supported(initializer, functions, report)
                Ast::Stmt.If(condition, _, _, _):
                    return proof_expr_supported(condition) and proof_runtime_branch_calls_allowed(condition, functions)
                Ast::Stmt.While(condition, _, _):
                    return proof_expr_supported(condition) and proof_runtime_expression_calls_allowed(condition, functions)
                Ast::Stmt.For(_, _, iterable, _, _):
                    return proof_expr_supported(iterable) and proof_runtime_expression_calls_allowed(iterable, functions)
                Ast::Stmt.Match(scrutinee, _, _):
                    return proof_expr_supported(scrutinee) and proof_runtime_expression_calls_allowed(scrutinee, functions)
                Ast::Stmt.Block(block_kind, _, _, block_body, _):
                    if block_kind == "assert_by" and block_body.count > 0:
                        match block_body[0]:
                            Ast::Stmt.Contract(_, goal, _):
                                return proof_expr_supported(goal) and proof_runtime_expression_calls_allowed(goal, functions)
                            _:
                                return false
                    return true
                Ast::Stmt.Contract(kind, expression, _):
                    return true if kind != "assert"
                    return proof_expr_supported(expression) and proof_runtime_expression_calls_allowed(expression, functions)
                Ast::Stmt.Break(_, _):
                    return true
                Ast::Stmt.Continue(_, _):
                    return true
                _:
                    # Unknown statements are not proof-state no-ops. Reject them until their
                    # control-flow and mutation semantics are represented by the checker.
                    return false

        # Extract only a top-level statement value recovery. This deliberately does not walk the
        # recovery body: the main proof-state checker must do that with an isolated state so a
        # failure branch cannot leak bindings or facts into the successful path.
        def proof_statement_getelse_recovery(statement: Ast::Stmt) -> (known: bool, guarded: Ast::Expr, recovery: darray[Ast::Stmt], line: u32):
            match statement:
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        match returned:
                            Ast::Expr.GetElse(guarded, recovery, position):
                                return (true, guarded, recovery, position.line)
                            _:
                                pass
                Ast::Stmt.Expr(expression, _):
                    match expression:
                        Ast::Expr.GetElse(guarded, recovery, position):
                            return (true, guarded, recovery, position.line)
                        _:
                            pass
                Ast::Stmt.VarDecl(_, _, initializer, _):
                    match initializer:
                        Ast::Expr.GetElse(guarded, recovery, position):
                            return (true, guarded, recovery, position.line)
                        _:
                            pass
                Ast::Stmt.Assign(_, _, initializer, _):
                    match initializer:
                        Ast::Expr.GetElse(guarded, recovery, position):
                            return (true, guarded, recovery, position.line)
                        _:
                            pass
                _:
                    pass
            return (false, Ast::Expr.Invalid, [], 0)

        # A runtime index is a memory-safety obligation, not merely an expression the arithmetic
        # prover may ignore. This first heap slice handles directly tracked collection-like
        # places and collection literals whose length is expressed as `.count`; calls, nested dynamic indexes,
        # and multi-index forms stay opaque until the heap model can describe them soundly.
        def proof_indexable_object(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_indexable_object(inner)
                Ast::Expr.Refinement(base, _, _):
                    return proof_indexable_object(base)
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_indexable_object(object)
                Ast::Expr.Scope(base, _, _):
                    return proof_indexable_object(base)
                Ast::Expr.Array(_, _):
                    # A local bound to a collection literal is indexed through its recorded value.
                    # The literal is a value, so its count is its own length and nothing resizes it.
                    return true
                _:
                    return false

        # Elisa's `value.cast[Type]` syntax is represented by the compiler AST as an Index whose
        # receiver is the reserved `cast` selector. The bracket contains a type expression, not a
        # runtime position, so treating it as collection indexing manufactures false memory-safety
        # obligations (especially in trusted low-level pointer adapters). Ordinary `value[index]`
        # expressions do not match this shape and remain fully checked below. The compiler's
        # reserved `size_of[Type]` layout query also has a type argument, not a runtime index.
        # Recognizing that syntax grants no numerical layout fact or allocation provenance.
        def proof_is_type_cast_index(object: Ast::Expr) -> bool:
            match object:
                Ast::Expr.Ident(name, _):
                    return name == "size_of"
                Ast::Expr.Field(_, field, _):
                    return field == "cast"
                Ast::Expr.Paren(inner, _):
                    return proof_is_type_cast_index(inner)
                _:
                    return false

        def proof_expr_is_invalid(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return true
                _:
                    return false

        # Purity only proves that an index-producing call cannot mutate the collection. It does
        # not prove that the returned position is safe. Admit the call only when its verified
        # executable summary contains an exact, call-free result equation; the caller's ordinary
        # arithmetic facts then prove the bounds for that returned expression.
        # Shared index checks account contract substitution in the same per-function budget as
        # their fact scans and snapshots; other callers retain the local substitution meter.
        def proof_index_call_summary_substitute[@r](expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]& @r, local_work: mutable usize&, report: mutable ProofReport&, owner: sview, line: u32, share_index_search_work: bool) -> Ast::Expr @r:
            if share_index_search_work:
                substituted: Ast::Expr = proof_substitute_with_work_limit(expression, names, values, &report.analysis_1.budgets.index_safety_source_work, PROOF_LINEAR_SAFETY_WORK_LIMIT)
                if report.analysis_1.budgets.index_safety_source_work > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                    proof_index_safety_report_work_exhausted(report, owner, line)
                    return Ast::Expr.Invalid
                return substituted
            proof_substitute_with_work(expression, names, values, &local_work)

        def proof_index_call_candidate_supported(expression: Ast::Expr, report: mutable ProofReport&, owner: sview, line: u32, share_index_search_work: bool) -> bool:
            return proof_expr_supported(expression) if not share_index_search_work
            supported: bool = proof_expr_supported_with_work_limit(expression, &report.analysis_1.budgets.index_safety_source_work, PROOF_LINEAR_SAFETY_WORK_LIMIT)
            if report.analysis_1.budgets.index_safety_source_work > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                proof_index_safety_report_work_exhausted(report, owner, line)
                return false
            supported

        def proof_index_call_candidate_call_free(expression: Ast::Expr, report: mutable ProofReport&, owner: sview, line: u32, share_index_search_work: bool) -> bool:
            return not proof_expr_has_call(expression) if not share_index_search_work
            has_call: bool = proof_expr_has_call_with_work(expression, &report.analysis_1.budgets.index_safety_source_work, PROOF_LINEAR_SAFETY_WORK_LIMIT)
            if report.analysis_1.budgets.index_safety_source_work > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                proof_index_safety_report_work_exhausted(report, owner, line)
                return false
            not has_call

        def proof_index_call_candidate_move_free(expression: Ast::Expr, report: mutable ProofReport&, owner: sview, line: u32, share_index_search_work: bool) -> bool:
            return not proof_expr_has_move(expression) if not share_index_search_work
            has_move: bool = proof_expr_has_move_with_work(expression, &report.analysis_1.budgets.index_safety_source_work, PROOF_LINEAR_SAFETY_WORK_LIMIT)
            if report.analysis_1.budgets.index_safety_source_work > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                proof_index_safety_report_work_exhausted(report, owner, line)
                return false
            not has_move

        def proof_index_call_result(expression: Ast::Expr, facts: darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, annotations: darray[Ast::EnumAnnotation]&, summary_facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, share_index_search_work: bool) -> (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) can[Global.Read, Global.Write]:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return (proof_index_call_result(inner, facts, functions, annotations, summary_facts, report, owner, share_index_search_work) can Global{Read,Write})
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    function_name: sview = proof_callable_name(callee)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    parameter_count: usize = functions.parameters.metadata.param_counts[function_index] if function_index < functions.parameters.metadata.param_counts.count else 0
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if:
                        function_name == "" or function_index >= functions.lookup.names.count
                        function_index >= functions.summaries.pure.count or not functions.summaries.pure[function_index]
                        function_index >= functions.summaries.verified.count or not functions.summaries.verified[function_index]
                        function_index >= functions.parameters.metadata.param_counts.count or function_index >= functions.parameters.metadata.param_starts.count or arguments.count > parameter_count
                    parameter_start: usize = functions.parameters.metadata.param_starts[function_index]
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if:
                        parameter_start > functions.parameters.metadata.all_params.count or parameter_count > functions.parameters.metadata.all_params.count - parameter_start
                        parameter_start > functions.parameters.metadata.all_has_defaults.count or parameter_count > functions.parameters.metadata.all_has_defaults.count - parameter_start
                        parameter_start > functions.parameters.metadata.all_defaults.count or parameter_count > functions.parameters.metadata.all_defaults.count - parameter_start
                    if share_index_search_work:
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if:
                            not proof_index_safety_take_source_work(report, owner, position.line, parameter_count)
                            not proof_index_safety_take_source_work(report, owner, position.line, parameter_count)
                            not proof_index_safety_take_source_work(report, owner, position.line, parameter_count)
                    parameter_names: mutable darray[sview] = []
                    for parameter_index in 0..<functions.parameters.metadata.param_counts[function_index] |parameter_names, functions, parameter_start|:
                        parameter_names.push(functions.parameters.metadata.all_params[parameter_start + parameter_index])
                    default_flags: mutable darray[bool] = []
                    default_values: mutable darray[Ast::Expr] = []
                    for parameter_index in 0..<functions.parameters.metadata.param_counts[function_index] |default_flags, default_values, functions, parameter_start|:
                        default_flags.push(functions.parameters.metadata.all_has_defaults[parameter_start + parameter_index])
                        default_values.push(functions.parameters.metadata.all_defaults[parameter_start + parameter_index])
                    mapped_arguments: mutable darray[Ast::Expr] = []
                    mapped_arguments_known: bool = false
                    if share_index_search_work:
                        mapped_arguments_known <- proof_map_runtime_call_arguments_with_work(parameter_names, default_flags, default_values, arguments, argument_names, &mapped_arguments, functions, &report.analysis_1.budgets.index_safety_source_work, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                        if not mapped_arguments_known and report.analysis_1.budgets.index_safety_source_work > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                            proof_index_safety_report_work_exhausted(report, owner, position.line)
                            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "")
                    else:
                        mapped_arguments_known <- proof_map_runtime_call_arguments(parameter_names, default_flags, default_values, arguments, argument_names, &mapped_arguments, functions)
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if not mapped_arguments_known
                    requires_start: usize = functions.contracts.obligations.requires_starts[function_index] if function_index < functions.contracts.obligations.requires_starts.count else functions.contracts.obligations.all_requires.count
                    requires_count: usize = functions.contracts.obligations.requires_counts[function_index] if function_index < functions.contracts.obligations.requires_counts.count else 0
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if requires_start > functions.contracts.obligations.all_requires.count or requires_count > functions.contracts.obligations.all_requires.count - requires_start
                    substitution_work: mutable usize = 0
                    require_goal_ids: mutable darray[usize] = []
                    for requires_index in 0..<requires_count |requires_index, functions, requires_start, parameter_names, mapped_arguments, facts, annotations, report, position, owner, require_goal_ids|:
                        required: Ast::Expr = proof_index_call_summary_substitute(functions.contracts.obligations.all_requires[requires_start + requires_index], parameter_names, mapped_arguments, &substitution_work, report, owner, position.line, share_index_search_work)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if proof_expr_is_invalid(required)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if share_index_search_work and not proof_index_safety_preflight_expr_work(required, 2, report, owner, position.line)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if proof_expr_has_old(required)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if share_index_search_work and not proof_index_safety_preflight_fact_work(facts, PROOF_INDEX_SAFETY_REQUIRES_FACT_PASSES, report, owner, position.line)
                        required_proven: mutable bool = false
                        if share_index_search_work:
                            required_proven <- (proof_certify_goal_with_rule_shared(facts, required, report, position.line, owner, annotations, "") can Global{Read,Write})
                        else:
                            required_proven <- (proof_certify_goal(facts, required, report, position.line, owner, annotations) can Global{Read,Write})
                        require_goal_ids.push(report.results.goal_attempts.count - 1) if report.results.goal_attempts.count > 0
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if not required_proven
                    ensures_start: usize = functions.contracts.obligations.ensure_starts[function_index] if function_index < functions.contracts.obligations.ensure_starts.count else functions.contracts.obligations.all_ensures.count
                    ensures_count: usize = functions.contracts.obligations.ensure_counts[function_index] if function_index < functions.contracts.obligations.ensure_counts.count else 0
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if ensures_start > functions.contracts.obligations.all_ensures.count or ensures_count > functions.contracts.obligations.all_ensures.count - ensures_start
                    result_name: darray[sview] = ["result"]
                    result_value: darray[Ast::Expr] = [expression]
                    for ensures_index in 0..<ensures_count |ensures_index, functions, ensures_start, parameter_names, mapped_arguments, result_name, result_value, expression|:
                        ensured: Ast::Expr = proof_index_call_summary_substitute(functions.contracts.obligations.all_ensures[ensures_start + ensures_index], parameter_names, mapped_arguments, &substitution_work, report, owner, position.line, share_index_search_work)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if proof_expr_is_invalid(ensured)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if share_index_search_work and not proof_index_safety_preflight_expr_work(ensured, 2, report, owner, position.line)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if proof_expr_has_old(ensured)
                        instantiated: Ast::Expr = proof_index_call_summary_substitute(ensured, result_name, result_value, &substitution_work, report, owner, position.line, share_index_search_work)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if proof_expr_is_invalid(instantiated)
                        match instantiated:
                            Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                                candidate: mutable Ast::Expr = Ast::Expr.Invalid
                                if share_index_search_work:
                                    left_match: (complete: bool, equal: bool) = proof_index_call_expr_equal_with_work(left, expression, report, owner, position.line)
                                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if not left_match.complete
                                    if left_match.equal:
                                        candidate <- right
                                    else:
                                        right_match: (complete: bool, equal: bool) = proof_index_call_expr_equal_with_work(right, expression, report, owner, position.line)
                                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if not right_match.complete
                                        candidate <- left if right_match.equal
                                else:
                                    candidate <- right if proof_expr_equal(left, expression) else (left if proof_expr_equal(right, expression) else Ast::Expr.Invalid)
                                continue if proof_expr_is_invalid(candidate)
                                continue if not proof_index_call_candidate_supported(candidate, report, owner, position.line, share_index_search_work)
                                continue if not proof_index_call_candidate_call_free(candidate, report, owner, position.line, share_index_search_work)
                                continue if not proof_index_call_candidate_move_free(candidate, report, owner, position.line, share_index_search_work)
                                if share_index_search_work and not proof_index_call_summary_fact_preflight(instantiated, parameter_names, mapped_arguments, expression, require_goal_ids, false, Ast::Expr.Absent, report, owner, position.line):
                                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "")
                                proof_add_function_summary_fact(summary_facts, report, functions, instantiated, position.line, owner, function_name, parameter_names, mapped_arguments, expression, require_goal_ids, ensures_index, false, Ast::Expr.Absent, functions.lookup.lines[function_index] if function_index < functions.lookup.lines.count else 0, position)
                                return (true, candidate, instantiated, function_name)
                            _:
                                pass
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "")
                _:
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "")

        # `x.usize()` (or any unsigned width conversion) as an index. The bounds are checked on
        # `x` itself: `0 <= x` and `x < count`. For such an `x` the conversion yields a value in
        # `[0, x]` -- `x` unchanged when it fits the target, a truncation of a nonnegative value
        # otherwise -- or panics before any read, so the access is in bounds either way. Signed
        # targets are excluded (a truncation could turn negative), as is a conversion a source
        # function shadows and a receiver that holds a move or any call but a pure conversion.
        def proof_index_unsigned_conversion(index: Ast::Expr, functions: ProofFunctionTable&) -> (known: bool, receiver: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(index):
                Ast::Expr.Call(callee, arguments, _, _):
                    conversion: (known: bool, receiver: Ast::Expr) = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                    return (false, Ast::Expr.Invalid) if not conversion.known
                    match callee:
                        Ast::Expr.Field(_, target, _):
                            return (false, Ast::Expr.Invalid) if target != "u8" and target != "u16" and target != "u32" and target != "u64" and target != "usize"
                        _:
                            return (false, Ast::Expr.Invalid)
                    return (false, Ast::Expr.Invalid) if not proof_expr_calls_are_conversions(conversion.receiver, functions, 0) or proof_expr_has_move(conversion.receiver)
                    return (true, conversion.receiver)
                _:
                    pass
            return (false, Ast::Expr.Invalid)

        def proof_check_index_access(object: Ast::Expr, index: Ast::Expr, position: Ast::Pos, facts: mutable darray[Ast::Expr]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: mutable ProofFunctionTable&) -> void can[Global.Read, Global.Write]:
            return if proof_is_type_cast_index(object)
            checked_index: mutable Ast::Expr = index
            return if not proof_index_safety_take_source_work(report, name, position.line, facts.count)
            checked_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            unsigned_conversion: (known: bool, receiver: Ast::Expr) = proof_index_unsigned_conversion(index, functions)
            if unsigned_conversion.known:
                checked_index <- unsigned_conversion.receiver
            elif proof_expr_has_call(index):
                resolved: (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) = (proof_index_call_result(index, facts, functions, annotations, &checked_facts, report, name, true) can Global{Read,Write})
                if resolved.known:
                    checked_index <- resolved.value
                else:
                    checked_index <- Ast::Expr.Invalid
            if not proof_indexable_object(object) or proof_expr_has_call(object) or proof_expr_has_move(object) or proof_expr_is_invalid(checked_index) or (proof_expr_has_call(checked_index) and not (unsigned_conversion.known and proof_expr_calls_are_conversions(checked_index, functions, 0))) or proof_expr_has_move(checked_index):
                report.proof_obligation(false)
                proof_add_finding(report, "index-bounds-opaque", position.line, name, "indexed access has no statically tracked collection bound")
                return
            lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, checked_index, position)
            count: Ast::Expr = Ast::Expr.Field(object, "count", position)
            upper: Ast::Expr = Ast::Expr.Binary(checked_index, TokenKind.Lt, count, position)
            return if not proof_index_safety_preflight_fact_work(checked_facts, 1, report, name, position.line)
            lower_proven: bool = (proof_certify_goal_with_rule_shared(checked_facts, lower, report, position.line, name, annotations, "index-lower") can Global{Read,Write})
            report.proof_obligation(lower_proven)
            proof_add_latest_goal_finding(report, "index-lower-unproven", position.line, name, "indexed access may use a negative position") if not lower_proven
            # The array type establishes its count, never this particular index's
            # safety. Keep the index relation in the ordinary certificate so replay
            # must validate the bounds premises used to establish it.
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            fixed_lookup: (complete: bool, extent: i64) = proof_fixed_array_extent_for_object(object, fixed_names, fixed_extents, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, name, "fixed-array place matching exceeded its shared source-work budget", "fixed-array-place-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            fixed_extent: i64 = fixed_lookup.extent if fixed_lookup.complete else -1
            source_array: (complete: bool, found: bool) = proof_global_mutable_array_index_witness_with_work(checked_facts, report, object, name, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            if not source_array.complete:
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, name, "global array witness lookup exceeded its shared source-work budget", "global-array-witness-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            source_global_array: bool = source_array.found
            fixed_upper_proven: mutable bool = false
            if fixed_extent >= 0:
                fixed_upper: Ast::Expr = Ast::Expr.Binary(checked_index, TokenKind.Lt, Ast::Expr.IntLit(fixed_extent, position), position)
                return if not proof_index_safety_preflight_fact_work(checked_facts, PROOF_INDEX_SAFETY_PROBE_FACT_PASSES, report, name, position.line)
                fixed_upper_proven <- (proof_index_safety_goal_with_shared_work(checked_facts, fixed_upper, annotations, report, name, position.line) can Global{Read,Write})
                if source_global_array and fixed_upper_proven:
                    precondition_bound: (complete: bool, found: bool) = proof_global_mutable_array_has_precondition_bound(checked_facts, report, fixed_upper, name)
                    if not precondition_bound.complete:
                        source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", position.line, name, "global array witness fact scan exceeded its shared source-work budget", "global-array-witness-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return
                    if precondition_bound.found and not proof_add_global_mutable_array_index_bound_fact(checked_facts, report, upper, position.line, name):
                        source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", position.line, name, "global array witness fact scan exceeded its shared source-work budget", "global-array-witness-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return
                # The global case carries a replay-checked `object.count == extent` source
                # fact, so certify `index < object.count` from that fact and the program's
                # actual bounds evidence. Do not turn the successful literal check into an
                # unauthenticated generic type-bound trace.
                proof_add_type_bound_fact(checked_facts, report, upper, position.line, name) if fixed_upper_proven and not source_global_array
            # A signed position bounded by the count's own `i64` conversion: `0 <= x` and
            # `x < count.i64()` give `x < count`. `count` is a `usize`, so `count.i64()` is
            # `count` itself, a negative wrap, or a panic before the bound is read; a positive
            # `count.i64()` above a nonnegative `x` is therefore `count`. The `i64` bound is
            # certified like any goal, and only then is `x < count` recorded with type-bound
            # provenance, as the fixed-array extent above is.
            if not source_global_array and not fixed_upper_proven and lower_proven:
                converted_count: Ast::Expr = Ast::Expr.Call(Ast::Expr.Field(count, "i64", position), [], [], position)
                converted_upper: Ast::Expr = Ast::Expr.Binary(checked_index, TokenKind.Lt, converted_count, position)
                if proof_resource_function_name_count(functions, "i64") == 0:
                    return if not proof_index_safety_preflight_fact_work(checked_facts, PROOF_INDEX_SAFETY_PROBE_FACT_PASSES, report, name, position.line)
                    current_upper_proven: bool = proof_index_safety_goal_with_shared_work(checked_facts, upper, annotations, report, name, position.line) can Global{Read,Write}
                    if not current_upper_proven:
                        return if not proof_index_safety_preflight_fact_work(checked_facts, PROOF_INDEX_SAFETY_PROBE_FACT_PASSES, report, name, position.line)
                        converted_upper_proven: bool = proof_index_safety_goal_with_shared_work(checked_facts, converted_upper, annotations, report, name, position.line) can Global{Read,Write}
                        if converted_upper_proven:
                            return if not proof_index_safety_preflight_fact_work(checked_facts, 1, report, name, position.line)
                            converted_proven: bool = (proof_certify_goal_with_rule_shared(checked_facts, converted_upper, report, position.line, name, annotations, "index-upper") can Global{Read,Write})
                            report.proof_obligation(converted_proven)
                            proof_add_type_bound_fact(checked_facts, report, upper, position.line, name) if converted_proven
            proof_add_dynamic_array_guard_bound(checked_facts, report, upper, name, position.line)
            return if not proof_index_safety_preflight_fact_work(checked_facts, 1, report, name, position.line)
            upper_proven: bool = (proof_certify_goal_with_rule_shared(checked_facts, upper, report, position.line, name, annotations, "index-upper") can Global{Read,Write})
            report.proof_obligation(upper_proven)
            proof_add_latest_goal_finding(report, "index-upper-unproven", position.line, name, "indexed access may exceed the collection bound") if not upper_proven

        # A compiler `IndexN` can denote nested fixed-array access (`matrix[row, column]`).
        # Check each argument against the corresponding literal dimension. This is deliberately
        # narrower than treating every IndexN as nested indexing: generic applications, dynamic
        # inner arrays, calls, and aliases have no independently tracked storage bound here.
        def proof_check_indexn_access(object: Ast::Expr, arguments: darray[Ast::Expr]&, position: Ast::Pos, facts: mutable darray[Ast::Expr]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: mutable ProofFunctionTable&) -> void can[Global.Read, Global.Write]:
            if arguments.count == 0 or not proof_indexable_object(object) or proof_expr_has_call(object) or proof_expr_has_move(object):
                report.proof_obligation(false)
                proof_add_finding(report, "index-bounds-opaque", position.line, name, "multi-index access has no checked heap bound model")
                return
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            fixed_dimensions_result: (complete: bool, dimensions: darray[i64]) = proof_fixed_array_dimensions_for_object(object, fixed_names, fixed_extents, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, name, "fixed-array place matching exceeded its shared source-work budget", "fixed-array-place-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            fixed_dimensions: darray[i64] = fixed_dimensions_result.dimensions if fixed_dimensions_result.complete else []
            dimension: mutable usize = 0
            for index in arguments |facts, fixed_dimensions, report, name, annotations, position, dimension, functions|:
                checked_index: mutable Ast::Expr = index
                return if not proof_index_safety_take_source_work(report, name, position.line, facts.count)
                checked_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                if proof_expr_has_call(index):
                    resolved: (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) = (proof_index_call_result(index, facts, functions, annotations, &checked_facts, report, name, true) can Global{Read,Write})
                    if resolved.known:
                        checked_index <- resolved.value
                    else:
                        checked_index <- Ast::Expr.Invalid
                if proof_expr_is_invalid(checked_index) or proof_expr_has_call(checked_index) or proof_expr_has_move(checked_index):
                    report.proof_obligation(false)
                    proof_add_finding(report, "index-bounds-opaque", position.line, name, "multi-index position has no statically checked value")
                else:
                    extent: i64 = fixed_dimensions[dimension] if dimension < fixed_dimensions.count else -1
                    if extent < 0:
                        report.proof_obligation(false)
                        proof_add_finding(report, "index-bounds-opaque", position.line, name, "multi-index dimension has no statically tracked bound")
                    else:
                        lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, checked_index, position)
                        upper: Ast::Expr = Ast::Expr.Binary(checked_index, TokenKind.Lt, Ast::Expr.IntLit(extent, position), position)
                        return if not proof_index_safety_preflight_fact_work(checked_facts, 1, report, name, position.line)
                        lower_proven: bool = (proof_certify_goal_with_rule_shared(checked_facts, lower, report, position.line, name, annotations, "index-lower") can Global{Read,Write})
                        report.proof_obligation(lower_proven)
                        proof_add_latest_goal_finding(report, "index-lower-unproven", position.line, name, "multi-index position may be negative") if not lower_proven
                        return if not proof_index_safety_preflight_fact_work(checked_facts, 1, report, name, position.line)
                        upper_proven: bool = (proof_certify_goal_with_rule_shared(checked_facts, upper, report, position.line, name, annotations, "index-upper") can Global{Read,Write})
                        report.proof_obligation(upper_proven)
                        proof_add_latest_goal_finding(report, "index-upper-unproven", position.line, name, "multi-index position may exceed its fixed dimension") if not upper_proven
                dimension <- dimension + 1

        # The checked-index operator is a compiler/runtime boundary, not an arithmetic claim:
        # either the guarded load is in range or the fallback is selected. Record a dedicated
        # certificate so a successful report cannot silently omit this memory-safety transition.
        # The selected element remains opaque; value properties must still be proved separately.
        def proof_certify_checked_index(expression: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32) -> void:
            if not proof_kernel_expression_supported(expression):
                report.proof_obligation(false)
                proof_add_finding(report, "checked-index-unsupported", line, name, "checked index expression is outside the replayable kernel fragment")
                return
            empty_checked_facts: darray[Ast::Expr] = []
            attempt_count: usize = report.results.goal_attempts.count
            proof_add_goal_attempt(report, empty_checked_facts, expression, line, name, "checked-index", true)
            attempt_proven: bool = report.results.goal_attempts.count > attempt_count and report.results.goal_attempts[report.results.goal_attempts.count - 1].producer_proven
            report.proof_obligation(attempt_proven)

        # A control-recovery get (`get collection[index] else return/raise/break/continue`)
        # provides the same runtime no-load guarantee as the value-fallback form, but its
        # recovery is not an expression and therefore cannot be represented by the checked-index
        # arena node. Emit a distinct certificate so replay cannot confuse the two semantics.
        def proof_certify_checked_get(expression: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32) -> void:
            if not proof_kernel_expression_supported(expression):
                report.proof_obligation(false)
                proof_add_finding(report, "checked-get-unsupported", line, name, "checked get expression is outside the replayable kernel fragment")
                return
            empty_checked_facts: darray[Ast::Expr] = []
            attempt_count: usize = report.results.goal_attempts.count
            proof_add_goal_attempt(report, empty_checked_facts, expression, line, name, "checked-get", true)
            attempt_proven: bool = report.results.goal_attempts.count > attempt_count and report.results.goal_attempts[report.results.goal_attempts.count - 1].producer_proven
            report.proof_obligation(attempt_proven)

        # Slices use an exclusive high endpoint (`object[low:high]`). Open endpoints are
        # already represented by Ast::Expr.Absent and inherit the implicit safe bounds 0 and
        # object.count. As with single indexes, a receiver whose storage shape is not directly
        # tracked is unsupported rather than guessed; this avoids treating an arbitrary view or
        # returned collection as if its `.count` were the backing allocation's bound.
        def proof_check_slice_access(object: Ast::Expr, low: Ast::Expr, high: Ast::Expr, position: Ast::Pos, facts: mutable darray[Ast::Expr]&, fixed_names: darray[Ast::Expr]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: mutable ProofFunctionTable&) -> void can[Global.Read, Global.Write]:
            checked_low: mutable Ast::Expr = low
            checked_high: mutable Ast::Expr = high
            return if not proof_index_safety_take_source_work(report, name, position.line, facts.count)
            checked_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            if proof_expr_has_call(low):
                resolved_low: (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) = (proof_index_call_result(low, facts, functions, annotations, &checked_facts, report, name, true) can Global{Read,Write})
                if resolved_low.known:
                    checked_low <- resolved_low.value
                else:
                    checked_low <- Ast::Expr.Invalid
            if proof_expr_has_call(high):
                resolved_high: (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) = (proof_index_call_result(high, facts, functions, annotations, &checked_facts, report, name, true) can Global{Read,Write})
                if resolved_high.known:
                    checked_high <- resolved_high.value
                else:
                    checked_high <- Ast::Expr.Invalid
            if not proof_indexable_object(object) or proof_expr_has_call(object) or proof_expr_has_move(object) or proof_expr_is_invalid(checked_low) or proof_expr_has_move(checked_low) or proof_expr_is_invalid(checked_high) or proof_expr_has_move(checked_high):
                report.proof_obligation(false)
                proof_add_finding(report, "slice-bounds-opaque", position.line, name, "slice has no statically tracked collection bound")
                return
            match checked_low:
                Ast::Expr.Absent:
                    pass
                _:
                    lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, checked_low, position)
                    return if not proof_index_safety_preflight_fact_work(checked_facts, 1, report, name, position.line)
                    lower_proven: bool = (proof_certify_goal_with_rule_shared(checked_facts, lower, report, position.line, name, annotations, "slice-lower") can Global{Read,Write})
                    report.proof_obligation(lower_proven)
                    proof_add_latest_goal_finding(report, "slice-lower-unproven", position.line, name, "slice may begin before the collection") if not lower_proven
            match checked_high:
                Ast::Expr.Absent:
                    pass
                _:
                    count: Ast::Expr = Ast::Expr.Field(object, "count", position)
                    upper: Ast::Expr = Ast::Expr.Binary(checked_high, TokenKind.LtEq, count, position)
                    # A fixed array contributes its declared count equality. The
                    # slice endpoint must still follow from replayed index premises.
                    source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
                    fixed_lookup: (complete: bool, extent: i64) = proof_fixed_array_extent_for_object(object, fixed_names, fixed_extents, &source_work)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        report.proof_obligation(false)
                        proof_add_budget_finding(report, "resource-analysis-budget", position.line, name, "fixed-array place matching exceeded its shared source-work budget", "fixed-array-place-work", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return
                    fixed_extent: i64 = fixed_lookup.extent if fixed_lookup.complete else -1
                    if fixed_extent >= 0:
                        fixed_upper: Ast::Expr = Ast::Expr.Binary(checked_high, TokenKind.LtEq, Ast::Expr.IntLit(fixed_extent, position), position)
                        return if not proof_index_safety_preflight_fact_work(checked_facts, PROOF_INDEX_SAFETY_PROBE_FACT_PASSES, report, name, position.line)
                        if (proof_index_safety_goal_with_shared_work(checked_facts, fixed_upper, annotations, report, name, position.line) can Global{Read,Write}):
                            proof_add_type_bound_fact(checked_facts, report, upper, position.line, name)
                    return if not proof_index_safety_preflight_fact_work(checked_facts, 1, report, name, position.line)
                    upper_proven: bool = (proof_certify_goal_with_rule_shared(checked_facts, upper, report, position.line, name, annotations, "slice-upper") can Global{Read,Write})
                    report.proof_obligation(upper_proven)
                    proof_add_latest_goal_finding(report, "slice-upper-unproven", position.line, name, "slice may end beyond the collection") if not upper_proven
            match checked_low:
                Ast::Expr.Absent:
                    pass
                _:
                    match checked_high:
                        Ast::Expr.Absent:
                            pass
                        _:
                            ordered: Ast::Expr = Ast::Expr.Binary(checked_low, TokenKind.LtEq, checked_high, position)
                            return if not proof_index_safety_preflight_fact_work(checked_facts, 1, report, name, position.line)
                            ordered_proven: bool = (proof_certify_goal_with_rule_shared(checked_facts, ordered, report, position.line, name, annotations, "slice-order") can Global{Read,Write})
                            report.proof_obligation(ordered_proven)
                            proof_add_latest_goal_finding(report, "slice-order-unproven", position.line, name, "slice bounds may be reversed") if not ordered_proven
