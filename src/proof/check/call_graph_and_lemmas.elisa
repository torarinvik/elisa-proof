extend ElisaProof:
    private:
        const PROOF_FRAME_WHOLE_CHANGE_ROW: u32 = 3900000010
        const PROOF_FRAME_CHANGE_ROOT_ROW: u32 = 3900000006
        const PROOF_FRAME_CHANGE_FIELD_ROW: u32 = 3900000003
        const PROOF_FRAME_PRESERVE_ROOT_ROW: u32 = 3900000011
        const PROOF_FRAME_PRESERVE_FIELD_ROW: u32 = 3900000012
        const PROOF_FRAME_CHANGED_FIELD_FALLBACK_ROW: u32 = 3900000077

        def proof_expr_may_be_opaque_reference(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return true
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Index(_, _, _):
                    return true
                Ast::Expr.Slice(_, _, _, _):
                    return true
                Ast::Expr.IndexN(_, _, _):
                    return true
                Ast::Expr.Move(operand, _):
                    return proof_expr_may_be_opaque_reference(operand)
                Ast::Expr.RegionNew(_, _, _):
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_expr_may_be_opaque_reference(object)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return proof_expr_may_be_opaque_reference(base)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_may_be_opaque_reference(condition) or proof_expr_may_be_opaque_reference(then_expr) or proof_expr_may_be_opaque_reference(else_expr)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_may_be_opaque_reference(iterable) or proof_expr_may_be_opaque_reference(condition) or proof_expr_may_be_opaque_reference(body)
                Ast::Expr.Paren(inner, _):
                    return proof_expr_may_be_opaque_reference(inner)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_may_be_opaque_reference(operand)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_may_be_opaque_reference(left) or proof_expr_may_be_opaque_reference(right)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if proof_expr_may_be_opaque_reference(field.value)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_may_be_opaque_reference(element)
                    return false
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_may_be_opaque_reference(element)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_may_be_opaque_reference(element)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_may_be_opaque_reference(entry.key) or proof_expr_may_be_opaque_reference(entry.value)
                    return false
                _:
                    return false

        # A call argument aliases a frame place only for the direct forms this kernel can
        # justify. Passing a whole root may expose every descendant; passing &root.field exposes
        # that subtree. Unknown aliases cause the caller's facts to be discarded but do not
        # silently establish frame preservation.
        def proof_argument_may_alias_place(argument: Ast::Expr, place: ProofFramePlace) -> bool:
            root: sview = proof_ident_name(argument)
            return true if root != "" and root == place.root
            match argument:
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(operand)
                        return true if addressed.known and proof_frame_places_overlap(addressed.place, place)
                    return proof_argument_may_alias_place(operand, place)
                Ast::Expr.Paren(inner, _):
                    return proof_argument_may_alias_place(inner, place)
                Ast::Expr.Field(_, _, _):
                    addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(argument)
                    return addressed.known and proof_frame_places_overlap(addressed.place, place)
                Ast::Expr.Index(_, _, _):
                    addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(argument)
                    return addressed.known and proof_frame_places_overlap(addressed.place, place)
                Ast::Expr.Slice(_, _, _, _):
                    addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(argument)
                    return addressed.known and proof_frame_places_overlap(addressed.place, place)
                Ast::Expr.IndexN(_, _, _):
                    addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(argument)
                    return addressed.known and proof_frame_places_overlap(addressed.place, place)
                _:
                    return false

        # Extract the storage root from an assignment target. The returned expression is kept
        # structured so symbolic substitution can resolve a local reference alias to a parameter
        # before the frame decision is made.
        def proof_frame_target_root(expression: Ast::Expr) -> Ast::Expr:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_frame_target_root(inner)
                Ast::Expr.Field(object, _, _):
                    return proof_frame_target_root(object)
                Ast::Expr.Index(object, _, _):
                    return proof_frame_target_root(object)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_frame_target_root(object)
                Ast::Expr.IndexN(object, _, _):
                    return proof_frame_target_root(object)
                _:
                    return expression

        def proof_call_may_alias_places(arguments: darray[Ast::Expr]&, places: darray[ProofFramePlace]&, names: darray[sview]&, parameter_names: darray[sview]&) -> bool:
            for argument in arguments:
                for place in places:
                    return true if proof_argument_may_alias_place(argument, place) and proof_current_parameter(names, parameter_names, place.root)
            return false

        def proof_frame_alias_scan_text_cost(text: sview, total: mutable usize&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            length: usize = sview_len(text)
            if length >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            amount: usize = length + 1
            if total > PROOF_LINEAR_SAFETY_WORK_LIMIT - amount:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            total <- total + amount
            proof_linear_safety_work_charge(budget, exhausted, amount)

        def proof_frame_source_work_report_exhaustion(report: mutable ProofReport&, name: sview, line: u32, dimension: sview, message: sview) -> void:
            if not report.analysis_1.budgets.frame_call_reported:
                report.analysis_1.budgets.frame_call_reported <- true
                proof_add_budget_finding(report, "frame-analysis-budget", line, name, message, dimension, report.analysis_1.budgets.frame_call_source_work, PROOF_LINEAR_SAFETY_WORK_LIMIT)

        def proof_frame_source_work_stop(report: mutable ProofReport&, name: sview, line: u32) -> bool:
            return false if report.analysis_1.budgets.frame_call_source_work < PROOF_LINEAR_SAFETY_WORK_LIMIT
            proof_frame_source_work_report_exhaustion(report, name, line, "frame-expression-work", "frame expression traversal exhausted its bounded source-work budget")
            true

        def proof_frame_source_work_take(report: mutable ProofReport&, name: sview, line: u32, amount: usize, dimension: sview, message: sview) -> bool:
            work: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            complete: bool = proof_linear_safety_work_charge(&work, &exhausted, amount)
            report.analysis_1.budgets.frame_call_source_work <- work
            if not complete:
                proof_frame_source_work_report_exhaustion(report, name, line, dimension, message)
            complete

        # Reserve legacy expression scans before they run. Short-circuit classification needs two
        # passes; opaque-expression classification needs one.
        def proof_frame_expression_rechecks_with_work(expression: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32, passes: usize) -> bool:
            work: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, &work, &exhausted)
            complete: mutable bool = cost.complete
            if complete:
                complete <- proof_linear_safety_work_charge_scaled(&work, &exhausted, cost.cost, passes)
            report.analysis_1.budgets.frame_call_source_work <- work
            if not complete:
                proof_frame_source_work_report_exhaustion(report, name, line, "frame-expression-recheck-work", "frame expression classification exceeded its bounded source-work budget")
            complete

        def proof_frame_expr_equal_with_work(left: Ast::Expr, right: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32) -> (complete: bool, equal: bool):
            work: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            left_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(left, &work, &exhausted)
            if not left_cost.complete:
                report.analysis_1.budgets.frame_call_source_work <- work
                proof_frame_source_work_report_exhaustion(report, name, line, "frame-fact-comparison-work", "frame fact comparison exceeded its bounded source-work budget")
                return (false, false)
            right_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(right, &work, &exhausted)
            if not right_cost.complete:
                report.analysis_1.budgets.frame_call_source_work <- work
                proof_frame_source_work_report_exhaustion(report, name, line, "frame-fact-comparison-work", "frame fact comparison exceeded its bounded source-work budget")
                return (false, false)
            comparison_cost: usize = left_cost.cost + right_cost.cost
            complete: bool = proof_linear_safety_work_charge_scaled(&work, &exhausted, comparison_cost, 1)
            report.analysis_1.budgets.frame_call_source_work <- work
            if not complete:
                proof_frame_source_work_report_exhaustion(report, name, line, "frame-fact-comparison-work", "frame fact comparison exceeded its bounded source-work budget")
                return (false, false)
            return (true, proof_expr_equal(left, right))

        # The legacy place matcher descends each argument and rechecks nested selector prefixes.
        # Reserve a quadratic AST bound per argument/place pair, plus all place and binding-name
        # comparisons, before calling it. Exhaustion means "may alias" so no frame is preserved.
        def proof_call_may_alias_places_with_work(arguments: darray[Ast::Expr]&, places: darray[ProofFramePlace]&, names: darray[sview]&, parameter_names: darray[sview]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, may_alias: bool):
            if exhausted:
                return (false, true)
            if arguments.count == 0 or places.count == 0:
                return (true, false)
            if arguments.count > PROOF_LINEAR_SAFETY_WORK_LIMIT / places.count:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return (false, true)
            pair_count: usize = arguments.count * places.count
            return (false, true) if not proof_linear_safety_work_charge_scaled(budget, exhausted, pair_count, 1)
            argument_scan_cost: mutable usize = 0
            for argument in arguments |argument, argument_scan_cost, budget, exhausted|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(argument, budget, exhausted)
                return (false, true) if:
                    not cost.complete
                    not proof_linear_safety_work_charge(budget, exhausted, 1)
                if cost.cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                    budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                    exhausted <- true
                    return (false, true)
                increment: usize = cost.cost + 1
                if increment > PROOF_LINEAR_SAFETY_WORK_LIMIT - argument_scan_cost:
                    budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                    exhausted <- true
                    return (false, true)
                argument_scan_cost <- argument_scan_cost + increment
            # For each argument/place pair the legacy prefix checker can re-scan the entire
            # argument once per nested selector. Reserve O(AST^2), not just O(AST), before it.
            return (false, true) if not proof_linear_safety_work_charge_product4_with_work(budget, exhausted, argument_scan_cost, argument_scan_cost, places.count, 4, 1)
            place_scan_cost: mutable usize = 0
            for place in places |place, place_scan_cost, budget, exhausted|:
                return (false, true) if:
                    not proof_linear_safety_work_charge(budget, exhausted, 1)
                    not proof_frame_alias_scan_text_cost(place.root, &place_scan_cost, &budget, &exhausted)
                    not proof_frame_alias_scan_text_cost(place.field, &place_scan_cost, &budget, &exhausted)
                    not proof_frame_alias_scan_text_cost(place.field2, &place_scan_cost, &budget, &exhausted)
                    not proof_frame_alias_scan_text_cost(place.field3, &place_scan_cost, &budget, &exhausted)
            if arguments.count > PROOF_LINEAR_SAFETY_WORK_LIMIT / 4:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return (false, true)
            place_repetitions: usize = arguments.count * 4
            return (false, true) if not proof_linear_safety_work_charge_scaled(budget, exhausted, place_scan_cost, place_repetitions)
            parameter_scan_cost: mutable usize = 1
            for name in names |name, parameter_scan_cost, budget, exhausted|:
                return (false, true) if not proof_frame_alias_scan_text_cost(name, &parameter_scan_cost, &budget, &exhausted)
            for parameter in parameter_names |parameter, parameter_scan_cost, budget, exhausted|:
                return (false, true) if not proof_frame_alias_scan_text_cost(parameter, &parameter_scan_cost, &budget, &exhausted)
            if parameter_scan_cost > (PROOF_LINEAR_SAFETY_WORK_LIMIT - 4) / 2:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return (false, true)
            pair_comparison_cost: usize = parameter_scan_cost * 2 + 4
            return (false, true) if not proof_linear_safety_work_charge_scaled(budget, exhausted, pair_count, pair_comparison_cost)
            (true, proof_call_may_alias_places(arguments, places, names, parameter_names))

        def proof_frame_call_may_alias_places_with_work(arguments: darray[Ast::Expr]&, places: darray[ProofFramePlace]&, names: darray[sview]&, parameter_names: darray[sview]&, report: mutable ProofReport&, name: sview, line: u32) -> (complete: bool, may_alias: bool):
            work: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            result: (complete: bool, may_alias: bool) = proof_call_may_alias_places_with_work(arguments, places, names, parameter_names, &work, &exhausted)
            report.analysis_1.budgets.frame_call_source_work <- work
            if exhausted:
                proof_frame_source_work_report_exhaustion(report, name, line, "place-alias-work", "frame place analysis exceeded its bounded source-work budget")
            result

        def proof_frame_collect_annotations(file: Ast::File&, frame_index: ProofFrameAnnotationIndex, function_name: sview, changes: mutable darray[ProofFramePlace]&, preserves: mutable darray[ProofFramePlace]&) -> void:
            header_change_roots: mutable darray[sview] = []
            header_change_fields: mutable darray[sview] = []
            preserved_roots: mutable darray[sview] = []
            preserved_fields: mutable darray[sview] = []
            owner_index: usize = proof_frame_annotation_owner(frame_index, function_name)
            return if owner_index >= frame_index.owner_names.count
            annotation_row: mutable usize = frame_index.head_indices[owner_index]
            while annotation_row < frame_index.annotation_indices.count |annotation_row, file, frame_index, owner_index, function_name, header_change_roots, header_change_fields, preserved_roots, preserved_fields|:
                annotation: Ast::EnumAnnotation = file.enum_annotations[frame_index.annotation_indices[annotation_row]]
                if annotation.owner == function_name and annotation.line == PROOF_FRAME_WHOLE_CHANGE_ROW:
                    changes.push(ProofFramePlace{root: annotation.name, field: "", field2: "", field3: "", depth: 0, whole: true})
                if annotation.owner == function_name and annotation.line == PROOF_FRAME_CHANGE_ROOT_ROW:
                    header_change_roots.push(annotation.name)
                if annotation.owner == function_name and annotation.line == PROOF_FRAME_CHANGE_FIELD_ROW:
                    header_change_fields.push(annotation.name)
                if annotation.owner == function_name and annotation.line == PROOF_FRAME_PRESERVE_ROOT_ROW:
                    preserved_roots.push(annotation.name)
                if annotation.owner == function_name and annotation.line == PROOF_FRAME_PRESERVE_FIELD_ROW:
                    preserved_fields.push(annotation.name)
                # This marker is emitted by the parser's conflict scanner for dotted changes
                # targets. It is useful only as a field fallback when the paired capture is
                # absent; the paired 0006/0003 rows above retain the exact root.
                if annotation.owner == function_name and annotation.line == PROOF_FRAME_CHANGED_FIELD_FALLBACK_ROW and header_change_fields.count == 0:
                    header_change_fields.push(annotation.name)
                annotation_row <- frame_index.next_indices[annotation_row]
            for index in 0..<header_change_fields.count |changes, header_change_roots, header_change_fields, index|:
                root: sview = header_change_roots[index] if index < header_change_roots.count else ""
                changes.push(ProofFramePlace{root: root, field: header_change_fields[index], field2: "", field3: "", depth: 1, whole: false})
            index: mutable usize = 0
            while index < preserved_roots.count and index < preserved_fields.count |index, preserved_roots, preserved_fields, preserves|:
                preserves.push(ProofFramePlace{root: preserved_roots[index], field: preserved_fields[index], field2: "", field3: "", depth: 1, whole: false})
                index <- index + 1

        # Name lookup is on a hot path during call-graph construction and SCC analysis. The
        # hash is only a collision-safe prefilter; the exact sview comparison below remains the
        # authority, so this optimization cannot turn a collision into a resolved call.
        def proof_name_hash(value: sview) -> u32:
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            for index in 0..<sview_len(value) |index, hash, value|:
                hash <- ((hash ^ sview_at(value, index).i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return hash.u32()

        # Keep graph traversal termination explicit. This avoids depending on a higher-order
        # membership expression inside a mutable worklist, and makes the finite exploration
        # invariant directly auditable in the self-hosted checker.
        def proof_usize_seen(values: darray[usize]&, wanted: usize) -> bool:
            for value in values:
                return true if value == wanted
            return false

        # Build the flat lemma summary used by the compiler's assert-by checker.
        # A call can contribute only a postcondition from a lemma whose preconditions are
        # established at the call site; opaque ordinary functions never contribute facts.
        def proof_collect_lemmas(file: Ast::File&, declarations: darray[Ast::Decl], lemma_markers: ProofLemmaAnnotationIndex, owner_module: sview, lemmas: mutable ProofLemmaTable&, source_work: mutable usize&) -> void:
            for declaration in declarations |file, owner_module, lemmas, source_work|:
                if not proof_report_source_work_charge(1, source_work):
                    source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                    return
                match declaration:
                    Ast::Decl.Func(name, parameters, return_type, body, _, _, position):
                        lemma_marker: (complete: bool, is_lemma: bool) = proof_function_is_lemma_with_work(lemma_markers, name, source_work)
                        if not lemma_marker.complete:
                            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                            return
                        if lemma_marker.is_lemma:
                            # Charge the lemma table's fixed parallel-row writes and all
                            # parameter metadata before mutating the table. Body traversal
                            # work is reserved separately from the AST cost preflight below.
                            if parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3 or not proof_report_source_work_charge(16, source_work) or not proof_report_source_work_charge(parameters.count * 3, source_work) or not proof_report_source_work_charge(sview_len(name), source_work):
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            body_cost: mutable usize = 0
                            if not proof_replay_summary_expr_cost_body(body, &body_cost, source_work, 0):
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            remaining_work: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                            # The preflight itself walks the body once; call collection,
                            # call-row appending, decreases flattening, and contract census
                            # each make another body-sized pass.
                            if body_cost > remaining_work / 5:
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            source_work <- source_work + body_cost * 5
                            signature_contracts: (complete: bool, preconditions: darray[Ast::Expr], postconditions: darray[Ast::Expr]) = proof_signature_contracts_for_line_with_work(file, position.line, source_work)
                            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1 if not signature_contracts.complete
                            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            lemmas.identity.names <- lemmas.identity.names.push(name)
                            lemmas.identity.owner_modules <- lemmas.identity.owner_modules.push(owner_module)
                            lemmas.identity.lines <- lemmas.identity.lines.push(position.line)
                            lemmas.identity.offsets <- lemmas.identity.offsets.push(position.offset)
                            lemmas.identity.name_hashes <- lemmas.identity.name_hashes.push(proof_name_hash(name))
                            lemmas.parameters.param_starts <- lemmas.parameters.param_starts.push(lemmas.parameters.all_params.count)
                            lemmas.parameters.param_counts <- lemmas.parameters.param_counts.push(parameters.count)
                            for parameter in parameters |lemmas|:
                                lemmas.parameters.all_params <- lemmas.parameters.all_params.push(parameter.name)
                                lemmas.parameters.all_has_defaults <- lemmas.parameters.all_has_defaults.push(parameter.has_default)
                                lemmas.parameters.all_defaults <- lemmas.parameters.all_defaults.push(parameter.default_value)
                            lemmas.termination.call_starts <- lemmas.termination.call_starts.push(lemmas.termination.all_calls.count)
                            lemma_call_names: mutable darray[sview] = []
                            proof_collect_lemma_body_call_names(body, &lemma_call_names)
                            body_call_count: usize = lemma_call_names.count
                            for requirement in signature_contracts.preconditions |lemma_call_names, source_work|:
                                if not proof_replay_summary_expr_repeat_charge_with_work(requirement, 1, source_work):
                                    source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                    return
                                proof_collect_lemma_call_names(requirement, &lemma_call_names)
                            for ensure in signature_contracts.postconditions |lemma_call_names, source_work|:
                                if not proof_replay_summary_expr_repeat_charge_with_work(ensure, 1, source_work):
                                    source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                    return
                                proof_collect_lemma_call_names(ensure, &lemma_call_names)
                            if lemma_call_names.count < body_call_count:
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            if not proof_report_source_work_charge(lemma_call_names.count - body_call_count, source_work):
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            for called in lemma_call_names |lemmas|:
                                lemmas.termination.all_calls <- lemmas.termination.all_calls.push(called)
                            lemmas.termination.call_counts <- lemmas.termination.call_counts.push(lemma_call_names.count)
                            lemmas.termination.decreases_starts <- lemmas.termination.decreases_starts.push(lemmas.termination.all_decreases.count)
                            decreases_components: mutable darray[Ast::Expr] = []
                            has_unbounded_decreases: mutable bool = false
                            for statement in body |decreases_components, has_unbounded_decreases|:
                                match statement:
                                    Ast::Stmt.Contract(kind, expression, _):
                                        proof_decreases_components(expression, &decreases_components) if kind == "decreases"
                                        has_unbounded_decreases <- true if kind == "decreases*"
                                    _:
                                        pass
                            lemmas.termination.all_decreases.extend(decreases_components)
                            lemmas.termination.decreases_counts <- lemmas.termination.decreases_counts.push(decreases_components.count)
                            lemmas.termination.decreases_unbounded <- lemmas.termination.decreases_unbounded.push(has_unbounded_decreases)
                            lemmas.contracts.requires_starts <- lemmas.contracts.requires_starts.push(lemmas.contracts.all_requires.count)
                            lemmas.contracts.ensure_starts <- lemmas.contracts.ensure_starts.push(lemmas.contracts.all_ensures.count)
                            requires_count: mutable usize = 0
                            ensures_count: mutable usize = 0
                            for statement in body |lemmas, requires_count, ensures_count|:
                                match statement:
                                    Ast::Stmt.Contract(kind, expression, _):
                                        if kind == "requires":
                                            lemmas.contracts.all_requires <- lemmas.contracts.all_requires.push(expression)
                                            requires_count <- requires_count + 1
                                        if proof_is_ensure_kind(kind):
                                            lemmas.contracts.all_ensures <- lemmas.contracts.all_ensures.push(expression)
                                            ensures_count <- ensures_count + 1
                                    _:
                                        pass
                            if not proof_report_source_work_charge(signature_contracts.preconditions.count, source_work) or not proof_report_source_work_charge(signature_contracts.postconditions.count, source_work):
                                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                                return
                            lemmas.contracts.all_requires.extend(signature_contracts.preconditions)
                            lemmas.contracts.all_ensures.extend(signature_contracts.postconditions)
                            requires_count <- requires_count + signature_contracts.preconditions.count
                            ensures_count <- ensures_count + signature_contracts.postconditions.count
                            lemmas.contracts.requires_counts <- lemmas.contracts.requires_counts.push(requires_count)
                            lemmas.contracts.ensure_counts <- lemmas.contracts.ensure_counts.push(ensures_count)
                    Ast::Decl.Module(module_name, module_body, _):
                        proof_collect_lemmas(file, module_body, lemma_markers, module_name, lemmas, source_work)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_collect_lemmas(file, scoped_body, lemma_markers, owner_module, lemmas, source_work)
                    _:
                        pass

        def proof_lemma_index(lemmas: ProofLemmaTable&, name: sview) -> usize:
            capacity: usize = lemmas.identity.index_values.count
            return lemmas.identity.names.count if capacity == 0 or capacity != lemmas.identity.index_hashes.count or capacity != lemmas.identity.index_ambiguous.count
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes < PROOF_NAME_INDEX_MAX_CLUSTER + 1 |probes, slot, wanted_hash, name, lemmas, capacity|:
                current: usize = lemmas.identity.index_values[slot]
                return lemmas.identity.names.count if current == lemmas.identity.names.count or current >= lemmas.identity.names.count
                if lemmas.identity.index_hashes[slot] == wanted_hash and lemmas.identity.names[current] == name:
                    return lemmas.identity.names.count if lemmas.identity.index_ambiguous[slot]
                    return current
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return lemmas.identity.names.count

        # Lemmas are theorem declarations, not executable summaries. A recursive lemma cannot
        # use its own postcondition as an induction hypothesis unless the kernel also checks a
        # well-founded proof. Keep the graph conservative: unknown/opaque proof-body calls are
        # treated as a possible hidden edge for the queried node, so a future AST form cannot
        # smuggle a recursive lemma back into the summary table.
        def proof_lemma_reaches(lemmas: ProofLemmaTable&, source: usize, target: usize) -> bool:
            return false if source >= lemmas.identity.names.count or target >= lemmas.identity.names.count
            reachable: mutable darray[usize] = [source]
            cursor: mutable usize = 0
            while cursor < reachable.count |cursor, reachable, lemmas, target|:
                current: usize = reachable[cursor]
                return true if current == target and (current >= lemmas.termination.call_starts.count or current >= lemmas.termination.call_counts.count)
                return false if current >= lemmas.termination.call_starts.count or current >= lemmas.termination.call_counts.count
                start: usize = lemmas.termination.call_starts[current]
                count: usize = lemmas.termination.call_counts[current]
                for offset in 0..<count |offset, start, lemmas, reachable, target|:
                    return true if current == target and start + offset >= lemmas.termination.all_calls.count
                    continue if start + offset >= lemmas.termination.all_calls.count
                    called: sview = lemmas.termination.all_calls[start + offset]
                    if called == "__opaque_call__":
                        return true if current == target
                    else:
                        next: usize = proof_lemma_index(lemmas, called)
                        if next < lemmas.identity.names.count:
                            return true if next == target
                            already_seen: bool = proof_usize_seen(reachable, next)
                            reachable.push(next) if not already_seen
                cursor <- cursor + 1
            return false
