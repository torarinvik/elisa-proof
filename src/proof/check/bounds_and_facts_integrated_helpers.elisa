# Factored helpers retained by the branch integration.
extend ElisaProof:
    private:
        def proof_unsigned_type_width(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            primitive: i64 = proof_unsigned_primitive_width(expression)
            return primitive if primitive > 0
            match expression:
                Ast::Expr.Refinement(base, _, _):
                    # A predicate restricts inhabitants; it does not change the base type's
                    # machine arithmetic. Preserve the width even for a vacuous predicate.
                    return proof_unsigned_type_width(base, declarations, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_type_width(inner, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_unsigned_type_width(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                Ast::Expr.Ident(name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return -1 if alias.count > 1
                    return proof_unsigned_type_width(alias.target, declarations, depth + 1) if alias.count == 1
                Ast::Expr.Scope(_, name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    # A bare-name search cannot establish a qualified alias's owner.
                    return -1 if alias.count > 0
                _:
                    pass
            return 0

        def proof_signed_type_width(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            primitive: i64 = proof_signed_primitive_width(expression)
            return primitive if primitive > 0
            match expression:
                Ast::Expr.Refinement(base, _, _):
                    return proof_signed_type_width(base, declarations, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_signed_type_width(inner, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_signed_type_width(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                Ast::Expr.Ident(name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return -1 if alias.count > 1
                    return proof_signed_type_width(alias.target, declarations, depth + 1) if alias.count == 1
                Ast::Expr.Scope(_, name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return -1 if alias.count > 0
                _:
                    pass
            return 0

        def proof_unsigned_type_width_index(expression: Ast::Expr, index: ProofTypeAuditIndex, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not index.complete
            primitive: i64 = proof_unsigned_primitive_width(expression)
            return primitive if primitive > 0
            match expression:
                Ast::Expr.Refinement(base, _, _):
                    return proof_unsigned_type_width_index(base, index, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_type_width_index(inner, index, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_unsigned_type_width_index(inner, index, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                Ast::Expr.Ident(name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_index(index, name)
                    return -1 if alias.count > 1
                    return proof_unsigned_type_width_index(alias.target, index, depth + 1) if alias.count == 1
                Ast::Expr.Scope(_, name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_index(index, name)
                    return -1 if alias.count > 0
                _:
                    pass
            return 0

        def proof_signed_type_width_index(expression: Ast::Expr, index: ProofTypeAuditIndex, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not index.complete
            primitive: i64 = proof_signed_primitive_width(expression)
            return primitive if primitive > 0
            match expression:
                Ast::Expr.Refinement(base, _, _):
                    return proof_signed_type_width_index(base, index, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_signed_type_width_index(inner, index, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_signed_type_width_index(inner, index, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                Ast::Expr.Ident(name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_index(index, name)
                    return -1 if alias.count > 1
                    return proof_signed_type_width_index(alias.target, index, depth + 1) if alias.count == 1
                Ast::Expr.Scope(_, name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias_index(index, name)
                    return -1 if alias.count > 0
                _:
                    pass
            return 0

        # Type facts are re-established whenever a binding is re-symbolized. This is idempotent
        # within the current state: an existing fact is not pushed again, while a fact restored
        # into a fresh state receives a fresh provenance trace for that state.
        def proof_add_type_bound_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, owner: sview) -> void:
            for existing in facts |existing, expression|:
                return if proof_expr_equal(existing, expression)
            if not proof_fact_is_type_bound(report, expression, owner):
                report.type_bounds.seen.push(expression)
                report.type_bounds.seen_hashes.push(proof_expr_shape_hash(expression, 0))
            proof_add_traced_fact(facts, report, expression, "type-bound", line, owner)

        def proof_add_unsigned_binding_facts(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, width: i64, line: u32, owner: sview, position: Ast::Pos) -> void:
            return if name == "" or width <= 0
            lower_bound: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, Ast::Expr.Ident(name, position), position)
            proof_add_type_bound_fact(facts, report, lower_bound, line, owner)
            proof_add_type_bound_fact(facts, report, proof_unsigned_type_marker(name, width, position), line, owner)
            if width < PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH:
                upper: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident(name, position), TokenKind.LtEq, Ast::Expr.IntLit(proof_unsigned_width_max(width), position), position)
                proof_add_type_bound_fact(facts, report, upper, line, owner)

        # A signed parameter of fewer than 64 bits is bounded by its type on both sides. The floor
        # is spelled `-MAX - 1` because the bare literal `-MIN` reads as one past the width to the
        # typed constant guard, which then refuses every goal beside the fact (see AUDIT).
        def proof_add_signed_upper_bound_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, width: i64, line: u32, owner: sview, position: Ast::Pos) -> void:
            return if name == ""
            proof_add_signed_range_facts(facts, report, Ast::Expr.Ident(name, position), width, line, owner, position)

        # The same two type facts over any place of that signed type: a local, a field, a label.
        def proof_add_signed_range_facts(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, term: Ast::Expr, width: i64, line: u32, owner: sview, position: Ast::Pos) -> void:
            return if width <= 0 or width >= PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH
            upper: Ast::Expr = Ast::Expr.Binary(term, TokenKind.LtEq, Ast::Expr.IntLit(ElisaProofKernelCore::proof_kernel_signed_width_max(width), position), position)
            proof_add_type_bound_fact(facts, report, upper, line, owner)
            # `-MAX - 1`: the bare literal `-MIN` is one past the width, so the typed constant guard would refuse it.
            magnitude: Ast::Expr = Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(ElisaProofKernelCore::proof_kernel_signed_width_max(width), position), position)
            floor: Ast::Expr = Ast::Expr.Binary(magnitude, TokenKind.Minus, Ast::Expr.IntLit(1, position), position)
            lower: Ast::Expr = Ast::Expr.Binary(floor, TokenKind.LtEq, term, position)
            proof_add_type_bound_fact(facts, report, lower, line, owner)

        # Fixed arrays carry an exact element count in their type (`array[T, N]` or the
        # primitive shorthand `T[N]`). Keep this importer intentionally narrower than the
        # compiler's full type algebra: an extent is a literal or a uniquely declared qualified
        # integer constant (fixed_array_places.elisa), and wrappers are transparent. Dynamic
        # arrays, bare or dependent extents, aliases, and malformed syntax have no shape. This
        # is used only to derive a memory-safety fact after the index itself has independently
        # been proved below the exact extent.
        #
        # The dimensions are collected in receiver-to-element order. A missing nested dimension
        # is intentionally not invented: `array[darray[T], N]` contributes only its outer `N`, so
        # a second runtime index remains opaque. This flat shape is enough for a bounded `IndexN`
        # access without introducing a separate heap/alias model.
