include "./operator_witness_queries.elisa"
include "./operator_witness_markers.elisa"
include "./operator_impl_queries.elisa"
include "./operator_impl_chain.elisa"
include "./struct_members.elisa"
include "./operator_witness_dispatch.elisa"
include "./operator_witness_indexes.elisa"

extend ElisaProof:
    private:
        def proof_scalar_reference_parameter_type_in_declarations_with_work(declarations: darray[Ast::Decl]&, function_name: sview, parameter_name: sview, depth: usize, source_work: mutable usize&) -> (count: usize, type_expression: Ast::Expr):
            selected: mutable Ast::Expr = Ast::Expr.Invalid
            count: mutable usize = 0
            return (2, selected) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            for declaration in declarations |declaration, function_name, parameter_name, depth, selected, count, source_work|:
                return (2, Ast::Expr.Invalid) if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, _):
                        return (2, Ast::Expr.Invalid) if:
                            not proof_type_audit_work_charge(sview_len(name), source_work)
                            not proof_type_audit_work_charge(sview_len(function_name), source_work)
                        if name == function_name:
                            for parameter in parameters |parameter, parameter_name, selected, count, source_work|:
                                return (2, Ast::Expr.Invalid) if:
                                    not proof_type_audit_work_charge(1, source_work)
                                    not proof_type_audit_work_charge(sview_len(parameter.name), source_work)
                                    not proof_type_audit_work_charge(sview_len(parameter_name), source_work)
                                if parameter.name == parameter_name:
                                    selected <- parameter.type_expression
                                    count <- count + 1
                    Ast::Decl.Module(_, body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_scalar_reference_parameter_type_in_declarations_with_work(body, function_name, parameter_name, depth + 1, source_work)
                        count <- count + nested.count
                        selected <- nested.type_expression if nested.count == 1
                    Ast::Decl.Scoped(body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_scalar_reference_parameter_type_in_declarations_with_work(body, function_name, parameter_name, depth + 1, source_work)
                        count <- count + nested.count
                        selected <- nested.type_expression if nested.count == 1
                    _:
                        pass
            return (count, selected)

        # Replay source witnesses must resolve a formal from the exact owner declaration whose
        # body was selected. Name-only lookup can otherwise combine same-line overloads.
        def proof_scalar_reference_parameter_type_at_owner_offset_with_work(declarations: darray[Ast::Decl]&, function_name: sview, parameter_name: sview, owner_line: u32, owner_offset: usize, owner_offset_valid: bool, depth: usize, source_work: mutable usize&) -> (count: usize, type_expression: Ast::Expr):
            selected: mutable Ast::Expr = Ast::Expr.Invalid
            count: mutable usize = 0
            return (2, selected) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not owner_offset_valid or not proof_type_audit_work_charge(1, source_work)
            for declaration in declarations |declaration, function_name, parameter_name, owner_line, owner_offset, selected, count, source_work, depth|:
                return (2, Ast::Expr.Invalid) if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return (2, Ast::Expr.Invalid) if:
                            not proof_type_audit_work_charge(sview_len(name), source_work)
                            not proof_type_audit_work_charge(sview_len(function_name), source_work)
                        continue if name != function_name or position.line != owner_line or position.offset.usize() != owner_offset
                        for parameter in parameters |parameter, parameter_name, selected, count, source_work|:
                            return (2, Ast::Expr.Invalid) if:
                                not proof_type_audit_work_charge(1, source_work)
                                not proof_type_audit_work_charge(sview_len(parameter.name), source_work)
                                not proof_type_audit_work_charge(sview_len(parameter_name), source_work)
                            if parameter.name == parameter_name:
                                selected <- parameter.type_expression
                                count <- count + 1
                    Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_scalar_reference_parameter_type_at_owner_offset_with_work(body, function_name, parameter_name, owner_line, owner_offset, owner_offset_valid, depth + 1, source_work)
                        count <- count + nested.count
                        selected <- nested.type_expression if nested.count == 1
                    _:
                        pass
            return (count, selected)

        const PROOF_PURE_CALL_WITNESS_DEPTH_LIMIT: usize = 32

        def proof_initialize_old_parameter_values_with_work(parameters: darray[Ast::ParamDecl]&, old_values: mutable darray[Ast::Expr]&, declarations: darray[Ast::Decl]&, generic_lines: darray[u32]&, generic_names: darray[sview]&, declaration_line: u32, declaration_offset: u32, exact_metadata_complete: bool, generic_index: ProofSourceEffectIndex&, generic_names_complete: bool, position: Ast::Pos, source_work: mutable usize&) -> void:
            parameter_index: mutable usize = 0
            for parameter in parameters |parameter_index, old_values, declarations, generic_lines, generic_names, declaration_line, declaration_offset, exact_metadata_complete, generic_index, position, source_work|:
                return if not proof_type_audit_work_charge(1, source_work) or not proof_type_audit_work_charge(sview_len(parameter.name), source_work)
                scalar_reference: (known: bool, target: Ast::Expr) = proof_scalar_reference_target_type_with_work(parameter.type_expression, declarations, 0, source_work)
                parameter_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(parameter.type_expression, declarations, generic_lines, generic_names, declaration_line, declaration_offset, exact_metadata_complete, generic_index, generic_names_complete, source_work)
                if scalar_reference.known and parameter_index < old_values.count:
                    initial_value: Ast::Expr = Ast::Expr.Index(Ast::Expr.Ident(parameter.name, position), Ast::Expr.IntLit(0, position), position)
                    old_values[parameter_index] <- proof_scalar_reference_state_marker(initial_value, position)
                elif parameter_index < old_values.count and (not proof_resource_type_is_scalar(parameter.type_expression) or (parameter_markers.reference and parameter_markers.mutable_reference)):
                    # An aggregate's entry value is not a stable name: mutable fields or
                    # collection contents can change while the parameter binding stays put.
                    # Until the adapter carries field/element snapshots, never substitute the
                    # aggregate binding itself for old(aggregate.field) or old(aggregate[i]).
                    # A mutable reference the body writes through without rebinding its name
                    # denotes the exit state too, so `old(v...)` gets the same opaque entry state.
                    entry_arguments: darray[Ast::Expr] = [Ast::Expr.Ident(parameter.name, position)]
                    old_values[parameter_index] <- Ast::Expr.Call(Ast::Expr.Ident("__elisa_proof_entry_state", position), entry_arguments, [], position)
                parameter_index <- parameter_index + 1

        const PROOF_SCALAR_WITNESS_BUDGET: usize = 16
        const PROOF_SCALAR_WITNESS_FUNCTION_BUDGET: usize = 32
        const PROOF_SCALAR_WITNESS_DEPTH: usize = 3

        def proof_add_scalar_type_witness(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, owner: sview) -> void:
            # A witness already present costs nothing; every goal of a return re-derives them.
            for existing in facts |existing, expression|:
                return if proof_expr_equal(existing, expression)
            return if report.analysis_2.scalar_witness_facts >= PROOF_SCALAR_WITNESS_FUNCTION_BUDGET
            report.analysis_2.scalar_witness_facts <- report.analysis_2.scalar_witness_facts + 1
            proof_add_type_bound_fact(facts, report, expression, line, owner)

        # Expression-level type witnesses for a binding. The bare name of a scalar binding is
        # witnessed by the caller; this records what the declared type says about the places
        # reachable from the binding: each scalar field of a struct, recursively through
        # struct-typed fields to a fixed depth, the `count` of a built-in container, and the
        # container itself when its elements are scalars. Every witness is a type statement about
        # a place and is retained and invalidated with the binding's root symbol.
        def proof_add_scalar_witnesses(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, line: u32, owner: sview, position: Ast::Pos, caller_scope: darray[sview]&, caller_module: sview, module_aliases: ProofModuleAliasIndex&, declaration_line: u32, declaration_offset: usize, budget: mutable usize&, depth: usize) -> void can[Global.Read]:
            return if depth >= PROOF_SCALAR_WITNESS_DEPTH or budget == 0 or report.analysis_2.scalar_witness_facts >= PROOF_SCALAR_WITNESS_FUNCTION_BUDGET or report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            primitive_witness_complete: bool = proof_add_primitive_operator_witnesses_with_aliases_work(facts, report, root, type_expression, position, caller_scope, caller_module, module_aliases, declaration_line, declaration_offset, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if not primitive_witness_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            scalar_reference: (known: bool, target: Ast::Expr) = proof_scalar_reference_target_type_with_work(type_expression, report.source.source_declarations, 0, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            # This shape-only recognizer may treat a generic formal named like a
            # primitive (for example `u8`) as a scalar pointee. Check the exact
            # owner before emitting any indexed scalar facts for the reference.
            scalar_reference_is_owner_generic: bool = proof_resource_type_mentions_owner_generic_at_owner_with_work(scalar_reference.target, declaration_line, declaration_offset.u32(), report.source_types.source_generic_owner_params_valid, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &source_work, 0) if scalar_reference.known else true
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if scalar_reference.known and not scalar_reference_is_owner_generic:
                # This root is scalar only because the source declaration resolved to a
                # primitive pointee type; the branch does not apply to general references.
                element_operator_complete: bool = proof_add_untrusted_scalar_element_operator_witness_with_protocol_work(facts, report, root, scalar_reference.target, "Element.Ref", position, declaration_line, declaration_offset, &source_work)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if not element_operator_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                indexed_element_operator_complete: bool = proof_add_untrusted_scalar_element_operator_witness_with_work(facts, report, root, scalar_reference.target, position, declaration_line, declaration_offset, &source_work)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if not indexed_element_operator_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                proof_add_scalar_type_witness(facts, report, proof_scalar_type_marker(proof_ident_name(root), position), line, owner) if proof_ident_name(root) != ""
                proof_add_builtin_index_witness(facts, report, root, position)
                index_witness_complete: bool = proof_add_index_operator_witnesses(facts, report, root, scalar_reference.target, position, scalar_reference_is_owner_generic, &source_work) can Global.Read
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if not index_witness_complete
                element_width: i64 = proof_unsigned_type_width_with_work(scalar_reference.target, report.source.source_declarations, 0, &source_work)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                proof_add_scalar_type_witness(facts, report, proof_scalar_element_marker(root, 1, position, element_width), line, owner)
                # A scalar reference's implicit read and its explicit zero-index read have
                # the declared pointee width, not an inferred "all references are scalar" type.
                # The place marker below is exact to the one source index admitted by the
                # builtin-index witness and is independently shape-checked during replay.
                signed_element_width: i64 = proof_signed_type_width_with_work(scalar_reference.target, report.source.source_declarations, 0, &source_work)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                proof_add_scalar_type_witness(facts, report, proof_signed_type_marker(root, signed_element_width, position), line, owner) if signed_element_width > 0
                explicit_zero: Ast::Expr = Ast::Expr.Index(root, Ast::Expr.IntLit(0, position), position)
                proof_add_scalar_type_witness(facts, report, proof_signed_place_marker(explicit_zero, signed_element_width, position), line, owner) if signed_element_width > 0
                return
            builtin_type: sview = (proof_builtin_operator_type_name_with_work(type_expression, report.source.source_declarations, 0, &source_work) can Global.Read)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if builtin_type != "":
                builtin_witness_complete: bool = proof_add_builtin_operator_witnesses_with_work(facts, report, root, builtin_type, position, &source_work)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if not builtin_witness_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return
            named_type: sview = proof_type_head_name_with_work(type_expression, report.source.source_declarations, 0, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            builtin_enum_eq: bool = proof_plain_enum_builtin_equality_type_with_work(type_expression, "", report, &source_work) != ""
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            proof_add_untrusted_operator_witnesses(facts, report, root, position, builtin_enum_eq) if named_type != ""
            container_profile: (known: bool, element: Ast::Expr, scalar_depth: i64, unsigned_width: i64) = proof_container_scalar_profile_with_work(type_expression, report.source.source_declarations, 0, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            container: (known: bool, element: Ast::Expr) = (container_profile.known, container_profile.element)
            element_depth: i64 = container_profile.scalar_depth
            if container.known:
                element_is_owner_generic: bool = proof_resource_type_mentions_owner_generic_at_owner_with_work(container.element, declaration_line, declaration_offset.u32(), report.source_types.source_generic_owner_params_valid, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &source_work, 0)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                proof_add_builtin_index_witness(facts, report, root, position)
                index_witness_complete: bool = proof_add_index_operator_witnesses(facts, report, root, container.element, position, element_is_owner_generic, &source_work) can Global.Read
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if not index_witness_complete
                budget <- budget - 1
                proof_add_scalar_type_witness(facts, report, proof_scalar_term_marker(Ast::Expr.Field(root, "count", position), position), line, owner)
                # A count is a `usize`: its exact place gets the width marker the arithmetic
                # reader needs, so `k + 1 <= xs.count` can be decided inside a loop that havocs
                # every alias of the count.
                proof_add_scalar_type_witness(facts, report, proof_unsigned_place_marker(Ast::Expr.Field(root, "count", position), 64, position), line, owner)
                proof_add_scalar_type_witness(facts, report, Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, Ast::Expr.Field(root, "count", position), position), line, owner) if proof_count_fact_wanted(root, type_expression)
                # Primitive-looking names can be shadowed by an owner generic (for
                # example, a formal named `u8`). The shape-only scalar profile has
                # no owner context, so authenticate the leaf before emitting a
                # width-bearing scalar marker. Unknown generic metadata fails closed.
                if element_depth > 0 and not element_is_owner_generic and budget > 0:
                    budget <- budget - 1
                    element_operator_complete: bool = proof_add_untrusted_scalar_element_operator_witness_for_container_with_work(facts, report, root, type_expression, position, declaration_line, declaration_offset, &source_work)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return if not element_operator_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    proof_add_scalar_type_witness(facts, report, proof_scalar_element_marker(root, element_depth, position, container_profile.unsigned_width), line, owner)
                # A container of records has no scalar leaf at the container level, but an
                # indexed primitive field is scalar. Record one exact marker per declared field;
                # replay matches only that field on an element of this exact container.
                source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                struct_element: (known: bool, element: Ast::Expr, depth: i64) = proof_container_struct_element_with_work(type_expression, report.source.source_declarations, 0, &source_work)
                element_struct: sview = proof_type_head_name_with_work(struct_element.element, report.source.source_declarations, 0, &source_work)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                if struct_element.known and element_struct != "" and budget > 0:
                    members: mutable darray[Ast::StructMember] = []
                    if proof_struct_members_with_report(report.source.source_declarations, element_struct, 0, &members, report) == 1:
                        return if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        latest: mutable darray[bool] = []
                        latest_rows: mutable darray[usize] = []
                        source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                        latest_complete: bool = proof_struct_member_latest_rows_with_work(members, &latest, &latest_rows, &source_work)
                        report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                        return if not latest_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        for row in 0..<members.count |facts, report, root, element_struct, members, latest, latest_rows, line, owner, position, caller_scope, caller_module, module_aliases, declaration_line, declaration_offset, budget, source_work, row|:
                            continue if not latest[row]
                            return if budget == 0
                            row_work_complete: bool = proof_type_audit_work_charge(1, source_work)
                            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                            return if not row_work_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            member: Ast::StructMember = members[row]
                            latest_member: Ast::StructMember = members[latest_rows[row]]
                            field_name: sview = member.name
                            field_type: Ast::Expr = latest_member.type_expression
                            source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                            field_scalar_kind: i64 = proof_scalar_type_kind_with_work(field_type, report.source.source_declarations, 0, &source_work)
                            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            continue if field_scalar_kind != 1
                            budget <- budget - 1
                            field_container: Ast::Expr = Ast::Expr.Field(root, field_name, position)
                            width: i64 = proof_unsigned_type_width_with_work(field_type, report.source.source_declarations, 0, &source_work)
                            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            primitive_witness_complete: bool = proof_add_primitive_operator_witnesses_with_aliases_work(facts, report, field_container, field_type, position, caller_scope, caller_module, module_aliases, declaration_line, declaration_offset, &source_work)
                            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                            return if not primitive_witness_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            proof_add_scalar_type_witness(facts, report, proof_scalar_element_marker(field_container, struct_element.depth, position, width), line, owner)
                return
            struct_name: sview = proof_type_head_name_with_work(type_expression, report.source.source_declarations, 0, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return if struct_name == ""
            members: mutable darray[Ast::StructMember] = []
            return if proof_struct_members_with_report(report.source.source_declarations, struct_name, 0, &members, report) != 1
            return if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            latest: mutable darray[bool] = []
            latest_rows: mutable darray[usize] = []
            source_work <- report.source_types.source_effect_index.work.implicit_effect_work
            latest_complete: bool = proof_struct_member_latest_rows_with_work(members, &latest, &latest_rows, &source_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            return if not latest_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for row in 0..<members.count |facts, report, root, struct_name, members, latest, latest_rows, line, owner, position, caller_scope, caller_module, module_aliases, declaration_line, declaration_offset, budget, depth, source_work, row|:
                continue if not latest[row]
                return if budget == 0
                row_work_complete: bool = proof_type_audit_work_charge(1, source_work)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if not row_work_complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                member: Ast::StructMember = members[row]
                latest_member: Ast::StructMember = members[latest_rows[row]]
                field_name: sview = member.name
                field_type: Ast::Expr = latest_member.type_expression
                source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                field_scalar_kind: i64 = proof_scalar_type_kind_with_work(field_type, report.source.source_declarations, 0, &source_work)
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                place: Ast::Expr = Ast::Expr.Field(root, field_name, position)
                if field_scalar_kind == 1:
                    budget <- budget - 1
                    proof_add_scalar_type_witness(facts, report, proof_scalar_term_marker(place, position), line, owner)
                    # Exact place markers preserve scalar widths without extending them to sibling
                    # fields of the containing record.
                    field_width: i64 = proof_unsigned_type_width_with_work(field_type, report.source.source_declarations, 0, &source_work)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    proof_add_scalar_type_witness(facts, report, proof_unsigned_place_marker(place, field_width, position), line, owner) if field_width > 0
                    signed_field_width: i64 = proof_signed_type_width_with_work(field_type, report.source.source_declarations, 0, &source_work)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    proof_add_scalar_type_witness(facts, report, proof_signed_place_marker(place, signed_field_width, position), line, owner) if signed_field_width > 0
                    proof_add_signed_range_facts(facts, report, place, signed_field_width, line, owner, position) if signed_field_width > 0
                else:
                    (proof_add_scalar_witnesses(facts, report, place, field_type, line, owner, position, caller_scope, caller_module, module_aliases, declaration_line, declaration_offset, budget, depth + 1) can Global.Read)

        # A call to a verified total-pure function with a primitive scalar return type denotes
        # one value: the classification proves it reads nothing but its arguments and always
        # returns, so two occurrences of the same call text over witnessed arguments are the same
        # value. Boolean calls also serve as proposition atoms. Admit those only for a direct
        # `bool` return and a callee with no requires; their exact call AST (including arguments)
        # is the atom identity. This lets conjunction denial reason about the same checked helper
        # result without treating an arbitrary call or a partial function as stable.
        def proof_add_pure_call_witnesses(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, depth: usize) -> bool:
            budget: mutable usize = report.analysis_1.budgets.frame_call_source_work
            exhausted: mutable bool = false
            proof_add_pure_call_witnesses_with_work(expression, facts, functions, report, line, owner, depth, &budget, &exhausted)
            report.analysis_1.budgets.frame_call_source_work <- budget
            proof_frame_source_work_report_exhaustion(report, owner, line, "pure-call-witness-work", "pure-call witness expansion exceeded its bounded source-work budget") if exhausted
            return not exhausted

        def proof_add_pure_call_witnesses_with_work(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> void:
            return if exhausted
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                exhausted <- true
                return
            if depth >= PROOF_PURE_CALL_WITNESS_DEPTH_LIMIT:
                exhausted <- true
                return
            return if not proof_linear_safety_work_charge(budget, exhausted, 1)
            source_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_add_pure_call_witnesses_with_work(inner, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                Ast::Expr.Scope(_, _, position):
                    proof_add_qualified_constant_witness(expression, facts, functions, report, line, owner, position)
                    if report.source_types.source_effect_index.work.implicit_effect_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        exhausted <- true
                Ast::Expr.Unary(_, operand, _):
                    proof_add_pure_call_witnesses_with_work(operand, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                Ast::Expr.Binary(left, operator, right, position):
                    proof_add_pure_call_witnesses_with_work(left, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                    return if exhausted
                    proof_add_pure_call_witnesses_with_work(right, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                    return if exhausted
                    # `name is Enum.Variant` is the builtin tag test: never overloaded, one bool
                    # for the one value a name denotes in a goal.
                    if operator == TokenKind.Is and proof_ident_name(left) != "":
                        match right:
                            Ast::Expr.Field(Ast::Expr.Ident(_, _), _, _):
                                exhausted <- not proof_pure_call_add_scalar_witness_with_work(facts, report, proof_scalar_term_marker(expression, position), line, owner, budget, exhausted)
                            _:
                                pass
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    proof_add_pure_call_witnesses_with_work(condition, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                    return if exhausted
                    proof_add_pure_call_witnesses_with_work(then_expression, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                    return if exhausted
                    proof_add_pure_call_witnesses_with_work(else_expression, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                Ast::Expr.Call(callee, arguments, _, position):
                    for argument in arguments |facts, functions, report, line, owner, depth, budget, exhausted|:
                        proof_add_pure_call_witnesses_with_work(argument, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                        return if exhausted
                    return if exhausted
                    # Recursive scope arguments update the shared implicit-effect meter. Reload
                    # after visiting them so return-type checks cannot overwrite their charges.
                    source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                    call_shape: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
                    return if not call_shape.complete or exhausted
                    # The numeric-cast recognizer is constant-time; only its receiver's legacy
                    # nested-call check walks an expression, so reserve one measured pass.
                    return if not proof_linear_safety_work_charge_scaled(budget, exhausted, call_shape.cost, 1)
                    # Builtin integer casts have a stable scalar result even when the cast is
                    # not a value-preserving widening. Admit only a cast without a custom hook
                    # and with a call-free receiver; this records its result type, not a relation
                    # to the receiver's mathematical value.
                    numeric_cast: (known: bool, receiver: Ast::Expr) = proof_runtime_numeric_conversion(callee, arguments.count, functions)
                    if numeric_cast.known and not proof_expr_has_call(numeric_cast.receiver):
                        match callee:
                            Ast::Expr.Field(_, cast_name, _):
                                target_type: Ast::Expr = Ast::Expr.Ident(cast_name, position)
                                signed_cast_width: i64 = proof_signed_primitive_width(target_type)
                                unsigned_cast_width: i64 = proof_unsigned_primitive_width(target_type)
                                if signed_cast_width > 0:
                                    return if not proof_pure_call_add_scalar_witness_with_work(facts, report, proof_scalar_term_marker(expression, position), line, owner, budget, exhausted)
                                    return if not proof_pure_call_add_scalar_witness_with_work(facts, report, proof_signed_place_marker(expression, signed_cast_width, position), line, owner, budget, exhausted)
                                elif unsigned_cast_width > 0:
                                    return if not proof_pure_call_add_scalar_witness_with_work(facts, report, proof_scalar_term_marker(expression, position), line, owner, budget, exhausted)
                                    return if not proof_pure_call_add_scalar_witness_with_work(facts, report, proof_unsigned_place_marker(expression, unsigned_cast_width, position), line, owner, budget, exhausted)
                            _:
                                pass
                    return if not proof_add_widening_cast_witnesses_with_work(expression, callee, arguments.count, facts, functions, report, line, owner, position, budget, exhausted)
                    return if exhausted
                    pure: bool = proof_contract_calls_are_pure_with_source_work(expression, functions, true, budget)
                    if budget > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                        exhausted <- true
                        return
                    return if not pure
                    called: usize = proof_function_index_for_callee(functions, callee)
                    if functions.lookup.module_resolution_work_exhausted:
                        exhausted <- true
                        return
                    return if called >= functions.returns.return_scalar.count or not functions.returns.return_scalar[called]
                    return if called >= functions.returns.return_types.count
                    return_type: Ast::Expr = functions.returns.return_types[called]
                    boolean_atom: bool = proof_ident_name(return_type) == "bool" and called < functions.contracts.obligations.requires_counts.count and functions.contracts.obligations.requires_counts[called] == 0
                    if not boolean_atom:
                        # The fact frame does not change during this argument check. Build its
                        # scalar marker index once, rather than rescanning and reindexing every
                        # fact separately for each argument.
                        scalar_markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
                        return if not scalar_markers_result.complete or exhausted
                        scalar_markers: mutable ProofScalarWitnesses = scalar_markers_result.witnesses
                        marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(scalar_markers, budget, exhausted)
                        return if not marker_scale.complete or exhausted
                        for argument in arguments |facts, report, scalar_markers, marker_scale, budget, exhausted|:
                            value_binding: (complete: bool, argument: bool) = proof_value_binding_argument_with_work(argument, report, 0, budget, exhausted)
                            return if not value_binding.complete or exhausted
                            continue if value_binding.argument
                            witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(argument, scalar_markers, marker_scale.scale, budget, exhausted)
                            return if not witnessed.complete or exhausted or not witnessed.matches
                    if boolean_atom:
                        return if called >= functions.lookup.owner_modules.count
                        atom_arguments: darray[Ast::Expr] = [expression, Ast::Expr.StringLit(functions.lookup.owner_modules[called], position)]
                        atom: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("__elisa_verified_total_bool_atom", position), atom_arguments, [], position)
                        return if not proof_pure_call_add_type_fact_with_work(facts, report, atom, line, owner, budget, exhausted)
                    else:
                        return if not proof_pure_call_add_scalar_witness_with_work(facts, report, proof_scalar_term_marker(expression, position), line, owner, budget, exhausted)
                    # The call's value has its callee's declared signed width, which is what lets
                    # `size(left) + size(right) + 1` be bounded without wrapping. The bare name
                    # must select exactly one source declaration; anything else keeps no width.
                    return_declaration_line: u32 = functions.lookup.lines[called] if called < functions.lookup.lines.count else 0
                    return_declaration_offset: u32 = functions.lookup.offsets[called] if called < functions.lookup.offsets.count else 0
                    source_work <- report.source_types.source_effect_index.work.implicit_effect_work
                    return_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(return_type, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, return_declaration_line, return_declaration_offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &source_work)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or not return_markers.complete:
                        exhausted <- true
                        return
                    return if return_markers.reference
                    unsigned_width: i64 = proof_unsigned_primitive_width(return_type)
                    return if unsigned_width > 0 and not proof_pure_call_add_scalar_witness_with_work(facts, report, proof_unsigned_place_marker(expression, unsigned_width, position), line, owner, budget, exhausted)
                    width: i64 = proof_signed_type_width_with_work(return_type, report.source.source_declarations, 0, &source_work)
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                    return if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return if width > 0 and not proof_pure_call_add_scalar_witness_with_work(facts, report, proof_signed_place_marker(expression, width, position), line, owner, budget, exhausted)
                Ast::Expr.Field(object, field, position):
                    proof_add_pure_call_witnesses_with_work(object, facts, functions, report, line, owner, depth + 1, budget, exhausted)
                    return if exhausted
                    tuple_complete: bool = proof_add_tuple_field_call_witnesses_with_work(object, field, facts, functions, report, line, owner, position, budget, exhausted)
                    if not tuple_complete:
                        exhausted <- true
                        return
                _:
                    pass

        # Zero means a non-unsigned type; -1 means alias resolution is ambiguous or too
        # deep. Never silently treat a failed resolution as ordinary signed arithmetic.

        # A builtin integer conversion keeps its receiver's mathematical value only when the
        # receiver has an exact source type witness and that type, or the current fact interval,
        # fits the destination range. Places are limited to names, fields, and an explicitly
        # witnessed zero-index scalar reference element; calls and arbitrary reference roots do
        # not acquire a scalar type by shape alone.
        def proof_widening_cast_receiver_with_work(callee: Ast::Expr, argument_count: usize, facts: darray[Ast::Expr]&, functions: ProofFunctionTable&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, receiver: Ast::Expr, target: sview):
            return (false, false, Ast::Expr.Invalid, "") if exhausted
            # The conversion and builtin-index recognizers below predate source-work APIs.
            # Measure their inputs and reserve their bounded source scans before calling them.
            callee_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(callee, &budget, &exhausted)
            return (false, false, Ast::Expr.Invalid, "") if not callee_cost.complete
            return (false, false, Ast::Expr.Invalid, "") if not proof_linear_safety_work_charge_scaled(&budget, &exhausted, callee_cost.cost, 2)
            return (false, false, Ast::Expr.Invalid, "") if not proof_linear_safety_work_charge(&budget, &exhausted, argument_count)
            conversion: (known: bool, receiver: Ast::Expr) = proof_runtime_numeric_conversion(callee, argument_count, functions)
            return (true, false, Ast::Expr.Invalid, "") if not conversion.known
            receiver: Ast::Expr = proof_strip_parens(conversion.receiver)
            receiver_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(receiver, &budget, &exhausted)
            return (false, false, Ast::Expr.Invalid, "") if not receiver_cost.complete
            match receiver:
                Ast::Expr.Ident(name, _): return (true, false, Ast::Expr.Invalid, "") if name == ""
                Ast::Expr.Field(_, field, _): return (true, false, Ast::Expr.Invalid, "") if field == ""
                Ast::Expr.Index(_, index, _):
                    fact_scan_cost: mutable usize = 0
                    for fact in facts |fact, budget, exhausted, fact_scan_cost|:
                        fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, &budget, &exhausted)
                        return (false, false, Ast::Expr.Invalid, "") if not fact_cost.complete
                        if fact_scan_cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                            exhausted <- true
                            return (false, false, Ast::Expr.Invalid, "")
                        remaining_scan_cost: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_scan_cost - 1
                        if fact_cost.cost > remaining_scan_cost:
                            exhausted <- true
                            return (false, false, Ast::Expr.Invalid, "")
                        fact_scan_cost <- fact_scan_cost + fact_cost.cost + 1
                    return (false, false, Ast::Expr.Invalid, "") if not proof_linear_safety_charge_cross_with_work(&budget, &exhausted, fact_scan_cost, receiver_cost.cost, 8)
                    return (false, false, Ast::Expr.Invalid, "") if not proof_linear_safety_fact_scan_with_work(fact_scan_cost, 1, &budget, &exhausted)
                    return (true, false, Ast::Expr.Invalid, "") if not proof_builtin_index_expression_witnessed(receiver, facts) or not proof_expr_is_zero(index)
                _:
                    return (true, false, Ast::Expr.Invalid, "")
            target_name: sview = proof_cast_target_name(callee)
            target: Ast::Expr = Ast::Expr.Ident(target_name, Ast::expr_pos(callee))
            target_unsigned: i64 = proof_unsigned_primitive_width(target)
            target_signed: i64 = proof_signed_primitive_width(target)
            return (true, false, Ast::Expr.Invalid, "") if target_unsigned <= 0 and target_signed <= 0
            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, &budget, &exhausted)
            return (false, false, Ast::Expr.Invalid, "") if not marker_result.complete
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, &budget, &exhausted)
            return (false, false, Ast::Expr.Invalid, "") if not marker_scale.complete
            receiver_unsigned: i64 = proof_unsigned_width_in_expression_with_work(receiver, marker_result.witnesses, &budget, &exhausted)
            return (false, false, Ast::Expr.Invalid, "") if exhausted
            receiver_signed: i64 = proof_signed_width_in_expression_with_work(receiver, marker_result.witnesses, 0, &budget, &exhausted)
            return (false, false, Ast::Expr.Invalid, "") if exhausted
            scalar_witness: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(receiver, marker_result.witnesses, marker_scale.scale, &budget, &exhausted)
            return (false, false, Ast::Expr.Invalid, "") if not scalar_witness.complete or exhausted
            return (true, false, Ast::Expr.Invalid, "") if not scalar_witness.matches
            widening: mutable bool = false
            if receiver_unsigned > 0:
                widening <- (target_unsigned > 0 and target_unsigned >= receiver_unsigned) or (target_signed > 0 and target_signed > receiver_unsigned)
            elif receiver_signed > 0:
                widening <- target_signed > 0 and target_signed >= receiver_signed
            if not widening:
                bounds: mutable darray[ProofBound] = []
                return (false, false, Ast::Expr.Invalid, "") if not proof_collect_fact_bounds_with_work(facts, marker_result.witnesses, &bounds, &budget, &exhausted)
                return (false, false, Ast::Expr.Invalid, "") if not proof_close_equalities_with_work(facts, marker_result.witnesses, &bounds, &budget, &exhausted)
                interval = proof_interval_with_work(receiver, bounds, 0, &budget, &exhausted)
                return (false, false, Ast::Expr.Invalid, "") if exhausted
                if interval.has_lower and interval.has_upper and interval.lower <= interval.upper:
                    if target_signed > 0:
                        widening <- interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(target_signed) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(target_signed)
                    elif target_unsigned > 0:
                        widening <- interval.lower >= 0 and interval.upper <= proof_unsigned_width_max(target_unsigned)
            return (true, widening, conversion.receiver, target_name) if widening
            return (true, false, Ast::Expr.Invalid, "")

        def proof_expr_is_zero(expression: Ast::Expr) -> bool:
            match proof_strip_parens(expression):
                Ast::Expr.IntLit(value, _): return value == 0
                _:
                    return false

        def proof_add_widening_cast_witnesses_with_work(expression: Ast::Expr, callee: Ast::Expr, argument_count: usize, facts: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, position: Ast::Pos, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            widening: (complete: bool, known: bool, receiver: Ast::Expr, target: sview) = proof_widening_cast_receiver_with_work(callee, argument_count, facts, functions, budget, exhausted)
            report.analysis_1.budgets.frame_call_source_work <- budget
            source_work_stopped: bool = proof_frame_source_work_stop(report, owner, line)
            if exhausted or not widening.complete or source_work_stopped:
                exhausted <- true
                proof_frame_source_work_report_exhaustion(report, owner, line, "widening-cast-work", "widening-cast classification exceeded its bounded source-work budget")
                return false
            return true if not widening.known
            target: Ast::Expr = Ast::Expr.Ident(widening.target, position)
            target_unsigned: i64 = proof_unsigned_primitive_width(target)
            target_signed: i64 = proof_signed_primitive_width(target)
            output_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            if not output_cost.complete or exhausted:
                report.analysis_1.budgets.frame_call_source_work <- budget
                proof_frame_source_work_report_exhaustion(report, owner, line, "widening-cast-work", "widening-cast witness insertion exceeded its bounded source-work budget")
                exhausted <- true
                return false
            receiver_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(widening.receiver, budget, exhausted)
            if not receiver_cost.complete or exhausted:
                report.analysis_1.budgets.frame_call_source_work <- budget
                proof_frame_source_work_report_exhaustion(report, owner, line, "widening-cast-work", "widening-cast witness insertion exceeded its bounded source-work budget")
                exhausted <- true
                return false
            fact_scan_cost: mutable usize = 0
            for fact in facts |fact, budget, exhausted, fact_scan_cost|:
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                if not fact_cost.complete or exhausted:
                    report.analysis_1.budgets.frame_call_source_work <- budget
                    proof_frame_source_work_report_exhaustion(report, owner, line, "widening-cast-work", "widening-cast witness insertion exceeded its bounded source-work budget")
                    exhausted <- true
                    return false
                if fact_scan_cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT or fact_cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_scan_cost - 1:
                    exhausted <- true
                    report.analysis_1.budgets.frame_call_source_work <- budget
                    proof_frame_source_work_report_exhaustion(report, owner, line, "widening-cast-work", "widening-cast witness insertion exceeded its bounded source-work budget")
                    return false
                fact_scan_cost <- fact_scan_cost + fact_cost.cost
                fact_scan_cost <- fact_scan_cost + 1
            witness_passes: usize = 1
            witness_passes <- witness_passes + 1 if target_unsigned > 0
            witness_passes <- witness_passes + 2 if target_signed > 0
            comparison_multiplier: usize = witness_passes * 8
            generated_marker_cost: usize = output_cost.cost + 4
            complete: bool = proof_linear_safety_charge_cross_with_work(budget, exhausted, facts.count, generated_marker_cost, comparison_multiplier)
            complete <- complete and proof_linear_safety_work_charge_scaled(budget, exhausted, fact_scan_cost, comparison_multiplier)
            report.analysis_1.budgets.frame_call_source_work <- budget
            if not complete or exhausted:
                proof_frame_source_work_report_exhaustion(report, owner, line, "widening-cast-work", "widening-cast witness insertion exceeded its bounded source-work budget")
                exhausted <- true
                return false
            if proof_frame_source_work_stop(report, owner, line):
                exhausted <- true
                return false
            proof_add_scalar_type_witness(facts, report, proof_unsigned_place_marker(expression, target_unsigned, position), line, owner) if target_unsigned > 0
            proof_add_scalar_type_witness(facts, report, proof_scalar_term_marker(expression, position), line, owner)
            proof_add_scalar_type_witness(facts, report, proof_signed_type_marker(expression, target_signed, position), line, owner) if target_signed > 0
            proof_add_scalar_type_witness(facts, report, Ast::Expr.Binary(expression, TokenKind.EqEq, widening.receiver, position), line, owner)
            report.analysis_1.budgets.frame_call_source_work <- budget
            if report.source_types.source_effect_index.work.implicit_effect_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                exhausted <- true
                proof_frame_source_work_report_exhaustion(report, owner, line, "widening-cast-work", "widening-cast witness insertion exceeded its bounded source-work budget")
                return false
            return true
