# A deliberately small, explicit ownership state for the proof checker.
#
# The compiler already has a substantially richer affine/borrow analysis. The proof checker must
# not silently treat that analysis as a proof axiom, so this pass owns an independent, source
# backed subset: lexical borrows, bounded static places, shared-vs-mutable exclusivity, writes to
# borrowed places, moves, and reference escapes. Closed literal indexes, including every component
# of a bounded multi-index, are exact path components. Small symbolic +/- index expressions are
# retained as path components only when an explicit replayed inequality proves them disjoint;
# unsupported dynamic indexes remain conservative whole-root accesses and are never guessed apart.
# Borrow-carrying calls require a verified,
# replayed callee resource summary with exact argument mapping; direct reference-formal returns
# may compose only when caller ownership is externally established. Recursive-SCC, defaulted,
# dynamic, and otherwise opaque calls remain unsupported until their effect and lifetime summaries
# are explicit.
extend ElisaProof:
    private:
        struct ProofResourcePlace:
            root: sview
            # Exact named-field path into the report's source-neutral kernel arena. Indexes are
            # intentionally structural rather than hashed and are widened to a whole-root place
            # only for dynamic selectors.
            path_root: usize
            depth: usize
            whole: bool

        struct ProofResourceState:
            binding_names: mutable darray[sview]
            binding_reference: mutable darray[bool]
            binding_mutable_reference: mutable darray[bool]
            binding_writable: mutable darray[bool]
            binding_moved: mutable darray[bool]
            # A non-empty region label means the binding's value carries storage owned by that
            # lexical region. Region values are tracked separately from ordinary borrows: they
            # may be used while the region is active, but cannot cross its closing boundary.
            binding_region: mutable darray[sview]
            # Region labels are not identities: after `destroy r`, a later declaration may reuse
            # the spelling `r`. Keep a separate liveness bit so an old binding cannot become live
            # merely because a same-named region was opened again.
            binding_region_live: mutable darray[bool]
            active_regions: mutable darray[sview]
            # Region parameters are caller-owned capabilities. They remain active across the
            # callee's return and therefore must not be closed by proof_resource_finish.
            external_regions: mutable darray[sview]
            borrow_target_slots: mutable darray[usize]
            borrow_target_places: mutable darray[ProofResourcePlace]
            borrow_mutable: mutable darray[bool]
            borrow_present: mutable darray[bool]
            # The resource pass receives a snapshot of the logical entry facts. It may use those
            # facts only for explicit symbolic-index separation; assignments and calls clear the
            # snapshot before it can become stale.
            facts: mutable darray[Ast::Expr]
            # The trace is a flat list of source-neutral transition roots. Nested lexical states
            # are wrapped in resource-scope nodes when their snapshots are closed.
            trace_events: mutable darray[usize]

        def proof_resource_empty() -> ProofResourceState:
            return ProofResourceState{binding_names: [], binding_reference: [], binding_mutable_reference: [], binding_writable: [], binding_moved: [], binding_region: [], binding_region_live: [], active_regions: [], external_regions: [], borrow_target_slots: [], borrow_target_places: [], borrow_mutable: [], borrow_present: [], facts: [], trace_events: []}

        # Copy into an already-created state. Returning a struct that owns several darrays would
        # hide their allocation region from the self-hosting compiler, so all branch snapshots
        # are made in place.
        def proof_resource_copy_into[@source, @target](source: ProofResourceState& @source, target: mutable ProofResourceState& @target) -> void can[Memory.Allocate, Abort.Panic]:
            target.binding_names.clear()
            target.binding_reference.clear()
            target.binding_mutable_reference.clear()
            target.binding_writable.clear()
            target.binding_moved.clear()
            target.binding_region.clear()
            target.binding_region_live.clear()
            target.active_regions.clear()
            target.external_regions.clear()
            target.borrow_target_slots.clear()
            target.borrow_target_places.clear()
            target.borrow_mutable.clear()
            target.borrow_present.clear()
            target.facts.clear()
            target.trace_events.clear()
            target.binding_names.extend(source.binding_names)
            target.binding_reference.extend(source.binding_reference)
            target.binding_mutable_reference.extend(source.binding_mutable_reference)
            target.binding_writable.extend(source.binding_writable)
            target.binding_moved.extend(source.binding_moved)
            target.binding_region.extend(source.binding_region)
            target.binding_region_live.extend(source.binding_region_live)
            target.active_regions.extend(source.active_regions)
            target.external_regions.extend(source.external_regions)
            target.borrow_target_slots.extend(source.borrow_target_slots)
            target.borrow_target_places.extend(source.borrow_target_places)
            target.borrow_mutable.extend(source.borrow_mutable)
            target.borrow_present.extend(source.borrow_present)
            target.facts.extend(source.facts)

        def proof_resource_record_event[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, kind: sview, operator: sview, left: usize, name: sview, secondary_name: sview, auxiliary: usize) -> void:
            event: usize = proof_kernel_add_node(&report.kernel_nodes, kind, operator, left, 0, auxiliary, 0, 0, 0, name, secondary_name)
            state.trace_events.push(event)

        def proof_resource_close_child[@parent, @child, @r](parent: mutable ProofResourceState& @parent, child: ProofResourceState& @child, report: mutable ProofReport& @r, join_moves: bool) -> void:
            start: usize = report.kernel_children.count
            for event in child.trace_events |event, report|:
                report.kernel_children.push(event)
            scope_root: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-scope", "", 0, 0, 0, start, child.trace_events.count, 0, "", "")
            parent.trace_events.push(scope_root)
            if join_moves:
                for index in 0..<parent.binding_moved.count |index, parent, child|:
                    if index < child.binding_moved.count and child.binding_moved[index]:
                        parent.binding_moved[index] <- true
                        join_root: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-join-move", "", 0, 0, 0, 0, 0, 0, parent.binding_names[index], "")
                        parent.trace_events.push(join_root)

        def proof_resource_add_binding_traced[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, name: sview, is_reference: bool, is_mutable_reference: bool, is_writable: bool, target_slot: usize, borrow_is_mutable: bool, source_name: sview, source_place: ProofResourcePlace, source_place_root: usize) -> void:
            proof_resource_add_binding(state, name, is_reference, is_mutable_reference, is_writable, target_slot, borrow_is_mutable, source_place)
            operator: mutable sview = "value"
            if is_reference:
                operator <- "mutable" if borrow_is_mutable and source_name != ""
                operator <- "shared" if not borrow_is_mutable and source_name != ""
                operator <- "external-mutable" if is_mutable_reference and source_name == ""
                operator <- "external-shared" if not is_mutable_reference and source_name == ""
            proof_resource_record_event(state, report, "resource-bind", operator, source_place_root if operator == "shared" or operator == "mutable" else 0, name, source_name, 1 if is_writable else 0)

        # Region-owned values use their own transition forms. Treating `new[r] x` as an
        # external reference would let a certificate forget which lexical lifetime owns the
        # allocation, so the trusted replay state carries the region label explicitly.
        def proof_resource_region_is_active(state: ProofResourceState&, region: sview) -> bool:
            return false if region == ""
            index: mutable usize = state.active_regions.count
            while index > 0 |index, state, region|:
                index <- index - 1
                return true if state.active_regions[index] == region
            return false

        def proof_resource_region_is_external(state: ProofResourceState&, region: sview) -> bool:
            return any external in state.external_regions where external == region

        # Attach the explicit `@r` lifetime of a formal reference parameter to both the source
        # state and its serialized bind node. Keeping it on the bind node lets independent replay
        # validate the same region relation without consulting the AST or the producer tables.
        def proof_resource_set_binding_region(state: mutable ProofResourceState&, report: mutable ProofReport&, name: sview, region: sview) -> void:
            return if name == "" or region == ""
            slot: usize = proof_resource_lookup(state, name)
            return if slot >= state.binding_names.count
            state.binding_region[slot] <- region
            state.binding_region_live[slot] <- proof_resource_region_is_active(state, region)
            return if state.trace_events.count == 0
            event: usize = state.trace_events[state.trace_events.count - 1]
            return if event >= report.kernel_nodes.count
            return if report.kernel_nodes[event].kind != "resource-bind"
            return if report.kernel_nodes[event].name != name
            report.kernel_nodes[event].secondary_name <- region

        def proof_resource_binding_region(state: ProofResourceState&, slot: usize) -> sview:
            return state.binding_region[slot] if slot < state.binding_region.count
            return ""

        def proof_resource_binding_region_is_live(state: ProofResourceState&, slot: usize) -> bool:
            return slot < state.binding_region_live.count and state.binding_region_live[slot]

        def proof_resource_invalidate_region_bindings(state: mutable ProofResourceState&, region: sview) -> void:
            for index in 0..<state.binding_region.count |index, state, region|:
                if index < state.binding_region_live.count and state.binding_region[index] == region:
                    state.binding_region_live[index] <- false

        # Close a named region in the same state in which it was opened. The compiler's flat
        # `region r(size)` form keeps the owner live across following statements, so its close
        # must be a real stack transition rather than the end of a synthetic child scope.
        def proof_resource_close_named_region[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, region: sview, position: Ast::Pos, function_name: sview) -> void:
            valid: bool = region != "" and not proof_resource_region_is_external(state, region) and state.active_regions.count > 0 and state.active_regions[state.active_regions.count - 1] == region
            proof_resource_add_failing_obligation(report, "region-destroy-unsupported", position, function_name, "destroy must name the innermost active tracked region") if not valid
            if valid:
                state.active_regions <- state.active_regions.truncate(state.active_regions.count - 1)
                proof_resource_invalidate_region_bindings(state, region)
                proof_resource_record_event(state, report, "resource-region-close", "", 0, region, "", 0)

        def proof_resource_add_region_allocation[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, name: sview, type_expression: Ast::Expr, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> void:
            is_reference: bool = proof_resource_is_reference_type(type_expression)
            is_mutable_reference: bool = is_reference and proof_resource_is_mutable_reference_type(type_expression)
            writable: bool = is_mutable_reference or proof_resource_type_has_marker(type_expression, TokenKind.Mutable)
            encoded: usize = proof_kernel_encode_expression(operand, &report.kernel_nodes, &report.kernel_children)
            valid: bool = proof_resource_region_is_active(state, region) and encoded < report.kernel_nodes.count and report.kernel_nodes[encoded].kind != "unsupported"
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "region allocation requires an active lexical region and a kernel-replayable operand") if not valid
            proof_resource_add_binding(state, name, is_reference, is_mutable_reference, writable, state.binding_names.count, false, proof_resource_empty_place())
            state.binding_region[state.binding_region.count - 1] <- region
            state.binding_region_live[state.binding_region_live.count - 1] <- valid
            proof_resource_record_event(state, report, "resource-region-alloc", "", encoded, name, region, (1 if writable else 0) + (2 if is_reference else 0) + (4 if is_mutable_reference else 0)) if valid

        # A discarded `new[r] value` still performs a real allocation into @r. Keep it in the
        # trace without inventing a user-visible binding: the replay kernel validates the
        # operand and active region, then deliberately leaves no value available after the
        # expression statement.
        def proof_resource_add_region_discard[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> void:
            encoded: usize = proof_kernel_encode_expression(operand, &report.kernel_nodes, &report.kernel_children)
            valid: bool = proof_resource_region_is_active(state, region) and encoded < report.kernel_nodes.count and report.kernel_nodes[encoded].kind != "unsupported"
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "region allocation requires an active lexical region and a kernel-replayable operand") if not valid
            proof_resource_record_event(state, report, "resource-region-alloc-discard", "", encoded, "", region, 0) if valid

        def proof_resource_add_region_return_alloc[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> void:
            encoded: usize = proof_kernel_encode_expression(operand, &report.kernel_nodes, &report.kernel_children)
            valid: bool = proof_resource_region_is_active(state, region) and encoded < report.kernel_nodes.count and report.kernel_nodes[encoded].kind != "unsupported"
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "a returned region allocation requires an active lifetime and a kernel-replayable operand") if not valid
            proof_resource_record_event(state, report, "resource-region-return-alloc", "", encoded, "", region, 0) if valid

        def proof_resource_rebind_region_allocation[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, target: Ast::Expr, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> void:
            target_name: sview = proof_resource_direct_binding_name(target)
            target_slot: usize = proof_resource_lookup(state, target_name)
            encoded: usize = proof_kernel_encode_expression(operand, &report.kernel_nodes, &report.kernel_children)
            target_access: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(target, report)
            valid: bool = target_name != "" and not proof_resource_is_discard_target(target) and target_access.known and target_slot < state.binding_names.count and target_slot < state.binding_moved.count and not state.binding_moved[target_slot] and target_slot < state.borrow_present.count and not state.borrow_present[target_slot] and not proof_resource_has_borrow_overlap(state, report, target_access.place, state.binding_names.count) and proof_resource_region_is_active(state, region) and encoded < report.kernel_nodes.count and report.kernel_nodes[encoded].kind != "unsupported"
            proof_resource_add_failing_obligation(report, "region-store-escape", position, function_name, "a region allocation may be assigned only to a directly tracked live binding without an active borrow handle") if not valid
            if valid:
                state.binding_region[target_slot] <- region
                state.binding_region_live[target_slot] <- true
                proof_resource_record_event(state, report, "resource-region-rebind-alloc", "", encoded, target_name, region, 0)

        def proof_resource_add_region_binding[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, name: sview, type_expression: Ast::Expr, source: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> void:
            is_reference: bool = proof_resource_is_reference_type(type_expression)
            is_mutable_reference: bool = is_reference and proof_resource_is_mutable_reference_type(type_expression)
            writable: bool = is_mutable_reference or proof_resource_type_has_marker(type_expression, TokenKind.Mutable)
            source_place: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(source, report)
            encoded: usize = proof_resource_encode_access_place(source, report)
            source_slot: usize = proof_resource_lookup(state, source_place.place.root)
            valid: bool = proof_resource_region_is_active(state, region) and source_place.known and source_slot < state.binding_names.count and proof_resource_binding_region(state, source_slot) == region and proof_resource_binding_region_is_live(state, source_slot) and encoded < report.kernel_nodes.count
            proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "region value aliases require a live source with the same tracked region") if not valid
            proof_resource_add_binding(state, name, is_reference, is_mutable_reference, writable, state.binding_names.count, false, proof_resource_empty_place())
            state.binding_region[state.binding_region.count - 1] <- region
            state.binding_region_live[state.binding_region_live.count - 1] <- valid
            proof_resource_record_event(state, report, "resource-region-bind", "", encoded, name, region, (1 if writable else 0) + (2 if is_reference else 0) + (4 if is_mutable_reference else 0)) if valid

        def proof_resource_finish[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, line: u32, failed_before: u32, parameter_count: usize) -> void:
            return if report.failed != failed_before
            # A local region that is used only as allocation backing is automatically released
            # at function-scope exit by Elisa. Materialize that implicit lifetime boundary in
            # the certificate so replay never accepts an unbalanced open region. Explicit
            # `destroy r` has already removed its entry and therefore emits no duplicate close.
            while state.active_regions.count > 0 |state, report, function_name, line|:
                region: sview = state.active_regions[state.active_regions.count - 1]
                state.active_regions <- state.active_regions.truncate(state.active_regions.count - 1)
                if not proof_resource_region_is_external(state, region):
                    proof_resource_invalidate_region_bindings(state, region)
                    proof_resource_record_event(state, report, "resource-region-close", "", 0, region, "", 0)
            start: usize = report.kernel_children.count
            for event in state.trace_events |event, report|:
                report.kernel_children.push(event)
            # The parameter count is part of the certificate header. The replay kernel uses it
            # to distinguish formal external capabilities from body-local bindings when a caller
            # composes this trace into a resource-call transition.
            root: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-safety", "", 0, 0, parameter_count, start, state.trace_events.count, 0, function_name, "resource-v1")
            report.proof_obligation(true)
            proof_add_resource_goal_attempt(report, root, line, function_name)

        # Type markers are nested unary AST nodes in the compiler AST. Keep this helper local to
        # the proof system: importing the compiler's predicate here would make its implementation
        # an unrecorded trusted premise for proof-state transitions.
        def proof_resource_type_has_marker(expression: Ast::Expr, marker: TokenKind) -> bool:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == marker
                    return proof_resource_type_has_marker(operand, marker)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_type_has_marker(inner, marker)
                _:
                    return false

        def proof_resource_is_reference_type(expression: Ast::Expr) -> bool:
            return proof_resource_type_has_marker(expression, TokenKind.Ampersand) or proof_resource_type_has_marker(expression, TokenKind.Lmut)

        def proof_resource_is_mutable_reference_type(expression: Ast::Expr) -> bool:
            return proof_resource_type_has_marker(expression, TokenKind.Mutable) or proof_resource_type_has_marker(expression, TokenKind.Lmut)

        def proof_resource_empty_place() -> ProofResourcePlace:
            return ProofResourcePlace{root: "", path_root: 0, depth: 0, whole: false}

        # The old fixed three-field representation could silently widen a fourth segment into an
        # unrelated whole-root access. State-owned structural paths give the checker arbitrary
        # named-field depth while preserving exact prefix reasoning; unlike a hash, they cannot
        # alias on a collision.
        def proof_resource_place_add_field[@r](report: mutable ProofReport& @r, parent: ProofResourcePlace, field: sview) -> (known: bool, place: ProofResourcePlace):
            empty: ProofResourcePlace = proof_resource_empty_place()
            return (false, empty) if parent.root == "" or field == "" or parent.depth >= 127
            field_root: usize = proof_kernel_add_node(&report.kernel_nodes, "field", "", parent.path_root, 0, 0, 0, 0, 0, field, "")
            return (true, ProofResourcePlace{root: parent.root, path_root: field_root, depth: parent.depth + 1, whole: false})

        # A literal index is a precise selector. The index expression remains an arena child of
        # the `index` node, so independent replay can require that it is actually closed.
        # Dynamic selectors stay outside this tier and are widened to the whole root below.
        def proof_resource_place_add_index[@r](report: mutable ProofReport& @r, parent: ProofResourcePlace, index_root: usize) -> (known: bool, place: ProofResourcePlace):
            empty: ProofResourcePlace = proof_resource_empty_place()
            return (false, empty) if parent.root == "" or parent.depth >= 127 or index_root >= report.kernel_nodes.count
            path_root: usize = proof_kernel_add_node(&report.kernel_nodes, "index", "", parent.path_root, index_root, 0, 0, 0, 0, "", "")
            return (true, ProofResourcePlace{root: parent.root, path_root: path_root, depth: parent.depth + 1, whole: false})

        # Symbolic selectors are deliberately small: a name, a parenthesized name, or bounded
        # affine +/- arithmetic. Calls, fields, and arbitrary expressions remain conservative
        # whole-root accesses until their semantics are represented in the resource kernel.
        def proof_resource_symbolic_index_supported(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name != ""
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_resource_symbolic_index_supported(inner)
                Ast::Expr.Unary(operator, operand, _):
                    return (operator == TokenKind.Plus or operator == TokenKind.Minus) and proof_resource_symbolic_index_supported(operand)
                Ast::Expr.Binary(left, operator, right, _):
                    return (operator == TokenKind.Plus or operator == TokenKind.Minus) and proof_resource_symbolic_index_supported(left) and proof_resource_symbolic_index_supported(right)
                _:
                    return false

        def proof_resource_default_position() -> Ast::Pos:
            return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}

        # Decode only the symbolic-index sublanguage back into source AST terms. This is used by
        # the producer to ask the same arithmetic prover that checks contracts; replay consumes
        # the corresponding canonical arena roots independently.
        def proof_resource_decode_index_expression(report: ProofReport&, root: usize, depth: usize) -> (known: bool, expression: Ast::Expr):
            invalid: Ast::Expr = Ast::Expr.Invalid
            return (false, invalid) if depth >= 127 or root >= report.kernel_nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[root]
            position: Ast::Pos = proof_resource_default_position()
            return (true, Ast::Expr.IntLit(node.value)) if node.kind == "int" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""
            return (true, Ast::Expr.Ident(node.name, position)) if node.kind == "ident" and node.name != "" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.secondary_name == ""
            if node.kind == "unary" and (node.operator == "+" or node.operator == "-"):
                operand: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, node.left, depth + 1)
                return (true, Ast::Expr.Unary(TokenKind.Plus if node.operator == "+" else TokenKind.Minus, operand.expression, position)) if operand.known and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "binary" and (node.operator == "+" or node.operator == "-"):
                left: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, node.left, depth + 1)
                right: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, node.right, depth + 1)
                return (true, Ast::Expr.Binary(left.expression, TokenKind.Plus if node.operator == "+" else TokenKind.Minus, right.expression, position)) if left.known and right.known and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""
            return (false, invalid)

        def proof_resource_index_is_closed(report: ProofReport&, root: usize) -> bool:
            return false if root >= report.kernel_nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[root]
            return node.kind == "int" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""

        def proof_resource_symbolic_index_supported_kernel(report: ProofReport&, root: usize, depth: usize) -> bool:
            decoded: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, root, depth)
            return decoded.known

        # A successful symbolic separation always emits a replayable resource-disjoint event.
        # The event carries the exact index roots and a closed logical context, so replay does
        # not need to trust this source-side call into the arithmetic prover.
        def proof_resource_record_disjoint[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, left_root: usize, right_root: usize) -> void:
            return if left_root >= report.kernel_nodes.count or right_root >= report.kernel_nodes.count
            goal_root: usize = proof_kernel_add_node(&report.kernel_nodes, "binary", "!=", left_root, right_root, 0, 0, 0, 0, "", "")
            fact_roots: mutable darray[usize] = []
            for fact in state.facts |fact, report, fact_roots|:
                if proof_kernel_expression_supported(fact):
                    fact_roots.push(proof_kernel_encode_expression(fact, &report.kernel_nodes, &report.kernel_children))
            start: usize = report.kernel_children.count
            report.kernel_children.extend(fact_roots)
            event: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-disjoint", "!=", left_root, right_root, goal_root, start, fact_roots.count, 0, "", "")
            state.trace_events.push(event)

        def proof_resource_symbolic_indices_disjoint[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, left_root: usize, right_root: usize) -> bool:
            return false if proof_resource_index_is_closed(report, left_root) and proof_resource_index_is_closed(report, right_root)
            left: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, left_root, 0)
            right: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, right_root, 0)
            return false if not left.known or not right.known
            goal: Ast::Expr = Ast::Expr.Binary(left.expression, TokenKind.BangEq, right.expression, proof_resource_default_position())
            annotations: darray[Ast::EnumAnnotation] = []
            proven: bool = proof_goal(state.facts, goal, annotations)
            proof_resource_record_disjoint(state, report, left_root, right_root) if proven
            return proven

        # Resource identities cover a root and an exact named-field/literal-index path up to the
        # same bounded expression depth as the independent kernel. Dynamic selectors are lowered
        # to a conservative whole-root place below.
        def proof_resource_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> (known: bool, place: ProofResourcePlace):
            empty: ProofResourcePlace = proof_resource_empty_place()
            match expression:
                Ast::Expr.Ident(root, _):
                    ident_root: usize = proof_kernel_add_node(&report.kernel_nodes, "ident", "", 0, 0, 0, 0, 0, 0, root, "")
                    return (root != "", ProofResourcePlace{root: root, path_root: ident_root, depth: 0, whole: true})
                Ast::Expr.Field(object, field, _):
                    parent: (known: bool, place: ProofResourcePlace) = proof_resource_place(object, report)
                    return proof_resource_place_add_field(report, parent.place, field) if parent.known
                    return (false, empty)
                Ast::Expr.Index(object, index, _):
                    parent: (known: bool, place: ProofResourcePlace) = proof_resource_place(object, report)
                    return (false, empty) if not parent.known
                    match index:
                        Ast::Expr.IntLit(_):
                            index_root: usize = proof_kernel_encode_expression(index, &report.kernel_nodes, &report.kernel_children)
                            return proof_resource_place_add_index(report, parent.place, index_root)
                        _:
                            if proof_resource_symbolic_index_supported(index):
                                index_root: usize = proof_kernel_encode_expression(index, &report.kernel_nodes, &report.kernel_children)
                                return proof_resource_place_add_index(report, parent.place, index_root)
                            return (false, empty)
                Ast::Expr.IndexN(object, arguments, _):
                    decoded: (known: bool, place: ProofResourcePlace) = proof_resource_place(object, report)
                    return (false, empty) if not decoded.known or arguments.count == 0
                    parent: mutable ProofResourcePlace = decoded.place
                    for argument in arguments |argument, report, parent|:
                        match argument:
                            Ast::Expr.IntLit(_):
                                index_root: usize = proof_kernel_encode_expression(argument, &report.kernel_nodes, &report.kernel_children)
                                next: (known: bool, place: ProofResourcePlace) = proof_resource_place_add_index(report, parent, index_root)
                                return (false, empty) if not next.known
                                parent <- next.place
                            _:
                                if proof_resource_symbolic_index_supported(argument):
                                    index_root: usize = proof_kernel_encode_expression(argument, &report.kernel_nodes, &report.kernel_children)
                                    next: (known: bool, place: ProofResourcePlace) = proof_resource_place_add_index(report, parent, index_root)
                                    return (false, empty) if not next.known
                                    parent <- next.place
                                    continue
                                return (false, empty)
                    return (true, parent)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_place(inner, report)
                _:
                    return (false, empty)

        def proof_resource_borrow_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> (known: bool, place: ProofResourcePlace):
            empty: ProofResourcePlace = proof_resource_empty_place()
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        exact: (known: bool, place: ProofResourcePlace) = proof_resource_place(operand, report)
                        return exact if exact.known
                        # An unsupported dynamic selector cannot identify an element in the v1
                        # resource language, but its receiver root is still a sound capability identity.
                        # Widening to that whole root lets shared dynamic borrows participate in
                        # ordinary read reasoning while ensuring every write or mutable borrow
                        # of the root conflicts conservatively.
                        root: sview = proof_resource_place_root(operand)
                        return (false, empty) if root == ""
                        root_node: usize = proof_kernel_add_node(&report.kernel_nodes, "ident", "", 0, 0, 0, 0, 0, 0, root, "")
                        return (true, ProofResourcePlace{root: root, path_root: root_node, depth: 0, whole: true})
                    return (false, empty)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_borrow_place(inner, report)
                _:
                    return (false, empty)

        # Recover one exact path component in root-to-leaf order. Index components carry their
        # closed integer value; an explicit kind keeps fields and indexes disjoint even when their
        # spellings happen to match.
        def proof_resource_path_component(report: ProofReport&, path_root: usize, position: usize, depth: usize) -> (known: bool, kind: sview, field: sview, value: i64, expression_root: usize):
            requires depth <= 127
            decreases depth
            return (false, "", "", 0, 0) if depth == 0 or path_root >= report.kernel_nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[path_root]
            if position + 1 == depth:
                return (true, "field", node.name, 0, 0) if node.kind == "field" and node.name != ""
                if node.kind == "index" and node.operator == "" and node.name == "" and node.secondary_name == "" and node.right < report.kernel_nodes.count:
                    index_node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[node.right]
                    return (true, "index", "", index_node.value, node.right) if proof_resource_index_is_closed(report, node.right)
                    return (true, "index", "", 0, node.right) if proof_resource_symbolic_index_supported_kernel(report, node.right, 0)
                return (false, "", "", 0, 0)
            return (false, "", "", 0, 0) if position >= depth - 1
            return proof_resource_path_component(report, node.left, position, depth - 1) if node.kind == "field" or node.kind == "index"
            return (false, "", "", 0, 0)

        def proof_resource_place_is_prefix[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, prefix: ProofResourcePlace, target: ProofResourcePlace) -> bool:
            return false if prefix.root == "" or target.root == "" or prefix.root != target.root
            return true if prefix.whole
            return false if target.whole or prefix.depth > target.depth or prefix.depth > 127 or target.depth > 127
            for index in 0..<prefix.depth:
                prefix_component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_resource_path_component(report, prefix.path_root, index, prefix.depth)
                target_component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_resource_path_component(report, target.path_root, index, target.depth)
                return false if not prefix_component.known or not target_component.known or prefix_component.kind != target_component.kind
                return false if prefix_component.kind == "field" and prefix_component.field != target_component.field
                if prefix_component.kind == "index":
                    if proof_resource_index_is_closed(report, prefix_component.expression_root) and proof_resource_index_is_closed(report, target_component.expression_root):
                        return false if prefix_component.value != target_component.value
                    else:
                        return false if proof_resource_symbolic_indices_disjoint(state, report, prefix_component.expression_root, target_component.expression_root)
            return true

        def proof_resource_places_overlap[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, left: ProofResourcePlace, right: ProofResourcePlace) -> bool:
            return proof_resource_place_is_prefix(state, report, left, right) or proof_resource_place_is_prefix(state, report, right, left)

        # Field/index roots and calls now have a stable root identity. Unsupported dynamic
        # selectors are intentionally widened to the whole root, retaining soundness without
        # pretending that two runtime indexes are disjoint.
        def proof_resource_direct_borrow_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        match operand:
                            Ast::Expr.Ident(name, _):
                                return name
                            Ast::Expr.Paren(inner, _):
                                match inner:
                                    Ast::Expr.Ident(name, _):
                                        return name
                                    _:
                                        pass
                            _:
                                pass
                Ast::Expr.Paren(inner, _):
                    return proof_resource_direct_borrow_root(inner)
                _:
                    pass
            return ""

        def proof_resource_place_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _):
                    return proof_resource_place_root(object)
                Ast::Expr.Index(object, _, _):
                    return proof_resource_place_root(object)
                Ast::Expr.IndexN(object, _, _):
                    return proof_resource_place_root(object)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_resource_place_root(object)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_place_root(base)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_place_root(inner)
                _:
                    return ""

        def proof_resource_access_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> (known: bool, place: ProofResourcePlace):
            decoded: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            return decoded if decoded.known
            root: sview = proof_resource_place_root(expression)
            root_node: usize = proof_kernel_add_node(&report.kernel_nodes, "ident", "", 0, 0, 0, 0, 0, 0, root, "") if root != "" else 0
            return (false, ProofResourcePlace{root: root, path_root: root_node, depth: 0, whole: true}) if root != ""
            return decoded

        def proof_resource_encode_access_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> usize:
            decoded: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            return decoded.place.path_root if decoded.known
            root: sview = proof_resource_place_root(expression)
            return proof_kernel_add_node(&report.kernel_nodes, "ident", "", 0, 0, 0, 0, 0, 0, root, "") if root != ""
            return 0

        def proof_resource_place_shape_known(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Ident(root, _):
                    return root != ""
                Ast::Expr.Field(object, field, _):
                    return field != "" and proof_resource_place_shape_known(object)
                Ast::Expr.Index(object, index, _):
                    return false if not proof_resource_place_shape_known(object)
                    match index:
                        Ast::Expr.IntLit(_):
                            return true
                        _:
                            return proof_resource_symbolic_index_supported(index)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_resource_place_shape_known(object) or arguments.count == 0
                    for argument in arguments:
                        match argument:
                            Ast::Expr.IntLit(_):
                                pass
                            _:
                                return false if not proof_resource_symbolic_index_supported(argument)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_resource_place_shape_known(inner)
                _:
                    return false

        def proof_resource_encode_borrow_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> usize:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return proof_resource_encode_access_place(operand, report) if operator == TokenKind.Ampersand
                Ast::Expr.Paren(inner, _):
                    return proof_resource_encode_borrow_place(inner, report)
                _:
                    pass
            return 0

        def proof_resource_function_index(functions: ProofFunctionTable&, name: sview) -> usize:
            index: mutable usize = 0
            while index < functions.names.count |index, functions, name|:
                return index if functions.names[index] == name
                index <- index + 1
            return functions.names.count

        def proof_resource_function_region_param_count(functions: ProofFunctionTable&, function_index: usize) -> usize:
            return functions.region_param_counts[function_index] if function_index < functions.region_param_counts.count
            return 0

        def proof_resource_function_region_param_at(functions: ProofFunctionTable&, function_index: usize, region_index: usize) -> sview:
            return "" if function_index >= functions.region_param_starts.count or function_index >= functions.region_param_counts.count
            return "" if region_index >= functions.region_param_counts[function_index]
            slot: usize = functions.region_param_starts[function_index] + region_index
            return functions.all_region_params[slot] if slot < functions.all_region_params.count
            return ""

        def proof_resource_function_parameter_region(functions: ProofFunctionTable&, function_index: usize, parameter_index: usize) -> sview:
            return "" if function_index >= functions.all_param_region_starts.count or function_index >= functions.param_counts.count
            return "" if parameter_index >= functions.param_counts[function_index]
            slot: usize = functions.all_param_region_starts[function_index] + parameter_index
            return functions.all_param_regions[slot] if slot < functions.all_param_regions.count
            return ""

        def proof_resource_function_return_region(functions: ProofFunctionTable&, function_index: usize) -> sview:
            return functions.return_regions[function_index] if function_index < functions.return_regions.count
            return ""

        # A resource summary is usable only after the callee's complete executable summary has
        # converged. In particular, a provisional recursive SCC must not consume one of its own
        # members' traces: doing so would turn a cyclic assumption into a certificate.
        def proof_resource_summary_is_ready(functions: ProofFunctionTable&, report: ProofReport&, caller_name: sview, callee_name: sview) -> (known: bool, root: usize):
            empty_root: usize = report.kernel_nodes.count
            callee_index: usize = proof_resource_function_index(functions, callee_name)
            caller_index: usize = proof_resource_function_index(functions, caller_name)
            return (false, empty_root) if callee_index >= functions.names.count or caller_index >= functions.names.count
            return (false, empty_root) if callee_index >= functions.verified.count or not functions.verified[callee_index]
            # Keep every later array access behind its own explicit bound. The source checker and
            # the independent replay kernel must see the same alignment facts; a compound `and`
            # guard is not a substitute for proving each indexed table has the requested slot.
            return (false, empty_root) if caller_index >= functions.recursive.count or callee_index >= functions.recursive.count
            return (false, empty_root) if caller_index >= functions.recursive_component_ids.count or callee_index >= functions.recursive_component_ids.count
            if functions.recursive[caller_index] and functions.recursive[callee_index]:
                return (false, empty_root) if functions.recursive_component_ids[caller_index] == functions.recursive_component_ids[callee_index]
            for index in 0..<report.kernel_nodes.count |index, report, callee_name|:
                node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[index]
                return (true, index) if node.kind == "resource-safety" and node.name == callee_name and node.secondary_name == "resource-v1"
            return (false, empty_root)

        # Calls are resource-bearing when they pass either a borrow expression or a reference
        # binding. A field borrow is included even when it does not overlap an already-live local
        # borrow: the callee still receives a capability whose effects must be summarized.
        def proof_resource_expr_carries_resource(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
            return true if borrowed.known
            match expression:
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return slot < state.binding_reference.count and state.binding_reference[slot]
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_carries_resource(inner, state, report)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_carries_resource(object, state, report)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_carries_resource(base, state, report)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_carries_resource(object, state, report) or proof_resource_expr_carries_resource(index, state, report)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_carries_resource(object, state, report)
                    for argument in arguments |argument, state, report|:
                        return true if proof_resource_expr_carries_resource(argument, state, report)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_carries_resource(object, state, report) or proof_resource_expr_carries_resource(low, state, report) or proof_resource_expr_carries_resource(high, state, report)
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == TokenKind.Ampersand
                    return proof_resource_expr_carries_resource(operand, state, report)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_carries_resource(left, state, report) or proof_resource_expr_carries_resource(right, state, report)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_carries_resource(callee, state, report)
                    for argument in arguments |argument, state, report|:
                        return true if proof_resource_expr_carries_resource(argument, state, report)
                    return false
                _:
                    return false

        # `new[r] value` is a fresh resource-producing argument. It has no caller binding or
        # borrow place, but its concrete region is still part of the call's lifetime contract.
        # Parentheses are transparent here so the source spelling does not change the resource
        # transition that gets serialized for replay.
        def proof_resource_region_new_parts(expression: Ast::Expr) -> (known: bool, operand: Ast::Expr, region: sview):
            match expression:
                Ast::Expr.RegionNew(operand, region, _):
                    return (true, operand, region)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_region_new_parts(inner)
                _:
                    pass
            return (false, Ast::Expr.Invalid, "")

        def proof_resource_call_argument_kind(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> sview:
            match expression:
                Ast::Expr.RegionNew(_, _, _):
                    return "region-new"
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
                        return "borrow" if borrowed.known
                        return "borrow-opaque"
                Ast::Expr.Paren(inner, _):
                    return proof_resource_call_argument_kind(inner, state, report)
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return "reference" if slot < state.binding_reference.count and state.binding_reference[slot]
                _:
                    pass
            return "value"

        def proof_resource_map_call_arguments(functions: ProofFunctionTable&, function_index: usize, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&) -> bool:
            return false if function_index >= functions.param_counts.count or function_index >= functions.param_starts.count
            parameter_count: usize = functions.param_counts[function_index]
            return false if arguments.count != parameter_count or (argument_names.count != 0 and argument_names.count != arguments.count)
            mapped.clear()
            for _ in 0..<parameter_count |mapped|:
                mapped.push(Ast::Expr.Absent)
            used: mutable darray[bool] = []
            for _ in 0..<parameter_count |used|:
                used.push(false)
            param_start: usize = functions.param_starts[function_index]
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, mapped, used, functions, param_start, parameter_count|:
                parameter_index: mutable usize = argument_index
                if argument_names.count == arguments.count and argument_names[argument_index] != "":
                    label: sview = argument_names[argument_index]
                    parameter_index <- parameter_count
                    for candidate in 0..<parameter_count |candidate, functions, param_start, label, parameter_index|:
                        parameter_index <- candidate if functions.all_params[param_start + candidate] == label
                    return false if parameter_index >= parameter_count
                return false if used[parameter_index]
                mapped[parameter_index] <- arguments[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameter_count |parameter_index, used|:
                return false if not used[parameter_index]
            return true

        # Keep allocation roots aligned with the formal parameter order. This is separate from
        # AST argument mapping because a root is a certificate index, not a source expression.
        # In particular, named calls must not accidentally attach one temporary's allocation to
        # another formal.
        def proof_resource_map_call_allocation_roots(functions: ProofFunctionTable&, function_index: usize, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, source_roots: darray[usize]&, mapped_roots: mutable darray[usize]&) -> bool:
            return false if function_index >= functions.param_counts.count or function_index >= functions.param_starts.count
            parameter_count: usize = functions.param_counts[function_index]
            return false if arguments.count != parameter_count or source_roots.count != arguments.count or (argument_names.count != 0 and argument_names.count != arguments.count)
            mapped_roots.clear()
            for _ in 0..<parameter_count |mapped_roots|:
                mapped_roots.push(0)
            used: mutable darray[bool] = []
            for _ in 0..<parameter_count |used|:
                used.push(false)
            param_start: usize = functions.param_starts[function_index]
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, source_roots, mapped_roots, used, functions, param_start, parameter_count|:
                parameter_index: mutable usize = argument_index
                if argument_names.count == arguments.count and argument_names[argument_index] != "":
                    label: sview = argument_names[argument_index]
                    parameter_index <- parameter_count
                    for candidate in 0..<parameter_count |candidate, functions, param_start, label, parameter_index|:
                        parameter_index <- candidate if functions.all_params[param_start + candidate] == label
                    return false if parameter_index >= parameter_count
                return false if used[parameter_index]
                mapped_roots[parameter_index] <- source_roots[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameter_count |parameter_index, used|:
                return false if not used[parameter_index]
            return true

        def proof_resource_call_source_actual(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool):
            empty: ProofResourcePlace = proof_resource_empty_place()
            kind: sview = proof_resource_call_argument_kind(expression, state, report)
            if kind == "region-new":
                # The allocation is fresh, so it cannot overlap an existing caller borrow. Treat
                # it as writable for a mutable reference formal; replay separately validates the
                # allocation root and discards effects that cannot escape the temporary.
                return (true, empty, state.binding_names.count, false, true, true)
            if kind == "value":
                return (true, empty, state.binding_names.count, false, false, false)
            if kind == "borrow":
                borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
                return (false, empty, state.binding_names.count, false, false, false) if not borrowed.known
                slot: usize = proof_resource_lookup(state, borrowed.place.root)
                return (false, empty, state.binding_names.count, false, false, false) if slot >= state.binding_names.count
                writable: mutable bool = slot < state.binding_writable.count and state.binding_writable[slot]
                writable <- true if slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot]
                return (true, borrowed.place, slot, false, slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot], writable)
            place: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            slot: usize = proof_resource_lookup(state, place.place.root)
            return (false, empty, state.binding_names.count, false, false, false) if not place.known or slot >= state.binding_names.count or slot >= state.binding_reference.count or not state.binding_reference[slot]
            target: mutable ProofResourcePlace = place.place
            target <- state.borrow_target_places[slot] if slot < state.borrow_present.count and state.borrow_present[slot] and slot < state.borrow_target_places.count and state.borrow_target_places[slot].root != ""
            target <- ProofResourcePlace{root: place.place.root, path_root: place.place.path_root, depth: 0, whole: true} if target.root == ""
            writable: mutable bool = slot < state.binding_writable.count and state.binding_writable[slot]
            writable <- true if slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot]
            return (true, target, slot, true, slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot], writable)

        # This mirrors only the call-site permission preconditions. The kernel repeats the same
        # checks from the serialized nodes; keeping the producer-side diagnostic here avoids
        # turning an obvious alias conflict into a bare replay gap.
        def proof_resource_callee_parameter_node(report: ProofReport&, callee: ElisaProofKernelCore::ProofKernelNode, parameter_index: usize) -> (known: bool, node: ElisaProofKernelCore::ProofKernelNode):
            empty: ElisaProofKernelCore::ProofKernelNode = ElisaProofKernelCore::ProofKernelNode{kind: "", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""}
            return (false, empty) if callee.children_start > report.kernel_children.count or callee.children_count > report.kernel_children.count - callee.children_start
            bind_index: mutable usize = 0
            for offset in 0..<callee.children_count |offset, callee, report, parameter_index, bind_index|:
                child: usize = report.kernel_children[callee.children_start + offset]
                continue if child >= report.kernel_nodes.count
                candidate: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[child]
                continue if candidate.kind != "resource-bind"
                if bind_index == parameter_index:
                    return (true, candidate)
                bind_index <- bind_index + 1
            return (false, empty)

        def proof_resource_call_source_compatible(state: mutable ProofResourceState&, report: mutable ProofReport&, callee_root: usize, function_index: usize, mapped: darray[Ast::Expr]&, functions: ProofFunctionTable&) -> bool:
            return false if callee_root >= report.kernel_nodes.count
            callee: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[callee_root]
            return false if callee.kind != "resource-safety" or callee.auxiliary != mapped.count
            return false if callee.children_start > report.kernel_children.count or callee.children_count > report.kernel_children.count - callee.children_start
            for parameter_index in 0..<mapped.count |parameter_index, mapped, report, callee, state|:
                formal_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_resource_callee_parameter_node(report, callee, parameter_index)
                return false if not formal_node.known
                formal: ElisaProofKernelCore::ProofKernelNode = formal_node.node
                formal_reference: bool = formal.operator == "external-shared" or formal.operator == "external-mutable"
                actual_kind: sview = proof_resource_call_argument_kind(mapped[parameter_index], state, report)
                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_source_actual(mapped[parameter_index], state, report)
                formal_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                actual_region: sview = proof_resource_expr_region(mapped[parameter_index], state)
                return false if formal_region != "" and (actual_region == "" or not proof_resource_region_is_active(state, actual_region))
                return false if formal_region == "" and actual_region != "" and actual_kind != "region-new"
                if formal_reference:
                    return false if actual_kind != "borrow" and actual_kind != "reference" and actual_kind != "region-new" or not actual.known
                    return false if actual_kind != "region-new" and actual.place.root == ""
                    if formal.operator == "external-mutable":
                        if actual_kind != "region-new":
                            return false if actual_kind == "reference" and not actual.mutable_reference
                            return false if actual_kind == "borrow" and not actual.writable
                            return false if proof_resource_has_borrow_overlap(state, report, actual.place, actual.slot if actual.is_reference else state.binding_names.count)
                    else:
                        if actual_kind != "region-new":
                            return false if proof_resource_has_mutable_borrow_overlap(state, report, actual.place, actual.slot if actual.is_reference else state.binding_names.count)
                else:
                    return false if actual_kind != "value"
            return true

        # Infer a symbolic callee region only from an explicitly region-pinned formal and a
        # directly tracked caller value carrying that same region. A scalar argument cannot infer
        # `@r`; accepting the ambient region in that case would make a generic allocation summary
        # depend on an unstated call-site fact. Every region parameter must have a witness, and
        # every region-owned actual must be consumed by a matching pinned formal.
        def proof_resource_collect_call_regions(state: ProofResourceState&, functions: ProofFunctionTable&, function_index: usize, mapped: darray[Ast::Expr]&, formal_regions: mutable darray[sview]&, actual_regions: mutable darray[sview]&) -> bool:
            formal_regions.clear()
            actual_regions.clear()
            region_count: usize = proof_resource_function_region_param_count(functions, function_index)
            for region_index in 0..<region_count |region_index, functions, function_index, mapped, formal_regions, actual_regions, state|:
                formal_region: sview = proof_resource_function_region_param_at(functions, function_index, region_index)
                return false if formal_region == ""
                actual_region: mutable sview = ""
                for parameter_index in 0..<mapped.count |parameter_index, mapped, functions, function_index, formal_region, actual_region, state|:
                    parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                    continue if parameter_region != formal_region
                    candidate: sview = proof_resource_expr_region(mapped[parameter_index], state)
                    return false if candidate == "" or not proof_resource_region_is_active(state, candidate)
                    actual_region <- candidate if actual_region == ""
                    return false if actual_region != candidate
                return false if actual_region == ""
                formal_regions.push(formal_region)
                actual_regions.push(actual_region)
            for parameter_index in 0..<mapped.count |parameter_index, mapped, functions, function_index, formal_regions, state|:
                candidate: sview = proof_resource_expr_region(mapped[parameter_index], state)
                parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                new_parts: (known: bool, operand: Ast::Expr, region: sview) = proof_resource_region_new_parts(mapped[parameter_index])
                return false if candidate != "" and parameter_region == "" and not new_parts.known
                return false if candidate != "" and not new_parts.known and not any formal_region in formal_regions where formal_region == parameter_region
            return true

        def proof_resource_add_region_call_allocation[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> usize:
            encoded: usize = proof_kernel_encode_expression(operand, &report.kernel_nodes, &report.kernel_children)
            valid: bool = proof_resource_region_is_active(state, region) and encoded < report.kernel_nodes.count and report.kernel_nodes[encoded].kind != "unsupported"
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "a region-call allocation requires an active lexical region and a kernel-replayable operand") if not valid
            event: mutable usize = report.kernel_nodes.count
            proof_resource_record_event(state, report, "resource-region-call-alloc", "", encoded, "", region, 0) if valid
            event <- state.trace_events[state.trace_events.count - 1] if valid and state.trace_events.count > 0
            return event

        def proof_resource_record_call[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, callee_name: sview, callee_root: usize, function_index: usize, mapped: darray[Ast::Expr]&, allocation_roots: darray[usize]&, functions: ProofFunctionTable&) -> bool:
            return false if function_index >= functions.param_counts.count or function_index >= functions.param_starts.count
            return false if mapped.count != functions.param_counts[function_index]
            return false if allocation_roots.count != mapped.count
            formal_regions: mutable darray[sview] = []
            actual_regions: mutable darray[sview] = []
            return false if not proof_resource_collect_call_regions(state, functions, function_index, mapped, &formal_regions, &actual_regions)
            return false if not proof_resource_call_source_compatible(state, report, callee_root, function_index, mapped, functions)
            param_start: usize = functions.param_starts[function_index]
            encoded_arguments: mutable darray[usize] = []
            argument_kinds: mutable darray[sview] = []
            for parameter_index in 0..<mapped.count |parameter_index, mapped, allocation_roots, functions, param_start, report, state, encoded_arguments, argument_kinds|:
                actual: Ast::Expr = mapped[parameter_index]
                actual_kind: sview = proof_resource_call_argument_kind(actual, state, report)
                return false if actual_kind == "borrow-opaque"
                encoded: mutable usize = allocation_roots[parameter_index] if actual_kind == "region-new" else proof_kernel_encode_expression(actual, &report.kernel_nodes, &report.kernel_children)
                match actual:
                    Ast::Expr.Unary(operator, operand, _):
                        encoded <- proof_resource_encode_access_place(operand, report) if operator == TokenKind.Ampersand
                    Ast::Expr.Paren(inner, _):
                        match inner:
                            Ast::Expr.Unary(operator, operand, _):
                                encoded <- proof_resource_encode_access_place(operand, report) if operator == TokenKind.Ampersand
                            _:
                                pass
                    _:
                        pass
                return false if encoded >= report.kernel_nodes.count
                encoded_arguments.push(encoded)
                argument_kinds.push(actual_kind)
            start: usize = report.kernel_children.count
            for parameter_index in 0..<mapped.count |parameter_index, encoded_arguments, argument_kinds, mapped, functions, param_start, report, state|:
                argument_region: sview = proof_resource_expr_region(mapped[parameter_index], state) if argument_kinds[parameter_index] == "region-new" else ""
                child: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-call-arg", argument_kinds[parameter_index], encoded_arguments[parameter_index], 0, 0, 0, 0, 0, functions.all_params[param_start + parameter_index], argument_region)
                report.kernel_children.push(child)
            for region_index in 0..<formal_regions.count |region_index, formal_regions, actual_regions, report|:
                region_child: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, formal_regions[region_index], actual_regions[region_index])
                report.kernel_children.push(region_child)
            event: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-call", "", callee_root, formal_regions.count, mapped.count, start, mapped.count + formal_regions.count, 0, callee_name, "")
            state.trace_events.push(event)
            return true

        def proof_resource_lookup(state: ProofResourceState&, name: sview) -> usize:
            index: mutable usize = state.binding_names.count
            while index > 0 |index, state, name|:
                index <- index - 1
                return index if state.binding_names[index] == name
            return state.binding_names.count

        def proof_resource_binding_is_moved(state: ProofResourceState&, slot: usize) -> bool:
            return slot < state.binding_moved.count and state.binding_moved[slot]

        def proof_resource_mark_binding_moved(state: mutable ProofResourceState&, slot: usize) -> void:
            state.binding_moved[slot] <- true if slot < state.binding_moved.count

        def proof_resource_has_borrow_for(state: ProofResourceState&, target_slot: usize, except_slot: usize) -> bool:
            for index in 0..<state.borrow_target_slots.count |index, state, target_slot, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and state.borrow_target_slots[index] == target_slot
            return false

        def proof_resource_has_mutable_borrow_for(state: ProofResourceState&, target_slot: usize, except_slot: usize) -> bool:
            for index in 0..<state.borrow_target_slots.count |index, state, target_slot, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and state.borrow_target_slots[index] == target_slot and index < state.borrow_mutable.count and state.borrow_mutable[index]
            return false

        def proof_resource_has_borrow_overlap[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, target: ProofResourcePlace, except_slot: usize) -> bool:
            return false if target.root == ""
            for index in 0..<state.borrow_target_places.count |index, state, report, target, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and proof_resource_places_overlap(state, report, state.borrow_target_places[index], target)
            return false

        def proof_resource_has_mutable_borrow_overlap[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, target: ProofResourcePlace, except_slot: usize) -> bool:
            return false if target.root == ""
            for index in 0..<state.borrow_target_places.count |index, state, report, target, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and index < state.borrow_mutable.count and state.borrow_mutable[index] and proof_resource_places_overlap(state, report, state.borrow_target_places[index], target)
            return false

        # Read-only callers such as contract escape diagnostics must not emit resource proof
        # events. Root equality is intentionally conservative here; the permission transitions
        # above use the fact-aware mutable relation when they decide acceptance.
        def proof_resource_has_borrow_overlap_readonly(state: ProofResourceState&, target: ProofResourcePlace, except_slot: usize) -> bool:
            return false if target.root == ""
            for index in 0..<state.borrow_target_places.count |index, state, target, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and state.borrow_target_places[index].root == target.root
            return false

        def proof_resource_add_failing_obligation(report: mutable ProofReport&, kind: sview, position: Ast::Pos, function_name: sview, message: sview) -> void:
            report.proof_obligation(false)
            proof_add_finding(report, kind, position.line, function_name, message)

        def proof_resource_expr_has_call(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_has_call(inner)
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_has_call(operand)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_has_call(left) or proof_resource_expr_has_call(right)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_has_call(object)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_has_call(base)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_has_call(object) or proof_resource_expr_has_call(index)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_has_call(object)
                    for argument in arguments:
                        return true if proof_resource_expr_has_call(argument)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_has_call(object) or proof_resource_expr_has_call(low) or proof_resource_expr_has_call(high)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_resource_expr_has_call(condition) or proof_resource_expr_has_call(then_expression) or proof_resource_expr_has_call(else_expression)
                Ast::Expr.Move(operand, _):
                    return proof_resource_expr_has_call(operand)
                _:
                    return false

        def proof_resource_expr_has_move(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Move(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_has_move(inner)
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_has_move(operand)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_has_move(left) or proof_resource_expr_has_move(right)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_has_move(object)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_has_move(base)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_has_move(object) or proof_resource_expr_has_move(index)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_has_move(object)
                    for argument in arguments:
                        return true if proof_resource_expr_has_move(argument)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_has_move(object) or proof_resource_expr_has_move(low) or proof_resource_expr_has_move(high)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_resource_expr_has_move(condition) or proof_resource_expr_has_move(then_expression) or proof_resource_expr_has_move(else_expression)
                _:
                    return false

        def proof_resource_add_binding[@s](state: mutable ProofResourceState& @s, name: sview, is_reference: bool, is_mutable_reference: bool, is_writable: bool, target_slot: usize, borrow_is_mutable: bool, target_place: ProofResourcePlace) -> void:
            borrow_is_present: bool = target_slot < state.binding_names.count
            state.binding_names.push(name)
            state.binding_reference.push(is_reference)
            state.binding_mutable_reference.push(is_mutable_reference)
            state.binding_writable.push(is_writable)
            state.binding_moved.push(false)
            state.binding_region.push("")
            state.binding_region_live.push(false)
            state.borrow_target_slots.push(target_slot)
            state.borrow_target_places.push(target_place)
            state.borrow_mutable.push(borrow_is_mutable)
            state.borrow_present.push(borrow_is_present)

        def proof_resource_expr_has_address_of(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == TokenKind.Ampersand
                    return proof_resource_expr_has_address_of(operand)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_has_address_of(inner)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_has_address_of(left) or proof_resource_expr_has_address_of(right)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_has_address_of(callee)
                    for argument in arguments |argument|:
                        return true if proof_resource_expr_has_address_of(argument)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_has_address_of(object)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_has_address_of(base)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_has_address_of(object) or proof_resource_expr_has_address_of(index)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_has_address_of(object)
                    for argument in arguments |argument|:
                        return true if proof_resource_expr_has_address_of(argument)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_has_address_of(object) or proof_resource_expr_has_address_of(low) or proof_resource_expr_has_address_of(high)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_resource_expr_has_address_of(operand)
                Ast::Expr.Array(elements, _):
                    for element in elements |element|:
                        return true if proof_resource_expr_has_address_of(element)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element|:
                        return true if proof_resource_expr_has_address_of(element)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element|:
                        return true if proof_resource_expr_has_address_of(element)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry|:
                        return true if proof_resource_expr_has_address_of(entry.key) or proof_resource_expr_has_address_of(entry.value)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field|:
                        return true if proof_resource_expr_has_address_of(field.value)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_has_address_of(base)
                    for field in fields |field|:
                        return true if proof_resource_expr_has_address_of(field.value)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_has_address_of(condition) or proof_resource_expr_has_address_of(then_expr) or proof_resource_expr_has_address_of(else_expr)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_resource_expr_has_address_of(iterable) or proof_resource_expr_has_address_of(condition) or proof_resource_expr_has_address_of(body)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_resource_expr_has_address_of(base) or proof_resource_expr_has_address_of(predicate)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_resource_expr_has_address_of(scrutinee)
                    for arm in arms |arm|:
                        return true if proof_resource_expr_has_address_of(arm.guard)
                        return true if proof_resource_statements_have_address_of(arm.body)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_has_address_of(guarded)
                    for arm in arms |arm|:
                        return true if proof_resource_expr_has_address_of(arm.guard)
                        return true if proof_resource_statements_have_address_of(arm.body)
                    return false
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_resource_expr_has_address_of(guarded) or proof_resource_statements_have_address_of(recovery)
                Ast::Expr.Lambda(_, body, _):
                    return proof_resource_statements_have_address_of(body)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_resource_statements_have_address_of(statements) or proof_resource_expr_has_address_of(value)
                _:
                    return false

        def proof_resource_statements_have_address_of(statements: darray[Ast::Stmt]&) -> bool:
            for statement in statements:
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_resource_expr_has_address_of(initializer)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        return true if proof_resource_expr_has_address_of(target) or proof_resource_expr_has_address_of(initializer)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_resource_expr_has_address_of(expression)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_has_address_of(returned)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_resource_expr_has_address_of(condition) or proof_resource_statements_have_address_of(then_body) or proof_resource_statements_have_address_of(else_body)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_resource_expr_has_address_of(condition) or proof_resource_statements_have_address_of(while_body)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        return true if proof_resource_expr_has_address_of(iterable) or proof_resource_statements_have_address_of(for_body)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_resource_expr_has_address_of(scrutinee)
                        for arm in arms |arm|:
                            return true if proof_resource_expr_has_address_of(arm.guard) or proof_resource_statements_have_address_of(arm.body)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_have_address_of(block_body)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_resource_expr_has_address_of(expression)
                    _:
                        pass
            return false

        def proof_resource_expr_uses_local_borrow(expression: Ast::Expr, state: ProofResourceState&) -> bool:
            match expression:
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return slot < state.borrow_present.count and state.borrow_present[slot]
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_uses_local_borrow(operand, state)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_uses_local_borrow(inner, state)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_uses_local_borrow(left, state) or proof_resource_expr_uses_local_borrow(right, state)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_uses_local_borrow(callee, state)
                    for argument in arguments |argument, state|:
                        return true if proof_resource_expr_uses_local_borrow(argument, state)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_uses_local_borrow(object, state)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_uses_local_borrow(base, state)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_uses_local_borrow(object, state) or proof_resource_expr_uses_local_borrow(index, state)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_uses_local_borrow(object, state)
                    for argument in arguments |argument, state|:
                        return true if proof_resource_expr_uses_local_borrow(argument, state)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_uses_local_borrow(object, state) or proof_resource_expr_uses_local_borrow(low, state) or proof_resource_expr_uses_local_borrow(high, state)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_resource_expr_uses_local_borrow(operand, state)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state|:
                        return true if proof_resource_expr_uses_local_borrow(element, state)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state|:
                        return true if proof_resource_expr_uses_local_borrow(element, state)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state|:
                        return true if proof_resource_expr_uses_local_borrow(element, state)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state|:
                        return true if proof_resource_expr_uses_local_borrow(entry.key, state) or proof_resource_expr_uses_local_borrow(entry.value, state)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state|:
                        return true if proof_resource_expr_uses_local_borrow(field.value, state)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_uses_local_borrow(base, state)
                    for field in fields |field, state|:
                        return true if proof_resource_expr_uses_local_borrow(field.value, state)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_uses_local_borrow(condition, state) or proof_resource_expr_uses_local_borrow(then_expr, state) or proof_resource_expr_uses_local_borrow(else_expr, state)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_resource_expr_uses_local_borrow(iterable, state) or proof_resource_expr_uses_local_borrow(condition, state) or proof_resource_expr_uses_local_borrow(body, state)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_resource_expr_uses_local_borrow(base, state) or proof_resource_expr_uses_local_borrow(predicate, state)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_resource_expr_uses_local_borrow(scrutinee, state)
                    for arm in arms |arm, state|:
                        return true if proof_resource_expr_uses_local_borrow(arm.guard, state)
                        return true if proof_resource_statements_use_local_borrow(arm.body, state)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_uses_local_borrow(guarded, state)
                    for arm in arms |arm, state|:
                        return true if proof_resource_expr_uses_local_borrow(arm.guard, state)
                        return true if proof_resource_statements_use_local_borrow(arm.body, state)
                    return false
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_resource_expr_uses_local_borrow(guarded, state) or proof_resource_statements_use_local_borrow(recovery, state)
                Ast::Expr.Lambda(_, body, _):
                    return proof_resource_statements_use_local_borrow(body, state)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_resource_statements_use_local_borrow(statements, state) or proof_resource_expr_uses_local_borrow(value, state)
                _:
                    return false

        def proof_resource_statements_use_local_borrow(statements: darray[Ast::Stmt]&, state: ProofResourceState&) -> bool:
            for statement in statements:
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_resource_expr_uses_local_borrow(initializer, state)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        return true if proof_resource_expr_uses_local_borrow(target, state) or proof_resource_expr_uses_local_borrow(initializer, state)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_resource_expr_uses_local_borrow(expression, state)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_uses_local_borrow(returned, state)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_resource_expr_uses_local_borrow(condition, state) or proof_resource_statements_use_local_borrow(then_body, state) or proof_resource_statements_use_local_borrow(else_body, state)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_resource_expr_uses_local_borrow(condition, state) or proof_resource_statements_use_local_borrow(while_body, state)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        return true if proof_resource_expr_uses_local_borrow(iterable, state) or proof_resource_statements_use_local_borrow(for_body, state)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_resource_expr_uses_local_borrow(scrutinee, state)
                        for arm in arms |arm, state|:
                            return true if proof_resource_expr_uses_local_borrow(arm.guard, state) or proof_resource_statements_use_local_borrow(arm.body, state)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_use_local_borrow(block_body, state)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_resource_expr_uses_local_borrow(expression, state)
                    _:
                        pass
            return false

        def proof_resource_function_returns_reference(functions: ProofFunctionTable&, name: sview) -> bool:
            index: usize = proof_resource_function_index(functions, name)
            return index < functions.return_references.count and functions.return_references[index]

        # Only a direct return of one reference formal gets a compositional provenance summary.
        # Any richer return expression (field projection, conditional, aggregate, or multiple
        # sources) stays conservative until its lifetime relation is represented explicitly.
        def proof_resource_reference_return_parameter(parameters: darray[Ast::ParamDecl]&, return_type: Ast::Expr?, body: darray[Ast::Stmt]&) -> usize:
            if return_type is declared_return_type:
                return parameters.count if not proof_resource_is_reference_type(declared_return_type)
                candidate: mutable usize = parameters.count
                found: mutable bool = false
                for statement in body |parameters, candidate, found|:
                    match statement:
                        Ast::Stmt.Return(value, _):
                            if value is returned:
                                match returned:
                                    Ast::Expr.Ident(name, _):
                                        parameter_index: mutable usize = parameters.count
                                        for index in 0..<parameters.count |index, parameters, name, parameter_index|:
                                            parameter_index <- index if parameters[index].name == name
                                        return parameters.count if parameter_index >= parameters.count
                                        if not found:
                                            candidate <- parameter_index
                                            found <- true
                                        else:
                                            return parameters.count if candidate != parameter_index
                                    _:
                                        return parameters.count
                        _:
                            pass
                return candidate if found else parameters.count
            return parameters.count

        def proof_resource_borrow_result_is_local(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
            return true if not borrowed.known
            slot: usize = proof_resource_lookup(state, borrowed.place.root)
            return true if slot >= state.binding_names.count
            return false if slot < state.binding_reference.count and state.binding_reference[slot] and not (slot < state.borrow_present.count and state.borrow_present[slot])
            return true

        # Return escape is about the value produced by the expression, not every resource
        # operation performed while computing it. In particular, a call may borrow a local for
        # the duration of the call and return an ordinary value. The older whole-expression
        # predicate is still used for binding/contract boundaries where any hidden borrow is
        # intentionally conservative; this result-specific predicate is the narrower rule for
        # explicit returns and expression-arm values.
        def proof_resource_expr_returns_local_borrow(expression: Ast::Expr, state: ProofResourceState&, functions: ProofFunctionTable&, report: mutable ProofReport&) -> bool:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == TokenKind.Ampersand
                    return proof_resource_expr_returns_local_borrow(operand, state, functions, report)
                Ast::Expr.Move(operand, _):
                    return proof_resource_expr_returns_local_borrow(operand, state, functions, report)
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return slot < state.borrow_present.count and state.borrow_present[slot]
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_returns_local_borrow(inner, state, functions, report)
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    callee_name: sview = proof_callable_name(callee)
                    callee_index: usize = proof_resource_function_index(functions, callee_name)
                    if callee_index < functions.return_references.count:
                        return false if not functions.return_references[callee_index]
                        return true if callee_index >= functions.return_reference_parameters.count or callee_index >= functions.param_starts.count or callee_index >= functions.param_counts.count
                        source_parameter: usize = functions.return_reference_parameters[callee_index]
                        return true if source_parameter >= functions.param_counts[callee_index]
                        mapped: mutable darray[Ast::Expr] = []
                        # Reference provenance is admitted only for the same exact positional
                        # mapping used by resource calls. Named calls are resolved through the
                        # shared mapping helper below; no default or omitted actual is guessed.
                        return true if not proof_resource_map_call_arguments(functions, callee_index, arguments, argument_names, &mapped)
                        return true if source_parameter >= mapped.count
                        actual: Ast::Expr = mapped[source_parameter]
                        kind: sview = proof_resource_call_argument_kind(actual, state, report)
                        return proof_resource_expr_uses_local_borrow(actual, state) if kind == "reference"
                        return proof_resource_borrow_result_is_local(actual, state, report) if kind == "borrow"
                        return true
                    return true if proof_resource_expr_uses_local_borrow(callee, state)
                    for argument in arguments |argument, state, functions|:
                        return true if proof_resource_expr_returns_local_borrow(argument, state, functions, report)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_returns_local_borrow(object, state, functions, report)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_returns_local_borrow(base, state, functions, report)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_returns_local_borrow(object, state, functions, report) or proof_resource_expr_returns_local_borrow(index, state, functions, report)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_returns_local_borrow(object, state, functions, report)
                    for argument in arguments |argument, state, functions, report|:
                        return true if proof_resource_expr_returns_local_borrow(argument, state, functions, report)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_returns_local_borrow(object, state, functions, report) or proof_resource_expr_returns_local_borrow(low, state, functions, report) or proof_resource_expr_returns_local_borrow(high, state, functions, report)
                Ast::Expr.Binary(_, _, _, _):
                    # Binary operators produce values. Their operands may borrow temporarily,
                    # but that borrow is not itself the returned value.
                    return false
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_resource_expr_returns_local_borrow(operand, state, functions, report)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state, functions, report|:
                        return true if proof_resource_expr_returns_local_borrow(element, state, functions, report)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state, functions, report|:
                        return true if proof_resource_expr_returns_local_borrow(element, state, functions, report)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state, functions, report|:
                        return true if proof_resource_expr_returns_local_borrow(element, state, functions, report)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state, functions, report|:
                        return true if proof_resource_expr_returns_local_borrow(entry.key, state, functions, report) or proof_resource_expr_returns_local_borrow(entry.value, state, functions, report)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state, functions, report|:
                        return true if proof_resource_expr_returns_local_borrow(field.value, state, functions, report)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_returns_local_borrow(base, state, functions, report)
                    for field in fields |field, state, functions, report|:
                        return true if proof_resource_expr_returns_local_borrow(field.value, state, functions, report)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_returns_local_borrow(then_expr, state, functions, report) or proof_resource_expr_returns_local_borrow(else_expr, state, functions, report)
                Ast::Expr.Comprehension(_, _, _, body, _):
                    return proof_resource_expr_returns_local_borrow(body, state, functions, report)
                Ast::Expr.Refinement(base, _, _):
                    return proof_resource_expr_returns_local_borrow(base, state, functions, report)
                Ast::Expr.Match(scrutinee, arms, _):
                    for arm in arms |arm, state, functions, report|:
                        return true if proof_resource_statements_result_uses_local_borrow(arm.body, state, functions, report)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_returns_local_borrow(guarded, state, functions, report)
                    for arm in arms |arm, state, functions, report|:
                        return true if proof_resource_statements_result_uses_local_borrow(arm.body, state, functions, report)
                    return false
                Ast::Expr.Block(statements, value, _, _):
                    return true if proof_resource_statements_return_local_borrow(statements, state, functions, report)
                    return proof_resource_expr_returns_local_borrow(value, state, functions, report)
                Ast::Expr.Lambda(_, body, _):
                    # A lambda captures a fresh callable value; a borrow in its body is not the
                    # result of this expression, and closure lifetime checking remains separate.
                    return false if body.count > 0
                    return false
                _:
                    return false

        def proof_resource_statements_return_local_borrow(statements: darray[Ast::Stmt]&, state: ProofResourceState&, functions: ProofFunctionTable&, report: mutable ProofReport&) -> bool:
            for statement in statements |state, functions, report|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_returns_local_borrow(returned, state, functions, report)
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return true if proof_resource_statements_return_local_borrow(then_body, state, functions, report) or proof_resource_statements_return_local_borrow(else_body, state, functions, report)
                    Ast::Stmt.While(_, while_body, _):
                        return true if proof_resource_statements_return_local_borrow(while_body, state, functions, report)
                    Ast::Stmt.For(_, _, _, for_body, _):
                        return true if proof_resource_statements_return_local_borrow(for_body, state, functions, report)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |arm, state, functions, report|:
                            return true if proof_resource_statements_return_local_borrow(arm.body, state, functions, report)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_return_local_borrow(block_body, state, functions, report)
                    _:
                        pass
            return false

        def proof_resource_statements_result_uses_local_borrow(statements: darray[Ast::Stmt]&, state: ProofResourceState&, functions: ProofFunctionTable&, report: mutable ProofReport&) -> bool:
            return false if statements.count == 0
            return true if proof_resource_statements_return_local_borrow(statements, state, functions, report)
            last: Ast::Stmt = statements[statements.count - 1]
            match last:
                Ast::Stmt.Expr(expression, _):
                    return proof_resource_expr_returns_local_borrow(expression, state, functions, report)
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        return proof_resource_expr_returns_local_borrow(returned, state, functions, report)
                    return false
                _:
                    return false

        def proof_resource_is_discard_target(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name == "_"
                Ast::Expr.Paren(inner, _):
                    return proof_resource_is_discard_target(inner)
                _:
                    return false

        def proof_resource_expr_uses_borrowed_target(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            # A direct address-of is a resource-bearing value. Field/index places deliberately
            # stay outside the opaque-call rule when they are newly created; existing live field
            # borrows are still checked by the place overlap relation below.
            return true if proof_resource_direct_borrow_root(expression) != ""
            accessed: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            if accessed.known:
                slot: usize = proof_resource_lookup(state, accessed.place.root)
                return false if slot >= state.binding_names.count
                return true if slot < state.borrow_present.count and state.borrow_present[slot]
                return proof_resource_has_borrow_overlap_readonly(state, accessed.place, state.binding_names.count)
            match expression:
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return false if slot >= state.binding_names.count
                    return true if slot < state.borrow_present.count and state.borrow_present[slot]
                    return proof_resource_has_borrow_for(state, slot, state.binding_names.count)
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_uses_borrowed_target(operand, state, report)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_uses_borrowed_target(inner, state, report)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_uses_borrowed_target(left, state, report) or proof_resource_expr_uses_borrowed_target(right, state, report)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_uses_borrowed_target(object, state, report)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_uses_borrowed_target(base, state, report)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_uses_borrowed_target(object, state, report) or proof_resource_expr_uses_borrowed_target(index, state, report)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_uses_borrowed_target(object, state, report)
                    for argument in arguments |argument, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(argument, state, report)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_uses_borrowed_target(object, state, report) or proof_resource_expr_uses_borrowed_target(low, state, report) or proof_resource_expr_uses_borrowed_target(high, state, report)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_uses_borrowed_target(callee, state, report)
                    for argument in arguments |argument, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(argument, state, report)
                    return false
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_resource_expr_uses_borrowed_target(operand, state, report)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(element, state, report)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(element, state, report)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(element, state, report)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(entry.key, state, report) or proof_resource_expr_uses_borrowed_target(entry.value, state, report)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(field.value, state, report)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_uses_borrowed_target(base, state, report)
                    for field in fields |field, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(field.value, state, report)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_uses_borrowed_target(condition, state, report) or proof_resource_expr_uses_borrowed_target(then_expr, state, report) or proof_resource_expr_uses_borrowed_target(else_expr, state, report)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_resource_expr_uses_borrowed_target(iterable, state, report) or proof_resource_expr_uses_borrowed_target(condition, state, report) or proof_resource_expr_uses_borrowed_target(body, state, report)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_resource_expr_uses_borrowed_target(base, state, report) or proof_resource_expr_uses_borrowed_target(predicate, state, report)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_resource_expr_uses_borrowed_target(scrutinee, state, report)
                    for arm in arms |arm, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(arm.guard, state, report)
                        return true if proof_resource_statements_use_borrowed_target(arm.body, state, report)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_uses_borrowed_target(guarded, state, report)
                    for arm in arms |arm, state, report|:
                        return true if proof_resource_expr_uses_borrowed_target(arm.guard, state, report)
                        return true if proof_resource_statements_use_borrowed_target(arm.body, state, report)
                    return false
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_resource_expr_uses_borrowed_target(guarded, state, report) or proof_resource_statements_use_borrowed_target(recovery, state, report)
                Ast::Expr.Lambda(_, body, _):
                    return proof_resource_statements_use_borrowed_target(body, state, report)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_resource_statements_use_borrowed_target(statements, state, report) or proof_resource_expr_uses_borrowed_target(value, state, report)
                _:
                    return false

        def proof_resource_statements_use_borrowed_target(statements: darray[Ast::Stmt]&, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            for statement in statements:
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(initializer, report)
                        return true if borrowed.known or proof_resource_expr_uses_borrowed_target(initializer, state, report)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(initializer, report)
                        return true if proof_resource_expr_uses_borrowed_target(target, state, report) or borrowed.known or proof_resource_expr_uses_borrowed_target(initializer, state, report)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_resource_expr_uses_borrowed_target(expression, state, report)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_uses_borrowed_target(returned, state, report)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_resource_expr_uses_borrowed_target(condition, state, report) or proof_resource_statements_use_borrowed_target(then_body, state, report) or proof_resource_statements_use_borrowed_target(else_body, state, report)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_resource_expr_uses_borrowed_target(condition, state, report) or proof_resource_statements_use_borrowed_target(while_body, state, report)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        return true if proof_resource_expr_uses_borrowed_target(iterable, state, report) or proof_resource_statements_use_borrowed_target(for_body, state, report)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_resource_expr_uses_borrowed_target(scrutinee, state, report)
                        for arm in arms |arm, state, report|:
                            return true if proof_resource_expr_uses_borrowed_target(arm.guard, state, report) or proof_resource_statements_use_borrowed_target(arm.body, state, report)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_use_borrowed_target(block_body, state, report)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_resource_expr_uses_borrowed_target(expression, state, report)
                    _:
                        pass
            return false

        def proof_resource_check_expression[@s, @r](expression: Ast::Expr, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, functions: ProofFunctionTable&) -> void:
            match expression:
                Ast::Expr.Ident(name, position):
                    slot: usize = proof_resource_lookup(state, name)
                    if slot < state.binding_names.count:
                        region: sview = proof_resource_binding_region(state, slot)
                        stale_region: bool = region != "" and (not proof_resource_binding_region_is_live(state, slot) or not proof_resource_region_is_active(state, region))
                        proof_resource_add_failing_obligation(report, "region-use-after-destroy", position, function_name, "a region-owned binding is used after its region was destroyed") if stale_region
                        proof_resource_add_failing_obligation(report, "resource-use-after-move", position, function_name, "a moved resource is used again") if proof_resource_binding_is_moved(state, slot)
                        access_root: usize = proof_resource_encode_access_place(expression, report)
                        proof_resource_record_event(state, report, "resource-use", "", access_root, name, "", 0) if not stale_region
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    proof_resource_check_expression(callee, state, report, function_name, functions)
                    resource_argument: mutable bool = false
                    region_argument: mutable bool = false
                    normalized_arguments: mutable darray[Ast::Expr] = []
                    allocation_roots: mutable darray[usize] = []
                    for argument in arguments |argument, state, report, function_name, functions, position, resource_argument, region_argument, normalized_arguments, allocation_roots|:
                        new_parts: (known: bool, operand: Ast::Expr, region: sview) = proof_resource_region_new_parts(argument)
                        if new_parts.known:
                            proof_resource_check_expression(new_parts.operand, state, report, function_name, functions)
                            allocation_root: usize = proof_resource_add_region_call_allocation(state, report, new_parts.operand, new_parts.region, position, function_name)
                            normalized_arguments.push(Ast::Expr.RegionNew(new_parts.operand, new_parts.region, Ast::expr_pos(argument)))
                            allocation_roots.push(allocation_root)
                            region_argument <- true
                        else:
                            proof_resource_check_expression(argument, state, report, function_name, functions)
                            normalized_arguments.push(argument)
                            allocation_roots.push(0)
                            resource_argument <- true if proof_resource_expr_carries_resource(argument, state, report)
                            region_argument <- true if proof_resource_expr_contains_region_value(argument, state)
                    callee_name: sview = proof_callable_name(callee)
                    callee_index: usize = proof_resource_function_index(functions, callee_name)
                    region_polymorphic_call: bool = callee_index < functions.region_param_counts.count and functions.region_param_counts[callee_index] > 0
                    if resource_argument or region_argument or region_polymorphic_call:
                        summary: (known: bool, root: usize) = proof_resource_summary_is_ready(functions, report, function_name, callee_name)
                        mapped: mutable darray[Ast::Expr] = []
                        mapped_allocation_roots: mutable darray[usize] = []
                        mapped_ok: bool = summary.known and callee_index < functions.names.count and proof_resource_map_call_arguments(functions, callee_index, normalized_arguments, argument_names, &mapped) and proof_resource_map_call_allocation_roots(functions, callee_index, normalized_arguments, argument_names, allocation_roots, &mapped_allocation_roots)
                        if summary.known and mapped_ok:
                            recorded: bool = proof_resource_record_call(state, report, callee_name, summary.root, callee_index, mapped, mapped_allocation_roots, functions)
                            proof_resource_add_failing_obligation(report, "region-call-opaque", position, function_name, "a region-polymorphic call is not mapped to a verified caller region") if (region_argument or region_polymorphic_call) and not recorded
                            proof_resource_add_failing_obligation(report, "borrow-call-summary-unsupported", position, function_name, "the checked callee resource summary could not be encoded for this call") if resource_argument and not recorded
                        elif summary.known:
                            proof_resource_add_failing_obligation(report, "region-call-opaque", position, function_name, "a region-polymorphic call requires an exact verified region summary") if region_argument or region_polymorphic_call
                            proof_resource_add_failing_obligation(report, "borrow-call-summary-unsupported", position, function_name, "borrow-carrying call requires an exact argument mapping with no unresolved defaults") if resource_argument
                        else:
                            proof_resource_add_failing_obligation(report, "region-call-opaque", position, function_name, "a region-polymorphic call has no converged lifetime summary") if region_argument or region_polymorphic_call
                            proof_resource_add_failing_obligation(report, "borrow-call-opaque", position, function_name, "a call argument carries a resource, but no converged callee resource summary is available") if resource_argument
                Ast::Expr.Move(operand, position):
                    root: sview = proof_resource_place_root(operand)
                    slot: usize = proof_resource_lookup(state, root)
                    access: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(operand, report)
                    proof_resource_check_expression(operand, state, report, function_name, functions)
                    moved: bool = slot < state.binding_names.count and proof_resource_binding_is_moved(state, slot)
                    conflict: bool = moved or (slot < state.binding_names.count and ((slot < state.borrow_present.count and state.borrow_present[slot]) or proof_resource_has_borrow_overlap(state, report, access.place, state.binding_names.count)))
                    if conflict:
                        proof_resource_add_failing_obligation(report, "borrow-move-conflict", position, function_name, "a live borrow prevents moving the borrowed root or borrow handle") if not moved
                    elif root != "" and slot < state.binding_names.count:
                        access_root: usize = proof_resource_encode_access_place(operand, report)
                        proof_resource_record_event(state, report, "resource-move", "", access_root, root, "", 0)
                        proof_resource_mark_binding_moved(state, slot)
                Ast::Expr.Unary(_, operand, _):
                    proof_resource_check_expression(operand, state, report, function_name, functions)
                Ast::Expr.Paren(inner, _):
                    proof_resource_check_expression(inner, state, report, function_name, functions)
                Ast::Expr.Binary(left, _, right, _):
                    proof_resource_check_expression(left, state, report, function_name, functions)
                    proof_resource_check_expression(right, state, report, function_name, functions)
                Ast::Expr.Field(object, _, _):
                    proof_resource_check_expression(object, state, report, function_name, functions)
                Ast::Expr.Scope(base, _, _):
                    proof_resource_check_expression(base, state, report, function_name, functions)
                Ast::Expr.Index(object, index, _):
                    proof_resource_check_expression(object, state, report, function_name, functions)
                    proof_resource_check_expression(index, state, report, function_name, functions)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_resource_check_expression(object, state, report, function_name, functions)
                    for argument in arguments |argument, state, report, function_name, functions|:
                        proof_resource_check_expression(argument, state, report, function_name, functions)
                Ast::Expr.Slice(object, low, high, _):
                    proof_resource_check_expression(object, state, report, function_name, functions)
                    proof_resource_check_expression(low, state, report, function_name, functions)
                    proof_resource_check_expression(high, state, report, function_name, functions)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_resource_check_expression(operand, state, report, function_name, functions)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state, report, function_name, functions|:
                        proof_resource_check_expression(element, state, report, function_name, functions)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state, report, function_name, functions|:
                        proof_resource_check_expression(element, state, report, function_name, functions)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state, report, function_name, functions|:
                        proof_resource_check_expression(element, state, report, function_name, functions)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state, report, function_name, functions|:
                        proof_resource_check_expression(entry.key, state, report, function_name, functions)
                        proof_resource_check_expression(entry.value, state, report, function_name, functions)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state, report, function_name, functions|:
                        proof_resource_check_expression(field.value, state, report, function_name, functions)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_resource_check_expression(base, state, report, function_name, functions)
                    for field in fields |field, state, report, function_name, functions|:
                        proof_resource_check_expression(field.value, state, report, function_name, functions)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    proof_resource_check_expression(condition, state, report, function_name, functions)
                    proof_resource_check_expression(then_expr, state, report, function_name, functions)
                    proof_resource_check_expression(else_expr, state, report, function_name, functions)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    proof_resource_check_expression(iterable, state, report, function_name, functions)
                    proof_resource_check_expression(condition, state, report, function_name, functions)
                    proof_resource_check_expression(body, state, report, function_name, functions)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_resource_check_expression(base, state, report, function_name, functions)
                    proof_resource_check_expression(predicate, state, report, function_name, functions)
                Ast::Expr.Match(scrutinee, arms, _):
                    proof_resource_check_expression(scrutinee, state, report, function_name, functions)
                    for arm in arms |arm, state, report, function_name, functions|:
                        arm_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &arm_state)
                        proof_resource_check_pattern_names(arm.pattern, &arm_state, report, functions)
                        proof_resource_check_expression(arm.guard, &arm_state, report, function_name, functions)
                        proof_resource_check_statements(arm.body, &arm_state, report, function_name, functions)
                        proof_resource_close_child(state, arm_state, report, true)
                Ast::Expr.Catch(guarded, arms, _):
                    proof_resource_check_expression(guarded, state, report, function_name, functions)
                    for arm in arms |arm, state, report, function_name, functions|:
                        arm_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &arm_state)
                        proof_resource_check_pattern_names(arm.pattern, &arm_state, report, functions)
                        proof_resource_check_expression(arm.guard, &arm_state, report, function_name, functions)
                        proof_resource_check_statements(arm.body, &arm_state, report, function_name, functions)
                        proof_resource_close_child(state, arm_state, report, true)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_resource_check_expression(guarded, state, report, function_name, functions)
                    recovery_state: mutable ProofResourceState = proof_resource_empty()
                    proof_resource_copy_into(state, &recovery_state)
                    proof_resource_check_statements(recovery, &recovery_state, report, function_name, functions)
                    proof_resource_close_child(state, recovery_state, report, false)
                Ast::Expr.Lambda(parameters, body, _):
                    lambda_state: mutable ProofResourceState = proof_resource_empty()
                    proof_resource_copy_into(state, &lambda_state)
                    for parameter in parameters |parameter, lambda_state|:
                        proof_resource_add_binding_traced(&lambda_state, report, parameter, false, false, false, lambda_state.binding_names.count, false, "", proof_resource_empty_place(), 0)
                    proof_resource_check_statements(body, &lambda_state, report, function_name, functions)
                    proof_resource_close_child(state, lambda_state, report, false)
                Ast::Expr.Block(statements, value, _, _):
                    child: mutable ProofResourceState = proof_resource_empty()
                    proof_resource_copy_into(state, &child)
                    proof_resource_check_statements(statements, &child, report, function_name, functions)
                    proof_resource_check_expression(value, &child, report, function_name, functions)
                    proof_resource_close_child(state, child, report, true)
                _:
                    pass

        def proof_resource_check_write[@s, @r](target: Ast::Expr, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: ProofFunctionTable&) -> void:
            root: sview = proof_resource_place_root(target)
            return if root == ""
            slot: usize = proof_resource_lookup(state, root)
            return if slot >= state.binding_names.count
            region: sview = proof_resource_binding_region(state, slot)
            if region != "" and (not proof_resource_binding_region_is_live(state, slot) or not proof_resource_region_is_active(state, region)):
                proof_resource_add_failing_obligation(report, "region-use-after-destroy", position, function_name, "a region-owned binding is written after its region was destroyed")
                return
            if proof_resource_binding_is_moved(state, slot):
                proof_resource_add_failing_obligation(report, "resource-use-after-move", position, function_name, "a moved resource is written again")
                return
            access: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(target, report)
            is_reference: bool = slot < state.binding_reference.count and state.binding_reference[slot]
            is_mutable_reference: bool = slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot]
            conflict: mutable bool = false
            if is_reference and not is_mutable_reference:
                conflict <- true
                proof_resource_add_failing_obligation(report, "borrow-readonly-write", position, function_name, "a write through an immutable reference is not permitted by the proof resource state")
            elif not is_reference and proof_resource_has_borrow_overlap(state, report, access.place, state.binding_names.count):
                conflict <- true
                proof_resource_add_failing_obligation(report, "borrow-write-conflict", position, function_name, "a write to a place overlapping a live borrow is not permitted by the proof resource state")
            if not conflict:
                access_root: usize = proof_resource_encode_access_place(target, report)
                proof_resource_record_event(state, report, "resource-write", "", access_root, root, "", 0)

        # Return the tracked region carried by a direct value path. Calls and aggregate
        # transformations intentionally return no region here; their broader recursive check
        # below rejects a hidden region value instead of guessing its lifetime.
        def proof_resource_expr_region(expression: Ast::Expr, state: ProofResourceState&) -> sview:
            match expression:
                Ast::Expr.RegionNew(_, region, _):
                    return region
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return proof_resource_binding_region(state, slot) if slot < state.binding_names.count and proof_resource_binding_region_is_live(state, slot)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_region(inner, state)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_region(object, state)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_region(base, state)
                Ast::Expr.Index(object, _, _):
                    return proof_resource_expr_region(object, state)
                Ast::Expr.IndexN(object, _, _):
                    return proof_resource_expr_region(object, state)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_resource_expr_region(object, state)
                _:
                    return ""
            return ""

        # A call returning `T& @r` carries the caller's concrete region only when the callee has
        # a verified resource summary and its explicit `@r` witness is mapped at this call site.
        # This is intentionally separate from proof_resource_expr_region: that helper handles
        # direct tracked paths, while this one is the summary-backed result rule.
        def proof_resource_call_result_region(expression: Ast::Expr, state: ProofResourceState&, functions: ProofFunctionTable&, report: ProofReport&) -> sview:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    callee_name: sview = proof_callable_name(callee)
                    function_index: usize = proof_resource_function_index(functions, callee_name)
                    return "" if function_index >= functions.return_references.count or not functions.return_references[function_index]
                    return_region: sview = proof_resource_function_return_region(functions, function_index)
                    return "" if return_region == ""
                    region_count: usize = proof_resource_function_region_param_count(functions, function_index)
                    formal_region_index: mutable usize = region_count
                    for candidate in 0..<region_count |candidate, functions, function_index, return_region, formal_region_index|:
                        formal_region_index <- candidate if proof_resource_function_region_param_at(functions, function_index, candidate) == return_region
                    return "" if formal_region_index >= region_count
                    return "" if function_index >= functions.verified.count or not functions.verified[function_index]
                    summary_root: mutable usize = report.kernel_nodes.count
                    for candidate_root in 0..<report.kernel_nodes.count |candidate_root, report, callee_name, summary_root|:
                        candidate: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[candidate_root]
                        summary_root <- candidate_root if candidate.kind == "resource-safety" and candidate.name == callee_name and candidate.secondary_name == "resource-v1"
                    return "" if summary_root >= report.kernel_nodes.count
                    mapped: mutable darray[Ast::Expr] = []
                    return "" if not proof_resource_map_call_arguments(functions, function_index, arguments, argument_names, &mapped)
                    formal_regions: mutable darray[sview] = []
                    actual_regions: mutable darray[sview] = []
                    return "" if not proof_resource_collect_call_regions(state, functions, function_index, mapped, &formal_regions, &actual_regions)
                    return actual_regions[formal_region_index] if formal_region_index < actual_regions.count
                Ast::Expr.Paren(inner, _):
                    return proof_resource_call_result_region(inner, state, functions, report)
                _:
                    pass
            return ""

        def proof_resource_expr_result_region(expression: Ast::Expr, state: ProofResourceState&, functions: ProofFunctionTable&, report: ProofReport&) -> sview:
            direct: sview = proof_resource_expr_region(expression, state)
            return direct if direct != ""
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return proof_resource_call_result_region(expression, state, functions, report)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_result_region(inner, state, functions, report)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_result_region(object, state, functions, report)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_result_region(base, state, functions, report)
                Ast::Expr.Index(object, _, _):
                    return proof_resource_expr_result_region(object, state, functions, report)
                Ast::Expr.IndexN(object, _, _):
                    return proof_resource_expr_result_region(object, state, functions, report)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_resource_expr_result_region(object, state, functions, report)
                _:
                    pass
            return ""

        # A verified call consumes direct region temporaries as part of its resource transition.
        # Do not confuse those consumed inputs with a region value produced by the call. Calls
        # whose result is itself region-tied remain visible here; unresolved calls are already
        # rejected by the call-summary/resource transition above.
        def proof_resource_expr_contains_unresolved_region_value(expression: Ast::Expr, state: ProofResourceState&, functions: ProofFunctionTable&, report: ProofReport&) -> bool:
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    return true if proof_resource_expr_result_region(expression, state, functions, report) != ""
                    return proof_resource_expr_contains_region_value(callee, state)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_contains_unresolved_region_value(inner, state, functions, report)
                _:
                    return proof_resource_expr_contains_region_value(expression, state)

        # A region-polymorphic callee may return/use values tied to an EXTERNAL caller region. A
        # local region remains forbidden at return, so keep that distinction explicit instead of
        # weakening the general region-value predicate used at opaque boundaries.
        def proof_resource_expr_contains_local_region_value(expression: Ast::Expr, state: ProofResourceState&) -> bool:
            match expression:
                Ast::Expr.RegionNew(_, region, _):
                    return region != "" and not proof_resource_region_is_external(state, region)
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    region: sview = proof_resource_binding_region(state, slot)
                    return slot < state.binding_names.count and region != "" and not proof_resource_region_is_external(state, region)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_contains_local_region_value(inner, state)
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_contains_local_region_value(operand, state)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_contains_local_region_value(left, state) or proof_resource_expr_contains_local_region_value(right, state)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_contains_local_region_value(callee, state)
                    for argument in arguments |argument, state|:
                        return true if proof_resource_expr_contains_local_region_value(argument, state)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_contains_local_region_value(object, state)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_contains_local_region_value(base, state)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_contains_local_region_value(object, state) or proof_resource_expr_contains_local_region_value(index, state)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_contains_local_region_value(object, state)
                    for argument in arguments |argument, state|:
                        return true if proof_resource_expr_contains_local_region_value(argument, state)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_contains_local_region_value(object, state) or proof_resource_expr_contains_local_region_value(low, state) or proof_resource_expr_contains_local_region_value(high, state)
                Ast::Expr.Move(operand, _):
                    return proof_resource_expr_contains_local_region_value(operand, state)
                _:
                    return false

        # A call may consume a local region temporary while returning an ordinary scalar. The
        # lifetime of the returned value is therefore not the union of all input lifetimes. Use
        # the verified result summary for calls, while retaining the conservative recursive walk
        # for every other expression shape.
        def proof_resource_expr_returns_local_region_value(expression: Ast::Expr, state: ProofResourceState&, functions: ProofFunctionTable&, report: ProofReport&) -> bool:
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    returned_region: sview = proof_resource_expr_result_region(expression, state, functions, report)
                    return returned_region != "" and not proof_resource_region_is_external(state, returned_region)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_returns_local_region_value(inner, state, functions, report)
                _:
                    return proof_resource_expr_contains_local_region_value(expression, state)

        # This is deliberately a conservative taint walk. Once a region value enters a call,
        # arithmetic expression, conditional, aggregate, lambda, or other opaque transformer,
        # the proof system does not have a lifetime summary for that operation and must reject
        # the boundary rather than treating the result as an ordinary value.
        def proof_resource_expr_contains_region_value(expression: Ast::Expr, state: ProofResourceState&) -> bool:
            match expression:
                Ast::Expr.RegionNew(_, _, _):
                    return true
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return slot < state.binding_names.count and proof_resource_binding_region(state, slot) != ""
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_contains_region_value(inner, state)
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_contains_region_value(operand, state)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_contains_region_value(left, state) or proof_resource_expr_contains_region_value(right, state)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_contains_region_value(callee, state)
                    for argument in arguments |argument, state|:
                        return true if proof_resource_expr_contains_region_value(argument, state)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_contains_region_value(object, state)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_contains_region_value(base, state)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_contains_region_value(object, state) or proof_resource_expr_contains_region_value(index, state)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_contains_region_value(object, state)
                    for argument in arguments |argument, state|:
                        return true if proof_resource_expr_contains_region_value(argument, state)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_contains_region_value(object, state) or proof_resource_expr_contains_region_value(low, state) or proof_resource_expr_contains_region_value(high, state)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state|:
                        return true if proof_resource_expr_contains_region_value(element, state)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state|:
                        return true if proof_resource_expr_contains_region_value(element, state)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state|:
                        return true if proof_resource_expr_contains_region_value(element, state)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state|:
                        return true if proof_resource_expr_contains_region_value(entry.key, state) or proof_resource_expr_contains_region_value(entry.value, state)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state|:
                        return true if proof_resource_expr_contains_region_value(field.value, state)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_contains_region_value(base, state)
                    for field in fields |field, state|:
                        return true if proof_resource_expr_contains_region_value(field.value, state)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_contains_region_value(condition, state) or proof_resource_expr_contains_region_value(then_expr, state) or proof_resource_expr_contains_region_value(else_expr, state)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_resource_expr_contains_region_value(iterable, state) or proof_resource_expr_contains_region_value(condition, state) or proof_resource_expr_contains_region_value(body, state)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_resource_expr_contains_region_value(base, state) or proof_resource_expr_contains_region_value(predicate, state)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_resource_expr_contains_region_value(scrutinee, state)
                    for arm in arms |arm, state|:
                        return true if proof_resource_expr_contains_region_value(arm.guard, state) or proof_resource_statements_use_region_value(arm.body, state)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_contains_region_value(guarded, state)
                    for arm in arms |arm, state|:
                        return true if proof_resource_expr_contains_region_value(arm.guard, state) or proof_resource_statements_use_region_value(arm.body, state)
                    return false
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_resource_expr_contains_region_value(guarded, state) or proof_resource_statements_use_region_value(recovery, state)
                Ast::Expr.Lambda(_, body, _):
                    return proof_resource_statements_use_region_value(body, state)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_resource_statements_use_region_value(statements, state) or proof_resource_expr_contains_region_value(value, state)
                _:
                    return false

        def proof_resource_statements_use_region_value(statements: darray[Ast::Stmt]&, state: ProofResourceState&) -> bool:
            for statement in statements:
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_resource_expr_contains_region_value(initializer, state)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        return true if proof_resource_expr_contains_region_value(target, state) or proof_resource_expr_contains_region_value(initializer, state)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_resource_expr_contains_region_value(expression, state)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_contains_region_value(returned, state)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_resource_expr_contains_region_value(condition, state) or proof_resource_statements_use_region_value(then_body, state) or proof_resource_statements_use_region_value(else_body, state)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_resource_expr_contains_region_value(condition, state) or proof_resource_statements_use_region_value(while_body, state)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        return true if proof_resource_expr_contains_region_value(iterable, state) or proof_resource_statements_use_region_value(for_body, state)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_resource_expr_contains_region_value(scrutinee, state)
                        for arm in arms |arm, state|:
                            return true if proof_resource_expr_contains_region_value(arm.guard, state) or proof_resource_statements_use_region_value(arm.body, state)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_use_region_value(block_body, state)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_resource_expr_contains_region_value(expression, state)
                    _:
                        pass
            return false

        # A child region may expose a value to the enclosing resource state only when that
        # value is still owned by a region that remains active in the parent. Locals introduced
        # inside the region are dropped with the child and therefore need no join operation.
        def proof_resource_check_region_boundary[@r](parent: ProofResourceState&, child: ProofResourceState&, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos) -> void:
            for index in 0..<child.binding_region.count |index, child, parent, report, function_name, position|:
                region: sview = child.binding_region[index]
                if region != "" and index < parent.binding_names.count and (not proof_resource_binding_region_is_live(child, index) or not proof_resource_region_is_active(parent, region)):
                    proof_resource_add_failing_obligation(report, "region-store-escape", position, function_name, "a region-owned value outlives the lexical region that owns its storage")

        def proof_resource_direct_binding_name(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_resource_direct_binding_name(inner)
                _:
                    return ""

        def proof_resource_handle_region_assignment[@s, @r](target: Ast::Expr, initializer: Ast::Expr, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: ProofFunctionTable&) -> void:
            match initializer:
                Ast::Expr.RegionNew(operand, region, _):
                    proof_resource_add_region_discard(state, report, operand, region, position, function_name) if proof_resource_is_discard_target(target)
                    proof_resource_rebind_region_allocation(state, report, target, operand, region, position, function_name) if not proof_resource_is_discard_target(target)
                    return
                _:
                    pass
            assigned_region: sview = proof_resource_expr_result_region(initializer, state, functions, report)
            if assigned_region != "":
                target_name: sview = proof_resource_direct_binding_name(target)
                target_slot: usize = proof_resource_lookup(state, target_name)
                source_place: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(initializer, report)
                source_slot: usize = proof_resource_lookup(state, source_place.place.root)
                target_access: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(target, report)
                encoded_source: usize = proof_resource_encode_access_place(initializer, report)
                valid: bool = target_name != "" and target_slot < state.binding_names.count and source_slot < state.binding_names.count and source_place.known and target_access.known and not proof_resource_binding_is_moved(state, source_slot) and not proof_resource_binding_is_moved(state, target_slot) and not proof_resource_has_borrow_overlap(state, report, target_access.place, state.binding_names.count) and proof_resource_region_is_active(state, assigned_region) and encoded_source < report.kernel_nodes.count
                proof_resource_add_failing_obligation(report, "region-store-escape", position, function_name, "a region-owned value may be assigned only to a directly tracked live binding") if not valid
                if valid:
                    state.binding_region[target_slot] <- assigned_region
                    state.binding_region_live[target_slot] <- true
                    proof_resource_record_event(state, report, "resource-region-assign", "", encoded_source, target_name, assigned_region, 0)
            if assigned_region == "" and proof_resource_expr_contains_unresolved_region_value(initializer, state, functions, report):
                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region value flows through an assignment without a lifetime summary")

        def proof_resource_check_var[@s, @r](statement_name: sview, type_expression: Ast::Expr, initializer: Ast::Expr, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: ProofFunctionTable&) -> void:
            is_reference: bool = proof_resource_is_reference_type(type_expression)
            is_mutable_reference: bool = is_reference and proof_resource_is_mutable_reference_type(type_expression)
            direct_region: mutable sview = ""
            direct_region_operand: mutable Ast::Expr = Ast::Expr.Invalid
            match initializer:
                Ast::Expr.RegionNew(operand, region, _):
                    direct_region <- region
                    direct_region_operand <- operand
                _:
                    pass
            if direct_region != "":
                proof_resource_check_expression(direct_region_operand, state, report, function_name, functions)
                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region allocation operand contains a value whose lifetime is not summarized") if proof_resource_expr_contains_region_value(direct_region_operand, state)
                proof_resource_add_region_allocation(state, report, statement_name, type_expression, direct_region_operand, direct_region, position, function_name)
                return
            source_region: sview = proof_resource_expr_result_region(initializer, state, functions, report)
            if source_region != "":
                proof_resource_check_expression(initializer, state, report, function_name, functions)
                callee_name: mutable sview = ""
                match initializer:
                    Ast::Expr.Call(callee, _, _, _):
                        callee_name <- proof_callable_name(callee)
                    _:
                        pass
                result_function_index: usize = proof_resource_function_index(functions, callee_name) if callee_name != "" else functions.names.count
                result_is_reference: bool = result_function_index < functions.return_references.count and functions.return_references[result_function_index]
                if result_is_reference and callee_name != "":
                    is_mutable_result: bool = result_function_index < functions.return_mutable_references.count and functions.return_mutable_references[result_function_index]
                    writable_result: bool = is_mutable_result or proof_resource_type_has_marker(type_expression, TokenKind.Mutable)
                    proof_resource_add_binding(state, statement_name, true, is_mutable_result, writable_result, state.binding_names.count, false, proof_resource_empty_place())
                    state.binding_region[state.binding_region.count - 1] <- source_region
                    state.binding_region_live[state.binding_region_live.count - 1] <- proof_resource_region_is_active(state, source_region)
                    call_event: usize = state.trace_events[state.trace_events.count - 1] if state.trace_events.count > 0 else report.kernel_nodes.count
                    valid_call_event: bool = call_event < report.kernel_nodes.count and report.kernel_nodes[call_event].kind == "resource-call"
                    proof_resource_record_event(state, report, "resource-call-result", "", call_event, statement_name, source_region, (1 if writable_result else 0) + 2 + (4 if is_mutable_result else 0)) if valid_call_event
                    proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "a region-returning call did not leave a replayable call transition") if not valid_call_event
                    return
                proof_resource_add_region_binding(state, report, statement_name, type_expression, initializer, source_region, position, function_name)
                return
            if proof_resource_expr_contains_unresolved_region_value(initializer, state, functions, report):
                proof_resource_check_expression(initializer, state, report, function_name, functions)
                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region value flows through an expression without a lifetime summary")
                proof_resource_add_binding_traced(state, report, statement_name, is_reference, is_mutable_reference, is_mutable_reference or proof_resource_type_has_marker(type_expression, TokenKind.Mutable), state.binding_names.count, false, "", proof_resource_empty_place(), 0)
                return
            direct_root: sview = proof_resource_direct_borrow_root(initializer)
            borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(initializer, report)
            proof_resource_check_expression(initializer, state, report, function_name, functions)
            if is_reference and not borrowed.known:
                proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "reference initializer is not a bounded static address-of borrow")
            elif not is_reference and proof_resource_expr_returns_local_borrow(initializer, state, functions, report):
                proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "address-of value enters a non-reference binding")
            target_slot: mutable usize = state.binding_names.count
            borrow_is_mutable: mutable bool = false
            source_place_root: mutable usize = 0
            source_name: sview = borrowed.place.root if borrowed.known else direct_root
            if borrowed.known:
                target_slot <- proof_resource_lookup(state, borrowed.place.root)
                if target_slot >= state.binding_names.count:
                    proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "borrow target is not a live proof binding")
                else:
                    borrow_is_mutable <- is_mutable_reference
                    if borrow_is_mutable and proof_resource_has_borrow_overlap(state, report, borrowed.place, state.binding_names.count):
                        proof_resource_add_failing_obligation(report, "borrow-alias-conflict", position, function_name, "mutable borrow conflicts with another live borrow of the same root")
                    elif not borrow_is_mutable and proof_resource_has_mutable_borrow_overlap(state, report, borrowed.place, state.binding_names.count):
                        proof_resource_add_failing_obligation(report, "borrow-alias-conflict", position, function_name, "shared borrow conflicts with a live mutable borrow of the same root")
                    # Reuse the exact path already stored in the resource state. Re-encoding the
                    # same AST would create structurally equal but numerically different roots,
                    # which would make replayed resource-disjoint evidence unable to identify the
                    # path component it justified.
                    source_place_root <- borrowed.place.path_root
            if borrowed.known and target_slot < state.binding_names.count and borrow_is_mutable:
                source_writable: bool = target_slot < state.binding_writable.count and (state.binding_writable[target_slot] or (target_slot < state.binding_mutable_reference.count and state.binding_mutable_reference[target_slot]))
                proof_resource_add_failing_obligation(report, "borrow-mutable-source", position, function_name, "mutable borrow requires a writable source binding") if not source_writable
            writable: bool = is_mutable_reference or proof_resource_type_has_marker(type_expression, TokenKind.Mutable)
            proof_resource_add_binding_traced(state, report, statement_name, is_reference, is_mutable_reference, writable, target_slot, borrow_is_mutable, source_name, borrowed.place, source_place_root) if is_reference
            proof_resource_add_binding_traced(state, report, statement_name, false, false, writable, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if not is_reference

        def proof_resource_check_pattern_names[@s, @r](pattern: Ast::Pattern, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, functions: ProofFunctionTable&) -> void:
            match pattern:
                Ast::Pattern.Binding(binding):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                Ast::Pattern.Rest(binding):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                Ast::Pattern.TypeBind(_, binding):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                Ast::Pattern.As(binding, inner):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                    for nested in inner |nested, state, report|:
                        proof_resource_check_pattern_names(nested, state, report, functions)
                Ast::Pattern.Variant(_, fields):
                    for field in fields |field, state, report|:
                        match field:
                            Ast::Pattern.Field(_, inner):
                                for nested in inner |nested, state, report|:
                                    proof_resource_check_pattern_names(nested, state, report, functions)
                            _:
                                pass
                Ast::Pattern.Or(options):
                    # Alternatives are checked independently by the statement walker. Their
                    # bindings are deliberately not merged into one resource state.
                    pass
                _:
                    pass

        def proof_resource_check_statements[@s, @r](statements: darray[Ast::Stmt]&, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, functions: ProofFunctionTable&) -> void:
            for statement in statements |state, report, function_name|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                        shadowed: bool = proof_resource_lookup(state, local_name) < state.binding_names.count
                        proof_resource_check_var(local_name, type_expression, initializer, state, report, function_name, position, functions)
                        state.facts.clear() if shadowed or proof_resource_expr_has_call(initializer) or proof_resource_expr_has_move(initializer)
                    Ast::Stmt.Assign(target, _, initializer, position):
                        if not proof_resource_is_discard_target(target) and proof_resource_expr_returns_local_borrow(initializer, state, functions, report):
                            proof_resource_add_failing_obligation(report, "borrow-escape", position, function_name, "a newly created borrow is assigned across a binding boundary")
                        proof_resource_check_write(target, state, report, function_name, position, functions)
                        proof_resource_check_expression(target, state, report, function_name, functions)
                        proof_resource_check_expression(initializer, state, report, function_name, functions)
                        proof_resource_handle_region_assignment(target, initializer, state, report, function_name, position, functions)
                        state.facts.clear()
                    Ast::Stmt.Expr(expression, position):
                        match expression:
                            Ast::Expr.RegionNew(operand, region, _):
                                # `new[r] value` is itself the resource transition. A bare
                                # expression statement discards the resulting reference, but
                                # the allocation remains valid and must be replayed explicitly.
                                proof_resource_check_expression(operand, state, report, function_name, functions)
                                proof_resource_add_region_discard(state, report, operand, region, position, function_name)
                            _:
                                proof_resource_check_expression(expression, state, report, function_name, functions)
                                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "a region-owned expression must be bound or explicitly rejected at this resource boundary") if proof_resource_expr_contains_unresolved_region_value(expression, state, functions, report)
                        state.facts.clear() if proof_resource_expr_has_call(expression) or proof_resource_expr_has_move(expression)
                    Ast::Stmt.Return(value, position):
                        if value is returned:
                            if proof_resource_expr_returns_local_borrow(returned, state, functions, report):
                                proof_resource_add_failing_obligation(report, "borrow-escape", position, function_name, "a borrow cannot escape this lexical proof resource state")
                            proof_resource_add_failing_obligation(report, "region-return-escape", position, function_name, "a region-owned value cannot escape the region that owns its storage") if proof_resource_expr_returns_local_region_value(returned, state, functions, report)
                            returned_region: sview = proof_resource_expr_result_region(returned, state, functions, report)
                            match returned:
                                Ast::Expr.RegionNew(operand, allocated_region, _):
                                    proof_resource_add_region_return_alloc(state, report, operand, allocated_region, position, function_name) if allocated_region != "" and proof_resource_region_is_external(state, allocated_region)
                                _:
                                    pass
                            proof_resource_record_event(state, report, "resource-region-return", "param", 0, returned_region, "", 0) if returned_region != "" and proof_resource_region_is_external(state, returned_region)
                            proof_resource_check_expression(returned, state, report, function_name, functions)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_resource_check_expression(condition, state, report, function_name, functions)
                        then_state: mutable ProofResourceState = proof_resource_empty()
                        else_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &then_state)
                        proof_resource_copy_into(state, &else_state)
                        proof_resource_check_statements(then_body, &then_state, report, function_name, functions)
                        proof_resource_check_statements(else_body, &else_state, report, function_name, functions)
                        proof_resource_close_child(state, then_state, report, true)
                        proof_resource_close_child(state, else_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.While(condition, while_body, _):
                        proof_resource_check_expression(condition, state, report, function_name, functions)
                        while_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &while_state)
                        proof_resource_check_statements(while_body, &while_state, report, function_name, functions)
                        proof_resource_close_child(state, while_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.For(_, variables, iterable, for_body, _):
                        proof_resource_check_expression(iterable, state, report, function_name, functions)
                        for_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &for_state)
                        for variable in variables |variable, for_state|:
                            proof_resource_add_binding_traced(&for_state, report, variable, false, false, false, for_state.binding_names.count, false, "", proof_resource_empty_place(), 0) if variable != ""
                        proof_resource_check_statements(for_body, &for_state, report, function_name, functions)
                        proof_resource_close_child(state, for_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.Match(scrutinee, arms, _):
                        proof_resource_check_expression(scrutinee, state, report, function_name, functions)
                        for arm in arms |arm, state, report, function_name|:
                            arm_state: mutable ProofResourceState = proof_resource_empty()
                            proof_resource_copy_into(state, &arm_state)
                            proof_resource_check_pattern_names(arm.pattern, &arm_state, report, functions)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    proof_resource_check_expression(arm.guard, &arm_state, report, function_name, functions)
                            proof_resource_check_statements(arm.body, &arm_state, report, function_name, functions)
                            proof_resource_close_child(state, arm_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.Block(block_kind, clause, binding, block_body, block_position):
                        if block_kind == "destroy":
                            region_name: sview = clause[0] if clause.count > 0 else binding
                            proof_resource_close_named_region(state, report, region_name, block_position, function_name)
                            state.facts.clear()
                            continue
                        if block_kind == "region" and binding != "" and block_body.count == 0:
                            # Canonical statement form: `region r(size)` is an owner declaration,
                            # not an ordinary binding and not a zero-body lexical block. Its
                            # lifetime extends over subsequent statements until `destroy r` (or
                            # the implicit function-scope close in proof_resource_finish).
                            region_valid: bool = not proof_resource_region_is_active(state, binding)
                            proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region declaration must introduce a fresh named lexical region") if binding == "" or not region_valid
                            if region_valid:
                                state.active_regions.push(binding)
                                proof_resource_record_event(state, report, "resource-region-open", "", 0, binding, "", 0)
                            state.facts.clear()
                            continue
                        block_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &block_state)
                        if block_kind == "region" and binding == "":
                            region_name: sview = clause[0] if clause.count > 0 else ""
                            region_valid: bool = region_name != "" and not proof_resource_region_is_active(state, region_name)
                            proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region block must introduce a fresh named lexical region") if not region_valid
                            if region_valid:
                                block_state.active_regions.push(region_name)
                                proof_resource_record_event(&block_state, report, "resource-region-open", "", 0, region_name, "", 0)
                            proof_resource_check_statements(block_body, &block_state, report, function_name, functions)
                            proof_resource_check_region_boundary(state, block_state, report, function_name, block_position)
                            if region_valid:
                                if block_state.active_regions.count == state.active_regions.count:
                                    proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region scope did not close in the resource transition trace")
                                else:
                                    block_state.active_regions <- block_state.active_regions.truncate(block_state.active_regions.count - 1)
                                    proof_resource_invalidate_region_bindings(&block_state, region_name)
                                    proof_resource_record_event(&block_state, report, "resource-region-close", "", 0, region_name, "", 0)
                            proof_resource_close_child(state, block_state, report, true)
                            state.facts.clear()
                            continue
                        proof_resource_add_binding_traced(&block_state, report, binding, false, false, false, block_state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                        proof_resource_check_statements(block_body, &block_state, report, function_name, functions)
                        proof_resource_close_child(state, block_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.Contract(kind, expression, position):
                        if kind == "assert" or kind == "requires" or kind == "ensure":
                            proof_resource_check_expression(expression, state, report, function_name, functions)
                            proof_resource_add_failing_obligation(report, "borrow-contract-unsupported", position, function_name, "resource-bearing expressions are not admitted in logical contracts") if proof_resource_expr_has_address_of(expression) or proof_resource_expr_uses_local_borrow(expression, state)
                            proof_resource_add_failing_obligation(report, "region-contract-unsupported", position, function_name, "region-owned expressions are not admitted in logical contracts") if proof_resource_expr_contains_region_value(expression, state)
                    Ast::Stmt.Break(_, _):
                        pass
                    Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        # The main proof-state walker owns the canonical invalid-statement
                        # diagnostic. Resource replay has no additional transition to emit.
                        pass
                    _:
                        proof_resource_add_failing_obligation(report, "statement-unsupported", Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}, function_name, "unknown statement form has no resource transition model")

        def proof_check_resource_safety[@r](parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, facts: darray[Ast::Expr]&, report: mutable ProofReport& @r, function_name: sview, line: u32, functions: ProofFunctionTable&) -> void:
            failed_before: u32 = report.failed
            state: mutable ProofResourceState = proof_resource_empty()
            state.facts.extend(facts)
            function_index: usize = proof_resource_function_index(functions, function_name)
            region_parameter_count: usize = proof_resource_function_region_param_count(functions, function_index)
            for region_index in 0..<region_parameter_count |region_index, functions, function_index, state, report|:
                region: sview = proof_resource_function_region_param_at(functions, function_index, region_index)
                valid_region: bool = region != "" and not proof_resource_region_is_active(state, region)
                proof_resource_add_failing_obligation(report, "region-scope-unsupported", Ast::Pos{line: line, column: 0, offset: 0, end_line: line, end_column: 0, end_offset: 0}, function_name, "region-polymorphic parameters must be distinct lifetime capabilities") if not valid_region
                if valid_region:
                    state.active_regions.push(region)
                    state.external_regions.push(region)
                    proof_resource_record_event(&state, report, "resource-region-param", "external", 0, region, "", 0)
            for parameter in parameters |state, report|:
                is_reference: bool = proof_resource_is_reference_type(parameter.type_expression)
                is_mutable_reference: bool = is_reference and proof_resource_is_mutable_reference_type(parameter.type_expression)
                writable: bool = parameter.is_mutable or proof_resource_type_has_marker(parameter.type_expression, TokenKind.Mutable) or is_mutable_reference
                proof_resource_add_binding_traced(&state, report, parameter.name, is_reference, is_mutable_reference, writable, state.binding_names.count, false, "", proof_resource_empty_place(), 0)
                parameter_index: usize = state.binding_names.count - 1
                parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                proof_resource_set_binding_region(&state, report, parameter.name, parameter_region) if is_reference and parameter_region != ""
            proof_resource_check_statements(body, &state, report, function_name, functions)
            proof_resource_finish(&state, report, function_name, line, failed_before, parameters.count)
