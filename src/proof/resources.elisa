# Resource checker facade. The implementation remains private to ElisaProof and is divided into
# state/region transitions, places, calls, borrows, escape checks, and statement orchestration.
# Resource safety emits a source-neutral certificate through the shared admission layer. Keep this
# dependency here so standalone resource clients receive the same complete module, not only the
# command-line root that happens to include admission first.
include "./certificate_admission.elisa"
include "./resources/state_and_regions.elisa"
include "./resources/place_paths.elisa"
include "./resources/conditional_resource_join.elisa"
include "./resources/type_markers.elisa"
include "./resources/state_copy.elisa"
include "./resources/sview_certificates.elisa"
include "./resources/source_indexed_values.elisa"
include "./resources/scalar_reference_index_values.elisa"
include "./resources/function_region_metadata.elisa"
include "./resources/places_and_calls.elisa"
include "./resources/collection_builtin_admission.elisa"
include "./resources/type_lifetimes.elisa"
include "./resources/call_regions.elisa"
include "./resources/borrows_and_bindings.elisa"
include "./resources/overlap_diagnostics.elisa"
include "./resources/borrow_escape_checks.elisa"
include "./resources/pattern_names_budget.elisa"
include "./resources/expression_checker.elisa"
include "./resources/region_flow.elisa"
include "./resources/region_value_taint.elisa"
include "./resources/return_witnesses.elisa"
include "./resources/inferred_bindings.elisa"
include "./resources/opaque_call_results.elisa"
include "./resources/statement_bindings.elisa"
include "./resources/statement_checker.elisa"
include "./resources/sview_call_results.elisa"
