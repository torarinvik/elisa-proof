# Proof checking over the compiler AST. This is a deliberately conservative Hoare-style
# kernel: a proof block may contribute only explicit facts, every assertion is an obligation,
# and an ensure is accepted only after symbolic substitution through the executable body.
extend ElisaProof:
    private:
        # Flow is tracked separately from the symbolic state. A loop-control statement does not
        # have a normal successor, but it can still carry a proof obligation for the nearest
        # loop's invariant. Keeping these exits explicit prevents a `break` path from being
        # mistaken for the loop's ordinary fallthrough state. Continue states are retained per
        # path so termination can check each back edge independently. The snapshots are flattened
        # into parallel arrays because nested dynamic arrays would violate Elisa region lifetimes
        # when a state is stored in a flow collection.
        struct ProofFlow:
            normal: mutable bool
            breaks: mutable bool
            continues: mutable bool
            valid: mutable bool
            continue_name_starts: mutable darray[usize]
            continue_name_counts: mutable darray[usize]
            continue_names: mutable darray[sview]
            continue_value_starts: mutable darray[usize]
            continue_value_counts: mutable darray[usize]
            continue_values: mutable darray[Ast::Expr]
            continue_fact_starts: mutable darray[usize]
            continue_fact_counts: mutable darray[usize]
            continue_facts: mutable darray[Ast::Expr]

        # Structural subterms are tracked with their origin subject, not only their binder name.
        # This distinction is essential for inferred product rankings: a subterm of `left` may
        # not be silently passed as the decreasing argument for `right`.
        struct ProofStructuralSmaller:
            name: sview
            subject: sview

        # One source-neutral witness for a recursive edge. `same` records the unchanged
        # component of an inferred product ranking; `strict` records the component that came
        # from a matched strict subterm. The kernel checks the relation shape independently of
        # the AST walker that discovered it.
        struct ProofStructuralWitness:
            subject: sview
            argument: sview
            strict: bool

        def proof_add_structural_edge_attempt(report: mutable ProofReport&, caller: sview, callee: sview, witnesses: darray[ProofStructuralWitness]&, line: u32) -> void:
            return if caller == "" or callee == "" or witnesses.count == 0
            for witness in witnesses |witness|:
                return if witness.subject == "" or witness.argument == ""
                return if not witness.strict and witness.subject != witness.argument
            witness_start: usize = report.kernel_children.count
            witness_nodes: mutable darray[usize] = []
            for witness in witnesses |witness, report, witness_nodes|:
                witness_nodes.push(proof_kernel_add_node(&report.kernel_nodes, "structural-argument", "strict" if witness.strict else "same", 0, 0, 0, 0, 0, 0, witness.subject, witness.argument))
            report.kernel_children.extend(witness_nodes)
            edge_start: usize = report.kernel_children.count
            edge: usize = proof_kernel_add_node(&report.kernel_nodes, "structural-edge", "", 0, 0, witnesses.count, witness_start, witnesses.count, 0, caller, callee)
            report.kernel_children.push(edge)
            root: usize = proof_kernel_add_node(&report.kernel_nodes, "structural-safety", "", 0, 0, 0, edge_start, 1, 0, caller, "structural-v1")
            proof_add_structural_goal_attempt(report, root, line, caller)

        def proof_empty_flow() -> ProofFlow:
            return ProofFlow{normal: true, breaks: false, continues: false, valid: true, continue_name_starts: [], continue_name_counts: [], continue_names: [], continue_value_starts: [], continue_value_counts: [], continue_values: [], continue_fact_starts: [], continue_fact_counts: [], continue_facts: []}

        def proof_copy_names(source: darray[sview]&) -> darray[sview]:
            result: mutable darray[sview] = []
            result.extend(source)
            return result

        def proof_copy_structural_smaller(source: darray[ProofStructuralSmaller]&) -> darray[ProofStructuralSmaller]:
            result: mutable darray[ProofStructuralSmaller] = []
            result.extend(source)
            return result

        def proof_copy_exprs(source: darray[Ast::Expr]&) -> darray[Ast::Expr]:
            result: mutable darray[Ast::Expr] = []
            result.extend(source)
            return result

        def proof_clear_continue_states(flow: mutable ProofFlow&) -> void:
            flow.continue_name_starts.clear()
            flow.continue_name_counts.clear()
            flow.continue_names.clear()
            flow.continue_value_starts.clear()
            flow.continue_value_counts.clear()
            flow.continue_values.clear()
            flow.continue_fact_starts.clear()
            flow.continue_fact_counts.clear()
            flow.continue_facts.clear()

        # Copy path snapshots with fresh offsets. The source and target arrays remain flat, so no
        # nested container crosses the region boundary of a branch-local flow value.
        def proof_append_continue_states(target: mutable ProofFlow&, source: ProofFlow&) -> void:
            for state_index in 0..<source.continue_name_starts.count |state_index, target, source|:
                name_start: usize = source.continue_name_starts[state_index]
                name_count: usize = source.continue_name_counts[state_index]
                value_start: usize = source.continue_value_starts[state_index]
                value_count: usize = source.continue_value_counts[state_index]
                fact_start: usize = source.continue_fact_starts[state_index]
                fact_count: usize = source.continue_fact_counts[state_index]
                target.continue_name_starts.push(target.continue_names.count)
                target.continue_name_counts.push(name_count)
                for offset in 0..<name_count |offset, target, source, name_start|:
                    target.continue_names.push(source.continue_names[name_start + offset])
                target.continue_value_starts.push(target.continue_values.count)
                target.continue_value_counts.push(value_count)
                for offset in 0..<value_count |offset, target, source, value_start|:
                    target.continue_values.push(source.continue_values[value_start + offset])
                target.continue_fact_starts.push(target.continue_facts.count)
                target.continue_fact_counts.push(fact_count)
                for offset in 0..<fact_count |offset, target, source, fact_start|:
                    target.continue_facts.push(source.continue_facts[fact_start + offset])

        def proof_record_continue_state(flow: mutable ProofFlow&, names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&) -> void:
            flow.continue_name_starts.push(flow.continue_names.count)
            flow.continue_name_counts.push(names.count)
            flow.continue_names.extend(names)
            flow.continue_value_starts.push(flow.continue_values.count)
            flow.continue_value_counts.push(values.count)
            flow.continue_values.extend(values)
            flow.continue_fact_starts.push(flow.continue_facts.count)
            flow.continue_fact_counts.push(facts.count)
            flow.continue_facts.extend(facts)

        # Elisa's unsigned primitive types carry a compiler-level lower bound of zero. Keep
        # this import deliberately narrow: only bare primitive spellings are recognized here;
        # aliases, refinements, and opaque wrappers must provide an explicit proof instead of
        # being guessed from a name. This is a source-semantic fact, not an axiom supplied by a
        # proof author, and is recorded as `type-bound` provenance for replay.
        def proof_unsigned_primitive_type(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uint"
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_primitive_type(inner)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_unsigned_primitive_type(inner) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return false
                _:
                    return false

        def proof_unsigned_primitive_width(expression: Ast::Expr) -> i64:
            match expression:
                Ast::Expr.Ident(name, _):
                    return 8 if name == "u8"
                    return 16 if name == "u16"
                    return 32 if name == "u32"
                    return 64 if name == "u64" or name == "usize" or name == "uint"
                    return 0
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_primitive_width(inner)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_unsigned_primitive_width(inner) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                _:
                    return 0

        # The primitive scalar types. Equality, arithmetic, and ordering on these are the
        # language's own operators; only a struct operand dispatches to a user protocol method.
        # Floating point is deliberately absent: it is excluded from the certificate term
        # language entirely because arithmetic can produce NaN, which is not reflexive.
        def proof_scalar_primitive_type_name(name: sview) -> bool:
            return true if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize" or name == "int"
            return true if name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uint"
            return true if name == "bool" or name == "char"
            return false

        # 1 means a primitive scalar type, 0 means it is not one, and -1 means alias resolution
        # is ambiguous or too deep. A failed resolution is never reported as scalar. References
        # are excluded rather than followed: `&T` compares by address, and reading that as the
        # pointee's equality would need a separate argument.
        def proof_scalar_type_kind(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return 1 if proof_scalar_primitive_type_name(name)
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return -1 if alias.count > 1
                    return proof_scalar_type_kind(alias.target, declarations, depth + 1) if alias.count == 1
                    # A `const enum` is an integer-backed value; its `==` is the integer compare.
                    # A plain enum is a tagged union and is deliberately not a scalar here.
                    const_enums: usize = proof_count_const_enums(declarations, name, 0)
                    return -1 if const_enums > 1
                    return 1 if const_enums == 1
                    return 0
                Ast::Expr.Paren(inner, _):
                    return proof_scalar_type_kind(inner, declarations, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    # A predicate restricts inhabitants; the underlying operators are unchanged.
                    return proof_scalar_type_kind(base, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_scalar_type_kind(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                Ast::Expr.Scope(_, name, _):
                    # A bare-name search cannot establish a qualified alias's owner.
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return -1 if alias.count > 0
                    return 0
                _:
                    return 0

        def proof_find_type_alias(declarations: darray[Ast::Decl]&, name: sview, depth: usize) -> (count: usize, target: Ast::Expr):
            return (2, Ast::Expr.Invalid) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            target: mutable Ast::Expr = Ast::Expr.Absent
            for declaration in declarations |name, depth, count, target|:
                match declaration:
                    Ast::Decl.Alias(alias_name, alias_target, _):
                        if alias_name == name:
                            count <- count + 1
                            target <- alias_target
                    Ast::Decl.Module(_, body, _):
                        nested: (count: usize, target: Ast::Expr) = proof_find_type_alias(body, name, depth + 1)
                        count <- count + nested.count
                        target <- nested.target if nested.count > 0
                    Ast::Decl.Scoped(body, _):
                        nested: (count: usize, target: Ast::Expr) = proof_find_type_alias(body, name, depth + 1)
                        count <- count + nested.count
                        target <- nested.target if nested.count > 0
                    _:
                        pass
                return (2, Ast::Expr.Invalid) if count > 1
            return (count, target)

        def proof_count_const_enums(declarations: darray[Ast::Decl]&, name: sview, depth: usize) -> usize:
            return 2 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |name, depth, count|:
                match declaration:
                    Ast::Decl.Enum(enum_name, _, is_const, _, _):
                        count <- count + 1 if enum_name == name and is_const
                    Ast::Decl.Module(_, body, _):
                        count <- count + proof_count_const_enums(body, name, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        count <- count + proof_count_const_enums(body, name, depth + 1)
                    _:
                        pass
            return count

        # The declared type of one field of a named struct. The count reports how many struct
        # declarations answer to the name; anything but exactly one is refused by the caller.
        def proof_struct_field_type(declarations: darray[Ast::Decl]&, struct_name: sview, field_name: sview, depth: usize) -> (count: usize, type_expression: Ast::Expr):
            return (2, Ast::Expr.Invalid) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            for declaration in declarations |struct_name, field_name, depth, count, found|:
                match declaration:
                    Ast::Decl.Struct(name, members, _, _, _, _, _):
                        if name == struct_name:
                            count <- count + 1
                            for member in members |field_name, found|:
                                found <- member.type_expression if member.name == field_name
                    Ast::Decl.Module(_, body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_struct_field_type(body, struct_name, field_name, depth + 1)
                        count <- count + nested.count
                        found <- nested.type_expression if nested.count > 0
                    Ast::Decl.Scoped(body, _):
                        nested: (count: usize, type_expression: Ast::Expr) = proof_struct_field_type(body, struct_name, field_name, depth + 1)
                        count <- count + nested.count
                        found <- nested.type_expression if nested.count > 0
                    _:
                        pass
            return (count, found)

        def proof_struct_field_names(declarations: darray[Ast::Decl]&, struct_name: sview, depth: usize, names: mutable darray[sview]&) -> usize:
            return 2 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |struct_name, depth, count, names|:
                match declaration:
                    Ast::Decl.Struct(name, members, _, _, _, _, _):
                        if name == struct_name:
                            count <- count + 1
                            for member in members |names|:
                                names.push(member.name)
                    Ast::Decl.Module(_, body, _):
                        count <- count + proof_struct_field_names(body, struct_name, depth + 1, names)
                    Ast::Decl.Scoped(body, _):
                        count <- count + proof_struct_field_names(body, struct_name, depth + 1, names)
                    _:
                        pass
            return count

        # The struct a declared type names, after stripping storage qualifiers, references,
        # parentheses, refinements, and a unique alias. A reference is followed here because a
        # field read through `p: Pair&` still has the field's declared type; what is refused for
        # a scalar (`&T` compares by address) does not arise for a projection out of it.
        def proof_type_head_name(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> sview:
            return "" if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return "" if proof_scalar_primitive_type_name(name)
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return "" if alias.count > 1
                    return proof_type_head_name(alias.target, declarations, depth + 1) if alias.count == 1
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_type_head_name(inner, declarations, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_type_head_name(base, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_type_head_name(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                _:
                    return ""

        # The element type of a built-in container spelling: `darray[T]`, `view[T]`,
        # `array[T, N]`, or `T[N]`. Only built-in containers are recognized, because a subscript
        # on a struct is an `__index__` protocol call whose result is whatever the author chose.
        def proof_container_element_type(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> (known: bool, element: Ast::Expr):
            return (false, Ast::Expr.Invalid) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_container_element_type(inner, declarations, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_container_element_type(base, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_container_element_type(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return (false, Ast::Expr.Invalid)
                Ast::Expr.Ident(name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return proof_container_element_type(alias.target, declarations, depth + 1) if alias.count == 1
                    return (false, Ast::Expr.Invalid)
                Ast::Expr.Index(head, argument, _):
                    head_name: sview = proof_ident_name(head)
                    return (true, argument) if head_name == "darray" or head_name == "view"
                    match argument:
                        Ast::Expr.IntLit(_):
                            return (true, head)
                        _:
                            return (false, Ast::Expr.Invalid)
                Ast::Expr.IndexN(head, arguments, _):
                    return (false, Ast::Expr.Invalid) if proof_ident_name(head) != "array" or arguments.count != 2
                    match arguments[1]:
                        Ast::Expr.IntLit(_):
                            return (true, arguments[0])
                        _:
                            return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        # How many subscripts separate a container from a primitive scalar element: 1 for
        # `darray[i64]`, 2 for `array[array[i64, 4], 4]`, and 0 when the innermost element is not
        # a scalar or the spelling is not a built-in container.
        def proof_scalar_element_depth(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> i64:
            return 0 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            element: (known: bool, element: Ast::Expr) = proof_container_element_type(expression, declarations, depth)
            return 0 if not element.known
            return 1 if proof_scalar_type_kind(element.element, declarations, 0) == 1
            inner: i64 = proof_scalar_element_depth(element.element, declarations, depth + 1)
            return inner + 1 if inner > 0
            return 0

        const PROOF_SCALAR_WITNESS_BUDGET: usize = 12
        const PROOF_SCALAR_WITNESS_DEPTH: usize = 3

        # Expression-level type witnesses for a binding. The bare name of a scalar binding is
        # witnessed by the caller; this records what the declared type says about the places
        # reachable from the binding: each scalar field of a struct, recursively through
        # struct-typed fields to a fixed depth, the `count` of a built-in container, and the
        # container itself when its elements are scalars. Every witness is a type statement about
        # a place and is retained and invalidated with the binding's root symbol.
        def proof_add_scalar_witnesses(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, root: Ast::Expr, type_expression: Ast::Expr, line: u32, owner: sview, position: Ast::Pos, budget: mutable usize&, depth: usize) -> void:
            return if depth >= PROOF_SCALAR_WITNESS_DEPTH or budget == 0
            element_depth: i64 = proof_scalar_element_depth(type_expression, report.source_declarations, 0)
            container: (known: bool, element: Ast::Expr) = proof_container_element_type(type_expression, report.source_declarations, 0)
            if container.known:
                budget <- budget - 1
                proof_add_type_bound_fact(facts, report, proof_scalar_term_marker(Ast::Expr.Field(root, "count", position), position), line, owner)
                if element_depth > 0 and budget > 0:
                    budget <- budget - 1
                    proof_add_type_bound_fact(facts, report, proof_scalar_element_marker(root, element_depth, position), line, owner)
                return
            struct_name: sview = proof_type_head_name(type_expression, report.source_declarations, 0)
            return if struct_name == ""
            field_names: mutable darray[sview] = []
            return if proof_struct_field_names(report.source_declarations, struct_name, 0, &field_names) != 1
            for field_name in field_names |facts, report, root, struct_name, line, owner, position, budget, depth|:
                return if budget == 0
                field: (count: usize, type_expression: Ast::Expr) = proof_struct_field_type(report.source_declarations, struct_name, field_name, 0)
                continue if field.count != 1
                place: Ast::Expr = Ast::Expr.Field(root, field_name, position)
                if proof_scalar_type_kind(field.type_expression, report.source_declarations, 0) == 1:
                    budget <- budget - 1
                    proof_add_type_bound_fact(facts, report, proof_scalar_term_marker(place, position), line, owner)
                else:
                    proof_add_scalar_witnesses(facts, report, place, field.type_expression, line, owner, position, budget, depth + 1)

        # A call to a verified total-pure function with a primitive scalar return type denotes
        # one value: the classification proves it reads nothing but its arguments and always
        # returns, so two occurrences of the same call text over witnessed arguments are the same
        # value. Record that witness for each such call in the goal before it is decided. Any
        # other call stays unwitnessed.
        def proof_add_pure_call_witnesses(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&, report: mutable ProofReport&, line: u32, owner: sview, depth: usize) -> void:
            return if depth >= 32
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_add_pure_call_witnesses(inner, facts, functions, report, line, owner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    proof_add_pure_call_witnesses(operand, facts, functions, report, line, owner, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    proof_add_pure_call_witnesses(left, facts, functions, report, line, owner, depth + 1)
                    proof_add_pure_call_witnesses(right, facts, functions, report, line, owner, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    proof_add_pure_call_witnesses(condition, facts, functions, report, line, owner, depth + 1)
                    proof_add_pure_call_witnesses(then_expression, facts, functions, report, line, owner, depth + 1)
                    proof_add_pure_call_witnesses(else_expression, facts, functions, report, line, owner, depth + 1)
                Ast::Expr.Call(callee, arguments, _, position):
                    for argument in arguments |facts, functions, report, line, owner, depth|:
                        proof_add_pure_call_witnesses(argument, facts, functions, report, line, owner, depth + 1)
                    return if not proof_contract_calls_are_pure(expression, functions)
                    called: usize = proof_function_index(functions, proof_callable_name(callee))
                    return if called >= functions.return_scalar.count or not functions.return_scalar[called]
                    for argument in arguments |facts|:
                        return if not proof_scalar_term_witnessed(argument, facts, 0)
                    proof_add_type_bound_fact(facts, report, proof_scalar_term_marker(expression, position), line, owner)
                _:
                    pass

        # Zero means a non-unsigned type; -1 means alias resolution is ambiguous or too
        # deep. Never silently treat a failed resolution as ordinary signed arithmetic.
        def proof_unsigned_type_width(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            primitive: i64 = proof_unsigned_primitive_width(expression)
            return primitive if primitive > 0
            match expression:
                Ast::Expr.Refinement(base, _, _):
                    # A predicate restricts inhabitants; it does not change the base type's
                    # machine arithmetic. Preserve the width even for a vacuous predicate.
                    return proof_unsigned_type_width(base, declarations, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_type_width(inner, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_unsigned_type_width(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return 0
                Ast::Expr.Ident(name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    return -1 if alias.count > 1
                    return proof_unsigned_type_width(alias.target, declarations, depth + 1) if alias.count == 1
                Ast::Expr.Scope(_, name, _):
                    alias: (count: usize, target: Ast::Expr) = proof_find_type_alias(declarations, name, 0)
                    # A bare-name search cannot establish a qualified alias's owner.
                    return -1 if alias.count > 0
                _:
                    pass
            return 0

        # Type facts are re-established whenever a binding is re-symbolized, so this must be
        # idempotent: a fact already present is not pushed again, and a fact already traced as
        # a type bound of this owner is not traced again. Otherwise every join and rebinding
        # would multiply identical facts and traces.
        def proof_add_type_bound_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, owner: sview) -> void:
            for existing in facts |existing, expression|:
                return if proof_expr_equal(existing, expression)
            if proof_fact_is_type_bound(report, expression, owner):
                facts.push(expression)
                return
            proof_add_traced_fact(facts, report, expression, "type-bound", line, owner)

        def proof_add_unsigned_binding_facts(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, width: i64, line: u32, owner: sview, position: Ast::Pos) -> void:
            return if name == "" or width <= 0
            lower_bound: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0), TokenKind.LtEq, Ast::Expr.Ident(name, position), position)
            proof_add_type_bound_fact(facts, report, lower_bound, line, owner)
            proof_add_type_bound_fact(facts, report, proof_unsigned_type_marker(name, width, position), line, owner)
            if width < 64:
                upper: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident(name, position), TokenKind.LtEq, Ast::Expr.IntLit(proof_unsigned_width_max(width)), position)
                proof_add_type_bound_fact(facts, report, upper, line, owner)

        # Fixed arrays carry an exact element count in their type (`array[T, N]` or the
        # primitive shorthand `T[N]`). Keep this importer intentionally narrower than the
        # compiler's full type algebra: only a literal extent is admitted, and wrappers are
        # transparent. The result is -1 for dynamic arrays, dependent extents, aliases, or
        # malformed type syntax. This is used only to derive a memory-safety fact after the
        # index itself has independently been proved below the exact extent.
        def proof_fixed_array_extent(expression: Ast::Expr) -> i64:
            match expression:
                Ast::Expr.Unary(_, operand, _):
                    return proof_fixed_array_extent(operand)
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_array_extent(inner)
                Ast::Expr.IndexN(object, arguments, _):
                    head: sview = proof_callable_name(object)
                    return -1 if head != "array" or arguments.count != 2
                    extent: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return extent.value if extent.known and extent.value >= 0
                    return -1
                Ast::Expr.Index(object, extent_expression, _):
                    head: sview = proof_callable_name(object)
                    # The compiler's shorthand form is only a fixed array when the
                    # element head is a primitive scalar. Generic `T[N]`-shaped syntax
                    # must not be reinterpreted as a storage bound by the proof importer.
                    primitive: bool = head == "i8" or head == "i16" or head == "i32" or head == "i64" or head == "int" or head == "isize" or head == "u8" or head == "u16" or head == "u32" or head == "u64" or head == "usize" or head == "uintptr" or head == "f32" or head == "f64"
                    return -1 if not primitive
                    extent: (known: bool, value: i64) = proof_constant_int(extent_expression)
                    return extent.value if extent.known and extent.value >= 0
                    return -1
                _:
                    return -1

        # Only direct function parameters are imported into this first fixed-array model.
        # Looking through parentheses is harmless; fields, calls, and arbitrary paths are
        # intentionally excluded until their storage identity and aliasing are modeled.
        def proof_fixed_array_extent_for_object(expression: Ast::Expr, names: darray[sview]&, extents: darray[i64]&) -> i64:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_array_extent_for_object(inner, names, extents)
                Ast::Expr.Ident(object_name, _):
                    limit: usize = names.count if names.count <= extents.count else extents.count
                    for index in 0..<limit |index, names, extents, object_name|:
                        return extents[index] if names[index] == object_name
                    return -1
                _:
                    return -1

        # Collect the statically known dimensions of a nested fixed-array parameter in
        # receiver-to-element order. A missing nested dimension is intentionally not invented:
        # `array[darray[T], N]` contributes only its outer `N`, so a second runtime index remains
        # opaque. This flat shape is enough for a bounded `IndexN` access without introducing a
        # separate heap/alias model.
        def proof_fixed_array_shape(expression: Ast::Expr, extents: mutable darray[i64]&) -> bool:
            match expression:
                Ast::Expr.Unary(_, operand, _):
                    return proof_fixed_array_shape(operand, extents)
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_array_shape(inner, extents)
                Ast::Expr.IndexN(object, arguments, _):
                    head: sview = proof_callable_name(object)
                    return false if head != "array" or arguments.count != 2
                    extent: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return false if not extent.known or extent.value < 0
                    extents.push(extent.value)
                    nested: mutable darray[i64] = []
                    proof_fixed_array_shape(arguments[0], &nested)
                    extents.extend(nested)
                    return true
                Ast::Expr.Index(object, extent_expression, _):
                    head: sview = proof_callable_name(object)
                    primitive: bool = head == "i8" or head == "i16" or head == "i32" or head == "i64" or head == "int" or head == "isize" or head == "u8" or head == "u16" or head == "u32" or head == "u64" or head == "usize" or head == "uintptr" or head == "f32" or head == "f64"
                    return false if not primitive
                    extent: (known: bool, value: i64) = proof_constant_int(extent_expression)
                    return false if not extent.known or extent.value < 0
                    extents.push(extent.value)
                    return true
                _:
                    return false

        # The ordinary index path uses the first dimension. Multi-index expressions select the
        # dimension by occurrence, so duplicate parameter names in the flat shape are deliberate
        # and preserve the exact nesting order.
        def proof_fixed_array_dimension_extent(expression: Ast::Expr, dimension: usize, names: darray[sview]&, extents: darray[i64]&) -> i64:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_fixed_array_dimension_extent(inner, dimension, names, extents)
                Ast::Expr.Ident(object_name, _):
                    limit: usize = names.count if names.count <= extents.count else extents.count
                    occurrence: mutable usize = 0
                    for index in 0..<limit |index, names, extents, object_name, dimension, occurrence|:
                        if names[index] == object_name:
                            return extents[index] if occurrence == dimension
                            occurrence <- occurrence + 1
                    return -1
                _:
                    return -1

        def proof_quantifier_rule(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> sview:
            kind: sview = proof_quantifier_kind(expression, annotations)
            return "quantifier-forall" if kind == "forall"
            return "quantifier-exists" if kind == "exists"
            return ""

        # Keep the decision procedure and certificate emission together. Only successful goals
        # enter the certificate stream; failed goals remain ordinary report findings.
        def proof_certify_goal_with_rule(facts: darray[Ast::Expr]&, goal: Ast::Expr, report: mutable ProofReport&, line: u32, name: sview, annotations: darray[Ast::EnumAnnotation]&, original_rule: sview) -> bool:
            exhausted: mutable bool = false
            proven: bool = proof_kernel_expression_supported(goal) and proof_goal_with_limits(facts, goal, annotations, &exhausted)
            rule: mutable sview = original_rule
            quantifier_kind: mutable sview = ""
            quantifier_kind <- proof_quantifier_kind(goal, annotations) if original_rule == ""
            rule <- "goal" if rule == ""
            rule <- "quantifier-forall" if quantifier_kind == "forall"
            rule <- "quantifier-exists" if quantifier_kind == "exists"
            proof_add_goal_attempt(report, facts, goal, line, name, rule, proven)
            proof_mark_latest_attempt_exhausted(report, exhausted and not proven)
            return proven

        def proof_certify_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, report: mutable ProofReport&, line: u32, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_certify_goal_with_rule(facts, goal, report, line, name, annotations, "")

        # A termination clause may spell a lexicographic ranking either as one tuple
        # (`decreases (outer, inner)`) or as several clauses. Flatten only the explicit tuple
        # shell; each resulting component is still checked as an ordinary fixed-width integer
        # expression. Empty/nested unsupported shapes remain represented by their expression and
        # therefore fail closed in the arithmetic obligation instead of becoming an assumption.
        def proof_decreases_components(expression: Ast::Expr, components: mutable darray[Ast::Expr]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_decreases_components(inner, components)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |components|:
                        proof_decreases_components(element, components)
                _:
                    components.push(expression)

        def proof_decreases_component_slice(expressions: darray[Ast::Expr]&, components: mutable darray[Ast::Expr]&) -> void:
            for expression in expressions |components|:
                proof_decreases_components(expression, components)

        # Infer the ordinary structural ranking used by algebraic-data-type traversals when the
        # author omits an explicit `decreases` clause. This is deliberately narrow: there must be
        # at least one enum-typed parameter, and the existing structural checker must still prove
        # every recursive edge descends in one of the enum parameters while leaving every other
        # enum parameter unchanged or descending. This is a product-of-subterms ranking: the sum
        # of the finite constructor heights strictly decreases. No integer or opaque/reference
        # parameter is inferred, so this cannot turn arbitrary recursion into a termination
        # certificate.
        def proof_infer_structural_decrease(file: Ast::File&, parameters: darray[Ast::ParamDecl]&) -> (known: bool, parameter: sview, position: usize, type_name: sview):
            candidate: mutable sview = ""
            candidate_position: mutable usize = parameters.count
            candidate_type: mutable sview = ""
            for index in 0..<parameters.count |index, parameters, candidate, candidate_position, candidate_type, file|:
                type_name: sview = proof_callable_name(parameters[index].type_expression)
                if type_name != "" and proof_declaration_has_enum(file.top_decls, type_name):
                    if candidate == "":
                        candidate <- parameters[index].name
                        candidate_position <- index
                        candidate_type <- type_name
            return (candidate != "", candidate, candidate_position, candidate_type)

        def proof_enum_parameter_names(file: Ast::File&, parameters: darray[Ast::ParamDecl]&) -> darray[sview]:
            result: mutable darray[sview] = []
            for parameter in parameters |result, file|:
                type_name: sview = proof_callable_name(parameter.type_expression)
                result.push(parameter.name) if type_name != "" and proof_declaration_has_enum(file.top_decls, type_name)
            return result

        def proof_decreases_range_valid(start: usize, count: usize, total: usize) -> bool:
            return start <= total and count <= total - start

        def proof_declaration_has_enum(declarations: darray[Ast::Decl]&, wanted: sview) -> bool:
            for declaration in declarations:
                match declaration:
                    Ast::Decl.Enum(name, _, _, _, _):
                        return true if name == wanted
                    Ast::Decl.Module(_, module_body, _):
                        return true if proof_declaration_has_enum(module_body, wanted)
                    Ast::Decl.Scoped(scoped_body, _):
                        return true if proof_declaration_has_enum(scoped_body, wanted)
                    _:
                        pass
            return false

        def proof_enum_parameter_position(declarations: darray[Ast::Decl]&, parameters: darray[Ast::ParamDecl]&, subject: sview) -> usize:
            index: mutable usize = 0
            for parameter in parameters |index|:
                type_name: sview = proof_callable_name(parameter.type_expression)
                return index if parameter.name == subject and proof_declaration_has_enum(declarations, type_name)
                index <- index + 1
            return parameters.count

        # Prove lexicographic descent over nonnegative components. Earlier components must be
        # equal and the first component that differs must strictly decrease. Every component's
        # nonnegativity is checked by the caller, so this relation is a well-founded ranking over
        # fixed-width naturals rather than an unchecked tuple comparison.
        def proof_lexicographic_smaller(current_components: darray[Ast::Expr]&, next_components: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos, report: mutable ProofReport&, name: sview) -> bool:
            return false if current_components.count == 0 or current_components.count != next_components.count
            # Build one proposition instead of emitting speculative component goals while
            # searching for the first decrease. For (a,b), this is a'<a || (a'==a && b'<b).
            # Consequently every exported goal attempt is a real obligation and a successful
            # lexicographic proof cannot leave abandoned failures in the repair queue.
            relation: mutable Ast::Expr = Ast::Expr.Invalid
            cursor: mutable usize = current_components.count
            while cursor > 0 |cursor, current_components, next_components, position, relation|:
                cursor <- cursor - 1
                smaller: Ast::Expr = Ast::Expr.Binary(next_components[cursor], TokenKind.Lt, current_components[cursor], position)
                if proof_expr_is_invalid(relation):
                    relation <- smaller
                else:
                    equal: Ast::Expr = Ast::Expr.Binary(next_components[cursor], TokenKind.EqEq, current_components[cursor], position)
                    suffix: Ast::Expr = Ast::Expr.Binary(equal, TokenKind.And, relation, position)
                    relation <- Ast::Expr.Binary(smaller, TokenKind.Or, suffix, position)
            return proof_certify_goal(facts, relation, report, position.line, name, annotations)

        # A branch/loop join may have changed a local on only some paths. Retaining its old
        # symbolic value would let a later return silently use the pre-join expression. Forget
        # such values by replacing them with opaque current identifiers; invariants or explicit
        # facts may reintroduce relationships after the join.
        def proof_forget_values(names: darray[sview]&, values: mutable darray[Ast::Expr]&, position: Ast::Pos) -> void:
            for index in 0..<values.count |index, names, values, position|:
                values[index] <- Ast::Expr.Ident(names[index], position) if index < names.count
                values[index] <- Ast::Expr.Invalid if index >= names.count

        def proof_forget_values_before(names: darray[sview]&, values: mutable darray[Ast::Expr]&, limit: usize, position: Ast::Pos) -> void:
            capped_limit: usize = limit if limit < values.count else values.count
            for index in 0..<capped_limit |index, names, values, position|:
                values[index] <- Ast::Expr.Ident(names[index], position) if index < names.count
                values[index] <- Ast::Expr.Invalid if index >= names.count

        def proof_forget_values_except(names: darray[sview]&, values: mutable darray[Ast::Expr]&, keep: usize, position: Ast::Pos) -> void:
            for index in 0..<values.count |index, names, values, keep, position|:
                continue if index == keep
                values[index] <- Ast::Expr.Ident(names[index], position) if index < names.count
                values[index] <- Ast::Expr.Invalid if index >= names.count

        # An else path after `if not condition` carries condition itself, not a redundant
        # double negation. This matters for early-return guards: the surviving path can then
        # publish the predicate that justified a later access or postcondition.
        # A conjunctive branch condition entails each of its conjuncts. Recording the conjuncts
        # alongside the whole costs nothing logically and makes each one survive on its own
        # merits: `not f(x) and depth < 127` is discarded wholesale at the next call because of
        # the call, while its second conjunct is over a by-value scalar and remains true. The
        # walk is a bounded worklist so a deeply nested condition cannot blow up the fact set.
        def proof_conjunct_components(expression: Ast::Expr, components: mutable darray[Ast::Expr]&) -> void:
            pending: mutable darray[Ast::Expr] = [expression]
            cursor: mutable usize = 0
            while cursor < pending.count and components.count < 8 |cursor, pending, components|:
                current: Ast::Expr = proof_strip_parens(pending[cursor])
                cursor <- cursor + 1
                room: bool = pending.count < 16
                split: mutable bool = false
                match current:
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        if room:
                            pending.push(left)
                            pending.push(right)
                            split <- true
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        # De Morgan only where it makes progress; a negated comparison is
                        # already atomic and must not be pushed back onto the worklist.
                        inner: Ast::Expr = proof_strip_parens(operand)
                        match inner:
                            Ast::Expr.Binary(_, TokenKind.Or, _, _):
                                # `not (X or Y)` is the conjunction `not X and not Y`. The dual
                                # form `not (X and Y)` is a disjunction and is left whole: it is
                                # not a conjunct and the kernel would not re-derive it.
                                if room:
                                    pending.push(proof_branch_negation(inner, Ast::expr_pos(current)))
                                    split <- true
                            Ast::Expr.Unary(TokenKind.Not, double, _):
                                if room:
                                    pending.push(double)
                                    split <- true
                            _:
                                pass
                    _:
                        pass
                components.push(current) if not split

        # Record a branch condition and, separately, every conjunct it entails. The conjuncts are
        # derived facts: replay revalidates each one from the premises standing at this point
        # rather than accepting it as a second assumption.
        def proof_add_branch_condition_facts(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, condition: Ast::Expr, line: u32, name: sview) -> void:
            proof_add_traced_fact(facts, report, condition, "branch-condition", line, name)
            components: mutable darray[Ast::Expr] = []
            proof_conjunct_components(condition, &components)
            return if components.count < 2
            premises: darray[Ast::Expr] = [condition]
            for component in components |facts, report, line, name, premises|:
                continue if any existing in facts where proof_expr_equal(existing, component)
                proof_add_derived_fact_from(facts, report, component, premises, "branch-conjunct", line, name)

        def proof_branch_negation(expression: Ast::Expr, position: Ast::Pos) -> Ast::Expr:
            match expression:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return inner
                Ast::Expr.BoolLit(value):
                    return Ast::Expr.BoolLit(not value)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, left, position), TokenKind.Or, Ast::Expr.Unary(TokenKind.Not, right, position), position)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, left, position), TokenKind.And, Ast::Expr.Unary(TokenKind.Not, right, position), position)
                _:
                    return Ast::Expr.Unary(TokenKind.Not, expression, position)

        def proof_add_fact(facts: mutable darray[Ast::Expr]&, expression: Ast::Expr) -> void:
            facts.push(expression)

        def proof_trace_fact(report: mutable ProofReport&, expression: Ast::Expr, kind: sview, line: u32, name: sview) -> void:
            kernel_expression: usize = proof_kernel_encode_annotated(expression, &report.kernel_nodes, &report.kernel_children, report.source_annotations)
            report.fact_traces <- report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: kernel_expression, kind: kind, line: line, name: name, dependency: "", premises_start: report.fact_trace_premises.count, premises_count: 0, kernel_premises_start: report.kernel_fact_trace_premises.count, kernel_premises_count: 0, summary_bindings_start: report.fact_trace_summary_names.count, summary_bindings_count: 0, summary_requires_start: report.fact_trace_summary_require_goal_ids.count, summary_requires_count: 0, summary_ensure_index: 0})

        def proof_add_traced_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, kind: sview, line: u32, name: sview) -> void:
            facts.push(expression)
            proof_trace_fact(report, expression, kind, line, name)

        # A derived fact records the current logical context before it is added. Replay can then
        # recursively validate proof-step facts instead of treating their source assertion as an
        # axiom. Runtime facts and imported contract summaries continue to use proof_trace_fact;
        # they are explicit semantic assumptions at this boundary.
        def proof_add_derived_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, kind: sview, line: u32, name: sview) -> void:
            premises: darray[Ast::Expr] = proof_copy_exprs(facts)
            facts.push(expression)
            premises_start: usize = report.fact_trace_premises.count
            report.fact_trace_premises.extend(premises)
            kernel_premises_start: usize = report.kernel_fact_trace_premises.count
            for premise in premises |premise, report|:
                report.kernel_fact_trace_premises.push(proof_kernel_encode_annotated(premise, &report.kernel_nodes, &report.kernel_children, report.source_annotations))
            kernel_expression: usize = proof_kernel_encode_annotated(expression, &report.kernel_nodes, &report.kernel_children, report.source_annotations)
            report.fact_traces <- report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: kernel_expression, kind: kind, line: line, name: name, dependency: "", premises_start: premises_start, premises_count: premises.count, kernel_premises_start: kernel_premises_start, kernel_premises_count: premises.count, summary_bindings_start: report.fact_trace_summary_names.count, summary_bindings_count: 0, summary_requires_start: report.fact_trace_summary_require_goal_ids.count, summary_requires_count: 0, summary_ensure_index: 0})

        # The same trace, but over an explicit premise list rather than the whole current context.
        # A step whose justification is a single named fact records exactly that fact, so replay
        # revalidates a small, precise derivation instead of the entire ambient state.
        def proof_add_derived_fact_from(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, premises: darray[Ast::Expr]&, kind: sview, line: u32, name: sview) -> void:
            facts.push(expression)
            premises_start: usize = report.fact_trace_premises.count
            report.fact_trace_premises.extend(premises)
            kernel_premises_start: usize = report.kernel_fact_trace_premises.count
            for premise in premises |premise, report|:
                report.kernel_fact_trace_premises.push(proof_kernel_encode_annotated(premise, &report.kernel_nodes, &report.kernel_children, report.source_annotations))
            kernel_expression: usize = proof_kernel_encode_annotated(expression, &report.kernel_nodes, &report.kernel_children, report.source_annotations)
            report.fact_traces <- report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: kernel_expression, kind: kind, line: line, name: name, dependency: "", premises_start: premises_start, premises_count: premises.count, kernel_premises_start: kernel_premises_start, kernel_premises_count: premises.count, summary_bindings_start: report.fact_trace_summary_names.count, summary_bindings_count: 0, summary_requires_start: report.fact_trace_summary_require_goal_ids.count, summary_requires_count: 0, summary_ensure_index: 0})

        def proof_add_function_summary_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, name: sview, dependency: sview, parameter_names: darray[sview]&, argument_values: darray[Ast::Expr]&, result_value: Ast::Expr, require_goal_ids: darray[usize]&, ensure_index: usize) -> void:
            facts.push(expression)
            bindings_start: usize = report.fact_trace_summary_names.count
            report.fact_trace_summary_names.extend(parameter_names)
            report.fact_trace_summary_values.extend(argument_values)
            report.fact_trace_summary_names.push("result")
            report.fact_trace_summary_values.push(result_value)
            requires_start: usize = report.fact_trace_summary_require_goal_ids.count
            report.fact_trace_summary_require_goal_ids.extend(require_goal_ids)
            kernel_expression: usize = proof_kernel_encode_annotated(expression, &report.kernel_nodes, &report.kernel_children, report.source_annotations)
            report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: kernel_expression, kind: "function-summary", line: line, name: name, dependency: dependency, premises_start: report.fact_trace_premises.count, premises_count: 0, kernel_premises_start: report.kernel_fact_trace_premises.count, kernel_premises_count: 0, summary_bindings_start: bindings_start, summary_bindings_count: parameter_names.count + 1, summary_requires_start: requires_start, summary_requires_count: require_goal_ids.count, summary_ensure_index: ensure_index})

        def proof_add_lemma_summary_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, line: u32, name: sview, dependency: sview, parameter_names: darray[sview]&, argument_values: darray[Ast::Expr]&, require_goal_ids: darray[usize]&, ensure_index: usize) -> void:
            facts.push(expression)
            bindings_start: usize = report.fact_trace_summary_names.count
            report.fact_trace_summary_names.extend(parameter_names)
            report.fact_trace_summary_values.extend(argument_values)
            requires_start: usize = report.fact_trace_summary_require_goal_ids.count
            report.fact_trace_summary_require_goal_ids.extend(require_goal_ids)
            kernel_expression: usize = proof_kernel_encode_annotated(expression, &report.kernel_nodes, &report.kernel_children, report.source_annotations)
            report.fact_traces.push(ProofFactTrace{expression: expression, kernel_expression: kernel_expression, kind: "lemma-summary", line: line, name: name, dependency: dependency, premises_start: report.fact_trace_premises.count, premises_count: 0, kernel_premises_start: report.kernel_fact_trace_premises.count, kernel_premises_count: 0, summary_bindings_start: bindings_start, summary_bindings_count: parameter_names.count, summary_requires_start: requires_start, summary_requires_count: require_goal_ids.count, summary_ensure_index: ensure_index})

        def proof_type_bound_name(expression: Ast::Expr) -> sview:
            marker_name: sview = proof_unsigned_marker_name(expression)
            return marker_name if marker_name != ""
            # A type witness may be keyed by a place rather than a name. Retention follows the
            # root symbol of that place, so `h.part`'s witness lives and dies with `h`.
            root_name: sview = proof_type_marker_root_name(expression)
            return root_name if root_name != ""
            match expression:
                Ast::Expr.Binary(left, TokenKind.LtEq, right, _):
                    match left:
                        Ast::Expr.IntLit(value):
                            match right:
                                Ast::Expr.Ident(name, _):
                                    return name if value == 0
                                _:
                                    pass
                        _:
                            pass
                    match right:
                        Ast::Expr.IntLit(_):
                            match left:
                                Ast::Expr.Ident(name, _):
                                    return name
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return ""

        def proof_fact_is_type_bound(report: ProofReport&, expression: Ast::Expr, owner: sview) -> bool:
            return false if proof_type_bound_name(expression) == ""
            for trace in report.fact_traces:
                return true if trace.kind == "type-bound" and trace.name == owner and proof_expr_equal(trace.expression, expression)
            return false

        # Type bounds come from the compiler's variable type, not from mutable program state.
        # Preserve only those explicitly traced facts across an opaque/recursive call, and only
        # while their lexical binding is still live. Move-containing calls are excluded because
        # ownership invalidation can remove the binding itself at the statement boundary.
        def proof_restore_type_bound_facts(source: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, report: ProofReport&, owner: sview) -> void:
            for fact in source |fact, facts, names, report, owner|:
                bound_name: sview = proof_type_bound_name(fact)
                continue if bound_name == "" or not (any candidate in names where candidate == bound_name)
                continue if not proof_fact_is_type_bound(report, fact, owner)
                duplicate: mutable bool = false
                for existing in facts |existing, fact, duplicate|:
                    duplicate <- true if proof_expr_equal(existing, fact)
                facts.push(fact) if not duplicate

        # A loop or pattern binder can shadow a name while the proof state still uses source
        # spellings. Remove inherited type facts for those spellings before entering the child
        # state; otherwise an outer `0 <= i` could be applied to an unrelated signed binder.
        def proof_remove_type_bound_facts_for_names(facts: mutable darray[Ast::Expr]&, names: darray[sview]&) -> void:
            # Compact in place. A temporary AST value in a fresh darray would acquire the
            # inferred auto region of this helper; stage1 correctly rejects storing that value
            # into the longer-lived fact set. The source and destination are the same arena-owned
            # array, so compaction preserves both the AST views and the proof-state lifetime.
            original_count: usize = facts.count
            write_index: mutable usize = 0
            for read_index in 0..<original_count |facts, names, original_count, write_index|:
                bound_name: sview = proof_type_bound_name(facts[read_index])
                continue if bound_name != "" and (any candidate in names where candidate == bound_name)
                facts[write_index] <- facts[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)

        # Replaces `facts.clear()` at every state-invalidation point of symbolic execution.
        # Type-bound facts describe the compiler type of a binding, not mutable program state,
        # so they remain true across an invalidation while that binding is lexically live. A
        # redeclaration purges them explicitly before establishing the new declaration's type.
        # Without this, a cleared unsigned marker would let later arithmetic on the binding be
        # folded as unbounded signed arithmetic.
        def proof_push_aliased(aliased: mutable darray[sview]&, name: sview) -> void:
            return if name == ""
            return if any existing in aliased where existing == name
            aliased.push(name)

        # The locals of a function body that may be referenced: a place under `&`, `mutable` or
        # `move`, the receiver of a method call, and a bare name passed to a parameter that is a
        # reference (Elisa references such an argument implicitly) or to a callee whose signature
        # is not imported. A lambda body is not analyzed; it disables the analysis for the whole
        # function through the `*` sentinel. Everything else is a by-value scalar a callee cannot
        # reach.
        def proof_collect_aliased_names(body: darray[Ast::Stmt]&, functions: ProofFunctionTable&, aliased: mutable darray[sview]&) -> void:
            for statement in body |functions, aliased|:
                match statement:
                    Ast::Stmt.Expr(expression, _):
                        proof_collect_aliased_in_expression(expression, functions, aliased)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        proof_collect_aliased_names(block_body, functions, aliased)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        proof_collect_aliased_in_expression(initializer, functions, aliased)
                    Ast::Stmt.Assign(target, _, value, _):
                        proof_collect_aliased_in_expression(target, functions, aliased)
                        proof_collect_aliased_in_expression(value, functions, aliased)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_collect_aliased_in_expression(condition, functions, aliased)
                        proof_collect_aliased_names(then_body, functions, aliased)
                        proof_collect_aliased_names(else_body, functions, aliased)
                    Ast::Stmt.While(condition, while_body, _):
                        proof_collect_aliased_in_expression(condition, functions, aliased)
                        proof_collect_aliased_names(while_body, functions, aliased)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        proof_collect_aliased_in_expression(iterable, functions, aliased)
                        proof_collect_aliased_names(for_body, functions, aliased)
                    Ast::Stmt.Return(value, _):
                        proof_collect_aliased_in_expression(returned, functions, aliased) if value is returned
                    Ast::Stmt.Match(scrutinee, arms, _):
                        proof_collect_aliased_in_expression(scrutinee, functions, aliased)
                        for arm in arms |functions, aliased|:
                            proof_collect_aliased_in_expression(arm.guard, functions, aliased)
                            proof_collect_aliased_names(arm.body, functions, aliased)
                    Ast::Stmt.Contract(_, expression, _):
                        proof_collect_aliased_in_expression(expression, functions, aliased)
                    _:
                        pass

        def proof_strip_parens(expression: Ast::Expr) -> Ast::Expr:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_strip_parens(inner)
                _:
                    return expression

        def proof_collect_aliased_call_arguments(callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, functions: ProofFunctionTable&, aliased: mutable darray[sview]&) -> void:
            called: sview = proof_callable_name(callee)
            index: usize = proof_function_index(functions, called)
            known: bool = called != "" and index < functions.names.count
            match callee:
                Ast::Expr.Field(receiver, _, _):
                    proof_push_aliased(aliased, proof_ident_name(proof_strip_parens(receiver)))
                _:
                    pass
            for position in 0..<arguments.count |position, arguments, argument_names, functions, aliased, known, index|:
                argument_name: sview = proof_ident_name(proof_strip_parens(arguments[position]))
                continue if argument_name == ""
                if not known:
                    proof_push_aliased(aliased, argument_name)
                    continue
                parameter_start: usize = functions.param_starts[index]
                parameter_count: usize = functions.param_counts[index]
                slot: mutable usize = parameter_count
                if argument_names.count == arguments.count and argument_names[position] != "":
                    for offset in 0..<parameter_count |offset, functions, parameter_start, argument_names, position, slot|:
                        slot <- offset if functions.all_params[parameter_start + offset] == argument_names[position]
                else:
                    slot <- position if position < parameter_count
                if slot >= parameter_count or parameter_start + slot >= functions.all_parameter_references.count:
                    proof_push_aliased(aliased, argument_name)
                    continue
                proof_push_aliased(aliased, argument_name) if functions.all_parameter_references[parameter_start + slot]

        def proof_collect_aliased_in_expression(expression: Ast::Expr, functions: ProofFunctionTable&, aliased: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    proof_push_aliased(aliased, proof_place_root_name(operand, 0)) if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    proof_collect_aliased_in_expression(operand, functions, aliased)
                Ast::Expr.Move(operand, _):
                    proof_push_aliased(aliased, proof_place_root_name(operand, 0))
                    proof_collect_aliased_in_expression(operand, functions, aliased)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_push_aliased(aliased, proof_place_root_name(operand, 0))
                    proof_collect_aliased_in_expression(operand, functions, aliased)
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    proof_collect_aliased_call_arguments(callee, arguments, argument_names, functions, aliased)
                    proof_collect_aliased_in_expression(callee, functions, aliased)
                    for argument in arguments |functions, aliased|:
                        proof_collect_aliased_in_expression(argument, functions, aliased)
                Ast::Expr.StaticEffectCall(_, _, _, arguments, _, _):
                    for argument in arguments |functions, aliased|:
                        proof_push_aliased(aliased, proof_ident_name(proof_strip_parens(argument)))
                        proof_collect_aliased_in_expression(argument, functions, aliased)
                Ast::Expr.Field(object, _, _):
                    proof_collect_aliased_in_expression(object, functions, aliased)
                Ast::Expr.Scope(base, _, _):
                    proof_collect_aliased_in_expression(base, functions, aliased)
                Ast::Expr.Index(object, index, _):
                    proof_collect_aliased_in_expression(object, functions, aliased)
                    proof_collect_aliased_in_expression(index, functions, aliased)
                Ast::Expr.Slice(object, low, high, _):
                    proof_collect_aliased_in_expression(object, functions, aliased)
                    proof_collect_aliased_in_expression(low, functions, aliased)
                    proof_collect_aliased_in_expression(high, functions, aliased)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_collect_aliased_in_expression(object, functions, aliased)
                    for argument in arguments |functions, aliased|:
                        proof_collect_aliased_in_expression(argument, functions, aliased)
                Ast::Expr.Binary(left, _, right, _):
                    proof_collect_aliased_in_expression(left, functions, aliased)
                    proof_collect_aliased_in_expression(right, functions, aliased)
                Ast::Expr.Paren(inner, _):
                    proof_collect_aliased_in_expression(inner, functions, aliased)
                Ast::Expr.Array(elements, _):
                    for element in elements |functions, aliased|:
                        proof_collect_aliased_in_expression(element, functions, aliased)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |functions, aliased|:
                        proof_collect_aliased_in_expression(element, functions, aliased)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |functions, aliased|:
                        proof_collect_aliased_in_expression(element, functions, aliased)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |functions, aliased|:
                        proof_collect_aliased_in_expression(entry.key, functions, aliased)
                        proof_collect_aliased_in_expression(entry.value, functions, aliased)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |functions, aliased|:
                        proof_collect_aliased_in_expression(field.value, functions, aliased)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_collect_aliased_in_expression(base, functions, aliased)
                    for field in fields |functions, aliased|:
                        proof_collect_aliased_in_expression(field.value, functions, aliased)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    proof_collect_aliased_in_expression(condition, functions, aliased)
                    proof_collect_aliased_in_expression(then_expression, functions, aliased)
                    proof_collect_aliased_in_expression(else_expression, functions, aliased)
                Ast::Expr.Match(scrutinee, arms, _):
                    proof_collect_aliased_in_expression(scrutinee, functions, aliased)
                    for arm in arms |functions, aliased|:
                        proof_collect_aliased_in_expression(arm.guard, functions, aliased)
                        proof_collect_aliased_names(arm.body, functions, aliased)
                Ast::Expr.Catch(guarded, arms, _):
                    proof_collect_aliased_in_expression(guarded, functions, aliased)
                    for arm in arms |functions, aliased|:
                        proof_collect_aliased_in_expression(arm.guard, functions, aliased)
                        proof_collect_aliased_names(arm.body, functions, aliased)
                Ast::Expr.Comprehension(_, iterable, condition, comprehension_body, _):
                    proof_collect_aliased_in_expression(iterable, functions, aliased)
                    proof_collect_aliased_in_expression(condition, functions, aliased)
                    proof_collect_aliased_in_expression(comprehension_body, functions, aliased)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_collect_aliased_in_expression(base, functions, aliased)
                    proof_collect_aliased_in_expression(predicate, functions, aliased)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_collect_aliased_in_expression(guarded, functions, aliased)
                    proof_collect_aliased_names(recovery, functions, aliased)
                Ast::Expr.Lambda(_, _, _):
                    proof_push_aliased(aliased, "*")
                Ast::Expr.Block(statements, value, _, _):
                    proof_collect_aliased_names(statements, functions, aliased)
                    proof_collect_aliased_in_expression(value, functions, aliased)
                _:
                    pass

        # A fact a call cannot falsify: a proposition over literals and by-value scalar locals
        # and parameters of the current function that are never referenced. A callee reaches
        # its caller's state only through references and globals, so such a fact holds after
        # the call exactly as before it. Anything else — a field, an element, a container, a
        # call, a name the body may reference — is not stable.
        def proof_expr_call_stable(expression: Ast::Expr, facts: darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, aliased: darray[sview]&, depth: usize) -> bool:
            return false if depth >= 64
            match expression:
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.BoolLit(_):
                    return true
                Ast::Expr.CharLit(_):
                    return true
                Ast::Expr.ShorthandMember(parts, _):
                    return parts.count == 1 and parts[0] != ""
                Ast::Expr.Ident(name, _):
                    return false if any existing in aliased where existing == name
                    return false if not (any candidate in names where candidate == name) and not (any parameter in parameters where parameter == name)
                    return proof_scalar_witnessed(facts, name)
                Ast::Expr.Tuple(_, _):
                    # A loop binder's atom `(name, offset)`: the binder is a local of this body.
                    binder: sview = proof_place_root_name(expression, 0)
                    return false if binder == ""
                    return false if any existing in aliased where existing == binder
                    return false if not (any candidate in names where candidate == binder)
                    return proof_scalar_term_witnessed(expression, facts, 0)
                Ast::Expr.Paren(inner, _):
                    return proof_expr_call_stable(inner, facts, names, parameters, aliased, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Not
                    return proof_expr_call_stable(operand, facts, names, parameters, aliased, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_call_stable(left, facts, names, parameters, aliased, depth + 1) and proof_expr_call_stable(right, facts, names, parameters, aliased, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_expr_call_stable(condition, facts, names, parameters, aliased, depth + 1) and proof_expr_call_stable(then_expression, facts, names, parameters, aliased, depth + 1) and proof_expr_call_stable(else_expression, facts, names, parameters, aliased, depth + 1)
                _:
                    return false

        # Re-establish, after a nested opaque call, every pre-call fact that is call-stable for
        # the current function. Witnesses are read from the pre-call state, which still holds
        # every type bound the call could not remove.
        def proof_restore_call_stable_facts(source: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            for fact in source |source, facts, names, parameters, report|:
                continue if not proof_expr_call_stable(fact, source, names, parameters, report.aliased_names, 0)
                continue if any existing in facts where proof_expr_equal(existing, fact)
                facts.push(fact)

        # Give a fresh opaque symbol only to the bindings a captured block can actually write.
        # The capture list is the block's whole reach, so an uncaptured binding keeps its symbolic
        # value — but only when that value is itself call-stable against the captured and aliased
        # names, otherwise a value recorded in terms of a binding the block does rewrite would
        # silently follow it. Without a usable alias set for this frame nothing is kept, which is
        # exactly the whole-state havoc this replaces.
        def proof_forget_captured_values(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: darray[Ast::Expr]&, captures: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview, position: Ast::Pos) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            if not analyzed or captures.count == 0:
                proof_forget_values(names, values, position)
                return
            blocked: mutable darray[sview] = []
            blocked.extend(report.aliased_names)
            blocked.extend(captures)
            for index in 0..<values.count |index, names, values, facts, parameters, blocked, position|:
                values[index] <- Ast::Expr.Invalid if index >= names.count
                continue if index >= names.count
                retained: bool = not (any name in blocked where name == names[index]) and proof_expr_call_stable(values[index], facts, names, parameters, blocked, 0)
                values[index] <- Ast::Expr.Ident(names[index], position) if not retained

        # Re-establish, after a captured block in statement position, every fact the block could
        # not have falsified. The capture list is the block's whole reach: a binding it does not
        # name cannot be read or written inside it. Blocking the captured names alongside the
        # aliased ones reuses the call-stability rule unchanged, so a fact over an aliased or
        # unwitnessed binding is still refused and a captured reference cannot smuggle one back.
        def proof_restore_uncaptured_facts(source: darray[Ast::Expr]&, captures: darray[sview]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            return if captures.count == 0
            blocked: mutable darray[sview] = []
            blocked.extend(report.aliased_names)
            blocked.extend(captures)
            for fact in source |source, facts, names, parameters, blocked|:
                continue if not proof_expr_call_stable(fact, source, names, parameters, blocked, 0)
                continue if any existing in facts where proof_expr_equal(existing, fact)
                facts.push(fact)

        # Re-establish, at a branch join both arms reach, every fact that both arms still hold.
        # A fact standing at an arm's exit is true on that path, so one held on both paths is
        # true at the join. Only call-stable facts are imported, so an arm-local binding can
        # never escape with them, and an arm that assigns to a scalar has already purged the
        # facts over it, so a direct write inside the branch cannot survive here either.
        def proof_restore_branch_stable_facts(primary: darray[Ast::Expr]&, secondary: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            return if not analyzed
            for fact in primary |primary, secondary, facts, names, parameters, report|:
                continue if not (any other in secondary where proof_expr_equal(other, fact))
                continue if not proof_expr_call_stable(fact, primary, names, parameters, report.aliased_names, 0)
                continue if any existing in facts where proof_expr_equal(existing, fact)
                facts.push(fact)

        # Havoc for an opaque call. Type bounds are kept as at every havoc point; in addition a
        # fact that is call-stable for the current function is kept. The alias set must belong
        # to this very owner, otherwise nothing but type bounds survives.
        def proof_clear_facts_after_call(facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview) -> void:
            analyzed: bool = report.aliased_owner == owner and owner != "" and not (any existing in report.aliased_names where existing == "*")
            original: darray[Ast::Expr] = proof_copy_exprs(facts)
            keep: mutable darray[bool] = []
            for fact in original |keep, original, names, parameters, report, owner, analyzed|:
                bound_name: sview = proof_type_bound_name(fact)
                retained: mutable bool = false
                retained <- true if bound_name != "" and ((any candidate in names where candidate == bound_name) or (any parameter in parameters where parameter == bound_name)) and proof_fact_is_type_bound(report, fact, owner)
                retained <- true if not retained and analyzed and proof_expr_call_stable(fact, original, names, parameters, report.aliased_names, 0)
                keep.push(retained)
            write_index: mutable usize = 0
            for read_index in 0..<original.count |facts, original, keep, write_index|:
                continue if not keep[read_index]
                facts[write_index] <- original[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)

        def proof_clear_facts_keep_type_bounds(facts: mutable darray[Ast::Expr]&, names: darray[sview]&, parameters: darray[sview]&, report: ProofReport&, owner: sview) -> void:
            original_count: usize = facts.count
            write_index: mutable usize = 0
            for read_index in 0..<original_count |facts, names, parameters, report, owner, original_count, write_index|:
                bound_name: sview = proof_type_bound_name(facts[read_index])
                continue if bound_name == ""
                continue if not (any candidate in names where candidate == bound_name) and not (any parameter in parameters where parameter == bound_name)
                continue if not proof_fact_is_type_bound(report, facts[read_index], owner)
                facts[write_index] <- facts[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)

        # A binding becomes an opaque symbol again whenever its new value is not expressible in
        # terms of the existing symbols: a declaration reuses a spelling, an unsigned local is
        # bound or rebound, or any binding is updated by a compound assignment. Every fact that
        # mentions the old symbol, and every other binding whose recorded value mentions it,
        # would otherwise silently describe the new value. Purge both transitively. Only the
        # compiler type facts of cascaded bindings are re-established; their types are unchanged.
        def proof_resymbolize_binding(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, target: sview, position: Ast::Pos) -> void:
            return if target == ""
            targets: mutable darray[sview] = [target]
            changed: mutable bool = true
            while changed |changed, targets, names, values|:
                changed <- false
                for index in 0..<values.count |index, names, values, targets, changed|:
                    continue if index >= names.count
                    continue if any existing in targets where existing == names[index]
                    mentions: mutable bool = false
                    for candidate in targets |candidate, values, index, mentions|:
                        mentions <- true if proof_expr_mentions_name(values[index], candidate)
                    if mentions:
                        targets.push(names[index])
                        changed <- true
            cascaded_widths: mutable darray[i64] = []
            for candidate in targets |candidate, facts, cascaded_widths|:
                cascaded_widths.push(proof_unsigned_marker_width_for_name(facts, candidate))
            original_count: usize = facts.count
            write_index: mutable usize = 0
            for read_index in 0..<original_count |facts, targets, original_count, write_index|:
                mentions: mutable bool = false
                for candidate in targets |candidate, facts, read_index, mentions|:
                    mentions <- true if proof_expr_mentions_name(facts[read_index], candidate)
                continue if mentions
                facts[write_index] <- facts[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)
            for index in 0..<values.count |index, names, values, targets, position|:
                continue if index >= names.count
                values[index] <- Ast::Expr.Ident(names[index], position) if any candidate in targets where candidate == names[index]
            for target_index in 0..<targets.count |target_index, targets, cascaded_widths, facts, report, owner, position|:
                continue if target_index == 0 or target_index >= cascaded_widths.count
                proof_add_unsigned_binding_facts(facts, report, targets[target_index], cascaded_widths[target_index], position.line, owner, position)

        # Bind an unsigned local to its own symbol instead of substituting its value. The symbol
        # keeps its compiler width through every later substitution, so wrapping arithmetic on
        # it stays visible to the unsigned range guard rather than being folded into signed
        # literal arithmetic. The value is recorded as an equality only when it is itself
        # range-safe under the current facts; a possibly wrapping initializer leaves the symbol
        # opaque within its declared type range.
        def proof_bind_unsigned_symbol(names: darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview, slot: usize, width: i64, value: Ast::Expr, position: Ast::Pos) -> void:
            return if slot >= names.count or slot >= values.count or width <= 0
            symbol: sview = names[slot]
            proof_resymbolize_binding(names, values, facts, report, owner, symbol, position)
            values[slot] <- Ast::Expr.Ident(symbol, position)
            proof_add_unsigned_binding_facts(facts, report, symbol, width, position.line, owner, position)
            value_known: mutable bool = true
            match value:
                Ast::Expr.Invalid:
                    value_known <- false
                Ast::Expr.Absent:
                    value_known <- false
                _:
                    pass
            return if not value_known or proof_expr_mentions_name(value, symbol)
            return if not proof_unsigned_expression_safe(value, facts)
            binding: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident(symbol, position), TokenKind.EqEq, value, position)
            proof_add_traced_fact(facts, report, binding, "local-binding", position.line, owner)

        # A scalar local whose initializer is opaque still denotes one value. Keep its own name as
        # the symbol instead of the unexpressible initializer, so `reading == reading` is decided
        # over the witnessed binding rather than over two copies of an unknown. Nothing about the
        # value is assumed: an opaque initializer contributes no binding fact.
        def proof_bind_scalar_symbol(names: darray[sview]&, values: mutable darray[Ast::Expr]&, slot: usize, position: Ast::Pos) -> void:
            return if slot >= names.count or slot >= values.count
            match values[slot]:
                Ast::Expr.Invalid:
                    values[slot] <- Ast::Expr.Ident(names[slot], position)
                Ast::Expr.Absent:
                    values[slot] <- Ast::Expr.Ident(names[slot], position)
                _:
                    pass

        def proof_statement_declared_name(statement: Ast::Stmt) -> sview:
            match statement:
                Ast::Stmt.VarDecl(local_name, _, _, _):
                    return local_name
                _:
                    return ""

        def proof_restore_type_bound_facts_except(source: darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, report: ProofReport&, owner: sview, excluded: sview) -> void:
            for fact in source |fact, facts, names, report, owner, excluded|:
                bound_name: sview = proof_type_bound_name(fact)
                continue if bound_name == "" or bound_name == excluded
                continue if not (any candidate in names where candidate == bound_name)
                continue if not proof_fact_is_type_bound(report, fact, owner)
                duplicate: mutable bool = false
                for existing in facts |existing, fact, duplicate|:
                    duplicate <- true if proof_expr_equal(existing, fact)
                facts.push(fact) if not duplicate

        # Return the binding root affected by a move. Field and index moves consume the
        # containing binding from this kernel's name-based state; precise subfield ownership is
        # intentionally left to the compiler's affine checker until the proof state has binding
        # identities rather than source spellings.
        def proof_move_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _):
                    return proof_move_root(object)
                Ast::Expr.Index(object, _, _):
                    return proof_move_root(object)
                Ast::Expr.IndexN(object, _, _):
                    return proof_move_root(object)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_move_root(object)
                Ast::Expr.Paren(inner, _):
                    return proof_move_root(inner)
                Ast::Expr.Move(operand, _):
                    return proof_move_root(operand)
                _:
                    return ""

        def proof_collect_move_roots(expression: Ast::Expr, roots: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Move(operand, _):
                    root: sview = proof_move_root(operand)
                    roots.push(root) if root != "" and not (any existing in roots where existing == root)
                    proof_collect_move_roots(operand, roots)
                Ast::Expr.Paren(inner, _):
                    proof_collect_move_roots(inner, roots)
                Ast::Expr.Unary(_, operand, _):
                    proof_collect_move_roots(operand, roots)
                Ast::Expr.Binary(left, _, right, _):
                    proof_collect_move_roots(left, roots)
                    proof_collect_move_roots(right, roots)
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_collect_move_roots(callee, roots)
                    for argument in arguments |roots|:
                        proof_collect_move_roots(argument, roots)
                Ast::Expr.Field(object, _, _):
                    proof_collect_move_roots(object, roots)
                Ast::Expr.Scope(base, _, _):
                    proof_collect_move_roots(base, roots)
                Ast::Expr.Index(object, index, _):
                    proof_collect_move_roots(object, roots)
                    proof_collect_move_roots(index, roots)
                Ast::Expr.Slice(object, low, high, _):
                    proof_collect_move_roots(object, roots)
                    proof_collect_move_roots(low, roots)
                    proof_collect_move_roots(high, roots)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_collect_move_roots(object, roots)
                    for argument in arguments |roots|:
                        proof_collect_move_roots(argument, roots)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_collect_move_roots(operand, roots)
                Ast::Expr.Array(elements, _):
                    for element in elements |roots|:
                        proof_collect_move_roots(element, roots)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |roots|:
                        proof_collect_move_roots(element, roots)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |roots|:
                        proof_collect_move_roots(element, roots)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |roots|:
                        proof_collect_move_roots(entry.key, roots)
                        proof_collect_move_roots(entry.value, roots)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |roots|:
                        proof_collect_move_roots(field.value, roots)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_collect_move_roots(base, roots)
                    for field in fields |roots|:
                        proof_collect_move_roots(field.value, roots)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    proof_collect_move_roots(condition, roots)
                    proof_collect_move_roots(then_expr, roots)
                    proof_collect_move_roots(else_expr, roots)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    proof_collect_move_roots(iterable, roots)
                    proof_collect_move_roots(condition, roots)
                    proof_collect_move_roots(body, roots)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_collect_move_roots(base, roots)
                    proof_collect_move_roots(predicate, roots)
                Ast::Expr.GetElse(guarded, _, _):
                    # Recovery statements execute on the failure branch and are checked against
                    # a cloned state. Only a move in the successful guarded value invalidates the
                    # enclosing success-path binding here; recovery-side moves are collected by
                    # the nested proof_check_returns invocation.
                    proof_collect_move_roots(guarded, roots)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements |roots|:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                proof_collect_move_roots(initializer, roots)
                            Ast::Stmt.Assign(_, _, initializer, _):
                                proof_collect_move_roots(initializer, roots)
                            Ast::Stmt.Expr(statement_expression, _):
                                proof_collect_move_roots(statement_expression, roots)
                            Ast::Stmt.Return(statement_value, _):
                                if statement_value is returned:
                                    proof_collect_move_roots(returned, roots)
                            _:
                                pass
                    proof_collect_move_roots(value, roots)
                _:
                    pass

        def proof_statement_move_roots(statement: Ast::Stmt, roots: mutable darray[sview]&) -> void:
            match statement:
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        proof_collect_move_roots(returned, roots)
                Ast::Stmt.Expr(expression, _):
                    proof_collect_move_roots(expression, roots)
                Ast::Stmt.VarDecl(_, _, initializer, _):
                    proof_collect_move_roots(initializer, roots)
                Ast::Stmt.Assign(target, _, initializer, _):
                    proof_collect_move_roots(target, roots)
                    proof_collect_move_roots(initializer, roots)
                Ast::Stmt.If(condition, _, _, _):
                    proof_collect_move_roots(condition, roots)
                Ast::Stmt.While(condition, _, _):
                    proof_collect_move_roots(condition, roots)
                Ast::Stmt.For(_, _, iterable, _, _):
                    proof_collect_move_roots(iterable, roots)
                Ast::Stmt.Match(scrutinee, _, _):
                    proof_collect_move_roots(scrutinee, roots)
                Ast::Stmt.Block(block_kind, _, _, block_body, _):
                    if block_kind == "assert_by" and block_body.count > 0:
                        match block_body[0]:
                            Ast::Stmt.Contract(_, goal, _):
                                proof_collect_move_roots(goal, roots)
                            _:
                                pass
                Ast::Stmt.Contract(kind, expression, _):
                    proof_collect_move_roots(expression, roots) if kind == "assert"
                _:
                    pass

        # A move invalidates all symbolic values conservatively, then marks the consumed root as
        # unavailable. This makes a later use substitute to Invalid and prevents the proof
        # checker from proving a post-move property from a pre-move alias. The compiler's own
        # affine/linear/region passes remain the authority for exact ownership legality.
        def proof_invalidate_moved_roots(roots: darray[sview], names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, report: ProofReport&, owner: sview, position: Ast::Pos) -> void:
            return if roots.count == 0
            proof_forget_values(names, values, position)
            # A transfer invalidates what is known about the moved roots, not the declared type of
            # every other binding: an unrelated `y: i64` is still an `i64` afterwards. Keep the
            # traced type bounds of live, unmoved names and discard everything else, which is the
            # same retention rule used at call and control-flow havoc points.
            original_count: usize = facts.count
            write_index: mutable usize = 0
            for read_index in 0..<original_count |facts, names, roots, report, owner, original_count, write_index|:
                bound_name: sview = proof_type_bound_name(facts[read_index])
                continue if bound_name == ""
                continue if any root in roots where root == bound_name
                continue if not (any candidate in names where candidate == bound_name)
                continue if not proof_fact_is_type_bound(report, facts[read_index], owner)
                facts[write_index] <- facts[read_index]
                write_index <- write_index + 1
            facts.resize(write_index)
            for root in roots |root, names, values|:
                for index in 0..<names.count |index, names, values, root|:
                    values[index] <- Ast::Expr.Invalid if names[index] == root

        def proof_contracts(body: darray[Ast::Stmt]&, kind: sview) -> darray[Ast::Expr]:
            result: mutable darray[Ast::Expr] = []
            for statement in body |result, kind|:
                match statement:
                    Ast::Stmt.Contract(contract_kind, expression, _):
                        result.push(expression) if contract_kind == kind
                    _:
                        pass
            return result

        # Function/loop specifications are logical state, not executable expression contexts.
        # `old(...)` is modeled separately; other calls require an explicit purity proof and a
        # state-observation model for contract evaluation.
        # A contract may mention a call only when the callee was independently classified as a
        # total pure function. This is deliberately stricter than merely checking that the call
        # has an `ensure`: a precondition, mutable parameter, write, or opaque transitive call
        # would make the call a partial/effectful expression rather than a stable logical value.
        def proof_contract_calls_are_pure(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.FloatLit(_):
                    return true
                Ast::Expr.StringLit(_):
                    return true
                Ast::Expr.CharLit(_):
                    return true
                Ast::Expr.BoolLit(_):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    if proof_ident_name(callee) == "old" and arguments.count == 1:
                        return proof_contract_calls_are_pure(arguments[0], functions)
                    called: sview = proof_callable_name(callee)
                    called_index: usize = proof_function_index(functions, called)
                    return false if called == "" or called_index >= functions.pure.count or not functions.pure[called_index]
                    # Purity is a syntactic/fixed-point classification, not a proof result.
                    # A function whose body failed verification must not be smuggled into a
                    # logical contract merely because it has the right effect shape.
                    return false if called_index >= functions.verified.count or not functions.verified[called_index]
                    return false if not proof_contract_calls_are_pure(callee, functions)
                    for argument in arguments |functions|:
                        return false if not proof_contract_calls_are_pure(argument, functions)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_contract_calls_are_pure(inner, functions)
                Ast::Expr.Unary(_, operand, _):
                    return proof_contract_calls_are_pure(operand, functions)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_contract_calls_are_pure(left, functions) and proof_contract_calls_are_pure(right, functions)
                Ast::Expr.Field(object, _, _):
                    return proof_contract_calls_are_pure(object, functions)
                Ast::Expr.Scope(base, _, _):
                    return proof_contract_calls_are_pure(base, functions)
                Ast::Expr.Index(object, index, _):
                    return proof_contract_calls_are_pure(object, functions) and proof_contract_calls_are_pure(index, functions)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_contract_calls_are_pure(object, functions) and proof_contract_calls_are_pure(low, functions) and proof_contract_calls_are_pure(high, functions)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_contract_calls_are_pure(object, functions)
                    for argument in arguments |functions|:
                        return false if not proof_contract_calls_are_pure(argument, functions)
                    return true
                Ast::Expr.Move(operand, _):
                    return proof_contract_calls_are_pure(operand, functions)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_contract_calls_are_pure(operand, functions)
                Ast::Expr.Array(elements, _):
                    for element in elements |functions|:
                        return false if not proof_contract_calls_are_pure(element, functions)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements |functions|:
                        return false if not proof_contract_calls_are_pure(element, functions)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements |functions|:
                        return false if not proof_contract_calls_are_pure(element, functions)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |functions|:
                        return false if not proof_contract_calls_are_pure(entry.key, functions) or not proof_contract_calls_are_pure(entry.value, functions)
                    return true
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |functions|:
                        return false if not proof_contract_calls_are_pure(field.value, functions)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_contract_calls_are_pure(base, functions)
                    for field in fields |functions|:
                        return false if not proof_contract_calls_are_pure(field.value, functions)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_contract_calls_are_pure(condition, functions) and proof_contract_calls_are_pure(then_expr, functions) and proof_contract_calls_are_pure(else_expr, functions)
                Ast::Expr.Match(scrutinee, arms, _):
                    return false if not proof_contract_calls_are_pure(scrutinee, functions)
                    for arm in arms |functions|:
                        return false if not proof_contract_calls_are_pure(arm.guard, functions)
                        return false if arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return false if not proof_contract_calls_are_pure(value, functions)
                            _:
                                return false
                    return true
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_contract_calls_are_pure(iterable, functions) and proof_contract_calls_are_pure(condition, functions) and proof_contract_calls_are_pure(body, functions)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_contract_calls_are_pure(base, functions) and proof_contract_calls_are_pure(predicate, functions)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return false if not proof_contract_calls_are_pure(initializer, functions)
                            _:
                                return false
                    return proof_contract_calls_are_pure(value, functions)
                _:
                    return false

        # A fact produced by a runtime assertion may outlive the expression evaluation. A
        # substituted call term is therefore safe to publish only when it denotes a certified pure
        # value; an unresolved/effectful call may have a different result on its next execution.
        def proof_runtime_fact_is_stable(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            return false if proof_expr_has_old(expression)
            return true if not proof_expr_has_call(expression)
            return proof_contract_calls_are_pure(expression, functions)

        # Rewrite only exact equalities already published by a verified call summary. This is
        # intentionally separate from ordinary identifier substitution: call results are effect-
        # sensitive, and treating arbitrary equalities as a rewrite system could cross a call or
        # overflow boundary. The enclosing admission gates ensure nested runtime calls are pure;
        # the equality lookup also handles a successful result binding from a fallible call. The
        # eight-step fuel limit keeps nested expressions finite and fail-closed.
        def proof_pure_call_summary_replacement(expression: Ast::Expr, facts: darray[Ast::Expr]&, functions: ProofFunctionTable&) -> (known: bool, value: Ast::Expr):
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    pass
                _:
                    return (false, Ast::Expr.Invalid)
            return (false, Ast::Expr.Invalid) if proof_expr_has_old(expression)
            for fact in facts |expression|:
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        candidate: Ast::Expr = right if proof_expr_equal(left, expression) else (left if proof_expr_equal(right, expression) else Ast::Expr.Invalid)
                        if not proof_expr_is_invalid(candidate) and proof_expr_supported(candidate) and not proof_expr_has_old(candidate) and not proof_expr_has_move(candidate):
                            return (true, candidate)
                    _:
                        pass
            return (false, Ast::Expr.Invalid)

        def proof_rewrite_pure_call_summaries(expression: Ast::Expr, facts: darray[Ast::Expr]&, functions: ProofFunctionTable&, depth: usize) -> Ast::Expr:
            return expression if depth >= 8
            direct: (known: bool, value: Ast::Expr) = proof_pure_call_summary_replacement(expression, facts, functions)
            if direct.known and not proof_expr_equal(direct.value, expression):
                return proof_rewrite_pure_call_summaries(direct.value, facts, functions, depth + 1)
            match expression:
                Ast::Expr.Paren(inner, position):
                    return Ast::Expr.Paren(proof_rewrite_pure_call_summaries(inner, facts, functions, depth + 1), position)
                Ast::Expr.Unary(operator, operand, position):
                    return Ast::Expr.Unary(operator, proof_rewrite_pure_call_summaries(operand, facts, functions, depth + 1), position)
                Ast::Expr.Binary(left, operator, right, position):
                    return Ast::Expr.Binary(proof_rewrite_pure_call_summaries(left, facts, functions, depth + 1), operator, proof_rewrite_pure_call_summaries(right, facts, functions, depth + 1), position)
                Ast::Expr.Field(object, field, position):
                    return Ast::Expr.Field(proof_rewrite_pure_call_summaries(object, facts, functions, depth + 1), field, position)
                Ast::Expr.Scope(base, member, position):
                    return Ast::Expr.Scope(proof_rewrite_pure_call_summaries(base, facts, functions, depth + 1), member, position)
                Ast::Expr.Index(object, index, position):
                    return Ast::Expr.Index(proof_rewrite_pure_call_summaries(object, facts, functions, depth + 1), proof_rewrite_pure_call_summaries(index, facts, functions, depth + 1), position)
                Ast::Expr.Slice(object, low, high, position):
                    return Ast::Expr.Slice(proof_rewrite_pure_call_summaries(object, facts, functions, depth + 1), proof_rewrite_pure_call_summaries(low, facts, functions, depth + 1), proof_rewrite_pure_call_summaries(high, facts, functions, depth + 1), position)
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    rewritten_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |rewritten_arguments, facts, functions, depth|:
                        rewritten_arguments.push(proof_rewrite_pure_call_summaries(argument, facts, functions, depth + 1))
                    rewritten_call: Ast::Expr = Ast::Expr.Call(proof_rewrite_pure_call_summaries(callee, facts, functions, depth + 1), rewritten_arguments, argument_names, position)
                    rewritten_direct: (known: bool, value: Ast::Expr) = proof_pure_call_summary_replacement(rewritten_call, facts, functions)
                    return proof_rewrite_pure_call_summaries(rewritten_direct.value, facts, functions, depth + 1) if rewritten_direct.known and not proof_expr_equal(rewritten_direct.value, rewritten_call)
                    return rewritten_call
                _:
                    return expression

        def proof_check_logical_contract_calls(body: darray[Ast::Stmt]&, functions: ProofFunctionTable&, report: mutable ProofReport&, name: sview) -> void:
            for statement in body |functions, report, name|:
                match statement:
                    Ast::Stmt.Contract(kind, expression, position):
                        logical: bool = kind == "requires" or kind == "ensure" or kind == "invariant" or kind == "decreases" or kind == "decreases*"
                        if logical:
                            if proof_expr_has_move(expression):
                                report.proof_obligation(false)
                                proof_add_finding(report, "contract-resource-unsupported", position.line, name, "logical contracts may not perform ownership transfers")
                            elif not proof_expr_supported(expression):
                                report.proof_obligation(false)
                                proof_add_finding(report, "contract-expression-unsupported", position.line, name, "logical contract uses an unsupported expression form")
                            else:
                                if proof_expr_has_executable_call(expression) and not proof_contract_calls_are_pure(expression, functions):
                                    report.proof_obligation(false)
                                    proof_add_finding(report, "contract-call-unsupported", position.line, name, "logical contracts may use old(...) or calls to verified total pure functions")
                    Ast::Stmt.If(_, then_body, else_body, _):
                        proof_check_logical_contract_calls(then_body, functions, report, name)
                        proof_check_logical_contract_calls(else_body, functions, report, name)
                    Ast::Stmt.While(_, while_body, _):
                        proof_check_logical_contract_calls(while_body, functions, report, name)
                    Ast::Stmt.For(_, _, _, for_body, _):
                        proof_check_logical_contract_calls(for_body, functions, report, name)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |functions, report, name|:
                            proof_check_logical_contract_calls(arm.body, functions, report, name)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        proof_check_logical_contract_calls(block_body, functions, report, name)
                    _:
                        pass

        def proof_signature_contracts(file: Ast::File&, line: u32, kind: sview) -> darray[Ast::Expr]:
            result: mutable darray[Ast::Expr] = []
            index: mutable usize = 0
            while index < file.signature_contract_lines.count |index, file, line, kind, result|:
                if file.signature_contract_lines[index] == line and file.signature_contract_kinds[index] == kind:
                    result.push(file.signature_contract_exprs[index])
                index <- index + 1
            return result

        # The mutable name stack is append-only while checking one lexical path. Therefore the
        # last binding for a name tells us whether it is still one of the original parameters;
        # this prevents a local shadow from accidentally borrowing a parameter's frame grant.
        def proof_current_parameter(names: darray[sview]&, parameter_names: darray[sview]&, name: sview) -> bool:
            index: mutable usize = names.count
            while index > 0 |index, names, parameter_names|:
                index <- index - 1
                return index < parameter_names.count if names[index] == name
            return false

        # Decode the frame syntax the compiler parser keeps in the AST. Frame clauses are
        # places, not propositions: only a bare root or a bounded root.field... selector is
        # accepted by this kernel. Anything richer stays opaque and cannot authorize a write or
        # preserve a caller fact. The bound is explicit in ProofFramePlace so summaries remain
        # flat and independently inspectable.
        def proof_frame_place_add_field(parent: ProofFramePlace, field: sview) -> (known: bool, place: ProofFramePlace):
            empty: ProofFramePlace = ProofFramePlace{root: "", field: "", field2: "", field3: "", depth: 0, whole: false}
            return (false, empty) if parent.root == "" or field == "" or parent.depth >= 3
            if parent.depth == 0:
                return (true, ProofFramePlace{root: parent.root, field: field, field2: "", field3: "", depth: 1, whole: false})
            if parent.depth == 1:
                return (true, ProofFramePlace{root: parent.root, field: parent.field, field2: field, field3: "", depth: 2, whole: false})
            return (true, ProofFramePlace{root: parent.root, field: parent.field, field2: parent.field2, field3: field, depth: 3, whole: false})

        def proof_frame_place(expression: Ast::Expr) -> (known: bool, place: ProofFramePlace):
            empty: ProofFramePlace = ProofFramePlace{root: "", field: "", field2: "", field3: "", depth: 0, whole: false}
            match expression:
                Ast::Expr.Ident(root, _):
                    return (root != "", ProofFramePlace{root: root, field: "", field2: "", field3: "", depth: 0, whole: true})
                Ast::Expr.Field(object, field, _):
                    parent: (known: bool, place: ProofFramePlace) = proof_frame_place(object)
                    return proof_frame_place_add_field(parent.place, field) if parent.known
                    return (false, empty)
                Ast::Expr.Paren(inner, _):
                    return proof_frame_place(inner)
                _:
                    return (false, empty)

        def proof_frame_body_places(body: darray[Ast::Stmt]&, kind: sview) -> darray[ProofFramePlace]:
            result: mutable darray[ProofFramePlace] = []
            for statement in body |result, kind|:
                match statement:
                    Ast::Stmt.Contract(contract_kind, expression, _):
                        decoded: (known: bool, place: ProofFramePlace) = proof_frame_place(expression)
                        result.push(decoded.place) if contract_kind == kind and decoded.known
                    _:
                        pass
            return result

        def proof_frame_place_same(left: ProofFramePlace, right: ProofFramePlace) -> bool:
            return left.root != "" and right.root != "" and left.root == right.root and left.depth == right.depth and left.field == right.field and left.field2 == right.field2 and left.field3 == right.field3 and left.whole == right.whole

        # A frame permission is a path prefix permission. Changing `box.inner` may update any
        # descendant of `inner`, while changing `box.inner.value` does not authorize a sibling or
        # the whole `box.inner` object. This is also the overlap relation used for preservation.
        def proof_frame_place_is_prefix(prefix: ProofFramePlace, target: ProofFramePlace) -> bool:
            return false if prefix.root == "" or target.root == "" or prefix.root != target.root
            return true if prefix.whole
            return false if target.whole or prefix.depth > target.depth
            return false if prefix.depth >= 1 and prefix.field != target.field
            return false if prefix.depth >= 2 and prefix.field2 != target.field2
            return false if prefix.depth >= 3 and prefix.field3 != target.field3
            return true

        def proof_frame_places_overlap(preserved: ProofFramePlace, changed: ProofFramePlace) -> bool:
            return false if preserved.root == "" or changed.root == "" or preserved.root != changed.root
            return proof_frame_place_is_prefix(preserved, changed) or proof_frame_place_is_prefix(changed, preserved)

        # A declared whole-root or subtree change authorizes every target below that path.
        # Unknown roots from lossy compiler metadata never authorize a write, which keeps the
        # proof kernel fail-closed.
        def proof_frame_allows_write(changes: darray[ProofFramePlace]&, target: ProofFramePlace) -> bool:
            for changed in changes:
                return true if proof_frame_place_is_prefix(changed, target)
            return false

        def proof_frame_argument_place(expression: Ast::Expr) -> (known: bool, place: ProofFramePlace):
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return proof_frame_place(operand) if operator == TokenKind.Ampersand
                    return (false, ProofFramePlace{root: "", field: "", field2: "", field3: "", depth: 0, whole: false})
                Ast::Expr.Paren(inner, _):
                    return proof_frame_argument_place(inner)
                _:
                    return proof_frame_place(expression)

        # Append a callee frame path to the caller argument path. For example, a callee place
        # `p.value` passed `&box.inner` maps to `box.inner.value`. The explicit depth cap causes
        # an opaque mapping instead of silently dropping a selector.
        def proof_frame_place_append(base: ProofFramePlace, suffix: ProofFramePlace) -> (known: bool, place: ProofFramePlace):
            empty: ProofFramePlace = ProofFramePlace{root: "", field: "", field2: "", field3: "", depth: 0, whole: false}
            return (false, empty) if base.root == "" or suffix.root == ""
            total: usize = base.depth + suffix.depth
            return (false, empty) if total > 3
            first: sview = base.field if base.depth >= 1 else suffix.field
            second: sview = base.field2 if base.depth >= 2 else (suffix.field if base.depth == 1 else suffix.field2)
            third: sview = base.field3 if base.depth >= 3 else (suffix.field if base.depth == 2 else (suffix.field2 if base.depth == 1 else suffix.field3))
            return (true, ProofFramePlace{root: base.root, field: first, field2: second, field3: third, depth: total, whole: total == 0})

        # Recover the known container prefix of an indexed/sliced target. The selector itself is
        # intentionally opaque, but a checked ancestor frame can still authorize the operation:
        # `changes box.values` covers `box.values[i]`, while an exact element frame is not
        # guessed. This lets the heap model make useful progress without pretending indices are
        # alias-free.
        def proof_frame_target_place_prefix(expression: Ast::Expr) -> (known: bool, place: ProofFramePlace):
            empty: ProofFramePlace = ProofFramePlace{root: "", field: "", field2: "", field3: "", depth: 0, whole: false}
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_frame_target_place_prefix(inner)
                Ast::Expr.Unary(operator, operand, _):
                    return proof_frame_target_place_prefix(operand) if operator == TokenKind.Ampersand
                    return (false, empty)
                Ast::Expr.Field(object, field, _):
                    parent: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(object)
                    return proof_frame_place_add_field(parent.place, field) if parent.known
                    return (false, empty)
                Ast::Expr.Index(object, _, _):
                    return proof_frame_target_place_prefix(object)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_frame_target_place_prefix(object)
                Ast::Expr.IndexN(object, _, _):
                    return proof_frame_target_place_prefix(object)
                _:
                    return proof_frame_place(expression)

        def proof_frame_target_has_dynamic_selector(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_frame_target_has_dynamic_selector(inner)
                Ast::Expr.Unary(_, operand, _):
                    return proof_frame_target_has_dynamic_selector(operand)
                Ast::Expr.Field(object, _, _):
                    return proof_frame_target_has_dynamic_selector(object)
                Ast::Expr.Index(_, _, _):
                    return true
                Ast::Expr.Slice(_, _, _, _):
                    return true
                Ast::Expr.IndexN(_, _, _):
                    return true
                _:
                    return false

        def proof_frame_place_from_call(place: ProofFramePlace, parameter_names: darray[sview]&, argument_values: darray[Ast::Expr]&) -> ProofFramePlace:
            empty: ProofFramePlace = ProofFramePlace{root: "", field: "", field2: "", field3: "", depth: 0, whole: false}
            return empty if place.root == ""
            for index in 0..<argument_values.count |index, parameter_names, argument_values|:
                if index < parameter_names.count:
                    if parameter_names[index] == place.root:
                        argument_place: ProofFramePlace = proof_frame_argument_place(argument_values[index]).place
                        return proof_frame_place_append(argument_place, place).place if argument_place.root != ""
                        return empty
            return empty

        # Whether an expression depends on a changed place. A field mutation invalidates the
        # overlapping selector and a bare use of its root (the latter may be an alias); unrelated
        # sibling fields remain available for modular proofs.
        def proof_expr_mentions_frame_place(expression: Ast::Expr, place: ProofFramePlace) -> bool:
            decoded: (known: bool, place: ProofFramePlace) = proof_frame_place(expression)
            if decoded.known:
                if place.root == "":
                    return decoded.place.field == place.field and decoded.place.field2 == place.field2 and decoded.place.field3 == place.field3 and decoded.place.depth == place.depth
                return proof_frame_places_overlap(decoded.place, place)
            match expression:
                Ast::Expr.Field(object, field, _):
                    return proof_expr_mentions_frame_place(object, place)
                Ast::Expr.Paren(inner, _):
                    return proof_expr_mentions_frame_place(inner, place)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_mentions_frame_place(operand, place)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_mentions_frame_place(left, place) or proof_expr_mentions_frame_place(right, place)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_expr_mentions_frame_place(callee, place)
                    for argument in arguments:
                        return true if proof_expr_mentions_frame_place(argument, place)
                    return false
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_mentions_frame_place(base, place)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_mentions_frame_place(object, place) or proof_expr_mentions_frame_place(index, place)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_mentions_frame_place(object, place) or proof_expr_mentions_frame_place(low, place) or proof_expr_mentions_frame_place(high, place)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_mentions_frame_place(object, place)
                    for argument in arguments:
                        return true if proof_expr_mentions_frame_place(argument, place)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_expr_mentions_frame_place(operand, place)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_mentions_frame_place(operand, place)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_frame_place(element, place)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_frame_place(element, place)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_frame_place(element, place)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_mentions_frame_place(entry.key, place) or proof_expr_mentions_frame_place(entry.value, place)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if proof_expr_mentions_frame_place(field.value, place)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_mentions_frame_place(base, place)
                    for field in fields:
                        return true if proof_expr_mentions_frame_place(field.value, place)
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_mentions_frame_place(iterable, place) or proof_expr_mentions_frame_place(condition, place) or proof_expr_mentions_frame_place(body, place)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_mentions_frame_place(condition, place) or proof_expr_mentions_frame_place(then_expr, place) or proof_expr_mentions_frame_place(else_expr, place)
                _:
                    return true

        # Whether a root expression may denote a reference whose storage identity is not
        # represented in the AST fragment. Calls, indexes, slices, and unsupported forms are
        # opaque reference candidates; literal constructors and scalar expressions are not.
        def proof_expr_may_be_opaque_reference(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return true
                Ast::Expr.Index(_, _, _):
                    return true
                Ast::Expr.Slice(_, _, _, _):
                    return true
                Ast::Expr.IndexN(_, _, _):
                    return true
                Ast::Expr.Move(operand, _):
                    return proof_expr_may_be_opaque_reference(operand)
                Ast::Expr.RegionNew(_, _, _):
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_expr_may_be_opaque_reference(object)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return proof_expr_may_be_opaque_reference(base)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_may_be_opaque_reference(condition) or proof_expr_may_be_opaque_reference(then_expr) or proof_expr_may_be_opaque_reference(else_expr)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_may_be_opaque_reference(iterable) or proof_expr_may_be_opaque_reference(condition) or proof_expr_may_be_opaque_reference(body)
                Ast::Expr.Paren(inner, _):
                    return proof_expr_may_be_opaque_reference(inner)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_may_be_opaque_reference(operand)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_may_be_opaque_reference(left) or proof_expr_may_be_opaque_reference(right)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if proof_expr_may_be_opaque_reference(field.value)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_may_be_opaque_reference(element)
                    return false
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_may_be_opaque_reference(element)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_may_be_opaque_reference(element)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_may_be_opaque_reference(entry.key) or proof_expr_may_be_opaque_reference(entry.value)
                    return false
                _:
                    return false

        # A call argument aliases a frame place only for the direct forms this kernel can
        # justify. Passing a whole root may expose every descendant; passing &root.field exposes
        # that subtree. Unknown aliases cause the caller's facts to be discarded but do not
        # silently establish frame preservation.
        def proof_argument_may_alias_place(argument: Ast::Expr, place: ProofFramePlace) -> bool:
            root: sview = proof_ident_name(argument)
            return true if root != "" and root == place.root
            match argument:
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(operand)
                        return true if addressed.known and proof_frame_places_overlap(addressed.place, place)
                    return proof_argument_may_alias_place(operand, place)
                Ast::Expr.Paren(inner, _):
                    return proof_argument_may_alias_place(inner, place)
                Ast::Expr.Field(_, _, _):
                    addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(argument)
                    return addressed.known and proof_frame_places_overlap(addressed.place, place)
                Ast::Expr.Index(_, _, _):
                    addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(argument)
                    return addressed.known and proof_frame_places_overlap(addressed.place, place)
                Ast::Expr.Slice(_, _, _, _):
                    addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(argument)
                    return addressed.known and proof_frame_places_overlap(addressed.place, place)
                Ast::Expr.IndexN(_, _, _):
                    addressed: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(argument)
                    return addressed.known and proof_frame_places_overlap(addressed.place, place)
                _:
                    return false

        # Extract the storage root from an assignment target. The returned expression is kept
        # structured so symbolic substitution can resolve a local reference alias to a parameter
        # before the frame decision is made.
        def proof_frame_target_root(expression: Ast::Expr) -> Ast::Expr:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_frame_target_root(inner)
                Ast::Expr.Field(object, _, _):
                    return proof_frame_target_root(object)
                Ast::Expr.Index(object, _, _):
                    return proof_frame_target_root(object)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_frame_target_root(object)
                Ast::Expr.IndexN(object, _, _):
                    return proof_frame_target_root(object)
                _:
                    return expression

        def proof_call_may_alias_places(arguments: darray[Ast::Expr]&, places: darray[ProofFramePlace]&, names: darray[sview]&, parameter_names: darray[sview]&) -> bool:
            for argument in arguments:
                for place in places:
                    return true if proof_argument_may_alias_place(argument, place) and proof_current_parameter(names, parameter_names, place.root)
            return false

        def proof_frame_collect_annotations(file: Ast::File&, function_name: sview, changes: mutable darray[ProofFramePlace]&, preserves: mutable darray[ProofFramePlace]&) -> void:
            header_change_roots: mutable darray[sview] = []
            header_change_fields: mutable darray[sview] = []
            preserved_roots: mutable darray[sview] = []
            preserved_fields: mutable darray[sview] = []
            for annotation in file.enum_annotations |header_change_roots, header_change_fields, preserved_roots, preserved_fields|:
                if annotation.owner == function_name and annotation.line == 3900000010:
                    changes.push(ProofFramePlace{root: annotation.name, field: "", field2: "", field3: "", depth: 0, whole: true})
                if annotation.owner == function_name and annotation.line == 3900000006:
                    header_change_roots.push(annotation.name)
                if annotation.owner == function_name and annotation.line == 3900000003:
                    header_change_fields.push(annotation.name)
                if annotation.owner == function_name and annotation.line == 3900000011:
                    preserved_roots.push(annotation.name)
                if annotation.owner == function_name and annotation.line == 3900000012:
                    preserved_fields.push(annotation.name)
                # This marker is emitted by the parser's conflict scanner for dotted changes
                # targets. It is useful only as a field fallback when the paired capture is
                # absent; the paired 0006/0003 rows above retain the exact root.
                if annotation.owner == function_name and annotation.line == 3900000077 and header_change_fields.count == 0:
                    header_change_fields.push(annotation.name)
            for index in 0..<header_change_fields.count |changes, header_change_roots, header_change_fields, index|:
                root: sview = header_change_roots[index] if index < header_change_roots.count else ""
                changes.push(ProofFramePlace{root: root, field: header_change_fields[index], field2: "", field3: "", depth: 1, whole: false})
            index: mutable usize = 0
            while index < preserved_roots.count and index < preserved_fields.count |index, preserved_roots, preserved_fields, preserves|:
                preserves.push(ProofFramePlace{root: preserved_roots[index], field: preserved_fields[index], field2: "", field3: "", depth: 1, whole: false})
                index <- index + 1

        def proof_function_is_lemma(file: Ast::File&, name: sview) -> bool:
            for annotation in file.enum_annotations:
                return true if annotation.owner == "__lemma" and annotation.name == name
            return false

        # Name lookup is on a hot path during call-graph construction and SCC analysis. The
        # hash is only a collision-safe prefilter; the exact sview comparison below remains the
        # authority, so this optimization cannot turn a collision into a resolved call.
        def proof_name_hash(value: sview) -> u32:
            hash: mutable i64 = 2166136261
            for index in 0..<sview_len(value) |index, hash, value|:
                hash <- ((hash ^ sview_at(value, index).i64()) * 16777619) % 4294967296
            return hash.u32()

        # Keep graph traversal termination explicit. This avoids depending on a higher-order
        # membership expression inside a mutable worklist, and makes the finite exploration
        # invariant directly auditable in the self-hosted checker.
        def proof_usize_seen(values: darray[usize]&, wanted: usize) -> bool:
            for value in values:
                return true if value == wanted
            return false

        # Build an open-addressed name index after collection is complete. Exact name equality
        # remains the authority; stored hashes only choose a probe path, and duplicate names are
        # represented by an ambiguity sentinel so malformed overload-free tables fail closed.
        def proof_index_capacity(count: usize) -> usize:
            return 0 if count == 0
            capacity: mutable usize = 1
            while capacity < count |capacity, count|:
                capacity <- capacity * 2
            return capacity

        def proof_build_lemma_index(lemmas: mutable ProofLemmaTable&) -> void:
            lemmas.index_hashes.clear()
            lemmas.index_values.clear()
            capacity: usize = proof_index_capacity(lemmas.names.count)
            return if capacity == 0
            lemmas.index_hashes.resize(capacity)
            lemmas.index_values.resize(capacity)
            for slot in 0..<capacity |slot, lemmas|:
                lemmas.index_values[slot] <- lemmas.names.count
            for name_index in 0..<lemmas.names.count |name_index, lemmas, capacity|:
                hash: u32 = lemmas.name_hashes[name_index]
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity |probes, slot, hash, name_index, lemmas, capacity|:
                    current: usize = lemmas.index_values[slot]
                    if current == lemmas.names.count:
                        lemmas.index_hashes[slot] <- hash
                        lemmas.index_values[slot] <- name_index
                        break
                    if current <= lemmas.names.count and lemmas.index_hashes[slot] == hash and lemmas.names[current] == lemmas.names[name_index]:
                        lemmas.index_values[slot] <- lemmas.names.count + 1
                        break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1

        def proof_build_function_index(functions: mutable ProofFunctionTable&) -> void:
            functions.index_hashes.clear()
            functions.index_values.clear()
            capacity: usize = proof_index_capacity(functions.names.count)
            return if capacity == 0
            functions.index_hashes.resize(capacity)
            functions.index_values.resize(capacity)
            for slot in 0..<capacity |slot, functions|:
                functions.index_values[slot] <- functions.names.count
            for name_index in 0..<functions.names.count |name_index, functions, capacity|:
                hash: u32 = functions.name_hashes[name_index]
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity |probes, slot, hash, name_index, functions, capacity|:
                    current: usize = functions.index_values[slot]
                    if current == functions.names.count:
                        functions.index_hashes[slot] <- hash
                        functions.index_values[slot] <- name_index
                        break
                    if current <= functions.names.count and functions.index_hashes[slot] == hash and functions.names[current] == functions.names[name_index]:
                        functions.index_values[slot] <- functions.names.count + 1
                        break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1

        # Build the same kind of flat lemma summary used by the compiler's assert-by checker.
        # A call can contribute only a postcondition from a lemma whose preconditions are
        # established at the call site; opaque ordinary functions never contribute facts.
        def proof_collect_lemmas(file: Ast::File&, declarations: darray[Ast::Decl], lemmas: mutable ProofLemmaTable&) -> void:
            for declaration in declarations |file, lemmas|:
                match declaration:
                    Ast::Decl.Func(name, parameters, return_type, body, _, _, position):
                        if proof_function_is_lemma(file, name):
                            lemmas.names <- lemmas.names.push(name)
                            lemmas.name_hashes <- lemmas.name_hashes.push(proof_name_hash(name))
                            lemmas.param_starts <- lemmas.param_starts.push(lemmas.all_params.count)
                            lemmas.param_counts <- lemmas.param_counts.push(parameters.count)
                            for parameter in parameters |lemmas|:
                                lemmas.all_params <- lemmas.all_params.push(parameter.name)
                                lemmas.all_has_defaults <- lemmas.all_has_defaults.push(parameter.has_default)
                                lemmas.all_defaults <- lemmas.all_defaults.push(parameter.default_value)
                            lemmas.call_starts <- lemmas.call_starts.push(lemmas.all_calls.count)
                            lemma_call_names: mutable darray[sview] = []
                            proof_collect_lemma_body_call_names(body, &lemma_call_names)
                            for called in lemma_call_names |lemmas|:
                                lemmas.all_calls <- lemmas.all_calls.push(called)
                            lemmas.call_counts <- lemmas.call_counts.push(lemma_call_names.count)
                            lemmas.decreases_starts <- lemmas.decreases_starts.push(lemmas.all_decreases.count)
                            decreases_components: mutable darray[Ast::Expr] = []
                            has_unbounded_decreases: mutable bool = false
                            for statement in body |decreases_components, has_unbounded_decreases|:
                                match statement:
                                    Ast::Stmt.Contract(kind, expression, _):
                                        proof_decreases_components(expression, &decreases_components) if kind == "decreases"
                                        has_unbounded_decreases <- true if kind == "decreases*"
                                    _:
                                        pass
                            lemmas.all_decreases.extend(decreases_components)
                            lemmas.decreases_counts <- lemmas.decreases_counts.push(decreases_components.count)
                            lemmas.decreases_unbounded <- lemmas.decreases_unbounded.push(has_unbounded_decreases)
                            lemmas.requires_starts <- lemmas.requires_starts.push(lemmas.all_requires.count)
                            lemmas.ensure_starts <- lemmas.ensure_starts.push(lemmas.all_ensures.count)
                            requires_count: mutable usize = 0
                            ensures_count: mutable usize = 0
                            for statement in body |lemmas, requires_count, ensures_count|:
                                match statement:
                                    Ast::Stmt.Contract(kind, expression, _):
                                        if kind == "requires":
                                            lemmas.all_requires <- lemmas.all_requires.push(expression)
                                            requires_count <- requires_count + 1
                                        if kind == "ensure":
                                            lemmas.all_ensures <- lemmas.all_ensures.push(expression)
                                            ensures_count <- ensures_count + 1
                                    _:
                                        pass
                            signature_requires: darray[Ast::Expr] = proof_signature_contracts(file, position.line, "requires")
                            signature_ensures: darray[Ast::Expr] = proof_signature_contracts(file, position.line, "ensure")
                            lemmas.all_requires.extend(signature_requires)
                            lemmas.all_ensures.extend(signature_ensures)
                            requires_count <- requires_count + signature_requires.count
                            ensures_count <- ensures_count + signature_ensures.count
                            lemmas.requires_counts <- lemmas.requires_counts.push(requires_count)
                            lemmas.ensure_counts <- lemmas.ensure_counts.push(ensures_count)
                    Ast::Decl.Module(_, module_body, _):
                        proof_collect_lemmas(file, module_body, lemmas)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_collect_lemmas(file, scoped_body, lemmas)
                    _:
                        pass

        def proof_lemma_index(lemmas: ProofLemmaTable&, name: sview) -> usize:
            if lemmas.index_values.count > 0:
                wanted_hash: u32 = proof_name_hash(name)
                capacity: usize = lemmas.index_values.count
                slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity |probes, slot, wanted_hash, name, lemmas, capacity|:
                    current: usize = lemmas.index_values[slot]
                    return lemmas.names.count if current == lemmas.names.count
                    return lemmas.names.count if current > lemmas.names.count
                    if lemmas.index_hashes[slot] == wanted_hash and lemmas.names[current] == name:
                        return current
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return lemmas.names.count
            index: mutable usize = 0
            found: mutable usize = lemmas.names.count
            wanted_hash: u32 = proof_name_hash(name)
            while index < lemmas.names.count |index, lemmas, name|:
                if index >= lemmas.name_hashes.count or lemmas.name_hashes[index] == wanted_hash:
                    if lemmas.names[index] == name:
                        return lemmas.names.count if found < lemmas.names.count
                        found <- index
                index <- index + 1
            return found

        # Lemma calls in erased proof steps still participate in induction. The executable call
        # graph deliberately ignores those steps, so recursive lemma summaries need this separate
        # collector that descends through every assert-by body instead of only its runtime guard.
        def proof_collect_lemma_body_call_names(body: darray[Ast::Stmt]&, names: mutable darray[sview]&) -> void:
            for statement in body |names|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        proof_collect_call_names(returned, names) if value is returned
                    Ast::Stmt.Expr(expression, _):
                        proof_collect_call_names(expression, names)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        proof_collect_call_names(initializer, names)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        proof_collect_call_names(target, names)
                        proof_collect_call_names(initializer, names)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_collect_call_names(condition, names)
                        proof_collect_lemma_body_call_names(then_body, names)
                        proof_collect_lemma_body_call_names(else_body, names)
                    Ast::Stmt.While(condition, while_body, _):
                        proof_collect_call_names(condition, names)
                        proof_collect_lemma_body_call_names(while_body, names)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        proof_collect_call_names(iterable, names)
                        proof_collect_lemma_body_call_names(for_body, names)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        proof_collect_call_names(scrutinee, names)
                        for arm in arms |names|:
                            proof_collect_call_names(arm.guard, names)
                            proof_collect_lemma_body_call_names(arm.body, names)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        proof_collect_lemma_body_call_names(block_body, names)
                    Ast::Stmt.Contract(kind, expression, _):
                        proof_collect_call_names(expression, names) if kind == "assert"
                    _:
                        names.push("__opaque_call__") if not (any existing in names where existing == "__opaque_call__")

        # Lemmas are theorem declarations, not executable summaries. A recursive lemma cannot
        # use its own postcondition as an induction hypothesis unless the kernel also checks a
        # well-founded proof. Keep the graph conservative: unknown/opaque proof-body calls are
        # treated as a possible hidden edge for the queried node, so a future AST form cannot
        # smuggle a recursive lemma back into the summary table.
        def proof_lemma_reaches(lemmas: ProofLemmaTable&, source: usize, target: usize) -> bool:
            return false if source >= lemmas.names.count or target >= lemmas.names.count
            reachable: mutable darray[usize] = [source]
            cursor: mutable usize = 0
            while cursor < reachable.count |cursor, reachable, lemmas, target|:
                current: usize = reachable[cursor]
                return true if current == target and (current >= lemmas.call_starts.count or current >= lemmas.call_counts.count)
                return false if current >= lemmas.call_starts.count or current >= lemmas.call_counts.count
                start: usize = lemmas.call_starts[current]
                count: usize = lemmas.call_counts[current]
                for offset in 0..<count |offset, start, lemmas, reachable, target|:
                    return true if current == target and start + offset >= lemmas.all_calls.count
                    continue if start + offset >= lemmas.all_calls.count
                    called: sview = lemmas.all_calls[start + offset]
                    if called == "__opaque_call__":
                        return true if current == target
                    else:
                        next: usize = proof_lemma_index(lemmas, called)
                        if next < lemmas.names.count:
                            return true if next == target
                            already_seen: bool = proof_usize_seen(reachable, next)
                            reachable.push(next) if not already_seen
                cursor <- cursor + 1
            return false

        # Compute lemma SCCs with iterative Kosaraju traversal. The older per-node reachability
        # test was easy to read but quadratic over large imported compiler modules and could make
        # self-hosted-scale checking impractical. The explicit stacks keep traversal bounded by
        # the collected graph and avoid recursive host-stack assumptions.
        def proof_build_lemma_components(lemmas: mutable ProofLemmaTable&) -> void:
            count: usize = lemmas.names.count
            lemmas.recursive.clear()
            lemmas.recursive_component_ids.clear()
            return if count == 0
            reverse_counts: mutable darray[usize] = []
            reverse_counts.resize(count)
            self_edges: mutable darray[bool] = []
            self_edges.resize(count)
            for source in 0..<count |source, lemmas, reverse_counts, self_edges|:
                start: usize = lemmas.call_starts[source] if source < lemmas.call_starts.count else lemmas.all_calls.count
                edge_count: usize = lemmas.call_counts[source] if source < lemmas.call_counts.count else 0
                valid_range: bool = start <= lemmas.all_calls.count and edge_count <= lemmas.all_calls.count - start
                continue if not valid_range
                for offset in 0..<edge_count |offset, source, start, lemmas, reverse_counts, self_edges|:
                    called: sview = lemmas.all_calls[start + offset]
                    next: usize = proof_lemma_index(lemmas, called)
                    continue if next >= count
                    reverse_counts[next] <- reverse_counts[next] + 1
                    self_edges[source] <- true if next == source
            reverse_starts: mutable darray[usize] = []
            reverse_cursor: mutable usize = 0
            for incoming in reverse_counts |reverse_starts, reverse_cursor|:
                reverse_starts.push(reverse_cursor)
                reverse_cursor <- reverse_cursor + incoming
            reverse_edges: mutable darray[usize] = []
            reverse_edges.resize(reverse_cursor)
            reverse_write: mutable darray[usize] = []
            reverse_write.extend(reverse_starts)
            for source in 0..<count |source, lemmas, reverse_starts, reverse_write, reverse_edges|:
                start: usize = lemmas.call_starts[source] if source < lemmas.call_starts.count else lemmas.all_calls.count
                edge_count: usize = lemmas.call_counts[source] if source < lemmas.call_counts.count else 0
                valid_range: bool = start <= lemmas.all_calls.count and edge_count <= lemmas.all_calls.count - start
                continue if not valid_range
                for offset in 0..<edge_count |offset, source, start, lemmas, reverse_write, reverse_edges|:
                    next: usize = proof_lemma_index(lemmas, lemmas.all_calls[start + offset])
                    continue if next >= count
                    slot: usize = reverse_write[next]
                    reverse_edges[slot] <- source
                    reverse_write[next] <- slot + 1
            visited: mutable darray[bool] = []
            visited.resize(count)
            order: mutable darray[usize] = []
            for source in 0..<count |source, visited, order, lemmas|:
                continue if visited[source]
                stack_nodes: mutable darray[usize] = [source]
                stack_offsets: mutable darray[usize] = [0]
                visited[source] <- true
                while stack_nodes.count > 0 |stack_nodes, stack_offsets, visited, order, lemmas|:
                    top: usize = stack_nodes.count - 1
                    current: usize = stack_nodes[top]
                    start: usize = lemmas.call_starts[current] if current < lemmas.call_starts.count else lemmas.all_calls.count
                    edge_count: usize = lemmas.call_counts[current] if current < lemmas.call_counts.count else 0
                    valid_range: bool = start <= lemmas.all_calls.count and edge_count <= lemmas.all_calls.count - start
                    if valid_range and stack_offsets[top] < edge_count:
                        offset: usize = stack_offsets[top]
                        stack_offsets[top] <- offset + 1
                        next: usize = proof_lemma_index(lemmas, lemmas.all_calls[start + offset])
                        if next < count and not visited[next]:
                            visited[next] <- true
                            stack_nodes.push(next)
                            stack_offsets.push(0)
                    else:
                        order.push(current)
                        stack_nodes <- stack_nodes.truncate(top)
                        stack_offsets <- stack_offsets.truncate(top)
            component_ids: mutable darray[usize] = []
            component_ids.resize(count)
            for index in 0..<count |index, component_ids|:
                component_ids[index] <- count
            for order_index in 0..<order.count |order_index, order, component_ids, reverse_starts, reverse_counts, reverse_edges, count|:
                seed: usize = order[order.count - 1 - order_index]
                continue if component_ids[seed] < count
                component_ids[seed] <- seed
                component_work: mutable darray[usize] = [seed]
                while component_work.count > 0 |component_work, component_ids, reverse_starts, reverse_counts, reverse_edges, count|:
                    current: usize = component_work[component_work.count - 1]
                    component_work <- component_work.truncate(component_work.count - 1)
                    start: usize = reverse_starts[current]
                    edge_count: usize = reverse_counts[current]
                    for offset in 0..<edge_count |offset, start, reverse_edges, component_ids, component_work, current|:
                        predecessor: usize = reverse_edges[start + offset]
                        if component_ids[predecessor] == count:
                            component_ids[predecessor] <- seed
                            component_work.push(predecessor)
            component_sizes: mutable darray[usize] = []
            component_sizes.resize(count)
            for index in 0..<count |index, component_ids, component_sizes, count|:
                component_sizes[component_ids[index]] <- component_sizes[component_ids[index]] + 1
            for index in 0..<count |index, component_ids, component_sizes, self_edges, lemmas|:
                lemmas.recursive_component_ids.push(component_ids[index])
                lemmas.recursive.push(component_sizes[component_ids[index]] > 1 or self_edges[index])

        def proof_lemmas_same_recursive_component(lemmas: ProofLemmaTable&, source: usize, target: usize) -> bool:
            return false if source >= lemmas.names.count or target >= lemmas.names.count
            return true if source == target
            return false if source >= lemmas.recursive.count or target >= lemmas.recursive.count
            return false if not lemmas.recursive[source] or not lemmas.recursive[target]
            if source < lemmas.recursive_component_ids.count and target < lemmas.recursive_component_ids.count:
                return lemmas.recursive_component_ids[source] == lemmas.recursive_component_ids[target]
            return proof_lemma_reaches(lemmas, source, target) and proof_lemma_reaches(lemmas, target, source)

        # Map actual arguments to formal parameters using Elisa's named-argument rules. The
        # compiler stores labels separately from values, so positional substitution is not
        # sufficient: `f(second: y, first: x)` must instantiate the same summary as `f(x, y)`.
        # Missing/defaulted parameters are declined here until summary metadata carries a
        # validated default-value substitution; this is conservative and avoids guessing.
        def proof_parameter_index(parameters: darray[sview]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < parameters.count |index, parameters, name|:
                return index if parameters[index] == name
                index <- index + 1
            return parameters.count

        def proof_map_call_arguments(parameters: darray[sview]&, has_defaults: darray[bool]&, defaults: darray[Ast::Expr]&, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&) -> bool:
            mapped.clear()
            return false if argument_names.count != 0 and argument_names.count != arguments.count
            used: mutable darray[bool] = []
            for parameter in parameters |mapped, used|:
                mapped.push(Ast::Expr.Absent)
                used.push(false)
            saw_named: mutable bool = false
            next_positional: mutable usize = 0
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, parameters, mapped, used, saw_named, next_positional|:
                label: sview = argument_names[argument_index] if argument_names.count == arguments.count else ""
                parameter_index: mutable usize = parameters.count
                if label == "":
                    return false if saw_named
                    while next_positional < parameters.count and used[next_positional] |next_positional, used, parameters|:
                        next_positional <- next_positional + 1
                    return false if next_positional >= parameters.count
                    parameter_index <- next_positional
                    next_positional <- next_positional + 1
                else:
                    saw_named <- true
                    parameter_index <- proof_parameter_index(parameters, label)
                    return false if parameter_index >= parameters.count
                return false if used[parameter_index]
                mapped[parameter_index] <- arguments[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameters.count |parameter_index, used|:
                if not used[parameter_index]:
                    # Defaults are executable expressions. To keep the summary boundary
                    # proof-safe, only pure defaults are materialized here; calls, `old`, and
                    # unresolved later-formal dependencies require a future effect-aware call
                    # evaluator and therefore decline conservatively.
                    return false if parameter_index >= has_defaults.count or parameter_index >= defaults.count or not has_defaults[parameter_index]
                    default_expression: Ast::Expr = defaults[parameter_index]
                    return false if proof_expr_has_call(default_expression) or proof_expr_has_old(default_expression)
                    if parameter_index + 1 < parameters.count:
                        for later_index in parameter_index + 1..<parameters.count |later_index, parameters, default_expression|:
                            return false if proof_expr_mentions_name(default_expression, parameters[later_index])
                    resolved_default: Ast::Expr = proof_substitute(default_expression, parameters, mapped)
                    return false if proof_expr_has_call(resolved_default) or proof_expr_has_old(resolved_default)
                    for formal_name in parameters |formal_name, resolved_default|:
                        return false if proof_expr_mentions_name(resolved_default, formal_name)
                    mapped[parameter_index] <- resolved_default
                    used[parameter_index] <- true
            return true

        def proof_apply_lemma(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, lemmas: ProofLemmaTable&, caller_names: darray[sview]&, caller_values: darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    lemma_name: sview = proof_callable_name(callee)
                    lemma_index: usize = proof_lemma_index(lemmas, lemma_name)
                    return false if lemma_name == "" or lemma_index >= lemmas.names.count
                    if lemma_index >= lemmas.verified.count or not lemmas.verified[lemma_index]:
                        report.proof_obligation(false)
                        proof_add_finding(report, "lemma-summary-unverified", position.line, name, "lemma body has not established a verified proof summary")
                        return false
                    return false if lemma_index >= lemmas.param_counts.count or arguments.count > lemmas.param_counts[lemma_index]
                    parameter_names: mutable darray[sview] = []
                    argument_values: mutable darray[Ast::Expr] = []
                    param_start: usize = lemmas.param_starts[lemma_index]
                    for argument_index in 0..<lemmas.param_counts[lemma_index] |parameter_names, arguments, lemmas, param_start|:
                        parameter_names.push(lemmas.all_params[param_start + argument_index])
                    mapped_arguments: mutable darray[Ast::Expr] = []
                    default_start: usize = lemmas.param_starts[lemma_index]
                    default_flags: mutable darray[bool] = []
                    default_values: mutable darray[Ast::Expr] = []
                    for parameter_index in 0..<lemmas.param_counts[lemma_index] |default_flags, default_values, lemmas, default_start|:
                        default_flags.push(lemmas.all_has_defaults[default_start + parameter_index])
                        default_values.push(lemmas.all_defaults[default_start + parameter_index])
                    return false if not proof_map_call_arguments(parameter_names, default_flags, default_values, arguments, argument_names, &mapped_arguments)
                    argument_values.extend(mapped_arguments)
                    requires_ok: mutable bool = true
                    require_goal_ids: mutable darray[usize] = []
                    requires_start: usize = lemmas.requires_starts[lemma_index]
                    requires_count: usize = lemmas.requires_counts[lemma_index]
                    for requires_index in 0..<requires_count |requires_ok, facts, parameter_names, argument_values, lemmas, requires_start|:
                        required: Ast::Expr = proof_substitute(lemmas.all_requires[requires_start + requires_index], parameter_names, argument_values)
                        goal_id: usize = report.goal_attempts.count
                        required_proven: bool = proof_certify_goal(facts, required, report, position.line, name, annotations)
                        require_goal_ids.push(goal_id) if goal_id < report.goal_attempts.count
                        report.proof_obligation(required_proven)
                        requires_ok <- false if not required_proven
                        proof_add_latest_goal_finding(report, "lemma-requires-unproven", position.line, name, "lemma precondition is not established at the call") if not required_proven
                    return false if not requires_ok
                    if lemma_index < lemmas.recursive.count and lemmas.recursive[lemma_index]:
                        caller_lemma_index: usize = proof_lemma_index(lemmas, name)
                        same_recursive_component: bool = caller_lemma_index < lemmas.names.count and proof_lemmas_same_recursive_component(lemmas, caller_lemma_index, lemma_index)
                        if same_recursive_component:
                            caller_has_measure: bool = caller_lemma_index < lemmas.decreases_counts.count and caller_lemma_index < lemmas.decreases_starts.count and caller_lemma_index < lemmas.decreases_unbounded.count and lemmas.decreases_counts[caller_lemma_index] > 0 and not lemmas.decreases_unbounded[caller_lemma_index] and proof_decreases_range_valid(lemmas.decreases_starts[caller_lemma_index], lemmas.decreases_counts[caller_lemma_index], lemmas.all_decreases.count)
                            callee_has_measure: bool = lemma_index < lemmas.decreases_counts.count and lemma_index < lemmas.decreases_starts.count and lemma_index < lemmas.decreases_unbounded.count and lemmas.decreases_counts[lemma_index] > 0 and not lemmas.decreases_unbounded[lemma_index] and proof_decreases_range_valid(lemmas.decreases_starts[lemma_index], lemmas.decreases_counts[lemma_index], lemmas.all_decreases.count)
                            same_measure_arity: bool = caller_has_measure and callee_has_measure and lemmas.decreases_counts[caller_lemma_index] == lemmas.decreases_counts[lemma_index]
                            if not same_measure_arity:
                                report.proof_obligation(false)
                                proof_add_finding(report, "lemma-recursive-unsupported", position.line, name, "recursive lemma summaries require matching checked lexicographic termination measures")
                                return false
                            caller_param_names: mutable darray[sview] = []
                            caller_param_values: mutable darray[Ast::Expr] = []
                            caller_param_start: usize = lemmas.param_starts[caller_lemma_index]
                            caller_param_count: usize = lemmas.param_counts[caller_lemma_index]
                            for parameter_index in 0..<caller_param_count |caller_param_names, caller_param_values, lemmas, caller_param_start, caller_names, caller_values, position|:
                                parameter_name: sview = lemmas.all_params[caller_param_start + parameter_index]
                                caller_param_names.push(parameter_name)
                                caller_param_values.push(proof_substitute(Ast::Expr.Ident(parameter_name, position), caller_names, caller_values))
                            current_components: mutable darray[Ast::Expr] = []
                            recursive_components: mutable darray[Ast::Expr] = []
                            caller_measure_start: usize = lemmas.decreases_starts[caller_lemma_index]
                            callee_measure_start: usize = lemmas.decreases_starts[lemma_index]
                            for component_index in 0..<lemmas.decreases_counts[caller_lemma_index] |component_index, current_components, lemmas, caller_measure_start, caller_param_names, caller_param_values|:
                                current_components.push(proof_substitute(lemmas.all_decreases[caller_measure_start + component_index], caller_param_names, caller_param_values))
                            for component_index in 0..<lemmas.decreases_counts[lemma_index] |component_index, recursive_components, lemmas, callee_measure_start, parameter_names, argument_values|:
                                recursive_components.push(proof_substitute(lemmas.all_decreases[callee_measure_start + component_index], parameter_names, argument_values))
                            current_nonnegative_proven: mutable bool = true
                            recursive_nonnegative_proven: mutable bool = true
                            for component in current_components |facts, annotations, report, name, position, current_nonnegative_proven|:
                                current_nonnegative: Ast::Expr = Ast::Expr.Binary(component, TokenKind.GtEq, Ast::Expr.IntLit(0), position)
                                component_proven: bool = proof_certify_goal(facts, current_nonnegative, report, position.line, name, annotations)
                                report.proof_obligation(component_proven)
                                current_nonnegative_proven <- false if not component_proven
                                proof_add_latest_goal_finding(report, "lemma-recursive-decreases-unproven", position.line, name, "recursive lemma decreases component is not proven nonnegative") if not component_proven
                            for component in recursive_components |facts, annotations, report, name, position, recursive_nonnegative_proven|:
                                recursive_nonnegative: Ast::Expr = Ast::Expr.Binary(component, TokenKind.GtEq, Ast::Expr.IntLit(0), position)
                                component_proven: bool = proof_certify_goal(facts, recursive_nonnegative, report, position.line, name, annotations)
                                report.proof_obligation(component_proven)
                                recursive_nonnegative_proven <- false if not component_proven
                                proof_add_latest_goal_finding(report, "lemma-recursive-decreases-unproven", position.line, name, "recursive lemma callee measure is not proven nonnegative") if not component_proven
                            smaller_proven: bool = proof_lexicographic_smaller(current_components, recursive_components, facts, annotations, position, report, name)
                            report.proof_obligation(smaller_proven)
                            proof_add_latest_goal_finding(report, "lemma-recursive-decreases-unproven", position.line, name, "recursive lemma lexicographic measure is not proven to strictly decrease") if not smaller_proven
                            return false if not current_nonnegative_proven or not recursive_nonnegative_proven or not smaller_proven
                    ensures_start: usize = lemmas.ensure_starts[lemma_index]
                    ensures_count: usize = lemmas.ensure_counts[lemma_index]
                    for ensure_index in 0..<ensures_count |facts, parameter_names, argument_values, lemmas, ensures_start, report, name, position|:
                        ensure_expression: Ast::Expr = lemmas.all_ensures[ensures_start + ensure_index]
                        # A statement-form lemma call has no result slot to substitute. Do not
                        # let a bare `result` from a returning lemma become a caller fact.
                        if proof_expr_mentions_name(ensure_expression, "result"):
                            report.proof_obligation(false)
                            proof_add_finding(report, "lemma-result-unbound", position.line, name, "returning lemma ensure cannot be used without a result binding")
                            return false
                        proof_add_lemma_summary_fact(facts, report, proof_substitute(ensure_expression, parameter_names, argument_values), position.line, name, lemma_name, parameter_names, argument_values, require_goal_ids, ensure_index)
                    return true
                _:
                    return false

        def proof_function_index(functions: ProofFunctionTable&, name: sview) -> usize:
            if functions.index_values.count > 0:
                wanted_hash: u32 = proof_name_hash(name)
                capacity: usize = functions.index_values.count
                slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity |probes, slot, wanted_hash, name, functions, capacity|:
                    current: usize = functions.index_values[slot]
                    return functions.names.count if current == functions.names.count
                    return functions.names.count if current > functions.names.count
                    if functions.index_hashes[slot] == wanted_hash and functions.names[current] == name:
                        return current
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return functions.names.count
            index: mutable usize = 0
            found: mutable usize = functions.names.count
            wanted_hash: u32 = proof_name_hash(name)
            while index < functions.names.count |index, functions, name|:
                if index >= functions.name_hashes.count or functions.name_hashes[index] == wanted_hash:
                    if functions.names[index] == name:
                        return functions.names.count if found < functions.names.count
                        found <- index
                index <- index + 1
            return found

        def proof_structural_name_in(names: darray[sview]&, wanted: sview) -> bool:
            return wanted != "" and (any candidate in names where candidate == wanted)

        # A value block may capture mutable loop state that is unrelated to the
        # structural subject. Such a capture does not affect termination evidence unless
        # it is itself one of the strict-subterm binders used by a recursive edge. Keep
        # the conservative rejection for captures that overlap those binders, but do not
        # let an accumulator or parser cursor hide an otherwise checked descent.
        def proof_structural_captures_overlap(captures: darray[sview]&, smaller: darray[ProofStructuralSmaller]&) -> bool:
            for capture in captures |smaller|:
                return true if any candidate in smaller where candidate.name == capture
            return false

        # Structural termination environments are name-based because the compiler AST does not
        # expose stable binding identities. Remove every outer fact shadowed by a nested binder;
        # retaining the spelling would let an unrelated local masquerade as a strict subterm.
        def proof_structural_without(source: darray[sview]&, blocked: darray[sview]&) -> darray[sview]:
            result: mutable darray[sview] = []
            for candidate in source |result, blocked|:
                result.push(candidate) if not proof_structural_name_in(blocked, candidate)
            return result

        # After a branch or loop, a structural binding remains usable only if both the incoming
        # state and every normal path preserve it. Newly introduced arm/block locals are never
        # merged because they are outside the enclosing lexical scope.
        def proof_structural_intersect(left: darray[sview]&, right: darray[sview]&) -> darray[sview]:
            result: mutable darray[sview] = []
            for candidate in left |result, right|:
                result.push(candidate) if proof_structural_name_in(right, candidate)
            return result

        def proof_structural_smaller_without(source: darray[ProofStructuralSmaller]&, blocked: darray[sview]&) -> darray[ProofStructuralSmaller]:
            result: mutable darray[ProofStructuralSmaller] = []
            for candidate in source |result, blocked|:
                result.push(candidate) if not proof_structural_name_in(blocked, candidate.name)
            return result

        # Branch joins retain a mapped subterm only when both paths preserve the same origin
        # subject. Matching names with different subjects would recreate the product-ranking bug
        # this provenance exists to prevent.
        def proof_structural_smaller_intersect(left: darray[ProofStructuralSmaller]&, right: darray[ProofStructuralSmaller]&) -> darray[ProofStructuralSmaller]:
            result: mutable darray[ProofStructuralSmaller] = []
            for candidate in left |result, right|:
                result.push(candidate) if any other in right where other.name == candidate.name and other.subject == candidate.subject
            return result

        # Pattern bindings that are in scope after a match. This list is used only to decide
        # which values can themselves be destructured later; it is intentionally broader than
        # the strict-subterm list below.
        def proof_structural_pattern_bindings(pattern: Ast::Pattern, bindings: mutable darray[sview]&) -> void:
            match pattern:
                Ast::Pattern.Binding(name):
                    bindings.push(name) if name != ""
                Ast::Pattern.As(name, inner):
                    bindings.push(name) if name != ""
                    for subpattern in inner |bindings|:
                        proof_structural_pattern_bindings(subpattern, bindings)
                Ast::Pattern.TypeBind(_, binder):
                    bindings.push(binder) if binder != ""
                Ast::Pattern.Variant(_, fields):
                    for subpattern in fields |bindings|:
                        proof_structural_pattern_bindings(subpattern, bindings)
                Ast::Pattern.Struct(_, fields):
                    for subpattern in fields |bindings|:
                        proof_structural_pattern_bindings(subpattern, bindings)
                Ast::Pattern.Field(_, inner):
                    for subpattern in inner |bindings|:
                        proof_structural_pattern_bindings(subpattern, bindings)
                Ast::Pattern.Tuple(elements):
                    for subpattern in elements |bindings|:
                        proof_structural_pattern_bindings(subpattern, bindings)
                Ast::Pattern.Rest(name):
                    bindings.push(name) if name != ""
                Ast::Pattern.Or(options):
                    for option in options |bindings|:
                        proof_structural_pattern_bindings(option, bindings)
                _:
                    pass

        # Only payload/field binders are strict subterms. A bare binding, `as whole`, or
        # category binder names the complete matched value and is therefore never accepted as a
        # structural decrease. Or-patterns are left opaque because a binder may exist in only one
        # alternative; rejecting them is safer than guessing which names are common.
        def proof_structural_pattern_subterms(pattern: Ast::Pattern, subject: sview, subterms: mutable darray[ProofStructuralSmaller]&) -> void:
            match pattern:
                Ast::Pattern.Variant(_, fields):
                    for subpattern in fields |subterms|:
                        proof_structural_pattern_subterms(subpattern, subject, subterms)
                Ast::Pattern.Struct(_, fields):
                    for subpattern in fields |subterms|:
                        proof_structural_pattern_subterms(subpattern, subject, subterms)
                Ast::Pattern.Field(_, inner):
                    for subpattern in inner |subterms|:
                        proof_structural_pattern_subterms(subpattern, subject, subterms)
                Ast::Pattern.Tuple(elements):
                    for subpattern in elements |subterms|:
                        proof_structural_pattern_subterms(subpattern, subject, subterms)
                Ast::Pattern.Binding(name):
                    subterms.push(ProofStructuralSmaller{name: name, subject: subject}) if name != ""
                Ast::Pattern.As(_, inner):
                    for subpattern in inner |subterms|:
                        proof_structural_pattern_subterms(subpattern, subject, subterms)
                _:
                    pass

        # A recursive AST walker often reaches a child through a compiler-owned side table:
        # `for argument in arguments: visit(argument)`. The loop variable is a strict subterm of
        # the matched enum value when the iterable itself is a matched subterm. Direct projections
        # from that element (for example `field.value`) are strict as well. The compiler has
        # already type-checked the recursive call; this helper recognizes only the structural
        # shape and never infers a type from a spelling.
        def proof_structural_argument_root(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_structural_argument_root(inner)
                Ast::Expr.Field(object, _, _):
                    return proof_structural_argument_root(object)
                Ast::Expr.Index(object, _, _):
                    return proof_structural_argument_root(object)
                Ast::Expr.IndexN(object, _, _):
                    return proof_structural_argument_root(object)
                _:
                    return ""

        def proof_structural_argument_is_smaller(expression: Ast::Expr, smaller: darray[ProofStructuralSmaller]&) -> bool:
            root: sview = proof_structural_argument_root(expression)
            return root != "" and any candidate in smaller where candidate.name == root

        def proof_structural_argument_is_smaller_for_subject(expression: Ast::Expr, subject: sview, smaller: darray[ProofStructuralSmaller]&) -> bool:
            root: sview = proof_structural_argument_root(expression)
            return root != "" and any candidate in smaller where candidate.name == root and candidate.subject == subject

        def proof_structural_argument_subject(expression: Ast::Expr, smaller: darray[ProofStructuralSmaller]&) -> sview:
            root: sview = proof_structural_argument_root(expression)
            for candidate in smaller |root|:
                return candidate.subject if candidate.name == root
            return ""

        def proof_structural_call_argument(arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, parameters: darray[Ast::ParamDecl]&, position: usize) -> Ast::Expr:
            return Ast::Expr.Invalid if position >= parameters.count
            if argument_names.count == 0:
                if position < arguments.count:
                    return arguments[position]
                return Ast::Expr.Invalid
            return Ast::Expr.Invalid if argument_names.count != arguments.count
            has_named: bool = any label in argument_names where label != ""
            return Ast::Expr.Invalid if has_named and (any label in argument_names where label == "")
            if not has_named:
                if position < arguments.count:
                    return arguments[position]
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, parameters, position|:
                return arguments[argument_index] if argument_names[argument_index] == parameters[position].name
            return Ast::Expr.Invalid

        def proof_parameter_position(parameters: darray[Ast::ParamDecl]&, wanted: sview) -> usize:
            for index in 0..<parameters.count |index, parameters, wanted|:
                return index if parameters[index].name == wanted
            return parameters.count

        # The structural walker receives the currently live destructurable names. At the entry
        # of an inferred multi-subject function those names are exactly its enum parameters; a
        # shadowing declaration or pattern removes the name before any recursive edge is
        # inspected. Explicitly annotated single-subject functions do not use this helper.
        def proof_enum_parameter_names_from_parameters(parameters: darray[Ast::ParamDecl]&, destructurable: darray[sview]&) -> darray[sview]:
            result: mutable darray[sview] = []
            for parameter in parameters |result, destructurable|:
                result.push(parameter.name) if proof_structural_name_in(destructurable, parameter.name)
            return result

        def proof_structural_report_index(report: ProofReport&, wanted: sview) -> usize:
            for index in 0..<report.structural_names.count |index, report, wanted|:
                return index if report.structural_names[index] == wanted
            return report.structural_names.count

        def proof_structural_report_same_component(report: ProofReport&, left: usize, right: usize) -> bool:
            return false if left >= report.structural_component_ids.count or right >= report.structural_component_ids.count
            return report.structural_component_ids[left] == report.structural_component_ids[right]

        def proof_structural_termination_finding(report: mutable ProofReport&, line: u32, name: sview, message: sview) -> void:
            report.proof_obligation(false)
            proof_add_finding(report, "structural-decreases-unproven", line, name, message)

        # Once a structural function has a termination finding, arithmetic fallback on the same
        # recursive edge only creates duplicate diagnostics. It is still rejected by the
        # recorded structural obligation; this helper merely keeps the report focused and does
        # not authorize the edge as a summary.
        def proof_structural_report_failed(report: ProofReport&, wanted: sview) -> bool:
            for finding in report.findings:
                return true if finding.kind == "structural-decreases-unproven" and finding.name == wanted
            return false

        # Check every recursive edge in one structural function with its lexical match
        # environment. The environment is copied for each arm, so a binder from one branch can
        # never justify a call in a sibling or after the match. Mutual structural edges use the
        # callee's own decreasing-parameter position, but still require the same enum subject
        # type and a binder from the caller's matched strict subterms.
        def proof_structural_check_expression(expression: Ast::Expr, own_name: sview, subject_position: usize, parameters: darray[Ast::ParamDecl]&, destructurable: darray[sview]&, smaller: darray[ProofStructuralSmaller]&, report: mutable ProofReport&, name: sview) -> void:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    called_name: sview = proof_callable_name(callee)
                    own_index: usize = proof_structural_report_index(report, own_name)
                    called_index: usize = proof_structural_report_index(report, called_name)
                    direct_recursive: bool = called_name == own_name
                    mutual_recursive: bool = not direct_recursive and own_index < report.structural_names.count and called_index < report.structural_names.count and proof_structural_report_same_component(report, own_index, called_index) and own_index < report.structural_subject_types.count and called_index < report.structural_subject_types.count and report.structural_subject_types[own_index] != "" and report.structural_subject_types[own_index] == report.structural_subject_types[called_index]
                    if direct_recursive or mutual_recursive:
                        # When the ranking was inferred from an unannotated function with
                        # multiple enum parameters, use the sum of their constructor heights.
                        # Every subject must be passed unchanged or as a known strict subterm,
                        # and at least one subject must be strict. This is the only place where
                        # a multi-parameter product ranking is admitted; explicit `decreases`
                        # clauses retain their exact single-subject meaning.
                        if subject_position >= parameters.count and direct_recursive:
                            enum_subjects: darray[sview] = proof_enum_parameter_names_from_parameters(parameters, destructurable)
                            multi_valid: mutable bool = enum_subjects.count > 0
                            multi_strict: mutable bool = false
                            witnesses: mutable darray[ProofStructuralWitness] = []
                            for subject in enum_subjects |subject, arguments, argument_names, parameters, smaller, multi_valid, multi_strict, witnesses|:
                                subject_index: usize = proof_parameter_position(parameters, subject)
                                recursive_argument: Ast::Expr = proof_structural_call_argument(arguments, argument_names, parameters, subject_index)
                                recursive_name: sview = proof_ident_name(recursive_argument)
                                if proof_structural_argument_is_smaller_for_subject(recursive_argument, subject, smaller):
                                    multi_strict <- true
                                    argument_root: sview = proof_structural_argument_root(recursive_argument)
                                    witnesses.push(ProofStructuralWitness{subject: subject, argument: argument_root, strict: true}) if argument_root != ""
                                elif recursive_name != subject:
                                    multi_valid <- false
                                else:
                                    witnesses.push(ProofStructuralWitness{subject: subject, argument: subject, strict: false})
                            if multi_valid and multi_strict:
                                report.proof_obligation(true)
                                proof_add_structural_edge_attempt(report, own_name, called_name, witnesses, position.line)
                            else:
                                proof_structural_termination_finding(report, position.line, name, "recursive call must preserve or strictly descend every inferred enum subject")
                        else:
                            recursive_position: mutable usize = subject_position
                            recursive_position <- report.structural_subject_positions[called_index] if mutual_recursive and called_index < report.structural_subject_positions.count
                            recursive_argument: Ast::Expr = proof_structural_call_argument(arguments, argument_names, parameters, recursive_position)
                            recursive_name: sview = proof_ident_name(recursive_argument)
                            if proof_structural_argument_is_smaller(recursive_argument, smaller):
                                report.proof_obligation(true)
                                argument_root: sview = proof_structural_argument_root(recursive_argument)
                                witness_subject: mutable sview = proof_structural_argument_subject(recursive_argument, smaller)
                                witness_subject <- parameters[recursive_position].name if witness_subject == "" and recursive_position < parameters.count
                                witnesses: darray[ProofStructuralWitness] = [ProofStructuralWitness{subject: witness_subject, argument: argument_root, strict: true}]
                                proof_add_structural_edge_attempt(report, own_name, called_name, witnesses, position.line)
                            else:
                                proof_structural_termination_finding(report, position.line, name, "recursive call does not pass a binder from a matched strict subterm")
                    proof_structural_check_expression(callee, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    for argument in arguments |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(argument, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Paren(inner, _):
                    proof_structural_check_expression(inner, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Unary(_, operand, _):
                    proof_structural_check_expression(operand, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Binary(left, _, right, _):
                    proof_structural_check_expression(left, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    proof_structural_check_expression(right, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Field(object, _, _):
                    proof_structural_check_expression(object, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Scope(base, _, _):
                    proof_structural_check_expression(base, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Index(object, index, _):
                    proof_structural_check_expression(object, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    proof_structural_check_expression(index, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Slice(object, low, high, _):
                    proof_structural_check_expression(object, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    proof_structural_check_expression(low, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    proof_structural_check_expression(high, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_structural_check_expression(object, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    for argument in arguments |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(argument, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Move(operand, _):
                    proof_structural_check_expression(operand, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_structural_check_expression(operand, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Array(elements, _):
                    for element in elements |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(element, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(element, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(element, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(entry.key, own_name, subject_position, parameters, destructurable, smaller, report, name)
                        proof_structural_check_expression(entry.value, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(field.value, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_structural_check_expression(base, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    for field in fields |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(field.value, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    proof_structural_check_expression(condition, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    proof_structural_check_expression(then_expr, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    proof_structural_check_expression(else_expr, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Comprehension(variable, iterable, condition, body, _):
                    proof_structural_check_expression(iterable, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    comprehension_blocked: darray[sview] = [variable]
                    comprehension_destructurable: darray[sview] = proof_structural_without(destructurable, comprehension_blocked)
                    comprehension_smaller: darray[ProofStructuralSmaller] = proof_structural_smaller_without(smaller, comprehension_blocked)
                    proof_structural_check_expression(condition, own_name, subject_position, parameters, comprehension_destructurable, comprehension_smaller, report, name)
                    proof_structural_check_expression(body, own_name, subject_position, parameters, comprehension_destructurable, comprehension_smaller, report, name)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_structural_check_expression(base, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    proof_structural_check_expression(predicate, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.Match(scrutinee, arms, _):
                    proof_structural_check_expression(scrutinee, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    for arm in arms |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        arm_bindings: mutable darray[sview] = []
                        proof_structural_pattern_bindings(arm.pattern, &arm_bindings)
                        arm_destructurable: mutable darray[sview] = proof_structural_without(destructurable, arm_bindings)
                        arm_smaller: mutable darray[ProofStructuralSmaller] = proof_structural_smaller_without(smaller, arm_bindings)
                        scrutinee_name: sview = proof_ident_name(scrutinee)
                        if proof_structural_name_in(destructurable, scrutinee_name):
                            proof_structural_pattern_bindings(arm.pattern, &arm_destructurable)
                            proof_structural_pattern_subterms(arm.pattern, scrutinee_name, &arm_smaller)
                        proof_structural_check_expression(arm.guard, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name)
                        proof_structural_check_body(arm.body, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name)
                Ast::Expr.Catch(guarded, arms, _):
                    proof_structural_check_expression(guarded, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    for arm in arms |own_name, subject_position, parameters, destructurable, smaller, report, name|:
                        proof_structural_check_expression(arm.guard, own_name, subject_position, parameters, destructurable, smaller, report, name)
                        proof_structural_check_body(arm.body, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_structural_check_expression(guarded, own_name, subject_position, parameters, destructurable, smaller, report, name)
                    proof_structural_check_body(recovery, own_name, subject_position, parameters, destructurable, smaller, report, name)
                Ast::Expr.ShorthandMember(_, _):
                    # A leading-dot const-enum member is a closed value atom and cannot hide a
                    # recursive call or structural projection.
                    pass
                Ast::Expr.Block(statements, value, captures, _):
                    block_destructurable: darray[sview] = proof_copy_names(destructurable)
                    block_smaller: darray[ProofStructuralSmaller] = proof_copy_structural_smaller(smaller)
                    proof_structural_check_body(statements, own_name, subject_position, parameters, &block_destructurable, &block_smaller, report, name)
                    proof_structural_check_expression(value, own_name, subject_position, parameters, block_destructurable, block_smaller, report, name)
                    proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "captured value block is not structurally certified") if captures.count > 0 and proof_expr_has_call(expression) and proof_structural_captures_overlap(captures, block_smaller)
                Ast::Expr.Lambda(_, _, position):
                    proof_structural_termination_finding(report, position.line, name, "recursive calls inside a closure are not structurally certified")
                _:
                    proof_structural_termination_finding(report, Ast::expr_pos(expression).line, name, "unsupported expression may hide a structural recursive call") if proof_expr_has_call(expression)

        def proof_structural_check_body(body: darray[Ast::Stmt]&, own_name: sview, subject_position: usize, parameters: darray[Ast::ParamDecl]&, destructurable: darray[sview]&, smaller: darray[ProofStructuralSmaller]&, report: mutable ProofReport&, name: sview) -> void:
            current_destructurable: mutable darray[sview] = proof_copy_names(destructurable)
            current_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(smaller)
            for statement in body |own_name, subject_position, parameters, current_destructurable, current_smaller, report, name|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        proof_structural_check_expression(returned, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name) if value is returned
                    Ast::Stmt.Expr(expression, _):
                        proof_structural_check_expression(expression, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                    Ast::Stmt.VarDecl(local_name, _, initializer, _):
                        proof_structural_check_expression(initializer, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        blocked: darray[sview] = [local_name]
                        current_destructurable <- proof_structural_without(current_destructurable, blocked)
                        current_smaller <- proof_structural_smaller_without(current_smaller, blocked)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        proof_structural_check_expression(target, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        proof_structural_check_expression(initializer, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        blocked: darray[sview] = [proof_ident_name(target)]
                        current_destructurable <- proof_structural_without(current_destructurable, blocked)
                        current_smaller <- proof_structural_smaller_without(current_smaller, blocked)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_structural_check_expression(condition, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        then_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        then_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(then_body, own_name, subject_position, parameters, &then_destructurable, &then_smaller, report, name)
                        else_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        else_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(else_body, own_name, subject_position, parameters, &else_destructurable, &else_smaller, report, name)
                        current_destructurable <- proof_structural_intersect(then_destructurable, else_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(then_smaller, else_smaller)
                    Ast::Stmt.While(condition, while_body, _):
                        proof_structural_check_expression(condition, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        loop_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        loop_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        proof_structural_check_body(while_body, own_name, subject_position, parameters, &loop_destructurable, &loop_smaller, report, name)
                        current_destructurable <- proof_structural_intersect(current_destructurable, loop_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(current_smaller, loop_smaller)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        proof_structural_check_expression(iterable, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        loop_variables: mutable darray[sview] = []
                        match statement:
                            Ast::Stmt.For(_, variables, _, _, _):
                                loop_variables <- variables
                            _:
                                pass
                        loop_destructurable: mutable darray[sview] = proof_structural_without(current_destructurable, loop_variables)
                        loop_smaller: mutable darray[ProofStructuralSmaller] = proof_structural_smaller_without(current_smaller, loop_variables)
                        # Each element of a matched AST side-table is a strict subterm of the
                        # enclosing AST node. Promote loop variables only for an iterable already
                        # known to be such a subterm; ordinary user collections never enter this
                        # structural environment.
                        if proof_structural_argument_is_smaller(iterable, current_smaller):
                            for loop_variable in loop_variables |loop_variable, loop_smaller|:
                                loop_smaller.push(ProofStructuralSmaller{name: loop_variable, subject: proof_structural_argument_subject(iterable, current_smaller)}) if not any candidate in loop_smaller where candidate.name == loop_variable
                        proof_structural_check_body(for_body, own_name, subject_position, parameters, &loop_destructurable, &loop_smaller, report, name)
                        current_destructurable <- proof_structural_intersect(current_destructurable, loop_destructurable)
                        current_smaller <- proof_structural_smaller_intersect(current_smaller, loop_smaller)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        proof_structural_check_expression(scrutinee, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                        merged_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                        merged_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                        first_arm: mutable bool = true
                        for arm in arms |own_name, subject_position, parameters, current_destructurable, current_smaller, report, name, merged_destructurable, merged_smaller, first_arm|:
                            arm_bindings: mutable darray[sview] = []
                            proof_structural_pattern_bindings(arm.pattern, &arm_bindings)
                            arm_destructurable: mutable darray[sview] = proof_structural_without(current_destructurable, arm_bindings)
                            arm_smaller: mutable darray[ProofStructuralSmaller] = proof_structural_smaller_without(current_smaller, arm_bindings)
                            scrutinee_name: sview = proof_ident_name(scrutinee)
                            if proof_structural_name_in(current_destructurable, scrutinee_name):
                                proof_structural_pattern_bindings(arm.pattern, &arm_destructurable)
                                proof_structural_pattern_subterms(arm.pattern, scrutinee_name, &arm_smaller)
                            proof_structural_check_expression(arm.guard, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name)
                            proof_structural_check_body(arm.body, own_name, subject_position, parameters, arm_destructurable, arm_smaller, report, name)
                            arm_outer_destructurable: darray[sview] = proof_structural_intersect(current_destructurable, arm_destructurable)
                            arm_outer_smaller: darray[ProofStructuralSmaller] = proof_structural_smaller_intersect(current_smaller, arm_smaller)
                            if first_arm:
                                merged_destructurable <- arm_outer_destructurable
                                merged_smaller <- arm_outer_smaller
                                first_arm <- false
                            else:
                                merged_destructurable <- proof_structural_intersect(merged_destructurable, arm_outer_destructurable)
                                merged_smaller <- proof_structural_smaller_intersect(merged_smaller, arm_outer_smaller)
                        current_destructurable <- merged_destructurable if not first_arm
                        current_smaller <- merged_smaller if not first_arm
                    Ast::Stmt.Block(block_kind, _, _, block_body, _):
                        if block_kind == "assert_by" and block_body.count > 0:
                            match block_body[0]:
                                Ast::Stmt.Contract(_, goal, _):
                                    proof_structural_check_expression(goal, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name)
                                _:
                                    pass
                        if block_kind != "assert_by":
                            block_destructurable: mutable darray[sview] = proof_copy_names(current_destructurable)
                            block_smaller: mutable darray[ProofStructuralSmaller] = proof_copy_structural_smaller(current_smaller)
                            match statement:
                                Ast::Stmt.Block(_, _, binding, _, _):
                                    blocked: darray[sview] = [binding]
                                    block_destructurable <- proof_structural_without(block_destructurable, blocked) if binding != ""
                                    block_smaller <- proof_structural_smaller_without(block_smaller, blocked) if binding != ""
                                _:
                                    pass
                            proof_structural_check_body(block_body, own_name, subject_position, parameters, &block_destructurable, &block_smaller, report, name)
                            current_destructurable <- proof_structural_intersect(current_destructurable, block_destructurable)
                            current_smaller <- proof_structural_smaller_intersect(current_smaller, block_smaller)
                    Ast::Stmt.Contract(kind, expression, _):
                        proof_structural_check_expression(expression, own_name, subject_position, parameters, current_destructurable, current_smaller, report, name) if kind == "assert"
                    _:
                        pass

        def proof_check_structural_function(file: Ast::File&, function_name: sview, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], report: mutable ProofReport&) -> void:
            decreases_clauses: darray[Ast::Expr] = proof_contracts(body, "decreases")
            components: mutable darray[Ast::Expr] = []
            proof_decreases_component_slice(decreases_clauses, &components)
            inferred_structural: mutable bool = false
            if components.count == 0:
                inferred: (known: bool, parameter: sview, position: usize, type_name: sview) = proof_infer_structural_decrease(file, parameters)
                components.push(Ast::Expr.Ident(inferred.parameter, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})) if inferred.known
                inferred_structural <- inferred.known
            return if components.count != 1
            subject: sview = proof_ident_name(components[0])
            subject_position: mutable usize = proof_enum_parameter_position(file.top_decls, parameters, subject)
            return if subject_position >= parameters.count
            # A missing decreases clause on a function with several enum parameters denotes the
            # product ranking handled by the recursive-edge check above. Use the parameter-count
            # sentinel to select that mode without widening explicitly written rankings.
            enum_subjects: darray[sview] = proof_enum_parameter_names(file, parameters)
            subject_position <- parameters.count if inferred_structural and enum_subjects.count > 1
            destructurable: mutable darray[sview] = [subject]
            destructurable <- enum_subjects if subject_position >= parameters.count
            smaller: mutable darray[ProofStructuralSmaller] = []
            own_index: usize = proof_structural_report_index(report, function_name)
            has_mutual_structural_member: mutable bool = false
            if own_index < report.structural_names.count and own_index < report.structural_component_ids.count and own_index < report.structural_subject_types.count:
                for candidate in 0..<report.structural_names.count |candidate, report, own_index, has_mutual_structural_member|:
                    has_mutual_structural_member <- true if candidate != own_index and candidate < report.structural_members.count and report.structural_members[candidate] and proof_structural_report_same_component(report, own_index, candidate) and candidate < report.structural_subject_types.count and report.structural_subject_types[own_index] != "" and report.structural_subject_types[own_index] == report.structural_subject_types[candidate]
            finding_start: usize = report.findings.count
            proof_structural_check_body(body, function_name, subject_position, parameters, destructurable, smaller, report, function_name)
            structural_failed: mutable bool = false
            for finding_index in finding_start..<report.findings.count |finding_index, report, function_name, structural_failed|:
                structural_failed <- true if report.findings[finding_index].kind == "structural-decreases-unproven" and report.findings[finding_index].name == function_name
            if not structural_failed:
                report.structural_verified_names.push(function_name)

        def proof_check_structural_termination(file: Ast::File&, declarations: darray[Ast::Decl], functions: ProofFunctionTable&, report: mutable ProofReport&) -> void:
            # The structural checker is intentionally parameter-light because it recursively
            # walks many AST forms. Publish the immutable function-table metadata into the
            # report once so each call edge can identify a mutual SCC and the callee's decreasing
            # parameter without threading a second context object through every walker branch.
            report.structural_names.clear()
            report.structural_subject_positions.clear()
            report.structural_subject_types.clear()
            report.structural_component_ids.clear()
            report.structural_members.clear()
            # This routine recurses into nested modules/scopes. Keep the certificate names
            # accumulated by the outer invocation; clearing here would erase every function
            # verified before the last nested scope and force callers back onto arithmetic
            # recursion checks.
            for index in 0..<functions.names.count |index, functions, report|:
                report.structural_names.push(functions.names[index])
                report.structural_subject_positions.push(functions.structural_subject_positions[index] if index < functions.structural_subject_positions.count else functions.param_counts[index])
                report.structural_subject_types.push(functions.structural_subject_types[index] if index < functions.structural_subject_types.count else "")
                report.structural_members.push(functions.structural[index] if index < functions.structural.count else false)
                component: mutable usize = index
                for candidate in 0..<index |candidate, functions, index, component|:
                    if proof_functions_same_recursive_component(functions, index, candidate):
                        component <- candidate
                        break
                report.structural_component_ids.push(component)
            for declaration in declarations |file, functions, report|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, _):
                        function_index: usize = proof_function_index(functions, name)
                        proof_check_structural_function(file, name, parameters, body, report) if function_index < functions.structural.count and functions.structural[function_index]
                    Ast::Decl.Module(_, module_body, _):
                        proof_check_structural_termination(file, module_body, functions, report)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_check_structural_termination(file, scoped_body, functions, report)
                    _:
                        pass

        # Determine whether a function can reach a target in the collected executable call
        # graph. This is deliberately finite and name-based; ambiguous/unknown targets are not
        # treated as edges, while an unsupported expression marks its own function opaque below.
        def proof_function_reaches(functions: ProofFunctionTable&, source: usize, target: usize) -> bool:
            return false if source >= functions.names.count or target >= functions.names.count
            reachable: mutable darray[usize] = [source]
            cursor: mutable usize = 0
            while cursor < reachable.count |cursor, reachable, functions, target|:
                current: usize = reachable[cursor]
                # A malformed flat-table alignment must fail closed: if this node is the
                # queried target, do not let missing graph metadata turn a possible self-edge
                # into an admitted summary.
                return true if current == target and (current >= functions.call_starts.count or current >= functions.call_counts.count)
                return false if current >= functions.call_starts.count or current >= functions.call_counts.count
                start: usize = functions.call_starts[current]
                count: usize = functions.call_counts[current]
                for offset in 0..<count |offset, start, functions, reachable, target|:
                    return true if current == target and start + offset >= functions.all_calls.count
                    continue if start + offset >= functions.all_calls.count
                    called: sview = functions.all_calls[start + offset]
                    if called == "__opaque_call__":
                        return true if current == target
                    else:
                        next: usize = proof_function_index(functions, called)
                        if next < functions.names.count:
                            return true if next == target
                            already_seen: bool = proof_usize_seen(reachable, next)
                            reachable.push(next) if not already_seen
                cursor <- cursor + 1
            return false

        def proof_functions_same_recursive_component(functions: ProofFunctionTable&, source: usize, target: usize) -> bool:
            return false if source >= functions.names.count or target >= functions.names.count
            return true if source == target
            return false if source >= functions.recursive.count or target >= functions.recursive.count
            return false if not functions.recursive[source] or not functions.recursive[target]
            if source < functions.recursive_component_ids.count and target < functions.recursive_component_ids.count:
                return functions.recursive_component_ids[source] == functions.recursive_component_ids[target]
            return proof_function_reaches(functions, source, target) and proof_function_reaches(functions, target, source)

        # Compute executable SCCs with iterative Kosaraju traversal. Summary scheduling and
        # structural recursion then use the stable component ids instead of re-running a full
        # transitive reachability search for every pair of functions.
        def proof_build_function_components(functions: mutable ProofFunctionTable&) -> void:
            count: usize = functions.names.count
            functions.recursive.clear()
            functions.recursive_component_ids.clear()
            return if count == 0
            reverse_counts: mutable darray[usize] = []
            reverse_counts.resize(count)
            self_edges: mutable darray[bool] = []
            self_edges.resize(count)
            for source in 0..<count |source, functions, reverse_counts, self_edges|:
                start: usize = functions.call_starts[source] if source < functions.call_starts.count else functions.all_calls.count
                edge_count: usize = functions.call_counts[source] if source < functions.call_counts.count else 0
                valid_range: bool = start <= functions.all_calls.count and edge_count <= functions.all_calls.count - start
                continue if not valid_range
                for offset in 0..<edge_count |offset, source, start, functions, reverse_counts, self_edges|:
                    called: sview = functions.all_calls[start + offset]
                    next: usize = proof_function_index(functions, called)
                    continue if next >= count
                    reverse_counts[next] <- reverse_counts[next] + 1
                    self_edges[source] <- true if next == source
            reverse_starts: mutable darray[usize] = []
            reverse_cursor: mutable usize = 0
            for incoming in reverse_counts |reverse_starts, reverse_cursor|:
                reverse_starts.push(reverse_cursor)
                reverse_cursor <- reverse_cursor + incoming
            reverse_edges: mutable darray[usize] = []
            reverse_edges.resize(reverse_cursor)
            reverse_write: mutable darray[usize] = []
            reverse_write.extend(reverse_starts)
            for source in 0..<count |source, functions, reverse_write, reverse_edges|:
                start: usize = functions.call_starts[source] if source < functions.call_starts.count else functions.all_calls.count
                edge_count: usize = functions.call_counts[source] if source < functions.call_counts.count else 0
                valid_range: bool = start <= functions.all_calls.count and edge_count <= functions.all_calls.count - start
                continue if not valid_range
                for offset in 0..<edge_count |offset, source, start, functions, reverse_write, reverse_edges|:
                    next: usize = proof_function_index(functions, functions.all_calls[start + offset])
                    continue if next >= count
                    slot: usize = reverse_write[next]
                    reverse_edges[slot] <- source
                    reverse_write[next] <- slot + 1
            visited: mutable darray[bool] = []
            visited.resize(count)
            order: mutable darray[usize] = []
            for source in 0..<count |source, visited, order, functions|:
                continue if visited[source]
                stack_nodes: mutable darray[usize] = [source]
                stack_offsets: mutable darray[usize] = [0]
                visited[source] <- true
                while stack_nodes.count > 0 |stack_nodes, stack_offsets, visited, order, functions|:
                    top: usize = stack_nodes.count - 1
                    current: usize = stack_nodes[top]
                    start: usize = functions.call_starts[current] if current < functions.call_starts.count else functions.all_calls.count
                    edge_count: usize = functions.call_counts[current] if current < functions.call_counts.count else 0
                    valid_range: bool = start <= functions.all_calls.count and edge_count <= functions.all_calls.count - start
                    if valid_range and stack_offsets[top] < edge_count:
                        offset: usize = stack_offsets[top]
                        stack_offsets[top] <- offset + 1
                        next: usize = proof_function_index(functions, functions.all_calls[start + offset])
                        if next < count and not visited[next]:
                            visited[next] <- true
                            stack_nodes.push(next)
                            stack_offsets.push(0)
                    else:
                        order.push(current)
                        stack_nodes <- stack_nodes.truncate(top)
                        stack_offsets <- stack_offsets.truncate(top)
            component_ids: mutable darray[usize] = []
            component_ids.resize(count)
            for index in 0..<count |index, component_ids|:
                component_ids[index] <- count
            for order_index in 0..<order.count |order_index, order, component_ids, reverse_starts, reverse_counts, reverse_edges, count|:
                seed: usize = order[order.count - 1 - order_index]
                continue if component_ids[seed] < count
                component_ids[seed] <- seed
                component_work: mutable darray[usize] = [seed]
                while component_work.count > 0 |component_work, component_ids, reverse_starts, reverse_counts, reverse_edges, count|:
                    current: usize = component_work[component_work.count - 1]
                    component_work <- component_work.truncate(component_work.count - 1)
                    start: usize = reverse_starts[current]
                    edge_count: usize = reverse_counts[current]
                    for offset in 0..<edge_count |offset, start, reverse_edges, component_ids, component_work, current|:
                        predecessor: usize = reverse_edges[start + offset]
                        if component_ids[predecessor] == count:
                            component_ids[predecessor] <- seed
                            component_work.push(predecessor)
            component_sizes: mutable darray[usize] = []
            component_sizes.resize(count)
            for index in 0..<count |index, component_ids, component_sizes, count|:
                component_sizes[component_ids[index]] <- component_sizes[component_ids[index]] + 1
            for index in 0..<count |index, component_ids, component_sizes, self_edges, functions|:
                functions.recursive_component_ids.push(component_ids[index])
                functions.recursive.push(component_sizes[component_ids[index]] > 1 or self_edges[index])

        # Syntactic purity is intentionally a small total-function tier. It admits straight-line
        # value computation and pure conditionals, but no loops, assignments, hidden block scope,
        # runtime assertions, or ownership/region effects. Calls are allowed only after the
        # declaration-independent fixed point below proves every reachable callee pure.
        def proof_pure_expression_shape(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.FloatLit(_):
                    return true
                Ast::Expr.StringLit(_):
                    return true
                Ast::Expr.CharLit(_):
                    return true
                Ast::Expr.BoolLit(_):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_pure_expression_shape(callee)
                    for argument in arguments:
                        return false if not proof_pure_expression_shape(argument)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_pure_expression_shape(inner)
                Ast::Expr.Unary(_, operand, _):
                    return proof_pure_expression_shape(operand)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_pure_expression_shape(left) and proof_pure_expression_shape(right)
                Ast::Expr.Field(object, _, _):
                    return proof_pure_expression_shape(object)
                Ast::Expr.Scope(base, _, _):
                    return proof_pure_expression_shape(base)
                Ast::Expr.Index(object, index, _):
                    return proof_pure_expression_shape(object) and proof_pure_expression_shape(index)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_pure_expression_shape(object) and proof_pure_expression_shape(low) and proof_pure_expression_shape(high)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_pure_expression_shape(object)
                    for argument in arguments:
                        return false if not proof_pure_expression_shape(argument)
                    return true
                Ast::Expr.Move(_, _):
                    return false
                Ast::Expr.RegionNew(_, _, _):
                    return false
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return false if not proof_pure_expression_shape(element)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return false if not proof_pure_expression_shape(element)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return false if not proof_pure_expression_shape(element)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return false if not proof_pure_expression_shape(entry.key) or not proof_pure_expression_shape(entry.value)
                    return true
                Ast::Expr.Construct(type_expression, fields, _):
                    return false if not proof_pure_expression_shape(type_expression)
                    for field in fields:
                        return false if not proof_pure_expression_shape(field.value)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_pure_expression_shape(base)
                    for field in fields:
                        return false if not proof_pure_expression_shape(field.value)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_pure_expression_shape(condition) and proof_pure_expression_shape(then_expr) and proof_pure_expression_shape(else_expr)
                Ast::Expr.Match(_, _, _):
                    # The proof-safe value-match subset is lowered to a pure decision tree by
                    # proof_expr_supported; using that same gate here keeps pure-summary
                    # discovery aligned with the expression certificate boundary.
                    return proof_expr_supported(expression)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_pure_expression_shape(iterable) and proof_pure_expression_shape(condition) and proof_pure_expression_shape(body)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_pure_expression_shape(base) and proof_pure_expression_shape(predicate)
                Ast::Expr.Block(_, _, _, _):
                    # Even a currently supported value block has a separate local scope and
                    # can acquire hidden write-back semantics as the language evolves.
                    return false
                _:
                    return false

        # The parser stores canonical `x: mutable T` in the type expression; the separate
        # ParamDecl bit is only populated for the legacy leading `mutable x: T` spelling.
        # Mirror the compiler's recursive type mutability rule so both spellings affect purity.
        def proof_parameter_type_is_mutable(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    return proof_parameter_type_is_mutable(operand)
                Ast::Expr.Binary(left, _, _, _):
                    return proof_parameter_type_is_mutable(left)
                Ast::Expr.Paren(inner, _):
                    return proof_parameter_type_is_mutable(inner)
                Ast::Expr.Refinement(base, _, _):
                    return proof_parameter_type_is_mutable(base)
                _:
                    return false

        def proof_expr_mentions_any_global(expression: Ast::Expr, mutable_globals: darray[sview]&) -> bool:
            for global_name in mutable_globals:
                return true if proof_expr_mentions_name(expression, global_name)
            return false

        # A total pure summary cannot observe mutable ambient state. The compiler parser records
        # `global mutable` declarations in its annotation side table; reject those names in every
        # expression of the candidate body/defaults. Name collisions with a local are rejected
        # conservatively because this kernel does not carry binding identities through the AST.
        def proof_pure_body_reads_mutable_global(body: darray[Ast::Stmt]&, mutable_globals: darray[sview]&) -> bool:
            for statement in body:
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return true if proof_expr_mentions_any_global(returned, mutable_globals)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_expr_mentions_any_global(expression, mutable_globals)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_expr_mentions_any_global(initializer, mutable_globals)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_expr_mentions_any_global(condition, mutable_globals) or proof_pure_body_reads_mutable_global(then_body, mutable_globals) or proof_pure_body_reads_mutable_global(else_body, mutable_globals)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_expr_mentions_any_global(expression, mutable_globals)
                    _:
                        return true
            return false

        def proof_pure_body_direct(body: darray[Ast::Stmt]&) -> bool:
            for statement in body:
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return false if not proof_expr_supported(returned)
                            return false if not proof_pure_expression_shape(returned)
                    Ast::Stmt.Expr(expression, _):
                        return false if not proof_expr_supported(expression)
                        return false if not proof_pure_expression_shape(expression)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return false if not proof_expr_supported(initializer)
                        return false if not proof_pure_expression_shape(initializer)
                    Ast::Stmt.Assign(_, _, _, _):
                        return false
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return false if not proof_expr_supported(condition)
                        return false if not proof_pure_expression_shape(condition)
                        return false if not proof_pure_body_direct(then_body) or not proof_pure_body_direct(else_body)
                    Ast::Stmt.While(_, _, _):
                        return false
                    Ast::Stmt.For(_, _, _, _, _):
                        return false
                    Ast::Stmt.Match(_, _, _):
                        return false
                    Ast::Stmt.Block(_, _, _, _, _):
                        return false
                    Ast::Stmt.Contract(kind, expression, _):
                        return false if kind != "requires" and kind != "ensure" and kind != "decreases" and kind != "decreases*"
                        return false if proof_expr_has_old(expression) or proof_expr_has_call(expression) or not proof_expr_supported(expression)
                    Ast::Stmt.Break(_, _):
                        return false
                    Ast::Stmt.Continue(_, _):
                        return false
                    Ast::Stmt.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_function_is_directly_pure(functions: ProofFunctionTable&, function_index: usize, parameters: darray[Ast::ParamDecl]&, effects: darray[sview]&, body: darray[Ast::Stmt]&, mutable_globals: darray[sview]&) -> bool:
            return false if function_index >= functions.param_starts.count or function_index >= functions.param_counts.count
            return false if function_index >= functions.requires_counts.count or function_index >= functions.changes_counts.count or function_index >= functions.preserves_counts.count
            return false if functions.requires_counts[function_index] > 0 or functions.changes_counts[function_index] > 0 or functions.preserves_counts[function_index] > 0
            return false if effects.count > 0
            param_start: usize = functions.param_starts[function_index]
            return false if function_index >= functions.param_counts.count or functions.param_counts[function_index] != parameters.count
            for parameter_index in 0..<parameters.count |parameter_index, functions, param_start|:
                slot: usize = param_start + parameter_index
                return false if slot >= functions.all_parameter_mutable.count or functions.all_parameter_mutable[slot] or parameter_index >= parameters.count or parameters[parameter_index].is_mutable or proof_parameter_type_is_mutable(parameters[parameter_index].type_expression)
                if parameters[parameter_index].has_default:
                    # Defaults execute when the argument is omitted. Their call edges are added
                    # to the same fixed-point graph as body calls, so only verified pure calls
                    # can participate in a pure function's default computation.
                    return false if not proof_expr_supported(parameters[parameter_index].default_value)
                    return false if not proof_pure_expression_shape(parameters[parameter_index].default_value)
                    return false if proof_expr_has_old(parameters[parameter_index].default_value)
                    return false if proof_expr_mentions_any_global(parameters[parameter_index].default_value, mutable_globals)
            return false if proof_pure_body_reads_mutable_global(body, mutable_globals)
            return proof_pure_body_direct(body)

        def proof_recursive_purity_eligible(functions: ProofFunctionTable&, function_index: usize) -> bool:
            return false if function_index >= functions.recursive.count or not functions.recursive[function_index]
            return false if function_index >= functions.decreases_counts.count or function_index >= functions.decreases_unbounded.count or function_index >= functions.decreases_starts.count
            return false if functions.decreases_counts[function_index] == 0 or functions.decreases_unbounded[function_index]
            return proof_decreases_range_valid(functions.decreases_starts[function_index], functions.decreases_counts[function_index], functions.all_decreases.count)

        # Recursive purity is a component certificate, not a per-edge shortcut. In particular,
        # one locally pure member must not become pure by pointing at another member whose body
        # reaches an unknown or effectful function. Inspect every member and every outgoing edge
        # together before allowing any recursive summary edge in the fixed point.
        def proof_recursive_component_is_pure_candidate(functions: ProofFunctionTable&, source: usize) -> bool:
            return false if source >= functions.names.count
            member_index: mutable usize = 0
            while member_index < functions.names.count |member_index, functions, source|:
                if proof_functions_same_recursive_component(functions, source, member_index):
                    return false if member_index >= functions.direct_pure.count or not functions.direct_pure[member_index]
                    return false if not proof_recursive_purity_eligible(functions, member_index)
                    return false if member_index >= functions.call_starts.count or member_index >= functions.call_counts.count
                    member_start: usize = functions.call_starts[member_index]
                    member_count: usize = functions.call_counts[member_index]
                    return false if member_start > functions.all_calls.count or member_count > functions.all_calls.count - member_start
                    for call_offset in 0..<member_count |call_offset, member_start, functions, source|:
                        called: sview = functions.all_calls[member_start + call_offset]
                        return false if called == "__opaque_call__"
                        called_index: usize = proof_function_index(functions, called)
                        return false if called_index >= functions.names.count
                        if not proof_functions_same_recursive_component(functions, source, called_index):
                            return false if called_index >= functions.pure.count or not functions.pure[called_index]
                member_index <- member_index + 1
            return true

        # A recursive pure function may use calls within its own SCC as total values only when
        # every recursive member has an explicit bounded decreases tuple and a declaration-local
        # purity certificate. The ordinary call checker still proves each edge's nonnegativity
        # and strict descent while checking the bodies; this helper only opens the summary fixed
        # point for that already-certified recursive component.
        def proof_function_calls_are_pure(functions: ProofFunctionTable&, function_index: usize, allow_recursive_component: bool) -> bool:
            return false if function_index >= functions.call_starts.count or function_index >= functions.call_counts.count
            start: usize = functions.call_starts[function_index]
            count: usize = functions.call_counts[function_index]
            return false if start > functions.all_calls.count or count > functions.all_calls.count - start
            for offset in 0..<count |offset, start, functions, function_index, allow_recursive_component|:
                called: sview = functions.all_calls[start + offset]
                called_index: usize = proof_function_index(functions, called)
                return false if called == "__opaque_call__"
                continue if called_index < functions.pure.count and functions.pure[called_index]
                recursive_member: bool = allow_recursive_component and called_index < functions.recursive.count and functions.recursive[called_index] and proof_functions_same_recursive_component(functions, function_index, called_index)
                continue if recursive_member and proof_recursive_component_is_pure_candidate(functions, function_index)
                return false
            return true

        # Compute declaration-local purity before the call-graph fixed point. This pass must cover
        # the complete table first: otherwise a mutually recursive pair would be classified based
        # on declaration order rather than on the properties of the entire component.
        def proof_mark_direct_pure_functions_pass(file: Ast::File&, declarations: darray[Ast::Decl], functions: mutable ProofFunctionTable&, cursor: mutable usize&, mutable_globals: darray[sview]&) -> void:
            for declaration in declarations |file, functions, cursor, mutable_globals|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, effects, _, _):
                        # The executable table already excludes lemmas. Resolve the declaration
                        # through that indexed table instead of rescanning every annotation.
                        continue if proof_function_index(functions, name) >= functions.names.count
                        function_index: usize = cursor
                        cursor <- cursor + 1
                        if function_index < functions.direct_pure.count:
                            functions.direct_pure[function_index] <- proof_function_is_directly_pure(functions, function_index, parameters, effects, body, mutable_globals)
                    Ast::Decl.Module(_, module_body, _):
                        proof_mark_direct_pure_functions_pass(file, module_body, functions, cursor, mutable_globals)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_mark_direct_pure_functions_pass(file, scoped_body, functions, cursor, mutable_globals)
                    _:
                        pass

        # Populate purity after the complete function table exists. The fixed point admits an
        # acyclic chain of pure calls, plus recursive SCCs whose ordinary body checker will prove
        # bounded decreases on every edge.
        def proof_mark_pure_functions_pass(file: Ast::File&, declarations: darray[Ast::Decl], functions: mutable ProofFunctionTable&, cursor: mutable usize&, changed: mutable bool&) -> void:
            for declaration in declarations |file, functions, cursor, changed|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, effects, _, _):
                        # The executable table already excludes lemmas. Resolve the declaration
                        # through that indexed table instead of rescanning every annotation.
                        continue if proof_function_index(functions, name) >= functions.names.count
                        function_index: usize = cursor
                        cursor <- cursor + 1
                        candidate: mutable bool = function_index < functions.direct_pure.count and functions.direct_pure[function_index]
                        recursive_allowed: bool = proof_recursive_purity_eligible(functions, function_index)
                        candidate <- false if function_index < functions.recursive.count and functions.recursive[function_index] and not recursive_allowed
                        candidate <- false if not proof_function_calls_are_pure(functions, function_index, recursive_allowed)
                        if candidate and function_index < functions.pure.count and not functions.pure[function_index]:
                            functions.pure[function_index] <- true
                            changed <- true
                    Ast::Decl.Module(_, module_body, _):
                        proof_mark_pure_functions_pass(file, module_body, functions, cursor, changed)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_mark_pure_functions_pass(file, scoped_body, functions, cursor, changed)
                    _:
                        pass

        def proof_mark_pure_functions(file: Ast::File&, declarations: darray[Ast::Decl], functions: mutable ProofFunctionTable&) -> void:
            functions.direct_pure.clear()
            for _ in 0..<functions.names.count |functions|:
                functions.direct_pure.push(false)
            mutable_global_names: mutable darray[sview] = []
            for annotation in file.enum_annotations |mutable_global_names|:
                if annotation.name == "__global_mutable" and not (any existing in mutable_global_names where existing == annotation.owner):
                    mutable_global_names.push(annotation.owner)
            direct_cursor: mutable usize = 0
            proof_mark_direct_pure_functions_pass(file, declarations, functions, direct_cursor, mutable_global_names)
            functions.pure.clear()
            for _ in 0..<functions.names.count |functions|:
                functions.pure.push(false)
            changed: mutable bool = true
            pass_index: mutable usize = 0
            while changed and pass_index <= functions.names.count |functions, declarations, changed, pass_index|:
                changed <- false
                cursor: mutable usize = 0
                proof_mark_pure_functions_pass(file, declarations, functions, cursor, changed)
                pass_index <- pass_index + 1

        # Runtime calls may materialize a default that invokes a verified pure function. This is
        # separate from the lemma mapper because erased lemma defaults remain intentionally
        # call-free. Evaluation is left-to-right: every missing formal can depend only on earlier
        # formals, and the resolved default must contain no unresolved formal or old-state read.
        def proof_map_runtime_call_arguments(parameters: darray[sview]&, has_defaults: darray[bool]&, defaults: darray[Ast::Expr]&, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&) -> bool:
            mapped.clear()
            return false if argument_names.count != 0 and argument_names.count != arguments.count
            used: mutable darray[bool] = []
            for parameter in parameters |mapped, used|:
                mapped.push(Ast::Expr.Absent)
                used.push(false)
            saw_named: mutable bool = false
            next_positional: mutable usize = 0
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, parameters, mapped, used, saw_named, next_positional|:
                label: sview = argument_names[argument_index] if argument_names.count == arguments.count else ""
                parameter_index: mutable usize = parameters.count
                if label == "":
                    return false if saw_named
                    while next_positional < parameters.count and used[next_positional] |next_positional, used, parameters|:
                        next_positional <- next_positional + 1
                    return false if next_positional >= parameters.count
                    parameter_index <- next_positional
                    next_positional <- next_positional + 1
                else:
                    saw_named <- true
                    parameter_index <- proof_parameter_index(parameters, label)
                    return false if parameter_index >= parameters.count
                return false if used[parameter_index]
                mapped[parameter_index] <- arguments[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameters.count |parameter_index, used, parameters, has_defaults, defaults, mapped, functions|:
                if not used[parameter_index]:
                    return false if parameter_index >= has_defaults.count or parameter_index >= defaults.count or not has_defaults[parameter_index]
                    default_expression: Ast::Expr = defaults[parameter_index]
                    return false if not proof_expr_supported(default_expression) or proof_expr_has_old(default_expression)
                    if parameter_index + 1 < parameters.count:
                        for later_index in parameter_index + 1..<parameters.count |later_index, parameters, default_expression|:
                            return false if proof_expr_mentions_name(default_expression, parameters[later_index])
                    resolved_default: Ast::Expr = proof_substitute(default_expression, parameters, mapped)
                    return false if not proof_expr_supported(resolved_default) or proof_expr_has_old(resolved_default)
                    return false if proof_expr_has_call(resolved_default) and not proof_contract_calls_are_pure(resolved_default, functions)
                    mapped[parameter_index] <- resolved_default
                    used[parameter_index] <- true
            return true

        # Collect executable function contracts for modular call checking. The callee's
        # contract is the only fact an ordinary call may contribute; its body is checked in the
        # same report, so an invalid summary still makes the whole command fail.
        def proof_collect_functions(file: Ast::File&, declarations: darray[Ast::Decl], lemmas: ProofLemmaTable&, functions: mutable ProofFunctionTable&) -> void:
            for declaration in declarations |file, lemmas, functions|:
                match declaration:
                    Ast::Decl.Func(name, parameters, return_type, body, declared_effects, _, position):
                        # Lemmas are erased proof declarations, never executable summaries.
                        # Keeping them out of this table prevents a runtime assignment or
                        # return from manufacturing facts through a proof-only call.
                        continue if proof_lemma_index(lemmas, name) < lemmas.names.count
                        functions.names <- functions.names.push(name)
                        functions.name_hashes <- functions.name_hashes.push(proof_name_hash(name))
                        functions.param_starts <- functions.param_starts.push(functions.all_params.count)
                        functions.param_counts <- functions.param_counts.push(parameters.count)
                        functions.region_param_starts <- functions.region_param_starts.push(functions.all_region_params.count)
                        region_parameter_count: mutable usize = 0
                        for annotation in file.local_region_annotations |functions, region_parameter_count|:
                            if annotation.name == "__region_param" and annotation.line == position.line:
                                functions.all_region_params <- functions.all_region_params.push(annotation.region)
                                region_parameter_count <- region_parameter_count + 1
                        functions.region_param_counts <- functions.region_param_counts.push(region_parameter_count)
                        functions.all_param_region_starts <- functions.all_param_region_starts.push(functions.all_param_regions.count)
                        for parameter in parameters |functions|:
                            functions.all_params <- functions.all_params.push(parameter.name)
                            functions.all_parameter_references <- functions.all_parameter_references.push(proof_resource_is_reference_type(parameter.type_expression))
                            functions.all_parameter_mutable_references <- functions.all_parameter_mutable_references.push(proof_resource_is_mutable_reference_type(parameter.type_expression))
                            functions.all_parameter_mutable <- functions.all_parameter_mutable.push(parameter.is_mutable)
                            functions.all_has_defaults <- functions.all_has_defaults.push(parameter.has_default)
                            functions.all_defaults <- functions.all_defaults.push(parameter.default_value)
                            parameter_region: mutable sview = ""
                            for annotation in file.local_region_annotations |parameter, position, parameter_region|:
                                parameter_region <- annotation.region if annotation.name == parameter.name and annotation.line == position.line
                            functions.all_param_regions <- functions.all_param_regions.push(parameter_region)
                        if return_type is declared_return_type:
                            functions.return_scalar <- functions.return_scalar.push(proof_scalar_type_kind(declared_return_type, declarations, 0) == 1)
                            functions.return_references <- functions.return_references.push(proof_resource_is_reference_type(declared_return_type))
                            functions.return_mutable_references <- functions.return_mutable_references.push(proof_resource_is_mutable_reference_type(declared_return_type))
                            functions.return_reference_parameters <- functions.return_reference_parameters.push(proof_resource_reference_return_parameter(parameters, return_type, body))
                        else:
                            functions.return_scalar <- functions.return_scalar.push(false)
                            functions.return_references <- functions.return_references.push(false)
                            functions.return_mutable_references <- functions.return_mutable_references.push(false)
                            functions.return_reference_parameters <- functions.return_reference_parameters.push(parameters.count)
                        return_region: mutable sview = ""
                        for annotation in file.local_region_annotations |position, return_region|:
                            return_region <- annotation.region if annotation.name == "__region_return" and annotation.line == position.line
                        functions.return_regions <- functions.return_regions.push(return_region)
                        functions.effect_starts <- functions.effect_starts.push(functions.all_effects.count)
                        functions.effect_counts <- functions.effect_counts.push(declared_effects.count)
                        functions.effects_declared <- functions.effects_declared.push(declared_effects.count > 0)
                        for effect in declared_effects |functions|:
                            functions.all_effects <- functions.all_effects.push(effect)
                        functions.call_starts <- functions.call_starts.push(functions.all_calls.count)
                        call_names: mutable darray[sview] = []
                        proof_collect_body_call_names(body, &call_names)
                        for parameter in parameters |call_names|:
                            proof_collect_call_names(parameter.default_value, &call_names) if parameter.has_default
                        for called in call_names |functions|:
                            functions.all_calls <- functions.all_calls.push(called)
                        functions.call_counts <- functions.call_counts.push(call_names.count)
                        functions.requires_starts <- functions.requires_starts.push(functions.all_requires.count)
                        functions.ensure_starts <- functions.ensure_starts.push(functions.all_ensures.count)
                        functions.changes_starts <- functions.changes_starts.push(functions.all_changes.count)
                        functions.preserves_starts <- functions.preserves_starts.push(functions.all_preserves.count)
                        functions.decreases_starts <- functions.decreases_starts.push(functions.all_decreases.count)
                        decreases_components: mutable darray[Ast::Expr] = []
                        has_unbounded_decreases: mutable bool = false
                        for statement in body |functions, decreases_components, has_unbounded_decreases|:
                            match statement:
                                Ast::Stmt.Contract(kind, expression, _):
                                    if kind == "decreases":
                                        proof_decreases_components(expression, &decreases_components)
                                    if kind == "decreases*":
                                        has_unbounded_decreases <- true
                                _:
                                    pass
                        if decreases_components.count == 0 and not has_unbounded_decreases:
                            inferred: (known: bool, parameter: sview, position: usize, type_name: sview) = proof_infer_structural_decrease(file, parameters)
                            if inferred.known:
                                decreases_components.push(Ast::Expr.Ident(inferred.parameter, position))
                        functions.all_decreases.extend(decreases_components)
                        functions.decreases_counts <- functions.decreases_counts.push(decreases_components.count)
                        functions.decreases_unbounded <- functions.decreases_unbounded.push(has_unbounded_decreases)
                        structural_measure: mutable bool = false
                        structural_subject_position: mutable usize = parameters.count
                        structural_subject_type: mutable sview = ""
                        if decreases_components.count == 1:
                            structural_subject: sview = proof_ident_name(decreases_components[0])
                            structural_subject_position <- proof_enum_parameter_position(file.top_decls, parameters, structural_subject)
                            structural_measure <- structural_subject_position < parameters.count
                            structural_subject_type <- proof_callable_name(parameters[structural_subject_position].type_expression) if structural_measure
                        functions.structural <- functions.structural.push(structural_measure)
                        functions.structural_subject_positions <- functions.structural_subject_positions.push(structural_subject_position)
                        functions.structural_subject_types <- functions.structural_subject_types.push(structural_subject_type)
                        requires_count: mutable usize = 0
                        ensures_count: mutable usize = 0
                        for statement in body |functions, requires_count, ensures_count|:
                            match statement:
                                Ast::Stmt.Contract(kind, expression, _):
                                    if kind == "requires":
                                        functions.all_requires <- functions.all_requires.push(expression)
                                        requires_count <- requires_count + 1
                                    if kind == "ensure":
                                        functions.all_ensures <- functions.all_ensures.push(expression)
                                        ensures_count <- ensures_count + 1
                                _:
                                    pass
                        signature_requires: darray[Ast::Expr] = proof_signature_contracts(file, position.line, "requires")
                        signature_ensures: darray[Ast::Expr] = proof_signature_contracts(file, position.line, "ensure")
                        functions.all_requires.extend(signature_requires)
                        functions.all_ensures.extend(signature_ensures)
                        requires_count <- requires_count + signature_requires.count
                        ensures_count <- ensures_count + signature_ensures.count
                        functions.requires_counts <- functions.requires_counts.push(requires_count)
                        functions.ensure_counts <- functions.ensure_counts.push(ensures_count)
                        changes_before: usize = functions.all_changes.count
                        preserves_before: usize = functions.all_preserves.count
                        for statement in body |functions|:
                            match statement:
                                Ast::Stmt.Contract(contract_kind, expression, _):
                                    decoded: (known: bool, place: ProofFramePlace) = proof_frame_place(expression)
                                    functions.all_changes <- functions.all_changes.push(decoded.place) if contract_kind == "changes" and decoded.known
                                    functions.all_preserves <- functions.all_preserves.push(decoded.place) if contract_kind == "preserves" and decoded.known
                                _:
                                    pass
                        proof_frame_collect_annotations(file, name, &functions.all_changes, &functions.all_preserves)
                        functions.changes_counts <- functions.changes_counts.push(functions.all_changes.count - changes_before)
                        functions.preserves_counts <- functions.preserves_counts.push(functions.all_preserves.count - preserves_before)
                    Ast::Decl.Module(_, module_body, _):
                        proof_collect_functions(file, module_body, lemmas, functions)
                    Ast::Decl.Scoped(scoped_body, _):
                        proof_collect_functions(file, scoped_body, lemmas, functions)
                    _:
                        pass

        # Apply an executable call summary. An explicit, checked `changes` frame allows facts
        # about disjoint places to survive; an unframed or lossy summary clears them. The caller's
        # own frame and preserves clauses are checked at the same boundary, so modular proofs
        # cannot smuggle an out-of-frame write through an opaque call. A summary edge inside a
        # recursive component is exceptional: it is available only after both functions provide
        # checked decreases measures, with the callee measure nonnegative and strictly smaller.
        # `result_value` is `Absent` for a statement call and the call expression for an assigned
        # or returned value.
        def proof_apply_function(expression: Ast::Expr, result_value: Ast::Expr, facts: mutable darray[Ast::Expr]&, functions: ProofFunctionTable&, caller_names: darray[sview]&, caller_parameters: darray[sview]&, caller_changes: darray[ProofFramePlace]&, caller_preserves: darray[ProofFramePlace]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    function_name: sview = proof_callable_name(callee)
                    function_index: usize = proof_function_index(functions, function_name)
                    return false if function_name == "" or function_index >= functions.names.count
                    if function_index >= functions.verified.count or not functions.verified[function_index]:
                        report.proof_obligation(false)
                        proof_add_finding(report, "function-summary-unverified", position.line, name, "callee body has not established a verified executable summary")
                        return false
                    return false if function_index >= functions.param_counts.count or arguments.count > functions.param_counts[function_index]
                    parameter_names: mutable darray[sview] = []
                    argument_values: mutable darray[Ast::Expr] = []
                    param_start: usize = functions.param_starts[function_index]
                    for argument_index in 0..<functions.param_counts[function_index] |parameter_names, functions, param_start|:
                        parameter_names.push(functions.all_params[param_start + argument_index])
                    mapped_arguments: mutable darray[Ast::Expr] = []
                    default_start: usize = functions.param_starts[function_index]
                    default_flags: mutable darray[bool] = []
                    default_values: mutable darray[Ast::Expr] = []
                    for parameter_index in 0..<functions.param_counts[function_index] |default_flags, default_values, functions, default_start|:
                        default_flags.push(functions.all_has_defaults[default_start + parameter_index])
                        default_values.push(functions.all_defaults[default_start + parameter_index])
                    return false if not proof_map_runtime_call_arguments(parameter_names, default_flags, default_values, arguments, argument_names, &mapped_arguments, functions)
                    argument_values.extend(mapped_arguments)
                    requires_ok: mutable bool = true
                    require_goal_ids: mutable darray[usize] = []
                    requires_start: usize = functions.requires_starts[function_index]
                    requires_count: usize = functions.requires_counts[function_index]
                    for requires_index in 0..<requires_count |requires_ok, require_goal_ids, facts, parameter_names, argument_values, functions, requires_start, report, position, name, annotations|:
                        required: Ast::Expr = proof_substitute(functions.all_requires[requires_start + requires_index], parameter_names, argument_values)
                        required_proven: bool = proof_certify_goal(facts, required, report, position.line, name, annotations)
                        require_goal_ids.push(report.goal_attempts.count - 1) if report.goal_attempts.count > 0
                        report.proof_obligation(required_proven)
                        requires_ok <- false if not required_proven
                        proof_add_latest_goal_finding(report, "call-requires-unproven", position.line, name, "callee precondition is not established at the call") if not required_proven
                    return false if not requires_ok
                    caller_index: usize = proof_function_index(functions, name)
                    if function_index < functions.recursive.count and functions.recursive[function_index] and proof_functions_same_recursive_component(functions, caller_index, function_index):
                        # A structural shape in the function table is only a candidate. The
                        # structural walker must have independently certified both declarations
                        # before an executable recursive summary can skip arithmetic measure
                        # obligations. This also covers the inferred product ranking for multiple
                        # enum parameters; it never trusts metadata alone.
                        structural_summary: bool = proof_structural_name_in(report.structural_verified_names, name) and proof_structural_name_in(report.structural_verified_names, function_name) and caller_index < functions.decreases_unbounded.count and function_index < functions.decreases_unbounded.count and not functions.decreases_unbounded[caller_index] and not functions.decreases_unbounded[function_index] and proof_functions_same_recursive_component(functions, caller_index, function_index)
                        structural_failure: bool = proof_structural_report_failed(report, name) or proof_structural_report_failed(report, function_name)
                        if structural_failure:
                            return false
                        if not structural_summary:
                            has_caller_measure: bool = caller_index < functions.decreases_counts.count and caller_index < functions.decreases_unbounded.count and caller_index < functions.decreases_starts.count and functions.decreases_counts[caller_index] > 0 and not functions.decreases_unbounded[caller_index] and proof_decreases_range_valid(functions.decreases_starts[caller_index], functions.decreases_counts[caller_index], functions.all_decreases.count)
                            has_callee_measure: bool = function_index < functions.decreases_counts.count and function_index < functions.decreases_unbounded.count and function_index < functions.decreases_starts.count and functions.decreases_counts[function_index] > 0 and not functions.decreases_unbounded[function_index] and proof_decreases_range_valid(functions.decreases_starts[function_index], functions.decreases_counts[function_index], functions.all_decreases.count)
                            same_measure_arity: bool = has_caller_measure and has_callee_measure and functions.decreases_counts[caller_index] == functions.decreases_counts[function_index]
                            recursive_ok: bool = same_measure_arity
                            if not recursive_ok:
                                report.proof_obligation(false)
                                proof_add_finding(report, "recursive-summary-unsupported", position.line, name, "recursive executable summaries require matching checked lexicographic termination measures")
                                return false
                            caller_measure_start: usize = functions.decreases_starts[caller_index]
                            callee_measure_start: usize = functions.decreases_starts[function_index]
                            caller_measure_values: mutable darray[Ast::Expr] = []
                            for parameter_name in caller_parameters |caller_measure_values, position|:
                                caller_measure_values.push(Ast::Expr.Ident(parameter_name, position))
                            current_components: mutable darray[Ast::Expr] = []
                            recursive_components: mutable darray[Ast::Expr] = []
                            for component_index in 0..<functions.decreases_counts[caller_index] |component_index, current_components, functions, caller_measure_start, caller_parameters, caller_measure_values|:
                                current_components.push(proof_substitute(functions.all_decreases[caller_measure_start + component_index], caller_parameters, caller_measure_values))
                            for component_index in 0..<functions.decreases_counts[function_index] |component_index, recursive_components, functions, callee_measure_start, parameter_names, argument_values|:
                                recursive_components.push(proof_substitute(functions.all_decreases[callee_measure_start + component_index], parameter_names, argument_values))
                            nonnegative_proven: mutable bool = true
                            recursive_nonnegative_proven: mutable bool = true
                            for component in current_components |facts, annotations, report, name, position, nonnegative_proven|:
                                current_nonnegative: Ast::Expr = Ast::Expr.Binary(component, TokenKind.GtEq, Ast::Expr.IntLit(0), position)
                                component_proven: bool = proof_certify_goal(facts, current_nonnegative, report, position.line, name, annotations)
                                report.proof_obligation(component_proven)
                                nonnegative_proven <- false if not component_proven
                                proof_add_latest_goal_finding(report, "recursive-decreases-unproven", position.line, name, "recursive decreases component is not proven nonnegative") if not component_proven
                            for component in recursive_components |facts, annotations, report, name, position, recursive_nonnegative_proven|:
                                recursive_nonnegative: Ast::Expr = Ast::Expr.Binary(component, TokenKind.GtEq, Ast::Expr.IntLit(0), position)
                                component_proven: bool = proof_certify_goal(facts, recursive_nonnegative, report, position.line, name, annotations)
                                report.proof_obligation(component_proven)
                                recursive_nonnegative_proven <- false if not component_proven
                                proof_add_latest_goal_finding(report, "recursive-decreases-unproven", position.line, name, "callee decreases component is not proven nonnegative") if not component_proven
                            smaller_proven: bool = proof_lexicographic_smaller(current_components, recursive_components, facts, annotations, position, report, name)
                            report.proof_obligation(smaller_proven)
                            proof_add_latest_goal_finding(report, "recursive-decreases-unproven", position.line, name, "recursive lexicographic measure is not proven to strictly decrease") if not smaller_proven
                            return false if not nonnegative_proven or not recursive_nonnegative_proven or not smaller_proven
                    changes_start: usize = functions.changes_starts[function_index] if function_index < functions.changes_starts.count else functions.all_changes.count
                    changes_count: usize = functions.changes_counts[function_index] if function_index < functions.changes_counts.count else 0
                    preserves_start: usize = functions.preserves_starts[function_index] if function_index < functions.preserves_starts.count else functions.all_preserves.count
                    preserves_count: usize = functions.preserves_counts[function_index] if function_index < functions.preserves_counts.count else 0
                    mapped_changes: mutable darray[ProofFramePlace] = []
                    mapping_known: mutable bool = true
                    for changed_index in 0..<changes_count |mapped_changes, mapping_known, functions, changes_start, parameter_names, argument_values|:
                        original: ProofFramePlace = functions.all_changes[changes_start + changed_index]
                        mapped: ProofFramePlace = proof_frame_place_from_call(original, parameter_names, argument_values)
                        mapped_known: bool = mapped.root != ""
                        mapping_known <- false if not mapped_known
                        mapped_changes.push(mapped) if mapped_known
                    if changes_count > 0 and mapping_known:
                        for changed in mapped_changes |caller_changes, caller_preserves, report, name, position|:
                            aliases_current_parameter: bool = proof_current_parameter(caller_names, caller_parameters, changed.root)
                            if caller_changes.count > 0 and aliases_current_parameter:
                                allowed: bool = proof_frame_allows_write(caller_changes, changed)
                                report.proof_obligation(allowed)
                                proof_add_finding(report, "frame-call-outside", position.line, name, "callee changes a place outside the caller's changes frame") if not allowed
                            if caller_preserves.count > 0 and aliases_current_parameter:
                                for preserved in caller_preserves |report, name, position|:
                                    preserved_ok: bool = not proof_frame_places_overlap(preserved, changed)
                                    report.proof_obligation(preserved_ok)
                                    proof_add_finding(report, "frame-preserve-violated", position.line, name, "callee changes a place declared preserved by the caller") if not preserved_ok
                    if changes_count == 0 or not mapping_known:
                        if not mapping_known and caller_changes.count > 0:
                            report.proof_obligation(false)
                            proof_add_finding(report, "frame-call-opaque", position.line, name, "callee frame argument is not a directly tracked caller place")
                        if not mapping_known and caller_preserves.count > 0:
                            report.proof_obligation(false)
                            proof_add_finding(report, "frame-preserve-opaque", position.line, name, "callee frame argument is not a directly tracked caller place")
                        if changes_count == 0 and caller_changes.count > 0 and proof_call_may_alias_places(arguments, caller_changes, caller_names, caller_parameters):
                            report.proof_obligation(false)
                            proof_add_finding(report, "frame-call-opaque", position.line, name, "unframed or opaque callee may write through a caller frame argument")
                        if changes_count == 0 and caller_preserves.count > 0 and proof_call_may_alias_places(arguments, caller_preserves, caller_names, caller_parameters):
                            report.proof_obligation(false)
                            proof_add_finding(report, "frame-preserve-opaque", position.line, name, "unframed or opaque callee may write a preserved caller place")
                    old_facts: darray[Ast::Expr] = proof_copy_exprs(facts)
                    facts.clear()
                    # A verified total-pure callee cannot mutate or observe ambient mutable
                    # state, so all caller facts remain valid across the call. Every other call
                    # keeps the existing havoc/frame rules; an ensure alone is not permission to
                    # preserve unrelated facts.
                    if function_index < functions.pure.count and functions.pure[function_index]:
                        facts.extend(old_facts)
                    elif changes_count > 0 and mapping_known:
                        for old_fact in old_facts |facts, mapped_changes|:
                            invalidated: mutable bool = false
                            for changed in mapped_changes |invalidated, old_fact|:
                                invalidated <- true if proof_expr_mentions_frame_place(old_fact, changed)
                            facts.push(old_fact) if not invalidated
                    # An unsigned binding's lower bound comes from compiler typing rather than
                    # mutable state. Restore only that explicitly traced fact after the summary's
                    # normal havoc/frame handling; enclosing move invalidation still removes it.
                    proof_restore_type_bound_facts(old_facts, facts, caller_names, report, name)
                    # A verified callee without a `changes` frame is havoced exactly like an
                    # opaque one, and the same argument bounds that havoc: a callee reaches the
                    # caller only through references and globals, so a fact over a by-value
                    # scalar the caller's body never references survives this call too.
                    proof_restore_call_stable_facts(old_facts, facts, caller_names, caller_parameters, report, name)
                    ensures_start: usize = functions.ensure_starts[function_index]
                    ensures_count: usize = functions.ensure_counts[function_index]
                    result_names: mutable darray[sview] = ["result"]
                    result_values: mutable darray[Ast::Expr] = [result_value]
                    for ensure_index in 0..<ensures_count |facts, parameter_names, argument_values, functions, ensures_start, result_value, result_names, result_values, report, name, position|:
                        ensured: mutable Ast::Expr = proof_substitute(functions.all_ensures[ensures_start + ensure_index], parameter_names, argument_values)
                        if proof_expr_has_old(ensured):
                            report.proof_obligation(false)
                            proof_add_finding(report, "call-old-opaque", position.line, name, "callee ensure depends on a pre-state that is not tracked across calls")
                            return false
                        match result_value:
                            Ast::Expr.Absent:
                                if proof_expr_mentions_name(ensured, "result"):
                                    report.proof_obligation(false)
                                    proof_add_finding(report, "call-result-unbound", position.line, name, "returning callee ensure cannot be used by a statement call")
                                    return false
                            _:
                                ensured <- proof_substitute(ensured, result_names, result_values)
                        proof_add_function_summary_fact(facts, report, ensured, position.line, name, function_name, parameter_names, argument_values, result_value, require_goal_ids, ensure_index)
                    return true
                _:
                    return false

        # Whether a statement can change a value that appears in a caller fact. We use this
        # only to decide whether facts may survive a join point; false positives are acceptable,
        # stale facts are not. Proof blocks are erased and therefore do not modify runtime state.
        def proof_body_may_modify(body: darray[Ast::Stmt]&) -> bool:
            for statement in body:
                match statement:
                    Ast::Stmt.Assign(_, _, _, _):
                        return true
                    Ast::Stmt.VarDecl(_, _, _, _):
                        return true
                    Ast::Stmt.Expr(expression, _):
                        # Calls nested in constructors, indexing, conditionals, and other
                        # expression forms are runtime effects too. Proof blocks are handled
                        # separately and are not present here.
                        return true if proof_expr_has_call(expression) or proof_expr_has_move(expression)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_expr_has_call(condition) or proof_expr_has_move(condition) or proof_body_may_modify(then_body) or proof_body_may_modify(else_body)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_expr_has_call(condition) or proof_expr_has_move(condition) or proof_body_may_modify(while_body)
                    Ast::Stmt.For(bind, _, iterable, for_body, _):
                        # A parallel loop is a proof-state barrier even when its worker body is
                        # empty. Propagate that barrier through enclosing if/block joins; otherwise
                        # the cloned branch state would be discarded while the outer state kept
                        # facts that were not proven to survive the concurrent join.
                        return true if bind == "parallel"
                        return true if proof_expr_has_call(iterable) or proof_expr_has_move(iterable) or proof_body_may_modify(for_body)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_expr_has_call(scrutinee) or proof_expr_has_move(scrutinee)
                        for arm in arms:
                            return true if proof_body_may_modify(arm.body)
                    Ast::Stmt.Contract(kind, expression, _):
                        return true if kind == "assert" and (proof_expr_has_call(expression) or proof_expr_has_move(expression))
                    Ast::Stmt.Break(_, _):
                        pass
                    Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        return true
                    Ast::Stmt.Block(block_kind, _, _, block_body, _):
                        if block_kind == "assert_by" and block_body.count > 0:
                            match block_body[0]:
                                Ast::Stmt.Contract(_, runtime_goal, _):
                                    return true if proof_expr_has_call(runtime_goal) or proof_expr_has_move(runtime_goal)
                                _:
                                    pass
                        return true if block_kind != "assert_by" and proof_body_may_modify(block_body)
                    _:
                        pass
            return false

        # A sequence can complete normally unless a definitely reached statement returns. A
        # conditional, loop, and match are conservatively fallthrough-capable because their
        # runtime coverage is not yet proved by this kernel. A match with an unguarded
        # irrefutable final arm is the one safe exception: every runtime value reaches an arm,
        # and if every arm returns, the match itself cannot complete normally.
        def proof_body_may_fallthrough(body: darray[Ast::Stmt]&) -> bool:
            for statement in body:
                match statement:
                    Ast::Stmt.Return(_, _):
                        return false
                    Ast::Stmt.If(_, then_body, else_body, _):
                        # If either branch can continue, the surrounding sequence continues
                        # with its next statement; only two definitely-returning branches stop
                        # the sequence here.
                        return false if not proof_body_may_fallthrough(then_body) and not proof_body_may_fallthrough(else_body)
                    Ast::Stmt.While(_, _, _):
                        pass
                    Ast::Stmt.For(_, _, _, _, _):
                        pass
                    Ast::Stmt.Match(_, arms, _):
                        all_arms_return: mutable bool = arms.count > 0
                        for arm in arms |all_arms_return|:
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    all_arms_return <- false
                            all_arms_return <- false if proof_body_may_fallthrough(arm.body)
                        if all_arms_return:
                            last_pattern: Ast::Pattern = arms[arms.count - 1].pattern
                            match last_pattern:
                                Ast::Pattern.Wildcard:
                                    return false
                                Ast::Pattern.Binding(_):
                                    return false
                                Ast::Pattern.TypeBind(_, _):
                                    return false
                                Ast::Pattern.As(_, inner):
                                    if inner.count == 1:
                                        match inner[0]:
                                            Ast::Pattern.Wildcard:
                                                return false
                                            Ast::Pattern.Binding(_):
                                                return false
                                            Ast::Pattern.TypeBind(_, _):
                                                return false
                                            _:
                                                pass
                                _:
                                    pass
                    Ast::Stmt.Break(_, _):
                        return false
                    Ast::Stmt.Continue(_, _):
                        return false
                    Ast::Stmt.Invalid:
                        return false
                    Ast::Stmt.Block(block_kind, _, _, block_body, _):
                        return false if block_kind != "assert_by" and not proof_body_may_fallthrough(block_body)
                    _:
                        pass
            return true

        # A break or continue is safe only when the nearest loop's invariant holds on that
        # transfer path. For loops without an imported invariant there is no post-state claim to
        # preserve, so the caller will discard symbolic state after the loop instead.
        def proof_check_loop_control_invariants(loop_invariants: darray[Ast::Expr]&, names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, loop_scope_count: usize, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, line: u32) -> bool:
            result: mutable bool = true
            for invariant in loop_invariants |names, values, facts, loop_scope_count, frame_parameters, old_values, report, name, annotations, line, result|:
                goal: Ast::Expr = proof_substitute_scoped_contract(invariant, names, values, loop_scope_count, frame_parameters, old_values)
                proven: bool = proof_certify_goal(facts, goal, report, line, name, annotations)
                report.proof_obligation(proven)
                result <- false if not proven
                proof_add_latest_goal_finding(report, "invariant-not-preserved", line, name, "loop control path does not re-establish the loop invariant") if not proven
            return result

        # A `for` binder is live only inside the body scope. It cannot occur in invariant facts
        # exported after the loop, where the binder no longer exists. Reject that shape explicitly
        # instead of leaving a free identifier in a replay certificate; callers can still use the
        # loop's range facts for obligations about the binder itself.
        def proof_loop_invariant_mentions_binder(invariant: Ast::Expr, variables: darray[sview]&) -> bool:
            for variable in variables:
                return true if variable != "" and proof_expr_mentions_name(invariant, variable)
            return false

        # A proof block is erased by the backend. Reject executable statements rather than
        # accidentally accepting an effectful proof that will not run at runtime.
        def proof_check_purity(body: darray[Ast::Stmt]&, lemmas: ProofLemmaTable&, report: mutable ProofReport&, name: sview) -> void:
            for statement in body |report, name, lemmas|:
                match statement:
                    Ast::Stmt.Expr(expression, position):
                        match expression:
                            Ast::Expr.Call(callee, arguments, _, _):
                                called: sview = proof_callable_name(callee)
                                if called != "assert" and proof_lemma_index(lemmas, called) >= lemmas.names.count:
                                    proof_add_finding(report, "proof-unknown", position.line, name, "proof blocks may contain only assert facts")
                                proof_add_finding(report, "proof-malformed", position.line, name, "assert requires exactly one proposition") if called == "assert" and arguments.count != 1
                            _:
                                proof_add_finding(report, "proof-impure", position.line, name, "proof blocks may contain only assert facts")
                    Ast::Stmt.Contract(kind, expression, position):
                        proof_add_finding(report, "proof-unknown", position.line, name, "unsupported contract in proof block") if kind != "assert"
                        proof_add_finding(report, "proof-impure", position.line, name, "proof assertions may not evaluate executable calls or ownership transfers") if kind == "assert" and (proof_expr_has_call(expression) or proof_expr_has_move(expression))
                    Ast::Stmt.Block(block_kind, _, _, nested, _):
                        proof_check_purity(nested, lemmas, report, name) if block_kind == "assert_by"
                    _:
                        proof_add_finding(report, "proof-impure", 0, name, "proof blocks may not mutate or return")

        # Lemmas are erased proof declarations too. Their body may contain contracts, checked
        # assertions, lemma applications, and nested assert-by blocks, but no executable state
        # change or return. Otherwise an assignment could manufacture a postcondition in the
        # symbolic evaluator even though the erased lemma never executes at runtime.
        def proof_check_lemma_purity(body: darray[Ast::Stmt]&, lemmas: ProofLemmaTable&, report: mutable ProofReport&, name: sview) -> void:
            for statement in body |lemmas, report, name|:
                match statement:
                    Ast::Stmt.Contract(kind, _, position):
                        if kind != "requires" and kind != "ensure" and kind != "assert" and kind != "decreases" and kind != "decreases*":
                            proof_add_finding(report, "lemma-impure", position.line, name, "lemmas may contain only requires, ensure, decreases, and checked assertions")
                        if kind == "assert":
                            match statement:
                                Ast::Stmt.Contract(_, assertion_expression, _):
                                    proof_add_finding(report, "lemma-impure", position.line, name, "lemma assertions may not evaluate executable calls") if proof_expr_has_call(assertion_expression)
                                _:
                                    pass
                    Ast::Stmt.Expr(expression, position):
                        match expression:
                            Ast::Expr.Call(callee, arguments, _, _):
                                called: sview = proof_callable_name(callee)
                                if called != "assert" and proof_lemma_index(lemmas, called) >= lemmas.names.count:
                                    proof_add_finding(report, "lemma-impure", position.line, name, "lemma bodies may call only assert or another lemma")
                                proof_add_finding(report, "lemma-malformed", position.line, name, "assert requires exactly one proposition") if called == "assert" and arguments.count != 1
                            _:
                                proof_add_finding(report, "lemma-impure", position.line, name, "lemma bodies may contain only proof calls")
                    Ast::Stmt.Block(block_kind, _, _, nested, _):
                        proof_check_purity(nested, lemmas, report, name) if block_kind == "assert_by"
                        proof_add_finding(report, "lemma-impure", 0, name, "lemma bodies may contain only proof blocks") if block_kind != "assert_by"
                    Ast::Stmt.If(condition, then_body, else_body, position):
                        proof_add_finding(report, "lemma-impure", position.line, name, "lemma branch conditions may not evaluate executable calls") if proof_expr_has_call(condition)
                        proof_check_lemma_purity(then_body, lemmas, report, name)
                        proof_check_lemma_purity(else_body, lemmas, report, name)
                    _:
                        proof_add_finding(report, "lemma-impure", 0, name, "lemma bodies may not mutate or return")

        def proof_check_frame_specs(body: darray[Ast::Stmt]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, parameter_names: darray[sview]&, report: mutable ProofReport&, name: sview) -> void:
            for statement in body |changes, preserves, parameter_names, report, name|:
                match statement:
                    Ast::Stmt.Contract(kind, expression, position):
                        if kind == "changes" or kind == "preserves":
                            decoded: (known: bool, place: ProofFramePlace) = proof_frame_place(expression)
                            valid: bool = decoded.known and proof_current_parameter(parameter_names, parameter_names, decoded.place.root)
                            report.proof_obligation(valid)
                            proof_add_finding(report, "frame-spec-invalid", position.line, name, "frame clauses must name a function parameter or parameter field") if not valid
                    _:
                        pass
            for place in changes |report, name|:
                if place.root == "":
                    report.proof_obligation(false)
                    proof_add_finding(report, "frame-spec-opaque", 0, name, "frame metadata does not retain the changed place root")
            for place in preserves |report, name|:
                if place.root == "":
                    report.proof_obligation(false)
                    proof_add_finding(report, "frame-spec-opaque", 0, name, "frame metadata does not retain the preserved place root")

        # Header frame metadata is imported from a compiler side table rather than a body
        # contract, so it does not pass through the body-clause validation above. Validate it
        # against the actual formal parameters before it can authorize a write or preserve a
        # caller fact. A compiler marker with a stale/foreign root must never become authority.
        def proof_check_header_frame_specs(changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, parameter_names: darray[sview]&, report: mutable ProofReport&, name: sview) -> void:
            for place in changes |parameter_names, report, name|:
                valid: bool = place.root != "" and proof_current_parameter(parameter_names, parameter_names, place.root)
                report.proof_obligation(valid)
                proof_add_finding(report, "frame-spec-invalid", 0, name, "header changes metadata names a non-parameter root") if not valid
            for place in preserves |parameter_names, report, name|:
                valid: bool = place.root != "" and proof_current_parameter(parameter_names, parameter_names, place.root)
                report.proof_obligation(valid)
                proof_add_finding(report, "frame-spec-invalid", 0, name, "header preserves metadata names a non-parameter root") if not valid

        def proof_check_direct_frame_write(target: Ast::Expr, names: darray[sview]&, parameter_names: darray[sview]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, report: mutable ProofReport&, name: sview, line: u32) -> void:
            decoded: (known: bool, place: ProofFramePlace) = proof_frame_place(target)
            if decoded.known and proof_current_parameter(names, parameter_names, decoded.place.root):
                if changes.count > 0:
                    allowed: bool = proof_frame_allows_write(changes, decoded.place)
                    report.proof_obligation(allowed)
                    proof_add_finding(report, "frame-write-outside", line, name, "write is outside the function's changes frame") if not allowed
                for preserved in preserves |report, name, line|:
                    preserved_ok: bool = not proof_frame_places_overlap(preserved, decoded.place)
                    report.proof_obligation(preserved_ok)
                    proof_add_finding(report, "frame-preserve-write", line, name, "write violates a preserved function place") if not preserved_ok
                return
            return if changes.count == 0 and preserves.count == 0
            # Dynamic selectors are opaque at the element level, but their statically known
            # container prefix still participates in subtree framing. Permit only a declared
            # ancestor change; preservation remains conservative over any overlapping prefix.
            dynamic_prefix: (known: bool, place: ProofFramePlace) = proof_frame_target_place_prefix(target)
            if proof_frame_target_has_dynamic_selector(target) and dynamic_prefix.known:
                if changes.count > 0:
                    dynamic_allowed: mutable bool = false
                    for changed in changes |dynamic_allowed, dynamic_prefix|:
                        dynamic_allowed <- true if proof_frame_place_is_prefix(changed, dynamic_prefix.place)
                    report.proof_obligation(dynamic_allowed)
                    proof_add_finding(report, "frame-write-outside", line, name, "indexed write is outside the function's changes frame") if not dynamic_allowed
                for preserved in preserves |report, name, line, dynamic_prefix|:
                    preserved_ok: bool = not proof_frame_places_overlap(preserved, dynamic_prefix.place)
                    report.proof_obligation(preserved_ok)
                    proof_add_finding(report, "frame-preserve-write", line, name, "indexed write violates a preserved function place") if not preserved_ok
                return
            # A non-direct target can still be a local reference alias. Resolve its root as far
            # as the symbolic state permits; if it depends on a framed parameter, reject the
            # write instead of treating the unknown alias as harmless.
            root_expression: Ast::Expr = proof_frame_target_root(target)
            root_value: Ast::Expr = root_expression
            opaque_reference: bool = proof_expr_may_be_opaque_reference(root_value)
            for changed in changes |report, name, line, root_value|:
                if opaque_reference or proof_expr_mentions_frame_place(root_value, changed):
                    report.proof_obligation(false)
                    proof_add_finding(report, "frame-write-opaque", line, name, "write target may alias a framed parameter but its root is not tracked")
            for preserved in preserves |report, name, line, root_value|:
                if opaque_reference or proof_expr_mentions_frame_place(root_value, preserved):
                    report.proof_obligation(false)
                    proof_add_finding(report, "frame-preserve-opaque", line, name, "write target may alias a preserved parameter but its root is not tracked")

        def proof_check_opaque_call_frame(expression: Ast::Expr, names: darray[sview]&, parameter_names: darray[sview]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, functions: ProofFunctionTable&, report: mutable ProofReport&, name: sview) -> void:
            match expression:
                Ast::Expr.Call(callee, arguments, _, position):
                    called: sview = proof_callable_name(callee)
                    known: bool = called != "" and proof_function_index(functions, called) < functions.names.count
                    return if known
                    match callee:
                        Ast::Expr.Field(receiver, _, _):
                            proof_check_direct_frame_write(receiver, names, parameter_names, changes, preserves, report, name, position.line)
                        _:
                            pass
                    if changes.count > 0 and proof_call_may_alias_places(arguments, changes, names, parameter_names):
                        report.proof_obligation(false)
                        proof_add_finding(report, "frame-call-opaque", position.line, name, "unknown call may write through a caller frame argument")
                    if preserves.count > 0 and proof_call_may_alias_places(arguments, preserves, names, parameter_names):
                        report.proof_obligation(false)
                        proof_add_finding(report, "frame-preserve-opaque", position.line, name, "unknown call may write a preserved caller place")
                _:
                    pass

        # Conditions and other compound expressions can contain calls even when there is no
        # standalone call statement. Track child calls in evaluation order so later subexpressions
        # see only validated post-call facts; callers that need a disposable state pass a copy.
        def proof_check_frame_calls_in_expression(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: mutable darray[Ast::Expr]&, parameter_names: darray[sview]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, functions: ProofFunctionTable&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> void:
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    # Evaluation proceeds through the callee and arguments before the call
                    # summary is applied. In particular, the outer postcondition must not
                    # justify an argument precondition. Once a child call is checked, carry its
                    # post-call fact state into the next child; otherwise a mutating first
                    # argument could be incorrectly treated as invisible to a later argument.
                    proof_check_frame_calls_in_expression(callee, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    for argument in arguments |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(argument, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    current_call: Ast::Expr = proof_substitute(expression, names, values)
                    pre_call_facts: darray[Ast::Expr] = proof_copy_exprs(facts)
                    probe_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                    applied: bool = proof_apply_function(current_call, current_call, &probe_facts, functions, names, parameter_names, changes, preserves, report, name, annotations)
                    proof_check_opaque_call_frame(current_call, names, parameter_names, changes, preserves, functions, report, name) if not applied
                    facts.clear()
                    facts.extend(probe_facts) if applied
                    proof_restore_type_bound_facts(pre_call_facts, facts, names, report, name) if not proof_expr_has_move(expression)
                    # An opaque nested call reaches an unreferenced by-value scalar local no
                    # more than a call statement does: the facts over such locals come back.
                    proof_restore_call_stable_facts(pre_call_facts, facts, names, parameter_names, report, name) if not applied and not proof_expr_has_move(expression)
                    # A nested call has no destination binding to preserve. Forget all symbolic
                    # values after it so a later sibling or the enclosing call sees only the
                    # current-state identifiers, never a pre-call alias expression.
                    proof_forget_values(names, values, Ast::expr_pos(expression))
                Ast::Expr.Paren(inner, _):
                    proof_check_frame_calls_in_expression(inner, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Unary(_, operand, _):
                    proof_check_frame_calls_in_expression(operand, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Binary(left, _, right, _):
                    proof_check_frame_calls_in_expression(left, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(right, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Field(object, _, _):
                    proof_check_frame_calls_in_expression(object, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Scope(base, _, _):
                    proof_check_frame_calls_in_expression(base, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Index(object, index, _):
                    proof_check_frame_calls_in_expression(object, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(index, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Slice(object, low, high, _):
                    proof_check_frame_calls_in_expression(object, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(low, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(high, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_check_frame_calls_in_expression(object, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    for argument in arguments |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(argument, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Move(operand, _):
                    proof_check_frame_calls_in_expression(operand, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_check_frame_calls_in_expression(operand, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Array(elements, _):
                    for element in elements |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(element, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(element, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(element, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(entry.key, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                        proof_check_frame_calls_in_expression(entry.value, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Construct(type_expression, fields, _):
                    proof_check_frame_calls_in_expression(type_expression, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    for field in fields |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(field.value, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_check_frame_calls_in_expression(base, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    for field in fields |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(field.value, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    proof_check_frame_calls_in_expression(condition, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(then_expr, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(else_expr, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    proof_check_frame_calls_in_expression(iterable, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(condition, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(body, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_check_frame_calls_in_expression(base, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    proof_check_frame_calls_in_expression(predicate, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.GetElse(guarded, _, _):
                    # The recovery body is checked as a statement path by proof_check_returns;
                    # this expression walk covers only calls evaluated on the successful value
                    # path and prevents a guarded call from being classified as an opaque frame.
                    proof_check_frame_calls_in_expression(guarded, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                Ast::Expr.Catch(guarded, arms, _):
                    # The return-boundary catch checker applies the guarded call summary on the
                    # success arm and performs a disposable frame probe for error arms. Walk the
                    # guarded expression here as well for callers that inspect a catch before
                    # reaching that boundary.
                    proof_check_frame_calls_in_expression(guarded, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    for arm in arms |facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations|:
                        proof_check_frame_calls_in_expression(arm.guard, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                        if arm.body.count == 1:
                            match arm.body[0]:
                                Ast::Stmt.Expr(value, _):
                                    proof_check_frame_calls_in_expression(value, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                                _:
                                    pass
                _:
                    if proof_expr_has_call(expression) and (changes.count > 0 or preserves.count > 0):
                        position: Ast::Pos = Ast::expr_pos(expression)
                        report.proof_obligation(false)
                        proof_add_finding(report, "frame-expression-opaque", position.line, name, "unsupported expression may contain an unmodeled call with frame effects")

        # A summarized outer call must not hide calls evaluated in its callee or arguments.
        # Check these children against the caller's pre-call facts before applying the outer
        # summary; the outer ensure is a post-call fact and cannot justify an argument's
        # precondition.
        def proof_check_frame_call_children(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: mutable darray[Ast::Expr]&, parameter_names: darray[sview]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, functions: ProofFunctionTable&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> void:
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_check_frame_calls_in_expression(callee, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                    for argument in arguments |facts, names, values, parameter_names, changes, preserves, functions, report, name|:
                        proof_check_frame_calls_in_expression(argument, facts, names, values, parameter_names, changes, preserves, functions, report, name, annotations)
                _:
                    pass

        # Attach a witness only when the same exact evaluator can show that all current facts
        # hold and the failed proposition is false. Unsupported/frame failures remain witness-
        # free, so clients never mistake a heuristic sample for a semantic counterexample.
        def proof_add_goal_failure(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview, facts: darray[Ast::Expr]&, goal: Ast::Expr) -> void:
            counterexample: mutable darray[Ast::Expr] = []
            found: bool = proof_find_counterexample(facts, goal, &counterexample)
            attempt_exhausted: bool = proof_latest_attempt_exhausted(report)
            proof_add_finding_with_counterexample(report, kind, line, name, message, &counterexample, found)
            # A counterexample is a stronger answer than a budget: report "disproved" when one was
            # found, and "timeout" only when the search never reached a verdict.
            if attempt_exhausted and not found and report.findings.count > 0:
                report.findings[report.findings.count - 1].status <- "timeout" if report.findings[report.findings.count - 1].status == "unknown"
            if report.goal_attempts.count > 0 and report.findings.count > 0:
                report.findings[report.findings.count - 1].goal_id <- report.goal_attempts.count - 1
                report.findings[report.findings.count - 1].has_goal <- true

        # Check proof steps in source order. An `assert` is a `have`, not an unchecked axiom:
        # it becomes a fact only after the current fact set entails it. This is the key trust
        # boundary that keeps a proof block from proving an arbitrary proposition by repeating
        # the proposition as its own assertion.
        def proof_check_block_steps(body: darray[Ast::Stmt]&, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> void:
            for statement in body |facts, names, values, lemmas, report, name|:
                match statement:
                    Ast::Stmt.Contract(kind, expression, position):
                        if kind == "assert":
                            assertion: Ast::Expr = proof_substitute(expression, names, values)
                            proven: bool = proof_certify_goal(facts, assertion, report, position.line, name, annotations)
                            report.proof_obligation(proven)
                            proof_add_derived_fact(facts, report, assertion, "proof-step", position.line, name) if proven
                            proof_add_goal_failure(report, "proof-step-unproven", position.line, name, "asserted proof step is not entailed by earlier facts", facts, assertion) if not proven
                    Ast::Stmt.Expr(expression, position):
                        match expression:
                            Ast::Expr.Call(callee, arguments, _, _):
                                if proof_callable_name(callee) == "assert" and arguments.count == 1:
                                    step: Ast::Expr = proof_substitute(arguments[0], names, values)
                                    proven_step: bool = proof_certify_goal(facts, step, report, position.line, name, annotations)
                                    report.proof_obligation(proven_step)
                                    proof_add_derived_fact(facts, report, step, "proof-step", position.line, name) if proven_step
                                    proof_add_goal_failure(report, "proof-step-unproven", position.line, name, "asserted proof step is not entailed by earlier facts", facts, step) if not proven_step
                                proof_apply_lemma(proof_substitute(expression, names, values), facts, lemmas, names, values, report, name, annotations) if proof_callable_name(callee) != "assert"
                            _:
                                pass
                    Ast::Stmt.Block(block_kind, _, _, nested, _):
                        proof_check_block_steps(nested, facts, names, values, lemmas, report, name, annotations) if block_kind == "assert_by"
                    _:
                        pass

        def proof_check_block(block_body: darray[Ast::Stmt]&, tactic: sview, seed_facts: darray[Ast::Expr]&, names: darray[sview]&, values: darray[Ast::Expr]&, parameters: darray[sview]&, lemmas: ProofLemmaTable&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if block_body.count == 0
            goal: mutable Ast::Expr = Ast::Expr.Absent
            goal_line: mutable u32 = 0
            match block_body[0]:
                Ast::Stmt.Contract(_, expression, position):
                    goal <- proof_substitute(expression, names, values)
                    goal_line <- position.line
                _:
                    proof_add_finding(report, "proof-malformed", 0, name, "proof block has no goal")
                    return false
            proof_body: mutable darray[Ast::Stmt] = []
            index: mutable usize = 1
            while index < block_body.count |index, block_body, proof_body|:
                proof_body.push(block_body[index])
                index <- index + 1
            proof_check_purity(proof_body, lemmas, report, name)
            facts: mutable darray[Ast::Expr] = []
            facts.extend(seed_facts)
            # A scoped block walls off path assumptions, not the language: the compiler type
            # of every live binding still holds inside it. Keeping those facts is what lets the
            # unsigned range guard see a fixed-width symbol instead of an untyped integer.
            proof_clear_facts_keep_type_bounds(&facts, names, parameters, report, name) if tactic == "scoped"
            proof_check_block_steps(proof_body, &facts, names, values, lemmas, report, name, annotations)
            proven: bool = proof_certify_goal(facts, goal, report, goal_line, name, annotations)
            report.proof_obligation(proven)
            proof_add_goal_failure(report, "proof-unproven", goal_line, name, "goal is not entailed by the proof facts", facts, goal) if not proven
            return proven

        # Rebuild a dotted variant path as the same AST shape the compiler parser uses for an
        # `is` test. Pattern paths are source-backed views, so slicing the view keeps the
        # generated proposition allocation-free and preserves the compiler-owned lifetime.
        def proof_pattern_path_expression(path: sview, position: Ast::Pos) -> Ast::Expr:
            return Ast::Expr.Invalid if sview_len(path) == 0
            first_dot: mutable usize = sview_len(path)
            for index in 0..<sview_len(path) |index, path, first_dot|:
                if sview_at(path, index) == 46:
                    first_dot <- index
                    break
            # The compiler stores a leading-dot pattern as a payload-free Variant whose path
            # omits the dot (for example `.Ready` becomes `Ready`). A dotless path therefore
            # denotes enum shorthand here, not an ordinary identifier; preserving that marker
            # keeps match facts aligned with the source-neutral kernel atom used by expressions.
            return Ast::Expr.ShorthandMember([path], position) if first_dot == sview_len(path)
            result: mutable Ast::Expr = Ast::Expr.Ident(sview(path.data, 0, first_dot.i64()), position)
            segment_start: mutable usize = first_dot + 1
            while segment_start < sview_len(path) |segment_start, path, result, position|:
                segment_end: mutable usize = segment_start
                while segment_end < sview_len(path) and sview_at(path, segment_end) != 46 |segment_end, path|:
                    segment_end <- segment_end + 1
                result <- Ast::Expr.Field(result, sview(path.data, segment_start.i64(), segment_end.i64()), position)
                segment_start <- segment_end + 1
            return result

        # Decode the integer subset of a raw pattern literal without borrowing the compiler's
        # parser helper. The pattern AST intentionally retains source text, so this local parser
        # accepts decimal/hex digits and the compiler's numeric suffix spelling, while rejecting
        # malformed text and signed overflow. The accumulator stays signed and grows toward zero
        # for negative literals, which handles i64.min without an overflowing positive magnitude.
        def proof_pattern_integer_literal(text: sview) -> (known: bool, value: i64):
            n: usize = sview_len(text)
            return (false, 0) if n == 0
            negative: bool = sview_at(text, 0) == 45
            start: mutable usize = 1 if negative else 0
            return (false, 0) if start >= n
            is_hex: bool = n - start >= 2 and sview_at(text, start) == 48 and (sview_at(text, start + 1) == 120 or sview_at(text, start + 1) == 88)
            start <- start + 2 if is_hex
            return (false, 0) if start >= n
            base: i64 = 16 if is_hex else 10
            result: mutable i64 = 0
            saw_digit: mutable bool = false
            index: mutable usize = start
            while index < n |index, text, base, negative, result, saw_digit|:
                character: u8 = sview_at(text, index)
                if character == 95:
                    index <- index + 1
                    continue
                digit: mutable i64 = -1
                digit <- (character - 48).i64() if character >= 48 and character <= 57
                digit <- (character - 97 + 10).i64() if digit < 0 and is_hex and character >= 97 and character <= 102
                digit <- (character - 65 + 10).i64() if digit < 0 and is_hex and character >= 65 and character <= 70
                # A suffix starts at the first non-digit after at least one digit. The lexer and
                # semantic pass validate that suffix; it does not alter the integer value.
                break if digit < 0
                return (false, 0) if digit >= base
                if negative:
                    minimum: i64 = 0 - 9223372036854775807 - 1
                    return (false, 0) if result < (minimum + digit) / base
                    result <- result * base - digit
                else:
                    maximum: i64 = 9223372036854775807
                    return (false, 0) if result > (maximum - digit) / base
                    result <- result * base + digit
                saw_digit <- true
                index <- index + 1
            return (false, 0) if not saw_digit
            return (true, result)

        def proof_pattern_literal_expression(text: sview, position: Ast::Pos) -> Ast::Expr?:
            return Ast::Expr.BoolLit(true) if text == "true"
            return Ast::Expr.BoolLit(false) if text == "false"
            parsed: (known: bool, value: i64) = proof_pattern_integer_literal(text)
            return Ast::Expr.IntLit(parsed.value) if parsed.known
            length: usize = sview_len(text)
            if length >= 2 and sview_at(text, 0) == 39 and sview_at(text, length - 1) == 39:
                return Ast::Expr.CharLit(sview(text.data, 1, (length - 1).i64()))
            has_float_marker: mutable bool = false
            for index in 0..<length |index, text, has_float_marker|:
                has_float_marker <- true if sview_at(text, index) == 46 or sview_at(text, index) == 101 or sview_at(text, index) == 69
            return Ast::Expr.FloatLit(text) if has_float_marker
            return null

        # Produce the semantic fact supplied by a successful match arm. The compiler's runtime
        # match machinery establishes this proposition before entering the arm; replay treats it
        # as a source transition, just like an ordinary branch condition. Only representations
        # that map exactly to logical AST values are emitted: variant tags, booleans, and integer
        # equalities/ranges. Struct destructures and string/char/complex patterns remain omitted
        # until their exact value-level lowering is represented in the certificate format.
        def proof_pattern_condition(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos) -> Ast::Expr?:
            match pattern:
                Ast::Pattern.As(_, inner):
                    return proof_pattern_condition(inner[0], scrutinee, position) if inner.count == 1
                Ast::Pattern.Variant(path, _):
                    target: Ast::Expr = proof_pattern_path_expression(path, position)
                    null return if target is Ast::Expr.Invalid
                    return Ast::Expr.Binary(scrutinee, TokenKind.Is, target, position)
                Ast::Pattern.Literal(text):
                    literal: Ast::Expr? = proof_pattern_literal_expression(text, position)
                    if literal is value:
                        return Ast::Expr.Binary(scrutinee, TokenKind.EqEq, value, position)
                Ast::Pattern.Pin(name):
                    return Ast::Expr.Binary(scrutinee, TokenKind.EqEq, Ast::Expr.Ident(name, position), position) if name != ""
                Ast::Pattern.Range(low_text, high_text, inclusive):
                    low: Ast::Expr? = proof_pattern_literal_expression(low_text, position)
                    high: Ast::Expr? = proof_pattern_literal_expression(high_text, position)
                    if low is lower and high is upper:
                        lower_bound: Ast::Expr = Ast::Expr.Binary(scrutinee, TokenKind.GtEq, lower, position)
                        upper_operator: TokenKind = TokenKind.LtEq if inclusive else TokenKind.Lt
                        upper_bound: Ast::Expr = Ast::Expr.Binary(scrutinee, upper_operator, upper, position)
                        return Ast::Expr.Binary(lower_bound, TokenKind.And, upper_bound, position)
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    conditions: mutable darray[Ast::Expr] = []
                    for option in options |conditions, scrutinee, position|:
                        condition: Ast::Expr? = proof_pattern_condition(option, scrutinee, position)
                        if condition is known_condition:
                            conditions.push(known_condition)
                        else:
                            return null
                    result: mutable Ast::Expr = conditions[0]
                    for index in 1..<conditions.count |index, conditions, result, position|:
                        result <- Ast::Expr.Binary(result, TokenKind.Or, conditions[index], position)
                    return result
                _:
                    pass
            return null

        # OR-patterns are admitted only for closed alternatives. This gives the proof state one
        # precise disjunctive match fact while avoiding the unsound choice of a payload binding
        # that exists in only one alternative or has different projections in each alternative.
        def proof_pattern_or_closed(pattern: Ast::Pattern) -> bool:
            match pattern:
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Variant(_, fields):
                    return fields.count == 0
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |pattern|:
                        return false if not proof_pattern_or_closed(option)
                    return true
                _:
                    return false

        # Install lexical bindings introduced by a runtime pattern. A binder now receives a
        # symbolic projection of the matched scrutinee whenever the syntax identifies that
        # projection (`Struct{field: value}` / `Variant(field: value)`). This is a definitional
        # environment update, not an axiom: later substitution can only use the projection that
        # the compiler's pattern itself selected. Positional enum payloads remain conservative
        # because the lowered AST does not expose their stable field names here.
        def proof_bind_pattern(pattern: Ast::Pattern, position: Ast::Pos, source: Ast::Expr, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&) -> bool:
            match pattern:
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Pin(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Binding(binding):
                    return false if binding == ""
                    names.push(binding)
                    values.push(source)
                    return true
                Ast::Pattern.Rest(binding):
                    return true if binding == ""
                    names.push(binding)
                    values.push(Ast::Expr.Invalid)
                    return true
                Ast::Pattern.TypeBind(_, binding):
                    return false if binding == ""
                    names.push(binding)
                    values.push(source)
                    return true
                Ast::Pattern.As(binding, inner):
                    return false if binding == ""
                    names.push(binding)
                    values.push(source)
                    return false if inner.count != 1
                    return proof_bind_pattern(inner[0], position, source, names, values)
                Ast::Pattern.Variant(_, fields):
                    for field in fields |names, values, position, source|:
                        match field:
                            Ast::Pattern.Field(selector, inner):
                                return false if selector == "" or inner.count != 1
                                field_source: Ast::Expr = Ast::Expr.Field(source, selector, position)
                                return false if not proof_bind_pattern(inner[0], position, field_source, names, values)
                            Ast::Pattern.Wildcard:
                                pass
                            Ast::Pattern.Binding(binding):
                                # The payload ordinal-to-field map is not carried by this
                                # compiler AST layer. Keep the binder in lexical scope for the
                                # structural-recursion checker, but leave its value opaque so it
                                # cannot be mistaken for the whole enum or an invented field.
                                return false if binding == ""
                                names.push(binding)
                                values.push(Ast::Expr.Invalid)
                            _:
                                # Positional variant payloads need the compiler's lowered
                                # ordinal-to-field map; guessing a field name would be unsound.
                                return false
                    return true
                Ast::Pattern.Struct(_, fields):
                    for field in fields |names, values, position, source|:
                        match field:
                            Ast::Pattern.Field(selector, inner):
                                return false if selector == "" or inner.count != 1
                                field_source: Ast::Expr = Ast::Expr.Field(source, selector, position)
                                return false if not proof_bind_pattern(inner[0], position, field_source, names, values)
                            Ast::Pattern.Binding(binding):
                                return false if binding == ""
                                names.push(binding)
                                values.push(Ast::Expr.Field(source, binding, position))
                            Ast::Pattern.Wildcard:
                                pass
                            _:
                                return false
                    return true
                Ast::Pattern.Field(_, inner):
                    return false if inner.count != 1
                    return proof_bind_pattern(inner[0], position, source, names, values)
                Ast::Pattern.Tuple(elements):
                    for index in 0..<elements.count |index, elements, names, values, position, source|:
                        element_source: Ast::Expr = Ast::Expr.Index(source, Ast::Expr.IntLit(index.i64()), position)
                        return false if not proof_bind_pattern(elements[index], position, element_source, names, values)
                    return true
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |position|:
                        return false if not proof_pattern_or_closed(option)
                    return true
                Ast::Pattern.Other(_):
                    return false

        # Check only the expression at this statement level; nested statement bodies are checked
        # by their own proof_check_returns invocation. This keeps an unsupported runtime form from
        # being silently reduced to `Invalid` and then accidentally discharged by an unrelated
        # `ensure true`.
        # Runtime expression admission runs before executable summaries are scheduled, so it
        # cannot require the later `verified` bit. It nevertheless requires the already computed
        # transitive purity fixed point: a nested call is retained as a value only when it cannot
        # mutate state. Contract reasoning uses the stricter verified-summary predicate above.
        def proof_statement_position(statement: Ast::Stmt) -> Ast::Pos:
            match statement:
                Ast::Stmt.Expr(_, position):
                    return position
                Ast::Stmt.Block(_, _, _, _, position):
                    return position
                Ast::Stmt.VarDecl(_, _, _, position):
                    return position
                Ast::Stmt.Assign(_, _, _, position):
                    return position
                Ast::Stmt.If(_, _, _, position):
                    return position
                Ast::Stmt.While(_, _, position):
                    return position
                Ast::Stmt.For(_, _, _, _, position):
                    return position
                Ast::Stmt.Return(_, position):
                    return position
                Ast::Stmt.Break(_, position):
                    return position
                Ast::Stmt.Continue(_, position):
                    return position
                Ast::Stmt.Match(_, _, position):
                    return position
                Ast::Stmt.Contract(_, _, position):
                    return position
                _:
                    return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}

        def proof_runtime_calls_are_pure(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    called: sview = proof_callable_name(callee)
                    called_index: usize = proof_function_index(functions, called)
                    return false if called == "" or called_index >= functions.pure.count or not functions.pure[called_index]
                    return false if not proof_runtime_calls_are_pure(callee, functions)
                    for argument in arguments |functions|:
                        return false if not proof_runtime_calls_are_pure(argument, functions)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_runtime_calls_are_pure(inner, functions)
                Ast::Expr.Unary(_, operand, _):
                    return proof_runtime_calls_are_pure(operand, functions)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_runtime_calls_are_pure(left, functions) and proof_runtime_calls_are_pure(right, functions)
                Ast::Expr.Field(object, _, _):
                    return proof_runtime_calls_are_pure(object, functions)
                Ast::Expr.Scope(base, _, _):
                    return proof_runtime_calls_are_pure(base, functions)
                Ast::Expr.Index(object, index, _):
                    return proof_runtime_calls_are_pure(object, functions) and proof_runtime_calls_are_pure(index, functions)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_runtime_calls_are_pure(object, functions) and proof_runtime_calls_are_pure(low, functions) and proof_runtime_calls_are_pure(high, functions)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_runtime_calls_are_pure(object, functions)
                    for argument in arguments |functions|:
                        return false if not proof_runtime_calls_are_pure(argument, functions)
                    return true
                Ast::Expr.Move(operand, _):
                    return proof_runtime_calls_are_pure(operand, functions)
                Ast::Expr.Array(elements, _):
                    for element in elements |functions|:
                        return false if not proof_runtime_calls_are_pure(element, functions)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements |functions|:
                        return false if not proof_runtime_calls_are_pure(element, functions)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements |functions|:
                        return false if not proof_runtime_calls_are_pure(element, functions)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |functions|:
                        return false if not proof_runtime_calls_are_pure(entry.key, functions) or not proof_runtime_calls_are_pure(entry.value, functions)
                    return true
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |functions|:
                        return false if not proof_runtime_calls_are_pure(field.value, functions)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_runtime_calls_are_pure(base, functions)
                    for field in fields |functions|:
                        return false if not proof_runtime_calls_are_pure(field.value, functions)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_runtime_calls_are_pure(condition, functions) and proof_runtime_calls_are_pure(then_expr, functions) and proof_runtime_calls_are_pure(else_expr, functions)
                Ast::Expr.Match(scrutinee, arms, _):
                    return false if not proof_runtime_calls_are_pure(scrutinee, functions)
                    for arm in arms |functions|:
                        return false if not proof_runtime_calls_are_pure(arm.guard, functions)
                        return false if arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return false if not proof_runtime_calls_are_pure(value, functions)
                            _:
                                return false
                    return true
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_runtime_calls_are_pure(iterable, functions) and proof_runtime_calls_are_pure(condition, functions) and proof_runtime_calls_are_pure(body, functions)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_runtime_calls_are_pure(base, functions) and proof_runtime_calls_are_pure(predicate, functions)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return false if not proof_runtime_calls_are_pure(initializer, functions)
                            _:
                                return false
                    return proof_runtime_calls_are_pure(value, functions)
                _:
                    return true

        def proof_runtime_expression_calls_allowed(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            return not proof_expr_has_call(expression) or proof_expr_is_call_rooted(expression) or proof_runtime_calls_are_pure(expression, functions)

        # A branch condition may carry an executable call anywhere the call runs whenever the
        # condition is evaluated at all. The `if` machinery frames every call in the condition,
        # forgets symbolic values, and clears unstable facts on both arms before recording the
        # branch fact, which is exactly the model of a call that certainly happened — so the older
        # restriction to a call at the root was conservatism, not a requirement.
        #
        # This is deliberately narrower than `proof_runtime_expression_calls_allowed`, which still
        # governs `while`, `for`, `match`, `catch` and `assert`. An assertion in particular
        # publishes its expression as a fact through a different path that would hand back the
        # pre-call symbolic value; `examples/rejected_assert_nested_call.elisa` pins that.
        def proof_runtime_branch_calls_allowed(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            return not proof_expr_has_call(expression) or proof_runtime_calls_evaluate_unconditionally(expression, functions, 0) or proof_runtime_calls_are_pure(expression, functions)

        # A call hidden behind a short-circuit, a ternary or a recovery arm may not happen, so
        # only a pure one is admitted there. Every shape this does not reason about explicitly
        # falls through to the no-executable-call case rather than being assumed unconditional.
        def proof_runtime_calls_evaluate_unconditionally(expression: Ast::Expr, functions: ProofFunctionTable&, depth: usize) -> bool:
            requires depth <= 63
            decreases 63 - depth
            return false if depth >= 63
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    # Arguments and the callee term are evaluated before the call itself.
                    return false if not proof_runtime_calls_evaluate_unconditionally(callee, functions, depth + 1)
                    for argument in arguments |functions, depth|:
                        return false if not proof_runtime_calls_evaluate_unconditionally(argument, functions, depth + 1)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_runtime_calls_evaluate_unconditionally(inner, functions, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_runtime_calls_evaluate_unconditionally(operand, functions, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_runtime_calls_evaluate_unconditionally(object, functions, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_runtime_calls_evaluate_unconditionally(base, functions, depth + 1)
                Ast::Expr.Move(operand, _):
                    return proof_runtime_calls_evaluate_unconditionally(operand, functions, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_runtime_calls_evaluate_unconditionally(left, functions, depth + 1)
                    # `and` and `or` evaluate their right operand only for one value of the left.
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        return not proof_expr_has_executable_call(right) or proof_runtime_calls_are_pure(right, functions)
                    return proof_runtime_calls_evaluate_unconditionally(right, functions, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_runtime_calls_evaluate_unconditionally(object, functions, depth + 1) and proof_runtime_calls_evaluate_unconditionally(index, functions, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_runtime_calls_evaluate_unconditionally(object, functions, depth + 1)
                    return proof_runtime_calls_evaluate_unconditionally(low, functions, depth + 1) and proof_runtime_calls_evaluate_unconditionally(high, functions, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_runtime_calls_evaluate_unconditionally(object, functions, depth + 1)
                    for argument in arguments |functions, depth|:
                        return false if not proof_runtime_calls_evaluate_unconditionally(argument, functions, depth + 1)
                    return true
                _:
                    return not proof_expr_has_executable_call(expression)

        # Expression-position catch is admitted only for a closed, value-producing arm shape.
        # The first arm is the successful payload binding; subsequent arms handle errors and the
        # final arm must be an explicit catch-all. This keeps the branch relation finite and
        # prevents an unmodeled error variant from disappearing between the success summary and
        # the returned value.
        def proof_catch_arm_value(arm: Ast::MatchArm) -> (known: bool, value: Ast::Expr):
            return (false, Ast::Expr.Invalid) if arm.body.count != 1
            match arm.body[0]:
                Ast::Stmt.Expr(value, _):
                    return (true, value)
                _:
                    return (false, Ast::Expr.Invalid)

        def proof_catch_error_pattern_supported(pattern: Ast::Pattern) -> bool:
            match pattern:
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.TypeBind(type_name, _):
                    return type_name == "error"
                Ast::Pattern.Variant(_, fields):
                    # Payload projections are not part of the error-state model yet. A
                    # payload-free named variant is still an exact dispatch label.
                    return fields.count == 0
                _:
                    return false

        def proof_catch_value_supported(guarded: Ast::Expr, arms: darray[Ast::MatchArm], functions: ProofFunctionTable&) -> bool:
            return false if arms.count < 2
            return false if not proof_expr_supported(guarded) or not proof_runtime_expression_calls_allowed(guarded, functions)
            match arms[0].pattern:
                Ast::Pattern.Binding(binding):
                    return false if binding == ""
                Ast::Pattern.Wildcard:
                    pass
                _:
                    return false
            for arm_index in 0..<arms.count |arm_index, arms, functions|:
                arm: Ast::MatchArm = arms[arm_index]
                match arm.guard:
                    Ast::Expr.Absent:
                        pass
                    _:
                        return false
                arm_value: (known: bool, value: Ast::Expr) = proof_catch_arm_value(arm)
                return false if not arm_value.known or proof_expr_has_move(arm_value.value)
                # Catch arm values run after the guarded call has selected a branch. A pure
                # executable value call has no additional error/frame state to split here and is
                # safe to evaluate in the arm-local state; effectful or unresolved calls remain
                # outside this expression evaluator.
                return false if proof_expr_has_call(arm_value.value) and not proof_runtime_calls_are_pure(arm_value.value, functions)
                return false if not proof_expr_supported(arm_value.value) or not proof_runtime_expression_calls_allowed(arm_value.value, functions)
                if arm_index > 0:
                    return false if not proof_catch_error_pattern_supported(arm.pattern)
            return proof_catch_error_pattern_supported(arms[arms.count - 1].pattern)

        # `proof_expr_supported` intentionally excludes executable `new[r]` terms. At a call
        # value boundary, however, a direct region allocation is a legal temporary argument. The
        # resource checker gives it an explicit allocation/call transition; this gate admits only
        # that narrow shape and still requires every non-allocation argument to be an ordinary
        # replayable runtime expression.
        def proof_statement_region_new_call_argument_supported(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            match expression:
                Ast::Expr.RegionNew(operand, region, _):
                    return region != "" and proof_expr_supported(operand) and proof_runtime_expression_calls_allowed(operand, functions)
                Ast::Expr.Paren(inner, _):
                    match inner:
                        Ast::Expr.RegionNew(_, _, _):
                            return proof_statement_region_new_call_argument_supported(inner, functions)
                        _:
                            pass
                _:
                    pass
            return proof_expr_supported(expression) and proof_runtime_expression_calls_allowed(expression, functions)

        def proof_statement_region_new_call_supported(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_expr_supported(callee) or not proof_runtime_expression_calls_allowed(callee, functions)
                    for argument in arguments |arguments, functions|:
                        return false if not proof_statement_region_new_call_argument_supported(argument, functions)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_statement_region_new_call_supported(inner, functions)
                _:
                    return false

        # `get EXPR else <control-flow>` is an executable value form, but only at a statement
        # value boundary. The recovery path is checked separately by proof_check_returns; a
        # nested GetElse would require expression-level control-flow joins and remains opaque.
        def proof_statement_value_supported(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            match expression:
                Ast::Expr.RegionNew(operand, _, _):
                    # `new[r] value` is an executable resource transition, not a logical term.
                    # Its lifetime is checked by the resource pass; only the allocated operand
                    # enters this runtime-expression shape gate.
                    return proof_expr_supported(operand) and proof_runtime_expression_calls_allowed(operand, functions)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if recovery.count == 0
                    return proof_expr_supported(guarded) and proof_runtime_expression_calls_allowed(guarded, functions)
                Ast::Expr.Catch(guarded, arms, _):
                    return proof_catch_value_supported(guarded, arms, functions)
                Ast::Expr.Call(_, _, _, _):
                    return proof_statement_region_new_call_supported(expression, functions)
                Ast::Expr.Paren(inner, _):
                    match inner:
                        Ast::Expr.Call(_, _, _, _):
                            return proof_statement_region_new_call_supported(expression, functions)
                        _:
                            pass
                    return proof_expr_supported(expression) and proof_runtime_expression_calls_allowed(expression, functions)
                _:
                    return proof_expr_supported(expression) and proof_runtime_expression_calls_allowed(expression, functions)

        # The compiler represents `raise E.Tag` as a call-shaped expression, but its operational
        # meaning is a terminating exceptional transfer rather than an ordinary statement call.
        # Treat only the reserved terminal heads as such; arbitrary user calls remain normal and
        # must not accidentally discharge a get/try recovery path.
        def proof_expression_is_terminal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    called: sview = proof_callable_name(callee)
                    return called == "raise" or called == "panic"
                Ast::Expr.Paren(inner, _):
                    return proof_expression_is_terminal(inner)
                _:
                    return false

        def proof_statement_expressions_supported(statement: Ast::Stmt, functions: ProofFunctionTable&) -> bool:
            match statement:
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        return proof_statement_value_supported(returned, functions)
                    return true
                Ast::Stmt.Expr(expression, _):
                    return proof_statement_value_supported(expression, functions)
                Ast::Stmt.VarDecl(_, _, initializer, _):
                    return proof_statement_value_supported(initializer, functions)
                Ast::Stmt.Assign(target, _, initializer, _):
                    return proof_expr_supported(target) and proof_statement_value_supported(initializer, functions)
                Ast::Stmt.If(condition, _, _, _):
                    return proof_expr_supported(condition) and proof_runtime_branch_calls_allowed(condition, functions)
                Ast::Stmt.While(condition, _, _):
                    return proof_expr_supported(condition) and proof_runtime_expression_calls_allowed(condition, functions)
                Ast::Stmt.For(_, _, iterable, _, _):
                    return proof_expr_supported(iterable) and proof_runtime_expression_calls_allowed(iterable, functions)
                Ast::Stmt.Match(scrutinee, _, _):
                    return proof_expr_supported(scrutinee) and proof_runtime_expression_calls_allowed(scrutinee, functions)
                Ast::Stmt.Block(block_kind, _, _, block_body, _):
                    if block_kind == "assert_by" and block_body.count > 0:
                        match block_body[0]:
                            Ast::Stmt.Contract(_, goal, _):
                                return proof_expr_supported(goal) and proof_runtime_expression_calls_allowed(goal, functions)
                            _:
                                return false
                    return true
                Ast::Stmt.Contract(kind, expression, _):
                    return true if kind != "assert"
                    return proof_expr_supported(expression) and proof_runtime_expression_calls_allowed(expression, functions)
                _:
                    return true

        # Extract only a top-level statement value recovery. This deliberately does not walk the
        # recovery body: the main proof-state checker must do that with an isolated state so a
        # failure branch cannot leak bindings or facts into the successful path.
        def proof_statement_getelse_recovery(statement: Ast::Stmt) -> (known: bool, recovery: darray[Ast::Stmt], line: u32):
            match statement:
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        match returned:
                            Ast::Expr.GetElse(_, recovery, position):
                                return (true, recovery, position.line)
                            _:
                                pass
                Ast::Stmt.Expr(expression, _):
                    match expression:
                        Ast::Expr.GetElse(_, recovery, position):
                            return (true, recovery, position.line)
                        _:
                            pass
                Ast::Stmt.VarDecl(_, _, initializer, _):
                    match initializer:
                        Ast::Expr.GetElse(_, recovery, position):
                            return (true, recovery, position.line)
                        _:
                            pass
                Ast::Stmt.Assign(_, _, initializer, _):
                    match initializer:
                        Ast::Expr.GetElse(_, recovery, position):
                            return (true, recovery, position.line)
                        _:
                            pass
                _:
                    pass
            return (false, [], 0)

        # A runtime index is a memory-safety obligation, not merely an expression the arithmetic
        # prover may ignore. This first heap slice handles directly tracked collection-like
        # places whose length is expressed as `.count`; calls, literals, nested dynamic indexes,
        # and multi-index forms stay opaque until the heap model can describe them soundly.
        def proof_indexable_object(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_indexable_object(inner)
                Ast::Expr.Refinement(base, _, _):
                    return proof_indexable_object(base)
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_indexable_object(object)
                Ast::Expr.Scope(base, _, _):
                    return proof_indexable_object(base)
                _:
                    return false

        # Elisa's `value.cast[Type]` syntax is represented by the compiler AST as an Index whose
        # receiver is the reserved `cast` selector. The bracket contains a type expression, not a
        # runtime position, so treating it as collection indexing manufactures false memory-safety
        # obligations (especially in trusted low-level pointer adapters). Ordinary `value[index]`
        # expressions do not match this shape and remain fully checked below.
        def proof_is_type_cast_index(object: Ast::Expr) -> bool:
            match object:
                Ast::Expr.Field(_, field, _):
                    return field == "cast"
                Ast::Expr.Paren(inner, _):
                    return proof_is_type_cast_index(inner)
                _:
                    return false

        def proof_expr_is_invalid(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return true
                _:
                    return false

        # Purity only proves that an index-producing call cannot mutate the collection. It does
        # not prove that the returned position is safe. Admit the call only when its verified
        # executable summary contains an exact, call-free result equation; the caller's ordinary
        # arithmetic facts then prove the bounds for that returned expression.
        def proof_index_call_result(expression: Ast::Expr, facts: darray[Ast::Expr]&, functions: ProofFunctionTable&, annotations: darray[Ast::EnumAnnotation]&, summary_facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, owner: sview) -> (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview):
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_index_call_result(inner, facts, functions, annotations, summary_facts, report, owner)
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    function_name: sview = proof_callable_name(callee)
                    function_index: usize = proof_function_index(functions, function_name)
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if function_name == "" or function_index >= functions.names.count
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if function_index >= functions.pure.count or not functions.pure[function_index]
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if function_index >= functions.verified.count or not functions.verified[function_index]
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if function_index >= functions.param_counts.count or arguments.count > functions.param_counts[function_index]
                    parameter_names: mutable darray[sview] = []
                    parameter_start: usize = functions.param_starts[function_index]
                    for parameter_index in 0..<functions.param_counts[function_index] |parameter_names, functions, parameter_start|:
                        parameter_names.push(functions.all_params[parameter_start + parameter_index])
                    default_flags: mutable darray[bool] = []
                    default_values: mutable darray[Ast::Expr] = []
                    for parameter_index in 0..<functions.param_counts[function_index] |default_flags, default_values, functions, parameter_start|:
                        default_flags.push(functions.all_has_defaults[parameter_start + parameter_index])
                        default_values.push(functions.all_defaults[parameter_start + parameter_index])
                    mapped_arguments: mutable darray[Ast::Expr] = []
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if not proof_map_runtime_call_arguments(parameter_names, default_flags, default_values, arguments, argument_names, &mapped_arguments, functions)
                    requires_start: usize = functions.requires_starts[function_index] if function_index < functions.requires_starts.count else functions.all_requires.count
                    requires_count: usize = functions.requires_counts[function_index] if function_index < functions.requires_counts.count else 0
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if requires_start > functions.all_requires.count or requires_count > functions.all_requires.count - requires_start
                    require_goal_ids: mutable darray[usize] = []
                    for requires_index in 0..<requires_count |requires_index, functions, requires_start, parameter_names, mapped_arguments, facts, annotations, report, position, owner, require_goal_ids|:
                        required: Ast::Expr = proof_substitute(functions.all_requires[requires_start + requires_index], parameter_names, mapped_arguments)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if proof_expr_has_old(required)
                        required_proven: bool = proof_certify_goal(facts, required, report, position.line, owner, annotations)
                        require_goal_ids.push(report.goal_attempts.count - 1) if report.goal_attempts.count > 0
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if not required_proven
                    ensures_start: usize = functions.ensure_starts[function_index] if function_index < functions.ensure_starts.count else functions.all_ensures.count
                    ensures_count: usize = functions.ensure_counts[function_index] if function_index < functions.ensure_counts.count else 0
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if ensures_start > functions.all_ensures.count or ensures_count > functions.all_ensures.count - ensures_start
                    result_name: darray[sview] = ["result"]
                    result_value: darray[Ast::Expr] = [expression]
                    for ensures_index in 0..<ensures_count |ensures_index, functions, ensures_start, parameter_names, mapped_arguments, result_name, result_value, expression|:
                        ensured: Ast::Expr = proof_substitute(functions.all_ensures[ensures_start + ensures_index], parameter_names, mapped_arguments)
                        return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "") if proof_expr_has_old(ensured)
                        instantiated: Ast::Expr = proof_substitute(ensured, result_name, result_value)
                        match instantiated:
                            Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                                candidate: Ast::Expr = right if proof_expr_equal(left, expression) else (left if proof_expr_equal(right, expression) else Ast::Expr.Invalid)
                                if not proof_expr_is_invalid(candidate) and proof_expr_supported(candidate) and not proof_expr_has_call(candidate) and not proof_expr_has_move(candidate):
                                    proof_add_function_summary_fact(summary_facts, report, instantiated, position.line, owner, function_name, parameter_names, mapped_arguments, expression, require_goal_ids, ensures_index)
                                    return (true, candidate, instantiated, function_name)
                            _:
                                pass
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "")
                _:
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid, "")

        def proof_check_index_access(object: Ast::Expr, index: Ast::Expr, position: Ast::Pos, facts: mutable darray[Ast::Expr]&, fixed_names: darray[sview]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: ProofFunctionTable&) -> void:
            return if proof_is_type_cast_index(object)
            checked_index: mutable Ast::Expr = index
            checked_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            if proof_expr_has_call(index):
                resolved: (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) = proof_index_call_result(index, facts, functions, annotations, &checked_facts, report, name)
                if resolved.known:
                    checked_index <- resolved.value
                else:
                    checked_index <- Ast::Expr.Invalid
            if not proof_indexable_object(object) or proof_expr_has_call(object) or proof_expr_has_move(object) or proof_expr_is_invalid(checked_index) or proof_expr_has_call(checked_index) or proof_expr_has_move(checked_index):
                report.proof_obligation(false)
                proof_add_finding(report, "index-bounds-opaque", position.line, name, "indexed access has no statically tracked collection bound")
                return
            lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0), TokenKind.LtEq, checked_index, position)
            count: Ast::Expr = Ast::Expr.Field(object, "count", position)
            upper: Ast::Expr = Ast::Expr.Binary(checked_index, TokenKind.Lt, count, position)
            lower_proven: bool = proof_certify_goal_with_rule(checked_facts, lower, report, position.line, name, annotations, "index-lower")
            report.proof_obligation(lower_proven)
            proof_add_latest_goal_finding(report, "index-lower-unproven", position.line, name, "indexed access may use a negative position") if not lower_proven
            # A fixed-array parameter has an exact runtime count. We first prove the
            # source index below that literal extent, then import the corresponding
            # `.count` fact with explicit type-bound provenance. If that proof fails,
            # retain the ordinary dynamic-count obligation and fail closed.
            fixed_extent: i64 = proof_fixed_array_extent_for_object(object, fixed_names, fixed_extents)
            fixed_upper_proven: mutable bool = false
            if fixed_extent >= 0:
                fixed_upper: Ast::Expr = Ast::Expr.Binary(checked_index, TokenKind.Lt, Ast::Expr.IntLit(fixed_extent), position)
                fixed_upper_proven <- proof_goal(checked_facts, fixed_upper, annotations)
                proof_add_traced_fact(checked_facts, report, upper, "type-bound", position.line, name) if fixed_upper_proven
            upper_proven: bool = proof_certify_goal_with_rule(checked_facts, upper, report, position.line, name, annotations, "index-upper")
            report.proof_obligation(upper_proven)
            proof_add_latest_goal_finding(report, "index-upper-unproven", position.line, name, "indexed access may exceed the collection bound") if not upper_proven

        # A compiler `IndexN` can denote nested fixed-array access (`matrix[row, column]`).
        # Check each argument against the corresponding literal dimension. This is deliberately
        # narrower than treating every IndexN as nested indexing: generic applications, dynamic
        # inner arrays, calls, and aliases have no independently tracked storage bound here.
        def proof_check_indexn_access(object: Ast::Expr, arguments: darray[Ast::Expr]&, position: Ast::Pos, facts: mutable darray[Ast::Expr]&, fixed_names: darray[sview]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: ProofFunctionTable&) -> void:
            if arguments.count == 0 or not proof_indexable_object(object) or proof_expr_has_call(object) or proof_expr_has_move(object):
                report.proof_obligation(false)
                proof_add_finding(report, "index-bounds-opaque", position.line, name, "multi-index access has no checked heap bound model")
                return
            dimension: mutable usize = 0
            for index in arguments |facts, fixed_names, fixed_extents, report, name, annotations, position, dimension, functions|:
                checked_index: mutable Ast::Expr = index
                checked_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                if proof_expr_has_call(index):
                    resolved: (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) = proof_index_call_result(index, facts, functions, annotations, &checked_facts, report, name)
                    if resolved.known:
                        checked_index <- resolved.value
                    else:
                        checked_index <- Ast::Expr.Invalid
                if proof_expr_is_invalid(checked_index) or proof_expr_has_call(checked_index) or proof_expr_has_move(checked_index):
                    report.proof_obligation(false)
                    proof_add_finding(report, "index-bounds-opaque", position.line, name, "multi-index position has no statically checked value")
                else:
                    extent: i64 = proof_fixed_array_dimension_extent(object, dimension, fixed_names, fixed_extents)
                    if extent < 0:
                        report.proof_obligation(false)
                        proof_add_finding(report, "index-bounds-opaque", position.line, name, "multi-index dimension has no statically tracked bound")
                    else:
                        lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0), TokenKind.LtEq, checked_index, position)
                        upper: Ast::Expr = Ast::Expr.Binary(checked_index, TokenKind.Lt, Ast::Expr.IntLit(extent), position)
                        lower_proven: bool = proof_certify_goal_with_rule(checked_facts, lower, report, position.line, name, annotations, "index-lower")
                        report.proof_obligation(lower_proven)
                        proof_add_latest_goal_finding(report, "index-lower-unproven", position.line, name, "multi-index position may be negative") if not lower_proven
                        upper_proven: bool = proof_certify_goal_with_rule(checked_facts, upper, report, position.line, name, annotations, "index-upper")
                        report.proof_obligation(upper_proven)
                        proof_add_latest_goal_finding(report, "index-upper-unproven", position.line, name, "multi-index position may exceed its fixed dimension") if not upper_proven
                dimension <- dimension + 1

        # The checked-index operator is a compiler/runtime boundary, not an arithmetic claim:
        # either the guarded load is in range or the fallback is selected. Record a dedicated
        # certificate so a successful report cannot silently omit this memory-safety transition.
        # The selected element remains opaque; value properties must still be proved separately.
        def proof_certify_checked_index(expression: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32) -> void:
            return if not proof_kernel_expression_supported(expression)
            empty_checked_facts: darray[Ast::Expr] = []
            proof_add_goal_attempt(report, empty_checked_facts, expression, line, name, "checked-index", true)
            report.proof_obligation(true)

        # A control-recovery get (`get collection[index] else return/raise/break/continue`)
        # provides the same runtime no-load guarantee as the value-fallback form, but its
        # recovery is not an expression and therefore cannot be represented by the checked-index
        # arena node. Emit a distinct certificate so replay cannot confuse the two semantics.
        def proof_certify_checked_get(expression: Ast::Expr, report: mutable ProofReport&, name: sview, line: u32) -> void:
            return if not proof_kernel_expression_supported(expression)
            empty_checked_facts: darray[Ast::Expr] = []
            proof_add_goal_attempt(report, empty_checked_facts, expression, line, name, "checked-get", true)
            report.proof_obligation(true)

        # Slices use an exclusive high endpoint (`object[low:high]`). Open endpoints are
        # already represented by Ast::Expr.Absent and inherit the implicit safe bounds 0 and
        # object.count. As with single indexes, a receiver whose storage shape is not directly
        # tracked is unsupported rather than guessed; this avoids treating an arbitrary view or
        # returned collection as if its `.count` were the backing allocation's bound.
        def proof_check_slice_access(object: Ast::Expr, low: Ast::Expr, high: Ast::Expr, position: Ast::Pos, facts: mutable darray[Ast::Expr]&, fixed_names: darray[sview]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: ProofFunctionTable&) -> void:
            checked_low: mutable Ast::Expr = low
            checked_high: mutable Ast::Expr = high
            checked_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            if proof_expr_has_call(low):
                resolved_low: (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) = proof_index_call_result(low, facts, functions, annotations, &checked_facts, report, name)
                if resolved_low.known:
                    checked_low <- resolved_low.value
                else:
                    checked_low <- Ast::Expr.Invalid
            if proof_expr_has_call(high):
                resolved_high: (known: bool, value: Ast::Expr, summary: Ast::Expr, dependency: sview) = proof_index_call_result(high, facts, functions, annotations, &checked_facts, report, name)
                if resolved_high.known:
                    checked_high <- resolved_high.value
                else:
                    checked_high <- Ast::Expr.Invalid
            if not proof_indexable_object(object) or proof_expr_has_call(object) or proof_expr_has_move(object) or proof_expr_is_invalid(checked_low) or proof_expr_has_move(checked_low) or proof_expr_is_invalid(checked_high) or proof_expr_has_move(checked_high):
                report.proof_obligation(false)
                proof_add_finding(report, "slice-bounds-opaque", position.line, name, "slice has no statically tracked collection bound")
                return
            match checked_low:
                Ast::Expr.Absent:
                    pass
                _:
                    lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0), TokenKind.LtEq, checked_low, position)
                    lower_proven: bool = proof_certify_goal_with_rule(checked_facts, lower, report, position.line, name, annotations, "slice-lower")
                    report.proof_obligation(lower_proven)
                    proof_add_latest_goal_finding(report, "slice-lower-unproven", position.line, name, "slice may begin before the collection") if not lower_proven
            match checked_high:
                Ast::Expr.Absent:
                    pass
                _:
                    count: Ast::Expr = Ast::Expr.Field(object, "count", position)
                    upper: Ast::Expr = Ast::Expr.Binary(checked_high, TokenKind.LtEq, count, position)
                    # As with a single index, a fixed-array parameter may supply the
                    # count relation only after the high endpoint is proved below the
                    # declared literal extent. Dynamic views still use the normal count
                    # obligation and therefore cannot inherit this fact.
                    fixed_extent: i64 = proof_fixed_array_extent_for_object(object, fixed_names, fixed_extents)
                    if fixed_extent >= 0:
                        fixed_upper: Ast::Expr = Ast::Expr.Binary(checked_high, TokenKind.LtEq, Ast::Expr.IntLit(fixed_extent), position)
                        if proof_goal(checked_facts, fixed_upper, annotations):
                            proof_add_traced_fact(checked_facts, report, upper, "type-bound", position.line, name)
                    upper_proven: bool = proof_certify_goal_with_rule(checked_facts, upper, report, position.line, name, annotations, "slice-upper")
                    report.proof_obligation(upper_proven)
                    proof_add_latest_goal_finding(report, "slice-upper-unproven", position.line, name, "slice may end beyond the collection") if not upper_proven
            match checked_low:
                Ast::Expr.Absent:
                    pass
                _:
                    match checked_high:
                        Ast::Expr.Absent:
                            pass
                        _:
                            ordered: Ast::Expr = Ast::Expr.Binary(checked_low, TokenKind.LtEq, checked_high, position)
                            ordered_proven: bool = proof_certify_goal_with_rule(checked_facts, ordered, report, position.line, name, annotations, "slice-order")
                            report.proof_obligation(ordered_proven)
                            proof_add_latest_goal_finding(report, "slice-order-unproven", position.line, name, "slice bounds may be reversed") if not ordered_proven

        def proof_check_index_safety_value(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, fixed_names: darray[sview]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, line: u32, functions: ProofFunctionTable&) -> void:
            match expression:
                Ast::Expr.Index(object, index, position):
                    proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    return if proof_is_type_cast_index(object)
                    proof_check_index_safety_value(index, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_access(object, index, position, facts, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Expr.IndexN(object, arguments, position):
                    proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    for argument in arguments |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        proof_check_index_safety_value(argument, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_indexn_access(object, arguments, position, facts, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Expr.Paren(inner, _):
                    proof_check_index_safety_value(inner, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Unary(_, operand, _):
                    proof_check_index_safety_value(operand, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.GetElse(guarded, _, getelse_position):
                    # The recovery is checked in an isolated statement proof state. For a direct
                    # index, the runtime either loads an in-range element or takes that recovery,
                    # so ordinary lower/upper obligations would be false positives. Nested
                    # accesses in the receiver or index remain ordinary obligations.
                    match guarded:
                        Ast::Expr.Index(checked_object, checked_index_position, _):
                            proof_certify_checked_get(expression, report, name, getelse_position.line)
                            proof_check_index_safety_value(checked_object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                            proof_check_index_safety_value(checked_index_position, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                        _:
                            proof_check_index_safety_value(guarded, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                # `get xs[i] else fallback` is lowered by the compiler to
                # `Binary(Index(xs, i), Else, fallback)`. The Else operator is the runtime
                # bounds guard itself: when the index is outside the collection no element
                # load occurs and the fallback is evaluated. Do not manufacture ordinary
                # `0 <= i` / `i < xs.count` obligations for the guarded access. Still walk
                # the receiver, index expression, and fallback so nested accesses, calls,
                # and unsupported forms cannot be hidden behind the outer recovery.
                Ast::Expr.Binary(checked_index, TokenKind.Else, checked_fallback, checked_position):
                    match checked_index:
                        Ast::Expr.Index(checked_object, checked_index_position, _):
                            proof_certify_checked_index(expression, report, name, checked_position.line)
                            proof_check_index_safety_value(checked_object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                            proof_check_index_safety_value(checked_index_position, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                            proof_check_index_safety_value(checked_fallback, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                        _:
                            proof_check_index_safety_value(checked_index, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                            proof_check_index_safety_value(checked_fallback, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Binary(left, _, right, _):
                    proof_check_index_safety_value(left, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_safety_value(right, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_check_index_safety_value(callee, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    for argument in arguments |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        proof_check_index_safety_value(argument, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Field(object, _, _):
                    proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Scope(base, _, _):
                    proof_check_index_safety_value(base, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Slice(object, low, high, position):
                    proof_check_index_safety_value(object, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_safety_value(low, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_safety_value(high, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_slice_access(object, low, high, position, facts, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Expr.Move(operand, _):
                    proof_check_index_safety_value(operand, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_check_index_safety_value(operand, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Array(elements, _):
                    for element in elements |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        proof_check_index_safety_value(element, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        proof_check_index_safety_value(element, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        proof_check_index_safety_value(element, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        proof_check_index_safety_value(entry.key, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                        proof_check_index_safety_value(entry.value, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        proof_check_index_safety_value(field.value, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_check_index_safety_value(base, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    for field in fields |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        proof_check_index_safety_value(field.value, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    proof_check_index_safety_value(condition, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_safety_value(then_expr, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_safety_value(else_expr, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    proof_check_index_safety_value(iterable, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_safety_value(condition, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_safety_value(body, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_check_index_safety_value(base, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                    proof_check_index_safety_value(predicate, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements |facts, fixed_names, fixed_extents, report, name, annotations, line|:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                proof_check_index_safety_value(initializer, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                            _:
                                pass
                    proof_check_index_safety_value(value, facts, fixed_names, fixed_extents, report, name, annotations, line, functions)
                _:
                    pass

        def proof_check_index_safety(expression: Ast::Expr, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: darray[Ast::Expr]&, fixed_names: darray[sview]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: ProofFunctionTable&) -> void:
            # `proof_substitute` intentionally projects GetElse to its successful value for
            # ordinary symbolic reasoning. Preserve the control wrapper at this safety boundary
            # so a direct guarded index can emit its distinct checked-get certificate.
            match expression:
                Ast::Expr.GetElse(guarded, recovery, position):
                    substituted_guarded: Ast::Expr = proof_substitute(guarded, names, values)
                    preserved: Ast::Expr = Ast::Expr.GetElse(substituted_guarded, recovery, position)
                    proof_check_index_safety_value(preserved, facts, fixed_names, fixed_extents, report, name, annotations, position.line, functions)
                Ast::Expr.Catch(guarded, arms, position):
                    # Catch arm values are evaluated in their own branch. This safety walk is
                    # intentionally expression-only; the value-position admission gate rejects
                    # arm statements that need a richer control-flow model.
                    proof_check_index_safety(guarded, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                    for arm in arms |facts, names, values, fixed_names, fixed_extents, report, name, annotations|:
                        arm_value: (known: bool, value: Ast::Expr) = proof_catch_arm_value(arm)
                        proof_check_index_safety(arm_value.value, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) if arm_value.known
                _:
                    substituted: Ast::Expr = proof_substitute(expression, names, values)
                    proof_check_index_safety_value(substituted, facts, fixed_names, fixed_extents, report, name, annotations, Ast::expr_pos(expression).line, functions)

        def proof_check_statement_index_safety(statement: Ast::Stmt, facts: mutable darray[Ast::Expr]&, names: darray[sview]&, values: darray[Ast::Expr]&, fixed_names: darray[sview]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, functions: ProofFunctionTable&) -> void:
            match statement:
                Ast::Stmt.Return(value, _):
                    proof_check_index_safety(returned, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) if value is returned
                Ast::Stmt.Expr(expression, _):
                    proof_check_index_safety(expression, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Stmt.VarDecl(_, _, initializer, _):
                    proof_check_index_safety(initializer, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Stmt.Assign(target, _, initializer, _):
                    proof_check_index_safety(target, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                    proof_check_index_safety(initializer, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Stmt.If(condition, _, _, _):
                    proof_check_index_safety(condition, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Stmt.While(condition, _, _):
                    proof_check_index_safety(condition, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Stmt.For(_, _, iterable, _, _):
                    proof_check_index_safety(iterable, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Stmt.Match(scrutinee, arms, _):
                    proof_check_index_safety(scrutinee, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                    for arm in arms |facts, names, values, fixed_names, fixed_extents, report, name, annotations|:
                        proof_check_index_safety(arm.guard, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                Ast::Stmt.Contract(kind, expression, _):
                    proof_check_index_safety(expression, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions) if kind == "assert"
                _:
                    pass

        # A counting range is a semantic source of bounds: every value bound by a loop over
        # `low..<high` satisfies `low <= item` and `item < high` (or `item <= high` for `..=`).
        # Keep these as traced facts rather than treating the syntax as an axiom. They are valid
        # for every iteration, and the normal call/write/move boundaries still discard them when
        # the surrounding state can change. Refinement filters are unwrapped only to recover the
        # range; their predicates are handled separately by the ordinary loop checker.
        def proof_loop_range_base(iterable: Ast::Expr) -> Ast::Expr:
            match iterable:
                Ast::Expr.Refinement(base, _, _):
                    return proof_loop_range_base(base)
                Ast::Expr.Paren(inner, _):
                    return proof_loop_range_base(inner)
                _:
                    return iterable

        # The proof state is name-based, while Elisa permits a loop binder to shadow an outer
        # binding with the same spelling. Represent the current binder with a structural, opaque
        # proof atom so `for x in ...: return x` cannot become definitionally equal to the outer
        # `x`. The source offset makes nested binders with the same name distinct; this atom is
        # internal to certificates and is never emitted as executable Elisa.
        def proof_loop_binder_value(variable: sview, position: Ast::Pos) -> Ast::Expr:
            marker: mutable darray[Ast::Expr] = []
            marker.push(Ast::Expr.Ident(variable, position))
            marker.push(Ast::Expr.IntLit(position.offset.i64()))
            return Ast::Expr.Tuple(marker, position)

        def proof_add_loop_range_facts(iterable: Ast::Expr, variables: darray[sview]&, binder_position: Ast::Pos, facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, name: sview, line: u32) -> void:
            return if variables.count == 0 or variables[0] == ""
            range: Ast::Expr = proof_loop_range_base(iterable)
            # The binder is represented by its own proof atom, so the type witness has to be
            # keyed by that atom: a witness on the bare spelling would never meet a goal.
            binder: Ast::Expr = proof_loop_binder_value(variables[0], binder_position)
            match range:
                Ast::Expr.Binary(low, operator, high, position):
                    return if operator != TokenKind.RangeLt and operator != TokenKind.RangeLe
                    lower: Ast::Expr = Ast::Expr.Binary(low, TokenKind.LtEq, binder, position)
                    upper_operator: TokenKind = TokenKind.LtEq if operator == TokenKind.RangeLe else TokenKind.Lt
                    upper: Ast::Expr = Ast::Expr.Binary(binder, upper_operator, high, position)
                    proof_add_traced_fact(facts, report, lower, "loop-range", line, name)
                    proof_add_traced_fact(facts, report, upper, "loop-range", line, name)
                    # The endpoints of a counting range are integers, so the binder is one too.
                    # That is the same semantic source as the two bounds just recorded.
                    proof_add_type_bound_fact(facts, report, proof_scalar_term_marker(binder, binder_position), line, name)
                _:
                    # Iterating a container whose elements were resolved to primitive scalars
                    # binds each element, so the binder inherits that witness. A container of
                    # aggregates, or one with no element witness, leaves the binder unwitnessed.
                    return if variables.count != 1
                    proof_add_type_bound_fact(facts, report, proof_scalar_term_marker(binder, binder_position), line, name) if proof_scalar_element_remaining(range, facts, 0) == 1

        # Check a restricted expression-position catch at a return boundary. A fallible call has
        # two semantically different post-states: the success arm may consume the callee's
        # verified result summary, while error arms may consume only the call's checked frame
        # boundary (and retain facts only for a verified pure callee). Never share the success
        # summary with an error arm, because the callee's `ensure` describes successful returns.
        def proof_check_catch_return(guarded: Ast::Expr, arms: darray[Ast::MatchArm], names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, ensures: darray[Ast::Expr]&, functions: ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, report: mutable ProofReport&, name: sview, annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos) -> void:
            success_names: mutable darray[sview] = proof_copy_names(names)
            success_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
            success_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            error_names: mutable darray[sview] = proof_copy_names(names)
            error_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
            error_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            success_call: mutable Ast::Expr = proof_substitute(guarded, success_names, success_values)
            error_call: mutable Ast::Expr = proof_substitute(guarded, error_names, error_values)
            success_applied: mutable bool = false
            error_applied: mutable bool = false
            match success_call:
                Ast::Expr.Call(_, _, _, _):
                    proof_check_frame_call_children(success_call, success_facts, success_names, success_values, frame_parameters, changes, preserves, functions, report, name, annotations)
                    success_call <- proof_substitute(success_call, success_names, success_values)
                    success_applied <- proof_apply_function(success_call, success_call, &success_facts, functions, success_names, frame_parameters, changes, preserves, report, name, annotations)
                    proof_check_opaque_call_frame(success_call, success_names, frame_parameters, changes, preserves, functions, report, name) if not success_applied
                _:
                    success_applied <- false
            match error_call:
                Ast::Expr.Call(_, _, _, _):
                    proof_check_frame_call_children(error_call, error_facts, error_names, error_values, frame_parameters, changes, preserves, functions, report, name, annotations)
                    error_call <- proof_substitute(error_call, error_names, error_values)
                    error_applied <- proof_apply_function(error_call, Ast::Expr.Invalid, &error_facts, functions, error_names, frame_parameters, changes, preserves, report, name, annotations)
                    proof_check_opaque_call_frame(error_call, error_names, frame_parameters, changes, preserves, functions, report, name) if not error_applied
                _:
                    error_applied <- false
            error_function_name: sview = proof_callable_name(error_call)
            error_function_index: usize = proof_function_index(functions, error_function_name)
            error_is_pure: bool = error_applied and error_function_index < functions.pure.count and functions.pure[error_function_index]
            if error_is_pure:
                error_facts.clear()
                error_facts.extend(facts)
                error_names <- proof_copy_names(names)
                error_values <- proof_copy_exprs(values)
            else:
                proof_clear_facts_after_call(error_facts, error_names, frame_parameters, report, name)
                proof_forget_values(error_names, error_values, position)
            result_names: darray[sview] = ["result"]
            for arm_index in 0..<arms.count |arm_index, arms, success_names, success_values, success_facts, error_names, error_values, error_facts, success_call, ensures, frame_parameters, old_values, report, name, annotations, position|:
                arm: Ast::MatchArm = arms[arm_index]
                arm_names: mutable darray[sview] = proof_copy_names(success_names) if arm_index == 0 else proof_copy_names(error_names)
                arm_values: mutable darray[Ast::Expr] = proof_copy_exprs(success_values) if arm_index == 0 else proof_copy_exprs(error_values)
                arm_facts: mutable darray[Ast::Expr] = proof_copy_exprs(success_facts) if arm_index == 0 else proof_copy_exprs(error_facts)
                binding_source: Ast::Expr = success_call if arm_index == 0 else Ast::Expr.Invalid
                pattern_supported: bool = proof_bind_pattern(arm.pattern, position, binding_source, &arm_names, &arm_values)
                if not pattern_supported:
                    report.proof_obligation(false)
                    proof_add_finding(report, "pattern-unsupported", position.line, name, "catch pattern bindings are not modeled for proof-state substitution")
                    arm_facts.clear()
                arm_value: (known: bool, value: Ast::Expr) = proof_catch_arm_value(arm)
                if not arm_value.known:
                    report.proof_obligation(false)
                    proof_add_finding(report, "catch-arm-unsupported", position.line, name, "catch value arms must contain exactly one expression")
                if pattern_supported and arm_value.known:
                    returned_value: mutable Ast::Expr = proof_substitute(arm_value.value, arm_names, arm_values)
                    arm_call_applied: mutable bool = false
                    match arm_value.value:
                        Ast::Expr.Call(_, _, _, _):
                            proof_check_frame_call_children(arm_value.value, arm_facts, arm_names, arm_values, frame_parameters, changes, preserves, functions, report, name, annotations)
                            returned_value <- proof_substitute(arm_value.value, arm_names, arm_values)
                            arm_call_applied <- proof_apply_function(returned_value, returned_value, &arm_facts, functions, arm_names, frame_parameters, changes, preserves, report, name, annotations)
                            proof_check_opaque_call_frame(returned_value, arm_names, frame_parameters, changes, preserves, functions, report, name) if not arm_call_applied
                            returned_value <- Ast::Expr.Invalid if not arm_call_applied
                        _:
                            proof_check_frame_calls_in_expression(arm_value.value, arm_facts, arm_names, arm_values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(arm_value.value)
                            returned_value <- proof_substitute(arm_value.value, arm_names, arm_values) if proof_expr_has_call(arm_value.value)
                    returned_value <- proof_rewrite_pure_call_summaries(returned_value, arm_facts, functions, 0) if proof_expr_has_call(returned_value)
                    proof_clear_facts_after_call(arm_facts, arm_names, frame_parameters, report, name) if proof_expr_has_call(returned_value) and not arm_call_applied
                    result_values: darray[Ast::Expr] = [returned_value]
                    for ensure in ensures |ensure, arm_values, old_values, frame_parameters, result_names, result_values, arm_facts, report, name, annotations, position|:
                        current_goal: Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, arm_values, old_values)
                        goal: mutable Ast::Expr = proof_substitute(current_goal, result_names, result_values)
                        goal <- proof_rewrite_pure_call_summaries(goal, arm_facts, functions, 0) if proof_expr_has_call(goal)
                        proof_add_pure_call_witnesses(goal, arm_facts, functions, report, position.line, name, 0) if proof_expr_has_call(goal)
                        proven: bool = proof_certify_goal(arm_facts, goal, report, position.line, name, annotations)
                        report.proof_obligation(proven)
                        proof_add_goal_failure(report, "ensure-unproven", position.line, name, "catch arm value does not establish ensure", arm_facts, goal) if not proven

        # A value match is a branch join, not a textual conditional. When an arm contains a
        # pure executable call, check that arm in an isolated proof state and route its value
        # through the ordinary return checker. This preserves call preconditions, callee
        # postconditions, pattern facts, and caller ensures without letting one arm's summary
        # facts justify another arm.
        def proof_check_value_match_return(scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], names: darray[sview]&, values: darray[Ast::Expr]&, facts: darray[Ast::Expr]&, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[sview]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, position: Ast::Pos) -> void:
            scrutinee_value: Ast::Expr = proof_substitute(scrutinee, names, values)
            for arm in arms |arms, names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, scrutinee_value, position|:
                arm_names: mutable darray[sview] = proof_copy_names(names)
                arm_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                arm_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                pattern_supported: bool = proof_match_closed_pattern(arm.pattern) and proof_bind_pattern(arm.pattern, position, scrutinee_value, &arm_names, &arm_values)
                if not pattern_supported:
                    report.proof_obligation(false)
                    proof_add_finding(report, "pattern-unsupported", position.line, name, "value-match pattern cannot enter a verified proof state")
                pattern_condition: Ast::Expr? = proof_pattern_condition(arm.pattern, scrutinee_value, position) if pattern_supported else null
                if pattern_condition is condition:
                    proof_add_traced_fact(arm_facts, report, condition, "branch-condition", position.line, name)
                else:
                    match arm.pattern:
                        Ast::Pattern.Wildcard:
                            pass
                        _:
                            if pattern_supported:
                                report.proof_obligation(false)
                                proof_add_finding(report, "pattern-unsupported", position.line, name, "value-match pattern has no exact logical condition")
                match arm.guard:
                    Ast::Expr.Absent:
                        pass
                    _:
                        guard_supported: bool = proof_expr_supported(arm.guard) and not proof_expr_has_call(arm.guard) and not proof_expr_has_move(arm.guard)
                        if not guard_supported:
                            report.proof_obligation(false)
                            proof_add_finding(report, "expression-unsupported", position.line, name, "value-match guard cannot enter a verified proof state")
                        else:
                            guard_value: Ast::Expr = proof_substitute(arm.guard, arm_names, arm_values)
                            proof_add_traced_fact(arm_facts, report, guard_value, "branch-condition", position.line, name)
                if arm.body.count != 1:
                    report.proof_obligation(false)
                    proof_add_finding(report, "expression-unsupported", position.line, name, "value-match arms must contain exactly one expression")
                    continue
                arm_value: mutable Ast::Expr = Ast::Expr.Invalid
                arm_value_known: mutable bool = false
                match arm.body[0]:
                    Ast::Stmt.Expr(value, _):
                        arm_value <- value
                        arm_value_known <- true
                    _:
                        pass
                if not arm_value_known:
                    report.proof_obligation(false)
                    proof_add_finding(report, "expression-unsupported", position.line, name, "value-match arms must end in an expression")
                    continue
                synthetic_body: darray[Ast::Stmt] = [Ast::Stmt.Return(arm_value, position)]
                arm_flow: mutable ProofFlow = proof_empty_flow()
                proof_check_returns(synthetic_body, &arm_names, &arm_values, &arm_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &arm_flow)

        # Check one exact loop back-edge. Every edge gets its own post-body facts; sharing the
        # entry context here would allow a condition or assertion from one branch to justify a
        # A captured block statement: `for x in xs |a, b|: ...` reaches the statement walker as an
        # expression statement holding a block with a capture list, not as `Ast::Stmt.For`. The
        # shape gate refuses such a block on purpose — a captured block writes back into its outer
        # bindings, and accepting it as a pure expression would let an outer fact survive a hidden
        # mutation. In *statement* position the value is discarded, so the write-back can simply be
        # modelled instead: check the body in a private state so no nested obligation is skipped,
        # then havoc the outer symbolic values and facts exactly as an opaque call boundary does.
        #
        # That is strictly better than refusing, which invalidates the whole enclosing path and so
        # costs every obligation after the loop as well as the function's own summary.
        def proof_captured_block_statement(statement: Ast::Stmt) -> (known: bool, body: darray[Ast::Stmt], captures: darray[sview], position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            empty: mutable darray[Ast::Stmt] = []
            empty_captures: mutable darray[sview] = []
            match statement:
                Ast::Stmt.Expr(expression, _):
                    match expression:
                        Ast::Expr.Block(statements, value, captures, position):
                            return (false, empty, empty_captures, position) if captures.count == 0
                            # The statement position discards the block's result, but the trailing
                            # value is still evaluated and may carry obligations of its own. Append
                            # it as an ordinary expression statement so the body walk checks it;
                            # `Absent` and `Invalid` are the parser's "no result" markers and carry
                            # nothing to check.
                            body: mutable darray[Ast::Stmt] = []
                            body.extend(statements)
                            match value:
                                Ast::Expr.Absent:
                                    pass
                                Ast::Expr.Invalid:
                                    pass
                                _:
                                    body.push(Ast::Stmt.Expr(value, position))
                            block_captures: mutable darray[sview] = []
                            block_captures.extend(captures)
                            return (true, body, block_captures, position)
                        _:
                            pass
                _:
                    pass
            return (false, empty, empty_captures, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})

        # different branch's termination step.
        def proof_check_decreases_step(measure_components: darray[Ast::Expr]&, decreases_components: darray[Ast::Expr]&, next_names: darray[sview]&, next_values: darray[Ast::Expr]&, next_facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, report: mutable ProofReport&, name: sview, position: Ast::Pos) -> bool:
            next_components: mutable darray[Ast::Expr] = []
            for component in decreases_components |next_components, next_names, next_values|:
                next_components.push(proof_substitute(component, next_names, next_values))
            next_nonnegative_proven: mutable bool = true
            for next_measure in next_components |next_facts, annotations, report, name, position, next_nonnegative_proven|:
                next_measure_nonnegative: Ast::Expr = Ast::Expr.Binary(next_measure, TokenKind.GtEq, Ast::Expr.IntLit(0), Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0})
                next_component_proven: bool = proof_certify_goal(next_facts, next_measure_nonnegative, report, position.line, name, annotations)
                report.proof_obligation(next_component_proven)
                next_nonnegative_proven <- false if not next_component_proven
                proof_add_latest_goal_finding(report, "loop-decreases-unproven", position.line, name, "decreases component is not proven nonnegative after one loop step") if not next_component_proven
            # Emit the descent goal even when a separate nonnegativity premise failed. Every
            # counted failure must have its own repairable goal rather than borrowing the ID of
            # the preceding component obligation.
            decreasing_proven: bool = proof_lexicographic_smaller(measure_components, next_components, next_facts, annotations, Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0}, report, name)
            report.proof_obligation(decreasing_proven)
            proof_add_latest_goal_finding(report, "loop-decreases-unproven", position.line, name, "decreases lexicographic measure is not proven to strictly decrease") if not decreasing_proven
            return next_nonnegative_proven and decreasing_proven

        def proof_check_returns(body: darray[Ast::Stmt]&, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, facts: mutable darray[Ast::Expr]&, ensures: darray[Ast::Expr]&, lemmas: ProofLemmaTable&, functions: ProofFunctionTable&, frame_parameters: darray[sview]&, old_values: darray[Ast::Expr]&, changes: darray[ProofFramePlace]&, preserves: darray[ProofFramePlace]&, fixed_names: darray[sview]&, fixed_extents: darray[i64]&, report: mutable ProofReport&, name: sview, lemma_steps: bool, annotations: darray[Ast::EnumAnnotation]&, loop_depth: usize, loop_label: sview, loop_invariants: darray[Ast::Expr]&, loop_scope_count: usize, flow: mutable ProofFlow&) -> void:
            flow.normal <- true
            flow.breaks <- false
            flow.continues <- false
            flow.valid <- true
            proof_clear_continue_states(flow)
            for statement in body |names, values, facts, ensures, lemmas, functions, fixed_names, fixed_extents, report, name, lemma_steps, flow|:
                # Once a path returns or transfers to a loop edge, later statements cannot
                # affect the state on that path. The compiler separately diagnoses unreachable
                # source; the proof checker still handles all reachable paths conservatively.
                continue if not flow.normal
                moved_roots: mutable darray[sview] = []
                proof_statement_move_roots(statement, &moved_roots)
                statement_facts: darray[Ast::Expr] = proof_copy_exprs(facts)
                declared_name: sview = proof_statement_declared_name(statement)
                captured_block: (known: bool, body: darray[Ast::Stmt], captures: darray[sview], position: Ast::Pos) = proof_captured_block_statement(statement)
                if captured_block.known:
                    # The body is checked against the same postconditions, so a `return` inside it
                    # still has to establish them; `break` and `continue` are absorbed by the loop
                    # and never reach the enclosing function.
                    block_names: mutable darray[sview] = proof_copy_names(names)
                    block_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                    block_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                    block_flow: mutable ProofFlow = proof_empty_flow()
                    empty_block_invariants: mutable darray[Ast::Expr] = []
                    proof_check_returns(captured_block.body, &block_names, &block_values, &block_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth + 1, "", empty_block_invariants, 0, &block_flow)
                    flow.valid <- false if not block_flow.valid
                    # The loop itself is not verified: no invariant relates its iterations, so the
                    # obligation is recorded as failing while the enclosing path stays checkable.
                    report.proof_obligation(false)
                    proof_add_finding(report, "captured-block-unsupported", captured_block.position.line, name, "a captured block's write-back is havocked rather than modeled")
                    proof_forget_captured_values(names, values, statement_facts, captured_block.captures, frame_parameters, report, name, captured_block.position)
                    proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                    # A captured block can name only what its capture list names, so a fact over
                    # bindings the list does not mention survives it. Import those under exactly
                    # the rule the opaque call boundary uses: `proof_expr_call_stable` refuses an
                    # aliased or unwitnessed name, so a binding the block could still reach
                    # through a captured reference is never restored here.
                    proof_restore_uncaptured_facts(statement_facts, captured_block.captures, facts, names, frame_parameters, report, name)
                    continue
                if not proof_statement_expressions_supported(statement, functions):
                    unsupported_position: Ast::Pos = proof_statement_position(statement)
                    flow.valid <- false
                    report.proof_obligation(false)
                    proof_add_finding(report, "expression-unsupported", unsupported_position.line, name, "unsupported runtime expression cannot enter a verified proof state")
                    proof_forget_values(names, values, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0})
                    # Whatever the expression does, it reaches an unreferenced by-value scalar
                    # local no more than a call does; the alias analysis covered this expression.
                    proof_clear_facts_after_call(facts, names, frame_parameters, report, name)
                getelse: (known: bool, recovery: darray[Ast::Stmt], line: u32) = proof_statement_getelse_recovery(statement)
                if getelse.known and proof_statement_expressions_supported(statement, functions):
                    # The absent/error branch is a real control-flow path. Check it against a
                    # cloned state, then retain only its terminating transfer for the enclosing
                    # statement. In particular, a recovery return/break/continue must not leak
                    # its local mutations or facts into the successful value path.
                    recovery_names: mutable darray[sview] = proof_copy_names(names)
                    recovery_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                    recovery_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                    recovery_flow: mutable ProofFlow = proof_empty_flow()
                    proof_check_returns(getelse.recovery, &recovery_names, &recovery_values, &recovery_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &recovery_flow)
                    flow.valid <- false if not recovery_flow.valid
                    flow.valid <- false if recovery_flow.normal
                    flow.breaks <- flow.breaks or recovery_flow.breaks
                    flow.continues <- flow.continues or recovery_flow.continues
                    proof_append_continue_states(flow, recovery_flow)
                    if recovery_flow.normal:
                        report.proof_obligation(false)
                        proof_add_finding(report, "getelse-recovery-nonterminating", getelse.line, name, "get/try recovery must terminate on every path")
                proof_check_statement_index_safety(statement, facts, names, values, fixed_names, fixed_extents, report, name, annotations, functions)
                match statement:
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                        value: mutable Ast::Expr = proof_substitute(initializer, names, values)
                        prior_value_count: usize = values.count
                        shadowed: mutable bool = false
                        for existing_name in names |shadowed, local_name|:
                            shadowed <- true if existing_name == local_name
                        call_applied: mutable bool = false
                        match value:
                            Ast::Expr.Call(_, _, _, _):
                                proof_check_frame_call_children(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                                call_applied <- proof_apply_function(value, value, facts, functions, names, frame_parameters, changes, preserves, report, name, annotations)
                                proof_check_opaque_call_frame(value, names, frame_parameters, changes, preserves, functions, report, name) if not call_applied
                                value <- Ast::Expr.Invalid if not call_applied
                            _:
                                proof_check_frame_calls_in_expression(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(initializer)
                                value <- proof_substitute(initializer, names, values) if proof_expr_has_call(initializer)
                        # A declaration's initializer is evaluated before its binding enters
                        # scope. Commit the new local only after nested calls have seen the
                        # pre-declaration environment; otherwise `x: T = f(x)` would pass the
                        # freshly assigned x back into f instead of the outer x.
                        # The spelling may already denote an earlier symbol: a shadowed local,
                        # a parameter, or a binding forgotten to its own name. Purge everything
                        # that refers to that symbol before it denotes the new binding; a value
                        # that mentions its own new name has no expressible meaning either.
                        proof_resymbolize_binding(names, values, facts, report, name, local_name, position)
                        value <- Ast::Expr.Invalid if proof_expr_mentions_name(value, local_name)
                        names <- names.push(local_name)
                        values <- values.push(value)
                        values[prior_value_count] <- value if proof_expr_has_call(initializer) and prior_value_count < values.count
                        unsigned_width: i64 = proof_unsigned_type_width(type_expression, report.source_declarations, 0)
                        if unsigned_width < 0:
                            values[prior_value_count] <- Ast::Expr.Invalid
                            proof_add_finding(report, "contract-expression-unsupported", position.line, name, "local numeric type alias cannot be resolved uniquely")
                        if proof_expr_has_call(initializer):
                            # The new local contains the call result, so retain its binding, but
                            # forget every pre-existing binding that the call may have mutated.
                            proof_forget_values_before(names, values, prior_value_count, position)
                        proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name) if shadowed
                        proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if not shadowed and proof_expr_has_call(initializer) and not call_applied
                        proof_bind_unsigned_symbol(names, values, facts, report, name, prior_value_count, unsigned_width, value, position) if unsigned_width > 0
                        # A scalar local carries the same primitive-type witness as a parameter, so
                        # equality reasoning over it is not held back by the binding form. An
                        # unsigned width marker already witnesses the same thing.
                        local_scalar_kind: i64 = proof_scalar_type_kind(type_expression, report.source_declarations, 0)
                        proof_add_type_bound_fact(facts, report, proof_scalar_type_marker(local_name, position), position.line, name) if local_scalar_kind == 1 and unsigned_width <= 0
                        proof_bind_scalar_symbol(names, values, prior_value_count, position) if local_scalar_kind == 1 and unsigned_width <= 0
                        local_witness_budget: mutable usize = PROOF_SCALAR_WITNESS_BUDGET
                        proof_add_scalar_witnesses(facts, report, Ast::Expr.Ident(local_name, position), type_expression, position.line, name, position, &local_witness_budget, 0) if local_scalar_kind != 1
                    Ast::Stmt.Assign(target, operator, initializer, position):
                        target_name: sview = proof_ident_name(target)
                        if target_name != "":
                            proof_check_direct_frame_write(proof_substitute(target, names, values), names, frame_parameters, changes, preserves, report, name, position.line)
                            value: mutable Ast::Expr = proof_substitute(initializer, names, values)
                            slot: mutable usize = names.count
                            target_slot: mutable usize = names.count
                            while slot > 0 |slot, names, target_name|:
                                slot <- slot - 1
                                if names[slot] == target_name:
                                    target_slot <- slot
                                    # Only a plain rebind has the RHS as the new value. A
                                    # compound assignment (`+=`, `-=`, …) depends on the old
                                    # value and is opaque until the assignment algebra is modeled.
                                    values[slot] <- Ast::Expr.Absent if operator != TokenKind.LArrow and operator != TokenKind.Assign
                                    break
                            call_applied: mutable bool = false
                            match value:
                                Ast::Expr.Call(_, _, _, _):
                                    proof_check_frame_call_children(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if operator == TokenKind.LArrow or operator == TokenKind.Assign
                                    call_applied <- proof_apply_function(value, value, facts, functions, names, frame_parameters, changes, preserves, report, name, annotations) if operator == TokenKind.LArrow or operator == TokenKind.Assign
                                    proof_check_opaque_call_frame(value, names, frame_parameters, changes, preserves, functions, report, name) if not call_applied
                                    value <- Ast::Expr.Invalid if not call_applied
                                    proof_check_frame_calls_in_expression(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if operator != TokenKind.LArrow and operator != TokenKind.Assign
                                    value <- proof_substitute(initializer, names, values) if operator != TokenKind.LArrow and operator != TokenKind.Assign
                                _:
                                    proof_check_frame_calls_in_expression(initializer, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(initializer)
                                    value <- proof_substitute(initializer, names, values) if proof_expr_has_call(initializer)
                            values[target_slot] <- value if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and target_slot < values.count
                            if proof_expr_has_call(initializer):
                                if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and target_slot < values.count:
                                    # Preserve the assigned result, but do not let the call's
                                    # possible mutation of another binding survive this point.
                                    proof_forget_values_except(names, values, target_slot, position)
                                else:
                                    proof_forget_values(names, values, position)
                            # An unsigned local keeps its width by staying symbolic; its new
                            # value becomes an equality fact when it is range-safe.
                            rebound_width: i64 = proof_unsigned_marker_width_for_name(facts, target_name) if target_slot < values.count else 0
                            proof_bind_unsigned_symbol(names, values, facts, report, name, target_slot, rebound_width, value, position) if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and rebound_width > 0
                            # A compound assignment still executes its RHS call, but the
                            # resulting value depends on the old target and is not modeled.
                            # Discard all facts after it, including when the RHS call had a
                            # usable executable summary. The target denotes a new opaque value,
                            # so bindings that recorded the old symbol are forgotten with it.
                            proof_resymbolize_binding(names, values, facts, report, name, target_name, position) if operator != TokenKind.LArrow and operator != TokenKind.Assign
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name) if operator != TokenKind.LArrow and operator != TokenKind.Assign
                            # A plain local rebind is represented in `values`, so keep facts
                            # about prior symbolic values available for the substitution-based
                            # postcondition check. Parameter rebinding is different: it changes
                            # an externally visible root, so all facts must be discarded. Calls
                            # still clear facts when no checked summary was applied.
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name) if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and proof_current_parameter(names, frame_parameters, target_name)
                            proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if (operator == TokenKind.LArrow or operator == TokenKind.Assign) and proof_expr_has_call(initializer) and not call_applied
                        else:
                            # Field/index/compound assignments can mutate aliases whose
                            # dependencies are not represented in this small state model.
                            proof_check_direct_frame_write(proof_substitute(target, names, values), names, frame_parameters, changes, preserves, report, name, position.line)
                            proof_clear_facts_after_call(facts, names, frame_parameters, report, name)
                    Ast::Stmt.Contract(kind, expression, position):
                        if kind == "assert":
                            assertion: mutable Ast::Expr = proof_substitute(expression, names, values)
                            assertion_has_call: bool = proof_expr_has_call(expression)
                            # The assertion expression is evaluated at runtime before its
                            # proposition becomes a fact. Any nested call can invalidate prior
                            # state, so check its frame/precondition boundary and discard all
                            # pre-call facts before publishing the assertion itself.
                            proof_check_frame_calls_in_expression(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if assertion_has_call
                            proof_forget_values(names, values, position) if assertion_has_call
                            proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if assertion_has_call
                            if lemma_steps:
                                assertion_proven: bool = proof_certify_goal(facts, assertion, report, position.line, name, annotations)
                                report.proof_obligation(assertion_proven)
                                proof_add_derived_fact(facts, report, assertion, "lemma-step", position.line, name) if assertion_proven
                                proof_add_goal_failure(report, "lemma-step-unproven", position.line, name, "lemma proof step is not entailed by earlier facts", facts, assertion) if not assertion_proven
                            else:
                                proof_add_traced_fact(facts, report, assertion, "runtime-assert", position.line, name) if proof_runtime_fact_is_stable(assertion, functions)
                    Ast::Stmt.Expr(expression, position):
                        substituted_expression: mutable Ast::Expr = proof_substitute(expression, names, values)
                        terminal_expression: bool = proof_expression_is_terminal(expression)
                        match expression:
                            Ast::Expr.Call(callee, arguments, _, _):
                                proof_check_frame_call_children(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                                if proof_callable_name(callee) == "assert" and arguments.count == 1:
                                    assertion_call: Ast::Expr = proof_substitute(arguments[0], names, values)
                                    assertion_has_call: bool = proof_expr_has_call(arguments[0])
                                    # `assert(expr)` evaluates expr before publishing it. Do not
                                    # retain facts that a nested executable call may have
                                    # invalidated, even when the outer builtin is pure.
                                    proof_forget_values(names, values, position) if assertion_has_call
                                    proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if assertion_has_call
                                    if lemma_steps:
                                        call_assertion_proven: bool = proof_certify_goal(facts, assertion_call, report, position.line, name, annotations)
                                        report.proof_obligation(call_assertion_proven)
                                        proof_add_derived_fact(facts, report, assertion_call, "lemma-step", position.line, name) if call_assertion_proven
                                        proof_add_goal_failure(report, "lemma-step-unproven", position.line, name, "lemma proof step is not entailed by earlier facts", facts, assertion_call) if not call_assertion_proven
                                    else:
                                        proof_add_traced_fact(facts, report, assertion_call, "runtime-assert", position.line, name) if proof_runtime_fact_is_stable(assertion_call, functions)
                                if proof_callable_name(callee) != "assert":
                                    # Lemma calls are valid only in proof blocks (which are
                                    # checked by proof_check_block). A normal executable body
                                    # cannot gain ghost facts from an erased declaration.
                                    applied_lemma: mutable bool = false
                                    applied_lemma <- proof_apply_lemma(substituted_expression, facts, lemmas, names, values, report, name, annotations) if lemma_steps
                                    if not applied_lemma:
                                        applied_function: bool = proof_apply_function(substituted_expression, Ast::Expr.Absent, facts, functions, names, frame_parameters, changes, preserves, report, name, annotations)
                                        proof_check_opaque_call_frame(substituted_expression, names, frame_parameters, changes, preserves, functions, report, name) if not applied_function
                                        proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if not applied_function
                                        # A statement call has no result binding to carry forward;
                                        # even a framed summary may have changed an untracked local
                                        # alias, so forget symbolic values at the call boundary.
                                        proof_forget_values(names, values, position)
                            _:
                                proof_check_frame_calls_in_expression(expression, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(expression)
                                substituted_expression <- proof_substitute(expression, names, values) if proof_expr_has_call(expression)
                                proof_forget_values(names, values, position) if proof_expr_has_call(expression)
                                proof_clear_facts_after_call(facts, names, frame_parameters, report, name)
                        flow.normal <- false if terminal_expression
                    Ast::Stmt.Return(value, position):
                        if value is returned:
                            match returned:
                                Ast::Expr.Catch(guarded, arms, _):
                                    # Expression catches are checked arm-by-arm. The supported
                                    # shape is guaranteed by the statement admission gate above;
                                    # each arm receives its own post-state and the catch itself
                                    # is terminal at this return boundary.
                                    proof_check_catch_return(guarded, arms, names, values, facts, ensures, functions, frame_parameters, old_values, changes, preserves, report, name, annotations, position)
                                    flow.normal <- false
                                    continue
                                Ast::Expr.Match(scrutinee, arms, _):
                                    # A value match has one return value per arm. Checking the
                                    # lowered conditional as one expression would let a summary
                                    # fact from one arm justify another, so preserve the source
                                    # branch states and check each arm through a synthetic return.
                                    proof_check_value_match_return(scrutinee, arms, names, values, facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, position)
                                    flow.normal <- false
                                    continue
                                _:
                                    pass
                            return_value: mutable Ast::Expr = proof_substitute(returned, names, values)
                            return_call_applied: mutable bool = false
                            # Only a syntactic call at the return site is evaluated here. If a
                            # local already contains a summarized call result, substituting it
                            # produces a Call-shaped value but must not execute/apply that call a
                            # second time; the declaration or assignment already established its
                            # postcondition and may have consumed the caller's pre-call facts.
                            match returned:
                                Ast::Expr.Call(_, _, _, _):
                                    proof_check_frame_call_children(returned, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                                    return_call_applied <- proof_apply_function(return_value, return_value, facts, functions, names, frame_parameters, changes, preserves, report, name, annotations)
                                    proof_check_opaque_call_frame(return_value, names, frame_parameters, changes, preserves, functions, report, name) if not return_call_applied
                                    return_value <- Ast::Expr.Invalid if not return_call_applied
                                Ast::Expr.GetElse(guarded, _, _):
                                    # A GetElse is transparent only after its recovery has been
                                    # checked. If its successful value is a syntactic call, apply
                                    # that summary exactly once here, just as for `return call()`.
                                    # This is distinct from a substituted local whose value merely
                                    # happens to have Call shape.
                                    match guarded:
                                        Ast::Expr.Call(_, _, _, _):
                                            proof_check_frame_call_children(guarded, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations)
                                            return_call_applied <- proof_apply_function(return_value, return_value, facts, functions, names, frame_parameters, changes, preserves, report, name, annotations)
                                            proof_check_opaque_call_frame(return_value, names, frame_parameters, changes, preserves, functions, report, name) if not return_call_applied
                                            return_value <- Ast::Expr.Invalid if not return_call_applied
                                        _:
                                            pass
                                _:
                                    proof_check_frame_calls_in_expression(returned, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if proof_expr_has_call(returned)
                                    return_value <- proof_substitute(returned, names, values) if proof_expr_has_call(returned)
                            return_value <- proof_rewrite_pure_call_summaries(return_value, facts, functions, 0) if proof_expr_has_call(return_value)
                            proof_clear_facts_after_call(facts, names, frame_parameters, report, name) if proof_expr_has_call(return_value) and not return_call_applied
                            proof_invalidate_moved_roots(moved_roots, names, values, facts, report, name, position)
                            result_name: mutable darray[sview] = ["result"]
                            result_value: mutable darray[Ast::Expr] = [return_value]
                            for ensure in ensures |report, name, facts, result_name, result_value, position|:
                                current_goal: Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, values, old_values)
                                goal: mutable Ast::Expr = proof_substitute(current_goal, result_name, result_value)
                                goal <- proof_rewrite_pure_call_summaries(goal, facts, functions, 0) if proof_expr_has_call(goal)
                                proof_add_pure_call_witnesses(goal, facts, functions, report, position.line, name, 0) if proof_expr_has_call(goal)
                                proven: bool = proof_certify_goal_with_rule(facts, goal, report, position.line, name, annotations, proof_quantifier_rule(ensure, annotations))
                                report.proof_obligation(proven)
                                proof_add_goal_failure(report, "ensure-unproven", position.line, name, "return value does not establish ensure", facts, goal) if not proven
                        else:
                            # A void return still completes normally and must establish its
                            # postconditions. There is no result binding to substitute, so a
                            # result-dependent ensure fails closed rather than disappearing.
                            for ensure in ensures |report, name, facts, names, values, frame_parameters, old_values, annotations, position|:
                                goal: Ast::Expr = proof_substitute_function_contract(ensure, frame_parameters, values, old_values)
                                proven: mutable bool = false
                                if proof_expr_mentions_name(goal, "result"):
                                    failed_rule: mutable sview = proof_quantifier_rule(ensure, annotations)
                                    failed_rule <- "goal" if failed_rule == ""
                                    proof_add_goal_attempt(report, facts, goal, position.line, name, failed_rule, false)
                                else:
                                    proven <- proof_certify_goal_with_rule(facts, goal, report, position.line, name, annotations, proof_quantifier_rule(ensure, annotations))
                                report.proof_obligation(proven)
                                proof_add_goal_failure(report, "ensure-unproven", position.line, name, "void return does not establish ensure", facts, goal) if not proven
                            proof_invalidate_moved_roots(moved_roots, names, values, facts, report, name, position)
                        flow.normal <- false
                    Ast::Stmt.If(condition, then_body, else_body, position):
                        condition_value: mutable Ast::Expr = proof_substitute(condition, names, values)
                        condition_has_call: bool = proof_expr_has_call(condition)
                        condition_facts_stable: bool = not condition_has_call or proof_contract_calls_are_pure(condition, functions)
                        proof_check_frame_calls_in_expression(condition, facts, names, values, frame_parameters, changes, preserves, functions, report, name, annotations) if condition_has_call
                        proof_forget_values(names, values, position) if condition_has_call
                        branch_value_count: usize = values.count
                        then_names: mutable darray[sview] = proof_copy_names(names)
                        then_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                        then_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                        then_flow: mutable ProofFlow = proof_empty_flow()
                        proof_clear_facts_after_call(then_facts, names, frame_parameters, report, name) if condition_has_call and not condition_facts_stable
                        proof_add_branch_condition_facts(then_facts, report, condition_value, position.line, name)
                        proof_check_returns(then_body, &then_names, &then_values, &then_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &then_flow)
                        else_names: mutable darray[sview] = proof_copy_names(names)
                        else_values: mutable darray[Ast::Expr] = proof_copy_exprs(values)
                        else_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
                        else_flow: mutable ProofFlow = proof_empty_flow()
                        negated: Ast::Expr = proof_branch_negation(condition_value, Ast::Pos{line: position.line, column: 0, offset: 0, end_line: position.line, end_column: 0, end_offset: 0})
                        proof_clear_facts_after_call(else_facts, names, frame_parameters, report, name) if condition_has_call and not condition_facts_stable
                        proof_add_branch_condition_facts(else_facts, report, negated, position.line, name)
                        proof_check_returns(else_body, &else_names, &else_values, &else_facts, ensures, lemmas, functions, frame_parameters, old_values, changes, preserves, fixed_names, fixed_extents, report, name, lemma_steps, annotations, loop_depth, loop_label, loop_invariants, loop_scope_count, &else_flow)
                        then_falls_through: bool = then_flow.normal
                        else_falls_through: bool = else_flow.normal
                        flow.breaks <- then_flow.breaks or else_flow.breaks
                        flow.continues <- then_flow.continues or else_flow.continues
                        flow.valid <- then_flow.valid and else_flow.valid
                        proof_append_continue_states(flow, then_flow)
                        proof_append_continue_states(flow, else_flow)
                        # If one branch definitely terminates, the other branch is the complete
                        # state at the following statement. Merge only the surviving branch and
                        # only when it did not introduce a branch-local binding; leaking a local
                        # name or a fact mentioning it would be unsound. When both branches can
                        # continue, retain the pre-branch state as a conservative intersection.
                        if not then_falls_through and else_falls_through:
                            if condition_facts_stable and else_names.count == names.count and else_values.count >= branch_value_count:
                                for index in 0..<branch_value_count |index, values, else_values|:
                                    values[index] <- else_values[index]
                                facts.clear()
                                facts.extend(else_facts)
                            else:
                                proof_forget_values(names, values, position)
                                proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                                # Control reaches the next statement only through the surviving
                                # branch, so its end state holds here. The opaque condition call
                                # forbids importing that state wholesale, but a call-stable fact
                                # is over by-value scalars of this frame that nothing references:
                                # true at the end of the branch means true at this point.
                                proof_restore_call_stable_facts(else_facts, facts, names, frame_parameters, report, name) if else_names.count == names.count
                        elif then_falls_through and not else_falls_through:
                            if condition_facts_stable and then_names.count == names.count and then_values.count >= branch_value_count:
                                for index in 0..<branch_value_count |index, values, then_values|:
                                    values[index] <- then_values[index]
                                facts.clear()
                                facts.extend(then_facts)
                            else:
                                proof_forget_values(names, values, position)
                                proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                                proof_restore_call_stable_facts(then_facts, facts, names, frame_parameters, report, name) if then_names.count == names.count
                        elif not then_falls_through and not else_falls_through:
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                            flow.normal <- false
                        if not lemma_steps and (proof_body_may_modify(then_body) or proof_body_may_modify(else_body)):
                            proof_forget_values(names, values, position)
                            proof_clear_facts_keep_type_bounds(facts, names, frame_parameters, report, name)
                            # The arms were executed symbolically, so a fact still standing at a
                            # surviving arm's exit is true on that path. Import the call-stable
                            # ones from the paths that actually reach this statement.
                            if then_falls_through and else_falls_through:
                                proof_restore_branch_stable_facts(then_facts, else_facts, facts, names, frame_parameters, report, name)
                            elif then_falls_through:
                                proof_restore_call_stable_facts(then_facts, facts, names, frame_parameters, report, name)
                            elif else_falls_through:
                                proof_restore_call_stable_facts(else_facts, facts, names, frame_parameters, report, name)
                    Ast::Stmt.While(condition, while_body, position):
                        # A loop without an invariant is not treated as verified. With one,
                        # establish and check preservation on the one symbolic iteration.
                        invariants: darray[Ast::Expr] = proof_contracts(while_body, "invariant")
