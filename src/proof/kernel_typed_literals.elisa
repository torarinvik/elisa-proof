# Source-neutral typed literal representation. Admission into the full arena
# remains separate: callers must also establish independent source correspondence.
extend ElisaProofKernelCore:
    public:
        def typed_literal_comparison(left: ProofKernelNode, operator: sview, right: ProofKernelNode) -> (known: bool, value: bool):
            return (false, false) if left.name != right.name
            a = typed_literal_value(left)
            b = typed_literal_value(right)
            return (false, false) if not a.known or not b.known
            return (true, a.bits == b.bits) if operator == "=="
            return (true, a.bits != b.bits) if operator == "!="
            return (true, a.bits < b.bits) if operator == "<"
            return (true, a.bits <= b.bits) if operator == "<="
            return (true, a.bits > b.bits) if operator == ">"
            return (true, a.bits >= b.bits) if operator == ">="
            return (false, false)

        def typed_literal_value(node: ProofKernelNode) -> (known: bool, bits: u64, unsigned: bool, width: i64):
            return (false, 0, false, 0) if node.kind != "typed-int"
            return (false, 0, false, 0) if node.operator != "" or node.left != 0 or node.right != 0 or node.auxiliary != 0 or node.children_start != 0 or node.children_count != 0 or node.secondary_name != ""
            unsigned: bool = node.name == "u8" or node.name == "u16" or node.name == "u32" or node.name == "u64"
            signed: bool = node.name == "i8" or node.name == "i16" or node.name == "i32" or node.name == "i64"
            return (false, 0, false, 0) if not unsigned and not signed
            width: i64 = 8 if node.name == "u8" or node.name == "i8" else 16 if node.name == "u16" or node.name == "i16" else 32 if node.name == "u32" or node.name == "i32" else 64
            # This node denotes a positive source token, not a unary expression.
            # Only u64 may have a negative i64 storage payload.
            return (false, 0, false, 0) if node.value < 0 and node.name != "u64"
            bits: u64 = node.value.u64()
            maximum: u64 = 255 if unsigned and width == 8 else 65535 if unsigned and width == 16 else 4294967295 if unsigned and width == 32 else 18446744073709551615u64 if unsigned else proof_kernel_signed_width_max(width).u64()
            return (false, 0, false, 0) if bits > maximum
            return (true, bits, unsigned, width)
