# Source-neutral typed literal representation. Admission into the full arena
# remains separate: callers must also establish independent source correspondence.
extend ElisaProofKernelCore:
    private:
        def typed_integer_sort(name: sview) -> (known: bool, unsigned: bool, width: i64):
            match name:
                "u8":
                    return (true, true, PROOF_KERNEL_U8_WIDTH)
                "u16":
                    return (true, true, PROOF_KERNEL_U16_WIDTH)
                "u32":
                    return (true, true, PROOF_KERNEL_U32_WIDTH)
                "u64":
                    return (true, true, PROOF_KERNEL_MACHINE_WORD_BITS)
                "i8":
                    return (true, false, PROOF_KERNEL_I8_WIDTH)
                "i16":
                    return (true, false, PROOF_KERNEL_I16_WIDTH)
                "i32":
                    return (true, false, PROOF_KERNEL_I32_WIDTH)
                "i64":
                    return (true, false, PROOF_KERNEL_I64_WIDTH)
                _:
                    return (false, false, 0)

        def typed_integer_maximum(unsigned: bool, width: i64) -> (known: bool, value: u64):
            return (false, 0) if width != PROOF_KERNEL_U8_WIDTH and width != PROOF_KERNEL_U16_WIDTH and width != PROOF_KERNEL_U32_WIDTH and width != PROOF_KERNEL_MACHINE_WORD_BITS
            return (true, proof_kernel_signed_width_max(width).u64()) if not unsigned
            return (true, PROOF_KERNEL_U8_MAX.u64()) if width == PROOF_KERNEL_U8_WIDTH
            return (true, PROOF_KERNEL_U16_MAX.u64()) if width == PROOF_KERNEL_U16_WIDTH
            return (true, PROOF_KERNEL_U32_MAX.u64()) if width == PROOF_KERNEL_U32_WIDTH
            return (true, PROOF_KERNEL_U64_MAX) if width == PROOF_KERNEL_MACHINE_WORD_BITS
            return (false, 0)

        def typed_literal_payload_is_canonical(node: ProofKernelNode) -> bool:
            return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.secondary_name == ""

    public:
        # Compute modulo 2^width without overflowing the host u64 intermediate.
        # Only explicit, matching unsigned sorts enter this rule.
        def typed_unsigned_add_sub(left: ProofKernelNode, operator: sview, right: ProofKernelNode) -> (known: bool, bits: u64, width: i64):
            return (false, 0, 0) if left.name != right.name or (operator != "+" and operator != "-")
            a = typed_literal_value(left)
            b = typed_literal_value(right)
            return (false, 0, 0) if not a.known or not b.known or not a.unsigned or not b.unsigned
            maximum: u64 = 255 if a.width == 8 else 65535 if a.width == 16 else 4294967295 if a.width == 32 else 18446744073709551615u64
            if operator == "+":
                room: u64 = maximum - b.bits
                return (true, a.bits - room - 1, a.width) if a.bits > room
                return (true, a.bits + b.bits, a.width)
            return (true, a.bits - b.bits, a.width) if a.bits >= b.bits
            difference: u64 = b.bits - a.bits
            return (true, maximum - difference + 1, a.width)

        def typed_literal_comparison(left: ProofKernelNode, operator: sview, right: ProofKernelNode) -> (known: bool, value: bool):
            return (false, false) if left.name != right.name
            a = typed_literal_value(left)
            b = typed_literal_value(right)
            return (false, false) if not a.known or not b.known
            return (true, a.bits == b.bits) if operator == "=="
            return (true, a.bits != b.bits) if operator == "!="
            return (true, a.bits < b.bits) if operator == "<"
            return (true, a.bits <= b.bits) if operator == "<="
            return (true, a.bits > b.bits) if operator == ">"
            return (true, a.bits >= b.bits) if operator == ">="
            return (false, false)

        def typed_literal_value(node: ProofKernelNode) -> (known: bool, bits: u64, unsigned: bool, width: i64):
            return (false, 0, false, 0) if node.kind != "typed-int"
            return (false, 0, false, 0) if not typed_literal_payload_is_canonical(node)
            sort: (known: bool, unsigned: bool, width: i64) = typed_integer_sort(node.name)
            return (false, 0, false, 0) if not sort.known
            # This node denotes a positive source token, not a unary expression.
            # Only u64 may have a negative i64 storage payload.
            return (false, 0, false, 0) if node.value < 0 and node.name != "u64"
            bits: u64 = node.value.u64()
            maximum: (known: bool, value: u64) = typed_integer_maximum(sort.unsigned, sort.width)
            return (false, 0, false, 0) if not maximum.known or bits > maximum.value
            return (true, bits, sort.unsigned, sort.width)
