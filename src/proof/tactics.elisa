# A small, reusable tactic interface for proof clients.
#
# The command-line report is intentionally observational. This module is the first
# state-transforming layer: an editor, an AI agent, or an Elisa program can build a
# proof state and apply typed proof actions without manufacturing facts. Every action
# either uses the existing proof decision procedure or performs a logically valid
# proposition transformation; failed actions leave the state unchanged.
extend ElisaProof:
    public:
        struct ProofTacticStep:
            action: sview
            accepted: bool
            goal: Ast::Expr
            facts_start: usize
            facts_count: usize
            solved: bool
            reason: sview
            argument: Ast::Expr
            secondary: Ast::Expr
            has_argument: bool
            has_secondary: bool
            argument_index: usize
            has_argument_index: bool
            detail: sview

        struct ProofTacticState:
            facts: mutable darray[Ast::Expr]
            goal: mutable Ast::Expr
            solved: mutable bool
            action_count: mutable usize
            last_action: mutable sview
            last_reason: mutable sview
            initial_facts: mutable darray[Ast::Expr]
            initial_goal: mutable Ast::Expr
            trace: mutable darray[ProofTacticStep]
            trace_facts: mutable darray[Ast::Expr]
            pending_argument: mutable Ast::Expr
            pending_secondary: mutable Ast::Expr
            pending_has_argument: mutable bool
            pending_has_secondary: mutable bool
            pending_argument_index: mutable usize
            pending_has_argument_index: mutable bool
            pending_detail: mutable sview

        def proof_tactic_copy_facts(source: darray[Ast::Expr]&) -> darray[Ast::Expr]:
            copied: mutable darray[Ast::Expr] = []
            copied.extend(source)
            return copied

        def proof_tactic_state(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> ProofTacticState:
            return ProofTacticState{facts: proof_tactic_copy_facts(facts), goal: goal, solved: false, action_count: 0, last_action: "start", last_reason: "state initialized", initial_facts: proof_tactic_copy_facts(facts), initial_goal: goal, trace: [], trace_facts: [], pending_argument: Ast::Expr.Absent, pending_secondary: Ast::Expr.Absent, pending_has_argument: false, pending_has_secondary: false, pending_argument_index: 0, pending_has_argument_index: false, pending_detail: ""}

        def proof_tactic_prepare(state: mutable ProofTacticState&, argument: Ast::Expr, secondary: Ast::Expr, argument_index: usize, has_argument_index: bool, has_secondary: bool) -> void:
            state.pending_argument <- argument
            state.pending_secondary <- secondary
            state.pending_has_argument <- true
            state.pending_has_secondary <- has_secondary
            state.pending_argument_index <- argument_index
            state.pending_has_argument_index <- has_argument_index
            state.pending_detail <- ""

        def proof_tactic_record(state: mutable ProofTacticState&, action: sview, accepted: bool, reason: sview) -> bool:
            state.action_count <- state.action_count + 1
            state.last_action <- action
            state.last_reason <- reason
            facts_start: usize = state.trace_facts.count
            state.trace_facts.extend(state.facts)
            state.trace.push(ProofTacticStep{action: action, accepted: accepted, goal: state.goal, facts_start: facts_start, facts_count: state.facts.count, solved: state.solved, reason: reason, argument: state.pending_argument, secondary: state.pending_secondary, has_argument: state.pending_has_argument, has_secondary: state.pending_has_secondary, argument_index: state.pending_argument_index, has_argument_index: state.pending_has_argument_index, detail: state.pending_detail})
            state.pending_argument <- Ast::Expr.Absent
            state.pending_secondary <- Ast::Expr.Absent
            state.pending_has_argument <- false
            state.pending_has_secondary <- false
            state.pending_argument_index <- 0
            state.pending_has_argument_index <- false
            state.pending_detail <- ""
            return accepted

        def proof_tactic_assumption(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_tactic_record(state, "assumption", false, "a solved goal cannot accept another action") if state.solved
            for fact in state.facts |fact, state, annotations|:
                if proof_expr_equal(fact, state.goal) or proof_quantifier_equal(fact, state.goal, annotations):
                    state.solved <- true
                    return proof_tactic_record(state, "assumption", true, "the goal is an explicit hypothesis")
            return proof_tactic_record(state, "assumption", false, "the goal is not an explicit hypothesis")

        # `exact` and `decide` are deliberately backed by the same bounded, overflow-aware
        # prover used by the source checker. This is a tactic API, not a second acceptance
        # path, so a successful state still has the same proof fragment and limits.
        def proof_tactic_decision(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, action: sview) -> bool:
            return proof_tactic_record(state, action, false, "a solved goal cannot accept another action") if state.solved
            proven: bool = proof_goal(state.facts, state.goal, annotations)
            if proven:
                state.solved <- true
                return proof_tactic_record(state, action, true, "the existing proof kernel entailed the goal")
            return proof_tactic_record(state, action, false, "the existing proof kernel could not entail the goal")

        def proof_tactic_exact(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_tactic_decision(state, annotations, "exact")

        def proof_tactic_decide(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_tactic_decision(state, annotations, "decide")

        # Normalize only closed, overflow-safe constants and closed Boolean connectives. The
        # routine deliberately does not use algebraic identities involving unknown expressions:
        # an indexed read, partial operation, or effectful call may not be interchangeable with
        # a logical shortcut in Elisa's execution semantics. Every arithmetic fold delegates to
        # the kernel's checked constant evaluator, so overflow and invalid division remain opaque.
        def proof_tactic_simplify_expression(expression: Ast::Expr) -> (changed: bool, value: Ast::Expr):
            match expression:
                Ast::Expr.Paren(inner, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression(inner)
                    return (true, Ast::Expr.Paren(rewritten.value, position)) if rewritten.changed
                    return (false, expression)
                Ast::Expr.Unary(operator, operand, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression(operand)
                    if operator == TokenKind.Not:
                        match rewritten.value:
                            Ast::Expr.BoolLit(value):
                                return (true, Ast::Expr.BoolLit(not value))
                            Ast::Expr.Unary(TokenKind.Not, inner, _):
                                return (true, inner)
                            _:
                                pass
                    candidate: Ast::Expr = Ast::Expr.Unary(operator, rewritten.value, position)
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        constant: (known: bool, value: i64) = proof_constant_int(candidate)
                        return (true, Ast::Expr.IntLit(constant.value)) if constant.known
                    return (rewritten.changed, candidate)
                Ast::Expr.Binary(left, operator, right, position):
                    rewritten_left: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression(left)
                    rewritten_right: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression(right)
                    candidate: Ast::Expr = Ast::Expr.Binary(rewritten_left.value, operator, rewritten_right.value, position)
                    if proof_is_comparison(operator):
                        left_constant: (known: bool, value: i64) = proof_constant_int(rewritten_left.value)
                        right_constant: (known: bool, value: i64) = proof_constant_int(rewritten_right.value)
                        if left_constant.known and right_constant.known:
                            result: mutable bool = false
                            result <- left_constant.value == right_constant.value if operator == TokenKind.EqEq
                            result <- left_constant.value != right_constant.value if operator == TokenKind.BangEq
                            result <- left_constant.value < right_constant.value if operator == TokenKind.Lt
                            result <- left_constant.value <= right_constant.value if operator == TokenKind.LtEq
                            result <- left_constant.value > right_constant.value if operator == TokenKind.Gt
                            result <- left_constant.value >= right_constant.value if operator == TokenKind.GtEq
                            return (true, Ast::Expr.BoolLit(result))
                        match rewritten_left.value:
                            Ast::Expr.BoolLit(left_bool):
                                match rewritten_right.value:
                                    Ast::Expr.BoolLit(right_bool):
                                        return (true, Ast::Expr.BoolLit(left_bool == right_bool)) if operator == TokenKind.EqEq
                                        return (true, Ast::Expr.BoolLit(left_bool != right_bool)) if operator == TokenKind.BangEq
                                    _:
                                        pass
                            _:
                                pass
                    if operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow:
                        match rewritten_left.value:
                            Ast::Expr.BoolLit(left_bool):
                                match rewritten_right.value:
                                    Ast::Expr.BoolLit(right_bool):
                                        result: mutable bool = false
                                        result <- left_bool and right_bool if operator == TokenKind.And
                                        result <- left_bool or right_bool if operator == TokenKind.Or
                                        result <- (not left_bool) or right_bool if operator == TokenKind.FatArrow
                                        return (true, Ast::Expr.BoolLit(result))
                                    _:
                                        pass
                            _:
                                pass
                    constant: (known: bool, value: i64) = proof_constant_int(candidate)
                    if constant.known:
                        return (true, Ast::Expr.IntLit(constant.value)) if operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
                    return (rewritten_left.changed or rewritten_right.changed, candidate)
                _:
                    return (false, expression)

        # Simplification is a state transformation, not an unchecked proof shortcut. It may
        # close the resulting goal only through the same bounded kernel used by `exact`; if no
        # supported rewrite exists, the original goal and solved bit remain unchanged.
        def proof_tactic_simplify(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_tactic_record(state, "simp", false, "a solved goal cannot accept another action") if state.solved
            rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression(state.goal)
            return proof_tactic_record(state, "simp", false, "the goal has no supported safe simplification") if not rewritten.changed
            state.goal <- rewritten.value
            if proof_goal(state.facts, state.goal, annotations):
                state.solved <- true
                return proof_tactic_record(state, "simp", true, "the goal was simplified and discharged by the existing proof kernel")
            return proof_tactic_record(state, "simp", true, "the goal was simplified; it remains to be discharged")

        # Implication introduction is a structural proof rule. It only changes the state when
        # the goal is syntactically an implication; no arbitrary expression is promoted to a
        # hypothesis.
        def proof_tactic_intro(state: mutable ProofTacticState&) -> bool:
            return proof_tactic_record(state, "intro", false, "a solved goal cannot accept another action") if state.solved
            match state.goal:
                Ast::Expr.Binary(antecedent, TokenKind.FatArrow, consequent, _):
                    state.facts.push(antecedent)
                    state.goal <- consequent
                    return proof_tactic_record(state, "intro", true, "introduced the implication antecedent as a hypothesis")
                _:
                    return proof_tactic_record(state, "intro", false, "the goal is not an implication")

        # Apply an explicit implication in the context backwards. This is the useful
        # interactive counterpart to `intro`: a fact A => B changes a goal B into A, but only
        # when B is the current goal. It never treats an arbitrary caller-supplied implication
        # as an axiom and leaves the state untouched when no matching theorem is present.
        def proof_tactic_apply(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_tactic_record(state, "apply", false, "a solved goal cannot accept another action") if state.solved
            found: mutable bool = false
            premise: mutable Ast::Expr = Ast::Expr.Absent
            for fact in state.facts |fact, state, annotations, found, premise|:
                match fact:
                    Ast::Expr.Binary(antecedent, TokenKind.FatArrow, consequent, _):
                        if not proof_expr_has_call(fact) and not proof_expr_has_move(fact) and (proof_expr_equal(consequent, state.goal) or proof_quantifier_equal(consequent, state.goal, annotations)):
                            found <- true
                            premise <- antecedent
                            break
                    Ast::Expr.Paren(inner, _):
                        match inner:
                            Ast::Expr.Binary(antecedent, TokenKind.FatArrow, consequent, _):
                                if not proof_expr_has_call(inner) and not proof_expr_has_move(inner) and (proof_expr_equal(consequent, state.goal) or proof_quantifier_equal(consequent, state.goal, annotations)):
                                    found <- true
                                    premise <- antecedent
                                    break
                            _:
                                pass
                    _:
                        pass
            return proof_tactic_record(state, "apply", false, "no explicit implication concludes the current goal") if not found
            state.goal <- premise
            return proof_tactic_record(state, "apply", true, "reduced the goal using an explicit implication hypothesis")

        def proof_tactic_collection_instance(body: Ast::Expr, binder: sview, value: Ast::Expr, elements: darray[Ast::Expr]&) -> (known: bool, instance: Ast::Expr):
            return (false, Ast::Expr.Invalid) if proof_expr_has_call(body) or proof_expr_has_move(body) or proof_expr_has_call(value) or proof_expr_has_move(value)
            for element in elements:
                return (false, Ast::Expr.Invalid) if proof_expr_has_call(element) or proof_expr_has_move(element)
                if proof_expr_equal(value, element):
                    binder_names: mutable darray[sview] = [binder]
                    binder_values: mutable darray[Ast::Expr] = [value]
                    instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                    match instance:
                        Ast::Expr.Invalid:
                            return (false, Ast::Expr.Invalid)
                        _:
                            return (true, instance)
            return (false, Ast::Expr.Invalid)

        # Instantiate a universal fact at a checked integer-range or finite literal-collection
        # member. Dynamic collections and existential instantiation stay outside this action:
        # selecting from either would require assumptions not represented in this proof state.
        def proof_tactic_instantiate(state: mutable ProofTacticState&, fact_index: usize, value: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_tactic_record(state, "instantiate", false, "a solved goal cannot accept another action") if state.solved
            proof_tactic_prepare(state, value, Ast::Expr.Absent, fact_index, true, false)
            state.pending_detail <- "forall"
            return proof_tactic_record(state, "instantiate", false, "the quantified fact index is out of range") if fact_index >= state.facts.count
            return proof_tactic_record(state, "instantiate", false, "only a universal quantified fact can be instantiated") if proof_quantifier_kind(state.facts[fact_index], annotations) != "forall"
            quantifier: mutable Ast::Expr = state.facts[fact_index]
            match quantifier:
                Ast::Expr.Paren(inner, _):
                    quantifier <- inner
                _:
                    pass
            match quantifier:
                Ast::Expr.Block(statements, body, _, _):
                    return proof_tactic_record(state, "instantiate", false, "the quantified fact must have one integer range binder") if statements.count != 1
                    return proof_tactic_record(state, "instantiate", false, "effectful quantified bodies are not admissible proof facts") if proof_expr_has_call(body) or proof_expr_has_move(body)
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, _, range_expression, _):
                            return proof_tactic_record(state, "instantiate", false, "the quantified binder has no name") if binder == ""
                            match range_expression:
                                Ast::Expr.Binary(lower_expression, range_operator, upper_expression, _):
                                    return proof_tactic_record(state, "instantiate", false, "the quantified binder is not an integer range") if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                                    selected: (known: bool, value: i64) = proof_constant_int(value)
                                    lower: (known: bool, value: i64) = proof_exact_int_from_facts(lower_expression, state.facts)
                                    upper: (known: bool, value: i64) = proof_exact_int_from_facts(upper_expression, state.facts)
                                    return proof_tactic_record(state, "instantiate", false, "the instance or quantified bounds are not exact integers") if not selected.known or not lower.known or not upper.known
                                    return proof_tactic_record(state, "instantiate", false, "the selected value is outside the quantified range") if selected.value < lower.value or (range_operator == TokenKind.RangeLt and selected.value >= upper.value) or (range_operator == TokenKind.RangeLe and selected.value > upper.value)
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = [value]
                                    instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                    match instance:
                                        Ast::Expr.Invalid:
                                            return proof_tactic_record(state, "instantiate", false, "the quantified body could not be represented after substitution")
                                        _:
                                            pass
                                    state.facts.push(instance)
                                    return proof_tactic_record(state, "instantiate", true, "added a universally quantified instance after checking range membership")
                                _:
                                    pass
                            match range_expression:
                                Ast::Expr.Array(elements, _):
                                    candidate: (known: bool, instance: Ast::Expr) = proof_tactic_collection_instance(body, binder, value, elements)
                                    if candidate.known:
                                        state.facts.push(candidate.instance)
                                        return proof_tactic_record(state, "instantiate", true, "added a universally quantified instance after checking literal-array membership")
                                Ast::Expr.Tuple(elements, _):
                                    candidate: (known: bool, instance: Ast::Expr) = proof_tactic_collection_instance(body, binder, value, elements)
                                    if candidate.known:
                                        state.facts.push(candidate.instance)
                                        return proof_tactic_record(state, "instantiate", true, "added a universally quantified instance after checking literal-tuple membership")
                                Ast::Expr.SetLit(elements, _):
                                    candidate: (known: bool, instance: Ast::Expr) = proof_tactic_collection_instance(body, binder, value, elements)
                                    if candidate.known:
                                        state.facts.push(candidate.instance)
                                        return proof_tactic_record(state, "instantiate", true, "added a universally quantified instance after checking literal-set membership")
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return proof_tactic_record(state, "instantiate", false, "the quantified fact shape is unsupported")

        # Add a local derived fact only after the current proof kernel has established it.
        # This is the tactic analogue of an asserted proof step; it never acts as an axiom.
        def proof_tactic_have(state: mutable ProofTacticState&, fact: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_tactic_record(state, "have", false, "a solved goal cannot accept another action") if state.solved
            proof_tactic_prepare(state, fact, Ast::Expr.Absent, 0, false, false)
            return proof_tactic_record(state, "have", false, "effectful expressions cannot enter a tactic proof context") if proof_expr_has_call(fact) or proof_expr_has_move(fact)
            proven: bool = proof_goal(state.facts, fact, annotations)
            if proven:
                state.facts.push(fact)
                return proof_tactic_record(state, "have", true, "the derived fact was entailed by the current hypotheses")
            return proof_tactic_record(state, "have", false, "the proposed fact is not entailed by the current hypotheses")

        # Replace one exact subexpression at every supported expression node. The equality
        # itself must be an explicit fact; this keeps rewrite provenance visible and avoids
        # treating an arbitrary caller-supplied pair as a theorem.
        def proof_tactic_replace(expression: Ast::Expr, from: Ast::Expr, replacement: Ast::Expr) -> (changed: bool, value: Ast::Expr):
            return (true, replacement) if proof_expr_equal(expression, from)
            match expression:
                Ast::Expr.Paren(inner, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(inner, from, replacement)
                    return (true, Ast::Expr.Paren(rewritten.value, position)) if rewritten.changed
                Ast::Expr.Unary(operator, operand, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(operand, from, replacement)
                    return (true, Ast::Expr.Unary(operator, rewritten.value, position)) if rewritten.changed
                Ast::Expr.Binary(left, operator, right, position):
                    rewritten_left: (changed: bool, value: Ast::Expr) = proof_tactic_replace(left, from, replacement)
                    return (true, Ast::Expr.Binary(rewritten_left.value, operator, right, position)) if rewritten_left.changed
                    rewritten_right: (changed: bool, value: Ast::Expr) = proof_tactic_replace(right, from, replacement)
                    return (true, Ast::Expr.Binary(left, operator, rewritten_right.value, position)) if rewritten_right.changed
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    rewritten_callee: (changed: bool, value: Ast::Expr) = proof_tactic_replace(callee, from, replacement)
                    return (true, Ast::Expr.Call(rewritten_callee.value, arguments, argument_names, position)) if rewritten_callee.changed
                    rewritten_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |argument, rewritten_arguments, from, replacement|:
                        rewritten_argument: (changed: bool, value: Ast::Expr) = proof_tactic_replace(argument, from, replacement)
                        rewritten_arguments.push(rewritten_argument.value)
                        return (true, Ast::Expr.Call(callee, rewritten_arguments, argument_names, position)) if rewritten_argument.changed
                    return (false, expression)
                Ast::Expr.Field(object, field, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(object, from, replacement)
                    return (true, Ast::Expr.Field(rewritten.value, field, position)) if rewritten.changed
                Ast::Expr.Scope(base, field, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(base, from, replacement)
                    return (true, Ast::Expr.Scope(rewritten.value, field, position)) if rewritten.changed
                Ast::Expr.Index(object, index, position):
                    rewritten_object: (changed: bool, value: Ast::Expr) = proof_tactic_replace(object, from, replacement)
                    return (true, Ast::Expr.Index(rewritten_object.value, index, position)) if rewritten_object.changed
                    rewritten_index: (changed: bool, value: Ast::Expr) = proof_tactic_replace(index, from, replacement)
                    return (true, Ast::Expr.Index(object, rewritten_index.value, position)) if rewritten_index.changed
                Ast::Expr.Slice(object, low, high, position):
                    rewritten_object: (changed: bool, value: Ast::Expr) = proof_tactic_replace(object, from, replacement)
                    return (true, Ast::Expr.Slice(rewritten_object.value, low, high, position)) if rewritten_object.changed
                    rewritten_low: (changed: bool, value: Ast::Expr) = proof_tactic_replace(low, from, replacement)
                    return (true, Ast::Expr.Slice(object, rewritten_low.value, high, position)) if rewritten_low.changed
                    rewritten_high: (changed: bool, value: Ast::Expr) = proof_tactic_replace(high, from, replacement)
                    return (true, Ast::Expr.Slice(object, low, rewritten_high.value, position)) if rewritten_high.changed
                Ast::Expr.IndexN(object, arguments, position):
                    rewritten_object: (changed: bool, value: Ast::Expr) = proof_tactic_replace(object, from, replacement)
                    return (true, Ast::Expr.IndexN(rewritten_object.value, arguments, position)) if rewritten_object.changed
                    rewritten_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |argument, rewritten_arguments, from, replacement|:
                        rewritten_argument: (changed: bool, value: Ast::Expr) = proof_tactic_replace(argument, from, replacement)
                        rewritten_arguments.push(rewritten_argument.value)
                        return (true, Ast::Expr.IndexN(object, rewritten_arguments, position)) if rewritten_argument.changed
                Ast::Expr.If(condition, then_expression, else_expression, position):
                    rewritten_condition: (changed: bool, value: Ast::Expr) = proof_tactic_replace(condition, from, replacement)
                    return (true, Ast::Expr.If(rewritten_condition.value, then_expression, else_expression, position)) if rewritten_condition.changed
                    rewritten_then: (changed: bool, value: Ast::Expr) = proof_tactic_replace(then_expression, from, replacement)
                    return (true, Ast::Expr.If(condition, rewritten_then.value, else_expression, position)) if rewritten_then.changed
                    rewritten_else: (changed: bool, value: Ast::Expr) = proof_tactic_replace(else_expression, from, replacement)
                    return (true, Ast::Expr.If(condition, then_expression, rewritten_else.value, position)) if rewritten_else.changed
                _:
                    pass
            return (false, expression)

        def proof_tactic_rewrite(state: mutable ProofTacticState&, from: Ast::Expr, replacement: Ast::Expr) -> bool:
            return proof_tactic_record(state, "rewrite", false, "a solved goal cannot accept another action") if state.solved
            proof_tactic_prepare(state, from, replacement, 0, false, true)
            return proof_tactic_record(state, "rewrite", false, "effectful goals cannot be rewritten without a purity certificate") if proof_expr_has_call(state.goal) or proof_expr_has_move(state.goal)
            equality_found: mutable bool = false
            for fact in state.facts |fact, from, replacement, equality_found|:
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        equality_found <- true if not proof_expr_has_call(fact) and not proof_expr_has_move(fact) and ((proof_expr_equal(left, from) and proof_expr_equal(right, replacement)) or (proof_expr_equal(left, replacement) and proof_expr_equal(right, from)))
                    _:
                        pass
            return proof_tactic_record(state, "rewrite", false, "no explicit equality fact supports this rewrite") if not equality_found
            rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(state.goal, from, replacement)
            return proof_tactic_record(state, "rewrite", false, "the target expression does not contain the rewrite source") if not rewritten.changed
            state.goal <- rewritten.value
            return proof_tactic_record(state, "rewrite", true, "rewrote the goal using an explicit equality hypothesis")

        def proof_tactic_initialize_child[@r](parent: ProofTacticState&, goal: Ast::Expr, skip_fact: usize, branch_fact: Ast::Expr, child: mutable ProofTacticState& @r) -> void:
            child.facts <- []
            child.initial_facts <- []
            for index in 0..<parent.facts.count |index, parent, child, skip_fact|:
                child.facts.push(parent.facts[index]) if index != skip_fact
                child.initial_facts.push(parent.facts[index]) if index != skip_fact
            child.facts.push(branch_fact) if skip_fact < parent.facts.count
            child.initial_facts.push(branch_fact) if skip_fact < parent.facts.count
            child.goal <- goal
            child.initial_goal <- goal
            child.solved <- false
            child.action_count <- 0
            child.last_action <- "branch"
            child.last_reason <- "child state created by a structural proof rule"
            child.trace <- []
            child.trace_facts <- []
            child.pending_argument <- Ast::Expr.Absent
            child.pending_secondary <- Ast::Expr.Absent
            child.pending_has_argument <- false
            child.pending_has_secondary <- false
            child.pending_argument_index <- 0
            child.pending_has_argument_index <- false
            child.pending_detail <- ""

        # Conjunction splitting creates two independent states. Both branches must later be
        # solved; returning two states makes that obligation explicit to callers rather than
        # silently choosing one side.
        def proof_tactic_split[@r](state: mutable ProofTacticState& @r, left_state: mutable ProofTacticState& @r, right_state: mutable ProofTacticState& @r) -> bool:
            match state.goal:
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    proof_tactic_initialize_child(state, left, state.facts.count, Ast::Expr.Absent, left_state)
                    proof_tactic_initialize_child(state, right, state.facts.count, Ast::Expr.Absent, right_state)
                    return proof_tactic_record(state, "split", true, "created independent states for both conjunction branches")
                _:
                    return proof_tactic_record(state, "split", false, "the goal is not a conjunction")

        # Select one side of a disjunctive goal. The selected goal is still unsolved; the
        # operation only performs the constructive introduction rule and cannot manufacture a
        # proof of either branch.
        def proof_tactic_left(state: mutable ProofTacticState&) -> bool:
            return proof_tactic_record(state, "left", false, "a solved goal cannot accept another action") if state.solved
            match state.goal:
                Ast::Expr.Binary(left, TokenKind.Or, _, _):
                    state.goal <- left
                    return proof_tactic_record(state, "left", true, "selected the left disjunct")
                _:
                    return proof_tactic_record(state, "left", false, "the goal is not a disjunction")

        def proof_tactic_right(state: mutable ProofTacticState&) -> bool:
            return proof_tactic_record(state, "right", false, "a solved goal cannot accept another action") if state.solved
            match state.goal:
                Ast::Expr.Binary(_, TokenKind.Or, right, _):
                    state.goal <- right
                    return proof_tactic_record(state, "right", true, "selected the right disjunct")
                _:
                    return proof_tactic_record(state, "right", false, "the goal is not a disjunction")

        # Disjunction case analysis is similarly explicit. The selected disjunct is removed
        # from each child context and replaced by one branch hypothesis.
        def proof_tactic_cases[@r](state: mutable ProofTacticState& @r, left_state: mutable ProofTacticState& @r, right_state: mutable ProofTacticState& @r) -> bool:
            for index in 0..<state.facts.count |index, state, left_state, right_state|:
                match state.facts[index]:
                    Ast::Expr.Binary(left, TokenKind.Or, right, _):
                        proof_tactic_initialize_child(state, state.goal, index, left, left_state)
                        proof_tactic_initialize_child(state, state.goal, index, right, right_state)
                        return proof_tactic_record(state, "cases", true, "created independent states for both disjunction branches")
                    _:
                        pass
            return proof_tactic_record(state, "cases", false, "no disjunction hypothesis is available")

        # Compare the observable part of one recorded action. The trace includes the post-state
        # snapshot and all explicit arguments, so a client can distinguish an accepted action
        # from a merely attempted one without scraping prose diagnostics.
        def proof_tactic_step_equal(left: ProofTacticStep, right: ProofTacticStep) -> bool:
            return false if left.action != right.action or left.accepted != right.accepted or left.facts_start != right.facts_start or left.facts_count != right.facts_count or left.solved != right.solved or left.reason != right.reason or left.has_argument != right.has_argument or left.has_secondary != right.has_secondary or left.argument_index != right.argument_index or left.has_argument_index != right.has_argument_index or left.detail != right.detail
            return false if not proof_expr_equal(left.goal, right.goal)
            return false if not proof_expr_equal(left.argument, right.argument)
            return proof_expr_equal(left.secondary, right.secondary)

        def proof_tactic_state_equal(left: ProofTacticState&, right: ProofTacticState&) -> bool:
            return false if left.solved != right.solved or left.action_count != right.action_count or left.last_action != right.last_action or left.last_reason != right.last_reason
            return false if not proof_expr_equal(left.initial_goal, right.initial_goal)
            return false if not proof_expr_array_equal(left.initial_facts, right.initial_facts)
            return false if not proof_expr_equal(left.goal, right.goal)
            return false if not proof_expr_array_equal(left.facts, right.facts)
            return false if left.trace.count != right.trace.count
            return false if not proof_expr_array_equal(left.trace_facts, right.trace_facts)
            for index in 0..<left.trace.count |index, left, right|:
                return false if not proof_tactic_step_equal(left.trace[index], right.trace[index])
            return true

        # Deterministically replay the complete action history from the state snapshot. This is
        # intentionally separate from mutation: a failed or partial proof remains inspectable,
        # and replay returns false if any accepted/rejected transition or post-state diverges.
        # The proposition-closing actions still delegate to the existing proof kernel, while the
        # trace itself records structural and derived-fact transitions for later independent
        # certificate work.
        def proof_tactic_replay(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            replay_state: mutable ProofTacticState = proof_tactic_state(state.initial_facts, state.initial_goal)
            empty: mutable darray[Ast::Expr] = []
            for expected in state.trace |expected, replay_state, annotations, empty|:
                before_count: usize = replay_state.trace.count
                accepted: mutable bool = false
                if expected.action == "assumption":
                    accepted <- proof_tactic_assumption(&replay_state, annotations)
                elif expected.action == "exact":
                    accepted <- proof_tactic_exact(&replay_state, annotations)
                elif expected.action == "decide":
                    accepted <- proof_tactic_decide(&replay_state, annotations)
                elif expected.action == "intro":
                    accepted <- proof_tactic_intro(&replay_state)
                elif expected.action == "apply":
                    accepted <- proof_tactic_apply(&replay_state, annotations)
                elif expected.action == "simp":
                    accepted <- proof_tactic_simplify(&replay_state, annotations)
                elif expected.action == "have":
                    accepted <- proof_tactic_have(&replay_state, expected.argument, annotations)
                elif expected.action == "instantiate":
                    accepted <- proof_tactic_instantiate(&replay_state, expected.argument_index, expected.argument, annotations)
                elif expected.action == "rewrite":
                    accepted <- proof_tactic_rewrite(&replay_state, expected.argument, expected.secondary)
                elif expected.action == "split":
                    split_left: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
                    split_right: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
                    accepted <- proof_tactic_split(&replay_state, &split_left, &split_right)
                elif expected.action == "left":
                    accepted <- proof_tactic_left(&replay_state)
                elif expected.action == "right":
                    accepted <- proof_tactic_right(&replay_state)
                elif expected.action == "cases":
                    cases_left: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
                    cases_right: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
                    accepted <- proof_tactic_cases(&replay_state, &cases_left, &cases_right)
                else:
                    return false
                return false if replay_state.trace.count != before_count + 1
                return false if accepted != expected.accepted
                return false if not proof_tactic_step_equal(replay_state.trace[before_count], expected)
            return proof_tactic_state_equal(replay_state, state)

        # Independently replay a solved tactic state through the source-neutral kernel. This
        # deliberately does not call `proof_goal` or any tactic implementation: AST expressions
        # are lowered into the canonical arena, then the independent replay module decides the
        # final proposition from those roots. Unsupported AST terms return false and can never
        # become a successful tactic certificate by accident.
        def proof_tactic_kernel_encode_annotated(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&) -> usize:
            return proof_kernel_encode_annotated(expression, nodes, children, annotations)

        # Imported AST handles may belong to a different store. Compare their canonical
        # arena terms with the reparsed state, preserving the ordered hypotheses as well as
        # the goal. A matching fact count alone does not bind a proof to a source obligation.
        def proof_tactic_source_state_matches(report: ProofReport&, goal_id: usize, facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            return false if goal_id >= report.goal_attempts.count
            attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
            return false if attempt.rule == "resource-safety" or attempt.rule == "structural-safety"
            return false if facts.count != attempt.facts_count or facts.count != attempt.kernel_facts_count
            return false if attempt.kernel_facts_start > report.kernel_certificate_facts.count or attempt.kernel_facts_count > report.kernel_certificate_facts.count - attempt.kernel_facts_start
            return false if attempt.kernel_goal >= report.kernel_nodes.count
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            nodes.extend(report.kernel_nodes)
            children.extend(report.kernel_children)
            goal_root: usize = proof_kernel_encode_annotated(goal, &nodes, &children, report.source_annotations)
            return false if not ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public(nodes, children, attempt.kernel_goal, goal_root, 0)
            for index in 0..<facts.count |index, report, attempt, facts, nodes, children|:
                expected: usize = report.kernel_certificate_facts[attempt.kernel_facts_start + index]
                return false if expected >= report.kernel_nodes.count
                actual: usize = proof_kernel_encode_annotated(facts[index], &nodes, &children, report.source_annotations)
                return false if not ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public(nodes, children, expected, actual, 0)
            return true

        def proof_tactic_kernel_replay(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if not state.solved
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            facts: mutable darray[usize] = []
            for fact in state.facts |fact, nodes, children, facts, annotations|:
                return false if not proof_kernel_expression_supported(fact)
                facts.push(proof_tactic_kernel_encode_annotated(fact, annotations, nodes, children))
            return false if not proof_kernel_expression_supported(state.goal)
            goal_root: usize = proof_tactic_kernel_encode_annotated(state.goal, annotations, nodes, children)
            return ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, facts, goal_root)

        # Lower and replay the complete tactic trace through the source-neutral transition
        # checker. Unlike `proof_tactic_replay`, this path never invokes a tactic implementation
        # or compares compiler AST values. Every snapshot and explicit argument is encoded into
        # one arena, then the independent kernel validates the action rule and the final mutable
        # state against the last certificate snapshot.
        def proof_tactic_kernel_encode_facts(source: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: mutable darray[usize]&) -> bool:
            for fact in source |fact, nodes, children, roots, annotations|:
                return false if not proof_kernel_expression_supported(fact)
                roots.push(proof_tactic_kernel_encode_annotated(fact, annotations, nodes, children))
            return true

        def proof_tactic_kernel_trace_replay(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if state.action_count != state.trace.count
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            before_facts: mutable darray[usize] = []
            return false if not proof_tactic_kernel_encode_facts(state.initial_facts, annotations, &nodes, &children, &before_facts)
            return false if not proof_kernel_expression_supported(state.initial_goal)
            before_goal: mutable usize = proof_tactic_kernel_encode_annotated(state.initial_goal, annotations, &nodes, &children)
            before_solved: mutable bool = false
            snapshot_cursor: mutable usize = 0
            for expected in state.trace |expected, state, nodes, children, before_facts, before_goal, before_solved, snapshot_cursor|:
                return false if expected.facts_start != snapshot_cursor
                return false if expected.facts_count > state.trace_facts.count - expected.facts_start
                after_facts: mutable darray[usize] = []
                for index in 0..<expected.facts_count |index, expected, state, nodes, children, after_facts, annotations|:
                    fact: Ast::Expr = state.trace_facts[expected.facts_start + index]
                    return false if not proof_kernel_expression_supported(fact)
                    after_facts.push(proof_tactic_kernel_encode_annotated(fact, annotations, nodes, children))
                return false if not proof_kernel_expression_supported(expected.goal)
                after_goal: usize = proof_tactic_kernel_encode_annotated(expected.goal, annotations, nodes, children)
                argument: mutable usize = 0
                secondary: mutable usize = 0
                if expected.has_argument:
                    return false if not proof_kernel_expression_supported(expected.argument)
                    argument <- proof_tactic_kernel_encode_annotated(expected.argument, annotations, nodes, children)
                if expected.has_secondary:
                    return false if not proof_kernel_expression_supported(expected.secondary)
                    secondary <- proof_tactic_kernel_encode_annotated(expected.secondary, annotations, nodes, children)
                return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_step(&nodes, &children, expected.action, expected.accepted, before_solved, expected.solved, before_facts, before_goal, after_facts, after_goal, argument, expected.has_argument, secondary, expected.has_secondary, expected.argument_index, expected.has_argument_index, expected.detail)
                before_facts <- []
                before_facts.extend(after_facts)
                before_goal <- after_goal
                before_solved <- expected.solved
                snapshot_cursor <- snapshot_cursor + expected.facts_count
            return false if snapshot_cursor != state.trace_facts.count
            final_facts: mutable darray[usize] = []
            return false if not proof_tactic_kernel_encode_facts(state.facts, annotations, &nodes, &children, &final_facts)
            return false if final_facts.count != before_facts.count
            for index in 0..<final_facts.count |index, final_facts, before_facts, nodes, children|:
                return false if not ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public(&nodes, &children, final_facts[index], before_facts[index], 0)
            return false if not proof_kernel_expression_supported(state.goal)
            final_goal: usize = proof_tactic_kernel_encode_annotated(state.goal, annotations, &nodes, &children)
            return false if not ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public(&nodes, &children, final_goal, before_goal, 0)
            return state.solved == before_solved

        # Complete certificate admission for clients that require both dimensions at once:
        # source-neutral validation of every transition and independent proof of the solved
        # proposition. Partial/unsolved tactic states remain useful through the trace API but
        # cannot pass this final certificate boundary.
        def proof_tactic_kernel_certificate_replay(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return proof_tactic_kernel_trace_replay(state, annotations) and proof_tactic_kernel_replay(state, annotations)

        # Replay only the parent-to-child part of a branching proof. Keeping this relation separate
        # from child closure lets serialized proof trees compose branches recursively without
        # making the parent verifier trust the tactic interpreter's in-memory child references.
        def proof_tactic_kernel_branch_transition_replay(parent: ProofTacticState&, left: ProofTacticState&, right: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if parent.trace.count == 0
            branch: ProofTacticStep = parent.trace[parent.trace.count - 1]
            return false if not branch.accepted or (branch.action != "split" and branch.action != "cases")
            return false if not proof_tactic_kernel_trace_replay(parent, annotations)
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            parent_facts: mutable darray[usize] = []
            left_facts: mutable darray[usize] = []
            right_facts: mutable darray[usize] = []
            return false if not proof_tactic_kernel_encode_facts(parent.facts, annotations, &nodes, &children, &parent_facts)
            return false if not proof_kernel_expression_supported(parent.goal) or not proof_kernel_expression_supported(left.initial_goal) or not proof_kernel_expression_supported(right.initial_goal)
            parent_goal: usize = proof_tactic_kernel_encode_annotated(parent.goal, annotations, &nodes, &children)
            return false if not proof_tactic_kernel_encode_facts(left.initial_facts, annotations, &nodes, &children, &left_facts)
            left_goal: usize = proof_tactic_kernel_encode_annotated(left.initial_goal, annotations, &nodes, &children)
            return false if not proof_tactic_kernel_encode_facts(right.initial_facts, annotations, &nodes, &children, &right_facts)
            right_goal: usize = proof_tactic_kernel_encode_annotated(right.initial_goal, annotations, &nodes, &children)
            return ElisaProofKernelReplay::proof_kernel_replay_tactic_branch(&nodes, &children, branch.action, parent_facts, parent_goal, left_facts, left_goal, right_facts, right_goal)

        # Compose a completed branching proof. The parent trace proves that the branch action was
        # a valid state transition; the independent branch kernel below additionally binds both
        # child initial contexts to the parent's proposition and requires each child certificate
        # to close. This prevents separately valid child proofs from being attached to the wrong
        # conjunction or disjunction.
        def proof_tactic_kernel_branch_certificate_replay(parent: ProofTacticState&, left: ProofTacticState&, right: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if not proof_tactic_kernel_branch_transition_replay(parent, left, right, annotations)
            return proof_tactic_kernel_certificate_replay(left, annotations) and proof_tactic_kernel_certificate_replay(right, annotations)
