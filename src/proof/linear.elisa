# A conservative interval prover over the compiler's integer AST. It proves only facts that
# follow from explicit bounds and overflow-safe identities; unknown shapes remain unproven.
extend ElisaProof:
    public:
        struct ProofBound:
            name: sview
            lower: mutable i64
            upper: mutable i64
            has_lower: mutable bool
            has_upper: mutable bool

        # A normalized signed-integer difference constraint `left - right <= bound`. Empty
        # names denote the mathematical zero node, so the same representation covers ordinary
        # bounds (`x >= 0`) and relations between two symbolic values.
        struct ProofDifference:
            left: sview
            right: sview
            bound: i64

        # A deliberately small affine form. The base is one bare identifier, the coefficient is
        # either +1 or -1, and the offset is a fixed i64 constant. This is still far from a
        # general Presburger solver, but it covers both `x + k` and well-founded ranks such as
        # `127 - depth` without treating arithmetic normalization as an axiom.
        struct ProofAffine:
            known: bool
            base: sview
            offset: i64
            negative: bool

        def proof_bound_index(bounds: darray[ProofBound]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < bounds.count |index, bounds, name|:
                return index if bounds[index].name == name
                index <- index + 1
            return bounds.count

        def proof_bound_for(bounds: darray[ProofBound]&, name: sview) -> ProofBound:
            index: usize = proof_bound_index(bounds, name)
            return bounds[index] if index < bounds.count
            return ProofBound{name: name, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_add_lower(bounds: mutable darray[ProofBound]&, name: sview, value: i64) -> void:
            return if name == ""
            index: usize = proof_bound_index(bounds, name)
            if index == bounds.count:
                bounds <- bounds.push(ProofBound{name: name, has_lower: true, lower: value, has_upper: false, upper: 0})
                return
            old_has: bool = bounds[index].has_lower
            old_value: i64 = bounds[index].lower
            bounds[index].has_lower <- true
            bounds[index].lower <- value if not old_has or value > old_value

        def proof_add_upper(bounds: mutable darray[ProofBound]&, name: sview, value: i64) -> void:
            return if name == ""
            index: usize = proof_bound_index(bounds, name)
            if index == bounds.count:
                bounds <- bounds.push(ProofBound{name: name, has_lower: false, lower: 0, has_upper: true, upper: value})
                return
            old_has: bool = bounds[index].has_upper
            old_value: i64 = bounds[index].upper
            bounds[index].has_upper <- true
            bounds[index].upper <- value if not old_has or value < old_value

        def proof_comparison_negation(operator: TokenKind) -> TokenKind:
            return TokenKind.BangEq if operator == TokenKind.EqEq
            return TokenKind.EqEq if operator == TokenKind.BangEq
            return TokenKind.GtEq if operator == TokenKind.Lt
            return TokenKind.Lt if operator == TokenKind.GtEq
            return TokenKind.Gt if operator == TokenKind.LtEq
            return TokenKind.LtEq if operator == TokenKind.Gt
            # Eof is outside the comparison-token set and serves as the impossible result.
            return TokenKind.Eof

        def proof_collect_comparison_bounds(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, bounds: mutable darray[ProofBound]&) -> void:
            return if not proof_is_comparison(operator)
            left_name: sview = proof_ident_name(left)
            right_name: sview = proof_ident_name(right)
            right_constant: (known: bool, value: i64) = proof_constant_int(right)
            left_constant: (known: bool, value: i64) = proof_constant_int(left)
            if left_name != "" and right_constant.known:
                incremented: (known: bool, value: i64) = proof_add_safe(right_constant.value, 1)
                proof_add_lower(bounds, left_name, incremented.value) if operator == TokenKind.Gt and incremented.known
                proof_add_lower(bounds, left_name, right_constant.value) if operator == TokenKind.GtEq
                decremented: (known: bool, value: i64) = proof_sub_safe(right_constant.value, 1)
                proof_add_upper(bounds, left_name, decremented.value) if operator == TokenKind.Lt and decremented.known
                proof_add_upper(bounds, left_name, right_constant.value) if operator == TokenKind.LtEq
                proof_add_lower(bounds, left_name, right_constant.value) if operator == TokenKind.EqEq
                proof_add_upper(bounds, left_name, right_constant.value) if operator == TokenKind.EqEq
            if right_name != "" and left_constant.known:
                decremented_left: (known: bool, value: i64) = proof_sub_safe(left_constant.value, 1)
                proof_add_upper(bounds, right_name, decremented_left.value) if operator == TokenKind.Gt and decremented_left.known
                proof_add_upper(bounds, right_name, left_constant.value) if operator == TokenKind.GtEq
                incremented_left: (known: bool, value: i64) = proof_add_safe(left_constant.value, 1)
                proof_add_lower(bounds, right_name, incremented_left.value) if operator == TokenKind.Lt and incremented_left.known
                proof_add_lower(bounds, right_name, left_constant.value) if operator == TokenKind.LtEq
                proof_add_lower(bounds, right_name, left_constant.value) if operator == TokenKind.EqEq
                proof_add_upper(bounds, right_name, left_constant.value) if operator == TokenKind.EqEq

        # Extract facts of the form x OP constant or constant OP x, including conjunctions.
        def proof_collect_bounds(expression: Ast::Expr, bounds: mutable darray[ProofBound]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_collect_bounds(inner, bounds)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated_operator: TokenKind = proof_comparison_negation(operator)
                            proof_collect_comparison_bounds(left, negated_operator, right, bounds) if negated_operator != TokenKind.Eof
                        _:
                            pass
                Ast::Expr.Binary(left, operator, right, position):
                    if operator == TokenKind.And:
                        proof_collect_bounds(left, bounds)
                        proof_collect_bounds(right, bounds)
                        return
                    proof_collect_comparison_bounds(left, operator, right, bounds)
                _:
                    pass

        # The proof AST does not carry compiler type metadata. Unsigned widths therefore travel
        # through the same traced-fact channel as compiler-derived bounds. This marker is opaque
        # to the arithmetic fragment, but it is encoded in the kernel arena and independently
        # recognized by kernel replay. A proof author can manufacture the marker only to lose
        # completeness: it never proves a proposition by itself, and the source trace still has
        # to identify it as a type-bound fact.
        def proof_unsigned_type_marker(name: sview, width: i64, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [Ast::Expr.Ident(name, position), Ast::Expr.IntLit(width)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_unsigned_type_bound", position), arguments, [], position)

        # Elisa dispatches `==`, `+`, `-`, `*`, `/` and the ordering operators to a user
        # `__eq__`/`__add__`/`__cmp__` implementation whenever an operand's type is a struct, and
        # a user `__eq__` need not be Leibniz equality. Ground congruence is therefore admitted
        # only over terms whose operators are the language's primitive ones. The proof AST carries
        # no compiler type metadata, so the producer records the declared primitive scalar types
        # it resolved through the same traced-fact channel used for unsigned widths. The marker is
        # opaque to every arithmetic tier and proves no proposition by itself; manufacturing one
        # can only lose completeness, because the source trace still has to identify it as a
        # type-bound fact of the owning declaration.
        def proof_scalar_type_marker(name: sview, position: Ast::Pos) -> Ast::Expr:
            return proof_scalar_term_marker(Ast::Expr.Ident(name, position), position)

        # The declared type of a term, not only of a name. The producer resolves a field
        # selection's declared type through the owning struct declaration, so the witness has to
        # be keyed by the exact term rather than by a symbol.
        def proof_scalar_term_marker(term: Ast::Expr, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), arguments, [], position)

        # A container whose declared element type is a primitive scalar. The index set is not
        # enumerable, so the witness is recorded once against the container term and says only
        # that every element of it is a primitive scalar.
        # The depth is how many subscripts reach the scalar: 1 for `darray[i64]`, 2 for
        # `array[array[i64, 4], 4]`, so a nested or multi-argument subscript is witnessed only
        # when it goes exactly that deep.
        def proof_scalar_element_marker(term: Ast::Expr, depth: i64, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term, Ast::Expr.IntLit(depth)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_element", position), arguments, [], position)

        def proof_element_marker_info(expression: Ast::Expr) -> (known: bool, term: Ast::Expr, depth: i64):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid, 0) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, Ast::Expr.Invalid, 0) if proof_ident_name(callee) != "__elisa_primitive_scalar_element" or arguments.count != 2
                    depth: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return (false, Ast::Expr.Invalid, 0) if not depth.known or depth.value < 1 or depth.value > 8
                    return (true, arguments[0], depth.value)
                _:
                    return (false, Ast::Expr.Invalid, 0)

        def proof_marker_argument(expression: Ast::Expr, callee_name: sview) -> (known: bool, term: Ast::Expr):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, Ast::Expr.Invalid) if proof_ident_name(callee) != callee_name or arguments.count != 1
                    return (true, arguments[0])
                _:
                    return (false, Ast::Expr.Invalid)

        # True for either compiler type marker, whatever its payload looks like. A marker states a
        # declared type; it constrains no model and proves no proposition on its own.
        def proof_type_marker_callee(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    name: sview = proof_ident_name(callee)
                    return name == "__elisa_unsigned_type_bound" or name == "__elisa_primitive_scalar_type" or name == "__elisa_primitive_scalar_element"
                _:
                    return false

        # The bare-name form of the scalar witness. A term-shaped witness answers "" here and is
        # matched structurally by `proof_scalar_term_witnessed` instead.
        def proof_scalar_marker_name(expression: Ast::Expr) -> sview:
            argument: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
            return "" if not argument.known
            return proof_ident_name(argument.term)

        # The symbol a type witness hangs off: the root of its argument place. Retention and
        # invalidation follow that symbol, so a field or element witness dies exactly when the
        # binding it was resolved against does.
        def proof_type_marker_root_name(expression: Ast::Expr) -> sview:
            scalar: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
            return proof_place_root_name(scalar.term, 0) if scalar.known
            element: (known: bool, term: Ast::Expr, depth: i64) = proof_element_marker_info(expression)
            return proof_place_root_name(element.term, 0) if element.known
            return ""

        def proof_place_root_name(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= 64
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_place_root_name(inner, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_place_root_name(object, depth + 1)
                Ast::Expr.Index(object, _, _):
                    return proof_place_root_name(object, depth + 1)
                Ast::Expr.Tuple(elements, _):
                    # A loop binder's proof atom is `(name, offset)`; it belongs to that name.
                    return "" if elements.count != 2
                    offset: (known: bool, value: i64) = proof_constant_int(elements[1])
                    return proof_ident_name(elements[0]) if offset.known
                    return ""
                _:
                    return ""

        def proof_unsigned_marker_info(expression: Ast::Expr) -> (known: bool, name: sview, width: i64):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, "", 0) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, "", 0) if proof_ident_name(callee) != "__elisa_unsigned_type_bound" or arguments.count != 2
                    name: sview = proof_ident_name(arguments[0])
                    width: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return (width.known and name != "" and width.value >= 8 and width.value <= 64, name, width.value)
                _:
                    return (false, "", 0)

        def proof_unsigned_marker_name(expression: Ast::Expr) -> sview:
            marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(expression)
            return marker.name if marker.known
            return ""

        def proof_unsigned_marker_width_for_name(facts: darray[Ast::Expr]&, name: sview) -> i64:
            width: mutable i64 = 0
            for fact in facts |fact, name, width|:
                marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                continue if not marker.known or marker.name != name
                width <- marker.width if width == 0 or marker.width < width
            return width

        def proof_unsigned_width_max(width: i64) -> i64:
            return 255 if width == 8
            return 65535 if width == 16
            return 4294967295 if width == 32
            # i64 is the largest signed value representable by this proof AST. For u64/usize,
            # a finite proof interval must establish this conservative representable ceiling;
            # an unbounded unsigned value consequently cannot enter an arithmetic proof.
            return 9223372036854775807 if width == 64
            return 0

        def proof_unsigned_width_in_expression(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> i64:
            match expression:
                Ast::Expr.Ident(name, _):
                    return proof_unsigned_marker_width_for_name(facts, name)
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_width_in_expression(inner, facts)
                Ast::Expr.Unary(_, operand, _):
                    return proof_unsigned_width_in_expression(operand, facts)
                Ast::Expr.Binary(left, _, right, _):
                    left_width: i64 = proof_unsigned_width_in_expression(left, facts)
                    right_width: i64 = proof_unsigned_width_in_expression(right, facts)
                    return right_width if left_width == 0
                    return left_width if right_width == 0 or left_width < right_width
                    return right_width
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    condition_width: i64 = proof_unsigned_width_in_expression(condition, facts)
                    then_width: i64 = proof_unsigned_width_in_expression(then_expression, facts)
                    else_width: i64 = proof_unsigned_width_in_expression(else_expression, facts)
                    return condition_width if condition_width != 0 and (then_width == 0 or condition_width < then_width) and (else_width == 0 or condition_width < else_width)
                    return then_width if then_width != 0 and (else_width == 0 or then_width < else_width)
                    return else_width
                Ast::Expr.Call(callee, arguments, _, _):
                    width: mutable i64 = proof_unsigned_width_in_expression(callee, facts)
                    for argument in arguments |argument, facts, width|:
                        candidate: i64 = proof_unsigned_width_in_expression(argument, facts)
                        width <- candidate if width == 0 or (candidate != 0 and candidate < width)
                    return width
                _:
                    return 0

        def proof_unsigned_order_atom(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Field(object, field_name, _):
                    # A field of a bare name is a place, not arithmetic, so it carries the same
                    # guarantee an identifier does: reading it twice in one fact set reads the
                    # same value, because any write to it, and any call that is not stable for
                    # it, discards these facts first. `values.count` is the term this admits in
                    # practice, and it is the bound every loop over a collection is written
                    # against. The peer rule already names exactly this shape.
                    return field_name != "" and proof_ident_name(proof_strip_parens(object)) != ""
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_order_atom(inner)
                _:
                    return false

        # Range safety must not be justified by reinterpreting the very modular
        # arithmetic whose safety is in question. Only plain scalar orders enter
        # the subtraction-order solver; split conjunctions without importing their
        # arithmetic siblings.
        def proof_collect_unsigned_order_facts(expression: Ast::Expr, orders: mutable darray[Ast::Expr]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_collect_unsigned_order_facts(inner, orders)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    # An early return leaves its condition negated, which is the ordinary way a
                    # guard reaches the statements after it. The negation of a comparison between
                    # two atoms is a comparison between the same two atoms, so it imports no
                    # arithmetic; the bound and difference collectors already complement it.
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            orders.push(expression) if proof_is_comparison(operator) and proof_unsigned_order_atom(left) and proof_unsigned_order_atom(right)
                        _:
                            pass
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And:
                        proof_collect_unsigned_order_facts(left, orders)
                        proof_collect_unsigned_order_facts(right, orders)
                    elif proof_is_comparison(operator) and proof_unsigned_order_atom(left) and proof_unsigned_order_atom(right):
                        orders.push(expression)
                _:
                    pass

        # A boolean constant, seeing through the negation the contract substitution leaves behind.
        # `ensure not result or X` becomes `not false or X` on a path that returns false.
        def proof_constant_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            match proof_strip_parens(expression):
                Ast::Expr.BoolLit(value):
                    return (true, value)
                Ast::Expr.Unary(operator, operand, _):
                    return (false, false) if operator != TokenKind.Not
                    inner: (known: bool, value: bool) = proof_constant_bool(operand)
                    return (inner.known, not inner.value)
                _:
                    return (false, false)

        def proof_unsigned_expression_safe_with_bounds(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_expression_safe_with_bounds(inner, facts, bounds)
                Ast::Expr.Unary(operator, operand, _):
                    return false if not proof_unsigned_expression_safe_with_bounds(operand, facts, bounds)
                    if operator == TokenKind.Minus:
                        width: i64 = proof_unsigned_width_in_expression(operand, facts)
                        if width != 0:
                            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                            return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= proof_unsigned_width_max(width)
                    return true
                Ast::Expr.Binary(left, operator, right, _):
                    # `or` and `and` short-circuit, so an operand the left one settles is never
                    # evaluated and its arithmetic never happens. Requiring it to be in range
                    # refuses goals whose own structure makes it unreachable -- `ensure not result
                    # or count <= total - start` on the path that returns false, where the guard
                    # the subtraction needs is exactly what failed.
                    if operator == TokenKind.Or or operator == TokenKind.And:
                        return false if not proof_unsigned_expression_safe_with_bounds(left, facts, bounds)
                        settled: (known: bool, value: bool) = proof_constant_bool(left)
                        return true if settled.known and settled.value and operator == TokenKind.Or
                        return true if settled.known and not settled.value and operator == TokenKind.And
                        return proof_unsigned_expression_safe_with_bounds(right, facts, bounds)
                    return false if not proof_unsigned_expression_safe_with_bounds(left, facts, bounds)
                    return false if not proof_unsigned_expression_safe_with_bounds(right, facts, bounds)
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.LShift or operator == TokenKind.RShift
                    width: i64 = proof_unsigned_width_in_expression(expression, facts)
                    return true if not arithmetic or width == 0
                    # Unsigned subtraction is defined for every nonnegative pair when the
                    # minuend is at least the subtrahend, even when the values are wider than
                    # this prover's i64 interval domain. Preserve useful range proofs such as
                    # `count <= total - start` under the explicit `start <= total` precondition.
                    if operator == TokenKind.Plus:
                        unit: (known: bool, base: Ast::Expr) = proof_unsigned_unit_increment_base(left, right)
                        if unit.known:
                            return true if proof_unsigned_increment_has_strict_peer(unit.base, width, facts)
                        # A sum of two non-constant terms has no interval here, and for a 64-bit
                        # unsigned value it never can. What it can have is a bound: the same search
                        # that discharges `a + b <= C` also names the `C`, and a sum bounded by a
                        # term of its own width is in range without any magnitude being known.
                        sum_witness: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness(left, right, facts)
                        if sum_witness.known and proof_peer_is_nameable(sum_witness.bound):
                            return true if proof_peer_unsigned_width(sum_witness.bound, facts) == width
                    if operator == TokenKind.Minus:
                        orders: mutable darray[Ast::Expr] = []
                        # Read the facts the same way the structural rules do: conjuncts
                        # flattened, and a disjunction one side of which an existing fact denies
                        # contributing the other. A callee's postcondition arrives as
                        # `not result or ...` and the caller has already guarded on the result, so
                        # without this the order the subtraction needs is stated and unreadable.
                        readable: darray[Ast::Expr] = proof_conjunct_facts(facts)
                        for fact in readable |orders|:
                            proof_collect_unsigned_order_facts(fact, &orders)
                        # The order tier is gated on its operands' primitive type witness, which
                        # is a type statement rather than an order fact. Carry the markers across
                        # with the orders; they are inert for every bound and alias collector.
                        for fact in facts |orders|:
                            orders.push(fact) if proof_scalar_marker_name(fact) != "" or proof_unsigned_marker_name(fact) != ""
                        # The order the subtraction needs may be stated between two places, and
                        # the affine tiers below name one bare identifier, so they cannot read it.
                        # A collected order is a comparison between two atoms and contains no
                        # arithmetic, so matching one directly imports nothing this guard would
                        # then be deciding about itself.
                        return true if proof_has_order_fact(right, left, false, orders)
                        return true if proof_linear_goal(right, TokenKind.LtEq, left, orders)
                    interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                    return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= proof_unsigned_width_max(width)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_unsigned_expression_safe_with_bounds(condition, facts, bounds) and proof_unsigned_expression_safe_with_bounds(then_expression, facts, bounds) and proof_unsigned_expression_safe_with_bounds(else_expression, facts, bounds)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_unsigned_expression_safe_with_bounds(callee, facts, bounds)
                    for argument in arguments |argument, facts, bounds|:
                        return false if not proof_unsigned_expression_safe_with_bounds(argument, facts, bounds)
                    return true
                _:
                    return true

        def proof_unsigned_expression_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            bounds: mutable darray[ProofBound] = []
            for fact in facts |bounds|:
                proof_collect_bounds(fact, &bounds)
            proof_close_equalities(facts, &bounds)
            # Deliberately no bound propagation here. A difference constraint is read off a fact
            # such as `y == x + 1`, which for an unsigned type is a *modular* equality: it is true
            # at `x == 255, y == 0` for a `u8` and says nothing about the integers. Propagating it
            # would hand this guard an interval that only holds if the term does not wrap, which is
            # the very question the guard is deciding, and `examples/rejected_unsigned_fact_explosion.elisa`
            # then proves `x == 0` from `x == 255`. The goal tier may propagate because it runs
            # after every affine term in the goal has been certified non-wrapping.
            return proof_unsigned_expression_safe_with_bounds(expression, facts, bounds)

        # Reflexivity, symmetry, and coherence with arithmetic are not universal in Elisa. `==`,
        # `!=` and the four ordering operators dispatch to a user `__eq__`/`__cmp__` whenever an
        # operand's type is a struct, and neither protocol method is required to have any of those
        # properties, so `p == p`, `p <= p`, and `q == p` from `p == q` are not theorems for an
        # arbitrary type. Every rule that concludes a comparison because its operands denote the
        # same value therefore needs the operand's primitive type witness. A bare identifier is
        # the shape whose declared type the producer records; a richer operand shape is left to
        # the numeric tiers, which cannot construct an interval for a struct anyway.
        def proof_scalar_witnessed(facts: darray[Ast::Expr]&, name: sview) -> bool:
            return false if name == ""
            for fact in facts:
                return true if proof_scalar_marker_name(fact) == name
                return true if proof_unsigned_marker_name(fact) == name
            return false

        # Ground congruence and the identity tiers admit only the language's own operators; a
        # struct operand would dispatch to a user protocol method instead. This mirrors the
        # kernel's list exactly, including the deliberate exclusion of unary `&`: an address is
        # not a function of the value stored at it.
        def proof_congruent_binary_operator(operator: TokenKind) -> bool:
            return true if operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent
            return true if operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
            return true if operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow
            return true if operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
            return false

        def proof_congruent_unary_operator(operator: TokenKind) -> bool:
            return operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Not

        # How many further subscripts this term needs to reach a primitive scalar: the marker's
        # depth for a witnessed container, one less per subscript over a witnessed index term,
        # and -1 when nothing is known. A term is a scalar element exactly when this reaches 0.
        def proof_scalar_element_remaining(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> i64:
            return -1 if depth >= 64
            for fact in facts |expression|:
                marker: (known: bool, term: Ast::Expr, depth: i64) = proof_element_marker_info(fact)
                return marker.depth if marker.known and proof_expr_equal(marker.term, expression)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_scalar_element_remaining(inner, facts, depth + 1)
                Ast::Expr.Index(object, index, _):
                    remaining: i64 = proof_scalar_element_remaining(object, facts, depth + 1)
                    return -1 if remaining < 1 or not proof_scalar_term_witnessed(index, facts, depth + 1)
                    return remaining - 1
                Ast::Expr.IndexN(object, arguments, _):
                    remaining: i64 = proof_scalar_element_remaining(object, facts, depth + 1)
                    return -1 if remaining < arguments.count.i64()
                    for argument in arguments |facts, depth|:
                        return -1 if not proof_scalar_term_witnessed(argument, facts, depth + 1)
                    return remaining - arguments.count.i64()
                _:
                    return -1

        # Whether this term is known to denote a primitive scalar value. The producer mirror of
        # `proof_kernel_replay_scalar_term_witnessed`; the kernel re-derives the same judgement
        # from the certificate and owns the decision.
        #
        # A witness is a scalar literal, a term whose declared primitive scalar type the producer
        # resolved and recorded, an element of a container whose element type it resolved indexed
        # by a witnessed term, or a former built from the language's own operators over witnessed
        # operands. A call result is deliberately not witnessed: its return type is not resolved
        # here, and a function need not be deterministic, so two occurrences of the same call text
        # need not denote one value.
        def proof_scalar_term_witnessed(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> bool:
            return false if depth >= 64
            match expression:
                Ast::Expr.IntLit(_):
                    return true
                Ast::Expr.BoolLit(_):
                    return true
                Ast::Expr.CharLit(_):
                    return true
                Ast::Expr.ShorthandMember(parts, _):
                    # A one-segment leading-dot value is a `const enum` member: an integer.
                    return parts.count == 1 and parts[0] != ""
                _:
                    pass
            for fact in facts |expression|:
                argument: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, "__elisa_primitive_scalar_type")
                return true if argument.known and proof_expr_equal(argument.term, expression)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_scalar_term_witnessed(inner, facts, depth + 1)
                Ast::Expr.Ident(name, _):
                    return proof_scalar_witnessed(facts, name)
                Ast::Expr.Index(_, _, _):
                    return proof_scalar_element_remaining(expression, facts, depth + 1) == 0
                Ast::Expr.IndexN(_, _, _):
                    return proof_scalar_element_remaining(expression, facts, depth + 1) == 0
                Ast::Expr.Unary(operator, operand, _):
                    return proof_congruent_unary_operator(operator) and proof_scalar_term_witnessed(operand, facts, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_congruent_binary_operator(operator) and proof_scalar_term_witnessed(left, facts, depth + 1) and proof_scalar_term_witnessed(right, facts, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_scalar_term_witnessed(condition, facts, depth + 1) and proof_scalar_term_witnessed(then_expression, facts, depth + 1) and proof_scalar_term_witnessed(else_expression, facts, depth + 1)
                _:
                    return false

        def proof_primitive_comparison(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return proof_scalar_term_witnessed(left, facts, 0) and proof_scalar_term_witnessed(right, facts, 0)

        def proof_unsigned_goal_identity(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_goal_identity(inner, facts)
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_primitive_comparison(left, right, facts) and proof_definitionally_equal(left, right) and proof_is_true_comparison(operator)
                _:
                    return false

        # Collect only explicit identifier equalities. This is deliberately narrower than
        # general expression rewriting: a positive `x == y` fact is safe to use as an alias,
        # while inventing a canonical form for calls, references, or arithmetic could cross
        # effects and fixed-width overflow boundaries.
        def proof_collect_name_equalities(expression: Ast::Expr, left_names: mutable darray[sview]&, right_names: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_collect_name_equalities(inner, left_names, right_names)
                Ast::Expr.Binary(left, operator, right, position):
                    if operator == TokenKind.And:
                        proof_collect_name_equalities(left, left_names, right_names)
                        proof_collect_name_equalities(right, left_names, right_names)
                    if operator == TokenKind.EqEq:
                        left_name: sview = proof_ident_name(left)
                        right_name: sview = proof_ident_name(right)
                        if left_name != "" and right_name != "":
                            left_names.push(left_name)
                            right_names.push(right_name)
                _:
                    pass

        # Equality aliases also transport interval bounds. Iterate by relation count so a
        # chain such as x == y, y == z reaches every member without relying on a host solver.
        def proof_close_equalities(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            left_names: mutable darray[sview] = []
            right_names: mutable darray[sview] = []
            for fact in facts |left_names, right_names|:
                proof_collect_name_equalities(fact, &left_names, &right_names)
            rounds: mutable usize = 0
            max_rounds: usize = facts.count * 2 + 2
            while rounds < max_rounds |rounds, left_names, right_names, bounds|:
                for index in 0..<left_names.count |index, left_names, right_names, bounds|:
                    left_bound: ProofBound = proof_bound_for(bounds, left_names[index])
                    right_bound: ProofBound = proof_bound_for(bounds, right_names[index])
                    proof_add_lower(bounds, right_names[index], left_bound.lower) if left_bound.has_lower
                    proof_add_upper(bounds, right_names[index], left_bound.upper) if left_bound.has_upper
                    proof_add_lower(bounds, left_names[index], right_bound.lower) if right_bound.has_lower
                    proof_add_upper(bounds, left_names[index], right_bound.upper) if right_bound.has_upper
                rounds <- rounds + 1

        def proof_names_equal_from_facts(left_name: sview, right_name: sview, facts: darray[Ast::Expr]&) -> bool:
            return false if left_name == "" or right_name == ""
            return true if left_name == right_name
            relation_left: mutable darray[sview] = []
            relation_right: mutable darray[sview] = []
            for fact in facts |relation_left, relation_right|:
                proof_collect_name_equalities(fact, &relation_left, &relation_right)
            reachable: mutable darray[sview] = [left_name]
            cursor: mutable usize = 0
            while cursor < reachable.count |cursor, reachable, relation_left, relation_right|:
                current: sview = reachable[cursor]
                for index in 0..<relation_left.count |index, relation_left, relation_right, reachable, current, right_name|:
                    next_name: mutable sview = ""
                    next_name <- relation_right[index] if relation_left[index] == current
                    next_name <- relation_left[index] if relation_right[index] == current
                    if next_name != "":
                        return true if next_name == right_name
                        already_seen: bool = any existing in reachable where existing == next_name
                        reachable.push(next_name) if not already_seen
                cursor <- cursor + 1
            return false

        # An inconsistent set of explicit interval facts has no reachable state. Applying
        # ex-falso here is sound Hoare reasoning (a function with impossible preconditions has
        # no executions), and it also makes contradictory branch complements useful without
        # teaching the kernel a general-purpose theorem prover.
        # The part of inconsistency that needs no arithmetic: a false literal, or a proposition
        # beside its own negation. Nothing is evaluated and no interval is consulted, so this may
        # run before the fixed-width guard -- it cannot be misled by a modular premise, because it
        # never reads one as a number. That ordering is what closes the branch a disjunctive
        # premise refutes: a callee's `not result or p` beside the caller's own `result` leaves
        # `p` in the only branch that survives, and the branch that assumed `not result` is shut
        # without its facts ever having to be range-safe.
        def proof_facts_propositionally_inconsistent(facts: darray[Ast::Expr]&) -> bool:
            for fact in facts:
                match fact:
                    Ast::Expr.BoolLit(value):
                        return true if not value
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        match operand:
                            Ast::Expr.BoolLit(value):
                                return true if value
                            _:
                                pass
                    _:
                        pass
            for fact in facts |facts|:
                return true if proof_fact_denies(fact, facts)
            return false

        def proof_facts_inconsistent(facts: darray[Ast::Expr]&) -> bool:
            bounds: mutable darray[ProofBound] = []
            for fact in facts |bounds|:
                proof_collect_bounds(fact, &bounds)
            proof_close_equalities(facts, &bounds)
            for bound in bounds:
                return true if bound.has_lower and bound.has_upper and bound.lower > bound.upper
            return proof_facts_propositionally_inconsistent(facts)

        # Return a conservative interval for affine expressions. Lower and upper knowledge are
        # tracked independently: a fact such as x >= 0 is enough for a later lower-bound goal,
        # but never gets mistaken for a finite interval or used to justify an unsafe operation.
        def proof_interval(expression: Ast::Expr, bounds: darray[ProofBound]&) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            constant: (known: bool, value: i64) = proof_constant_int(expression)
            return (true, constant.value, constant.value, true, true) if constant.known
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_interval(inner, bounds)
                Ast::Expr.Ident(name, _):
                    found: ProofBound = proof_bound_for(bounds, name)
                    return (found.has_lower and found.has_upper, found.lower, found.upper, found.has_lower, found.has_upper)
                Ast::Expr.Unary(operator, operand, _):
                    inner: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(operand, bounds)
                    if operator == TokenKind.Minus:
                        negated_lower: mutable i64 = 0
                        negated_upper: mutable i64 = 0
                        has_negated_lower: mutable bool = inner.has_upper and inner.upper != proof_i64_min()
                        has_negated_upper: mutable bool = inner.has_lower and inner.lower != proof_i64_min()
                        negated_lower <- 0 - inner.upper if has_negated_lower
                        negated_upper <- 0 - inner.lower if has_negated_upper
                        return (has_negated_lower and has_negated_upper, negated_lower, negated_upper, has_negated_lower, has_negated_upper)
                    if operator == TokenKind.Plus:
                        return inner
                Ast::Expr.Binary(left, operator, right, position):
                    a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(left, bounds)
                    b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(right, bounds)
                    if operator == TokenKind.Plus:
                        lower: mutable i64 = 0
                        upper: mutable i64 = 0
                        has_lower: mutable bool = false
                        has_upper: mutable bool = false
                        if a.has_lower and b.has_lower:
                            low: (known: bool, value: i64) = proof_add_safe(a.lower, b.lower)
                            lower <- low.value if low.known
                            has_lower <- low.known
                        if a.has_upper and b.has_upper:
                            high: (known: bool, value: i64) = proof_add_safe(a.upper, b.upper)
                            upper <- high.value if high.known
                            has_upper <- high.known
                        return (has_lower and has_upper, lower, upper, has_lower, has_upper)
                    if operator == TokenKind.Minus:
                        lower: mutable i64 = 0
                        upper: mutable i64 = 0
                        has_lower: mutable bool = false
                        has_upper: mutable bool = false
                        if a.has_lower and b.has_upper:
                            low_sub: (known: bool, value: i64) = proof_sub_safe(a.lower, b.upper)
                            lower <- low_sub.value if low_sub.known
                            has_lower <- low_sub.known
                        if a.has_upper and b.has_lower:
                            high_sub: (known: bool, value: i64) = proof_sub_safe(a.upper, b.lower)
                            upper <- high_sub.value if high_sub.known
                            has_upper <- high_sub.known
                        return (has_lower and has_upper, lower, upper, has_lower, has_upper)
                    if operator == TokenKind.Star and a.known and b.known:
                        p1_result: (known: bool, value: i64) = proof_mul_safe(a.lower, b.lower)
                        p2_result: (known: bool, value: i64) = proof_mul_safe(a.lower, b.upper)
                        p3_result: (known: bool, value: i64) = proof_mul_safe(a.upper, b.lower)
                        p4_result: (known: bool, value: i64) = proof_mul_safe(a.upper, b.upper)
                        return (false, 0, 0, false, false) if not p1_result.known or not p2_result.known or not p3_result.known or not p4_result.known
                        p1: i64 = p1_result.value
                        p2: i64 = p2_result.value
                        p3: i64 = p3_result.value
                        p4: i64 = p4_result.value
                        low: mutable i64 = p1
                        high: mutable i64 = p1
                        low <- p2 if p2 < low
                        low <- p3 if p3 < low
                        low <- p4 if p4 < low
                        high <- p2 if p2 > high
                        high <- p3 if p3 > high
                        high <- p4 if p4 > high
                        return (true, low, high, true, true)
                    if operator == TokenKind.Slash and b.known and b.lower == b.upper and a.has_lower and a.has_upper:
                        lower_quotient: (known: bool, value: i64) = proof_div_safe(a.lower, b.lower)
                        upper_quotient: (known: bool, value: i64) = proof_div_safe(a.upper, b.lower)
                        return (false, 0, 0, false, false) if not lower_quotient.known or not upper_quotient.known
                        return (true, lower_quotient.value, upper_quotient.value, true, true) if b.lower > 0
                        return (true, upper_quotient.value, lower_quotient.value, true, true)
                    if operator == TokenKind.Percent:
                        divisor: (known: bool, value: i64) = proof_constant_int(right)
                        # `MIN_I64 % -1` is the fixed-width overflow edge. The interval
                        # tier does not retain enough information to prove that the dividend
                        # excludes MIN_I64, so reject divisor -1 instead of treating this as a
                        # universally safe machine-integer remainder.
                        return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or divisor.value == -1
                        magnitude: mutable i64 = divisor.value
                        if magnitude < 0:
                            absolute: (known: bool, value: i64) = proof_sub_safe(0, magnitude)
                            return (false, 0, 0, false, false) if not absolute.known
                            magnitude <- absolute.value
                        remainder_limit: (known: bool, value: i64) = proof_sub_safe(magnitude, 1)
                        return (false, 0, 0, false, false) if not remainder_limit.known
                        negative_limit: (known: bool, value: i64) = proof_sub_safe(0, remainder_limit.value)
                        return (false, 0, 0, false, false) if not negative_limit.known
                        return (true, negative_limit.value, remainder_limit.value, true, true)
                _:
                    pass
            return (false, 0, 0, false, false)

        def proof_exact_int_from_facts(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, value: i64):
            constant: (known: bool, value: i64) = proof_constant_int(expression)
            return constant if constant.known
            bounds: mutable darray[ProofBound] = []
            for fact in facts |bounds|:
                proof_collect_bounds(fact, &bounds)
            proof_close_equalities(facts, &bounds)
            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
            return (true, interval.lower) if interval.known and interval.lower == interval.upper
            return (false, 0)

        def proof_affine_expression(expression: Ast::Expr) -> ProofAffine:
            empty: ProofAffine = ProofAffine{known: false, base: "", offset: 0, negative: false}
            constant: (known: bool, value: i64) = proof_constant_int(expression)
            return ProofAffine{known: true, base: "", offset: constant.value, negative: false} if constant.known
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_affine_expression(inner)
                Ast::Expr.Ident(name, _):
                    return ProofAffine{known: name != "", base: name, offset: 0, negative: false}
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_affine_expression(operand)
                Ast::Expr.Unary(TokenKind.Minus, operand, _):
                    inner: ProofAffine = proof_affine_expression(operand)
                    return empty if not inner.known or inner.base == ""
                    negated_offset: (known: bool, value: i64) = proof_sub_safe(0, inner.offset)
                    return empty if not negated_offset.known
                    return ProofAffine{known: true, base: inner.base, offset: negated_offset.value, negative: not inner.negative}
                Ast::Expr.Binary(left, operator, right, _):
                    left_affine: ProofAffine = proof_affine_expression(left)
                    right_constant: (known: bool, value: i64) = proof_constant_int(right)
                    if left_affine.known and left_affine.base != "" and right_constant.known:
                        if operator == TokenKind.Plus:
                            combined: (known: bool, value: i64) = proof_add_safe(left_affine.offset, right_constant.value)
                            return ProofAffine{known: true, base: left_affine.base, offset: combined.value, negative: left_affine.negative} if combined.known
                        if operator == TokenKind.Minus:
                            # `x - MIN_I64` has no representable +offset form. Decline it
                            # rather than manufacturing an overflowing negation.
                            return empty if right_constant.value == proof_i64_min()
                            negated: (known: bool, value: i64) = proof_sub_safe(0, right_constant.value)
                            combined: (known: bool, value: i64) = proof_add_safe(left_affine.offset, negated.value) if negated.known else (false, 0)
                            return ProofAffine{known: true, base: left_affine.base, offset: combined.value, negative: left_affine.negative} if combined.known
                        if operator == TokenKind.Star and right_constant.value == 1:
                            return left_affine
                    left_constant: (known: bool, value: i64) = proof_constant_int(left)
                    right_affine: ProofAffine = proof_affine_expression(right)
                    if left_constant.known and right_affine.known and operator == TokenKind.Plus:
                        combined: (known: bool, value: i64) = proof_add_safe(left_constant.value, right_affine.offset)
                        return ProofAffine{known: true, base: right_affine.base, offset: combined.value, negative: right_affine.negative} if combined.known
                    if left_constant.known and right_affine.known and right_affine.base != "" and operator == TokenKind.Minus:
                        combined: (known: bool, value: i64) = proof_sub_safe(left_constant.value, right_affine.offset) if not right_affine.negative else proof_add_safe(left_constant.value, right_affine.offset)
                        return ProofAffine{known: true, base: right_affine.base, offset: combined.value, negative: not right_affine.negative} if combined.known
                    if left_constant.known and operator == TokenKind.Star and left_constant.value == 1:
                        return right_affine
                _:
                    pass
            return empty

        # Prove that an affine expression is evaluated without fixed-width overflow for every
        # value in the current interval. Only the endpoint relevant to the offset is required:
        # positive offsets need an upper bound, negative offsets a lower bound.
        # A difference constraint carries a bound from one name to another: `x - y <= c` with
        # `y <= U` gives `x <= U + c`, and with `x >= L` gives `y >= L - c`. The interval pass
        # collects only the bounds a fact states about a name directly, so `index < count` beside
        # `count <= 1000` left `index` with no upper bound at all -- and the overflow guard, which
        # asks for exactly that, refused `index + 1` even though 999 was derivable. Each step is an
        # ordinary interval inference and can only narrow an interval that already held. The round
        # cap keeps this linear; a bound that needs more rounds is simply not derived, which only
        # loses a proof.
        const PROOF_BOUND_PROPAGATION_ROUNDS: usize = 4

        # `a + 1` cannot overflow when a fact bounds `a` strictly below a value of the same unsigned
        # width: `a < Y` gives `a + 1 <= Y`, and `Y` is at most the type's maximum by typing alone.
        # This is the addition counterpart of the guarded-subtraction rule, and like it the
        # argument is relational rather than numeric -- which is the whole point. A 64-bit unsigned
        # value has no representable interval in this prover's i64 domain, so an interval argument
        # can never admit `index + 1` for a `usize`, however the facts are arranged, while this one
        # needs no magnitude at all.
        # The expression form of the same relational argument: `a + 1` is in range when a fact says
        # `a < Y` for a `Y` of the same unsigned width, because `Y` is at most the type's maximum
        # by typing. No interval is involved, which is what lets it work for `usize` -- a 64-bit
        # unsigned value has no representable interval in this prover's i64 domain at all.
        def proof_unsigned_unit_increment_base(left: Ast::Expr, right: Ast::Expr) -> (known: bool, base: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            right_constant: (known: bool, value: i64) = proof_constant_int(right)
            return (true, left) if right_constant.known and right_constant.value == 1
            left_constant: (known: bool, value: i64) = proof_constant_int(left)
            return (true, right) if left_constant.known and left_constant.value == 1
            return (false, Ast::Expr.Invalid)

        # A peer that may bound an increment: a bare name, or a field of one. Neither can mention the
        # base's own increment, which is what the restriction is for -- `a < a + 1` is precisely the
        # claim whose range this decides, and neither shape can spell it. A field place is admitted
        # because `index < values.count` is how a bound is written wherever a collection is walked.
        def proof_peer_is_nameable(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_peer_is_nameable(inner)
                Ast::Expr.Ident(name, _):
                    return name != ""
                Ast::Expr.Field(object, field_name, _):
                    return field_name != "" and proof_ident_name(proof_strip_parens(object)) != ""
                _:
                    return false

        # The width of a term when it is used as a *peer*, which is a narrower question than the
        # width of a term in arithmetic. The element count of a collection is a `usize`, but nothing
        # records a width marker for a field place, so `values.count` has no width and the peer rule
        # cannot use the one bound every loop over a collection has. Reporting the platform width
        # only here is safe in the direction the peer rule uses it -- it needs
        # `peer <= TYPE_MAX(base)`, and a peer reported wider than it is can only make that test
        # fail -- and it deliberately does not reach `proof_unsigned_width_in_expression`, where it
        # would make every arithmetic term containing `.count` subject to the unsigned wrap guard
        # and cost far more proofs than it buys.
        def proof_peer_unsigned_width(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> i64:
            declared: i64 = proof_unsigned_width_in_expression(expression, facts)
            return declared if declared != 0
            match proof_strip_parens(expression):
                Ast::Expr.Field(object, field_name, _):
                    return 0 if field_name != "count"
                    return 64 if proof_ident_name(proof_strip_parens(object)) != ""
                    return 0
                _:
                    return 0

        def proof_unsigned_increment_has_strict_peer(base: Ast::Expr, width: i64, facts: darray[Ast::Expr]&) -> bool:
            return false if width == 0
            for fact in facts |fact, base, width, facts|:
                match fact:
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        # The peer is required to be a bare name. A peer that mentioned the base
                        # could justify itself -- `a < a + 1` is exactly the claim whose range this
                        # rule is deciding -- and a name cannot.
                        if fact_operator == TokenKind.Lt and proof_expr_equal(fact_left, base) and proof_peer_is_nameable(fact_right):
                            return true if proof_peer_unsigned_width(fact_right, facts) == width
                        if fact_operator == TokenKind.Gt and proof_expr_equal(fact_right, base) and proof_peer_is_nameable(fact_left):
                            return true if proof_peer_unsigned_width(fact_left, facts) == width
                    _:
                        pass
            return false

        def proof_affine_unsigned_peer_safe(affine: ProofAffine, constraints: darray[ProofDifference]&, facts: darray[Ast::Expr]&) -> bool:
            return false if not affine.known or affine.negative or affine.offset != 1 or affine.base == ""
            width: i64 = proof_unsigned_marker_width_for_name(facts, affine.base)
            return false if width == 0
            for constraint in constraints |constraint, affine, width, facts|:
                continue if constraint.left != affine.base or constraint.right == ""
                # `left - right <= -1` is `left < right`, which is the strictness the argument needs.
                continue if constraint.bound > -1
                return true if proof_unsigned_marker_width_for_name(facts, constraint.right) == width
            return false

        def proof_close_bounds_through_differences(constraints: darray[ProofDifference]&, bounds: mutable darray[ProofBound]&) -> void:
            return if constraints.count == 0
            for round in 0..<PROOF_BOUND_PROPAGATION_ROUNDS |round, constraints, bounds|:
                for constraint in constraints |constraint, bounds|:
                    continue if constraint.left == "" or constraint.right == ""
                    right_bound: ProofBound = proof_bound_for(bounds, constraint.right)
                    if right_bound.has_upper:
                        derived_upper: (known: bool, value: i64) = proof_add_safe(right_bound.upper, constraint.bound)
                        proof_add_upper(bounds, constraint.left, derived_upper.value) if derived_upper.known
                    left_bound: ProofBound = proof_bound_for(bounds, constraint.left)
                    if left_bound.has_lower:
                        derived_lower: (known: bool, value: i64) = proof_sub_safe(left_bound.lower, constraint.bound)
                        proof_add_lower(bounds, constraint.right, derived_lower.value) if derived_lower.known

        def proof_affine_safe(affine: ProofAffine, bounds: darray[ProofBound]&) -> bool:
            return false if not affine.known
            return true if affine.base == ""
            return true if not affine.negative and affine.offset == 0
            base_bound: ProofBound = proof_bound_for(bounds, affine.base)
            if affine.negative:
                return false if not base_bound.has_lower or not base_bound.has_upper
                negated_upper: (known: bool, value: i64) = proof_sub_safe(0, base_bound.upper)
                negated_lower: (known: bool, value: i64) = proof_sub_safe(0, base_bound.lower)
                return false if not negated_upper.known or not negated_lower.known
                lower: (known: bool, value: i64) = proof_add_safe(negated_upper.value, affine.offset)
                upper: (known: bool, value: i64) = proof_add_safe(negated_lower.value, affine.offset)
                return lower.known and upper.known
            if affine.offset > 0:
                limit: (known: bool, value: i64) = proof_sub_safe(proof_i64_max(), affine.offset)
                return limit.known and base_bound.has_upper and base_bound.upper <= limit.value
            limit: (known: bool, value: i64) = proof_sub_safe(proof_i64_min(), affine.offset)
            return limit.known and base_bound.has_lower and base_bound.lower >= limit.value

        def proof_difference_push(left: ProofAffine, right: ProofAffine, reverse: bool, strict: bool, constraints: mutable darray[ProofDifference]&) -> void:
            first: ProofAffine = left if not reverse else right
            second: ProofAffine = right if not reverse else left
            difference: (known: bool, value: i64) = proof_sub_safe(second.offset, first.offset)
            return if not difference.known
            bound: mutable i64 = difference.value
            if strict:
                decremented: (known: bool, value: i64) = proof_sub_safe(bound, 1)
                return if not decremented.known
                bound <- decremented.value
            # Encode `sign * base + offset` as a difference constraint only when the resulting
            # relation is representable by the graph. A negative affine term reverses the graph
            # edge; dropping that sign would turn `0 - x <= 0` into the false bound `x <= 0`.
            if first.base == "" and second.base == "":
                constraints.push(ProofDifference{left: "", right: "", bound: bound})
                return
            if first.base == "":
                constraints.push(ProofDifference{left: second.base, right: "", bound: bound}) if second.negative
                constraints.push(ProofDifference{left: "", right: second.base, bound: bound}) if not second.negative
                return
            if second.base == "":
                constraints.push(ProofDifference{left: "", right: first.base, bound: bound}) if first.negative
                constraints.push(ProofDifference{left: first.base, right: "", bound: bound}) if not first.negative
                return
            return if first.negative != second.negative
            constraints.push(ProofDifference{left: second.base, right: first.base, bound: bound}) if first.negative
            constraints.push(ProofDifference{left: first.base, right: second.base, bound: bound}) if not first.negative

        # Normalize only comparison facts whose affine subexpressions are safe to evaluate for
        # the current fixed-width intervals. A relation involving `x + 1` is not imported unless
        # the known bounds prove that expression cannot wrap.
        def proof_collect_difference_constraints(expression: Ast::Expr, bounds: darray[ProofBound]&, constraints: mutable darray[ProofDifference]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_collect_difference_constraints(inner, bounds, constraints)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated_operator: TokenKind = proof_comparison_negation(operator)
                            proof_collect_difference_constraints(Ast::Expr.Binary(left, negated_operator, right, Ast::expr_pos(expression)), bounds, constraints) if negated_operator != TokenKind.Eof
                        _:
                            pass
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And:
                        proof_collect_difference_constraints(left, bounds, constraints)
                        proof_collect_difference_constraints(right, bounds, constraints)
                        return
                    return if not proof_is_comparison(operator)
                    left_affine: ProofAffine = proof_affine_expression(left)
                    right_affine: ProofAffine = proof_affine_expression(right)
                    return if not proof_affine_safe(left_affine, bounds) or not proof_affine_safe(right_affine, bounds)
                    if operator == TokenKind.LtEq:
                        proof_difference_push(left_affine, right_affine, false, false, constraints)
                    if operator == TokenKind.Lt:
                        proof_difference_push(left_affine, right_affine, false, true, constraints)
                    if operator == TokenKind.GtEq:
                        proof_difference_push(left_affine, right_affine, true, false, constraints)
                    if operator == TokenKind.Gt:
                        proof_difference_push(left_affine, right_affine, true, true, constraints)
                    if operator == TokenKind.EqEq:
                        proof_difference_push(left_affine, right_affine, false, false, constraints)
                        proof_difference_push(left_affine, right_affine, true, false, constraints)
                _:
                    pass

        def proof_difference_node_index(nodes: darray[sview]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < nodes.count |index, nodes, name|:
                return index if nodes[index] == name
                index <- index + 1
            return nodes.count

        def proof_difference_matrix_query(nodes: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, left: sview, right: sview, bound: i64) -> bool:
            left_index: usize = proof_difference_node_index(nodes, left)
            right_index: usize = proof_difference_node_index(nodes, right)
            return false if left_index >= nodes.count or right_index >= nodes.count
            slot: usize = left_index * nodes.count + right_index
            return known[slot] and matrix[slot] <= bound

        # Query the graph representation of `first OP second` after offsets have been moved
        # into `bound`. The sign bit is part of the affine meaning: `-x <= 0` is an edge from
        # zero to x, while `x <= 0` is an edge from x to zero. Mixed signs with two symbolic
        # bases would require a non-difference constraint such as `x + y <= k`, so decline them.
        def proof_difference_affine_query(nodes: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, first: ProofAffine, second: ProofAffine, bound: i64) -> bool:
            return proof_difference_matrix_query(nodes, matrix, known, "", "", bound) if first.base == "" and second.base == ""
            if first.base == "":
                return proof_difference_matrix_query(nodes, matrix, known, second.base, "", bound) if second.negative
                return proof_difference_matrix_query(nodes, matrix, known, "", second.base, bound)
            if second.base == "":
                return proof_difference_matrix_query(nodes, matrix, known, "", first.base, bound) if first.negative
                return proof_difference_matrix_query(nodes, matrix, known, first.base, "", bound)
            return false if first.negative != second.negative
            return proof_difference_matrix_query(nodes, matrix, known, second.base, first.base, bound) if first.negative
            return proof_difference_matrix_query(nodes, matrix, known, first.base, second.base, bound)

        # Floyd-Warshall closure over a bounded relation graph. The node and constraint caps are
        # resource guards: a hostile source file can force an opaque proof failure, never an
        # unbounded allocation or an arithmetic overflow in the closure itself.
        def proof_difference_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return false if not proof_is_comparison(operator) or operator == TokenKind.BangEq
            bounds: mutable darray[ProofBound] = []
            constraints: mutable darray[ProofDifference] = []
            for fact in facts |bounds, constraints|:
                proof_collect_bounds(fact, &bounds)
            proof_close_equalities(facts, &bounds)
            left_affine: ProofAffine = proof_affine_expression(left)
            right_affine: ProofAffine = proof_affine_expression(right)
            for fact in facts |bounds, constraints|:
                proof_collect_difference_constraints(fact, bounds, &constraints)
            return false if constraints.count > 4096
            # The constraints are collected before the overflow guard runs, because they are what
            # gives a name an interval when no fact states one about it directly.
            proof_close_bounds_through_differences(constraints, &bounds)
            left_safe: bool = proof_affine_safe(left_affine, bounds) or proof_affine_unsigned_peer_safe(left_affine, constraints, facts)
            right_safe: bool = proof_affine_safe(right_affine, bounds) or proof_affine_unsigned_peer_safe(right_affine, constraints, facts)
            return false if not left_safe or not right_safe
            nodes: mutable darray[sview] = [""]
            for constraint in constraints |nodes|:
                nodes.push(constraint.left) if constraint.left != "" and proof_difference_node_index(nodes, constraint.left) == nodes.count
                nodes.push(constraint.right) if constraint.right != "" and proof_difference_node_index(nodes, constraint.right) == nodes.count
            return false if nodes.count > 128
            matrix: mutable darray[i64] = []
            known: mutable darray[bool] = []
            matrix.resize(nodes.count * nodes.count)
            known.resize(nodes.count * nodes.count)
            for index in 0..<matrix.count |index, matrix, known|:
                matrix[index] <- 0
                known[index] <- false
            for index in 0..<nodes.count |index, nodes, matrix, known|:
                slot: usize = index * nodes.count + index
                matrix[slot] <- 0
                known[slot] <- true
            for constraint in constraints |constraint, nodes, matrix, known|:
                left_index: usize = proof_difference_node_index(nodes, constraint.left)
                right_index: usize = proof_difference_node_index(nodes, constraint.right)
                slot: usize = left_index * nodes.count + right_index
                matrix[slot] <- constraint.bound if not known[slot] or constraint.bound < matrix[slot]
                known[slot] <- true
            for pivot in 0..<nodes.count |pivot, nodes, matrix, known|:
                for source in 0..<nodes.count |source, pivot, nodes, matrix, known|:
                    first_slot: usize = source * nodes.count + pivot
                    continue if not known[first_slot]
                    for target in 0..<nodes.count |target, source, pivot, nodes, matrix, known|:
                        second_slot: usize = pivot * nodes.count + target
                        continue if not known[second_slot]
                        combined: (known: bool, value: i64) = proof_add_safe(matrix[first_slot], matrix[second_slot])
                        continue if not combined.known
                        result_slot: usize = source * nodes.count + target
                        matrix[result_slot] <- combined.value if not known[result_slot] or combined.value < matrix[result_slot]
                        known[result_slot] <- true
            target_bound: mutable i64 = 0
            if operator == TokenKind.LtEq or operator == TokenKind.Lt:
                difference: (known: bool, value: i64) = proof_sub_safe(right_affine.offset, left_affine.offset)
                return false if not difference.known
                target_bound <- difference.value
                if operator == TokenKind.Lt:
                    decremented: (known: bool, value: i64) = proof_sub_safe(target_bound, 1)
                    return false if not decremented.known
                    target_bound <- decremented.value
            if operator == TokenKind.GtEq or operator == TokenKind.Gt:
                difference: (known: bool, value: i64) = proof_sub_safe(left_affine.offset, right_affine.offset)
                return false if not difference.known
                target_bound <- difference.value
                if operator == TokenKind.Gt:
                    decremented: (known: bool, value: i64) = proof_sub_safe(target_bound, 1)
                    return false if not decremented.known
                    target_bound <- decremented.value
            if operator == TokenKind.EqEq:
                forward_difference: (known: bool, value: i64) = proof_sub_safe(right_affine.offset, left_affine.offset)
                reverse_difference: (known: bool, value: i64) = proof_sub_safe(left_affine.offset, right_affine.offset)
                return false if not forward_difference.known or not reverse_difference.known
                return proof_difference_affine_query(nodes, matrix, known, left_affine, right_affine, forward_difference.value) and proof_difference_affine_query(nodes, matrix, known, right_affine, left_affine, reverse_difference.value)
            return proof_difference_affine_query(nodes, matrix, known, left_affine, right_affine, target_bound) if operator == TokenKind.LtEq or operator == TokenKind.Lt
            return proof_difference_affine_query(nodes, matrix, known, right_affine, left_affine, target_bound)

        # Compare two affine expressions sharing the same base. The operation safety checks are
        # independent of the comparison itself; without them a wrapped `x + 1` could reverse
        # the mathematical difference at the i64 endpoint.
        def proof_affine_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, bounds: darray[ProofBound]&, facts: darray[Ast::Expr]&) -> bool:
            left_affine: ProofAffine = proof_affine_expression(left)
            right_affine: ProofAffine = proof_affine_expression(right)
            return false if not left_affine.known or not right_affine.known or left_affine.base == ""
            return false if left_affine.base != right_affine.base and not proof_names_equal_from_facts(left_affine.base, right_affine.base, facts)
            return false if left_affine.negative != right_affine.negative
            return false if not proof_affine_safe(left_affine, bounds) or not proof_affine_safe(right_affine, bounds)
            difference: (known: bool, value: i64) = proof_sub_safe(left_affine.offset, right_affine.offset)
            return false if not difference.known
            return difference.value > 0 if operator == TokenKind.Gt
            return difference.value >= 0 if operator == TokenKind.GtEq
            return difference.value < 0 if operator == TokenKind.Lt
            return difference.value <= 0 if operator == TokenKind.LtEq
            return difference.value != 0 if operator == TokenKind.BangEq
            return difference.value == 0 if operator == TokenKind.EqEq
            return false

        # Evaluate a bounded contract quantifier by finite instantiation. The range bounds must
        # be constants (possibly made constant by exact facts), the body must be understood by
        # the ordinary kernel, and the work budget is capped. This is a proof-producing check,
        # not a heuristic: forall requires every instance and exists requires a checked witness.
        def proof_quantifier_goal(facts: darray[Ast::Expr]&, expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            kind: sview = proof_quantifier_kind(expression, annotations)
            return false if kind == ""
            # Keep source-side instantiation behind the same shape gate as the certificate
            # encoder. In particular, dictionary binders must be distinct and their erased
            # initializer must be the exact parser placeholder.
            return false if not proof_kernel_expression_supported(expression)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_quantifier_goal(facts, inner, annotations, depth, budget, split_depth, exhausted)
                Ast::Expr.Block(statements, body, _, _):
                    return false if statements.count == 0
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, _, range_expression, _):
                            match range_expression:
                                Ast::Expr.Binary(lower_expression, range_operator, upper_expression, _):
                                    return false if statements.count != 1
                                    return false if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                                    lower: (known: bool, value: i64) = proof_exact_int_from_facts(lower_expression, facts)
                                    upper: (known: bool, value: i64) = proof_exact_int_from_facts(upper_expression, facts)
                                    return false if not lower.known or not upper.known
                                    if range_operator == TokenKind.RangeLt and lower.value >= upper.value:
                                        return kind == "forall"
                                    if range_operator == TokenKind.RangeLe and lower.value > upper.value:
                                        return kind == "forall"
                                    width_difference: (known: bool, value: i64) = proof_sub_safe(upper.value, lower.value)
                                    return false if not width_difference.known
                                    width: mutable i64 = width_difference.value
                                    if range_operator == TokenKind.RangeLe:
                                        width_with_end: (known: bool, value: i64) = proof_add_safe(width, 1)
                                        return false if not width_with_end.known
                                        width <- width_with_end.value
                                    return false if width <= 0
                                    if width > 65536:
                                        # The range is finite but larger than the instantiation
                                        # budget. That is a resource limit, not a verdict.
                                        exhausted <- true
                                        return false
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = []
                                    candidate: mutable i64 = lower.value
                                    offset: mutable i64 = 0
                                    while offset < width |offset, candidate, binder_values, binder_names, facts, body, annotations, kind, budget, exhausted|:
                                        if budget >= 65536:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        binder_values.clear()
                                        binder_values.push(Ast::Expr.IntLit(candidate))
                                        instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                        proven: bool = proof_goal_depth(facts, instance, annotations, depth + 1, budget, split_depth, exhausted)
                                        return false if kind == "forall" and not proven
                                        return true if kind == "exists" and proven
                                        offset <- offset + 1
                                        if offset < width:
                                            next_candidate: (known: bool, value: i64) = proof_add_safe(candidate, 1)
                                            return false if not next_candidate.known
                                            candidate <- next_candidate.value
                                    return kind == "forall"
                                _:
                                    pass
                            # Finite literal collections are also safe to instantiate. Dynamic
                            # collections remain opaque: without a heap snapshot or a quantified
                            # collection invariant, iterating them here would silently assume
                            # that their contents are stable and fully represented by the AST.
                            match range_expression:
                                Ast::Expr.Array(elements, _):
                                    return false if statements.count != 1
                                    return false if elements.count > 65536
                                    return false if elements.count == 0 and kind == "exists"
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = []
                                    collection_offset: mutable usize = 0
                                    while collection_offset < elements.count |collection_offset, elements, binder_names, binder_values, facts, body, annotations, kind, budget, depth, exhausted|:
                                        if budget >= 65536:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        binder_values.clear()
                                        binder_values.push(elements[collection_offset])
                                        instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                        proven: bool = proof_goal_depth(facts, instance, annotations, depth + 1, budget, split_depth, exhausted)
                                        return false if kind == "forall" and not proven
                                        return true if kind == "exists" and proven
                                        collection_offset <- collection_offset + 1
                                    return kind == "forall"
                                Ast::Expr.Tuple(elements, _):
                                    return false if statements.count != 1
                                    return false if elements.count > 65536
                                    return false if elements.count == 0 and kind == "exists"
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = []
                                    collection_offset: mutable usize = 0
                                    while collection_offset < elements.count |collection_offset, elements, binder_names, binder_values, facts, body, annotations, kind, budget, depth, exhausted|:
                                        if budget >= 65536:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        binder_values.clear()
                                        binder_values.push(elements[collection_offset])
                                        instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                        proven: bool = proof_goal_depth(facts, instance, annotations, depth + 1, budget, split_depth, exhausted)
                                        return false if kind == "forall" and not proven
                                        return true if kind == "exists" and proven
                                        collection_offset <- collection_offset + 1
                                    return kind == "forall"
                                Ast::Expr.SetLit(elements, _):
                                    return false if statements.count != 1
                                    return false if elements.count > 65536
                                    return false if elements.count == 0 and kind == "exists"
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = []
                                    collection_offset: mutable usize = 0
                                    while collection_offset < elements.count |collection_offset, elements, binder_names, binder_values, facts, body, annotations, kind, budget, depth, exhausted|:
                                        if budget >= 65536:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        binder_values.clear()
                                        binder_values.push(elements[collection_offset])
                                        instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                        proven: bool = proof_goal_depth(facts, instance, annotations, depth + 1, budget, split_depth, exhausted)
                                        return false if kind == "forall" and not proven
                                        return true if kind == "exists" and proven
                                        collection_offset <- collection_offset + 1
                                    return kind == "forall"
                                Ast::Expr.DictLit(entries, _):
                                    return false if statements.count != 2
                                    return false if entries.count > 32768
                                    return false if entries.count == 0 and kind == "exists"
                                    match statements[1]:
                                        Ast::Stmt.VarDecl(value_binder, _, _, _):
                                            binder_names: mutable darray[sview] = [binder, value_binder]
                                            binder_values: mutable darray[Ast::Expr] = []
                                            dictionary_offset: mutable usize = 0
                                            while dictionary_offset < entries.count |dictionary_offset, entries, binder_names, binder_values, facts, body, annotations, kind, budget, depth, exhausted|:
                                                if budget >= 65536:
                                                    exhausted <- true
                                                    return false
                                                budget <- budget + 1
                                                binder_values.clear()
                                                binder_values.push(entries[dictionary_offset].key)
                                                binder_values.push(entries[dictionary_offset].value)
                                                instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                                proven: bool = proof_goal_depth(facts, instance, annotations, depth + 1, budget, split_depth, exhausted)
                                                return false if kind == "forall" and not proven
                                                return true if kind == "exists" and proven
                                                dictionary_offset <- dictionary_offset + 1
                                            return kind == "forall"
                                        _:
                                            return false
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false

        # A cancellation rule handles only exact identities and x + 0 / x - 0. We deliberately
        # do not infer x + c OP x for c != 0 here: Elisa integers are fixed-width, so that
        # statement can fail at an endpoint because of overflow. The separate affine tier may
        # prove such a relation only when explicit bounds establish that both expressions are
        # safe; neither tier guesses about opaque calls.
        def proof_delta_constant(left: Ast::Expr, right: Ast::Expr) -> (known: bool, value: i64):
            if proof_expr_equal(left, right):
                return (true, 0)
            match left:
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_value: (known: bool, value: i64) = proof_constant_int(amount)
                    if amount_value.known and proof_expr_equal(base, right):
                        return (true, 0) if amount_value.value == 0 and (operator == TokenKind.Plus or operator == TokenKind.Minus)
                _:
                    pass
            match right:
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_value: (known: bool, value: i64) = proof_constant_int(amount)
                    if amount_value.known and proof_expr_equal(base, left):
                        return (true, 0) if amount_value.value == 0 and (operator == TokenKind.Plus or operator == TokenKind.Minus)
                _:
                    pass
            return (false, 0)

        # Definitional fixed-width identities. These rewrites are valid for every i64 value,
        # including endpoints: adding/subtracting zero, multiplying by zero/one, dividing by
        # one, taking a remainder by one, and the listed bitwise identities cannot introduce an
        # arithmetic side condition. We intentionally do not add cancellation, distributivity,
        # or x / x rules here.
        def proof_definitionally_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return true if proof_expr_equal(left, right)
            match left:
                Ast::Expr.Paren(inner, _):
                    return proof_definitionally_equal(inner, right)
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_definitionally_equal(operand, right)
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_constant: (known: bool, value: i64) = proof_constant_int(amount)
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 0
                    if operator == TokenKind.Star:
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 1
                        target_constant: (known: bool, value: i64) = proof_constant_int(right)
                        return target_constant.known and target_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        return proof_definitionally_equal(amount, right) if base_constant.known and base_constant.value == 1
                        return target_constant.known and target_constant.value == 0 if base_constant.known and base_constant.value == 0
                    if operator == TokenKind.Slash:
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Percent:
                        target_constant: (known: bool, value: i64) = proof_constant_int(right)
                        return target_constant.known and target_constant.value == 0 if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Ampersand:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        target_constant: (known: bool, value: i64) = proof_constant_int(right)
                        return target_constant.known and target_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        return target_constant.known and target_constant.value == 0 if base_constant.known and base_constant.value == 0
                        return proof_definitionally_equal(base, right) if proof_expr_equal(base, amount)
                    if operator == TokenKind.Pipe:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 0
                        return proof_definitionally_equal(amount, right) if base_constant.known and base_constant.value == 0
                        return proof_definitionally_equal(base, right) if proof_expr_equal(base, amount)
                    if operator == TokenKind.Caret:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        target_constant: (known: bool, value: i64) = proof_constant_int(right)
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 0
                        return proof_definitionally_equal(amount, right) if base_constant.known and base_constant.value == 0
                        return target_constant.known and target_constant.value == 0 if proof_expr_equal(base, amount)
                    if operator == TokenKind.LShift or operator == TokenKind.RShift:
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 0
                _:
                    pass
            match right:
                Ast::Expr.Paren(inner, _):
                    return proof_definitionally_equal(left, inner)
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_definitionally_equal(left, operand)
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_constant: (known: bool, value: i64) = proof_constant_int(amount)
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 0
                    if operator == TokenKind.Star:
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 1
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return left_constant.known and left_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        return proof_definitionally_equal(left, amount) if base_constant.known and base_constant.value == 1
                        return left_constant.known and left_constant.value == 0 if base_constant.known and base_constant.value == 0
                    if operator == TokenKind.Slash:
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Percent:
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return left_constant.known and left_constant.value == 0 if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Ampersand:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return left_constant.known and left_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        return left_constant.known and left_constant.value == 0 if base_constant.known and base_constant.value == 0
                        return proof_definitionally_equal(left, base) if proof_expr_equal(base, amount)
                    if operator == TokenKind.Pipe:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 0
                        return proof_definitionally_equal(left, amount) if base_constant.known and base_constant.value == 0
                        return proof_definitionally_equal(left, base) if proof_expr_equal(base, amount)
                    if operator == TokenKind.Caret:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 0
                        return proof_definitionally_equal(left, amount) if base_constant.known and base_constant.value == 0
                        return left_constant.known and left_constant.value == 0 if proof_expr_equal(base, amount)
                    if operator == TokenKind.LShift or operator == TokenKind.RShift:
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 0
                _:
                    pass
            return false

        # The sign of a product, the one nonlinear fact worth deciding. Every other tier here is
        # linear, so `x >= 0, y >= 0 |- x * y >= 0` was out of reach even though it is decidable
        # from the operands' signs alone and needs no multiplication reasoning beyond them.
        #
        # The rule is deliberately syntactic: the required sign facts must be present as facts,
        # matched structurally, rather than re-derived by another search. That keeps it small, and
        # it keeps the producer and the replay kernel able to state exactly the same rule — a tier
        # the two could only approximate would show up as a replay gap rather than a proof.
        #
        # Both operands must be witnessed primitive scalars. Elisa rewrites `*` on a struct operand
        # to a user `__mul__`, which is an ordinary method under no sign law at all.
        def proof_product_sign_operands(expression: Ast::Expr) -> (known: bool, left: Ast::Expr, right: Ast::Expr):
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_product_sign_operands(inner)
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, left, right) if operator == TokenKind.Star
                    return (false, Ast::Expr.Absent, Ast::Expr.Absent)
                _:
                    return (false, Ast::Expr.Absent, Ast::Expr.Absent)

        # Is `term <relation> 0` an explicit fact? Only the four orderings against a literal zero
        # count; anything else would need the arithmetic tiers this rule sits beside.
        def proof_product_sign_fact(term: Ast::Expr, relation: TokenKind, facts: darray[Ast::Expr]&) -> bool:
            for fact in facts |fact, term, relation|:
                match fact:
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        if fact_operator == relation and proof_expr_is_zero_literal(fact_right) and proof_expr_equal(fact_left, term):
                            return true
                        # `0 <= x` is the same fact as `x >= 0`; accept the mirrored form too.
                        mirrored: TokenKind = proof_product_sign_mirror(relation)
                        if fact_operator == mirrored and proof_expr_is_zero_literal(fact_left) and proof_expr_equal(fact_right, term):
                            return true
                    _:
                        pass
            return false

        def proof_product_sign_mirror(relation: TokenKind) -> TokenKind:
            return TokenKind.LtEq if relation == TokenKind.GtEq
            return TokenKind.GtEq if relation == TokenKind.LtEq
            return TokenKind.Lt if relation == TokenKind.Gt
            return TokenKind.Gt if relation == TokenKind.Lt
            return relation

        def proof_expr_is_zero_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_expr_is_zero_literal(inner)
                Ast::Expr.IntLit(value):
                    return value == 0
                _:
                    return false

        def proof_product_sign_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            # Only `product <relation> 0` shapes; the product may sit on either side.
            product: mutable (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_product_sign_operands(left)
            relation: mutable TokenKind = operator
            if not product.known:
                product <- proof_product_sign_operands(right)
                relation <- proof_product_sign_mirror(operator)
                return false if not product.known or not proof_expr_is_zero_literal(left)
            else:
                return false if not proof_expr_is_zero_literal(right)
            return false if not proof_scalar_term_witnessed(product.left, facts, 0) or not proof_scalar_term_witnessed(product.right, facts, 0)
            if relation == TokenKind.GtEq:
                return true if proof_product_sign_fact(product.left, TokenKind.GtEq, facts) and proof_product_sign_fact(product.right, TokenKind.GtEq, facts)
                return proof_product_sign_fact(product.left, TokenKind.LtEq, facts) and proof_product_sign_fact(product.right, TokenKind.LtEq, facts)
            if relation == TokenKind.LtEq:
                return true if proof_product_sign_fact(product.left, TokenKind.GtEq, facts) and proof_product_sign_fact(product.right, TokenKind.LtEq, facts)
                return proof_product_sign_fact(product.left, TokenKind.LtEq, facts) and proof_product_sign_fact(product.right, TokenKind.GtEq, facts)
            if relation == TokenKind.Gt:
                return true if proof_product_sign_fact(product.left, TokenKind.Gt, facts) and proof_product_sign_fact(product.right, TokenKind.Gt, facts)
                return proof_product_sign_fact(product.left, TokenKind.Lt, facts) and proof_product_sign_fact(product.right, TokenKind.Lt, facts)
            if relation == TokenKind.Lt:
                return true if proof_product_sign_fact(product.left, TokenKind.Gt, facts) and proof_product_sign_fact(product.right, TokenKind.Lt, facts)
                return proof_product_sign_fact(product.left, TokenKind.Lt, facts) and proof_product_sign_fact(product.right, TokenKind.Gt, facts)
            return false

        # Chain two recorded comparisons through a shared middle term. The difference engine
        # already does this, but only over atoms it can name: its affine form carries one bare
        # identifier, so `limit <= items.count` is invisible to it and `index < limit` cannot
        # reach `index < items.count`. Structural transitivity needs no atom at all -- the middle
        # term is matched with the same structural equality the kernel replays.
        #
        # The whole rule rests on `<` and `<=` being the primitive integer order, which they are
        # only for witnessed scalars: on a struct they are a user `__lt__`/`__le__` under no
        # transitivity law. Every one of the three terms therefore needs its own scalar witness,
        # exactly as the other comparison rules require.
        const PROOF_CHAIN_CANDIDATE_BUDGET: usize = 32

        def proof_chain_strict(operator: TokenKind) -> bool:
            return operator == TokenKind.Lt

        def proof_chain_ascending(operator: TokenKind) -> bool:
            return operator == TokenKind.Lt or operator == TokenKind.LtEq

        # `a op1 b` and `b op2 c` compose to a strict `a < c` when either step is strict, and to
        # `a <= c` otherwise. A strict conclusion also discharges a non-strict goal; a non-strict
        # one never discharges a strict goal.
        def proof_chain_discharges(first: TokenKind, second: TokenKind, goal: TokenKind) -> bool:
            strict: bool = proof_chain_strict(first) or proof_chain_strict(second)
            return true if strict
            return goal == TokenKind.LtEq

        # `a < R` gives `a + 1 <= R` over the integers, for *any* term `R`. The difference engine
        # already draws this conclusion whenever it can name both sides, but its atom is one bare
        # identifier, so `index < values.count` reaches nothing -- a field place is not an atom,
        # which is the same representation limit the comparison chain was written around. This tier
        # needs no atom at all: it matches the shifted side structurally against the strict fact's
        # own right-hand side.
        #
        # The shift is only sound if `a + 1` does not wrap, which is exactly what the unsigned peer
        # rule decides from this same fact, and for a signed term the ordinary overflow guard does.
        # A goal that is `<` rather than `<=` is not this rule: `a < R` does not give `a + 1 < R`.
        # A sum of two non-constant terms is not an affine form here -- `ProofAffine.base` is one
        # identifier -- so `children_start + index < children.count` reaches no tier that can name
        # it. Both facts that bound such a sum are themselves structural, so the search is too.
        #
        # Shape A, the offset chain: `a + n <= C` and `b < n` give `a + b < C`, because
        # `a + b < a + n <= C`.
        # Shape B, the subtraction transposed: `b <= C - a` with `a <= C` gives `a + b <= C`. The
        # second premise is what makes `C - a` meaningful for an unsigned type, and it is exactly
        # the guard such code already writes beside the subtraction.
        #
        # Both return the bounding term as well as the strictness, because the same search answers
        # the range question: the sum is at most `C`, so it cannot wrap whenever `C` is a term of
        # the same unsigned width. That is the relational argument the peer rule uses for `a + 1`,
        # and it is the only kind available for a 64-bit unsigned value.
        def proof_sum_operands(expression: Ast::Expr) -> (known: bool, left: Ast::Expr, right: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(expression):
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, left, right) if operator == TokenKind.Plus
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)

        def proof_difference_operands(expression: Ast::Expr) -> (known: bool, left: Ast::Expr, right: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(expression):
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, left, right) if operator == TokenKind.Minus
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)

        # A conjunction asserts both of its sides, so a rule that scans facts for a shape has to
        # see inside one. The structural rules matched only a top-level comparison, so a single
        # `requires a <= b and c <= d` was invisible where the same two facts written separately
        # were not. Flattening is a reading of the fact list, not an addition to it: every
        # conjunct was already asserted, and the range guard certifies the whole conjunction
        # before any rule reads either half.
        def proof_push_conjuncts(expression: Ast::Expr, conjuncts: mutable darray[Ast::Expr]&, depth: usize) -> void:
            stripped: Ast::Expr = proof_strip_parens(expression)
            if depth < 32:
                match stripped:
                    Ast::Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And:
                            proof_push_conjuncts(left, conjuncts, depth + 1)
                            proof_push_conjuncts(right, conjuncts, depth + 1)
                            return
                    _:
                        pass
            conjuncts.push(stripped)

        # `not e` where the expression is one, seen through parentheses.
        def proof_negated_operand(expression: Ast::Expr) -> (known: bool, operand: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(expression):
                Ast::Expr.Unary(operator, operand, _):
                    return (true, operand) if operator == TokenKind.Not
                    return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        # A candidate an existing fact denies outright: the fact is its negation, or it is the
        # negation of the fact. Only a literal denial counts -- no tier is consulted, so this
        # cannot decide anything the fact list did not already state.
        def proof_fact_denies(candidate: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            negated: (known: bool, operand: Ast::Expr) = proof_negated_operand(candidate)
            for fact in facts |fact, candidate, negated|:
                return true if negated.known and proof_expr_equal(fact, negated.operand)
                fact_negated: (known: bool, operand: Ast::Expr) = proof_negated_operand(fact)
                return true if fact_negated.known and proof_expr_equal(fact_negated.operand, candidate)
            return false

        # The facts a structural rule may read directly, with conjunctions flattened. A
        # disjunctive premise is not resolved here: the goal solver already opens one by case
        # split, and each branch reaches these rules with the disjunct as an ordinary fact.
        def proof_conjunct_facts(facts: darray[Ast::Expr]&) -> darray[Ast::Expr] can[Memory.Allocate, Abort.Panic]:
            conjuncts: mutable darray[Ast::Expr] = []
            for fact in facts |conjuncts|:
                proof_push_conjuncts(fact, &conjuncts, 0)
            return conjuncts

        # `term <= bound` or `term < bound` recorded as a fact, in either spelling.
        def proof_has_order_fact(term: Ast::Expr, bound: Ast::Expr, strict_only: bool, facts: darray[Ast::Expr]&) -> bool:
            conjuncts: darray[Ast::Expr] = proof_conjunct_facts(facts)
            for fact in conjuncts |fact, term, bound, strict_only|:
                match fact:
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        if fact_operator == TokenKind.Lt and proof_expr_equal(fact_left, term) and proof_expr_equal(fact_right, bound):
                            return true
                        if fact_operator == TokenKind.Gt and proof_expr_equal(fact_right, term) and proof_expr_equal(fact_left, bound):
                            return true
                        continue if strict_only
                        if fact_operator == TokenKind.LtEq and proof_expr_equal(fact_left, term) and proof_expr_equal(fact_right, bound):
                            return true
                        if fact_operator == TokenKind.GtEq and proof_expr_equal(fact_right, term) and proof_expr_equal(fact_left, bound):
                            return true
                    _:
                        pass
            return false

        def proof_sum_witness_for(first: Ast::Expr, second: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, bound: Ast::Expr, strict: bool) can[Memory.Allocate, Abort.Panic]:
            conjuncts: darray[Ast::Expr] = proof_conjunct_facts(facts)
            for fact in conjuncts |fact, first, second, facts|:
                match fact:
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        continue if fact_operator != TokenKind.Lt and fact_operator != TokenKind.LtEq
                        # Shape B: some term is bounded by `bound - first`, with `first <= bound`
                        # recorded beside it -- the guard that makes the subtraction meaningful for
                        # an unsigned type, and the one such code already writes. The bounded term
                        # is `second` itself, or a term `second` is under in turn: a range check
                        # states `count <= total - start` once and every index into it is `< count`.
                        #
                        # The premise is deliberately this shape rather than `first + second <=
                        # bound`. For an unsigned type the latter is a *modular* claim about a sum
                        # that may already have wrapped, so it cannot be read as a bound on the
                        # mathematical sum, and using it to justify its own range is the mistake
                        # `examples/rejected_unsigned_fact_explosion.elisa` pins.
                        difference: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_difference_operands(fact_right)
                        if difference.known and proof_expr_equal(difference.right, first) and proof_has_order_fact(first, difference.left, false, facts):
                            if proof_expr_equal(fact_left, second):
                                return (true, difference.left, fact_operator == TokenKind.Lt)
                            if proof_has_order_fact(second, fact_left, true, facts):
                                return (true, difference.left, true)
                            if fact_operator == TokenKind.Lt and proof_has_order_fact(second, fact_left, false, facts):
                                return (true, difference.left, true)
                            if proof_has_order_fact(second, fact_left, false, facts):
                                return (true, difference.left, false)
                        # There is deliberately no rule reading `first + middle <= bound` as a
                        # premise. For a fixed-width type that is a claim about a sum that may
                        # already have wrapped: at `start = MAX, count = 1, total = 0` the premise
                        # `start + count <= total` holds modulo 2^64 while the mathematical sum does
                        # not, and reading it as an integer bound proves `start + 0 < 0`. The
                        # subtraction form above says the same thing without a sum in it.
                    _:
                        pass
            return (false, Ast::Expr.Invalid, false)

        def proof_sum_upper_witness(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, bound: Ast::Expr, strict: bool) can[Memory.Allocate, Abort.Panic]:
            forward: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_witness_for(left, right, facts)
            return forward if forward.known
            return proof_sum_witness_for(right, left, facts)

        # An unsigned expression that is certified not to wrap has a mathematical value equal to
        # its machine value, and an unsigned machine value is nonnegative. The certification is
        # the same guard every other rule here is gated on, so the rule adds no new assumption:
        # it only reads the answer the guard already computed. Without it a lower-bound obligation
        # on `start + index` is refused even where the matching upper bound is proved, because no
        # affine tier can name a sum of two terms.
        def proof_unsigned_nonnegative_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            zero_left: (known: bool, value: i64) = proof_constant_int(left)
            zero_right: (known: bool, value: i64) = proof_constant_int(right)
            term: mutable Ast::Expr = Ast::Expr.Invalid
            if zero_left.known and zero_left.value == 0 and (operator == TokenKind.LtEq or operator == TokenKind.Lt):
                term <- right
            elif zero_right.known and zero_right.value == 0 and (operator == TokenKind.GtEq or operator == TokenKind.Gt):
                term <- left
            else:
                return false
            # A strict goal claims the value is not zero, which no width argument establishes.
            return false if operator == TokenKind.Lt or operator == TokenKind.Gt
            return false if proof_unsigned_width_in_expression(term, facts) == 0
            return proof_unsigned_expression_safe(term, facts)

        def proof_sum_bound_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return false if operator != TokenKind.Lt and operator != TokenKind.LtEq
            operands: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_sum_operands(left)
            return false if not operands.known
            witness: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness(operands.left, operands.right, facts)
            return false if not witness.known
            return false if not proof_expr_equal(witness.bound, right)
            return false if operator == TokenKind.Lt and not witness.strict
            return proof_sum_range_safe(left, operands.left, operands.right, facts)

        # The sum is at most its witness bound, so for an unsigned type it is in range whenever
        # that bound is a term of the same width. A signed sum keeps the ordinary guard.
        def proof_sum_range_safe(sum: Ast::Expr, first: Ast::Expr, second: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            width: i64 = proof_unsigned_width_in_expression(sum, facts)
            return proof_unsigned_expression_safe(sum, facts) if width == 0
            witness: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness(first, second, facts)
            return false if not witness.known
            return proof_peer_is_nameable(witness.bound) and proof_peer_unsigned_width(witness.bound, facts) == width

        def proof_strict_shift_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return false if operator != TokenKind.LtEq
            shifted: (known: bool, base: Ast::Expr) = proof_shifted_unit_base(left)
            return false if not shifted.known
            return false if not proof_unsigned_expression_safe(left, facts)
            for fact in facts |fact, shifted, right|:
                match fact:
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        if fact_operator == TokenKind.Lt and proof_expr_equal(fact_left, shifted.base) and proof_expr_equal(fact_right, right):
                            return true
                        if fact_operator == TokenKind.Gt and proof_expr_equal(fact_right, shifted.base) and proof_expr_equal(fact_left, right):
                            return true
                    _:
                        pass
            return false

        # `x + 1` and `1 + x`, and nothing else.
        def proof_shifted_unit_base(expression: Ast::Expr) -> (known: bool, base: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_shifted_unit_base(inner)
                Ast::Expr.Binary(left, operator, right, _):
                    return (false, Ast::Expr.Invalid) if operator != TokenKind.Plus
                    return proof_unsigned_unit_increment_base(left, right)
                _:
                    return (false, Ast::Expr.Invalid)

        def proof_comparison_chain_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            goal_operator: mutable TokenKind = operator
            lower: mutable Ast::Expr = left
            upper: mutable Ast::Expr = right
            if operator == TokenKind.Gt:
                goal_operator <- TokenKind.Lt
                lower <- right
                upper <- left
            if operator == TokenKind.GtEq:
                goal_operator <- TokenKind.LtEq
                lower <- right
                upper <- left
            return false if not proof_chain_ascending(goal_operator)
            # The difference engine already chains everything it can name, so this tier is only
            # ever the answer for a goal it could not represent. Requiring one unnameable side
            # keeps the search off every ordinary comparison instead of running it twice.
            lower_affine: ProofAffine = proof_affine_expression(lower)
            upper_affine: ProofAffine = proof_affine_expression(upper)
            return false if lower_affine.known and lower_affine.base != "" and upper_affine.known and upper_affine.base != ""
            return false if not proof_scalar_term_witnessed(lower, facts, 0) or not proof_scalar_term_witnessed(upper, facts, 0)
            # Every enclosing goal that reaches this tier pays for this search, and a frame in
            # this codebase carries hundreds of facts. Collect the two candidate sets in one pass
            # each and pair only those, rather than rescanning every fact per candidate: the sets
            # are the facts that actually mention an endpoint, which is a handful. Both are capped,
            # and a spent cap only ever loses a proof.
            lower_middles: mutable darray[Ast::Expr] = []
            lower_operators: mutable darray[TokenKind] = []
            for fact in facts |facts, lower, lower_middles, lower_operators|:
                break if lower_middles.count >= PROOF_CHAIN_CANDIDATE_BUDGET
                step: (known: bool, middle: Ast::Expr, operator: TokenKind) = proof_chain_step(fact, lower, true, facts)
                continue if not step.known
                lower_middles.push(step.middle)
                lower_operators.push(step.operator)
            return false if lower_middles.count == 0
            upper_middles: mutable darray[Ast::Expr] = []
            upper_operators: mutable darray[TokenKind] = []
            for fact in facts |facts, upper, upper_middles, upper_operators|:
                break if upper_middles.count >= PROOF_CHAIN_CANDIDATE_BUDGET
                step: (known: bool, middle: Ast::Expr, operator: TokenKind) = proof_chain_step(fact, upper, false, facts)
                continue if not step.known
                upper_middles.push(step.middle)
                upper_operators.push(step.operator)
            return false if upper_middles.count == 0
            for first_index in 0..<lower_middles.count |facts, goal_operator, lower_middles, lower_operators, upper_middles, upper_operators|:
                for second_index in 0..<upper_middles.count |facts, goal_operator, first_index, lower_middles, lower_operators, upper_middles, upper_operators|:
                    continue if not proof_chain_discharges(lower_operators[first_index], upper_operators[second_index], goal_operator)
                    continue if not proof_expr_equal(lower_middles[first_index], upper_middles[second_index])
                    # The witness is the expensive check and the last one standing, so it runs
                    # only for a pair that would otherwise discharge the goal.
                    return true if proof_scalar_term_witnessed(lower_middles[first_index], facts, 0)
            return false

        # Read one ascending step out of a fact. With `from_lower` the fact must read
        # `anchor op middle`; otherwise it must read `middle op anchor`. A `>`/`>=` fact is the
        # same step written backwards and is accepted in its mirrored form.
        def proof_chain_step(fact: Ast::Expr, anchor: Ast::Expr, from_lower: bool, facts: darray[Ast::Expr]&) -> (known: bool, middle: Ast::Expr, operator: TokenKind):
            unknown: (known: bool, middle: Ast::Expr, operator: TokenKind) = (false, Ast::Expr.Invalid, TokenKind.Lt)
            match fact:
                Ast::Expr.Paren(inner, _):
                    return proof_chain_step(inner, anchor, from_lower, facts)
                Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                    # An equality is both steps at once. `b == c` gives `b <= c` and `c <= b`, so
                    # it reads as a non-strict step from either end and in either direction. It is
                    # the primitive integer equality only for witnessed scalars -- on a struct it
                    # is a user `__eq__` under no order law at all -- and the two operands of the
                    # fact used here are the chain's anchor and its middle term, both of which the
                    # caller requires a scalar witness for. A step is never strict, so an equality
                    # alone can only ever discharge a non-strict goal.
                    if fact_operator == TokenKind.EqEq:
                        if from_lower:
                            return (true, fact_right, TokenKind.LtEq) if proof_expr_equal(fact_left, anchor)
                            return (true, fact_left, TokenKind.LtEq) if proof_expr_equal(fact_right, anchor)
                            return unknown
                        return (true, fact_left, TokenKind.LtEq) if proof_expr_equal(fact_right, anchor)
                        return (true, fact_right, TokenKind.LtEq) if proof_expr_equal(fact_left, anchor)
                        return unknown
                    ascending: mutable bool = proof_chain_ascending(fact_operator)
                    normalized: mutable TokenKind = fact_operator
                    low: mutable Ast::Expr = fact_left
                    high: mutable Ast::Expr = fact_right
                    if fact_operator == TokenKind.Gt:
                        ascending <- true
                        normalized <- TokenKind.Lt
                        low <- fact_right
                        high <- fact_left
                    if fact_operator == TokenKind.GtEq:
                        ascending <- true
                        normalized <- TokenKind.LtEq
                        low <- fact_right
                        high <- fact_left
                    return unknown if not ascending
                    if from_lower:
                        return (true, high, normalized) if proof_expr_equal(low, anchor)
                        return unknown
                    return (true, low, normalized) if proof_expr_equal(high, anchor)
                    return unknown
                _:
                    pass
            return unknown

        def proof_linear_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return true if proof_primitive_comparison(left, right, facts) and proof_definitionally_equal(left, right) and proof_is_true_comparison(operator)
            left_name: sview = proof_ident_name(left)
            right_name: sview = proof_ident_name(right)
            if proof_names_equal_from_facts(left_name, right_name, facts):
                # Denoting the same value is not the same as satisfying the operator. A negative
                # answer stays available, since refusing to conclude is always sound.
                return true if proof_primitive_comparison(left, right, facts) and (operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq)
                return false if operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt
            delta: (known: bool, value: i64) = proof_delta_constant(left, right)
            if delta.known:
                # A zero difference says the two terms denote the same value, so concluding a
                # comparison on them needs the operator to be reflexive. The numeric tiers below
                # cannot help either without a bound on the operand, so declining here is sound.
                return false if delta.value == 0 and not proof_primitive_comparison(left, right, facts) and (operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq)
                return delta.value > 0 if operator == TokenKind.Gt
                return delta.value >= 0 if operator == TokenKind.GtEq
                return delta.value < 0 if operator == TokenKind.Lt
                return delta.value <= 0 if operator == TokenKind.LtEq
                return delta.value != 0 if operator == TokenKind.BangEq
                return delta.value == 0 if operator == TokenKind.EqEq
            bounds: mutable darray[ProofBound] = []
            for fact in facts |bounds|:
                proof_collect_bounds(fact, &bounds)
            proof_close_equalities(facts, &bounds)
            # The affine and difference tiers close over `==` premises between identifiers, so
            # their operands carry the same requirement as the rules above.
            return true if proof_primitive_comparison(left, right, facts) and proof_affine_goal(left, operator, right, bounds, facts)
            return true if proof_primitive_comparison(left, right, facts) and proof_difference_goal(left, operator, right, facts)
            a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(left, bounds)
            b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(right, bounds)
            return a.has_lower and b.has_upper and a.lower > b.upper if operator == TokenKind.Gt
            return a.has_lower and b.has_upper and a.lower >= b.upper if operator == TokenKind.GtEq
            return a.has_upper and b.has_lower and a.upper < b.lower if operator == TokenKind.Lt
            return a.has_upper and b.has_lower and a.upper <= b.lower if operator == TokenKind.LtEq
            return a.known and b.known and a.lower == a.upper and b.lower == b.upper and a.lower == b.lower if operator == TokenKind.EqEq
            return (a.has_upper and b.has_lower and a.upper < b.lower) or (a.has_lower and b.has_upper and a.lower > b.upper) if operator == TokenKind.BangEq
            return false

        # A bounded, deterministic counterexample search for the same small integer fragment
        # used by the prover. This is a diagnostic aid, never an acceptance rule: a witness is
        # emitted only when every fact and the failed goal evaluate exactly under the assignment.
        # Unsupported expressions therefore produce no witness instead of a misleading guess.
        def proof_counterexample_name_index(names: darray[sview]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < names.count |index, names, name|:
                return index if names[index] == name
                index <- index + 1
            return names.count

        def proof_counterexample_collect_names(expression: Ast::Expr, names: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Ident(name, _):
                    if name != "" and proof_counterexample_name_index(names, name) == names.count:
                        names.push(name)
                Ast::Expr.Paren(inner, _):
                    proof_counterexample_collect_names(inner, names)
                Ast::Expr.Unary(_, operand, _):
                    proof_counterexample_collect_names(operand, names)
                Ast::Expr.Binary(left, _, right, _):
                    proof_counterexample_collect_names(left, names)
                    proof_counterexample_collect_names(right, names)
                _:
                    pass

        def proof_counterexample_int(expression: Ast::Expr, names: darray[sview]&, values: darray[i64]&) -> (known: bool, value: i64):
            match expression:
                Ast::Expr.IntLit(value):
                    return (true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_counterexample_int(inner, names, values)
                Ast::Expr.Ident(name, _):
                    index: usize = proof_counterexample_name_index(names, name)
                    return (true, values[index]) if index < values.count
                Ast::Expr.Unary(operator, operand, _):
                    inner: (known: bool, value: i64) = proof_counterexample_int(operand, names, values)
                    return (false, 0) if not inner.known
                    return inner if operator == TokenKind.Plus
                    if operator == TokenKind.Minus:
                        return (false, 0) if inner.value == proof_i64_min()
                        return (true, 0 - inner.value)
                Ast::Expr.Binary(left, operator, right, _):
                    a: (known: bool, value: i64) = proof_counterexample_int(left, names, values)
                    b: (known: bool, value: i64) = proof_counterexample_int(right, names, values)
                    return (false, 0) if not a.known or not b.known
                    if operator == TokenKind.Plus:
                        return proof_add_safe(a.value, b.value)
                    if operator == TokenKind.Minus:
                        return proof_sub_safe(a.value, b.value)
                    if operator == TokenKind.Star:
                        return proof_mul_safe(a.value, b.value)
                    if operator == TokenKind.Slash:
                        return proof_div_safe(a.value, b.value)
                    if operator == TokenKind.Percent:
                        return proof_mod_safe(a.value, b.value)
                    if operator == TokenKind.Ampersand:
                        return (true, a.value & b.value)
                    if operator == TokenKind.Pipe:
                        return (true, a.value | b.value)
                    if operator == TokenKind.Caret:
                        return (true, a.value ^ b.value)
                    if operator == TokenKind.LShift:
                        return proof_shift_safe(a.value, b.value, true)
                    if operator == TokenKind.RShift:
                        return proof_shift_safe(a.value, b.value, false)
                _:
                    pass
            return (false, 0)

        def proof_counterexample_bool(expression: Ast::Expr, names: darray[sview]&, values: darray[i64]&) -> (known: bool, value: bool):
            # A compiler type marker states a declared type, not a constraint on the model. It
            # holds at every point of the domain, so bounded enumeration must read it as true
            # rather than as an unknown fact that abandons the search.
            return (true, true) if proof_type_marker_callee(expression)
            match expression:
                Ast::Expr.BoolLit(value):
                    return (true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_counterexample_bool(inner, names, values)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    inner: (known: bool, value: bool) = proof_counterexample_bool(operand, names, values)
                    return (inner.known, not inner.value) if inner.known
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        a_bool: (known: bool, value: bool) = proof_counterexample_bool(left, names, values)
                        b_bool: (known: bool, value: bool) = proof_counterexample_bool(right, names, values)
                        return (false, false) if not a_bool.known or not b_bool.known
                        return (true, a_bool.value and b_bool.value) if operator == TokenKind.And
                        return (true, a_bool.value or b_bool.value)
                    if proof_is_comparison(operator):
                        a: (known: bool, value: i64) = proof_counterexample_int(left, names, values)
                        b: (known: bool, value: i64) = proof_counterexample_int(right, names, values)
                        if a.known and b.known:
                            return (true, a.value == b.value) if operator == TokenKind.EqEq
                            return (true, a.value != b.value) if operator == TokenKind.BangEq
                            return (true, a.value < b.value) if operator == TokenKind.Lt
                            return (true, a.value > b.value) if operator == TokenKind.Gt
                            return (true, a.value <= b.value) if operator == TokenKind.LtEq
                            return (true, a.value >= b.value) if operator == TokenKind.GtEq
                        if operator == TokenKind.EqEq or operator == TokenKind.BangEq:
                            left_bool: (known: bool, value: bool) = proof_counterexample_bool(left, names, values)
                            right_bool: (known: bool, value: bool) = proof_counterexample_bool(right, names, values)
                            if left_bool.known and right_bool.known:
                                equal: bool = left_bool.value == right_bool.value
                                return (true, equal) if operator == TokenKind.EqEq
                                return (true, not equal)
                _:
                    pass
            return (false, false)

        def proof_counterexample_add_candidate(candidates: mutable darray[i64]&, start: usize, bound: ProofBound, value: i64) -> void:
            return if bound.has_lower and value < bound.lower
            return if bound.has_upper and value > bound.upper
            for index in start..<candidates.count |index, candidates, start, value|:
                return if candidates[index] == value
            candidates.push(value)

        def proof_counterexample_search(index: usize, names: darray[sview]&, values: mutable darray[i64]&, starts: darray[usize]&, counts: darray[usize]&, candidates: darray[i64]&, facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&) -> bool:
            if index == names.count:
                return false if budget == 0
                budget <- budget - 1
                for fact in facts |fact, names, values|:
                    fact_value: (known: bool, value: bool) = proof_counterexample_bool(fact, names, values)
                    return false if not fact_value.known or not fact_value.value
                goal_value: (known: bool, value: bool) = proof_counterexample_bool(goal, names, values)
                return goal_value.known and not goal_value.value
            start: usize = starts[index]
            end: usize = start + counts[index]
            candidate_index: mutable usize = start
            while candidate_index < end |candidate_index, end, candidates, values, index, names, starts, counts, facts, goal, budget|:
                values[index] <- candidates[candidate_index]
                return true if proof_counterexample_search(index + 1, names, values, starts, counts, candidates, facts, goal, budget)
                candidate_index <- candidate_index + 1
            return false

        # Populate `assignments` only after an exact falsifying state is found. The result uses
        # ordinary equality expressions so existing JSON tooling can display/replay it directly.
        def proof_find_counterexample(facts: darray[Ast::Expr]&, goal: Ast::Expr, assignments: mutable darray[Ast::Expr]&) -> bool:
            names: mutable darray[sview] = []
            for fact in facts |names|:
                proof_counterexample_collect_names(fact, &names)
            proof_counterexample_collect_names(goal, &names)
            return false if names.count > 6
            bounds: mutable darray[ProofBound] = []
            for fact in facts |bounds|:
                proof_collect_bounds(fact, &bounds)
            proof_close_equalities(facts, &bounds)
            starts: mutable darray[usize] = []
            counts: mutable darray[usize] = []
            candidates: mutable darray[i64] = []
            for name in names |name, starts, counts, candidates, bounds|:
                bound: ProofBound = proof_bound_for(bounds, name)
                start: usize = candidates.count
                proof_counterexample_add_candidate(&candidates, start, bound, 0)
                proof_counterexample_add_candidate(&candidates, start, bound, 1)
                proof_counterexample_add_candidate(&candidates, start, bound, -1)
                proof_counterexample_add_candidate(&candidates, start, bound, bound.lower) if bound.has_lower
                proof_counterexample_add_candidate(&candidates, start, bound, bound.upper) if bound.has_upper
                if bound.has_lower:
                    next_lower: (known: bool, value: i64) = proof_add_safe(bound.lower, 1)
                    proof_counterexample_add_candidate(&candidates, start, bound, next_lower.value) if next_lower.known
                if bound.has_upper:
                    previous_upper: (known: bool, value: i64) = proof_sub_safe(bound.upper, 1)
                    proof_counterexample_add_candidate(&candidates, start, bound, previous_upper.value) if previous_upper.known
                starts.push(start)
                counts.push(candidates.count - start)
                return false if counts[counts.count - 1] == 0
            values: mutable darray[i64] = []
            values.resize(names.count)
            budget: mutable usize = 4096
            found: bool = proof_counterexample_search(0, names, &values, starts, counts, candidates, facts, goal, &budget)
            return false if not found
            position: Ast::Pos = Ast::expr_pos(goal)
            for index in 0..<names.count |index, names, values, assignments, position|:
                assignments.push(Ast::Expr.Binary(Ast::Expr.Ident(names[index], position), TokenKind.EqEq, Ast::Expr.IntLit(values[index]), position))
            return true

        # Complete bounded model checking for the same pure integer/Boolean fragment. This is
        # deliberately separate from the sparse counterexample search above: a proof may use
        # this rule only when every symbolic integer has an explicit finite interval, every
        # evaluated fact is known, and every point in the product domain is visited. It therefore
        # handles small nonlinear properties such as `x * x >= 0` without treating samples as a
        # theorem. Fixed-width overflow and unsupported expressions make the result unknown.
        def proof_bounded_model_visit(index: usize, names: darray[sview]&, values: mutable darray[i64]&, lowers: darray[i64]&, widths: darray[i64]&, facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, all_known: mutable bool&, holds: mutable bool&, exhausted: mutable bool&) -> void:
            known_now: bool = all_known
            holds_now: bool = holds
            return if not known_now or not holds_now
            if index == names.count:
                if budget == 0:
                    all_known <- false
                    exhausted <- true
                    return
                budget <- budget - 1
                facts_hold: mutable bool = true
                for fact in facts |fact, names, values, all_known, facts_hold|:
                    fact_value: (known: bool, value: bool) = proof_counterexample_bool(fact, names, values)
                    if not fact_value.known:
                        all_known <- false
                        return
                    facts_hold <- false if not fact_value.value
                return if not facts_hold
                goal_value: (known: bool, value: bool) = proof_counterexample_bool(goal, names, values)
                if not goal_value.known:
                    all_known <- false
                    return
                holds <- false if not goal_value.value
                return
            candidate: mutable i64 = lowers[index]
            offset: mutable i64 = 0
            while offset < widths[index] |offset, candidate, index, widths, values, facts, goal, budget, all_known, holds, names, lowers, exhausted|:
                values[index] <- candidate
                proof_bounded_model_visit(index + 1, names, values, lowers, widths, facts, goal, budget, all_known, holds, exhausted)
                known_after: bool = all_known
                holds_after: bool = holds
                return if not known_after or not holds_after
                offset <- offset + 1
                if offset < widths[index]:
                    next_candidate: (known: bool, value: i64) = proof_add_safe(candidate, 1)
                    if not next_candidate.known:
                        all_known <- false
                        return
                    candidate <- next_candidate.value

        def proof_bounded_model_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, exhausted: mutable bool&) -> bool:
            names: mutable darray[sview] = []
            for fact in facts |names|:
                proof_counterexample_collect_names(fact, &names)
            proof_counterexample_collect_names(goal, &names)
            return false if names.count == 0 or names.count > 6
            bounds: mutable darray[ProofBound] = []
            for fact in facts |bounds|:
                proof_collect_bounds(fact, &bounds)
            proof_close_equalities(facts, &bounds)
            lowers: mutable darray[i64] = []
            widths: mutable darray[i64] = []
            total: mutable i64 = 1
            for name in names |name, bounds, lowers, widths, total|:
                bound: ProofBound = proof_bound_for(bounds, name)
                return false if not bound.has_lower or not bound.has_upper or bound.lower > bound.upper
                width_difference: (known: bool, value: i64) = proof_sub_safe(bound.upper, bound.lower)
                return false if not width_difference.known
                width_with_end: (known: bool, value: i64) = proof_add_safe(width_difference.value, 1)
                return false if not width_with_end.known or width_with_end.value <= 0
                if width_with_end.value > 4096:
                    exhausted <- true
                    return false
                total_width: (known: bool, value: i64) = proof_mul_safe(total, width_with_end.value)
                return false if not total_width.known
                if total_width.value > 65536:
                    exhausted <- true
                    return false
                total <- total_width.value
                lowers.push(bound.lower)
                widths.push(width_with_end.value)
            values: mutable darray[i64] = []
            values.resize(names.count)
            budget: mutable usize = 65536
            all_known: mutable bool = true
            holds: mutable bool = true
            proof_bounded_model_visit(0, names, &values, lowers, widths, facts, goal, &budget, &all_known, &holds, exhausted)
            return all_known and holds

        # A false branch carries `not condition`. Recognize the exact logical complement of a
        # comparison so branch-sensitive checking can prove facts such as `not (x < 0) |- x >= 0`
        # without pretending that arbitrary Boolean negation is an arithmetic theorem.
        def proof_fact_proves_comparison_negation(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            negated_operator: TokenKind = proof_comparison_negation(operator)
            return false if negated_operator == TokenKind.Eof
            for fact in facts:
                match fact:
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        match operand:
                            Ast::Expr.Binary(inner_left, inner_operator, inner_right, _):
                                return true if inner_operator == negated_operator and proof_expr_equal(inner_left, left) and proof_expr_equal(inner_right, right)
                            _:
                                pass
                    _:
                        pass
            return false

        # Project a conjunct from a Boolean fact. This is a structural logical rule, not an
        # arithmetic assumption: a fact `A and B` entails each of A and B.
        def proof_fact_contains(fact: Ast::Expr, goal: Ast::Expr) -> bool:
            return true if proof_expr_equal(fact, goal)
            match fact:
                Ast::Expr.Paren(inner, _):
                    return proof_fact_contains(inner, goal)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return proof_fact_contains(left, goal) or proof_fact_contains(right, goal)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Unary(TokenKind.Not, nested, _):
                            return proof_fact_contains(nested, goal)
                        _:
                            pass
                    return false
                _:
                    return false

        # A verified function summary equates a call result with its postcondition. When a
        # branch has already established the Boolean call (or its negation), the corresponding
        # postcondition is available by equality substitution. Keep this rule narrow: one side
        # must remain a call-shaped term, and the branch fact must contain that exact call. This
        # avoids turning arbitrary arithmetic equalities into unrestricted rewriting while still
        # letting guarded pure summaries justify bounds such as `root < nodes.count`.
        def proof_fact_proves_call_summary(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            for summary in facts:
                match summary:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, position):
                        left_is_call: mutable bool = false
                        right_is_call: mutable bool = false
                        match left:
                            Ast::Expr.Call(_, _, _, _):
                                left_is_call <- true
                            _:
                                pass
                        match right:
                            Ast::Expr.Call(_, _, _, _):
                                right_is_call <- true
                            _:
                                pass
                        for fact in facts |fact, left, right, goal, left_is_call, right_is_call, position|:
                            if left_is_call:
                                return true if proof_expr_equal(right, goal) and proof_fact_contains(fact, left)
                                match goal:
                                    Ast::Expr.Unary(TokenKind.Not, inner, _):
                                        return true if proof_expr_equal(right, inner) and proof_fact_contains(fact, Ast::Expr.Unary(TokenKind.Not, left, position))
                                    _:
                                        pass
                            if right_is_call:
                                return true if proof_expr_equal(left, goal) and proof_fact_contains(fact, right)
                                match goal:
                                    Ast::Expr.Unary(TokenKind.Not, inner, _):
                                        return true if proof_expr_equal(left, inner) and proof_fact_contains(fact, Ast::Expr.Unary(TokenKind.Not, right, position))
                                    _:
                                        pass
                    _:
                        pass
            return false

        # Return one disjunctive branch from a Boolean fact. The original fact is replaced by
        # exactly one branch in each recursive proof, so neither branch can silently retain the
        # un-split disjunction as an axiom. Parentheses are transparent. A disjunction nested in
        # a conjunction reconstructs that conjunction in each branch, preserving all context.
        def proof_find_disjunction(expression: Ast::Expr) -> (known: bool, left: Ast::Expr, right: Ast::Expr):
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_find_disjunction(inner)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return (true, left, right)
                Ast::Expr.Binary(left, TokenKind.And, right, position):
                    left_split: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_find_disjunction(left)
                    if left_split.known:
                        return (true, Ast::Expr.Binary(left_split.left, TokenKind.And, right, position), Ast::Expr.Binary(left_split.right, TokenKind.And, right, position))
                    right_split: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_find_disjunction(right)
                    if right_split.known:
                        return (true, Ast::Expr.Binary(left, TokenKind.And, right_split.left, position), Ast::Expr.Binary(left, TokenKind.And, right_split.right, position))
                _:
                    pass
            return (false, Ast::Expr.Absent, Ast::Expr.Absent)

        # Ground congruence closure. Proof search belongs to this AST tier, but the equality rule
        # itself does not: the premises and goal are lowered into a scratch source-neutral arena
        # and decided by the same kernel routine that re-derives the certificate during replay.
        # A congruence the kernel cannot reproduce therefore cannot be found here either, so this
        # rule can never widen the producer beyond the checker.
        def proof_expression_is_conditional(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.If(_, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expression_is_conditional(inner)
                _:
                    return false

        def proof_congruence_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, exhausted: mutable bool&) -> bool:
            return false if not proof_kernel_expression_supported(goal)
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            roots: mutable darray[usize] = []
            for fact in facts |fact, nodes, children, roots, annotations|:
                continue if not proof_kernel_expression_supported(fact)
                roots.push(proof_kernel_encode_annotated(fact, &nodes, &children, annotations))
            return false if roots.count == 0
            goal_root: usize = proof_kernel_encode_annotated(goal, &nodes, &children, annotations)
            return ElisaProofKernelReplay::proof_kernel_replay_congruence_report_status(&nodes, &children, roots, goal_root, exhausted)

        def proof_goal_depth(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            # An explicitly asserted proposition is accepted before trying the arithmetic
            # fragment. This matters for one-sided facts such as `x >= 0`: the fact itself is
            # valid even though it is not enough to construct a finite interval for `x`.
            for fact in facts:
                return true if proof_fact_contains(fact, goal) or proof_quantifier_equal(fact, goal, annotations)
            # Do not let the unbounded signed interval/model tiers prove a fixed-width unsigned
            # expression unless every arithmetic subterm is shown to remain in its declared
            # range. Directly asserted facts were handled above and remain valid path assumptions.
            return true if proof_unsigned_goal_identity(goal, facts)
            # Propositional inconsistency first. It reads no term as a number, so no wrapping
            # premise can mislead it, and a contradictory branch must be able to close before the
            # guard below asks its facts to be range-safe -- the branch a disjunctive premise
            # refutes often cannot answer that, and does not have to.
            return true if proof_facts_propositionally_inconsistent(facts)
            disjunction_index: mutable usize = facts.count
            disjunction_left: mutable Ast::Expr = Ast::Expr.Absent
            disjunction_right: mutable Ast::Expr = Ast::Expr.Absent
            for index in 0..<facts.count |index, facts, disjunction_index, disjunction_left, disjunction_right|:
                candidate: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_find_disjunction(facts[index])
                if candidate.known:
                    disjunction_index <- index
                    disjunction_left <- candidate.left
                    disjunction_right <- candidate.right
                    break
            # A disjunctive premise the split budget refuses to open leaves the goal undecided,
            # not unprovable: the remaining tiers run without it, and a failure is a timeout.
            exhausted <- true if disjunction_index < facts.count and split_depth >= 4
            if disjunction_index < facts.count and split_depth < 4:
                left_facts: mutable darray[Ast::Expr] = []
                right_facts: mutable darray[Ast::Expr] = []
                for index in 0..<facts.count |index, facts, left_facts, right_facts, disjunction_index|:
                    continue if index == disjunction_index
                    left_facts.push(facts[index])
                    right_facts.push(facts[index])
                left_facts.push(disjunction_left)
                right_facts.push(disjunction_right)
                return proof_goal_depth(left_facts, goal, annotations, depth, budget, split_depth + 1, exhausted) and proof_goal_depth(right_facts, goal, annotations, depth, budget, split_depth + 1, exhausted)
            # Signed decision procedures consume premises as well as the goal.
            # A true wrapping premise may be false over integers; treating it as
            # such can discard every actual execution and prove an arbitrary goal.
            # Each branch of a split above re-enters here, so every premise a tier
            # below actually consumes has passed this guard in its own branch.
            for fact in facts:
                return false if not proof_unsigned_expression_safe(fact, facts)
            return true if proof_facts_inconsistent(facts)
            return true if proof_fact_proves_call_summary(facts, goal)
            return false if not proof_unsigned_expression_safe(goal, facts)
            quantifier_kind: sview = proof_quantifier_kind(goal, annotations)
            if quantifier_kind != "" and depth >= 4:
                exhausted <- true
                return false
            return proof_quantifier_goal(facts, goal, annotations, depth, budget, split_depth, exhausted) if quantifier_kind != ""
            return true if proof_bounded_model_goal(facts, goal, exhausted)
            match goal:
                Ast::Expr.BoolLit(value):
                    return value
                Ast::Expr.Paren(inner, _):
                    return proof_goal_depth(facts, inner, annotations, depth, budget, split_depth, exhausted)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.BoolLit(value):
                            return not value
                        Ast::Expr.Binary(left, operator, right, _):
                            negated_operator: TokenKind = proof_comparison_negation(operator)
                            return proof_linear_goal(left, negated_operator, right, facts) if negated_operator != TokenKind.Eof
                        _:
                            pass
                Ast::Expr.Binary(left, operator, right, position):
                    if operator == TokenKind.And:
                        return proof_goal_depth(facts, left, annotations, depth, budget, split_depth, exhausted) and proof_goal_depth(facts, right, annotations, depth, budget, split_depth, exhausted)
                    if operator == TokenKind.Or:
                        return proof_goal_depth(facts, left, annotations, depth, budget, split_depth, exhausted) or proof_goal_depth(facts, right, annotations, depth, budget, split_depth, exhausted)
                    if operator == TokenKind.FatArrow:
                        implication_facts: mutable darray[Ast::Expr] = []
                        implication_facts.extend(facts)
                        implication_facts.push(left)
                        return proof_goal_depth(implication_facts, right, annotations, depth, budget, split_depth, exhausted)
                    # Eliminate a conditional expression by checking both semantic branches.
                    # The condition and its negation are path assumptions, not asserted facts;
                    # both branches are required, so an opaque condition cannot manufacture a
                    # proof. Bound the split with the same small case-splitting budget used for
                    # disjunctive facts. A conditional the budget refuses to eliminate leaves the
                    # goal undecided rather than unprovable.
                    exhausted <- true if split_depth >= 4 and (proof_expression_is_conditional(left) or proof_expression_is_conditional(right))
                    if split_depth < 4:
                        match left:
                            Ast::Expr.If(condition, then_expression, else_expression, _):
                                then_facts: mutable darray[Ast::Expr] = []
                                else_facts: mutable darray[Ast::Expr] = []
                                then_facts.extend(facts)
                                else_facts.extend(facts)
                                then_facts.push(condition)
                                else_facts.push(Ast::Expr.Unary(TokenKind.Not, condition, position))
                                then_goal: Ast::Expr = Ast::Expr.Binary(then_expression, operator, right, position)
                                else_goal: Ast::Expr = Ast::Expr.Binary(else_expression, operator, right, position)
                                # A failed case split proves nothing either way, so it must not
                                # consume the goal; later tiers still get to decide it.
                                return true if proof_goal_depth(then_facts, then_goal, annotations, depth, budget, split_depth + 1, exhausted) and proof_goal_depth(else_facts, else_goal, annotations, depth, budget, split_depth + 1, exhausted)
                            _:
                                pass
                        match right:
                            Ast::Expr.If(condition, then_expression, else_expression, _):
                                then_facts: mutable darray[Ast::Expr] = []
                                else_facts: mutable darray[Ast::Expr] = []
                                then_facts.extend(facts)
                                else_facts.extend(facts)
                                then_facts.push(condition)
                                else_facts.push(Ast::Expr.Unary(TokenKind.Not, condition, position))
                                then_goal: Ast::Expr = Ast::Expr.Binary(left, operator, then_expression, position)
                                else_goal: Ast::Expr = Ast::Expr.Binary(left, operator, else_expression, position)
                                return true if proof_goal_depth(then_facts, then_goal, annotations, depth, budget, split_depth + 1, exhausted) and proof_goal_depth(else_facts, else_goal, annotations, depth, budget, split_depth + 1, exhausted)
                            _:
                                pass
                    if proof_is_comparison(operator):
                        return true if proof_fact_proves_comparison_negation(left, operator, right, facts)
                        return true if proof_linear_goal(left, operator, right, facts)
                        return true if proof_product_sign_goal(left, operator, right, facts)
                        return true if proof_comparison_chain_goal(left, operator, right, facts)
                        return true if proof_strict_shift_goal(left, operator, right, facts)
                        return true if proof_sum_bound_goal(left, operator, right, facts)
                        return true if proof_unsigned_nonnegative_goal(left, operator, right, facts)
                        # Congruence is the last equality tier and runs only after the
                        # fixed-width safety guards above rejected every wrapping premise/goal.
                        return proof_congruence_goal(facts, goal, annotations, exhausted) if operator == TokenKind.EqEq
                        return false
                _:
                    pass
            return false

        # A search that ends because a fixed budget ran out is not the same answer as one that
        # ends because no rule applies. Callers that report a verdict take the second entry point
        # so the two can be told apart downstream; `exhausted` is advisory and never widens what
        # is provable.
        def proof_goal_with_limits(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, exhausted: mutable bool&) -> bool:
            budget: mutable usize = 0
            return proof_goal_depth(facts, goal, annotations, 0, budget, 0, exhausted)

        def proof_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            exhausted: mutable bool = false
            return proof_goal_with_limits(facts, goal, annotations, &exhausted)
