extend ElisaProof:
    private:
        # Derived lookup row for a source-level overloaded operator implementation. An empty
        # protocol represents an extension, which shadows every builtin protocol for its type.
        struct ProofOperatorImpl:
            concrete: sview
            protocol: sview

        # Hash index over the source's operator implementations, rebuilt by every check
        # (proof_build_operator_impl_index). `valid` is false until it is built; queries then
        # fall back to scanning the source annotations.
        struct ProofOperatorImplIndex:
            rows: mutable darray[ProofOperatorImpl] = []
            hashes: mutable darray[u32] = []
            bucket_heads: mutable darray[usize] = []
            next_indices: mutable darray[usize] = []
            valid: mutable bool = false
