extend ElisaProof:
    private:
        # Derived lookup row for a source-level overloaded operator implementation. An empty
        # protocol represents an extension; its operator mask is derived from its dunder methods.
        struct ProofOperatorImpl:
            concrete: sview
            protocol: sview
            operator_mask: usize
            line: u32
            offset: u32

        # Exact parser-AST position for an impl/extension declaration scope. This temporary
        # index lets the checker join parser side-table annotations to the owning method body
        # without rescanning the declaration tree once per impl.
        struct ProofOperatorScope:
            line: u32
            offset: u32
            operator_mask: usize
            self_operator_mask: usize = 0
            # True only when a unique impl/extension annotation owns this AST scope.
            implementation_scope: bool = false
            # Dunders whose declared receiver cannot be tied to the enclosing concrete type.
            global_operator_mask: usize = 0
            # Explicit receiver spelling used by dunder methods in this scope.
            explicit_receiver_type: sview = ""
            explicit_receiver_mask: usize = 0

        struct ProofOperatorScopeIndex:
            rows: mutable darray[ProofOperatorScope] = []
            hashes: mutable darray[u32] = []
            bucket_heads: mutable darray[usize] = []
            next_indices: mutable darray[usize] = []
            global_operator_mask: mutable usize = 0
            valid: mutable bool = false

        # Hash index over the source's operator implementations, rebuilt by every check
        # (proof_build_operator_impl_index). `valid` is false until it is built; queries then
        # fall back to scanning the source annotations.
        struct ProofOperatorImplIndex:
            rows: mutable darray[ProofOperatorImpl] = []
            hashes: mutable darray[u32] = []
            bucket_heads: mutable darray[usize] = []
            next_indices: mutable darray[usize] = []
            # Free functions can also participate in synthesized UFCS operator calls.
            # Their receiver type may be selected only after overload resolution, so this
            # mask is applied conservatively to every receiver during proof admission.
            global_operator_mask: mutable usize = 0
            valid: mutable bool = false
