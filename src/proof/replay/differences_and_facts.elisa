const PROOF_REPLAY_MAX_DIFFERENCE_CONSTRAINTS: usize = 4096

extend ElisaProof:
    private:
        def proof_replay_difference_push(left: ProofReplayAffine, right: ProofReplayAffine, reverse: bool, strict: bool, constraints: mutable darray[ProofReplayDifference]&) -> void:
            first: ProofReplayAffine = left if not reverse else right
            second: ProofReplayAffine = right if not reverse else left
            difference: ProofReplayInt = proof_replay_sub_safe(second.offset, first.offset)
            return if not difference.known
            bound: mutable i64 = difference.value
            if strict:
                decremented: ProofReplayInt = proof_replay_sub_safe(bound, 1)
                return if not decremented.known
                bound <- decremented.value
            constraints.push(ProofReplayDifference{left: first.base, right: second.base, bound: bound})

        def proof_replay_collect_differences(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofReplayBound]&, constraints: mutable darray[ProofReplayDifference]&, work: mutable usize&) -> bool:
            proof_replay_collect_differences_depth(expression, facts, bounds, constraints, work, 0)

        def proof_replay_collect_differences_depth(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofReplayBound]&, constraints: mutable darray[ProofReplayDifference]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_equality_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_collect_differences_depth(inner, facts, bounds, constraints, work, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated_operator: TokenKind = proof_replay_comparison_negation(operator)
                            return proof_replay_collect_differences_depth(Ast::Expr.Binary(left, negated_operator, right, Ast::expr_pos(expression)), facts, bounds, constraints, work, depth + 1) if negated_operator != TokenKind.Eof
                        _:
                            pass
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return false if not proof_replay_collect_differences_depth(left, facts, bounds, constraints, work, depth + 1)
                    return proof_replay_collect_differences_depth(right, facts, bounds, constraints, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return true if operator != TokenKind.EqEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq
                    primitive: (complete: bool, matches: bool) = proof_replay_primitive_comparison_with_work(left, right, facts, work)
                    return false if not primitive.complete
                    return true if not primitive.matches
                    left_affine_check: (complete: bool, affine: ProofReplayAffine) = proof_replay_affine_expression_with_work(left, work, 0)
                    return false if not left_affine_check.complete
                    right_affine_check: (complete: bool, affine: ProofReplayAffine) = proof_replay_affine_expression_with_work(right, work, 0)
                    return false if not right_affine_check.complete
                    left_affine: ProofReplayAffine = left_affine_check.affine
                    right_affine: ProofReplayAffine = right_affine_check.affine
                    return true if not left_affine.known or not right_affine.known
                    left_safe: (complete: bool, safe: bool) = proof_replay_affine_safe_with_work(left_affine, bounds, work)
                    return false if not left_safe.complete
                    return true if not left_safe.safe
                    right_safe: (complete: bool, safe: bool) = proof_replay_affine_safe_with_work(right_affine, bounds, work)
                    return false if not right_safe.complete
                    return true if not right_safe.safe
                    proof_replay_difference_push(left_affine, right_affine, false, false, constraints) if operator == TokenKind.LtEq
                    proof_replay_difference_push(left_affine, right_affine, false, true, constraints) if operator == TokenKind.Lt
                    proof_replay_difference_push(left_affine, right_affine, true, false, constraints) if operator == TokenKind.GtEq
                    proof_replay_difference_push(left_affine, right_affine, true, true, constraints) if operator == TokenKind.Gt
                    if operator == TokenKind.EqEq:
                        proof_replay_difference_push(left_affine, right_affine, false, false, constraints)
                        proof_replay_difference_push(left_affine, right_affine, true, false, constraints)
                _:
                    pass
            return true

        def proof_replay_difference_node_index_with_work(nodes: darray[sview]&, name: sview, work: mutable usize&) -> (complete: bool, index: usize):
            index: mutable usize = 0
            while index < nodes.count |index, nodes, name, work|:
                return (false, nodes.count) if not proof_replay_equality_work_charge(1, work) or not proof_replay_equality_work_charge(sview_len(nodes[index]), work) or not proof_replay_equality_work_charge(sview_len(name), work)
                return (true, index) if nodes[index] == name
                index <- index + 1
            return (true, nodes.count)

        def proof_replay_difference_query_with_work(nodes: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, left: sview, right: sview, bound: i64, work: mutable usize&) -> (complete: bool, matches: bool):
            left_lookup: (complete: bool, index: usize) = proof_replay_difference_node_index_with_work(nodes, left, work)
            return (false, false) if not left_lookup.complete
            right_lookup: (complete: bool, index: usize) = proof_replay_difference_node_index_with_work(nodes, right, work)
            return (false, false) if not right_lookup.complete
            return (true, false) if left_lookup.index >= nodes.count or right_lookup.index >= nodes.count
            slot: usize = left_lookup.index * nodes.count + right_lookup.index
            return (true, known[slot] and matrix[slot] <= bound)

        def proof_replay_definitionally_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return proof_replay_definitionally_equal_depth(left, right, 0)

        def proof_replay_definitionally_equal_depth(left: Ast::Expr, right: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            return true if proof_replay_expr_equal_depth(left, right, depth)
            match left:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_definitionally_equal_depth(inner, right, depth + 1)
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_replay_definitionally_equal_depth(operand, right, depth + 1)
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_constant: ProofReplayInt = proof_replay_constant_int(amount)
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        return proof_replay_definitionally_equal_depth(base, right, depth + 1) if amount_constant.known and amount_constant.value == 0
                    if operator == TokenKind.Star:
                        return proof_replay_definitionally_equal_depth(base, right, depth + 1) if amount_constant.known and amount_constant.value == 1
                        target_constant: ProofReplayInt = proof_replay_constant_int(right)
                        return target_constant.known and target_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        base_constant: ProofReplayInt = proof_replay_constant_int(base)
                        return proof_replay_definitionally_equal_depth(amount, right, depth + 1) if base_constant.known and base_constant.value == 1
                        return target_constant.known and target_constant.value == 0 if base_constant.known and base_constant.value == 0
                    if operator == TokenKind.Slash:
                        return proof_replay_definitionally_equal_depth(base, right, depth + 1) if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Percent:
                        target_constant: ProofReplayInt = proof_replay_constant_int(right)
                        return target_constant.known and target_constant.value == 0 if amount_constant.known and amount_constant.value == 1
                _:
                    pass
            match right:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_definitionally_equal_depth(left, inner, depth + 1)
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_replay_definitionally_equal_depth(left, operand, depth + 1)
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_constant: ProofReplayInt = proof_replay_constant_int(amount)
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        return proof_replay_definitionally_equal_depth(left, base, depth + 1) if amount_constant.known and amount_constant.value == 0
                    if operator == TokenKind.Star:
                        return proof_replay_definitionally_equal_depth(left, base, depth + 1) if amount_constant.known and amount_constant.value == 1
                        left_constant: ProofReplayInt = proof_replay_constant_int(left)
                        return left_constant.known and left_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        base_constant: ProofReplayInt = proof_replay_constant_int(base)
                        return proof_replay_definitionally_equal_depth(left, amount, depth + 1) if base_constant.known and base_constant.value == 1
                        return left_constant.known and left_constant.value == 0 if base_constant.known and base_constant.value == 0
                    if operator == TokenKind.Slash:
                        return proof_replay_definitionally_equal_depth(left, base, depth + 1) if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Percent:
                        left_constant: ProofReplayInt = proof_replay_constant_int(left)
                        return left_constant.known and left_constant.value == 0 if amount_constant.known and amount_constant.value == 1
                _:
                    pass
            return false

        def proof_replay_expr_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            cost: mutable usize = 0
            return false if:
                not proof_replay_summary_expr_cost(left, &cost, 0, 0)
                not proof_replay_summary_expr_cost(right, &cost, 0, 0)
                cost > PROOF_REPLAY_EQUALITY_WORK_LIMIT / 2
            return proof_replay_expr_equal_depth(left, right, 0)

        # Repeated source comparisons share one counter across candidates. Charge both size
        # walks and the final structural comparison before allowing equality to succeed.
        def proof_replay_expr_equal_with_work(left: Ast::Expr, right: Ast::Expr, work: mutable usize&) -> bool:
            left_size: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(left, work)
            return false if not left_size.complete
            right_size: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(right, work)
            return false if:
                not right_size.complete or left_size.cost > PROOF_REPLAY_EQUALITY_WORK_LIMIT - work
                right_size.cost > PROOF_REPLAY_EQUALITY_WORK_LIMIT - work - left_size.cost
                not proof_replay_equality_work_charge(left_size.cost, work)
                not proof_replay_equality_work_charge(right_size.cost, work)
            proof_replay_expr_equal_depth(left, right, 0)

        def proof_replay_expr_equal_depth(left: Ast::Expr, right: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match right:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_expr_equal_depth(left, inner, depth + 1)
                _:
                    pass
            match left:
                Ast::Expr.Absent:
                    match right:
                        Ast::Expr.Absent:
                            return true
                        _:
                            return false
                Ast::Expr.IntLit(value, _):
                    match right:
                        Ast::Expr.IntLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.BoolLit(value, _):
                    match right:
                        Ast::Expr.BoolLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.FloatLit(value, _):
                    match right:
                        Ast::Expr.FloatLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return name == other
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_replay_expr_equal_depth(inner, right, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    match right:
                        Ast::Expr.Unary(other_operator, other_operand, _):
                            return operator == other_operator and proof_replay_expr_equal_depth(operand, other_operand, depth + 1)
                        _:
                            return false
                Ast::Expr.Move(operand, _):
                    match right:
                        Ast::Expr.Move(other_operand, _):
                            return proof_replay_expr_equal_depth(operand, other_operand, depth + 1)
                        _:
                            return false
                Ast::Expr.Binary(left_operand, operator, right_operand, _):
                    match right:
                        Ast::Expr.Binary(other_left, other_operator, other_right, _):
                            return operator == other_operator and proof_replay_expr_equal_depth(left_operand, other_left, depth + 1) and proof_replay_expr_equal_depth(right_operand, other_right, depth + 1)
                        _:
                            return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    # Summary provenance requires exact conditional structure, not
                    # equivalent selected values or a producer's verified flag.
                    match right:
                        Ast::Expr.If(other_condition, other_then, other_else, _):
                            return proof_replay_expr_equal_depth(condition, other_condition, depth + 1) and proof_replay_expr_equal_depth(then_expression, other_then, depth + 1) and proof_replay_expr_equal_depth(else_expression, other_else, depth + 1)
                        _:
                            return false
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    match right:
                        Ast::Expr.Call(other_callee, other_arguments, other_argument_names, _):
                            return false if:
                                arguments.count != other_arguments.count or argument_names.count != other_argument_names.count
                                not proof_replay_expr_equal_depth(callee, other_callee, depth + 1)
                            for index in 0..<arguments.count |index, arguments, other_arguments|:
                                return false if not proof_replay_expr_equal_depth(arguments[index], other_arguments[index], depth + 1)
                            for index in 0..<argument_names.count |index, argument_names, other_argument_names|:
                                return false if argument_names[index] != other_argument_names[index]
                            return true
                        _:
                            return false
                Ast::Expr.Field(object, field, _):
                    match right:
                        Ast::Expr.Field(other_object, other_field, _):
                            return field == other_field and proof_replay_expr_equal_depth(object, other_object, depth + 1)
                        _:
                            return false
                Ast::Expr.Construct(type_expression, fields, _):
                    # Exact syntax identity for summary provenance, not record
                    # extensionality: never ignore the nominal type, field names,
                    # order, cardinality or nested initializer expressions.
                    match right:
                        Ast::Expr.Construct(other_type, other_fields, _):
                            return false if:
                                fields.count != other_fields.count
                                not proof_replay_expr_equal_depth(type_expression, other_type, depth + 1)
                            for index in 0..<fields.count |index, fields, other_fields, depth|:
                                return false if:
                                    fields[index].name != other_fields[index].name
                                    not proof_replay_expr_equal_depth(fields[index].value, other_fields[index].value, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.Scope(base, name, _):
                    match right:
                        Ast::Expr.Scope(other_base, other_name, _):
                            return name == other_name and proof_replay_expr_equal_depth(base, other_base, depth + 1)
                        _:
                            return false
                Ast::Expr.ShorthandMember(parts, _):
                    match right:
                        Ast::Expr.ShorthandMember(other_parts, _):
                            return false if parts.count != other_parts.count
                            for index in 0..<parts.count |index, parts, other_parts|:
                                return false if parts[index] != other_parts[index]
                            return true
                        _:
                            return false
                Ast::Expr.Index(object, index, _):
                    match right:
                        Ast::Expr.Index(other_object, other_index, _):
                            return proof_replay_expr_equal_depth(object, other_object, depth + 1) and proof_replay_expr_equal_depth(index, other_index, depth + 1)
                        _:
                            return false
                Ast::Expr.Slice(object, low, high, _):
                    match right:
                        Ast::Expr.Slice(other_object, other_low, other_high, _):
                            return proof_replay_expr_equal_depth(object, other_object, depth + 1) and proof_replay_expr_equal_depth(low, other_low, depth + 1) and proof_replay_expr_equal_depth(high, other_high, depth + 1)
                        _:
                            return false
                Ast::Expr.IndexN(object, arguments, _):
                    match right:
                        Ast::Expr.IndexN(other_object, other_arguments, _):
                            return false if arguments.count != other_arguments.count or not proof_replay_expr_equal_depth(object, other_object, depth + 1)
                            for index in 0..<arguments.count |index, arguments, other_arguments, depth|:
                                return false if not proof_replay_expr_equal_depth(arguments[index], other_arguments[index], depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.Tuple(elements, _):
                    match right:
                        Ast::Expr.Tuple(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements|:
                                return false if not proof_replay_expr_equal_depth(elements[index], other_elements[index], depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.Array(elements, _):
                    # A collection literal reaches a fact by substitution: a local bound to `[]`
                    # or to `[1, 2, 3]` has that literal as its recorded value, so a guard over
                    # `name.count` is recorded as a guard over `[...].count`. Without this arm the
                    # fact never matched its own trace, its origin came back unknown, and the
                    # certificate that carried it gapped -- a proven goal the kernel refused for
                    # want of an equality, not for want of a justification. Elementwise, exactly
                    # as the tuple above.
                    match right:
                        Ast::Expr.Array(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements|:
                                return false if not proof_replay_expr_equal_depth(elements[index], other_elements[index], depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.SetLit(elements, _):
                    match right:
                        Ast::Expr.SetLit(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements|:
                                return false if not proof_replay_expr_equal_depth(elements[index], other_elements[index], depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.DictLit(entries, _):
                    match right:
                        Ast::Expr.DictLit(other_entries, _):
                            return false if entries.count != other_entries.count
                            for index in 0..<entries.count |index, entries, other_entries, depth|:
                                return false if not proof_replay_expr_equal_depth(entries[index].key, other_entries[index].key, depth + 1) or not proof_replay_expr_equal_depth(entries[index].value, other_entries[index].value, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    match right:
                        Ast::Expr.RecordUpdate(other_base, other_fields, _):
                            return false if fields.count != other_fields.count or not proof_replay_expr_equal_depth(base, other_base, depth + 1)
                            for index in 0..<fields.count |index, fields, other_fields, depth|:
                                return false if fields[index].name != other_fields[index].name or not proof_replay_expr_equal_depth(fields[index].value, other_fields[index].value, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.Block(statements, body, captures, position):
                    # Parser quantifier kinds live in source-line annotations,
                    # not the Block payload. Preserve that identity as well as
                    # every binder/type/range/body field; no alpha conversion or
                    # equivalence between forall and exists is granted here.
                    match right:
                        Ast::Expr.Block(other_statements, other_body, other_captures, other_position):
                            return false if:
                                position.line != other_position.line
                                captures.count != 0 or other_captures.count != 0
                                statements.count == 0 or statements.count > ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS or statements.count != other_statements.count
                            for index in 0..<statements.count |index, statements, other_statements, depth|:
                                match statements[index]:
                                    Ast::Stmt.VarDecl(binder, type_expression, range_expression, _):
                                        match other_statements[index]:
                                            Ast::Stmt.VarDecl(other_binder, other_type, other_range, _):
                                                return false if:
                                                    binder == "" or binder != other_binder
                                                    not proof_replay_expr_equal_depth(type_expression, other_type, depth + 1)
                                                    not proof_replay_expr_equal_depth(range_expression, other_range, depth + 1)
                                            _:
                                                return false
                                    _:
                                        return false
                            return proof_replay_expr_equal_depth(body, other_body, depth + 1)
                        _:
                            return false
                Ast::Expr.CharLit(value, _):
                    match right:
                        Ast::Expr.CharLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.StringLit(value, _):
                    match right:
                        Ast::Expr.StringLit(other, _):
                            return value == other
                        _:
                            return false
                _:
                    return false

        def proof_replay_fact_contains(expression: Ast::Expr, goal: Ast::Expr) -> bool:
            return proof_replay_fact_contains_depth(expression, goal, 0)

        def proof_replay_fact_contains_depth(expression: Ast::Expr, goal: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            return true if proof_replay_expr_equal_depth(expression, goal, depth)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_fact_contains_depth(inner, goal, depth + 1)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return proof_replay_fact_contains_depth(left, goal, depth + 1) or proof_replay_fact_contains_depth(right, goal, depth + 1)
                _:
                    return false

        def proof_replay_comparison_negation(operator: TokenKind) -> TokenKind:
            return TokenKind.BangEq if operator == TokenKind.EqEq
            return TokenKind.EqEq if operator == TokenKind.BangEq
            return TokenKind.GtEq if operator == TokenKind.Lt
            return TokenKind.Lt if operator == TokenKind.GtEq
            return TokenKind.Gt if operator == TokenKind.LtEq
            return TokenKind.LtEq if operator == TokenKind.Gt
            return TokenKind.Eof

        def proof_replay_negative_fact(expression: Ast::Expr, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) -> bool:
            return proof_replay_negative_fact_depth(expression, left, operator, right, 0)

        def proof_replay_negative_fact_depth(expression: Ast::Expr, left: Ast::Expr, operator: TokenKind, right: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_negative_fact_depth(inner, left, operator, right, depth + 1)
                Ast::Expr.Binary(and_left, TokenKind.And, and_right, _):
                    return proof_replay_negative_fact_depth(and_left, left, operator, right, depth + 1) or proof_replay_negative_fact_depth(and_right, left, operator, right, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(inner_left, inner_operator, inner_right, _):
                            negated_operator: TokenKind = proof_replay_comparison_negation(operator)
                            return negated_operator != TokenKind.Eof and inner_operator == negated_operator and proof_replay_expr_equal_depth(inner_left, left, depth + 1) and proof_replay_expr_equal_depth(inner_right, right, depth + 1)
                        _:
                            pass
                _:
                    pass
            return false

        def proof_replay_facts_inconsistent(facts: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            return proof_replay_facts_inconsistent_depth(facts, work, 0)

        def proof_replay_facts_inconsistent_depth(facts: darray[Ast::Expr]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_equality_work_charge(facts.count, work)
            for fact in facts |work|:
                return false if not proof_replay_equality_work_charge(1, work)
                match fact:
                    Ast::Expr.BoolLit(value, _):
                        return true if not value
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        match operand:
                            Ast::Expr.BoolLit(value, _):
                                return true if value
                            _:
                                pass
                    Ast::Expr.Paren(inner, _):
                        nested_paren: mutable darray[Ast::Expr] = [inner]
                        return true if proof_replay_facts_inconsistent_depth(nested_paren, work, depth + 1)
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        nested_and: mutable darray[Ast::Expr] = [left, right]
                        return true if proof_replay_facts_inconsistent_depth(nested_and, work, depth + 1)
                    _:
                        pass
            bounds: mutable darray[ProofReplayBound] = []
            for fact in facts |bounds, work|:
                return false if not proof_replay_collect_bounds(fact, facts, &bounds, work)
            return false if not proof_replay_close_equalities_with_work(facts, &bounds, work)
            for bound in bounds |work|:
                return false if not proof_replay_equality_work_charge(1, work)
                return true if bound.has_lower and bound.has_upper and bound.lower > bound.upper
            return false
