# Shared target metadata for bounded source-call replay.
extend ElisaProof:
    private:
        struct ProofReplayCallSiteTarget:
            enabled: bool
            ignore_unmatched_scoped_edges: bool
            allow_scoped_target: bool
            include_nonassert_contract_calls: bool
            offset: usize
            line: u32
            name: sview
            calls_at_offset: mutable usize
            matched_calls: mutable usize
            track_unresolved_dispatch: bool
            unresolved_dispatch_found: mutable bool
            source_annotations: darray[Ast::EnumAnnotation]
            field_conversion_parameters: darray[Ast::ParamDecl]
            field_conversion_names: darray[sview]
            field_conversion_index_valid: bool
            field_conversion_index_hashes: darray[u32]
            field_conversion_index_values: darray[usize]
            field_conversion_index_counts: darray[usize]
            field_conversion_custom_cast_present: bool
            field_conversion_alias_names: darray[sview]
            field_conversion_alias_targets: darray[Ast::Expr]
            field_conversion_alias_lines: darray[u32]
            field_conversion_bare_alias_root_fallback_valid: bool
            field_conversion_alias_owners: darray[sview]
            field_conversion_alias_has_formals: darray[bool]
            field_conversion_alias_scope_index_valid: bool
            field_conversion_alias_scope_index_hashes: darray[u32]
            field_conversion_alias_scope_index_values: darray[usize]
            field_conversion_alias_scope_index_counts: darray[usize]
            field_conversion_alias_index_valid: bool
            field_conversion_alias_index_hashes: darray[u32]
            field_conversion_alias_index_values: darray[usize]
            field_conversion_alias_index_counts: darray[usize]
            field_conversion_generic_params_valid: bool
            field_conversion_generic_param_lines: darray[u32]
            field_conversion_generic_param_names: darray[sview]
            field_conversion_generic_param_line: u32
            field_conversion_generic_param_index_valid: bool
            field_conversion_generic_param_index_hashes: darray[u32]
            field_conversion_generic_param_index_values: darray[usize]
            field_conversion_generic_param_index_counts: darray[usize]
            field_conversion_declared_types: darray[sview]
            field_conversion_declared_type_owners: darray[sview]
            field_conversion_declared_type_scope_index_valid: bool
            field_conversion_declared_type_scope_index_hashes: darray[u32]
            field_conversion_declared_type_scope_index_values: darray[usize]
            field_conversion_declared_type_scope_index_counts: darray[usize]
            field_conversion_declared_type_index_valid: bool
            field_conversion_declared_type_index_hashes: darray[u32]
            field_conversion_declared_type_index_values: darray[usize]
            field_conversion_declared_type_index_counts: darray[usize]
            capture_all_call_sites: mutable bool = false
            captured_call_offsets: mutable darray[usize] = []
            captured_call_lines: mutable darray[u32] = []
            captured_call_names: mutable darray[sview] = []
            captured_scope_offsets: mutable darray[usize] = []
