# Source sites for call summaries restated over a local (`result` bound to the local that holds
# the call's value). The producer emits these at the local's binding statement, and also over a
# local read by a `return`. Replay accepts one only when the source shows that, at the consuming
# certificate, the local still holds exactly that call's result:
#   - the alias names the exact declaration or assignment statement whose value is the call, or
#     a `return` whose reaching definition of the local is that call on every path;
#   - nothing may write the local between that binding and the consumer, including a loop or
#     branch that starts before the consumer, an explicit or implicit lend, or a rebinding;
#   - a binding nested in a branch or loop body only reaches consumers inside that body.
const module ProofReplayLocalAlias:
    ABSENT: usize = 0
    VALID: usize = 1
    INVALID: usize = 2
    DEPTH_LIMIT: usize = 96

extend ElisaProof:
    private:
        def proof_replay_statement_position(statement: Ast::Stmt) -> Ast::Pos:
            match statement:
                Ast::Stmt.Expr(_, position) | Ast::Stmt.Block(_, _, _, _, position) | Ast::Stmt.VarDecl(_, _, _, position) | Ast::Stmt.Assign(_, _, _, position):
                    return position
                Ast::Stmt.If(_, _, _, position) | Ast::Stmt.While(_, _, position) | Ast::Stmt.For(_, _, _, _, position) | Ast::Stmt.Return(_, position):
                    return position
                Ast::Stmt.Break(_, position) | Ast::Stmt.Continue(_, position) | Ast::Stmt.Match(_, _, position) | Ast::Stmt.Contract(_, _, position):
                    return position
                _:
                    return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}

        # Source offsets remain monotone across `#line` directives, unlike source line numbers.
        # Use the outermost end offset when checking whether a consumer stays inside a scope.
        def proof_replay_body_last_offset(body: darray[Ast::Stmt]&, source_work: mutable usize&, complete: mutable bool&, depth: usize) -> u32:
            can Abort.Panic:
                if depth >= ProofReplayLocalAlias::DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    complete <- false
                    return 0
                last: mutable u32 = 0
                for statement in body |last, source_work, complete, depth|:
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                        complete <- false
                        return 0
                    source_work <- source_work + 1
                    position: Ast::Pos = proof_replay_statement_position(statement)
                    last <- position.end_offset if position.end_offset > last
                    nested: mutable u32 = 0
                    match statement:
                        Ast::Stmt.If(_, yes, no, _):
                            nested <- proof_replay_body_last_offset(yes, source_work, complete, depth + 1)
                            return 0 if not proof_goal_bool_ref_value(complete)
                            no_last: u32 = proof_replay_body_last_offset(no, source_work, complete, depth + 1)
                            return 0 if not proof_goal_bool_ref_value(complete)
                            nested <- no_last if no_last > nested
                        Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _) | Ast::Stmt.Block(_, _, _, inner, _):
                            nested <- proof_replay_body_last_offset(inner, source_work, complete, depth + 1)
                            return 0 if not proof_goal_bool_ref_value(complete)
                        Ast::Stmt.Match(_, arms, _):
                            if arms.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                                proof_replay_mutable_local_work_exhaust(source_work)
                                complete <- false
                                return 0
                            source_work <- source_work + arms.count
                            for arm in arms |nested, source_work, complete, depth|:
                                arm_last: u32 = proof_replay_body_last_offset(arm.body, source_work, complete, depth + 1)
                                return 0 if not proof_goal_bool_ref_value(complete)
                                nested <- arm_last if arm_last > nested
                        Ast::Stmt.Expr(Ast::Expr.Block(inner, _, _, _), _):
                            nested <- proof_replay_body_last_offset(inner, source_work, complete, depth + 1)
                            return 0 if not proof_goal_bool_ref_value(complete)
                        _:
                            pass
                    last <- nested if nested > last
                return last

        def proof_replay_local_alias_call_value(value: Ast::Expr, expected_call: Ast::Expr) -> bool:
            match value:
                Ast::Expr.Call(_, _, _, _):
                    return proof_replay_call_source_position_equal(value, expected_call)
                Ast::Expr.Paren(inner, _):
                    match inner:
                        Ast::Expr.Call(_, _, _, _):
                            return proof_replay_call_source_position_equal(inner, expected_call)
                        _:
                            return false
                _:
                    return false

        def proof_replay_local_alias_consumer_position(report: ProofReport&, owner: sview, source_work: mutable usize&) -> (known: bool, position: Ast::Pos):
            return (false, Ast::pos_at_line(0)) if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate_index: usize = report.analysis_2.trace_consumer_certificate_index - 1
            certificate: ProofGoalCertificate = report.analysis_1.certificates[certificate_index]
            return (false, Ast::pos_at_line(0)) if certificate.name != owner or certificate.line != report.analysis_2.trace_owner_line
            position: Ast::Pos = Ast::expr_pos(certificate.goal)
            return (false, position) if:
                position.offset == 0 or position.end_offset < position.offset
                not proof_replay_summary_owner_source_preflight(report, owner, report.analysis_2.replay_owner_line, source_work)
            body: mutable darray[Ast::Stmt] = []
            return (false, position) if not proof_replay_source_owner_body_with_work(report, owner, report.analysis_2.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            body_cost_start: usize = source_work
            return (false, position) if not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
            body_cost: usize = source_work - body_cost_start
            return (false, position) if not proof_replay_type_bound_extent_preflight_with_work(body, Ast::Expr.Absent, false, certificate.goal, true, source_work)
            goal_cost: mutable usize = 0
            return (false, position) if not proof_replay_summary_expr_cost(certificate.goal, &goal_cost, 0, 0)
            # The cost walk above is itself a full traversal of the goal. Account for it
            # before reserving repeated goal work below, so each alias query cannot perform
            # this extra pass outside the shared source-work budget.
            return (false, position) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or goal_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + goal_cost
            return (false, position) if body_cost != 0 and goal_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / body_cost
            source_work <- source_work + body_cost * goal_cost
            return (false, position) if report.results.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + report.results.goal_attempts.count
            source_matches: mutable usize = 0
            proof_replay_type_bound_consumer_source_site_in_body_with_work(body, certificate, &source_matches, source_work, 0)
            return (false, position) if source_matches != 1
            attempt_matches: mutable usize = 0
            for attempt in report.results.goal_attempts |report, certificate, certificate_index, attempt_matches, source_work|:
                continue if not attempt.has_certificate or attempt.certificate_index != certificate_index
                return (false, position) if:
                    not proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, certificate_index, source_work)
                    not proof_replay_type_bound_goal_position_matches(attempt.goal, certificate.goal)
                attempt_matches <- attempt_matches + 1
            return (false, position) if attempt_matches != 1
            return (true, position)

        # The reservation census visits every parameter type to bound its own cost, but a call
        # slot lookup checks the type of at most one selected parameter in each matching function.
        # Keep those two costs separate so unused parameter types do not multiply by every call
        # candidate and nested alias-touch pass.
        def proof_replay_local_alias_call_slot_declaration_cost(declarations: darray[Ast::Decl]&, candidates: darray[sview]&, census_cost: mutable usize&, lookup_cost: mutable usize&, selected_type_lookup_cost: mutable usize&, callable_name_slots: mutable usize&, parameter_slots: mutable usize&, parameter_name_bytes: mutable usize&, work: usize, depth: usize) -> bool:
            return false if:
                depth >= ProofReplayLocalAlias::DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or census_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work or lookup_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work - census_cost
            census_cost <- census_cost + declarations.count
            return false if not proof_replay_summary_expr_cost_add(lookup_cost, work, declarations.count)
            for declaration in declarations |candidates, census_cost, lookup_cost, selected_type_lookup_cost, callable_name_slots, parameter_slots, parameter_name_bytes, work, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, _):
                        return false if callable_name_slots >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - parameter_slots
                        callable_name_slots <- callable_name_slots + 1
                        parameter_slots <- parameter_slots + parameters.count
                        return false if:
                            not proof_replay_summary_expr_cost_add(census_cost, work, sview_len(name))
                            not proof_replay_summary_expr_cost_add(census_cost, work, parameters.count)
                        maximum_parameter_type_cost: mutable usize = 0
                        for parameter in parameters |parameter, census_cost, maximum_parameter_type_cost, parameter_name_bytes, work, depth|:
                            parameter_name_length: usize = sview_len(parameter.name)
                            return false if:
                                not proof_replay_summary_expr_cost_add(census_cost, work, parameter_name_length)
                                parameter_name_bytes > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or parameter_name_length > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - parameter_name_bytes
                            parameter_name_bytes <- parameter_name_bytes + parameter_name_length
                            parameter_type_cost: mutable usize = 0
                            type_work: usize = work + census_cost
                            return false if:
                                not proof_replay_summary_expr_cost(parameter.type_expression, &parameter_type_cost, type_work, depth + 1)
                                not proof_replay_summary_expr_cost_add(census_cost, work, parameter_type_cost)
                            maximum_parameter_type_cost <- parameter_type_cost if parameter_type_cost > maximum_parameter_type_cost
                        for candidate_name in candidates |candidate_name, candidates, census_cost, selected_type_lookup_cost, work, name, maximum_parameter_type_cost|:
                            return false if:
                                not proof_replay_summary_expr_cost_add(census_cost, work, 1)
                                not proof_replay_summary_expr_cost_add(census_cost, work, sview_len(candidate_name))
                            if name == candidate_name:
                                return false if not proof_replay_summary_expr_cost_add(selected_type_lookup_cost, work, maximum_parameter_type_cost)
                    Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if callable_name_slots >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        callable_name_slots <- callable_name_slots + 1
                        return false if not proof_replay_summary_expr_cost_add(census_cost, work, sview_len(name))
                    Ast::Decl.Module(name, nested, _):
                        return false if:
                            not proof_replay_summary_expr_cost_add(census_cost, work, sview_len(name))
                            not proof_replay_local_alias_call_slot_declaration_cost(nested, candidates, census_cost, lookup_cost, selected_type_lookup_cost, callable_name_slots, parameter_slots, parameter_name_bytes, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_local_alias_call_slot_declaration_cost(nested, candidates, census_cost, lookup_cost, selected_type_lookup_cost, callable_name_slots, parameter_slots, parameter_name_bytes, work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_local_alias_body_touch_depth(body: darray[Ast::Stmt]&, depth: usize) -> usize:
            return ProofReplayLocalAlias::DEPTH_LIMIT if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            maximum: mutable usize = depth
            for statement in body |statement, maximum, depth|:
                match statement:
                    Ast::Stmt.If(_, yes, no, _):
                        yes_depth: usize = proof_replay_local_alias_body_touch_depth(yes, depth + 1)
                        no_depth: usize = proof_replay_local_alias_body_touch_depth(no, depth + 1)
                        maximum <- yes_depth if yes_depth > maximum
                        maximum <- no_depth if no_depth > maximum
                    Ast::Stmt.While(_, nested, _) | Ast::Stmt.For(_, _, _, nested, _) | Ast::Stmt.Block(_, _, _, nested, _):
                        nested_depth: usize = proof_replay_local_alias_body_touch_depth(nested, depth + 1)
                        maximum <- nested_depth if nested_depth > maximum
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |arm, maximum, depth|:
                            arm_depth: usize = proof_replay_local_alias_body_touch_depth(arm.body, depth + 1)
                            maximum <- arm_depth if arm_depth > maximum
                    Ast::Stmt.VarDecl(_, _, Ast::Expr.Block(nested, yielded, _, _), _):
                        nested_depth: usize = proof_replay_local_alias_body_touch_depth(nested, depth + 1)
                        maximum <- nested_depth if nested_depth > maximum
                        # A declaration's block result is revisited as a synthetic statement.
                        # If that result is another block, alias-site traversal enters its body
                        # at one more lexical level; reserve that directly yielded continuation.
                        match yielded:
                            Ast::Expr.Block(yielded_body, _, _, _):
                                yielded_depth: usize = proof_replay_local_alias_body_touch_depth(yielded_body, depth + 2)
                                maximum <- yielded_depth if yielded_depth > maximum
                            _:
                                pass
                    Ast::Stmt.Expr(Ast::Expr.Block(nested, _, _, _), _):
                        nested_depth: usize = proof_replay_local_alias_body_touch_depth(nested, depth + 1)
                        maximum <- nested_depth if nested_depth > maximum
                    _:
                        pass
            return maximum

        # Alias liveness can ask whether a call writes through a local. The source visitor only
        # scans declarations for call arguments rooted at this local, while nested source
        # wrappers may revisit the body at each lexical level. Count those lookup candidates
        # before reserving their declaration cost so unrelated AST nodes don't consume that
        # budget.
        def proof_replay_local_alias_touch_work_reservation(report: ProofReport&, body: darray[Ast::Stmt]&, local_name: sview, work: mutable usize&) -> bool:
            body_cost: mutable usize = 0
            return proof_replay_mutable_local_work_exhaust(work) if:
                not proof_replay_summary_expr_cost_body(body, &body_cost, work, 0)
                body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body_cost
            return true if body_cost == 0
            candidate_count: mutable usize = 0
            callee_query_bytes: mutable usize = 0
            candidate_callees: mutable darray[sview] = []
            named_argument_query_bytes: mutable usize = 0
            named_argument_count: mutable usize = 0
            root_walk_cost: mutable usize = 0
            root_extra_cost: mutable usize = 0
            return proof_replay_mutable_local_work_exhaust(work) if:
                not proof_replay_source_touch_candidate_count_body_with_root_work(body, local_name, true, 0, &candidate_count, &callee_query_bytes, &candidate_callees, &named_argument_query_bytes, &named_argument_count, &root_walk_cost, &root_extra_cost, work)
                candidate_count > body_cost
            declaration_census_cost: mutable usize = 0
            declaration_lookup_cost: mutable usize = 0
            declaration_selected_type_cost: mutable usize = 0
            callable_name_slots: mutable usize = 0
            parameter_slots: mutable usize = 0
            parameter_name_bytes: mutable usize = 0
            if candidate_count > 0:
                return proof_replay_mutable_local_work_exhaust(work) if:
                    not proof_replay_local_alias_call_slot_declaration_cost(report.source.source_declarations, candidate_callees, &declaration_census_cost, &declaration_lookup_cost, &declaration_selected_type_cost, &callable_name_slots, &parameter_slots, &parameter_name_bytes, work, 0)
                    declaration_census_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + declaration_census_cost
            # Site/control matching is separate from the expression/statement touch wrappers.
            return proof_replay_mutable_local_work_exhaust(work) if body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body_cost
            # The depth census is a separate unmetered source-tree walk from the AST sizing pass.
            return proof_replay_mutable_local_work_exhaust(work) if body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body_cost
            # The touch wrappers charge AST nodes for each actual visitor pass. Reserve only
            # their repeated auxiliary place-root, name, and declaration scans below.
            touch_depth: usize = proof_replay_local_alias_body_touch_depth(body, 0)
            # A flat body visits each candidate through one alias or liveness wrapper. Each
            # nested control level can add at most four whole-subtree/continuation visits.
            touch_passes: usize = touch_depth * 4 + 1
            return proof_replay_mutable_local_work_exhaust(work) if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            remaining: mutable usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            # Each visitor pass can revisit nested place-root prefixes (for example, each
            # unary lend in a chain scans the remaining tail). Reserve the measured root walks
            # for every alias touch pass, including the name comparison at each probe.
            if root_walk_cost > 0:
                local_name_bytes: usize = sview_len(local_name)
                return proof_replay_mutable_local_work_exhaust(work) if local_name_bytes >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                root_name_scale: usize = local_name_bytes + 1
                return proof_replay_mutable_local_work_exhaust(work) if root_walk_cost > remaining / touch_passes / root_name_scale
                root_work: usize = root_walk_cost * touch_passes * root_name_scale
                remaining <- remaining - root_work
                work <- work + root_work
            if root_extra_cost > 0:
                return proof_replay_mutable_local_work_exhaust(work) if root_extra_cost > remaining / touch_passes
                repeated_root_extra_work: usize = root_extra_cost * touch_passes
                remaining <- remaining - repeated_root_extra_work
                work <- work + repeated_root_extra_work
            if candidate_count > 0:
                declaration_lookup_cost <- 1 if declaration_lookup_cost == 0
                if callable_name_slots > 0:
                    return proof_replay_mutable_local_work_exhaust(work) if touch_passes > remaining / callable_name_slots
                    callee_comparison_scale: usize = callable_name_slots * touch_passes
                    return proof_replay_mutable_local_work_exhaust(work) if callee_query_bytes > remaining / callee_comparison_scale
                    callee_comparison_work: usize = callee_query_bytes * callee_comparison_scale
                    remaining <- remaining - callee_comparison_work
                    work <- work + callee_comparison_work
                if parameter_slots > 0 and named_argument_count > 0:
                    return proof_replay_mutable_local_work_exhaust(work) if touch_passes > remaining / parameter_slots
                    named_parameter_scale: usize = parameter_slots * touch_passes
                    return proof_replay_mutable_local_work_exhaust(work) if named_argument_count > remaining / named_parameter_scale
                    named_parameter_scan_work: usize = named_argument_count * named_parameter_scale
                    remaining <- remaining - named_parameter_scan_work
                    work <- work + named_parameter_scan_work
                    return proof_replay_mutable_local_work_exhaust(work) if named_argument_query_bytes > remaining / named_parameter_scale
                    named_parameter_compare_work: usize = named_argument_query_bytes * named_parameter_scale
                    remaining <- remaining - named_parameter_compare_work
                    work <- work + named_parameter_compare_work
                    if parameter_name_bytes > 0:
                        return proof_replay_mutable_local_work_exhaust(work) if touch_passes > remaining / parameter_name_bytes
                        named_declaration_scale: usize = parameter_name_bytes * touch_passes
                        return proof_replay_mutable_local_work_exhaust(work) if named_argument_count > remaining / named_declaration_scale
                        named_declaration_compare_work: usize = named_argument_count * named_declaration_scale
                        remaining <- remaining - named_declaration_compare_work
                        work <- work + named_declaration_compare_work
                if declaration_selected_type_cost > 0:
                    return proof_replay_mutable_local_work_exhaust(work) if declaration_selected_type_cost > remaining / touch_passes
                    repeated_selected_type_work: usize = declaration_selected_type_cost * touch_passes
                    remaining <- remaining - repeated_selected_type_work
                    work <- work + repeated_selected_type_work
                return proof_replay_mutable_local_work_exhaust(work) if touch_passes > remaining / candidate_count or declaration_lookup_cost > remaining / candidate_count / touch_passes
                candidate_lookup_work: usize = candidate_count * touch_passes * declaration_lookup_cost
                remaining <- remaining - candidate_lookup_work
                work <- work + candidate_lookup_work
            return true

        def proof_replay_local_alias_expr_touches_with_work(report: ProofReport&, owner_body: darray[Ast::Stmt]&, expression: Ast::Expr, name: sview, writes: bool, source_work: mutable usize&) -> bool:
            return true if not proof_replay_mutable_local_expr_work_charge(expression, source_work)
            return proof_replay_source_expr_touches(report.source.source_declarations, expression, name, writes, 0) or proof_replay_source_expr_calls_mutating_local_lambda(owner_body, expression, name, source_work, 0)

        def proof_replay_local_alias_statement_touches_with_work(report: ProofReport&, owner_body: darray[Ast::Stmt]&, statement: Ast::Stmt, name: sview, writes: bool, source_work: mutable usize&) -> bool:
            return true if not proof_replay_mutable_local_statement_work_charge_fail_closed(statement, source_work, 0)
            return proof_replay_source_statement_touches(report.source.source_declarations, statement, name, writes, 0) or proof_replay_source_body_calls_mutating_local_lambda(owner_body, [statement], name, source_work, 0)

        # The local's binding statement at `index` reaches the exact consumer position unchanged.
        def proof_replay_local_alias_live(report: ProofReport&, owner_body: darray[Ast::Stmt]&, body: darray[Ast::Stmt]&, index: usize, local_name: sview, binding_position: Ast::Pos, consumer_position: Ast::Pos, nested: bool, source_work: mutable usize&) -> bool:
            return false if:
                index >= body.count or consumer_position.offset == 0 or binding_position.offset == 0
                consumer_position.offset < binding_position.offset
            if nested:
                body_bound_complete: mutable bool = true
                body_last: u32 = proof_replay_body_last_offset(body, source_work, &body_bound_complete, 0)
                return false if not body_bound_complete or consumer_position.offset >= body_last
            first_later: usize = index + 1
            for later in first_later..<body.count |later, body, report, local_name, consumer_position, source_work|:
                later_position: Ast::Pos = proof_replay_statement_position(body[later])
                if later_position.offset > consumer_position.offset:
                    break
                touches: bool = proof_replay_local_alias_statement_touches_with_work(report, owner_body, body[later], local_name, true, source_work)
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or touches
            return true

        def proof_replay_local_alias_nested(report: ProofReport&, owner_body: darray[Ast::Stmt]&, body: darray[Ast::Stmt]&, local_name: sview, binding_position: Ast::Pos, expected_call: Ast::Expr, consumer_position: Ast::Pos, reaching: bool, depth: usize, source_work: mutable usize&) -> usize:
            return ProofReplayLocalAlias::INVALID if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            return proof_replay_local_alias_site(report, owner_body, body, local_name, binding_position, expected_call, consumer_position, reaching, true, depth + 1, source_work)

        # Locate the alias site in `body`. `reaching` says whether, on entry to this list, the
        # local's value on every path is exactly the expected call's result.
        def proof_replay_local_alias_site(report: ProofReport&, owner_body: darray[Ast::Stmt]&, body: darray[Ast::Stmt]&, local_name: sview, binding_position: Ast::Pos, expected_call: Ast::Expr, consumer_position: Ast::Pos, reaching_on_entry: bool, nested: bool, depth: usize, source_work: mutable usize&) -> usize:
            return ProofReplayLocalAlias::INVALID if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            reaching: mutable bool = reaching_on_entry
            for index in 0..<body.count |index, body, report, local_name, binding_position, expected_call, consumer_position, nested, depth, reaching, source_work|:
                statement: Ast::Stmt = body[index]
                position: Ast::Pos = proof_replay_statement_position(statement)
                found: mutable usize = ProofReplayLocalAlias::ABSENT
                written_value: mutable Ast::Expr = Ast::Expr.Absent
                direct_write: mutable bool = false
                match statement:
                    Ast::Stmt.VarDecl(name, _, initializer, _):
                        if name == local_name:
                            direct_write <- true
                            written_value <- initializer
                        match initializer:
                            Ast::Expr.Block(inner, yielded, _, _):
                                # Include the final expression in the lexical lifetime and
                                # mutation check. A block-local result cannot escape this list.
                                scoped: mutable darray[Ast::Stmt] = []
                                for child in inner |scoped|:
                                    scoped.push(child)
                                scoped.push(Ast::Stmt.Expr(yielded, Ast::expr_pos(yielded)))
                                found <- proof_replay_local_alias_nested(report, owner_body, &scoped, local_name, binding_position, expected_call, consumer_position, false, depth, source_work)
                            _:
                                pass
                    Ast::Stmt.Assign(Ast::Expr.Ident(name, _), operator, value, _):
                        if name == local_name and (operator == TokenKind.Assign or operator == TokenKind.LArrow):
                            direct_write <- true
                            written_value <- value
                    Ast::Stmt.Return(value, _):
                        if position.offset > 0 and consumer_position.offset >= position.offset and consumer_position.offset < position.end_offset:
                            if value is returned:
                                return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_expr_work_charge(returned, source_work)
                                if proof_replay_source_local_use(returned, local_name, binding_position, 0):
                                    return ProofReplayLocalAlias::INVALID if not reaching or consumer_position.offset < position.offset or consumer_position.offset >= position.end_offset
                                    touches_return: bool = proof_replay_local_alias_expr_touches_with_work(report, owner_body, returned, local_name, true, source_work)
                                    return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or touches_return
                                    found <- ProofReplayLocalAlias::VALID
                    Ast::Stmt.If(condition, yes, no, _):
                        condition_touches: bool = proof_replay_local_alias_expr_touches_with_work(report, owner_body, condition, local_name, true, source_work)
                        return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        branch_reaching: bool = reaching and not condition_touches
                        found <- proof_replay_local_alias_nested(report, owner_body, yes, local_name, binding_position, expected_call, consumer_position, branch_reaching, depth, source_work)
                        found <- proof_replay_local_alias_nested(report, owner_body, no, local_name, binding_position, expected_call, consumer_position, branch_reaching, depth, source_work) if found == ProofReplayLocalAlias::ABSENT
                    Ast::Stmt.Match(subject, arms, _):
                        subject_touches: bool = proof_replay_local_alias_expr_touches_with_work(report, owner_body, subject, local_name, true, source_work)
                        return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        subject_reaching: bool = reaching and not subject_touches
                        for arm in arms |found, report, local_name, binding_position, expected_call, consumer_position, subject_reaching, depth, source_work|:
                            continue if found != ProofReplayLocalAlias::ABSENT
                            guard_touches: bool = proof_replay_local_alias_expr_touches_with_work(report, owner_body, arm.guard, local_name, true, source_work)
                            return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            arm_reaching: bool = subject_reaching and not guard_touches and not proof_replay_source_pattern_binds_with_work(arm.pattern, local_name, source_work, 0)
                            return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            found <- proof_replay_local_alias_nested(report, owner_body, arm.body, local_name, binding_position, expected_call, consumer_position, arm_reaching, depth, source_work)
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        # A later iteration re-enters the body with whatever the body last wrote.
                        loop_touches: bool = proof_replay_local_alias_statement_touches_with_work(report, owner_body, statement, local_name, true, source_work)
                        return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        loop_reaching: bool = reaching and not loop_touches
                        found <- proof_replay_local_alias_nested(report, owner_body, inner, local_name, binding_position, expected_call, consumer_position, loop_reaching, depth, source_work)
                    Ast::Stmt.Expr(Ast::Expr.Block(inner, _, _, _), _):
                        # The parser's captured-loop wrapper; treated as a loop for the same reason.
                        block_touches: bool = proof_replay_local_alias_statement_touches_with_work(report, owner_body, statement, local_name, true, source_work)
                        return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        block_reaching: bool = reaching and not block_touches
                        found <- proof_replay_local_alias_nested(report, owner_body, inner, local_name, binding_position, expected_call, consumer_position, block_reaching, depth, source_work)
                    Ast::Stmt.Block(_, _, binding, inner, _):
                        found <- proof_replay_local_alias_nested(report, owner_body, inner, local_name, binding_position, expected_call, consumer_position, reaching and binding != local_name, depth, source_work)
                    _:
                        pass
                if direct_write and proof_replay_source_position_equal(position, binding_position):
                    return ProofReplayLocalAlias::INVALID if not proof_replay_local_alias_call_value(written_value, expected_call)
                    return ProofReplayLocalAlias::VALID if proof_replay_local_alias_live(report, owner_body, body, index, local_name, binding_position, consumer_position, nested, source_work)
                    return ProofReplayLocalAlias::INVALID
                return found if found != ProofReplayLocalAlias::ABSENT
                if direct_write:
                    value_touches: bool = proof_replay_local_alias_expr_touches_with_work(report, owner_body, written_value, local_name, true, source_work)
                    return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    reaching <- proof_replay_local_alias_call_value(written_value, expected_call) and not value_touches
                else:
                    statement_touches: bool = proof_replay_local_alias_statement_touches_with_work(report, owner_body, statement, local_name, true, source_work)
                    return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    reaching <- false if statement_touches
            return ProofReplayLocalAlias::ABSENT

        # Check that the source local receives this call at an exact consumer source position.
        def proof_replay_summary_local_alias_valid_at(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr, consumer_position: Ast::Pos) -> bool:
            return false if local_name == "" or consumer_position.offset == 0
            source_work: mutable usize = 0
            return proof_replay_summary_local_alias_valid_at_with_work(report, owner, local_name, binding_position, call, consumer_position, &source_work)

        def proof_replay_summary_local_alias_valid_at_with_work(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr, consumer_position: Ast::Pos, source_work: mutable usize&) -> bool:
            return false if:
                local_name == "" or consumer_position.offset == 0 or consumer_position.end_offset < consumer_position.offset
                not proof_replay_mutable_local_owner_preflight_work_charge(report, owner, report.analysis_2.replay_owner_line, source_work)
            body: mutable darray[Ast::Stmt] = []
            return false if:
                not proof_replay_source_owner_body_with_work(report, owner, report.analysis_2.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                not proof_replay_local_alias_touch_work_reservation(report, body, local_name, source_work)
            return proof_replay_local_alias_site(report, body, body, local_name, binding_position, call, consumer_position, false, false, 0, source_work) == ProofReplayLocalAlias::VALID

        # Ordinary aliases remain live through the source position consuming the summary.
        def proof_replay_summary_local_alias_valid(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr) -> bool:
            source_work: mutable usize = 0
            consumer: (known: bool, position: Ast::Pos) = proof_replay_local_alias_consumer_position(report, owner, &source_work)
            return false if not consumer.known
            return proof_replay_summary_local_alias_valid_at_with_work(report, owner, local_name, binding_position, call, consumer.position, &source_work)

        def proof_replay_summary_local_alias_valid_with_work(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr, source_work: mutable usize&) -> bool:
            consumer: (known: bool, position: Ast::Pos) = proof_replay_local_alias_consumer_position(report, owner, source_work)
            return false if not consumer.known
            return proof_replay_summary_local_alias_valid_at_with_work(report, owner, local_name, binding_position, call, consumer.position, source_work)
