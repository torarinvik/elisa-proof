# Source sites for call summaries restated over a local (`result` bound to the local that holds
# the call's value). The producer emits these at the local's binding statement, and also over a
# local read by a `return`. Replay accepts one only when the source shows that, at the consuming
# certificate, the local still holds exactly that call's result:
#   - the alias names the exact declaration or assignment statement whose value is the call, or
#     a `return` whose reaching definition of the local is that call on every path;
#   - nothing may write the local between that binding and the consumer, including a loop or
#     branch that starts before the consumer, an explicit or implicit lend, or a rebinding;
#   - a binding nested in a branch or loop body only reaches consumers inside that body.
const module ProofReplayLocalAlias:
    ABSENT: usize = 0
    VALID: usize = 1
    INVALID: usize = 2
    DEPTH_LIMIT: usize = 96

extend ElisaProof:
    private:
        def proof_replay_statement_position(statement: Ast::Stmt) -> Ast::Pos:
            match statement:
                Ast::Stmt.Expr(_, position) | Ast::Stmt.Block(_, _, _, _, position) | Ast::Stmt.VarDecl(_, _, _, position) | Ast::Stmt.Assign(_, _, _, position):
                    return position
                Ast::Stmt.If(_, _, _, position) | Ast::Stmt.While(_, _, position) | Ast::Stmt.For(_, _, _, _, position) | Ast::Stmt.Return(_, position):
                    return position
                Ast::Stmt.Break(_, position) | Ast::Stmt.Continue(_, position) | Ast::Stmt.Match(_, _, position) | Ast::Stmt.Contract(_, _, position):
                    return position
                _:
                    return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}

        # The last source line any statement of `body` occupies, nested bodies included. Lines
        # of multi-line expressions are covered by the statement's recorded end line.
        def proof_replay_body_last_line(body: darray[Ast::Stmt]&, depth: usize) -> u32:
            return 4294967295 if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            last: mutable u32 = 0
            for statement in body |last, depth|:
                position: Ast::Pos = proof_replay_statement_position(statement)
                last <- position.line if position.line > last
                last <- position.end_line if position.end_line > last
                nested: mutable u32 = 0
                match statement:
                    Ast::Stmt.If(_, yes, no, _):
                        nested <- proof_replay_body_last_line(yes, depth + 1)
                        no_last: u32 = proof_replay_body_last_line(no, depth + 1)
                        nested <- no_last if no_last > nested
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _) | Ast::Stmt.Block(_, _, _, inner, _):
                        nested <- proof_replay_body_last_line(inner, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |nested, depth|:
                            arm_last: u32 = proof_replay_body_last_line(arm.body, depth + 1)
                            nested <- arm_last if arm_last > nested
                    Ast::Stmt.Expr(Ast::Expr.Block(inner, _, _, _), _):
                        nested <- proof_replay_body_last_line(inner, depth + 1)
                    _:
                        pass
                last <- nested if nested > last
            return last

        def proof_replay_local_alias_call_value(value: Ast::Expr, expected_call: Ast::Expr) -> bool:
            match value:
                Ast::Expr.Call(_, _, _, _):
                    return proof_replay_call_source_position_equal(value, expected_call)
                Ast::Expr.Paren(inner, _):
                    match inner:
                        Ast::Expr.Call(_, _, _, _):
                            return proof_replay_call_source_position_equal(inner, expected_call)
                        _:
                            return false
                _:
                    return false

        # The reservation census visits every parameter type to bound its own cost, but a call
        # slot lookup checks the type of at most one selected parameter in each matching function.
        # Keep those two costs separate so unused parameter types do not multiply by every call
        # candidate and nested alias-touch pass.
        def proof_replay_local_alias_call_slot_declaration_cost(declarations: darray[Ast::Decl]&, census_cost: mutable usize&, lookup_cost: mutable usize&, comparison_slots: mutable usize&, work: usize, depth: usize) -> bool:
            return false if depth >= ProofReplayLocalAlias::DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or census_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work or lookup_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            return false if declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work - census_cost
            census_cost <- census_cost + declarations.count
            return false if not proof_replay_summary_expr_cost_add(lookup_cost, work, declarations.count)
            for declaration in declarations |census_cost, lookup_cost, comparison_slots, work, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, _):
                        return false if comparison_slots >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - comparison_slots - 1
                        comparison_slots <- comparison_slots + 1 + parameters.count
                        return false if not proof_replay_summary_expr_cost_add(census_cost, work, sview_len(name))
                        return false if not proof_replay_summary_expr_cost_add(lookup_cost, work, sview_len(name))
                        return false if not proof_replay_summary_expr_cost_add(census_cost, work, parameters.count)
                        return false if not proof_replay_summary_expr_cost_add(lookup_cost, work, parameters.count)
                        maximum_parameter_type_cost: mutable usize = 0
                        for parameter in parameters |census_cost, lookup_cost, maximum_parameter_type_cost, work, depth|:
                            return false if not proof_replay_summary_expr_cost_add(census_cost, work, sview_len(parameter.name))
                            return false if not proof_replay_summary_expr_cost_add(lookup_cost, work, sview_len(parameter.name))
                            parameter_type_cost: mutable usize = 0
                            type_work: usize = work + census_cost
                            return false if not proof_replay_summary_expr_cost(parameter.type_expression, &parameter_type_cost, type_work, depth + 1)
                            return false if not proof_replay_summary_expr_cost_add(census_cost, work, parameter_type_cost)
                            maximum_parameter_type_cost <- parameter_type_cost if parameter_type_cost > maximum_parameter_type_cost
                        return false if not proof_replay_summary_expr_cost_add(lookup_cost, work, maximum_parameter_type_cost)
                    Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if comparison_slots >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        comparison_slots <- comparison_slots + 1
                        return false if not proof_replay_summary_expr_cost_add(census_cost, work, sview_len(name))
                        return false if not proof_replay_summary_expr_cost_add(lookup_cost, work, sview_len(name))
                    Ast::Decl.Module(name, nested, _):
                        return false if not proof_replay_summary_expr_cost_add(census_cost, work, sview_len(name))
                        return false if not proof_replay_local_alias_call_slot_declaration_cost(nested, census_cost, lookup_cost, comparison_slots, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_local_alias_call_slot_declaration_cost(nested, census_cost, lookup_cost, comparison_slots, work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_local_alias_body_touch_depth(body: darray[Ast::Stmt]&, depth: usize) -> usize:
            return ProofReplayLocalAlias::DEPTH_LIMIT if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            maximum: mutable usize = depth
            for statement in body |statement, maximum, depth|:
                match statement:
                    Ast::Stmt.If(_, yes, no, _):
                        yes_depth: usize = proof_replay_local_alias_body_touch_depth(yes, depth + 1)
                        no_depth: usize = proof_replay_local_alias_body_touch_depth(no, depth + 1)
                        maximum <- yes_depth if yes_depth > maximum
                        maximum <- no_depth if no_depth > maximum
                    Ast::Stmt.While(_, nested, _) | Ast::Stmt.For(_, _, _, nested, _) | Ast::Stmt.Block(_, _, _, nested, _):
                        nested_depth: usize = proof_replay_local_alias_body_touch_depth(nested, depth + 1)
                        maximum <- nested_depth if nested_depth > maximum
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |arm, maximum, depth|:
                            arm_depth: usize = proof_replay_local_alias_body_touch_depth(arm.body, depth + 1)
                            maximum <- arm_depth if arm_depth > maximum
                    Ast::Stmt.VarDecl(_, _, Ast::Expr.Block(nested, yielded, _, _), _):
                        nested_depth: usize = proof_replay_local_alias_body_touch_depth(nested, depth + 1)
                        maximum <- nested_depth if nested_depth > maximum
                        # A declaration's block result is revisited as a synthetic statement.
                        # If that result is another block, alias-site traversal enters its body
                        # at one more lexical level; reserve that directly yielded continuation.
                        match yielded:
                            Ast::Expr.Block(yielded_body, _, _, _):
                                yielded_depth: usize = proof_replay_local_alias_body_touch_depth(yielded_body, depth + 2)
                                maximum <- yielded_depth if yielded_depth > maximum
                            _:
                                pass
                    Ast::Stmt.Expr(Ast::Expr.Block(nested, _, _, _), _):
                        nested_depth: usize = proof_replay_local_alias_body_touch_depth(nested, depth + 1)
                        maximum <- nested_depth if nested_depth > maximum
                    _:
                        pass
            return maximum

        # Alias liveness can ask whether a call writes through a local. The source visitor only
        # scans declarations for call arguments rooted at this local, while nested source
        # wrappers may revisit the body at each lexical level. Count those lookup candidates
        # before reserving their declaration cost so unrelated AST nodes don't consume that
        # budget.
        def proof_replay_local_alias_touch_work_reservation(report: ProofReport&, body: darray[Ast::Stmt]&, local_name: sview, work: mutable usize&) -> bool:
            body_cost: mutable usize = 0
            return proof_replay_mutable_local_work_exhaust(work) if not proof_replay_summary_expr_cost_body(body, &body_cost, work, 0)
            return proof_replay_mutable_local_work_exhaust(work) if body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body_cost
            return true if body_cost == 0
            candidate_count: mutable usize = 0
            query_bytes: mutable usize = 0
            root_walk_cost: mutable usize = 0
            root_extra_cost: mutable usize = 0
            return proof_replay_mutable_local_work_exhaust(work) if not proof_replay_source_touch_candidate_count_body_with_root_work(body, local_name, true, 0, &candidate_count, &query_bytes, &root_walk_cost, &root_extra_cost, work)
            return proof_replay_mutable_local_work_exhaust(work) if candidate_count > body_cost
            declaration_census_cost: mutable usize = 0
            declaration_lookup_cost: mutable usize = 0
            lookup_comparison_slots: mutable usize = 0
            if candidate_count > 0:
                return proof_replay_mutable_local_work_exhaust(work) if not proof_replay_local_alias_call_slot_declaration_cost(report.source_declarations, &declaration_census_cost, &declaration_lookup_cost, &lookup_comparison_slots, work, 0)
                return proof_replay_mutable_local_work_exhaust(work) if declaration_census_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + declaration_census_cost
            # Site/control matching and the nested body-bound query are separate from the
            # expression/statement touch wrappers, so charge one bounded body pass for them.
            return proof_replay_mutable_local_work_exhaust(work) if body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body_cost
            # The depth census is a separate unmetered source-tree walk from the AST sizing pass.
            return proof_replay_mutable_local_work_exhaust(work) if body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body_cost
            # The touch wrappers charge AST nodes for each actual visitor pass. Reserve only
            # their repeated auxiliary place-root, name, and declaration scans below.
            touch_depth: usize = proof_replay_local_alias_body_touch_depth(body, 0)
            # A flat body visits each candidate through one alias or liveness wrapper. Each
            # nested control level can add at most four whole-subtree/continuation visits.
            touch_passes: usize = touch_depth * 4 + 1
            return proof_replay_mutable_local_work_exhaust(work) if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            remaining: mutable usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            # Each visitor pass can revisit nested place-root prefixes (for example, each
            # unary lend in a chain scans the remaining tail). Reserve the measured root walks
            # for every alias touch pass, including the name comparison at each probe.
            if root_walk_cost > 0:
                local_name_bytes: usize = sview_len(local_name)
                return proof_replay_mutable_local_work_exhaust(work) if local_name_bytes >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                root_name_scale: usize = local_name_bytes + 1
                return proof_replay_mutable_local_work_exhaust(work) if root_walk_cost > remaining / touch_passes / root_name_scale
                root_work: usize = root_walk_cost * touch_passes * root_name_scale
                remaining <- remaining - root_work
                work <- work + root_work
            if root_extra_cost > 0:
                return proof_replay_mutable_local_work_exhaust(work) if root_extra_cost > remaining / touch_passes
                repeated_root_extra_work: usize = root_extra_cost * touch_passes
                remaining <- remaining - repeated_root_extra_work
                work <- work + repeated_root_extra_work
            if candidate_count > 0:
                declaration_lookup_cost <- 1 if declaration_lookup_cost == 0
                if lookup_comparison_slots > 0:
                    return proof_replay_mutable_local_work_exhaust(work) if touch_passes > remaining / lookup_comparison_slots
                    query_comparison_scale: usize = lookup_comparison_slots * touch_passes
                    return proof_replay_mutable_local_work_exhaust(work) if query_bytes > remaining / query_comparison_scale
                    # The candidate census counts the callee name once per rooted argument,
                    # since each argument lookup repeats that comparison against the declarations.
                    query_comparison_work: usize = query_bytes * query_comparison_scale
                    remaining <- remaining - query_comparison_work
                    work <- work + query_comparison_work
                return proof_replay_mutable_local_work_exhaust(work) if touch_passes > remaining / candidate_count or declaration_lookup_cost > remaining / candidate_count / touch_passes
                candidate_lookup_work: usize = candidate_count * touch_passes * declaration_lookup_cost
                remaining <- remaining - candidate_lookup_work
                work <- work + candidate_lookup_work
            return true

        def proof_replay_local_alias_expr_touches_with_work(report: ProofReport&, expression: Ast::Expr, name: sview, writes: bool, source_work: mutable usize&) -> bool:
            return true if not proof_replay_mutable_local_expr_work_charge(expression, source_work)
            return proof_replay_source_expr_touches(report.source_declarations, expression, name, writes, 0)

        def proof_replay_local_alias_statement_touches_with_work(report: ProofReport&, statement: Ast::Stmt, name: sview, writes: bool, source_work: mutable usize&) -> bool:
            return true if not proof_replay_mutable_local_statement_work_charge_fail_closed(statement, source_work, 0)
            return proof_replay_source_statement_touches(report.source_declarations, statement, name, writes, 0)

        # The local's binding statement at `index` reaches `consumer_line` unchanged.
        def proof_replay_local_alias_live(report: ProofReport&, body: darray[Ast::Stmt]&, index: usize, local_name: sview, consumer_line: u32, nested: bool, source_work: mutable usize&) -> bool:
            return false if index >= body.count or consumer_line == 0
            binding_line: u32 = proof_replay_statement_position(body[index]).line
            return false if consumer_line < binding_line
            return false if nested and consumer_line > proof_replay_body_last_line(body, 0)
            first_later: usize = index + 1
            for later in first_later..<body.count |later, body, report, local_name, consumer_line, source_work|:
                if proof_replay_statement_position(body[later]).line > consumer_line:
                    break
                touches: bool = proof_replay_local_alias_statement_touches_with_work(report, body[later], local_name, true, source_work)
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or touches
            return true

        def proof_replay_local_alias_nested(report: ProofReport&, body: darray[Ast::Stmt]&, local_name: sview, binding_position: Ast::Pos, expected_call: Ast::Expr, consumer_line: u32, reaching: bool, depth: usize, source_work: mutable usize&) -> usize:
            return ProofReplayLocalAlias::INVALID if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            return proof_replay_local_alias_site(report, body, local_name, binding_position, expected_call, consumer_line, reaching, true, depth + 1, source_work)

        # Locate the alias site in `body`. `reaching` says whether, on entry to this list, the
        # local's value on every path is exactly the expected call's result.
        def proof_replay_local_alias_site(report: ProofReport&, body: darray[Ast::Stmt]&, local_name: sview, binding_position: Ast::Pos, expected_call: Ast::Expr, consumer_line: u32, reaching_on_entry: bool, nested: bool, depth: usize, source_work: mutable usize&) -> usize:
            return ProofReplayLocalAlias::INVALID if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            reaching: mutable bool = reaching_on_entry
            for index in 0..<body.count |index, body, report, local_name, binding_position, expected_call, consumer_line, nested, depth, reaching, source_work|:
                statement: Ast::Stmt = body[index]
                position: Ast::Pos = proof_replay_statement_position(statement)
                found: mutable usize = ProofReplayLocalAlias::ABSENT
                written_value: mutable Ast::Expr = Ast::Expr.Absent
                direct_write: mutable bool = false
                match statement:
                    Ast::Stmt.VarDecl(name, _, initializer, _):
                        if name == local_name:
                            direct_write <- true
                            written_value <- initializer
                        match initializer:
                            Ast::Expr.Block(inner, yielded, _, _):
                                # Include the final expression in the lexical lifetime and
                                # mutation check. A block-local result cannot escape this list.
                                scoped: mutable darray[Ast::Stmt] = []
                                for child in inner |scoped|:
                                    scoped.push(child)
                                scoped.push(Ast::Stmt.Expr(yielded, Ast::expr_pos(yielded)))
                                found <- proof_replay_local_alias_nested(report, &scoped, local_name, binding_position, expected_call, consumer_line, false, depth, source_work)
                            _:
                                pass
                    Ast::Stmt.Assign(Ast::Expr.Ident(name, _), operator, value, _):
                        if name == local_name and (operator == TokenKind.Assign or operator == TokenKind.LArrow):
                            direct_write <- true
                            written_value <- value
                    Ast::Stmt.Return(value, _):
                        if position.line == binding_position.line:
                            if value is returned:
                                return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_expr_work_charge(returned, source_work)
                                if proof_replay_source_local_use(returned, local_name, binding_position, 0):
                                    return ProofReplayLocalAlias::INVALID if not reaching or consumer_line != position.line
                                    touches_return: bool = proof_replay_local_alias_expr_touches_with_work(report, returned, local_name, true, source_work)
                                    return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or touches_return
                                    found <- ProofReplayLocalAlias::VALID
                    Ast::Stmt.If(condition, yes, no, _):
                        condition_touches: bool = proof_replay_local_alias_expr_touches_with_work(report, condition, local_name, true, source_work)
                        return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        branch_reaching: bool = reaching and not condition_touches
                        found <- proof_replay_local_alias_nested(report, yes, local_name, binding_position, expected_call, consumer_line, branch_reaching, depth, source_work)
                        found <- proof_replay_local_alias_nested(report, no, local_name, binding_position, expected_call, consumer_line, branch_reaching, depth, source_work) if found == ProofReplayLocalAlias::ABSENT
                    Ast::Stmt.Match(subject, arms, _):
                        subject_touches: bool = proof_replay_local_alias_expr_touches_with_work(report, subject, local_name, true, source_work)
                        return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        subject_reaching: bool = reaching and not subject_touches
                        for arm in arms |found, report, local_name, binding_position, expected_call, consumer_line, subject_reaching, depth, source_work|:
                            continue if found != ProofReplayLocalAlias::ABSENT
                            arm_reaching: bool = subject_reaching and not proof_replay_source_pattern_binds(arm.pattern, local_name, 0)
                            found <- proof_replay_local_alias_nested(report, arm.body, local_name, binding_position, expected_call, consumer_line, arm_reaching, depth, source_work)
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        # A later iteration re-enters the body with whatever the body last wrote.
                        loop_touches: bool = proof_replay_local_alias_statement_touches_with_work(report, statement, local_name, true, source_work)
                        return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        loop_reaching: bool = reaching and not loop_touches
                        found <- proof_replay_local_alias_nested(report, inner, local_name, binding_position, expected_call, consumer_line, loop_reaching, depth, source_work)
                    Ast::Stmt.Expr(Ast::Expr.Block(inner, _, _, _), _):
                        # The parser's captured-loop wrapper; treated as a loop for the same reason.
                        block_touches: bool = proof_replay_local_alias_statement_touches_with_work(report, statement, local_name, true, source_work)
                        return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        block_reaching: bool = reaching and not block_touches
                        found <- proof_replay_local_alias_nested(report, inner, local_name, binding_position, expected_call, consumer_line, block_reaching, depth, source_work)
                    Ast::Stmt.Block(_, _, binding, inner, _):
                        found <- proof_replay_local_alias_nested(report, inner, local_name, binding_position, expected_call, consumer_line, reaching and binding != local_name, depth, source_work)
                    _:
                        pass
                if direct_write and proof_replay_source_position_equal(position, binding_position):
                    return ProofReplayLocalAlias::INVALID if not proof_replay_local_alias_call_value(written_value, expected_call)
                    return ProofReplayLocalAlias::VALID if proof_replay_local_alias_live(report, body, index, local_name, consumer_line, nested, source_work)
                    return ProofReplayLocalAlias::INVALID
                return found if found != ProofReplayLocalAlias::ABSENT
                if direct_write:
                    value_touches: bool = proof_replay_local_alias_expr_touches_with_work(report, written_value, local_name, true, source_work)
                    return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    reaching <- proof_replay_local_alias_call_value(written_value, expected_call) and not value_touches
                else:
                    statement_touches: bool = proof_replay_local_alias_statement_touches_with_work(report, statement, local_name, true, source_work)
                    return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    reaching <- false if statement_touches
            return ProofReplayLocalAlias::ABSENT

        # Check that the source local receives this call at an explicit consumer line. Result
        # symbol identity uses the binding line itself; ordinary local aliases use the consumer.
        def proof_replay_summary_local_alias_valid_at(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr, consumer_line: u32) -> bool:
            return false if local_name == "" or consumer_line == 0
            source_work: mutable usize = 0
            return proof_replay_summary_local_alias_valid_at_with_work(report, owner, local_name, binding_position, call, consumer_line, &source_work)

        def proof_replay_summary_local_alias_valid_at_with_work(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr, consumer_line: u32, source_work: mutable usize&) -> bool:
            return false if local_name == "" or consumer_line == 0
            return false if not proof_replay_mutable_local_owner_preflight_work_charge(report, owner, report.replay_owner_line, source_work)
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body(report, owner, report.replay_owner_line, &body)
            return false if not proof_replay_local_alias_touch_work_reservation(report, body, local_name, source_work)
            return proof_replay_local_alias_site(report, body, local_name, binding_position, call, consumer_line, false, false, 0, source_work) == ProofReplayLocalAlias::VALID

        # Ordinary aliases must remain live at the certificate line consuming the summary.
        def proof_replay_summary_local_alias_valid(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr) -> bool:
            return proof_replay_summary_local_alias_valid_at(report, owner, local_name, binding_position, call, report.trace_owner_line)

        def proof_replay_summary_local_alias_valid_with_work(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr, source_work: mutable usize&) -> bool:
            return proof_replay_summary_local_alias_valid_at_with_work(report, owner, local_name, binding_position, call, report.trace_owner_line, source_work)
