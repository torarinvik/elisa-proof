# Source sites for call summaries restated over a local (`result` bound to the local that holds
# the call's value). The producer emits these at the local's binding statement, and also over a
# local read by a `return`. Replay accepts one only when the source shows that, at the consuming
# certificate, the local still holds exactly that call's result:
#   - the alias names the exact declaration or assignment statement whose value is the call, or
#     a `return` whose reaching definition of the local is that call on every path;
#   - nothing may write the local between that binding and the consumer, including a loop or
#     branch that starts before the consumer, an explicit or implicit lend, or a rebinding;
#   - a binding nested in a branch or loop body only reaches consumers inside that body.
const module ProofReplayLocalAlias:
    ABSENT: usize = 0
    VALID: usize = 1
    INVALID: usize = 2
    DEPTH_LIMIT: usize = 96

extend ElisaProof:
    private:
        def proof_replay_statement_position(statement: Ast::Stmt) -> Ast::Pos:
            match statement:
                Ast::Stmt.Expr(_, position) | Ast::Stmt.Block(_, _, _, _, position) | Ast::Stmt.VarDecl(_, _, _, position) | Ast::Stmt.Assign(_, _, _, position):
                    return position
                Ast::Stmt.If(_, _, _, position) | Ast::Stmt.While(_, _, position) | Ast::Stmt.For(_, _, _, _, position) | Ast::Stmt.Return(_, position):
                    return position
                Ast::Stmt.Break(_, position) | Ast::Stmt.Continue(_, position) | Ast::Stmt.Match(_, _, position) | Ast::Stmt.Contract(_, _, position):
                    return position
                _:
                    return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}

        # The last source line any statement of `body` occupies, nested bodies included. Lines
        # of multi-line expressions are covered by the statement's recorded end line.
        def proof_replay_body_last_line(body: darray[Ast::Stmt]&, depth: usize) -> u32:
            return 4294967295 if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            last: mutable u32 = 0
            for statement in body |last, depth|:
                position: Ast::Pos = proof_replay_statement_position(statement)
                last <- position.line if position.line > last
                last <- position.end_line if position.end_line > last
                nested: mutable u32 = 0
                match statement:
                    Ast::Stmt.If(_, yes, no, _):
                        nested <- proof_replay_body_last_line(yes, depth + 1)
                        no_last: u32 = proof_replay_body_last_line(no, depth + 1)
                        nested <- no_last if no_last > nested
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _) | Ast::Stmt.Block(_, _, _, inner, _):
                        nested <- proof_replay_body_last_line(inner, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |nested, depth|:
                            arm_last: u32 = proof_replay_body_last_line(arm.body, depth + 1)
                            nested <- arm_last if arm_last > nested
                    Ast::Stmt.Expr(Ast::Expr.Block(inner, _, _, _), _):
                        nested <- proof_replay_body_last_line(inner, depth + 1)
                    _:
                        pass
                last <- nested if nested > last
            return last

        def proof_replay_local_alias_call_value(value: Ast::Expr, expected_call: Ast::Expr) -> bool:
            match value:
                Ast::Expr.Call(_, _, _, _):
                    return proof_replay_call_source_position_equal(value, expected_call)
                Ast::Expr.Paren(inner, _):
                    match inner:
                        Ast::Expr.Call(_, _, _, _):
                            return proof_replay_call_source_position_equal(inner, expected_call)
                        _:
                            return false
                _:
                    return false

        # The local's binding statement at `index` reaches `consumer_line` unchanged.
        def proof_replay_local_alias_live(report: ProofReport&, body: darray[Ast::Stmt]&, index: usize, local_name: sview, consumer_line: u32, nested: bool) -> bool:
            return false if index >= body.count or consumer_line == 0
            binding_line: u32 = proof_replay_statement_position(body[index]).line
            return false if consumer_line < binding_line
            return false if nested and consumer_line > proof_replay_body_last_line(body, 0)
            first_later: usize = index + 1
            for later in first_later..<body.count |later, body, report, local_name, consumer_line|:
                if proof_replay_statement_position(body[later]).line > consumer_line:
                    break
                return false if proof_replay_source_statement_touches(report.source_declarations, body[later], local_name, true, 0)
            return true

        def proof_replay_local_alias_nested(report: ProofReport&, body: darray[Ast::Stmt]&, local_name: sview, binding_position: Ast::Pos, expected_call: Ast::Expr, consumer_line: u32, reaching: bool, depth: usize) -> usize:
            return ProofReplayLocalAlias::INVALID if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            return proof_replay_local_alias_site(report, body, local_name, binding_position, expected_call, consumer_line, reaching, true, depth + 1)

        # Locate the alias site in `body`. `reaching` says whether, on entry to this list, the
        # local's value on every path is exactly the expected call's result.
        def proof_replay_local_alias_site(report: ProofReport&, body: darray[Ast::Stmt]&, local_name: sview, binding_position: Ast::Pos, expected_call: Ast::Expr, consumer_line: u32, reaching_on_entry: bool, nested: bool, depth: usize) -> usize:
            return ProofReplayLocalAlias::INVALID if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            reaching: mutable bool = reaching_on_entry
            for index in 0..<body.count |index, body, report, local_name, binding_position, expected_call, consumer_line, nested, depth, reaching|:
                statement: Ast::Stmt = body[index]
                position: Ast::Pos = proof_replay_statement_position(statement)
                found: mutable usize = ProofReplayLocalAlias::ABSENT
                written_value: mutable Ast::Expr = Ast::Expr.Absent
                direct_write: mutable bool = false
                match statement:
                    Ast::Stmt.VarDecl(name, _, initializer, _):
                        if name == local_name:
                            direct_write <- true
                            written_value <- initializer
                        match initializer:
                            Ast::Expr.Block(inner, yielded, _, _):
                                # Include the final expression in the lexical lifetime and
                                # mutation check. A block-local result cannot escape this list.
                                scoped: mutable darray[Ast::Stmt] = []
                                for child in inner |scoped|:
                                    scoped.push(child)
                                scoped.push(Ast::Stmt.Expr(yielded, Ast::expr_pos(yielded)))
                                found <- proof_replay_local_alias_nested(report, &scoped, local_name, binding_position, expected_call, consumer_line, false, depth)
                            _:
                                pass
                    Ast::Stmt.Assign(Ast::Expr.Ident(name, _), operator, value, _):
                        if name == local_name and (operator == TokenKind.Assign or operator == TokenKind.LArrow):
                            direct_write <- true
                            written_value <- value
                    Ast::Stmt.Return(value, _):
                        if position.line == binding_position.line:
                            if value is returned:
                                if proof_replay_source_local_use(returned, local_name, binding_position, 0):
                                    found <- ProofReplayLocalAlias::VALID if reaching and consumer_line == position.line and not proof_replay_source_expr_touches(report.source_declarations, returned, local_name, true, 0) else ProofReplayLocalAlias::INVALID
                    Ast::Stmt.If(condition, yes, no, _):
                        branch_reaching: bool = reaching and not proof_replay_source_expr_touches(report.source_declarations, condition, local_name, true, 0)
                        found <- proof_replay_local_alias_nested(report, yes, local_name, binding_position, expected_call, consumer_line, branch_reaching, depth)
                        found <- proof_replay_local_alias_nested(report, no, local_name, binding_position, expected_call, consumer_line, branch_reaching, depth) if found == ProofReplayLocalAlias::ABSENT
                    Ast::Stmt.Match(subject, arms, _):
                        subject_reaching: bool = reaching and not proof_replay_source_expr_touches(report.source_declarations, subject, local_name, true, 0)
                        for arm in arms |found, report, local_name, binding_position, expected_call, consumer_line, subject_reaching, depth|:
                            continue if found != ProofReplayLocalAlias::ABSENT
                            arm_reaching: bool = subject_reaching and not proof_replay_source_pattern_binds(arm.pattern, local_name, 0)
                            found <- proof_replay_local_alias_nested(report, arm.body, local_name, binding_position, expected_call, consumer_line, arm_reaching, depth)
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        # A later iteration re-enters the body with whatever the body last wrote.
                        loop_reaching: bool = reaching and not proof_replay_source_statement_touches(report.source_declarations, statement, local_name, true, 0)
                        found <- proof_replay_local_alias_nested(report, inner, local_name, binding_position, expected_call, consumer_line, loop_reaching, depth)
                    Ast::Stmt.Expr(Ast::Expr.Block(inner, _, _, _), _):
                        # The parser's captured-loop wrapper; treated as a loop for the same reason.
                        block_reaching: bool = reaching and not proof_replay_source_statement_touches(report.source_declarations, statement, local_name, true, 0)
                        found <- proof_replay_local_alias_nested(report, inner, local_name, binding_position, expected_call, consumer_line, block_reaching, depth)
                    Ast::Stmt.Block(_, _, binding, inner, _):
                        found <- proof_replay_local_alias_nested(report, inner, local_name, binding_position, expected_call, consumer_line, reaching and binding != local_name, depth)
                    _:
                        pass
                if direct_write and proof_replay_source_position_equal(position, binding_position):
                    return ProofReplayLocalAlias::INVALID if not proof_replay_local_alias_call_value(written_value, expected_call)
                    return ProofReplayLocalAlias::VALID if proof_replay_local_alias_live(report, body, index, local_name, consumer_line, nested)
                    return ProofReplayLocalAlias::INVALID
                return found if found != ProofReplayLocalAlias::ABSENT
                if direct_write:
                    reaching <- proof_replay_local_alias_call_value(written_value, expected_call) and not proof_replay_source_expr_touches(report.source_declarations, written_value, local_name, true, 0)
                elif proof_replay_source_statement_touches(report.source_declarations, statement, local_name, true, 0):
                    reaching <- false
            return ProofReplayLocalAlias::ABSENT

        # The alias must resolve in the unique owner function and be live at the certificate
        # that consumes it (`report.trace_owner_line`).
        def proof_replay_summary_local_alias_valid(report: ProofReport&, owner: sview, local_name: sview, binding_position: Ast::Pos, call: Ast::Expr) -> bool:
            return false if local_name == "" or report.trace_owner_line == 0
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body(report, owner, report.replay_owner_line, &body)
            return proof_replay_local_alias_site(report, body, local_name, binding_position, call, report.trace_owner_line, false, false, 0) == ProofReplayLocalAlias::VALID
