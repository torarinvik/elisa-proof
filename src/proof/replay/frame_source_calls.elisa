extend ElisaProofFrameSource:
    private:
        def call_name_is_lemma(annotations: darray[Ast::EnumAnnotation]&, name: sview, work: mutable usize&) -> (complete: bool, lemma: bool):
            for annotation in annotations |annotation, name, work|:
                return (false, false) if:
                    not replay_work_charge(1, work)
                    not replay_work_charge(sview_len(annotation.owner), work)
                if annotation.owner == "__lemma":
                    return (false, false) if not replay_work_charge(sview_len(annotation.name), work)
                    return (true, true) if annotation.name == name
            return (true, false)

        def call_expression_at(expression: Ast::Expr, position: Ast::Pos, depth: usize, work: mutable usize&, matches: mutable usize&, found: mutable Ast::Expr&) -> bool:
            return false if depth >= 64 or not replay_work_charge(1, work)
            match expression:
                Ast::Expr.Call(callee, arguments, _, actual):
                    if same_position(actual, position):
                        return false if matches != 0
                        matches <- matches + 1
                        found <- expression
                    return false if not call_expression_at(callee, position, depth + 1, work, matches, found)
                    for argument in arguments |position, depth, work, matches, found|:
                        return false if not call_expression_at(argument, position, depth + 1, work, matches, found)
                Ast::Expr.Binary(left, TokenKind.And, right, _) | Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return false if:
                        not call_expression_at(left, position, depth + 1, work, matches, found)
                        not call_expression_at(right, position, depth + 1, work, matches, found)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not call_expression_at(left, position, depth + 1, work, matches, found) or not call_expression_at(right, position, depth + 1, work, matches, found)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return false if:
                        not call_expression_at(condition, position, depth + 1, work, matches, found)
                        not call_expression_at(then_expression, position, depth + 1, work, matches, found)
                        not call_expression_at(else_expression, position, depth + 1, work, matches, found)
                Ast::Expr.Unary(_, inner, _) | Ast::Expr.Paren(inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return false if not call_expression_at(inner, position, depth + 1, work, matches, found)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not call_expression_at(object, position, depth + 1, work, matches, found) or not call_expression_at(low, position, depth + 1, work, matches, found)
                    return false if not call_expression_at(high, position, depth + 1, work, matches, found)
                Ast::Expr.IndexN(object, elements, _):
                    return false if not call_expression_at(object, position, depth + 1, work, matches, found)
                    for element in elements |position, depth, work, matches, found|:
                        return false if not call_expression_at(element, position, depth + 1, work, matches, found)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |position, depth, work, matches, found|:
                        return false if not call_expression_at(element, position, depth + 1, work, matches, found)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |position, depth, work, matches, found|:
                        return false if not replay_work_charge(1, work) or not call_expression_at(entry.key, position, depth + 1, work, matches, found) or not call_expression_at(entry.value, position, depth + 1, work, matches, found)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not call_expression_at(base, position, depth + 1, work, matches, found)
                    for field in fields |position, depth, work, matches, found|:
                        return false if not replay_work_charge(1, work) or not call_expression_at(field.value, position, depth + 1, work, matches, found)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return false if not call_expression_at(iterable, position, depth + 1, work, matches, found) or not call_expression_at(condition, position, depth + 1, work, matches, found)
                    return false if not call_expression_at(value, position, depth + 1, work, matches, found)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not call_expression_at(base, position, depth + 1, work, matches, found) or not call_expression_at(predicate, position, depth + 1, work, matches, found)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return false if not call_expression_at(subject, position, depth + 1, work, matches, found)
                    for arm in arms |position, depth, work, matches, found|:
                        return false if not replay_work_charge(1, work) or not call_expression_at(arm.guard, position, depth + 1, work, matches, found) or not call_statements_at(&arm.body, position, depth + 1, work, matches, found)
                Ast::Expr.GetElse(value, recovery, _):
                    return false if not call_expression_at(value, position, depth + 1, work, matches, found) or not call_statements_at(&recovery, position, depth + 1, work, matches, found)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |position, depth, work, matches, found|:
                        return false if not replay_work_charge(1, work)
                        for capture in candidate.captures |position, depth, work, matches, found|:
                            return false if not call_expression_at(capture, position, depth + 1, work, matches, found)
                    for argument in arguments |position, depth, work, matches, found|:
                        return false if not call_expression_at(argument, position, depth + 1, work, matches, found)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not call_statements_at(&statements, position, depth + 1, work, matches, found) or not call_expression_at(value, position, depth + 1, work, matches, found)
                Ast::Expr.Lambda(_, statements, _):
                    return false if not call_statements_at(&statements, position, depth + 1, work, matches, found)
                Ast::Expr.Ident(_, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Absent | Ast::Expr.ShorthandMember(_, _):
                    pass
                _:
                    return false
            return true

        def call_statements_at(body: darray[Ast::Stmt]&, position: Ast::Pos, depth: usize, work: mutable usize&, matches: mutable usize&, found: mutable Ast::Expr&) -> bool:
            return false if:
                depth >= 64
                not replay_work_charge(body.count, work)
            for statement in body |position, depth, work, matches, found|:
                match statement:
                    Ast::Stmt.Contract(_, expression, _):
                        return false if not call_expression_at(expression, position, depth + 1, work, matches, found)
                    Ast::Stmt.Expr(expression, _):
                        return false if not call_expression_at(expression, position, depth + 1, work, matches, found)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if not call_expression_at(target, position, depth + 1, work, matches, found) or not call_expression_at(value, position, depth + 1, work, matches, found)
                    Ast::Stmt.VarDecl(_, _, value, _):
                        return false if not call_expression_at(value, position, depth + 1, work, matches, found)
                    Ast::Stmt.Return(value, _):
                        if value is expression:
                            return false if not call_expression_at(expression, position, depth + 1, work, matches, found)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return false if:
                            not call_expression_at(condition, position, depth + 1, work, matches, found)
                            not call_statements_at(&then_body, position, depth + 1, work, matches, found) or not call_statements_at(&else_body, position, depth + 1, work, matches, found)
                    Ast::Stmt.While(condition, nested, _) | Ast::Stmt.For(_, _, condition, nested, _):
                        return false if not call_expression_at(condition, position, depth + 1, work, matches, found) or not call_statements_at(&nested, position, depth + 1, work, matches, found)
                    Ast::Stmt.Match(subject, arms, _):
                        return false if not call_expression_at(subject, position, depth + 1, work, matches, found)
                        for arm in arms |position, depth, work, matches, found|:
                            return false if not replay_work_charge(1, work) or not call_expression_at(arm.guard, position, depth + 1, work, matches, found) or not call_statements_at(&arm.body, position, depth + 1, work, matches, found)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not call_statements_at(&nested, position, depth + 1, work, matches, found)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        # Local callable aliases/binders and unsupported scopes
                        # require their own independent resolution.
                        return false
            return true

        # Canonical module traversal must agree with the resolved callee path: a fully
        # qualified declaration replaces the current prefix, while a bare module is relative.
        def call_module_scope_with_work(current: darray[sview]&, module_name: sview, work: mutable usize&) -> (complete: bool, scope: darray[sview]):
            module_length: usize = sview_len(module_name)
            if module_length > FRAME_SOURCE_REPLAY_WORK_LIMIT / 3:
                work <- FRAME_SOURCE_REPLAY_WORK_LIMIT + 1
                return (false, [])
            return (false, []) if not replay_work_charge(module_length * 3, work)
            segments: mutable darray[sview] = []
            segment_start: mutable usize = 0
            qualified: mutable bool = false
            for cursor in 0..<module_length |cursor, module_name, segments, segment_start, qualified, work|:
                if module_name[cursor] == 58 and cursor + 1 < module_length and module_name[cursor + 1] == 58:
                    segments.push(string_view_prefix(string_view_suffix(module_name, segment_start.i64()), (cursor - segment_start).i64()))
                    segment_start <- cursor + 2
                    qualified <- true
            if segment_start < module_length:
                segments.push(string_view_suffix(module_name, segment_start.i64()))
            return (true, segments) if qualified
            return (false, []) if not replay_work_charge(current.count, work)
            normalized: mutable darray[sview] = []
            normalized.extend(current)
            normalized.extend(segments)
            (true, normalized)

        def call_find_caller_module(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: u32, exact_owner: bool, depth: usize, work: mutable usize&, current_path: mutable darray[sview]&, found_path: mutable darray[sview]&, matches: mutable usize&) -> bool:
            return false if depth >= 64 or not replay_work_charge(declarations.count, work)
            for declaration in declarations |owner, owner_line, owner_offset, exact_owner, depth, work, current_path, found_path, matches|:
                return false if not replay_work_charge(1, work)
                match declaration:
                    Ast::Decl.Func(candidate, _, _, _, _, _, position):
                        return false if not replay_work_charge(sview_len(candidate), work)
                        if candidate == owner and position.line == owner_line and (not exact_owner or position.offset == owner_offset):
                            matches <- matches + 1
                            return false if:
                                matches > 1
                                not replay_work_charge(current_path.count, work)
                            for module_name in current_path |module_name, work|:
                                return false if not replay_work_charge(sview_len(module_name), work)
                            found_path.extend(current_path)
                    Ast::Decl.Module(module_name, nested, _):
                        nested_path: (complete: bool, scope: darray[sview]) = call_module_scope_with_work(current_path, module_name, work)
                        return false if not nested_path.complete or not call_find_caller_module(nested, owner, owner_line, owner_offset, exact_owner, depth + 1, work, nested_path.scope, found_path, matches)
                    Ast::Decl.Scoped(nested, _):
                        return false if not call_find_caller_module(nested, owner, owner_line, owner_offset, exact_owner, depth + 1, work, current_path, found_path, matches)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

        def call_owner_line(declarations: darray[Ast::Decl]&, name: sview, lemma_name: bool, caller_path: darray[sview]&, depth: usize, work: mutable usize&, current_path: mutable darray[sview]&, best_depth: mutable usize&, best_matches: mutable usize&, best_line: mutable u32&, best_offset: mutable u32&, best_path: mutable darray[sview]&, relevant_import: mutable bool&) -> bool:
            return false if:
                depth >= 64
                not replay_work_charge(declarations.count, work)
            for declaration in declarations |name, lemma_name, caller_path, depth, work, current_path, best_depth, best_matches, best_line, best_offset, best_path, relevant_import|:
                return false if not replay_work_charge(1, work)
                match declaration:
                    Ast::Decl.Func(candidate, _, _, _, _, _, position):
                        return false if not replay_work_charge(sview_len(candidate), work)
                        if candidate == name:
                            continue if lemma_name
                            return false if not replay_work_charge(current_path.count, work)
                            prefix_matches: bool = current_path.count <= caller_path.count
                            if prefix_matches:
                                for index in 0..<current_path.count |index, current_path, caller_path, work, prefix_matches|:
                                    return false if:
                                        not replay_work_charge(sview_len(current_path[index]), work)
                                        not replay_work_charge(sview_len(caller_path[index]), work)
                                    prefix_matches <- false if current_path[index] != caller_path[index]
                            if prefix_matches:
                                candidate_depth: usize = current_path.count
                                if candidate_depth > best_depth:
                                    best_depth <- candidate_depth
                                    best_matches <- 1
                                    best_line <- position.line
                                    best_offset <- position.offset
                                    best_path.clear()
                                    return false if not replay_work_charge(current_path.count, work)
                                    for module_name in current_path |module_name, work|:
                                        return false if not replay_work_charge(sview_len(module_name), work)
                                    best_path.extend(current_path)
                                elif candidate_depth == best_depth:
                                    best_matches <- best_matches + 1
                                    best_line <- position.line
                                    best_offset <- position.offset
                    Ast::Decl.Module(module_name, nested, _):
                        nested_path: (complete: bool, scope: darray[sview]) = call_module_scope_with_work(current_path, module_name, work)
                        return false if not nested_path.complete or not call_owner_line(nested, name, lemma_name, caller_path, depth + 1, work, nested_path.scope, best_depth, best_matches, best_line, best_offset, best_path, relevant_import)
                    Ast::Decl.Scoped(nested, _):
                        return false if not call_owner_line(nested, name, lemma_name, caller_path, depth + 1, work, current_path, best_depth, best_matches, best_line, best_offset, best_path, relevant_import)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Import(candidate, _):
                        return false if not replay_work_charge(sview_len(candidate), work)
                        if candidate == name and current_path.count <= caller_path.count:
                            candidate_import: mutable bool = true
                            for index in 0..<current_path.count |index, current_path, caller_path, work, candidate_import|:
                                return false if:
                                    not replay_work_charge(sview_len(current_path[index]), work)
                                    not replay_work_charge(sview_len(caller_path[index]), work)
                                candidate_import <- false if current_path[index] != caller_path[index]
                            relevant_import <- true if candidate_import
                    Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

    public:
        def resolve_callee_line_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, caller_name: sview, caller_line: u32, callee_name: sview, work: mutable usize&) -> (known: bool, line: u32, module_path: darray[sview]) can[Memory.Allocate, Abort.Panic]:
            return resolve_callee_line_with_work_and_caller_policy(declarations, annotations, caller_name, caller_line, callee_name, false, work)

        # Type-only source queries may use a lemma's module scope as the caller; lemma names
        # remain excluded from callee resolution in call_owner_line.
        def resolve_callee_line_with_work_and_caller_policy(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, caller_name: sview, caller_line: u32, callee_name: sview, allow_lemma_caller: bool, work: mutable usize&) -> (known: bool, line: u32, module_path: darray[sview]) can[Memory.Allocate, Abort.Panic]:
            resolved = resolve_callee_owner_impl(declarations, annotations, caller_name, caller_line, 0, false, callee_name, allow_lemma_caller, work)
            return (resolved.known, resolved.line, resolved.module_path)

        # Frame-call reconstruction carries the caller declaration key, so module
        # precedence and callee selection remain tied to that exact source owner.
        def resolve_callee_owner_at_offset_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, caller_name: sview, caller_line: u32, caller_offset: u32, callee_name: sview, work: mutable usize&) -> (known: bool, line: u32, offset: u32, module_path: darray[sview]) can[Memory.Allocate, Abort.Panic]:
            return resolve_callee_owner_at_offset_with_caller_policy_with_work(declarations, annotations, caller_name, caller_line, caller_offset, callee_name, false, work)

        # Type-bound call-result replay can use a lemma declaration as a caller, while
        # still resolving the callee under ordinary executable-call rules.
        def resolve_callee_owner_at_offset_with_caller_policy_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, caller_name: sview, caller_line: u32, caller_offset: u32, callee_name: sview, allow_lemma_caller: bool, work: mutable usize&) -> (known: bool, line: u32, offset: u32, module_path: darray[sview]) can[Memory.Allocate, Abort.Panic]:
            return resolve_callee_owner_impl(declarations, annotations, caller_name, caller_line, caller_offset, true, callee_name, allow_lemma_caller, work)

    private:
        def resolve_callee_owner_impl(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, caller_name: sview, caller_line: u32, caller_offset: u32, exact_caller: bool, callee_name: sview, allow_lemma_caller: bool, work: mutable usize&) -> (known: bool, line: u32, offset: u32, module_path: darray[sview]) can[Memory.Allocate, Abort.Panic]:
            caller_path: mutable darray[sview] = []
            current_path: mutable darray[sview] = []
            owner_matches: mutable usize = 0
            return (false, 0, 0, []) if caller_name == "" or caller_line == 0 or callee_name == ""
            caller_is_lemma: (complete: bool, lemma: bool) = call_name_is_lemma(annotations, caller_name, work)
            return (false, 0, 0, []) if not caller_is_lemma.complete or caller_is_lemma.lemma and not allow_lemma_caller
            callee_is_lemma: (complete: bool, lemma: bool) = call_name_is_lemma(annotations, callee_name, work)
            return (false, 0, 0, []) if:
                not callee_is_lemma.complete
                not call_find_caller_module(declarations, caller_name, caller_line, caller_offset, exact_caller, 0, work, &current_path, &caller_path, &owner_matches) or owner_matches != 1
            current_path.clear()
            best_depth: mutable usize = 0
            best_matches: mutable usize = 0
            best_line: mutable u32 = 0
            best_offset: mutable u32 = 0
            best_path: mutable darray[sview] = []
            relevant_import: mutable bool = false
            return (false, 0, 0, []) if not call_owner_line(declarations, callee_name, callee_is_lemma.lemma, caller_path, 0, work, &current_path, &best_depth, &best_matches, &best_line, &best_offset, &best_path, &relevant_import)
            # The compiler resolves bare functions in the caller module, then each parent
            # module, before consulting visible imports. A globally unique peer-module name
            # is not callable without an import, and an import cannot shadow a local winner.
            return (true, best_line, best_offset, best_path) if best_matches == 1
            return (false, 0, 0, []) if best_matches > 1 or relevant_import
            return (false, 0, 0, [])

    public:
        # Resolve one exact original occurrence; no producer call/summary row is
        # consulted. Leaf targets must resolve uniquely under caller-module precedence
        # and remain unshadowed at the call site.
        def source_call(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, position: Ast::Pos) -> (known: bool, expression: Ast::Expr, callee: sview, callee_line: u32) can[Memory.Allocate, Abort.Panic]:
            work: mutable usize = 0
            return source_call_with_work(declarations, annotations, name, line, position, &work)

        def source_call_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, position: Ast::Pos, work: mutable usize&) -> (known: bool, expression: Ast::Expr, callee: sview, callee_line: u32) can[Memory.Allocate, Abort.Panic]:
            context = owner_with_work(declarations, name, line, work)
            return (false, Ast::Expr.Invalid, "", 0) if not context.known
            exact: (known: bool, expression: Ast::Expr, callee: sview, callee_line: u32, callee_offset: u32) = source_call_in_owner_with_work(declarations, annotations, name, line, context.position.offset, &context.body, &context.formals, position, work)
            return (exact.known, exact.expression, exact.callee, exact.callee_line)

        # Callers that need to inspect the resolved declaration must retain its offset.
        # The legacy wrapper above remains name-and-line-only and fails closed on ambiguity.
        def source_call_with_offset_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, position: Ast::Pos, work: mutable usize&) -> (known: bool, expression: Ast::Expr, callee: sview, callee_line: u32, callee_offset: u32) can[Memory.Allocate, Abort.Panic]:
            context = owner_with_work(declarations, name, line, work)
            return (false, Ast::Expr.Invalid, "", 0, 0) if not context.known
            source_call_in_owner_with_work(declarations, annotations, name, line, context.position.offset, &context.body, &context.formals, position, work)

        def source_call_at_owner_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, position: Ast::Pos, work: mutable usize&) -> (known: bool, expression: Ast::Expr, callee: sview, callee_line: u32, callee_offset: u32) can[Memory.Allocate, Abort.Panic]:
            context = owner_at_offset_with_work(declarations, name, line, owner_offset, work)
            return (false, Ast::Expr.Invalid, "", 0, 0) if not context.known
            source_call_in_owner_with_work(declarations, annotations, name, line, context.position.offset, &context.body, &context.formals, position, work)

        # Resource-call replay can resolve a qualified callee from the exact call expression
        # using its report-scoped module-alias index. Keep the older leaf-only API fail-closed.
        def source_call_expression_at_owner_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, position: Ast::Pos, work: mutable usize&) -> (known: bool, expression: Ast::Expr, callee: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            context = owner_at_offset_with_work(declarations, name, line, owner_offset, work)
            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not context.known
            matches: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not call_statements_at(&context.body, position, 0, work, &matches, &found) or matches != 1
            match found:
                Ast::Expr.Call(callee, _, _, _):
                    match callee:
                        Ast::Expr.Ident(callee_name, _):
                            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not replay_work_charge(context.formals.count, work)
                            for formal in context.formals |formal, callee_name, work|:
                                return (false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not replay_work_charge(sview_len(formal), work)
                                return (false, Ast::Expr.Invalid, Ast::Expr.Invalid) if formal == callee_name
                            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not ElisaProof::source_call_locals_unshadowed_at_with_work(context.body, annotations, found, work)
                            (true, found, callee)
                        Ast::Expr.Scope(_, _, _):
                            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid) if not replay_work_charge(sview_len(proof_callable_name(callee)), work)
                            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid) if proof_callable_name(callee) == ""
                            (true, found, callee)
                        _:
                            (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                _:
                    (false, Ast::Expr.Invalid, Ast::Expr.Invalid)

        def source_call_in_owner_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, body: darray[Ast::Stmt]&, formals: darray[sview]&, position: Ast::Pos, work: mutable usize&) -> (known: bool, expression: Ast::Expr, callee: sview, callee_line: u32, callee_offset: u32) can[Memory.Allocate, Abort.Panic]:
            matches: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            return (false, Ast::Expr.Invalid, "", 0, 0) if not call_statements_at(body, position, 0, work, &matches, &found) or matches != 1
            match found:
                Ast::Expr.Call(Ast::Expr.Ident(callee, _), _, _, _):
                    return (false, Ast::Expr.Invalid, "", 0, 0) if not replay_work_charge(formals.count, work)
                    for formal in formals |callee, work|:
                        return (false, Ast::Expr.Invalid, "", 0, 0) if:
                            not replay_work_charge(sview_len(formal), work)
                            formal == callee
                    return (false, Ast::Expr.Invalid, "", 0, 0) if not ElisaProof::source_call_locals_unshadowed_at_with_work(body, annotations, found, work)
                    resolved = resolve_callee_owner_at_offset_with_work(declarations, annotations, name, line, owner_offset, callee, work)
                    return (false, Ast::Expr.Invalid, "", 0, 0) if not resolved.known
                    selected_owner = owner_at_offset_with_work(declarations, callee, resolved.line, resolved.offset, work)
                    return (false, Ast::Expr.Invalid, "", 0, 0) if not selected_owner.known
                    return (true, found, callee, resolved.line, resolved.offset)
                _:
                    return (false, Ast::Expr.Invalid, "", 0, 0)
