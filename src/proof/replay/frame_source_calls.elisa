extend ElisaProofFrameSource:
    private:
        def call_expression_at(expression: Ast::Expr, position: Ast::Pos, depth: usize, work: mutable usize&, matches: mutable usize&, found: mutable Ast::Expr&) -> bool:
            return false if depth >= 64 or work >= 4096
            work <- work + 1
            match expression:
                Ast::Expr.Call(callee, arguments, _, actual):
                    if same_position(actual, position):
                        return false if matches != 0
                        matches <- matches + 1
                        found <- expression
                    return false if not call_expression_at(callee, position, depth + 1, work, matches, found)
                    for argument in arguments |position, depth, work, matches, found|:
                        return false if not call_expression_at(argument, position, depth + 1, work, matches, found)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not call_expression_at(left, position, depth + 1, work, matches, found) or not call_expression_at(right, position, depth + 1, work, matches, found)
                Ast::Expr.Unary(_, inner, _) | Ast::Expr.Paren(inner, _) | Ast::Expr.Field(inner, _, _):
                    return false if not call_expression_at(inner, position, depth + 1, work, matches, found)
                Ast::Expr.Ident(_, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _):
                    pass
                _:
                    return false
            return true

        def call_statements_at(body: darray[Ast::Stmt]&, position: Ast::Pos, depth: usize, work: mutable usize&, matches: mutable usize&, found: mutable Ast::Expr&) -> bool:
            return false if depth >= 64
            for statement in body |position, depth, work, matches, found|:
                return false if work >= 4096
                work <- work + 1
                match statement:
                    Ast::Stmt.Contract(_, expression, _):
                        return false if not call_expression_at(expression, position, depth + 1, work, matches, found)
                    Ast::Stmt.Assign(target, operator, value, _):
                        return false if operator == TokenKind.Assign
                        return false if not call_expression_at(target, position, depth + 1, work, matches, found) or not call_expression_at(value, position, depth + 1, work, matches, found)
                    Ast::Stmt.VarDecl(_, declared_type, value, _):
                        return false if not contract_scalar_type(declared_type) or not call_expression_at(value, position, depth + 1, work, matches, found)
                    Ast::Stmt.Return(value, _):
                        if value is expression:
                            return false if not call_expression_at(expression, position, depth + 1, work, matches, found)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return false if not call_expression_at(condition, position, depth + 1, work, matches, found)
                        return false if not call_statements_at(&then_body, position, depth + 1, work, matches, found) or not call_statements_at(&else_body, position, depth + 1, work, matches, found)
                    _:
                        # Local callable aliases/binders and unsupported scopes
                        # require their own independent resolution.
                        return false
            return true

        def call_owner_line(declarations: darray[Ast::Decl]&, name: sview, depth: usize, work: mutable usize&, matches: mutable usize&, line: mutable u32&) -> bool:
            return false if depth >= 64
            for declaration in declarations |name, depth, work, matches, line|:
                return false if work >= 4096
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(candidate, _, _, _, _, _, position):
                        if candidate == name:
                            return false if matches != 0
                            matches <- matches + 1
                            line <- position.line
                    Ast::Decl.Const(candidate, _, _, _, _) | Ast::Decl.Alias(candidate, _, _):
                        return false if candidate == name
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not call_owner_line(&nested, name, depth + 1, work, matches, line)
                    _:
                        pass
            return true

    public:
        # Resolve one exact original occurrence; no producer call/summary row is
        # consulted. Leaf targets must be globally unique and unshadowed.
        def source_call(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos) -> (known: bool, expression: Ast::Expr, callee: sview, callee_line: u32) can[Memory.Allocate, Abort.Panic]:
            context = owner(declarations, name, line)
            return (false, Ast::Expr.Invalid, "", 0) if not context.known
            work: mutable usize = 0
            matches: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            return (false, Ast::Expr.Invalid, "", 0) if not call_statements_at(&context.body, position, 0, &work, &matches, &found) or matches != 1
            match found:
                Ast::Expr.Call(Ast::Expr.Ident(callee, _), _, _, _):
                    for formal in context.formals |callee|:
                        return (false, Ast::Expr.Invalid, "", 0) if formal == callee
                    for statement in context.body |callee|:
                        match statement:
                            Ast::Stmt.VarDecl(binding, _, _, _):
                                return (false, Ast::Expr.Invalid, "", 0) if binding == callee
                            _:
                                pass
                    work <- 0
                    matches <- 0
                    callee_line: mutable u32 = 0
                    return (false, Ast::Expr.Invalid, "", 0) if not call_owner_line(declarations, callee, 0, &work, &matches, &callee_line) or matches != 1
                    return (true, found, callee, callee_line)
                _:
                    return (false, Ast::Expr.Invalid, "", 0)
