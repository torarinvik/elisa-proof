extend ElisaProof:
    private:
        def proof_replay_structural_text_compare(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work <- work + 1
            return false if sview_len(left) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + sview_len(left)
            return false if sview_len(right) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + sview_len(right)
            return true

        def proof_replay_structural_work_charge(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + amount
            return true

        def proof_replay_structural_import_annotation_unresolved(annotation: Ast::EnumAnnotation, source_work: mutable usize&) -> (complete: bool, unresolved: bool):
            return (false, false) if not proof_replay_structural_text_compare(annotation.name, "__using", source_work)
            return (true, true) if annotation.name == "__using"
            return (false, false) if not proof_replay_structural_text_compare(annotation.name, "__using_alias", source_work)
            return (true, true) if annotation.name == "__using_alias"
            return (false, false) if not proof_replay_structural_text_compare(annotation.name, "__using_alias_target", source_work)
            return (true, true) if annotation.name == "__using_alias_target"
            return (false, false) if not proof_replay_structural_text_compare(annotation.name, "__using_member", source_work)
            return (true, true) if annotation.name == "__using_member"
            return (false, false) if not proof_replay_structural_text_compare(annotation.name, "__binding_wildcard_import", source_work)
            return (true, true) if annotation.name == "__binding_wildcard_import"
            return (false, false) if not proof_replay_structural_text_compare(annotation.name, "__from_decl", source_work)
            return (true, true) if annotation.name == "__from_decl"
            return (false, false) if not proof_replay_structural_text_compare(annotation.owner, "__from_member", source_work)
            return (true, true) if annotation.owner == "__from_member"
            return (false, false) if not proof_replay_structural_text_compare(annotation.owner, "__from_src", source_work)
            return (true, true) if annotation.owner == "__from_src"
            (true, false)
