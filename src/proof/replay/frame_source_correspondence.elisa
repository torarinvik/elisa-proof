extend ElisaProofFrameSource:
    private:
        def same_place(left: ElisaProofKernelFramePolicy::Place, right: ElisaProofKernelFramePolicy::Place) -> bool:
            return left.parameter == right.parameter and left.depth == right.depth and left.field == right.field and left.field2 == right.field2 and left.field3 == right.field3

    public:
        # Checks the complete body policy against the two ordered arena lists.
        # This does not establish that a write belongs to the source body, nor
        # account for signature clauses. Those are separate admission obligations.
        def body_lists_match(declarations: darray[Ast::Decl]&, name: sview, line: u32, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if root >= nodes.count
            node = nodes[root]
            return false if not ElisaProofKernelFramePolicy::arena_shape(node)
            return false if node.kind != "frame-policy" or node.operator != "write" or node.name != name or node.secondary_name != "frame-policy-v1"
            return false if node.right > node.children_count or node.children_start > children.count or node.children_count > children.count - node.children_start
            policy = body_policy(declarations, name, line)
            return false if not policy.known or node.auxiliary != policy.parameter_count or node.children_count != policy.clauses.count
            changes: mutable usize = 0
            preserves: mutable usize = node.right
            for clause in policy.clauses |changes, preserves, node, nodes, children|:
                index: usize = changes if clause.kind == "changes" else preserves
                return false if index >= node.children_count or (clause.kind == "changes" and index >= node.right)
                place_root: usize = children[node.children_start + index]
                return false if place_root >= root
                decoded = ElisaProofKernelFramePolicy::decode_place(nodes, children, place_root, node.auxiliary)
                return false if not decoded.known or not same_place(clause.place, decoded.place)
                if clause.kind == "changes":
                    changes <- changes + 1
                else:
                    preserves <- preserves + 1
            return changes == node.right and preserves == node.children_count
