extend ElisaProofFrameSource:
    private:
        def preserve_lists_match(name: sview, parameter_count: usize, clauses: darray[Clause]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> bool:
            work: mutable usize = 0
            return preserve_lists_match_with_work(name, parameter_count, clauses, nodes, children, root, &work)

        def preserve_lists_match_with_work(name: sview, parameter_count: usize, clauses: darray[Clause]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work: mutable usize&) -> bool:
            return false if root >= nodes.count
            node = nodes[root]
            return false if:
                not replay_work_charge(sview_len(name), work)
                not replay_work_charge(sview_len(node.name), work)
                not ElisaProofKernelFramePolicy::arena_shape(node) or node.kind != "frame-policy" or node.operator != "preserve" or node.name != name or node.auxiliary != parameter_count
                node.children_start > children.count or node.children_count > children.count - node.children_start
                not replay_work_charge(clauses.count, work)
            index: mutable usize = 0
            for clause in clauses |index, node, nodes, children, root, work|:
                return false if not replay_work_charge(sview_len(clause.kind), work)
                if clause.kind == "preserves":
                    return false if index >= node.children_count
                    place_root: usize = children[node.children_start + index]
                    return false if place_root >= root
                    decoded = ElisaProofKernelFramePolicy::decode_place(nodes, children, place_root, node.auxiliary)
                    return false if:
                        not decoded.known
                        not replay_work_charge(sview_len(clause.place.field), work)
                        not replay_work_charge(sview_len(decoded.place.field), work)
                        not replay_work_charge(sview_len(clause.place.field2), work)
                        not replay_work_charge(sview_len(decoded.place.field2), work)
                        not replay_work_charge(sview_len(clause.place.field3), work)
                        not replay_work_charge(sview_len(decoded.place.field3), work)
                        not same_place(clause.place, decoded.place)
                    index <- index + 1
            return index == node.children_count

        def same_place(left: ElisaProofKernelFramePolicy::Place, right: ElisaProofKernelFramePolicy::Place) -> bool:
            return left.parameter == right.parameter and left.depth == right.depth and left.field == right.field and left.field2 == right.field2 and left.field3 == right.field3

        def lists_match(name: sview, parameter_count: usize, clauses: darray[Clause]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            work: mutable usize = 0
            return lists_match_with_work(name, parameter_count, clauses, nodes, children, root, &work)

        def lists_match_with_work(name: sview, parameter_count: usize, clauses: darray[Clause]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if root >= nodes.count
            node = nodes[root]
            return false if:
                not ElisaProofKernelFramePolicy::arena_shape(node)
                not replay_work_charge(sview_len(name), work)
                not replay_work_charge(sview_len(node.name), work)
                not replay_work_charge(sview_len(node.secondary_name), work)
                node.kind != "frame-policy" or (node.operator != "write" and node.operator != "allow") or node.name != name or node.secondary_name != "frame-policy-v1"
                node.right > node.children_count or node.children_start > children.count or node.children_count > children.count - node.children_start
                node.auxiliary != parameter_count or node.children_count != clauses.count
                not replay_work_charge(clauses.count, work)
            changes: mutable usize = 0
            preserves: mutable usize = node.right
            for clause in clauses |changes, preserves, node, nodes, children, work|:
                return false if not replay_work_charge(sview_len(clause.kind), work)
                index: usize = changes if clause.kind == "changes" else preserves
                return false if index >= node.children_count or (clause.kind == "changes" and index >= node.right)
                place_root: usize = children[node.children_start + index]
                return false if place_root >= root
                decoded = ElisaProofKernelFramePolicy::decode_place(nodes, children, place_root, node.auxiliary)
                return false if:
                    not decoded.known
                    not replay_work_charge(sview_len(clause.place.field), work)
                    not replay_work_charge(sview_len(decoded.place.field), work)
                    not replay_work_charge(sview_len(clause.place.field2), work)
                    not replay_work_charge(sview_len(decoded.place.field2), work)
                    not replay_work_charge(sview_len(clause.place.field3), work)
                    not replay_work_charge(sview_len(decoded.place.field3), work)
                    not same_place(clause.place, decoded.place)
                if clause.kind == "changes":
                    changes <- changes + 1
                else:
                    preserves <- preserves + 1
            return changes == node.right and preserves == node.children_count

    public:
        # Body-only correspondence remains useful for individual body-spec checks.
        # Full write admission must account for signature clauses as well.
        def body_lists_match(declarations: darray[Ast::Decl]&, name: sview, line: u32, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            policy = body_policy(declarations, name, line)
            return policy.known and lists_match(name, policy.parameter_count, &policy.clauses, nodes, children, root)

        def source_lists_match(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            policy = source_policy(declarations, name, line, tokens, source, source_length)
            return policy.known and lists_match(name, policy.parameter_count, &policy.clauses, nodes, children, root)
