extend ElisaProof:
    private:
        # Entry preconditions are checked at the function declaration site, but a pure call
        # summary introduced while unfolding one of those preconditions must still be tied to
        # the call's actual source span. `trace.line` is the owning function's declaration line,
        # not the line of the nested call expression, so the ordinary executable-call scan
        # cannot find (for example) `is_digit(c)` in a `requires` on the following line.
        # Inspect only top-level `requires` contracts, count the exact call span, and require a
        # unique owning declaration. This admits no body-text summary: the callee's checked
        # summary, argument mapping, and dependency certificate are still validated separately.
        def proof_replay_summary_requires_call_body(body: darray[Ast::Stmt]&, call: Ast::Expr, matches: mutable usize&, work: mutable usize&, complete: mutable bool&) -> bool:
            return false if body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body.count
            for statement in body |call, matches, work, complete|:
                match statement:
                    Ast::Stmt.Contract("requires", expression, _):
                        matches <- matches + 1 if proof_replay_deterministic_call_source_contains_bounded(expression, call, work, complete, 0)
                    _:
                        pass
                return false if not proof_replay_summary_bool_ref_value(complete)
            return true

        def proof_replay_summary_requires_call_declarations(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, call: Ast::Expr, matches: mutable usize&, owners: mutable usize&, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            return false if depth >= 96 or declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + declarations.count
            for declaration in declarations |owner, owner_line, owner_offset, call, matches, owners, work, complete, depth|:
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, position):
                        if name == owner and position.line == owner_line and position.offset.usize() == owner_offset:
                            owners <- owners + 1
                            return false if not proof_replay_summary_requires_call_body(body, call, matches, work, complete)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_summary_requires_call_declarations(nested, owner, owner_line, owner_offset, call, matches, owners, work, complete, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
            return true

        def proof_replay_summary_requires_call_source_site(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&) -> bool:
            owner_line: u32 = report.analysis_2.replay_owner_line
            owner_offset: usize = report.analysis_2.replay_owner_offset
            return false if not report.analysis_2.replay_owner_offset_valid or owner_line == 0 or owner_line == 4294967295 or trace.name == "" or trace.line != owner_line
            if proof_replay_summary_signature_requires_call_source_site(report, trace, call, owner_line, work):
                return true
            matches: mutable usize = 0
            owners: mutable usize = 0
            complete: mutable bool = true
            return false if not proof_replay_summary_requires_call_declarations(report.source.source_declarations, trace.name, owner_line, owner_offset, call, &matches, &owners, work, &complete, 0)
            return owners == 1 and matches == 1

        def proof_replay_summary_signature_requires_call_source_site(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, owner_line: u32, work: mutable usize&) -> bool:
            position: Ast::Pos = trace.source_call_position
            return false if position.offset == 0 or position.end_offset <= position.offset
            owner_position: Ast::Pos = proof_replay_trace_owner_source_position_for_trace_with_work(report, trace, work)
            owner_offset: usize = report.analysis_2.replay_owner_offset
            return false if not report.analysis_2.replay_owner_offset_valid or owner_position.line != owner_line or owner_position.offset.usize() != owner_offset
            expected_call: mutable Ast::Expr = Ast::Expr.Invalid
            match call:
                Ast::Expr.Call(callee, arguments, type_arguments, call_position):
                    return false if not proof_replay_source_position_equal(call_position, position)
                    expected_call <- Ast::Expr.Call(callee, arguments, type_arguments, position)
                _:
                    return false
            rows: usize = report.source_contracts.source_signature_contract_lines.count
            return false if:
                rows != report.source_contracts.source_signature_contract_kinds.count or rows != report.source_contracts.source_signature_contracts.count
                work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or rows > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + rows
            matches: mutable usize = 0
            for index in 0..<rows |index, report, trace, owner_line, expected_call, matches, work|:
                kind: sview = report.source_contracts.source_signature_contract_kinds[index]
                return false if sview_len(kind) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(kind)
                continue if report.source_contracts.source_signature_contract_lines[index] != owner_line or kind != "requires"
                source_call: mutable Ast::Expr = Ast::Expr.Invalid
                source_calls: mutable usize = 0
                return false if:
                    not proof_replay_summary_call_exact_span_in_expr(report.source_contracts.source_signature_contracts[index], expected_call, &source_call, &source_calls, work, 0)
                    source_calls > 1
                if source_calls == 1:
                    complete: mutable bool = true
                    return false if not proof_replay_summary_call_same_source_span(report, trace, source_call, expected_call, 0, work, &complete, 0) or not complete
                    matches <- matches + 1
                    return false if matches > 1
            return matches == 1

        # A call summary stores normalized argument values: formal identifiers and checked
        # constants carry their declaration positions, while the source call carries the
        # argument-use positions. Site identity therefore uses the exact call span and callee;
        # argument count and actual slot values are checked separately by
        # proof_replay_summary_call_arguments_match before any summary is accepted.
        def proof_replay_summary_call_exact_span_in_expr(source: Ast::Expr, expected: Ast::Expr, found: mutable Ast::Expr&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work <- work + 1
            match source:
                Ast::Expr.Call(source_callee, source_arguments, _, source_position):
                    match expected:
                        Ast::Expr.Call(expected_callee, expected_arguments, _, expected_position):
                            wildcard_call: bool = match expected_callee:
                                Ast::Expr.Invalid: true
                                _: false
                            if source_position.line == expected_position.line and source_position.column == expected_position.column and source_position.offset == expected_position.offset and source_position.end_line == expected_position.end_line and source_position.end_column == expected_position.end_column and source_position.end_offset == expected_position.end_offset and (wildcard_call or source_arguments.count == expected_arguments.count):
                                callee_equal: bool = wildcard_call or proof_replay_summary_expr_equal_with_work(source_callee, expected_callee, work)
                                if callee_equal:
                                    matches <- matches + 1
                                    found <- source
                        _:
                            pass
                    return false if source_arguments.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                    work <- work + source_arguments.count
                    return false if not proof_replay_summary_call_exact_span_in_expr(source_callee, expected, found, matches, work, depth + 1)
                    for argument in source_arguments |expected, found, matches, work, depth|:
                        return false if not proof_replay_summary_call_exact_span_in_expr(argument, expected, found, matches, work, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not proof_replay_summary_call_exact_span_in_expr(left, expected, found, matches, work, depth + 1) or not proof_replay_summary_call_exact_span_in_expr(right, expected, found, matches, work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_summary_call_exact_span_in_expr(inner, expected, found, matches, work, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                    return proof_replay_summary_call_exact_span_in_expr(object, expected, found, matches, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return false if:
                        not proof_replay_summary_call_exact_span_in_expr(object, expected, found, matches, work, depth + 1)
                        not proof_replay_summary_call_exact_span_in_expr(low, expected, found, matches, work, depth + 1)
                    return proof_replay_summary_call_exact_span_in_expr(high, expected, found, matches, work, depth + 1)
                Ast::Expr.IndexN(object, elements, _):
                    return false if not proof_replay_summary_call_exact_span_in_expr(object, expected, found, matches, work, depth + 1)
                    for element in elements |expected, found, matches, work, depth|:
                        return false if not proof_replay_summary_call_exact_span_in_expr(element, expected, found, matches, work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |expected, found, matches, work, depth|:
                        return false if not proof_replay_summary_call_exact_span_in_expr(element, expected, found, matches, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |expected, found, matches, work, depth|:
                        return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        work <- work + 1
                        return false if:
                            not proof_replay_summary_call_exact_span_in_expr(entry.key, expected, found, matches, work, depth + 1)
                            not proof_replay_summary_call_exact_span_in_expr(entry.value, expected, found, matches, work, depth + 1)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_summary_call_exact_span_in_expr(base, expected, found, matches, work, depth + 1)
                    for field in fields |expected, found, matches, work, depth|:
                        return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_replay_summary_call_exact_span_in_expr(field.value, expected, found, matches, work, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return false if:
                        not proof_replay_summary_call_exact_span_in_expr(iterable, expected, found, matches, work, depth + 1)
                        not proof_replay_summary_call_exact_span_in_expr(condition, expected, found, matches, work, depth + 1)
                    return proof_replay_summary_call_exact_span_in_expr(value, expected, found, matches, work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_replay_summary_call_exact_span_in_expr(base, expected, found, matches, work, depth + 1)
                    return proof_replay_summary_call_exact_span_in_expr(predicate, expected, found, matches, work, depth + 1)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return false if not proof_replay_summary_call_exact_span_in_expr(subject, expected, found, matches, work, depth + 1)
                    for arm in arms |arm, expected, found, matches, work, depth|:
                        return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        work <- work + 1
                        return false if:
                            not proof_replay_summary_call_exact_span_in_expr(arm.guard, expected, found, matches, work, depth + 1)
                            not proof_replay_summary_call_exact_span_in_body(arm.body, expected, found, matches, work, depth + 1)
                Ast::Expr.GetElse(value, recovery, _):
                    return false if not proof_replay_summary_call_exact_span_in_expr(value, expected, found, matches, work, depth + 1)
                    return proof_replay_summary_call_exact_span_in_body(recovery, expected, found, matches, work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |expected, found, matches, work, depth|:
                        return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        work <- work + 1
                        for capture in candidate.captures |expected, found, matches, work, depth|:
                            return false if not proof_replay_summary_call_exact_span_in_expr(capture, expected, found, matches, work, depth + 1)
                    for argument in arguments |expected, found, matches, work, depth|:
                        return false if not proof_replay_summary_call_exact_span_in_expr(argument, expected, found, matches, work, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_summary_call_exact_span_in_body(statements, expected, found, matches, work, depth + 1)
                    return proof_replay_summary_call_exact_span_in_expr(value, expected, found, matches, work, depth + 1)
                Ast::Expr.Lambda(_, statements, _):
                    return proof_replay_summary_call_exact_span_in_body(statements, expected, found, matches, work, depth + 1)
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return true
                Ast::Expr.Invalid:
                    return false
                _:
                    return false
            return true

        def proof_replay_summary_call_exact_span_in_body(body: darray[Ast::Stmt]&, expected: Ast::Expr, found: mutable Ast::Expr&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body.count
            for statement in body |expected, matches, work, depth|:
                match statement:
                    Ast::Stmt.VarDecl(_, _, value, _) | Ast::Stmt.Expr(value, _) | Ast::Stmt.Return(value, _) | Ast::Stmt.Contract(_, value, _):
                        return false if not proof_replay_summary_call_exact_span_in_expr(value, expected, found, matches, work, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if:
                            not proof_replay_summary_call_exact_span_in_expr(target, expected, found, matches, work, depth + 1)
                            not proof_replay_summary_call_exact_span_in_expr(value, expected, found, matches, work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if:
                            not proof_replay_summary_call_exact_span_in_expr(condition, expected, found, matches, work, depth + 1)
                            not proof_replay_summary_call_exact_span_in_body(yes, expected, found, matches, work, depth + 1)
                            not proof_replay_summary_call_exact_span_in_body(no, expected, found, matches, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        return false if:
                            not proof_replay_summary_call_exact_span_in_expr(condition, expected, found, matches, work, depth + 1)
                            not proof_replay_summary_call_exact_span_in_body(nested, expected, found, matches, work, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        return false if:
                            not proof_replay_summary_call_exact_span_in_expr(iterable, expected, found, matches, work, depth + 1)
                            not proof_replay_summary_call_exact_span_in_body(nested, expected, found, matches, work, depth + 1)
                    Ast::Stmt.Match(value, arms, _):
                        return false if not proof_replay_summary_call_exact_span_in_expr(value, expected, found, matches, work, depth + 1)
                        for arm in arms |arm, expected, found, matches, work, depth|:
                            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            work <- work + 1
                            return false if:
                                not proof_replay_summary_call_exact_span_in_expr(arm.guard, expected, found, matches, work, depth + 1)
                                not proof_replay_summary_call_exact_span_in_body(arm.body, expected, found, matches, work, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_summary_call_exact_span_in_body(nested, expected, found, matches, work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_summary_call_exact_span_in_declarations(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, exact_owner: bool, call: Ast::Expr, found: mutable Ast::Expr&, found_owner_line: mutable u32&, matches: mutable usize&, owners: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + declarations.count
            for declaration in declarations |owner, owner_line, owner_offset, exact_owner, call, matches, owners, work, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, position):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if sview_len(owner) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(owner)
                        if name == owner and (owner_line == 0 or position.line == owner_line) and (not exact_owner or position.offset.usize() == owner_offset):
                            return false if parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + parameters.count
                            for parameter in parameters |work|:
                                return false if sview_len(parameter.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                                work <- work + sview_len(parameter.name)
                            # The later parameter-shadow and local-shadow predicates compare
                            # source names. Reserve the complete body walk, including identifier
                            # and binding-name bytes, before those legacy passes run.
                            body_cost: mutable usize = 0
                            return false if:
                                not proof_replay_summary_expr_cost_body(body, &body_cost, work, 0)
                                body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + body_cost
                            local_found: mutable Ast::Expr = Ast::Expr.Invalid
                            local_matches: mutable usize = 0
                            return false if not proof_replay_summary_call_exact_span_in_body(body, call, &local_found, &local_matches, work, 0)
                            if local_matches > 0:
                                owners <- owners + 1
                                matches <- matches + local_matches
                                found <- local_found
                                found_owner_line <- position.line
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_summary_call_exact_span_in_declarations(nested, owner, owner_line, owner_offset, exact_owner, call, found, found_owner_line, matches, owners, work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
            return true

        def proof_replay_summary_call_exact_source_site_with_work(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&) -> (known: bool, source_call: Ast::Expr):
            owner_line: u32 = report.analysis_2.replay_owner_line
            owner_offset: usize = report.analysis_2.replay_owner_offset
            exact_owner: bool = report.analysis_2.replay_owner_offset_valid
            return (false, Ast::Expr.Invalid) if owner_line == 4294967295 or trace.name == ""
            # A direct audit entry may have no active certificate context. In that case derive
            # the caller only from a unique exact source call span. A supplied nonzero owner line
            # constrains the search and is never replaced with a nearby declaration.
            source_owner_line: mutable u32 = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            matches: mutable usize = 0
            owners: mutable usize = 0
            return (false, Ast::Expr.Invalid) if:
                not proof_replay_summary_call_exact_span_in_declarations(report.source.source_declarations, trace.name, owner_line, owner_offset, exact_owner, call, &found, &source_owner_line, &matches, &owners, work, 0)
                owners != 1 or matches != 1 or source_owner_line == 0
                owner_line != 0 and owner_line != source_owner_line
            caller_scope: mutable darray[sview] = []
            caller_matches: mutable usize = 0
            root_scope: mutable darray[sview] = []
            proof_replay_summary_call_owner_scope(report.source.source_declarations, trace.name, source_owner_line, owner_offset, exact_owner, &root_scope, &caller_scope, &caller_matches, work, 0)
            return (true, found) if caller_matches == 1
            return (false, Ast::Expr.Invalid)

        def proof_replay_summary_direct_call_source_site(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_replay_summary_direct_call_source_site_with_work(report, trace, call, &work)

        def proof_replay_summary_direct_call_source_site_with_work(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&) -> bool:
            return proof_replay_summary_direct_call_source_site_at(report, trace, call, 0, work)

        # A summary equation names the call's actuals as they read at the call, so its call is
        # anchored by its raw text at its exact span in the owner's body, never by a value the
        # names held at an earlier point (that substituted comparison is for deterministic-call
        # markers only). The arguments themselves are checked against the bindings separately.
