extend ElisaProofFrameSource:
    public:
        # The clause index addresses the combined original header/body policy,
        # not a producer-filtered list or the ordinal of a successful check.
        def direct_preserve_clause_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, clause_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (direct_preserve_clause_replays_with_work(declarations, name, line, position, clause_index, tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def direct_preserve_clause_replays_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, clause_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                facts.count != 0
                not replay_work_charge(nodes.count, work)
                not replay_work_charge(children.count, work)
                not (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(nodes, children) can Global{Read,Write})
                not (frame_policy_replays_after_arena_with_work(nodes, children, root, work) can Global{Read,Write})
            return (direct_preserve_clause_replays_after_arena_with_work(declarations, name, line, 0, false, position, clause_index, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})

    private:
        def direct_preserve_clause_replays_after_arena_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, owner_offset: u32, exact_owner: bool, position: Ast::Pos, clause_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            node = nodes[root]
            return false if:
                not replay_work_charge(sview_len(name), work)
                not replay_work_charge(sview_len(node.name), work)
                node.operator != "preserve" or node.name != name or node.children_count != 1
            policy = source_policy_at_offset_with_work(declarations, name, line, owner_offset, tokens, source, source_length, work) if exact_owner else source_policy_with_work(declarations, name, line, tokens, source, source_length, work)
            return false if not policy.known or policy.parameter_count != node.auxiliary or clause_index >= policy.clauses.count
            clause = policy.clauses[clause_index]
            return false if:
                not replay_work_charge(sview_len(clause.kind), work)
                clause.kind != "preserves" or not (place_typed_at_offset_with_work(declarations, name, line, owner_offset, clause.place, work) if exact_owner else place_typed_with_work(declarations, name, line, clause.place, work))
            preserved = ElisaProofKernelFramePolicy::decode_place(nodes, children, children[node.children_start], node.auxiliary)
            return false if:
                not preserved.known
                not replay_work_charge(sview_len(clause.place.field), work)
                not replay_work_charge(sview_len(clause.place.field2), work)
                not replay_work_charge(sview_len(clause.place.field3), work)
                not replay_work_charge(sview_len(preserved.place.field), work)
                not replay_work_charge(sview_len(preserved.place.field2), work)
                not replay_work_charge(sview_len(preserved.place.field3), work)
                not same_place(clause.place, preserved.place)
            actual = direct_write_at_offset_with_work(declarations, name, line, owner_offset, position, work) if exact_owner else direct_write_with_work(declarations, name, line, position, work)
            return false if not actual.known or not (place_typed_at_offset_with_work(declarations, name, line, owner_offset, actual.place, work) if exact_owner else place_typed_with_work(declarations, name, line, actual.place, work))
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return false if:
                not certified.known
                not replay_work_charge(sview_len(actual.place.field), work)
                not replay_work_charge(sview_len(actual.place.field2), work)
                not replay_work_charge(sview_len(actual.place.field3), work)
                not replay_work_charge(sview_len(certified.place.field), work)
                not replay_work_charge(sview_len(certified.place.field2), work)
                not replay_work_charge(sview_len(certified.place.field3), work)
            return same_place(actual.place, certified.place)
