extend ElisaProofFrameSource:
    public:
        # The clause index addresses the combined original header/body policy,
        # not a producer-filtered list or the ordinal of a successful check.
        def direct_preserve_clause_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, clause_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return false if not ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(nodes, children, facts, root)
            node = nodes[root]
            return false if node.operator != "preserve" or node.name != name or node.children_count != 1
            policy = source_policy(declarations, name, line, tokens, source, source_length)
            return false if not policy.known or policy.parameter_count != node.auxiliary or clause_index >= policy.clauses.count
            clause = policy.clauses[clause_index]
            return false if clause.kind != "preserves" or not place_typed(declarations, name, line, clause.place)
            preserved = ElisaProofKernelFramePolicy::decode_place(nodes, children, children[node.children_start], node.auxiliary)
            return false if not preserved.known or not same_place(clause.place, preserved.place)
            actual = direct_write(declarations, name, line, position)
            return false if not actual.known or not place_typed(declarations, name, line, actual.place)
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return certified.known and same_place(actual.place, certified.place)
