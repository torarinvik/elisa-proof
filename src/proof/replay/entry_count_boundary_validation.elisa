# Revalidate the two entry-count facts emitted for `old(receiver.count)` snapshots.
# The unsigned marker and zero lower bound are usable only when they name the unique
# source-authenticated local-binding snapshot for that same symbol.
extend ElisaProof:
    private:
        def proof_replay_entry_count_position_equal(left: Ast::Pos, right: Ast::Pos) -> bool:
            return left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        def proof_replay_entry_count_local_symbol_source(report: ProofReport&, trace: ProofFactTrace, symbol: sview, marker_position: Ast::Pos) -> bool:
            work: mutable usize = 0
            return proof_replay_entry_count_local_symbol_source_with_work(report, trace, symbol, marker_position, &work)

        def proof_replay_entry_count_local_symbol_source_with_work(report: ProofReport&, trace: ProofFactTrace, symbol: sview, marker_position: Ast::Pos, work: mutable usize&) -> bool:
            return false if:
                trace.name == "" or trace.line == 0 or trace.line != report.replay_owner_line or symbol == "" or not proof_internal_name_is_rebind(symbol)
                report.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + report.traces.records.count
            matches: mutable usize = 0
            for candidate in report.traces.records |report, trace, symbol, marker_position, matches, work|:
                continue if candidate.kind != "local-binding" or candidate.name != trace.name or candidate.line != trace.line
                match candidate.expression:
                    Ast::Expr.Binary(Ast::Expr.Ident(bound, bound_position), TokenKind.EqEq, Ast::Expr.Field(Ast::Expr.Ident(_, _), "count", _), position):
                        continue if bound != symbol
                        return false if not proof_replay_entry_count_position_equal(position, marker_position) or not proof_replay_entry_count_position_equal(bound_position, marker_position)
                        matches <- matches + 1
                        return false if not proof_replay_entry_count_binding_with_work(report, candidate, work)
                    _:
                        pass
            return matches == 1

        def proof_replay_entry_count_unsigned_marker_source(report: ProofReport&, trace: ProofFactTrace, symbol: sview, marker_position: Ast::Pos) -> bool:
            work: mutable usize = 0
            return proof_replay_entry_count_unsigned_marker_source_with_work(report, trace, symbol, marker_position, &work)

        def proof_replay_entry_count_unsigned_marker_source_with_work(report: ProofReport&, trace: ProofFactTrace, symbol: sview, marker_position: Ast::Pos, work: mutable usize&) -> bool:
            return false if:
                symbol == "" or trace.name == "" or trace.line != report.replay_owner_line
                report.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + report.traces.records.count
            matches: mutable usize = 0
            for candidate in report.traces.records |report, trace, symbol, marker_position, matches, work|:
                continue if candidate.kind != "entry-count" or candidate.name != trace.name or candidate.line != trace.line
                if candidate.expression is Ast::Expr.Call(callee, arguments, labels, position):
                    continue if arguments.count != 2 or labels.count != 0
                    if callee is Ast::Expr.Ident(marker_name, _):
                        continue if marker_name != "__elisa_unsigned_type_bound"
                    else:
                        continue
                    if arguments[0] is Ast::Expr.Ident(bound, bound_position):
                        continue if bound != symbol
                        continue if not proof_replay_entry_count_position_equal(bound_position, marker_position)
                    else:
                        continue
                    if arguments[1] is Ast::Expr.IntLit(width, width_position):
                        continue if width != 64
                        continue if not proof_replay_entry_count_position_equal(position, marker_position) or not proof_replay_entry_count_position_equal(width_position, marker_position)
                        matches <- matches + 1
                        return false if not proof_replay_entry_count_local_symbol_source_with_work(report, candidate, symbol, marker_position, work)
            return matches == 1

        def proof_replay_entry_count_boundary_fact_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_entry_count_boundary_fact_valid_with_work(report, trace, &work)

        def proof_replay_entry_count_boundary_fact_valid_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or trace.line == 0 or trace.line != report.replay_owner_line
            if trace.expression is Ast::Expr.Call(callee, arguments, labels, position):
                return false if arguments.count != 2 or labels.count != 0
                if callee is Ast::Expr.Ident(marker_name, _):
                    return false if marker_name != "__elisa_unsigned_type_bound"
                else:
                    return false
                if arguments[0] is Ast::Expr.Ident(symbol, symbol_position):
                    if arguments[1] is Ast::Expr.IntLit(width, width_position):
                        return false if:
                            width != 64
                            not proof_replay_entry_count_position_equal(symbol_position, position) or not proof_replay_entry_count_position_equal(width_position, position)
                        return proof_replay_entry_count_local_symbol_source_with_work(report, trace, symbol, position, source_work)
                return false
            if trace.expression is Ast::Expr.Binary(left, operator, right, position):
                return false if operator != TokenKind.LtEq
                if left is Ast::Expr.IntLit(zero, zero_position):
                    return false if zero != 0
                    if right is Ast::Expr.Ident(symbol, symbol_position):
                        return false if not proof_replay_entry_count_position_equal(zero_position, position) or not proof_replay_entry_count_position_equal(symbol_position, position)
                        return proof_replay_entry_count_unsigned_marker_source_with_work(report, trace, symbol, position, source_work)
            return false
