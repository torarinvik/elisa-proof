# Replay source-backed scalar witnesses for qualified const-enum member terms.
extend ElisaProof:
    private:
        def proof_replay_type_bound_enum_root_name_with_work(expression: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, "") if name == "" or not proof_replay_type_bound_local_work_charge(sview_len(name), work)
                    return (true, name)
                Ast::Expr.Scope(base, _, _) | Ast::Expr.Paren(base, _) | Ast::Expr.Refinement(base, _, _):
                    return proof_replay_type_bound_enum_root_name_with_work(base, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_type_bound_enum_root_name_with_work(inner, work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    pass
            return (true, "")

        def proof_replay_type_bound_enum_generic_shadowed_with_work(report: mutable ProofReport&, declaration_line: u32, wanted: sview, work: mutable usize&) -> bool:
            return true if not report.source_generic_params_valid or report.source_generic_param_lines.count != report.source_generic_param_names.count
            return true if not proof_replay_source_generic_param_line_index_build(report, work) or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            index: ProofSourceEffectIndex& = report.source_effect_index
            count: usize = report.source_generic_param_lines.count
            hashes_count: usize = index.generic_param_line_index_hashes.count
            return true if hashes_count != index.generic_param_line_index_values.count or hashes_count != index.generic_param_line_index_counts.count
            return true if count == 0 and hashes_count != 0
            return false if count == 0
            expected_capacity: usize = proof_name_index_capacity(count)
            return true if expected_capacity == 0 or hashes_count != expected_capacity or not index.generic_param_line_index_valid
            return true if not proof_replay_type_bound_local_work_charge(1 + sview_len(wanted), work)
            wanted_hash: u32 = proof_replay_generic_param_key_hash(declaration_line, wanted)
            slot: mutable usize = (wanted_hash.i64() % hashes_count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes_count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, declaration_line, report, index, count, hashes_count, work|:
                return true if not proof_replay_type_bound_local_work_charge(1, work)
                current: usize = index.generic_param_line_index_values[slot]
                return false if current == count
                return true if current > count or index.generic_param_line_index_counts[slot] == 0
                if index.generic_param_line_index_hashes[slot] == wanted_hash:
                    return true if current >= report.source_generic_param_names.count or current >= report.source_generic_param_lines.count
                    current_name: sview = report.source_generic_param_names[current]
                    return true if not proof_replay_type_bound_local_text_compare_charge(current_name, wanted, work)
                    if report.source_generic_param_lines[current] == declaration_line and current_name == wanted:
                        return true
                slot <- (slot + 1) % hashes_count
                probes <- probes + 1
            return true

        def proof_replay_type_bound_enum_owner_matches_segments_with_work(owner: sview, segments: darray[sview]&, work: mutable usize&) -> bool:
            owner_length: usize = sview_len(owner)
            cursor: mutable usize = 0
            return false if segments.count == 0 and owner_length != 0
            for index in 0..<segments.count |index, owner, owner_length, segments, cursor, work|:
                segment: sview = segments[index]
                length: usize = sview_len(segment)
                return false if segment == "" or cursor > owner_length or length > owner_length - cursor
                return false if not proof_replay_type_bound_local_work_charge(length + 1, work)
                for offset in 0..<length |offset, owner, segment, cursor, work|:
                    return false if sview_at(owner, cursor + offset) != sview_at(segment, offset)
                cursor <- cursor + length
                if index + 1 < segments.count:
                    return false if not proof_replay_type_bound_local_work_charge(2, work)
                    return false if owner_length - cursor < 2 or sview_at(owner, cursor) != 58 or sview_at(owner, cursor + 1) != 58
                    cursor <- cursor + 2
            return cursor == owner_length

        def proof_replay_type_bound_enum_named_type_at_owner_with_work(declarations: darray[Ast::Decl]&, current_owner: sview, wanted_owner: darray[sview]&, wanted_name: sview, aliases: mutable usize&, nominal_types: mutable usize&, alias_target: mutable Ast::Expr&, alias_line: mutable u32&, alias_offset: mutable usize&, found_owner: mutable sview&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |current_owner, wanted_owner, wanted_name, aliases, nominal_types, alias_target, alias_line, alias_offset, found_owner, depth, work|:
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                match declaration:
                    Ast::Decl.Alias(name, target, position):
                        if proof_replay_type_bound_enum_owner_matches_segments_with_work(current_owner, wanted_owner, work):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                aliases <- aliases + 1
                                alias_target <- target if aliases == 1
                                alias_line <- position.line if aliases == 1
                                alias_offset <- position.offset.usize() if aliases == 1
                                found_owner <- current_owner if aliases == 1
                    Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        if proof_replay_type_bound_enum_owner_matches_segments_with_work(current_owner, wanted_owner, work):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                nominal_types <- nominal_types + 1
                                found_owner <- current_owner if aliases + nominal_types == 1
                    Ast::Decl.Module(module_name, nested, _):
                        return false if not proof_replay_type_bound_local_work_charge(sview_len(module_name), work)
                        return false if not proof_replay_type_bound_enum_named_type_at_owner_with_work(nested, module_name, wanted_owner, wanted_name, aliases, nominal_types, alias_target, alias_line, alias_offset, found_owner, depth + 1, work)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_type_bound_enum_named_type_at_owner_with_work(nested, current_owner, wanted_owner, wanted_name, aliases, nominal_types, alias_target, alias_line, alias_offset, found_owner, depth + 1, work)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        pass
                return false if aliases > 1 or nominal_types > 1
            return true

        def proof_replay_type_bound_enum_alias_has_formals_with_work(report: ProofReport&, alias_name: sview, alias_line: u32, work: mutable usize&) -> (complete: bool, has_formals: bool):
            matches: mutable usize = 0
            for annotation in report.source_annotations |alias_name, alias_line, matches, work|:
                return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.owner, "__alias_owner", work)
                continue if annotation.owner != "__alias_owner"
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.name, alias_name, work)
                if annotation.name == alias_name and annotation.line == alias_line:
                    matches <- matches + 1
                    return (false, false) if matches > 1
            return (true, matches == 1)

        def proof_replay_type_bound_enum_path_add_owner_with_work(owner: darray[sview]&, name: sview, path: mutable darray[sview]&, work: mutable usize&) -> bool:
            return false if name == "" or not proof_replay_type_bound_local_work_charge(owner.count + sview_len(name), work)
            path.extend(owner)
            path.push(name)
            return true

        def proof_replay_type_bound_enum_root_alias_with_work(report: ProofReport&, caller_module: sview, root_name: sview, work: mutable usize&) -> (complete: bool, matched: bool, target: Ast::Expr, line: u32, offset: usize, owner: sview):
            empty_owner: darray[sview] = []
            aliases: mutable usize = 0
            nominal_types: mutable usize = 0
            target: mutable Ast::Expr = Ast::Expr.Absent
            line: mutable u32 = 0
            offset: mutable usize = 0
            owner: mutable sview = ""
            if caller_module != "":
                visibility: (complete: bool, safe: bool) = proof_source_conversion_root_alias_visibility_scan(report.source_declarations, report.source_annotations, work, 0)
                return (false, false, Ast::Expr.Invalid, 0, 0, "") if not visibility.complete
                return (true, false, Ast::Expr.Absent, 0, 0, "") if not visibility.safe
            return (false, false, Ast::Expr.Invalid, 0, 0, "") if not proof_replay_type_bound_enum_named_type_at_owner_with_work(report.source_declarations, "", empty_owner, root_name, &aliases, &nominal_types, &target, &line, &offset, &owner, 0, work)
            return (false, false, Ast::Expr.Invalid, 0, 0, "") if aliases > 1 or nominal_types > 1 or (aliases > 0 and nominal_types > 0)
            return (true, false, Ast::Expr.Absent, 0, 0, "") if aliases == 0 or nominal_types != 0
            return (true, true, target, line, offset, owner)

        def proof_replay_type_bound_enum_module_alias_owner_with_work(report: ProofReport&, caller_module: sview, segments: darray[sview]&, work: mutable usize&) -> (complete: bool, owner: darray[sview]):
            return (false, []) if segments.count < 2
            aliases: mutable ProofModuleAliasIndex = ProofModuleAliasIndex{names: [], targets: [], scopes: [], lines: [], offsets: [], alias_lookup_hashes: [], alias_lookup_values: [], alias_lookup_ambiguous: [], global_alias_lookup_hashes: [], global_alias_lookup_values: [], function_lookup_hashes: [], function_lookup_values: [], function_lookup_ambiguous: [], function_lookup_complete: false, complete: false}
            built: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_module_alias_index(report.source_annotations, &aliases, work)
            return (false, []) if not built.complete
            lexical: (complete: bool, matched: bool, valid: bool, target: sview, scope: sview) = proof_module_alias_target(aliases, caller_module, segments[0], work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
            return (false, []) if not lexical.complete
            backend: (complete: bool, matched: bool, valid: bool, row: usize) = proof_module_alias_lookup_global(aliases, segments[0], work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
            return (false, []) if not backend.complete
            owner: mutable darray[sview] = []
            if lexical.matched:
                return (false, []) if not lexical.valid or not backend.matched or not backend.valid or backend.row >= aliases.targets.count
                return (false, []) if not proof_replay_type_bound_local_work_charge(sview_len(lexical.target) + sview_len(aliases.targets[backend.row]), work)
                return (false, []) if lexical.target != aliases.targets[backend.row]
                compatible: (complete: bool, compatible: bool, target: sview) = proof_module_alias_targets_compatible(aliases, lexical.scope, lexical.target, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
                return (false, []) if not compatible.complete or not compatible.compatible
                target_path: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(owner, compatible.target, work)
                return (false, []) if not target_path.complete
                owner.extend(target_path.scope)
            else:
                return (false, []) if backend.matched
                owner.push(segments[0])
            for index in 1..<segments.count - 1 |index, segments, owner, work|:
                return (false, []) if not proof_replay_type_bound_local_work_charge(sview_len(segments[index]), work)
                owner.push(segments[index])
            return (true, owner)

        def proof_replay_type_bound_enum_alias_path_with_work(report: ProofReport&, alias_name: sview, alias_owner: sview, alias_target: Ast::Expr, alias_line: u32, alias_offset: usize, caller_module: sview, active_offsets: mutable darray[usize]&, path: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for active in active_offsets |active, alias_offset, work|:
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                return false if active == alias_offset
            formals: (complete: bool, has_formals: bool) = proof_replay_type_bound_enum_alias_has_formals_with_work(report, alias_name, alias_line, work)
            return false if not formals.complete or formals.has_formals
            empty_scope: darray[sview] = []
            owner_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(empty_scope, alias_owner, work)
            return false if not owner_scope.complete
            mark: usize = active_offsets.count
            active_offsets.push(alias_offset)
            resolved: bool = proof_replay_type_bound_enum_type_path_with_work(report, alias_target, owner_scope.scope, alias_owner, false, active_offsets, path, work, depth + 1)
            active_offsets.resize(mark)
            return resolved

        def proof_replay_type_bound_enum_type_path_with_work(report: ProofReport&, expression: Ast::Expr, resolution_scope: darray[sview]&, resolution_module: sview, caller_expression: bool, active_offsets: mutable darray[usize]&, path: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_type_bound_enum_type_path_with_work(report, inner, resolution_scope, resolution_module, caller_expression, active_offsets, path, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_type_bound_enum_type_path_with_work(report, inner, resolution_scope, resolution_module, caller_expression, active_offsets, path, work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return false
                Ast::Expr.Ident(name, _):
                    return false if name == "" or proof_scalar_primitive_type_name(name)
                    local_aliases: mutable usize = 0
                    local_nominals: mutable usize = 0
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_line: mutable u32 = 0
                    alias_offset: mutable usize = 0
                    alias_owner: mutable sview = ""
                    return false if not proof_replay_type_bound_enum_named_type_at_owner_with_work(report.source_declarations, "", resolution_scope, name, &local_aliases, &local_nominals, &alias_target, &alias_line, &alias_offset, &alias_owner, 0, work)
                    return false if local_aliases > 1 or local_nominals > 1 or (local_aliases > 0 and local_nominals > 0)
                    if local_aliases == 1:
                        return proof_replay_type_bound_enum_alias_path_with_work(report, name, alias_owner, alias_target, alias_line, alias_offset, resolution_module, active_offsets, path, work, depth + 1)
                    if local_nominals == 1:
                        return proof_replay_type_bound_enum_path_add_owner_with_work(resolution_scope, name, path, work)
                    return false if not caller_expression
                    root: (complete: bool, matched: bool, target: Ast::Expr, line: u32, offset: usize, owner: sview) = proof_replay_type_bound_enum_root_alias_with_work(report, resolution_module, name, work)
                    return false if not root.complete or not root.matched
                    return proof_replay_type_bound_enum_alias_path_with_work(report, name, root.owner, root.target, root.line, root.offset, resolution_module, active_offsets, path, work, depth + 1)
                Ast::Expr.Scope(_, _, _):
                    segments: mutable darray[sview] = []
                    return false if not proof_qualified_path_segments(expression, &segments, 0) or segments.count < 2
                    qualified_owner: (complete: bool, owner: darray[sview]) = proof_replay_type_bound_enum_module_alias_owner_with_work(report, resolution_module, segments, work)
                    return false if not qualified_owner.complete
                    final_name: sview = segments[segments.count - 1]
                    aliases: mutable usize = 0
                    nominal_types: mutable usize = 0
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_line: mutable u32 = 0
                    alias_offset: mutable usize = 0
                    alias_owner: mutable sview = ""
                    return false if not proof_replay_type_bound_enum_named_type_at_owner_with_work(report.source_declarations, "", qualified_owner.owner, final_name, &aliases, &nominal_types, &alias_target, &alias_line, &alias_offset, &alias_owner, 0, work)
                    return false if aliases > 1 or nominal_types > 1 or (aliases > 0 and nominal_types > 0)
                    if aliases == 1:
                        return proof_replay_type_bound_enum_alias_path_with_work(report, final_name, alias_owner, alias_target, alias_line, alias_offset, resolution_module, active_offsets, path, work, depth + 1)
                    if nominal_types == 1:
                        return proof_replay_type_bound_enum_path_add_owner_with_work(qualified_owner.owner, final_name, path, work)
                    return false
                _:
                    return false

        def proof_replay_type_bound_enum_member_at_path_with_work(declarations: darray[Ast::Decl]&, target: darray[sview]&, current: darray[sview]&, member_name: sview, depth: usize, work: mutable usize&) -> (types: usize, const_types: usize, members: usize, fieldless: bool, backing: Ast::Expr):
            return (2, 2, 2, false, Ast::Expr.Invalid) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or target.count == 0
            types: mutable usize = 0
            const_types: mutable usize = 0
            members: mutable usize = 0
            fieldless: mutable bool = false
            backing: mutable Ast::Expr = Ast::Expr.Absent
            for declaration in declarations |target, current, member_name, depth, types, const_types, members, fieldless, backing, work|:
                return (2, 2, 2, false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        nested_scope: (complete: bool, scope: darray[sview]) = proof_replay_enum_module_scope_with_work(current, module_name, work)
                        return (2, 2, 2, false, Ast::Expr.Invalid) if not nested_scope.complete
                        nested: (types: usize, const_types: usize, members: usize, fieldless: bool, backing: Ast::Expr) = proof_replay_type_bound_enum_member_at_path_with_work(body, target, nested_scope.scope, member_name, depth + 1, work)
                        return (2, 2, 2, false, Ast::Expr.Invalid) if nested.types > 1 or nested.const_types > 1 or nested.members > 1
                        if nested.types > 0:
                            types <- types + nested.types
                            const_types <- const_types + nested.const_types
                            members <- members + nested.members
                            fieldless <- nested.fieldless
                            backing <- nested.backing
                    Ast::Decl.Scoped(body, _):
                        nested: (types: usize, const_types: usize, members: usize, fieldless: bool, backing: Ast::Expr) = proof_replay_type_bound_enum_member_at_path_with_work(body, target, current, member_name, depth + 1, work)
                        return (2, 2, 2, false, Ast::Expr.Invalid) if nested.types > 1 or nested.const_types > 1 or nested.members > 1
                        if nested.types > 0:
                            types <- types + nested.types
                            const_types <- const_types + nested.const_types
                            members <- members + nested.members
                            fieldless <- nested.fieldless
                            backing <- nested.backing
                    Ast::Decl.Enum(enum_name, variants, is_const, backing_type, _):
                        scope_matches: bool = proof_replay_enum_scope_matches(current, target, work)
                        return (2, 2, 2, false, Ast::Expr.Invalid) if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        return (2, 2, 2, false, Ast::Expr.Invalid) if not proof_replay_variant_text_compare_charge_with_work(enum_name, target[target.count - 1], work)
                        if scope_matches and enum_name == target[target.count - 1]:
                            types <- types + 1
                            if is_const:
                                const_types <- const_types + 1
                                backing <- backing_type
                            for variant in variants |member_name, work, members, fieldless|:
                                return (2, 2, 2, false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_text_compare_charge(variant.name, member_name, work)
                                if variant.name == member_name:
                                    members <- members + 1
                                    fieldless <- variant.fields.count == 0
                    Ast::Decl.Invalid:
                        return (2, 2, 2, false, Ast::Expr.Invalid)
                    _:
                        pass
                return (2, 2, 2, false, Ast::Expr.Invalid) if types > 1 or const_types > 1 or members > 1
            return (types, const_types, members, fieldless, backing)

        def proof_replay_type_bound_const_enum_field_scalar_with_work(report: ProofReport&, enum_type: Ast::Expr, member_name: sview, caller_module: sview, work: mutable usize&) -> bool:
            return false if member_name == "" or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            path: mutable darray[sview] = []
            empty_scope: darray[sview] = []
            caller_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(empty_scope, caller_module, work)
            return false if not caller_scope.complete
            active_offsets: mutable darray[usize] = []
            return false if not proof_replay_type_bound_enum_type_path_with_work(report, enum_type, caller_scope.scope, caller_module, true, &active_offsets, &path, work, 0) or path.count == 0
            current_scope: darray[sview] = []
            member: (types: usize, const_types: usize, members: usize, fieldless: bool, backing: Ast::Expr) = proof_replay_type_bound_enum_member_at_path_with_work(report.source_declarations, path, current_scope, member_name, 0, work)
            return false if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or member.types != 1 or member.const_types != 1 or member.members != 1 or not member.fieldless
            signed_width: i64 = proof_replay_type_bound_local_signed_width(report, member.backing, work, 0)
            unsigned_width: i64 = proof_replay_type_bound_local_unsigned_width(report, member.backing, work, 0)
            return false if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or (signed_width <= 0 and unsigned_width <= 0)
            aliases: (complete: bool, overridden: bool) = proof_replay_type_bound_shorthand_alias_operator_scan(report, report.source_declarations, path[path.count - 1], work, 0)
            return false if not aliases.complete or aliases.overridden
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
            for protocol in protocols |report, enum_type, work|:
                implementation: (complete: bool, exists: bool) = proof_replay_variant_type_operator_impl_exists_with_work(enum_type, protocol, report, work)
                return false if not implementation.complete or implementation.exists
                named: (complete: bool, exists: bool) = proof_replay_variant_builtin_operator_impl_exists_with_work(report, path[path.count - 1], protocol, work)
                return false if not named.complete or named.exists
            true
