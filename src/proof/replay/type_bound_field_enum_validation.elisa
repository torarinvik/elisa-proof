# Replay source-backed scalar witnesses for qualified const-enum member terms.
extend ElisaProof:
    private:
        def proof_replay_type_bound_enum_root_name_with_work(expression: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, "") if:
                        name == ""
                        not proof_replay_type_bound_local_work_charge(1, work)
                        not proof_replay_type_bound_local_work_charge(sview_len(name), work)
                    return (true, name)
                Ast::Expr.Scope(base, _, _) | Ast::Expr.Paren(base, _) | Ast::Expr.Refinement(base, _, _):
                    return proof_replay_type_bound_enum_root_name_with_work(base, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_type_bound_enum_root_name_with_work(inner, work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    pass
            return (true, "")

        def proof_replay_type_bound_enum_owner_matches_segments_with_work(owner: sview, segments: darray[sview]&, work: mutable usize&) -> bool:
            owner_length: usize = sview_len(owner)
            cursor: mutable usize = 0
            return false if segments.count == 0 and owner_length != 0
            for index in 0..<segments.count |index, owner, owner_length, segments, cursor, work|:
                segment: sview = segments[index]
                length: usize = sview_len(segment)
                return false if:
                    segment == "" or cursor > owner_length or length > owner_length - cursor
                    not proof_replay_type_bound_local_work_charge(1, work)
                    not proof_replay_type_bound_local_work_charge(length, work)
                    not proof_replay_type_bound_local_work_charge(length, work)
                for offset in 0..<length |offset, owner, segment, cursor, work|:
                    return false if owner[cursor + offset] != segment[offset]
                cursor <- cursor + length
                if index + 1 < segments.count:
                    return false if:
                        not proof_replay_type_bound_local_work_charge(2, work)
                        owner_length - cursor < 2 or owner[cursor] != 58 or owner[cursor + 1] != 58
                    cursor <- cursor + 2
            return cursor == owner_length

        def proof_replay_type_bound_enum_index_ensure(report: ProofReport&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if cache.enum_index_attempted and (cache.enum_index_report_identity != report_identity or cache.enum_index_source_identity != source_identity):
                cache.enum_index_attempted <- false
                cache.enum_index <- ProofEnumIndex{names: [], name_hashes: [], const_enums: [], declarations: [], root_level: [], owners: [], bucket_heads: [], next_indices: [], complete: false}
            if not cache.enum_index_attempted:
                cache.enum_index_attempted <- true
                cache.enum_index_report_identity <- report_identity
                cache.enum_index_source_identity <- source_identity
                cache.enum_index <- proof_build_enum_index(report.source.source_declarations, work)
            count: usize = cache.enum_index.names.count
            return false if:
                not cache.enum_index.complete
                cache.enum_index.name_hashes.count != count or cache.enum_index.const_enums.count != count or cache.enum_index.declarations.count != count
                cache.enum_index.root_level.count != count or cache.enum_index.owners.count != count or cache.enum_index.next_indices.count != count
                cache.enum_index.bucket_heads.count != proof_index_capacity(count)
            true

        def proof_replay_type_bound_enum_named_enum_census_with_work(report: ProofReport&, name: sview, resolution_scope: darray[sview]&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> (complete: bool, exact_count: usize, root_count: usize, all_count: usize, all_owner: sview):
            exact_count: mutable usize = 0
            root_count: mutable usize = 0
            all_count: mutable usize = 0
            all_owner: mutable sview = ""
            return (false, exact_count, root_count, all_count, all_owner) if name == "" or not proof_replay_type_bound_enum_index_ensure(report, work, cache)
            index: ProofEnumIndex& = cache.enum_index
            count: usize = index.names.count
            capacity: usize = index.bucket_heads.count
            return (true, exact_count, root_count, all_count, all_owner) if capacity == 0
            return (false, exact_count, root_count, all_count, all_owner) if:
                not proof_replay_type_bound_local_work_charge(sview_len(name), work)
                work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            hash: u32 = proof_name_hash(name)
            slot: usize = (hash.i64() % capacity.i64()).usize()
            entry: mutable usize = index.bucket_heads[slot]
            steps: mutable usize = 0
            while entry < count and steps < PROOF_INDEX_MAX_CHAIN |entry, steps, index, hash, name, count, resolution_scope, exact_count, root_count, all_count, all_owner, work|:
                return (false, exact_count, root_count, all_count, all_owner) if:
                    not proof_replay_type_bound_local_work_charge(1, work)
                    entry >= index.name_hashes.count or entry >= index.owners.count or entry >= index.root_level.count or entry >= index.next_indices.count
                if index.name_hashes[entry] == hash:
                    return (false, exact_count, root_count, all_count, all_owner) if not proof_replay_type_bound_local_text_compare_charge(index.names[entry], name, work)
                    if index.names[entry] == name:
                        exact: bool = proof_replay_type_bound_enum_owner_matches_segments_with_work(index.owners[entry], resolution_scope, work)
                        return (false, exact_count, root_count, all_count, all_owner) if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        exact_count <- exact_count + 1 if exact
                        root_count <- root_count + 1 if index.root_level[entry]
                        all_count <- all_count + 1
                        all_owner <- index.owners[entry] if all_count == 1
                entry <- index.next_indices[entry]
                steps <- steps + 1
            return (false, exact_count, root_count, all_count, all_owner) if entry != count
            (true, exact_count, root_count, all_count, all_owner)

        def proof_replay_type_bound_enum_named_type_at_owner_with_work(report: ProofReport&, declarations: darray[Ast::Decl]&, current_owner: sview, wanted_owner: darray[sview]&, wanted_name: sview, aliases: mutable usize&, nominal_types: mutable usize&, alias_target: mutable Ast::Expr&, alias_line: mutable u32&, alias_offset: mutable usize&, found_owner: mutable sview&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |report, current_owner, wanted_owner, wanted_name, aliases, nominal_types, alias_target, alias_line, alias_offset, found_owner, depth, work|:
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                match declaration:
                    Ast::Decl.Alias(name, target, position):
                        if proof_replay_type_bound_enum_owner_matches_segments_with_work(current_owner, wanted_owner, work):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                aliases <- aliases + 1
                                alias_target <- target if aliases == 1
                                alias_line <- position.line if aliases == 1
                                alias_offset <- position.offset.usize() if aliases == 1
                                found_owner <- current_owner if aliases == 1
                    Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        if proof_replay_type_bound_enum_owner_matches_segments_with_work(current_owner, wanted_owner, work):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                nominal_types <- nominal_types + 1
                                found_owner <- current_owner if aliases + nominal_types == 1
                    Ast::Decl.Extern(name, _, arity, _, callable, return_type_name, _, position):
                        if proof_replay_type_bound_enum_owner_matches_segments_with_work(current_owner, wanted_owner, work):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                opaque: (complete: bool, opaque_alias: bool, policy: i64) = proof_replay_type_bound_call_opaque_extern_alias_with_work(report, name, arity, callable, return_type_name, position.offset.usize(), work)
                                return false if not opaque.complete
                                if opaque.opaque_alias:
                                    aliases <- aliases + 1
                                    return false if aliases > 1
                                    alias_target <- Ast::Expr.Invalid
                                    alias_line <- position.line
                                    alias_offset <- position.offset.usize()
                                    found_owner <- current_owner
                    Ast::Decl.Module(module_name, nested, _):
                        return false if:
                            not proof_replay_type_bound_local_work_charge(sview_len(module_name), work)
                            not proof_replay_type_bound_enum_named_type_at_owner_with_work(report, nested, module_name, wanted_owner, wanted_name, aliases, nominal_types, alias_target, alias_line, alias_offset, found_owner, depth + 1, work)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_type_bound_enum_named_type_at_owner_with_work(report, nested, current_owner, wanted_owner, wanted_name, aliases, nominal_types, alias_target, alias_line, alias_offset, found_owner, depth + 1, work)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        pass
                return false if aliases > 1 or nominal_types > 1
            return true

        def proof_replay_type_bound_enum_path_add_owner_with_work(owner: darray[sview]&, name: sview, path: mutable darray[sview]&, work: mutable usize&) -> bool:
            return false if:
                name == ""
                not proof_replay_type_bound_local_work_charge(owner.count, work)
                not proof_replay_type_bound_local_work_charge(sview_len(name), work)
            path.extend(owner)
            path.push(name)
            return true

        def proof_replay_type_bound_enum_root_alias_with_work(report: ProofReport&, caller_module: sview, root_name: sview, work: mutable usize&) -> (complete: bool, matched: bool, target: Ast::Expr, line: u32, offset: usize, owner: sview):
            empty_owner: darray[sview] = []
            aliases: mutable usize = 0
            nominal_types: mutable usize = 0
            target: mutable Ast::Expr = Ast::Expr.Absent
            line: mutable u32 = 0
            offset: mutable usize = 0
            owner: mutable sview = ""
            if caller_module != "":
                visibility: (complete: bool, safe: bool) = proof_source_conversion_root_alias_visibility_scan(report.source.source_declarations, report.source.source_annotations, work, 0)
                return (false, false, Ast::Expr.Invalid, 0, 0, "") if not visibility.complete
                return (true, false, Ast::Expr.Absent, 0, 0, "") if not visibility.safe
            return (false, false, Ast::Expr.Invalid, 0, 0, "") if:
                not proof_replay_type_bound_enum_named_type_at_owner_with_work(report, report.source.source_declarations, "", empty_owner, root_name, &aliases, &nominal_types, &target, &line, &offset, &owner, 0, work)
                aliases > 1
            # The enum-owner resolver has already ruled out enum declarations. At this
            # rank it looks for aliases; struct declarations do not preempt that lookup.
            return (true, false, Ast::Expr.Absent, 0, 0, "") if aliases == 0
            return (true, true, target, line, offset, owner)

        def proof_replay_type_bound_enum_module_alias_owner_with_index_work(aliases: ProofModuleAliasIndex&, caller_module: sview, segments: darray[sview]&, work: mutable usize&) -> (complete: bool, owner: darray[sview]):
            return (false, []) if segments.count < 2
            return (false, []) if:
                not aliases.complete
                aliases.names.count != aliases.targets.count or aliases.names.count != aliases.scopes.count or aliases.names.count != aliases.lines.count or aliases.names.count != aliases.offsets.count
            lexical: (complete: bool, matched: bool, valid: bool, target: sview, scope: sview) = proof_module_alias_target(aliases, caller_module, segments[0], work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
            return (false, []) if not lexical.complete
            backend: (complete: bool, matched: bool, valid: bool, row: usize) = proof_module_alias_lookup_global(aliases, segments[0], work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
            return (false, []) if not backend.complete
            owner: mutable darray[sview] = []
            if lexical.matched:
                return (false, []) if:
                    not lexical.valid or not backend.matched or not backend.valid or backend.row >= aliases.targets.count
                    not proof_replay_type_bound_local_work_charge(sview_len(lexical.target), work)
                    not proof_replay_type_bound_local_work_charge(sview_len(aliases.targets[backend.row]), work)
                    lexical.target != aliases.targets[backend.row]
                compatible: (complete: bool, compatible: bool, target: sview) = proof_module_alias_targets_compatible(aliases, lexical.scope, lexical.target, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
                return (false, []) if not compatible.complete or not compatible.compatible
                target_path: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(owner, compatible.target, work)
                return (false, []) if not target_path.complete
                owner.extend(target_path.scope)
            elif backend.matched:
                return (false, []) if not backend.valid or backend.row >= aliases.targets.count or backend.row >= aliases.scopes.count
                compatible: (complete: bool, compatible: bool, target: sview) = proof_module_alias_targets_compatible(aliases, aliases.scopes[backend.row], aliases.targets[backend.row], work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
                return (false, []) if not compatible.complete or not compatible.compatible
                target_path: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(owner, compatible.target, work)
                return (false, []) if not target_path.complete
                owner.extend(target_path.scope)
            else:
                owner.push(segments[0])
            for index in 1..<segments.count - 1 |index, segments, owner, work|:
                return (false, []) if not proof_replay_type_bound_local_work_charge(sview_len(segments[index]), work)
                owner.push(segments[index])
            return (true, owner)

        # Source-bound replay already retains the exact bounded module-alias index built from
        # parser annotations. Reuse it for each enum witness instead of rebuilding the tables;
        # compatibility reports keep the bounded rebuild path because their source is mutable.
        def proof_replay_type_bound_enum_module_alias_owner_with_work(report: ProofReport&, caller_module: sview, segments: darray[sview]&, work: mutable usize&) -> (complete: bool, owner: darray[sview]):
            snapshot: ProofFactCallShapeSnapshot& = report.analysis_2.fact_call_shapes
            if report.source.source_analysis_bound and snapshot.status.initialized and snapshot.status.complete and snapshot.status.source_identity == report.source.source_file_identity and snapshot.functions.module_aliases.complete:
                return proof_replay_type_bound_enum_module_alias_owner_with_index_work(snapshot.functions.module_aliases, caller_module, segments, work)
            aliases: mutable ProofModuleAliasIndex = ProofModuleAliasIndex{names: [], targets: [], scopes: [], lines: [], offsets: [], alias_lookup_hashes: [], alias_lookup_values: [], alias_lookup_ambiguous: [], global_alias_lookup_hashes: [], global_alias_lookup_values: [], function_lookup_hashes: [], function_lookup_values: [], function_lookup_ambiguous: [], function_lookup_complete: false, complete: false}
            built: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_module_alias_index(report.source.source_annotations, &aliases, work)
            return (false, []) if not built.complete
            proof_replay_type_bound_enum_module_alias_owner_with_index_work(aliases, caller_module, segments, work)

        def proof_replay_type_bound_enum_alias_path_with_work(report: ProofReport&, alias_name: sview, alias_owner: sview, alias_target: Ast::Expr, alias_line: u32, alias_offset: usize, caller_module: sview, active_offsets: mutable darray[usize]&, path: mutable darray[sview]&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&, depth: usize) -> bool:
            empty_scope: darray[sview] = []
            owner_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(empty_scope, alias_owner, work)
            return false if not owner_scope.complete
            proof_replay_type_bound_enum_alias_path_at_scope_with_work(report, alias_name, owner_scope.scope, alias_owner, alias_target, alias_line, alias_offset, caller_module, active_offsets, path, work, cache, depth)

        def proof_replay_type_bound_enum_alias_path_at_scope_with_work(report: ProofReport&, alias_name: sview, alias_owner_scope: darray[sview]&, alias_owner_module: sview, alias_target: Ast::Expr, alias_line: u32, alias_offset: usize, caller_module: sview, active_offsets: mutable darray[usize]&, path: mutable darray[sview]&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for active in active_offsets |active, alias_offset, work|:
                return false if:
                    not proof_replay_type_bound_local_work_charge(1, work)
                    active == alias_offset
            formals: (complete: bool, has_formals: bool) = proof_replay_type_bound_enum_alias_has_formals_with_work(report, alias_name, alias_line, alias_offset, work, cache)
            return false if not formals.complete or formals.has_formals
            mark: usize = active_offsets.count
            active_offsets.push(alias_offset)
            resolved: bool = proof_replay_type_bound_enum_type_path_with_work(report, alias_target, alias_owner_scope, alias_owner_module, false, active_offsets, path, work, cache, depth + 1)
            active_offsets.resize(mark)
            return resolved

        def proof_replay_type_bound_enum_type_path_with_work(report: ProofReport&, expression: Ast::Expr, resolution_scope: darray[sview]&, resolution_module: sview, caller_expression: bool, active_offsets: mutable darray[usize]&, path: mutable darray[sview]&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_type_bound_enum_type_path_with_work(report, inner, resolution_scope, resolution_module, caller_expression, active_offsets, path, work, cache, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_type_bound_enum_type_path_with_work(report, inner, resolution_scope, resolution_module, caller_expression, active_offsets, path, work, cache, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return false
                Ast::Expr.Ident(name, _):
                    return false if name == "" or proof_scalar_primitive_type_name(name)
                    enums: (complete: bool, exact_count: usize, root_count: usize, all_count: usize, all_owner: sview) = proof_replay_type_bound_enum_named_enum_census_with_work(report, name, resolution_scope, work, cache)
                    return false if not enums.complete or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                    return proof_replay_type_bound_enum_path_add_owner_with_work(resolution_scope, name, path, work) if enums.exact_count == 1
                    # Stage1 treats an ambiguous enum rank as a failed enum lookup,
                    # then attempts alias lookup from its first rank. Keep lower enum
                    # ranks blocked after ambiguity while allowing that alias fallback.
                    if enums.exact_count == 0:
                        imported: (complete: bool, count: usize, owner: sview) = proof_replay_type_bound_enum_imported_census_with_work(report, name, work, cache)
                        return false if not imported.complete or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        if imported.count == 1:
                            imported_owner: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work([], imported.owner, work)
                            return false if not imported_owner.complete
                            return proof_replay_type_bound_enum_path_add_owner_with_work(imported_owner.scope, name, path, work)
                        if imported.count == 0:
                            if resolution_scope.count > 0:
                                if enums.root_count == 1:
                                    root_scope: darray[sview] = []
                                    return proof_replay_type_bound_enum_path_add_owner_with_work(root_scope, name, path, work)
                                if enums.root_count == 0 and enums.all_count == 1:
                                    global_scope: darray[sview] = []
                                    global_owner: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(global_scope, enums.all_owner, work) if enums.all_owner != "" else (true, global_scope)
                                    return false if not global_owner.complete
                                    return proof_replay_type_bound_enum_path_add_owner_with_work(global_owner.scope, name, path, work)
                            elif enums.all_count == 1:
                                global_scope: darray[sview] = []
                                global_owner: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(global_scope, enums.all_owner, work) if enums.all_owner != "" else (true, global_scope)
                                return false if not global_owner.complete
                                return proof_replay_type_bound_enum_path_add_owner_with_work(global_owner.scope, name, path, work)
                    local_aliases: mutable usize = 0
                    local_nominals: mutable usize = 0
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_line: mutable u32 = 0
                    alias_offset: mutable usize = 0
                    alias_owner: mutable sview = ""
                    return false if:
                        not proof_replay_type_bound_enum_named_type_at_owner_with_work(report, report.source.source_declarations, "", resolution_scope, name, &local_aliases, &local_nominals, &alias_target, &alias_line, &alias_offset, &alias_owner, 0, work)
                    # Stage1 checks aliases before concrete declarations in a module,
                    # but concrete declarations before aliases at root scope.
                    if resolution_scope.count > 0:
                        return false if local_aliases > 1
                        if local_aliases == 1:
                            return proof_replay_type_bound_enum_alias_path_with_work(report, name, alias_owner, alias_target, alias_line, alias_offset, resolution_module, active_offsets, path, work, cache, depth + 1)
                        imported_alias: (complete: bool, count: usize, target: Ast::Expr, line: u32, offset: usize, owner: sview) = proof_replay_type_bound_enum_imported_alias_with_work(report, name, work)
                        return false if not imported_alias.complete or imported_alias.count > 1
                        if imported_alias.count == 1:
                            return proof_replay_type_bound_enum_alias_path_with_work(report, name, imported_alias.owner, imported_alias.target, imported_alias.line, imported_alias.offset, resolution_module, active_offsets, path, work, cache, depth + 1)
                    else:
                        return false if local_aliases > 1
                        if local_aliases == 1:
                            return proof_replay_type_bound_enum_alias_path_with_work(report, name, alias_owner, alias_target, alias_line, alias_offset, resolution_module, active_offsets, path, work, cache, depth + 1)
                        imported_alias: (complete: bool, count: usize, target: Ast::Expr, line: u32, offset: usize, owner: sview) = proof_replay_type_bound_enum_imported_alias_with_work(report, name, work)
                        return false if not imported_alias.complete or imported_alias.count > 1
                        if imported_alias.count == 1:
                            return proof_replay_type_bound_enum_alias_path_with_work(report, name, imported_alias.owner, imported_alias.target, imported_alias.line, imported_alias.offset, resolution_module, active_offsets, path, work, cache, depth + 1)
                    return false if not caller_expression
                    root: (complete: bool, matched: bool, target: Ast::Expr, line: u32, offset: usize, owner: sview) = proof_replay_type_bound_enum_root_alias_with_work(report, resolution_module, name, work)
                    return false if not root.complete
                    if root.matched:
                        return proof_replay_type_bound_enum_alias_path_with_work(report, name, root.owner, root.target, root.line, root.offset, resolution_module, active_offsets, path, work, cache, depth + 1)
                    global_alias_count: mutable usize = 0
                    concrete_count: mutable usize = 0
                    global_alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    global_alias_line: mutable u32 = 0
                    global_alias_offset: mutable usize = 0
                    global_alias_owner: mutable darray[sview] = []
                    empty_scope: mutable darray[sview] = []
                    opaque_classified: mutable bool = false
                    opaque_policy: mutable i64 = 0
                    global_complete: bool = proof_replay_type_bound_global_alias_lookup_with_work(report, report.source.source_declarations, report.source.source_annotations, &empty_scope, name, &global_alias_count, &concrete_count, &global_alias_target, &global_alias_line, &global_alias_offset, &global_alias_owner, &opaque_classified, &opaque_policy, work, 0)
                    return false if not global_complete or global_alias_count > 1
                    if global_alias_count == 0:
                        return false if local_nominals > 1
                        return proof_replay_type_bound_enum_path_add_owner_with_work(resolution_scope, name, path, work) if local_nominals == 1
                        return false
                    return false if global_alias_owner.count == 0
                    formals: (complete: bool, has_formals: bool) = proof_replay_type_bound_enum_alias_has_formals_with_work(report, name, global_alias_line, global_alias_offset, work, cache)
                    return false if not formals.complete or formals.has_formals
                    alias_module: sview = global_alias_owner[global_alias_owner.count - 1]
                    return proof_replay_type_bound_enum_alias_path_at_scope_with_work(report, name, global_alias_owner, alias_module, global_alias_target, global_alias_line, global_alias_offset, resolution_module, active_offsets, path, work, cache, depth + 1)
                Ast::Expr.Scope(head, _, _):
                    segments: mutable darray[sview] = []
                    return false if not proof_qualified_path_segments(expression, &segments, 0) or segments.count < 2
                    qualified_owner: (complete: bool, owner: darray[sview]) = proof_replay_type_bound_enum_module_alias_owner_with_work(report, resolution_module, segments, work)
                    return false if not qualified_owner.complete
                    final_name: sview = segments[segments.count - 1]
                    resolved_type_owner: mutable darray[sview] = qualified_owner.owner
                    aliases: mutable usize = 0
                    nominal_types: mutable usize = 0
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_line: mutable u32 = 0
                    alias_offset: mutable usize = 0
                    alias_owner: mutable sview = ""
                    return false if:
                        not proof_replay_type_bound_enum_named_type_at_owner_with_work(report, report.source.source_declarations, "", qualified_owner.owner, final_name, &aliases, &nominal_types, &alias_target, &alias_line, &alias_offset, &alias_owner, 0, work)
                        aliases > 1
                    simple_module_head: bool = match head:
                        Ast::Expr.Ident(_, _): true
                        _: false
                    if aliases == 0 and simple_module_head:
                        imported_alias: (complete: bool, count: usize, target: Ast::Expr, line: u32, offset: usize, owner: sview) = proof_replay_type_bound_enum_imported_alias_with_work(report, final_name, work)
                        return false if not imported_alias.complete or imported_alias.count > 1
                        if imported_alias.count == 1:
                            aliases <- 1
                            alias_target <- imported_alias.target
                            alias_line <- imported_alias.line
                            alias_offset <- imported_alias.offset
                            alias_owner <- imported_alias.owner
                            nominal_types <- 0
                            resolved_type_owner.clear()
                    if aliases == 0 and simple_module_head:
                        empty_owner: darray[sview] = []
                        root_aliases: mutable usize = 0
                        root_nominals: mutable usize = 0
                        root_target: mutable Ast::Expr = Ast::Expr.Absent
                        root_line: mutable u32 = 0
                        root_offset: mutable usize = 0
                        root_owner: mutable sview = ""
                        return false if:
                            not proof_replay_type_bound_enum_named_type_at_owner_with_work(report, report.source.source_declarations, "", empty_owner, final_name, &root_aliases, &root_nominals, &root_target, &root_line, &root_offset, &root_owner, 0, work)
                            root_aliases > 1
                        if root_aliases == 1:
                            aliases <- 1
                            nominal_types <- 0
                            alias_target <- root_target
                            alias_line <- root_line
                            alias_offset <- root_offset
                            alias_owner <- root_owner
                            resolved_type_owner.clear()
                        elif nominal_types == 0 and root_nominals == 1:
                            nominal_types <- 1
                            resolved_type_owner.clear()
                    if aliases == 0 and simple_module_head:
                        global_alias_count: mutable usize = 0
                        concrete_count: mutable usize = 0
                        global_alias_target: mutable Ast::Expr = Ast::Expr.Absent
                        global_alias_line: mutable u32 = 0
                        global_alias_offset: mutable usize = 0
                        global_alias_owner: mutable darray[sview] = []
                        opaque_classified: mutable bool = false
                        opaque_policy: mutable i64 = 0
                        empty_scope: mutable darray[sview] = []
                        global_complete: bool = proof_replay_type_bound_global_alias_lookup_with_work(report, report.source.source_declarations, report.source.source_annotations, &empty_scope, final_name, &global_alias_count, &concrete_count, &global_alias_target, &global_alias_line, &global_alias_offset, &global_alias_owner, &opaque_classified, &opaque_policy, work, 0)
                        return false if not global_complete or global_alias_count > 1
                        if global_alias_count == 1:
                            return false if global_alias_owner.count == 0
                            formals: (complete: bool, has_formals: bool) = proof_replay_type_bound_enum_alias_has_formals_with_work(report, final_name, global_alias_line, global_alias_offset, work, cache)
                            return false if not formals.complete or formals.has_formals
                            alias_module: sview = global_alias_owner[global_alias_owner.count - 1]
                            return proof_replay_type_bound_enum_alias_path_at_scope_with_work(report, final_name, global_alias_owner, alias_module, global_alias_target, global_alias_line, global_alias_offset, resolution_module, active_offsets, path, work, cache, depth + 1)
                    if aliases == 1:
                        return proof_replay_type_bound_enum_alias_path_with_work(report, final_name, alias_owner, alias_target, alias_line, alias_offset, resolution_module, active_offsets, path, work, cache, depth + 1)
                    if nominal_types == 1:
                        return proof_replay_type_bound_enum_path_add_owner_with_work(resolved_type_owner, final_name, path, work)
                    return false
                _:
                    return false

        def proof_replay_type_bound_enum_member_at_path_with_work(declarations: darray[Ast::Decl]&, target: darray[sview]&, current: darray[sview]&, member_name: sview, depth: usize, work: mutable usize&) -> (types: usize, const_types: usize, members: usize, fieldless: bool, backing: Ast::Expr):
            return (2, 2, 2, false, Ast::Expr.Invalid) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or target.count == 0
            types: mutable usize = 0
            const_types: mutable usize = 0
            members: mutable usize = 0
            fieldless: mutable bool = false
            backing: mutable Ast::Expr = Ast::Expr.Absent
            for declaration in declarations |target, current, member_name, depth, types, const_types, members, fieldless, backing, work|:
                return (2, 2, 2, false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        nested_scope: (complete: bool, scope: darray[sview]) = proof_replay_enum_module_scope_with_work(current, module_name, work)
                        return (2, 2, 2, false, Ast::Expr.Invalid) if not nested_scope.complete
                        nested: (types: usize, const_types: usize, members: usize, fieldless: bool, backing: Ast::Expr) = proof_replay_type_bound_enum_member_at_path_with_work(body, target, nested_scope.scope, member_name, depth + 1, work)
                        return (2, 2, 2, false, Ast::Expr.Invalid) if nested.types > 1 or nested.const_types > 1 or nested.members > 1
                        if nested.types > 0:
                            types <- types + nested.types
                            const_types <- const_types + nested.const_types
                            members <- members + nested.members
                            fieldless <- nested.fieldless
                            backing <- nested.backing
                    Ast::Decl.Scoped(body, _):
                        nested: (types: usize, const_types: usize, members: usize, fieldless: bool, backing: Ast::Expr) = proof_replay_type_bound_enum_member_at_path_with_work(body, target, current, member_name, depth + 1, work)
                        return (2, 2, 2, false, Ast::Expr.Invalid) if nested.types > 1 or nested.const_types > 1 or nested.members > 1
                        if nested.types > 0:
                            types <- types + nested.types
                            const_types <- const_types + nested.const_types
                            members <- members + nested.members
                            fieldless <- nested.fieldless
                            backing <- nested.backing
                    Ast::Decl.Enum(enum_name, variants, is_const, backing_type, _):
                        scope_matches: bool = proof_replay_enum_scope_matches(current, target, work)
                        return (2, 2, 2, false, Ast::Expr.Invalid) if:
                            work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                            not proof_replay_variant_text_compare_charge_with_work(enum_name, target[target.count - 1], work)
                        if scope_matches and enum_name == target[target.count - 1]:
                            types <- types + 1
                            if is_const:
                                const_types <- const_types + 1
                                backing <- backing_type
                            for variant in variants |member_name, work, members, fieldless|:
                                return (2, 2, 2, false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_text_compare_charge(variant.name, member_name, work)
                                if variant.name == member_name:
                                    members <- members + 1
                                    fieldless <- variant.fields.count == 0
                    Ast::Decl.Invalid:
                        return (2, 2, 2, false, Ast::Expr.Invalid)
                    _:
                        pass
                return (2, 2, 2, false, Ast::Expr.Invalid) if types > 1 or const_types > 1 or members > 1
            return (types, const_types, members, fieldless, backing)

        def proof_replay_type_bound_const_enum_field_scalar_with_work(report: ProofReport&, enum_type: Ast::Expr, member_name: sview, caller_module: sview, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if member_name == "" or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            path: mutable darray[sview] = []
            empty_scope: darray[sview] = []
            caller_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(empty_scope, caller_module, work)
            return false if not caller_scope.complete
            active_offsets: mutable darray[usize] = []
            return false if not proof_replay_type_bound_enum_type_path_with_work(report, enum_type, caller_scope.scope, caller_module, true, &active_offsets, &path, work, cache, 0) or path.count == 0
            current_scope: darray[sview] = []
            member: (types: usize, const_types: usize, members: usize, fieldless: bool, backing: Ast::Expr) = proof_replay_type_bound_enum_member_at_path_with_work(report.source.source_declarations, path, current_scope, member_name, 0, work)
            return false if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or member.types != 1 or member.const_types != 1 or member.members != 1 or not member.fieldless
            signed_width: i64 = proof_replay_type_bound_local_signed_width(report, member.backing, work, 0)
            unsigned_width: i64 = proof_replay_type_bound_local_unsigned_width(report, member.backing, work, 0)
            return false if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or (signed_width <= 0 and unsigned_width <= 0)
            aliases: (complete: bool, overridden: bool) = proof_replay_type_bound_shorthand_alias_operator_scan(report, report.source.source_declarations, path[path.count - 1], work, 0)
            return false if not aliases.complete or aliases.overridden
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg", "Less", "BitAnd", "BitOr", "BitXor"]
            operators: (complete: bool, absent: bool) = proof_replay_variant_type_and_named_operator_protocols_absent_with_work(enum_type, path[path.count - 1], protocols, report, work)
            operators.complete and operators.absent
