extend ElisaProof:
    private:
        # Replay is fed compiler-owned ASTs and report records, but those values can still be
        # malformed at a public revalidation boundary. Keep the native call stack well below the
        # host guard page: each validator frame contains a large record mirror, so the logical
        # arena depth of 127 is not a safe native recursion budget. Exhaustion is a gap, not a proof.
        const PROOF_REPLAY_TRACE_DEPTH_LIMIT: usize = 16
        const PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT: usize = 127

        def proof_replay_module_leaf_matches(owner: sview, leaf: sview) -> bool:
            return true if owner == leaf
            owner_length: usize = sview_len(owner)
            leaf_length: usize = sview_len(leaf)
            return false if leaf_length == 0 or owner_length < leaf_length + 2
            start: usize = owner_length - leaf_length
            return false if owner[start - 1] != 58 or owner[start - 2] != 58
            for offset in 0..<leaf_length |offset, owner, leaf, start|:
                return false if owner[start + offset] != leaf[offset]
            return true

        def proof_replay_source_local_use(expression: Ast::Expr, name: sview, expected: Ast::Pos, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(found, position):
                    return found == name and position.line == expected.line and position.column == expected.column and position.offset == expected.offset and position.end_line == expected.end_line and position.end_column == expected.end_column and position.end_offset == expected.end_offset
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _):
                    return proof_replay_source_local_use(inner, name, expected, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_source_local_use(left, name, expected, depth + 1) or proof_replay_source_local_use(right, name, expected, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_replay_source_local_use(callee, name, expected, depth + 1)
                    for argument in arguments |name, expected, depth|:
                        return true if proof_replay_source_local_use(argument, name, expected, depth + 1)
                    return false
                _:
                    return false

        def proof_replay_source_position_equal(left: Ast::Pos, right: Ast::Pos) -> bool:
            return left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        def proof_replay_call_source_position_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return proof_replay_source_position_equal(Ast::expr_pos(left), Ast::expr_pos(right))

        # The summary identity checks below walk both report summaries and source declarations.
        # Charge those walks against the same report-wide source budget used by call recovery.
        def proof_replay_summary_owner_matches_call_with_work(report: ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, source_call: Ast::Expr, source_work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return proof_replay_summary_owner_matches_call_bounded_with_cache(report, trace, summary, source_call, source_work, cache)

        # Reconstruct an executable postcondition from the verified source contract and the exact
        # call bindings. This keeps ordinary calls at the source-semantics boundary while removing
        # the producer's ability to attach an arbitrary fact to a merely verified function name.
        def proof_replay_function_summary_is_valid[@r](report: mutable ProofReport& @r, trace: ProofFactTrace, dependency_stack: darray[sview]&, dependency_depth: usize, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            return false if:
                dependency_depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
                trace.summary_bindings_start > report.analysis_1.traces.summary_names.count or trace.summary_bindings_count > report.analysis_1.traces.summary_names.count - trace.summary_bindings_start
                trace.summary_bindings_start > report.analysis_1.traces.summary_values.count or trace.summary_bindings_count > report.analysis_1.traces.summary_values.count - trace.summary_bindings_start
                trace.summary_requires_start > report.analysis_1.traces.summary_require_goal_ids.count or trace.summary_requires_count > report.analysis_1.traces.summary_require_goal_ids.count - trace.summary_requires_start
            summary_found: mutable bool = false
            summary: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
            # A summary trace records its callee's declaration line, which selects one summary
            # among same-named functions in different modules.
            return false if not proof_replay_executable_summary_index_build(report, validation_workspace.source_scan_work_used, structural_cache)
            return false if structural_cache.executable_summary_rows.names.count != report.analysis_1.executables.summaries.count or structural_cache.executable_summary_rows.next_indices.count != report.analysis_1.executables.summaries.count
            summary_lookup: (complete: bool, head: usize) = proof_replay_dependency_row_lookup(structural_cache.executable_summary_rows, trace.dependency, validation_workspace.source_scan_work_used)
            return false if not summary_lookup.complete
            summary_row: mutable usize = summary_lookup.head
            while summary_row < structural_cache.executable_summary_rows.names.count |summary_row, structural_cache, report, trace, summary_found, summary, validation_workspace|:
                return false if summary_row >= report.analysis_1.executables.summaries.count or summary_row >= structural_cache.executable_summary_rows.next_indices.count
                candidate: ProofExecutableSummary = report.analysis_1.executables.summaries[summary_row]
                return false if not proof_replay_dependency_text_compare(candidate.name, trace.dependency, validation_workspace.source_scan_work_used)
                return false if candidate.name != trace.dependency or not proof_replay_dependency_work_charge(1, validation_workspace.source_scan_work_used)
                if trace.owner_line == 0 or candidate.line == trace.owner_line:
                    return false if summary_found
                    summary_found <- true
                    summary <- candidate
                summary_row <- structural_cache.executable_summary_rows.next_indices[summary_row]
            return false if:
                not summary_found or not summary.verified
                summary.parameters_start > report.analysis_1.executables.parameters.count or summary.parameters_count > report.analysis_1.executables.parameters.count - summary.parameters_start
                summary.requires_start > report.analysis_1.executables.requires.count or summary.requires_count > report.analysis_1.executables.requires.count - summary.requires_start
                summary.ensures_start > report.analysis_1.executables.ensures.count or summary.ensures_count > report.analysis_1.executables.ensures.count - summary.ensures_start
                summary.parameters_start + summary.parameters_count > report.analysis_1.executables.parameter_references.count
                trace.summary_requires_count != summary.requires_count or trace.summary_ensure_index >= summary.ensures_count
                summary.parameters_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + summary.parameters_count
            return false if summary.requires_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + summary.requires_count
            return false if summary.ensures_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + summary.ensures_count
            return false if trace.summary_requires_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + trace.summary_requires_count
            for index in 0..<summary.parameters_count |index, summary, report, trace|:
                return false if sview_len(report.analysis_1.traces.summary_names[trace.summary_bindings_start + index]) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(report.analysis_1.traces.summary_names[trace.summary_bindings_start + index])
                return false if sview_len(report.analysis_1.executables.parameters[summary.parameters_start + index]) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(report.analysis_1.executables.parameters[summary.parameters_start + index])
                return false if report.analysis_1.traces.summary_names[trace.summary_bindings_start + index] != report.analysis_1.executables.parameters[summary.parameters_start + index]
            return false if sview_len("result") > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len("result")
            return false if report.analysis_1.traces.summary_names[trace.summary_bindings_start + summary.parameters_count] != "result"
            source_call: (known: bool, call: Ast::Expr) = proof_replay_summary_source_call_at_with_cache(report, trace, summary, 0, validation_workspace.source_scan_work_used, &structural_cache.deterministic_calls)
            return false if:
                not source_call.known
                not proof_replay_source_position_equal(Ast::expr_pos(source_call.call), trace.source_call_position)
            # Independently recover the caller's actual source call and pre-state. The
            # producer's resolved local value is not itself evidence that this call occurred.
            return false if not proof_replay_summary_direct_call_source_site_at_with_cache(report, trace, source_call.call, 0, validation_workspace.source_scan_work_used, &structural_cache.deterministic_calls)
            # A threaded call's exclusive `&` arguments are matched as the locals they lend.
            if not structural_cache.initialized:
                return false if not proof_replay_structural_validation_cache_build(report, validation_workspace.source_scan_work_used, structural_cache)
            return false if not structural_cache.complete
            structural_cache.scratch.analysis_2.replay_owner_line <- report.analysis_2.replay_owner_line
            structural_cache.scratch.analysis_2.replay_owner_offset <- report.analysis_2.replay_owner_offset
            structural_cache.scratch.analysis_2.replay_owner_offset_valid <- report.analysis_2.replay_owner_offset_valid
            threading: ProofReplayThreading = proof_replay_summary_threading_with_work(report, structural_cache.scratch, trace, summary, source_call.call, validation_workspace.source_scan_work_used)
            return false if:
                not threading.valid
                not proof_replay_summary_call_arguments_match_with_cache(report, trace, summary, proof_replay_thread_call_arguments(source_call.call, threading), validation_workspace.source_scan_work_used, &structural_cache.deterministic_calls)
            match source_call.call:
                Ast::Expr.Call(_, _, _, _):
                    return false if not proof_replay_summary_owner_matches_call_with_work(report, trace, summary, source_call.call, validation_workspace.source_scan_work_used, structural_cache.deterministic_calls)
                _:
                    return false
            ensure_expression: Ast::Expr = report.analysis_1.executables.ensures[summary.ensures_start + trace.summary_ensure_index]
            return false if not proof_replay_summary_expr_repeat_charge_with_work(ensure_expression, threading.symbols.count + 1, validation_workspace.source_scan_work_used)
            instance: mutable Ast::Expr = proof_replay_thread_contract(ensure_expression, threading, false)
            return false if:
                proof_replay_expr_is_invalid(instance)
                not proof_replay_summary_expr_charge_with_work(instance, validation_workspace.source_scan_work_used)
            old_reference: (known: bool, found: bool, parameter: sview) = proof_replay_old_reference_parameter(instance, 0)
            has_call_old: bool = old_reference.known and old_reference.found
            expected_binding_count: mutable usize = summary.parameters_count + 1 + threading.symbols.count
            expected_binding_count <- expected_binding_count + 1 if has_call_old
            return false if:
                not old_reference.known or trace.summary_bindings_count != expected_binding_count
                has_call_old and not summary.pure
            parameter_names: mutable darray[sview] = []
            parameter_values: mutable darray[Ast::Expr] = []
            for index in 0..<summary.parameters_count |index, summary, report, trace, parameter_names, parameter_values|:
                parameter_names.push(report.analysis_1.traces.summary_names[trace.summary_bindings_start + index])
                parameter_values.push(report.analysis_1.traces.summary_values[trace.summary_bindings_start + index])
            if has_call_old:
                old_parameter_slot: mutable usize = summary.parameters_count
                for index in 0..<summary.parameters_count |index, parameter_names, old_reference|:
                    return false if sview_len(parameter_names[index]) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(parameter_names[index])
                    return false if sview_len(old_reference.parameter) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(old_reference.parameter)
                    old_parameter_slot <- index if parameter_names[index] == old_reference.parameter
                return false if:
                    old_parameter_slot >= summary.parameters_count or not report.analysis_1.executables.parameter_references[summary.parameters_start + old_parameter_slot]
                    report.analysis_1.traces.summary_names[trace.summary_bindings_start + summary.parameters_count + 1] != "__old_reference_state"
                actual_parameter: Ast::Expr = parameter_values[old_parameter_slot]
                match actual_parameter:
                    Ast::Expr.Ident(actual_name, position):
                        caller_found: mutable bool = false
                        caller: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
                        return false if report.analysis_1.executables.summaries.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                        validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + report.analysis_1.executables.summaries.count
                        for candidate in report.analysis_1.executables.summaries |candidate, trace, caller_found, caller|:
                            return false if sview_len(candidate.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(candidate.name)
                            return false if sview_len(trace.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(trace.name)
                            if candidate.name == trace.name:
                                return false if caller_found
                                caller_found <- true
                                caller <- candidate
                        return false if:
                            not caller_found or caller.parameters_start > report.analysis_1.executables.parameters.count or caller.parameters_count > report.analysis_1.executables.parameters.count - caller.parameters_start or caller.parameters_start + caller.parameters_count > report.analysis_1.executables.parameter_references.count
                            not caller.pure
                            caller.parameters_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                        validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + caller.parameters_count
                        caller_reference: mutable bool = false
                        for index in 0..<caller.parameters_count |index, caller, report, actual_name, caller_reference|:
                            parameter_name: sview = report.analysis_1.executables.parameters[caller.parameters_start + index]
                            return false if sview_len(parameter_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(parameter_name)
                            return false if sview_len(actual_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(actual_name)
                            caller_reference <- true if parameter_name == actual_name and report.analysis_1.executables.parameter_references[caller.parameters_start + index]
                        return false if not caller_reference
                        zero: Ast::Expr = Ast::Expr.IntLit(0, position)
                        expected_snapshot: Ast::Expr = Ast::Expr.Index(actual_parameter, zero, position)
                        actual_snapshot: Ast::Expr = report.analysis_1.traces.summary_values[trace.summary_bindings_start + summary.parameters_count + 1]
                        return false if:
                            not proof_replay_summary_expr_equal_with_work(expected_snapshot, actual_snapshot, validation_workspace.source_scan_work_used)
                            not proof_replay_summary_expr_repeat_charge_with_work(actual_snapshot, 1, validation_workspace.source_scan_work_used)
                            not proof_replay_summary_expr_repeat_charge_with_work(instance, 1, validation_workspace.source_scan_work_used)
                        instance <- proof_replay_substitute_old_reference_call(instance, old_reference.parameter, actual_snapshot, 0)
                        return false if proof_replay_expr_is_invalid(instance)
                    _:
                        return false
            return false if not proof_replay_summary_expr_repeat_charge_with_work(instance, summary.parameters_count + 1, validation_workspace.source_scan_work_used)
            instance <- proof_replay_substitute_many(instance, parameter_names, parameter_values)
            return false if not proof_replay_summary_expr_repeat_charge_with_work(instance, 1, validation_workspace.source_scan_work_used)
            instance <- proof_replay_substitute(instance, "result", report.analysis_1.traces.summary_values[trace.summary_bindings_start + summary.parameters_count])
            return false if not proof_replay_summary_expr_equal_with_work(instance, trace.expression, validation_workspace.source_scan_work_used)
            # Each precondition was certified where the call is evaluated. A goal with the same
            # text proven at another program point is not evidence for this call.
            call_line: u32 = Ast::expr_pos(source_call.call).line
            call_position: Ast::Pos = Ast::expr_pos(source_call.call)
            return false if:
                summary.requires_count > 0 and call_line == 0
                summary.requires_count > 0 and (call_position.offset == 0 or call_position.end_offset <= call_position.offset)
            for require_index in 0..<summary.requires_count |require_index, summary, report, trace, dependency_stack, dependency_depth, validation_workspace, call_line, threading, structural_cache|:
                required_source: Ast::Expr = report.analysis_1.executables.requires[summary.requires_start + require_index]
                return false if not proof_replay_summary_expr_repeat_charge_with_work(required_source, threading.symbols.count + 1, validation_workspace.source_scan_work_used)
                required: mutable Ast::Expr = proof_replay_thread_contract(required_source, threading, true)
                return false if:
                    proof_replay_expr_is_invalid(required)
                    not proof_replay_summary_expr_repeat_charge_with_work(required, summary.parameters_count + 1, validation_workspace.source_scan_work_used)
                required <- proof_replay_substitute_many(required, parameter_names, parameter_values)
                goal_id: usize = report.analysis_1.traces.summary_require_goal_ids[trace.summary_requires_start + require_index]
                return false if goal_id >= report.results.goal_attempts.count
                attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                return false if sview_len(attempt.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(attempt.name)
                return false if sview_len(trace.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(trace.name)
                return false if:
                    attempt.name != trace.name or not attempt.producer_proven or not attempt.has_certificate or attempt.certificate_index >= report.analysis_1.certificates.count
                    attempt.line != call_line
                require_certificate: ProofGoalCertificate = report.analysis_1.certificates[attempt.certificate_index]
                return false if not proof_replay_source_position_equal(attempt.source_call_position, call_position) or not proof_replay_source_position_equal(require_certificate.source_call_position, call_position)
                matches_required: mutable bool = proof_replay_summary_expr_equal_with_work(attempt.goal, required, validation_workspace.source_scan_work_used)
                if not matches_required:
                    rebound_goal: Ast::Expr = proof_replay_literal_rebound_goal_with_cache(report, trace.name, attempt.goal, call_line, validation_workspace.source_scan_work_used, &structural_cache.deterministic_calls)
                    return false if proof_replay_expr_is_invalid(rebound_goal)
                    matches_required <- proof_replay_summary_expr_equal_with_work(rebound_goal, required, validation_workspace.source_scan_work_used)
                return false if:
                    not matches_required
                    not (proof_replay_certificate_with_stack(report, report.analysis_1.certificates[attempt.certificate_index], attempt.certificate_index, dependency_stack, dependency_depth + 1, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            return true

        # Trace names alone do not identify a declaration: modules can contain same-named
        # functions. While replaying a certificate or open attempt, bind every in-function trace
        # to the exact parser-owned declaration selected for that consumer. Global declaration
        # facts have their own validators, which re-check applicability at the active owner offset.
        def proof_replay_trace_owner_position_cached_with_work(report: ProofReport&, trace: ProofFactTrace, trace_index: usize, source_work: mutable usize&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> Ast::Pos:
            empty: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            return empty if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return proof_replay_trace_owner_source_position_for_trace_with_work(report, trace, source_work) if trace_index >= report.analysis_1.traces.records.count
            if not structural_cache.trace_owner_cache_initialized:
                count: usize = report.analysis_1.traces.records.count
                return empty if count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 2
                source_work <- source_work + count * 2
                structural_cache.trace_owner_cache_positions.resize(count)
                structural_cache.trace_owner_cache_checked.resize(count)
                zero: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                for index in 0..<count |index, structural_cache, zero|:
                    structural_cache.trace_owner_cache_positions[index] <- zero
                    structural_cache.trace_owner_cache_checked[index] <- false
                structural_cache.trace_owner_cache_count <- count
                structural_cache.trace_owner_cache_initialized <- true
            return empty if:
                structural_cache.trace_owner_cache_count != report.analysis_1.traces.records.count
                structural_cache.trace_owner_cache_positions.count != structural_cache.trace_owner_cache_count
                structural_cache.trace_owner_cache_checked.count != structural_cache.trace_owner_cache_count
            if not structural_cache.trace_owner_cache_checked[trace_index]:
                structural_cache.trace_owner_cache_positions[trace_index] <- proof_replay_trace_owner_source_position_for_trace_with_work(report, trace, source_work)
                structural_cache.trace_owner_cache_checked[trace_index] <- true
            structural_cache.trace_owner_cache_positions[trace_index]

        def proof_replay_trace_owner_matches_consumer_with_work(report: ProofReport&, trace: ProofFactTrace, trace_index: usize, owner: sview, source_work: mutable usize&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            consumer_name: mutable sview = ""
            if report.analysis_2.trace_consumer_certificate_index != 0:
                certificate_index: usize = report.analysis_2.trace_consumer_certificate_index - 1
                return false if certificate_index >= report.analysis_1.certificates.count
                consumer_name <- report.analysis_1.certificates[certificate_index].name
            elif report.analysis_2.trace_consumer_attempt_index != 0:
                attempt_index: usize = report.analysis_2.trace_consumer_attempt_index - 1
                return false if attempt_index >= report.results.goal_attempts.count
                consumer_name <- report.results.goal_attempts[attempt_index].name
            else:
                return true
            # A nested resource-call trace has only the callee name; the call node carries no
            # authenticated caller source position or edge. A unique callee declaration does not
            # prove that the caller made this call, so nested callee facts fail closed until the
            # resource trace binds each call event to its exact source call site.
            if owner != consumer_name:
                return false
            return false if:
                not report.analysis_2.replay_owner_offset_valid
                report.analysis_2.replay_owner_line == 0 or report.analysis_2.replay_owner_line == 4294967295
            if trace.owner_line != 0 and trace.kind in {"global-constant", "global-constant-qualified", "global-mutable-array-type", "global-mutable-array-index-bound"}:
                return true
            if trace.owner_line != 0 and trace.kind == "type-bound":
                return true
            trace_owner: Ast::Pos = proof_replay_trace_owner_position_cached_with_work(report, trace, trace_index, source_work, structural_cache)
            return trace_owner.line == report.analysis_2.replay_owner_line and trace_owner.offset.usize() == report.analysis_2.replay_owner_offset

        def proof_replay_kernel_fact_trace_is_valid_with_stack[@r](report: mutable ProofReport& @r, trace: ProofFactTrace, trace_index: usize, owner: sview, depth: usize, dependency_stack: darray[sview]&, revalidate_arena: bool, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            return false if:
                trace.name != owner or not proof_replay_kernel_trace_range_valid(report, trace)
                not proof_replay_ast_matches_kernel_with_work(report, trace.expression, trace.kernel_expression, validation_workspace.source_scan_work_used, 0)
                trace.premises_count != trace.kernel_premises_count
                trace.premises_start > report.analysis_1.traces.premises.count or trace.premises_count > report.analysis_1.traces.premises.count - trace.premises_start
                not proof_replay_trace_owner_matches_consumer_with_work(report, trace, trace_index, owner, validation_workspace.source_scan_work_used, structural_cache)
            kernel_premises: mutable darray[usize] = []
            for index in 0..<trace.premises_count |index, report, trace, kernel_premises|:
                kernel_premise: usize = report.analysis_1.kernel.fact_trace_premises[trace.kernel_premises_start + index]
                return false if not proof_replay_ast_matches_kernel_with_work(report, report.analysis_1.traces.premises[trace.premises_start + index], kernel_premise, validation_workspace.source_scan_work_used, 0)
                kernel_premises.push(kernel_premise)
            # Boundary facts do not require a logical derivation, but their serialized terms are
            # still untrusted input. Admit the complete reachable graph before any early return so
            # hidden fields, malformed child slices, cycles, and unsupported nodes fail closed.
            # A fact-trace entry is a public revalidation boundary. The batch certificate pass
            # may admit its arena once for the duration of that pass, but callers can retain a
            # mutable report and alter its serialized nodes afterwards. Never let that cached
            # bit turn a post-mutation fact trace into trusted evidence.
            return false if (revalidate_arena or not report.analysis_1.kernel.arena_validated) and not (ElisaProofKernelReplay::proof_kernel_replay_arena_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, kernel_premises, trace.kernel_expression, validation_workspace) can[Global{Read,Write}])
            trace_kind_work: usize = sview_len(trace.kind)
            if validation_workspace.source_scan_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or trace_kind_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used:
                validation_workspace.source_scan_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + trace_kind_work
            if trace.kind == "required-reference-parameter":
                return (proof_replay_required_reference_trace_valid_with_work(report, trace, validation_workspace.source_scan_work_used) can Global{Read,Write})
            if proof_replay_boundary_trace_kind(trace.kind):
                return (proof_replay_boundary_trace_shape_valid_with_cache(report, trace, validation_workspace.source_scan_work_used, structural_cache) can Global{Read,Write})
            return true if trace.kind == "proof-step" and proof_replay_pop_scalar_snapshot_source(report, trace)
            validation_workspace.trace_stack_touched <- true if trace.kind in {"lemma-summary", "function-summary"}
            if trace.kind == "lemma-summary":
                return (proof_replay_lemma_summary_is_valid(report, trace, dependency_stack, depth, active_certificates, validation_workspace, structural_cache) can Global{Read,Write}) and (proof_replay_dependency_is_checked(report, trace.dependency, 0, dependency_stack, depth, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            if trace.kind == "function-summary":
                return (proof_replay_function_summary_is_valid(report, trace, dependency_stack, depth, active_certificates, validation_workspace, structural_cache) can Global{Read,Write}) and (proof_replay_dependency_is_checked(report, trace.dependency, trace.owner_line, dependency_stack, depth, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            return false if:
                trace.kind != "proof-step" and trace.kind != "lemma-step" and trace.kind != "loop-invariant-step" and trace.kind != "branch-conjunct" and trace.kind != "unit-resolution" and trace.kind != "branch-join"
                depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            for premise in kernel_premises |premise, report, owner, depth, dependency_stack, revalidate_arena, active_certificates, validation_workspace|:
                found: mutable bool = false
                candidate_index: mutable usize = proof_replay_fact_trace_head(report, owner)
                while candidate_index < report.analysis_1.traces.records.count |candidate_index, premise, report, owner, depth, dependency_stack, found, revalidate_arena, active_certificates, validation_workspace|:
                    candidate: ProofFactTrace = report.analysis_1.traces.records[candidate_index]
                    kernel_equality_work: mutable usize = 0
                    same_kernel_expression: mutable bool = false
                    if candidate.kernel_expression < report.analysis_1.kernel.nodes.count:
                        if candidate.kernel_expression == premise:
                            return false if not proof_replay_trace_lookup_charge(report)
                            same_kernel_expression <- true
                        else:
                            root_shape: (complete: bool, may_equal: bool) = proof_replay_kernel_roots_may_equal(report, candidate.kernel_expression, premise)
                            return false if not root_shape.complete
                            if root_shape.may_equal:
                                equality_limit: usize = proof_replay_trace_lookup_remaining_work(report)
                                return false if equality_limit == 0
                                same_kernel_expression <- ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public_with_work(report.analysis_1.kernel.nodes, report.analysis_1.kernel.children, candidate.kernel_expression, premise, 0, equality_limit, &kernel_equality_work)
                    return false if not proof_replay_trace_lookup_charge_amount(report, kernel_equality_work)
                    if same_kernel_expression and (proof_replay_kernel_trace_valid_memo(report, candidate_index, owner, depth + 1, dependency_stack, revalidate_arena, active_certificates, validation_workspace, structural_cache) can Global{Read,Write}):
                        found <- true
                        break
                    candidate_index <- proof_replay_trace_chain_next(report, candidate_index)
                return false if not found
            return (ElisaProofKernelReplay::proof_kernel_replay_goal_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, kernel_premises, trace.kernel_expression, validation_workspace) can Global{Read,Write})

        # Different root kinds or operators can never be structurally equal. Check this small
        # necessary condition before the full bounded tree walk used for provenance matching.
        def proof_replay_kernel_roots_may_equal(report: mutable ProofReport&, left_root: usize, right_root: usize) -> (complete: bool, may_equal: bool):
            return (true, false) if left_root >= report.analysis_1.kernel.nodes.count or right_root >= report.analysis_1.kernel.nodes.count
            left: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[left_root]
            right: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[right_root]
            return (false, false) if:
                not proof_replay_trace_lookup_charge(report)
                not proof_replay_trace_lookup_charge_amount(report, sview_len(left.kind))
                not proof_replay_trace_lookup_charge_amount(report, sview_len(right.kind))
                not proof_replay_trace_lookup_charge_amount(report, sview_len(left.operator))
                not proof_replay_trace_lookup_charge_amount(report, sview_len(right.operator))
            return (true, left.kind == right.kind and left.operator == right.operator)

        def proof_replay_kernel_fact_root_is_traced_with_stack[@r](report: mutable ProofReport& @r, fact: usize, owner: sview, dependency_stack: darray[sview]&, revalidate_arena: bool, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            return false if fact >= report.analysis_1.kernel.nodes.count
            trace_index: mutable usize = proof_replay_fact_trace_head(report, owner)
            while trace_index < report.analysis_1.traces.records.count |trace_index, report, fact, owner, dependency_stack, revalidate_arena, active_certificates, validation_workspace|:
                trace: ProofFactTrace = report.analysis_1.traces.records[trace_index]
                kernel_equality_work: mutable usize = 0
                same_kernel_expression: mutable bool = false
                if trace.kernel_expression < report.analysis_1.kernel.nodes.count:
                    if trace.kernel_expression == fact:
                        return false if not proof_replay_trace_lookup_charge(report)
                        same_kernel_expression <- true
                    else:
                        root_shape: (complete: bool, may_equal: bool) = proof_replay_kernel_roots_may_equal(report, trace.kernel_expression, fact)
                        return false if not root_shape.complete
                        if root_shape.may_equal:
                            equality_limit: usize = proof_replay_trace_lookup_remaining_work(report)
                            return false if equality_limit == 0
                            same_kernel_expression <- ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public_with_work(report.analysis_1.kernel.nodes, report.analysis_1.kernel.children, trace.kernel_expression, fact, 0, equality_limit, &kernel_equality_work)
                return false if not proof_replay_trace_lookup_charge_amount(report, kernel_equality_work)
                return true if same_kernel_expression and (proof_replay_kernel_trace_valid_memo(report, trace_index, owner, 0, dependency_stack, revalidate_arena, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
                trace_index <- proof_replay_trace_chain_next(report, trace_index)
            return false

        def proof_replay_resource_owner_prefix_event_valid_with_work(report: ProofReport&, resource_root: usize, event_index: usize, prefix_end: usize, source_work: mutable usize&) -> bool:
            return false if resource_root >= report.analysis_1.kernel.nodes.count or event_index >= report.analysis_1.kernel.nodes.count
            root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[resource_root]
            return false if root.kind != "resource-safety" or prefix_end > root.children_count or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start
            total: mutable usize = 0
            prefix: mutable usize = 0
            for index in 0..<root.children_count |index, root, report, event_index, prefix_end, total, prefix, source_work|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[root.children_start + index]
                if child == event_index:
                    total <- total + 1
                    prefix <- prefix + 1 if index < prefix_end
            return false if total != 1 or prefix != 1
            # The root preflight checks all prefix nodes' unique incoming edges in one graph
            # walk, before dispatch reaches an individual bind.
            true

        # Resource-disjoint transitions carry their own logical premises inside the resource
        # trace because the resource certificate has no ordinary top-level proposition. Those
        # premise roots are still required to correspond to facts explicitly introduced by the
        # source checker. Meter every node and edge as well: recursion depth bounds stack use but
        # a flat serialized list still needs a caller-wide work bound.
        def proof_replay_resource_event_facts_with_owner[@r](report: mutable ProofReport& @r, root: usize, resource_root: usize, resource_prefix_end: usize, owner: sview, owner_line: u32, owner_offset: usize, owner_module: sview, dependency_stack: darray[sview]&, depth: usize, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            return false if not proof_replay_owner_work_charge(1, validation_workspace.source_scan_work_used)
            return false if depth >= PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT or root >= report.analysis_1.kernel.nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[root]
            return false if not proof_replay_resource_event_kind_dispatch_work(node.kind, "", 28, validation_workspace.source_scan_work_used)
            active_owner: mutable sview = owner
            active_owner_line: mutable u32 = owner_line
            active_owner_offset: mutable usize = owner_offset
            active_owner_module: mutable sview = owner_module
            active_owner <- node.name if node.kind == "resource-safety" and node.name != ""
            active_resource_prefix_end: mutable usize = resource_prefix_end
            if node.kind == "resource-safety":
                return false if not proof_replay_resource_event_offsets_ordered_for_owner_with_work(report, root, node.name, node.right.u32(), node.value.usize(), node.secondary_name, validation_workspace.source_scan_work_used, structural_cache)
                return false if not proof_replay_resource_safety_owner_valid_with_work(report, root, node, &active_resource_prefix_end, validation_workspace.source_scan_work_used, structural_cache)
                active_owner_line <- node.right.u32()
                active_owner_offset <- node.value.usize()
                active_owner_module <- node.secondary_name
                return false if not proof_replay_resource_call_coverage_for_owner_with_work(report, root, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind == "resource-disjoint":
                return false if node.children_start > report.analysis_1.kernel.children.count or node.children_count > report.analysis_1.kernel.children.count - node.children_start
                for index in 0..<node.children_count |index, node, report, active_owner, dependency_stack, active_certificates, validation_workspace|:
                    return false if not proof_replay_owner_work_charge(1, validation_workspace.source_scan_work_used)
                    fact: usize = report.analysis_1.kernel.children[node.children_start + index]
                    return false if not (proof_replay_kernel_fact_root_is_traced_with_stack(report, fact, active_owner, dependency_stack, false, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
                return true
            if node.kind in {"resource-safety", "resource-scope", "resource-alternatives"}:
                return false if node.children_start > report.analysis_1.kernel.children.count or node.children_count > report.analysis_1.kernel.children.count - node.children_start
                for index in 0..<node.children_count |index, node, report, active_owner, dependency_stack, depth, active_certificates, validation_workspace|:
                    return false if not proof_replay_owner_work_charge(1, validation_workspace.source_scan_work_used)
                    child: usize = report.analysis_1.kernel.children[node.children_start + index]
                    return false if not (proof_replay_resource_event_facts_with_owner(report, child, resource_root, active_resource_prefix_end, active_owner, active_owner_line, active_owner_offset, active_owner_module, dependency_stack, depth + 1, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
                return true
            if node.kind == "resource-call":
                return false if not proof_replay_resource_call_site_matches_owner_with_work(report, resource_root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
                return false if node.left >= report.analysis_1.kernel.nodes.count or node.left == resource_root
                callee_root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[node.left]
                return false if callee_root.kind != "resource-safety"
                return false if not proof_replay_owner_work_charge(sview_len(node.name), validation_workspace.source_scan_work_used) or not proof_replay_owner_work_charge(sview_len(callee_root.name), validation_workspace.source_scan_work_used) or node.name != callee_root.name
                return false if not proof_replay_owner_work_charge(sview_len(node.secondary_name), validation_workspace.source_scan_work_used) or not proof_replay_owner_work_charge(sview_len(callee_root.secondary_name), validation_workspace.source_scan_work_used) or node.secondary_name != callee_root.secondary_name
                return false if not proof_replay_owner_work_charge(sview_len(callee_root.operator), validation_workspace.source_scan_work_used) or callee_root.operator != "resource-v2"
                # Kernel replay executes the linked callee summary in a fresh resource state.
                # Authenticate that entire summary against its own source owner before allowing
                # its effects to contribute to the caller's transition.
                return (proof_replay_resource_event_facts_with_owner(report, node.left, node.left, 0, callee_root.name, callee_root.right.u32(), callee_root.value.usize(), callee_root.secondary_name, dependency_stack, depth + 1, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            # This helper is a provenance boundary, not merely a traversal convenience. The
            # resource kernel may know more node kinds in a future format revision, but an older
            # replay implementation must not silently bless one as fact-free. Every supported
