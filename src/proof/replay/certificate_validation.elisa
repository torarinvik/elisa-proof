extend ElisaProof:
    private:
        # Replay is fed compiler-owned ASTs and report records, but those values can still be
        # malformed at a public revalidation boundary. Keep the native call stack well below the
        # host guard page: each validator frame contains a large record mirror, so the logical
        # arena depth of 127 is not a safe native recursion budget. Exhaustion is a gap, not a proof.
        const PROOF_REPLAY_TRACE_DEPTH_LIMIT: usize = 16
        const PROOF_REPLAY_AST_DEPTH_LIMIT: usize = 96
        const PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT: usize = 127

        def proof_replay_module_leaf_matches(owner: sview, leaf: sview) -> bool:
            return true if owner == leaf
            owner_length: usize = sview_len(owner)
            leaf_length: usize = sview_len(leaf)
            return false if leaf_length == 0 or owner_length < leaf_length + 2
            start: usize = owner_length - leaf_length
            return false if sview_at(owner, start - 1) != 58 or sview_at(owner, start - 2) != 58
            for offset in 0..<leaf_length |offset, owner, leaf, start|:
                return false if sview_at(owner, start + offset) != sview_at(leaf, offset)
            return true

        # Match a module expression against a suffix of its declared qualified owner without
        # flattening or allocating. Returning the start offset lets callers distinguish an exact
        # path from a single-segment path resolved relative to an enclosing module.
        def proof_replay_module_path_start(owner: sview, expression: Ast::Expr, end: usize, depth: usize) -> (valid: bool, start: usize):
            return (false, 0) if depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    name_length: usize = sview_len(name)
                    return (false, 0) if name_length == 0 or name_length > end
                    start: usize = end - name_length
                    for offset in 0..<name_length |owner, name, start|:
                        return (false, 0) if sview_at(owner, start + offset) != sview_at(name, offset)
                    return (true, start)
                Ast::Expr.Scope(base, member, _):
                    member_length: usize = sview_len(member)
                    return (false, 0) if member_length == 0 or member_length + 2 > end
                    start: usize = end - member_length
                    for offset in 0..<member_length |owner, member, start|:
                        return (false, 0) if sview_at(owner, start + offset) != sview_at(member, offset)
                    return (false, 0) if sview_at(owner, start - 1) != 58 or sview_at(owner, start - 2) != 58
                    return proof_replay_module_path_start(owner, base, start - 2, depth + 1)
                _:
                    return (false, 0)

        # Fully qualified source spellings must match the complete declared module name.
        def proof_replay_exact_module_path_matches_owner(owner: sview, expression: Ast::Expr) -> bool:
            path: (valid: bool, start: usize) = proof_replay_module_path_start(owner, expression, sview_len(owner), 0)
            return path.valid and path.start == 0

        # A one-segment qualifier may name a nested module relative to the caller's module or
        # one of its ancestors. Requiring that lexical prefix prevents a same-leaf module under
        # an unrelated parent from being mistaken for the target summary's owner.
        def proof_replay_relative_module_path_matches_owner(owner: sview, module_name: sview, caller_owner: sview) -> bool:
            return true if owner == module_name
            return false if not proof_replay_module_leaf_matches(owner, module_name)
            owner_prefix_length: usize = sview_len(owner) - sview_len(module_name) - 2
            caller_length: usize = sview_len(caller_owner)
            return false if owner_prefix_length == 0 or caller_length < owner_prefix_length
            for index in 0..<owner_prefix_length |owner, caller_owner|:
                return false if sview_at(owner, index) != sview_at(caller_owner, index)
            return true if caller_length == owner_prefix_length
            return false if caller_length < owner_prefix_length + 2
            return sview_at(caller_owner, owner_prefix_length) == 58 and sview_at(caller_owner, owner_prefix_length + 1) == 58

        def proof_replay_function_owner_module(declarations: darray[Ast::Decl]&, name: sview, line: u32, current: sview, owner: mutable sview&, count: mutable usize&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            for declaration in declarations |name, line, current, owner, count, depth|:
                match declaration:
                    Ast::Decl.Func(candidate_name, _, _, _, _, _, candidate_position):
                        if candidate_name == name and candidate_position.line == line:
                            owner <- current
                            count <- count + 1
                    Ast::Decl.Module(module_name, body, _):
                        proof_replay_function_owner_module(body, name, line, module_name, owner, count, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_function_owner_module(body, name, line, current, owner, count, depth + 1)
                    _:
                        pass

        # Module enclosing the function declared at `line`, whatever its name.
        def proof_replay_module_at_function_line(declarations: darray[Ast::Decl]&, line: u32, current: sview, owner: mutable sview&, count: mutable usize&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            for declaration in declarations |line, current, owner, count, depth|:
                match declaration:
                    Ast::Decl.Func(_, _, _, _, _, _, candidate_position):
                        if candidate_position.line == line:
                            owner <- current
                            count <- count + 1
                    Ast::Decl.Module(module_name, body, _):
                        proof_replay_module_at_function_line(body, line, module_name, owner, count, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_module_at_function_line(body, line, current, owner, count, depth + 1)
                    _:
                        pass

        # The recorded result must resolve to the module that declares the chosen summary. A
        # matching final segment is insufficient: unrelated parents can declare same-leaf modules.
        def proof_replay_summary_owner_matches_call(report: ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, callee: Ast::Expr) -> bool:
            same_name: mutable usize = 0
            for candidate in report.executable_summaries |candidate, trace, same_name|:
                same_name <- same_name + 1 if candidate.name == trace.dependency
            return false if trace.owner_line == 0 or summary.line != trace.owner_line
            owner: mutable sview = ""
            owners: mutable usize = 0
            proof_replay_function_owner_module(report.source_declarations, trace.dependency, trace.owner_line, "", &owner, &owners, 0)
            return false if owners != 1
            match callee:
                Ast::Expr.Scope(base, member, _):
                    return false if member != trace.dependency or owner == ""
                    return true if proof_replay_exact_module_path_matches_owner(owner, base)
                    match base:
                        Ast::Expr.Ident(module_name, _):
                            return false if report.replay_owner_line == 0
                            caller_owner: mutable sview = ""
                            callers: mutable usize = 0
                            proof_replay_module_at_function_line(report.source_declarations, report.replay_owner_line, "", &caller_owner, &callers, 0)
                            return callers == 1 and proof_replay_relative_module_path_matches_owner(owner, module_name, caller_owner)
                        _:
                            return false
                Ast::Expr.Ident(callee_name, _):
                    return false if callee_name != trace.dependency
                    return true if same_name <= 1
                    # A bare call resolves to the caller's own module first, so it names
                    # this summary only when the certificate is declared in the callee's module.
                    return false if owner == "" or report.replay_owner_line == 0
                    caller_owner: mutable sview = ""
                    callers: mutable usize = 0
                    proof_replay_module_at_function_line(report.source_declarations, report.replay_owner_line, "", &caller_owner, &callers, 0)
                    return callers == 1 and caller_owner == owner
                _:
                    return false

        # Reconstruct an executable postcondition from the verified source contract and the exact
        # call bindings. This keeps ordinary calls at the source-semantics boundary while removing
        # the producer's ability to attach an arbitrary fact to a merely verified function name.
        def proof_replay_function_summary_is_valid[@r](report: mutable ProofReport& @r, trace: ProofFactTrace, dependency_stack: darray[sview]&, dependency_depth: usize, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            return false if dependency_depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            return false if trace.summary_bindings_start > report.fact_trace_summary_names.count or trace.summary_bindings_count > report.fact_trace_summary_names.count - trace.summary_bindings_start
            return false if trace.summary_bindings_start > report.fact_trace_summary_values.count or trace.summary_bindings_count > report.fact_trace_summary_values.count - trace.summary_bindings_start
            return false if trace.summary_requires_start > report.fact_trace_summary_require_goal_ids.count or trace.summary_requires_count > report.fact_trace_summary_require_goal_ids.count - trace.summary_requires_start
            summary_found: mutable bool = false
            summary: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
            # A summary trace records its callee's declaration line, which selects one summary
            # among same-named functions in different modules.
            for candidate in report.executable_summaries |candidate, trace, summary_found, summary|:
                if candidate.name == trace.dependency and (trace.owner_line == 0 or candidate.line == trace.owner_line):
                    return false if summary_found
                    summary_found <- true
                    summary <- candidate
            return false if not summary_found or not summary.verified
            return false if summary.parameters_start > report.executable_parameters.count or summary.parameters_count > report.executable_parameters.count - summary.parameters_start
            return false if summary.requires_start > report.executable_requires.count or summary.requires_count > report.executable_requires.count - summary.requires_start
            return false if summary.ensures_start > report.executable_ensures.count or summary.ensures_count > report.executable_ensures.count - summary.ensures_start
            return false if summary.parameters_start + summary.parameters_count > report.executable_parameter_references.count
            return false if trace.summary_requires_count != summary.requires_count or trace.summary_ensure_index >= summary.ensures_count
            for index in 0..<summary.parameters_count |index, summary, report, trace|:
                return false if report.fact_trace_summary_names[trace.summary_bindings_start + index] != report.executable_parameters[summary.parameters_start + index]
            return false if report.fact_trace_summary_names[trace.summary_bindings_start + summary.parameters_count] != "result"
            source_call: (known: bool, call: Ast::Expr) = proof_replay_summary_source_call(report, trace, summary)
            return false if not source_call.known
            return false if not proof_replay_summary_call_arguments_match(report, trace, summary, source_call.call)
            match source_call.call:
                Ast::Expr.Call(callee, _, _, _):
                    return false if not proof_replay_summary_owner_matches_call(report, trace, summary, callee)
                _:
                    return false
            instance: mutable Ast::Expr = report.executable_ensures[summary.ensures_start + trace.summary_ensure_index]
            old_reference: (known: bool, found: bool, parameter: sview) = proof_replay_old_reference_parameter(instance, 0)
            has_call_old: bool = old_reference.known and old_reference.found
            expected_binding_count: mutable usize = summary.parameters_count + 1
            expected_binding_count <- expected_binding_count + 1 if has_call_old
            return false if not old_reference.known or trace.summary_bindings_count != expected_binding_count
            return false if has_call_old and not summary.pure
            parameter_names: mutable darray[sview] = []
            parameter_values: mutable darray[Ast::Expr] = []
            for index in 0..<summary.parameters_count |index, summary, report, trace, parameter_names, parameter_values|:
                parameter_names.push(report.fact_trace_summary_names[trace.summary_bindings_start + index])
                parameter_values.push(report.fact_trace_summary_values[trace.summary_bindings_start + index])
            if has_call_old:
                old_parameter_slot: mutable usize = summary.parameters_count
                for index in 0..<summary.parameters_count |index, parameter_names, old_reference|:
                    old_parameter_slot <- index if parameter_names[index] == old_reference.parameter
                return false if old_parameter_slot >= summary.parameters_count or not report.executable_parameter_references[summary.parameters_start + old_parameter_slot]
                return false if report.fact_trace_summary_names[trace.summary_bindings_start + summary.parameters_count + 1] != "__old_reference_state"
                actual_parameter: Ast::Expr = parameter_values[old_parameter_slot]
                match actual_parameter:
                    Ast::Expr.Ident(actual_name, position):
                        caller_found: mutable bool = false
                        caller: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
                        for candidate in report.executable_summaries |candidate, trace, caller_found, caller|:
                            if candidate.name == trace.name:
                                return false if caller_found
                                caller_found <- true
                                caller <- candidate
                        return false if not caller_found or caller.parameters_start > report.executable_parameters.count or caller.parameters_count > report.executable_parameters.count - caller.parameters_start or caller.parameters_start + caller.parameters_count > report.executable_parameter_references.count
                        return false if not caller.pure
                        caller_reference: mutable bool = false
                        for index in 0..<caller.parameters_count |index, caller, report, actual_name, caller_reference|:
                            caller_reference <- true if report.executable_parameters[caller.parameters_start + index] == actual_name and report.executable_parameter_references[caller.parameters_start + index]
                        return false if not caller_reference
                        zero: Ast::Expr = Ast::Expr.IntLit(0, position)
                        expected_snapshot: Ast::Expr = Ast::Expr.Index(actual_parameter, zero, position)
                        actual_snapshot: Ast::Expr = report.fact_trace_summary_values[trace.summary_bindings_start + summary.parameters_count + 1]
                        return false if not proof_replay_expr_equal(expected_snapshot, actual_snapshot)
                        instance <- proof_replay_substitute_old_reference_call(instance, old_reference.parameter, actual_snapshot, 0)
                        return false if proof_replay_expr_is_invalid(instance)
                    _:
                        return false
            instance <- proof_replay_substitute_many(instance, parameter_names, parameter_values)
            instance <- proof_replay_substitute(instance, "result", report.fact_trace_summary_values[trace.summary_bindings_start + summary.parameters_count])
            return false if not proof_replay_expr_equal(instance, trace.expression)
            for require_index in 0..<summary.requires_count |require_index, summary, report, trace, dependency_stack, dependency_depth, validation_workspace|:
                required: mutable Ast::Expr = report.executable_requires[summary.requires_start + require_index]
                required <- proof_replay_substitute_many(required, parameter_names, parameter_values)
                goal_id: usize = report.fact_trace_summary_require_goal_ids[trace.summary_requires_start + require_index]
                return false if goal_id >= report.goal_attempts.count
                attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
                return false if attempt.name != trace.name or not attempt.proven or not attempt.has_certificate or attempt.certificate_index >= report.certificates.count
                return false if not proof_replay_expr_equal(attempt.goal, required) and not proof_replay_expr_equal(proof_replay_literal_rebound_goal(report, trace.name, attempt.goal), required)
                return false if not proof_replay_certificate_with_stack(report, report.certificates[attempt.certificate_index], attempt.certificate_index, dependency_stack, dependency_depth + 1, active_certificates, validation_workspace)
            return true

        # Independently check the untrusted AST mirror against the source-neutral kernel term.
        # Do not call the producer's encoder here: replay must detect, rather than reproduce, a
        # lowering bug. Parentheses and type annotations are intentionally semantic erasures.
        def proof_replay_operator_name(operator: TokenKind) -> sview:
            return "+" if operator == TokenKind.Plus
            return "-" if operator == TokenKind.Minus
            return "*" if operator == TokenKind.Star
            return "/" if operator == TokenKind.Slash
            return "%" if operator == TokenKind.Percent
            return "==" if operator == TokenKind.EqEq
            return "!=" if operator == TokenKind.BangEq
            return "<" if operator == TokenKind.Lt
            return ">" if operator == TokenKind.Gt
            return "<=" if operator == TokenKind.LtEq
            return ">=" if operator == TokenKind.GtEq
            return "and" if operator == TokenKind.And
            return "or" if operator == TokenKind.Or
            return "=>" if operator == TokenKind.FatArrow
            return "not" if operator == TokenKind.Not
            return "in" if operator == TokenKind.In
            return "is" if operator == TokenKind.Is
            return "as" if operator == TokenKind.As
            return "|" if operator == TokenKind.Pipe
            return "^" if operator == TokenKind.Caret
            return "&" if operator == TokenKind.Ampersand
            return "<<" if operator == TokenKind.LShift
            return ">>" if operator == TokenKind.RShift
            return "range_lt" if operator == TokenKind.RangeLt
            return "range_le" if operator == TokenKind.RangeLe
            return "else" if operator == TokenKind.Else
            return ""

        def proof_replay_ast_matches_kernel(report: ProofReport&, expression: Ast::Expr, root: usize, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or root >= report.kernel_nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[root]
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_ast_matches_kernel(report, inner, root, depth + 1)
                Ast::Expr.IntLit(value, position):
                    literal = proof_replay_numeric_literal_sort(report.source_annotations, position.line, position.column, value)
                    if literal.known:
                        sort: sview = proof_numeric_literal_sort_name(literal.unsigned, literal.width)
                        return node.kind == "typed-int" and node.value == value and node.name == sort and ElisaProofKernelCore::typed_literal_value(node).known
                    return node.kind == "int" and node.value == value
                Ast::Expr.Absent:
                    return node.kind == "absent"
                Ast::Expr.BoolLit(value, _):
                    return node.kind == "bool" and node.value == (1 if value else 0)
                Ast::Expr.FloatLit(value, _):
                    return node.kind == "float" and node.name == value
                Ast::Expr.StringLit(value, _):
                    return node.kind == "string" and node.name == value
                Ast::Expr.CharLit(value, _):
                    return node.kind == "char" and node.name == value
                Ast::Expr.Ident(name, _):
                    return node.kind == "ident" and node.name == name
                Ast::Expr.ShorthandMember(parts, _):
                    return parts.count == 1 and parts[0] != "" and node.kind == "shorthand" and node.name == parts[0]
                Ast::Expr.Unary(operator, operand, _):
                    expected: sview = proof_replay_operator_name(operator)
                    return expected != "" and node.kind == "unary" and node.operator == expected and proof_replay_ast_matches_kernel(report, operand, node.left, depth + 1)
                Ast::Expr.Binary(Ast::Expr.Index(object, index, _), TokenKind.Else, fallback, _):
                    return false if node.kind != "checked-index" or node.left >= report.kernel_nodes.count
                    index_node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[node.left]
                    return index_node.kind == "index" and proof_replay_ast_matches_kernel(report, object, index_node.left, depth + 1) and proof_replay_ast_matches_kernel(report, index, index_node.right, depth + 1) and proof_replay_ast_matches_kernel(report, fallback, node.right, depth + 1)
                Ast::Expr.GetElse(Ast::Expr.Index(object, index, _), recovery, _):
                    # The kernel node intentionally erases recovery control flow, so validate the
                    # complete source expression here before accepting the erased mirror. This
                    # prevents a forged report from pairing a valid checked-get root with an
                    # Invalid or otherwise unsupported recovery body.
                    return false if recovery.count == 0 or not proof_kernel_expression_supported(expression) or node.kind != "checked-get" or node.left >= report.kernel_nodes.count
                    index_node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[node.left]
                    return index_node.kind == "index" and proof_replay_ast_matches_kernel(report, object, index_node.left, depth + 1) and proof_replay_ast_matches_kernel(report, index, index_node.right, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    expected: sview = proof_replay_operator_name(operator)
                    return expected != "" and node.kind == "binary" and node.operator == expected and proof_replay_ast_matches_kernel(report, left, node.left, depth + 1) and proof_replay_ast_matches_kernel(report, right, node.right, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return node.kind == "if" and proof_replay_ast_matches_kernel(report, condition, node.left, depth + 1) and proof_replay_ast_matches_kernel(report, then_expression, node.right, depth + 1) and proof_replay_ast_matches_kernel(report, else_expression, node.auxiliary, depth + 1)
                Ast::Expr.Move(operand, _):
                    return node.kind == "move" and proof_replay_ast_matches_kernel(report, operand, node.left, depth + 1)
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return false if node.kind != "call" or node.auxiliary != argument_names.count or node.children_count != arguments.count
                    return false if node.children_start > report.kernel_children.count or node.children_count > report.kernel_children.count - node.children_start
                    return false if not proof_replay_ast_matches_kernel(report, callee, node.left, depth + 1)
                    for index in 0..<arguments.count |index, report, node, arguments, argument_names, depth|:
                        argument_root: usize = report.kernel_children[node.children_start + index]
                        return false if argument_root >= report.kernel_nodes.count
                        argument_node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[argument_root]
                        expected_name: sview = argument_names[index] if index < argument_names.count else ""
                        return false if argument_node.kind != "call_arg" or argument_node.name != expected_name or not proof_replay_ast_matches_kernel(report, arguments[index], argument_node.left, depth + 1)
                    return true
                Ast::Expr.Field(object, field, _):
                    return node.kind == "field" and node.name == field and proof_replay_ast_matches_kernel(report, object, node.left, depth + 1)
                Ast::Expr.Scope(base, field, _):
                    return node.kind == "scope" and node.name == field and proof_replay_ast_matches_kernel(report, base, node.left, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return node.kind == "index" and proof_replay_ast_matches_kernel(report, object, node.left, depth + 1) and proof_replay_ast_matches_kernel(report, index, node.right, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return node.kind == "slice" and proof_replay_ast_matches_kernel(report, object, node.left, depth + 1) and proof_replay_ast_matches_kernel(report, low, node.right, depth + 1) and proof_replay_ast_matches_kernel(report, high, node.auxiliary, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if arguments.count == 0 or node.kind != "index-n" or node.children_count != arguments.count
                    return false if node.children_start > report.kernel_children.count or node.children_count > report.kernel_children.count - node.children_start
                    return false if not proof_replay_ast_matches_kernel(report, object, node.left, depth + 1)
                    for index in 0..<arguments.count |index, report, node, arguments, depth|:
                        return false if not proof_replay_ast_matches_kernel(report, arguments[index], report.kernel_children[node.children_start + index], depth + 1)
                    return true
                Ast::Expr.Array(elements, _):
                    return proof_replay_ast_list_matches_kernel(report, elements, node, "array", depth)
                Ast::Expr.Tuple(elements, _):
                    return proof_replay_ast_list_matches_kernel(report, elements, node, "tuple", depth)
                Ast::Expr.SetLit(elements, _):
                    return proof_replay_ast_list_matches_kernel(report, elements, node, "set", depth)
                Ast::Expr.DictLit(entries, _):
                    return false if node.kind != "dict" or node.children_count != entries.count or node.children_start > report.kernel_children.count or node.children_count > report.kernel_children.count - node.children_start
                    for index in 0..<entries.count |index, report, node, entries, depth|:
                        entry_root: usize = report.kernel_children[node.children_start + index]
                        return false if entry_root >= report.kernel_nodes.count
                        entry_node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[entry_root]
                        return false if entry_node.kind != "dict_entry" or not proof_replay_ast_matches_kernel(report, entries[index].key, entry_node.left, depth + 1) or not proof_replay_ast_matches_kernel(report, entries[index].value, entry_node.right, depth + 1)
                    return true
                Ast::Expr.Construct(type_expression, fields, _):
                    return proof_replay_ast_fields_match_kernel(report, type_expression, fields, node, "construct", depth)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return proof_replay_ast_fields_match_kernel(report, base, fields, node, "record-update", depth)
                Ast::Expr.Block(statements, value, captures, _):
                    return false if captures.count != 0 or statements.count == 0 or statements.count > ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS or node.kind != "quantifier" or node.auxiliary != statements.count
                    source_kind: sview = proof_quantifier_kind(expression, report.source_annotations)
                    return false if source_kind == "" or node.operator != source_kind
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, type_expression, range_expression, _):
                            return false if binder == "" or not proof_kernel_expression_supported(type_expression) or node.name != binder or not proof_replay_ast_matches_kernel(report, range_expression, node.left, depth + 1) or not proof_replay_ast_matches_kernel(report, value, node.right, depth + 1)
                        _:
                            return false
                    if statements.count == ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS:
                        match statements[1]:
                            # The second dictionary binder is parser-synthesized with an
                            # unencoded zero initializer. Require that exact placeholder so the
                            # source mirror cannot agree with a kernel term that erased a hidden
                            # call or other initializer.
                            Ast::Stmt.VarDecl(binder, type_expression, Ast::Expr.IntLit(initializer, _), _):
                                return initializer == 0 and binder != "" and binder != node.name and node.secondary_name == binder and proof_kernel_expression_supported(type_expression)
                            _:
                                return false
                    return node.secondary_name == ""
                _:
                    return false

        def proof_replay_ast_list_matches_kernel(report: ProofReport&, elements: darray[Ast::Expr]&, node: ElisaProofKernelCore::ProofKernelNode, kind: sview, depth: usize) -> bool:
            return false if node.kind != kind or node.children_count != elements.count or node.children_start > report.kernel_children.count or node.children_count > report.kernel_children.count - node.children_start
            for index in 0..<elements.count |index, report, node, elements, depth|:
                return false if not proof_replay_ast_matches_kernel(report, elements[index], report.kernel_children[node.children_start + index], depth + 1)
            return true

        def proof_replay_ast_fields_match_kernel(report: ProofReport&, base: Ast::Expr, fields: darray[Ast::FieldInit]&, node: ElisaProofKernelCore::ProofKernelNode, kind: sview, depth: usize) -> bool:
            return false if node.kind != kind or node.children_count != fields.count or node.children_start > report.kernel_children.count or node.children_count > report.kernel_children.count - node.children_start
            return false if not proof_replay_ast_matches_kernel(report, base, node.left, depth + 1)
            for index in 0..<fields.count |index, report, node, fields, depth|:
                field_root: usize = report.kernel_children[node.children_start + index]
                return false if field_root >= report.kernel_nodes.count
                field_node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[field_root]
                return false if field_node.kind != "field-init" or field_node.name != fields[index].name or not proof_replay_ast_matches_kernel(report, fields[index].value, field_node.left, depth + 1)
            return true

        # The source-neutral trace validator mirrors the source trace policy, but its logical
        # step check is performed entirely by kernel_replay.elisa. Runtime and summary facts are
        # explicit semantic boundaries; they are still required to have a well-formed lowered
        # term and summary dependencies are recursively checked by the existing SCC-aware path.
        def proof_replay_kernel_fact_trace_is_valid_with_stack[@r](report: mutable ProofReport& @r, trace: ProofFactTrace, owner: sview, depth: usize, dependency_stack: darray[sview]&, revalidate_arena: bool, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            return false if trace.name != owner or not proof_replay_kernel_trace_range_valid(report, trace)
            return false if not proof_replay_ast_matches_kernel(report, trace.expression, trace.kernel_expression, 0)
            return false if trace.premises_count != trace.kernel_premises_count
            return false if trace.premises_start > report.fact_trace_premises.count or trace.premises_count > report.fact_trace_premises.count - trace.premises_start
            kernel_premises: mutable darray[usize] = []
            for index in 0..<trace.premises_count |index, report, trace, kernel_premises|:
                kernel_premise: usize = report.kernel_fact_trace_premises[trace.kernel_premises_start + index]
                return false if not proof_replay_ast_matches_kernel(report, report.fact_trace_premises[trace.premises_start + index], kernel_premise, 0)
                kernel_premises.push(kernel_premise)
            # Boundary facts do not require a logical derivation, but their serialized terms are
            # still untrusted input. Admit the complete reachable graph before any early return so
            # hidden fields, malformed child slices, cycles, and unsupported nodes fail closed.
            # A fact-trace entry is a public revalidation boundary. The batch certificate pass
            # may admit its arena once for the duration of that pass, but callers can retain a
            # mutable report and alter its serialized nodes afterwards. Never let that cached
            # bit turn a post-mutation fact trace into trusted evidence.
            return false if (revalidate_arena or not report.kernel_arena_validated) and not ElisaProofKernelReplay::proof_kernel_replay_arena_report_with_workspace(&report.kernel_nodes, &report.kernel_children, kernel_premises, trace.kernel_expression, validation_workspace)
            if trace.kind == "required-reference-parameter":
                return proof_replay_required_reference_trace_valid(report, trace)
            if proof_replay_boundary_trace_kind(trace.kind):
                return proof_replay_boundary_trace_shape_valid(report, trace)
            validation_workspace.trace_stack_touched <- true if trace.kind == "lemma-summary" or trace.kind == "function-summary"
            if trace.kind == "lemma-summary":
                return proof_replay_lemma_summary_is_valid(report, trace, dependency_stack, depth, active_certificates, validation_workspace) and proof_replay_dependency_is_checked(report, trace.dependency, 0, dependency_stack, depth, active_certificates, validation_workspace)
            if trace.kind == "function-summary":
                return proof_replay_function_summary_is_valid(report, trace, dependency_stack, depth, active_certificates, validation_workspace) and proof_replay_dependency_is_checked(report, trace.dependency, trace.owner_line, dependency_stack, depth, active_certificates, validation_workspace)
            return false if trace.kind != "proof-step" and trace.kind != "lemma-step" and trace.kind != "loop-invariant-step" and trace.kind != "branch-conjunct" and trace.kind != "unit-resolution" and trace.kind != "branch-join"
            return false if depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            for premise in kernel_premises |premise, report, owner, depth, dependency_stack, revalidate_arena, active_certificates, validation_workspace|:
                found: mutable bool = false
                candidate_index: mutable usize = proof_replay_fact_trace_head(report, owner)
                while candidate_index < report.fact_traces.count |candidate_index, premise, report, owner, depth, dependency_stack, found, revalidate_arena, active_certificates, validation_workspace|:
                    candidate: ProofFactTrace = report.fact_traces[candidate_index]
                    if candidate.kernel_expression < report.kernel_nodes.count and ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public(report.kernel_nodes, report.kernel_children, candidate.kernel_expression, premise, 0) and proof_replay_kernel_trace_valid_memo(report, candidate_index, owner, depth + 1, dependency_stack, revalidate_arena, active_certificates, validation_workspace):
                        found <- true
                        break
                    candidate_index <- proof_replay_trace_chain_next(report, candidate_index)
                return false if not found
            return ElisaProofKernelReplay::proof_kernel_replay_goal_report_with_workspace(&report.kernel_nodes, &report.kernel_children, kernel_premises, trace.kernel_expression, validation_workspace)

        def proof_replay_kernel_fact_root_is_traced_with_stack[@r](report: mutable ProofReport& @r, fact: usize, owner: sview, dependency_stack: darray[sview]&, revalidate_arena: bool, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            return false if fact >= report.kernel_nodes.count
            trace_index: mutable usize = proof_replay_fact_trace_head(report, owner)
            while trace_index < report.fact_traces.count |trace_index, report, fact, owner, dependency_stack, revalidate_arena, active_certificates, validation_workspace|:
                trace: ProofFactTrace = report.fact_traces[trace_index]
                return true if trace.kernel_expression < report.kernel_nodes.count and ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public(report.kernel_nodes, report.kernel_children, trace.kernel_expression, fact, 0) and proof_replay_kernel_trace_valid_memo(report, trace_index, owner, 0, dependency_stack, revalidate_arena, active_certificates, validation_workspace)
                trace_index <- proof_replay_trace_chain_next(report, trace_index)
            return false

        # Resource-disjoint transitions carry their own logical premises inside the resource
        # trace because the resource certificate has no ordinary top-level proposition. Those
        # premise roots are still required to correspond to facts explicitly introduced by the
        # source checker. This closes the provenance gap that would otherwise let a structurally
        # replayable resource event smuggle in a fabricated inequality.
        def proof_replay_resource_event_facts_with_owner[@r](report: mutable ProofReport& @r, root: usize, owner: sview, dependency_stack: darray[sview]&, depth: usize, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            return false if depth >= PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT or root >= report.kernel_nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[root]
            active_owner: mutable sview = owner
            active_owner <- node.name if node.kind == "resource-safety" and node.name != ""
            if node.kind == "resource-disjoint":
                return false if node.children_start > report.kernel_children.count or node.children_count > report.kernel_children.count - node.children_start
                for index in 0..<node.children_count |index, node, report, active_owner, dependency_stack, active_certificates, validation_workspace|:
                    fact: usize = report.kernel_children[node.children_start + index]
                    return false if not proof_replay_kernel_fact_root_is_traced_with_stack(report, fact, active_owner, dependency_stack, false, active_certificates, validation_workspace)
                return true
            if node.kind == "resource-safety" or node.kind == "resource-scope":
                return false if node.children_start > report.kernel_children.count or node.children_count > report.kernel_children.count - node.children_start
                for index in 0..<node.children_count |index, node, report, active_owner, dependency_stack, depth, active_certificates, validation_workspace|:
                    child: usize = report.kernel_children[node.children_start + index]
                    return false if not proof_replay_resource_event_facts_with_owner(report, child, active_owner, dependency_stack, depth + 1, active_certificates, validation_workspace)
                return true
            if node.kind == "resource-call":
                return proof_replay_resource_event_facts_with_owner(report, node.left, node.name, dependency_stack, depth + 1, active_certificates, validation_workspace)
            # This helper is a provenance boundary, not merely a traversal convenience. The
            # resource kernel may know more node kinds in a future format revision, but an older
            # replay implementation must not silently bless one as fact-free. Every supported
            # leaf is listed explicitly; unknown or newly introduced nodes fail closed until this
            # checker has been taught their embedded-fact semantics.
            if node.kind == "resource-region-open" or node.kind == "resource-region-close" or node.kind == "resource-region-alloc" or node.kind == "resource-region-bind" or node.kind == "resource-sview-param" or node.kind == "resource-region-alloc-discard" or node.kind == "resource-region-return-alloc" or node.kind == "resource-region-call-alloc" or node.kind == "resource-region-rebind-alloc" or node.kind == "resource-region-assign" or node.kind == "resource-region-return" or node.kind == "resource-region-param" or node.kind == "resource-write" or node.kind == "resource-move" or node.kind == "resource-use" or node.kind == "resource-join-move" or node.kind == "resource-call-arg" or node.kind == "resource-call-formal" or node.kind == "resource-call-region" or node.kind == "resource-call-result" or node.kind == "resource-call-lend" or node.kind == "resource-bind":
                return true
            return false

        # A certificate may only replay facts that the source checker explicitly introduced.
        # Derived proof steps are not accepted as axioms: their captured premises are themselves
        # traced and the independent logical kernel must re-prove the step from those premises.
        # The trace payload is deliberately checked with this module's structural equality, not
        # the main checker helper, so replay does not inherit its implementation by reference.
        def proof_replay_fact_trace_is_valid_with_stack(report: mutable ProofReport&, trace: ProofFactTrace, owner: sview, depth: usize, dependency_stack: darray[sview]&, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            return false if trace.name != owner or not proof_replay_trace_range_valid(report, trace)
            if trace.kind == "required-reference-parameter":
                return proof_replay_required_reference_trace_valid(report, trace)
            if proof_replay_boundary_trace_kind(trace.kind):
                return proof_replay_boundary_trace_shape_valid(report, trace)
            validation_workspace.trace_stack_touched <- true if trace.kind == "lemma-summary" or trace.kind == "function-summary"
            if trace.kind == "lemma-summary":
                return proof_replay_lemma_summary_is_valid(report, trace, dependency_stack, depth, active_certificates, validation_workspace) and proof_replay_dependency_is_checked(report, trace.dependency, 0, dependency_stack, depth, active_certificates, validation_workspace)
            if trace.kind == "function-summary":
                return proof_replay_function_summary_is_valid(report, trace, dependency_stack, depth, active_certificates, validation_workspace) and proof_replay_dependency_is_checked(report, trace.dependency, trace.owner_line, dependency_stack, depth, active_certificates, validation_workspace)
            return false if trace.kind != "proof-step" and trace.kind != "lemma-step" and trace.kind != "loop-invariant-step" and trace.kind != "branch-conjunct" and trace.kind != "unit-resolution" and trace.kind != "branch-join"
            return false if depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            premises: mutable darray[Ast::Expr] = []
            for index in 0..<trace.premises_count |index, premises, report, trace|:
                premises.push(report.fact_trace_premises[trace.premises_start + index])
            for premise in premises |premise, report, owner, depth, dependency_stack, active_certificates, validation_workspace|:
                found: mutable bool = false
                candidate_index: mutable usize = proof_replay_fact_trace_head(report, owner)
                while candidate_index < report.fact_traces.count |candidate_index, premise, owner, depth, dependency_stack, found, active_certificates, validation_workspace|:
                    candidate: ProofFactTrace = report.fact_traces[candidate_index]
                    if proof_replay_expr_equal(candidate.expression, premise) and proof_replay_trace_valid_memo(report, candidate_index, owner, depth + 1, dependency_stack, active_certificates, validation_workspace):
                        found <- true
                        break
                    candidate_index <- proof_replay_trace_chain_next(report, candidate_index)
                return false if not found
            return proof_replay_goal(premises, trace.expression)

include "./certificate_validation_integrated_helpers.elisa"
