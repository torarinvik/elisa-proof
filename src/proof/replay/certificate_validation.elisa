                return proof_replay_resource_local_value_bind_source_valid_with_work(report, resource_root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind in {"resource-region-param", "resource-sview-param"}:
                return proof_replay_resource_owner_prefix_event_valid_with_work(report, resource_root, root, active_resource_prefix_end, validation_workspace.source_scan_work_used)
            # These transitions still lack a source bridge to their exact owner AST operation.
            # Arena shape validation alone cannot authenticate their capability or payload.
