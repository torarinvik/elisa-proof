        # A certificate may only replay facts that the source checker explicitly introduced.
        # Derived proof steps are not accepted as axioms: their captured premises are themselves
        # traced and the independent logical kernel must re-prove the step from those premises.
        # The trace payload is deliberately checked with this module's structural equality, not
        # the main checker helper, so replay does not inherit its implementation by reference.
        def proof_replay_fact_trace_is_valid_with_stack(report: mutable ProofReport&, trace: ProofFactTrace, trace_index: usize, owner: sview, depth: usize, dependency_stack: darray[sview]&, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            return false if:
                trace.name != owner or not proof_replay_trace_range_valid(report, trace)
                not proof_replay_trace_owner_matches_consumer_with_work(report, trace, trace_index, owner, validation_workspace.source_scan_work_used, structural_cache)
            trace_kind_work: usize = sview_len(trace.kind)
            if validation_workspace.source_scan_work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or trace_kind_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used:
                validation_workspace.source_scan_work_used <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + trace_kind_work
            if trace.kind == "required-reference-parameter":
                return (proof_replay_required_reference_trace_valid_with_work(report, trace, validation_workspace.source_scan_work_used) can Global{Read,Write})
            if proof_replay_boundary_trace_kind(trace.kind):
                return (proof_replay_boundary_trace_shape_valid_with_cache(report, trace, validation_workspace.source_scan_work_used, structural_cache) can Global{Read,Write})
            return true if trace.kind == "proof-step" and proof_replay_pop_scalar_snapshot_source(report, trace)
            validation_workspace.trace_stack_touched <- true if trace.kind in {"lemma-summary", "function-summary"}
            if trace.kind == "lemma-summary":
                return (proof_replay_lemma_summary_is_valid(report, trace, dependency_stack, depth, active_certificates, validation_workspace, structural_cache) can Global{Read,Write}) and (proof_replay_dependency_is_checked(report, trace.dependency, 0, dependency_stack, depth, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            if trace.kind == "function-summary":
                return (proof_replay_function_summary_is_valid(report, trace, dependency_stack, depth, active_certificates, validation_workspace, structural_cache) can Global{Read,Write}) and (proof_replay_dependency_is_checked(report, trace.dependency, trace.owner_line, dependency_stack, depth, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            return false if:
                trace.kind != "proof-step" and trace.kind != "lemma-step" and trace.kind != "loop-invariant-step" and trace.kind != "branch-conjunct" and trace.kind != "unit-resolution" and trace.kind != "branch-join"
                depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            premises: mutable darray[Ast::Expr] = []
            for index in 0..<trace.premises_count |index, premises, report, trace|:
                premises.push(report.analysis_1.traces.premises[trace.premises_start + index])
            for premise in premises |premise, report, owner, depth, dependency_stack, active_certificates, validation_workspace|:
                found: mutable bool = false
                candidate_index: mutable usize = proof_replay_fact_trace_head(report, owner)
                while candidate_index < report.analysis_1.traces.records.count |candidate_index, premise, owner, depth, dependency_stack, found, active_certificates, validation_workspace|:
                    candidate: ProofFactTrace = report.analysis_1.traces.records[candidate_index]
                    return false if:
                        not proof_replay_trace_lookup_charge_amount(report, sview_len(candidate.name))
                        not proof_replay_trace_expression_equality_work(report, premise)
                        not proof_replay_trace_expression_equality_work(report, candidate.expression)
                    if proof_replay_expr_equal_depth(candidate.expression, premise, 0) and (proof_replay_trace_valid_memo(report, candidate_index, owner, depth + 1, dependency_stack, active_certificates, validation_workspace, structural_cache) can Global{Read,Write}):
                        found <- true
                        break
                    candidate_index <- proof_replay_trace_chain_next(report, candidate_index)
                return false if not found
            return proof_replay_goal(premises, trace.expression, validation_workspace.source_goal_work_used)

