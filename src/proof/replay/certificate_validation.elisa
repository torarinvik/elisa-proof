            # checker has been taught their embedded-fact semantics.
            if node.kind == "resource-call-lend":
                return proof_replay_resource_call_site_matches_owner_with_work(report, resource_root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind == "resource-write":
                return proof_replay_resource_write_source_valid_with_work(report, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind == "resource-use" or node.kind == "resource-move":
                return proof_replay_resource_use_or_move_source_valid_with_work(report, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind in {"resource-region-open", "resource-region-close"}:
                return proof_replay_resource_region_scope_event_source_valid_with_work(report, root, resource_root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind == "resource-region-return":
                return proof_replay_resource_return_marker_matches_owner_with_work(report, node, active_owner, active_owner_line, active_owner_offset, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind == "resource-region-return-alloc":
                return proof_replay_resource_return_alloc_source_valid_with_work(report, resource_root, root, active_owner, active_owner_line, active_owner_offset, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind == "resource-region-alloc-discard":
                return proof_replay_resource_discard_allocation_source_valid_with_work(report, resource_root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind == "resource-region-assign":
                return proof_replay_resource_region_assignment_source_valid_with_work(report, resource_root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
            if node.kind == "resource-region-alloc":
                return proof_replay_resource_region_alloc_source_valid_with_work(report, resource_root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache) can Global{Read,Write}
            if node.kind == "resource-region-rebind-alloc":
                return proof_replay_resource_region_rebind_alloc_source_valid_with_work(report, resource_root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache) can Global{Read,Write}
            if node.kind == "resource-region-call-alloc":
                return proof_replay_resource_call_allocation_source_valid_with_work(report, resource_root, root, node, active_owner, active_owner_line, active_owner_offset, active_owner_module, validation_workspace.source_scan_work_used, structural_cache)
