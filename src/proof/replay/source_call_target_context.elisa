# Build call-resolution context from the replay-owned source snapshot. The caller identity is
# the exact declaration name/module/line/offset selected by the declaration index; generic
# resolution uses that same module and source coordinate tuple.
extend ElisaProof:
    private:
        def proof_replay_collection_name_shadowed_in(declarations: darray[Ast::Decl]&, work: mutable usize&, depth: usize) -> bool:
            return true if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for declaration in declarations |work, depth|:
                return true if not proof_replay_call_work_add(work, 1)
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, _) | Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return true if not proof_replay_call_work_add(work, sview_len(name))
                        return true if name in {"push", "extend", "clear", "resize", "pop", "truncate"}
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_collection_name_shadowed_in(nested, work, depth + 1)
                    _:
                        pass
            false

        def proof_replay_collection_name_shadowed(scratch: mutable ProofReport&, work: mutable usize&) -> bool:
            return scratch.source.collection_method_name_shadowed if scratch.source.collection_method_name_shadow_checked
            shadowed: bool = proof_replay_collection_name_shadowed_in(scratch.source.source_declarations, work, 0)
            scratch.source.collection_method_name_shadowed <- shadowed
            scratch.source.collection_method_name_shadow_checked <- true
            shadowed

        def proof_replay_source_call_target_context(parameters: darray[Ast::ParamDecl]&, annotations: darray[Ast::EnumAnnotation]&, scratch: mutable ProofReport&, caller_name: sview, caller_module: sview, caller_line: u32, caller_offset: usize, source_work: mutable usize&, preserve_occurrences: bool = false, include_projected_fields: bool = false) -> ProofReplayCallSiteTarget:
            target: mutable ProofReplayCallSiteTarget = ProofReplayCallSiteTarget{selection: ProofReplayCallSiteTargetSelection{enabled: false, ignore_unmatched_scoped_edges: false, allow_scoped_target: false, include_nonassert_contract_calls: true, offset: caller_offset, line: caller_line, name: caller_name, calls_at_offset: 0, matched_calls: 0, track_unresolved_dispatch: true, unresolved_dispatch_found: false, source_annotations: annotations}, conversions: ProofReplayCallSiteTargetConversions{field_conversion_parameters: parameters, field_conversion_names: scratch.source_types.source_effect_index.conversions.field_conversion_names, field_conversion_index_valid: scratch.source_types.source_effect_index.conversions.field_conversion_index_valid, field_conversion_index_hashes: scratch.source_types.source_effect_index.conversions.field_conversion_index_hashes, field_conversion_index_values: scratch.source_types.source_effect_index.conversions.field_conversion_index_values, field_conversion_index_counts: scratch.source_types.source_effect_index.conversions.field_conversion_index_counts, field_conversion_custom_cast_present: scratch.source_types.source_effect_index.conversions.field_conversion_custom_cast_present}, aliases: ProofReplayCallSiteTargetAliases{field_conversion_alias_names: scratch.source_types.source_effect_index.aliases.alias_names, field_conversion_alias_targets: scratch.source_types.source_effect_index.aliases.alias_targets, field_conversion_alias_lines: scratch.source_types.source_effect_index.aliases.alias_lines, field_conversion_bare_alias_root_fallback_valid: scratch.source_types.source_effect_index.aliases.bare_alias_root_fallback_valid, field_conversion_alias_owners: scratch.source_types.source_effect_index.aliases.alias_owners, field_conversion_alias_has_formals: scratch.source_types.source_effect_index.aliases.alias_has_formals, field_conversion_alias_generic_formal_names: scratch.source_types.source_effect_index.aliases.alias_generic_formal_names, field_conversion_alias_generic_formal_starts: scratch.source_types.source_effect_index.aliases.alias_generic_formal_starts, field_conversion_alias_generic_formal_counts: scratch.source_types.source_effect_index.aliases.alias_generic_formal_counts, field_conversion_alias_generic_application_valid: scratch.source_types.source_effect_index.aliases.alias_generic_application_valid, field_conversion_alias_scope_index_valid: scratch.source_types.source_effect_index.aliases.alias_scope_index_valid, field_conversion_alias_scope_index_hashes: scratch.source_types.source_effect_index.aliases.alias_scope_index_hashes, field_conversion_alias_scope_index_values: scratch.source_types.source_effect_index.aliases.alias_scope_index_values, field_conversion_alias_scope_index_counts: scratch.source_types.source_effect_index.aliases.alias_scope_index_counts, field_conversion_alias_index_valid: scratch.source_types.source_effect_index.aliases.alias_index_valid, field_conversion_alias_index_hashes: scratch.source_types.source_effect_index.aliases.alias_index_hashes, field_conversion_alias_index_values: scratch.source_types.source_effect_index.aliases.alias_index_values, field_conversion_alias_index_counts: scratch.source_types.source_effect_index.aliases.alias_index_counts}, generics: ProofReplayCallSiteTargetGenerics{field_conversion_generic_params_valid: scratch.source_types.source_generic_params_valid and scratch.source_types.source_generic_param_lines.count == scratch.source_types.source_generic_param_names.count, field_conversion_generic_param_lines: scratch.source_types.source_generic_param_lines, field_conversion_generic_param_names: scratch.source_types.source_generic_param_names, field_conversion_generic_param_owner_offsets: scratch.source_types.source_generic_param_owner_offsets, field_conversion_generic_param_owner_row_index_valid: scratch.source_types.source_effect_index.generics.generic_param_owner_row_index_valid, field_conversion_generic_param_owner_row_index_hashes: scratch.source_types.source_effect_index.generics.generic_param_owner_row_index_hashes, field_conversion_generic_param_owner_row_index_values: scratch.source_types.source_effect_index.generics.generic_param_owner_row_index_values, field_conversion_generic_param_owner_row_index_counts: scratch.source_types.source_effect_index.generics.generic_param_owner_row_index_counts, field_conversion_generic_param_owner_row_index_entries: scratch.source_types.source_effect_index.generics.generic_param_owner_row_index_entries, field_conversion_generic_param_owner_row_lines: scratch.source_types.source_effect_index.generics.generic_param_owner_row_lines, field_conversion_generic_param_owner_row_offsets: scratch.source_types.source_effect_index.generics.generic_param_owner_row_offsets, field_conversion_generic_param_owner_row_names: scratch.source_types.source_effect_index.generics.generic_param_owner_row_names, field_conversion_generic_param_line: caller_line, field_conversion_generic_param_owner: caller_module, field_conversion_generic_param_owner_known: true, field_conversion_generic_param_owner_offset: caller_offset, field_conversion_generic_param_owner_offset_valid: true, field_conversion_generic_param_index_valid: scratch.source_types.source_effect_index.generics.generic_param_line_index_valid, field_conversion_generic_param_index_hashes: scratch.source_types.source_effect_index.generics.generic_param_line_index_hashes, field_conversion_generic_param_index_values: scratch.source_types.source_effect_index.generics.generic_param_line_index_values, field_conversion_generic_param_index_counts: scratch.source_types.source_effect_index.generics.generic_param_line_index_counts, field_conversion_generic_owner_index_valid: scratch.source_types.source_effect_index.generics.generic_owner_index_valid, field_conversion_generic_owner_index_hashes: scratch.source_types.source_effect_index.generics.generic_owner_index_hashes, field_conversion_generic_owner_index_values: scratch.source_types.source_effect_index.generics.generic_owner_index_values, field_conversion_generic_owner_index_counts: scratch.source_types.source_effect_index.generics.generic_owner_index_counts, field_conversion_generic_owner_index_entries: scratch.source_types.source_effect_index.generics.generic_owner_index_entries, field_conversion_generic_function_index_valid: scratch.source_types.source_effect_index.generics.generic_function_index_valid, field_conversion_generic_function_index_hashes: scratch.source_types.source_effect_index.generics.generic_function_index_hashes, field_conversion_generic_function_index_values: scratch.source_types.source_effect_index.generics.generic_function_index_values, field_conversion_generic_function_index_counts: scratch.source_types.source_effect_index.generics.generic_function_index_counts, field_conversion_generic_function_index_entries: scratch.source_types.source_effect_index.generics.generic_function_index_entries}, types: ProofReplayCallSiteTargetTypes{field_conversion_declared_types: scratch.source_types.source_effect_index.types.declared_types, field_conversion_declared_type_owners: scratch.source_types.source_effect_index.types.declared_type_owners, field_conversion_declared_type_generic_formal_counts: scratch.source_types.source_effect_index.types.declared_type_generic_formal_counts, field_conversion_declared_type_generic_formal_counts_valid: scratch.source_types.source_effect_index.types.declared_type_generic_formal_counts_valid, field_conversion_declared_type_scope_index_valid: scratch.source_types.source_effect_index.types.declared_type_scope_index_valid, field_conversion_declared_type_scope_index_hashes: scratch.source_types.source_effect_index.types.declared_type_scope_index_hashes, field_conversion_declared_type_scope_index_values: scratch.source_types.source_effect_index.types.declared_type_scope_index_values, field_conversion_declared_type_scope_index_counts: scratch.source_types.source_effect_index.types.declared_type_scope_index_counts, field_conversion_declared_type_index_valid: scratch.source_types.source_effect_index.types.declared_type_index_valid, field_conversion_declared_type_index_hashes: scratch.source_types.source_effect_index.types.declared_type_index_hashes, field_conversion_declared_type_index_values: scratch.source_types.source_effect_index.types.declared_type_index_values, field_conversion_declared_type_index_counts: scratch.source_types.source_effect_index.types.declared_type_index_counts}}
            target.capture.preserve_call_occurrences <- preserve_occurrences
            target.aliases.field_conversion_alias_generic_formal_owner_rows <- scratch.source_types.source_effect_index.aliases.alias_generic_formal_owner_rows
            target.aliases.field_conversion_alias_generic_formal_name_index_hashes <- scratch.source_types.source_effect_index.aliases.alias_generic_formal_name_index_hashes
            target.aliases.field_conversion_alias_generic_formal_name_index_values <- scratch.source_types.source_effect_index.aliases.alias_generic_formal_name_index_values
            target.aliases.field_conversion_alias_generic_formal_name_index_counts <- scratch.source_types.source_effect_index.aliases.alias_generic_formal_name_index_counts
            target.aliases.field_conversion_alias_generic_formal_name_index_valid <- scratch.source_types.source_effect_index.aliases.alias_generic_formal_name_index_valid
            if include_projected_fields:
                declaration_count: usize = scratch.source.source_declarations.count
                return target if not proof_replay_call_work_add(source_work, declaration_count) or not proof_replay_call_work_add(source_work, declaration_count)
                target.capture.source_declarations <- scratch.source.source_declarations
            target.conversions.field_dispatch_imports_present <- scratch.source_types.source_effect_index.conversions.field_dispatch_imports_present
            target.conversions.collection_method_name_shadowed <- proof_replay_collection_name_shadowed(scratch, source_work)
            return target
