# Bounded open-addressed lookup for deterministic cast-site cache rows. Exact owner equality
# remains authoritative after the composite hash selects a probe sequence.
extend ElisaProof:
    private:
        const PROOF_REPLAY_CAST_SITE_INDEX_MAX_CLUSTER: usize = 64
        const PROOF_REPLAY_CAST_SITE_INDEX_INITIAL_CAPACITY: usize = 16

        def proof_replay_cast_site_owner_key_hash(owner: sview, owner_line: u32, owner_offset: usize, owner_offset_valid: bool, trace_owner_line: u32, consumer_certificate_index: usize, consumer_attempt_index: usize, work: mutable usize&, complete: mutable bool&) -> (valid: bool, hash: u32):
            return (false, 0) if not proof_replay_deterministic_call_match_text_charge(owner, work, complete)
            return (false, 0) if not proof_replay_deterministic_call_match_charge(5, work, complete)
            hash: u32 = proof_expr_shape_mix(proof_name_hash(owner), owner_line.i64())
            hash <- proof_expr_shape_mix(hash, owner_offset.i64())
            hash <- proof_expr_shape_mix(hash, 1 if owner_offset_valid else 0)
            hash <- proof_expr_shape_mix(hash, trace_owner_line.i64())
            hash <- proof_expr_shape_mix(hash, consumer_certificate_index.i64())
            (true, proof_expr_shape_mix(hash, consumer_attempt_index.i64()))

        def proof_replay_cast_site_owner_index_probe(cache: ProofReplayDeterministicCallReplayCache&, owner: sview, owner_line: u32, owner_offset: usize, owner_offset_valid: bool, trace_owner_line: u32, consumer_certificate_index: usize, consumer_attempt_index: usize, key_hash: u32, work: mutable usize&, complete: mutable bool&) -> (valid: bool, found: bool, row_index: usize, empty_slot: usize):
            can Abort.Panic:
                capacity: usize = cache.cast_site_owner_bucket_values.count
                return (false, false, 0, 0) if not cache.cast_site_owner_index_valid or capacity == 0 or cache.cast_site_owner_bucket_occupied.count != capacity
                slot: mutable usize = (key_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes < PROOF_REPLAY_CAST_SITE_INDEX_MAX_CLUSTER |probes, slot, cache, owner, owner_line, owner_offset, owner_offset_valid, trace_owner_line, consumer_certificate_index, consumer_attempt_index, key_hash, work, complete, capacity|:
                    return (false, false, 0, 0) if not proof_replay_deterministic_call_match_charge(1, work, complete)
                    if not cache.cast_site_owner_bucket_occupied[slot]:
                        return (true, false, 0, slot)
                    row_index: usize = cache.cast_site_owner_bucket_values[slot]
                    return (false, false, 0, 0) if row_index >= cache.cast_site_owners.count
                    row: ProofReplayDeterministicCastSiteOwner = cache.cast_site_owners[row_index]
                    if row.key_hash == key_hash and row.owner_line == owner_line and row.owner_offset == owner_offset and row.owner_offset_valid == owner_offset_valid and row.trace_owner_line == trace_owner_line and row.consumer_certificate_index == consumer_certificate_index and row.consumer_attempt_index == consumer_attempt_index:
                        same_owner: bool = proof_replay_deterministic_call_match_text_equal(row.owner, owner, work, complete)
                        return (false, false, 0, 0) if not proof_goal_bool_ref_value(complete)
                        return (true, true, row_index, slot) if same_owner
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return (false, false, 0, 0)

        def proof_replay_cast_site_owner_index_reserve(cache: mutable ProofReplayDeterministicCallReplayCache&, required_rows: usize, work: mutable usize&, complete: mutable bool&) -> bool:
            return false if required_rows == 0 or required_rows > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT / 2
            current_capacity: usize = cache.cast_site_owner_bucket_values.count
            return false if cache.cast_site_owner_bucket_occupied.count != current_capacity
            wanted_capacity: mutable usize = PROOF_REPLAY_CAST_SITE_INDEX_INITIAL_CAPACITY
            while wanted_capacity / 2 < required_rows |wanted_capacity, required_rows|:
                return false if wanted_capacity > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT / 2
                wanted_capacity <- wanted_capacity * 2
            return true if cache.cast_site_owner_index_valid and current_capacity >= wanted_capacity
            new_capacity: mutable usize = wanted_capacity
            new_capacity <- current_capacity if current_capacity > new_capacity
            return false if:
                new_capacity == 0 or new_capacity > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
                not proof_replay_deterministic_call_match_charge(new_capacity, work, complete)
                not proof_replay_deterministic_call_match_charge(new_capacity, work, complete)
                not proof_replay_deterministic_call_match_charge(new_capacity, work, complete)
            cache.cast_site_owner_index_valid <- false
            cache.cast_site_owner_bucket_values.resize(new_capacity)
            cache.cast_site_owner_bucket_occupied.resize(new_capacity)
            for slot in 0..<new_capacity |slot, cache|:
                cache.cast_site_owner_bucket_occupied[slot] <- false
            for row_index in 0..<cache.cast_site_owners.count |row_index, cache, new_capacity, work, complete|:
                return false if not proof_replay_deterministic_call_match_charge(1, work, complete)
                row: ProofReplayDeterministicCastSiteOwner = cache.cast_site_owners[row_index]
                slot: mutable usize = (row.key_hash.i64() % new_capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < new_capacity and probes < PROOF_REPLAY_CAST_SITE_INDEX_MAX_CLUSTER |probes, slot, cache, row, row_index, work, complete, new_capacity|:
                    return false if not proof_replay_deterministic_call_match_charge(1, work, complete)
                    break if not cache.cast_site_owner_bucket_occupied[slot]
                    slot <- (slot + 1) % new_capacity
                    probes <- probes + 1
                return false if probes >= PROOF_REPLAY_CAST_SITE_INDEX_MAX_CLUSTER or cache.cast_site_owner_bucket_occupied[slot]
                cache.cast_site_owner_bucket_values[slot] <- row_index
                cache.cast_site_owner_bucket_occupied[slot] <- true
            cache.cast_site_owner_index_valid <- true
            return true

        def proof_replay_deterministic_validated_cast_sites_cached(report: mutable ProofReport&, owner: sview, sites: mutable darray[Ast::Expr]&, work: mutable usize&, complete: mutable bool&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if cache.cast_site_report_identity != report_identity or cache.cast_site_source_identity != source_identity:
                cache.cast_site_owners.clear()
                cache.cast_site_owner_bucket_values.clear()
                cache.cast_site_owner_bucket_occupied.clear()
                cache.cast_sites.clear()
                cache.cast_site_owner_index_valid <- false
                cache.cast_site_report_identity <- report_identity
                cache.cast_site_source_identity <- source_identity
            owner_line: mutable u32 = report.analysis_2.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            owner_offset: usize = report.analysis_2.replay_owner_offset
            owner_offset_valid: bool = report.analysis_2.replay_owner_offset_valid
            consumer_line: u32 = report.analysis_2.trace_owner_line
            consumer_certificate_index: usize = report.analysis_2.trace_consumer_certificate_index
            consumer_attempt_index: usize = report.analysis_2.trace_consumer_attempt_index
            key: (valid: bool, hash: u32) = proof_replay_cast_site_owner_key_hash(owner, owner_line, owner_offset, owner_offset_valid, consumer_line, consumer_certificate_index, consumer_attempt_index, work, complete)
            return false if not key.valid
            if cache.cast_site_owners.count == 0 or not cache.cast_site_owner_index_valid or cache.cast_site_owner_bucket_values.count == 0:
                return false if not proof_replay_cast_site_owner_index_reserve(cache, cache.cast_site_owners.count + 1, work, complete)
            lookup: (valid: bool, found: bool, row_index: usize, empty_slot: usize) = proof_replay_cast_site_owner_index_probe(cache, owner, owner_line, owner_offset, owner_offset_valid, consumer_line, consumer_certificate_index, consumer_attempt_index, key.hash, work, complete)
            return false if not lookup.valid
            if lookup.found:
                row: ProofReplayDeterministicCastSiteOwner = cache.cast_site_owners[lookup.row_index]
                return false if:
                    not row.complete or row.sites_start > cache.cast_sites.count or row.sites_count > cache.cast_sites.count - row.sites_start
                    not proof_replay_deterministic_call_match_charge(row.sites_count, work, complete)
                for offset in 0..<row.sites_count |offset, row, cache, sites|:
                    sites.push(cache.cast_sites[row.sites_start + offset])
                return true
            return false if not proof_replay_cast_site_owner_index_reserve(cache, cache.cast_site_owners.count + 1, work, complete)
            insertion: (valid: bool, found: bool, row_index: usize, empty_slot: usize) = proof_replay_cast_site_owner_index_probe(cache, owner, owner_line, owner_offset, owner_offset_valid, consumer_line, consumer_certificate_index, consumer_attempt_index, key.hash, work, complete)
            return false if:
                not insertion.valid or insertion.found
                not proof_replay_deterministic_call_match_charge(1, work, complete)
            row_index: usize = cache.cast_site_owners.count
            sites_start: usize = cache.cast_sites.count
            cache.cast_site_owners.push(ProofReplayDeterministicCastSiteOwner{owner: owner, owner_line: owner_line, owner_offset: owner_offset, owner_offset_valid: owner_offset_valid, trace_owner_line: consumer_line, consumer_certificate_index: consumer_certificate_index, consumer_attempt_index: consumer_attempt_index, key_hash: key.hash, sites_start: sites_start, sites_count: 0, complete: false})
            cache.cast_site_owner_bucket_values[insertion.empty_slot] <- row_index
            cache.cast_site_owner_bucket_occupied[insertion.empty_slot] <- true
            discovered: mutable darray[Ast::Expr] = []
            return false if:
                not proof_replay_deterministic_validated_cast_sites(report, owner, &discovered, work, complete)
                not proof_replay_deterministic_call_match_charge(discovered.count, work, complete)
            for site in discovered |site, cache, sites, complete|:
                cache.cast_sites.push(site)
                sites.push(site)
            cache.cast_site_owners[row_index].sites_count <- discovered.count
            cache.cast_site_owners[row_index].complete <- true
            return true
