extend ElisaProof:
    private:
        def proof_replay_resource_region_alloc_pointee_type(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, pointee: Ast::Expr):
            return (false, Ast::Expr.Invalid) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    proof_replay_resource_region_alloc_pointee_type(inner, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_resource_region_alloc_pointee_type(inner, source_work, depth + 1) if operator in {TokenKind.Ampersand, TokenKind.Lmut}
                    (true, expression)
                _:
                    (true, expression)

        def proof_replay_resource_region_alloc_source_valid_with_work(report: ProofReport&, resource_root: usize, event: ElisaProofKernelCore::ProofKernelNode, owner: sview, owner_line: u32, owner_offset: usize, owner_module: sview, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            return false if not proof_replay_owner_work_charge(sview_len(event.kind), source_work)
            return false if resource_root >= report.analysis_1.kernel.nodes.count or event.kind != "resource-region-alloc" or event.value <= 0 or event.value > 4294967295 or event.name == "" or event.secondary_name == "" or event.left >= report.analysis_1.kernel.nodes.count or owner == "" or owner_line == 0 or owner_offset > 4294967295
            return false if not proof_replay_owner_work_charge(sview_len(event.name), source_work) or not proof_replay_owner_work_charge(sview_len(event.secondary_name), source_work) or not proof_replay_owner_work_charge(sview_len(owner), source_work) or not proof_replay_owner_work_charge(sview_len(owner_module), source_work)
            positioned: (complete: bool, count: usize) = proof_replay_resource_event_count_in_root_with_work(report, report.analysis_1.kernel.nodes[resource_root], event.kind, event.value.usize(), event.name, source_work)
            return false if not positioned.complete or positioned.count != 1
            return false if not proof_replay_deterministic_call_declaration_index_ensure(report, source_work, &cache.deterministic_calls)
            caller: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.deterministic_calls.declaration_index, owner, owner_line, owner_offset, source_work)
            return false if not caller.complete or caller.matches != 1 or caller.row >= cache.deterministic_calls.declaration_index.entries.count
            entry: ProofReplayDeterministicDeclarationEntry = cache.deterministic_calls.declaration_index.entries[caller.row]
            return false if not proof_replay_owner_work_charge(sview_len(entry.owner), source_work)
            return false if entry.owner != owner_module
            body: mutable darray[Ast::Stmt] = []
            match entry.declaration:
                Ast::Decl.Func(_, _, _, declared_body, _, _, _):
                    body <- declared_body
                _:
                    return false
            matches: mutable usize = 0
            initializer: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, event.value.usize(), "resource-region-alloc-inventory", event.name, matches, initializer, source_work, 0)
            return false if matches != 1
            operand: mutable Ast::Expr = Ast::Expr.Invalid
            source_region: mutable sview = ""
            match initializer:
                Ast::Expr.RegionNew(source_operand, region, _):
                    operand <- source_operand
                    source_region <- region
                _:
                    return false
            return false if not proof_replay_owner_work_charge(sview_len(source_region), source_work)
            return false if source_region != event.secondary_name or not proof_replay_ast_matches_kernel_with_work(report, operand, event.left, source_work, 0)
            type_matches: mutable usize = 0
            source_type: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, event.value.usize(), "resource-region-alloc-type-inventory", event.name, type_matches, source_type, source_work, 0)
            return false if type_matches != 1 or source_type is Ast::Expr.Invalid
            markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(source_type, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, owner_line, owner_offset.u32(), report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, source_work)
            return false if not markers.complete or not markers.reference
            expected_auxiliary: usize = (ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_WRITABLE_FLAG if markers.mutable_reference or markers.is_mutable else 0) + ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_REFERENCE_FLAG + (ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG if markers.mutable_reference else 0)
            return false if event.auxiliary != expected_auxiliary
            owner_path: (complete: bool, path: darray[sview]) = proof_replay_resource_owner_module_path_with_work(report, owner, owner_line, owner_offset, source_work)
            return false if not owner_path.complete
            pointee: (complete: bool, expression: Ast::Expr) = proof_replay_resource_region_alloc_pointee_type(source_type, source_work, 0)
            return false if not pointee.complete
            borrowed: (complete: bool, contains: bool) = proof_replay_thread_type_contains_borrowed_storage(pointee.expression, report, owner_path.path, source_work, 0)
            return borrowed.complete and not borrowed.contains and source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
