# Source generic binders are keyed by declaration line and spelling. Lines are not
# assumed sorted because parser line directives can reset them.
extend ElisaProof:
    private:
        def proof_replay_generic_param_work_add(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + amount
            return true

        def proof_replay_generic_param_key_hash(line: u32, name: sview) -> u32:
            return proof_expr_shape_mix(proof_name_hash(name), line.i64())

        def proof_replay_source_generic_param_rows_copy(lines: darray[u32]&, names: darray[sview]&, valid: bool, report: mutable ProofReport&, work: mutable usize&) -> bool:
            report.source_generic_param_lines.clear()
            report.source_generic_param_names.clear()
            report.source_generic_params_valid <- false
            return true if not valid or lines.count != names.count
            return false if not proof_replay_generic_param_work_add(work, lines.count)
            for row in 0..<lines.count |row, lines, names, report, work|:
                return false if not proof_replay_generic_param_work_add(work, 1 + sview_len(names[row]))
                report.source_generic_param_lines.push(lines[row])
                report.source_generic_param_names.push(names[row])
            report.source_generic_params_valid <- true
            return true

        def proof_replay_source_generic_param_line_index_build(report: mutable ProofReport&, work: mutable usize&) -> bool:
            index: mutable ProofSourceEffectIndex& = &report.source_effect_index
            return true if not report.source_generic_params_valid or report.source_generic_param_lines.count != report.source_generic_param_names.count
            count: usize = report.source_generic_param_lines.count
            if count == 0:
                return index.generic_param_line_index_hashes.count == 0 and index.generic_param_line_index_values.count == 0 and index.generic_param_line_index_counts.count == 0
            capacity: usize = proof_name_index_capacity(count)
            if index.generic_param_line_index_valid and capacity != 0 and index.generic_param_line_index_hashes.count == capacity and index.generic_param_line_index_values.count == capacity and index.generic_param_line_index_counts.count == capacity:
                return true
            index.generic_param_line_index_valid <- false
            index.generic_param_line_index_hashes.clear()
            index.generic_param_line_index_values.clear()
            index.generic_param_line_index_counts.clear()
            return true if count == 0
            return false if capacity == 0 or not proof_replay_generic_param_work_add(work, capacity + count)
            index.generic_param_line_index_hashes.resize(capacity)
            index.generic_param_line_index_values.resize(capacity)
            index.generic_param_line_index_counts.resize(capacity)
            for slot in 0..<capacity |slot, index, count|:
                index.generic_param_line_index_values[slot] <- count
                index.generic_param_line_index_counts[slot] <- 0
            for row in 0..<count |row, report, index, capacity, count, work|:
                name: sview = report.source_generic_param_names[row]
                return false if not proof_replay_generic_param_work_add(work, 1 + sview_len(name))
                hash: u32 = proof_replay_generic_param_key_hash(report.source_generic_param_lines[row], name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, report, index, capacity, count, work, placed|:
                    return false if not proof_replay_generic_param_work_add(work, 1)
                    current: usize = index.generic_param_line_index_values[slot]
                    if current == count:
                        index.generic_param_line_index_hashes[slot] <- hash
                        index.generic_param_line_index_values[slot] <- row
                        index.generic_param_line_index_counts[slot] <- 1
                        placed <- true
                        break
                    if current < count and index.generic_param_line_index_hashes[slot] == hash:
                        current_name: sview = report.source_generic_param_names[current]
                        return false if not proof_replay_generic_param_work_add(work, 1 + sview_len(current_name))
                        if report.source_generic_param_lines[current] == report.source_generic_param_lines[row] and current_name == name:
                            index.generic_param_line_index_counts[slot] <- index.generic_param_line_index_counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.generic_param_line_index_values, count, work)
            index.generic_param_line_index_valid <- cluster.complete and cluster.bounded
            return index.generic_param_line_index_valid

        # Collision-safe lookup for one exact declaration-line/name binder key. The first query
        # builds the report-owned table; later queries share it and inspect only the bounded
        # collision chain.
        def proof_replay_source_generic_param_name_count_with_work(name: sview, declaration_line: u32, report: mutable ProofReport&, work: mutable usize&) -> (complete: bool, count: usize):
            return (false, 0) if:
                declaration_line == 0 or not report.source_generic_params_valid or report.source_generic_param_lines.count != report.source_generic_param_names.count
                not proof_replay_source_generic_param_line_index_build(report, work)
            count: usize = report.source_generic_param_lines.count
            index: ProofSourceEffectIndex& = report.source_effect_index
            hashes_count: usize = index.generic_param_line_index_hashes.count
            return (false, 0) if hashes_count != index.generic_param_line_index_values.count or hashes_count != index.generic_param_line_index_counts.count
            return (true, 0) if count == 0 and hashes_count == 0
            expected_capacity: usize = proof_name_index_capacity(count)
            return (false, 0) if:
                count == 0 or expected_capacity == 0 or hashes_count != expected_capacity or not index.generic_param_line_index_valid
                not proof_replay_generic_param_work_add(work, 1 + sview_len(name))
            wanted_hash: u32 = proof_replay_generic_param_key_hash(declaration_line, name)
            slot: mutable usize = (wanted_hash.i64() % hashes_count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes_count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, declaration_line, report, index, count, hashes_count, work|:
                return (false, 0) if not proof_replay_generic_param_work_add(work, 1)
                current: usize = index.generic_param_line_index_values[slot]
                return (true, 0) if current == count
                return (false, 0) if current > count or index.generic_param_line_index_counts[slot] == 0
                if index.generic_param_line_index_hashes[slot] == wanted_hash:
                    return (false, 0) if current >= report.source_generic_param_names.count or current >= report.source_generic_param_lines.count
                    current_name: sview = report.source_generic_param_names[current]
                    return (false, 0) if not proof_replay_generic_param_work_add(work, 1 + sview_len(current_name))
                    if report.source_generic_param_lines[current] == declaration_line and current_name == name:
                        return (true, index.generic_param_line_index_counts[slot])
                slot <- (slot + 1) % hashes_count
                probes <- probes + 1
            return (false, 0)

        def proof_replay_call_generic_param_name(name: sview, declaration_line: u32, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, present: bool):
            lines_count: usize = call_target.field_conversion_generic_param_lines.count
            names_count: usize = call_target.field_conversion_generic_param_names.count
            hashes_count: usize = call_target.field_conversion_generic_param_index_hashes.count
            return (false, false) if:
                not call_target.field_conversion_generic_params_valid or lines_count != names_count or declaration_line == 0
                hashes_count != call_target.field_conversion_generic_param_index_values.count or hashes_count != call_target.field_conversion_generic_param_index_counts.count
            return (true, false) if lines_count == 0 and hashes_count == 0
            expected_capacity: usize = proof_name_index_capacity(lines_count)
            return (false, false) if:
                lines_count == 0 or expected_capacity == 0 or hashes_count != expected_capacity or not call_target.field_conversion_generic_param_index_valid
                not proof_replay_generic_param_work_add(work, 1 + sview_len(name))
            wanted_hash: u32 = proof_replay_generic_param_key_hash(declaration_line, name)
            slot: mutable usize = (wanted_hash.i64() % hashes_count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes_count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, call_target, lines_count, hashes_count, work|:
                return (false, false) if not proof_replay_generic_param_work_add(work, 1)
                current: usize = call_target.field_conversion_generic_param_index_values[slot]
                return (true, false) if current == lines_count
                return (false, false) if current > lines_count
                if call_target.field_conversion_generic_param_index_hashes[slot] == wanted_hash:
                    return (false, false) if current >= names_count or current >= lines_count
                    current_name: sview = call_target.field_conversion_generic_param_names[current]
                    return (false, false) if not proof_replay_generic_param_work_add(work, 1 + sview_len(current_name))
                    if call_target.field_conversion_generic_param_lines[current] == declaration_line and current_name == name:
                        return (false, false) if call_target.field_conversion_generic_param_index_counts[slot] == 0
                        return (true, true)
                slot <- (slot + 1) % hashes_count
                probes <- probes + 1
            return (false, false)
