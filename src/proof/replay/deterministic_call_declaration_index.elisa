# One exact-name census for deterministic call replay. Duplicate counts include every named
# declaration kind so function and scalar-type resolution preserve the source lookup contract.
extend ElisaProof:
    private:
        def proof_replay_deterministic_lemma_index_build(annotations: darray[Ast::EnumAnnotation]&, index: mutable ProofReplayDeterministicDeclarationIndex&, work: mutable usize&) -> bool:
            index.lemma_names.clear()
            index.lemma_hashes.clear()
            index.lemma_slots.clear()
            index.lemma_missing <- 0
            index.lemma_index_valid <- false
            marker_count: mutable usize = 0
            for annotation in annotations |annotation, marker_count, work|:
                return false if not proof_replay_deterministic_call_budget_charge(1 + sview_len(annotation.owner), work)
                if annotation.owner == "__lemma":
                    return false if not proof_replay_deterministic_call_budget_charge(sview_len(annotation.name), work)
                    marker_count <- marker_count + 1
            if marker_count == 0:
                index.lemma_index_valid <- true
                return true
            capacity: usize = proof_name_index_capacity(marker_count)
            return false if capacity == 0
            index.lemma_missing <- marker_count
            return false if not proof_replay_deterministic_call_budget_charge(capacity, work)
            index.lemma_slots.resize(capacity)
            for slot in 0..<capacity |slot, index, marker_count|:
                index.lemma_slots[slot] <- marker_count
            for annotation in annotations |annotation, marker_count, index, capacity, work|:
                return false if not proof_replay_deterministic_call_budget_charge(1 + sview_len(annotation.owner), work)
                continue if annotation.owner != "__lemma"
                return false if not proof_replay_deterministic_call_budget_charge(sview_len(annotation.name), work)
                hash: u32 = proof_name_hash(annotation.name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, annotation, index, marker_count, capacity, work, placed|:
                    return false if not proof_replay_deterministic_call_budget_charge(1, work)
                    current: usize = index.lemma_slots[slot]
                    if current == marker_count:
                        name_index: usize = index.lemma_names.count
                        index.lemma_names.push(annotation.name)
                        index.lemma_hashes.push(hash)
                        index.lemma_slots[slot] <- name_index
                        placed <- true
                        break
                    return false if current >= index.lemma_names.count or current >= index.lemma_hashes.count
                    if index.lemma_hashes[current] == hash:
                        return false if not proof_replay_deterministic_call_budget_charge(sview_len(index.lemma_names[current]), work)
                        if index.lemma_names[current] == annotation.name:
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.lemma_slots, marker_count, work)
            return false if not cluster_status.complete or not cluster_status.bounded
            index.lemma_index_valid <- true
            return true

        def proof_replay_deterministic_lemma_name(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, work: mutable usize&) -> (complete: bool, found: bool):
            return (false, false) if not index.lemma_index_valid or index.lemma_hashes.count != index.lemma_names.count
            capacity: usize = index.lemma_slots.count
            return (true, false) if capacity == 0
            return (false, false) if not proof_replay_deterministic_call_budget_charge(sview_len(wanted), work)
            hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, wanted, index, capacity, work|:
                return (false, false) if not proof_replay_deterministic_call_budget_charge(1, work)
                current: usize = index.lemma_slots[slot]
                return (true, false) if current == index.lemma_missing
                return (false, false) if current >= index.lemma_names.count or current >= index.lemma_hashes.count
                if index.lemma_hashes[current] == hash:
                    return (false, false) if not proof_replay_deterministic_call_budget_charge(sview_len(index.lemma_names[current]), work)
                    return (true, true) if index.lemma_names[current] == wanted
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false)

        def proof_replay_deterministic_declaration_entry_add(index: mutable ProofReplayDeterministicDeclarationIndex&, declaration_path: darray[usize]&, name: sview, declaration: Ast::Decl, owner: sview, is_function: bool, is_lemma: bool, module_prefix: usize, work: mutable usize&) -> bool:
            return false if not proof_replay_deterministic_call_budget_charge(declaration_path.count, work)
            path_start: usize = index.declaration_path.count
            index.declaration_path.extend(declaration_path)
            index.entries.push(ProofReplayDeterministicDeclarationEntry{name: name, declaration: declaration, owner: owner, is_function: is_function, is_lemma: is_lemma, module_prefix: module_prefix, declaration_path_start: path_start, declaration_path_count: declaration_path.count, next_index: index.entries.count})
            return true

        def proof_replay_deterministic_declaration_collect(declarations: darray[Ast::Decl]&, index: mutable ProofReplayDeterministicDeclarationIndex&, declaration_path: mutable darray[usize]&, current_owner: sview, module_prefix: usize, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            return false if not proof_replay_deterministic_call_budget_charge(declarations.count, work)
            for declaration_index in 0..<declarations.count |declaration_index, declarations, index, declaration_path, current_owner, module_prefix, work, depth|:
                declaration: Ast::Decl = declarations[declaration_index]
                declaration_path.push(declaration_index)
                name: mutable sview = ""
                is_function: mutable bool = false
                is_lemma: mutable bool = false
                match declaration:
                    Ast::Decl.Func(found, parameters, _, _, _, _, _):
                        name <- found
                        is_function <- true
                        return false if not proof_replay_deterministic_call_budget_charge(sview_len(found), work)
                        return false if not proof_replay_deterministic_call_budget_charge(parameters.count, work)
                        for parameter in parameters |work|:
                            return false if not proof_replay_deterministic_call_budget_charge(sview_len(parameter.name), work)
                        lemma: (complete: bool, found: bool) = proof_replay_deterministic_lemma_name(index, found, work)
                        return false if not lemma.complete
                        is_lemma <- lemma.found
                    Ast::Decl.Const(found, _, _, _, _) | Ast::Decl.Extern(found, _, _, _, _, _, _, _) | Ast::Decl.Struct(found, _, _, _, _, _, _) | Ast::Decl.Alias(found, _, _) | Ast::Decl.Law(found, _, _) | Ast::Decl.Import(found, _):
                        name <- found
                        return false if not proof_replay_deterministic_call_budget_charge(sview_len(found), work)
                    Ast::Decl.Enum(found, variants, _, _, _):
                        name <- found
                        return false if not proof_replay_deterministic_call_budget_charge(sview_len(found), work)
                        return false if not proof_replay_deterministic_call_budget_charge(variants.count, work)
                        for variant in variants |work|:
                            return false if not proof_replay_deterministic_call_budget_charge(sview_len(variant.name), work)
                    Ast::Decl.Module(found, nested, _):
                        return false if not proof_replay_deterministic_call_budget_charge(sview_len(found), work)
                        return false if not proof_replay_deterministic_declaration_entry_add(index, declaration_path, found, declaration, current_owner, false, false, module_prefix, work)
                        return false if not proof_replay_deterministic_declaration_collect(nested, index, declaration_path, found, declaration_path.count, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_deterministic_declaration_collect(nested, index, declaration_path, current_owner, module_prefix, work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        pass
                if name != "":
                    return false if not proof_replay_deterministic_declaration_entry_add(index, declaration_path, name, declaration, current_owner, is_function, is_lemma, module_prefix, work)
                declaration_path <- declaration_path.truncate(declaration_path.count - 1)
            return true

        def proof_replay_deterministic_declaration_index_build(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, index: mutable ProofReplayDeterministicDeclarationIndex&, work: mutable usize&) -> bool:
            index.entries.clear()
            index.declaration_path.clear()
            index.lemma_index_valid <- false
            index.hashes.clear()
            index.heads.clear()
            index.counts.clear()
            index.valid <- false
            declaration_path: mutable darray[usize] = []
            return false if not proof_replay_deterministic_lemma_index_build(annotations, &index, work)
            return false if not proof_replay_deterministic_declaration_collect(declarations, &index, &declaration_path, "", 0, work, 0)
            count: usize = index.entries.count
            if count == 0:
                index.valid <- true
                return true
            for row in 0..<count |row, index, count|:
                index.entries[row].next_index <- count
            capacity: usize = proof_name_index_capacity(count)
            return false if capacity == 0
            return false if not proof_replay_deterministic_call_budget_charge(capacity, work)
            return false if not proof_replay_deterministic_call_budget_charge(count, work)
            index.hashes.resize(capacity)
            index.heads.resize(capacity)
            index.counts.resize(capacity)
            for slot in 0..<capacity |slot, index, count|:
                index.heads[slot] <- count
                index.counts[slot] <- 0
            for row in 0..<count |row, index, count, capacity, work|:
                name: sview = index.entries[row].name
                return false if not proof_replay_deterministic_call_budget_charge(sview_len(name), work)
                hash: u32 = proof_name_hash(name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, index, count, capacity, work, placed|:
                    return false if not proof_replay_deterministic_call_budget_charge(1, work)
                    current: usize = index.heads[slot]
                    if current == count:
                        index.hashes[slot] <- hash
                        index.heads[slot] <- row
                        index.counts[slot] <- 1
                        placed <- true
                        break
                    if index.hashes[slot] == hash:
                        return false if current >= count
                        current_name: sview = index.entries[current].name
                        return false if not proof_replay_deterministic_call_budget_charge(sview_len(current_name), work)
                        if current_name == name:
                            index.entries[row].next_index <- current
                            index.heads[slot] <- row
                            index.counts[slot] <- index.counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            cluster_status: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.heads, count, work)
            return false if not cluster_status.complete or not cluster_status.bounded
            index.valid <- true
            return true

        def proof_replay_deterministic_declaration_group(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, work: mutable usize&) -> (complete: bool, count: usize, head: usize):
            entry_count: usize = index.entries.count
            return (false, 2, entry_count) if not index.valid
            return (false, 2, entry_count) if index.heads.count != index.hashes.count or index.heads.count != index.counts.count
            return (false, 2, entry_count) if entry_count > 0 and index.heads.count != proof_name_index_capacity(entry_count)
            return (false, 2, entry_count) if not proof_replay_deterministic_call_budget_charge(sview_len(wanted), work)
            return (true, 0, entry_count) if entry_count == 0 or wanted == ""
            capacity: usize = index.heads.count
            wanted_hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, index, capacity, entry_count, work|:
                return (false, 2, entry_count) if not proof_replay_deterministic_call_budget_charge(1, work)
                head: usize = index.heads[slot]
                return (true, 0, entry_count) if head == entry_count
                return (false, 2, entry_count) if head > entry_count
                if index.hashes[slot] == wanted_hash:
                    found_name: sview = index.entries[head].name
                    return (false, 2, entry_count) if not proof_replay_deterministic_call_budget_charge(sview_len(found_name), work)
                    if found_name == wanted:
                        matches: usize = index.counts[slot]
                        return (false, 2, entry_count) if matches == 0
                        return (true, matches, head)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, 2, entry_count)
