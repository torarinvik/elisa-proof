        # Independent executable-call coverage; no producer indexes, unsupported dispatch fails closed.
extend ElisaProof:
    private:

        # Keep first-seen order with bounded open-addressed membership; hashes choose probes,
        # exact names decide equality, and overlong collision clusters fail closed.
        def proof_replay_call_name_index_place(calls: darray[sview]&, index: mutable ProofReplayCallNameIndex&, wanted: sview, wanted_hash: u32, value_index: usize, work: mutable usize&) -> (complete: bool, inserted: bool):
            capacity: usize = index.slots.count
            return (false, false) if capacity == 0
            slot: usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, value_index, calls, index, capacity, work|:
                return (false, false) if not proof_replay_call_work_add(work, 1)
                current: usize = index.slots[slot]
                if current == 0:
                    return (false, false) if not proof_replay_call_work_add(work, 1)
                    index.slots[slot] <- value_index + 1
                    return (true, true)
                existing: usize = current - 1
                return (false, false) if existing >= calls.count or existing >= index.hashes.count
                if index.hashes[existing] == wanted_hash:
                    return (false, false) if not proof_replay_call_string_compare_charge(calls[existing], wanted, work)
                    return (true, false) if calls[existing] == wanted
                slot <- slot + 1 if slot + 1 < capacity else 0
                probes <- probes + 1
            return (false, false)

        def proof_replay_call_name_index_rebuild(calls: darray[sview]&, index: mutable ProofReplayCallNameIndex&, capacity: usize, work: mutable usize&) -> bool:
            return false if:
                capacity == 0 or calls.count > capacity / 2
                not proof_replay_call_work_add(work, capacity)
                not proof_replay_call_work_add(work, capacity)
            index.slots.clear()
            index.slots.resize(capacity)
            for slot in 0..<capacity |slot, index|:
                index.slots[slot] <- 0
            for item_index in 0..<calls.count |item_index, calls, index, work|:
                return false if item_index >= index.hashes.count or not proof_replay_call_work_add(work, 1)
                placed: (complete: bool, inserted: bool) = proof_replay_call_name_index_place(calls, index, calls[item_index], index.hashes[item_index], item_index, work)
                return false if not placed.complete
            return true

        def proof_replay_call_name_index_build(calls: darray[sview]&, index: mutable ProofReplayCallNameIndex&, work: mutable usize&) -> bool:
            index.hashes.clear()
            index.slots.clear()
            return true if calls.count == 0
            capacity: usize = proof_name_index_capacity(calls.count)
            return false if capacity == 0 or not proof_replay_call_work_add(work, calls.count)
            for name in calls |name, index, work|:
                return false if not proof_replay_call_work_add(work, sview_len(name))
                return false if not proof_replay_call_work_add(work, 2)
                index.hashes.push(proof_name_hash(name))
            return proof_replay_call_name_index_rebuild(calls, index, capacity, work)
        def proof_replay_call_name_index_add(calls: mutable darray[sview]&, index: mutable ProofReplayCallNameIndex&, wanted: sview, work: mutable usize&, preserve_occurrences: bool = false) -> bool:
            if preserve_occurrences:
                return false if not proof_replay_call_work_add(work, sview_len(wanted)) or not proof_replay_call_work_add(work, 1)
                calls.push(wanted)
                return true
            next_count: usize = calls.count + 1
            if index.slots.count == 0 or next_count > index.slots.count / 2:
                capacity: usize = proof_name_index_capacity(next_count)
                return false if capacity == 0 or not proof_replay_call_name_index_rebuild(calls, index, capacity, work)
            return false if not proof_replay_call_work_add(work, sview_len(wanted))
            wanted_hash: u32 = proof_name_hash(wanted)
            placed: (complete: bool, inserted: bool) = proof_replay_call_name_index_place(calls, index, wanted, wanted_hash, calls.count, work)
            return false if not placed.complete
            if placed.inserted:
                return false if not proof_replay_call_work_add(work, 4)
                calls.push(wanted)
                index.hashes.push(wanted_hash)
            return true
        def proof_replay_call_arms(arms: darray[Ast::MatchArm]&, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_index: mutable ProofReplayCallNameIndex&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for arm in arms |bindings, calls, call_index, call_target, work, depth|:
                return false if not proof_replay_call_work_add(work, 1)
                mark: usize = bindings.count
                if not proof_replay_call_arm_pattern_bindings_with_work(arm.pattern, bindings, work, depth + 1):
                    return false if not call_target.selection.track_unresolved_dispatch
                    call_target.selection.unresolved_dispatch_found <- true
                    bindings.resize(mark)
                    if call_target.selection.enabled and call_target.capture.require_exact_call:
                        matched_before_arm: usize = call_target.selection.matched_calls
                        return false if:
                            not proof_replay_call_expression_with_index(arm.guard, bindings, calls, call_index, call_target, work, depth + 1)
                            not proof_replay_call_body(&arm.body, bindings, calls, call_index, call_target, work, depth + 1)
                        bindings.resize(mark)
                        call_target.selection.unresolved_scope_at_target <- true if call_target.selection.matched_calls > matched_before_arm
                    continue
                return false if:
                    not proof_replay_call_expression_with_index(arm.guard, bindings, calls, call_index, call_target, work, depth + 1)
                    not proof_replay_call_body(&arm.body, bindings, calls, call_index, call_target, work, depth + 1)
                bindings.resize(mark)
            return true
        def proof_replay_call_expression_with_index(expression: Ast::Expr, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_index: mutable ProofReplayCallNameIndex&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match expression:
                Ast::Expr.Absent:
                    pass
                Ast::Expr.IntLit(_, _):
                    pass
                Ast::Expr.FloatLit(_, _):
                    pass
                Ast::Expr.StringLit(_, _):
                    pass
                Ast::Expr.CharLit(_, _):
                    pass
                Ast::Expr.BoolLit(_, _):
                    pass
                Ast::Expr.Ident(_, _):
                    pass
                Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    # Direct unqualified calls add graph edges. Scoped calls are admitted only
                    # for the exact replay target; other scoped calls and field callees do not
                    # identify edges, though nested calls are traversed and unresolved dispatch
                    # is recorded by structural graph callers.
                    match callee:
                        Ast::Expr.Ident(name, _):
                            if proof_builtin_scalar_type_name(name):
                                return false if arguments.count != 1 or (argument_names.count != 0 and argument_names.count != arguments.count)
                                for label in argument_names |label, work|:
                                    return false if not proof_replay_call_work_add(work, 1) or not proof_replay_call_work_add(work, sview_len(label)) or label != ""
                                shadowed: mutable bool = false
                                for bound in bindings |bound, name, shadowed, work|:
                                    return false if not proof_replay_call_string_compare_charge(bound, name, work)
                                    shadowed <- true if bound == name
                                if shadowed:
                                    call_target.selection.unresolved_dispatch_found <- true
                                for argument in arguments |bindings, calls, call_index, call_target, work, depth|:
                                    return false if not proof_replay_call_expression_with_index(argument, bindings, calls, call_index, call_target, work, depth + 1)
                            else:
                                return false if name == ""
                                if call_target.capture.require_exact_call and position.offset.usize() == call_target.selection.offset:
                                    exact_complete: mutable bool = true
                                    exact: bool = proof_replay_deterministic_call_expression_equal_with_work(Ast::Expr.Call(callee, arguments, argument_names, position), call_target.capture.expected_call, work, &exact_complete, 0)
                                    return false if not exact_complete or not exact
                                shadowed: mutable bool = false
                                for bound in bindings |bound, name, shadowed, work|:
                                    return false if not proof_replay_call_string_compare_charge(bound, name, work)
                                    shadowed <- true if bound == name
                                if shadowed:
                                    if call_target.selection.track_unresolved_dispatch:
                                        call_target.selection.unresolved_dispatch_found <- true
                                    else:
                                        return false
                                else:
                                    return false if:
                                        not proof_replay_call_site_match(name, position, call_target, work)
                                        not proof_replay_call_name_index_add(calls, call_index, name, work, call_target.capture.preserve_call_occurrences)
                                        not proof_replay_call_capture_callee_path(callee, call_target, work)
                        Ast::Expr.Scope(base, name, _):
                            if call_target.capture.capture_all_call_sites and call_target.selection.enabled:
                                return false if:
                                    not proof_replay_call_site_scoped(position, call_target, work)
                                    not proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)
                            elif call_target.selection.enabled and position.offset.usize() == call_target.selection.offset and call_target.selection.allow_scoped_target:
                                return false if not proof_replay_call_scoped_target_site(callee, base, name, arguments, argument_names, position, bindings, calls, call_index, call_target, work, depth)
                            elif call_target.selection.track_unresolved_dispatch:
                                bound_base: mutable bool = false
                                match base:
                                    Ast::Expr.Ident(base_name, _):
                                        for bound in bindings |bound, base_name, bound_base, work|:
                                            return false if not proof_replay_call_string_compare_charge(bound, base_name, work)
                                            bound_base <- true if bound == base_name
                                    _:
                                        pass
                                if bound_base or name == "":
                                    call_target.selection.unresolved_dispatch_found <- true
                                else:
                                    return false if:
                                        not proof_replay_call_name_index_add(calls, call_index, name, work, call_target.capture.preserve_call_occurrences)
                                        not proof_replay_call_capture_callee_path(callee, call_target, work)
                                return false if not proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)
                            elif call_target.selection.ignore_unmatched_scoped_edges or (call_target.selection.enabled and position.offset.usize() != call_target.selection.offset):
                                return false if not proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)
                            else:
                                return false if not call_target.selection.enabled or not call_target.selection.allow_scoped_target or name == ""
                                shadowed: mutable bool = false
                                for bound in bindings |bound, name, shadowed, work|:
                                    return false if not proof_replay_call_string_compare_charge(bound, name, work)
                                    shadowed <- true if bound == name
                                return false if:
                                    shadowed
                                    not proof_replay_call_site_match(name, position, call_target, work)
                                    not proof_replay_call_name_index_add(calls, call_index, name, work, call_target.capture.preserve_call_occurrences)
                                    not proof_replay_call_capture_callee_path(callee, call_target, work)
                                    not proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)
                        Ast::Expr.Field(_, method, _):
                            if call_target.selection.track_unresolved_dispatch and not proof_replay_call_field_dispatch_is_accounted_for(callee, arguments, argument_names, bindings, call_target, work):
                                return false if not proof_replay_call_work_add(work, 1) or not proof_replay_call_work_add(work, sview_len(method))
                                call_target.selection.unresolved_dispatch_found <- true
                            return false if not proof_replay_call_expression_with_index(callee, bindings, calls, call_index, call_target, work, depth + 1)
                        _:
                            if call_target.selection.track_unresolved_dispatch:
                                call_target.selection.unresolved_dispatch_found <- true
                            else:
                                return false
                    for argument in arguments |bindings, calls, call_index, call_target, work, depth|:
                        return false if not proof_replay_call_expression_with_index(argument, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    # Match backend lowering only for its statically unambiguous case; ambiguous
                    # handler candidates remain opaque.
                    if candidates.count != 1:
                        return false if not call_target.selection.track_unresolved_dispatch
                        call_target.selection.unresolved_dispatch_found <- true
                        for argument in arguments |bindings, calls, call_index, call_target, work, depth|:
                            return false if not proof_replay_call_expression_with_index(argument, bindings, calls, call_index, call_target, work, depth + 1)
                        return true
                    candidate: Ast::StaticEffectCandidate = candidates[0]
                    # Charge each lowering loop and destination push before walking each result.
                    for _ in 0..<3 |candidate, arguments, work|:
                        return false if:
                            not proof_replay_call_work_add(work, candidate.captures.count)
                            not proof_replay_call_work_add(work, arguments.count)
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    if not lowered.known:
                        return false if not call_target.selection.track_unresolved_dispatch
                        call_target.selection.unresolved_dispatch_found <- true
                        return true
                    return proof_replay_call_expression_with_index(lowered.call, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_call_expression_with_index(inner, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Unary(_, inner, _):
                    return proof_replay_call_expression_with_index(inner, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Move(inner, _):
                    return proof_replay_call_expression_with_index(inner, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_call_expression_with_index(inner, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    # A category/type test's right side is pattern data; its names matter only in
                    # true-branch scope.
                    return proof_replay_call_expression_with_index(left, bindings, calls, call_index, call_target, work, depth + 1) if operator == TokenKind.Is or operator == TokenKind.As
                    return proof_replay_call_condition_expression(expression, bindings, calls, call_index, call_target, work, depth + 1) if operator == TokenKind.And or operator == TokenKind.Or
                    return proof_replay_call_expression_with_index(left, bindings, calls, call_index, call_target, work, depth + 1) and proof_replay_call_expression_with_index(right, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_replay_call_expression_with_index(object, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_replay_call_expression_with_index(object, bindings, calls, call_index, call_target, work, depth + 1) and proof_replay_call_expression_with_index(index, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_replay_call_expression_with_index(object, bindings, calls, call_index, call_target, work, depth + 1) and proof_replay_call_expression_with_index(low, bindings, calls, call_index, call_target, work, depth + 1) and proof_replay_call_expression_with_index(high, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.IndexN(object, elements, _):
                    return false if not proof_replay_call_expression_with_index(object, bindings, calls, call_index, call_target, work, depth + 1)
                    for element in elements |bindings, calls, call_index, call_target, work, depth|:
                        return false if not proof_replay_call_expression_with_index(element, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |bindings, calls, call_index, call_target, work, depth|:
                        return false if not proof_replay_call_expression_with_index(element, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |bindings, calls, call_index, call_target, work, depth|:
                        return false if not proof_replay_call_expression_with_index(element, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |bindings, calls, call_index, call_target, work, depth|:
                        return false if not proof_replay_call_expression_with_index(element, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |bindings, calls, call_index, call_target, work, depth|:
                        return false if not proof_replay_call_expression_with_index(entry.key, bindings, calls, call_index, call_target, work, depth + 1) or not proof_replay_call_expression_with_index(entry.value, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Construct(base, fields, _):
                    return false if not proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)
                    for field in fields |bindings, calls, call_index, call_target, work, depth|:
                        return false if not proof_replay_call_expression_with_index(field.value, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)
                    for field in fields |bindings, calls, call_index, call_target, work, depth|:
                        return false if not proof_replay_call_expression_with_index(field.value, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return false if not proof_replay_call_condition_expression(condition, bindings, calls, call_index, call_target, work, depth + 1)
                    mark: usize = bindings.count
                    return false if not proof_replay_call_condition_bindings(condition, bindings, call_target, work, depth + 1)
                    then_valid: bool = proof_replay_call_expression_with_index(yes, bindings, calls, call_index, call_target, work, depth + 1)
                    bindings.resize(mark)
                    return false if:
                        not then_valid
                        not proof_replay_call_condition_false_bindings(condition, bindings, call_target, work, depth + 1)
                    else_valid: bool = proof_replay_call_expression_with_index(no, bindings, calls, call_index, call_target, work, depth + 1)
                    bindings.resize(mark)
                    return else_valid
                Ast::Expr.Comprehension(name, iterable, condition, value, _):
                    return false if not proof_replay_call_expression_with_index(iterable, bindings, calls, call_index, call_target, work, depth + 1)
                    mark: usize = bindings.count
                    return false if not proof_replay_call_work_add(work, sview_len(name)) or not proof_replay_call_work_add(work, 2)
                    bindings.push(name)
                    split_result: (complete: bool, splits: bool) = proof_replay_call_comprehension_filter_splits(condition, work, depth + 1)
                    if not split_result.complete:
                        return false if not call_target.selection.track_unresolved_dispatch
                        call_target.selection.unresolved_dispatch_found <- true
                        bindings.resize(mark)
                        return true
                    if split_result.splits:
                        match condition:
                            Ast::Expr.Binary(filter_test, TokenKind.And, guard, _):
                                return false if not proof_replay_call_expression_with_index(filter_test, bindings, calls, call_index, call_target, work, depth + 1)
                                filter_mark: usize = bindings.count
                                return false if:
                                    not proof_replay_call_filter_bindings(filter_test, bindings, call_target, work, depth + 1)
                                    not proof_replay_call_expression_with_index(guard, bindings, calls, call_index, call_target, work, depth + 1)
                                valid: bool = proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1)
                                bindings.resize(filter_mark)
                                bindings.resize(mark)
                                return valid
                            _:
                                if call_target.selection.track_unresolved_dispatch:
                                    call_target.selection.unresolved_dispatch_found <- true
                                    bindings.resize(mark)
                                    return true
                                return false
                    else:
                        if not proof_replay_call_expression_with_index(condition, bindings, calls, call_index, call_target, work, depth + 1) or not proof_replay_call_filter_bindings(condition, bindings, call_target, work, depth + 1):
                            return false if not call_target.selection.track_unresolved_dispatch
                            call_target.selection.unresolved_dispatch_found <- true
                            bindings.resize(mark)
                            return true
                        valid: bool = proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1)
                        bindings.resize(mark)
                        return valid
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1) and proof_replay_call_expression_with_index(predicate, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Match(value, arms, _):
                    return proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1) and proof_replay_call_arms(&arms, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Catch(value, arms, _):
                    return proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1) and proof_replay_call_arms(&arms, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.GetElse(value, recovery, _):
                    return proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1) and proof_replay_call_body(&recovery, bindings, calls, call_index, call_target, work, depth + 1)
                Ast::Expr.Block(body, value, captures, _):
                    mark: usize = bindings.count
                    return false if:
                        not proof_replay_call_captures_extend(captures, bindings, work)
                        not proof_replay_call_statements(&body, bindings, calls, call_index, call_target, work, depth + 1)
                    valid: bool = proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1)
                    bindings.resize(mark)
                    return valid
                _:
                    if call_target.selection.track_unresolved_dispatch:
                        call_target.selection.unresolved_dispatch_found <- true
                        return true
                    return false
            return true
        def proof_replay_call_body(body: darray[Ast::Stmt]&, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_index: mutable ProofReplayCallNameIndex&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            mark: usize = bindings.count
            valid: bool = proof_replay_call_statements(body, bindings, calls, call_index, call_target, work, depth)
            bindings.resize(mark)
            return valid

        # Captured statement loops wrap declarations and one loop in a Block with an Invalid
        # sentinel. Admit it only there; walk initializers, conditions and bodies independently.
        # Invalid values elsewhere fail closed.
        def proof_replay_call_statement_expression(expression: Ast::Expr, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_index: mutable ProofReplayCallNameIndex&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match expression:
                Ast::Expr.Block(nested, Ast::Expr.Invalid, captures, _):
                    return false if nested.count == 0
                    for index in 0..<nested.count |index, nested, work|:
                        return false if not proof_replay_call_work_add(work, 1)
                        if index + 1 == nested.count:
                            match nested[index]:
                                Ast::Stmt.While(_, _, _) | Ast::Stmt.For(_, _, _, _, _):
                                    pass
                                _:
                                    return false
                        else:
                            match nested[index]:
                                Ast::Stmt.VarDecl(_, _, _, _):
                                    pass
                                _:
                                    return false
                    mark: usize = bindings.count
                    return false if not proof_replay_call_captures_extend(captures, bindings, work)
                    valid: bool = proof_replay_call_body(&nested, bindings, calls, call_index, call_target, work, depth + 1)
                    bindings.resize(mark)
                    return valid
                _:
                    return proof_replay_call_expression_with_index(expression, bindings, calls, call_index, call_target, work, depth + 1)

        def proof_replay_call_statements(body: darray[Ast::Stmt]&, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_index: mutable ProofReplayCallNameIndex&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for statement in body |bindings, calls, call_index, call_target, work, depth|:
                return false if not proof_replay_call_work_add(work, 1)
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return false if not proof_replay_call_expression_with_index(returned, bindings, calls, call_index, call_target, work, depth + 1)
                    Ast::Stmt.Expr(value, _):
                        if not proof_replay_call_statement_expression(value, bindings, calls, call_index, call_target, work, depth + 1):
                            return false if not call_target.selection.track_unresolved_dispatch
                            call_target.selection.unresolved_dispatch_found <- true
                            return true
                        if not proof_replay_call_expression_bindings(value, bindings, work, depth + 1):
                            return false if not call_target.selection.track_unresolved_dispatch
                            call_target.selection.unresolved_dispatch_found <- true
                            return true
                    Ast::Stmt.VarDecl(name, type_expression, value, _):
                        return false if not proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1)
                        if not proof_replay_call_expression_bindings(value, bindings, work, depth + 1):
                            return false if not call_target.selection.track_unresolved_dispatch
                            call_target.selection.unresolved_dispatch_found <- true
                            return true
                        return false if not proof_replay_call_work_add(work, sview_len(name)) or not proof_replay_call_work_add(work, 2) or not proof_replay_call_work_add(work, 2)
                        call_target.capture.captured_local_type_names.push(name)
                        call_target.capture.captured_local_type_expressions.push(type_expression)
                        bindings.push(name)
                    Ast::Stmt.Assign(target, operator, value, _):
                        return false if:
                            not proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1)
                            not proof_replay_call_expression_bindings(value, bindings, work, depth + 1)
                            not proof_replay_call_expression_with_index(target, bindings, calls, call_index, call_target, work, depth + 1)
                        match target:
                            Ast::Expr.Ident(name, _):
                                if operator == TokenKind.Assign:
                                    return false if name == "" or not proof_replay_call_work_add(work, 1) or not proof_replay_call_work_add(work, sview_len(name))
                                    bound_already: mutable bool = false
                                    for bound in bindings |bound, name, bound_already, work|:
                                        return false if not proof_replay_call_string_compare_charge(bound, name, work)
                                        bound_already <- true if bound == name
                                    if not bound_already:
                                        return false if not proof_replay_call_work_add(work, 2)
                                        bindings.push(name)
                            Ast::Expr.Array(elements, _):
                                if operator == TokenKind.Assign:
                                    for element in elements |bindings, work|:
                                        match element:
                                            Ast::Expr.Ident(name, _):
                                                return false if name == "" or not proof_replay_call_work_add(work, 1) or not proof_replay_call_work_add(work, sview_len(name))
                                                bound_already: mutable bool = false
                                                for bound in bindings |bound, name, bound_already, work|:
                                                    return false if not proof_replay_call_string_compare_charge(bound, name, work)
                                                    bound_already <- true if bound == name
                                                if not bound_already:
                                                    return false if not proof_replay_call_work_add(work, 2)
                                                    bindings.push(name)
                                            _:
                                                pass
                            Ast::Expr.Call(_, _, _, _):
                                if call_target.selection.track_unresolved_dispatch:
                                    call_target.selection.unresolved_dispatch_found <- true
                                    return true
                                return false
                            _:
                                pass
                    Ast::Stmt.If(condition, yes, no, position):
                        return false if not proof_replay_call_condition_expression(condition, bindings, calls, call_index, call_target, work, depth + 1)
                        mark: usize = bindings.count
                        return false if not proof_replay_call_condition_bindings(condition, bindings, call_target, work, depth + 1)
                        then_valid: bool = proof_replay_call_body(&yes, bindings, calls, call_index, call_target, work, depth + 1)
                        bindings.resize(mark)
                        return false if:
                            not then_valid
                            not proof_replay_call_condition_false_bindings(condition, bindings, call_target, work, depth + 1)
                        else_valid: bool = proof_replay_call_body(&no, bindings, calls, call_index, call_target, work, depth + 1)
                        bindings.resize(mark)
                        return false if not else_valid
                    Ast::Stmt.While(condition, nested, _):
                        return false if not proof_replay_call_condition_expression(condition, bindings, calls, call_index, call_target, work, depth + 1)
                        mark: usize = bindings.count
                        return false if not proof_replay_call_condition_bindings(condition, bindings, call_target, work, depth + 1)
                        body_valid: bool = proof_replay_call_body(&nested, bindings, calls, call_index, call_target, work, depth + 1)
                        bindings.resize(mark)
                        return false if not body_valid
                    Ast::Stmt.For(_, variables, iterable, nested, _):
                        filters: mutable darray[Ast::Expr] = []
                        base_iterable: mutable Ast::Expr = iterable
                        refinement_depth: mutable usize = 0
                        while refinement_depth < 96 |base_iterable, filters, refinement_depth, work|:
                            match base_iterable:
                                Ast::Expr.Refinement(base, predicate, _):
                                    return false if not proof_replay_call_work_add(work, 1)
                                    return false if not proof_replay_call_work_add(work, 2)
                                    filters.push(predicate)
                                    if filters.count > 2:
                                        return false if not call_target.selection.track_unresolved_dispatch
                                        call_target.selection.unresolved_dispatch_found <- true
                                        return true
                                    base_iterable <- base
                                    refinement_depth <- refinement_depth + 1
                                _:
                                    break
                        match base_iterable:
                            Ast::Expr.Refinement(_, _, _):
                                if call_target.selection.track_unresolved_dispatch:
                                    call_target.selection.unresolved_dispatch_found <- true
                                    return true
                                return false
                            _:
                                pass
                        return false if not proof_replay_call_expression_with_index(base_iterable, bindings, calls, call_index, call_target, work, depth + 1)
                        mark: usize = bindings.count
                        return false if not proof_replay_call_bindings_extend(variables, bindings, work)
                        if filters.count == 2:
                            inner_filter: Ast::Expr = filters[1]
                            return false if:
                                not proof_replay_call_expression_with_index(inner_filter, bindings, calls, call_index, call_target, work, depth + 1)
                                not proof_replay_call_filter_bindings(inner_filter, bindings, call_target, work, depth + 1)
                                not proof_replay_call_expression_with_index(filters[0], bindings, calls, call_index, call_target, work, depth + 1)
                        if filters.count == 1:
                            return false if:
                                not proof_replay_call_expression_with_index(filters[0], bindings, calls, call_index, call_target, work, depth + 1)
                                not proof_replay_call_filter_bindings(filters[0], bindings, call_target, work, depth + 1)
                        body_valid: bool = proof_replay_call_body(&nested, bindings, calls, call_index, call_target, work, depth + 1)
                        bindings.resize(mark)
                        return false if not body_valid
                    Ast::Stmt.Match(value, arms, _):
                        return false if not proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1) or not proof_replay_call_arms(&arms, bindings, calls, call_index, call_target, work, depth + 1)
                    Ast::Stmt.Block(kind, _, binding, nested, _):
                        mark: usize = bindings.count
                        scoped_block: bool = nested.count > 0 and (kind in {"region", "in", "can", "trusted", "with", "pool", "nursery", "scope", "lock"})
                        return false if binding != "" and (not proof_replay_call_work_add(work, sview_len(binding)) or not proof_replay_call_work_add(work, 2))
                        bindings.push(binding) if binding != ""
                        if kind == "assert_by":
                            if nested.count == 0:
                                return false if not call_target.selection.track_unresolved_dispatch
                                call_target.selection.unresolved_dispatch_found <- true
                                bindings.resize(mark)
                                return true
                            match nested[0]:
                                Ast::Stmt.Contract("assert", goal, _):
                                    return false if not proof_replay_call_expression_with_index(goal, bindings, calls, call_index, call_target, work, depth + 1)
                                _:
                                    if call_target.selection.track_unresolved_dispatch:
                                        call_target.selection.unresolved_dispatch_found <- true
                                        bindings.resize(mark)
                                        return true
                                    return false
                        else:
                            if scoped_block:
                                return false if not proof_replay_call_body(&nested, bindings, calls, call_index, call_target, work, depth + 1)
                            else:
                                return false if not proof_replay_call_statements(nested, bindings, calls, call_index, call_target, work, depth + 1)
                        bindings.resize(mark) if scoped_block
                    Ast::Stmt.Contract(kind, value, _):
                        # Stage1 executes requires and ensures, but erases loop
                        # decreases/invariant clauses. Never let an event offset bind to
                        # one of those non-runtime expressions.
                        if kind == "assert" or (call_target.selection.include_nonassert_contract_calls and (kind == "requires" or proof_is_ensure_kind(kind))):
                            return false if not proof_replay_call_expression_with_index(value, bindings, calls, call_index, call_target, work, depth + 1)
                    Ast::Stmt.Break(_, _):
                        pass
                    Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        if call_target.selection.track_unresolved_dispatch:
                            call_target.selection.unresolved_dispatch_found <- true
                            return true
                        return false
            return true
include "./source_call_expression_coverage.elisa"
