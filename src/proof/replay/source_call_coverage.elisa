# Independent executable-call coverage. This walk does not consult producer call
# indexes. Unsupported dispatch fails closed; success is not a purity summary.
extend ElisaProof:
    private:
        struct ProofReplayCallSiteTarget:
            enabled: bool
            ignore_unmatched_scoped_edges: bool
            allow_scoped_target: bool
            include_nonassert_contract_calls: bool
            offset: usize
            line: u32
            name: sview
            calls_at_offset: mutable usize
            matched_calls: mutable usize

        def proof_replay_call_work_add(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + amount
            return true

        def proof_replay_call_string_compare_charge(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if not proof_replay_call_work_add(work, 1)
            return false if not proof_replay_call_work_add(work, sview_len(left))
            return proof_replay_call_work_add(work, sview_len(right))

        def proof_replay_call_site_match(name: sview, position: Ast::Pos, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            return true if not call_target.enabled or position.offset.usize() != call_target.offset
            return false if not proof_replay_call_work_add(work, 1)
            call_target.calls_at_offset <- call_target.calls_at_offset + 1
            return false if not proof_replay_call_string_compare_charge(name, call_target.name, work)
            call_target.matched_calls <- call_target.matched_calls + 1 if name == call_target.name and position.line == call_target.line
            return true

        def proof_replay_call_pattern_bindings(pattern: Ast::Pattern, bindings: mutable darray[sview]&, depth: usize) -> bool:
            work: mutable usize = 0
            return proof_replay_call_pattern_bindings_with_work(pattern, bindings, &work, depth)

        def proof_replay_call_pattern_bindings_with_work(pattern: Ast::Pattern, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match pattern:
                Ast::Pattern.Binding(name):
                    bindings.push(name)
                Ast::Pattern.Rest(name):
                    bindings.push(name) if name != ""
                Ast::Pattern.TypeBind(_, name):
                    bindings.push(name)
                Ast::Pattern.As(name, children):
                    bindings.push(name)
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Variant(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Struct(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Field(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Tuple(children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Or(children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Wildcard:
                    pass
                Ast::Pattern.Literal(_):
                    pass
                Ast::Pattern.Pin(_):
                    pass
                Ast::Pattern.Range(_, _, _):
                    pass
                _:
                    return false
            return true

        def proof_replay_call_arms(arms: darray[Ast::MatchArm]&, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for arm in arms |bindings, calls, call_target, work, depth|:
                return false if not proof_replay_call_work_add(work, 1)
                mark: usize = bindings.count
                return false if not proof_replay_call_pattern_bindings_with_work(arm.pattern, bindings, work, depth + 1)
                return false if not proof_replay_call_expression(arm.guard, bindings, calls, call_target, work, depth + 1)
                return false if not proof_replay_call_body(&arm.body, bindings, calls, call_target, work, depth + 1)
                bindings.resize(mark)
            return true

        def proof_replay_call_expression(expression: Ast::Expr, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match expression:
                Ast::Expr.Absent:
                    pass
                Ast::Expr.IntLit(_, _):
                    pass
                Ast::Expr.FloatLit(_, _):
                    pass
                Ast::Expr.StringLit(_, _):
                    pass
                Ast::Expr.CharLit(_, _):
                    pass
                Ast::Expr.BoolLit(_, _):
                    pass
                Ast::Expr.Ident(_, _):
                    pass
                Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    # Unqualified direct dispatch contributes a call-graph edge. A scoped
                    # callee is admitted below only for the exact replay target, whose owner
                    # is checked independently. Non-target scoped calls are traversed for
                    # nested calls but do not contribute an edge here. Field callees are
                    # method syntax: the producer deliberately does not
                    # infer a source-function edge from its leaf name, so replay only walks
                    # its receiver (and arguments) for nested direct calls.
                    match callee:
                        Ast::Expr.Ident(name, _):
                            if proof_builtin_scalar_type_name(name):
                                return false if arguments.count != 1 or (argument_names.count != 0 and argument_names.count != arguments.count)
                                for label in argument_names |label, work|:
                                    return false if not proof_replay_call_work_add(work, 1 + sview_len(label)) or label != ""
                            else:
                                return false if name == ""
                                shadowed: mutable bool = false
                                for bound in bindings |bound, name, shadowed, work|:
                                    return false if not proof_replay_call_string_compare_charge(bound, name, work)
                                    shadowed <- true if bound == name
                                return false if shadowed
                                return false if not proof_replay_call_site_match(name, position, call_target, work)
                                already_seen: mutable bool = false
                                for existing in calls |existing, name, already_seen, work|:
                                    return false if not proof_replay_call_string_compare_charge(existing, name, work)
                                    already_seen <- true if existing == name
                                calls.push(name) if not already_seen
                        Ast::Expr.Scope(base, name, _):
                            if call_target.ignore_unmatched_scoped_edges or (call_target.enabled and position.offset.usize() != call_target.offset):
                                return false if not proof_replay_call_expression(base, bindings, calls, call_target, work, depth + 1)
                            else:
                                return false if not call_target.enabled or not call_target.allow_scoped_target or name == ""
                                shadowed: mutable bool = false
                                for bound in bindings |bound, name, shadowed, work|:
                                    return false if not proof_replay_call_string_compare_charge(bound, name, work)
                                    shadowed <- true if bound == name
                                return false if shadowed
                                return false if not proof_replay_call_site_match(name, position, call_target, work)
                                already_seen: mutable bool = false
                                for existing in calls |existing, name, already_seen, work|:
                                    return false if not proof_replay_call_string_compare_charge(existing, name, work)
                                    already_seen <- true if existing == name
                                calls.push(name) if not already_seen
                                return false if not proof_replay_call_expression(base, bindings, calls, call_target, work, depth + 1)
                        Ast::Expr.Field(_, _, _):
                            return false if not proof_replay_call_expression(callee, bindings, calls, call_target, work, depth + 1)
                        _:
                            return false
                    for argument in arguments |bindings, calls, call_target, work, depth|:
                        return false if not proof_replay_call_expression(argument, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    # Match the producer's backend lowering for the only statically
                    # unambiguous case. Ambiguous handler candidates remain fail-closed.
                    return false if candidates.count != 1
                    candidate: Ast::StaticEffectCandidate = candidates[0]
                    # Account for each lowering loop and both destination-array pushes
                    # before the ordinary-call walk charges each resulting expression.
                    for _ in 0..<3 |candidate, arguments, work|:
                        return false if not proof_replay_call_work_add(work, candidate.captures.count)
                        return false if not proof_replay_call_work_add(work, arguments.count)
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return false if not lowered.known
                    return proof_replay_call_expression(lowered.call, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_call_expression(inner, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Unary(_, inner, _):
                    return proof_replay_call_expression(inner, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Move(inner, _):
                    return proof_replay_call_expression(inner, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_call_expression(inner, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    # Category-test binders require branch-sensitive scope reconstruction.
                    return false if operator == TokenKind.Is
                    return proof_replay_call_expression(left, bindings, calls, call_target, work, depth + 1) and proof_replay_call_expression(right, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_replay_call_expression(object, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_replay_call_expression(base, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_replay_call_expression(object, bindings, calls, call_target, work, depth + 1) and proof_replay_call_expression(index, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_replay_call_expression(object, bindings, calls, call_target, work, depth + 1) and proof_replay_call_expression(low, bindings, calls, call_target, work, depth + 1) and proof_replay_call_expression(high, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.IndexN(object, elements, _):
                    return false if not proof_replay_call_expression(object, bindings, calls, call_target, work, depth + 1)
                    for element in elements |bindings, calls, call_target, work, depth|:
                        return false if not proof_replay_call_expression(element, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |bindings, calls, call_target, work, depth|:
                        return false if not proof_replay_call_expression(element, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |bindings, calls, call_target, work, depth|:
                        return false if not proof_replay_call_expression(element, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |bindings, calls, call_target, work, depth|:
                        return false if not proof_replay_call_expression(element, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |bindings, calls, call_target, work, depth|:
                        return false if not proof_replay_call_expression(entry.key, bindings, calls, call_target, work, depth + 1) or not proof_replay_call_expression(entry.value, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Construct(base, fields, _):
                    return false if not proof_replay_call_expression(base, bindings, calls, call_target, work, depth + 1)
                    for field in fields |bindings, calls, call_target, work, depth|:
                        return false if not proof_replay_call_expression(field.value, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_call_expression(base, bindings, calls, call_target, work, depth + 1)
                    for field in fields |bindings, calls, call_target, work, depth|:
                        return false if not proof_replay_call_expression(field.value, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return proof_replay_call_expression(condition, bindings, calls, call_target, work, depth + 1) and proof_replay_call_expression(yes, bindings, calls, call_target, work, depth + 1) and proof_replay_call_expression(no, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Comprehension(name, iterable, condition, value, _):
                    return false if not proof_replay_call_expression(iterable, bindings, calls, call_target, work, depth + 1)
                    mark: usize = bindings.count
                    bindings.push(name)
                    valid: bool = proof_replay_call_expression(condition, bindings, calls, call_target, work, depth + 1) and proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1)
                    bindings.resize(mark)
                    return valid
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_replay_call_expression(base, bindings, calls, call_target, work, depth + 1) and proof_replay_call_expression(predicate, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Match(value, arms, _):
                    return proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1) and proof_replay_call_arms(&arms, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Catch(value, arms, _):
                    return proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1) and proof_replay_call_arms(&arms, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.GetElse(value, recovery, _):
                    return proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1) and proof_replay_call_body(&recovery, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Block(body, value, captures, _):
                    mark: usize = bindings.count
                    bindings.extend(captures)
                    return false if not proof_replay_call_statements(&body, bindings, calls, call_target, work, depth + 1)
                    valid: bool = proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1)
                    bindings.resize(mark)
                    return valid
                _:
                    return false
            return true

        def proof_replay_call_body(body: darray[Ast::Stmt]&, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            mark: usize = bindings.count
            valid: bool = proof_replay_call_statements(body, bindings, calls, call_target, work, depth)
            bindings.resize(mark)
            return valid

        # Captured statement loops have a parser Block wrapper with an Invalid
        # value sentinel, not an evaluated result. Admit that sentinel only at
        # statement position and only for declarations followed by one loop.
        # Every initializer, loop condition and body still gets an independent
        # call walk. Invalid values elsewhere continue to fail closed.
        def proof_replay_call_statement_expression(expression: Ast::Expr, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match expression:
                Ast::Expr.Block(nested, Ast::Expr.Invalid, captures, _):
                    return false if nested.count == 0
                    for index in 0..<nested.count |index, nested|:
                        if index + 1 == nested.count:
                            match nested[index]:
                                Ast::Stmt.While(_, _, _) | Ast::Stmt.For(_, _, _, _, _):
                                    pass
                                _:
                                    return false
                        else:
                            match nested[index]:
                                Ast::Stmt.VarDecl(_, _, _, _):
                                    pass
                                _:
                                    return false
                    mark: usize = bindings.count
                    bindings.extend(captures)
                    valid: bool = proof_replay_call_body(&nested, bindings, calls, call_target, work, depth + 1)
                    bindings.resize(mark)
                    return valid
                _:
                    return proof_replay_call_expression(expression, bindings, calls, call_target, work, depth + 1)

        def proof_replay_call_statements(body: darray[Ast::Stmt]&, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for statement in body |bindings, calls, call_target, work, depth|:
                return false if not proof_replay_call_work_add(work, 1)
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return false if not proof_replay_call_expression(returned, bindings, calls, call_target, work, depth + 1)
                    Ast::Stmt.Expr(value, _):
                        return false if not proof_replay_call_statement_expression(value, bindings, calls, call_target, work, depth + 1)
                    Ast::Stmt.VarDecl(name, _, value, _):
                        return false if not proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1)
                        bindings.push(name)
                    Ast::Stmt.Assign(target, operator, value, _):
                        return false if not proof_replay_call_expression(target, bindings, calls, call_target, work, depth + 1) or not proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1)
                        if operator == TokenKind.Assign:
                            match target:
                                Ast::Expr.Ident(name, _):
                                    bindings.push(name)
                                _:
                                    return false
                    Ast::Stmt.If(condition, yes, no, position):
                        return false if not proof_replay_call_expression(condition, bindings, calls, call_target, work, depth + 1) or not proof_replay_call_body(&yes, bindings, calls, call_target, work, depth + 1) or not proof_replay_call_body(&no, bindings, calls, call_target, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        return false if not proof_replay_call_expression(condition, bindings, calls, call_target, work, depth + 1) or not proof_replay_call_body(&nested, bindings, calls, call_target, work, depth + 1)
                    Ast::Stmt.For(_, variables, iterable, nested, _):
                        return false if not proof_replay_call_expression(iterable, bindings, calls, call_target, work, depth + 1)
                        mark: usize = bindings.count
                        bindings.extend(variables)
                        return false if not proof_replay_call_body(&nested, bindings, calls, call_target, work, depth + 1)
                        bindings.resize(mark)
                    Ast::Stmt.Match(value, arms, _):
                        return false if not proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1) or not proof_replay_call_arms(&arms, bindings, calls, call_target, work, depth + 1)
                    Ast::Stmt.Block(kind, _, binding, nested, _):
                        mark: usize = bindings.count
                        bindings.push(binding) if binding != ""
                        if kind == "assert_by":
                            return false if nested.count == 0
                            match nested[0]:
                                Ast::Stmt.Contract("assert", goal, _):
                                    return false if not proof_replay_call_expression(goal, bindings, calls, call_target, work, depth + 1)
                                _:
                                    return false
                        else:
                            return false if not proof_replay_call_body(&nested, bindings, calls, call_target, work, depth + 1)
                        bindings.resize(mark)
                    Ast::Stmt.Contract(kind, value, _):
                        if kind == "assert" or (call_target.include_nonassert_contract_calls and kind != ""):
                            return false if not proof_replay_call_expression(value, bindings, calls, call_target, work, depth + 1)
                    Ast::Stmt.Break(_, _):
                        pass
                    Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_source_calls(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, calls: mutable darray[sview]&) -> bool:
            work: mutable usize = 0
            return proof_replay_source_calls_with_work(parameters, body, calls, &work)

        def proof_replay_source_calls_with_work(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, calls: mutable darray[sview]&, work: mutable usize&) -> bool:
            target: mutable ProofReplayCallSiteTarget = ProofReplayCallSiteTarget{enabled: false, ignore_unmatched_scoped_edges: false, allow_scoped_target: false, include_nonassert_contract_calls: false, offset: 0, line: 0, name: "", calls_at_offset: 0, matched_calls: 0}
            return proof_replay_source_calls_with_target_work(parameters, body, calls, target, work)

        def proof_replay_source_calls_with_target_work(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            calls.clear()
            call_target.calls_at_offset <- 0
            call_target.matched_calls <- 0
            bindings: mutable darray[sview] = []
            return false if not proof_replay_call_work_add(work, parameters.count)
            # Defaults are executable at omitted-argument calls; preserve their edges
            # rather than assuming a call-site always supplies every argument.
            for parameter in parameters |bindings, work|:
                return false if not proof_replay_call_work_add(work, sview_len(parameter.name))
                bindings.push(parameter.name)
            return false if not proof_replay_call_work_add(work, parameters.count)
            for parameter in parameters |bindings, calls, work|:
                return false if not proof_replay_call_work_add(work, 1)
                if parameter.has_default:
                    body_target_enabled: bool = call_target.enabled
                    call_target.enabled <- false
                    if not proof_replay_call_expression(parameter.default_value, &bindings, calls, call_target, work, 0):
                        calls.clear()
                        return false
                    call_target.enabled <- body_target_enabled
            if not proof_replay_call_body(body, &bindings, calls, call_target, work, 0):
                calls.clear()
                return false
            return true

        # Signature contract expressions live outside the declaration body. The structural
        # call graph must include them because the producer's SCC table includes their direct
        # calls. The caller supplies one source expression at a time and shares the graph's
        # cumulative source-work meter.
        def proof_replay_source_expression_calls_with_work(parameters: darray[Ast::ParamDecl]&, expression: Ast::Expr, calls: mutable darray[sview]&, work: mutable usize&) -> bool:
            bindings: mutable darray[sview] = []
            return false if not proof_replay_call_work_add(work, parameters.count)
            for parameter in parameters |bindings, work|:
                return false if not proof_replay_call_work_add(work, sview_len(parameter.name))
                bindings.push(parameter.name)
            target: mutable ProofReplayCallSiteTarget = ProofReplayCallSiteTarget{enabled: false, ignore_unmatched_scoped_edges: false, allow_scoped_target: false, include_nonassert_contract_calls: false, offset: 0, line: 0, name: "", calls_at_offset: 0, matched_calls: 0}
            return proof_replay_call_expression(expression, &bindings, calls, target, work, 0)

        def proof_replay_source_call_set_matches(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expected: darray[sview]&) -> bool:
            work: mutable usize = 0
            return proof_replay_source_call_set_matches_with_work(parameters, body, expected, &work)

        def proof_replay_source_call_set_matches_with_work(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expected: darray[sview]&, work: mutable usize&) -> bool:
            calls: mutable darray[sview] = []
            return false if not proof_replay_source_calls_with_work(parameters, body, &calls, work) or calls.count != expected.count
            for index in 0..<expected.count |index, expected, calls, work|:
                name: sview = expected[index]
                matched: mutable bool = false
                for called in calls |called, name, matched, work|:
                    return false if not proof_replay_call_string_compare_charge(called, name, work)
                    matched <- true if called == name
                return false if not matched
                for earlier in 0..<index |earlier, expected, name|:
                    return false if not proof_replay_call_string_compare_charge(expected[earlier], name, work)
                    return false if expected[earlier] == name
            return true
