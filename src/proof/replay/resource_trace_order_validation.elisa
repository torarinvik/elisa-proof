extend ElisaProof:
    private:
        def proof_replay_resource_return_stmt_end_with_work(statement: Ast::Stmt, source_work: mutable usize&, depth: usize, maximum_end: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            position: Ast::Pos = Ast::stmt_pos(statement)
            maximum_end <- position.end_offset.usize() if position.offset > 0 and position.end_offset.usize() > maximum_end
            match statement:
                Ast::Stmt.Invalid:
                    return false
                Ast::Stmt.Expr(expression, _) | Ast::Stmt.Contract(_, expression, _):
                    proof_replay_resource_return_expr_end_with_work(expression, source_work, depth + 1, maximum_end)
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        return proof_replay_resource_return_expr_end_with_work(returned, source_work, depth + 1, maximum_end)
                    return true
                Ast::Stmt.Block(_, _, _, body, _):
                    for nested in body |nested, source_work, depth, maximum_end|:
                        return false if not proof_replay_resource_return_stmt_end_with_work(nested, source_work, depth + 1, maximum_end)
                    return true
                Ast::Stmt.While(condition, body, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(condition, source_work, depth + 1, maximum_end)
                    for nested in body |nested, source_work, depth, maximum_end|:
                        return false if not proof_replay_resource_return_stmt_end_with_work(nested, source_work, depth + 1, maximum_end)
                    return true
                Ast::Stmt.For(_, _, iterable, body, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(iterable, source_work, depth + 1, maximum_end)
                    for nested in body |nested, source_work, depth, maximum_end|:
                        return false if not proof_replay_resource_return_stmt_end_with_work(nested, source_work, depth + 1, maximum_end)
                    return true
                Ast::Stmt.VarDecl(_, _, value, _):
                    proof_replay_resource_return_expr_end_with_work(value, source_work, depth + 1, maximum_end)
                Ast::Stmt.Assign(target, _, value, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(target, source_work, depth + 1, maximum_end)
                    proof_replay_resource_return_expr_end_with_work(value, source_work, depth + 1, maximum_end)
                Ast::Stmt.If(condition, yes, no, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(condition, source_work, depth + 1, maximum_end)
                    for nested in yes |nested, source_work, depth, maximum_end|:
                        return false if not proof_replay_resource_return_stmt_end_with_work(nested, source_work, depth + 1, maximum_end)
                    for nested in no |nested, source_work, depth, maximum_end|:
                        return false if not proof_replay_resource_return_stmt_end_with_work(nested, source_work, depth + 1, maximum_end)
                    return true
                Ast::Stmt.Match(scrutinee, arms, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(scrutinee, source_work, depth + 1, maximum_end)
                    for arm in arms |arm, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work)
                        return false if not proof_replay_resource_return_expr_end_with_work(arm.guard, source_work, depth + 1, maximum_end)
                        for nested in arm.body |nested, source_work, depth, maximum_end|:
                            return false if not proof_replay_resource_return_stmt_end_with_work(nested, source_work, depth + 1, maximum_end)
                    return true
                Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                    return true

        # Parser positions on compound expressions can identify only the operator or
        # opening token (notably calls), so derive the evaluated value's boundary from
        # its positioned descendants. This bounded walk follows evaluated children into
        # control-flow arms and statement bodies; malformed and unknown shapes fail closed.
        def proof_replay_resource_return_expr_end_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize, maximum_end: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            position: Ast::Pos = Ast::expr_pos(expression)
            maximum_end <- position.end_offset.usize() if position.offset > 0 and position.end_offset.usize() > maximum_end
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(callee, source_work, depth + 1, maximum_end)
                    for argument in arguments |argument, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_resource_return_expr_end_with_work(argument, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.StaticEffectCall(effect_type, _, candidates, arguments, argument_names, _):
                    return false if candidates.count != 1 or argument_names.count != 0 and argument_names.count != arguments.count
                    return false if not proof_replay_resource_return_expr_end_with_work(effect_type, source_work, depth + 1, maximum_end)
                    return false if not proof_replay_owner_work_charge(1, source_work)
                    candidate: Ast::StaticEffectCandidate = candidates[0]
                    return false if not proof_replay_owner_work_charge(sview_len(candidate.callee), source_work) or candidate.callee == ""
                    for capture in candidate.captures |capture, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_resource_return_expr_end_with_work(capture, source_work, depth + 1, maximum_end)
                    for argument in arguments |argument, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_resource_return_expr_end_with_work(argument, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |element, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_resource_return_expr_end_with_work(element, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work)
                        return false if not proof_replay_resource_return_expr_end_with_work(entry.key, source_work, depth + 1, maximum_end)
                        return false if not proof_replay_resource_return_expr_end_with_work(entry.value, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_resource_return_expr_end_with_work(field.value, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(base, source_work, depth + 1, maximum_end)
                    for field in fields |field, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_resource_return_expr_end_with_work(field.value, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_resource_return_expr_end_with_work(object, source_work, depth + 1, maximum_end)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(object, source_work, depth + 1, maximum_end)
                    proof_replay_resource_return_expr_end_with_work(index, source_work, depth + 1, maximum_end)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(object, source_work, depth + 1, maximum_end)
                    return false if not proof_replay_resource_return_expr_end_with_work(low, source_work, depth + 1, maximum_end)
                    proof_replay_resource_return_expr_end_with_work(high, source_work, depth + 1, maximum_end)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(object, source_work, depth + 1, maximum_end)
                    for argument in arguments |argument, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_resource_return_expr_end_with_work(argument, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.If(condition, then_value, else_value, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(condition, source_work, depth + 1, maximum_end)
                    return false if not proof_replay_resource_return_expr_end_with_work(then_value, source_work, depth + 1, maximum_end)
                    proof_replay_resource_return_expr_end_with_work(else_value, source_work, depth + 1, maximum_end)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(iterable, source_work, depth + 1, maximum_end)
                    return false if not proof_replay_resource_return_expr_end_with_work(condition, source_work, depth + 1, maximum_end)
                    proof_replay_resource_return_expr_end_with_work(body, source_work, depth + 1, maximum_end)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(base, source_work, depth + 1, maximum_end)
                    proof_replay_resource_return_expr_end_with_work(predicate, source_work, depth + 1, maximum_end)
                Ast::Expr.Match(scrutinee, arms, _) | Ast::Expr.Catch(scrutinee, arms, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(scrutinee, source_work, depth + 1, maximum_end)
                    for arm in arms |arm, source_work, depth, maximum_end|:
                        return false if not proof_replay_owner_work_charge(1, source_work)
                        return false if not proof_replay_resource_return_expr_end_with_work(arm.guard, source_work, depth + 1, maximum_end)
                        for statement in arm.body |statement, source_work, depth, maximum_end|:
                            return false if not proof_replay_resource_return_stmt_end_with_work(statement, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_resource_return_expr_end_with_work(guarded, source_work, depth + 1, maximum_end)
                    for statement in recovery |statement, source_work, depth, maximum_end|:
                        return false if not proof_replay_resource_return_stmt_end_with_work(statement, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.Lambda(_, body, _):
                    for statement in body |statement, source_work, depth, maximum_end|:
                        return false if not proof_replay_resource_return_stmt_end_with_work(statement, source_work, depth + 1, maximum_end)
                    return true
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements |statement, source_work, depth, maximum_end|:
                        return false if not proof_replay_resource_return_stmt_end_with_work(statement, source_work, depth + 1, maximum_end)
                    proof_replay_resource_return_expr_end_with_work(value, source_work, depth + 1, maximum_end)
                _:
                    return false

        # Resource events are serialized in producer AST-walk order. Check that every
        # source-positioned transition remains in that order after flattening lexical
        # scope wrappers. Normalize valued returns to the supported value-expression end
        # and post-body block closes to their statement end before comparing them.
        # Build the statement-span tables once per owner. The trace-order walk then does
        # logarithmic lookups instead of rescanning a large function body for every return
        # marker and region close.
        def proof_replay_resource_order_statement_spans_build_with_work(body: darray[Ast::Stmt]&, block_starts: mutable darray[usize]&, block_ends: mutable darray[usize]&, return_starts: mutable darray[usize]&, return_ends: mutable darray[usize]&, expected_region_open_offsets: mutable darray[usize]&, expected_region_open_names: mutable darray[sview]&, expected_region_close_offsets: mutable darray[usize]&, expected_region_close_names: mutable darray[sview]&, last_block_start: mutable usize&, last_return_start: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for statement in body |block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, depth|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                match statement:
                    Ast::Stmt.Return(expression, position):
                        start: usize = position.offset.usize()
                        finish: mutable usize = position.end_offset.usize()
                        # The parser stores only the `return` keyword span on the statement.
                        # Resource-use events from a returned value occur later, so use the
                        # maximum positioned descendant supported by the bounded walker.
                        if not (expression is Ast::Expr.Absent):
                            return false if not proof_replay_resource_return_expr_end_with_work(expression, source_work, 0, &finish)
                        return false if start == 0 or finish < start or return_starts.count > 0 and start <= last_return_start
                        return_starts.push(start)
                        return_ends.push(finish)
                        last_return_start <- start
                    Ast::Stmt.Block(kind, clause, binding, nested, position):
                        # Deferred bodies execute at scope exit, so their resource transitions
                        # cannot be ordered as if they ran at this source position. Until replay
                        # has an exit-time transition model, refuse this owner's trace.
                        return false if kind == "defer"
                        start: usize = position.offset.usize()
                        finish: usize = position.end_offset.usize()
                        return false if start == 0 or finish < start or block_starts.count > 0 and start <= last_block_start
                        block_starts.push(start)
                        block_ends.push(finish)
                        last_block_start <- start
                        if kind == "region":
                            return false if binding != "" and nested.count != 0 or binding == "" and clause.count == 0
                            region_name: sview = binding if binding != "" else clause[0]
                            return false if region_name == "" or not proof_replay_owner_work_charge(sview_len(region_name), source_work)
                            expected_region_open_offsets.push(start)
                            expected_region_open_names.push(region_name)
                            lexical_region: bool = binding == ""
                            return false if not proof_replay_resource_order_statement_spans_build_with_work(nested, block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, depth + 1)
                            if lexical_region:
                                expected_region_close_offsets.push(start)
                                expected_region_close_names.push(region_name)
                            continue
                        if kind == "destroy":
                            region_name: sview = clause[0] if clause.count > 0 else binding
                            return false if region_name == "" or not proof_replay_owner_work_charge(sview_len(region_name), source_work)
                            expected_region_close_offsets.push(start)
                            expected_region_close_names.push(region_name)
                            continue
                        return false if not proof_replay_resource_order_statement_spans_build_with_work(nested, block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, depth + 1)
                    Ast::Stmt.If(_, yes, no, _):
                        return false if not proof_replay_resource_order_statement_spans_build_with_work(yes, block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, depth + 1)
                        return false if not proof_replay_resource_order_statement_spans_build_with_work(no, block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, depth + 1)
                    Ast::Stmt.While(_, nested, _) | Ast::Stmt.For(_, _, _, nested, _):
                        return false if not proof_replay_resource_order_statement_spans_build_with_work(nested, block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, depth|:
                            return false if not proof_replay_owner_work_charge(1, source_work)
                            return false if not proof_replay_resource_order_statement_spans_build_with_work(arm.body, block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, depth + 1)
                    Ast::Stmt.VarDecl(_, _, _, _) | Ast::Stmt.Expr(_, _) | Ast::Stmt.Contract(_, _, _) | Ast::Stmt.Assign(_, _, _, _) | Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        return false
                    _:
                        return false
            return false if block_starts.count != block_ends.count or return_starts.count != return_ends.count
            true

        def proof_replay_resource_order_statement_end_lookup_with_work(starts: darray[usize]&, ends: darray[usize]&, offset: usize, source_work: mutable usize&) -> (complete: bool, end_offset: usize):
            return (false, 0) if starts.count != ends.count
            low: mutable usize = 0
            high: mutable usize = starts.count
            while low < high |low, high, starts, ends, offset, source_work|:
                return (false, 0) if not proof_replay_owner_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                return (false, 0) if middle >= starts.count or middle >= ends.count
                if starts[middle] == offset:
                    return (true, ends[middle])
                if starts[middle] < offset:
                    low <- middle + 1
                else:
                    high <- middle
            return (false, 0)

        def proof_replay_resource_event_offsets_ordered_with_work(report: ProofReport&, root: usize, owner_root: usize, body: darray[Ast::Stmt]&, block_starts: darray[usize]&, block_ends: darray[usize]&, return_starts: darray[usize]&, return_ends: darray[usize]&, actual_region_open_offsets: mutable darray[usize]&, actual_region_open_names: mutable darray[sview]&, actual_region_close_offsets: mutable darray[usize]&, actual_region_close_names: mutable darray[sview]&, prior_return_allocations: mutable darray[usize]&, previous_offset: mutable usize&, has_previous: mutable bool&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT or root >= report.analysis_1.kernel.nodes.count
            return false if owner_root >= report.analysis_1.kernel.nodes.count
            return false if not proof_replay_owner_work_charge(1, source_work)
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[root]
            owner_node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[owner_root]
            return false if node.children_start > report.analysis_1.kernel.children.count or node.children_count > report.analysis_1.kernel.children.count - node.children_start
            # This dispatch checks containers, transitions, and positioned event kinds; charge
            # for every possible comparison against the serialized node tag.
            return false if not proof_replay_resource_event_kind_dispatch_work(node.kind, "", 32, source_work)
            if node.kind in {"resource-safety", "resource-scope", "resource-alternatives"}:
                for index in 0..<node.children_count |index, report, node, owner_root, body, block_starts, block_ends, return_starts, return_ends, actual_region_open_offsets, actual_region_open_names, actual_region_close_offsets, actual_region_close_names, prior_return_allocations, previous_offset, has_previous, source_work, depth|:
                    return false if not proof_replay_owner_work_charge(1, source_work)
                    child: usize = report.analysis_1.kernel.children[node.children_start + index]
                    return false if not proof_replay_resource_event_offsets_ordered_with_work(report, child, owner_root, body, block_starts, block_ends, return_starts, return_ends, actual_region_open_offsets, actual_region_open_names, actual_region_close_offsets, actual_region_close_names, prior_return_allocations, previous_offset, has_previous, source_work, depth + 1)
                return true
            # Disjointness children are logical premises, not transitions in the source
            # execution trace. Their provenance is checked by the separate fact validator.
            return true if node.kind == "resource-disjoint"
            # All remaining nodes are transition leaves. Check this before the implicit-close
            # fast path so no special event can bypass the source-order walk's leaf invariant.
            return false if node.children_start != 0 or node.children_count != 0
            if node.kind == "resource-region-return":
                return false if node.left >= report.analysis_1.kernel.nodes.count
                witness_kind: sview = report.analysis_1.kernel.nodes[node.left].kind
                return false if not proof_replay_owner_work_charge(sview_len(witness_kind), source_work)
                if witness_kind == "resource-region-return-alloc":
                    witnessed_before_marker: mutable bool = false
                    for prior_root in prior_return_allocations |prior_root, node, prior_return_allocations, witnessed_before_marker, source_work|:
                        return false if not proof_replay_owner_work_charge(1, source_work)
                        witnessed_before_marker <- true if prior_root == node.left
                    return false if not witnessed_before_marker
            if node.kind == "resource-region-open":
                return false if not proof_replay_owner_work_charge(sview_len(node.name), source_work)
                actual_region_open_offsets.push(node.value.usize())
                actual_region_open_names.push(node.name)
            if node.kind == "resource-region-close" and node.value > 0:
                return false if not proof_replay_owner_work_charge(sview_len(node.name), source_work)
                actual_region_close_offsets.push(node.value.usize())
                actual_region_close_names.push(node.name)
            # Writes carry the assignment's parser-owned offset too. Omitting them allowed a
            # trace to move an authenticated write across a move or region transition while
            # retaining individually valid source witnesses.
            positioned: bool = node.kind in {"resource-region-open", "resource-region-close", "resource-region-alloc-discard", "resource-region-return-alloc", "resource-region-rebind-alloc", "resource-region-assign", "resource-use", "resource-write", "resource-move", "resource-region-return", "resource-call", "resource-call-lend"} or node.kind == "resource-bind" and node.value > 0
            if positioned:
                return false if node.value < 0 or node.value > 4294967295
                return true if node.kind == "resource-region-close" and node.value == 0 and node.auxiliary == 0
                return false if node.value == 0
                current_offset: usize = node.value.usize()
                if node.kind == "resource-region-assign":
                    assignment_matches: mutable usize = 0
                    assignment_value: mutable Ast::Expr = Ast::Expr.Invalid
                    return false if not proof_replay_resource_event_find_statements_with_work(body, current_offset, node.kind, node.name, assignment_matches, assignment_value, source_work, 0)
                    return false if assignment_matches != 1 or assignment_value is Ast::Expr.Invalid
                    assignment_end: mutable usize = current_offset
                    return false if not proof_replay_resource_return_expr_end_with_work(assignment_value, source_work, 0, &assignment_end) or assignment_end < current_offset
                    current_offset <- assignment_end
                if node.kind == "resource-region-rebind-alloc":
                    assignment_matches: mutable usize = 0
                    assignment_value: mutable Ast::Expr = Ast::Expr.Invalid
                    return false if not proof_replay_resource_event_find_statements_with_work(body, current_offset, node.kind, node.name, assignment_matches, assignment_value, source_work, 0)
                    return false if assignment_matches != 1 or assignment_value is Ast::Expr.Invalid
                    assignment_end: mutable usize = current_offset
                    return false if not proof_replay_resource_return_expr_end_with_work(assignment_value, source_work, 0, &assignment_end) or assignment_end < current_offset
                    current_offset <- assignment_end
                if node.kind == "resource-call" or node.kind == "resource-call-lend":
                    call_position: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: current_offset.u32(), end_line: 0, end_column: 0, end_offset: 0}
                    frame_work: mutable usize = 0
                    selected: (known: bool, expression: Ast::Expr, callee: sview, callee_line: u32, callee_offset: u32) = ElisaProofFrameSource::source_call_at_owner_with_work(report.source.source_declarations, report.source.source_annotations, owner_node.name, owner_node.right.u32(), owner_node.value.u32(), call_position, &frame_work)
                    frame_work_charged: bool = proof_replay_owner_work_charge(frame_work, source_work)
                    return false if not frame_work_charged or not selected.known
                    call_end: mutable usize = 0
                    return false if not proof_replay_resource_return_expr_end_with_work(selected.expression, source_work, 0, &call_end)
                    return false if call_end < current_offset
                    current_offset <- call_end
                if node.kind == "resource-move":
                    # The parser positions `move` at its keyword, before the operand. The
                    # producer visits the operand first (emitting its resource-use events),
                    # then emits the move transition. Compare the move at the end of that
                    # evaluated operand so valid `move x` traces remain ordered and later
                    # sibling effects still cannot cross the transition.
                    move_matches: mutable usize = 0
                    move_operand: mutable Ast::Expr = Ast::Expr.Invalid
                    return false if not proof_replay_resource_event_find_statements_with_work(body, current_offset, "resource-move", node.name, move_matches, move_operand, source_work, 0)
                    return false if move_matches != 1 or move_operand is Ast::Expr.Invalid
                    move_end: mutable usize = current_offset
                    return false if not proof_replay_resource_return_expr_end_with_work(move_operand, source_work, 0, &move_end) or move_end < current_offset
                    current_offset <- move_end
                if node.kind == "resource-region-close" or node.kind == "resource-region-return" or node.kind == "resource-region-return-alloc":
                    span: (complete: bool, end_offset: usize) = proof_replay_resource_order_statement_end_lookup_with_work(block_starts, block_ends, current_offset, source_work) if node.kind == "resource-region-close" else proof_replay_resource_order_statement_end_lookup_with_work(return_starts, return_ends, current_offset, source_work)
                    return false if not span.complete or span.end_offset < current_offset
                    current_offset <- span.end_offset
                return false if has_previous and current_offset < previous_offset
                previous_offset <- current_offset
                has_previous <- true
            if node.kind == "resource-region-return-alloc":
                return false if not proof_replay_owner_work_charge(1, source_work)
                prior_return_allocations.push(root)
            true

        def proof_replay_resource_event_offsets_ordered_for_owner_with_work(report: ProofReport&, root: usize, owner: sview, owner_line: u32, owner_offset: usize, owner_module: sview, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if not proof_replay_deterministic_call_declaration_index_ensure(report, source_work, &cache.deterministic_calls)
            located: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.deterministic_calls.declaration_index, owner, owner_line, owner_offset, source_work)
            return false if not located.complete or located.matches != 1 or located.row >= cache.deterministic_calls.declaration_index.entries.count
            entry: ProofReplayDeterministicDeclarationEntry = cache.deterministic_calls.declaration_index.entries[located.row]
            return false if entry.owner != owner_module
            body: darray[Ast::Stmt] = []
            match entry.declaration:
                Ast::Decl.Func(_, _, _, declared_body, _, _, _):
                    body <- declared_body
                _:
                    return false
            defer_blocks: mutable usize = 0
            found_expression: mutable Ast::Expr = Ast::Expr.Absent
            return false if not proof_replay_resource_event_find_statements_with_work(body, 0, "resource-defer-inventory", "", defer_blocks, found_expression, source_work, 0) or defer_blocks != 0
            block_starts: mutable darray[usize] = []
            block_ends: mutable darray[usize] = []
            return_starts: mutable darray[usize] = []
            return_ends: mutable darray[usize] = []
            expected_region_open_offsets: mutable darray[usize] = []
            expected_region_open_names: mutable darray[sview] = []
            expected_region_close_offsets: mutable darray[usize] = []
            expected_region_close_names: mutable darray[sview] = []
            actual_region_open_offsets: mutable darray[usize] = []
            actual_region_open_names: mutable darray[sview] = []
            actual_region_close_offsets: mutable darray[usize] = []
            actual_region_close_names: mutable darray[sview] = []
            prior_return_allocations: mutable darray[usize] = []
            last_block_start: mutable usize = 0
            last_return_start: mutable usize = 0
            return false if not proof_replay_resource_order_statement_spans_build_with_work(body, block_starts, block_ends, return_starts, return_ends, expected_region_open_offsets, expected_region_open_names, expected_region_close_offsets, expected_region_close_names, last_block_start, last_return_start, source_work, 0)
            previous_offset: mutable usize = 0
            has_previous: mutable bool = false
            return false if not proof_replay_resource_event_offsets_ordered_with_work(report, root, root, body, block_starts, block_ends, return_starts, return_ends, actual_region_open_offsets, actual_region_open_names, actual_region_close_offsets, actual_region_close_names, prior_return_allocations, previous_offset, has_previous, source_work, 0)
            return false if expected_region_open_offsets.count != expected_region_open_names.count or expected_region_close_offsets.count != expected_region_close_names.count
            return false if actual_region_open_offsets.count != actual_region_open_names.count or actual_region_close_offsets.count != actual_region_close_names.count
            return false if expected_region_open_offsets.count != actual_region_open_offsets.count or expected_region_close_offsets.count != actual_region_close_offsets.count
            for index in 0..<expected_region_open_offsets.count |index, expected_region_open_offsets, expected_region_open_names, actual_region_open_offsets, actual_region_open_names, source_work|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                return false if expected_region_open_offsets[index] != actual_region_open_offsets[index] or expected_region_open_names[index] != actual_region_open_names[index]
            for index in 0..<expected_region_close_offsets.count |index, expected_region_close_offsets, expected_region_close_names, actual_region_close_offsets, actual_region_close_names, source_work|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                return false if expected_region_close_offsets[index] != actual_region_close_offsets[index] or expected_region_close_names[index] != actual_region_close_names[index]
            true
