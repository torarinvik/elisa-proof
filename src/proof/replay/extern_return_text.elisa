# Exact metadata correspondence only. This does not resolve a type, prove a
# native result bound, or establish ownership/lifetime behavior. Production
# admission must also bind the declaration and independently checked type.
extend ElisaProof:
    private:
        def proof_replay_extern_return_text_matches(annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, expected: sview) -> bool:
            return false if name == "" or expected == ""
            markers: mutable usize = 0
            rows: mutable usize = 0
            for index in 0..<annotations.count |index, annotations, name, line, expected, markers, rows|:
                annotation: Ast::EnumAnnotation = annotations[index]
                continue if annotation.line != line
                if annotation.name == "__extern_return_text_complete":
                    return false if annotation.owner != name
                    markers <- markers + 1
                    return false if index + 1 >= annotations.count
                    adjacent: Ast::EnumAnnotation = annotations[index + 1]
                    return false if adjacent.line != line or adjacent.owner != "__extern_return_text" or adjacent.name != expected
                if annotation.owner == "__extern_return_text":
                    rows <- rows + 1
                    return false if annotation.name != expected or index == 0
                    previous: Ast::EnumAnnotation = annotations[index - 1]
                    return false if previous.line != line or previous.owner != name or previous.name != "__extern_return_text_complete"
            return markers == 1 and rows == 1
