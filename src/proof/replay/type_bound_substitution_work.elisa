# Work-metered result substitution for source-authenticated type-bound replay.
extend ElisaProof:
    private:
        def proof_replay_type_bound_substitute_with_work(expression: Ast::Expr, name: sview, value: Ast::Expr, work: mutable usize&) -> (complete: bool, expression: Ast::Expr):
            return proof_replay_type_bound_substitute_depth_with_work(expression, name, value, 0, work)

        def proof_replay_type_bound_substitute_depth_with_work(expression: Ast::Expr, name: sview, value: Ast::Expr, depth: usize, work: mutable usize&) -> (complete: bool, expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return (true, expression)
                Ast::Expr.Ident(expression_name, _):
                    return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(sview_len(expression_name), work) or not proof_replay_type_bound_local_work_charge(sview_len(name), work) or not proof_replay_type_bound_local_work_charge(1, work)
                    return (true, value) if expression_name == name
                    return (true, expression)
                Ast::Expr.Paren(inner, position):
                    substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(inner, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted.complete
                    return (true, Ast::Expr.Paren(substituted.expression, position))
                Ast::Expr.Unary(operator, operand, position):
                    substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(operand, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted.complete
                    return (true, Ast::Expr.Unary(operator, substituted.expression, position))
                Ast::Expr.Binary(left, operator, right, position):
                    substituted_left: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(left, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_left.complete
                    substituted_right: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(right, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_right.complete
                    return (true, Ast::Expr.Binary(substituted_left.expression, operator, substituted_right.expression, position))
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    substituted_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |substituted_arguments, name, value, depth, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(argument, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted.complete
                        substituted_arguments.push(substituted.expression)
                    substituted_callee: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(callee, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_callee.complete
                    return (true, Ast::Expr.Call(substituted_callee.expression, substituted_arguments, argument_names, position))
                Ast::Expr.Field(object, field, position):
                    substituted_object: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(object, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_object.complete
                    match substituted_object.expression:
                        Ast::Expr.Construct(_, fields, _):
                            for initializer in fields |field, work|:
                                return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work) or not proof_replay_type_bound_local_work_charge(sview_len(initializer.name), work) or not proof_replay_type_bound_local_work_charge(sview_len(field), work) or not proof_replay_type_bound_local_work_charge(1, work)
                                return (true, initializer.value) if initializer.name == field
                        Ast::Expr.RecordUpdate(base, fields, _):
                            for initializer in fields |field, work|:
                                return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work) or not proof_replay_type_bound_local_work_charge(sview_len(initializer.name), work) or not proof_replay_type_bound_local_work_charge(sview_len(field), work) or not proof_replay_type_bound_local_work_charge(1, work)
                                return (true, initializer.value) if initializer.name == field
                            return (true, Ast::Expr.Field(base, field, position))
                        _:
                            pass
                    return (true, Ast::Expr.Field(substituted_object.expression, field, position))
                Ast::Expr.Scope(base, member, position):
                    substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(base, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted.complete
                    return (true, Ast::Expr.Scope(substituted.expression, member, position))
                Ast::Expr.Index(object, index, position):
                    substituted_object: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(object, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_object.complete
                    substituted_index: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(index, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_index.complete
                    return (true, Ast::Expr.Index(substituted_object.expression, substituted_index.expression, position))
                Ast::Expr.Slice(object, low, high, position):
                    substituted_object: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(object, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_object.complete
                    substituted_low: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(low, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_low.complete
                    substituted_high: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(high, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_high.complete
                    return (true, Ast::Expr.Slice(substituted_object.expression, substituted_low.expression, substituted_high.expression, position))
                Ast::Expr.IndexN(object, arguments, position):
                    substituted_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |substituted_arguments, name, value, depth, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(argument, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted.complete
                        substituted_arguments.push(substituted.expression)
                    substituted_object: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(object, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_object.complete
                    return (true, Ast::Expr.IndexN(substituted_object.expression, substituted_arguments, position))
                Ast::Expr.Move(operand, position):
                    substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(operand, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted.complete
                    return (true, Ast::Expr.Move(substituted.expression, position))
                Ast::Expr.RegionNew(operand, region, position):
                    substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(operand, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted.complete
                    return (true, Ast::Expr.RegionNew(substituted.expression, region, position))
                Ast::Expr.Array(elements, position):
                    substituted_elements: mutable darray[Ast::Expr] = []
                    for element in elements |substituted_elements, name, value, depth, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(element, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted.complete
                        substituted_elements.push(substituted.expression)
                    return (true, Ast::Expr.Array(substituted_elements, position))
                Ast::Expr.Tuple(elements, position):
                    substituted_elements: mutable darray[Ast::Expr] = []
                    for element in elements |substituted_elements, name, value, depth, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(element, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted.complete
                        substituted_elements.push(substituted.expression)
                    return (true, Ast::Expr.Tuple(substituted_elements, position))
                Ast::Expr.SetLit(elements, position):
                    substituted_elements: mutable darray[Ast::Expr] = []
                    for element in elements |substituted_elements, name, value, depth, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(element, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted.complete
                        substituted_elements.push(substituted.expression)
                    return (true, Ast::Expr.SetLit(substituted_elements, position))
                Ast::Expr.DictLit(entries, position):
                    substituted_entries: mutable darray[Ast::DictEntry] = []
                    for entry in entries |substituted_entries, name, value, depth, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        substituted_key: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(entry.key, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted_key.complete
                        substituted_value: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(entry.value, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted_value.complete
                        substituted_entries.push(Ast::DictEntry{key: substituted_key.expression, value: substituted_value.expression})
                    return (true, Ast::Expr.DictLit(substituted_entries, position))
                Ast::Expr.Construct(type_expression, fields, position):
                    substituted_fields: mutable darray[Ast::FieldInit] = []
                    for initializer in fields |substituted_fields, name, value, depth, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(initializer.value, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted.complete
                        substituted_fields.push(Ast::FieldInit{name: initializer.name, value: substituted.expression})
                    return (true, Ast::Expr.Construct(type_expression, substituted_fields, position))
                Ast::Expr.RecordUpdate(base, fields, position):
                    substituted_fields: mutable darray[Ast::FieldInit] = []
                    for initializer in fields |substituted_fields, name, value, depth, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(initializer.value, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted.complete
                        substituted_fields.push(Ast::FieldInit{name: initializer.name, value: substituted.expression})
                    substituted_base: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(base, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_base.complete
                    return (true, Ast::Expr.RecordUpdate(substituted_base.expression, substituted_fields, position))
                Ast::Expr.If(condition, then_expression, else_expression, position):
                    substituted_condition: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(condition, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_condition.complete
                    substituted_then: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(then_expression, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_then.complete
                    substituted_else: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(else_expression, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_else.complete
                    return (true, Ast::Expr.If(substituted_condition.expression, substituted_then.expression, substituted_else.expression, position))
                Ast::Expr.GetElse(guarded, _, _):
                    return proof_replay_type_bound_substitute_depth_with_work(guarded, name, value, depth + 1, work)
                Ast::Expr.Comprehension(variable, iterable, condition, body, position):
                    substituted_iterable: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(iterable, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_iterable.complete
                    return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(sview_len(variable), work) or not proof_replay_type_bound_local_work_charge(sview_len(name), work) or not proof_replay_type_bound_local_work_charge(1, work)
                    return (true, Ast::Expr.Comprehension(variable, substituted_iterable.expression, condition, body, position)) if variable == name
                    if variable != "":
                        capture: (complete: bool, mentions: bool) = proof_replay_type_bound_local_expr_mentions_name_with_work(value, variable, work)
                        return (false, Ast::Expr.Invalid) if not capture.complete
                        return (true, Ast::Expr.Invalid) if capture.mentions
                    substituted_condition: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(condition, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_condition.complete
                    substituted_body: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(body, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_body.complete
                    return (true, Ast::Expr.Comprehension(variable, substituted_iterable.expression, substituted_condition.expression, substituted_body.expression, position))
                Ast::Expr.Refinement(base, predicate, position):
                    substituted_base: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(base, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_base.complete
                    substituted_predicate: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(predicate, name, value, depth + 1, work)
                    return (false, Ast::Expr.Invalid) if not substituted_predicate.complete
                    return (true, Ast::Expr.Refinement(substituted_base.expression, substituted_predicate.expression, position))
                Ast::Expr.Block(statements, block_value, captures, position):
                    substituted_statements: mutable darray[Ast::Stmt] = []
                    shadowed: mutable bool = false
                    for statement in statements |substituted_statements, name, value, depth, shadowed, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        match statement:
                            Ast::Stmt.VarDecl(local_name, type_expression, initializer, statement_position):
                                local_shadows_target: mutable bool = false
                                if not shadowed:
                                    return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_text_compare_charge(local_name, name, work)
                                    local_shadows_target <- local_name == name
                                    if not local_shadows_target and local_name != "":
                                        capture: (complete: bool, mentions: bool) = proof_replay_type_bound_local_expr_mentions_name_with_work(value, local_name, work)
                                        return (false, Ast::Expr.Invalid) if not capture.complete
                                        return (true, Ast::Expr.Invalid) if capture.mentions
                                substituted_initializer: Ast::Expr = initializer
                                if not shadowed:
                                    substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(initializer, name, value, depth + 1, work)
                                    return (false, Ast::Expr.Invalid) if not substituted.complete
                                    substituted_initializer <- substituted.expression
                                return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                                substituted_statements.push(Ast::Stmt.VarDecl(local_name, type_expression, substituted_initializer, statement_position))
                                shadowed <- true if local_shadows_target
                            _:
                                return (true, Ast::Expr.Invalid)
                    substituted_block_value: Ast::Expr = block_value
                    if not shadowed:
                        substituted: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_depth_with_work(block_value, name, value, depth + 1, work)
                        return (false, Ast::Expr.Invalid) if not substituted.complete
                        substituted_block_value <- substituted.expression
                    return (true, Ast::Expr.Block(substituted_statements, substituted_block_value, captures, position))
                _:
                    return (true, Ast::Expr.Invalid)

        # Size both inputs, reserve the caller's four recursive shape predicates, and let
        # the copier debit its own node, allocation-row, capture, and field-lookup work.
        def proof_replay_type_bound_result_substitution_reserve(ensure: Ast::Expr, returned: Ast::Expr, work: mutable usize&) -> bool:
            ensure_cost: mutable usize = 0
            returned_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(ensure, &ensure_cost, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT):
                return proof_replay_type_bound_local_work_exhaust(work)
            return false if not proof_replay_type_bound_local_work_charge(ensure_cost, work)
            if not proof_replay_summary_expr_cost_with_limit(returned, &returned_cost, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT):
                return proof_replay_type_bound_local_work_exhaust(work)
            return false if not proof_replay_type_bound_local_work_charge(returned_cost, work)
            return false if ensure_cost > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT / 4
            proof_replay_type_bound_local_work_charge(ensure_cost * 4, work)
