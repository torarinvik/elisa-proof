# Validate local scalar and fixed-array type-bound facts against their exact source bindings.
extend ElisaProof:
    private:
        def proof_replay_type_bound_fixed_array_element_with_work(type_expression: Ast::Expr, work: mutable usize&, depth: usize) -> Ast::Expr:
            return Ast::Expr.Invalid if depth >= PROOF_REPLAY_GLOBAL_MUTABLE_ARRAY_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Ampersand, inner, _) | Ast::Expr.Unary(TokenKind.Lmut, inner, _) | Ast::Expr.Unary(TokenKind.Mutable, inner, _):
                    return proof_replay_type_bound_fixed_array_element_with_work(inner, work, depth + 1)
                Ast::Expr.Index(element, _, _):
                    return element
                Ast::Expr.IndexN(Ast::Expr.Ident(base_name, _), arguments, _):
                    return Ast::Expr.Invalid if not proof_replay_type_bound_local_text_compare_charge(base_name, "array", work)
                    return arguments[0] if base_name == "array" and arguments.count == 2
                    return Ast::Expr.Invalid
                _:
                    return Ast::Expr.Invalid

        def proof_replay_type_bound_local_array_extent_charge_with_work(type_expression: Ast::Expr, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_GLOBAL_MUTABLE_ARRAY_DEPTH_LIMIT
            # Charge this metering walk and the legacy literal-extent walk that follows it.
            return false if not proof_replay_type_bound_local_work_charge(2, work)
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Ampersand, inner, _) | Ast::Expr.Unary(TokenKind.Lmut, inner, _) | Ast::Expr.Unary(TokenKind.Mutable, inner, _):
                    return proof_replay_type_bound_local_array_extent_charge_with_work(inner, work, depth + 1)
                Ast::Expr.Index(Ast::Expr.Ident(element_name, _), _, _):
                    return proof_replay_type_bound_local_type_name_charge(element_name, work)
                Ast::Expr.IndexN(Ast::Expr.Ident(base_name, _), _, _):
                    return false if not proof_replay_type_bound_local_text_compare_charge(base_name, "array", work)
                    return true
                _:
                    pass
            return true

        def proof_replay_type_bound_local_array_witness(report: ProofReport&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr, line: u32) -> bool:
            work: mutable usize = 0
            return proof_replay_type_bound_local_array_witness_with_work(report, parameters, body, expression, line, &work)

        def proof_replay_type_bound_local_array_witness_with_work(report: ProofReport&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr, line: u32, work: mutable usize&) -> bool:
            return false if not proof_replay_type_bound_local_body_repeat_charge(body, 1, "", work)
            candidate_matches: mutable usize = 0
            for statement in body |report, parameters, expression, line, candidate_matches, work|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, local_type, _, position):
                        continue if local_name == "" or position.line != line
                        parameter_match: mutable bool = false
                        for parameter in parameters |parameter, local_name, parameter_match, work|:
                            return false if not proof_replay_type_bound_local_text_compare_charge(parameter.name, local_name, work)
                            parameter_match <- true if parameter.name == local_name
                        continue if parameter_match
                        return false if not proof_replay_type_bound_local_array_extent_charge_with_work(local_type, work, 0)
                        extent: i64 = proof_replay_global_mutable_array_literal_extent(local_type, 0)
                        continue if extent < 0
                        root: Ast::Expr = Ast::Expr.Ident(local_name, position)
                        count: Ast::Expr = Ast::Expr.Field(root, "count", position)
                        matches: mutable bool = false
                        count_fact_match: mutable bool = false
                        equality: mutable (complete: bool, equal: bool) = proof_replay_type_bound_local_expr_equal_with_work(expression, Ast::Expr.Binary(count, TokenKind.EqEq, Ast::Expr.IntLit(extent, position), position), work)
                        return false if not equality.complete
                        count_fact_match <- equality.equal
                        equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_builtin_index_marker(root, position), work)
                        return false if not equality.complete
                        matches <- true if equality.equal
                        equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_scalar_term_marker(count, position), work)
                        return false if not equality.complete
                        count_fact_match <- count_fact_match or equality.equal
                        equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_unsigned_place_marker(count, ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS, position), work)
                        return false if not equality.complete
                        count_fact_match <- count_fact_match or equality.equal
                        if count_fact_match:
                            return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, Ast::Expr.Ident("usize", position), work)
                            matches <- true
                        return false if not proof_replay_type_bound_local_array_extent_charge_with_work(local_type, work, 0)
                        element: Ast::Expr = proof_replay_type_bound_fixed_array_element_with_work(local_type, work, 0)
                        element_shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_local_type_shape(report, element, work, 0)
                        return false if not element_shape.complete and work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        # Resolve the element in the owning function before treating an
                        # Index.All producer marker as a builtin scalar fact. In particular,
                        # a generic parameter named `i64` shadows the primitive spelling.
                        # This also admits uniquely resolved aliases to scalar elements.
                        element_scalar: bool = element_shape.complete and element_shape.scalar_kind == 1
                        if element_scalar:
                            expected_index_operators: Ast::Expr = proof_builtin_operator_marker(root, "Index.All", position)
                            equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_index_operators, work)
                            return false if not equality.complete
                            if equality.equal:
                                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                                matches <- true
                            untrusted_index_operators: Ast::Expr = proof_untrusted_operator_marker(root, "Index.All", position)
                            equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, untrusted_index_operators, work)
                            return false if not equality.complete
                            matches <- true if equality.equal
                            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
                            for protocol in protocols |expression, root, position, matches, work|:
                                expected_operator: Ast::Expr = proof_index_operator_marker(root, protocol, position, true)
                                equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_operator, work)
                                return false if not equality.complete
                                if equality.equal:
                                    return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                                    matches <- true
                            element_width: i64 = element_shape.unsigned_width
                            expected_element: Ast::Expr = proof_scalar_element_marker(root, 1, position, element_width)
                            equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_element, work)
                            return false if not equality.complete
                            if equality.equal:
                                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                                matches <- true
                        if matches:
                            return false if:
                                not proof_replay_type_bound_local_body_repeat_charge(body, 1, local_name, work)
                                not proof_replay_source_single_declaration_with_work(report.source.source_declarations, body, local_name, work)
                            candidate_matches <- candidate_matches + 1
                    _:
                        pass
            return candidate_matches == 1

        # Scalar locals retain source type witnesses at their declaration site. Resolve the
        # exact unique binding before accepting a width marker so a later shadow or forged local
        # type cannot borrow the trace.
        def proof_replay_type_bound_local_work_exhaust(work: mutable usize&) -> bool:
            work <- PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            return false

        def proof_replay_type_bound_local_work_charge(amount: usize, work: mutable usize&) -> bool:
            if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or amount > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work:
                return proof_replay_type_bound_local_work_exhaust(work)
            work <- work + amount
            return true

        def proof_replay_type_bound_local_text_compare_charge(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if:
                not proof_replay_type_bound_local_work_charge(1, work)
                not proof_replay_type_bound_local_work_charge(sview_len(left), work)
            return proof_replay_type_bound_local_work_charge(sview_len(right), work)

        def proof_replay_type_bound_local_text_repeat_charge(name: sview, repetitions: usize, work: mutable usize&) -> bool:
            name_bytes: usize = sview_len(name)
            return proof_replay_type_bound_local_work_exhaust(work) if name_bytes >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            name_cost: usize = name_bytes + 1
            if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or repetitions > (PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work) / name_cost:
                return proof_replay_type_bound_local_work_exhaust(work)
            work <- work + repetitions * name_cost
            return true

        def proof_replay_type_bound_scope_equal_with_work(left: darray[sview]&, right: darray[sview]&, work: mutable usize&) -> (complete: bool, equal: bool):
            return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
            return (true, false) if left.count != right.count
            for index in 0..<left.count |index, left, right, work|:
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(left[index], right[index], work)
                return (true, false) if left[index] != right[index]
            return (true, true)

        def proof_replay_type_bound_scope_with_module_with_work(current: darray[sview]&, module_name: sview, work: mutable usize&) -> (complete: bool, scope: darray[sview]):
            module_length: usize = sview_len(module_name)
            if module_length > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT / 3:
                work <- PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                return (false, [])
            return (false, []) if not proof_replay_type_bound_local_work_charge(module_length * 3, work)
            segments: mutable darray[sview] = []
            segment_start: mutable usize = 0
            qualified: mutable bool = false
            for cursor in 0..<module_length |cursor, module_name, segments, segment_start, qualified, work|:
                if module_name[cursor] == 58 and cursor + 1 < module_length and module_name[cursor + 1] == 58:
                    segments.push(string_view_prefix(string_view_suffix(module_name, segment_start.i64()), (cursor - segment_start).i64()))
                    segment_start <- cursor + 2
                    qualified <- true
            if segment_start < module_length:
                segments.push(string_view_suffix(module_name, segment_start.i64()))
            return (true, segments) if qualified
            return (false, []) if:
                not proof_replay_type_bound_local_work_charge(current.count, work)
                not proof_replay_type_bound_local_work_charge(segments.count, work)
            normalized: mutable darray[sview] = []
            normalized.extend(current)
            normalized.extend(segments)
            (true, normalized)

        def proof_replay_type_bound_local_expr_equal_with_work(left: Ast::Expr, right: Ast::Expr, work: mutable usize&) -> (complete: bool, equal: bool):
            return (false, false) if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            left_cost: mutable usize = 0
            right_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(left, &left_cost, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT) or left_cost > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work or not proof_replay_summary_expr_cost_with_limit(right, &right_cost, work + left_cost, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT):
                work <- PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                return (false, false)
            remaining: usize = PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
            if left_cost > remaining:
                work <- PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                return (false, false)
            if right_cost > remaining - left_cost:
                work <- PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                return (false, false)
            cost: usize = left_cost + right_cost
            if cost > remaining / 2:
                work <- PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                return (false, false)
            work <- work + cost * 2
            return (true, proof_replay_expr_equal_depth(left, right, 0))

        def proof_replay_type_bound_local_type_name_charge(name: sview, work: mutable usize&) -> bool:
            name_bytes: usize = sview_len(name)
            return proof_replay_type_bound_local_work_exhaust(work) if name_bytes >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT / 16
            # Primitive-name and width resolvers perform separate fixed comparison chains;
            # charge enough dispatches and bytes for both, including one-character names.
            name_cost: usize = name_bytes + 1
            return proof_replay_type_bound_local_work_charge(name_cost * 24, work)

        # Include the cost walk itself and every later body visit. Source uniqueness also
        # compares the requested name at visited nodes, so reserve that byte factor per pass.
        def proof_replay_type_bound_local_body_repeat_charge(body: darray[Ast::Stmt]&, repetitions: usize, compare_name: sview, work: mutable usize&) -> bool:
            cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_body(body, &cost, work, 0):
                return proof_replay_type_bound_local_work_exhaust(work)
            if work > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or cost > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work:
                return proof_replay_type_bound_local_work_exhaust(work)
            compare_name_cost: usize = sview_len(compare_name)
            if repetitions >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT or compare_name_cost >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                return proof_replay_type_bound_local_work_exhaust(work)
            passes: usize = repetitions + 1
            factor: usize = compare_name_cost + 1
            remaining: usize = PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
            if passes > remaining / factor or cost > remaining / passes / factor:
                return proof_replay_type_bound_local_work_exhaust(work)
            work <- work + cost * passes * factor
            return true

        def proof_replay_type_bound_local_generic_name_count_with_work(report: ProofReport&, name: sview, owner_line: u32, owner_offset: usize, owner_offset_valid: bool, work: mutable usize&) -> (complete: bool, count: usize):
            return (false, 0) if:
                owner_line == 0 or owner_line == 4294967295
                not report.source_types.source_generic_params_valid
                report.source_types.source_generic_param_lines.count != report.source_types.source_generic_param_names.count
            return (false, 0) if not owner_offset_valid or owner_offset > 4294967295
            lookup: (complete: bool, present: bool) = proof_source_generic_owner_param_present_in_index_with_work(name, owner_line, owner_offset.u32(), report.source_types.source_effect_index, work)
            return (false, 0) if not lookup.complete
            return (true, 1 if lookup.present else 0)

        # Reuse the scope-ranked resolver used by call-return facts for both bare and
        # qualified local type names. This keeps import visibility, shadowing, aliases,
        # generic binders, and opaque extern policy consistent across replay paths.
        def proof_replay_type_bound_local_type_shape(report: ProofReport&, expression: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64):
            owner_line: u32 = report.analysis_2.replay_owner_line
            owner_offset: usize = report.analysis_2.replay_owner_offset
            return (false, -1, -1, -1) if not report.analysis_2.replay_owner_offset_valid or owner_line == 0 or owner_line == 4294967295
            current_scope: mutable darray[sview] = []
            resolution_scope: mutable darray[sview] = []
            module_matches: mutable usize = 0
            return (false, -1, -1, -1) if not proof_replay_type_bound_function_scope_lookup_with_work(report.source.source_declarations, &current_scope, owner_line, owner_offset, &resolution_scope, &module_matches, work, 0) or module_matches != 1
            generic: (complete: bool, present: bool) = proof_replay_type_bound_call_type_has_generic_with_work(report, expression, owner_line, owner_offset, report.analysis_2.replay_owner_offset_valid, work, depth + 1)
            return (false, -1, -1, -1) if not generic.complete or generic.present
            active_alias_offsets: mutable darray[usize] = []
            proof_replay_type_bound_call_type_shape_with_work(report, expression, resolution_scope, &active_alias_offsets, work, depth + 1)

        def proof_replay_type_bound_local_unsigned_width(report: ProofReport&, expression: Ast::Expr, work: mutable usize&, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Refinement(base, _, _) | Ast::Expr.Paren(base, _):
                    return proof_replay_type_bound_local_unsigned_width(report, base, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return 0 if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                    return proof_replay_type_bound_local_unsigned_width(report, inner, work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_local_type_shape(report, expression, work, depth)
                    return -1 if not shape.complete
                    return shape.unsigned_width
                _:
                    pass
            return 0

        def proof_replay_type_bound_local_signed_width(report: ProofReport&, expression: Ast::Expr, work: mutable usize&, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Refinement(base, _, _) | Ast::Expr.Paren(base, _):
                    return proof_replay_type_bound_local_signed_width(report, base, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return 0 if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                    return proof_replay_type_bound_local_signed_width(report, inner, work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_local_type_shape(report, expression, work, depth)
                    return -1 if not shape.complete
                    return shape.signed_width
                _:
                    pass
            return 0

        def proof_replay_type_bound_local_scalar_kind(report: ProofReport&, expression: Ast::Expr, work: mutable usize&, depth: usize) -> i64:
            return -1 if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Refinement(base, _, _) | Ast::Expr.Paren(base, _):
                    return proof_replay_type_bound_local_scalar_kind(report, base, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return 0 if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                    return proof_replay_type_bound_local_scalar_kind(report, inner, work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_local_type_shape(report, expression, work, depth)
                    return -1 if not shape.complete
                    return shape.scalar_kind
                _:
                    pass
            return 0

        def proof_replay_type_bound_parameter_fact(report: ProofReport&, parameter: Ast::ParamDecl, expression: Ast::Expr, position: Ast::Pos, work: mutable usize&) -> bool:
            return false if parameter.name == ""
            term: Ast::Expr = Ast::Expr.Ident(parameter.name, position)
            parameter_shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_local_type_shape(report, parameter.type_expression, work, 0)
            return false if not parameter_shape.complete
            unsigned_width: i64 = parameter_shape.unsigned_width
            equal: mutable (complete: bool, equal: bool) = (true, false)
            if unsigned_width > 0:
                equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_unsigned_type_marker(parameter.name, unsigned_width, position), work)
                return false if not equal.complete
                if equal.equal:
                    return proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, parameter.type_expression, work)
                lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, term, position)
                equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, lower, work)
                return false if not equal.complete
                return proof_replay_type_bound_order_comparisons_trusted_with_work(report, parameter.type_expression, work) if equal.equal
                if unsigned_width < PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH:
                    upper: Ast::Expr = Ast::Expr.Binary(term, TokenKind.LtEq, Ast::Expr.IntLit(proof_unsigned_width_max(unsigned_width), position), position)
                    equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, upper, work)
                    return false if not equal.complete
                    return proof_replay_type_bound_order_comparisons_trusted_with_work(report, parameter.type_expression, work) if equal.equal
            signed_width: i64 = parameter_shape.signed_width
            if signed_width > 0:
                equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_signed_type_marker(term, signed_width, position), work)
                return false if not equal.complete
                if equal.equal:
                    return proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, parameter.type_expression, work)
                if signed_width < PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH:
                    maximum: i64 = ElisaProofKernelCore::proof_kernel_signed_width_max(signed_width)
                    upper: Ast::Expr = Ast::Expr.Binary(term, TokenKind.LtEq, Ast::Expr.IntLit(maximum, position), position)
                    equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, upper, work)
                    return false if not equal.complete
                    return proof_replay_type_bound_order_comparisons_trusted_with_work(report, parameter.type_expression, work) if equal.equal
                    magnitude: Ast::Expr = Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(maximum, position), position)
                    floor: Ast::Expr = Ast::Expr.Binary(magnitude, TokenKind.Minus, Ast::Expr.IntLit(1, position), position)
                    lower: Ast::Expr = Ast::Expr.Binary(floor, TokenKind.LtEq, term, position)
                    equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, lower, work)
                    return false if not equal.complete
                    return proof_replay_type_bound_order_comparisons_trusted_with_work(report, parameter.type_expression, work) if equal.equal
            scalar_kind: i64 = parameter_shape.scalar_kind
            if unsigned_width <= 0 and scalar_kind == 1:
                equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_scalar_type_marker(parameter.name, position), work)
                return false if not equal.complete
                if equal.equal:
                    return proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, parameter.type_expression, work)
            # Parameter array markers are produced from the declared element type. Authenticate
            # them against this exact parameter rather than accepting the producer's claim. Keep
            # aliases and non-fixed containers closed until their resolved type identity is carried
            # through this source-binding check.
            return proof_replay_type_bound_parameter_array_fact(report, parameter, expression, position, work)

        # A positive scalar-element marker cannot stand in for primitive operator
        # semantics when an implementation is registered for the element type or one of
        # its aliases. Recompute the deny condition during replay instead of depending on
        # the producer also supplying an untrusted-operator marker.
        def proof_replay_type_bound_scalar_element_operators_trusted_with_work(report: ProofReport&, element: Ast::Expr, work: mutable usize&) -> bool:
            protocols: darray[sview] = ["Eq", "Ord", "Less", "Add", "Sub", "Mul", "Div", "Neg", "BitAnd", "BitOr", "BitXor"]
            operators: (complete: bool, absent: bool) = proof_replay_variant_type_operator_protocols_absent_with_work(element, protocols, report, work)
            operators.complete and operators.absent

        # Range comparisons are executable operators too. Do not admit their builtin numeric
        # interpretation when the source type overrides either spelling used by order dispatch.
        def proof_replay_type_bound_order_comparisons_trusted_with_work(report: ProofReport&, element: Ast::Expr, work: mutable usize&) -> bool:
            protocols: darray[sview] = ["Ord", "Less"]
            operators: (complete: bool, absent: bool) = proof_replay_variant_type_operator_protocols_absent_with_work(element, protocols, report, work)
            operators.complete and operators.absent

        def proof_replay_type_bound_parameter_array_fact(report: ProofReport&, parameter: Ast::ParamDecl, expression: Ast::Expr, position: Ast::Pos, work: mutable usize&) -> bool:
            return false if not proof_replay_type_bound_local_array_extent_charge_with_work(parameter.type_expression, work, 0)
            extent: i64 = proof_replay_global_mutable_array_literal_extent(parameter.type_expression, 0)
            return false if extent < 0
            element: Ast::Expr = proof_replay_type_bound_fixed_array_element_with_work(parameter.type_expression, work, 0)
            element_shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_local_type_shape(report, element, work, 0)
            return false if not element_shape.complete or element_shape.scalar_kind != 1
            root: Ast::Expr = Ast::Expr.Ident(parameter.name, position)
            equal: mutable (complete: bool, equal: bool) = proof_replay_type_bound_local_expr_equal_with_work(expression, proof_builtin_operator_marker(root, "Index.All", position), work)
            return false if not equal.complete
            if equal.equal:
                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                return true
            equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_untrusted_operator_marker(root, "Index.All", position), work)
            return false if not equal.complete
            return true if equal.equal
            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
            for protocol in protocols |report, parameter, expression, position, root, protocols, work|:
                equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_index_operator_marker(root, protocol, position, true), work)
                return false if not equal.complete
                if equal.equal:
                    return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                    return true
            element_width: i64 = element_shape.unsigned_width
            return false if element_width < 0
            expected_element: Ast::Expr = proof_scalar_element_marker(root, 1, position, element_width)
            equal <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_element, work)
            return false if not equal.complete
            if equal.equal:
                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                return true
            false

        def proof_replay_type_bound_local_scalar_fact(report: ProofReport&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr, line: u32) -> bool:
            work: mutable usize = 0
            return proof_replay_type_bound_local_scalar_fact_with_work(report, parameters, body, expression, line, &work)

        def proof_replay_type_bound_local_scalar_fact_with_work(report: ProofReport&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr, line: u32, work: mutable usize&) -> bool:
            return false if not proof_replay_type_bound_local_body_repeat_charge(body, 1, "", work)
            candidate_matches: mutable usize = 0
            for statement in body |report, parameters, expression, line, candidate_matches, work|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, local_type, _, position):
                        continue if local_name == "" or position.line != line
                        parameter_match: mutable bool = false
                        for parameter in parameters |parameter, local_name, parameter_match, work|:
                            return false if not proof_replay_type_bound_local_text_compare_charge(parameter.name, local_name, work)
                            parameter_match <- true if parameter.name == local_name
                        continue if parameter_match
                        term: Ast::Expr = Ast::Expr.Ident(local_name, position)
                        local_matches: mutable usize = 0
                        local_shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_local_type_shape(report, local_type, work, 0)
                        continue if not local_shape.complete
                        unsigned_width: i64 = local_shape.unsigned_width
                        if unsigned_width > 0:
                            expected_unsigned: Ast::Expr = proof_unsigned_type_marker(local_name, unsigned_width, position)
                            if proof_replay_summary_expr_equal_with_work(expression, expected_unsigned, work):
                                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, local_type, work)
                                local_matches <- local_matches + 1
                            lower: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.LtEq, term, position)
                            if proof_replay_summary_expr_equal_with_work(expression, lower, work):
                                return false if not proof_replay_type_bound_order_comparisons_trusted_with_work(report, local_type, work)
                                local_matches <- local_matches + 1
                            if unsigned_width < PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH:
                                upper: Ast::Expr = Ast::Expr.Binary(term, TokenKind.LtEq, Ast::Expr.IntLit(proof_unsigned_width_max(unsigned_width), position), position)
                                if proof_replay_summary_expr_equal_with_work(expression, upper, work):
                                    return false if not proof_replay_type_bound_order_comparisons_trusted_with_work(report, local_type, work)
                                    local_matches <- local_matches + 1
                        signed_width: i64 = local_shape.signed_width
                        if signed_width > 0:
                            expected_signed: Ast::Expr = proof_signed_type_marker(term, signed_width, position)
                            if proof_replay_summary_expr_equal_with_work(expression, expected_signed, work):
                                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, local_type, work)
                                local_matches <- local_matches + 1
                            if signed_width < PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH:
                                maximum: i64 = ElisaProofKernelCore::proof_kernel_signed_width_max(signed_width)
                                upper: Ast::Expr = Ast::Expr.Binary(term, TokenKind.LtEq, Ast::Expr.IntLit(maximum, position), position)
                                if proof_replay_summary_expr_equal_with_work(expression, upper, work):
                                    return false if not proof_replay_type_bound_order_comparisons_trusted_with_work(report, local_type, work)
                                    local_matches <- local_matches + 1
                                magnitude: Ast::Expr = Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(maximum, position), position)
                                floor: Ast::Expr = Ast::Expr.Binary(magnitude, TokenKind.Minus, Ast::Expr.IntLit(1, position), position)
                                lower: Ast::Expr = Ast::Expr.Binary(floor, TokenKind.LtEq, term, position)
                                if proof_replay_summary_expr_equal_with_work(expression, lower, work):
                                    return false if not proof_replay_type_bound_order_comparisons_trusted_with_work(report, local_type, work)
                                    local_matches <- local_matches + 1
                        scalar_kind: i64 = local_shape.scalar_kind
                        if unsigned_width <= 0 and scalar_kind == 1 and proof_replay_summary_expr_equal_with_work(expression, proof_scalar_type_marker(local_name, position), work):
                            return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, local_type, work)
                            local_matches <- local_matches + 1
                        if local_matches != 0:
                            return false if:
                                not proof_replay_type_bound_local_body_repeat_charge(body, 1, local_name, work)
                                not proof_replay_source_single_declaration_with_work(report.source.source_declarations, body, local_name, work)
                            candidate_matches <- candidate_matches + local_matches
                    _:
                        pass
            return candidate_matches == 1

        def proof_replay_type_bound_local_array_fact(report: ProofReport&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr, line: u32) -> bool:
            work: mutable usize = 0
            return proof_replay_type_bound_local_array_fact_with_work(report, parameters, body, expression, line, &work)

        def proof_replay_type_bound_local_array_fact_with_work(report: ProofReport&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr, line: u32, work: mutable usize&) -> bool:
            return false if not proof_replay_type_bound_local_body_repeat_charge(body, 1, "", work)
            valid_matches: mutable usize = 0
            for statement in body |report, parameters, expression, line, valid_matches, work|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, local_type, _, position):
                        continue if local_name == "" or position.line != line
                        parameter_match: mutable bool = false
                        for parameter in parameters |parameter, local_name, parameter_match, work|:
                            return false if not proof_replay_type_bound_local_text_compare_charge(parameter.name, local_name, work)
                            parameter_match <- true if parameter.name == local_name
                        continue if parameter_match
                        return false if not proof_replay_type_bound_local_array_extent_charge_with_work(local_type, work, 0)
                        extent: i64 = proof_replay_global_mutable_array_literal_extent(local_type, 0)
                        continue if extent < 0
                        root: Ast::Expr = Ast::Expr.Ident(local_name, position)
                        count: Ast::Expr = Ast::Expr.Field(root, "count", position)
                        expected_extent: Ast::Expr = Ast::Expr.Binary(count, TokenKind.EqEq, Ast::Expr.IntLit(extent, position), position)
                        local_matches: mutable usize = 0
                        count_matches: mutable usize = 0
                        equality: mutable (complete: bool, equal: bool) = proof_replay_type_bound_local_expr_equal_with_work(expression, expected_extent, work)
                        return false if not equality.complete
                        count_matches <- count_matches + 1 if equality.equal
                        expected_index: Ast::Expr = proof_builtin_index_marker(root, position)
                        equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_index, work)
                        return false if not equality.complete
                        local_matches <- local_matches + 1 if equality.equal
                        expected_count_scalar: Ast::Expr = proof_scalar_term_marker(count, position)
                        equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_count_scalar, work)
                        return false if not equality.complete
                        count_matches <- count_matches + 1 if equality.equal
                        expected_count_unsigned: Ast::Expr = proof_unsigned_place_marker(count, ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS, position)
                        equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_count_unsigned, work)
                        return false if not equality.complete
                        count_matches <- count_matches + 1 if equality.equal
                        if count_matches != 0:
                            return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, Ast::Expr.Ident("usize", position), work)
                            local_matches <- local_matches + count_matches
                        return false if not proof_replay_type_bound_local_array_extent_charge_with_work(local_type, work, 0)
                        element: Ast::Expr = proof_replay_type_bound_fixed_array_element_with_work(local_type, work, 0)
                        element_shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_local_type_shape(report, element, work, 0)
                        return false if not element_shape.complete and work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        element_scalar: bool = element_shape.complete and element_shape.scalar_kind == 1
                        if element_scalar:
                            expected_index_operators: Ast::Expr = proof_builtin_operator_marker(root, "Index.All", position)
                            equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_index_operators, work)
                            return false if not equality.complete
                            if equality.equal:
                                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                                local_matches <- local_matches + 1
                            untrusted_index_operators: Ast::Expr = proof_untrusted_operator_marker(root, "Index.All", position)
                            equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, untrusted_index_operators, work)
                            return false if not equality.complete
                            local_matches <- local_matches + 1 if equality.equal
                            protocols: darray[sview] = ["Eq", "Ord", "Add", "Sub", "Mul", "Div", "Neg"]
                            for protocol in protocols |expression, root, position, local_matches, work|:
                                equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, proof_index_operator_marker(root, protocol, position, true), work)
                                return false if not equality.complete
                                if equality.equal:
                                    return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                                    local_matches <- local_matches + 1
                            element_width: i64 = element_shape.unsigned_width
                            expected_element: Ast::Expr = proof_scalar_element_marker(root, 1, position, element_width)
                            equality <- proof_replay_type_bound_local_expr_equal_with_work(expression, expected_element, work)
                            return false if not equality.complete
                            if equality.equal:
                                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, element, work)
                                local_matches <- local_matches + 1
                        if local_matches != 0:
                            return false if:
                                not proof_replay_type_bound_local_body_repeat_charge(body, 1, local_name, work)
                                not proof_replay_source_single_declaration_with_work(report.source.source_declarations, body, local_name, work)
                            valid_matches <- valid_matches + local_matches
                    _:
                        pass
            return valid_matches == 1

