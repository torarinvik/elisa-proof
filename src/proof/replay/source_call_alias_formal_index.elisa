# Exact per-alias generic formal lookup shared by call conversion and source-shape replay.
extend ElisaProof:
    private:
        def proof_replay_call_conversion_alias_formal_head(name: sview, owner_row: usize, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, found: bool):
            aliases: ProofReplayCallSiteTargetAliases& = &call_target.aliases
            alias_count: usize = aliases.field_conversion_alias_names.count
            return (false, false) if:
                owner_row >= alias_count
                aliases.field_conversion_alias_generic_formal_starts.count != alias_count
                aliases.field_conversion_alias_generic_formal_counts.count != alias_count
                aliases.field_conversion_alias_generic_application_valid.count != alias_count
                not aliases.field_conversion_alias_generic_application_valid[owner_row]
            start: usize = aliases.field_conversion_alias_generic_formal_starts[owner_row]
            count: usize = aliases.field_conversion_alias_generic_formal_counts[owner_row]
            return (false, false) if start > aliases.field_conversion_alias_generic_formal_names.count or count > aliases.field_conversion_alias_generic_formal_names.count - start
            lookup: (complete: bool, found: bool, count: usize, flat_index: usize) = proof_replay_call_conversion_alias_formal_name_lookup(name, owner_row, call_target, work)
            return (false, false) if not lookup.complete or lookup.count > 1
            (true, lookup.found)

        def proof_replay_call_conversion_alias_formal_name_lookup(name: sview, owner_row: usize, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, found: bool, count: usize, flat_index: usize):
            aliases: ProofReplayCallSiteTargetAliases& = &call_target.aliases
            alias_count: usize = aliases.field_conversion_alias_names.count
            formal_count: usize = aliases.field_conversion_alias_generic_formal_names.count
            return (false, false, 0, formal_count) if:
                owner_row >= alias_count
                aliases.field_conversion_alias_generic_formal_starts.count != alias_count
                aliases.field_conversion_alias_generic_formal_counts.count != alias_count
                aliases.field_conversion_alias_generic_application_valid.count != alias_count
                not aliases.field_conversion_alias_generic_application_valid[owner_row]
                not aliases.field_conversion_alias_generic_formal_name_index_valid
                aliases.field_conversion_alias_generic_formal_owner_rows.count != formal_count
            start: usize = aliases.field_conversion_alias_generic_formal_starts[owner_row]
            alias_formal_count: usize = aliases.field_conversion_alias_generic_formal_counts[owner_row]
            return (false, false, 0, formal_count) if start > formal_count or alias_formal_count > formal_count - start
            return (true, false, 0, formal_count) if alias_formal_count == 0
            capacity: usize = proof_name_index_capacity(formal_count)
            return (false, false, 0, formal_count) if:
                capacity == 0
                aliases.field_conversion_alias_generic_formal_name_index_hashes.count != capacity
                aliases.field_conversion_alias_generic_formal_name_index_values.count != capacity
                aliases.field_conversion_alias_generic_formal_name_index_counts.count != capacity
            return (false, false, 0, formal_count) if not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
            hash: u32 = proof_expr_shape_mix(proof_name_hash(name), owner_row.i64())
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, owner_row, aliases, formal_count, capacity, call_target, work|:
                return (false, false, 0, formal_count) if not proof_replay_call_conversion_alias_work_add(work, 1)
                current: usize = aliases.field_conversion_alias_generic_formal_name_index_values[slot]
                return (true, false, 0, formal_count) if current == formal_count
                return (false, false, 0, formal_count) if current > formal_count or current >= aliases.field_conversion_alias_generic_formal_owner_rows.count
                if aliases.field_conversion_alias_generic_formal_name_index_hashes[slot] == hash:
                    current_name: sview = aliases.field_conversion_alias_generic_formal_names[current]
                    return (false, false, 0, formal_count) if not proof_replay_call_conversion_alias_work_add(work, sview_len(current_name))
                    if aliases.field_conversion_alias_generic_formal_owner_rows[current] == owner_row and current_name == name:
                        return (false, false, 0, formal_count) if aliases.field_conversion_alias_generic_formal_name_index_counts[slot] == 0
                        return (true, true, aliases.field_conversion_alias_generic_formal_name_index_counts[slot], current)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, 0, formal_count)
