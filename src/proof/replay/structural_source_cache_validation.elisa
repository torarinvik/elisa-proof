extend ElisaProof:
    private:
        # The report's generic rows are a parser snapshot, not replay authority. Bind every
        # function-generic row back to its marker; cardinality detects omitted function rows.
        def proof_replay_structural_generic_rows_authenticate(report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            lines_count: usize = report.source_types.source_generic_param_lines.count
            return false if:
                not report.source_types.source_generic_params_valid or not report.source_types.source_generic_owner_params_valid
                lines_count != report.source_types.source_generic_param_names.count or lines_count != report.source_types.source_generic_param_owner_offsets.count
            if report.source_types.source_effect_index.work.implicit_effect_work > source_work:
                prior_index_work: usize = report.source_types.source_effect_index.work.implicit_effect_work - source_work
                return false if not proof_replay_structural_work_charge(source_work, prior_index_work)
            elif report.source_types.source_effect_index.work.implicit_effect_work < source_work:
                report.source_types.source_effect_index.work.implicit_effect_work <- source_work
            index_work_before_ensure: usize = report.source_types.source_effect_index.work.implicit_effect_work
            return false if not proof_source_conversion_generic_owner_index_ensure(report)
            return false if report.source_types.source_effect_index.work.implicit_effect_work < index_work_before_ensure
            index_work_used: usize = report.source_types.source_effect_index.work.implicit_effect_work - index_work_before_ensure
            return false if not proof_replay_structural_work_charge(source_work, index_work_used)
            function_markers: mutable usize = 0
            for annotation in report.source.source_annotations |annotation, report, source_work, function_markers|:
                return false if:
                    not proof_replay_structural_work_charge(source_work, 1)
                    not proof_replay_structural_work_charge(source_work, sview_len(annotation.name))
                    not proof_replay_structural_work_charge(source_work, sview_len(annotation.owner))
                continue if annotation.name != "__generic_param_identity" or annotation.line != 3900000131
                if report.source_types.source_effect_index.work.implicit_effect_work > source_work:
                    prior_index_work: usize = report.source_types.source_effect_index.work.implicit_effect_work - source_work
                    return false if not proof_replay_structural_work_charge(source_work, prior_index_work)
                elif report.source_types.source_effect_index.work.implicit_effect_work < source_work:
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                marker_work_before: usize = report.source_types.source_effect_index.work.implicit_effect_work
                function_owner: (complete: bool, found: bool) = proof_source_conversion_generic_function_owner_lookup(annotation.detail_line, annotation.offset.usize(), report)
                return false if not function_owner.complete or report.source_types.source_effect_index.work.implicit_effect_work < marker_work_before
                marker_work_used: usize = report.source_types.source_effect_index.work.implicit_effect_work - marker_work_before
                return false if not proof_replay_structural_work_charge(source_work, marker_work_used)
                function_markers <- function_markers + 1 if function_owner.found
            function_rows: mutable usize = 0
            for row in 0..<lines_count |row, report, source_work|:
                name: sview = report.source_types.source_generic_param_names[row]
                return false if not proof_replay_structural_work_charge(source_work, 2) or not proof_replay_structural_work_charge(source_work, sview_len(name))
                encoded_line: u32 = report.source_types.source_generic_param_lines[row]
                owner_line: u32 = proof_source_generic_owner_param_line(encoded_line)
                owner_offset: u32 = report.source_types.source_generic_param_owner_offsets[row]
                return false if owner_line == 0
                # High-bit rows encode protocol bounds, not generic binders. The owner
                # parameter index deliberately contains only ordinary binder rows, so do
                # not authenticate bound metadata through that index or count it here.
                continue if encoded_line >= PROOF_SOURCE_GENERIC_OWNER_PARAM_BOUND_LINE_FLAG
                row_lookup: (complete: bool, present: bool) = proof_source_generic_owner_param_present_in_index_with_work(name, owner_line, owner_offset, report.source_types.source_effect_index, source_work)
                return false if not row_lookup.complete or not row_lookup.present
                if report.source_types.source_effect_index.work.implicit_effect_work > source_work:
                    prior_index_work: usize = report.source_types.source_effect_index.work.implicit_effect_work - source_work
                    return false if not proof_replay_structural_work_charge(source_work, prior_index_work)
                elif report.source_types.source_effect_index.work.implicit_effect_work < source_work:
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                function_work_before: usize = report.source_types.source_effect_index.work.implicit_effect_work
                function_owner: (complete: bool, found: bool) = proof_source_conversion_generic_function_owner_lookup(owner_line, owner_offset.usize(), report)
                return false if not function_owner.complete or report.source_types.source_effect_index.work.implicit_effect_work < function_work_before
                function_work_used: usize = report.source_types.source_effect_index.work.implicit_effect_work - function_work_before
                return false if not proof_replay_structural_work_charge(source_work, function_work_used)
                continue if not function_owner.found
                function_rows <- function_rows + 1
                if report.source_types.source_effect_index.work.implicit_effect_work < source_work:
                    report.source_types.source_effect_index.work.implicit_effect_work <- source_work
                index_work_before: usize = report.source_types.source_effect_index.work.implicit_effect_work
                lookup: (complete: bool, count: usize) = proof_source_conversion_generic_owner_lookup(name, owner_line, owner_offset.usize(), report)
                return false if not lookup.complete or lookup.count != 1
                return false if report.source_types.source_effect_index.work.implicit_effect_work < index_work_before
                index_work_used: usize = report.source_types.source_effect_index.work.implicit_effect_work - index_work_before
                return false if not proof_replay_structural_work_charge(source_work, index_work_used)
            return false if function_rows != function_markers
            return true

        def proof_replay_structural_validation_cache_build(report: ProofReport&, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if cache.initialized
            cache.initialized <- true
            certificate_index_result: (complete: bool, index: ProofReplayStructuralCertificateIndex) = proof_replay_structural_certificate_index_build(report, source_work)
            return false if not certificate_index_result.complete
            cache.certificate_index <- certificate_index_result.index
            source_index_result: (complete: bool, index: ProofReplayStructuralSourceIndex) = proof_replay_structural_source_index_build(report.source.source_declarations, report.source.source_annotations, source_work)
            return false if not source_index_result.complete
            cache.source_index <- source_index_result.index
            cache.enum_index <- proof_build_enum_index(report.source.source_declarations, source_work)
            return false if:
                not cache.enum_index.complete
                cache.enum_index.names.count != cache.enum_index.name_hashes.count or cache.enum_index.names.count != cache.enum_index.const_enums.count or cache.enum_index.names.count != cache.enum_index.declarations.count or cache.enum_index.names.count != cache.enum_index.root_level.count or cache.enum_index.names.count != cache.enum_index.owners.count or cache.enum_index.names.count != cache.enum_index.next_indices.count
                not proof_replay_structural_work_charge(source_work, report.source.source_declarations.count)
            cache.scratch.source.source_declarations.extend(report.source.source_declarations)
            return false if not proof_replay_structural_work_charge(source_work, report.source.source_annotations.count)
            cache.scratch.source.source_annotations.extend(report.source.source_annotations)
            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or report.source.source_annotation_args.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            source_work <- source_work + report.source.source_annotation_args.count
            for argument in report.source.source_annotation_args |cache, source_work|:
                return false if not proof_replay_structural_work_charge(source_work, 2) or not proof_replay_structural_work_charge(source_work, sview_len(argument))
                cache.scratch.source.source_annotation_args.push(argument)
            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or report.source_contracts.source_region_param_lines.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            source_work <- source_work + report.source_contracts.source_region_param_lines.count
            cache.scratch.source_contracts.source_region_param_lines.extend(report.source_contracts.source_region_param_lines)
            return false if:
                not proof_replay_source_generic_param_rows_copy(report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_generic_param_owner_offsets, report.source_types.source_generic_params_valid, report.source_types.source_generic_owner_params_valid, &cache.scratch, source_work)
                not proof_source_conversion_generic_indexes_build(&cache.scratch, source_work)
                not proof_replay_structural_generic_rows_authenticate(&cache.scratch, source_work)
                not proof_replay_structural_work_charge(source_work, report.source_contracts.source_signature_contract_lines.count)
            cache.scratch.source_contracts.source_signature_contract_lines.extend(report.source_contracts.source_signature_contract_lines)
            return false if not proof_replay_structural_work_charge(source_work, report.source_contracts.source_signature_contract_kinds.count)
            cache.scratch.source_contracts.source_signature_contract_kinds.extend(report.source_contracts.source_signature_contract_kinds)
            return false if not proof_replay_structural_work_charge(source_work, report.source_contracts.source_signature_contracts.count)
            cache.scratch.source_contracts.source_signature_contracts.extend(report.source_contracts.source_signature_contracts)
            return false if not proof_replay_structural_work_charge(source_work, report.source_contracts.source_extern_parameters.count)
            cache.scratch.source_contracts.source_extern_parameters.extend(report.source_contracts.source_extern_parameters)
            operator_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_operator_impl_index(&cache.scratch, source_work)
            return false if not operator_index_status.complete
            operator_mask_status: (complete: bool, primitive_mask: usize, protocol_mask: usize) = proof_source_operator_masks_from_index(cache.scratch, source_work)
            return false if not operator_mask_status.complete
            cache.scratch.source.source_primitive_operator_mask <- operator_mask_status.primitive_mask
            cache.scratch.source.source_operator_protocol_mask <- operator_mask_status.protocol_mask
            cache.scratch.source.source_operator_masks_valid <- true
            alias_visibility: (complete: bool, safe: bool) = proof_source_conversion_root_alias_visibility_scan(cache.scratch.source.source_declarations, cache.scratch.source.source_annotations, source_work, 0)
            return false if not alias_visibility.complete
            cache.scratch.source_types.source_effect_index.aliases.bare_alias_root_fallback_valid <- alias_visibility.safe
            drop_type_index: (complete: bool, declared_types: darray[sview], drop_hook_types: darray[sview], alias_names: darray[sview], alias_targets: darray[Ast::Expr], callable_names: darray[sview], callable_return_types: darray[Ast::Expr], callable_lines: darray[u32], callable_owners: darray[sview], field_conversion_names: darray[sview], field_conversion_custom_cast_present: bool, declaration_count: usize) = proof_source_drop_type_index_with_work(cache.scratch.source.source_declarations, cache.scratch.source.source_annotations, cache.scratch.source_types.source_generic_param_lines, cache.scratch.source_types.source_generic_param_names, cache.scratch.source_types.source_generic_params_valid and cache.scratch.source_types.source_generic_param_lines.count == cache.scratch.source_types.source_generic_param_names.count, cache.scratch.source_types.source_effect_index, cache.scratch.source_types.source_effect_index.aliases.bare_alias_root_fallback_valid, &cache.scratch.source_types.source_effect_index.aliases.alias_index_hashes, &cache.scratch.source_types.source_effect_index.aliases.alias_index_values, &cache.scratch.source_types.source_effect_index.aliases.alias_index_counts, source_work)
            return false if not drop_type_index.complete
            cache.scratch.source_types.source_effect_index.types.declared_types <- drop_type_index.declared_types
            cache.scratch.source_types.source_effect_index.destructors.drop_hook_types <- drop_type_index.drop_hook_types
            cache.scratch.source_types.source_effect_index.aliases.alias_names <- drop_type_index.alias_names
            cache.scratch.source_types.source_effect_index.aliases.alias_targets <- drop_type_index.alias_targets
            cache.scratch.source_types.source_effect_index.aliases.alias_index_valid <- true
            cache.scratch.source_types.source_effect_index.callables.callable_names <- drop_type_index.callable_names
            cache.scratch.source_types.source_effect_index.callables.callable_return_types <- drop_type_index.callable_return_types
            cache.scratch.source_types.source_effect_index.callables.callable_lines <- drop_type_index.callable_lines
            cache.scratch.source_types.source_effect_index.callables.callable_owners <- drop_type_index.callable_owners
            cache.scratch.source_types.source_effect_index.conversions.field_conversion_names <- drop_type_index.field_conversion_names
            cache.scratch.source_types.source_effect_index.conversions.field_conversion_custom_cast_present <- drop_type_index.field_conversion_custom_cast_present
            cache.scratch.source_types.source_effect_index.work.declaration_count <- drop_type_index.declaration_count
            return false if:
                not proof_source_effect_callable_index_build(&cache.scratch, source_work)
                not proof_source_field_conversion_index_build(&cache.scratch, source_work)
                not proof_source_conversion_indexes_build(&cache.scratch, source_work)
                not proof_replay_source_generic_param_line_index_build(&cache.scratch, source_work)
                not proof_source_callable_extern_contract_index_build(cache.scratch.source.source_declarations, cache.scratch.source_contracts.source_extern_parameters, cache.scratch.source_contracts.source_signature_contract_lines, cache.scratch.source_contracts.source_signature_contract_kinds, cache.scratch.source_contracts.source_signature_contracts, &cache.scratch, source_work)
                not proof_replay_structural_source_graph_build(cache.source_index, cache.scratch.source_contracts.source_signature_contract_lines, cache.scratch.source_contracts.source_signature_contract_kinds, cache.scratch.source_contracts.source_signature_contracts, cache.enum_index, &cache.scratch, source_work, &cache.graph)
                not proof_structural_name_index_build(&cache.scratch, &source_work)
                not proof_replay_structural_graph_cache_indexes_build(&cache.graph, source_work)
                cache.scratch.analysis_1.structural.component_ids.count != cache.graph.nodes.component_ids.count
            for node_index in 0..<cache.graph.nodes.component_ids.count |node_index, cache, source_work|:
                return false if not proof_replay_structural_work_charge(source_work, 1)
                cache.scratch.analysis_1.structural.component_ids[node_index] <- cache.graph.nodes.component_ids[node_index]
            cache.complete <- true
            return true

        def proof_replay_structural_certificate_source_valid_with_work(report: ProofReport&, certificate: ProofGoalCertificate, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if certificate.kernel_goal >= report.analysis_1.kernel.nodes.count
            root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[certificate.kernel_goal]
            return false if:
                root.kind != "structural-safety" or root.secondary_name != "structural-v2" or root.children_count != 1 or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start
                not proof_replay_structural_text_compare(root.name, certificate.name, source_work) or root.name != certificate.name
            edge_id: usize = report.analysis_1.kernel.children[root.children_start]
            return false if edge_id >= report.analysis_1.kernel.nodes.count
            edge: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[edge_id]
            return false if:
                edge.kind != "structural-edge"
                not proof_replay_structural_text_compare(edge.name, certificate.name, source_work) or edge.name != certificate.name
            if not cache.initialized:
                return false if not proof_replay_structural_validation_cache_build(report, source_work, &cache)
            return false if not cache.complete
            certificate_owner: (complete: bool, owner_index: usize) = proof_replay_structural_certificate_owner_lookup(cache.certificate_index, certificate.name, source_work)
            return false if not certificate_owner.complete or certificate_owner.owner_index >= cache.certificate_index.owners.count
            return true if cache.certificate_index.owners[certificate_owner.owner_index].source_validated
            source_owner: (complete: bool, matches: usize, entry_index: usize, declaration: Ast::Decl, lemma: bool) = proof_replay_structural_source_lookup(cache.source_index, certificate.name, source_work)
            source_callee: (complete: bool, matches: usize, entry_index: usize, declaration: Ast::Decl, lemma: bool) = proof_replay_structural_source_lookup(cache.source_index, edge.secondary_name, source_work)
            return false if:
                not source_owner.complete or source_owner.matches != 1 or source_owner.lemma
                not source_callee.complete or source_callee.matches != 1 or source_callee.lemma
            match source_owner.declaration:
                Ast::Decl.Func(_, parameters, _, body, _, _, position):
                    callee_is_function: mutable bool = false
                    match source_callee.declaration:
                        Ast::Decl.Func(_, _, _, _, _, _, _):
                            callee_is_function <- true
                        _:
                            pass
                    return false if:
                        not callee_is_function
                        source_owner.entry_index >= cache.graph.nodes.node_by_source_entry.count or source_callee.entry_index >= cache.graph.nodes.node_by_source_entry.count
                    caller_node: usize = cache.graph.nodes.node_by_source_entry[source_owner.entry_index]
                    callee_node: usize = cache.graph.nodes.node_by_source_entry[source_callee.entry_index]
                    return false if:
                        caller_node >= cache.graph.nodes.declarations.count or callee_node >= cache.graph.nodes.declarations.count or cache.graph.nodes.owner_modules.count != cache.graph.nodes.declarations.count
                        not proof_replay_structural_call_site_matches(cache.graph, caller_node, root.left, edge.secondary_name, certificate.line, source_work)
                        caller_node >= cache.scratch.analysis_1.structural.members.count or not cache.scratch.analysis_1.structural.members[caller_node]
                        not proof_replay_structural_graph_has_edge(cache.graph, caller_node, callee_node, source_work)
                        cache.graph.nodes.component_ids.count != cache.graph.nodes.declarations.count or cache.graph.nodes.reachable_extern_contract_unsafe.count != cache.graph.nodes.declarations.count or cache.graph.nodes.reachable_unresolved_calls.count != cache.graph.nodes.declarations.count
                        cache.graph.nodes.component_ids[caller_node] != cache.graph.nodes.component_ids[callee_node]
                    extern_unsafe: bool = cache.graph.nodes.reachable_extern_contract_unsafe[caller_node]
                    return false if not proof_replay_structural_charge_check_preflight(parameters, body, source_work)
                    cache.scratch.results.findings.clear()
                    cache.scratch.results.counterexample_facts.clear()
                    cache.scratch.results.goal_attempts.clear()
                    cache.scratch.results.obligation_inventory.clear()
                    cache.scratch.analysis_1.certificates.clear()
                    cache.scratch.analysis_1.certificate_facts.clear()
                    cache.scratch.analysis_1.kernel <- ProofKernelArena{}
                    cache.scratch.results.failed <- 0
                    cache.scratch.results.obligations <- 0
                    cache.scratch.results.producer_proven_count <- 0
                    cache.scratch.analysis_1.structural.verified_names.clear()
                    return false if cache.scratch.analysis_1.structural.verified_members.count != cache.scratch.analysis_1.structural.names.count
                    for verified_row in 0..<cache.scratch.analysis_1.structural.verified_members.count |verified_row, cache, source_work|:
                        return false if not proof_replay_structural_work_charge(source_work, 1)
                        cache.scratch.analysis_1.structural.verified_members[verified_row] <- false
                    cache.scratch.analysis_1.structural.identity_next <- 0
                    unresolved_reachable: bool = caller_node >= cache.graph.nodes.reachable_unresolved_calls.count or cache.graph.nodes.reachable_unresolved_calls[caller_node]
                    proof_check_structural_function(cache.enum_index, certificate.name, position.line, parameters, body, true, extern_unsafe, unresolved_reachable, report.source_contracts.source_signature_contract_lines, report.source_contracts.source_signature_contract_kinds, report.source_contracts.source_signature_contracts, source_work, &cache.scratch, cache.graph.nodes.owner_modules[caller_node], true)
                    return false if:
                        cache.scratch.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        cache.scratch.results.failed != 0 or cache.scratch.analysis_1.kernel.budget_exhausted
                    return false if:
                        caller_node >= cache.scratch.analysis_1.structural.names.count or caller_node >= cache.scratch.analysis_1.structural.verified_members.count
                        cache.scratch.analysis_1.structural.names.count != cache.graph.nodes.declarations.count or cache.scratch.analysis_1.structural.verified_members.count != cache.graph.nodes.declarations.count
                        not proof_replay_structural_work_charge(source_work, 1)
                    owner_verified: bool = cache.scratch.analysis_1.structural.verified_members[caller_node]
                    return false if:
                        not owner_verified
                        not proof_replay_structural_certificate_set_matches_with_work(report, cache.certificate_index, certificate.name, cache.scratch, source_work)
                        not proof_replay_structural_text_compare(certificate.name, certificate.name, source_work)
                    cache.certificate_index.owners[certificate_owner.owner_index].source_validated <- true
                    return true
                _:
                    return false
