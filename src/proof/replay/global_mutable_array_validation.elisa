# Independent replay for the representation facts imported from a root-scope mutable global
# fixed array. The source initializer is deliberately irrelevant: these facts never reveal or
# freeze the array's contents.
extend ElisaProof:
    private:
        const PROOF_REPLAY_GLOBAL_MUTABLE_ARRAY_DEPTH_LIMIT: usize = 127

        def proof_replay_global_mutable_array_primitive(head: sview) -> bool:
            return head in {"i8", "i16", "i32", "i64", "int", "isize", "u8", "u16", "u32", "u64", "usize", "uintptr", "f32", "f64", "bool", "char"}

        def proof_replay_global_mutable_array_literal_extent(type_expression: Ast::Expr, depth: usize) -> i64:
            return -1 if depth >= PROOF_REPLAY_GLOBAL_MUTABLE_ARRAY_DEPTH_LIMIT
            match type_expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_global_mutable_array_literal_extent(inner, depth + 1)
                Ast::Expr.Unary(TokenKind.Ampersand, inner, _) | Ast::Expr.Unary(TokenKind.Lmut, inner, _) | Ast::Expr.Unary(TokenKind.Mutable, inner, _):
                    return proof_replay_global_mutable_array_literal_extent(inner, depth + 1)
                Ast::Expr.Index(Ast::Expr.Ident(element, _), Ast::Expr.IntLit(extent, _), _):
                    return extent if proof_replay_global_mutable_array_primitive(element) and extent >= 0
                Ast::Expr.IndexN(Ast::Expr.Ident("array", _), arguments, _):
                    if arguments.count == 2:
                        match arguments[1]:
                            Ast::Expr.IntLit(extent, _):
                                return extent if extent >= 0
                            _:
                                pass
                _:
                    pass
            return -1

        def proof_replay_global_mutable_array_annotation_count_with_work(annotations: darray[Ast::EnumAnnotation]&, name: sview, position: Ast::Pos, count: mutable usize&, source_work: mutable usize&) -> bool:
            for annotation in annotations |name, position, count, source_work|:
                return false if:
                    not proof_replay_mutable_local_text_compare_work_charge(annotation.name, "__global_mutable", source_work)
                    not proof_replay_mutable_local_text_compare_work_charge(annotation.owner, name, source_work)
                    not proof_replay_mutable_local_text_compare_work_charge(annotation.module, "", source_work)
                count <- count + 1 if annotation.name == "__global_mutable" and annotation.owner == name and annotation.module == "" and annotation.line == position.line and annotation.offset == position.offset and annotation.pos.line == position.line and annotation.pos.offset == position.offset
            return true

        def proof_replay_global_mutable_array_root_binding_count_with_work(declarations: darray[Ast::Decl]&, name: sview, count: mutable usize&, source_work: mutable usize&, complete: mutable bool&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_MUTABLE_ARRAY_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                complete <- false
                return
            for declaration in declarations |name, count, source_work, complete, depth|:
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    complete <- false
                    return
                source_work <- source_work + 1
                complete_now: mutable bool = proof_replay_summary_bool_ref_value(complete)
                match declaration:
                    Ast::Decl.Const(candidate, _, _, _, _) | Ast::Decl.Func(candidate, _, _, _, _, _, _) | Ast::Decl.Extern(candidate, _, _, _, _, _, _, _) | Ast::Decl.Import(candidate, _):
                        if not proof_replay_mutable_local_text_compare_work_charge(candidate, name, source_work):
                            complete <- false
                            return
                        count <- count + 1 if candidate == name
                    Ast::Decl.Module(candidate, _, _):
                        if not proof_replay_mutable_local_text_compare_work_charge(candidate, name, source_work):
                            complete <- false
                            return
                        count <- count + 1 if candidate == name
                    Ast::Decl.Scoped(nested, _):
                        proof_replay_global_mutable_array_root_binding_count_with_work(nested, name, count, source_work, complete, depth + 1)
                        complete_now <- proof_replay_summary_bool_ref_value(complete)
                        return if not complete_now
                    Ast::Decl.Invalid:
                        complete <- false
                        return
                    Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        complete <- false
                        return
            return

        def proof_replay_global_mutable_array_find_root_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration_line: u32, count: mutable usize&, valid: mutable bool&, extent: mutable i64&, position: mutable Ast::Pos&, source_work: mutable usize&, complete: mutable bool&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_MUTABLE_ARRAY_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                complete <- false
                return
            for declaration in declarations |annotations, name, declaration_line, count, valid, extent, position, source_work, complete, depth|:
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    complete <- false
                    return
                source_work <- source_work + 1
                complete_now: mutable bool = proof_replay_summary_bool_ref_value(complete)
                match declaration:
                    Ast::Decl.Const(candidate, candidate_type, _, is_global, candidate_position):
                        if not proof_replay_mutable_local_text_compare_work_charge(candidate, name, source_work):
                            complete <- false
                            return
                        if candidate == name:
                            count <- count + 1
                            valid <- false
                            if is_global and candidate_position.line == declaration_line:
                                annotation_matches: mutable usize = 0
                                if not proof_replay_global_mutable_array_annotation_count_with_work(annotations, name, candidate_position, &annotation_matches, source_work):
                                    complete <- false
                                    return
                                if annotation_matches == 1:
                                    if not proof_replay_summary_expr_charge_with_work(candidate_type, source_work):
                                        complete <- false
                                        return
                                    candidate_extent: i64 = proof_replay_global_mutable_array_literal_extent(candidate_type, 0)
                                    if candidate_extent >= 0:
                                        valid <- true
                                        extent <- candidate_extent
                                        position <- candidate_position
                    Ast::Decl.Scoped(body, _):
                        proof_replay_global_mutable_array_find_root_with_work(body, annotations, name, declaration_line, count, valid, extent, position, source_work, complete, depth + 1)
                        complete_now <- proof_replay_summary_bool_ref_value(complete)
                        return if not complete_now
                    Ast::Decl.Invalid:
                        complete <- false
                        return
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Module(_, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        complete <- false
                        return

        def proof_replay_global_mutable_array_find_owner_with_work(declarations: darray[Ast::Decl]&, name: sview, declaration_line: u32, matches: mutable usize&, parameters: mutable darray[Ast::ParamDecl]&, body: mutable darray[Ast::Stmt]&, position: mutable Ast::Pos&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_GLOBAL_MUTABLE_ARRAY_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for declaration in declarations |name, declaration_line, matches, parameters, body, position, source_work, depth|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match declaration:
                    Ast::Decl.Func(candidate, candidate_parameters, _, candidate_body, _, _, candidate_position):
                        return false if not proof_replay_mutable_local_text_compare_work_charge(candidate, name, source_work)
                        if candidate == name and candidate_position.line == declaration_line:
                            matches <- matches + 1
                            parameters <- candidate_parameters
                            body <- candidate_body
                            position <- candidate_position
                    Ast::Decl.Scoped(scoped, _):
                        return false if not proof_replay_global_mutable_array_find_owner_with_work(scoped, name, declaration_line, matches, parameters, body, position, source_work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Module(_, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_global_mutable_array_marker_term(expression: Ast::Expr) -> (known: bool, term: Ast::Expr):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (true, arguments[0]) if proof_ident_name(callee) == "__elisa_builtin_index_type" and arguments.count == 1 and argument_names.count == 0
                _:
                    pass
            return (false, Ast::Expr.Invalid)

        def proof_replay_global_mutable_array_fact_shape(expression: Ast::Expr, name: sview, extent: i64, global_position: Ast::Pos) -> bool:
            marker: (known: bool, term: Ast::Expr) = proof_replay_global_mutable_array_marker_term(expression)
            if marker.known:
                match marker.term:
                    Ast::Expr.Ident(candidate, position):
                        return candidate == name and position.line == global_position.line and position.offset == global_position.offset
                    _:
                        return false
            match expression:
                Ast::Expr.Binary(Ast::Expr.Field(Ast::Expr.Ident(candidate, object_position), "count", _), TokenKind.EqEq, Ast::Expr.IntLit(value, _), _):
                    return candidate == name and value == extent and object_position.line == global_position.line and object_position.offset == global_position.offset
                Ast::Expr.Binary(Ast::Expr.Ident(_, _), TokenKind.Lt, Ast::Expr.Field(Ast::Expr.Ident(candidate, _), "count", _), _):
                    return candidate == name
                _:
                    return false

        def proof_replay_global_mutable_array_bound_precondition(report: ProofReport&, owner_parameters: darray[Ast::ParamDecl]&, owner_body: darray[Ast::Stmt]&, expression: Ast::Expr, extent: i64, line: u32, source_work: mutable usize&) -> bool:
            match expression:
                Ast::Expr.Binary(Ast::Expr.Ident(bound_parameter, _), TokenKind.Lt, Ast::Expr.Field(Ast::Expr.Ident(_, _), "count", _), _):
                    return false if bound_parameter == ""
                    unsigned_parameter: mutable bool = false
                    return false if owner_parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                    source_work <- source_work + owner_parameters.count
                    for parameter in owner_parameters |bound_parameter, unsigned_parameter, source_work|:
                        return false if not proof_replay_mutable_local_text_compare_work_charge(parameter.name, bound_parameter, source_work)
                        if parameter.name == bound_parameter:
                            match parameter.type_expression:
                                Ast::Expr.Ident("usize", _):
                                    unsigned_parameter <- true
                                _:
                                    pass
                    return false if:
                        not unsigned_parameter
                        proof_replay_source_body_declares_with_work(report.source.source_declarations, owner_body, bound_parameter, source_work)
                    # A precondition about a by-value parameter is stable only while the function
                    # body leaves that binding unchanged. Calls and unsupported writes are treated
                    # conservatively by the shared source-write walk.
                    return false if:
                        proof_replay_source_body_touches_with_work(report.source.source_declarations, owner_body, bound_parameter, true, source_work)
                        owner_body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                    source_work <- source_work + owner_body.count
                    for statement in owner_body |bound_parameter, extent, line, source_work|:
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        source_work <- source_work + 1
                        match statement:
                            Ast::Stmt.Contract("requires", requirement, contract_position):
                                continue if contract_position.line > line
                                match requirement:
                                    Ast::Expr.Binary(Ast::Expr.Ident(required_parameter, _), TokenKind.Lt, Ast::Expr.IntLit(required_extent, _), _):
                                        return true if required_parameter == bound_parameter and required_extent == extent
                                    _:
                                        pass
                            _:
                                pass
                    return false
                _:
                    return false

        def proof_replay_global_mutable_array_source_preflight_with_work(report: ProofReport&, owner: sview, owner_line: u32, source_work: mutable usize&) -> bool:
            return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            found: mutable Ast::Expr = Ast::Expr.Invalid
            found_owner_line: mutable u32 = 0
            matches: mutable usize = 0
            owners: mutable usize = 0
            return proof_replay_summary_call_exact_span_in_declarations(report.source.source_declarations, owner, owner_line, Ast::Expr.Invalid, &found, &found_owner_line, &matches, &owners, source_work, 0)

        def proof_replay_global_mutable_array_type_fact_is_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_global_mutable_array_type_fact_is_valid_with_work(report, trace, &work)

        def proof_replay_global_mutable_array_type_fact_is_valid_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if:
                source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                not proof_replay_global_mutable_array_source_preflight_with_work(report, trace.name, trace.owner_line, source_work)
            # The exact-span walk establishes complete source shape; later declaration and body
            # walks charge their own work instead of reserving hypothetical passes in advance.
            return false if:
                proof_replay_summary_has_unresolved_import(report.source.source_annotations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                proof_replay_summary_has_unresolved_declaration_import(report.source.source_declarations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
            return proof_replay_global_mutable_array_type_fact_is_valid_after_preflight(report, trace, source_work)

        def proof_replay_global_mutable_array_type_fact_is_valid_after_preflight(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if:
                trace.kind != "global-mutable-array-type" and trace.kind != "global-mutable-array-index-bound" and trace.kind != "type-bound"
                trace.name == "" or trace.line == 0 or trace.owner_line == 0
                report.analysis_2.replay_owner_line == 0 or trace.owner_line != report.analysis_2.replay_owner_line
            owner_matches: mutable usize = 0
            owner_parameters: mutable darray[Ast::ParamDecl] = []
            owner_body: mutable darray[Ast::Stmt] = []
            owner_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            return false if:
                not proof_replay_global_mutable_array_find_owner_with_work(report.source.source_declarations, trace.name, trace.owner_line, &owner_matches, &owner_parameters, &owner_body, &owner_position, source_work, 0)
                owner_matches != 1 or owner_position.line != trace.owner_line
            global_matches: mutable usize = 0
            global_valid: mutable bool = false
            extent: mutable i64 = -1
            global_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            source_search_complete: mutable bool = true
            proof_replay_global_mutable_array_find_root_with_work(report.source.source_declarations, report.source.source_annotations, proof_replay_global_mutable_array_trace_global_name(trace.expression), trace.line, &global_matches, &global_valid, &extent, &global_position, source_work, &source_search_complete, 0)
            return false if not source_search_complete
            global_name: sview = proof_replay_global_mutable_array_trace_global_name(trace.expression)
            return false if global_name == "" or global_matches != 1 or not global_valid or extent < 0
            root_binding_count: mutable usize = 0
            source_search_complete <- true
            proof_replay_global_mutable_array_root_binding_count_with_work(report.source.source_declarations, global_name, &root_binding_count, source_work, &source_search_complete, 0)
            return false if:
                not source_search_complete or root_binding_count != 1
                owner_parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + owner_parameters.count
            for parameter in owner_parameters |parameter, global_name, source_work|:
                return false if:
                    not proof_replay_mutable_local_text_compare_work_charge(parameter.name, global_name, source_work)
                    parameter.name == global_name
            return false if:
                proof_replay_source_body_declares_with_work(report.source.source_declarations, owner_body, global_name, source_work)
                not proof_replay_global_mutable_array_fact_shape(trace.expression, global_name, extent, global_position)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(_, _), TokenKind.Lt, Ast::Expr.Field(Ast::Expr.Ident(_, _), "count", _), _):
                    return false if trace.kind != "global-mutable-array-index-bound" and trace.kind != "type-bound"
                    return proof_replay_global_mutable_array_bound_precondition(report, owner_parameters, owner_body, trace.expression, extent, trace.line, source_work)
                _:
                    return false if trace.kind == "global-mutable-array-index-bound"
            return true

        def proof_replay_global_mutable_array_trace_global_name(expression: Ast::Expr) -> sview:
            marker: (known: bool, term: Ast::Expr) = proof_replay_global_mutable_array_marker_term(expression)
            if marker.known:
                return proof_ident_name(marker.term)
            match expression:
                Ast::Expr.Binary(Ast::Expr.Field(object, "count", _), TokenKind.EqEq, _, _):
                    return proof_ident_name(object)
                Ast::Expr.Binary(Ast::Expr.Ident(_, _), TokenKind.Lt, Ast::Expr.Field(Ast::Expr.Ident(global_name, _), "count", _), _):
                    return global_name
                _:
                    return ""
