extend ElisaProofFrameSource:
    private:
        def scalar_array_type(expression: Ast::Expr, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64 or not replay_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Ampersand, inner, _):
                    return scalar_array_type(inner, depth + 1, work)
                Ast::Expr.Index(Ast::Expr.Ident("darray", _), element, _):
                    return contract_scalar_type_with_work(element, work)
                _:
                    return false

        def scalar_array_name(name: sview, names: darray[sview]&, types: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            return false if:
                names.count != types.count
                not replay_work_charge(names.count, work)
            for index in 0..<names.count |index, names, types, name, work|:
                return false if:
                    not replay_work_charge(sview_len(names[index]), work)
                    not replay_work_charge(sview_len(name), work)
                return scalar_array_type(types[index], 0, work) if names[index] == name
            return false

        # Read-only builtin scalar/array expressions. Numeric bounds and element
        # validity remain ordinary checker obligations, not frame theorems.
        def scalar_read(expression: Ast::Expr, names: darray[sview]&, types: darray[Ast::Expr]&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64 or not replay_work_charge(1, work)
            match expression:
                Ast::Expr.Field(Ast::Expr.Ident(name, _), "count", _):
                    return scalar_array_name(name, names, types, work)
                Ast::Expr.Index(Ast::Expr.Ident(name, _), index, _):
                    return scalar_array_name(name, names, types, work) and scalar_read(index, names, types, depth + 1, work)
                Ast::Expr.Paren(inner, _):
                    return scalar_read(inner, names, types, depth + 1, work)
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Not
                    return scalar_read(inner, names, types, depth + 1, work)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                    return scalar_read(left, names, types, depth + 1, work) and scalar_read(right, names, types, depth + 1, work)
                _:
                    return scalar_value(expression, names, types, depth + 1, work)
