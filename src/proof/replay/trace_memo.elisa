extend ElisaProof:
    private:
        # The two fact-trace validators of certificate_validation.elisa, memoized per pass by
        # trace index and consuming proof context (certificate or open attempt). A verdict is
        # reused only for that context, at the depth it validated from or shallower, and a kernel
        # verdict without arena revalidation never stands in for one that requires it.
        def proof_replay_trace_valid_memo(report: mutable ProofReport&, index: usize, owner: sview, depth: usize, dependency_stack: darray[sview]&, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global.Read, Global.Write]:
            return false if index >= report.analysis_1.traces.records.count
            context: usize = report.analysis_2.trace_consumer_certificate_index
            context <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + report.analysis_2.trace_consumer_attempt_index if report.analysis_2.trace_consumer_attempt_index != 0
            return true if index < validation_workspace.trace_memo_depth.count and index < validation_workspace.trace_memo_context.count and validation_workspace.trace_memo_context[index] == context and validation_workspace.trace_memo_depth[index] > depth
            outer_touched: bool = validation_workspace.trace_stack_touched
            validation_workspace.trace_stack_touched <- false
            valid: bool = (proof_replay_fact_trace_is_valid_with_stack(report, report.analysis_1.traces.records[index], owner, depth, dependency_stack, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            touched: bool = validation_workspace.trace_stack_touched
            validation_workspace.trace_stack_touched <- outer_touched or touched
            if valid and not touched:
                while validation_workspace.trace_memo_depth.count < report.analysis_1.traces.records.count |validation_workspace|:
                    validation_workspace.trace_memo_depth.push(0)
                while validation_workspace.trace_memo_context.count < report.analysis_1.traces.records.count |validation_workspace|:
                    validation_workspace.trace_memo_context.push(0)
                if validation_workspace.trace_memo_context[index] != context:
                    validation_workspace.trace_memo_context[index] <- context
                    validation_workspace.trace_memo_depth[index] <- 0
                validation_workspace.trace_memo_depth[index] <- depth + 1 if validation_workspace.trace_memo_depth[index] < depth + 1
            return valid

        def proof_replay_kernel_trace_valid_memo[@r](report: mutable ProofReport& @r, index: usize, owner: sview, depth: usize, dependency_stack: darray[sview]&, revalidate_arena: bool, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global.Read, Global.Write]:
            return false if index >= report.analysis_1.traces.records.count
            context: usize = report.analysis_2.trace_consumer_certificate_index
            context <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + report.analysis_2.trace_consumer_attempt_index if report.analysis_2.trace_consumer_attempt_index != 0
            if index < validation_workspace.kernel_trace_memo_depth.count and index < validation_workspace.kernel_trace_memo_context.count and index < validation_workspace.kernel_trace_memo_strict.count and validation_workspace.kernel_trace_memo_context[index] == context and validation_workspace.kernel_trace_memo_depth[index] > depth:
                return true if validation_workspace.kernel_trace_memo_strict[index] or not revalidate_arena
            outer_touched: bool = validation_workspace.trace_stack_touched
            validation_workspace.trace_stack_touched <- false
            valid: bool = (proof_replay_kernel_fact_trace_is_valid_with_stack(report, report.analysis_1.traces.records[index], owner, depth, dependency_stack, revalidate_arena, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            touched: bool = validation_workspace.trace_stack_touched
            validation_workspace.trace_stack_touched <- outer_touched or touched
            if valid and not touched:
                while validation_workspace.kernel_trace_memo_depth.count < report.analysis_1.traces.records.count |validation_workspace|:
                    validation_workspace.kernel_trace_memo_depth.push(0)
                    validation_workspace.kernel_trace_memo_strict.push(false)
                while validation_workspace.kernel_trace_memo_context.count < report.analysis_1.traces.records.count |validation_workspace|:
                    validation_workspace.kernel_trace_memo_context.push(0)
                while validation_workspace.kernel_trace_memo_strict.count < report.analysis_1.traces.records.count |validation_workspace|:
                    validation_workspace.kernel_trace_memo_strict.push(false)
                if validation_workspace.kernel_trace_memo_context[index] != context:
                    validation_workspace.kernel_trace_memo_context[index] <- context
                    validation_workspace.kernel_trace_memo_depth[index] <- 0
                    validation_workspace.kernel_trace_memo_strict[index] <- false
                stored: usize = validation_workspace.kernel_trace_memo_depth[index]
                if depth + 1 > stored:
                    validation_workspace.kernel_trace_memo_depth[index] <- depth + 1
                    validation_workspace.kernel_trace_memo_strict[index] <- revalidate_arena
                elif depth + 1 == stored and revalidate_arena:
                    validation_workspace.kernel_trace_memo_strict[index] <- true
            return valid

        def proof_replay_kernel_trace_range_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return trace.kernel_expression < report.analysis_1.kernel.nodes.count and trace.kernel_premises_start <= report.analysis_1.kernel.fact_trace_premises.count and trace.kernel_premises_count <= report.analysis_1.kernel.fact_trace_premises.count - trace.kernel_premises_start
