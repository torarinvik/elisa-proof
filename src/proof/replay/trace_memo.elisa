extend ElisaProof:
    private:
        # The two fact-trace validators of certificate_validation.elisa, memoized per pass by trace index (see the workspace). A
        # verdict is reused only at the depth it validated from or shallower, and a kernel
        # verdict without arena revalidation never stands in for one that requires it.
        def proof_replay_trace_valid_memo(report: mutable ProofReport&, index: usize, owner: sview, depth: usize, dependency_stack: darray[sview]&, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            return false if index >= report.traces.records.count
            return true if index < validation_workspace.trace_memo_depth.count and validation_workspace.trace_memo_depth[index] > depth
            outer_touched: bool = validation_workspace.trace_stack_touched
            validation_workspace.trace_stack_touched <- false
            valid: bool = proof_replay_fact_trace_is_valid_with_stack(report, report.traces.records[index], owner, depth, dependency_stack, active_certificates, validation_workspace)
            touched: bool = validation_workspace.trace_stack_touched
            validation_workspace.trace_stack_touched <- outer_touched or touched
            if valid and not touched:
                while validation_workspace.trace_memo_depth.count < report.traces.records.count |validation_workspace|:
                    validation_workspace.trace_memo_depth.push(0)
                validation_workspace.trace_memo_depth[index] <- depth + 1 if validation_workspace.trace_memo_depth[index] < depth + 1
            return valid

        def proof_replay_kernel_trace_valid_memo[@r](report: mutable ProofReport& @r, index: usize, owner: sview, depth: usize, dependency_stack: darray[sview]&, revalidate_arena: bool, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            return false if index >= report.traces.records.count
            if index < validation_workspace.kernel_trace_memo_depth.count and validation_workspace.kernel_trace_memo_depth[index] > depth:
                return true if validation_workspace.kernel_trace_memo_strict[index] or not revalidate_arena
            outer_touched: bool = validation_workspace.trace_stack_touched
            validation_workspace.trace_stack_touched <- false
            valid: bool = proof_replay_kernel_fact_trace_is_valid_with_stack(report, report.traces.records[index], owner, depth, dependency_stack, revalidate_arena, active_certificates, validation_workspace)
            touched: bool = validation_workspace.trace_stack_touched
            validation_workspace.trace_stack_touched <- outer_touched or touched
            if valid and not touched:
                while validation_workspace.kernel_trace_memo_depth.count < report.traces.records.count |validation_workspace|:
                    validation_workspace.kernel_trace_memo_depth.push(0)
                    validation_workspace.kernel_trace_memo_strict.push(false)
                stored: usize = validation_workspace.kernel_trace_memo_depth[index]
                if depth + 1 > stored:
                    validation_workspace.kernel_trace_memo_depth[index] <- depth + 1
                    validation_workspace.kernel_trace_memo_strict[index] <- revalidate_arena
                elif depth + 1 == stored and revalidate_arena:
                    validation_workspace.kernel_trace_memo_strict[index] <- true
            return valid

        def proof_replay_kernel_trace_range_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return trace.kernel_expression < report.kernel.nodes.count and trace.kernel_premises_start <= report.kernel.fact_trace_premises.count and trace.kernel_premises_count <= report.kernel.fact_trace_premises.count - trace.kernel_premises_start
