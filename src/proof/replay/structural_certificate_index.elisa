# Owner index for source-bound structural-safety certificate sets.
extend ElisaProof:
    private:
        def proof_replay_structural_certificate_index_charge(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + amount
            return true

        def proof_replay_structural_certificate_index_text_compare(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work <- work + 1
            return false if sview_len(left) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + sview_len(left)
            return false if sview_len(right) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + sview_len(right)
            return true

        def proof_replay_structural_certificate_index_build(report: ProofReport&, source_work: mutable usize&) -> (complete: bool, index: ProofReplayStructuralCertificateIndex):
            index: mutable ProofReplayStructuralCertificateIndex = ProofReplayStructuralCertificateIndex{owners: [], hashes: [], slots: [], certificate_indices: [], next_indices: [], complete: false}
            structural_count: mutable usize = 0
            for certificate in report.certificates |certificate, structural_count, source_work|:
                return (false, index) if not proof_replay_structural_certificate_index_charge(source_work, 1)
                return (false, index) if not proof_replay_structural_certificate_index_text_compare(certificate.rule, "structural-safety", source_work)
                if certificate.rule == "structural-safety":
                    return (false, index) if certificate.name == "" or not proof_replay_structural_certificate_index_text_compare(certificate.name, certificate.name, source_work)
                    return (false, index) if structural_count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    structural_count <- structural_count + 1
            if structural_count == 0:
                index.complete <- true
                return (true, index)
            capacity: usize = proof_name_index_capacity(structural_count)
            return (false, index) if capacity == 0 or not proof_replay_structural_certificate_index_charge(source_work, capacity)
            index.hashes.resize(capacity)
            index.slots.resize(capacity)
            for slot in 0..<capacity |slot, index, structural_count, source_work|:
                return (false, index) if not proof_replay_structural_certificate_index_charge(source_work, 1)
                index.slots[slot] <- 0
            sentinel: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            for certificate_index in 0..<report.certificates.count |certificate_index, report, index, capacity, sentinel, source_work|:
                certificate: ProofGoalCertificate = report.certificates[certificate_index]
                return (false, index) if not proof_replay_structural_certificate_index_charge(source_work, 1)
                return (false, index) if not proof_replay_structural_certificate_index_text_compare(certificate.rule, "structural-safety", source_work)
                continue if certificate.rule != "structural-safety"
                name: sview = certificate.name
                return (false, index) if not proof_replay_structural_certificate_index_charge(source_work, sview_len(name))
                hash: u32 = proof_name_hash(name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                owner_index: mutable usize = structural_count
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, index, capacity, structural_count, sentinel, source_work, owner_index|:
                    return (false, index) if not proof_replay_structural_certificate_index_charge(source_work, 1)
                    current: usize = index.slots[slot]
                    if current == 0:
                        return (false, index) if not proof_replay_structural_certificate_index_charge(source_work, 5)
                        owner_index <- index.owners.count
                        return (false, index) if owner_index >= structural_count
                        index.owners.push(ProofReplayStructuralCertificateOwner{name: name, head: sentinel, last_index: sentinel, count: 0, source_validated: false})
                        index.hashes[slot] <- hash
                        index.slots[slot] <- owner_index + 1
                        placed <- true
                        break
                    owner_index <- current - 1
                    return (false, index) if owner_index >= index.owners.count or owner_index >= structural_count
                    if index.hashes[slot] == hash:
                        return (false, index) if not proof_replay_structural_certificate_index_text_compare(index.owners[owner_index].name, name, source_work)
                        if index.owners[owner_index].name == name:
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return (false, index) if not placed or owner_index >= index.owners.count
                return (false, index) if index.certificate_indices.count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (false, index) if not proof_replay_structural_certificate_index_charge(source_work, 4)
                row: usize = index.certificate_indices.count
                index.certificate_indices.push(certificate_index)
                index.next_indices.push(sentinel)
                if index.owners[owner_index].head == sentinel:
                    index.owners[owner_index].head <- row
                else:
                    last_index: usize = index.owners[owner_index].last_index
                    return (false, index) if last_index >= row or last_index >= index.next_indices.count
                    index.next_indices[last_index] <- row
                index.owners[owner_index].last_index <- row
                return (false, index) if index.owners[owner_index].count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                index.owners[owner_index].count <- index.owners[owner_index].count + 1
            return (false, index) if index.certificate_indices.count != structural_count or index.next_indices.count != structural_count
            index.complete <- true
            return (true, index)

        def proof_replay_structural_certificate_owner_lookup(index: ProofReplayStructuralCertificateIndex&, wanted: sview, source_work: mutable usize&) -> (complete: bool, owner_index: usize):
            return (false, 0) if not index.complete
            capacity: usize = index.slots.count
            return (true, index.owners.count) if capacity == 0
            return (false, 0) if index.hashes.count != capacity
            return (false, 0) if not proof_replay_structural_certificate_index_text_compare(wanted, wanted, source_work)
            return (false, 0) if not proof_replay_structural_certificate_index_charge(source_work, sview_len(wanted))
            hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, wanted, index, capacity, source_work|:
                return (false, 0) if not proof_replay_structural_certificate_index_charge(source_work, 1)
                current: usize = index.slots[slot]
                return (true, index.owners.count) if current == 0
                owner_index: usize = current - 1
                return (false, 0) if owner_index >= index.owners.count
                if index.hashes[slot] == hash:
                    return (false, 0) if not proof_replay_structural_certificate_index_text_compare(index.owners[owner_index].name, wanted, source_work)
                    return (true, owner_index) if index.owners[owner_index].name == wanted
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            # Reaching the collision cap without an empty slot does not prove absence:
            # an owner may be farther along the probe chain. Fail closed instead.
            return (false, 0)
