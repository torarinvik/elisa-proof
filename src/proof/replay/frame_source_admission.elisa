extend ElisaProofFrameSource:
    private:
        # A direct write certificate must pass both the fact-free arena rule and
        # every source correspondence check. The caller supplies independently
        # parsed, semantically admitted source context with a checked identity.
        # This helper does not admit a report, or cover nested/aliased writes.
        def direct_operation_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, operation: sview) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (direct_operation_replays_with_work(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, operation, &work) can Global{Read,Write})

        def direct_operation_replays_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, operation: sview, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                facts.count != 0
                not replay_work_charge(nodes.count, work)
                not replay_work_charge(children.count, work)
                not (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(nodes, children) can Global{Read,Write})
                not (frame_policy_replays_after_arena_with_work(nodes, children, root, work) can Global{Read,Write})
            return (direct_operation_replays_after_arena_with_work(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, operation, work) can Global{Read,Write})

        def direct_operation_replays_after_arena_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, operation: sview, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                facts.count != 0
                nodes[root].operator != operation
            policy = source_policy_with_work(declarations, name, line, tokens, source, source_length, work)
            return false if not policy.known
            if operation == "preserve":
                return false if not preserve_lists_match_with_work(name, policy.parameter_count, &policy.clauses, nodes, children, root, work)
            else:
                return false if not lists_match_with_work(name, policy.parameter_count, &policy.clauses, nodes, children, root, work)
            return false if not replay_work_charge(policy.clauses.count, work)
            for clause in policy.clauses |declarations, name, line, work|:
                return false if not place_typed_with_work(declarations, name, line, clause.place, work)
            actual = direct_write_with_work(declarations, name, line, position, work)
            return false if not actual.known or not place_typed_with_work(declarations, name, line, actual.place, work)
            node = nodes[root]
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return false if:
                not certified.known
                not replay_work_charge(sview_len(actual.place.field), work)
                not replay_work_charge(sview_len(actual.place.field2), work)
                not replay_work_charge(sview_len(actual.place.field3), work)
                not replay_work_charge(sview_len(certified.place.field), work)
                not replay_work_charge(sview_len(certified.place.field2), work)
                not replay_work_charge(sview_len(certified.place.field3), work)
            return same_place(actual.place, certified.place)

    public:
        def direct_write_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (direct_write_replays_with_work(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def direct_write_replays_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return (direct_operation_replays_with_work(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, "write", work) can Global{Read,Write})

        def direct_allowance_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (direct_allowance_replays_with_work(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def direct_allowance_replays_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return (direct_operation_replays_with_work(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, "allow", work) can Global{Read,Write})

        def direct_preservation_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (direct_preservation_replays_with_work(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def direct_preservation_replays_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return (direct_operation_replays_with_work(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, "preserve", work) can Global{Read,Write})
