extend ElisaProofFrameSource:
    private:
        # A direct write certificate must pass both the fact-free arena rule and
        # every source correspondence check. The caller supplies independently
        # parsed, semantically admitted source context with a checked identity.
        # This helper does not admit a report, or cover nested/aliased writes.
        def direct_operation_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, operation: sview) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return false if not ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(nodes, children, facts, root)
            return false if nodes[root].operator != operation
            policy = source_policy(declarations, name, line, tokens, source, source_length)
            return false if not policy.known
            if operation == "preserve":
                return false if not preserve_lists_match(name, policy.parameter_count, &policy.clauses, nodes, children, root)
            else:
                return false if not lists_match(name, policy.parameter_count, &policy.clauses, nodes, children, root)
            for clause in policy.clauses |declarations, name, line|:
                return false if not place_typed(declarations, name, line, clause.place)
            actual = direct_write(declarations, name, line, position)
            return false if not actual.known or not place_typed(declarations, name, line, actual.place)
            node = nodes[root]
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return certified.known and same_place(actual.place, certified.place)

    public:
        def direct_write_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return direct_operation_replays(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, "write")

        def direct_allowance_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return direct_operation_replays(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, "allow")

        def direct_preservation_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return direct_operation_replays(declarations, name, line, position, tokens, source, source_length, nodes, children, facts, root, "preserve")
