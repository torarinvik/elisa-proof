# Reconstruct a narrow parameter-type fact subset from retained declarations. Generic
# `type-bound` rows are report input and must not be axioms just because their payload is empty.
extend ElisaProof:
    private:
        const PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT: usize = 1048576

        def proof_replay_type_bound_scalar_constant_type(type_expression: Ast::Expr) -> bool:
            match type_expression:
                Ast::Expr.Ident(type_name, _):
                    return type_name in {"i8", "i16", "i32", "i64", "isize", "int", "u8", "u16", "u32", "u64", "usize", "uintptr", "bool", "char"}
                _:
                    return false

        def proof_replay_type_bound_scalar_constant_lookup(report: ProofReport&, declarations: darray[Ast::Decl]&, wanted_scope: darray[sview]&, current_scope: darray[sview]&, constant_name: sview, marker_name: sview, marker_width: i64, matches: mutable usize&, valid: mutable bool&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                matches <- 2
                return
            scope_match: (complete: bool, equal: bool) = proof_replay_type_bound_scope_equal_with_work(wanted_scope, current_scope, work)
            if not scope_match.complete:
                matches <- 2
                return
            in_scope: bool = scope_match.equal
            for declaration in declarations |report, wanted_scope, current_scope, constant_name, marker_name, marker_width, matches, valid, work, depth, in_scope|:
                return if matches > 1
                if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                    matches <- 2
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Const(candidate_name, candidate_type, _, is_mutable, position):
                        if in_scope:
                            if not proof_replay_type_bound_local_text_compare_charge(candidate_name, constant_name, work):
                                matches <- 2
                                return
                            if candidate_name == constant_name:
                                matches <- matches + 1
                                constant_type_name: sview = match candidate_type:
                                    Ast::Expr.Ident(type_name, _): type_name
                                    _: ""
                                if constant_type_name != "":
                                    if not proof_replay_type_bound_local_text_repeat_charge(constant_type_name, 8, work):
                                        matches <- 2
                                        return
                                signed_width: i64 = proof_replay_type_bound_local_signed_width(report, candidate_type, work, 0)
                                unsigned_width: i64 = proof_replay_type_bound_local_unsigned_width(report, candidate_type, work, 0)
                                if constant_type_name != "":
                                    if not proof_replay_type_bound_local_text_repeat_charge(constant_type_name, 14, work):
                                        matches <- 2
                                        return
                                scalar: bool = proof_replay_type_bound_scalar_constant_type(candidate_type)
                                if not proof_replay_type_bound_local_text_repeat_charge(marker_name, 4, work):
                                    matches <- 2
                                    return
                                if marker_name == "__elisa_primitive_scalar_type":
                                    valid <- not is_mutable and scalar
                                elif marker_name in {"__elisa_signed_type_bound", "__elisa_signed_place_type_bound"}:
                                    valid <- not is_mutable and signed_width > 0 and marker_width == signed_width
                                elif marker_name == "__elisa_unsigned_type_bound":
                                    valid <- not is_mutable and unsigned_width > 0 and marker_width == unsigned_width
                                else:
                                    valid <- false
                    Ast::Decl.Module(module_name, nested, _):
                        normalized_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(current_scope, module_name, work)
                        if not normalized_scope.complete:
                            matches <- 2
                            return
                        next_scope: mutable darray[sview] = normalized_scope.scope
                        proof_replay_type_bound_scalar_constant_lookup(report, nested, wanted_scope, &next_scope, constant_name, marker_name, marker_width, matches, valid, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        proof_replay_type_bound_scalar_constant_lookup(report, nested, wanted_scope, current_scope, constant_name, marker_name, marker_width, matches, valid, work, depth + 1)
                    Ast::Decl.Invalid:
                        matches <- 2
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass

        def proof_replay_type_bound_owner_function_line(declarations: darray[Ast::Decl]&, name: sview, line: u32, best: mutable u32&, search_complete: mutable bool&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                search_complete <- false
                return
            for declaration in declarations |name, line, best, search_complete, work, depth|:
                if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                    search_complete <- false
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(candidate_name, _, _, _, _, _, candidate_position):
                        if not proof_replay_type_bound_local_text_compare_charge(candidate_name, name, work):
                            search_complete <- false
                            return
                        best <- candidate_position.line if candidate_name == name and candidate_position.line <= line and candidate_position.line > best
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_replay_type_bound_owner_function_line(nested, name, line, best, search_complete, work, depth + 1)
                    Ast::Decl.Invalid:
                        search_complete <- false
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass

        def proof_replay_type_bound_find_owner(declarations: darray[Ast::Decl]&, name: sview, owner_line: u32, matches: mutable usize&, parameters: mutable darray[Ast::ParamDecl]&, body: mutable darray[Ast::Stmt]&, position: mutable Ast::Pos&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                matches <- 2
                return
            for declaration in declarations |name, owner_line, matches, parameters, body, position, work, depth|:
                return if matches >= 2
                if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                    matches <- 2
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(candidate, candidate_parameters, _, candidate_body, _, _, candidate_position):
                        if not proof_replay_type_bound_local_text_compare_charge(candidate, name, work):
                            matches <- 2
                            return
                        if candidate == name and candidate_position.line == owner_line:
                            return if candidate_parameters.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work or candidate_body.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work - candidate_parameters.count
                            work <- work + candidate_parameters.count + candidate_body.count
                            matches <- matches + 1
                            parameters <- candidate_parameters
                            body <- candidate_body
                            position <- candidate_position
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_replay_type_bound_find_owner(nested, name, owner_line, matches, parameters, body, position, work, depth + 1)
                    Ast::Decl.Invalid:
                        matches <- 2
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass

        def proof_replay_type_bound_unique_owner_line(declarations: darray[Ast::Decl]&, name: sview, owner_line: mutable u32&, matches: mutable usize&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                matches <- 2
                return
            for declaration in declarations |name, owner_line, matches, work, depth|:
                return if matches >= 2
                if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                    matches <- 2
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(candidate, _, _, _, _, _, position):
                        if not proof_replay_type_bound_local_text_compare_charge(candidate, name, work):
                            matches <- 2
                            return
                        if candidate == name:
                            matches <- matches + 1
                            owner_line <- position.line
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_replay_type_bound_unique_owner_line(nested, name, owner_line, matches, work, depth + 1)
                    Ast::Decl.Invalid:
                        matches <- 2
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass

        def proof_replay_type_bound_scalar_constant_fact_with_work(report: mutable ProofReport&, owner_parameters: darray[Ast::ParamDecl]&, owner_body: darray[Ast::Stmt]&, owner_line: u32, trace: ProofFactTrace, work: mutable usize&) -> bool:
            return false if trace.kind != "type-bound" or trace.name == "" or trace.line == 0
            marker_name: mutable sview = ""
            marker_width: mutable i64 = 0
            term: mutable Ast::Expr = Ast::Expr.Invalid
            match trace.expression:
                Ast::Expr.Call(Ast::Expr.Ident(name, _), arguments, argument_names, _):
                    marker_name <- name
                    return false if not proof_replay_type_bound_local_text_repeat_charge(name, 4, work)
                    if name == "__elisa_primitive_scalar_type":
                        return false if arguments.count != 1 or argument_names.count != 0
                        term <- arguments[0]
                    elif name in {"__elisa_signed_type_bound", "__elisa_signed_place_type_bound", "__elisa_unsigned_type_bound"}:
                        return false if arguments.count != 2 or argument_names.count != 0
                        term <- arguments[0]
                        return false if not proof_replay_summary_expr_charge_with_work(arguments[1], work)
                        width_value: (known: bool, value: i64) = proof_constant_int(arguments[1])
                        return false if not width_value.known
                        marker_width <- width_value.value
                    else:
                        return false
                _:
                    return false
            return false if marker_name == ""
            owner_line: mutable u32 = 0
            owner_matches_by_name: mutable usize = 0
            proof_replay_type_bound_unique_owner_line(report.source.source_declarations, trace.name, &owner_line, &owner_matches_by_name, work, 0)
            return false if:
                owner_matches_by_name != 1
                report.analysis_2.replay_owner_line != 0 and report.analysis_2.replay_owner_line != 4294967295 and report.analysis_2.replay_owner_line != owner_line
            owner_matches: mutable usize = 0
            owner_parameters: mutable darray[Ast::ParamDecl] = []
            owner_body: mutable darray[Ast::Stmt] = []
            owner_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            proof_replay_type_bound_find_owner(report.source.source_declarations, trace.name, owner_line, &owner_matches, &owner_parameters, &owner_body, &owner_position, work, 0)
            return false if owner_matches != 1
            current_scope: mutable darray[sview] = []
            module_name: mutable sview = ""
            module_matches: mutable usize = 0
            return false if report.source.source_declarations.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
            work <- work + report.source.source_declarations.count
            proof_replay_module_at_function_line(report.source.source_declarations, owner_line, "", &module_name, &module_matches, 0)
            return false if module_matches != 1
            if module_name != "":
                normalized_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(current_scope, module_name, work)
                return false if not normalized_scope.complete
                current_scope <- normalized_scope.scope
            wanted_scope: mutable darray[sview] = []
            constant_name: mutable sview = ""
            qualified: mutable bool = false
            reference_path: mutable darray[sview] = []
            match term:
                Ast::Expr.Ident(name, _):
                    constant_name <- name
                    wanted_scope.extend(current_scope)
                Ast::Expr.Scope(_, _, _):
                    return false if not proof_replay_qualified_path(term, &reference_path, 0) or reference_path.count < 2
                    constant_name <- reference_path[reference_path.count - 1]
                    for index in 0..<reference_path.count - 1 |index, reference_path, wanted_scope|:
                        wanted_scope.push(reference_path[index])
                    qualified <- true
                Ast::Expr.ShorthandMember(parts, _):
                    return false if marker_name != "__elisa_primitive_scalar_type" or marker_width != 0 or parts.count != 1
                    return proof_replay_type_bound_const_enum_shorthand_scalar_with_work(report, parts[0], work)
                Ast::Expr.Field(enum_type, member_name, _):
                    return false if marker_name != "__elisa_primitive_scalar_type" or marker_width != 0
                    root: (complete: bool, name: sview) = proof_replay_type_bound_enum_root_name_with_work(enum_type, work, 0)
                    return false if:
                        not root.complete or root.name == ""
                        proof_replay_type_bound_enum_generic_shadowed_with_work(report, owner_line, root.name, work)
                    for parameter in owner_parameters |parameter, root, work|:
                        return false if:
                            not proof_replay_type_bound_local_text_compare_charge(parameter.name, root.name, work)
                            parameter.name == root.name
                    return false if proof_replay_source_body_declares_with_work(report.source.source_declarations, owner_body, root.name, work)
                    return proof_replay_type_bound_const_enum_field_scalar_with_work(report, enum_type, member_name, module_name, work)
                _:
                    return false
            return false if constant_name == ""
            shadow_name: sview = reference_path[0] if qualified else constant_name
            return false if owner_parameters.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
            work <- work + owner_parameters.count
            for parameter in owner_parameters |parameter, shadow_name, work|:
                return false if:
                    not proof_replay_type_bound_local_text_compare_charge(parameter.name, shadow_name, work)
                    parameter.name == shadow_name
            return false if:
                not proof_replay_type_bound_extent_preflight_with_work(owner_body, trace.expression, true, Ast::Expr.Absent, false, work)
                proof_replay_source_body_declares_with_work(report.source.source_declarations, owner_body, shadow_name, work)
            # A qualified spelling is a complete path from the source root. The owner scope is
            # only a base for bare names; carrying it into a qualified lookup duplicates the
            # module prefix for self-qualified constants inside `module` / `extend` bodies.
            lookup_scope: mutable darray[sview] = []
            lookup_scope.extend(current_scope) if not qualified
            matches: mutable usize = 0
            valid: mutable bool = false
            proof_replay_type_bound_scalar_constant_lookup(report, report.source.source_declarations, &wanted_scope, &lookup_scope, constant_name, marker_name, marker_width, &matches, &valid, work, 0)
            matches == 1 and valid

        def proof_replay_type_bound_parameter_declaration(report: ProofReport&, trace: ProofFactTrace, declarations: darray[Ast::Decl]&, owner_line: u32, matches: mutable usize&, valid: mutable bool&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                matches <- 2
                return
            for declaration in declarations |report, trace, owner_line, matches, valid, work, depth|:
                return if matches >= 2
                if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                    matches <- 2
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        if not proof_replay_type_bound_local_text_compare_charge(name, trace.name, work):
                            matches <- 2
                            return
                        if name == trace.name and position.line == owner_line:
                            matches <- matches + 1
                            if trace.line == position.line:
                                return if parameters.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
                                work <- work + parameters.count
                                for parameter in parameters |report, trace, valid, position, work|:
                                    valid <- true if proof_replay_type_bound_parameter_fact(report, parameter, trace.expression, position, work)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_replay_type_bound_parameter_declaration(report, trace, nested, owner_line, matches, valid, work, depth + 1)
                    Ast::Decl.Invalid:
                        matches <- 2
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass

        def proof_replay_type_bound_counting_loop_fact(expression: Ast::Expr, variables: darray[sview]&, iterable: Ast::Expr, position: Ast::Pos) -> bool:
            return false if variables.count != 1 or variables[0] == ""
            range: Ast::Expr = proof_loop_range_base(iterable)
            match range:
                Ast::Expr.Binary(low, operator, high, _):
                    return false if operator != TokenKind.RangeLt and operator != TokenKind.RangeLe
                    binder: Ast::Expr = proof_loop_binder_value(variables[0], position)
                    scalar: Ast::Expr = proof_scalar_term_marker(binder, position)
                    return true if proof_replay_expr_equal(expression, scalar)
                    match low:
                        Ast::Expr.IntLit(low_value, _):
                            match high:
                                Ast::Expr.IntLit(high_value, _):
                                    if low_value >= 0 and high_value >= low_value and high_value < 2147483647:
                                        signed: Ast::Expr = proof_signed_place_marker(binder, 32, position)
                                        return true if proof_replay_expr_equal(expression, signed)
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return false

        def proof_replay_type_bound_array_name(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_replay_type_bound_array_name(inner, depth + 1)
                _:
                    return ""

        def proof_replay_type_bound_index_use(expression: Ast::Expr, array_identifier: sview, index_expression: Ast::Expr, line: u32, use_position: Ast::Pos, work: mutable usize&, depth: usize) -> usize:
            return 2 if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.Index(object, subscript, position):
                    count: usize = 1 if proof_replay_type_bound_array_name(object, depth + 1) == array_identifier and proof_replay_summary_expr_equal_with_limit(subscript, index_expression, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT) and position.line == line and proof_replay_source_position_equal(position, use_position) else 0
                    object_count: usize = proof_replay_type_bound_index_use(object, array_identifier, index_expression, line, use_position, work, depth + 1)
                    subscript_count: usize = proof_replay_type_bound_index_use(subscript, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return count + object_count + subscript_count
                Ast::Expr.IndexN(object, arguments, position):
                    count: mutable usize = 1 if proof_replay_type_bound_array_name(object, depth + 1) == array_identifier and arguments.count == 1 and proof_replay_summary_expr_equal_with_limit(arguments[0], index_expression, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT) and position.line == line and proof_replay_source_position_equal(position, use_position) else 0
                    count <- count + proof_replay_type_bound_index_use(object, array_identifier, index_expression, line, use_position, work, depth + 1)
                    for argument in arguments |array_identifier, index_expression, line, use_position, work, depth, count|:
                        return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        count <- count + proof_replay_type_bound_index_use(argument, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return count
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_type_bound_index_use(inner, array_identifier, index_expression, line, use_position, work, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Refinement(left, right, _):
                    left_count: usize = proof_replay_type_bound_index_use(left, array_identifier, index_expression, line, use_position, work, depth + 1)
                    right_count: usize = proof_replay_type_bound_index_use(right, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return left_count + right_count
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    object_count: usize = proof_replay_type_bound_index_use(object, array_identifier, index_expression, line, use_position, work, depth + 1)
                    low_count: usize = proof_replay_type_bound_index_use(low, array_identifier, index_expression, line, use_position, work, depth + 1)
                    high_count: usize = proof_replay_type_bound_index_use(high, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return object_count + low_count + high_count
                Ast::Expr.Call(callee, arguments, _, _):
                    count: mutable usize = proof_replay_type_bound_index_use(callee, array_identifier, index_expression, line, use_position, work, depth + 1)
                    for argument in arguments |array_identifier, index_expression, line, use_position, work, depth, count|:
                        return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        count <- count + proof_replay_type_bound_index_use(argument, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return count
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    count: mutable usize = 0
                    for candidate in candidates |array_identifier, index_expression, line, use_position, work, depth, count|:
                        return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        work <- work + 1
                        for capture in candidate.captures |array_identifier, index_expression, line, use_position, work, depth, count|:
                            return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                            count <- count + proof_replay_type_bound_index_use(capture, array_identifier, index_expression, line, use_position, work, depth + 1)
                    for argument in arguments |array_identifier, index_expression, line, use_position, work, depth, count|:
                        return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        count <- count + proof_replay_type_bound_index_use(argument, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return count
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    count: mutable usize = 0
                    for element in elements |array_identifier, index_expression, line, use_position, work, depth, count|:
                        return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        count <- count + proof_replay_type_bound_index_use(element, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return count
                Ast::Expr.DictLit(entries, _):
                    count: mutable usize = 0
                    for entry in entries |array_identifier, index_expression, line, use_position, work, depth, count|:
                        return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        count <- count + proof_replay_type_bound_index_use(entry.key, array_identifier, index_expression, line, use_position, work, depth + 1)
                        count <- count + proof_replay_type_bound_index_use(entry.value, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return count
                Ast::Expr.Construct(type_expression, fields, _) | Ast::Expr.RecordUpdate(type_expression, fields, _):
                    count: mutable usize = proof_replay_type_bound_index_use(type_expression, array_identifier, index_expression, line, use_position, work, depth + 1)
                    for field in fields |array_identifier, index_expression, line, use_position, work, depth, count|:
                        return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        count <- count + proof_replay_type_bound_index_use(field.value, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return count
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    count: mutable usize = proof_replay_type_bound_index_use(subject, array_identifier, index_expression, line, use_position, work, depth + 1)
                    for arm in arms |array_identifier, index_expression, line, use_position, work, depth, count|:
                        return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                        count <- count + proof_replay_type_bound_index_use(arm.guard, array_identifier, index_expression, line, use_position, work, depth + 1)
                        count <- count + proof_replay_type_bound_index_use_body(arm.body, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return count
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    iterable_count: usize = proof_replay_type_bound_index_use(iterable, array_identifier, index_expression, line, use_position, work, depth + 1)
                    condition_count: usize = proof_replay_type_bound_index_use(condition, array_identifier, index_expression, line, use_position, work, depth + 1)
                    value_count: usize = proof_replay_type_bound_index_use(value, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return iterable_count + condition_count + value_count
                Ast::Expr.GetElse(guarded, recovery, _):
                    guarded_count: usize = proof_replay_type_bound_index_use(guarded, array_identifier, index_expression, line, use_position, work, depth + 1)
                    recovery_count: usize = proof_replay_type_bound_index_use_body(recovery, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return guarded_count + recovery_count
                Ast::Expr.Lambda(_, nested, _):
                    return proof_replay_type_bound_index_use_body(nested, array_identifier, index_expression, line, use_position, work, depth + 1)
                Ast::Expr.Block(nested, value, _, _):
                    nested_count: usize = proof_replay_type_bound_index_use_body(nested, array_identifier, index_expression, line, use_position, work, depth + 1)
                    value_count: usize = proof_replay_type_bound_index_use(value, array_identifier, index_expression, line, use_position, work, depth + 1)
                    return nested_count + value_count
                Ast::Expr.Invalid:
                    # Recovery nodes may hide a source use. They cannot prove uniqueness.
                    return 2
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return 0
                _:
                    # An expression variant added to the pinned AST without a visitor case
                    # makes source-use uniqueness inconclusive; never count it as absent.
                    return 2

        def proof_replay_type_bound_index_use_body(body: darray[Ast::Stmt]&, array_identifier: sview, index_expression: Ast::Expr, line: u32, use_position: Ast::Pos, work: mutable usize&, depth: usize) -> usize:
            return 2 if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            count: mutable usize = 0
            for statement in body |array_identifier, index_expression, line, use_position, work, depth, count|:
                return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                work <- work + 1
                match statement:
                    Ast::Stmt.VarDecl(_, type_expression, initializer, _):
                        count <- count + proof_replay_type_bound_index_use(type_expression, array_identifier, index_expression, line, use_position, work, depth + 1)
                        count <- count + proof_replay_type_bound_index_use(initializer, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        count <- count + proof_replay_type_bound_index_use(target, array_identifier, index_expression, line, use_position, work, depth + 1)
                        count <- count + proof_replay_type_bound_index_use(value, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _):
                        count <- count + proof_replay_type_bound_index_use(expression, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        count <- count + proof_replay_type_bound_index_use(condition, array_identifier, index_expression, line, use_position, work, depth + 1)
                        count <- count + proof_replay_type_bound_index_use_body(yes, array_identifier, index_expression, line, use_position, work, depth + 1)
                        count <- count + proof_replay_type_bound_index_use_body(no, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        count <- count + proof_replay_type_bound_index_use(condition, array_identifier, index_expression, line, use_position, work, depth + 1)
                        count <- count + proof_replay_type_bound_index_use_body(nested, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        count <- count + proof_replay_type_bound_index_use(iterable, array_identifier, index_expression, line, use_position, work, depth + 1)
                        count <- count + proof_replay_type_bound_index_use_body(nested, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        count <- count + proof_replay_type_bound_index_use_body(nested, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        count <- count + proof_replay_type_bound_index_use(expression, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.Match(subject, arms, _):
                        count <- count + proof_replay_type_bound_index_use(subject, array_identifier, index_expression, line, use_position, work, depth + 1)
                        for arm in arms |array_identifier, index_expression, line, use_position, work, depth, count|:
                            return 2 if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                            work <- work + 1
                            count <- count + proof_replay_type_bound_index_use(arm.guard, array_identifier, index_expression, line, use_position, work, depth + 1)
                            count <- count + proof_replay_type_bound_index_use_body(arm.body, array_identifier, index_expression, line, use_position, work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        # An unknown statement may contain an index use; uniqueness is inconclusive.
                        return 2
            return count

        # Fixed-array access can import `index < object.count` after proving the same index
        # below the source-declared literal extent. Reconstruct the array extent, the unsigned
        # index precondition, and the exact source subscript; the trace itself carries no trusted
        # premises.

include "./type_bound_array_validation.elisa"
