# Reconstruct source control-flow facts before replay admits them as boundary axioms.
# This module admits only source-anchored immutable control facts. Invariants additionally
# require independently replayable entry and preservation obligations.
extend ElisaProof:
    private:
        const PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT: usize = 16384
        const PROOF_REPLAY_CONTROL_DEPTH_LIMIT: usize = 64
        const PROOF_REPLAY_CONTROL_INVALID_OWNER_LINE: u32 = 4294967295

        def proof_replay_control_source_work_charge(source_work: mutable usize&, amount: usize) -> bool:
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            if amount > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work:
                source_work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            source_work <- source_work + amount
            return true

        def proof_replay_control_source_position_equal(left: Ast::Pos, right: Ast::Pos) -> bool:
            return left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        def proof_replay_control_expr_position_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return proof_replay_control_source_position_equal(Ast::expr_pos(left), Ast::expr_pos(right))

        # Substitution replaces a root identifier with the parameter's declaration AST, so its
        # source span moves even though the source site is still the exact same stable name.
        def proof_replay_control_expr_source_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return false if not proof_replay_expr_equal(left, right)
            return true if proof_replay_control_expr_position_equal(left, right)
            match left:
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return name == other
                        _:
                            return false
                _:
                    return false

        def proof_replay_control_expr_source_equal_with_work(left: Ast::Expr, right: Ast::Expr, work: mutable usize&, work_limit: usize) -> bool:
            return false if not proof_replay_summary_expr_equal_with_limit(left, right, work, work_limit)
            return true if proof_replay_control_expr_position_equal(left, right)
            match left:
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return false if not proof_replay_attempt_text_compare_with_limit(name, other, work, work_limit)
                            return name == other
                        _:
                            return false
                _:
                    return false

        def proof_replay_control_global_constant_count(declarations: darray[Ast::Decl]&, target: sview, matches: mutable usize&, mutable_matches: mutable usize&, depth: usize, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or not proof_replay_control_source_work_charge(source_work, 1)
            for declaration in declarations |target, matches, mutable_matches, depth, source_work|:
                return false if not proof_replay_control_source_work_charge(source_work, 1)
                match declaration:
                    Ast::Decl.Const(name, _, _, is_mutable, _):
                        return false if not proof_replay_control_source_work_charge(source_work, sview_len(name)) or not proof_replay_control_source_work_charge(source_work, sview_len(target))
                        if name == target:
                            matches <- matches + 1
                            mutable_matches <- mutable_matches + 1 if is_mutable
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_control_global_constant_count(nested, target, matches, mutable_matches, depth + 1, source_work)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_control_global_constant_immutable(declarations: darray[Ast::Decl]&, target: sview, source_work: mutable usize&) -> bool:
            matches: mutable usize = 0
            mutable_matches: mutable usize = 0
            return false if target == "" or not proof_replay_control_global_constant_count(declarations, target, &matches, &mutable_matches, 0, source_work)
            matches == 1 and mutable_matches == 0

        def proof_replay_control_immutable_boolean_parameter(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, exact_owner: bool, parameter_name: sview, depth: usize, source_work: mutable usize&) -> bool:
            return false if not exact_owner or depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or not proof_replay_control_source_work_charge(source_work, 1)
            for declaration in declarations |owner, owner_line, owner_offset, exact_owner, parameter_name, depth, source_work|:
                return false if not proof_replay_control_source_work_charge(source_work, 1)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return false if not proof_replay_control_source_work_charge(source_work, sview_len(name)) or not proof_replay_control_source_work_charge(source_work, sview_len(owner))
                        if name == owner and position.line == owner_line and position.offset.usize() == owner_offset:
                            matches: mutable usize = 0
                            valid: mutable bool = false
                            for parameter in parameters |parameter_name, matches, valid, source_work|:
                                return false if not proof_replay_control_source_work_charge(source_work, 1)
                                return false if not proof_replay_control_source_work_charge(source_work, sview_len(parameter.name)) or not proof_replay_control_source_work_charge(source_work, sview_len(parameter_name))
                                if parameter.name == parameter_name:
                                    matches <- matches + 1
                                    match parameter.type_expression:
                                        Ast::Expr.Ident("bool", _):
                                            valid <- not parameter.is_mutable
                                        _:
                                            valid <- false
                            return matches == 1 and valid
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_control_immutable_boolean_parameter(nested, owner, owner_line, owner_offset, exact_owner, parameter_name, depth + 1, source_work)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return false

        # The shared integer-parameter scanner uses the summary meter. Seed that meter so
        # this caller's smaller CONTROL budget remains the effective limit, then debit the
        # exact amount consumed before trying the Boolean-parameter path.
        def proof_replay_control_immutable_integer_parameter(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, exact_owner: bool, parameter_name: sview, source_work: mutable usize&) -> bool:
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            remaining_work: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            scan_seed: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - remaining_work
            scan_work: mutable usize = scan_seed
            valid: bool = proof_replay_local_binding_immutable_integer_parameter_at_offset_with_work(declarations, owner, owner_line, owner_offset, exact_owner, parameter_name, &scan_work, 0)
            if scan_work < scan_seed:
                source_work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            scan_cost: usize = scan_work - scan_seed
            if scan_cost > remaining_work:
                source_work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            source_work <- source_work + scan_cost
            valid

        def proof_replay_control_stable_identifier(report: ProofReport&, trace: ProofFactTrace, name: sview, source_work: mutable usize&) -> bool:
            return false if name == ""
            if proof_replay_control_global_constant_immutable(report.source.source_declarations, name, source_work):
                return false if proof_replay_local_binding_parameter_name_present_at_offset_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT, 0)
                return proof_replay_local_binding_parameter_source_unshadowed_at_offset_with_limit(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
            return false if not proof_replay_local_binding_parameter_source_unshadowed_at_offset_with_limit(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
            return proof_replay_control_immutable_integer_parameter(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, source_work) or proof_replay_control_immutable_boolean_parameter(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, 0, source_work)

        def proof_replay_control_deterministic_declaration_scan_with_work(declarations: darray[Ast::Decl]&, source_work: mutable usize&) -> bool:
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            remaining_work: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            scan_seed: usize = PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - remaining_work
            scan_work: mutable usize = scan_seed
            complete: bool = proof_replay_deterministic_declaration_scan_charge(declarations, &scan_work, 0)
            if scan_work < scan_seed:
                source_work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            scan_cost: usize = scan_work - scan_seed
            return false if scan_cost > remaining_work
            source_work <- source_work + scan_cost
            complete

        def proof_replay_control_stable_identifier_with_work(report: ProofReport&, trace: ProofFactTrace, name: sview, source_work: mutable usize&) -> bool:
            return false if:
                name == ""
                not proof_replay_control_deterministic_declaration_scan_with_work(report.source.source_declarations, source_work)
            owner_line: mutable u32 = report.analysis_2.replay_owner_line
            owner_line <- 0 if owner_line == PROOF_REPLAY_CONTROL_INVALID_OWNER_LINE
            return false if not proof_replay_summary_owner_source_scan_with_limit(report, trace.name, owner_line, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
            return proof_replay_control_stable_identifier(report, trace, name, source_work)

        # Only source expressions whose value cannot change during the control-flow region
        # and remain source-identical after checker substitution are eligible. Calls, fields,
        # and substituted locals need a source environment/effect certificate this trace lacks.
        def proof_replay_control_stable_expression(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, source_work: mutable usize&) -> bool:
            owner_line: mutable u32 = report.analysis_2.replay_owner_line
            owner_line <- 0 if owner_line == PROOF_REPLAY_CONTROL_INVALID_OWNER_LINE
            return false if not proof_replay_summary_owner_source_scan_with_limit(report, trace.name, owner_line, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            expression_seed: usize = source_work
            expression_work: mutable usize = expression_seed
            valid: bool = proof_replay_control_stable_expression_budgeted(report, trace, expression, &expression_work, 0)
            if expression_work < expression_seed:
                source_work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            expression_work <- expression_work - expression_seed
            return false if expression_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + expression_work
            return valid

        def proof_replay_control_stable_expression_budgeted(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return false if name == ""
                    for charge_index in 0..<3 |charge_index, report, work|:
                        return false if not proof_replay_control_match_guard_charge_declarations(report.source.source_declarations, work, 0)
                    return proof_replay_control_stable_identifier(report, trace, name, work)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_control_stable_expression_budgeted(report, trace, inner, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Not and operator != TokenKind.Minus
                    protocol: sview = proof_builtin_unary_operator_protocol(operator)
                    return false if protocol != "" and proof_source_primitive_operator_mask_has(report.source.source_primitive_operator_mask, protocol)
                    return proof_replay_control_stable_expression_budgeted(report, trace, inner, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                    protocol: sview = proof_builtin_operator_protocol(operator)
                    return false if:
                        protocol != "" and proof_source_primitive_operator_mask_has(report.source.source_primitive_operator_mask, protocol)
                        not proof_replay_control_stable_expression_budgeted(report, trace, left, work, depth + 1)
                    return proof_replay_control_stable_expression_budgeted(report, trace, right, work, depth + 1)
                _:
                    return false

        def proof_replay_control_negation(expression: Ast::Expr, position: Ast::Pos) -> Ast::Expr:
            match expression:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return inner
                Ast::Expr.BoolLit(value, _):
                    return Ast::Expr.BoolLit(not value, position)
                Ast::Expr.Binary(_, TokenKind.And, _, _):
                    return Ast::Expr.Unary(TokenKind.Not, expression, position)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, left, position), TokenKind.And, Ast::Expr.Unary(TokenKind.Not, right, position), position)
                _:
                    return Ast::Expr.Unary(TokenKind.Not, expression, position)

        def proof_replay_control_assertion_matches(statement: Ast::Stmt, certificate: ProofGoalCertificate) -> bool:
            work: mutable usize = 0
            proof_replay_control_assertion_matches_with_work(statement, certificate, &work)

        def proof_replay_control_assertion_matches_with_work(statement: Ast::Stmt, certificate: ProofGoalCertificate, work: mutable usize&) -> bool:
            # The source goal has to survive the checker substitution with the same tree and
            # span. A substituted local is rejected until replay can authenticate its value map.
            match statement:
                Ast::Stmt.Contract("assert", expression, position):
                    return false if position.line != certificate.line
                    return proof_replay_control_expr_source_equal_with_work(expression, certificate.goal, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("assert", _), arguments, _, _), position):
                    return false if position.line != certificate.line or arguments.count != 1
                    return proof_replay_control_expr_source_equal_with_work(arguments[0], certificate.goal, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                _:
                    return false

        def proof_replay_control_assert_by_goal_matches(statement: Ast::Stmt, certificate: ProofGoalCertificate) -> bool:
            work: mutable usize = 0
            proof_replay_control_assert_by_goal_matches_with_work(statement, certificate, &work)

        def proof_replay_control_assert_by_goal_matches_with_work(statement: Ast::Stmt, certificate: ProofGoalCertificate, work: mutable usize&) -> bool:
            match statement:
                Ast::Stmt.Block("assert_by", _, _, body, _):
                    return false if body.count == 0
                    match body[0]:
                        Ast::Stmt.Contract(kind, expression, position):
                            # An assert-by block's first contract is its declared goal. Other
                            # contracts count only in this exact first-statement role.
                            return false if kind != "assert" or position.line != certificate.line
                            return proof_replay_control_expr_source_equal_with_work(expression, certificate.goal, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                        _:
                            return false
                _:
                    return false

        def proof_replay_control_assertion_expr_scan(expression: Ast::Expr, certificate: ProofGoalCertificate, depth: usize, work: mutable usize&, matches: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Lambda(parameters, body, _):
                    for parameter in parameters |certificate, depth, work, matches|:
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        work <- work + 1
                    hidden_matches: mutable usize = 0
                    return proof_replay_control_assertion_scan(body, certificate, depth + 1, work, &hidden_matches)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_control_assertion_expr_scan(callee, certificate, depth + 1, work, matches)
                    for argument in arguments |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(argument, certificate, depth + 1, work, matches)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |certificate, depth, work, matches|:
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        work <- work + 1
                        for capture in candidate.captures |certificate, depth, work, matches|:
                            return false if not proof_replay_control_assertion_expr_scan(capture, certificate, depth + 1, work, matches)
                    for argument in arguments |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(argument, certificate, depth + 1, work, matches)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_control_assertion_expr_scan(object, certificate, depth + 1, work, matches)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return false if not proof_replay_control_assertion_expr_scan(object, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_expr_scan(index, certificate, depth + 1, work, matches)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return false if:
                        not proof_replay_control_assertion_expr_scan(object, certificate, depth + 1, work, matches)
                        not proof_replay_control_assertion_expr_scan(low, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_expr_scan(high, certificate, depth + 1, work, matches)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_control_assertion_expr_scan(object, certificate, depth + 1, work, matches)
                    for argument in arguments |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(argument, certificate, depth + 1, work, matches)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(element, certificate, depth + 1, work, matches)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |certificate, depth, work, matches|:
                        return false if:
                            not proof_replay_control_assertion_expr_scan(entry.key, certificate, depth + 1, work, matches)
                            not proof_replay_control_assertion_expr_scan(entry.value, certificate, depth + 1, work, matches)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_control_assertion_expr_scan(base, certificate, depth + 1, work, matches)
                    for field in fields |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(field.value, certificate, depth + 1, work, matches)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return false if not proof_replay_control_assertion_expr_scan(subject, certificate, depth + 1, work, matches)
                    for arm in arms |certificate, depth, work, matches|:
                        return false if:
                            not proof_replay_control_pattern_within_budget(arm.pattern, 0, work)
                            not proof_replay_control_assertion_expr_scan(arm.guard, certificate, depth + 1, work, matches)
                            not proof_replay_control_assertion_scan(arm.body, certificate, depth + 1, work, matches)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return false if:
                        not proof_replay_control_assertion_expr_scan(iterable, certificate, depth + 1, work, matches)
                        not proof_replay_control_assertion_expr_scan(condition, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_expr_scan(value, certificate, depth + 1, work, matches)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_control_assertion_expr_scan(guarded, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_scan(recovery, certificate, depth + 1, work, matches)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_control_assertion_scan(statements, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_expr_scan(value, certificate, depth + 1, work, matches)
            return false

        def proof_replay_control_assertion_scan(body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, depth: usize, work: mutable usize&, matches: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT
            for statement in body |certificate, depth, work, matches|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                matches <- matches + 1 if proof_replay_control_assertion_matches_with_work(statement, certificate, work) or proof_replay_control_assert_by_goal_matches_with_work(statement, certificate, work)
                match statement:
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _):
                        return false if not proof_replay_control_assertion_expr_scan(expression, certificate, depth + 1, work, matches)
                    Ast::Stmt.VarDecl(_, type_expression, value, _):
                        return false if:
                            not proof_replay_control_assertion_expr_scan(type_expression, certificate, depth + 1, work, matches)
                            not proof_replay_control_assertion_expr_scan(value, certificate, depth + 1, work, matches)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if:
                            not proof_replay_control_assertion_expr_scan(target, certificate, depth + 1, work, matches)
                            not proof_replay_control_assertion_expr_scan(value, certificate, depth + 1, work, matches)
                    Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_control_assertion_expr_scan(expression, certificate, depth + 1, work, matches)
                    Ast::Stmt.Block(_, clause, _, inner, _):
                        for _ in clause |certificate, depth, work, matches|:
                            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            work <- work + 1
                        return false if not proof_replay_control_assertion_scan(inner, certificate, depth + 1, work, matches)
                    Ast::Stmt.While(condition, inner, _):
                        return false if:
                            not proof_replay_control_assertion_expr_scan(condition, certificate, depth + 1, work, matches)
                            not proof_replay_control_assertion_scan(inner, certificate, depth + 1, work, matches)
                    Ast::Stmt.For(_, variables, iterable, inner, _):
                        for _ in variables |certificate, depth, work, matches|:
                            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            work <- work + 1
                        return false if:
                            not proof_replay_control_assertion_expr_scan(iterable, certificate, depth + 1, work, matches)
                            not proof_replay_control_assertion_scan(inner, certificate, depth + 1, work, matches)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if:
                            not proof_replay_control_assertion_expr_scan(condition, certificate, depth + 1, work, matches)
                            not proof_replay_control_assertion_scan(yes, certificate, depth + 1, work, matches)
                            not proof_replay_control_assertion_scan(no, certificate, depth + 1, work, matches)
                    Ast::Stmt.Match(subject, arms, _):
                        return false if not proof_replay_control_assertion_expr_scan(subject, certificate, depth + 1, work, matches)
                        for arm in arms |certificate, depth, work, matches|:
                            return false if:
                                not proof_replay_control_pattern_within_budget(arm.pattern, 0, work)
                                not proof_replay_control_assertion_expr_scan(arm.guard, certificate, depth + 1, work, matches)
                                not proof_replay_control_assertion_scan(arm.body, certificate, depth + 1, work, matches)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_control_certificate_attempt_index_unique(report: ProofReport&, certificate: ProofGoalCertificate, certificate_index: usize) -> bool:
            work: mutable usize = 0
            return proof_replay_control_certificate_attempt_index_unique_with_work(report, certificate, certificate_index, &work)

        def proof_replay_control_certificate_attempt_index_unique_with_work(report: ProofReport&, certificate: ProofGoalCertificate, certificate_index: usize, work: mutable usize&) -> bool:
            return false if:
                certificate_index >= report.analysis_1.certificates.count
                report.analysis_1.certificates[certificate_index].name != certificate.name or report.analysis_1.certificates[certificate_index].line != certificate.line
                certificate.source_phase != "" and certificate.source_phase != "loop-invariant-entry" and certificate.source_phase != "loop-invariant-preservation"
                work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT or report.results.goal_attempts.count > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
            work <- work + report.results.goal_attempts.count
            matches: mutable usize = 0
            for index in 0..<report.results.goal_attempts.count |index, report, certificate, certificate_index, matches, work|:
                attempt: ProofGoalAttempt = report.results.goal_attempts[index]
                matched: bool = proof_replay_attempt_matches_certificate_with_limit(report, attempt, certificate, certificate_index, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                matches <- matches + 1 if matched
                return false if:
                    work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                    work == PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT and (index + 1 < report.results.goal_attempts.count or not matched)
                    work == PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT and (index + 1 < report.results.goal_attempts.count or not matched)
            matches == 1

        def proof_replay_control_certificate_attempt_unique(report: ProofReport&, certificate: ProofGoalCertificate) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate_index: usize = report.analysis_2.trace_consumer_certificate_index - 1
            return proof_replay_control_certificate_attempt_index_unique(report, certificate, certificate_index)

        def proof_replay_control_certificate_attempt_unique_with_work(report: ProofReport&, certificate: ProofGoalCertificate, work: mutable usize&) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate_index: usize = report.analysis_2.trace_consumer_certificate_index - 1
            return proof_replay_control_certificate_attempt_index_unique_with_work(report, certificate, certificate_index, work)

        def proof_replay_control_assertion_in_scope(report: ProofReport&, whole_body: darray[Ast::Stmt]&, scope_body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate) -> bool:
            work: mutable usize = 0
            return proof_replay_control_assertion_in_scope_with_work(report, whole_body, scope_body, certificate, &work)

        def proof_replay_control_assertion_in_scope_with_work(report: ProofReport&, whole_body: darray[Ast::Stmt]&, scope_body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, work: mutable usize&) -> bool:
            return false if:
                certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
                not proof_replay_control_certificate_attempt_unique_with_work(report, certificate, work)
            whole_matches: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(whole_body, certificate, 0, work, &whole_matches) or whole_matches != 1
            scope_matches: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(scope_body, certificate, 0, work, &scope_matches)
            return scope_matches == 1

        def proof_replay_control_assertion_unique_in_owner(report: ProofReport&, body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, work: mutable usize&) -> bool:
            return false if:
                certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
                not proof_replay_control_certificate_attempt_unique_with_work(report, certificate, work)
            matches: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(body, certificate, 0, work, &matches)
            matches == 1
        # Compare AST statement order in the loop's lexical parent. A larger line or byte offset
        # alone cannot distinguish a same-line assertion in the loop body from one after it.
        def proof_replay_control_assertion_after_loop(report: ProofReport&, whole_body: darray[Ast::Stmt]&, lexical_body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, loop_line: u32) -> bool:
            work: mutable usize = 0
            proof_replay_control_assertion_after_loop_with_work(report, whole_body, lexical_body, certificate, loop_line, &work)

        def proof_replay_control_assertion_after_loop_with_work(report: ProofReport&, whole_body: darray[Ast::Stmt]&, lexical_body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, loop_line: u32, work: mutable usize&) -> bool:
            return false if not proof_replay_control_assertion_in_scope_with_work(report, whole_body, whole_body, certificate, work)
            loop_matches: mutable usize = 0
            loop_index: mutable usize = lexical_body.count
            for index in 0..<lexical_body.count |index, lexical_body, loop_line, loop_matches, loop_index, work|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                match lexical_body[index]:
                    Ast::Stmt.While(_, _, position) | Ast::Stmt.For(_, _, _, _, position):
                        if position.line == loop_line:
                            loop_matches <- loop_matches + 1
                            loop_index <- index
                    _:
                        pass
            return false if loop_matches != 1
            assertion_matches: mutable usize = 0
            assertion_index: mutable usize = lexical_body.count
            for index in 0..<lexical_body.count |index, lexical_body, certificate, assertion_matches, assertion_index, work|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                single_statement: mutable darray[Ast::Stmt] = [lexical_body[index]]
                local_matches: mutable usize = 0
                return false if not proof_replay_control_assertion_scan(single_statement, certificate, 0, work, &local_matches)
                if local_matches > 0:
                    assertion_matches <- assertion_matches + local_matches
                    assertion_index <- index
            assertion_matches == 1 and assertion_index > loop_index

        def proof_replay_control_body_has_break(body: darray[Ast::Stmt]&, depth: usize, loop_depth: usize, work: mutable usize&, work_limit: usize) -> bool:
            return true if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT
            for statement in body |depth, loop_depth, work, work_limit|:
                return true if work >= work_limit
                work <- work + 1
                match statement:
                    Ast::Stmt.Break(label, _):
                        return true if label != "" or loop_depth == 0
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.VarDecl(_, _, expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return true if proof_replay_control_expr_has_break(expression, depth + 1, loop_depth, work, work_limit)
                    Ast::Stmt.Assign(target, _, value, _):
                        return true if proof_replay_control_expr_has_break(target, depth + 1, loop_depth, work, work_limit) or proof_replay_control_expr_has_break(value, depth + 1, loop_depth, work, work_limit)
                    Ast::Stmt.Block(kind, _, _, inner, _):
                        return true if kind != "assert_by" and proof_replay_control_body_has_break(inner, depth + 1, loop_depth, work, work_limit)
                    Ast::Stmt.While(condition, inner, _):
                        return true if proof_replay_control_expr_has_break(condition, depth + 1, loop_depth, work, work_limit) or proof_replay_control_body_has_break(inner, depth + 1, loop_depth + 1, work, work_limit)
                    Ast::Stmt.For(_, _, iterable, inner, _):
                        return true if proof_replay_control_expr_has_break(iterable, depth + 1, loop_depth, work, work_limit) or proof_replay_control_body_has_break(inner, depth + 1, loop_depth + 1, work, work_limit)
                    Ast::Stmt.If(condition, yes, no, _):
                        return true if proof_replay_control_expr_has_break(condition, depth + 1, loop_depth, work, work_limit) or proof_replay_control_body_has_break(yes, depth + 1, loop_depth, work, work_limit) or proof_replay_control_body_has_break(no, depth + 1, loop_depth, work, work_limit)
                    Ast::Stmt.Match(subject, arms, _):
                        return true if proof_replay_control_expr_has_break(subject, depth + 1, loop_depth, work, work_limit)
                        for arm in arms |depth, loop_depth, work, work_limit|:
                            return true if work >= work_limit
                            work <- work + 1
                            return true if proof_replay_control_expr_has_break(arm.guard, depth + 1, loop_depth, work, work_limit) or proof_replay_control_body_has_break(arm.body, depth + 1, loop_depth, work, work_limit)
                    Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return true
            return false

        def proof_replay_control_expr_has_break(expression: Ast::Expr, depth: usize, loop_depth: usize, work: mutable usize&, work_limit: usize) -> bool:
            return true if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= work_limit
            work <- work + 1
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_replay_control_expr_has_break(callee, depth + 1, loop_depth, work, work_limit)
                    for argument in arguments |depth, loop_depth, work, work_limit|:
                        return true if proof_replay_control_expr_has_break(argument, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |depth, loop_depth, work, work_limit|:
                        return true if work >= work_limit
                        work <- work + 1
                        for capture in candidate.captures |depth, loop_depth, work, work_limit|:
                            return true if proof_replay_control_expr_has_break(capture, depth + 1, loop_depth, work, work_limit)
                    for argument in arguments |depth, loop_depth, work, work_limit|:
                        return true if proof_replay_control_expr_has_break(argument, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_control_expr_has_break(object, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return proof_replay_control_expr_has_break(object, depth + 1, loop_depth, work, work_limit) or proof_replay_control_expr_has_break(index, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return proof_replay_control_expr_has_break(object, depth + 1, loop_depth, work, work_limit) or proof_replay_control_expr_has_break(low, depth + 1, loop_depth, work, work_limit) or proof_replay_control_expr_has_break(high, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_replay_control_expr_has_break(object, depth + 1, loop_depth, work, work_limit)
                    for argument in arguments |depth, loop_depth, work, work_limit|:
                        return true if proof_replay_control_expr_has_break(argument, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |depth, loop_depth, work, work_limit|:
                        return true if proof_replay_control_expr_has_break(element, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, loop_depth, work, work_limit|:
                        return true if proof_replay_control_expr_has_break(entry.key, depth + 1, loop_depth, work, work_limit) or proof_replay_control_expr_has_break(entry.value, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_replay_control_expr_has_break(base, depth + 1, loop_depth, work, work_limit)
                    for field in fields |depth, loop_depth, work, work_limit|:
                        return true if proof_replay_control_expr_has_break(field.value, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return true if proof_replay_control_expr_has_break(subject, depth + 1, loop_depth, work, work_limit)
                    for arm in arms |depth, loop_depth, work, work_limit|:
                        return true if work >= work_limit
                        work <- work + 1
                        return true if proof_replay_control_expr_has_break(arm.guard, depth + 1, loop_depth, work, work_limit) or proof_replay_control_body_has_break(arm.body, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return true if proof_replay_control_expr_has_break(iterable, depth + 1, loop_depth, work, work_limit)
                    return proof_replay_control_expr_has_break(condition, depth + 1, loop_depth, work, work_limit) or proof_replay_control_expr_has_break(value, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return true if proof_replay_control_expr_has_break(guarded, depth + 1, loop_depth, work, work_limit)
                    return proof_replay_control_body_has_break(recovery, depth + 1, loop_depth, work, work_limit)
                Ast::Expr.Lambda(_, _, _):
                    return false
                Ast::Expr.Block(statements, value, _, _):
                    return proof_replay_control_body_has_break(statements, depth + 1, loop_depth, work, work_limit) or proof_replay_control_expr_has_break(value, depth + 1, loop_depth, work, work_limit)
            return true
