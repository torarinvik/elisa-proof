# Reconstruct source control-flow facts before replay admits them as boundary axioms.
# This module admits only source-anchored immutable control facts. Invariants additionally
# require independently replayable entry and preservation obligations.
extend ElisaProof:
    private:
        const PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT: usize = 16384

        def proof_replay_control_source_position_equal(left: Ast::Pos, right: Ast::Pos) -> bool:
            return left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        def proof_replay_control_expr_position_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return proof_replay_control_source_position_equal(Ast::expr_pos(left), Ast::expr_pos(right))

        # Substitution replaces a root identifier with the parameter's declaration AST, so its
        # source span moves even though the source site is still the exact same stable name.
        def proof_replay_control_expr_source_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return false if not proof_replay_expr_equal(left, right)
            return true if proof_replay_control_expr_position_equal(left, right)
            match left:
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return name == other
                        _:
                            return false
                _:
                    return false

        def proof_replay_control_global_constant_count(declarations: darray[Ast::Decl]&, target: sview, matches: mutable usize&, mutable_matches: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64
            for declaration in declarations |target, matches, mutable_matches, depth|:
                match declaration:
                    Ast::Decl.Const(name, _, _, is_mutable, _):
                        if name == target:
                            matches <- matches + 1
                            mutable_matches <- mutable_matches + 1 if is_mutable
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_control_global_constant_count(nested, target, matches, mutable_matches, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_control_global_constant_immutable(declarations: darray[Ast::Decl]&, target: sview) -> bool:
            matches: mutable usize = 0
            mutable_matches: mutable usize = 0
            return false if target == "" or not proof_replay_control_global_constant_count(declarations, target, &matches, &mutable_matches, 0)
            matches == 1 and mutable_matches == 0

        def proof_replay_control_immutable_boolean_parameter(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, parameter_name, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        if name == owner and position.line == owner_line:
                            matches: mutable usize = 0
                            valid: mutable bool = false
                            for parameter in parameters |parameter_name, matches, valid|:
                                if parameter.name == parameter_name:
                                    matches <- matches + 1
                                    match parameter.type_expression:
                                        Ast::Expr.Ident("bool", _):
                                            valid <- true
                                        _:
                                            valid <- false
                            return matches == 1 and valid
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_control_immutable_boolean_parameter(nested, owner, owner_line, parameter_name, depth + 1)
                    _:
                        pass
            return false

        def proof_replay_control_stable_identifier(report: ProofReport&, trace: ProofFactTrace, name: sview) -> bool:
            return false if name == ""
            if proof_replay_control_global_constant_immutable(report.source_declarations, name):
                return false if proof_replay_local_binding_parameter_name_present(report.source_declarations, trace.name, report.replay_owner_line, name, 0)
                return proof_replay_local_binding_parameter_source_unshadowed(report.source_declarations, trace.name, report.replay_owner_line, name)
            return false if not proof_replay_local_binding_parameter_source_unshadowed(report.source_declarations, trace.name, report.replay_owner_line, name)
            return proof_replay_local_binding_immutable_integer_parameter(report.source_declarations, trace.name, report.replay_owner_line, name, 0) or proof_replay_control_immutable_boolean_parameter(report.source_declarations, trace.name, report.replay_owner_line, name, 0)

        # Only source expressions whose value cannot change during the control-flow region
        # and remain source-identical after checker substitution are eligible. Calls, fields,
        # and substituted locals need a source environment/effect certificate this trace lacks.
        def proof_replay_control_stable_expression(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 64 or proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return proof_replay_control_stable_identifier(report, trace, name)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Not, inner, _) | Ast::Expr.Unary(TokenKind.Minus, inner, _):
                    return proof_replay_control_stable_expression(report, trace, inner, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                    return proof_replay_control_stable_expression(report, trace, left, depth + 1) and proof_replay_control_stable_expression(report, trace, right, depth + 1)
                _:
                    return false

        def proof_replay_control_negation(expression: Ast::Expr, position: Ast::Pos) -> Ast::Expr:
            match expression:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return inner
                Ast::Expr.BoolLit(value, _):
                    return Ast::Expr.BoolLit(not value, position)
                Ast::Expr.Binary(_, TokenKind.And, _, _):
                    return Ast::Expr.Unary(TokenKind.Not, expression, position)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, left, position), TokenKind.And, Ast::Expr.Unary(TokenKind.Not, right, position), position)
                _:
                    return Ast::Expr.Unary(TokenKind.Not, expression, position)

        def proof_replay_control_assertion_matches(statement: Ast::Stmt, certificate: ProofGoalCertificate) -> bool:
            # The source goal has to survive the checker substitution with the same tree and
            # span. A substituted local is rejected until replay can authenticate its value map.
            match statement:
                Ast::Stmt.Contract("assert", expression, position):
                    return false if position.line != certificate.line
                    return proof_replay_control_expr_source_equal(expression, certificate.goal)
                Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("assert", _), arguments, _, _), position):
                    return false if position.line != certificate.line or arguments.count != 1
                    return proof_replay_control_expr_source_equal(arguments[0], certificate.goal)
                _:
                    return false

        def proof_replay_control_assert_by_goal_matches(statement: Ast::Stmt, certificate: ProofGoalCertificate) -> bool:
            match statement:
                Ast::Stmt.Block("assert_by", _, _, body, _):
                    return false if body.count == 0
                    match body[0]:
                        Ast::Stmt.Contract(kind, expression, position):
                            # An assert-by block's first contract is its declared goal. Other
                            # contracts count only in this exact first-statement role.
                            return false if kind == "assert" or position.line != certificate.line
                            return proof_replay_control_expr_source_equal(expression, certificate.goal)
                        _:
                            return false
                _:
                    return false

        def proof_replay_control_assertion_expr_scan(expression: Ast::Expr, certificate: ProofGoalCertificate, depth: usize, work: mutable usize&, matches: mutable usize&) -> bool:
            return false if depth >= 64 or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Lambda(_, _, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _) | Ast::Expr.StaticEffectCall(callee, _, _, arguments, _, _):
                    return false if not proof_replay_control_assertion_expr_scan(callee, certificate, depth + 1, work, matches)
                    for argument in arguments |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(argument, certificate, depth + 1, work, matches)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_control_assertion_expr_scan(object, certificate, depth + 1, work, matches)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return false if not proof_replay_control_assertion_expr_scan(object, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_expr_scan(index, certificate, depth + 1, work, matches)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return false if not proof_replay_control_assertion_expr_scan(object, certificate, depth + 1, work, matches)
                    return false if not proof_replay_control_assertion_expr_scan(low, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_expr_scan(high, certificate, depth + 1, work, matches)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_control_assertion_expr_scan(object, certificate, depth + 1, work, matches)
                    for argument in arguments |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(argument, certificate, depth + 1, work, matches)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(element, certificate, depth + 1, work, matches)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(entry.key, certificate, depth + 1, work, matches)
                        return false if not proof_replay_control_assertion_expr_scan(entry.value, certificate, depth + 1, work, matches)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_control_assertion_expr_scan(base, certificate, depth + 1, work, matches)
                    for field in fields |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(field.value, certificate, depth + 1, work, matches)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return false if not proof_replay_control_assertion_expr_scan(subject, certificate, depth + 1, work, matches)
                    for arm in arms |certificate, depth, work, matches|:
                        return false if not proof_replay_control_assertion_expr_scan(arm.guard, certificate, depth + 1, work, matches)
                        return false if not proof_replay_control_assertion_scan(arm.body, certificate, depth + 1, work, matches)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return false if not proof_replay_control_assertion_expr_scan(iterable, certificate, depth + 1, work, matches)
                    return false if not proof_replay_control_assertion_expr_scan(condition, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_expr_scan(value, certificate, depth + 1, work, matches)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_control_assertion_expr_scan(guarded, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_scan(recovery, certificate, depth + 1, work, matches)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_control_assertion_scan(statements, certificate, depth + 1, work, matches)
                    return proof_replay_control_assertion_expr_scan(value, certificate, depth + 1, work, matches)
            return true

        def proof_replay_control_assertion_scan(body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, depth: usize, work: mutable usize&, matches: mutable usize&) -> bool:
            return false if depth >= 64
            for statement in body |certificate, depth, work, matches|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                matches <- matches + 1 if proof_replay_control_assertion_matches(statement, certificate) or proof_replay_control_assert_by_goal_matches(statement, certificate)
                match statement:
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _):
                        return false if not proof_replay_control_assertion_expr_scan(expression, certificate, depth + 1, work, matches)
                    Ast::Stmt.VarDecl(_, type_expression, value, _):
                        return false if not proof_replay_control_assertion_expr_scan(type_expression, certificate, depth + 1, work, matches)
                        return false if not proof_replay_control_assertion_expr_scan(value, certificate, depth + 1, work, matches)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if not proof_replay_control_assertion_expr_scan(target, certificate, depth + 1, work, matches)
                        return false if not proof_replay_control_assertion_expr_scan(value, certificate, depth + 1, work, matches)
                    Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_control_assertion_expr_scan(expression, certificate, depth + 1, work, matches)
                    Ast::Stmt.Block(_, _, _, inner, _):
                        return false if not proof_replay_control_assertion_scan(inner, certificate, depth + 1, work, matches)
                    Ast::Stmt.While(condition, inner, _) | Ast::Stmt.For(_, _, condition, inner, _):
                        return false if not proof_replay_control_assertion_expr_scan(condition, certificate, depth + 1, work, matches)
                        return false if not proof_replay_control_assertion_scan(inner, certificate, depth + 1, work, matches)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if not proof_replay_control_assertion_expr_scan(condition, certificate, depth + 1, work, matches)
                        return false if not proof_replay_control_assertion_scan(yes, certificate, depth + 1, work, matches)
                        return false if not proof_replay_control_assertion_scan(no, certificate, depth + 1, work, matches)
                    Ast::Stmt.Match(subject, arms, _):
                        return false if not proof_replay_control_assertion_expr_scan(subject, certificate, depth + 1, work, matches)
                        for arm in arms |certificate, depth, work, matches|:
                            return false if not proof_replay_control_assertion_expr_scan(arm.guard, certificate, depth + 1, work, matches)
                            return false if not proof_replay_control_assertion_scan(arm.body, certificate, depth + 1, work, matches)
                    _:
                        pass
            return true

        def proof_replay_control_certificate_attempt_index_unique(report: ProofReport&, certificate: ProofGoalCertificate, certificate_index: usize) -> bool:
            return false if certificate_index >= report.certificates.count
            return false if report.certificates[certificate_index].name != certificate.name or report.certificates[certificate_index].line != certificate.line
            return false if certificate.source_phase != "" and certificate.source_phase != "loop-invariant-entry" and certificate.source_phase != "loop-invariant-preservation"
            return false if report.goal_attempts.count > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            matches: mutable usize = 0
            for attempt in report.goal_attempts |report, certificate, certificate_index, matches|:
                matches <- matches + 1 if proof_replay_attempt_matches_certificate(report, attempt, certificate, certificate_index)
            matches == 1

        def proof_replay_control_certificate_attempt_unique(report: ProofReport&, certificate: ProofGoalCertificate) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate_index: usize = report.trace_consumer_certificate_index - 1
            return proof_replay_control_certificate_attempt_index_unique(report, certificate, certificate_index)

        def proof_replay_control_assertion_in_scope(report: ProofReport&, whole_body: darray[Ast::Stmt]&, scope_body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate) -> bool:
            return false if certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
            return false if not proof_replay_control_certificate_attempt_unique(report, certificate)
            whole_matches: mutable usize = 0
            whole_work: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(whole_body, certificate, 0, &whole_work, &whole_matches) or whole_matches != 1
            scope_matches: mutable usize = 0
            scope_work: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(scope_body, certificate, 0, &scope_work, &scope_matches)
            return scope_matches == 1

        def proof_replay_control_assertion_unique_in_owner(report: ProofReport&, body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, work: mutable usize&) -> bool:
            return false if certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
            return false if not proof_replay_control_certificate_attempt_unique(report, certificate)
            matches: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(body, certificate, 0, &work, &matches)
            matches == 1
        # Compare AST statement order in the loop's lexical parent. A larger line or byte offset
        # alone cannot distinguish a same-line assertion in the loop body from one after it.
        def proof_replay_control_assertion_after_loop(report: ProofReport&, whole_body: darray[Ast::Stmt]&, lexical_body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, loop_line: u32) -> bool:
            return false if not proof_replay_control_assertion_in_scope(report, whole_body, whole_body, certificate)
            loop_matches: mutable usize = 0
            loop_index: mutable usize = lexical_body.count
            for index in 0..<lexical_body.count |index, lexical_body, loop_line, loop_matches, loop_index|:
                match lexical_body[index]:
                    Ast::Stmt.While(_, _, position) | Ast::Stmt.For(_, _, _, _, position):
                        if position.line == loop_line:
                            loop_matches <- loop_matches + 1
                            loop_index <- index
                    _:
                        pass
            return false if loop_matches != 1
            assertion_matches: mutable usize = 0
            assertion_index: mutable usize = lexical_body.count
            work: mutable usize = 0
            for index in 0..<lexical_body.count |index, lexical_body, certificate, assertion_matches, assertion_index, work|:
                single_statement: mutable darray[Ast::Stmt] = [lexical_body[index]]
                local_matches: mutable usize = 0
                return false if not proof_replay_control_assertion_scan(single_statement, certificate, 0, &work, &local_matches)
                if local_matches > 0:
                    assertion_matches <- assertion_matches + local_matches
                    assertion_index <- index
            assertion_matches == 1 and assertion_index > loop_index

        def proof_replay_control_body_has_break(body: darray[Ast::Stmt]&, depth: usize, work: mutable usize&) -> bool:
            return true if depth >= 64
            for statement in body |depth, work|:
                return true if work >= 4096
                work <- work + 1
                match statement:
                    Ast::Stmt.Break(_, _):
                        return true
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.VarDecl(_, _, expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return true if proof_replay_control_expr_has_break(expression, depth + 1, work)
                    Ast::Stmt.Assign(target, _, value, _):
                        return true if proof_replay_control_expr_has_break(target, depth + 1, work) or proof_replay_control_expr_has_break(value, depth + 1, work)
                    Ast::Stmt.Block(kind, _, _, inner, _):
                        return true if kind != "assert_by" and proof_replay_control_body_has_break(inner, depth + 1, work)
                    Ast::Stmt.While(condition, inner, _) | Ast::Stmt.For(_, _, condition, inner, _):
                        return true if proof_replay_control_expr_has_break(condition, depth + 1, work) or proof_replay_control_body_has_break(inner, depth + 1, work)
                    Ast::Stmt.If(condition, yes, no, _):
                        return true if proof_replay_control_expr_has_break(condition, depth + 1, work) or proof_replay_control_body_has_break(yes, depth + 1, work) or proof_replay_control_body_has_break(no, depth + 1, work)
                    Ast::Stmt.Match(subject, arms, _):
                        return true if proof_replay_control_expr_has_break(subject, depth + 1, work)
                        for arm in arms |depth, work|:
                            return true if proof_replay_control_expr_has_break(arm.guard, depth + 1, work) or proof_replay_control_body_has_break(arm.body, depth + 1, work)
                    _:
                        return true
            return false

        def proof_replay_control_expr_has_break(expression: Ast::Expr, depth: usize, work: mutable usize&) -> bool:
            return true if depth >= 64 or work >= 4096
            work <- work + 1
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Call(callee, arguments, _, _) | Ast::Expr.StaticEffectCall(callee, _, _, arguments, _, _):
                    return true if proof_replay_control_expr_has_break(callee, depth + 1, work)
                    for argument in arguments |depth, work|:
                        return true if proof_replay_control_expr_has_break(argument, depth + 1, work)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_control_expr_has_break(object, depth + 1, work)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return proof_replay_control_expr_has_break(object, depth + 1, work) or proof_replay_control_expr_has_break(index, depth + 1, work)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return proof_replay_control_expr_has_break(object, depth + 1, work) or proof_replay_control_expr_has_break(low, depth + 1, work) or proof_replay_control_expr_has_break(high, depth + 1, work)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_replay_control_expr_has_break(object, depth + 1, work)
                    for argument in arguments |depth, work|:
                        return true if proof_replay_control_expr_has_break(argument, depth + 1, work)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |depth, work|:
                        return true if proof_replay_control_expr_has_break(element, depth + 1, work)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, work|:
                        return true if proof_replay_control_expr_has_break(entry.key, depth + 1, work) or proof_replay_control_expr_has_break(entry.value, depth + 1, work)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_replay_control_expr_has_break(base, depth + 1, work)
                    for field in fields |depth, work|:
                        return true if proof_replay_control_expr_has_break(field.value, depth + 1, work)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return true if proof_replay_control_expr_has_break(subject, depth + 1, work)
                    for arm in arms |depth, work|:
                        return true if proof_replay_control_expr_has_break(arm.guard, depth + 1, work) or proof_replay_control_body_has_break(arm.body, depth + 1, work)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return proof_replay_control_expr_has_break(iterable, depth + 1, work) or proof_replay_control_expr_has_break(condition, depth + 1, work) or proof_replay_control_expr_has_break(value, depth + 1, work)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return true if proof_replay_control_expr_has_break(guarded, depth + 1, work)
                    return proof_replay_control_body_has_break(recovery, depth + 1, work)
                Ast::Expr.Lambda(_, _, _):
                    return false
                Ast::Expr.Block(statements, value, _, _):
                    return proof_replay_control_body_has_break(statements, depth + 1, work) or proof_replay_control_expr_has_break(value, depth + 1, work)
            return true

        def proof_replay_control_if_facts(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, matches: mutable usize&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64
            for statement in body |report, trace, certificate, body, matches, depth, work|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                match statement:
                    Ast::Stmt.If(condition, yes, no, position):
                        if position.line == trace.line and proof_replay_control_stable_expression(report, trace, condition, 0):
                            yes_matches: mutable usize = 0
                            if proof_replay_control_expr_source_equal(trace.expression, condition) and proof_replay_control_assertion_scan(yes, certificate, 0, &work, &yes_matches) and yes_matches == 1:
                                matches <- matches + 1
                            no_matches: mutable usize = 0
                            negated: Ast::Expr = proof_replay_control_negation(condition, position)
                            if proof_replay_expr_equal(trace.expression, negated) and proof_replay_control_assertion_scan(no, certificate, 0, &work, &no_matches) and no_matches == 1:
                                matches <- matches + 1
                        return false if not proof_replay_control_if_facts(report, trace, certificate, yes, matches, depth + 1, work)
                        return false if not proof_replay_control_if_facts(report, trace, certificate, no, matches, depth + 1, work)
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        return false if not proof_replay_control_if_facts(report, trace, certificate, inner, matches, depth + 1, work)
                    Ast::Stmt.Block(_, _, _, inner, _):
                        return false if not proof_replay_control_if_facts(report, trace, certificate, inner, matches, depth + 1, work)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |report, trace, certificate, matches, depth, work|:
                            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            work <- work + 1
                            return false if not proof_replay_control_if_facts(report, trace, certificate, arm.body, matches, depth + 1, work)
                    _:
                        pass
            return true

        # Bound recursive pattern walks before calling the producer's canonical lowering.
        # Unsupported shapes still fail in `proof_match_closed_pattern`; this preflight only
        # prevents a deeply nested or unusually large source pattern from exhausting replay.
        def proof_replay_control_pattern_within_budget(pattern: Ast::Pattern, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64 or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.As(_, inner) | Ast::Pattern.Field(_, inner):
                    for child in inner |depth, work|:
                        return false if not proof_replay_control_pattern_within_budget(child, depth + 1, work)
                Ast::Pattern.Or(options) | Ast::Pattern.Tuple(options) | Ast::Pattern.Variant(_, options) | Ast::Pattern.Struct(_, options):
                    for child in options |depth, work|:
                        return false if not proof_replay_control_pattern_within_budget(child, depth + 1, work)
                _:
                    pass
            return true

        def proof_replay_control_pattern_condition(report: ProofReport&, trace: ProofFactTrace, pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, work: mutable usize&) -> Ast::Expr?:
            return null if not proof_replay_control_pattern_within_budget(pattern, 0, work)
            return null if not proof_match_closed_pattern(pattern) or not proof_replay_control_stable_expression(report, trace, scrutinee, 0)
            names: mutable darray[sview] = []
            values: mutable darray[Ast::Expr] = []
            return null if not proof_bind_pattern(pattern, position, scrutinee, &names, &values)
            condition: Ast::Expr? = proof_pattern_condition(pattern, scrutinee, position)
            if condition is expression:
                # Pattern equality must resolve to the primitive relation that the checker
                # lowered; custom literal comparisons cannot enter through a user operator.
                return null if proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
                return expression
            return null

        def proof_replay_control_match_guard_keeps_facts(report: ProofReport&, guard: Ast::Expr) -> bool:
            return true if guard is Ast::Expr.Absent
            return false if not proof_expr_supported(guard) or proof_expr_has_call(guard) or proof_expr_has_move(guard)
            return false if proof_source_expression_has_overloaded_operator(guard, report.source_primitive_operator_mask, 0)
            true

        def proof_replay_control_match_arm_fact(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], match_position: Ast::Pos, stop_refutations_after_nonretaining_prior: bool, matches: mutable usize&, work: mutable usize&) -> bool:
            return true if match_position.line != trace.line
            for arm_index in 0..<arms.count |arm_index, report, trace, certificate, scrutinee, arms, match_position, stop_refutations_after_nonretaining_prior, matches, work|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                arm: Ast::MatchArm = arms[arm_index]
                guard_absent: bool = arm.guard is Ast::Expr.Absent
                guard_keeps_facts: bool = proof_replay_control_match_guard_keeps_facts(report, arm.guard)
                current_condition: Ast::Expr? = proof_replay_control_pattern_condition(report, trace, arm.pattern, scrutinee, match_position, work) if guard_keeps_facts
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                if current_condition is expression and proof_replay_control_expr_source_equal(trace.expression, expression):
                    scope_matches: mutable usize = 0
                    return false if not proof_replay_control_assertion_scan(arm.body, certificate, 0, &work, &scope_matches)
                    matches <- matches + 1 if scope_matches == 1
                # Earlier unguarded patterns refute later arms only while intervening guards
                # leave the match fact state intact.
                refutations_available: bool = guard_keeps_facts
                if refutations_available and stop_refutations_after_nonretaining_prior:
                    for prior_index in 0..<arm_index |prior_index, report, trace, certificate, arms, matches, refutations_available, work|:
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        work <- work + 1
                        prior_guard: Ast::Expr = arms[prior_index].guard
                        if not proof_replay_control_match_guard_keeps_facts(report, prior_guard):
                            refutations_available <- false
                            break
                if refutations_available:
                    for prior_index in 0..<arm_index |prior_index, report, trace, certificate, scrutinee, arms, match_position, arm, matches, work|:
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        work <- work + 1
                        prior: Ast::MatchArm = arms[prior_index]
                        continue if not (prior.guard is Ast::Expr.Absent)
                        prior_condition: Ast::Expr? = proof_replay_control_pattern_condition(report, trace, prior.pattern, scrutinee, match_position, work)
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        continue if prior_condition is no_condition
                        continue if not proof_pattern_condition_exact(prior.pattern)
                        rejected: Ast::Expr = Ast::Expr.Unary(TokenKind.Not, no_condition, match_position)
                        if proof_replay_expr_equal(trace.expression, rejected):
                            scope_matches: mutable usize = 0
                            return false if not proof_replay_control_assertion_scan(arm.body, certificate, 0, &work, &scope_matches)
                            matches <- matches + 1 if scope_matches == 1
                if not guard_absent and guard_keeps_facts and proof_replay_control_stable_expression(report, trace, arm.guard, 0):
                    if proof_replay_control_expr_source_equal(trace.expression, arm.guard):
                        scope_matches: mutable usize = 0
                        return false if not proof_replay_control_assertion_scan(arm.body, certificate, 0, &work, &scope_matches)
                        matches <- matches + 1 if scope_matches == 1
            return true

        def proof_replay_control_match_expr_facts(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, expression: Ast::Expr, matches: mutable usize&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64 or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Lambda(_, _, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _) | Ast::Expr.StaticEffectCall(callee, _, _, arguments, _, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, callee, matches, depth + 1, work)
                    for argument in arguments |report, trace, certificate, depth, work, matches|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, argument, matches, depth + 1, work)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_control_match_expr_facts(report, trace, certificate, object, matches, depth + 1, work)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, object, matches, depth + 1, work)
                    return proof_replay_control_match_expr_facts(report, trace, certificate, index, matches, depth + 1, work)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, object, matches, depth + 1, work)
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, low, matches, depth + 1, work)
                    return proof_replay_control_match_expr_facts(report, trace, certificate, high, matches, depth + 1, work)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, object, matches, depth + 1, work)
                    for argument in arguments |report, trace, certificate, depth, work, matches|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, argument, matches, depth + 1, work)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |report, trace, certificate, depth, work, matches|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, element, matches, depth + 1, work)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |report, trace, certificate, depth, work, matches|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, entry.key, matches, depth + 1, work)
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, entry.value, matches, depth + 1, work)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, base, matches, depth + 1, work)
                    for field in fields |report, trace, certificate, depth, work, matches|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, field.value, matches, depth + 1, work)
                Ast::Expr.Match(subject, arms, position):
                    return false if not proof_replay_control_match_arm_fact(report, trace, certificate, subject, arms, position, true, matches, work)
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, subject, matches, depth + 1, work)
                    for arm in arms |report, trace, certificate, depth, work, matches|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, arm.guard, matches, depth + 1, work)
                        return false if not proof_replay_control_match_facts(report, trace, certificate, arm.body, matches, depth + 1, work)
                Ast::Expr.Catch(subject, arms, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, subject, matches, depth + 1, work)
                    for arm in arms |report, trace, certificate, depth, work, matches|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, arm.guard, matches, depth + 1, work)
                        return false if not proof_replay_control_match_facts(report, trace, certificate, arm.body, matches, depth + 1, work)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, iterable, matches, depth + 1, work)
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, condition, matches, depth + 1, work)
                    return proof_replay_control_match_expr_facts(report, trace, certificate, value, matches, depth + 1, work)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, guarded, matches, depth + 1, work)
                    return proof_replay_control_match_facts(report, trace, certificate, recovery, matches, depth + 1, work)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_control_match_facts(report, trace, certificate, statements, matches, depth + 1, work)
                    return proof_replay_control_match_expr_facts(report, trace, certificate, value, matches, depth + 1, work)
            return true

        def proof_replay_control_match_facts(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, matches: mutable usize&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64
            for statement in body |report, trace, certificate, body, matches, depth, work|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                match statement:
                    Ast::Stmt.Match(scrutinee, arms, position):
                        return false if not proof_replay_control_match_arm_fact(report, trace, certificate, scrutinee, arms, position, true, matches, work)
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, scrutinee, matches, depth + 1, work)
                        for arm in arms |report, trace, certificate, matches, depth, work|:
                            return false if not proof_replay_control_match_expr_facts(report, trace, certificate, arm.guard, matches, depth + 1, work)
                            return false if not proof_replay_control_match_facts(report, trace, certificate, arm.body, matches, depth + 1, work)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, condition, matches, depth + 1, work)
                        return false if not proof_replay_control_match_facts(report, trace, certificate, yes, matches, depth + 1, work)
                        return false if not proof_replay_control_match_facts(report, trace, certificate, no, matches, depth + 1, work)
                    Ast::Stmt.While(condition, inner, _):
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, condition, matches, depth + 1, work)
                        return false if not proof_replay_control_match_facts(report, trace, certificate, inner, matches, depth + 1, work)
                    Ast::Stmt.For(_, _, iterable, inner, _):
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, iterable, matches, depth + 1, work)
                        return false if not proof_replay_control_match_facts(report, trace, certificate, inner, matches, depth + 1, work)
                    Ast::Stmt.Block(_, _, _, inner, _):
                        return false if not proof_replay_control_match_facts(report, trace, certificate, inner, matches, depth + 1, work)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.VarDecl(_, _, expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, expression, matches, depth + 1, work)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, target, matches, depth + 1, work)
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, value, matches, depth + 1, work)
                    _:
                        pass
            return true

        def proof_replay_control_branch_fact_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count or trace.name == "" or trace.line == 0 or report.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body(report, trace.name, report.replay_owner_line, &body)
            matches: mutable usize = 0
            work: mutable usize = 0
            return false if not proof_replay_control_assertion_unique_in_owner(report, body, certificate, &work)
            return false if not proof_replay_control_if_facts(report, trace, certificate, body, &matches, 0, &work)
            return false if not proof_replay_control_match_facts(report, trace, certificate, body, &matches, 0, &work)
            matches == 1

        def proof_replay_control_find_while(body: darray[Ast::Stmt]&, line: u32, condition: mutable Ast::Expr&, loop_body: mutable darray[Ast::Stmt]&, loop_position: mutable Ast::Pos&, matches: mutable usize&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64
            for statement in body |line, condition, loop_body, loop_position, matches, depth, work|:
                return false if work >= 4096
                work <- work + 1
                match statement:
                    Ast::Stmt.While(source_condition, inner, position):
                        if position.line == line:
                            matches <- matches + 1
                            condition <- source_condition
                            loop_body.clear()
                            loop_body.extend(inner)
                            loop_position <- position
                        return false if not proof_replay_control_find_while(inner, line, condition, loop_body, loop_position, matches, depth + 1, work)
                    Ast::Stmt.For(_, _, _, inner, _) | Ast::Stmt.Block(_, _, _, inner, _):
                        return false if not proof_replay_control_find_while(inner, line, condition, loop_body, loop_position, matches, depth + 1, work)
                    Ast::Stmt.If(_, yes, no, _):
                        return false if not proof_replay_control_find_while(yes, line, condition, loop_body, loop_position, matches, depth + 1, work)
                        return false if not proof_replay_control_find_while(no, line, condition, loop_body, loop_position, matches, depth + 1, work)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |line, condition, loop_body, loop_position, matches, depth, work|:
                            return false if not proof_replay_control_find_while(arm.body, line, condition, loop_body, loop_position, matches, depth + 1, work)
                    _:
                        pass
            return true

        def proof_replay_control_loop_invariant_context(report: ProofReport&, trace: ProofFactTrace, whole_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt], lexical_body: darray[Ast::Stmt]) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name
            return false if not proof_replay_control_assertion_in_scope(report, whole_body, whole_body, certificate)
            return true if proof_replay_control_assertion_in_scope(report, whole_body, loop_body, certificate)
            no_break_work: mutable usize = 0
            return false if proof_replay_control_body_has_break(loop_body, 0, &no_break_work)
            proof_replay_control_assertion_after_loop(report, whole_body, lexical_body, certificate, trace.line)

        def proof_replay_control_certificate_has_invariant(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate) -> bool:
            return false if certificate.facts_start > report.traces.origin_indices.count or certificate.facts_count > report.traces.origin_indices.count - certificate.facts_start
            for index in 0..<certificate.facts_count |index, report, trace, certificate|:
                origin: usize = report.traces.origin_indices[certificate.facts_start + index]
                continue if origin >= report.traces.records.count
                candidate: ProofFactTrace = report.traces.records[origin]
                return true if candidate.kind == "loop-invariant" and candidate.name == trace.name and candidate.line == trace.line and proof_replay_control_expr_source_equal(candidate.expression, trace.expression)
            return false

        # The body-entry condition/range facts are consumed by the loop's preservation
        # obligation itself. That obligation is anchored to the exact source invariant and
        # carries the matching invariant hypothesis; ordinary consumers still need an assert.
        def proof_replay_control_preservation_contract_source(report: ProofReport&, trace: ProofFactTrace, loop_body: darray[Ast::Stmt]) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.source_phase != "loop-invariant-preservation" or certificate.name != trace.name or certificate.line != trace.line
            return false if certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
            return false if not proof_replay_control_certificate_attempt_unique(report, certificate)
            matches: mutable usize = 0
            for statement in loop_body |report, trace, certificate, matches|:
                match statement:
                    Ast::Stmt.Contract("invariant", invariant, _):
                        if proof_replay_control_expr_source_equal(invariant, certificate.goal) and proof_replay_control_stable_expression(report, trace, invariant, 0):
                            invariant_trace: ProofFactTrace = ProofFactTrace{expression: invariant, kernel_expression: trace.kernel_expression, kind: "loop-invariant", line: trace.line, name: trace.name, dependency: "", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 0}
                            if proof_replay_control_certificate_has_invariant(report, invariant_trace, certificate):
                                matches <- matches + 1
                    _:
                        pass
            matches == 1

        # A preservation certificate may consume its exact invariant as an induction hypothesis,
        # but only after the corresponding entry certificate is independently replayed.
        def proof_replay_control_loop_invariant_induction_premise(report: mutable ProofReport&, trace: ProofFactTrace, source_invariant: Ast::Expr, lexical_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt]) -> bool can[Global.Read, Global.Write]:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.source_phase != "loop-invariant-preservation" or certificate.name != trace.name or certificate.line != trace.line
            return false if not proof_replay_control_expr_source_equal(certificate.goal, source_invariant)
            return false if not proof_replay_control_certificate_has_invariant(report, trace, certificate)
            entry_matches: mutable usize = 0
            entry_index: mutable usize = report.certificates.count
            for index in 0..<report.certificates.count |report, trace, lexical_body, loop_body, index, entry_matches, entry_index|:
                candidate: ProofGoalCertificate = report.certificates[index]
                if candidate.source_phase == "loop-invariant-entry" and proof_replay_control_loop_entry_certificate(report, trace, candidate, index, lexical_body, loop_body):
                    entry_matches <- entry_matches + 1
                    entry_index <- index
            return false if entry_matches != 1
            workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            entry: ProofGoalCertificate = report.certificates[entry_index]
            return (proof_replay_certificate(report, entry, entry_index, workspace) can Global{Read,Write})

        def proof_replay_control_loop_invariant_source(report: mutable ProofReport&, trace: ProofFactTrace) -> bool can[Global.Read, Global.Write]:
            return false if trace.name == "" or trace.line == 0 or report.replay_owner_line == 0 or report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body(report, trace.name, report.replay_owner_line, &body)
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            loop_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_loop_scope(body, trace.line, &condition, &loop_body, &lexical_body)
            invariant_matches: mutable usize = 0
            source_invariant: mutable Ast::Expr = Ast::Expr.Invalid
            for statement in loop_body |report, trace, invariant_matches, source_invariant|:
                match statement:
                    Ast::Stmt.Contract("invariant", expression, _):
                        if proof_replay_control_expr_source_equal(expression, trace.expression) and proof_replay_control_stable_expression(report, trace, expression, 0):
                            invariant_matches <- invariant_matches + 1
                            source_invariant <- expression
                    _:
                        pass
            return false if invariant_matches != 1
            # During replay of the preservation certificate, this exact contract is the
            # induction hypothesis. The outer admission path still has to replay entry and
            # preservation independently before using it anywhere else.
            if proof_replay_control_loop_invariant_induction_premise(report, trace, source_invariant, lexical_body, loop_body) can Global{Read,Write}:
                return true
            return false if not proof_replay_control_loop_invariant_context(report, trace, body, loop_body, lexical_body)
            entry_matches: mutable usize = 0
            preservation_matches: mutable usize = 0
            entry_certificates: darray[usize] = []
            preservation_certificates: darray[usize] = []
            for index in 0..<report.certificates.count |report, trace, source_invariant, index, entry_matches, preservation_matches, entry_certificates, preservation_certificates|:
                candidate: ProofGoalCertificate = report.certificates[index]
                continue if candidate.name != trace.name or candidate.line != trace.line
                if candidate.source_phase == "loop-invariant-entry" and proof_replay_control_loop_entry_certificate(report, trace, candidate, index, lexical_body, loop_body):
                    entry_matches <- entry_matches + 1
                    entry_certificates.push(index)
                if candidate.source_phase == "loop-invariant-preservation" and proof_replay_control_certificate_attempt_index_unique(report, candidate, index) and proof_replay_control_expr_source_equal(candidate.goal, source_invariant) and proof_replay_control_certificate_has_invariant(report, trace, candidate):
                    preservation_matches <- preservation_matches + 1
                    preservation_certificates.push(index)
            return false if entry_matches != 1 or preservation_matches != 1 or entry_certificates[0] == preservation_certificates[0]
            workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            entry: ProofGoalCertificate = report.certificates[entry_certificates[0]]
            preserved: ProofGoalCertificate = report.certificates[preservation_certificates[0]]
            return false if not (proof_replay_certificate(report, entry, entry_certificates[0], workspace) can Global{Read,Write})
            return (proof_replay_certificate(report, preserved, preservation_certificates[0], workspace) can Global{Read,Write})

        def proof_replay_control_loop_entry_certificate(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, certificate_index: usize, lexical_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt]) -> bool:
            return false if certificate.source_phase != "loop-invariant-entry"
            return false if not proof_replay_control_certificate_attempt_index_unique(report, certificate, certificate_index)
            return false if certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
            return false if certificate.name != trace.name or certificate.line != trace.line
            return false if certificate.facts_start > report.traces.origin_indices.count or certificate.facts_count > report.traces.origin_indices.count - certificate.facts_start
            for index in 0..<certificate.facts_count |index, report, certificate|:
                origin: usize = report.traces.origin_indices[certificate.facts_start + index]
                continue if origin >= report.traces.records.count
                candidate: ProofFactTrace = report.traces.records[origin]
                # A range trace is serialized in the producer's for-loop entry context but
                # remains untrusted here; the range validator will omit it from entry replay.
                # Condition and invariant traces can describe loop-body state and stay barred.
                return false if candidate.line == certificate.line and (candidate.kind == "loop-condition" or candidate.kind == "loop-invariant")
            for statement in loop_body |report, trace, certificate, lexical_body|:
                match statement:
                    Ast::Stmt.Contract("invariant", invariant, _):
                        return true if proof_replay_control_expr_source_equal(invariant, trace.expression) and proof_replay_summary_call_argument_equal(report, trace, invariant, certificate.goal, 0) and proof_replay_control_expr_source_equal(invariant, certificate.goal)
                        return true if proof_replay_control_expr_source_equal(invariant, trace.expression) and proof_replay_loop_entry_expanded_goal(report, trace, certificate, lexical_body, invariant)
                    _:
                        pass
            return false

        def proof_replay_control_loop_condition_source(report: mutable ProofReport&, trace: ProofFactTrace) -> bool can[Global.Read, Global.Write]:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count or trace.name == "" or trace.line == 0 or report.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body(report, trace.name, report.replay_owner_line, &body)
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            loop_body: mutable darray[Ast::Stmt] = []
            loop_position: mutable Ast::Pos = Ast::pos_at_line(0)
            loop_matches: mutable usize = 0
            work: mutable usize = 0
            return false if not proof_replay_control_find_while(body, trace.line, &condition, &loop_body, &loop_position, &loop_matches, 0, &work) or loop_matches != 1
            return false if not proof_replay_control_stable_expression(report, trace, condition, 0)
            if proof_replay_control_expr_source_equal(trace.expression, condition):
                # The exact assertion AST is inside the loop body, which places its
                # evaluation after the test even when the whole construct is on one line.
                return proof_replay_control_assertion_in_scope(report, body, loop_body, certificate) or proof_replay_control_preservation_contract_source(report, trace, loop_body)
            expected_exit: Ast::Expr = proof_replay_control_negation(condition, loop_position)
            return false if not proof_replay_expr_equal(trace.expression, expected_exit)
            scoped_condition: mutable Ast::Expr = Ast::Expr.Invalid
            scoped_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_loop_scope(body, trace.line, &scoped_condition, &scoped_body, &lexical_body)
            return false if not proof_replay_control_expr_source_equal(scoped_condition, condition)
            return false if not proof_replay_control_assertion_after_loop(report, body, lexical_body, certificate, trace.line)
            break_work: mutable usize = 0
            return false if proof_replay_control_body_has_break(loop_body, 0, &break_work)
            return proof_replay_control_loop_has_certified_invariant(report, trace, body, loop_body)

        def proof_replay_control_loop_has_certified_invariant(report: mutable ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt]) -> bool can[Global.Read, Global.Write]:
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            source_loop_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_loop_scope(body, trace.line, &condition, &source_loop_body, &lexical_body)
            invariants: mutable darray[Ast::Expr] = []
            for statement in source_loop_body |invariants|:
                match statement:
                    Ast::Stmt.Contract("invariant", expression, _):
                        invariants.push(expression)
                    _:
                        pass
            return false if invariants.count == 0
            for invariant in invariants |report, trace, source_loop_body, invariant|:
                invariant_trace: ProofFactTrace = ProofFactTrace{expression: invariant, kernel_expression: trace.kernel_expression, kind: "loop-invariant", line: trace.line, name: trace.name, dependency: "", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 0}
                return false if not (proof_replay_control_loop_invariant_source(report, invariant_trace) can Global{Read,Write})
            return true

        def proof_replay_control_loop_range_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count or trace.name == "" or trace.line == 0 or report.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body(report, trace.name, report.replay_owner_line, &body)
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            loop_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_loop_scope(body, trace.line, &condition, &loop_body, &lexical_body)
            return false if not (proof_replay_control_assertion_in_scope(report, body, loop_body, certificate) or proof_replay_control_preservation_contract_source(report, trace, loop_body))
            for statement in lexical_body |report, trace, certificate, loop_body|:
                match statement:
                    Ast::Stmt.For(_, variables, iterable, inner, position):
                        continue if position.line != trace.line or variables.count != 1 or variables[0] == ""
                        return false if proof_expr_has_call(iterable) or proof_source_expression_has_overloaded_operator(iterable, report.source_primitive_operator_mask, 0)
                        binder_parts: mutable darray[Ast::Expr] = []
                        binder_parts.push(Ast::Expr.Ident(variables[0], position))
                        binder_parts.push(Ast::Expr.IntLit(position.offset.i64(), position))
                        binder: Ast::Expr = Ast::Expr.Tuple(binder_parts, position)
                        base: mutable Ast::Expr = iterable
                        while true:
                            match base:
                                Ast::Expr.Refinement(source, _, _) | Ast::Expr.Paren(source, _):
                                    base <- source
                                _:
                                    break
                        match base:
                            Ast::Expr.Binary(low, operator, high, range_position):
                                return false if operator != TokenKind.RangeLt and operator != TokenKind.RangeLe
                                return false if not proof_replay_control_stable_expression(report, trace, low, 0) or not proof_replay_control_stable_expression(report, trace, high, 0)
                                lower: Ast::Expr = Ast::Expr.Binary(low, TokenKind.LtEq, binder, range_position)
                                upper_operator: TokenKind = TokenKind.Lt if operator == TokenKind.RangeLt else TokenKind.LtEq
                                upper: Ast::Expr = Ast::Expr.Binary(binder, upper_operator, high, range_position)
                                return (proof_replay_expr_equal(trace.expression, lower) and proof_replay_control_expr_position_equal(trace.expression, lower)) or (proof_replay_expr_equal(trace.expression, upper) and proof_replay_control_expr_position_equal(trace.expression, upper))
                            _:
                                return false
                    _:
                        pass
            return false

        def proof_replay_control_loop_fact_source(report: mutable ProofReport&, trace: ProofFactTrace) -> bool can[Global.Read, Global.Write]:
            if trace.kind == "loop-condition":
                return (proof_replay_control_loop_condition_source(report, trace) can Global{Read,Write})
            if trace.kind == "loop-invariant":
                return (proof_replay_control_loop_invariant_source(report, trace) can Global{Read,Write})
            if trace.kind == "loop-range":
                return proof_replay_control_loop_range_source(report, trace)
            return false
