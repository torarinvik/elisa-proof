# Owner-aware generic-name checks for threaded-call type audits.
extend ElisaProof:
    private:
        const PROOF_REPLAY_THREADED_TYPE_DEPTH_LIMIT: usize = 96

        # A type identifier is generic only in the declaration that owns the matching source
        # row. File-wide aliases must not turn `T` in `darray[T]` into an unrelated concrete type.
        def proof_replay_thread_type_name_is_owner_generic_with_work(name: sview, declaration_line: u32, owner_offset: usize, owner_offset_valid: bool, report: mutable ProofReport&, source_work: mutable usize&) -> bool:
            lookup: (complete: bool, count: usize) = proof_replay_source_generic_param_owner_name_count_with_work(name, declaration_line, owner_offset, owner_offset_valid, report, source_work)
            return true if not lookup.complete
            return lookup.count > 0

        # Fail closed on an owner-scoped generic anywhere in a type, including collection element
        # arguments. Unsupported shapes and exhausted work are unknown, never concrete evidence.
        def proof_replay_thread_type_mentions_owner_generic_with_work(expression: Ast::Expr, declaration_line: u32, owner_offset: usize, owner_offset_valid: bool, report: mutable ProofReport&, source_work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_REPLAY_THREADED_TYPE_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return true
            source_work <- source_work + 1
            match expression:
                Ast::Expr.Absent:
                    return true
                Ast::Expr.Ident(name, _):
                    return proof_replay_thread_type_name_is_owner_generic_with_work(name, declaration_line, owner_offset, owner_offset_valid, report, source_work)
                Ast::Expr.Scope(base, name, _):
                    return true if proof_replay_thread_type_name_is_owner_generic_with_work(name, declaration_line, owner_offset, owner_offset_valid, report, source_work)
                    return proof_replay_thread_type_mentions_owner_generic_with_work(base, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_thread_type_mentions_owner_generic_with_work(inner, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return true if proof_replay_thread_type_mentions_owner_generic_with_work(base, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                    return proof_replay_thread_type_mentions_owner_generic_with_work(predicate, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                Ast::Expr.Index(head, argument, _) | Ast::Expr.Binary(head, _, argument, _):
                    return true if proof_replay_thread_type_mentions_owner_generic_with_work(head, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                    return proof_replay_thread_type_mentions_owner_generic_with_work(argument, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                Ast::Expr.IndexN(head, arguments, _):
                    return true if proof_replay_thread_type_mentions_owner_generic_with_work(head, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or arguments.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return true
                    source_work <- source_work + arguments.count
                    for argument in arguments |argument, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth|:
                        return true if proof_replay_thread_type_mentions_owner_generic_with_work(argument, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _) | Ast::Expr.Array(elements, _) | Ast::Expr.SetLit(elements, _):
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or elements.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return true
                    source_work <- source_work + elements.count
                    for element in elements |element, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth|:
                        return true if proof_replay_thread_type_mentions_owner_generic_with_work(element, declaration_line, owner_offset, owner_offset_valid, report, source_work, depth + 1)
                    return false
                _:
                    return true
