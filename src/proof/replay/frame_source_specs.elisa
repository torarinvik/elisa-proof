extend ElisaProofFrameSource:
    public:
        # Bind a non-propositional spec root to one exact header/body clause.
        # Source identity and semantic admission belong to the outer boundary.
        def spec_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, kind: sview, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (spec_replays_with_work(declarations, name, line, kind, position, tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def spec_replays_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, kind: sview, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                facts.count != 0 or (kind != "changes" and kind != "preserves")
                not replay_work_charge(nodes.count, work)
                not replay_work_charge(children.count, work)
                not (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(nodes, children) can Global{Read,Write})
                not (frame_policy_replays_after_arena_with_work(nodes, children, root, work) can Global{Read,Write})
            return (spec_replays_after_arena_with_work(declarations, name, line, 0, false, kind, position, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})

    private:
        def spec_replays_after_arena_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, owner_offset: u32, exact_owner: bool, kind: sview, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            node = nodes[root]
            return false if:
                not replay_work_charge(sview_len(name), work)
                not replay_work_charge(sview_len(node.name), work)
                node.operator != "spec" or node.name != name
            policy = source_policy_at_offset_with_work(declarations, name, line, owner_offset, tokens, source, source_length, work) if exact_owner else source_policy_with_work(declarations, name, line, tokens, source, source_length, work)
            return false if not policy.known or policy.parameter_count != node.auxiliary
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return false if not certified.known
            matches: mutable usize = 0
            return false if not replay_work_charge(policy.clauses.count, work)
            for clause in policy.clauses |matches, kind, position, certified, declarations, name, line, work|:
                return false if not replay_work_charge(sview_len(clause.kind), work)
                if clause.kind == kind and same_position(clause.position, position):
                    return false if:
                        not replay_work_charge(sview_len(clause.place.field), work)
                        not replay_work_charge(sview_len(clause.place.field2), work)
                        not replay_work_charge(sview_len(clause.place.field3), work)
                        not replay_work_charge(sview_len(certified.place.field), work)
                        not replay_work_charge(sview_len(certified.place.field2), work)
                        not replay_work_charge(sview_len(certified.place.field3), work)
                        matches != 0 or not same_place(clause.place, certified.place) or not (place_typed_at_offset_with_work(declarations, name, line, owner_offset, clause.place, work) if exact_owner else place_typed_with_work(declarations, name, line, clause.place, work))
                    matches <- matches + 1
            return matches == 1
