extend ElisaProofFrameSource:
    public:
        # Bind a non-propositional spec root to one exact header/body clause.
        # Source identity and semantic admission belong to the outer boundary.
        def spec_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, kind: sview, position: Ast::Pos, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0 or (kind != "changes" and kind != "preserves")
            return false if not ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(nodes, children, facts, root)
            node = nodes[root]
            return false if node.operator != "spec" or node.name != name
            policy = source_policy(declarations, name, line, tokens, source, source_length)
            return false if not policy.known or policy.parameter_count != node.auxiliary
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return false if not certified.known
            matches: mutable usize = 0
            for clause in policy.clauses |matches, kind, position, certified, declarations, name, line|:
                if clause.kind == kind and same_position(clause.position, position):
                    return false if matches != 0 or not same_place(clause.place, certified.place) or not place_typed(declarations, name, line, clause.place)
                    matches <- matches + 1
            return matches == 1
