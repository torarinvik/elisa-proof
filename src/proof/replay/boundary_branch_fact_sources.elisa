extend ElisaProof:
    private:
        def proof_replay_control_if_facts(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, matches: mutable usize&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT
            for statement in body |report, trace, certificate, body, matches, depth, work|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                match statement:
                    Ast::Stmt.If(condition, yes, no, position):
                        if position.line == trace.line and proof_replay_control_stable_expression_budgeted(report, trace, condition, work, 0):
                            yes_matches: mutable usize = 0
                            if proof_replay_control_expr_source_equal_with_work(trace.expression, condition, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_control_assertion_scan(yes, certificate, 0, work, &yes_matches) and yes_matches == 1:
                                matches <- matches + 1
                            no_matches: mutable usize = 0
                            negated: Ast::Expr = proof_replay_control_negation(condition, position)
                            if proof_replay_summary_expr_equal_with_limit(trace.expression, negated, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_trace_expression_positions_equal_with_work(trace.expression, negated, 0, &work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_control_assertion_scan(no, certificate, 0, work, &no_matches) and no_matches == 1:
                                matches <- matches + 1
                        return false if:
                            not proof_replay_control_if_facts(report, trace, certificate, yes, matches, depth + 1, work)
                            not proof_replay_control_if_facts(report, trace, certificate, no, matches, depth + 1, work)
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        return false if not proof_replay_control_if_facts(report, trace, certificate, inner, matches, depth + 1, work)
                    Ast::Stmt.Block(_, _, _, inner, _):
                        return false if not proof_replay_control_if_facts(report, trace, certificate, inner, matches, depth + 1, work)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |report, trace, certificate, matches, depth, work|:
                            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            work <- work + 1
                            return false if not proof_replay_control_if_facts(report, trace, certificate, arm.body, matches, depth + 1, work)
                    Ast::Stmt.Expr(_, _) | Ast::Stmt.Return(_, _) | Ast::Stmt.VarDecl(_, _, _, _) | Ast::Stmt.Assign(_, _, _, _) | Ast::Stmt.Contract(_, _, _) | Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return true

        # Only walk expression forms whose entire tree is explicit here. Calls, moves, and
        # unsupported future variants stop fact retention; work is charged for each node so
        # repeated prior-arm checks share the match replay budget.
        def proof_replay_control_match_guard_keeps_expression_facts(report: ProofReport&, expression: Ast::Expr, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.ShorthandMember(parts, _):
                    return false if parts.count != 1 or parts[0] == ""
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_replay_control_match_guard_keeps_expression_facts(report, inner, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Not and operator != TokenKind.Minus
                    protocol: sview = proof_builtin_unary_operator_protocol(operator)
                    return false if protocol != "" and proof_source_primitive_operator_mask_has(report.source.source_primitive_operator_mask, protocol)
                    return proof_replay_control_match_guard_keeps_expression_facts(report, inner, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                    protocol: sview = proof_builtin_operator_protocol(operator)
                    return false if:
                        protocol != "" and proof_source_primitive_operator_mask_has(report.source.source_primitive_operator_mask, protocol)
                        not proof_replay_control_match_guard_keeps_expression_facts(report, left, work, depth + 1)
                    return proof_replay_control_match_guard_keeps_expression_facts(report, right, work, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return false if not proof_replay_control_match_guard_keeps_expression_facts(report, object, work, depth + 1)
                    return proof_replay_control_match_guard_keeps_expression_facts(report, index, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return false if:
                        not proof_replay_control_match_guard_keeps_expression_facts(report, object, work, depth + 1)
                        not proof_replay_control_match_guard_keeps_expression_facts(report, low, work, depth + 1)
                    return proof_replay_control_match_guard_keeps_expression_facts(report, high, work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_control_match_guard_keeps_expression_facts(report, object, work, depth + 1)
                    for argument in arguments |report, work, depth|:
                        return false if not proof_replay_control_match_guard_keeps_expression_facts(report, argument, work, depth + 1)
                    return true
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |report, work, depth|:
                        return false if not proof_replay_control_match_guard_keeps_expression_facts(report, element, work, depth + 1)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |report, work, depth|:
                        return false if:
                            not proof_replay_control_match_guard_keeps_expression_facts(report, entry.key, work, depth + 1)
                            not proof_replay_control_match_guard_keeps_expression_facts(report, entry.value, work, depth + 1)
                    return true
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_control_match_guard_keeps_expression_facts(report, base, work, depth + 1)
                    for field in fields |report, work, depth|:
                        return false if not proof_replay_control_match_guard_keeps_expression_facts(report, field.value, work, depth + 1)
                    return true
                _:
                    return false

        def proof_replay_control_match_guard_keeps_facts(report: ProofReport&, guard: Ast::Expr, work: mutable usize&) -> bool:
            return true if guard is Ast::Expr.Absent
            return proof_replay_control_match_guard_keeps_expression_facts(report, guard, work, 0)

        def proof_replay_control_match_guard_charge_declarations(declarations: darray[Ast::Decl]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for declaration in declarations |work, depth|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, parameters, return_type, _, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if not proof_replay_summary_expr_charge_with_limit(return_type, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                        for _ in parameters |work, depth|:
                            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            work <- work + 1
                        for parameter in parameters |work|:
                            return false if sview_len(parameter.name) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(parameter.name)
                            return false if not proof_replay_summary_expr_charge_with_limit(parameter.type_expression, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                    Ast::Decl.Module(module_name, nested, _):
                        return false if sview_len(module_name) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(module_name)
                        return false if not proof_replay_control_match_guard_charge_declarations(nested, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_control_match_guard_charge_declarations(nested, work, depth + 1)
                    Ast::Decl.Const(name, _, _, _, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Extern(name, _, _, _, _, _, _, _) | Ast::Decl.Import(name, _) | Ast::Decl.Law(name, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                    Ast::Decl.Enum(name, variants, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if variants.count > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                        work <- work + variants.count
                        for variant in variants |work|:
                            return false if sview_len(variant.name) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(variant.name)
                    Ast::Decl.Alias(name, target, _):
                        return false if sview_len(name) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if not proof_replay_summary_expr_charge_with_limit(target, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_control_text_compare_charge(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            if sview_len(left) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            work <- work + sview_len(left)
            if sview_len(right) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            work <- work + sview_len(right)
            return true

        def proof_replay_control_match_guard_function_collect(declarations: darray[Ast::Decl]&, name: sview, selected: mutable Ast::Decl&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for declaration in declarations |name, selected, matches, work, depth|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(found_name, _, _, _, _, _, _):
                        return false if not proof_replay_control_text_compare_charge(found_name, name, work)
                        if found_name == name:
                            matches <- matches + 1
                            selected <- declaration
                    Ast::Decl.Const(found_name, _, _, _, _) | Ast::Decl.Extern(found_name, _, _, _, _, _, _, _) | Ast::Decl.Struct(found_name, _, _, _, _, _, _) | Ast::Decl.Enum(found_name, _, _, _, _) | Ast::Decl.Alias(found_name, _, _) | Ast::Decl.Law(found_name, _, _):
                        return false if not proof_replay_control_text_compare_charge(found_name, name, work)
                        matches <- matches + 1 if found_name == name
                    Ast::Decl.Module(module_name, nested, _):
                        return false if not proof_replay_control_text_compare_charge(module_name, name, work)
                        matches <- matches + 1 if module_name == name
                        return false if not proof_replay_control_match_guard_function_collect(nested, name, selected, matches, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_control_match_guard_function_collect(nested, name, selected, matches, work, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_control_match_guard_scalar_type(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name in {"i8", "i16", "i32", "i64", "isize", "int", "u8", "u16", "u32", "u64", "usize", "uintptr", "bool", "char"}
                _:
                    return false

        def proof_replay_control_match_guard_pure_expression(report: ProofReport&, expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            if expression is Ast::Expr.IntLit(_, _):
                return true
            if expression is Ast::Expr.FloatLit(_, _):
                return true
            if expression is Ast::Expr.StringLit(_, _):
                return true
            if expression is Ast::Expr.CharLit(_, _):
                return true
            if expression is Ast::Expr.BoolLit(_, _):
                return true
            if expression is Ast::Expr.Ident(name, _):
                matches: mutable usize = 0
                for parameter in parameters |name, matches, work|:
                    return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                    work <- work + 1
                    return false if not proof_replay_control_text_compare_charge(parameter.name, name, work)
                    matches <- matches + 1 if parameter.name == name
                return matches == 1
            if expression is Ast::Expr.Paren(inner, _):
                return proof_replay_control_match_guard_pure_expression(report, inner, parameters, work, depth + 1)
            if expression is Ast::Expr.Unary(operator, inner, _):
                return false if operator != TokenKind.Not and operator != TokenKind.Minus
                protocol: sview = proof_builtin_unary_operator_protocol(operator)
                return false if protocol != "" and proof_source_primitive_operator_mask_has(report.source.source_primitive_operator_mask, protocol)
                return proof_replay_control_match_guard_pure_expression(report, inner, parameters, work, depth + 1)
            if expression is Ast::Expr.Binary(left, operator, right, _):
                return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                protocol: sview = proof_builtin_operator_protocol(operator)
                return false if:
                    protocol != "" and proof_source_primitive_operator_mask_has(report.source.source_primitive_operator_mask, protocol)
                    not proof_replay_control_match_guard_pure_expression(report, left, parameters, work, depth + 1)
                return proof_replay_control_match_guard_pure_expression(report, right, parameters, work, depth + 1)
            return false

        # Only simple scalar-return bodies are admitted here. The narrow body shape lets replay
        # prove purity directly with the same shared budget, without trusting checker summary
        # bits or invoking an unbounded call-graph walk.
        def proof_replay_control_match_guard_pure_function(report: ProofReport&, name: sview, argument_count: usize, declaration: Ast::Decl, work: mutable usize&) -> bool:
            match declaration:
                Ast::Decl.Func(found_name, parameters, return_type, body, effects, _, _):
                    return false if:
                        not proof_replay_control_text_compare_charge(found_name, name, work)
                        found_name != name or effects.count != 0 or parameters.count != argument_count or parameters.count > 64 or body.count != 1
                        not proof_replay_control_match_guard_scalar_type(return_type)
                    for parameter_index in 0..<parameters.count |parameter_index, parameters, work|:
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        work <- work + 1
                        parameter: Ast::ParamDecl = parameters[parameter_index]
                        return false if parameter.name == "" or parameter.has_default or parameter.is_mutable or not proof_replay_control_match_guard_scalar_type(parameter.type_expression)
                        for previous in 0..<parameter_index |previous, parameter_index, parameters, work|:
                            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            work <- work + 1
                            return false if:
                                not proof_replay_control_text_compare_charge(parameters[previous].name, parameter.name, work)
                                parameters[previous].name == parameter.name
                    match body[0]:
                        Ast::Stmt.Return(value, _):
                            if value is returned:
                                return proof_replay_control_match_guard_pure_expression(report, returned, parameters, work, 0)
                            return false
                        _:
                            return false
                _:
                    return false

        def proof_replay_control_match_guard_call_is_pure(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&, owner_source_work: usize) -> bool:
            return false if:
                trace.name == "" or report.analysis_2.replay_owner_line == 0
                proof_replay_summary_has_unresolved_import(report.source.source_annotations, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                not proof_replay_control_match_guard_charge_declarations(report.source.source_declarations, work, 0)
                proof_replay_summary_has_unresolved_declaration_import(report.source.source_declarations, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT, 0)
            match call:
                Ast::Expr.Call(Ast::Expr.Ident(name, _), arguments, labels, _):
                    return false if name == "" or labels.count != 0
                    selected: mutable Ast::Decl = Ast::Decl.Invalid
                    matches: mutable usize = 0
                    return false if:
                        not proof_replay_control_match_guard_function_collect(report.source.source_declarations, name, selected, &matches, work, 0)
                        matches != 1 or not proof_replay_control_match_guard_pure_function(report, name, arguments.count, selected, work)
                        not proof_replay_control_match_guard_charge_declarations(report.source.source_declarations, work, 0)
                        proof_replay_local_binding_parameter_name_present_at_offset_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT, 0)
                        not proof_replay_control_match_guard_charge_declarations(report.source.source_declarations, work, 0)
                        owner_source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                    work <- work + owner_source_work
                    return false if not proof_replay_local_binding_parameter_source_unshadowed_at_offset_with_limit(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                    return true
                _:
                    return false

        # Resolve and copy the owner body in the same bounded declaration walk. Imports remain
        # valid for source-local branch facts; pure helper name resolution applies its own stricter
        # import checks only when a guard contains a call.
        def proof_replay_control_find_owner_body(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, exact_owner: bool, body: mutable darray[Ast::Stmt]&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if owner == "" or owner_line == 0 or owner_line == PROOF_REPLAY_CONTROL_INVALID_OWNER_LINE or depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, owner_offset, exact_owner, body, matches, work, depth|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, _, _, function_body, _, _, position):
                        if name == owner and position.line == owner_line and (not exact_owner or position.offset.usize() == owner_offset):
                            matches <- matches + 1
                            return false if matches != 1 or function_body.count > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                            work <- work + function_body.count
                            body.extend(function_body)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_control_find_owner_body(nested, owner, owner_line, owner_offset, exact_owner, body, matches, work, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_control_match_guard_stable_expression(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, work: mutable usize&, owner_source_work: usize, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    # Stable-identifier validation performs at most three declaration walks:
                    # global-constant lookup plus parameter/shadow checks, or owner lookup plus
                    # integer and Boolean parameter checks. Charge those walks here; the owner
                    # body scan is charged separately through owner_source_work below.
                    for charge_index in 0..<3 |charge_index, report, work|:
                        return false if not proof_replay_control_match_guard_charge_declarations(report.source.source_declarations, work, 0)
                    return false if owner_source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                    work <- work + owner_source_work
                    return proof_replay_control_stable_identifier(report, trace, name, work)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_control_match_guard_stable_expression(report, trace, inner, work, owner_source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Not and operator != TokenKind.Minus
                    protocol: sview = proof_builtin_unary_operator_protocol(operator)
                    return false if protocol != "" and proof_source_primitive_operator_mask_has(report.source.source_primitive_operator_mask, protocol)
                    return proof_replay_control_match_guard_stable_expression(report, trace, inner, work, owner_source_work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                    protocol: sview = proof_builtin_operator_protocol(operator)
                    return false if:
                        protocol != "" and proof_source_primitive_operator_mask_has(report.source.source_primitive_operator_mask, protocol)
                        not proof_replay_control_match_guard_stable_expression(report, trace, left, work, owner_source_work, depth + 1)
                    return proof_replay_control_match_guard_stable_expression(report, trace, right, work, owner_source_work, depth + 1)
                Ast::Expr.Call(_, arguments, _, _):
                    return false if not proof_replay_control_match_guard_call_is_pure(report, trace, expression, work, owner_source_work)
                    for argument in arguments |report, trace, work, owner_source_work, depth|:
                        return false if not proof_replay_control_match_guard_stable_expression(report, trace, argument, work, owner_source_work, depth + 1)
                    return true
                _:
                    return false

        def proof_replay_control_match_arm_fact(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, scrutinee: Ast::Expr, arms: darray[Ast::MatchArm], match_position: Ast::Pos, stop_refutations_after_nonretaining_prior: bool, owner_source_work: usize, matches: mutable usize&, work: mutable usize&, replay_cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return true if match_position.line != trace.line
            # The source formal and its shadow scan are match-scoped facts; compute them once
            # rather than rescanning every owner declaration for every current and prior arm.
            pattern_type: Ast::Expr = proof_replay_control_pattern_formal_type(report, trace.name, scrutinee, work, &replay_cache)
            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            pattern_scrutinee_stable: bool = proof_replay_control_pattern_scrutinee_stable(report, trace, scrutinee, pattern_type, owner_source_work, work)
            for arm_index in 0..<arms.count |arm_index, report, trace, certificate, scrutinee, arms, match_position, stop_refutations_after_nonretaining_prior, owner_source_work, pattern_type, pattern_scrutinee_stable, matches, work|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                arm: Ast::MatchArm = arms[arm_index]
                guard_absent: bool = arm.guard is Ast::Expr.Absent
                guard_keeps_facts: bool = proof_replay_control_match_guard_keeps_facts(report, arm.guard, work)
                current_condition: Ast::Expr? = proof_replay_control_pattern_condition(report, arm.pattern, scrutinee, match_position, pattern_type, work) if guard_keeps_facts and pattern_scrutinee_stable else null
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                if current_condition is expression and proof_replay_control_expr_source_equal_with_work(trace.expression, expression, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT):
                    scope_matches: mutable usize = 0
                    return false if not proof_replay_control_assertion_scan(arm.body, certificate, 0, work, &scope_matches)
                    matches <- matches + 1 if scope_matches == 1
                # Earlier unguarded patterns refute later arms only while intervening guards
                # leave the match fact state intact.
                refutations_available: mutable bool = guard_keeps_facts
                if refutations_available and stop_refutations_after_nonretaining_prior:
                    for prior_index in 0..<arm_index |prior_index, report, trace, certificate, arms, matches, refutations_available, work|:
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        work <- work + 1
                        prior_guard: Ast::Expr = arms[prior_index].guard
                        if not proof_replay_control_match_guard_keeps_facts(report, prior_guard, work):
                            refutations_available <- false
                            break
                if refutations_available and pattern_scrutinee_stable:
                    for prior_index in 0..<arm_index |prior_index, report, trace, certificate, scrutinee, arms, match_position, arm, pattern_type, matches, work|:
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        work <- work + 1
                        prior: Ast::MatchArm = arms[prior_index]
                        continue if not (prior.guard is Ast::Expr.Absent)
                        prior_condition: Ast::Expr? = proof_replay_control_pattern_condition(report, prior.pattern, scrutinee, match_position, pattern_type, work)
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        if prior_condition is prior_expression:
                            continue if not proof_replay_control_pattern_exact(prior.pattern, pattern_type, work)
                            rejected: Ast::Expr = Ast::Expr.Unary(TokenKind.Not, prior_expression, match_position)
                            if proof_replay_summary_expr_equal_with_limit(trace.expression, rejected, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_trace_expression_positions_equal_with_work(trace.expression, rejected, 0, &work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT):
                                scope_matches: mutable usize = 0
                                return false if not proof_replay_control_assertion_scan(arm.body, certificate, 0, work, &scope_matches)
                                matches <- matches + 1 if scope_matches == 1
                if not guard_absent and proof_replay_control_expr_source_equal_with_work(trace.expression, arm.guard, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT):
                    # Match the exact source guard before validating any calls. That keeps the
                    # declaration and shadow walk off unrelated arms in the owner's body.
                    if proof_replay_control_match_guard_stable_expression(report, trace, arm.guard, work, owner_source_work, 0):
                        scope_matches: mutable usize = 0
                        return false if not proof_replay_control_assertion_scan(arm.body, certificate, 0, work, &scope_matches)
                        matches <- matches + 1 if scope_matches == 1
            return true

        def proof_replay_control_match_expr_facts(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, owner_source_work: usize, expression: Ast::Expr, matches: mutable usize&, depth: usize, work: mutable usize&, replay_cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Lambda(_, _, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, callee, matches, depth + 1, work, replay_cache)
                    for argument in arguments |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, argument, matches, depth + 1, work, replay_cache)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                        work <- work + 1
                        for capture in candidate.captures |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                            return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, capture, matches, depth + 1, work, replay_cache)
                    for argument in arguments |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, argument, matches, depth + 1, work, replay_cache)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, object, matches, depth + 1, work, replay_cache)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, object, matches, depth + 1, work, replay_cache)
                    return proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, index, matches, depth + 1, work, replay_cache)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return false if:
                        not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, object, matches, depth + 1, work, replay_cache)
                        not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, low, matches, depth + 1, work, replay_cache)
                    return proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, high, matches, depth + 1, work, replay_cache)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, object, matches, depth + 1, work, replay_cache)
                    for argument in arguments |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, argument, matches, depth + 1, work, replay_cache)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, element, matches, depth + 1, work, replay_cache)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if:
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, entry.key, matches, depth + 1, work, replay_cache)
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, entry.value, matches, depth + 1, work, replay_cache)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, base, matches, depth + 1, work, replay_cache)
                    for field in fields |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, field.value, matches, depth + 1, work, replay_cache)
                Ast::Expr.Match(subject, arms, position):
                    return false if:
                        not proof_replay_control_match_arm_fact(report, trace, certificate, subject, arms, position, true, owner_source_work, matches, work, replay_cache)
                        not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, subject, matches, depth + 1, work, replay_cache)
                    for arm in arms |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if:
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, arm.guard, matches, depth + 1, work, replay_cache)
                            not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, arm.body, matches, depth + 1, work, replay_cache)
                Ast::Expr.Catch(subject, arms, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, subject, matches, depth + 1, work, replay_cache)
                    for arm in arms |report, trace, certificate, owner_source_work, depth, work, matches, replay_cache|:
                        return false if:
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, arm.guard, matches, depth + 1, work, replay_cache)
                            not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, arm.body, matches, depth + 1, work, replay_cache)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return false if:
                        not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, iterable, matches, depth + 1, work, replay_cache)
                        not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, condition, matches, depth + 1, work, replay_cache)
                    return proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, value, matches, depth + 1, work, replay_cache)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, guarded, matches, depth + 1, work, replay_cache)
                    return proof_replay_control_match_facts(report, trace, certificate, owner_source_work, recovery, matches, depth + 1, work, replay_cache)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, statements, matches, depth + 1, work, replay_cache)
                    return proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, value, matches, depth + 1, work, replay_cache)
            return false

        def proof_replay_control_match_facts(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, owner_source_work: usize, body: darray[Ast::Stmt]&, matches: mutable usize&, depth: usize, work: mutable usize&, replay_cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT
            for statement in body |report, trace, certificate, body, matches, owner_source_work, depth, work, replay_cache|:
                return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work <- work + 1
                match statement:
                    Ast::Stmt.Match(scrutinee, arms, position):
                        return false if:
                            not proof_replay_control_match_arm_fact(report, trace, certificate, scrutinee, arms, position, true, owner_source_work, matches, work, replay_cache)
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, scrutinee, matches, depth + 1, work, replay_cache)
                        for arm in arms |report, trace, certificate, matches, owner_source_work, depth, work, replay_cache|:
                            return false if:
                                not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, arm.guard, matches, depth + 1, work, replay_cache)
                                not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, arm.body, matches, depth + 1, work, replay_cache)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if:
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, condition, matches, depth + 1, work, replay_cache)
                            not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, yes, matches, depth + 1, work, replay_cache)
                            not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, no, matches, depth + 1, work, replay_cache)
                    Ast::Stmt.While(condition, inner, _):
                        return false if:
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, condition, matches, depth + 1, work, replay_cache)
                            not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, inner, matches, depth + 1, work, replay_cache)
                    Ast::Stmt.For(_, _, iterable, inner, _):
                        return false if:
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, iterable, matches, depth + 1, work, replay_cache)
                            not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, inner, matches, depth + 1, work, replay_cache)
                    Ast::Stmt.Block(_, _, _, inner, _):
                        return false if not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, inner, matches, depth + 1, work, replay_cache)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.VarDecl(_, _, expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, expression, matches, depth + 1, work, replay_cache)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if:
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, target, matches, depth + 1, work, replay_cache)
                            not proof_replay_control_match_expr_facts(report, trace, certificate, owner_source_work, value, matches, depth + 1, work, replay_cache)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_control_branch_fact_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_control_branch_fact_source_with_work(report, trace, &work)

        def proof_replay_control_branch_fact_source_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work_seed: usize = source_work
            work: mutable usize = work_seed
            complete: bool = proof_replay_control_branch_fact_source_scan(report, trace, &work)
            if work < work_seed:
                source_work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            work_delta: usize = work - work_seed
            if work_delta > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work:
                source_work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            source_work <- source_work + work_delta
            complete

        def proof_replay_control_branch_fact_source_scan(report: ProofReport&, trace: ProofFactTrace, work: mutable usize&) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count or trace.name == "" or trace.line == 0 or report.analysis_2.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
            body: mutable darray[Ast::Stmt] = []
            owner_matches: mutable usize = 0
            return false if not proof_replay_control_find_owner_body(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, &body, &owner_matches, work, 0) or owner_matches != 1
            matches: mutable usize = 0
            replay_cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            declaration_work: usize = work
            return false if not proof_replay_control_assertion_unique_in_owner(report, body, certificate, work)
            owner_source_work: usize = work - declaration_work
            return false if:
                not proof_replay_control_if_facts(report, trace, certificate, body, &matches, 0, work)
                not proof_replay_control_match_facts(report, trace, certificate, owner_source_work, body, &matches, 0, work, &replay_cache)
            matches == 1
