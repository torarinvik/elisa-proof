# Counting-loop type witnesses carry a source-position-tagged proof atom, so nested binders with
# the same spelling remain distinct. Certificate replay also binds their use to the exact loop
# body; the standalone fact-trace API has no consumer context and checks source origin only.
extend ElisaProof:
    private:
        def proof_replay_type_bound_goal_position_matches(expression: Ast::Expr, goal: Ast::Expr, work: mutable usize&) -> bool:
            return false if not proof_replay_summary_expr_equal_with_limit(expression, goal, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
            expression_position: Ast::Pos = Ast::expr_pos(expression)
            goal_position: Ast::Pos = Ast::expr_pos(goal)
            return expression_position.line == goal_position.line and expression_position.column == goal_position.column and expression_position.offset == goal_position.offset and expression_position.end_line == goal_position.end_line and expression_position.end_column == goal_position.end_column and expression_position.end_offset == goal_position.end_offset

        def proof_replay_type_bound_consumer_source_site_in_expr(expression: Ast::Expr, certificate: ProofGoalCertificate, matches: mutable usize&, work: mutable usize&, depth: usize) -> void:
            proof_replay_type_bound_consumer_source_site_in_expr_bounded(expression, certificate, matches, work, depth, false)

        def proof_replay_type_bound_consumer_source_site_in_expr_bounded(expression: Ast::Expr, certificate: ProofGoalCertificate, matches: mutable usize&, work: mutable usize&, depth: usize, count_assert_call: bool) -> void:
            return if matches >= 2
            if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                matches <- 2
                return
            work <- work + 1
            match expression:
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(inner, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Refinement(left, right, _) | Ast::Expr.Index(left, right, _):
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(left, certificate, matches, work, depth + 1, count_assert_call)
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(right, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(object, certificate, matches, work, depth + 1, count_assert_call)
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(low, certificate, matches, work, depth + 1, count_assert_call)
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(high, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(object, certificate, matches, work, depth + 1, count_assert_call)
                    for argument in arguments |certificate, matches, work, depth|:
                        return if matches >= 2
                        if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                            matches <- 2
                            return
                        work <- work + 1
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(argument, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.Call(callee, arguments, _, position):
                    if count_assert_call:
                        match callee:
                            Ast::Expr.Ident("assert", _):
                                if position.line == certificate.line and arguments.count == 1:
                                    matches <- matches + 1 if proof_replay_type_bound_goal_position_matches(arguments[0], certificate.goal, work)
                            _:
                                pass
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(callee, certificate, matches, work, depth + 1, count_assert_call)
                    for argument in arguments |certificate, matches, work, depth|:
                        return if matches >= 2
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(argument, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |certificate, matches, work, depth, count_assert_call|:
                        return if matches >= 2
                        if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                            matches <- 2
                            return
                        work <- work + 1
                        for capture in candidate.captures |certificate, matches, work, depth, count_assert_call|:
                            return if matches >= 2
                            proof_replay_type_bound_consumer_source_site_in_expr_bounded(capture, certificate, matches, work, depth + 1, count_assert_call)
                    for argument in arguments |certificate, matches, work, depth|:
                        return if matches >= 2
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(argument, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |certificate, matches, work, depth|:
                        return if matches >= 2
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(element, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |certificate, matches, work, depth|:
                        return if matches >= 2
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(entry.key, certificate, matches, work, depth + 1, count_assert_call)
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(entry.value, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(base, certificate, matches, work, depth + 1, count_assert_call)
                    for field in fields |certificate, matches, work, depth|:
                        return if matches >= 2
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(field.value, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(subject, certificate, matches, work, depth + 1, count_assert_call)
                    for arm in arms |certificate, matches, work, depth|:
                        return if matches >= 2
                        if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                            matches <- 2
                            return
                        work <- work + 1
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(arm.guard, certificate, matches, work, depth + 1, count_assert_call)
                        proof_replay_type_bound_consumer_source_site_in_body_bounded(arm.body, certificate, matches, work, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(iterable, certificate, matches, work, depth + 1, count_assert_call)
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(condition, certificate, matches, work, depth + 1, count_assert_call)
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(value, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(guarded, certificate, matches, work, depth + 1, count_assert_call)
                    proof_replay_type_bound_consumer_source_site_in_body_bounded(recovery, certificate, matches, work, depth + 1)
                Ast::Expr.Lambda(_, nested, _):
                    proof_replay_type_bound_consumer_source_site_in_body_bounded(nested, certificate, matches, work, depth + 1)
                Ast::Expr.Block(nested, value, _, _):
                    proof_replay_type_bound_consumer_source_site_in_body_bounded(nested, certificate, matches, work, depth + 1)
                    proof_replay_type_bound_consumer_source_site_in_expr_bounded(value, certificate, matches, work, depth + 1, count_assert_call)
                Ast::Expr.Invalid:
                    matches <- 2
                _:
                    # An unknown expression may contain another consumer site.
                    matches <- 2

        def proof_replay_type_bound_consumer_source_site_in_body_bounded(body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, matches: mutable usize&, work: mutable usize&, depth: usize) -> void:
            return if matches >= 2
            if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                matches <- 2
                return
            for statement in body |certificate, matches, work, depth|:
                return if matches >= 2
                if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                    matches <- 2
                    return
                work <- work + 1
                match statement:
                    Ast::Stmt.Block(_, _, _, nested, _):
                        proof_replay_type_bound_consumer_source_site_in_body_bounded(nested, certificate, matches, work, depth + 1)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_replay_type_bound_consumer_source_site_in_expr(condition, certificate, matches, work, depth + 1)
                        proof_replay_type_bound_consumer_source_site_in_body_bounded(then_body, certificate, matches, work, depth + 1)
                        proof_replay_type_bound_consumer_source_site_in_body_bounded(else_body, certificate, matches, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        proof_replay_type_bound_consumer_source_site_in_expr(condition, certificate, matches, work, depth + 1)
                        proof_replay_type_bound_consumer_source_site_in_body_bounded(nested, certificate, matches, work, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        proof_replay_type_bound_consumer_source_site_in_expr(iterable, certificate, matches, work, depth + 1)
                        proof_replay_type_bound_consumer_source_site_in_body_bounded(nested, certificate, matches, work, depth + 1)
                    Ast::Stmt.Match(subject, arms, _):
                        proof_replay_type_bound_consumer_source_site_in_expr(subject, certificate, matches, work, depth + 1)
                        for arm in arms |certificate, matches, work, depth|:
                            return if matches >= 2
                            if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                                matches <- 2
                                return
                            work <- work + 1
                            proof_replay_type_bound_consumer_source_site_in_expr(arm.guard, certificate, matches, work, depth + 1)
                            proof_replay_type_bound_consumer_source_site_in_body_bounded(arm.body, certificate, matches, work, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        matches <- matches + 1 if proof_replay_type_bound_goal_position_matches(expression, certificate.goal, work)
                        proof_replay_type_bound_consumer_source_site_in_expr(expression, certificate, matches, work, depth + 1)
                    Ast::Stmt.Expr(expression, _):
                        proof_replay_type_bound_consumer_source_site_in_expr_bounded(expression, certificate, matches, work, depth + 1, true)
                    Ast::Stmt.Return(expression, _):
                        proof_replay_type_bound_consumer_source_site_in_expr(expression, certificate, matches, work, depth + 1)
                    Ast::Stmt.VarDecl(_, type_expression, initializer, _):
                        proof_replay_type_bound_consumer_source_site_in_expr(type_expression, certificate, matches, work, depth + 1)
                        proof_replay_type_bound_consumer_source_site_in_expr(initializer, certificate, matches, work, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        proof_replay_type_bound_consumer_source_site_in_expr(target, certificate, matches, work, depth + 1)
                        proof_replay_type_bound_consumer_source_site_in_expr(value, certificate, matches, work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        matches <- 2
                    _:
                        matches <- 2

        def proof_replay_type_bound_consumer_source_site_in_body(body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, matches: mutable usize&, depth: usize) -> void:
            work: mutable usize = 0
            proof_replay_type_bound_consumer_source_site_in_body_with_work(body, certificate, matches, &work, depth)

        def proof_replay_type_bound_consumer_source_site_in_body_with_work(body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, matches: mutable usize&, work: mutable usize&, depth: usize) -> void:
            proof_replay_type_bound_consumer_source_site_in_body_bounded(body, certificate, matches, work, depth)

        def proof_replay_type_bound_loop_consumer_in_scope(report: ProofReport&, trace: ProofFactTrace, loop_position: Ast::Pos, binder: sview, body: darray[Ast::Stmt]&) -> bool:
            work: mutable usize = 0
            return proof_replay_type_bound_loop_consumer_in_scope_with_work(report, trace, loop_position, binder, body, &work)

        def proof_replay_type_bound_loop_consumer_in_scope_with_work(report: ProofReport&, trace: ProofFactTrace, loop_position: Ast::Pos, binder: sview, body: darray[Ast::Stmt]&, work: mutable usize&) -> bool:
            return true if report.analysis_2.trace_consumer_certificate_index == 0 and report.analysis_2.trace_owner_line == 0
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if binder == "" or certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
            # The source-site walker does not carry lexical bindings. Refuse this witness if
            # any nested scope in the loop body can rebind the outer iteration variable.
            return false if proof_replay_source_body_declares_with_work(report.source.source_declarations, body, binder, work)
            # The binder is introduced after the loop header, so a line-level certificate on
            # that header cannot prove that the binder is in scope.
            return false if:
                certificate.line <= loop_position.line
                report.results.goal_attempts.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                not proof_replay_summary_expr_charge_with_work(certificate.goal, work)
                not proof_replay_type_bound_extent_preflight_with_work(body, Ast::Expr.Absent, false, certificate.goal, true, work)
                report.results.goal_attempts.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
            work <- work + report.results.goal_attempts.count
            attempt_matches: mutable usize = 0
            for attempt in report.results.goal_attempts |certificate, attempt_matches|:
                if attempt.has_certificate and attempt.certificate_index < report.analysis_1.certificates.count and attempt.certificate_index == report.analysis_2.trace_consumer_certificate_index - 1:
                    return false if not proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, report.analysis_2.trace_consumer_certificate_index - 1, work)
                    attempt_matches <- attempt_matches + 1
            return false if attempt_matches != 1
            consumer_matches: mutable usize = 0
            proof_replay_type_bound_consumer_source_site_in_body_with_work(body, certificate, &consumer_matches, work, 0)
            return consumer_matches == 1

        def proof_replay_type_bound_loop_fact_in_expr(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, matches: mutable usize&, valid: mutable bool&, consumer_valid: mutable bool&, work: mutable usize&, depth: usize) -> void:
            return if matches >= 2
            if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                matches <- 2
                return
            work <- work + 1
            match expression:
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, callee, matches, valid, consumer_valid, work, depth + 1)
                    for argument in arguments |report, trace, matches, valid, consumer_valid, work, depth|:
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, argument, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |report, trace, matches, valid, consumer_valid, work, depth|:
                        if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                            matches <- 2
                            return
                        work <- work + 1
                        for capture in candidate.captures |report, trace, matches, valid, consumer_valid, work, depth|:
                            proof_replay_type_bound_loop_fact_in_expr(report, trace, capture, matches, valid, consumer_valid, work, depth + 1)
                    for argument in arguments |report, trace, matches, valid, consumer_valid, work, depth|:
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, argument, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, object, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, object, matches, valid, consumer_valid, work, depth + 1)
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, index, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, object, matches, valid, consumer_valid, work, depth + 1)
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, low, matches, valid, consumer_valid, work, depth + 1)
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, high, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, object, matches, valid, consumer_valid, work, depth + 1)
                    for argument in arguments |report, trace, matches, valid, consumer_valid, work, depth|:
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, argument, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |report, trace, matches, valid, consumer_valid, work, depth|:
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, element, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |report, trace, matches, valid, consumer_valid, work, depth|:
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, entry.key, matches, valid, consumer_valid, work, depth + 1)
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, entry.value, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, base, matches, valid, consumer_valid, work, depth + 1)
                    for field in fields |report, trace, matches, valid, consumer_valid, work, depth|:
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, field.value, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, subject, matches, valid, consumer_valid, work, depth + 1)
                    for arm in arms |report, trace, matches, valid, consumer_valid, work, depth|:
                        if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                            matches <- 2
                            return
                        work <- work + 1
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, arm.guard, matches, valid, consumer_valid, work, depth + 1)
                        proof_replay_type_bound_loop_fact_in_body(report, trace, arm.body, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, iterable, matches, valid, consumer_valid, work, depth + 1)
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, condition, matches, valid, consumer_valid, work, depth + 1)
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, value, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, guarded, matches, valid, consumer_valid, work, depth + 1)
                    proof_replay_type_bound_loop_fact_in_body(report, trace, recovery, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Lambda(_, nested, _):
                    proof_replay_type_bound_loop_fact_in_body(report, trace, nested, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Block(nested, value, _, _):
                    proof_replay_type_bound_loop_fact_in_body(report, trace, nested, matches, valid, consumer_valid, work, depth + 1)
                    proof_replay_type_bound_loop_fact_in_expr(report, trace, value, matches, valid, consumer_valid, work, depth + 1)
                Ast::Expr.Invalid:
                    matches <- 2
                _:
                    matches <- 2

        def proof_replay_type_bound_loop_fact_in_body(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&, matches: mutable usize&, valid: mutable bool&, consumer_valid: mutable bool&, work: mutable usize&, depth: usize) -> void:
            return if matches >= 2
            if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT:
                matches <- 2
                return
            for statement in body |report, trace, matches, valid, consumer_valid, work, depth|:
                if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                    matches <- 2
                    return
                work <- work + 1
                match statement:
                    Ast::Stmt.For(_, variables, iterable, nested, position):
                        if position.line == trace.line:
                            matches <- matches + 1
                            valid <- proof_replay_type_bound_counting_loop_fact(report, trace.expression, variables, iterable, position, work)
                            binder: sview = variables[0] if variables.count == 1 else ""
                            consumer_valid <- proof_replay_type_bound_loop_consumer_in_scope_with_work(report, trace, position, binder, nested, work)
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, iterable, matches, valid, consumer_valid, work, depth + 1)
                        proof_replay_type_bound_loop_fact_in_body(report, trace, nested, matches, valid, consumer_valid, work, depth + 1)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, condition, matches, valid, consumer_valid, work, depth + 1)
                        proof_replay_type_bound_loop_fact_in_body(report, trace, then_body, matches, valid, consumer_valid, work, depth + 1)
                        proof_replay_type_bound_loop_fact_in_body(report, trace, else_body, matches, valid, consumer_valid, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, condition, matches, valid, consumer_valid, work, depth + 1)
                        proof_replay_type_bound_loop_fact_in_body(report, trace, nested, matches, valid, consumer_valid, work, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        proof_replay_type_bound_loop_fact_in_body(report, trace, nested, matches, valid, consumer_valid, work, depth + 1)
                    Ast::Stmt.Match(subject, arms, _):
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, subject, matches, valid, consumer_valid, work, depth + 1)
                        for arm in arms |report, trace, matches, valid, consumer_valid, work, depth|:
                            if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT:
                                matches <- 2
                                return
                            work <- work + 1
                            proof_replay_type_bound_loop_fact_in_expr(report, trace, arm.guard, matches, valid, consumer_valid, work, depth + 1)
                            proof_replay_type_bound_loop_fact_in_body(report, trace, arm.body, matches, valid, consumer_valid, work, depth + 1)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, expression, matches, valid, consumer_valid, work, depth + 1)
                    Ast::Stmt.VarDecl(_, type_expression, initializer, _):
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, type_expression, matches, valid, consumer_valid, work, depth + 1)
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, initializer, matches, valid, consumer_valid, work, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, target, matches, valid, consumer_valid, work, depth + 1)
                        proof_replay_type_bound_loop_fact_in_expr(report, trace, value, matches, valid, consumer_valid, work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        matches <- 2
                    _:
                        matches <- 2
