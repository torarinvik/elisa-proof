# Entry preconditions are source assumptions, not report-supplied axioms. Replay accepts one only
# when it is present in the owning function's leading body `requires`, a parser-retained signature
# `requires` for that declaration, or follows from a uniquely resolved parameter refinement.
extend ElisaProof:
    private:
        const PROOF_REPLAY_PRECONDITION_DEPTH_LIMIT: usize = 127

        def proof_replay_precondition_work_add(work: mutable usize&, amount: usize) -> bool:
            if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            work <- work + amount
            return true

        def proof_replay_precondition_expr_repetition_charge(expression: Ast::Expr, repetitions: usize, work: mutable usize&) -> bool:
            return true if repetitions == 0
            if repetitions >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            total_passes: usize = repetitions + 1
            cost: mutable usize = 0
            if not proof_replay_summary_expr_cost(expression, &cost, work, 0) or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / total_passes:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            work <- work + cost * total_passes
            return true

        def proof_replay_precondition_source_tree_charge(declarations: darray[Ast::Decl]&, work: mutable usize&, depth: usize, scope_compare_work: usize) -> bool:
            return false if:
                depth >= PROOF_REPLAY_PRECONDITION_DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                scope_compare_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + scope_compare_work
            return false if declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + declarations.count
            for declaration in declarations |work, depth, scope_compare_work|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + parameters.count
                        for parameter in parameters |work|:
                            return false if sview_len(parameter.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(parameter.name)
                            return false if:
                                not proof_replay_summary_expr_charge_with_work(parameter.type_expression, work)
                                parameter.has_default and not proof_replay_summary_expr_charge_with_work(parameter.default_value, work)
                    Ast::Decl.Const(name, type_expression, value, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if:
                            not proof_replay_summary_expr_charge_with_work(type_expression, work)
                            not proof_replay_summary_expr_charge_with_work(value, work)
                    Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Import(name, _) | Ast::Decl.Law(name, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                    Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                    Ast::Decl.Alias(name, target, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if not proof_replay_summary_expr_charge_with_work(target, work)
                    Ast::Decl.Enum(name, variants, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if variants.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + variants.count
                        for variant in variants |work|:
                            return false if sview_len(variant.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(variant.name)
                    Ast::Decl.Module(module_name, nested, _):
                        return false if sview_len(module_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(module_name)
                        module_scope_work: mutable usize = scope_compare_work
                        return false if sview_len(module_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - module_scope_work
                        module_scope_work <- module_scope_work + sview_len(module_name)
                        return false if not proof_replay_precondition_source_tree_charge(nested, work, depth + 1, module_scope_work)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_precondition_source_tree_charge(nested, work, depth + 1, scope_compare_work)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_precondition_find_owner(declarations: darray[Ast::Decl]&, name: sview, line: u32, matches: mutable usize&, owner_offset: mutable u32&, parameters: mutable darray[Ast::ParamDecl]&, body: mutable darray[Ast::Stmt]&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_PRECONDITION_DEPTH_LIMIT
            for declaration in declarations |name, line, matches, owner_offset, parameters, body, depth|:
                match declaration:
                    Ast::Decl.Func(candidate, candidate_parameters, _, candidate_body, _, _, position):
                        if candidate == name and position.line == line:
                            matches <- matches + 1
                            owner_offset <- position.offset
                            parameters <- candidate_parameters
                            body <- candidate_body
                    Ast::Decl.Module(_, nested, _):
                        proof_replay_precondition_find_owner(nested, name, line, matches, owner_offset, parameters, body, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        proof_replay_precondition_find_owner(nested, name, line, matches, owner_offset, parameters, body, depth + 1)
                    Ast::Decl.Invalid:
                        matches <- 2
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        matches <- 2

        def proof_replay_precondition_type_alias_count(declarations: darray[Ast::Decl]&, name: sview, work: mutable usize&, depth: usize) -> usize:
            return 2 if depth >= PROOF_REPLAY_PRECONDITION_DEPTH_LIMIT
            count: mutable usize = 0
            for declaration in declarations |name, depth, count, work|:
                return 2 if not proof_replay_precondition_work_add(work, 1)
                match declaration:
                    Ast::Decl.Alias(candidate, _, _):
                        return 2 if:
                            not proof_replay_precondition_work_add(work, sview_len(candidate))
                            not proof_replay_precondition_work_add(work, sview_len(name))
                        count <- count + 1 if candidate == name
                    Ast::Decl.Module(_, nested, _):
                        count <- count + proof_replay_precondition_type_alias_count(nested, name, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        count <- count + proof_replay_precondition_type_alias_count(nested, name, work, depth + 1)
                    Ast::Decl.Invalid:
                        return 2
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return 2
                return 2 if count > 1
            return count

        def proof_replay_precondition_type_alias_target(declarations: darray[Ast::Decl]&, name: sview, target: mutable Ast::Expr&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_PRECONDITION_DEPTH_LIMIT
            for declaration in declarations |name, target, work, depth|:
                return false if not proof_replay_precondition_work_add(work, 1)
                match declaration:
                    Ast::Decl.Alias(candidate, candidate_target, _):
                        return false if:
                            not proof_replay_precondition_work_add(work, sview_len(candidate))
                            not proof_replay_precondition_work_add(work, sview_len(name))
                        if candidate == name:
                            target <- candidate_target
                            return true
                    Ast::Decl.Module(_, nested, _):
                        return true if proof_replay_precondition_type_alias_target(nested, name, target, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_precondition_type_alias_target(nested, name, target, work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return false

        def proof_replay_precondition_refinement_capture(predicate: Ast::Expr, parameters: darray[Ast::ParamDecl]&, work: mutable usize&) -> bool:
            return false if:
                not proof_replay_precondition_work_add(work, parameters.count)
                not proof_replay_precondition_expr_repetition_charge(predicate, parameters.count + 1, work)
            return true if proof_expr_mentions_name(predicate, "result")
            for parameter in parameters |predicate, work|:
                return false if not proof_replay_precondition_work_add(work, sview_len(parameter.name))
                return true if parameter.name != "self" and proof_expr_mentions_name(predicate, parameter.name)
            return false

        def proof_replay_precondition_refinement_matches(type_expression: Ast::Expr, declarations: darray[Ast::Decl]&, parameters: darray[Ast::ParamDecl]&, parameter_name: sview, required: Ast::Expr, work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_REPLAY_PRECONDITION_DEPTH_LIMIT
                not proof_replay_summary_expr_charge_with_work(type_expression, work)
                not proof_replay_summary_expr_charge_with_work(required, work)
            match type_expression:
                Ast::Expr.Refinement(base, predicate, _):
                    if not proof_replay_precondition_refinement_capture(predicate, parameters, work):
                        return false if:
                            work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            not proof_replay_precondition_expr_repetition_charge(predicate, 2, work)
                            not proof_replay_precondition_expr_repetition_charge(required, 2, work)
                        subject: Ast::Expr = Ast::Expr.Ident(parameter_name, Ast::expr_pos(predicate))
                        substituted: Ast::Expr = proof_replay_substitute(predicate, "self", subject)
                        return true if not proof_replay_expr_is_invalid(substituted) and proof_replay_expr_equal_depth(substituted, required, 0)
                    return proof_replay_precondition_refinement_matches(base, declarations, parameters, parameter_name, required, work, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_precondition_refinement_matches(inner, declarations, parameters, parameter_name, required, work, depth + 1)
                Ast::Expr.Ident(alias_name, _):
                    return false if proof_replay_precondition_type_alias_count(declarations, alias_name, work, 0) != 1
                    target: mutable Ast::Expr = Ast::Expr.Absent
                    return false if not proof_replay_precondition_type_alias_target(declarations, alias_name, &target, work, 0)
                    return proof_replay_precondition_refinement_matches(target, declarations, parameters, parameter_name, required, work, depth + 1)
                _:
                    return false
            return false

        # Replace one exact source term after its declaration-backed equality fact has been
        # validated. This handles qualified constant paths as well as bare names; it never
        # substitutes by the last path segment alone. The shared counter charges both the
        # subtree comparisons and each recursive visit so repeated source terms cannot multiply
        # the rewrite work outside the report budget.
        def proof_replay_precondition_replace_source_term_with_work(expression: Ast::Expr, source_term: Ast::Expr, replacement: Ast::Expr, work: mutable usize&, depth: usize) -> Ast::Expr:
            if depth >= PROOF_REPLAY_PRECONDITION_DEPTH_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return Ast::Expr.Invalid
            if not proof_replay_precondition_expr_repetition_charge(expression, 2, work):
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return Ast::Expr.Invalid
            if not proof_replay_precondition_expr_repetition_charge(source_term, 2, work):
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return Ast::Expr.Invalid
            return replacement if proof_replay_expr_equal_depth(expression, source_term, 0)
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Ident(_, _):
                    return expression
                Ast::Expr.Paren(inner, position):
                    return Ast::Expr.Paren(proof_replay_precondition_replace_source_term_with_work(inner, source_term, replacement, work, depth + 1), position)
                Ast::Expr.Unary(operator, operand, position):
                    return Ast::Expr.Unary(operator, proof_replay_precondition_replace_source_term_with_work(operand, source_term, replacement, work, depth + 1), position)
                Ast::Expr.Binary(left, operator, right, position):
                    return Ast::Expr.Binary(proof_replay_precondition_replace_source_term_with_work(left, source_term, replacement, work, depth + 1), operator, proof_replay_precondition_replace_source_term_with_work(right, source_term, replacement, work, depth + 1), position)
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    rewritten_arguments: mutable darray[Ast::Expr] = []
                    if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or arguments.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return Ast::Expr.Invalid
                    work <- work + arguments.count
                    for argument in arguments |rewritten_arguments, source_term, replacement, work, depth|:
                        rewritten_arguments.push(proof_replay_precondition_replace_source_term_with_work(argument, source_term, replacement, work, depth + 1))
                    return Ast::Expr.Call(proof_replay_precondition_replace_source_term_with_work(callee, source_term, replacement, work, depth + 1), rewritten_arguments, argument_names, position)
                Ast::Expr.Field(object, field, position):
                    return Ast::Expr.Field(proof_replay_precondition_replace_source_term_with_work(object, source_term, replacement, work, depth + 1), field, position)
                Ast::Expr.Scope(base, member, position):
                    return Ast::Expr.Scope(proof_replay_precondition_replace_source_term_with_work(base, source_term, replacement, work, depth + 1), member, position)
                Ast::Expr.Index(object, index, position):
                    return Ast::Expr.Index(proof_replay_precondition_replace_source_term_with_work(object, source_term, replacement, work, depth + 1), proof_replay_precondition_replace_source_term_with_work(index, source_term, replacement, work, depth + 1), position)
                Ast::Expr.If(condition, then_expression, else_expression, position):
                    return Ast::Expr.If(proof_replay_precondition_replace_source_term_with_work(condition, source_term, replacement, work, depth + 1), proof_replay_precondition_replace_source_term_with_work(then_expression, source_term, replacement, work, depth + 1), proof_replay_precondition_replace_source_term_with_work(else_expression, source_term, replacement, work, depth + 1), position)
                Ast::Expr.Array(elements, position):
                    rewritten: mutable darray[Ast::Expr] = []
                    if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or elements.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return Ast::Expr.Invalid
                    work <- work + elements.count
                    for element in elements |rewritten, source_term, replacement, work, depth|:
                        rewritten.push(proof_replay_precondition_replace_source_term_with_work(element, source_term, replacement, work, depth + 1))
                    return Ast::Expr.Array(rewritten, position)
                Ast::Expr.Tuple(elements, position):
                    rewritten: mutable darray[Ast::Expr] = []
                    if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or elements.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return Ast::Expr.Invalid
                    work <- work + elements.count
                    for element in elements |rewritten, source_term, replacement, work, depth|:
                        rewritten.push(proof_replay_precondition_replace_source_term_with_work(element, source_term, replacement, work, depth + 1))
                    return Ast::Expr.Tuple(rewritten, position)
                _:
                    return Ast::Expr.Invalid

        def proof_replay_precondition_contract_expr_matches(report: ProofReport&, trace: ProofFactTrace, requirement: Ast::Expr, candidate_source_cost: usize, work: mutable usize&) -> bool:
            return false if:
                not proof_replay_precondition_expr_repetition_charge(requirement, 2, work)
                not proof_replay_precondition_expr_repetition_charge(trace.expression, 2, work)
            return true if proof_replay_expr_equal_depth(requirement, trace.expression, 0)
            # Global immutable literals are substituted before entry facts are recorded. Rebuild
            # that normalization only from source-validated constant facts owned by this exact
            # function; mutable or shadowed names have no such witness.
            normalized: mutable Ast::Expr = requirement
            for candidate in report.analysis_1.traces.records |normalized, report, trace, candidate_source_cost, work|:
                return false if:
                    not proof_replay_precondition_work_add(work, 1)
                    not proof_replay_precondition_work_add(work, sview_len(candidate.name))
                    not proof_replay_precondition_work_add(work, sview_len(candidate.kind))
                continue if candidate.name != trace.name or candidate.owner_line != trace.line
                continue if candidate.kind != "global-constant" and candidate.kind != "global-constant-qualified"
                return false if:
                    not proof_replay_precondition_work_add(work, candidate_source_cost)
                    not proof_replay_precondition_expr_repetition_charge(candidate.expression, 1, work)
                continue if not proof_replay_global_constant_fact_is_valid_with_work(report, candidate, work)
                match candidate.expression:
                    Ast::Expr.Binary(source_term, TokenKind.EqEq, constant_value, _):
                        normalized <- proof_replay_precondition_replace_source_term_with_work(normalized, source_term, constant_value, work, 0)
                    _:
                        pass
                return false if proof_replay_expr_is_invalid(normalized)
            return false if:
                not proof_replay_precondition_expr_repetition_charge(normalized, 2, work)
                not proof_replay_precondition_expr_repetition_charge(trace.expression, 2, work)
            return not proof_replay_expr_is_invalid(normalized) and proof_replay_expr_equal_depth(normalized, trace.expression, 0)

        def proof_replay_precondition_body_contract_matches(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt], candidate_source_cost: usize, work: mutable usize&) -> bool:
            leading: mutable bool = true
            for statement in body |leading, report, trace, candidate_source_cost, work|:
                return false if not proof_replay_precondition_work_add(work, 1)
                match statement:
                    Ast::Stmt.Contract(kind, requirement, _):
                        if kind == "requires":
                            return false if not leading
                            return true if proof_replay_precondition_contract_expr_matches(report, trace, requirement, candidate_source_cost, work)
                        else:
                            leading <- false
                    _:
                        leading <- false
            return false

        # The retained signature table is keyed by source line, which is not a unique function
        # identity when declarations share a line. Bind each clause expression to the nearest
        # preceding function declaration on that line; absent or tied offsets are ambiguous.
        def proof_replay_precondition_signature_clause_owned_by(declarations: darray[Ast::Decl]&, declaration_line: u32, expression_offset: u32, best_offset: mutable u32&, best_name: mutable sview&, best_matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_PRECONDITION_DEPTH_LIMIT
            for declaration in declarations |declaration_line, expression_offset, best_offset, best_name, best_matches, work, depth|:
                return false if not proof_replay_precondition_work_add(work, 1)
                match declaration:
                    Ast::Decl.Func(candidate, _, _, _, _, _, position):
                        if position.line == declaration_line and position.offset <= expression_offset:
                            return false if not proof_replay_precondition_work_add(work, sview_len(candidate))
                            if best_matches == 0 or position.offset > best_offset:
                                best_offset <- position.offset
                                best_name <- candidate
                                best_matches <- 1
                            elif position.offset == best_offset:
                                best_matches <- best_matches + 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_precondition_signature_clause_owned_by(nested, declaration_line, expression_offset, best_offset, best_name, best_matches, work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        pass
            return true

        def proof_replay_precondition_signature_clause_matches(report: ProofReport&, trace: ProofFactTrace, declaration_line: u32, owner_offset: u32, requirement: Ast::Expr, candidate_source_cost: usize, work: mutable usize&) -> bool:
            best_offset: mutable u32 = 0
            best_name: mutable sview = ""
            best_matches: mutable usize = 0
            expression_position: Ast::Pos = Ast::expr_pos(requirement)
            return false if:
                expression_position.offset <= owner_offset
                not proof_replay_precondition_signature_clause_owned_by(report.source.source_declarations, declaration_line, expression_position.offset, &best_offset, &best_name, &best_matches, work, 0)
                best_matches != 1 or best_name != trace.name or best_offset != owner_offset
            return proof_replay_precondition_contract_expr_matches(report, trace, requirement, candidate_source_cost, work)

        def proof_replay_resource_disjoint_precondition_body_site_matches(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt], source_work: mutable usize&) -> bool:
            leading: mutable bool = true
            matches: mutable usize = 0
            for statement in body |leading, report, trace, source_work, matches|:
                return false if not proof_replay_precondition_work_add(source_work, 1)
                match statement:
                    Ast::Stmt.Contract(kind, requirement, _):
                        if kind == "requires":
                            continue if not leading
                            return false if:
                                not proof_replay_precondition_expr_repetition_charge(requirement, 2, source_work)
                                not proof_replay_precondition_expr_repetition_charge(trace.expression, 2, source_work)
                            if proof_replay_expr_equal_depth(requirement, trace.expression, 0):
                                position_work: mutable usize = 0
                                same_positions: bool = proof_replay_trace_expression_positions_equal_with_work(requirement, trace.expression, 0, &position_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                return false if not proof_replay_precondition_work_add(source_work, position_work)
                                matches <- matches + 1 if same_positions
                                return false if matches > 1
                        else:
                            leading <- false
                    _:
                        leading <- false
            return matches == 1

        # Resource-disjoint events have no source position at which to check whether an
        # entry fact is still live. Admit only the narrow case that is stable for the whole
        # function: a direct `usize` parameter inequality from a leading `requires`, with
        # immutable by-value parameters that are neither shadowed nor touched anywhere in
        # the body. The ordinary precondition validator remains tied to its exact consumer.
        def proof_replay_resource_disjoint_precondition_is_stable(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.kind != "precondition" or trace.name == "" or trace.line == 0 or trace.owner_line != 0
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(left_name, _), TokenKind.BangEq, Ast::Expr.Ident(right_name, _), _):
                    return false if left_name == "" or right_name == "" or left_name == right_name
                    return false if not proof_replay_summary_owner_source_preflight(report, trace.name, trace.line, source_work)
                    return false if not proof_replay_precondition_source_tree_charge(report.source.source_declarations, source_work, 0, 0)
                    return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                    matches: mutable usize = 0
                    owner_offset: mutable u32 = 0
                    parameters: mutable darray[Ast::ParamDecl] = []
                    body: mutable darray[Ast::Stmt] = []
                    proof_replay_precondition_find_owner(report.source.source_declarations, trace.name, trace.line, &matches, &owner_offset, &parameters, &body, 0)
                    return false if matches != 1
                    return false if not proof_replay_resource_disjoint_precondition_body_site_matches(report, trace, body, source_work)
                    left_matches: mutable usize = 0
                    right_matches: mutable usize = 0
                    for parameter in parameters |left_name, right_name, left_matches, right_matches, source_work|:
                        return false if not proof_replay_precondition_work_add(source_work, 1)
                        return false if not proof_replay_precondition_work_add(source_work, sview_len(parameter.name))
                        continue if parameter.name != left_name and parameter.name != right_name
                        return false if parameter.is_mutable or parameter.has_default or parameter.is_affine
                        match parameter.type_expression:
                            Ast::Expr.Ident("usize", _):
                                scalar: (complete: bool, scalar: bool) = proof_replay_resource_scalar_type_with_work(parameter.type_expression, report, source_work, 0)
                                return false if not scalar.complete or not scalar.scalar
                            _:
                                return false
                        left_matches <- left_matches + 1 if parameter.name == left_name
                        right_matches <- right_matches + 1 if parameter.name == right_name
                    return false if left_matches != 1 or right_matches != 1
                    return false if:
                        proof_replay_source_body_declares_with_work(report.source.source_declarations, body, left_name, source_work)
                        proof_replay_source_body_declares_with_work(report.source.source_declarations, body, right_name, source_work)
                        proof_replay_source_body_touches_with_work(report.source.source_declarations, body, left_name, true, source_work)
                        proof_replay_source_body_touches_with_work(report.source.source_declarations, body, right_name, true, source_work)
                    operator_mask_status: (complete: bool, mask: usize) = proof_source_analysis_operator_mask_from_source(report.source.source_declarations, report.source.source_annotations, source_work)
                    return false if not operator_mask_status.complete
                    operator_work_exhausted: mutable bool = false
                    return false if proof_source_expression_has_overloaded_operator_with_work(trace.expression, operator_mask_status.mask, source_work, operator_work_exhausted) or operator_work_exhausted
                    return true
                _:
                    return false

        def proof_replay_resource_disjoint_precondition_is_stable_cached(report: ProofReport&, trace_index: usize, trace: ProofFactTrace, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if not proof_replay_precondition_work_add(source_work, 1)
            trace_count: usize = report.analysis_1.traces.records.count
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if cache.resource_precondition_report_identity != report_identity or cache.resource_precondition_source_identity != source_identity or cache.resource_precondition_trace_count != trace_count or cache.resource_precondition_statuses.count != trace_count:
                return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or trace_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + trace_count
                cache.resource_precondition_statuses.resize(trace_count)
                for index in 0..<trace_count |index, cache|:
                    cache.resource_precondition_statuses[index] <- 0
                cache.resource_precondition_report_identity <- report_identity
                cache.resource_precondition_source_identity <- source_identity
                cache.resource_precondition_trace_count <- trace_count
            return false if trace_index >= trace_count
            status: u8 = cache.resource_precondition_statuses[trace_index]
            return true if status == 1
            return false if status == 2
            stable: bool = proof_replay_resource_disjoint_precondition_is_stable(report, trace, source_work)
            cache.resource_precondition_statuses[trace_index] <- 1 if stable else 2
            return stable

        def proof_replay_precondition_source_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_precondition_source_valid_with_work(report, trace, &work)

        def proof_replay_precondition_source_valid_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.kind != "precondition" or trace.name == "" or trace.line == 0 or trace.owner_line != 0
            source_start: usize = source_work
            return false if not proof_replay_summary_owner_source_preflight(report, trace.name, trace.line, source_work)
            if source_work < source_start:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            owner_scan_cost: usize = source_work - source_start
            source_tree_start: usize = source_work
            return false if not proof_replay_precondition_source_tree_charge(report.source.source_declarations, source_work, 0, 0)
            if source_work < source_tree_start:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            source_tree_cost: usize = source_work - source_tree_start
            signature_rows: usize = report.source_contracts.source_signature_contract_lines.count
            return false if:
                signature_rows != report.source_contracts.source_signature_contract_kinds.count
                signature_rows != report.source_contracts.source_signature_contracts.count
                signature_rows > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + signature_rows
            for index in 0..<signature_rows |index, report, source_work|:
                return false if not proof_replay_summary_expr_charge_with_work(report.source_contracts.source_signature_contracts[index], source_work)
            return false if:
                not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                report.analysis_1.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + report.analysis_1.traces.records.count
            for candidate in report.analysis_1.traces.records |source_work|:
                candidate_name_work: usize = sview_len(candidate.name)
                candidate_kind_work: usize = sview_len(candidate.kind)
                return false if:
                    source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    candidate_name_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + candidate_name_work
                return false if candidate_kind_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + candidate_kind_work
                if candidate.name == trace.name and candidate.owner_line == trace.line and (candidate.kind in {"global-constant", "global-constant-qualified"}):
                    return false if not proof_replay_summary_expr_charge_with_work(candidate.expression, source_work)
            return false if:
                owner_scan_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_tree_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - owner_scan_cost) / 3
            # A candidate may traverse declarations while locating its owner, resolving the
            # function-local constant, and checking the root binding. Reserve all three scans.
            source_candidate_scan_cost: usize = owner_scan_cost + source_tree_cost * 3
            return proof_replay_precondition_source_valid_after_preflight(report, trace, source_work, source_candidate_scan_cost)

        # A `requires` clause establishes an entry-state fact. It can be used at a later proof
        # point only while every value named by that fact is unchanged. Tie the consumer to the
        # exact source goal, then scan the source prefix for writes to parameters and mutable
        # globals whenever the fact depends on either. Scan every such root because two formal
        # references may alias even when their names differ. A call inside the precondition can
        # hide a global read behind its callee, so call-bearing facts conservatively depend on all
        # global roots. Calls in executable statements are rejected in this case because they may
        # mutate a global or an aliased parameter without naming the affected root at the call
        # site. A containing statement is scanned whole, so writes later within the same statement
        # conservatively invalidate the fact too.
        def proof_replay_precondition_live_at_consumer(report: ProofReport&, trace: ProofFactTrace, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, source_work: mutable usize&) -> bool:
            consumer_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            return false if not proof_replay_mutable_local_consumer_position_with_work(report, trace, body, &consumer_position, source_work)
            return false if consumer_position.offset == 0
            depends_on_mutable_state: mutable bool = false
            return false if not proof_replay_precondition_expr_repetition_charge(trace.expression, 1, source_work)
            call_dependent: bool = proof_replay_expression_contains_call_node(trace.expression, 0)
            may_alias_global: mutable bool = call_dependent
            depends_on_mutable_state <- true if call_dependent
            for parameter in parameters |report, trace, body, consumer_position, source_work|:
                return false if:
                    not proof_replay_precondition_work_add(source_work, 1)
                    not proof_replay_precondition_work_add(source_work, sview_len(parameter.name))
                    not proof_replay_precondition_expr_repetition_charge(trace.expression, 1, source_work)
                parameter_used: bool = parameter.name != "" and proof_expr_mentions_name(trace.expression, parameter.name)
                depends_on_mutable_state <- true if parameter_used
                if parameter_used:
                    may_alias_global <- true if proof_replay_precondition_parameter_may_alias_global(report, parameter.type_expression, source_work)
                    return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for annotation in report.source.source_annotations |report, trace, body, consumer_position, source_work|:
                return false if:
                    not proof_replay_precondition_work_add(source_work, 1)
                    not proof_replay_precondition_work_add(source_work, sview_len(annotation.name))
                    not proof_replay_precondition_work_add(source_work, sview_len(annotation.owner))
                continue if annotation.name != "__global_mutable" or annotation.owner == ""
                return false if not proof_replay_precondition_expr_repetition_charge(trace.expression, 1, source_work)
                depends_on_mutable_state <- true if proof_expr_mentions_name(trace.expression, annotation.owner)
            depends_on_mutable_state <- true if proof_replay_precondition_mentions_mutable_global(report.source.source_declarations, trace.expression, source_work, 0)
            return true if not depends_on_mutable_state
            for statement in body |report, body, parameters, consumer_position, source_work|:
                position: Ast::Pos = proof_replay_statement_position(statement)
                return false if position.offset == 0
                break if position.offset >= consumer_position.offset
                match statement:
                    # Contract expressions are checked as propositions and do not execute in
                    # the function's state. Their calls are separately restricted to pure calls.
                    Ast::Stmt.Contract(_, _, _):
                        pass
                    _:
                        return false if proof_replay_precondition_statement_introduces_state_alias(report, parameters, statement, source_work, 0)
                        single_statement: darray[Ast::Stmt] = [statement]
                        return false if proof_replay_source_body_has_call(single_statement, source_work, 0)
                for parameter in parameters |report, parameters, statement, source_work|:
                    return false if:
                        not proof_replay_precondition_work_add(source_work, 1)
                        not proof_replay_precondition_work_add(source_work, sview_len(parameter.name))
                    continue if parameter.name == ""
                    return false if proof_replay_source_statement_touches_with_work(report.source.source_declarations, statement, parameter.name, true, source_work)
                for annotation in report.source.source_annotations |report, statement, source_work|:
                    return false if:
                        not proof_replay_precondition_work_add(source_work, 1)
                        not proof_replay_precondition_work_add(source_work, sview_len(annotation.name))
                        not proof_replay_precondition_work_add(source_work, sview_len(annotation.owner))
                    continue if annotation.name != "__global_mutable" or annotation.owner == ""
                    return false if proof_replay_source_statement_touches_with_work(report.source.source_declarations, statement, annotation.owner, true, source_work)
                return false if proof_replay_precondition_statement_touches_mutable_global(report.source.source_declarations, trace.expression, statement, may_alias_global, source_work, 0)
            return true

        def proof_replay_precondition_source_valid_after_preflight(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&, candidate_source_cost: usize) -> bool:
            return false if:
                trace.kind != "precondition" or trace.name == "" or trace.line == 0 or trace.owner_line != 0
                report.analysis_2.replay_owner_line != 0 and report.analysis_2.replay_owner_line != trace.line
            matches: mutable usize = 0
            owner_offset: mutable u32 = 0
            parameters: mutable darray[Ast::ParamDecl] = []
            body: mutable darray[Ast::Stmt] = []
            proof_replay_precondition_find_owner(report.source.source_declarations, trace.name, trace.line, &matches, &owner_offset, &parameters, &body, 0)
            return false if matches != 1
            return false if not proof_replay_precondition_live_at_consumer(report, trace, parameters, body, source_work)
            # A source-exact precondition can still invoke an implicit protocol through
            # operator syntax. Entry facts are reusable only when replay can establish that
            # the expression stays within builtin dispatch; this includes Index.__index__,
            # whose call is absent from the AST's explicit Call nodes. The source-admission
            # pass already matched this cached mask against the independently parsed source.
            operator_mask: (complete: bool, mask: usize) = proof_source_primitive_operator_mask_from_report_with_work(report, source_work)
            return false if not operator_mask.complete
            operator_work_exhausted: mutable bool = false
            return false if proof_source_expression_has_overloaded_operator_with_work(trace.expression, operator_mask.mask, source_work, operator_work_exhausted) or operator_work_exhausted
            return true if proof_replay_precondition_body_contract_matches(report, trace, body, candidate_source_cost, source_work)
            # Signature clauses are retained from the parser and keyed by the unique owner's
            # declaration line. Only `requires` rows can establish entry assumptions.
            rows: usize = report.source_contracts.source_signature_contract_lines.count
            return false if:
                rows != report.source_contracts.source_signature_contract_kinds.count
                rows != report.source_contracts.source_signature_contracts.count
            for index in 0..<rows |index, report, trace, source_work|:
                return false if not proof_replay_precondition_work_add(source_work, 1)
                continue if report.source_contracts.source_signature_contract_lines[index] != trace.line
                continue if report.source_contracts.source_signature_contract_kinds[index] != "requires"
                requirement: Ast::Expr = report.source_contracts.source_signature_contracts[index]
                return true if proof_replay_precondition_signature_clause_matches(report, trace, trace.line, owner_offset, requirement, candidate_source_cost, source_work)
            for parameter in parameters |report, trace, parameters|:
                return true if parameter.name != "" and proof_replay_precondition_refinement_matches(parameter.type_expression, report.source.source_declarations, parameters, parameter.name, trace.expression, source_work, 0)
            return false
