# A threaded call `f(&x)` (value_threading.elisa) records its summary with one extra binding per
# exclusive reference parameter, `__threaded_state = S`, naming the fresh symbol for that
# parameter's value after the call; the parameter's own binding is the local's value before it.
# Replay re-derives the instance from the callee's source contract by reading `p[0]` as S and
# `old(p[0])` as `p` (the entry value), exactly as the producer did, and accepts it only when
#   - the callee is one declaration with no Unsafe effect, no region parameter (a lend that can
#     outlive the call) and no reference result, whose reference parameters are all mutable and
#     each receives one threaded binding, in parameter order;
#   - each threaded argument of the source call is `&x`, `mutable x`, `lmut x` or `x` for a local
#     `x` declared in the owner by a non-reference declaration (not a parameter or a global);
#   - each S is a rebind symbol that no local binding defines and no other call threads;
#   - every contract mentions a threaded parameter only as `p[0]` or `old(p[0])`.
extend ElisaProof:
    private:
        # The unique source declaration of the callee and whether it may thread.
        def proof_replay_thread_callee_find_with_work(declarations: darray[Ast::Decl]&, source_report: mutable ProofReport&, name: sview, line: u32, found: mutable usize&, safe: mutable bool&, mutable_slots: mutable darray[usize]&, current_path: darray[sview]&, found_path: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_REPLAY_THREAD_DEPTH_LIMIT or work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                found <- 2
                return false
            work <- work + declarations.count
            for declaration in declarations |name, line, found, safe, mutable_slots, current_path, found_path, work, depth, source_report|:
                match declaration:
                    Ast::Decl.Func(candidate, parameters, return_type, _, effects, _, position):
                        return false if sview_len(candidate) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(candidate)
                        if candidate == name and position.line == line:
                            found <- found + 1
                            found_path.clear()
                            for segment in current_path |segment, found_path, work|:
                                return false if not proof_replay_generic_param_work_add(work, sview_len(segment))
                                found_path.push(segment)
                            mutable_slots.clear()
                            safe <- true
                            return false if effects.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + effects.count
                            for effect in effects |work, safe|:
                                return false if sview_len(effect) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                                work <- work + sview_len(effect)
                                safe <- false if sview_starts_with(effect, "Unsafe")
                            if return_type is declared:
                                return_has_generic: bool = proof_replay_thread_type_mentions_owner_generic_with_work(declared, position.line, position.offset.usize(), true, source_report, work, 0)
                                return_reference_syntax: (complete: bool, has_reference: bool) = proof_replay_thread_type_has_reference_syntax(declared, source_report, found_path, work, 0)
                                return_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(declared, source_report.source.source_declarations, source_report.source_types.source_generic_param_lines, source_report.source_types.source_generic_param_names, position.line, position.offset, source_report.source_types.source_generic_owner_params_valid, source_report.source_types.source_effect_index, source_report.source_types.source_generic_params_valid and source_report.source_types.source_generic_param_lines.count == source_report.source_types.source_generic_param_names.count, work)
                                direct_return_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_replay_thread_direct_type_markers(declared, source_report, found_path, work, 0)
                                return_borrowed_storage: (complete: bool, borrowed: bool) = proof_replay_thread_type_contains_borrowed_storage(declared, source_report, found_path, work, 0)
                                return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                safe <- false if return_has_generic or not return_reference_syntax.complete or return_reference_syntax.has_reference or not return_borrowed_storage.complete or return_borrowed_storage.borrowed or return_markers.reference or not proof_replay_thread_markers_cover_direct_syntax(return_markers, direct_return_markers)
                            return false if parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + parameters.count
                            for index in 0..<parameters.count |index, parameters, safe, mutable_slots, work, source_report|:
                                return false if sview_len(parameters[index].name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                                work <- work + sview_len(parameters[index].name)
                                parameter_has_generic: bool = proof_replay_thread_type_mentions_owner_generic_with_work(parameters[index].type_expression, position.line, position.offset.usize(), true, source_report, work, 0)
                                parameter_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(parameters[index].type_expression, source_report.source.source_declarations, source_report.source_types.source_generic_param_lines, source_report.source_types.source_generic_param_names, position.line, position.offset, source_report.source_types.source_generic_owner_params_valid, source_report.source_types.source_effect_index, source_report.source_types.source_generic_params_valid and source_report.source_types.source_generic_param_lines.count == source_report.source_types.source_generic_param_names.count, work)
                                direct_parameter_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_replay_thread_direct_type_markers(parameters[index].type_expression, source_report, found_path, work, 0)
                                parameter_storage_type: Ast::Expr = proof_replay_thread_parameter_storage_type(parameters[index].type_expression, 0)
                                parameter_reference_syntax: (complete: bool, has_reference: bool) = proof_replay_thread_type_has_reference_syntax(parameter_storage_type, source_report, found_path, work, 0)
                                parameter_borrowed_storage: (complete: bool, borrowed: bool) = proof_replay_thread_type_contains_borrowed_storage(parameter_storage_type, source_report, found_path, work, 0)
                                return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                safe <- false if parameter_has_generic
                                safe <- false if not parameter_reference_syntax.complete or parameter_reference_syntax.has_reference or not parameter_borrowed_storage.complete or parameter_borrowed_storage.borrowed
                                continue if not parameter_markers.reference
                                safe <- false if not proof_replay_thread_markers_cover_direct_syntax(parameter_markers, direct_parameter_markers) or not parameter_markers.mutable_reference
                                mutable_slots.push(index)
                    Ast::Decl.Module(module_name, nested, _):
                        nested_path: (complete: bool, scope: darray[sview]) = proof_replay_global_constant_scope_with_module_and_work(current_path, module_name, work)
                        return false if not nested_path.complete
                        return false if not proof_replay_thread_callee_find_with_work(nested, source_report, name, line, found, safe, mutable_slots, nested_path.scope, found_path, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_thread_callee_find_with_work(nested, source_report, name, line, found, safe, mutable_slots, current_path, found_path, work, depth + 1)
                    Ast::Decl.Invalid:
                        found <- 2
                        return false
                    _:
                        pass
            return true

        # Without an explicit type, only obvious scalar literals and their parenthesized forms
        # establish a non-reference initializer. Unknown expressions fail closed.
        def proof_replay_thread_inferred_initializer_may_reference(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> bool:
            return true if depth >= PROOF_REPLAY_THREAD_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work <- source_work + 1
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.Paren(inner, _):
                    return proof_replay_thread_inferred_initializer_may_reference(inner, source_work, depth + 1)
                _:
                    return true

        # Inspect nested expression scopes too: calls can occur in value blocks, matches,
        # comprehensions, and recovery expressions inside an otherwise ordinary statement.
        def proof_replay_thread_expression_scopes(expression: Ast::Expr, local_name: sview, report: mutable ProofReport&, count: mutable usize&, reference: mutable bool&, source_work: mutable usize&, depth: usize) -> void:
            return if reference
            if depth >= PROOF_REPLAY_THREAD_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                count <- 2
                reference <- true
                return
            source_work <- source_work + 1
            match expression:
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    proof_replay_thread_expression_scopes(inner, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.Is:
                        count <- 2
                        reference <- true
                        return
                    proof_replay_thread_expression_scopes(left, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(right, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Index(left, right, _) | Ast::Expr.Refinement(left, right, _):
                    proof_replay_thread_expression_scopes(left, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(right, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_replay_thread_expression_scopes(callee, local_name, report, count, reference, source_work, depth + 1)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or arguments.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        count <- 2
                        reference <- true
                        return
                    source_work <- source_work + arguments.count
                    for argument in arguments |argument, local_name, report, count, reference, source_work, depth|:
                        proof_replay_thread_expression_scopes(argument, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Field(base, _, _) | Ast::Expr.Scope(base, _, _):
                    proof_replay_thread_expression_scopes(base, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Slice(base, low, high, _):
                    proof_replay_thread_expression_scopes(base, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(low, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(high, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.IndexN(base, elements, _):
                    proof_replay_thread_expression_scopes(base, local_name, report, count, reference, source_work, depth + 1)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or elements.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        count <- 2
                        reference <- true
                        return
                    source_work <- source_work + elements.count
                    for element in elements |element, local_name, report, count, reference, source_work, depth|:
                        proof_replay_thread_expression_scopes(element, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or elements.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        count <- 2
                        reference <- true
                        return
                    source_work <- source_work + elements.count
                    for element in elements |element, local_name, report, count, reference, source_work, depth|:
                        proof_replay_thread_expression_scopes(element, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or entries.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        count <- 2
                        reference <- true
                        return
                    source_work <- source_work + entries.count
                    for entry in entries |entry, local_name, report, count, reference, source_work, depth|:
                        proof_replay_thread_expression_scopes(entry.key, local_name, report, count, reference, source_work, depth + 1)
                        proof_replay_thread_expression_scopes(entry.value, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    proof_replay_thread_expression_scopes(base, local_name, report, count, reference, source_work, depth + 1)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or fields.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        count <- 2
                        reference <- true
                        return
                    source_work <- source_work + fields.count
                    for field in fields |field, local_name, report, count, reference, source_work, depth|:
                        proof_replay_thread_expression_scopes(field.value, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    proof_replay_thread_expression_scopes(condition, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(yes, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(no, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Comprehension(name, iterable, condition, value, _):
                    if not proof_replay_thread_name_compare_work_charge(name, local_name, source_work):
                        count <- 2
                        reference <- true
                        return
                    reference <- true if name == local_name
                    proof_replay_thread_expression_scopes(iterable, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(condition, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(value, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Match(value, arms, _) | Ast::Expr.Catch(value, arms, _):
                    proof_replay_thread_expression_scopes(value, local_name, report, count, reference, source_work, depth + 1)
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or arms.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        count <- 2
                        reference <- true
                        return
                    source_work <- source_work + arms.count
                    for arm in arms |arm, local_name, report, count, reference, source_work, depth|:
                        bindings: mutable darray[sview] = []
                        if not proof_replay_call_pattern_bindings_with_work(arm.pattern, &bindings, source_work, depth + 1):
                            count <- 2
                            reference <- true
                            return
                        for binding in bindings |binding, local_name, count, reference, source_work|:
                            if not proof_replay_thread_name_compare_work_charge(binding, local_name, source_work):
                                count <- 2
                                reference <- true
                                return
                            if binding == local_name:
                                reference <- true
                                return
                        proof_replay_thread_expression_scopes(arm.guard, local_name, report, count, reference, source_work, depth + 1)
                        proof_replay_thread_local_declarations(arm.body, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.GetElse(value, recovery, _):
                    proof_replay_thread_expression_scopes(value, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_local_declarations(recovery, local_name, report, count, reference, source_work, depth + 1)
                Ast::Expr.Block(nested, value, captures, _):
                    if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or captures.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                        count <- 2
                        reference <- true
                        return
                    source_work <- source_work + captures.count
                    for capture in captures |capture, local_name, count, reference, source_work|:
                        if not proof_replay_thread_name_compare_work_charge(capture, local_name, source_work):
                            count <- 2
                            reference <- true
                            return
                        reference <- true if capture == local_name
                    proof_replay_thread_local_declarations(nested, local_name, report, count, reference, source_work, depth + 1)
                    proof_replay_thread_expression_scopes(value, local_name, report, count, reference, source_work, depth + 1)
                _:
                    count <- 2
                    reference <- true

        # Declarations of `local_name` in an owner body: (count, any of them a reference).
        def proof_replay_thread_local_declarations(body: darray[Ast::Stmt]&, local_name: sview, source_report: mutable ProofReport&, count: mutable usize&, reference: mutable bool&, source_work: mutable usize&, depth: usize) -> void:
            return if reference
            if depth >= PROOF_REPLAY_THREAD_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                count <- 2
                reference <- true
                return
            source_work <- source_work + body.count
            for statement in body |local_name, source_report, count, reference, source_work, depth|:
                return if reference
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, initializer, _):
                        if not proof_replay_thread_name_compare_work_charge(name, local_name, source_work):
                            count <- 2
                            reference <- true
                            return
                        if name == local_name:
                            count <- count + 1
                            inferred_reference: bool = false
                            match type_expression:
                                Ast::Expr.Absent:
                                    inferred_reference <- proof_replay_thread_inferred_initializer_may_reference(initializer, source_work, 0)
                                _:
                                    type_has_generic: bool = proof_replay_thread_type_mentions_owner_generic_with_work(type_expression, source_report.analysis_2.replay_owner_line, source_report.analysis_2.replay_owner_offset, source_report.analysis_2.replay_owner_offset_valid, source_report, source_work, 0)
                                    markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(type_expression, source_report.source.source_declarations, source_report.source_types.source_generic_param_lines, source_report.source_types.source_generic_param_names, source_report.analysis_2.replay_owner_line, source_report.analysis_2.replay_owner_offset.u32(), source_report.analysis_2.replay_owner_offset_valid and source_report.source_types.source_generic_owner_params_valid, source_report.source_types.source_effect_index, source_report.source_types.source_generic_params_valid and source_report.source_types.source_generic_param_lines.count == source_report.source_types.source_generic_param_names.count, source_work)
                                    owner_path: (complete: bool, path: darray[sview]) = proof_replay_thread_active_owner_path(source_report, source_work)
                                    if not owner_path.complete:
                                        count <- 2
                                        reference <- true
                                        return
                                    type_reference_syntax: (complete: bool, has_reference: bool) = proof_replay_thread_type_has_reference_syntax(type_expression, source_report, owner_path.path, source_work, 0)
                                    type_borrowed_storage: (complete: bool, borrowed: bool) = proof_replay_thread_type_contains_borrowed_storage(type_expression, source_report, owner_path.path, source_work, 0)
                                    reference <- true if type_has_generic or not type_reference_syntax.complete or type_reference_syntax.has_reference or markers.reference or not markers.complete or not type_borrowed_storage.complete or type_borrowed_storage.borrowed
                            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                count <- 2
                                reference <- true
                                return
                            reference <- true if inferred_reference
                        proof_replay_thread_expression_scopes(initializer, local_name, source_report, count, reference, source_work, depth + 1)
                    Ast::Stmt.Assign(target, operator, value, _):
                        if operator == TokenKind.Assign:
                            match target:
                                Ast::Expr.Ident(name, _):
                                    if not proof_replay_thread_name_compare_work_charge(name, local_name, source_work):
                                        count <- 2
                                        reference <- true
                                        return
                                    if name == local_name:
                                        reference <- true
                                        return
                                _:
                                    reference <- true
                                    return
                        proof_replay_thread_expression_scopes(target, local_name, source_report, count, reference, source_work, depth + 1)
                        proof_replay_thread_expression_scopes(value, local_name, source_report, count, reference, source_work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        proof_replay_thread_expression_scopes(condition, local_name, source_report, count, reference, source_work, depth + 1)
                        proof_replay_thread_local_declarations(yes, local_name, source_report, count, reference, source_work, depth + 1)
                        proof_replay_thread_local_declarations(no, local_name, source_report, count, reference, source_work, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        proof_replay_thread_expression_scopes(condition, local_name, source_report, count, reference, source_work, depth + 1)
                        proof_replay_thread_local_declarations(nested, local_name, source_report, count, reference, source_work, depth + 1)
                    Ast::Stmt.For(_, variables, iterable, nested, _):
                        if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or variables.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                            count <- 2
                            reference <- true
                            return
                        source_work <- source_work + variables.count
                        for variable in variables |variable, local_name, count, reference, source_work|:
                            if not proof_replay_thread_name_compare_work_charge(variable, local_name, source_work):
                                count <- 2
                                reference <- true
                                return
                            if variable == local_name:
                                reference <- true
                                return
                        proof_replay_thread_expression_scopes(iterable, local_name, source_report, count, reference, source_work, depth + 1)
                        proof_replay_thread_local_declarations(nested, local_name, source_report, count, reference, source_work, depth + 1)
                    Ast::Stmt.Match(value, arms, _):
                        proof_replay_thread_expression_scopes(value, local_name, source_report, count, reference, source_work, depth + 1)
                        if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or arms.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                            count <- 2
                            reference <- true
                            return
                        source_work <- source_work + arms.count
                        for arm in arms |local_name, source_report, count, reference, source_work, depth|:
                            pattern_bindings: mutable darray[sview] = []
                            if not proof_replay_call_pattern_bindings_with_work(arm.pattern, &pattern_bindings, source_work, depth + 1):
                                count <- 2
                                reference <- true
                                return
                            for pattern_binding in pattern_bindings |pattern_binding, local_name, count, reference, source_work|:
                                if not proof_replay_thread_name_compare_work_charge(pattern_binding, local_name, source_work):
                                    count <- 2
                                    reference <- true
                                    return
                                if pattern_binding == local_name:
                                    reference <- true
                                    return
                            proof_replay_thread_local_declarations(arm.body, local_name, source_report, count, reference, source_work, depth + 1)
                    Ast::Stmt.Block(_, _, binding, nested, _):
                        if not proof_replay_thread_name_compare_work_charge(binding, local_name, source_work):
                            count <- 2
                            reference <- true
                            return
                        if binding != "" and binding == local_name:
                            reference <- true
                            return
                        proof_replay_thread_local_declarations(nested, local_name, source_report, count, reference, source_work, depth + 1)
                    Ast::Stmt.Expr(value, _) | Ast::Stmt.Return(value, _) | Ast::Stmt.Contract(_, value, _):
                        proof_replay_thread_expression_scopes(value, local_name, source_report, count, reference, source_work, depth + 1)
                    Ast::Stmt.Invalid:
                        count <- 2
                        reference <- true
                        return
                    _:
                        pass

        # The threaded local an argument names, or "".
        def proof_replay_thread_argument_local(argument: Ast::Expr) -> sview:
            match argument:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_thread_argument_local(inner)
                Ast::Expr.Unary(operator, Ast::Expr.Ident(name, _), _):
                    return name if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    return ""
                Ast::Expr.Ident(name, _):
                    return name
                _:
                    return ""

        # The source call with each threaded argument read as its local, for the argument match.
        def proof_replay_thread_call_arguments(call: Ast::Expr, threading: ProofReplayThreading&) -> Ast::Expr:
            match call:
                Ast::Expr.Call(callee, arguments, names, position):
                    return call if any argument_name in names where argument_name != ""
                    rewritten: mutable darray[Ast::Expr] = []
                    for index in 0..<arguments.count |index, arguments, threading, rewritten|:
                        local_name: sview = proof_replay_thread_argument_local(arguments[index])
                        threaded: bool = any slot in threading.slots where slot == index
                        rewritten.push(Ast::Expr.Ident(local_name, Ast::expr_pos(arguments[index])) if threaded and local_name != "" else arguments[index])
                    return Ast::Expr.Call(callee, rewritten, names, position)
                _:
                    return call

        def proof_replay_summary_threading_with_work(report: ProofReport&, source_report: mutable ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, call: Ast::Expr, source_work: mutable usize&) -> ProofReplayThreading can[Memory.Allocate, Abort.Panic]:
            return proof_replay_threading_none(false) if not proof_replay_summary_expr_charge_with_work(call, source_work)
            first: usize = trace.summary_bindings_start + summary.parameters_count + 1
            count: mutable usize = 0
            while first + count < trace.summary_bindings_start + trace.summary_bindings_count and first + count < report.analysis_1.traces.summary_names.count and report.analysis_1.traces.summary_names[first + count] == "__threaded_state" |count, first, trace, report|:
                return proof_replay_threading_none(false) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                count <- count + 1
            return proof_replay_threading_none(true) if count == 0
            return proof_replay_threading_none(false) if not proof_replay_mutable_local_trace_work_charge(report, source_work, count)
            repeated_call_cost: mutable usize = 0
            return proof_replay_threading_none(false) if:
                not proof_replay_summary_expr_cost(call, &repeated_call_cost, source_work, 0)
                repeated_call_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / count
            source_work <- source_work + repeated_call_cost * count
            return proof_replay_threading_none(false) if source_report.source_contracts.source_region_param_lines.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + source_report.source_contracts.source_region_param_lines.count
            return proof_replay_threading_none(false) if not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, source_work)
            invalid: ProofReplayThreading = proof_replay_threading_none(false)
            found: mutable usize = 0
            safe: mutable bool = false
            mutable_slots: mutable darray[usize] = []
            callee_path: mutable darray[sview] = []
            root_path: darray[sview] = []
            return invalid if:
                not proof_replay_thread_callee_find_with_work(source_report.source.source_declarations, source_report, summary.name, summary.line, &found, &safe, &mutable_slots, root_path, &callee_path, source_work, 0)
                found != 1 or not safe or mutable_slots.count != count
                any region_line in source_report.source_contracts.source_region_param_lines where region_line == summary.line
            arguments: mutable darray[Ast::Expr] = []
            match call:
                Ast::Expr.Call(_, call_arguments, call_names, _):
                    return invalid if (any argument_name in call_names where argument_name != "") or call_arguments.count != summary.parameters_count
                    arguments.extend(call_arguments)
                _:
                    return invalid
            body: mutable darray[Ast::Stmt] = []
            return invalid if not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            plan: mutable ProofReplayThreading = proof_replay_threading_none(true)
            for index in 0..<count |index, mutable_slots, arguments, summary, report, trace, first, body, plan, invalid|:
                slot: usize = mutable_slots[index]
                local_name: sview = proof_replay_thread_argument_local(arguments[slot])
                return invalid if local_name == "" or proof_internal_name_is_rebind(local_name)
                duplicate_local: mutable bool = false
                for taken in plan.parameters |taken, local_name, duplicate_local, invalid, source_work|:
                    return invalid if not proof_replay_thread_name_compare_work_charge(taken, local_name, source_work)
                    duplicate_local <- true if taken == local_name
                return invalid if duplicate_local
                declarations: mutable usize = 0
                reference_local: mutable bool = false
                proof_replay_thread_local_declarations(body, local_name, source_report, &declarations, &reference_local, source_work, 0)
                return invalid if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or declarations == 0 or reference_local
                for other in 0..<arguments.count |other, slot, arguments, local_name, invalid|:
                    return invalid if other != slot and proof_replay_thread_mentions_name(arguments[other], local_name, 0)
                match report.analysis_1.traces.summary_values[first + index]:
                    Ast::Expr.Ident(symbol, _):
                        return invalid if not proof_internal_name_is_rebind(symbol)
                        duplicate_symbol: mutable bool = false
                        for taken in plan.symbols |taken, symbol, duplicate_symbol, invalid, source_work|:
                            return invalid if not proof_replay_thread_name_compare_work_charge(taken, symbol, source_work)
                            duplicate_symbol <- true if taken == symbol
                        return invalid if duplicate_symbol
                        plan.symbols.push(symbol)
                    _:
                        return invalid
                plan.parameters.push(local_name)
                plan.slots.push(slot)
            # Parameters, from here on, name the callee's formals.
            plan.parameters.clear()
            for slot in plan.slots |plan, report, summary, invalid|:
                return invalid if summary.parameters_start > report.analysis_1.executables.parameters.count or slot >= report.analysis_1.executables.parameters.count - summary.parameters_start
                plan.parameters.push(report.analysis_1.executables.parameters[summary.parameters_start + slot])
            for symbol in plan.symbols |report, trace, invalid|:
                return invalid if not proof_replay_thread_symbol_fresh(report, trace, symbol)
            return plan

        # No local binding defines S, and every summary that threads S is a summary of this same
        # call (one per ensure of the callee). Later summaries may read S as an argument value.
        def proof_replay_thread_symbol_fresh(report: ProofReport&, trace: ProofFactTrace, symbol: sview) -> bool:
            for candidate in report.analysis_1.traces.records |candidate, report, trace, symbol|:
                continue if candidate.name != trace.name
                if candidate.kind == "local-binding":
                    match candidate.expression:
                        Ast::Expr.Binary(Ast::Expr.Ident(bound, _), TokenKind.EqEq, _, _):
                            return false if bound == symbol
                        _:
                            pass
                    continue
                continue if candidate.kind != "function-summary"
                continue if candidate.summary_bindings_start > report.analysis_1.traces.summary_names.count or candidate.summary_bindings_count > report.analysis_1.traces.summary_names.count - candidate.summary_bindings_start
                for offset in 0..<candidate.summary_bindings_count |offset, candidate, report, trace, symbol|:
                    binding: usize = candidate.summary_bindings_start + offset
                    continue if binding >= report.analysis_1.traces.summary_values.count
                    continue if report.analysis_1.traces.summary_names[binding] != "__threaded_state"
                    match report.analysis_1.traces.summary_values[binding]:
                        Ast::Expr.Ident(named, _):
                            return false if named == symbol and (candidate.line != trace.line or candidate.dependency != trace.dependency or candidate.owner_line != trace.owner_line)
                        _:
                            return false
            return true
