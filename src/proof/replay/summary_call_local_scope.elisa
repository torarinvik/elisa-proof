extend ElisaProof:
    private:
        # Check only the live local-binding scope at a call's source position. This keeps calls
        # before later declarations and calls in sibling blocks available to summaries.
        def proof_replay_source_call_locals_unshadowed_at_with_work(body: darray[Ast::Stmt]&, annotations: darray[Ast::EnumAnnotation]&, call: Ast::Expr, work: mutable usize&) -> bool:
            match call:
                Ast::Expr.Call(callee, _, _, position):
                    name: mutable sview = ""
                    match callee:
                        Ast::Expr.Ident(callee_name, _):
                            name <- callee_name
                        Ast::Expr.Scope(_, callee_name, _):
                            name <- callee_name
                        _:
                            return false
                    return false if name == "" or position.line == 0
                    target: mutable ProofReplayCallSiteTarget = ProofReplayCallSiteTarget{selection: ProofReplayCallSiteTargetSelection{enabled: true,
                        ignore_unmatched_scoped_edges: false,
                        allow_scoped_target: false,
                        include_nonassert_contract_calls: true,
                        offset: position.offset.usize(),
                        line: position.line,
                        name: name,
                        calls_at_offset: 0,
                        matched_calls: 0,
                        track_unresolved_dispatch: true,
                        unresolved_dispatch_found: false,
                        source_annotations: annotations},
                        conversions: ProofReplayCallSiteTargetConversions{field_conversion_parameters: [],
                        field_conversion_names: [],
                        field_conversion_index_valid: false,
                        field_conversion_index_hashes: [],
                        field_conversion_index_values: [],
                        field_conversion_index_counts: [],
                        field_conversion_custom_cast_present: false},
                        aliases: ProofReplayCallSiteTargetAliases{field_conversion_alias_names: [],
                        field_conversion_alias_targets: [],
                        field_conversion_alias_lines: [],
                        field_conversion_bare_alias_root_fallback_valid: false,
                        field_conversion_alias_owners: [],
                        field_conversion_alias_has_formals: [],
                        field_conversion_alias_generic_formal_names: [],
                        field_conversion_alias_generic_formal_starts: [],
                        field_conversion_alias_generic_formal_counts: [],
                        field_conversion_alias_generic_application_valid: [],
                        field_conversion_alias_scope_index_valid: false,
                        field_conversion_alias_scope_index_hashes: [],
                        field_conversion_alias_scope_index_values: [],
                        field_conversion_alias_scope_index_counts: [],
                        field_conversion_alias_index_valid: false,
                        field_conversion_alias_index_hashes: [],
                        field_conversion_alias_index_values: [],
                        field_conversion_alias_index_counts: []},
                        generics: ProofReplayCallSiteTargetGenerics{field_conversion_generic_params_valid: false,
                        field_conversion_generic_param_lines: [],
                        field_conversion_generic_param_names: [],
                        field_conversion_generic_param_owner_offsets: [],
                        field_conversion_generic_param_line: 0,
                        field_conversion_generic_param_owner: "",
                        field_conversion_generic_param_owner_known: false, field_conversion_generic_param_owner_offset: 0, field_conversion_generic_param_owner_offset_valid: false,
                        field_conversion_generic_param_index_valid: false,
                        field_conversion_generic_param_index_hashes: [],
                        field_conversion_generic_param_index_values: [],
                        field_conversion_generic_param_index_counts: [], field_conversion_generic_owner_index_valid: false, field_conversion_generic_owner_index_hashes: [], field_conversion_generic_owner_index_values: [], field_conversion_generic_owner_index_counts: [], field_conversion_generic_owner_index_entries: 0, field_conversion_generic_function_index_valid: false, field_conversion_generic_function_index_hashes: [], field_conversion_generic_function_index_values: [], field_conversion_generic_function_index_counts: [], field_conversion_generic_function_index_entries: 0},
                        types: ProofReplayCallSiteTargetTypes{field_conversion_declared_types: [],
                        field_conversion_declared_type_owners: [],
                        field_conversion_declared_type_scope_index_valid: false,
                        field_conversion_declared_type_scope_index_hashes: [],
                        field_conversion_declared_type_scope_index_values: [],
                        field_conversion_declared_type_scope_index_counts: [],
                        field_conversion_declared_type_index_valid: false,
                        field_conversion_declared_type_index_hashes: [],
                        field_conversion_declared_type_index_values: [],
                        field_conversion_declared_type_index_counts: []}}
                    target.selection.allow_scoped_target <- true
                    target.capture.expected_call <- call
                    target.capture.require_exact_call <- true
                    calls: mutable darray[sview] = []
                    return false if not proof_replay_source_calls_with_target_work([], body, annotations, &calls, &target, work)
                    return target.selection.calls_at_offset == 1 and target.selection.matched_calls == 1 and not target.selection.unresolved_scope_at_target
                _:
                    return false

    public:
        # Shared by frame and type-bound replay so both use the same live-scope call binding rule.
        def source_call_locals_unshadowed_at_with_work(body: darray[Ast::Stmt]&, annotations: darray[Ast::EnumAnnotation]&, call: Ast::Expr, work: mutable usize&) -> bool:
            return proof_replay_source_call_locals_unshadowed_at_with_work(body, annotations, call, work)
