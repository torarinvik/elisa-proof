extend ElisaProof:
    private:
        const PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT: usize = 1048576
        const PROOF_REPLAY_REBIND_ARGUMENT_DEPTH_LIMIT: usize = 2

        def proof_replay_summary_bool_ref_value(value: mutable bool&) -> bool:
            can Abort.Panic:
                return value

        def proof_replay_summary_scope_work_charge(scope: darray[sview]&, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or scope.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + scope.count
            for segment in scope |work|:
                return false if sview_len(segment) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(segment)
            return true

        def proof_replay_summary_scope_equal_with_work(left: darray[sview]&, right: darray[sview]&, work: mutable usize&) -> bool:
            comparison: (equal: bool, complete: bool) = proof_replay_global_constant_scope_equal_with_work(left, right, work)
            comparison.complete and comparison.equal

        def proof_replay_summary_call_owner_scope(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, exact_owner: bool, current_scope: darray[sview]&, found_scope: mutable darray[sview]&, matches: mutable usize&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                matches <- 2
                return
            for declaration in declarations |owner, owner_line, owner_offset, exact_owner, current_scope, found_scope, matches, work, depth|:
                return if matches >= 2
                if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    matches <- 2
                    return
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, position):
                        if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                            matches <- 2
                            return
                        work <- work + sview_len(name)
                        if sview_len(owner) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                            matches <- 2
                            return
                        work <- work + sview_len(owner)
                        if name == owner and (owner_line == 0 or position.line == owner_line) and (not exact_owner or position.offset.usize() == owner_offset):
                            matches <- matches + 1
                            found_scope.clear()
                            found_scope.extend(current_scope)
                    Ast::Decl.Module(module_name, body, _):
                        module_bytes: usize = sview_len(module_name)
                        if module_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / 3:
                            matches <- 2
                            return
                        work <- work + module_bytes * 3
                        if current_scope.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                            matches <- 2
                            return
                        work <- work + current_scope.count
                        next_scope: mutable darray[sview] = proof_replay_global_constant_scope_with_module(current_scope, module_name)
                        proof_replay_summary_call_owner_scope(body, owner, owner_line, owner_offset, exact_owner, &next_scope, found_scope, matches, work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_summary_call_owner_scope(body, owner, owner_line, owner_offset, exact_owner, current_scope, found_scope, matches, work, depth + 1)
                    Ast::Decl.Invalid:
                        matches <- 2
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass

        def proof_replay_summary_call_constant_path_matches(report: ProofReport&, trace: ProofFactTrace, source: Ast::Expr, declaration: Ast::Expr, work: mutable usize&) -> bool:
            source_path: mutable darray[sview] = []
            declaration_path: mutable darray[sview] = []
            return false if:
                not proof_replay_qualified_path(source, &source_path, 0) or not proof_replay_qualified_path(declaration, &declaration_path, 0)
                not proof_replay_summary_scope_work_charge(source_path, work) or not proof_replay_summary_scope_work_charge(declaration_path, work)
            owner_line: mutable u32 = report.analysis_2.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            owner_offset: usize = report.analysis_2.replay_owner_offset
            exact_owner: bool = report.analysis_2.replay_owner_offset_valid
            owner_scope: mutable darray[sview] = []
            matches: mutable usize = 0
            root_scope: mutable darray[sview] = []
            proof_replay_summary_call_owner_scope(report.source.source_declarations, trace.name, owner_line, owner_offset, exact_owner, &root_scope, &owner_scope, &matches, work, 0)
            return false if matches != 1
            return true if proof_replay_summary_scope_equal_with_work(&declaration_path, &source_path, work)
            relative_path: mutable darray[sview] = []
            relative_path.extend(owner_scope)
            relative_path.extend(source_path)
            return false if not proof_replay_summary_scope_work_charge(relative_path, work)
            return proof_replay_summary_scope_equal_with_work(&declaration_path, &relative_path, work)

        # A constant spelling is normalized to its value only when no parameter or local of the
        # owner function spells the name (for a path, its first segment) anywhere in the body:
        # such a binding would make the source spelling denote that local instead.
        def proof_replay_summary_owner_source_preflight(report: ProofReport&, owner: sview, owner_line: u32, work: mutable usize&) -> bool:
            proof_replay_summary_owner_source_preflight_with_limit(report, owner, owner_line, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_replay_summary_owner_source_preflight_with_limit(report: ProofReport&, owner: sview, owner_line: u32, work: mutable usize&, work_limit: usize) -> bool:
            scan_start: usize = work
            return false if not proof_replay_summary_owner_source_scan_with_limit(report, owner, owner_line, work, work_limit)
            if work < scan_start:
                work <- work_limit
                return false
            scan_cost: usize = work - scan_start
            seed: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - (work_limit - work)
            if scan_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - seed) / 3:
                work <- work_limit
                return false
            # Reserve the same bounded tree size for the legacy owner, parameter and shadow
            # predicates that follow this complete preflight walk.
            work <- work + scan_cost * 3
            true

        # Charge only the exact owner lookup itself. CONTROL callers meter their subsequent
        # declaration predicates separately, so they must not inherit the legacy reservations.
        def proof_replay_summary_owner_source_scan_with_limit(report: ProofReport&, owner: sview, owner_line: u32, work: mutable usize&, work_limit: usize) -> bool:
            return false if work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or work > work_limit
            seed: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - (work_limit - work)
            metered_work: mutable usize = seed
            scan_start: usize = metered_work
            owner_offset: usize = report.analysis_2.replay_owner_offset if owner_line != 0 else 0
            exact_owner: bool = report.analysis_2.replay_owner_offset_valid
            found: mutable Ast::Expr = Ast::Expr.Invalid
            found_owner_line: mutable u32 = 0
            matches: mutable usize = 0
            owners: mutable usize = 0
            if not proof_replay_summary_call_exact_span_in_declarations(report.source.source_declarations, owner, owner_line, owner_offset, exact_owner, Ast::Expr.Invalid, &found, &found_owner_line, &matches, &owners, &metered_work, 0):
                work <- work_limit
                return false
            if metered_work < scan_start:
                work <- work_limit
                return false
            scan_cost: usize = metered_work - scan_start
            if scan_cost > work_limit - work:
                work <- work_limit
                return false
            work <- work + scan_cost
            true

        def proof_replay_summary_call_constant_source_unshadowed(report: ProofReport&, trace: ProofFactTrace, source: Ast::Expr, work: mutable usize&) -> bool:
            path: mutable darray[sview] = []
            return false if not proof_replay_qualified_path(source, &path, 0) or path.count == 0
            owner_line: mutable u32 = report.analysis_2.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            return false if not proof_replay_summary_owner_source_preflight(report, trace.name, owner_line, work)
            body: mutable darray[Ast::Stmt] = []
            return false if:
                not proof_replay_source_owner_body_with_work(report, trace.name, owner_line, &body, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                proof_replay_local_binding_parameter_name_present_for_report_owner_with_work(report.source.source_declarations, trace.name, owner_line, report, path[0], work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
            return not proof_replay_source_body_declares_with_work(report.source.source_declarations, body, path[0], work)

        def proof_replay_summary_call_global_constant_matches(report: ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_replay_summary_call_global_constant_matches_with_work(report, trace, source, expected, &work)

        def proof_replay_summary_call_global_constant_matches_with_work(report: ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, work: mutable usize&) -> bool:
            expected_value = proof_replay_global_constant_fact_value(expected)
            return false if:
                not expected_value.known
                report.source.source_declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + report.source.source_declarations.count
            return false if not proof_replay_summary_call_constant_source_unshadowed(report, trace, source, work)
            for candidate in report.analysis_1.traces.records |candidate, trace, source, expected_value, work|:
                return false if not proof_replay_mutable_local_text_compare_work_charge(candidate.name, trace.name, work)
                continue if candidate.name != trace.name
                return false if:
                    not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "global-constant", work)
                    not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "global-constant-qualified", work)
                continue if candidate.kind != "global-constant" and candidate.kind != "global-constant-qualified"
                return false if not proof_replay_summary_expr_charge_with_work(candidate.expression, work)
                match candidate.expression:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        decoded = proof_replay_global_constant_fact_value(right)
                        if decoded.known and decoded.value == expected_value.value and proof_replay_summary_call_constant_path_matches(report, trace, source, left, work):
                            owner_line: mutable u32 = report.analysis_2.replay_owner_line
                            owner_line <- 0 if owner_line == 4294967295
                            return true if proof_replay_summary_owner_source_preflight(report, trace.name, owner_line, work) and proof_replay_global_constant_fact_is_valid_with_work(report, candidate, work)
                    _:
                        pass
            return false

        def proof_replay_summary_call_rebind_argument_matches(report: mutable ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, rebind_depth: usize, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            match expected:
                Ast::Expr.Ident(symbol, _):
                    # A literal rebind is re-derived from the summary of its own call, whose
                    # arguments are compared here again. Bound the re-entry so a cyclic chain of
                    # rebinds fails closed instead of exhausting the native stack.
                    return false if not proof_internal_name_is_rebind(symbol) or rebind_depth >= PROOF_REPLAY_REBIND_ARGUMENT_DEPTH_LIMIT
                    for candidate_index in 0..<report.analysis_1.traces.records.count |candidate_index, report, trace, source, symbol, rebind_depth, work, cache|:
                        candidate: ProofFactTrace = report.analysis_1.traces.records[candidate_index]
                        return false if:
                            not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "local-binding", work)
                            not proof_replay_mutable_local_text_compare_work_charge(candidate.name, trace.name, work)
                        continue if candidate.kind != "local-binding" or candidate.name != trace.name or candidate.line != trace.line
                        return false if not proof_replay_summary_expr_charge_with_work(candidate.expression, work)
                        match candidate.expression:
                            Ast::Expr.Binary(Ast::Expr.Ident(bound_name, _), TokenKind.EqEq, literal, _):
                                continue if bound_name != symbol or (not proof_replay_summary_expr_equal_with_work(literal, source, work) and not proof_replay_summary_call_global_constant_matches_with_work(report, trace, source, literal, work))
                                return true if proof_replay_local_binding_literal_call_argument_source_at_with_cache(report, candidate, rebind_depth + 1, work, cache)
                            _:
                                pass
                    return false
                _:
                    return false

        def proof_replay_summary_call_argument_equal(report: mutable ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, rebind_depth: usize) -> bool:
            work: mutable usize = 0
            complete: mutable bool = true
            return proof_replay_summary_call_argument_equal_with_work(report, trace, source, expected, rebind_depth, &work, &complete, 0) and complete

        def proof_replay_summary_call_argument_equal_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, rebind_depth: usize, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_summary_call_argument_equal_with_cache(report, trace, source, expected, rebind_depth, work, complete, depth, &cache)

        # Callers with a smaller budget can reuse the summary comparator without letting its
        # internal SUMMARY meter exceed their remaining allowance. Debit the actual delta even
        # when the source expressions fail to match.
        def proof_replay_summary_call_argument_equal_with_limit(report: mutable ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, rebind_depth: usize, work: mutable usize&, work_limit: usize, complete: mutable bool&, depth: usize) -> bool:
            if work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                complete <- false
                return false
            if work > work_limit:
                work <- work_limit
                complete <- false
                return false
            remaining_work: usize = work_limit - work
            if remaining_work == 0:
                complete <- false
                return false
            virtual_seed: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - remaining_work
            virtual_work: mutable usize = virtual_seed
            matches: bool = proof_replay_summary_call_argument_equal_with_work(report, trace, source, expected, rebind_depth, &virtual_work, complete, depth)
            if virtual_work < virtual_seed or virtual_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                work <- work_limit
                complete <- false
                return false
            consumed_work: usize = virtual_work - virtual_seed
            if consumed_work > remaining_work:
                work <- work_limit
                complete <- false
                return false
            work <- work + consumed_work
            matches and complete

        def proof_replay_summary_call_argument_equal_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, rebind_depth: usize, work: mutable usize&, complete: mutable bool&, depth: usize, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            if depth >= 96 or work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                complete <- false
                return false
            work <- work + 1
            match source:
                Ast::Expr.Call(source_callee, source_arguments, source_names, source_position):
                    match expected:
                        Ast::Expr.Call(expected_callee, expected_arguments, expected_names, expected_position):
                            return false if source_position.line != expected_position.line or source_position.column != expected_position.column or source_position.offset != expected_position.offset or source_position.end_line != expected_position.end_line or source_position.end_column != expected_position.end_column or source_position.end_offset != expected_position.end_offset
                            if source_arguments.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                                complete <- false
                                return false
                            work <- work + source_arguments.count
                            return false if:
                                source_arguments.count != expected_arguments.count or source_names.count != expected_names.count
                                not proof_replay_summary_expr_equal_with_work(source_callee, expected_callee, work)
                            for index in 0..<source_arguments.count |index, source_arguments, expected_arguments, source_names, expected_names, report, trace, work, complete, depth, cache|:
                                return false if:
                                    not proof_replay_mutable_local_text_compare_work_charge(source_names[index], expected_names[index], work)
                                    source_names[index] != expected_names[index] or not proof_replay_summary_call_argument_equal_with_cache(report, trace, source_arguments[index], expected_arguments[index], rebind_depth, work, complete, depth + 1, cache)
                            return true
                        _:
                            return false
                Ast::Expr.Binary(source_left, source_operator, source_right, _):
                    match expected:
                        Ast::Expr.Binary(expected_left, expected_operator, expected_right, _):
                            return source_operator == expected_operator and proof_replay_summary_call_argument_equal_with_cache(report, trace, source_left, expected_left, rebind_depth, work, complete, depth + 1, cache) and proof_replay_summary_call_argument_equal_with_cache(report, trace, source_right, expected_right, rebind_depth, work, complete, depth + 1, cache)
                        _:
                            return false
                Ast::Expr.Unary(source_operator, source_inner, _):
                    match expected:
                        Ast::Expr.Unary(expected_operator, expected_inner, _):
                            return source_operator == expected_operator and proof_replay_summary_call_argument_equal_with_cache(report, trace, source_inner, expected_inner, rebind_depth, work, complete, depth + 1, cache)
                        _:
                            return false
                Ast::Expr.Paren(source_inner, _):
                    match expected:
                        Ast::Expr.Paren(expected_inner, _):
                            return proof_replay_summary_call_argument_equal_with_cache(report, trace, source_inner, expected_inner, rebind_depth, work, complete, depth + 1, cache)
                        _:
                            return false
                _:
                    return proof_replay_summary_expr_equal_with_work(source, expected, work) or proof_replay_summary_call_global_constant_matches_with_work(report, trace, source, expected, work) or proof_replay_summary_call_rebind_argument_matches(report, trace, source, expected, rebind_depth, work, cache)

        # A direct call can be lowered with a source literal in its summary binding even when
        # the source spells that value through a qualified const. Match its exact source span,
        # callee, and argument mapping here; the argument comparator independently requires a
        # source-backed global-constant fact for each normalized constant.
        def proof_replay_summary_call_same_source_span(report: mutable ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, rebind_depth: usize, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            if depth >= 96 or work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                complete <- false
                return false
            work <- work + 1
            match source:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_summary_call_same_source_span(report, trace, inner, expected, rebind_depth, work, complete, depth + 1)
                Ast::Expr.Call(source_callee, source_arguments, source_names, source_position):
                    match expected:
                        Ast::Expr.Call(expected_callee, expected_arguments, expected_names, expected_position):
                            return false if source_position.line != expected_position.line or source_position.column != expected_position.column or source_position.offset != expected_position.offset or source_position.end_line != expected_position.end_line or source_position.end_column != expected_position.end_column or source_position.end_offset != expected_position.end_offset
                            if source_arguments.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                                complete <- false
                                return false
                            work <- work + source_arguments.count
                            return false if:
                                source_arguments.count != expected_arguments.count or source_names.count != expected_names.count
                                not proof_replay_summary_expr_equal_with_work(source_callee, expected_callee, work)
                            for index in 0..<source_arguments.count |index, source_arguments, expected_arguments, source_names, expected_names, report, trace, work, complete, depth|:
                                return false if:
                                    not proof_replay_mutable_local_text_compare_work_charge(source_names[index], expected_names[index], work)
                                    source_names[index] != expected_names[index] or not proof_replay_summary_call_argument_equal_with_work(report, trace, source_arguments[index], expected_arguments[index], rebind_depth, work, complete, depth + 1)
                            return true
                        _:
                            return false
                _:
                    return false

        def proof_replay_summary_call_same_source_goal(report: mutable ProofReport&, trace: ProofFactTrace, source_expression: Ast::Expr, goal: Ast::Expr, expected: Ast::Expr, matches: mutable usize&, work: mutable usize&, complete: mutable bool&, rebind_depth: usize) -> bool:
            source_call: mutable Ast::Expr = Ast::Expr.Invalid
            exact_matches: mutable usize = 0
            return false if:
                not proof_replay_summary_call_exact_span_in_expr(source_expression, expected, &source_call, &exact_matches, work, 0)
                exact_matches != 1 or source_call is Ast::Expr.Invalid
            call_position: Ast::Pos = Ast::expr_pos(source_call)
            return false if call_position.offset == 0 or call_position.end_offset <= call_position.offset
            # A preserved Paren node carries the opening token's position, not the full
            # parenthesized source extent. Prove membership in the consumer goal structurally
            # and by exact call span instead of treating that delimiter position as an extent.
            goal_call: mutable Ast::Expr = Ast::Expr.Invalid
            goal_matches: mutable usize = 0
            return false if:
                not proof_replay_summary_call_exact_span_in_expr(goal, expected, &goal_call, &goal_matches, work, 0)
                goal_matches != 1 or goal_call is Ast::Expr.Invalid
            goal_call_position: Ast::Pos = Ast::expr_pos(goal_call)
            return false if:
                goal_call_position.offset == 0 or goal_call_position.end_offset <= goal_call_position.offset
                not proof_replay_summary_call_same_source_span(report, trace, source_call, expected, rebind_depth, work, complete, 0)
                not proof_replay_summary_call_same_source_span(report, trace, goal_call, expected, rebind_depth, work, complete, 0)
            matches <- matches + 1
            return proof_replay_summary_bool_ref_value(complete)

        def proof_replay_summary_call_same_source_statement(report: mutable ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&, expected: Ast::Expr, consumer_position: Ast::Pos, consumer_goal: Ast::Expr, consumer_valid: bool, matches: mutable usize&, work: mutable usize&, complete: mutable bool&, rebind_depth: usize) -> bool:
            if body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                complete <- false
                return false
            work <- work + body.count
            if consumer_valid:
                extent_cost: mutable usize = 0
                if not proof_replay_summary_expr_cost_body(body, &extent_cost, work, 0) or extent_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                    complete <- false
                    return false
                work <- work + extent_cost
            for statement in body |report, trace, expected, consumer_position, consumer_goal, consumer_valid, matches, work, complete, rebind_depth|:
                position: Ast::Pos = proof_replay_statement_position(statement)
                if consumer_valid:
                    return false if consumer_position.offset == 0 or position.offset == 0
                    return true if consumer_position.offset < position.offset
                    extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(statement, 0)
                    return false if not extent.offsets_complete or extent.end_offset <= position.offset
                    if consumer_position.offset < extent.end_offset:
                        match statement:
                            Ast::Stmt.Contract(_, expression, _) | Ast::Stmt.Expr(expression, _):
                                return false if not proof_replay_source_position_equal(Ast::expr_pos(consumer_goal), consumer_position)
                                return proof_replay_summary_call_same_source_goal(report, trace, expression, consumer_goal, expected, matches, work, complete, rebind_depth)
                            _:
                                return false
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, position):
                        matches <- matches + 1 if proof_replay_summary_call_same_source_span(report, trace, initializer, expected, rebind_depth, work, complete, 0)
                    Ast::Stmt.Assign(_, TokenKind.Assign, value, position) | Ast::Stmt.Assign(_, TokenKind.LArrow, value, position) | Ast::Stmt.Expr(value, position) | Ast::Stmt.Return(value, position):
                        matches <- matches + 1 if proof_replay_summary_call_same_source_span(report, trace, value, expected, rebind_depth, work, complete, 0)
                    Ast::Stmt.Contract(_, expression, position):
                        matches <- matches + 1 if proof_replay_summary_call_same_source_span(report, trace, expression, expected, rebind_depth, work, complete, 0)
                    Ast::Stmt.If(_, _, _, position) | Ast::Stmt.While(_, _, position) | Ast::Stmt.For(_, _, _, _, position) | Ast::Stmt.Match(_, _, position) | Ast::Stmt.Block(_, _, _, _, position):
                        return false
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
                return false if not proof_replay_summary_bool_ref_value(complete)
            return true

        # The per-replay declaration index has already traversed the full source tree and keeps
        # every same-name row, including duplicate and non-function declarations. Reuse its
        # collision-checked group here so each summary witness scans only declarations with the
        # owner's spelling; exact source line and call-span checks still decide admission.
        def proof_replay_summary_call_same_source_indexed(report: mutable ProofReport&, trace: ProofFactTrace, expected: Ast::Expr, owner_line: u32, consumer_position: Ast::Pos, consumer_goal: Ast::Expr, consumer_valid: bool, matches: mutable usize&, work: mutable usize&, complete: mutable bool&, rebind_depth: usize, cache: ProofReplayDeterministicCallReplayCache&) -> bool:
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(cache.declaration_index, trace.name, work)
            if not group.complete:
                complete <- false
                return false
            row: mutable usize = group.head
            for _ in 0..<group.count |group, row, cache, trace, owner_line, expected, consumer_position, consumer_goal, consumer_valid, matches, work, complete, report, rebind_depth|:
                return false if row >= cache.declaration_index.entries.count
                entry: ProofReplayDeterministicDeclarationEntry = cache.declaration_index.entries[row]
                return false if not proof_replay_mutable_local_text_compare_work_charge(entry.name, trace.name, work)
                if entry.name == trace.name:
                    match entry.declaration:
                        Ast::Decl.Func(name, _, _, body, _, _, position):
                            if owner_line == 0 or position.line == owner_line:
                                return false if not proof_replay_summary_call_same_source_statement(report, trace, body, expected, consumer_position, consumer_goal, consumer_valid, matches, work, complete, rebind_depth)
                        _:
                            pass
                row <- entry.next_index
                if row > cache.declaration_index.entries.count:
                    complete <- false
                    return false
            if row != cache.declaration_index.entries.count:
                complete <- false
                return false
            true

        def proof_replay_summary_call_owner_body_from_index(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, owner_line: u32, body: mutable darray[Ast::Stmt]&, work: mutable usize&) -> (complete: bool, matches: usize):
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(index, wanted, work)
            return (false, 0) if not group.complete
            matches: mutable usize = 0
            row: mutable usize = group.head
            for _ in 0..<group.count |group, row, index, wanted, owner_line, body, matches, work|:
                return (false, matches) if row >= index.entries.count
                entry: ProofReplayDeterministicDeclarationEntry = index.entries[row]
                return (false, matches) if not proof_replay_mutable_local_text_compare_work_charge(entry.name, wanted, work)
                match entry.declaration:
                    Ast::Decl.Func(name, _, _, statements, _, _, position):
                        if name == wanted and position.line == owner_line:
                            matches <- matches + 1
                            return (true, matches) if matches > 1
                            return (false, matches) if statements.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + statements.count
                            body.extend(statements)
                    _:
                        pass
                row <- entry.next_index
                return (false, matches) if row > index.entries.count
            return (false, matches) if row != index.entries.count
            (true, matches)

        def proof_replay_summary_call_same_source_site(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr, rebind_depth: usize, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            matches: mutable usize = 0
            complete: mutable bool = true
            owner_line: mutable u32 = report.analysis_2.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            consumer_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            consumer_goal: mutable Ast::Expr = Ast::Expr.Invalid
            consumer_valid: mutable bool = false
            return false if not proof_replay_deterministic_call_declaration_index_ensure(report, work, cache)
            if report.analysis_2.trace_consumer_certificate_index != 0:
                return false if owner_line == 0
                owner_body: mutable darray[Ast::Stmt] = []
                owner_candidate: (complete: bool, matches: usize) = proof_replay_summary_call_owner_body_from_index(cache.declaration_index, trace.name, owner_line, &owner_body, work)
                return false if:
                    not owner_candidate.complete or owner_candidate.matches != 1
                    not proof_replay_mutable_local_consumer_position_with_work(report, trace, owner_body, &consumer_position, work)
                    report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
                consumer_goal <- report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1].goal
                return false if not proof_replay_source_position_equal(Ast::expr_pos(consumer_goal), consumer_position)
                consumer_valid <- true
            return false if:
                not proof_replay_summary_call_same_source_indexed(report, trace, call, owner_line, consumer_position, consumer_goal, consumer_valid, &matches, work, &complete, rebind_depth, cache)
                work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return complete and matches == 1

        # A call summary's parameter values are part of the trusted substitution into its
        # postcondition. Reconstruct positional/named argument mapping from the source call;
        # omitted trailing positional slots take literal callee defaults
        # (summary_default_arguments.elisa); other defaults and ambiguous mappings stay
        # unsupported until their source semantics are independently reconstructed here.
        def proof_replay_summary_call_arguments_match(report: mutable ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, call: Ast::Expr, work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_summary_call_arguments_match_with_cache(report, trace, summary, call, work, &cache)

        def proof_replay_summary_call_arguments_match_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, call: Ast::Expr, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            match call:
                Ast::Expr.Call(_, arguments, argument_names, _):
                    return false if:
                        work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        arguments.count > summary.parameters_count
                        argument_names.count != 0 and argument_names.count != arguments.count
                    # Omitted trailing slots of a positional call take literal defaults.
                    return false if:
                        arguments.count < summary.parameters_count and argument_names.count != 0
                        summary.parameters_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                    work <- work + summary.parameters_count
                    slots: mutable darray[bool] = []
                    for index in 0..<summary.parameters_count |slots, work|:
                        slots.push(false)
                    next_positional: mutable usize = 0
                    saw_named: mutable bool = false
                    for index in 0..<arguments.count |index, arguments, argument_names, slots, next_positional, saw_named, report, trace, summary, work, cache|:
                        argument_name: sview = argument_names[index] if argument_names.count > 0 else ""
                        return false if not proof_replay_mutable_local_text_compare_work_charge(argument_name, "", work)
                        parameter_slot: mutable usize = summary.parameters_count
                        if argument_name == "":
                            return false if saw_named
                            while next_positional < summary.parameters_count and slots[next_positional] |next_positional, slots|:
                                next_positional <- next_positional + 1
                            parameter_slot <- next_positional
                            next_positional <- next_positional + 1
                        else:
                            saw_named <- true
                            for candidate in 0..<summary.parameters_count |candidate, argument_name, report, summary, parameter_slot, work|:
                                formal_index: usize = summary.parameters_start + candidate
                                return false if:
                                    formal_index >= report.analysis_1.executables.parameters.count
                                    not proof_replay_mutable_local_text_compare_work_charge(report.analysis_1.executables.parameters[formal_index], argument_name, work)
                                parameter_slot <- candidate if report.analysis_1.executables.parameters[formal_index] == argument_name
                        return false if parameter_slot >= summary.parameters_count or slots[parameter_slot]
                        slots[parameter_slot] <- true
                        binding_index: usize = trace.summary_bindings_start + parameter_slot
                        return false if binding_index >= report.analysis_1.traces.summary_values.count
                        argument_complete: mutable bool = true
                        return false if not proof_replay_summary_call_argument_equal_with_cache(report, trace, arguments[index], report.analysis_1.traces.summary_values[binding_index], 0, work, &argument_complete, 0, cache) or not argument_complete
                    for slot in 0..<arguments.count |slot, slots, work|:
                        return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        work <- work + 1
                        return false if not slots[slot]
                    return proof_replay_summary_omitted_defaults_match_with_cache(report, trace, summary, arguments.count, work, cache)
                _:
                    return false

        def proof_replay_summary_raw_call_source_site(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_replay_summary_raw_call_source_site_with_work(report, trace, call, &work)

        def proof_replay_summary_raw_call_source_site_with_work(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&) -> bool:
            return false if:
                Ast::expr_pos(call).line == 0
                not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, work)
            body: mutable darray[Ast::Stmt] = []
            return false if:
                not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &body, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body.count
            match call:
                Ast::Expr.Call(Ast::Expr.Ident(callee_name, _), _, _, _):
                    return false if:
                        callee_name == "" or report.analysis_2.replay_owner_line == 0 or report.analysis_2.replay_owner_line == 4294967295
                        proof_replay_local_binding_parameter_name_present_for_report_owner_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report, callee_name, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                    return proof_replay_source_call_locals_unshadowed_at_with_work(body, report.source.source_annotations, call, work)
                _:
                    pass
            complete: mutable bool = true
            if proof_replay_deterministic_call_source_contains_statements_bounded(body, call, work, &complete, 0) and complete:
                return true
            return false if not complete
            bare = proof_replay_same_module_bare_call_with_work(report, trace, call, work)
            return false if not bare.known or body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body.count
            complete <- true
            return proof_replay_deterministic_call_source_contains_statements_bounded(body, bare.call, work, &complete, 0) and complete

    private:
        def proof_replay_summary_direct_call_source_site_at(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr, rebind_depth: usize, work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_summary_direct_call_source_site_at_with_cache(report, trace, call, rebind_depth, work, &cache)

        def proof_replay_summary_direct_call_source_site_at_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr, rebind_depth: usize, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return true if proof_replay_summary_raw_call_source_site_with_work(report, trace, call, work)
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            owner_line: mutable u32 = report.analysis_2.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            return false if:
                not proof_replay_summary_owner_source_preflight(report, trace.name, owner_line, work)
                report.analysis_1.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + report.analysis_1.traces.records.count
            return true if proof_replay_deterministic_call_source_site_with_cache(report, trace, call, work, cache)
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true if proof_replay_summary_call_same_source_site(report, trace, call, rebind_depth, work, cache)
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return proof_replay_summary_requires_call_source_site(report, trace, call, work)

        # Call summaries are emitted both for the call term and, when it initializes a local,
        # for that local's name. Accept the latter only when the source declaration binds that
        # exact local to the exact call already used by a same-site direct summary.
include "./summary_source_cost.elisa"

include "./summary_source_call_sites.elisa"
