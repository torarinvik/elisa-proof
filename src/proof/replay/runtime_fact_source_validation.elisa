# Runtime assertion traces are source facts only after replay finds the exact assertion
# statement and proves that the consumer is its immediate lexical successor. Keeping this first
# route local and conservative avoids treating a line number as dominance or liveness evidence.
extend ElisaProof:
    private:
        const PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT: usize = 16384

        def proof_replay_runtime_fact_pure_function(report: ProofReport&, name: sview, argument_count: usize, declaration: Ast::Decl, work: mutable usize&) -> bool:
            match declaration:
                Ast::Decl.Func(found_name, parameters, return_type, body, effects, _, _):
                    return false if found_name != name or effects.count != 0 or parameters.count != argument_count or parameters.count > 64 or body.count != 1
                    return false if not proof_replay_control_match_guard_scalar_type(return_type)
                    for parameter_index in 0..<parameters.count |parameter_index, parameters, work|:
                        return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                        work <- work + 1
                        parameter: Ast::ParamDecl = parameters[parameter_index]
                        return false if parameter.name == "" or parameter.has_default or parameter.is_mutable or not proof_replay_control_match_guard_scalar_type(parameter.type_expression)
                        for previous in 0..<parameter_index |previous, parameter_index, parameters, work|:
                            return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                            work <- work + 1
                            return false if parameters[previous].name == parameter.name
                    match body[0]:
                        Ast::Stmt.Return(value, _):
                            if value is returned:
                                return proof_replay_control_match_guard_pure_expression(report, returned, parameters, work, 0)
                            return false
                        _:
                            return false
                _:
                    return false

        def proof_replay_runtime_fact_call_is_pure(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&, owner_source_work: usize) -> bool:
            return false if trace.name == "" or report.replay_owner_line == 0
            return false if report.source_annotations.count > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
            work <- work + report.source_annotations.count
            return false if not proof_replay_control_match_guard_charge_declarations(report.source_declarations, work, 0)
            return false if proof_replay_summary_has_unresolved_import(report.source_annotations) or proof_replay_summary_has_unresolved_declaration_import(report.source_declarations, 0)
            match call:
                Ast::Expr.Call(Ast::Expr.Ident(name, _), arguments, labels, _):
                    return false if name == "" or labels.count != 0
                    selected: mutable Ast::Decl = Ast::Decl.Invalid
                    matches: mutable usize = 0
                    return false if not proof_replay_control_match_guard_function_collect(report.source_declarations, name, selected, &matches, work, 0)
                    return false if matches != 1 or not proof_replay_runtime_fact_pure_function(report, name, arguments.count, selected, work)
                    return false if not proof_replay_control_match_guard_charge_declarations(report.source_declarations, work, 0)
                    return false if proof_replay_local_binding_parameter_name_present(report.source_declarations, trace.name, report.replay_owner_line, name, 0)
                    return false if owner_source_work > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
                    work <- work + owner_source_work
                    return proof_replay_local_binding_parameter_source_unshadowed(report.source_declarations, trace.name, report.replay_owner_line, name)
                _:
                    return false

        def proof_replay_runtime_fact_expression_stable(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, work: mutable usize&, owner_source_work: usize, depth: usize) -> bool:
            return false if depth >= 64 or work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return name != ""
                Ast::Expr.Paren(inner, _):
                    return proof_replay_runtime_fact_expression_stable(report, trace, inner, work, owner_source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Not and operator != TokenKind.Minus
                    protocol: sview = proof_builtin_unary_operator_protocol(operator)
                    return false if protocol != "" and proof_source_primitive_operator_mask_has(report.source_primitive_operator_mask, protocol)
                    return proof_replay_runtime_fact_expression_stable(report, trace, inner, work, owner_source_work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                    protocol: sview = proof_builtin_operator_protocol(operator)
                    return false if protocol != "" and proof_source_primitive_operator_mask_has(report.source_primitive_operator_mask, protocol)
                    return false if not proof_replay_runtime_fact_expression_stable(report, trace, left, work, owner_source_work, depth + 1)
                    return proof_replay_runtime_fact_expression_stable(report, trace, right, work, owner_source_work, depth + 1)
                Ast::Expr.Call(Ast::Expr.Ident(name, _), arguments, labels, _):
                    return false if name == "" or name == "old" or labels.count != 0
                    return false if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize"
                    return false if not proof_replay_runtime_fact_call_is_pure(report, trace, expression, work, owner_source_work)
                    for argument in arguments |report, trace, work, owner_source_work, depth|:
                        return false if not proof_replay_runtime_fact_expression_stable(report, trace, argument, work, owner_source_work, depth + 1)
                    return true
                _:
                    return false

        def proof_replay_runtime_fact_expression_is_stable(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, work: mutable usize&, owner_source_work: usize) -> bool:
            return proof_replay_runtime_fact_expression_stable(report, trace, expression, work, owner_source_work, 0)

        def proof_replay_runtime_fact_source_statement_matches(report: ProofReport&, trace: ProofFactTrace, source_certificate: ProofGoalCertificate, statement: Ast::Stmt, work: mutable usize&, owner_source_work: usize) -> bool:
            if trace.kind == "runtime-assert":
                match statement:
                    Ast::Stmt.Contract("assert", expression, position):
                        return false if not proof_replay_control_assertion_matches(statement, source_certificate)
                        return proof_replay_runtime_fact_expression_is_stable(report, trace, expression, work, owner_source_work)
                    Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("assert", _), arguments, labels, _), position):
                        return false if position.line != trace.line or arguments.count != 1 or labels.count != 0
                        return false if not proof_replay_control_assertion_matches(statement, source_certificate)
                        return proof_replay_runtime_fact_expression_is_stable(report, trace, arguments[0], work, owner_source_work)
                    _:
                        return false
            if trace.kind == "runtime-guard":
                match statement:
                    Ast::Stmt.Block("assert_by", _, _, body, position):
                        return false if position.line != trace.line or body.count == 0
                        return false if not proof_replay_control_assert_by_goal_matches(statement, source_certificate)
                        match body[0]:
                            Ast::Stmt.Contract(kind, expression, _):
                                return false if kind == "assert"
                                return proof_replay_runtime_fact_expression_is_stable(report, trace, expression, work, owner_source_work)
                            _:
                                return false
                    _:
                        return false
            return false

        def proof_replay_runtime_fact_use_matches(statement: Ast::Stmt, certificate: ProofGoalCertificate) -> bool:
            return proof_replay_control_assertion_matches(statement, certificate) or proof_replay_control_assert_by_goal_matches(statement, certificate)

        def proof_replay_runtime_fact_find_owner_body(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, body: mutable darray[Ast::Stmt]&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64
            for declaration in declarations |owner, owner_line, body, matches, work, depth|:
                return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, _, _, function_body, _, _, position):
                        if name == owner and position.line == owner_line:
                            matches <- matches + 1
                            return false if function_body.count > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
                            work <- work + function_body.count
                            body.clear()
                            body.extend(function_body)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_runtime_fact_find_owner_body(nested, owner, owner_line, body, matches, work, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        # Only direct siblings count here. A return, control-flow edge, assignment, or even an
        # unrelated statement between the fact and consumer ends this supported live range.
        def proof_replay_runtime_fact_adjacent_use_scan(report: ProofReport&, trace: ProofFactTrace, source_certificate: ProofGoalCertificate, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, depth: usize, work: mutable usize&, owner_source_work: usize, uses: mutable usize&) -> bool:
            return false if depth >= 64
            for index in 0..<body.count |index, body, report, trace, source_certificate, certificate, depth, work, owner_source_work, uses|:
                return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                work <- work + 1
                if proof_replay_runtime_fact_source_statement_matches(report, trace, source_certificate, body[index], work, owner_source_work):
                    if index + 1 < body.count and proof_replay_runtime_fact_use_matches(body[index + 1], certificate):
                        return false if not proof_replay_runtime_fact_expression_is_stable(report, trace, certificate.goal, work, owner_source_work)
                        uses <- uses + 1
                match body[index]:
                    Ast::Stmt.If(_, yes, no, _):
                        return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, yes, depth + 1, work, owner_source_work, uses)
                        return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, no, depth + 1, work, owner_source_work, uses)
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, inner, depth + 1, work, owner_source_work, uses)
                    Ast::Stmt.Block(kind, _, _, inner, _):
                        # `assert_by` checks its proof body through the ghost checker; nested
                        # proof-step assertions are not executable runtime facts.
                        return false if kind != "assert_by" and not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, inner, depth + 1, work, owner_source_work, uses)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |report, trace, source_certificate, certificate, depth, work, owner_source_work, uses|:
                            return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                            work <- work + 1
                            return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, arm.body, depth + 1, work, owner_source_work, uses)
                    _:
                        pass
            return true

        def proof_replay_runtime_fact_source_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if trace.kind != "runtime-assert" and trace.kind != "runtime-guard"
            return false if trace.name == "" or trace.line == 0 or trace.owner_line != 0 or report.replay_owner_line == 0
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line
            return false if certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
            body: mutable darray[Ast::Stmt] = []
            work: mutable usize = 0
            owner_matches: mutable usize = 0
            return false if not proof_replay_runtime_fact_find_owner_body(report.source_declarations, trace.name, report.replay_owner_line, &body, &owner_matches, &work, 0) or owner_matches != 1
            return false if not proof_replay_control_certificate_attempt_unique(report, certificate)
            owner_source_work: mutable usize = 0
            owner_assertions: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(body, certificate, 0, &owner_source_work, &owner_assertions) or owner_assertions != 1
            return false if owner_source_work > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
            work <- work + owner_source_work
            source_certificate: ProofGoalCertificate = ProofGoalCertificate{goal: trace.expression, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: trace.line, name: trace.name, rule: "goal", source_phase: "", replayed: false}
            source_matches: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(body, source_certificate, 0, &work, &source_matches) or source_matches != 1
            uses: mutable usize = 0
            return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, body, 0, &work, owner_source_work, &uses)
            uses == 1
