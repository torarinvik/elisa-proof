# Runtime assertion traces are source facts only after replay finds the exact assertion
# statement and proves that the consumer is its immediate lexical successor. Keeping this first
# route local and conservative avoids treating a line number as dominance or liveness evidence.
extend ElisaProof:
    private:
        const PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT: usize = 16384

        def proof_replay_runtime_fact_expression_stable(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
            work <- work + 1
            return false if not proof_expr_supported(expression) or proof_expr_has_old(expression) or proof_expr_has_move(expression)
            return false if proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
            # Pure calls can be repeated across a runtime assertion only when replay can
            # reconstruct their source definition and the unique call site. This admits the
            # independently checked scalar predicate subset; other pure-call shapes stay closed.
            if proof_expr_has_call(expression):
                match expression:
                    Ast::Expr.Call(_, _, _, _):
                        call_sites: mutable usize = 0
                        return false if not proof_replay_control_match_guard_stable_expression(report, trace, expression, work, &call_sites, 0)
                        return proof_replay_deterministic_call_source_site(report, trace, expression)
                    _:
                        return false
            return true

        def proof_replay_runtime_fact_source_statement_matches(report: ProofReport&, trace: ProofFactTrace, source_certificate: ProofGoalCertificate, statement: Ast::Stmt, work: mutable usize&) -> bool:
            if trace.kind == "runtime-assert":
                match statement:
                    Ast::Stmt.Contract("assert", expression, position):
                        return false if not proof_replay_control_assertion_matches(statement, source_certificate)
                        return proof_replay_runtime_fact_expression_stable(report, trace, expression, work)
                    Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("assert", _), arguments, labels, _), position):
                        return false if position.line != trace.line or arguments.count != 1 or labels.count != 0
                        return false if not proof_replay_control_assertion_matches(statement, source_certificate)
                        return proof_replay_runtime_fact_expression_stable(report, trace, arguments[0], work)
                    _:
                        return false
            if trace.kind == "runtime-guard":
                match statement:
                    Ast::Stmt.Block("assert_by", _, _, body, position):
                        return false if position.line != trace.line or body.count == 0
                        return false if not proof_replay_control_assert_by_goal_matches(statement, source_certificate)
                        match body[0]:
                            Ast::Stmt.Contract(kind, expression, _):
                                return false if kind == "assert"
                                return proof_replay_runtime_fact_expression_stable(report, trace, expression, work)
                            _:
                                return false
                    _:
                        return false
            return false

        def proof_replay_runtime_fact_use_matches(statement: Ast::Stmt, certificate: ProofGoalCertificate) -> bool:
            return proof_replay_control_assertion_matches(statement, certificate) or proof_replay_control_assert_by_goal_matches(statement, certificate)

        # Only direct siblings count here. A return, control-flow edge, assignment, or even an
        # unrelated statement between the fact and consumer ends this supported live range.
        def proof_replay_runtime_fact_adjacent_use_scan(report: ProofReport&, trace: ProofFactTrace, source_certificate: ProofGoalCertificate, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, depth: usize, work: mutable usize&, uses: mutable usize&) -> bool:
            return false if depth >= 64
            for index in 0..<body.count |index, body, report, trace, source_certificate, certificate, depth, work, uses|:
                return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                work <- work + 1
                if proof_replay_runtime_fact_source_statement_matches(report, trace, source_certificate, body[index], work):
                    if index + 1 < body.count and proof_replay_runtime_fact_use_matches(body[index + 1], certificate):
                        return false if not proof_replay_runtime_fact_expression_stable(report, trace, certificate.goal, work)
                        uses <- uses + 1
                match body[index]:
                    Ast::Stmt.If(_, yes, no, _):
                        return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, yes, depth + 1, work, uses)
                        return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, no, depth + 1, work, uses)
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, inner, depth + 1, work, uses)
                    Ast::Stmt.Block(kind, _, _, inner, _):
                        # `assert_by` checks its proof body through the ghost checker; nested
                        # proof-step assertions are not executable runtime facts.
                        return false if kind != "assert_by" and not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, inner, depth + 1, work, uses)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |report, trace, source_certificate, certificate, depth, work, uses|:
                            return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, arm.body, depth + 1, work, uses)
                    _:
                        pass
            return true

        def proof_replay_runtime_fact_source_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if trace.kind != "runtime-assert" and trace.kind != "runtime-guard"
            return false if trace.name == "" or trace.line == 0 or trace.owner_line != 0 or report.replay_owner_line == 0
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line
            return false if certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body(report, trace.name, report.replay_owner_line, &body)
            work: mutable usize = 0
            return false if not proof_replay_control_assertion_unique_in_owner(report, body, certificate, &work)
            source_certificate: ProofGoalCertificate = ProofGoalCertificate{goal: trace.expression, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: trace.line, name: trace.name, rule: "goal", source_phase: "", replayed: false}
            source_matches: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(body, source_certificate, 0, &work, &source_matches) or source_matches != 1
            uses: mutable usize = 0
            return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, body, 0, &work, &uses)
            uses == 1
