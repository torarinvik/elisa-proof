# Runtime assertion traces are source facts only after replay finds the exact assertion
# statement and proves that the consumer is its immediate lexical successor. Keeping this first
# route local and conservative avoids treating a line number as dominance or liveness evidence.
extend ElisaProof:
    private:
        const PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT: usize = 16384

        def proof_replay_runtime_fact_expression_operators_safe(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, declaration_line: u32, declaration_offset: u32, scratch: mutable ProofReport&, work: mutable usize&, owner: sview, owner_known: bool) -> bool:
            saved_owner_line: u32 = scratch.context.current_goal_owner_line
            saved_owner_offset: u32 = scratch.context.current_goal_owner_offset
            scratch.context.current_goal_owner_line <- declaration_line
            scratch.context.current_goal_owner_offset <- declaration_offset
            supported: bool = proof_replay_runtime_fact_expression_operators_safe_with_owner(expression, parameters, declaration_line, scratch, work, owner, owner_known)
            scratch.context.current_goal_owner_line <- saved_owner_line
            scratch.context.current_goal_owner_offset <- saved_owner_offset
            return supported

        def proof_replay_runtime_fact_expression_operators_safe_with_owner(expression: Ast::Expr, parameters: darray[Ast::ParamDecl]&, declaration_line: u32, scratch: mutable ProofReport&, work: mutable usize&, owner: sview, owner_known: bool) -> bool:
            return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
            remaining: usize = PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
            meter_base: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - remaining
            scratch.source_types.source_effect_index.work.implicit_effect_work <- meter_base
            overloaded: bool = proof_structural_typed_operator_expression_has_overload(expression, parameters, declaration_line, scratch, 0, owner, owner_known)
            observed_total: usize = scratch.source_types.source_effect_index.work.implicit_effect_work
            return false if observed_total < meter_base
            observed: usize = observed_total - meter_base
            return false if observed > remaining
            work <- work + observed
            not overloaded

        def proof_replay_runtime_fact_function_owner_module(declarations: darray[Ast::Decl]&, name: sview, line: u32, current_owner: sview, owner: mutable sview&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64 or work > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
            return false if declarations.count > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
            work <- work + declarations.count
            for declaration in declarations |name, line, current_owner, owner, matches, work, depth|:
                return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(candidate_name, _, _, _, _, _, position):
                        return false if not proof_replay_control_text_compare_charge(candidate_name, name, work)
                        if candidate_name == name and position.line == line:
                            matches <- matches + 1
                            owner <- current_owner
                    Ast::Decl.Module(module_name, nested, _):
                        return false if not proof_replay_control_text_compare_charge(module_name, module_name, work)
                        return false if not proof_replay_runtime_fact_function_owner_module(nested, name, line, module_name, owner, matches, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_runtime_fact_function_owner_module(nested, name, line, current_owner, owner, matches, work, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_runtime_fact_pure_function(report: ProofReport&, name: sview, argument_count: usize, declaration: Ast::Decl, work: mutable usize&, scratch: mutable ProofReport&) -> bool:
            match declaration:
                Ast::Decl.Func(found_name, parameters, return_type, body, effects, _, position):
                    return false if:
                        found_name != name or effects.count != 0 or parameters.count != argument_count or parameters.count > 64 or body.count != 1
                        not proof_replay_control_match_guard_scalar_type(return_type)
                    for parameter_index in 0..<parameters.count |parameter_index, parameters, work|:
                        return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                        work <- work + 1
                        parameter: Ast::ParamDecl = parameters[parameter_index]
                        return false if parameter.name == "" or parameter.has_default or parameter.is_mutable or not proof_replay_control_match_guard_scalar_type(parameter.type_expression)
                        for previous in 0..<parameter_index |previous, parameter_index, parameters, work|:
                            return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                            work <- work + 1
                            return false if parameters[previous].name == parameter.name
                    match body[0]:
                        Ast::Stmt.Return(value, _):
                            if value is returned:
                                owner: mutable sview = ""
                                owner_matches: mutable usize = 0
                                return false if not proof_replay_runtime_fact_function_owner_module(report.source.source_declarations, name, position.line, "", &owner, &owner_matches, work, 0) or owner_matches != 1
                                return false if:
                                    not proof_replay_summary_expr_charge_with_limit(returned, work, PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT)
                                    not proof_replay_runtime_fact_expression_operators_safe(returned, parameters, position.line, position.offset, scratch, work, owner, true)
                                return proof_replay_control_match_guard_pure_expression(report, returned, parameters, work, 0)
                            return false
                        _:
                            return false
                _:
                    return false

        def proof_replay_runtime_fact_call_is_pure(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&, owner_source_work: usize, scratch: mutable ProofReport&) -> bool:
            return false if:
                trace.name == "" or report.analysis_2.replay_owner_line == 0
                proof_replay_summary_has_unresolved_import(report.source.source_annotations, work, PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT)
                not proof_replay_control_match_guard_charge_declarations(report.source.source_declarations, work, 0)
                proof_replay_summary_has_unresolved_declaration_import(report.source.source_declarations, work, PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT, 0)
            match call:
                Ast::Expr.Call(Ast::Expr.Ident(name, _), arguments, labels, _):
                    return false if name == "" or labels.count != 0
                    selected: mutable Ast::Decl = Ast::Decl.Invalid
                    matches: mutable usize = 0
                    return false if:
                        not proof_replay_control_match_guard_function_collect(report.source.source_declarations, name, selected, &matches, work, 0)
                        matches != 1 or not proof_replay_runtime_fact_pure_function(report, name, arguments.count, selected, work, scratch)
                        not proof_replay_control_match_guard_charge_declarations(report.source.source_declarations, work, 0)
                        proof_replay_local_binding_parameter_name_present_at_offset_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, work, PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT, 0)
                        owner_source_work > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
                    work <- work + owner_source_work
                    return proof_replay_local_binding_parameter_source_unshadowed_at_offset_with_limit(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, work, PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT)
                _:
                    return false

        def proof_replay_runtime_fact_expression_stable(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, work: mutable usize&, owner_source_work: usize, scratch: mutable ProofReport&, depth: usize) -> bool:
            return false if depth >= 64 or work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return name != ""
                Ast::Expr.Paren(inner, _):
                    return proof_replay_runtime_fact_expression_stable(report, trace, inner, work, owner_source_work, scratch, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Not and operator != TokenKind.Minus
                    return proof_replay_runtime_fact_expression_stable(report, trace, inner, work, owner_source_work, scratch, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if:
                        operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                        not proof_replay_runtime_fact_expression_stable(report, trace, left, work, owner_source_work, scratch, depth + 1)
                    return proof_replay_runtime_fact_expression_stable(report, trace, right, work, owner_source_work, scratch, depth + 1)
                Ast::Expr.Call(Ast::Expr.Ident(name, _), arguments, labels, _):
                    return false if:
                        name in {"", "old"} or labels.count != 0
                        name in {"i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize"}
                        not proof_replay_runtime_fact_call_is_pure(report, trace, expression, work, owner_source_work, scratch)
                    for argument in arguments |report, trace, work, owner_source_work, scratch, depth|:
                        return false if not proof_replay_runtime_fact_expression_stable(report, trace, argument, work, owner_source_work, scratch, depth + 1)
                    return true
                _:
                    return false

        def proof_replay_runtime_fact_expression_is_stable(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, work: mutable usize&, owner_source_work: usize, scratch: mutable ProofReport&) -> bool:
            return proof_replay_runtime_fact_expression_stable(report, trace, expression, work, owner_source_work, scratch, 0)

        def proof_replay_runtime_fact_source_statement_matches(report: ProofReport&, trace: ProofFactTrace, source_certificate: ProofGoalCertificate, statement: Ast::Stmt, work: mutable usize&, owner_source_work: usize, parameters: darray[Ast::ParamDecl]&, declaration_line: u32, declaration_offset: u32, caller_owner: sview, caller_owner_known: bool, scratch: mutable ProofReport&) -> bool:
            if trace.kind == "runtime-assert":
                match statement:
                    Ast::Stmt.Contract("assert", expression, _):
                        return false if:
                            not proof_replay_control_assertion_matches(statement, source_certificate)
                            not proof_replay_summary_expr_equal_with_work(expression, trace.expression, work)
                            not proof_replay_trace_expression_positions_equal_for_report(report, expression, trace.expression, 0)
                            not proof_replay_runtime_fact_expression_operators_safe(expression, parameters, declaration_line, declaration_offset, scratch, work, caller_owner, caller_owner_known)
                        return proof_replay_runtime_fact_expression_is_stable(report, trace, expression, work, owner_source_work, scratch)
                    Ast::Stmt.Expr(Ast::Expr.Call(Ast::Expr.Ident("assert", _), arguments, labels, _), position):
                        return false if:
                            position.line != trace.line or arguments.count != 1 or labels.count != 0
                            not proof_replay_control_assertion_matches(statement, source_certificate)
                            not proof_replay_summary_expr_equal_with_work(arguments[0], trace.expression, work)
                            not proof_replay_trace_expression_positions_equal_for_report(report, arguments[0], trace.expression, 0)
                            not proof_replay_runtime_fact_expression_operators_safe(arguments[0], parameters, declaration_line, declaration_offset, scratch, work, caller_owner, caller_owner_known)
                        return proof_replay_runtime_fact_expression_is_stable(report, trace, arguments[0], work, owner_source_work, scratch)
                    _:
                        return false
            if trace.kind == "runtime-guard":
                match statement:
                    Ast::Stmt.Block("assert_by", _, _, body, position):
                        return false if:
                            position.line != trace.line or body.count == 0
                            not proof_replay_control_assert_by_goal_matches(statement, source_certificate)
                        match body[0]:
                            Ast::Stmt.Contract(kind, expression, _):
                                return false if:
                                    kind != "assert"
                                    not proof_replay_summary_expr_equal_with_work(expression, trace.expression, work)
                                    not proof_replay_trace_expression_positions_equal_for_report(report, expression, trace.expression, 0)
                                    not proof_replay_runtime_fact_expression_operators_safe(expression, parameters, declaration_line, declaration_offset, scratch, work, caller_owner, caller_owner_known)
                                return proof_replay_runtime_fact_expression_is_stable(report, trace, expression, work, owner_source_work, scratch)
                            _:
                                return false
                    _:
                        return false
            return false

        def proof_replay_runtime_fact_use_matches(statement: Ast::Stmt, certificate: ProofGoalCertificate) -> bool:
            return proof_replay_control_assertion_matches(statement, certificate) or proof_replay_control_assert_by_goal_matches(statement, certificate)

        def proof_replay_runtime_fact_find_owner_body(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, current_owner: sview, body: mutable darray[Ast::Stmt]&, parameters: mutable darray[Ast::ParamDecl]&, function_owner: mutable sview&, function_offset: mutable u32&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64
            for declaration in declarations |owner, owner_line, current_owner, body, parameters, function_owner, function_offset, matches, work, depth|:
                return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, function_parameters, _, function_body, _, _, position):
                        if sview_len(name) > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work:
                            work <- PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                            return false
                        work <- work + sview_len(name)
                        if name == owner and position.line == owner_line:
                            matches <- matches + 1
                            function_owner <- current_owner
                            function_offset <- position.offset
                            return false if function_body.count > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
                            work <- work + function_body.count
                            body.clear()
                            body.extend(function_body)
                            parameters.clear()
                            parameters.extend(function_parameters)
                    Ast::Decl.Module(module_name, nested, _):
                        return false if not proof_replay_runtime_fact_find_owner_body(nested, owner, owner_line, module_name, body, parameters, function_owner, function_offset, matches, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_runtime_fact_find_owner_body(nested, owner, owner_line, current_owner, body, parameters, function_owner, function_offset, matches, work, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        # Only direct siblings count here. A return, control-flow edge, assignment, or even an
        # unrelated statement between the fact and consumer ends this supported live range.
        def proof_replay_runtime_fact_adjacent_use_scan(report: ProofReport&, trace: ProofFactTrace, source_certificate: ProofGoalCertificate, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, parameters: darray[Ast::ParamDecl]&, declaration_line: u32, declaration_offset: u32, caller_owner: sview, caller_owner_known: bool, scratch: mutable ProofReport&, depth: usize, work: mutable usize&, owner_source_work: usize, uses: mutable usize&) -> bool:
            return false if depth >= 64
            for index in 0..<body.count |index, body, report, trace, source_certificate, certificate, parameters, declaration_line, declaration_offset, caller_owner, caller_owner_known, scratch, depth, work, owner_source_work, uses|:
                return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                work <- work + 1
                if proof_replay_runtime_fact_source_statement_matches(report, trace, source_certificate, body[index], work, owner_source_work, parameters, declaration_line, declaration_offset, caller_owner, caller_owner_known, scratch):
                    if index + 1 < body.count and proof_replay_runtime_fact_use_matches(body[index + 1], certificate):
                        return false if:
                            not proof_replay_runtime_fact_expression_operators_safe(certificate.goal, parameters, declaration_line, declaration_offset, scratch, work, caller_owner, caller_owner_known)
                            not proof_replay_runtime_fact_expression_is_stable(report, trace, certificate.goal, work, owner_source_work, scratch)
                        uses <- uses + 1
                match body[index]:
                    Ast::Stmt.If(_, yes, no, _):
                        return false if:
                            not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, yes, parameters, declaration_line, declaration_offset, caller_owner, caller_owner_known, scratch, depth + 1, work, owner_source_work, uses)
                            not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, no, parameters, declaration_line, declaration_offset, caller_owner, caller_owner_known, scratch, depth + 1, work, owner_source_work, uses)
                    Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, inner, parameters, declaration_line, declaration_offset, caller_owner, caller_owner_known, scratch, depth + 1, work, owner_source_work, uses)
                    Ast::Stmt.Block(kind, _, _, inner, _):
                        # `assert_by` checks its proof body through the ghost checker; nested
                        # proof-step assertions are not executable runtime facts.
                        return false if kind != "assert_by" and not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, inner, parameters, declaration_line, declaration_offset, caller_owner, caller_owner_known, scratch, depth + 1, work, owner_source_work, uses)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |report, trace, source_certificate, certificate, parameters, declaration_line, declaration_offset, caller_owner, caller_owner_known, scratch, depth, work, owner_source_work, uses|:
                            return false if work >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT
                            work <- work + 1
                            return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, arm.body, parameters, declaration_line, declaration_offset, caller_owner, caller_owner_known, scratch, depth + 1, work, owner_source_work, uses)
                    _:
                        pass
            return true

        def proof_replay_runtime_fact_source_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_runtime_fact_source_valid_with_work(report, trace, &work)

        def proof_replay_runtime_fact_work_commit(work: usize, source_work: mutable usize&) -> bool:
            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            source_work <- source_work + work
            return true

        def proof_replay_runtime_fact_source_valid_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            proof_replay_runtime_fact_source_valid_with_cache(report, trace, source_work, &cache)

        def proof_replay_runtime_fact_source_valid_with_cache(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            if not cache.analysis_context_attempted:
                minimum_rows: mutable usize = 0
                if report.source.source_declarations.count >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT:
                    proof_replay_runtime_fact_work_commit(PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT, source_work)
                    return false
                minimum_rows <- report.source.source_declarations.count
                if report.source.source_annotations.count >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - minimum_rows:
                    proof_replay_runtime_fact_work_commit(PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT, source_work)
                    return false
                minimum_rows <- minimum_rows + report.source.source_annotations.count
                if report.source_types.source_generic_param_lines.count >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - minimum_rows:
                    proof_replay_runtime_fact_work_commit(PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT, source_work)
                    return false
                minimum_rows <- minimum_rows + report.source_types.source_generic_param_lines.count
                if report.source_types.source_generic_param_names.count >= PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - minimum_rows:
                    proof_replay_runtime_fact_work_commit(PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT, source_work)
                    return false
            return false if not proof_replay_deterministic_analysis_context_ensure(report, source_work, cache)
            work: mutable usize = 0
            valid: bool = proof_replay_runtime_fact_source_valid_unmetered(report, trace, cache.analysis_scratch, &work)
            return false if not proof_replay_runtime_fact_work_commit(work, source_work)
            return valid

        def proof_replay_runtime_fact_source_valid_unmetered(report: ProofReport&, trace: ProofFactTrace, scratch: mutable ProofReport&, work: mutable usize&) -> bool:
            return false if:
                trace.kind != "runtime-assert" and trace.kind != "runtime-guard"
                trace.name == "" or trace.line == 0 or trace.owner_line != 0 or report.analysis_2.replay_owner_line == 0
                report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
                certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
            body: mutable darray[Ast::Stmt] = []
            parameters: mutable darray[Ast::ParamDecl] = []
            function_owner: mutable sview = ""
            function_offset: mutable u32 = 0
            owner_matches: mutable usize = 0
            return false if:
                not proof_replay_runtime_fact_find_owner_body(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, "", &body, &parameters, &function_owner, &function_offset, &owner_matches, work, 0) or owner_matches != 1
                not proof_replay_control_certificate_attempt_unique_with_work(report, certificate, work)
            owner_source_work: mutable usize = 0
            owner_assertions: mutable usize = 0
            return false if:
                not proof_replay_control_assertion_scan(body, certificate, 0, &owner_source_work, &owner_assertions) or owner_assertions != 1
                owner_source_work > PROOF_REPLAY_RUNTIME_FACT_WORK_LIMIT - work
            work <- work + owner_source_work
            source_certificate: ProofGoalCertificate = ProofGoalCertificate{goal: trace.expression, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: trace.line, name: trace.name, rule: "goal", source_phase: "", replayed: false}
            source_matches: mutable usize = 0
            return false if not proof_replay_control_assertion_scan(body, source_certificate, 0, work, &source_matches) or source_matches != 1
            uses: mutable usize = 0
            return false if not proof_replay_runtime_fact_adjacent_use_scan(report, trace, source_certificate, certificate, body, parameters, report.analysis_2.replay_owner_line, function_offset, function_owner, true, scratch, 0, work, owner_source_work, &uses)
            uses == 1
