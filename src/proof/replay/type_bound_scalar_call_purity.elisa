# Admit scalar call witnesses only after a source-backed effect/purity analysis.
extend ElisaProof:
    private:
        def proof_replay_type_bound_scalar_call_source_pure(report: mutable ProofReport&, entry: ProofReplayDeterministicDeclarationEntry, row: usize, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if:
                row >= cache.declaration_index.entries.count
                not proof_replay_deterministic_call_alias_index_ensure(report, work, cache)
                not proof_replay_deterministic_call_alias_imports_ensure(report, work, cache)
                not proof_replay_deterministic_analysis_context_ensure(report, work, cache)
            return true if proof_replay_resource_call_pure_function(report, cache.analysis_scratch, cache.declaration_index, cache.alias_index, entry, work, 0)
            active: mutable darray[usize] = []
            # The fallback accepts richer, acyclic scalar bodies only after checking their
            # effect-free source form and recursively validating every resolved call edge.
            return proof_replay_deterministic_function_declaration(report.source.source_declarations, cache.declaration_index, cache.alias_index, report.source.source_annotations, report.source_contracts.source_signature_contract_lines, report.source_contracts.source_signature_contract_kinds, report.source_contracts.source_signature_contracts, entry.name, entry.owner, entry.declaration, row, &cache.analysis_scratch, active, work, 0)
