extend ElisaProof:
    private:
        const PROOF_REPLAY_I64_MAX: i64 = 9223372036854775807
        const PROOF_REPLAY_I64_MIN: i64 = 0 - 9223372036854775807 - 1

        struct ProofReplayInt:
            known: bool
            value: i64

        struct ProofReplayBound:
            name: sview
            lower: mutable i64
            upper: mutable i64
            has_lower: mutable bool
            has_upper: mutable bool

        struct ProofReplayAffine:
            known: bool
            base: sview
            offset: i64

        struct ProofReplayDifference:
            left: sview
            right: sview
            bound: i64

        def proof_replay_i64_max() -> i64:
            return PROOF_REPLAY_I64_MAX

        def proof_replay_i64_min() -> i64:
            return PROOF_REPLAY_I64_MIN

        def proof_replay_add_safe(left: i64, right: i64) -> ProofReplayInt:
            return ProofReplayInt{known: false, value: 0} if right > 0 and left > proof_replay_i64_max() - right
            return ProofReplayInt{known: false, value: 0} if right < 0 and left < proof_replay_i64_min() - right
            return ProofReplayInt{known: true, value: left + right}

        def proof_replay_sub_safe(left: i64, right: i64) -> ProofReplayInt:
            return ProofReplayInt{known: false, value: 0} if right > 0 and left < proof_replay_i64_min() + right
            return ProofReplayInt{known: false, value: 0} if right < 0 and left > proof_replay_i64_max() + right
            return ProofReplayInt{known: true, value: left - right}

        def proof_replay_mul_safe(left: i64, right: i64) -> ProofReplayInt:
            return ProofReplayInt{known: true, value: 0} if left == 0 or right == 0
            return ProofReplayInt{known: true, value: right} if left == 1
            return ProofReplayInt{known: true, value: left} if right == 1
            if left == -1:
                return ProofReplayInt{known: false, value: 0} if right == proof_replay_i64_min()
                return ProofReplayInt{known: true, value: 0 - right}
            if right == -1:
                return ProofReplayInt{known: false, value: 0} if left == proof_replay_i64_min()
                return ProofReplayInt{known: true, value: 0 - left}
            if left > 0:
                return ProofReplayInt{known: false, value: 0} if right > 0 and left > proof_replay_i64_max() / right
                return ProofReplayInt{known: false, value: 0} if right < 0 and right < proof_replay_i64_min() / left
            else:
                return ProofReplayInt{known: false, value: 0} if right > 0 and left < proof_replay_i64_min() / right
                return ProofReplayInt{known: false, value: 0} if right < 0 and right < proof_replay_i64_max() / left
            return ProofReplayInt{known: true, value: left * right}

        def proof_replay_div_safe(left: i64, right: i64) -> ProofReplayInt:
            return ProofReplayInt{known: false, value: 0} if right == 0 or (left == proof_replay_i64_min() and right == -1)
            return ProofReplayInt{known: true, value: left / right}

        def proof_replay_mod_safe(left: i64, right: i64) -> ProofReplayInt:
            return ProofReplayInt{known: false, value: 0} if right == 0 or (left == proof_replay_i64_min() and right == -1)
            return ProofReplayInt{known: true, value: left % right}

        def proof_replay_shift_safe(value: i64, amount: i64, left: bool) -> ProofReplayInt:
            return ProofReplayInt{known: false, value: 0} if amount < 0 or amount > ElisaProofKernelCore::PROOF_KERNEL_MAX_SHIFT_AMOUNT
            return ProofReplayInt{known: true, value: value << amount} if left
            return ProofReplayInt{known: true, value: value >> amount}

        def proof_replay_constant_int(expression: Ast::Expr) -> ProofReplayInt:
            return proof_replay_constant_int_depth(expression, 0)

        def proof_replay_constant_int_depth(expression: Ast::Expr, depth: usize) -> ProofReplayInt:
            return ProofReplayInt{known: false, value: 0} if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return ProofReplayInt{known: true, value: value}
                Ast::Expr.Paren(inner, _):
                    return proof_replay_constant_int_depth(inner, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    inner: ProofReplayInt = proof_replay_constant_int_depth(operand, depth + 1)
                    return ProofReplayInt{known: false, value: 0} if not inner.known
                    return inner if operator == TokenKind.Plus
                    if operator == TokenKind.Minus:
                        return ProofReplayInt{known: false, value: 0} if inner.value == proof_replay_i64_min()
                        return ProofReplayInt{known: true, value: 0 - inner.value}
                Ast::Expr.Binary(left, operator, right, _):
                    left_value: ProofReplayInt = proof_replay_constant_int_depth(left, depth + 1)
                    right_value: ProofReplayInt = proof_replay_constant_int_depth(right, depth + 1)
                    return ProofReplayInt{known: false, value: 0} if not left_value.known or not right_value.known
                    return proof_replay_add_safe(left_value.value, right_value.value) if operator == TokenKind.Plus
                    return proof_replay_sub_safe(left_value.value, right_value.value) if operator == TokenKind.Minus
                    return proof_replay_mul_safe(left_value.value, right_value.value) if operator == TokenKind.Star
                    return proof_replay_div_safe(left_value.value, right_value.value) if operator == TokenKind.Slash
                    return proof_replay_mod_safe(left_value.value, right_value.value) if operator == TokenKind.Percent
                    return ProofReplayInt{known: true, value: left_value.value & right_value.value} if operator == TokenKind.Ampersand
                    return ProofReplayInt{known: true, value: left_value.value | right_value.value} if operator == TokenKind.Pipe
                    return ProofReplayInt{known: true, value: left_value.value ^ right_value.value} if operator == TokenKind.Caret
                    return proof_replay_shift_safe(left_value.value, right_value.value, true) if operator == TokenKind.LShift
                    return proof_replay_shift_safe(left_value.value, right_value.value, false) if operator == TokenKind.RShift
                _:
                    pass
            return ProofReplayInt{known: false, value: 0}

        def proof_replay_constant_comparison(left: Ast::Expr, operator: TokenKind, right: Ast::Expr) -> bool:
            # Match the tactic and kernel: direct nonnegative literals compare exactly, while
            # arithmetic folds only inside the nonnegative i8 range at every intermediate.
            left_value: (known: bool, value: i64) = proof_safe_comparison_constant(left)
            right_value: (known: bool, value: i64) = proof_safe_comparison_constant(right)
            return false if not left_value.known or not right_value.known
            return left_value.value == right_value.value if operator == TokenKind.EqEq
            return left_value.value != right_value.value if operator == TokenKind.BangEq
            return left_value.value < right_value.value if operator == TokenKind.Lt
            return left_value.value > right_value.value if operator == TokenKind.Gt
            return left_value.value <= right_value.value if operator == TokenKind.LtEq
            return left_value.value >= right_value.value if operator == TokenKind.GtEq
            return false

        def proof_replay_bound_index(bounds: darray[ProofReplayBound]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < bounds.count |index, bounds, name|:
                return index if bounds[index].name == name
                index <- index + 1
            return bounds.count

        def proof_replay_bound_for(bounds: darray[ProofReplayBound]&, name: sview) -> ProofReplayBound:
            index: usize = proof_replay_bound_index(bounds, name)
            return bounds[index] if index < bounds.count
            return ProofReplayBound{name: name, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_replay_add_lower(bounds: mutable darray[ProofReplayBound]&, name: sview, value: i64) -> void:
            return if name == ""
            index: usize = proof_replay_bound_index(bounds, name)
            if index == bounds.count:
                bounds <- bounds.push(ProofReplayBound{name: name, has_lower: true, lower: value, has_upper: false, upper: 0})
                return
            old_has: bool = bounds[index].has_lower
            old_value: i64 = bounds[index].lower
            bounds[index].has_lower <- true
            bounds[index].lower <- value if not old_has or value > old_value

        def proof_replay_add_upper(bounds: mutable darray[ProofReplayBound]&, name: sview, value: i64) -> void:
            return if name == ""
            index: usize = proof_replay_bound_index(bounds, name)
            if index == bounds.count:
                bounds <- bounds.push(ProofReplayBound{name: name, has_lower: false, lower: 0, has_upper: true, upper: value})
                return
            old_has: bool = bounds[index].has_upper
            old_value: i64 = bounds[index].upper
            bounds[index].has_upper <- true
            bounds[index].upper <- value if not old_has or value < old_value

        def proof_replay_collect_bound_comparison(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, bounds: mutable darray[ProofReplayBound]&, work: mutable usize&) -> bool:
            checked: (complete: bool, matches: bool) = proof_replay_primitive_comparison_with_work(left, right, facts, work)
            return false if not checked.complete
            return true if not checked.matches
            left_name_check: (complete: bool, name: sview) = proof_replay_equality_ident_name(left, work, 0)
            return false if not left_name_check.complete
            right_name_check: (complete: bool, name: sview) = proof_replay_equality_ident_name(right, work, 0)
            return false if not right_name_check.complete
            left_constant_check: (complete: bool, constant: ProofReplayInt) = proof_replay_constant_int_with_equality_work(left, work)
            return false if not left_constant_check.complete
            right_constant_check: (complete: bool, constant: ProofReplayInt) = proof_replay_constant_int_with_equality_work(right, work)
            return false if not right_constant_check.complete
            left_name: sview = left_name_check.name
            right_name: sview = right_name_check.name
            left_constant: ProofReplayInt = left_constant_check.constant
            right_constant: ProofReplayInt = right_constant_check.constant
            if left_name != "" and right_constant.known:
                incremented: ProofReplayInt = proof_replay_add_safe(right_constant.value, 1)
                if operator == TokenKind.Gt and incremented.known:
                    return false if not proof_replay_add_lower_with_work(bounds, left_name, incremented.value, work)
                if operator == TokenKind.GtEq or operator == TokenKind.EqEq:
                    return false if not proof_replay_add_lower_with_work(bounds, left_name, right_constant.value, work)
                decremented: ProofReplayInt = proof_replay_sub_safe(right_constant.value, 1)
                if operator == TokenKind.Lt and decremented.known:
                    return false if not proof_replay_add_upper_with_work(bounds, left_name, decremented.value, work)
                if operator == TokenKind.LtEq or operator == TokenKind.EqEq:
                    return false if not proof_replay_add_upper_with_work(bounds, left_name, right_constant.value, work)
            if right_name != "" and left_constant.known:
                decremented_left: ProofReplayInt = proof_replay_sub_safe(left_constant.value, 1)
                if operator == TokenKind.Gt and decremented_left.known:
                    return false if not proof_replay_add_upper_with_work(bounds, right_name, decremented_left.value, work)
                if operator == TokenKind.GtEq or operator == TokenKind.EqEq:
                    return false if not proof_replay_add_upper_with_work(bounds, right_name, left_constant.value, work)
                incremented_left: ProofReplayInt = proof_replay_add_safe(left_constant.value, 1)
                if operator == TokenKind.Lt and incremented_left.known:
                    return false if not proof_replay_add_lower_with_work(bounds, right_name, incremented_left.value, work)
                if operator == TokenKind.LtEq or operator == TokenKind.EqEq:
                    return false if not proof_replay_add_lower_with_work(bounds, right_name, left_constant.value, work)
            return true

        def proof_replay_collect_bounds(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: mutable darray[ProofReplayBound]&, work: mutable usize&) -> bool:
            proof_replay_collect_bounds_depth(expression, facts, bounds, work, 0)

        def proof_replay_collect_bounds_depth(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: mutable darray[ProofReplayBound]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_equality_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_collect_bounds_depth(inner, facts, bounds, work, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated_operator: TokenKind = proof_replay_comparison_negation(operator)
                            return proof_replay_collect_bound_comparison(left, negated_operator, right, facts, bounds, work) if negated_operator != TokenKind.Eof
                        _:
                            pass
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And:
                        return false if not proof_replay_collect_bounds_depth(left, facts, bounds, work, depth + 1)
                        return proof_replay_collect_bounds_depth(right, facts, bounds, work, depth + 1)
                    else:
                        return proof_replay_collect_bound_comparison(left, operator, right, facts, bounds, work)
                _:
                    pass
            return true

        def proof_replay_ident_name(expression: Ast::Expr) -> sview:
            return proof_replay_ident_name_depth(expression, 0)

        def proof_replay_ident_name_depth(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_replay_ident_name_depth(inner, depth + 1)
                _:
                    pass
            return ""

        def proof_replay_affine_expression_with_work(expression: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, affine: ProofReplayAffine):
            empty: ProofReplayAffine = ProofReplayAffine{known: false, base: "", offset: 0}
            return (false, empty) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_equality_work_charge(1, work)
            constant_check: (complete: bool, constant: ProofReplayInt) = proof_replay_constant_int_with_equality_work(expression, work)
            return (false, empty) if not constant_check.complete
            constant: ProofReplayInt = constant_check.constant
            return (true, ProofReplayAffine{known: true, base: "", offset: constant.value}) if constant.known
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_affine_expression_with_work(inner, work, depth + 1)
                Ast::Expr.Ident(name, _):
                    return (true, ProofReplayAffine{known: name != "", base: name, offset: 0})
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_replay_affine_expression_with_work(operand, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    left_check: (complete: bool, affine: ProofReplayAffine) = proof_replay_affine_expression_with_work(left, work, depth + 1)
                    return (false, empty) if not left_check.complete
                    right_constant_check: (complete: bool, constant: ProofReplayInt) = proof_replay_constant_int_with_equality_work(right, work)
                    return (false, empty) if not right_constant_check.complete
                    left_affine: ProofReplayAffine = left_check.affine
                    right_constant: ProofReplayInt = right_constant_check.constant
                    if left_affine.known and left_affine.base != "" and right_constant.known:
                        if operator == TokenKind.Plus:
                            combined: ProofReplayInt = proof_replay_add_safe(left_affine.offset, right_constant.value)
                            return (true, ProofReplayAffine{known: true, base: left_affine.base, offset: combined.value}) if combined.known
                        if operator == TokenKind.Minus:
                            negated: ProofReplayInt = proof_replay_sub_safe(0, right_constant.value)
                            return (true, empty) if not negated.known
                            combined: ProofReplayInt = proof_replay_add_safe(left_affine.offset, negated.value)
                            return (true, ProofReplayAffine{known: true, base: left_affine.base, offset: combined.value}) if combined.known
                    left_constant_check: (complete: bool, constant: ProofReplayInt) = proof_replay_constant_int_with_equality_work(left, work)
                    return (false, empty) if not left_constant_check.complete
                    left_constant: ProofReplayInt = left_constant_check.constant
                    right_check: (complete: bool, affine: ProofReplayAffine) = proof_replay_affine_expression_with_work(right, work, depth + 1)
                    return (false, empty) if not right_check.complete
                    right_affine: ProofReplayAffine = right_check.affine
                    if left_constant.known and right_affine.known and right_affine.base != "" and operator == TokenKind.Plus:
                        combined: ProofReplayInt = proof_replay_add_safe(left_constant.value, right_affine.offset)
                        return (true, ProofReplayAffine{known: true, base: right_affine.base, offset: combined.value}) if combined.known
                _:
                    pass
            return (true, empty)

        def proof_replay_affine_safe_with_work(affine: ProofReplayAffine, bounds: darray[ProofReplayBound]&, work: mutable usize&) -> (complete: bool, safe: bool):
            return (true, false) if not affine.known
            return (true, true) if affine.base == "" or affine.offset == 0
            lookup: (complete: bool, index: usize) = proof_replay_bound_index_with_work(bounds, affine.base, work)
            return (false, false) if not lookup.complete
            bound: ProofReplayBound = bounds[lookup.index] if lookup.index < bounds.count else ProofReplayBound{name: affine.base, has_lower: false, lower: 0, has_upper: false, upper: 0}
            if affine.offset > 0:
                limit: ProofReplayInt = proof_replay_sub_safe(proof_replay_i64_max(), affine.offset)
                return (true, limit.known and bound.has_upper and bound.upper <= limit.value)
            limit: ProofReplayInt = proof_replay_sub_safe(proof_replay_i64_min(), affine.offset)
            return (true, limit.known and bound.has_lower and bound.lower >= limit.value)

        def proof_replay_affine_comparison(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            primitive: (complete: bool, matches: bool) = proof_replay_primitive_comparison_with_work(left, right, facts, work)
            return false if not primitive.complete or not primitive.matches
            left_affine_check: (complete: bool, affine: ProofReplayAffine) = proof_replay_affine_expression_with_work(left, work, 0)
            return false if not left_affine_check.complete
            right_affine_check: (complete: bool, affine: ProofReplayAffine) = proof_replay_affine_expression_with_work(right, work, 0)
            return false if not right_affine_check.complete
            left_affine: ProofReplayAffine = left_affine_check.affine
            right_affine: ProofReplayAffine = right_affine_check.affine
            return false if not left_affine.known or not right_affine.known
            return false if left_affine.base == "" or right_affine.base == ""
            return false if left_affine.base != right_affine.base and not proof_replay_names_equal_with_work(left_affine.base, right_affine.base, facts, work)
            bounds: mutable darray[ProofReplayBound] = []
            for fact in facts |bounds, work|:
                return false if not proof_replay_collect_bounds(fact, facts, &bounds, work)
            return false if not proof_replay_close_equalities_with_work(facts, &bounds, work)
            left_safe: (complete: bool, safe: bool) = proof_replay_affine_safe_with_work(left_affine, bounds, work)
            return false if not left_safe.complete or not left_safe.safe
            right_safe: (complete: bool, safe: bool) = proof_replay_affine_safe_with_work(right_affine, bounds, work)
            return false if not right_safe.complete or not right_safe.safe
            difference: ProofReplayInt = proof_replay_sub_safe(left_affine.offset, right_affine.offset)
            return false if not difference.known
            return difference.value > 0 if operator == TokenKind.Gt
            return difference.value >= 0 if operator == TokenKind.GtEq
            return difference.value < 0 if operator == TokenKind.Lt
            return difference.value <= 0 if operator == TokenKind.LtEq
            return difference.value != 0 if operator == TokenKind.BangEq
            return difference.value == 0 if operator == TokenKind.EqEq
            return false

        def proof_replay_interval(expression: Ast::Expr, bounds: darray[ProofReplayBound]&, work: mutable usize&) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            return (false, 0, 0, false, false) if not proof_replay_equality_work_charge(1, work)
            constant_check: (complete: bool, constant: ProofReplayInt) = proof_replay_constant_int_with_equality_work(expression, work)
            return (false, 0, 0, false, false) if not constant_check.complete
            constant: ProofReplayInt = constant_check.constant
            if constant.known:
                safe_nodes: (complete: bool, nodes: usize) = proof_replay_equality_constant_nodes(expression, work, 0)
                return (false, 0, 0, false, false) if not safe_nodes.complete or not proof_replay_equality_work_charge(safe_nodes.nodes, work)
                safe_constant: (known: bool, value: i64) = proof_safe_comparison_constant(expression)
                return (true, safe_constant.value, safe_constant.value, true, true) if safe_constant.known
                return (false, 0, 0, false, false)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_interval(inner, bounds, work)
                Ast::Expr.Ident(name, _):
                    lookup: (complete: bool, index: usize) = proof_replay_bound_index_with_work(bounds, name, work)
                    return (false, 0, 0, false, false) if not lookup.complete
                    bound: ProofReplayBound = bounds[lookup.index] if lookup.index < bounds.count else ProofReplayBound{name: name, has_lower: false, lower: 0, has_upper: false, upper: 0}
                    return (bound.has_lower and bound.has_upper, bound.lower, bound.upper, bound.has_lower, bound.has_upper)
                Ast::Expr.Unary(TokenKind.Minus, operand, _):
                    inner: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_replay_interval(operand, bounds, work)
                    negated_lower: ProofReplayInt = proof_replay_sub_safe(0, inner.upper)
                    negated_upper: ProofReplayInt = proof_replay_sub_safe(0, inner.lower)
                    return (false, 0, 0, false, false) if not negated_lower.known or not negated_upper.known
                    return (inner.has_lower and inner.has_upper, negated_lower.value, negated_upper.value, inner.has_upper, inner.has_lower)
                Ast::Expr.Binary(left, TokenKind.Plus, right, _):
                    a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_replay_interval(left, bounds, work)
                    b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_replay_interval(right, bounds, work)
                    lower_sum: ProofReplayInt = proof_replay_add_safe(a.lower, b.lower)
                    upper_sum: ProofReplayInt = proof_replay_add_safe(a.upper, b.upper)
                    has_lower: bool = a.has_lower and b.has_lower and lower_sum.known
                    has_upper: bool = a.has_upper and b.has_upper and upper_sum.known
                    return (has_lower and has_upper, lower_sum.value, upper_sum.value, has_lower, has_upper)
                Ast::Expr.Binary(left, TokenKind.Minus, right, _):
                    a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_replay_interval(left, bounds, work)
                    b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_replay_interval(right, bounds, work)
                    lower_difference: ProofReplayInt = proof_replay_sub_safe(a.lower, b.upper)
                    upper_difference: ProofReplayInt = proof_replay_sub_safe(a.upper, b.lower)
                    has_lower: bool = a.has_lower and b.has_upper and lower_difference.known
                    has_upper: bool = a.has_upper and b.has_lower and upper_difference.known
                    return (has_lower and has_upper, lower_difference.value, upper_difference.value, has_lower, has_upper)
                Ast::Expr.Binary(left, TokenKind.Slash, right, _):
                    divisor_check: (complete: bool, constant: ProofReplayInt) = proof_replay_constant_int_with_equality_work(right, work)
                    return (false, 0, 0, false, false) if not divisor_check.complete
                    divisor: ProofReplayInt = divisor_check.constant
                    dividend: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_replay_interval(left, bounds, work)
                    return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or not dividend.has_lower or not dividend.has_upper
                    lower_quotient: ProofReplayInt = proof_replay_div_safe(dividend.lower, divisor.value)
                    upper_quotient: ProofReplayInt = proof_replay_div_safe(dividend.upper, divisor.value)
                    return (false, 0, 0, false, false) if not lower_quotient.known or not upper_quotient.known
                    return (true, lower_quotient.value, upper_quotient.value, true, true) if divisor.value > 0
                    return (true, upper_quotient.value, lower_quotient.value, true, true)
                Ast::Expr.Binary(_, TokenKind.Percent, right, _):
                    divisor_check: (complete: bool, constant: ProofReplayInt) = proof_replay_constant_int_with_equality_work(right, work)
                    return (false, 0, 0, false, false) if not divisor_check.complete
                    divisor: ProofReplayInt = divisor_check.constant
                    # Keep AST replay conservative at the same fixed-width boundary as the
                    # producer and kernel: an interval cannot establish that MIN_I64 is absent.
                    return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or divisor.value == -1
                    magnitude: mutable i64 = divisor.value
                    if magnitude < 0:
                        absolute: ProofReplayInt = proof_replay_sub_safe(0, magnitude)
                        return (false, 0, 0, false, false) if not absolute.known
                        magnitude <- absolute.value
                    limit: ProofReplayInt = proof_replay_sub_safe(magnitude, 1)
                    return (false, 0, 0, false, false) if not limit.known
                    negative_limit: ProofReplayInt = proof_replay_sub_safe(0, limit.value)
                    return (false, 0, 0, false, false) if not negative_limit.known
                    return (true, negative_limit.value, limit.value, true, true)
                _:
                    pass
            return (false, 0, 0, false, false)

        def proof_replay_interval_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            return false if operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq
            primitive: (complete: bool, matches: bool) = proof_replay_primitive_comparison_with_work(left, right, facts, work)
            return false if not primitive.complete or not primitive.matches
            bounds: mutable darray[ProofReplayBound] = []
            for fact in facts |bounds, work|:
                return false if not proof_replay_collect_bounds(fact, facts, &bounds, work)
            return false if not proof_replay_close_equalities_with_work(facts, &bounds, work)
            a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_replay_interval(left, bounds, work)
            b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_replay_interval(right, bounds, work)
            return a.has_lower and b.has_upper and a.lower > b.upper if operator == TokenKind.Gt
            return a.has_lower and b.has_upper and a.lower >= b.upper if operator == TokenKind.GtEq
            return a.has_upper and b.has_lower and a.upper < b.lower if operator == TokenKind.Lt
            return a.has_upper and b.has_lower and a.upper <= b.lower if operator == TokenKind.LtEq
            return a.known and b.known and a.lower == a.upper and b.lower == b.upper and a.lower == b.lower if operator == TokenKind.EqEq
            return (a.has_upper and b.has_lower and a.upper < b.lower) or (a.has_lower and b.has_upper and a.lower > b.upper) if operator == TokenKind.BangEq
            return false
