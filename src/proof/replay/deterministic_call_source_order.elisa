# Exact byte-span ordering for deterministic call reconstruction. Logical lines can move
# backward under #line directives; incomplete or overlapping sibling spans refuse replay.
extend ElisaProof:
    private:
        def proof_replay_deterministic_call_expected_span(expected: Ast::Expr) -> Ast::Pos:
            return Ast::expr_pos(expected)

        def proof_replay_deterministic_call_expr_contains_expected(expression: Ast::Expr, expected: Ast::Expr, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            if depth >= 96:
                complete <- false
                return false
            cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost(expression, &cost, work, depth + 1)
            return false if not proof_replay_deterministic_call_match_charge(cost, work, complete)
            start: Ast::Pos = Ast::expr_pos(expression)
            target: Ast::Pos = proof_replay_deterministic_call_expected_span(expected)
            extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_expr_extent(expression, depth + 1)
            if start.offset == 0 or target.offset == 0 or target.end_offset <= target.offset or not extent.offsets_complete or extent.end_offset <= start.offset:
                complete <- false
                return false
            overlaps: bool = target.offset < extent.end_offset and start.offset < target.end_offset
            if overlaps:
                if target.offset < start.offset or target.end_offset > extent.end_offset:
                    complete <- false
                    return false
                return true
            return false

        def proof_replay_deterministic_call_statement_order(statement: Ast::Stmt, expected: Ast::Expr, previous_end: u32, work: mutable usize&, complete: mutable bool&) -> (valid: bool, after_expected: bool, end_offset: u32):
            single: mutable darray[Ast::Stmt] = [statement]
            cost: mutable usize = 0
            return (false, false, 0) if not proof_replay_summary_expr_cost_body(single, &cost, work, 0)
            return (false, false, 0) if not proof_replay_deterministic_call_match_charge(cost, work, complete)
            position: Ast::Pos = proof_replay_statement_position(statement)
            target: Ast::Pos = proof_replay_deterministic_call_expected_span(expected)
            extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(statement, 0)
            if position.offset == 0 or target.offset == 0 or target.end_offset <= target.offset or not extent.offsets_complete or extent.end_offset <= position.offset or position.offset < previous_end:
                complete <- false
                return (false, false, 0)
            if target.end_offset <= position.offset:
                return (true, true, extent.end_offset)
            if extent.end_offset <= target.offset:
                return (true, false, extent.end_offset)
            if target.offset < position.offset or target.end_offset > extent.end_offset:
                complete <- false
                return (false, false, 0)
            return (true, false, extent.end_offset)
