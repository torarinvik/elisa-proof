extend ElisaProof:
    private:
        # Locate the one supported call-entry place without consulting producer metadata. Call-old
        # replay is intentionally limited to a zero-index reference belonging to one formal.
        def proof_replay_old_reference_parameter(expression: Ast::Expr, depth: usize) -> (known: bool, found: bool, parameter: sview):
            return (false, true, "") if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    if proof_replay_ident_name(callee) == "old":
                        return (false, true, "") if arguments.count != 1
                        match arguments[0]:
                            Ast::Expr.Index(object, index, _):
                                match object:
                                    Ast::Expr.Ident(parameter, _):
                                        match index:
                                            Ast::Expr.IntLit(offset, _):
                                                return (true, true, parameter) if offset == 0
                                            _:
                                                pass
                                    _:
                                        pass
                            _:
                                pass
                        return (false, true, "")
                    found: mutable (known: bool, found: bool, parameter: sview) = proof_replay_old_reference_parameter(callee, depth + 1)
                    for argument in arguments |found, depth|:
                        child: (known: bool, found: bool, parameter: sview) = proof_replay_old_reference_parameter(argument, depth + 1)
                        return (false, true, "") if not child.known or found.found and child.found and found.parameter != child.parameter
                        found <- child if child.found
                    return found
                Ast::Expr.Paren(inner, _):
                    return proof_replay_old_reference_parameter(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_replay_old_reference_parameter(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    left_result: (known: bool, found: bool, parameter: sview) = proof_replay_old_reference_parameter(left, depth + 1)
                    right_result: (known: bool, found: bool, parameter: sview) = proof_replay_old_reference_parameter(right, depth + 1)
                    return (false, true, "") if not left_result.known or not right_result.known or left_result.found and right_result.found and left_result.parameter != right_result.parameter
                    return left_result if left_result.found else right_result
                _:
                    return (true, false, "")

        def proof_replay_expr_is_invalid(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Invalid:
                    return true
                _:
                    return false

        def proof_replay_substitute_old_reference_call(expression: Ast::Expr, parameter: sview, snapshot: Ast::Expr, depth: usize) -> Ast::Expr:
            return Ast::Expr.Invalid if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    if proof_replay_ident_name(callee) == "old":
                        return Ast::Expr.Invalid if arguments.count != 1
                        match arguments[0]:
                            Ast::Expr.Index(object, index, _):
                                match object:
                                    Ast::Expr.Ident(name, _):
                                        match index:
                                            Ast::Expr.IntLit(offset, _):
                                                return snapshot if name == parameter and offset == 0
                                            _:
                                                pass
                                    _:
                                        pass
                            _:
                                pass
                        return Ast::Expr.Invalid
                    substituted_callee: Ast::Expr = proof_replay_substitute_old_reference_call(callee, parameter, snapshot, depth + 1)
                    return Ast::Expr.Invalid if proof_replay_expr_is_invalid(substituted_callee)
                    substituted_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |substituted_arguments, parameter, snapshot, depth|:
                        substituted: Ast::Expr = proof_replay_substitute_old_reference_call(argument, parameter, snapshot, depth + 1)
                        return Ast::Expr.Invalid if proof_replay_expr_is_invalid(substituted)
                        substituted_arguments.push(substituted)
                    return Ast::Expr.Call(substituted_callee, substituted_arguments, argument_names, position)
                Ast::Expr.Paren(inner, position):
                    return Ast::Expr.Paren(proof_replay_substitute_old_reference_call(inner, parameter, snapshot, depth + 1), position)
                Ast::Expr.Unary(operator, operand, position):
                    return Ast::Expr.Unary(operator, proof_replay_substitute_old_reference_call(operand, parameter, snapshot, depth + 1), position)
                Ast::Expr.Binary(left, operator, right, position):
                    return Ast::Expr.Binary(proof_replay_substitute_old_reference_call(left, parameter, snapshot, depth + 1), operator, proof_replay_substitute_old_reference_call(right, parameter, snapshot, depth + 1), position)
                _:
                    return expression
