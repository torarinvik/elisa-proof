# Source binding for the declared-row containment rule. The source-neutral kernel
# still checks set containment; this layer independently checks what those sets
# and executable edges describe. It never supplies a native body/resource summary.
extend ElisaProof:
    private:
        def proof_replay_effect_pairwise_work_charge(count: usize, work: mutable usize&) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if count != 0:
                return false if count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / count
                work <- work + count * count
            return true

        def proof_replay_effect_names_work_charge(names: darray[sview]&, work: mutable usize&) -> bool:
            return false if names.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + names.count
            return false if not proof_replay_effect_pairwise_work_charge(names.count, work)
            return false if not proof_replay_effect_pairwise_work_charge(names.count, work)
            name_bytes: mutable usize = 0
            for name in names |work|:
                return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(name)
                return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - name_bytes
                name_bytes <- name_bytes + sview_len(name)
            if names.count != 0:
                return false if names.count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / 2
                comparison_factor: usize = names.count * 2
                return false if name_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / comparison_factor
                work <- work + name_bytes * comparison_factor
            return true

        def proof_replay_effect_string_compare_charge(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work <- work + 1
            return false if sview_len(left) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + sview_len(left)
            return false if sview_len(right) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + sview_len(right)
            return true

        def proof_replay_effect_parameter_defaults_work_charge(parameters: darray[Ast::ParamDecl]&, work: mutable usize&) -> bool:
            return false if parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + parameters.count
            for parameter in parameters |work|:
                return false if sview_len(parameter.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(parameter.name)
                if parameter.has_default:
                    return false if not proof_replay_summary_expr_charge_with_work(parameter.default_value, work)
            return true

        def proof_replay_effect_annotations_work_charge(annotations: darray[Ast::EnumAnnotation]&, work: mutable usize&) -> bool:
            return false if annotations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + annotations.count
            for annotation in annotations |work|:
                return false if sview_len(annotation.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.name)
                return false if sview_len(annotation.owner) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.owner)
                return false if sview_len(annotation.module) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.module)
            return true

        def proof_replay_effect_extern_row_extra_work_charge(annotations: darray[Ast::EnumAnnotation]&, owner: sview, line: u32, members: darray[sview]&, work: mutable usize&) -> bool:
            row_bytes: mutable usize = 0
            reference_count: mutable usize = 0
            reference_bytes: mutable usize = 0
            member_bytes: mutable usize = 0
            for member in members |member_bytes|:
                return false if sview_len(member) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - member_bytes
                member_bytes <- member_bytes + sview_len(member)
            for annotation in annotations |annotation, owner, line, row_bytes, reference_count, reference_bytes|:
                row_bytes <- sview_len(annotation.name) if annotation.line == line and annotation.owner == "__extern_effect_row_text" and sview_len(annotation.name) > row_bytes
                if annotation.line == line and annotation.owner == "__extern_effect_ref":
                    reference_count <- reference_count + 1
                    return false if sview_len(annotation.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - reference_bytes
                    reference_bytes <- reference_bytes + sview_len(annotation.name)
            # The parser caps both the parsed row and the source member set at 128 entries, and
            # caps row text at 4096 bytes. Reserve pairwise comparisons plus their worst-case
            # byte work against the actual row/member/implicit-reference widths.
            count_work: mutable usize = 128 * 128 * 3
            return false if reference_count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - count_work) / 128
            count_work <- count_work + reference_count * 128
            return false if count_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + count_work
            return false if row_bytes > 4096
            return false if row_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / 136
            work <- work + row_bytes * 136
            return false if members.count != 0 and row_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / members.count
            work <- work + members.count * row_bytes
            return false if member_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / 256
            work <- work + member_bytes * 256
            return false if reference_count != 0 and row_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / reference_count
            work <- work + reference_count * row_bytes
            return false if reference_count != 0 and reference_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / 128
            work <- work + reference_bytes * 128
            return true

        def proof_replay_effect_member_concrete(name: sview) -> bool:
            for offset in 0..<sview_len(name) |offset, name|:
                return true if sview_at(name, offset) == 46
            return false

        def proof_replay_effect_named_declaration(declarations: darray[Ast::Decl]&, wanted: sview, depth: usize) -> (matches: usize, declaration: Ast::Decl):
            return (2, Ast::Decl.Invalid) if depth >= 96 or wanted == ""
            matches: mutable usize = 0
            selected: mutable Ast::Decl = Ast::Decl.Invalid
            for declaration in declarations |wanted, depth, matches, selected|:
                name: mutable sview = ""
                match declaration:
                    Ast::Decl.Func(found, _, _, _, _, _, _):
                        name <- found
                    Ast::Decl.Extern(found, _, _, _, _, _, _, _):
                        name <- found
                    Ast::Decl.Const(found, _, _, _, _):
                        name <- found
                    Ast::Decl.Struct(found, _, _, _, _, _, _):
                        name <- found
                    Ast::Decl.Enum(found, _, _, _, _):
                        name <- found
                    Ast::Decl.Alias(found, _, _):
                        name <- found
                    Ast::Decl.Law(found, _, _):
                        name <- found
                    Ast::Decl.Import(found, _):
                        name <- found
                    Ast::Decl.Module(found, body, _):
                        name <- found
                        nested = proof_replay_effect_named_declaration(&body, wanted, depth + 1)
                        matches <- matches + nested.matches
                        selected <- nested.declaration if nested.matches != 0
                    Ast::Decl.Scoped(body, _):
                        nested = proof_replay_effect_named_declaration(&body, wanted, depth + 1)
                        matches <- matches + nested.matches
                        selected <- nested.declaration if nested.matches != 0
                    Ast::Decl.Invalid:
                        return (2, Ast::Decl.Invalid)
                if name == wanted:
                    matches <- matches + 1
                    selected <- declaration
                return (2, Ast::Decl.Invalid) if matches > 1
            return (matches, selected)

        def proof_replay_effect_kernel_row(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, members: mutable darray[sview]&) -> bool:
            members.clear()
            return false if root >= nodes.count or nodes[root].kind != "effect-row"
            row: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if row.children_start > children.count or row.children_count > children.count - row.children_start
            for offset in 0..<row.children_count |offset, row, children, nodes, members|:
                member: usize = children[row.children_start + offset]
                return false if member >= nodes.count or nodes[member].kind != "effect" or nodes[member].name == ""
                name: sview = nodes[member].name
                return false if not proof_replay_effect_member_concrete(name)
                return false if any previous in members where previous == name
                members.push(name)
            return true

        def proof_replay_effect_kernel_row_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, members: mutable darray[sview]&, work: mutable usize&) -> bool:
            return false if root >= nodes.count or nodes[root].kind != "effect-row"
            row: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if row.children_start > children.count or row.children_count > children.count - row.children_start
            return false if not proof_replay_effect_pairwise_work_charge(row.children_count, work)
            return false if row.children_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + row.children_count
            name_bytes: mutable usize = 0
            for offset in 0..<row.children_count |offset, row, children, nodes, work, name_bytes|:
                member: usize = children[row.children_start + offset]
                return false if member >= nodes.count or nodes[member].kind != "effect" or nodes[member].name == ""
                name: sview = nodes[member].name
                return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(name)
                return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - name_bytes
                name_bytes <- name_bytes + sview_len(name)
            if row.children_count != 0:
                return false if row.children_count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / row.children_count
                compare_bytes: usize = row.children_count * row.children_count
                return false if name_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / compare_bytes
                work <- work + name_bytes * compare_bytes
            return proof_replay_effect_kernel_row(nodes, children, root, members)

        def proof_replay_effect_function_row_matches(source: darray[sview]&, members: darray[sview]&) -> bool:
            unique: mutable darray[sview] = []
            for name in source |unique|:
                return false if name == "" or not proof_replay_effect_member_concrete(name)
                unique.push(name) if not (any previous in unique where previous == name)
            return false if unique.count != members.count
            for member in members |unique|:
                return false if not (any declared in unique where declared == member)
            return true

        def proof_replay_effect_callee_source_matches(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, parameters: darray[Ast::ExternParam]&, name: sview, members: darray[sview]&) -> bool:
            source = proof_replay_effect_named_declaration(declarations, name, 0)
            return false if source.matches != 1
            return false if any annotation in annotations where annotation.owner == "__lemma" and annotation.name == name
            match source.declaration:
                Ast::Decl.Func(_, _, _, _, effects, _, _):
                    return proof_replay_effect_function_row_matches(&effects, members)
                Ast::Decl.Extern(_, first, arity, _, callable, _, _, position):
                    start: usize = first.usize()
                    count: usize = arity.usize()
                    return false if not callable or start > parameters.count or count > parameters.count - start
                    return proof_replay_extern_effect_row_matches(annotations, name, position.line, members)
                _:
                    return false

        def proof_replay_effect_callee_source_matches_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, parameters: darray[Ast::ExternParam]&, name: sview, members: darray[sview]&, source_work: mutable usize&) -> bool:
            return false if not proof_replay_deterministic_declaration_scan_charge(declarations, source_work, 0)
            return false if not proof_replay_effect_annotations_work_charge(annotations, source_work)
            source = proof_replay_effect_named_declaration(declarations, name, 0)
            return false if source.matches != 1
            return false if any annotation in annotations where annotation.owner == "__lemma" and annotation.name == name
            match source.declaration:
                Ast::Decl.Func(_, _, _, _, effects, _, _):
                    return false if not proof_replay_effect_names_work_charge(&effects, source_work)
                    return proof_replay_effect_function_row_matches(&effects, members)
                Ast::Decl.Extern(_, first, arity, _, callable, _, _, position):
                    start: usize = first.usize()
                    count: usize = arity.usize()
                    return false if not callable or start > parameters.count or count > parameters.count - start
                    # The extern decoder scans annotations twice; the dynamic bound helper
                    # scans once more to size its comparison budget.
                    return false if not proof_replay_effect_annotations_work_charge(annotations, source_work)
                    return false if not proof_replay_effect_annotations_work_charge(annotations, source_work)
                    return false if not proof_replay_effect_annotations_work_charge(annotations, source_work)
                    return false if not proof_replay_effect_extern_row_extra_work_charge(annotations, name, position.line, members, source_work)
                    return proof_replay_extern_effect_row_matches(annotations, name, position.line, members)
                _:
                    return false

        def proof_replay_effect_source_valid(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, parameters: darray[Ast::ExternParam]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, owner: sview, line: u32) -> bool:
            work: mutable usize = 0
            return proof_replay_effect_source_valid_with_work(declarations, annotations, parameters, nodes, children, root, owner, line, &work)

        def proof_replay_effect_source_valid_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, parameters: darray[Ast::ExternParam]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, owner: sview, line: u32, source_work: mutable usize&) -> bool:
            return false if root >= nodes.count or nodes[root].kind != "effect-containment" or nodes[root].name != owner
            return false if not proof_replay_deterministic_declaration_scan_charge(declarations, source_work, 0)
            return false if not proof_replay_effect_annotations_work_charge(annotations, source_work)
            source = proof_replay_effect_named_declaration(declarations, owner, 0)
            return false if source.matches != 1
            return false if any annotation in annotations where annotation.owner == "__lemma" and annotation.name == owner
            containment: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if containment.children_start > children.count or containment.children_count > children.count - containment.children_start
            declared: mutable darray[sview] = []
            return false if not proof_replay_effect_kernel_row_with_work(nodes, children, containment.left, &declared, source_work)
            expected_calls: mutable darray[sview] = []
            for offset in 0..<containment.children_count |offset, containment, nodes, children, declarations, annotations, parameters, expected_calls, source_work|:
                call: usize = children[containment.children_start + offset]
                return false if call >= nodes.count or nodes[call].kind != "effect-call"
                name: sview = nodes[call].name
                return false if name == ""
                duplicate: mutable bool = false
                for previous in expected_calls |previous, name, duplicate, source_work|:
                    return false if not proof_replay_effect_string_compare_charge(previous, name, source_work)
                    duplicate <- true if previous == name
                return false if duplicate
                members: mutable darray[sview] = []
                return false if not proof_replay_effect_kernel_row_with_work(nodes, children, nodes[call].left, &members, source_work)
                return false if not proof_replay_effect_callee_source_matches_with_work(declarations, annotations, parameters, name, &members, source_work)
                expected_calls.push(name)
            match source.declaration:
                Ast::Decl.Func(_, source_parameters, _, body, effects, _, position):
                    return false if not proof_replay_effect_names_work_charge(&effects, source_work)
                    return position.line == line and proof_replay_effect_function_row_matches(&effects, &declared) and proof_replay_source_call_set_matches_with_work(&source_parameters, &body, &expected_calls, source_work)
                _:
                    return false
