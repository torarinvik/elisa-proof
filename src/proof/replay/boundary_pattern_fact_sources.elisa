extend ElisaProof:
    private:
        # Bound recursive source-pattern walks before replay reconstructs a fact. Unsupported
        # shapes still fail in the replay-local condition and exactness visitors.
        def proof_replay_control_pattern_within_budget(pattern: Ast::Pattern, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Literal(text) | Ast::Pattern.Other(text):
                    return proof_replay_control_pattern_text_work_charge(text, work)
                Ast::Pattern.Range(low, high, _):
                    return false if not proof_replay_control_pattern_text_work_charge(low, work)
                    return proof_replay_control_pattern_text_work_charge(high, work)
                Ast::Pattern.As(name, inner) | Ast::Pattern.Field(name, inner):
                    return false if not proof_replay_control_pattern_text_work_charge(name, work)
                    for child in inner |depth, work|:
                        return false if not proof_replay_control_pattern_within_budget(child, depth + 1, work)
                Ast::Pattern.Binding(name) | Ast::Pattern.Pin(name) | Ast::Pattern.Rest(name):
                    return proof_replay_control_pattern_text_work_charge(name, work)
                Ast::Pattern.TypeBind(type_name, binder):
                    return false if not proof_replay_control_pattern_text_work_charge(type_name, work)
                    return proof_replay_control_pattern_text_work_charge(binder, work)
                Ast::Pattern.Variant(path, options) | Ast::Pattern.Struct(path, options):
                    return false if not proof_replay_control_pattern_text_work_charge(path, work)
                    for child in options |depth, work|:
                        return false if not proof_replay_control_pattern_within_budget(child, depth + 1, work)
                Ast::Pattern.Or(options) | Ast::Pattern.Tuple(options):
                    for child in options |depth, work|:
                        return false if not proof_replay_control_pattern_within_budget(child, depth + 1, work)
                _:
                    pass
            return true
        def proof_replay_control_pattern_text_work_charge(text: sview, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            if sview_len(text) > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            work <- work + sview_len(text)
            return true
        def proof_replay_control_pattern_repeat_charge(pattern: Ast::Pattern, repetitions: usize, work: mutable usize&) -> bool:
            start: usize = work
            return false if not proof_replay_control_pattern_within_budget(pattern, 0, work)
            pattern_work: usize = work - start
            return false if work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            remaining: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
            if repetitions != 0 and pattern_work > remaining / repetitions:
                work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return false
            work <- work + pattern_work * repetitions
            return true

        def proof_replay_control_pattern_irrefutable_work_charge(pattern: Ast::Pattern, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.As(name, inner):
                    return false if name == "" or not proof_replay_control_pattern_text_work_charge(name, work) or inner.count != 1
                    return proof_replay_control_pattern_irrefutable_work_charge(inner[0], depth + 1, work)
                Ast::Pattern.Field(name, inner):
                    return false if name == "" or not proof_replay_control_pattern_text_work_charge(name, work) or inner.count != 1
                    return proof_replay_control_pattern_irrefutable_work_charge(inner[0], depth + 1, work)
                Ast::Pattern.Binding(name):
                    return name != "" and proof_replay_control_pattern_text_work_charge(name, work)
                Ast::Pattern.Wildcard:
                    return true
                _:
                    return false
        # Pattern.Literal erases the source token kind. For a direct string formal, the pinned
        # compiler selects string-match lowering from the scrutinee type and compares the
        # retained payload as bytes; a quoted "42" and bare 42 therefore denote the same string
        # match in that context. Integer-scrutinee literals, Boolean facts, and ranges remain
        # closed until their token kind and fixed-width semantics are source-bound.
        def proof_replay_control_pattern_type_is_direct_string(type_expression: Ast::Expr) -> bool:
            match proof_strip_parens(type_expression):
                Ast::Expr.Ident(name, _):
                    return name in {"sview", "cstr"}
                _:
                    return false

        def proof_replay_control_pattern_type_is_direct_char(type_expression: Ast::Expr) -> bool:
            match proof_strip_parens(type_expression):
                Ast::Expr.Ident(name, _):
                    return name == "char"
                _:
                    return false

        def proof_replay_control_pattern_unambiguous_string_with_work(text: sview, work: mutable usize&) -> bool:
            length: usize = sview_len(text)
            return false if length > 16384 or work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            remaining: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
            return false if length > (remaining - 1) / 4
            work <- work + length * 4 + 1
            for index in 0..<length |index, text|:
                character: u8 = text[index]
                return false if character < 32 or character > 126 or character == 34 or character == 92
            true

        def proof_replay_control_pattern_unambiguous_char(text: sview) -> bool:
            length: usize = sview_len(text)
            return false if length < 3 or text[0] != 39 or text[length - 1] != 39
            interior_length: usize = length - 2
            if interior_length == 1:
                character: u8 = text[1]
                return character >= 32 and character <= 126 and character != 39 and character != 92
            if interior_length == 2 and text[1] == 92:
                escaped: u8 = text[2]
                return escaped == 110 or escaped == 116 or escaped == 114 or escaped == 48 or escaped == 92 or escaped == 39
            false

        def proof_replay_control_pattern_needs_source_type(pattern: Ast::Pattern) -> bool:
            match pattern:
                Ast::Pattern.Literal(_) | Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.As(_, inner):
                    return inner.count == 1 and proof_replay_control_pattern_needs_source_type(inner[0])
                Ast::Pattern.Or(options):
                    for option in options |options|:
                        return true if proof_replay_control_pattern_needs_source_type(option)
                _:
                    pass
            return false

        # The shared write scan charges a bounded reservation against the summary meter.
        # Narrow that reservation to CONTROL here; refusal is treated as a possible touch.
        def proof_replay_control_pattern_body_touches_with_work(report: ProofReport&, body: darray[Ast::Stmt]&, name: sview, writes: bool, work: mutable usize&) -> bool:
            return true if work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            remaining: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
            seed: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - remaining
            virtual_work: mutable usize = seed
            touches: bool = proof_replay_source_body_touches_with_work(report.source.source_declarations, body, name, writes, &virtual_work)
            if virtual_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or virtual_work < seed:
                work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return true
            query_work: usize = virtual_work - seed
            if query_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return true
            work <- work + query_work
            touches

        def proof_replay_control_pattern_source_charge(amount: usize, work: mutable usize&) -> bool:
            return false if work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT or amount > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
            work <- work + amount
            true

        def proof_replay_control_pattern_source_text_equal(left: sview, right: sview, work: mutable usize&) -> (complete: bool, equal: bool):
            return (false, false) if not proof_replay_control_pattern_source_charge(1, work)
            return (false, false) if not proof_replay_control_pattern_source_charge(sview_len(left), work)
            return (false, false) if not proof_replay_control_pattern_source_charge(sview_len(right), work)
            return (true, left == right)

        # Replay independently locates the source formal and rejects body shadowing instead of
        # delegating those semantic decisions to the producer's pattern-type lookup.
        def proof_replay_control_pattern_source_formal_type_find(declarations: darray[Ast::Decl]&, function_name: sview, parameter: sview, found: mutable Ast::Expr&, function_line: mutable u32&, function_offset: mutable usize&, function_module: mutable sview&, declaration_module: mutable sview&, module_path: mutable darray[sview]&, function_module_path: mutable darray[sview]&, function_matches: mutable usize&, parameter_matches: mutable usize&, work: mutable usize&, complete: mutable bool&, depth: usize) -> void:
            if depth >= PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT or not proof_replay_control_pattern_source_charge(1, work):
                complete <- false
                return
            for declaration in declarations |function_name, parameter, found, function_line, function_offset, function_module, declaration_module, module_path, function_module_path, function_matches, parameter_matches, work, complete, depth|:
                if not proof_replay_control_pattern_source_charge(1, work):
                    complete <- false
                    return
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, position):
                        function_name_match: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(name, function_name, work)
                        if not function_name_match.complete:
                            complete <- false
                            return
                        if function_name_match.equal:
                            function_matches <- function_matches + 1
                            function_line <- position.line
                            function_offset <- position.offset.usize()
                            declaration_module <- function_module
                            function_module_path.clear()
                            for module_segment in module_path |module_segment, function_module_path, work, complete|:
                                if not proof_replay_control_pattern_source_charge(sview_len(module_segment), work):
                                    complete <- false
                                    return
                                if not proof_replay_control_pattern_source_charge(2, work):
                                    complete <- false
                                    return
                                function_module_path.push(module_segment)
                            matching_parameters: mutable usize = 0
                            for candidate in parameters |parameter, found, parameter_matches, matching_parameters, work, complete|:
                                parameter_match: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(candidate.name, parameter, work)
                                if not parameter_match.complete:
                                    complete <- false
                                    return
                                if parameter_match.equal:
                                    matching_parameters <- matching_parameters + 1
                                    parameter_matches <- parameter_matches + 1
                                    found <- candidate.type_expression
                            if matching_parameters != 0:
                                source_remaining: usize = PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - work
                                source_seed: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_remaining
                                source_work: mutable usize = source_seed
                                declares_parameter: bool = proof_replay_source_body_declares_with_work(declarations, body, parameter, &source_work)
                                if source_work < source_seed or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                    complete <- false
                                    return
                                body_scan_work: usize = source_work - source_seed
                                if not proof_replay_control_pattern_source_charge(body_scan_work, work):
                                    complete <- false
                                    return
                                complete <- false if declares_parameter
                    Ast::Decl.Module(module_name, body, _):
                        prior_module: sview = function_module
                        function_module <- module_name
                        nested_path: (complete: bool, scope: darray[sview]) = proof_replay_global_constant_scope_with_module_and_work(module_path, module_name, work)
                        if not nested_path.complete or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT:
                            complete <- false
                            return
                        proof_replay_control_pattern_source_formal_type_find(body, function_name, parameter, found, function_line, function_offset, function_module, declaration_module, nested_path.scope, function_module_path, function_matches, parameter_matches, work, complete, depth + 1)
                        function_module <- prior_module
                    Ast::Decl.Scoped(body, _):
                        proof_replay_control_pattern_source_formal_type_find(body, function_name, parameter, found, function_line, function_offset, function_module, declaration_module, module_path, function_module_path, function_matches, parameter_matches, work, complete, depth + 1)
                    Ast::Decl.Invalid:
                        complete <- false
                        return
                    _:
                        pass

        # Replay scans root declarations and the exact owner path independently of the producer.
        def proof_replay_control_pattern_builtin_name_shadowed(declarations: darray[Ast::Decl]&, wanted: sview, owner_path: darray[sview]&, current_path: mutable darray[sview]&, work: mutable usize&, depth: usize) -> (complete: bool, shadowed: bool):
            return (false, false) if depth >= PROOF_PATTERN_SOURCE_TYPE_DEPTH_LIMIT or not proof_replay_control_pattern_source_charge(1, work)
            for declaration in declarations |wanted, owner_path, current_path, work, depth|:
                return (false, false) if not proof_replay_control_pattern_source_charge(1, work)
                match declaration:
                    Ast::Decl.Alias(name, _, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        same_name: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(name, wanted, work)
                        return (false, false) if not same_name.complete
                        return (true, true) if same_name.equal
                    Ast::Decl.Module(module_name, nested, _):
                        nested_path: (complete: bool, scope: darray[sview]) = proof_replay_global_constant_scope_with_module_and_work(current_path, module_name, work)
                        return (false, false) if not nested_path.complete or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                        continue if nested_path.scope.count > owner_path.count
                        path_matches: mutable bool = true
                        for index in 0..<nested_path.scope.count |index, nested_path, owner_path, work, path_matches|:
                            module_match: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(nested_path.scope[index], owner_path[index], work)
                            return (false, false) if not module_match.complete or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                            path_matches <- false if not module_match.equal
                        continue if not path_matches
                        nested_status: (complete: bool, shadowed: bool) = proof_replay_control_pattern_builtin_name_shadowed(nested, wanted, owner_path, nested_path.scope, work, depth + 1)
                        return nested_status if not nested_status.complete or nested_status.shadowed
                    Ast::Decl.Scoped(nested, _):
                        nested_status: (complete: bool, shadowed: bool) = proof_replay_control_pattern_builtin_name_shadowed(nested, wanted, owner_path, current_path, work, depth + 1)
                        return nested_status if not nested_status.complete or nested_status.shadowed
                    Ast::Decl.Invalid:
                        return (false, false)
                    _:
                        pass
            return (true, false)

        # Qualified import scopes can be matched exactly. A simple module spelling may be
        # shared by siblings, so keep the conservative any-ancestor match for that case.
        def proof_replay_control_pattern_import_scope_visible(owner_path: darray[sview]&, import_module: sview, work: mutable usize&) -> (complete: bool, visible: bool):
            if import_module == "":
                return (true, true)
            empty_scope: darray[sview] = []
            normalized: (complete: bool, scope: darray[sview]) = proof_replay_global_constant_scope_with_module_and_work(empty_scope, import_module, work)
            return (false, false) if not normalized.complete or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
            if normalized.scope.count > 1:
                return (true, false) if owner_path.count < normalized.scope.count
                for index in 0..<normalized.scope.count |index, owner_path, normalized, work|:
                    same_module: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(owner_path[index], normalized.scope[index], work)
                    return (false, false) if not same_module.complete or work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT
                    return (true, false) if not same_module.equal
                return (true, true)
            for segment in owner_path |segment, import_module, work|:
                same_module: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(segment, import_module, work)
                return (false, false) if not same_module.complete
                return (true, true) if same_module.equal
            (true, false)

        def proof_replay_control_pattern_builtin_import_shadowed(annotations: darray[Ast::EnumAnnotation]&, wanted: sview, owner_path: darray[sview]&, work: mutable usize&) -> (complete: bool, shadowed: bool):
            for annotation in annotations |wanted, work|:
                return (false, false) if not proof_replay_control_pattern_source_charge(1, work)
                imported_name: mutable sview = ""
                wildcard_marker: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(annotation.name, "__binding_wildcard_import", work)
                return (false, false) if not wildcard_marker.complete
                if wildcard_marker.equal:
                    wildcard_scope: (complete: bool, visible: bool) = proof_replay_control_pattern_import_scope_visible(owner_path, annotation.module, work)
                    return (false, false) if not wildcard_scope.complete
                    return (false, false) if wildcard_scope.visible
                    continue
                from_member_marker: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(annotation.owner, "__from_member", work)
                return (false, false) if not from_member_marker.complete
                if from_member_marker.equal:
                    imported_name <- annotation.name
                using_alias_marker: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(annotation.name, "__using_alias", work)
                return (false, false) if not using_alias_marker.complete
                if using_alias_marker.equal:
                    imported_name <- annotation.owner
                using_member_marker: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(annotation.name, "__using_member", work)
                return (false, false) if not using_member_marker.complete
                same_name: (complete: bool, equal: bool) = proof_replay_control_pattern_source_text_equal(imported_name, wanted, work) if imported_name != "" else (true, false)
                return (false, false) if not same_name.complete
                if same_name.equal:
                    import_scope: (complete: bool, visible: bool) = proof_replay_control_pattern_import_scope_visible(owner_path, annotation.module, work)
                    return (false, false) if not import_scope.complete
                    return (true, true) if import_scope.visible
            return (true, false)

        # Replay owns the formal lookup and builtin-shadow validation. Seed source work so each
        # scan fits this CONTROL lane's remaining allowance, then transfer the measured delta.
        def proof_replay_control_pattern_formal_type(report: ProofReport&, function_name: sview, scrutinee: Ast::Expr, work: mutable usize&, replay_cache: mutable ProofReplayDeterministicCallReplayCache&) -> Ast::Expr:
            return Ast::Expr.Absent if:
                PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT < PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            remaining: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
            seed: usize = PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - remaining
            bounded_work: mutable usize = seed
            parameter: mutable sview = ""
            match proof_strip_parens(scrutinee):
                Ast::Expr.Ident(name, _):
                    parameter <- name
                _:
                    return Ast::Expr.Absent
            return Ast::Expr.Absent if parameter == "" or function_name == ""
            found: mutable Ast::Expr = Ast::Expr.Absent
            function_line: mutable u32 = 0
            function_offset: mutable usize = 0
            function_module: mutable sview = ""
            declaration_module: mutable sview = ""
            module_path: mutable darray[sview] = []
            function_module_path: mutable darray[sview] = []
            function_matches: mutable usize = 0
            parameter_matches: mutable usize = 0
            complete: mutable bool = true
            proof_replay_control_pattern_source_formal_type_find(report.source.source_declarations, function_name, parameter, &found, &function_line, &function_offset, &function_module, &declaration_module, &module_path, &function_module_path, &function_matches, &parameter_matches, &bounded_work, &complete, 0)
            return Ast::Expr.Absent if not complete or function_matches != 1 or parameter_matches != 1
            type_name: mutable sview = ""
            match proof_strip_parens(found):
                Ast::Expr.Ident(name, _):
                    type_name <- name if name in {"sview", "cstr", "char"}
                _:
                    pass
            # Select candidates using replay-owned syntax. Producer classifiers are not an
            # authority for which parser-origin types need namespace and import validation.
            if type_name != "":
                replay_generic_work: mutable usize = 0
                generic_shadowed: bool = proof_replay_type_bound_enum_generic_identity_shadowed_with_work(report, function_line, function_offset, declaration_module, type_name, &replay_generic_work, replay_cache)
                return Ast::Expr.Absent if generic_shadowed or replay_generic_work > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                return Ast::Expr.Absent if replay_generic_work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT - bounded_work
                bounded_work <- bounded_work + replay_generic_work
                current_path: mutable darray[sview] = []
                declaration_shadow: (complete: bool, shadowed: bool) = proof_replay_control_pattern_builtin_name_shadowed(report.source.source_declarations, type_name, function_module_path, &current_path, &bounded_work, 0)
                return Ast::Expr.Absent if not declaration_shadow.complete or declaration_shadow.shadowed
                import_shadow: (complete: bool, shadowed: bool) = proof_replay_control_pattern_builtin_import_shadowed(report.source.source_annotations, type_name, function_module_path, &bounded_work)
                return Ast::Expr.Absent if not import_shadow.complete or import_shadow.shadowed
            pattern_type: Ast::Expr = found
            if bounded_work > PROOF_PATTERN_SOURCE_TYPE_WORK_LIMIT or bounded_work < seed:
                work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return Ast::Expr.Absent
            query_work: usize = bounded_work - seed
            if query_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return Ast::Expr.Absent
            work <- work + query_work
            pattern_type

        def proof_replay_control_pattern_scrutinee_stable(report: ProofReport&, trace: ProofFactTrace, scrutinee: Ast::Expr, type_expression: Ast::Expr, owner_source_work: usize, work: mutable usize&) -> bool:
            if proof_replay_control_pattern_type_is_direct_string(type_expression):
                match proof_strip_parens(scrutinee):
                    Ast::Expr.Ident(name, _):
                        return false if work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT or owner_source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - work
                        work <- work + owner_source_work
                        body: mutable darray[Ast::Stmt] = []
                        owner_matches: mutable usize = 0
                        return false if not proof_replay_control_find_owner_body(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, &body, &owner_matches, work, 0) or owner_matches != 1
                        # Calls, assignments, moves, unknown syntax, and local rebinding all
                        # make the borrowed string's value unstable for a later arm assertion.
                        return not proof_replay_control_pattern_body_touches_with_work(report, body, name, true, work)
                    _:
                        return false
            return proof_replay_control_stable_expression_budgeted(report, trace, scrutinee, work, 0)

        def proof_replay_control_pattern_exact(pattern: Ast::Pattern, type_expression: Ast::Expr, work: mutable usize&) -> bool:
            if not (type_expression is Ast::Expr.Absent):
                return proof_replay_control_pattern_exact_typed_with_work(pattern, type_expression, 0, work)
            return false if proof_replay_control_pattern_needs_source_type(pattern)
            # Keep the no-type variant path inside replay too. The producer's helper has a
            # separate walk budget and must not decide whether a serialized source fact is
            # exact.
            proof_replay_control_pattern_exact_typed_with_work(pattern, Ast::Expr.Absent, 0, work)

        # Replay reconstructs exactness itself. In particular, it must not ask the producer's
        # typed pattern lowerer whether a literal decides a branch: the admitted literal subset
        # and its AST encoding are repeated here under the shared control-work budget.
        def proof_replay_control_pattern_exact_typed_with_work(pattern: Ast::Pattern, type_expression: Ast::Expr, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or not proof_replay_control_pattern_text_work_charge("", work)
            match pattern:
                Ast::Pattern.As(name, inner):
                    return name != "" and proof_replay_control_pattern_text_work_charge(name, work) and inner.count == 1 and proof_replay_control_pattern_exact_typed_with_work(inner[0], type_expression, depth + 1, work)
                Ast::Pattern.Literal(text):
                    return false if not proof_replay_control_pattern_text_work_charge(text, work)
                    if proof_replay_control_pattern_type_is_direct_string(type_expression):
                        return proof_replay_control_pattern_unambiguous_string_with_work(text, work)
                    return proof_replay_control_pattern_type_is_direct_char(type_expression) and proof_replay_control_pattern_unambiguous_char(text)
                Ast::Pattern.Range(_, _, _):
                    return false
                Ast::Pattern.Variant(_, fields):
                    for field in fields |depth, work|:
                        return false if not proof_replay_control_pattern_irrefutable_work_charge(field, depth + 1, work)
                    return true
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |type_expression, depth, work|:
                        return false if not proof_replay_control_pattern_exact_typed_with_work(option, type_expression, depth + 1, work)
                    return true
                _:
                    return false

        def proof_replay_control_pattern_condition_typed_with_work(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, type_expression: Ast::Expr, depth: usize, work: mutable usize&) -> Ast::Expr?:
            return null if depth >= PROOF_REPLAY_CONTROL_DEPTH_LIMIT or not proof_replay_control_pattern_text_work_charge("", work)
            match pattern:
                Ast::Pattern.As(name, inner):
                    return null if name == "" or not proof_replay_control_pattern_text_work_charge(name, work) or inner.count != 1
                    return proof_replay_control_pattern_condition_typed_with_work(inner[0], scrutinee, position, type_expression, depth + 1, work)
                Ast::Pattern.Literal(text):
                    return null if not proof_replay_control_pattern_text_work_charge(text, work)
                    if proof_replay_control_pattern_type_is_direct_string(type_expression) and proof_replay_control_pattern_unambiguous_string_with_work(text, work):
                        return Ast::Expr.Binary(scrutinee, TokenKind.EqEq, Ast::Expr.StringLit(text, position), position)
                    if proof_replay_control_pattern_type_is_direct_char(type_expression) and proof_replay_control_pattern_unambiguous_char(text):
                        return Ast::Expr.Binary(scrutinee, TokenKind.EqEq, Ast::Expr.CharLit(string_view_slice(text, 1, sview_len(text) - 1), position), position)
                    return null
                Ast::Pattern.Range(_, _, _):
                    return null
                Ast::Pattern.Variant(path, fields):
                    for field in fields |depth, work|:
                        return null if not proof_replay_control_pattern_irrefutable_work_charge(field, depth + 1, work)
                    target: Ast::Expr? = proof_replay_control_pattern_path_expression_with_work(path, position, work)
                    if target is known_target:
                        return Ast::Expr.Binary(scrutinee, TokenKind.Is, known_target, position)
                    return null
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    conditions: mutable darray[Ast::Expr] = []
                    for option in options |conditions, scrutinee, position, type_expression, depth, work|:
                        condition: Ast::Expr? = proof_replay_control_pattern_condition_typed_with_work(option, scrutinee, position, type_expression, depth + 1, work)
                        if condition is known_condition:
                            return null if not proof_replay_control_pattern_source_charge(2, work)
                            conditions.push(known_condition)
                        else:
                            return null
                    result: mutable Ast::Expr = conditions[0]
                    for index in 1..<conditions.count |index, conditions, result, position|:
                        result <- Ast::Expr.Binary(result, TokenKind.Or, conditions[index], position)
                    return result
                _:
                    return null

        # Rebuild enum-pattern paths inside replay. The source path is retained as text in the
        # parser AST, so each scanned byte is charged before constructing the kernel-side term.
        def proof_replay_control_pattern_path_expression_with_work(path: sview, position: Ast::Pos, work: mutable usize&) -> Ast::Expr?:
            return null if sview_len(path) == 0 or not proof_replay_control_pattern_text_work_charge(path, work) or not proof_replay_control_pattern_text_work_charge(path, work)
            length: usize = sview_len(path)
            first_delimiter: mutable usize = length
            first_is_scope: mutable bool = false
            for index in 0..<length |index, path, first_delimiter, first_is_scope|:
                if path[index] == 46:
                    first_delimiter <- index
                    break
                if path[index] == 58:
                    return null if index + 1 >= length or path[index + 1] != 58
                    first_delimiter <- index
                    first_is_scope <- true
                    break
            if first_delimiter == length:
                return Ast::Expr.ShorthandMember([path], position)
            return null if first_delimiter == 0
            result: mutable Ast::Expr = Ast::Expr.Ident(string_view_slice(path, 0, first_delimiter.i64()), position)
            segment_start: mutable usize = first_delimiter + (2 if first_is_scope else 1)
            delimiter_is_scope: mutable bool = first_is_scope
            while segment_start < length |segment_start, length, path, result, position, delimiter_is_scope|:
                segment_end: mutable usize = segment_start
                while segment_end < length and path[segment_end] != 46 and path[segment_end] != 58 |segment_end, length, path|:
                    segment_end <- segment_end + 1
                return null if segment_end == segment_start
                segment: sview = string_view_slice(path, segment_start.i64(), segment_end.i64())
                result <- Ast::Expr.Scope(result, segment, position) if delimiter_is_scope
                result <- Ast::Expr.Field(result, segment, position) if not delimiter_is_scope
                break if segment_end == length
                delimiter_is_scope <- path[segment_end] == 58
                return null if delimiter_is_scope and (segment_end + 1 >= length or path[segment_end + 1] != 58)
                segment_start <- segment_end + (2 if delimiter_is_scope else 1)
            return null if segment_start == length and first_delimiter + 1 < length and (path[length - 1] == 46 or path[length - 1] == 58)
            result

        def proof_replay_control_pattern_condition(report: ProofReport&, pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, type_expression: Ast::Expr, work: mutable usize&) -> Ast::Expr?:
            return null if:
                not proof_replay_control_pattern_repeat_charge(pattern, 3, work)
                not report.source.source_operator_masks_valid
            condition: mutable Ast::Expr? = null
            if not (type_expression is Ast::Expr.Absent):
                condition <- proof_replay_control_pattern_condition_typed_with_work(pattern, scrutinee, position, type_expression, 0, work)
            else:
                return null if proof_replay_control_pattern_needs_source_type(pattern)
                condition <- proof_replay_control_pattern_condition_typed_with_work(pattern, scrutinee, position, Ast::Expr.Absent, 0, work)
            if condition is expression:
                # Pattern equality must resolve to the primitive relation that the checker
                # lowered; custom literal comparisons cannot enter through a user operator.
                return null if:
                    not proof_replay_summary_expr_repeat_charge_with_limit(expression, 1, work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                    proof_source_expression_has_overloaded_operator(expression, report.source.source_primitive_operator_mask, 0)
                return expression
            return null

