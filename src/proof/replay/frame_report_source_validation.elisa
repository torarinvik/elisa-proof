extend ElisaProof:
    private:
        def proof_replay_frame_report_work_charge(amount: usize, report_work: mutable usize&) -> bool:
            return ElisaProofFrameSource::replay_work_charge(amount, report_work)

        def proof_frame_mirror_matches(expression: Ast::Expr, position: Ast::Pos) -> bool:
            match expression:
                Ast::Expr.BoolLit(value, actual):
                    return value and actual.line == position.line and actual.column == position.column and actual.end_line == position.end_line and actual.end_column == position.end_column and actual.offset == position.offset and actual.end_offset == position.end_offset
                _:
                    return false

        # Original source determines cardinality, occurrence and predicate. This
        # validates failed events too; it never marks a certificate replayed.
        def proof_direct_frame_report_matches_source(report: mutable ProofReport&, declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, report_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if proof_replay_summary_has_unresolved_import(report.source_annotations, report_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            return false if not proof_replay_frame_report_work_charge(report.obligation_inventory.count, report_work)
            event_entries: mutable darray[usize] = []
            event_attempt_starts: mutable darray[usize] = []
            roots: mutable darray[usize] = []
            ordinal: mutable usize = 0
            next_attempt: mutable usize = 0
            for entry_index in 0..<report.obligation_inventory.count |entry_index, report, name, line, event_entries, event_attempt_starts, roots, ordinal, next_attempt, report_work|:
                entry = report.obligation_inventory[entry_index]
                return false if not proof_replay_frame_report_work_charge(sview_len(entry.source_name), report_work)
                if entry.source_name == name and entry.source_line == line and (entry.source_kind == "changes" or entry.source_kind == "preserves" or entry.source_kind == "allow" or entry.source_kind == "preserve"):
                    return false if not proof_replay_frame_report_work_charge(sview_len(entry.source_kind), report_work)
                    return false if entry.source_obligation_index != ordinal or entry.attempts_count != 1 or entry.attempts_start >= report.goal_attempts.count
                    return false if entry.attempts_start < next_attempt
                    next_attempt <- entry.attempts_start + 1
                    attempt = report.goal_attempts[entry.attempts_start]
                    rule: sview = "frame-allow" if entry.source_kind == "allow" else "frame-preserve" if entry.source_kind == "preserve" else "frame-spec"
                    return false if not proof_replay_frame_report_work_charge(sview_len(attempt.name), report_work)
                    return false if not proof_replay_frame_report_work_charge(sview_len(attempt.rule), report_work)
                    return false if not proof_replay_frame_report_work_charge(sview_len(name), report_work)
                    return false if not proof_replay_frame_report_work_charge(sview_len(rule), report_work)
                    return false if attempt.name != name or attempt.rule != rule or attempt.budget_exhausted or attempt.facts_count != 0 or attempt.kernel_facts_count != 0
                    return false if attempt.facts_start > report.certificate_facts.count or attempt.kernel_facts_start > report.kernel.certificate_facts.count
                    event_entries.push(entry_index)
                    event_attempt_starts.push(entry.attempts_start)
                    roots.push(attempt.kernel_goal)
                    ordinal <- ordinal + 1
            outcomes = (ElisaProofFrameSource::direct_event_decisions_with_work(declarations, report.source_annotations, name, line, tokens, source, source_length, &report.kernel.nodes, &report.kernel.children, &roots, report_work) can Global{Read,Write})
            return false if not outcomes.known or ordinal != outcomes.decisions.count
            proven_count: mutable usize = 0
            next_certificate: mutable usize = 0
            return false if not proof_replay_frame_report_work_charge(outcomes.decisions.count, report_work)
            for index in 0..<outcomes.decisions.count |index, outcomes, report, event_entries, event_attempt_starts, proven_count, next_certificate, declarations, name, line, report_work|:
                event = outcomes.decisions[index].event
                entry = report.obligation_inventory[event_entries[index]]
                return false if not proof_replay_frame_report_work_charge(sview_len(entry.source_name), report_work)
                return false if not proof_replay_frame_report_work_charge(sview_len(entry.source_kind), report_work)
                return false if entry.source_name != name or entry.source_line != line or entry.source_obligation_index != index or entry.attempts_count != 1 or entry.attempts_start != event_attempt_starts[index] or entry.source_kind != event.kind
                attempt = report.goal_attempts[event_attempt_starts[index]]
                return false if not proof_replay_frame_report_work_charge(sview_len(event.kind), report_work)
                rule: sview = "frame-allow" if event.kind == "allow" else "frame-preserve" if event.kind == "preserve" else "frame-spec"
                return false if not proof_replay_frame_report_work_charge(sview_len(attempt.name), report_work)
                return false if not proof_replay_frame_report_work_charge(sview_len(attempt.rule), report_work)
                return false if not proof_replay_frame_report_work_charge(sview_len(name), report_work)
                return false if not proof_replay_frame_report_work_charge(sview_len(rule), report_work)
                return false if attempt.name != name or attempt.line != event.position.line or attempt.rule != rule or not proof_frame_mirror_matches(attempt.goal, event.position)
                proven: bool = outcomes.decisions[index].proven
                return false if entry.proven != proven or attempt.proven != proven or attempt.has_certificate != proven
                if proven:
                    return false if attempt.certificate_index >= report.certificates.count
                    return false if attempt.certificate_index < next_certificate
                    next_certificate <- attempt.certificate_index + 1
                    certificate = report.certificates[attempt.certificate_index]
                    return false if not proof_replay_frame_report_work_charge(sview_len(certificate.name), report_work)
                    return false if not proof_replay_frame_report_work_charge(sview_len(certificate.rule), report_work)
                    return false if not proof_replay_attempt_matches_certificate_with_work(report, &report.goal_attempts[event_attempt_starts[index]], certificate, attempt.certificate_index, report_work)
                    return false if certificate.kernel_goal != attempt.kernel_goal or certificate.name != name or certificate.line != event.position.line or certificate.rule != rule or certificate.facts_count != 0 or certificate.kernel_facts_count != 0 or not proof_frame_mirror_matches(certificate.goal, event.position)
                    proven_count <- proven_count + 1
            # Reject extra unattached family records rather than checking only the
            # subset selected by producer-owned obligation annotations.
            attempts: mutable usize = 0
            certificates: mutable usize = 0
            return false if not proof_replay_frame_report_work_charge(report.goal_attempts.count, report_work)
            for attempt in report.goal_attempts |attempts, name, report_work|:
                return false if not proof_replay_frame_report_work_charge(sview_len(attempt.name), report_work)
                return false if not proof_replay_frame_report_work_charge(sview_len(attempt.rule), report_work)
                attempts <- attempts + 1 if attempt.name == name and (attempt.rule == "frame-spec" or attempt.rule == "frame-allow" or attempt.rule == "frame-preserve")
            return false if not proof_replay_frame_report_work_charge(report.certificates.count, report_work)
            for certificate in report.certificates |certificates, name, report_work|:
                return false if not proof_replay_frame_report_work_charge(sview_len(certificate.name), report_work)
                return false if not proof_replay_frame_report_work_charge(sview_len(certificate.rule), report_work)
                certificates <- certificates + 1 if certificate.name == name and (certificate.rule == "frame-spec" or certificate.rule == "frame-allow" or certificate.rule == "frame-preserve")
            return attempts == outcomes.decisions.count and certificates == proven_count
