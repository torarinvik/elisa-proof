extend ElisaProof:
    private:
        def proof_replay_boundary_trace_kind(kind: sview) -> bool:
            match kind:
                "global-constant":
                    return true
                "global-constant-qualified":
                    return true
                "global-mutable-array-type":
                    return true
                "global-mutable-array-index-bound":
                    return true
                "precondition":
                    return true
                "type-bound":
                    return true
                "deterministic-call":
                    return true
                "variant-exclusion":
                    return true
                "const-enum-exclusion":
                    return true
                "const-enum-member-value":
                    return true
                "match-exhaustiveness":
                    return true
                "runtime-assert":
                    return true
                "runtime-guard":
                    return true
                "branch-condition":
                    return true
                "loop-condition":
                    return true
                "loop-invariant":
                    return true
                "loop-range":
                    return true
                "local-binding":
                    return true
                "collection-push":
                    return true
                "collection-pop":
                    return true
                "entry-count":
                    return true
                "linear-certificate":
                    return true
                "indexed-write":
                    return true
                _:
                    return false

        # A method-shaped cast/receiver equality is a source-semantic claim that the call
        # resolved to a builtin conversion. Elisa gives an exact `__cast__` hook precedence, so
        # the report cannot replay this fact from selector spelling alone.
        def proof_replay_is_numeric_cast_identity(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Binary(Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), target, _), arguments, _, _), TokenKind.EqEq, Ast::Expr.Ident(other, _), _):
                    return arguments.count == 0 and receiver != "" and receiver == other and proof_replay_numeric_cast_target(target)
                Ast::Expr.Binary(Ast::Expr.Ident(other, _), TokenKind.EqEq, Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), target, _), arguments, _, _), _):
                    return arguments.count == 0 and receiver != "" and receiver == other and proof_replay_numeric_cast_target(target)
                _:
                    return false

        def proof_replay_numeric_cast_target(target: sview) -> bool:
            return target == "i8" or target == "i16" or target == "i32" or target == "i64" or target == "isize" or target == "u8" or target == "u16" or target == "u32" or target == "u64" or target == "usize"

        # Trusted source-boundary facts have no derivation or summary payload. Without this
        # structural check, changing a summary trace's kind to `precondition` or `runtime-assert`
        # bypasses the exact declaration, argument, and precondition checks below.
        def proof_replay_boundary_trace_shape_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if trace.dependency != ""
            return false if trace.premises_count != 0
            return false if trace.kernel_premises_count != 0
            return false if trace.summary_bindings_count != 0
            return false if trace.summary_requires_count != 0
            return false if trace.summary_ensure_index != 0
            return false if trace.summary_bindings_start > report.traces.summary_names.count
            return false if trace.summary_requires_start > report.traces.summary_require_goal_ids.count
            # Reject the exact fact shape that would transfer a builtin identity equation to a
            # user hook. Range assumptions are independently kept out by the source-aware
            # producer, which has the function table and fails closed when hook resolution is
            # unavailable.
            if trace.kind == "type-bound" and proof_replay_is_numeric_cast_identity(trace.expression):
                return false if proof_replay_local_binding_cast_hook_present(report.source_declarations, 0)
            # A global-array boundary fact keeps its source owner line when its kind is
            # rewritten to the broad `type-bound` label. Re-run the declaration-backed check
            # instead of letting a kind mutation fall through to the generic type-bound case.
            if trace.kind == "type-bound" and trace.owner_line != 0:
                return proof_replay_global_mutable_array_type_fact_is_valid(report, trace)
            if trace.kind == "global-constant" or trace.kind == "global-constant-qualified":
                return proof_replay_global_constant_fact_is_valid(report, trace)
            if trace.kind == "global-mutable-array-type":
                return proof_replay_global_mutable_array_type_fact_is_valid(report, trace)
            if trace.kind == "global-mutable-array-index-bound":
                return proof_replay_global_mutable_array_type_fact_is_valid(report, trace)
            if trace.kind == "variant-exclusion":
                return proof_replay_variant_exclusion_valid(report, trace)
            if trace.kind == "const-enum-exclusion":
                return proof_replay_const_enum_exclusion_valid(report, trace)
            if trace.kind == "const-enum-member-value":
                return proof_replay_const_enum_member_value_valid(report, trace)
            if trace.kind == "match-exhaustiveness":
                return proof_replay_match_exhaustiveness_valid(report, trace)
            if trace.kind == "deterministic-call":
                return proof_replay_deterministic_call_valid(report, trace)
            if trace.kind == "local-binding":
                return proof_replay_local_binding_source_valid(report, trace)
            # A local-binding trace currently carries no source-path/version proof. The producer
            # emits these for ordinary assignments, synthesized return symbols, literal call
            # arguments and collection aliases, but this report format does not establish that
            # the binding dominates every certificate that consumes it or survives intervening
            # writes/branches. Treating the serialized expression as an axiom could therefore
            # make a false postcondition replay. Keep this fact class unsupported until replay
            # reconstructs its binding and reaching scope from source.
            if trace.kind == "local-binding":
                return false
            return true

        # Deterministic-call scalar witnesses are source claims, not trusted type facts. Replay
        # rebuilds the callee's call graph from declarations and accepts only an acyclic chain of
        # effect-free, by-value functions. Any mutable global in this source currently makes the
        # check conservative: that keeps a global read from being mistaken for a pure value.
        def proof_replay_deterministic_parameter_type(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Unary(operator, inner, _):
                    return true if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    return proof_replay_deterministic_parameter_type(inner, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_deterministic_parameter_type(left, depth + 1) or proof_replay_deterministic_parameter_type(right, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_deterministic_parameter_type(inner, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_replay_deterministic_parameter_type(base, depth + 1)
                _:
                    return false

        def proof_replay_deterministic_body_shape(body: darray[Ast::Stmt]&, depth: usize) -> bool:
            return false if depth >= 96
            for statement in body |depth|:
                match statement:
                    Ast::Stmt.Return(_, _):
                        pass
                    Ast::Stmt.Expr(_, _):
                        pass
                    Ast::Stmt.VarDecl(_, _, _, _):
                        pass
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return false if not proof_replay_deterministic_body_shape(then_body, depth + 1) or not proof_replay_deterministic_body_shape(else_body, depth + 1)
                    Ast::Stmt.Contract(kind, _, _):
                        return false if kind != "requires" and kind != "ensure" and kind != "decreases" and kind != "decreases*"
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |depth|:
                            return false if not proof_replay_deterministic_body_shape(arm.body, depth + 1)
                    _:
                        return false
            return true

        def proof_replay_deterministic_body_mentions(body: darray[Ast::Stmt]&, name: sview, depth: usize) -> bool:
            return true if depth >= 96
            for statement in body |name, depth|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return true if proof_expr_mentions_name(returned, name)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_expr_mentions_name(expression, name)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_expr_mentions_name(initializer, name)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_expr_mentions_name(condition, name) or proof_replay_deterministic_body_mentions(then_body, name, depth + 1) or proof_replay_deterministic_body_mentions(else_body, name, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_expr_mentions_name(scrutinee, name)
                        for arm in arms |name, depth|:
                            return true if proof_expr_mentions_name(arm.guard, name) or proof_replay_deterministic_body_mentions(arm.body, name, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_expr_mentions_name(expression, name)
                    _:
                        pass
            return false

        def proof_replay_deterministic_scalar_type(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Ident(name, _):
                    return true if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize" or name == "int"
                    return true if name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uint"
                    return true if name == "bool" or name == "char"
                    source = proof_replay_effect_named_declaration(declarations, name, 0)
                    return false if source.matches != 1
                    match source.declaration:
                        Ast::Decl.Alias(_, target, _):
                            return proof_replay_deterministic_scalar_type(target, declarations, depth + 1)
                        Ast::Decl.Enum(_, _, is_const, _, _):
                            return is_const
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_replay_deterministic_scalar_type(inner, declarations, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_replay_deterministic_scalar_type(base, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_deterministic_scalar_type(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    return false
            return false

        # Resolve a qualified deterministic call directly to the declaration under that exact
        # source module path. Same-leaf functions in other modules are irrelevant to this lookup.
        def proof_replay_deterministic_qualified_path_matches_owner(owner: sview, qualifier: Ast::Expr, caller_owner: sview) -> bool:
            return true if proof_replay_exact_module_path_matches_owner(owner, qualifier)
            match qualifier:
                Ast::Expr.Ident(module_name, _):
                    return proof_replay_relative_module_path_matches_owner(owner, module_name, caller_owner)
                _:
                    return false

        def proof_replay_deterministic_qualified_declaration(declarations: darray[Ast::Decl]&, wanted: sview, qualifier: Ast::Expr, caller_owner: sview, current: sview, selected: mutable Ast::Decl&, matches: mutable usize&, depth: usize) -> void:
            return if depth >= 96 or wanted == ""
            for declaration in declarations |wanted, qualifier, caller_owner, current, selected, matches, depth|:
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, _):
                        if name == wanted and proof_replay_deterministic_qualified_path_matches_owner(current, qualifier, caller_owner):
                            matches <- matches + 1
                            selected <- declaration
                    Ast::Decl.Module(module_name, body, _):
                        proof_replay_deterministic_qualified_declaration(body, wanted, qualifier, caller_owner, module_name, selected, matches, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_deterministic_qualified_declaration(body, wanted, qualifier, caller_owner, current, selected, matches, depth + 1)
                    _:
                        pass

        def proof_replay_deterministic_function_declaration(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration: Ast::Decl, active: darray[sview]&, depth: usize) -> bool:
            return false if depth >= 32 or name == "" or any current in active where current == name
            match declaration:
                Ast::Decl.Func(_, parameters, return_type, body, effects, _, _):
                    return false if effects.count != 0 or not proof_replay_deterministic_body_shape(body, 0)
                    if return_type is scalar_return:
                        return false if not proof_replay_deterministic_scalar_type(scalar_return, declarations, 0)
                    else:
                        return false
                    for parameter in parameters:
                        return false if parameter.is_mutable or proof_replay_deterministic_parameter_type(parameter.type_expression, 0) or not proof_replay_deterministic_scalar_type(parameter.type_expression, declarations, 0)
                    for annotation in annotations |body, parameters|:
                        if annotation.name == "__global_mutable":
                            return false if proof_replay_deterministic_body_mentions(body, annotation.owner, 0)
                            for parameter in parameters:
                                return false if parameter.has_default and proof_expr_mentions_name(parameter.default_value, annotation.owner)
                    calls: mutable darray[sview] = []
                    return false if not proof_replay_source_calls(parameters, body, &calls)
                    next_active: mutable darray[sview] = []
                    next_active.extend(active)
                    next_active.push(name)
                    for called in calls |declarations, annotations, next_active, depth|:
                        return false if not proof_replay_deterministic_function(declarations, annotations, called, next_active, depth + 1)
                    return true
                _:
                    return false

        def proof_replay_deterministic_function(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, active: darray[sview]&, depth: usize) -> bool:
            return false if depth >= 32 or name == "" or any current in active where current == name
            source = proof_replay_effect_named_declaration(declarations, name, 0)
            return false if source.matches != 1
            return proof_replay_deterministic_function_declaration(declarations, annotations, name, source.declaration, active, depth)

        def proof_replay_deterministic_call_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            marker = trace.expression
            match marker:
                Ast::Expr.Call(Ast::Expr.Ident(marker_name, _), arguments, _, _):
                    return false if marker_name != "__elisa_primitive_scalar_type" or arguments.count != 1
                    match arguments[0]:
                        Ast::Expr.Call(callee_expression, call_arguments, _, _):
                            callee: mutable sview = ""
                            qualified_declaration: mutable Ast::Decl = Ast::Decl.Invalid
                            qualified_call: mutable bool = false
                            match callee_expression:
                                Ast::Expr.Ident(name, _):
                                    callee <- name
                                Ast::Expr.Scope(base, name, _):
                                    qualified_matches: mutable usize = 0
                                    caller_line: mutable u32 = 0
                                    proof_replay_owner_function_line(report.source_declarations, trace.name, trace.line, &caller_line, 0)
                                    caller_owner: mutable sview = ""
                                    caller_count: mutable usize = 0
                                    proof_replay_module_at_function_line(report.source_declarations, caller_line, "", &caller_owner, &caller_count, 0)
                                    return false if caller_line == 0 or caller_count != 1
                                    proof_replay_deterministic_qualified_declaration(report.source_declarations, name, base, caller_owner, "", qualified_declaration, qualified_matches, 0)
                                    return false if qualified_matches != 1
                                    callee <- name
                                    qualified_call <- true
                                _:
                                    return false
                            for argument in call_arguments:
                                # Reference and mutable-reference actuals remain disallowed
                                # through wrappers such as parentheses/refinements too. The
                                # producer sees the resolved source type; replay must not accept
                                # a forged scalar-call marker by inspecting only the outer node.
                                return false if proof_replay_deterministic_parameter_type(argument, 0)
                            return false if not proof_replay_deterministic_call_source_site(report, trace, arguments[0])
                            active: mutable darray[sview] = []
                            return proof_replay_deterministic_function_declaration(report.source_declarations, report.source_annotations, callee, qualified_declaration, active, 0) if qualified_call
                            return proof_replay_deterministic_function(report.source_declarations, report.source_annotations, callee, active, 0)
                        _:
                            return false
                _:
                    return false
