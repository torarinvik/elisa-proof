include "./pop_value_source.elisa"
include "./entry_count_source.elisa"
include "./entry_count_boundary_validation.elisa"
extend ElisaProof:
    private:
        def proof_replay_boundary_trace_kind(kind: sview) -> bool:
            match kind:
                "global-constant":
                    return true
                "global-constant-qualified":
                    return true
                "global-mutable-array-type":
                    return true
                "global-mutable-array-index-bound":
                    return true
                "precondition":
                    return true
                "type-bound":
                    return true
                "deterministic-call":
                    return true
                "variant-exclusion":
                    return true
                "const-enum-exclusion":
                    return true
                "const-enum-member-value":
                    return true
                "match-exhaustiveness":
                    return true
                "runtime-assert":
                    return true
                "runtime-guard":
                    return true
                "branch-condition":
                    return true
                "loop-condition":
                    return true
                "loop-invariant":
                    return true
                "loop-range":
                    return true
                "local-binding":
                    return true
                "collection-push":
                    return true
                "collection-pop":
                    return true
                "collection-pop-value":
                    return true
                "entry-count":
                    return true
                "linear-certificate":
                    return true
                "indexed-write":
                    return true
                _:
                    return false

        # A method-shaped cast/receiver equality is a source-semantic claim that the call
        # resolved to a builtin conversion. Elisa gives an exact `__cast__` hook precedence, so
        # the report cannot replay this fact from selector spelling alone.
        def proof_replay_is_numeric_cast_identity(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Binary(Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), target, _), arguments, _, _), TokenKind.EqEq, Ast::Expr.Ident(other, _), _):
                    return arguments.count == 0 and receiver != "" and receiver == other and proof_replay_numeric_cast_target(target)
                Ast::Expr.Binary(Ast::Expr.Ident(other, _), TokenKind.EqEq, Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), target, _), arguments, _, _), _):
                    return arguments.count == 0 and receiver != "" and receiver == other and proof_replay_numeric_cast_target(target)
                _:
                    return false

        def proof_replay_boundary_trace_payload_shape_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if trace.dependency != ""
            return false if trace.premises_count != 0
            return false if trace.kernel_premises_count != 0
            return false if trace.summary_bindings_count != 0
            return false if trace.summary_requires_count != 0
            return false if trace.summary_ensure_index != 0
            return false if trace.summary_bindings_start > report.traces.summary_names.count
            return false if trace.summary_requires_start > report.traces.summary_require_goal_ids.count
            return true

        def proof_replay_numeric_cast_target(target: sview) -> bool:
            return target == "i8" or target == "i16" or target == "i32" or target == "i64" or target == "isize" or target == "u8" or target == "u16" or target == "u32" or target == "u64" or target == "usize"

        # Trusted source-boundary facts have no derivation or summary payload. Without this
        # structural check, changing a summary trace's kind to `precondition` or `runtime-assert`
        # bypasses the exact declaration, argument, and precondition checks below.
        def proof_replay_boundary_trace_shape_valid(report: mutable ProofReport&, trace: ProofFactTrace) -> bool can[Global.Read, Global.Write]:
            source_work: mutable usize = 0
            return (proof_replay_boundary_trace_shape_valid_with_work(report, trace, &source_work) can Global{Read,Write})

        def proof_replay_boundary_trace_shape_valid_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_replay_boundary_trace_payload_shape_valid(report, trace)
            if trace.kind == "precondition":
                return proof_replay_precondition_source_valid_with_work(report, trace, source_work)
            if trace.kind == "branch-condition":
                owner_line: mutable u32 = report.replay_owner_line
                owner_line <- 0 if owner_line == 4294967295
                owner_scan_start: usize = source_work
                return false if not proof_replay_summary_owner_source_preflight_with_limit(report, trace.name, owner_line, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                owner_preflight_work: usize = source_work - owner_scan_start
                return false if not proof_replay_summary_expr_charge_with_limit(trace.expression, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT or report.certificates.count > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.certificates.count
                return false if report.goal_attempts.count > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.goal_attempts.count
                return proof_replay_control_branch_fact_source_with_work(report, trace, owner_preflight_work, source_work)
            if trace.kind == "loop-condition" or trace.kind == "loop-invariant" or trace.kind == "loop-range":
                owner_line: mutable u32 = report.replay_owner_line
                owner_line <- 0 if owner_line == 4294967295
                return false if not proof_replay_summary_owner_source_preflight_with_limit(report, trace.name, owner_line, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return false if not proof_replay_summary_expr_charge_with_limit(trace.expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or report.certificates.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.certificates.count
                return false if report.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.goal_attempts.count
                # The control-flow validator has its own tighter work cap. Keep it local so
                # certificates and boundary facts processed earlier in this batch cannot make
                # this check fail just because the shared report-wide counter is already large.
                control_work: mutable usize = 0
                return false if not (proof_replay_control_loop_fact_source_with_work(report, trace, &control_work) can Global{Read,Write})
                return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or control_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + control_work
                return true
            if trace.kind == "runtime-assert" or trace.kind == "runtime-guard":
                return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                return false if report.certificates.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.certificates.count
                return false if report.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.goal_attempts.count
                return false if report.source_annotations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.source_annotations.count
                if report.trace_consumer_certificate_index != 0 and report.trace_consumer_certificate_index <= report.certificates.count:
                    return false if not proof_replay_summary_expr_charge_with_work(report.certificates[report.trace_consumer_certificate_index - 1].goal, source_work)
                for attempt in report.goal_attempts |source_work|:
                    return false if not proof_replay_summary_expr_charge_with_work(attempt.goal, source_work)
                return proof_replay_runtime_fact_source_valid_with_work(report, trace, source_work)
            # A cast/receiver equality is only sound after replay proves the exact widening
            # source site. This trace carries no such type evidence, so selector spelling and
            # absence of a hook cannot make it a trusted boundary fact.
            if trace.kind == "type-bound" and proof_replay_is_numeric_cast_identity(trace.expression):
                return false
            # A global-array boundary fact keeps its source owner line when its kind is
            # rewritten to the broad `type-bound` label. Re-run the declaration-backed check
            # instead of letting a kind mutation fall through to the generic type-bound case.
            if trace.kind == "type-bound" and trace.owner_line != 0:
                return proof_replay_global_mutable_array_type_fact_is_valid_with_work(report, trace, source_work)
            if trace.kind == "type-bound":
                return proof_replay_type_bound_source_valid_budgeted(report, trace, source_work)
            if trace.kind == "global-constant" or trace.kind == "global-constant-qualified":
                owner_line: mutable u32 = report.replay_owner_line
                owner_line <- 0 if owner_line == 4294967295
                return false if not proof_replay_summary_owner_source_preflight(report, trace.name, owner_line, source_work)
                return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                return proof_replay_global_constant_fact_is_valid(report, trace)
            if trace.kind == "global-mutable-array-type":
                return proof_replay_global_mutable_array_type_fact_is_valid_with_work(report, trace, source_work)
            if trace.kind == "global-mutable-array-index-bound":
                return proof_replay_global_mutable_array_type_fact_is_valid_with_work(report, trace, source_work)
            if trace.kind == "variant-exclusion":
                return false if not proof_replay_variant_source_work_charge(report, trace, source_work, 1, false)
                return proof_replay_variant_exclusion_valid(report, trace, source_work)
            if trace.kind == "const-enum-exclusion":
                return false if not proof_replay_variant_source_work_charge(report, trace, source_work, 4, false)
                return proof_replay_const_enum_exclusion_valid(report, trace, source_work)
            if trace.kind == "const-enum-member-value":
                return false if not proof_replay_variant_source_work_charge(report, trace, source_work, 2, false)
                return proof_replay_const_enum_member_value_valid(report, trace, source_work)
            if trace.kind == "match-exhaustiveness":
                return false if not proof_replay_variant_source_work_charge(report, trace, source_work, 2, true)
                return proof_replay_match_exhaustiveness_valid(report, trace, source_work)
            if trace.kind == "deterministic-call":
                return proof_replay_deterministic_call_valid_with_work(report, trace, source_work)
            if trace.kind == "entry-count":
                return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                return proof_replay_entry_count_boundary_fact_valid_with_work(report, trace, source_work)
            if trace.kind == "linear-certificate":
                return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                return false if report.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.goal_attempts.count
                for attempt in report.goal_attempts |source_work|:
                    return false if not proof_replay_summary_expr_charge_with_work(attempt.goal, source_work)
                return false if report.certificate_facts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.certificate_facts.count
                for fact in report.certificate_facts |source_work|:
                    return false if not proof_replay_summary_expr_charge_with_work(fact, source_work)
                return false if report.kernel.certificate_facts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.kernel.certificate_facts.count
                return false if report.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.traces.records.count
                for candidate in report.traces.records |source_work|:
                    return false if not proof_replay_summary_expr_charge_with_work(candidate.expression, source_work)
                return proof_replay_linear_certificate_trace_valid(report, trace)
            if trace.kind == "collection-pop-value":
                return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                return false if report.source_annotations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.source_annotations.count
                # `pop_value_source` has two independently reset declaration walks capped at
                # 4096 each. Reserve both against the report batch before invoking it.
                return false if 8192 > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + 8192
                return ElisaProofFrameSource::pop_value_source(&report.source_declarations, trace.name, report.replay_owner_line, trace.line, trace.expression)
            if trace.kind == "local-binding":
                if proof_replay_local_binding_source_valid_with_work(report, trace, source_work):
                    return true
                if proof_replay_literal_call_argument_binding_valid_with_work(report, trace, source_work):
                    return true
                owner_line: mutable u32 = report.replay_owner_line
                owner_line <- 0 if owner_line == 4294967295
                call_result_source_start: usize = source_work
                return false if not proof_replay_summary_owner_source_preflight(report, trace.name, owner_line, source_work)
                call_result_source_cost: usize = source_work - call_result_source_start
                return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                return false if report.traces.records.count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 12
                source_work <- source_work + report.traces.records.count * 12
                return false if report.source_annotations.count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 4
                source_work <- source_work + report.source_annotations.count * 4
                return false if call_result_source_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 12
                source_work <- source_work + call_result_source_cost * 12
                return proof_replay_call_result_binding_valid_with_work(report, trace, source_work)
            # A whitelisted kind is not evidence by itself. Every boundary fact admitted as an
            # axiom needs an explicit source reconstruction above; newly added kinds stay
            # untrusted until replay knows how to validate their source event.
            return false

        # Deterministic-call scalar witnesses are source claims, not trusted type facts. Replay
        # rebuilds the callee's call graph from declarations and accepts only an acyclic chain of
        # effect-free, by-value functions. Any mutable global in this source currently makes the
        # check conservative: that keeps a global read from being mistaken for a pure value.
        def proof_replay_deterministic_parameter_type(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Unary(operator, inner, _):
                    return true if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    return proof_replay_deterministic_parameter_type(inner, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_deterministic_parameter_type(left, depth + 1) or proof_replay_deterministic_parameter_type(right, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_deterministic_parameter_type(inner, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_replay_deterministic_parameter_type(base, depth + 1)
                _:
                    return false

        def proof_replay_deterministic_body_shape(body: darray[Ast::Stmt]&, depth: usize) -> bool:
            return false if depth >= 96
            for statement in body |depth|:
                match statement:
                    Ast::Stmt.Return(_, _):
                        pass
                    Ast::Stmt.Expr(_, _):
                        pass
                    Ast::Stmt.VarDecl(_, _, _, _):
                        pass
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return false if not proof_replay_deterministic_body_shape(then_body, depth + 1) or not proof_replay_deterministic_body_shape(else_body, depth + 1)
                    Ast::Stmt.Contract(kind, _, _):
                        return false if kind != "requires" and kind != "ensure" and kind != "decreases" and kind != "decreases*"
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |depth|:
                            return false if not proof_replay_deterministic_body_shape(arm.body, depth + 1)
                    _:
                        return false
            return true

        def proof_replay_deterministic_body_mentions(body: darray[Ast::Stmt]&, name: sview, depth: usize) -> bool:
            return true if depth >= 96
            for statement in body |name, depth|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return true if proof_expr_mentions_name(returned, name)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_expr_mentions_name(expression, name)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_expr_mentions_name(initializer, name)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_expr_mentions_name(condition, name) or proof_replay_deterministic_body_mentions(then_body, name, depth + 1) or proof_replay_deterministic_body_mentions(else_body, name, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_expr_mentions_name(scrutinee, name)
                        for arm in arms |name, depth|:
                            return true if proof_expr_mentions_name(arm.guard, name) or proof_replay_deterministic_body_mentions(arm.body, name, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_expr_mentions_name(expression, name)
                    _:
                        pass
            return false

        def proof_replay_deterministic_scalar_type(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Ident(name, _):
                    return true if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize" or name == "int"
                    return true if name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "uint"
                    return true if name == "bool" or name == "char"
                    source = proof_replay_effect_named_declaration(declarations, name, 0)
                    return false if source.matches != 1
                    match source.declaration:
                        Ast::Decl.Alias(_, target, _):
                            return proof_replay_deterministic_scalar_type(target, declarations, depth + 1)
                        Ast::Decl.Enum(_, _, is_const, _, _):
                            return is_const
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_replay_deterministic_scalar_type(inner, declarations, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_replay_deterministic_scalar_type(base, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_deterministic_scalar_type(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    return false
            return false

        def proof_replay_deterministic_module_alias_imports_supported(annotations: darray[Ast::EnumAnnotation]&, alias_count: mutable usize&, work: mutable usize&) -> bool:
            cursor: mutable usize = 0
            while cursor < annotations.count |cursor, annotations, work|:
                annotation: Ast::EnumAnnotation = annotations[cursor]
                return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 1 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + 1
                return false if sview_len(annotation.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.owner)
                return false if sview_len(annotation.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.name)
                return false if sview_len(annotation.module) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.module)
                if annotation.name == "__using":
                    return false if cursor + 2 >= annotations.count
                    alias: Ast::EnumAnnotation = annotations[cursor + 1]
                    target: Ast::EnumAnnotation = annotations[cursor + 2]
                    return false if alias.name != "__using_alias" or target.name != "__using_alias_target"
                    return false if alias.owner == "" or target.owner != annotation.owner or alias.module != target.module or alias.line != annotation.line or target.line != annotation.line or alias.offset != target.offset or alias.offset <= annotation.offset
                    for paired in [alias, target] |paired, work|:
                        return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 1 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + 1
                        return false if sview_len(paired.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(paired.owner)
                        return false if sview_len(paired.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(paired.name)
                        return false if sview_len(paired.module) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(paired.module)
                    alias_count <- alias_count + 1
                    cursor <- cursor + 3
                    continue
                match annotation.name:
                    "__using_alias" | "__using_alias_target" | "__using_member" | "__binding_wildcard_import" | "__from_member" | "__from_src" | "__from_decl":
                        return false
                    _:
                        pass
                cursor <- cursor + 1
            return true

        # Import declarations are usable here only when the parser's source annotations carry
        # one exact, paired namespace-alias witness for each declaration. Other import forms
        # still lack the selected-callee evidence required by deterministic replay.
        def proof_replay_deterministic_alias_import_declarations_supported(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, import_count: mutable usize&, matched_count: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or declarations.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + declarations.count
            for declaration in declarations |annotations, import_count, matched_count, work, depth|:
                match declaration:
                    Ast::Decl.Import(module, position):
                        return false if import_count >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
                        import_count <- import_count + 1
                        return false if sview_len(module) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(module)
                        matches: mutable usize = 0
                        for index in 0..<annotations.count |index, annotations, module, position, matches, work|:
                            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 1 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                            work <- work + 1
                            candidate: Ast::EnumAnnotation = annotations[index]
                            return false if sview_len(candidate.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(candidate.owner)
                            return false if sview_len(candidate.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(candidate.name)
                            if candidate.name == "__using" and index + 2 < annotations.count:
                                target: Ast::EnumAnnotation = annotations[index + 2]
                                return false if sview_len(target.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                                work <- work + sview_len(target.owner)
                                if candidate.owner == module and candidate.line == position.line and target.owner == module:
                                    matches <- matches + 1
                                    return false if matches > 1
                        return false if matches != 1
                        matched_count <- matched_count + 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_deterministic_alias_import_declarations_supported(nested, annotations, import_count, matched_count, work, depth + 1)
                    _:
                        pass
            return true

        # Resolve a qualified deterministic call through the same source-derived module and
        # alias index as checker admission. A single candidate row keeps this exact-owner query
        # bounded while preserving every AST path segment.
        def proof_replay_deterministic_qualified_path_matches_owner(owner: sview, wanted: sview, callee: Ast::Expr, caller_owner: sview, aliases: ProofModuleAliasIndex&, work: mutable usize&) -> bool:
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 2 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + 2
            names: darray[sview] = [wanted]
            owners: darray[sview] = [owner]
            resolved: (complete: bool, row: usize) = proof_module_function_index_for_callee(names, owners, aliases, caller_owner, callee, work, PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT)
            return work <= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT and resolved.complete and resolved.row == 0

        def proof_replay_deterministic_qualified_declaration(declarations: darray[Ast::Decl]&, wanted: sview, callee: Ast::Expr, caller_owner: sview, aliases: ProofModuleAliasIndex&, current: sview, selected: mutable Ast::Decl&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or wanted == ""
            for declaration in declarations |wanted, callee, caller_owner, aliases, current, selected, matches, work, depth|:
                return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 1 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        if name == wanted and proof_replay_deterministic_qualified_path_matches_owner(current, wanted, callee, caller_owner, aliases, work):
                            matches <- matches + 1
                            selected <- declaration
                    Ast::Decl.Module(module_name, body, _):
                        return false if sview_len(module_name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(module_name)
                        return false if not proof_replay_deterministic_qualified_declaration(body, wanted, callee, caller_owner, aliases, module_name, selected, matches, work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_replay_deterministic_qualified_declaration(body, wanted, callee, caller_owner, aliases, current, selected, matches, work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_deterministic_declaration_scan_charge(declarations: darray[Ast::Decl]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
            return false if declarations.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + declarations.count
            for declaration in declarations |work, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if parameters.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + parameters.count
                        for parameter in parameters |work|:
                            return false if sview_len(parameter.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(parameter.name)
                    Ast::Decl.Const(name, _, _, _, _) | Ast::Decl.Extern(name, _, _, _, _, _, _, _) | Ast::Decl.Import(name, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Alias(name, _, _) | Ast::Decl.Law(name, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                    Ast::Decl.Enum(name, variants, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if variants.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + variants.count
                        for variant in variants |work|:
                            return false if sview_len(variant.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(variant.name)
                    Ast::Decl.Module(module_name, nested, _):
                        return false if sview_len(module_name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(module_name)
                        return false if not proof_replay_deterministic_declaration_scan_charge(nested, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_deterministic_declaration_scan_charge(nested, work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_deterministic_body_scan_charge(body: darray[Ast::Stmt]&, repetitions: usize, work: mutable usize&) -> bool:
            cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost_body(body, cost, work, 0)
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
            if repetitions != 0:
                return false if cost > (PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work) / repetitions
            work <- work + cost * repetitions
            return true

        def proof_replay_deterministic_function_declaration(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, declaration: Ast::Decl, active: darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 32 or name == "" or any current in active where current == name
            match declaration:
                Ast::Decl.Func(_, parameters, return_type, body, effects, _, _):
                    return false if parameters.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                    work <- work + parameters.count
                    return false if annotations.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                    work <- work + annotations.count
                    for annotation in annotations |work|:
                        return false if sview_len(annotation.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(annotation.name)
                        return false if sview_len(annotation.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(annotation.owner)
                        return false if sview_len(annotation.module) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(annotation.module)
                    return false if not proof_replay_deterministic_body_scan_charge(body, annotations.count + 3, work)
                    return false if effects.count != 0 or not proof_replay_deterministic_body_shape(body, 0)
                    if return_type is scalar_return:
                        return false if not proof_replay_summary_expr_charge_with_work(scalar_return, work)
                        return false if not proof_replay_deterministic_declaration_scan_charge(declarations, work, 0)
                        return false if not proof_replay_deterministic_scalar_type(scalar_return, declarations, 0)
                    else:
                        return false
                    for parameter in parameters:
                        return false if not proof_replay_summary_expr_charge_with_work(parameter.type_expression, work)
                        return false if not proof_replay_deterministic_declaration_scan_charge(declarations, work, 0)
                        return false if parameter.is_mutable or proof_replay_deterministic_parameter_type(parameter.type_expression, 0) or not proof_replay_deterministic_scalar_type(parameter.type_expression, declarations, 0)
                    for annotation in annotations |body, parameters|:
                        if annotation.name == "__global_mutable":
                            return false if proof_replay_deterministic_body_mentions(body, annotation.owner, 0)
                            for parameter in parameters:
                                return false if parameter.has_default and proof_expr_mentions_name(parameter.default_value, annotation.owner)
                    calls: mutable darray[sview] = []
                    return false if not proof_replay_source_calls_with_work(parameters, body, annotations, &calls, work)
                    next_active: mutable darray[sview] = []
                    next_active.extend(active)
                    next_active.push(name)
                    for called in calls |declarations, annotations, next_active, depth|:
                        return false if not proof_replay_deterministic_function(declarations, annotations, called, next_active, work, depth + 1)
                    return true
                _:
                    return false

        def proof_replay_deterministic_function(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, active: darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 32 or name == "" or any current in active where current == name
            return false if not proof_replay_deterministic_declaration_scan_charge(declarations, work, 0)
            source = proof_replay_effect_named_declaration(declarations, name, 0)
            return false if source.matches != 1
            return proof_replay_deterministic_function_declaration(declarations, annotations, name, source.declaration, active, work, depth)

        def proof_replay_deterministic_call_valid(report: mutable ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_deterministic_call_valid_with_work(report, trace, &work)

        def proof_replay_deterministic_call_valid_with_work(report: mutable ProofReport&, trace: ProofFactTrace, work: mutable usize&) -> bool:
            return false if not proof_replay_deterministic_declaration_scan_charge(report.source_declarations, work, 0)
            return false if report.source_annotations.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + report.source_annotations.count
            return false if not proof_replay_summary_expr_charge_with_work(trace.expression, work)
            aliases: mutable ProofModuleAliasIndex = ProofModuleAliasIndex{names: [], targets: [], scopes: [], lines: [], offsets: [], alias_lookup_hashes: [], alias_lookup_values: [], alias_lookup_ambiguous: [], global_alias_lookup_hashes: [], global_alias_lookup_values: [], function_lookup_hashes: [], function_lookup_values: [], function_lookup_ambiguous: [], function_lookup_complete: false, complete: false}
            alias_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_module_alias_index(report.source_annotations, &aliases, work)
            return false if not alias_status.complete or not aliases.complete
            alias_count: mutable usize = 0
            return false if not proof_replay_deterministic_module_alias_imports_supported(report.source_annotations, alias_count, work)
            import_count: mutable usize = 0
            matched_import_count: mutable usize = 0
            return false if not proof_replay_deterministic_alias_import_declarations_supported(report.source_declarations, report.source_annotations, import_count, matched_import_count, work, 0)
            return false if import_count != alias_count or matched_import_count != import_count
            marker = trace.expression
            match marker:
                Ast::Expr.Call(Ast::Expr.Ident(marker_name, _), arguments, _, _):
                    return false if marker_name != "__elisa_primitive_scalar_type" or arguments.count != 1
                    match arguments[0]:
                        Ast::Expr.Call(callee_expression, call_arguments, _, _):
                            callee: mutable sview = ""
                            qualified_declaration: mutable Ast::Decl = Ast::Decl.Invalid
                            qualified_call: mutable bool = false
                            match callee_expression:
                                Ast::Expr.Ident(name, _):
                                    callee <- name
                                Ast::Expr.Scope(_, name, _):
                                    qualified_matches: mutable usize = 0
                                    caller_line: mutable u32 = 0
                                    proof_replay_owner_function_line(report.source_declarations, trace.name, trace.line, &caller_line, 0)
                                    caller_owner: mutable sview = ""
                                    caller_count: mutable usize = 0
                                    proof_replay_module_at_function_line(report.source_declarations, caller_line, "", &caller_owner, &caller_count, 0)
                                    return false if caller_line == 0 or caller_count != 1
                                    return false if not proof_replay_deterministic_qualified_declaration(report.source_declarations, name, callee_expression, caller_owner, aliases, "", qualified_declaration, qualified_matches, work, 0)
                                    return false if qualified_matches != 1
                                    callee <- name
                                    qualified_call <- true
                                _:
                                    return false
                            for argument in call_arguments:
                                # Reference and mutable-reference actuals remain disallowed
                                # through wrappers such as parentheses/refinements too. The
                                # producer sees the resolved source type; replay must not accept
                                # a forged scalar-call marker by inspecting only the outer node.
                                return false if proof_replay_deterministic_parameter_type(argument, 0)
                            return false if not proof_replay_deterministic_call_source_site_with_work(report, trace, arguments[0], work)
                            active: mutable darray[sview] = []
                            return proof_replay_deterministic_function_declaration(report.source_declarations, report.source_annotations, callee, qualified_declaration, active, work, 0) if qualified_call
                            return proof_replay_deterministic_function(report.source_declarations, report.source_annotations, callee, active, work, 0)
                        _:
                            return false
                _:
                    return false
