include "./pop_value_source.elisa"
include "./entry_count_source.elisa"
include "./entry_count_boundary_validation.elisa"
include "./deterministic_call_declaration_index.elisa"
include "./deterministic_call_bare_resolution.elisa"
include "./deterministic_call_source_validation.elisa"
extend ElisaProof:
    private:
        def proof_replay_boundary_trace_kind(kind: sview) -> bool:
            match kind:
                "global-constant":
                    return true
                "global-constant-qualified":
                    return true
                "global-mutable-array-type":
                    return true
                "global-mutable-array-index-bound":
                    return true
                "precondition":
                    return true
                "type-bound":
                    return true
                "deterministic-call":
                    return true
                "variant-exclusion":
                    return true
                "const-enum-exclusion":
                    return true
                "const-enum-member-value":
                    return true
                "match-exhaustiveness":
                    return true
                "runtime-assert":
                    return true
                "runtime-guard":
                    return true
                "branch-condition":
                    return true
                "loop-condition":
                    return true
                "loop-invariant":
                    return true
                "loop-range":
                    return true
                "local-binding":
                    return true
                "collection-push":
                    return true
                "collection-pop":
                    return true
                "collection-pop-value":
                    return true
                "entry-count":
                    return true
                "linear-certificate":
                    return true
                "indexed-write":
                    return true
                _:
                    return false

        # A method-shaped cast/receiver equality is a source-semantic claim that the call
        # resolved to a builtin conversion. Elisa gives an exact `__cast__` hook precedence, so
        # the report cannot replay this fact from selector spelling alone.
        def proof_replay_is_numeric_cast_identity(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Binary(Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), target, _), arguments, _, _), TokenKind.EqEq, Ast::Expr.Ident(other, _), _):
                    return arguments.count == 0 and receiver != "" and receiver == other and proof_replay_numeric_cast_target(target)
                Ast::Expr.Binary(Ast::Expr.Ident(other, _), TokenKind.EqEq, Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), target, _), arguments, _, _), _):
                    return arguments.count == 0 and receiver != "" and receiver == other and proof_replay_numeric_cast_target(target)
                _:
                    return false

        def proof_replay_boundary_trace_payload_shape_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if:
                trace.dependency != ""
                trace.premises_count != 0
                trace.kernel_premises_count != 0
                trace.summary_bindings_count != 0
                trace.summary_requires_count != 0
                trace.summary_ensure_index != 0
                trace.summary_bindings_start > report.analysis_1.traces.summary_names.count
                trace.summary_requires_start > report.analysis_1.traces.summary_require_goal_ids.count
            return true

        def proof_replay_numeric_cast_target(target: sview) -> bool:
            return target in {"i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize"}

        # Trusted source-boundary facts have no derivation or summary payload. Without this
        # structural check, changing a summary trace's kind to `precondition` or `runtime-assert`
        # bypasses the exact declaration, argument, and precondition checks below.
        def proof_replay_boundary_trace_shape_valid(report: mutable ProofReport&, trace: ProofFactTrace) -> bool can[Global.Read, Global.Write]:
            source_work: mutable usize = 0
            return (proof_replay_boundary_trace_shape_valid_with_work(report, trace, &source_work) can Global{Read,Write})

        def proof_replay_boundary_trace_shape_valid_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            cache: mutable ProofReplayStructuralValidationCache = ProofReplayStructuralValidationCache{}
            return (proof_replay_boundary_trace_shape_valid_with_cache(report, trace, source_work, &cache) can Global{Read,Write})

        def proof_replay_boundary_trace_shape_valid_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_replay_boundary_trace_payload_shape_valid(report, trace)
            if trace.kind == "precondition":
                return proof_replay_precondition_source_valid_with_work(report, trace, source_work)
            if trace.kind == "branch-condition":
                owner_line: mutable u32 = report.analysis_2.replay_owner_line
                owner_line <- 0 if owner_line == 4294967295
                return false if not proof_replay_summary_owner_source_scan_with_limit(report, trace.name, owner_line, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                return false if:
                    not proof_replay_summary_expr_charge_with_limit(trace.expression, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                    source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                return proof_replay_control_branch_fact_source_with_work(report, trace, source_work)
            if trace.kind in {"loop-condition", "loop-invariant", "loop-range"}:
                owner_line: mutable u32 = report.analysis_2.replay_owner_line
                owner_line <- 0 if owner_line == 4294967295
                return false if:
                    not proof_replay_summary_owner_source_scan_with_limit(report, trace.name, owner_line, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    not proof_replay_summary_expr_charge_with_limit(trace.expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                # The control-flow validator has its own tighter work cap. Keep it local so
                # certificates and boundary facts processed earlier in this batch cannot make
                # this check fail just because the shared report-wide counter is already large.
                control_work: mutable usize = 0
                return false if:
                    not (proof_replay_control_loop_fact_source_with_work(report, trace, &control_work) can Global{Read,Write})
                    source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or control_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + control_work
                return true
            if trace.kind in {"runtime-assert", "runtime-guard"}:
                return false if:
                    not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, source_work)
                    not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                    report.analysis_1.certificates.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.analysis_1.certificates.count
                return false if report.results.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.results.goal_attempts.count
                return false if report.source.source_annotations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.source.source_annotations.count
                if report.analysis_2.trace_consumer_certificate_index != 0 and report.analysis_2.trace_consumer_certificate_index <= report.analysis_1.certificates.count:
                    return false if not proof_replay_summary_expr_charge_with_work(report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1].goal, source_work)
                for attempt in report.results.goal_attempts |source_work|:
                    return false if not proof_replay_summary_expr_charge_with_work(attempt.goal, source_work)
                return proof_replay_runtime_fact_source_valid_with_cache(report, trace, source_work, &cache.deterministic_calls)
            # A cast/receiver equality is only sound after replay proves the exact widening
            # source site. This trace carries no such type evidence, so selector spelling and
            # absence of a hook cannot make it a trusted boundary fact.
            if trace.kind == "type-bound" and proof_replay_is_numeric_cast_identity(trace.expression):
                return false
            # A global-array boundary fact keeps its source owner line when its kind is
            # rewritten to the broad `type-bound` label. Re-run the declaration-backed check
            # instead of letting a kind mutation fall through to the generic type-bound case.
            if trace.kind == "type-bound" and trace.owner_line != 0:
                return proof_replay_global_mutable_array_type_fact_is_valid_with_work(report, trace, source_work)
            if trace.kind == "type-bound":
                return proof_replay_type_bound_source_valid_budgeted_with_cache(report, trace, source_work, &cache.deterministic_calls)
            if trace.kind in {"global-constant", "global-constant-qualified"}:
                owner_line: mutable u32 = report.analysis_2.replay_owner_line
                owner_line <- 0 if owner_line == 4294967295
                return false if:
                    not proof_replay_summary_owner_source_preflight(report, trace.name, owner_line, source_work)
                    not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                return proof_replay_global_constant_fact_is_valid_with_work(report, trace, source_work)
            if trace.kind == "global-mutable-array-type":
                return proof_replay_global_mutable_array_type_fact_is_valid_with_work(report, trace, source_work)
            if trace.kind == "global-mutable-array-index-bound":
                return proof_replay_global_mutable_array_type_fact_is_valid_with_work(report, trace, source_work)
            if trace.kind == "variant-exclusion":
                return false if not proof_replay_variant_source_work_charge(report, trace, source_work, 0, false)
                return proof_replay_variant_exclusion_valid(report, trace, source_work)
            if trace.kind == "const-enum-exclusion":
                return false if not proof_replay_variant_source_work_charge(report, trace, source_work, 0, false)
                return proof_replay_const_enum_exclusion_valid(report, trace, source_work)
            if trace.kind == "const-enum-member-value":
                return false if not proof_replay_variant_source_work_charge(report, trace, source_work, 0, false)
                return proof_replay_const_enum_member_value_valid(report, trace, source_work)
            if trace.kind == "match-exhaustiveness":
                return false if not proof_replay_variant_source_work_charge(report, trace, source_work, 0, true)
                return proof_replay_match_exhaustiveness_valid(report, trace, source_work)
            if trace.kind == "deterministic-call":
                return proof_replay_deterministic_call_valid_with_cache(report, trace, source_work, &cache.deterministic_calls)
            if trace.kind == "entry-count":
                return false if:
                    not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, source_work)
                    not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                return proof_replay_entry_count_boundary_fact_valid_with_work(report, trace, source_work)
            if trace.kind == "linear-certificate":
                return false if:
                    not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, source_work)
                    not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                    report.results.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.results.goal_attempts.count
                for attempt in report.results.goal_attempts |source_work|:
                    return false if not proof_replay_summary_expr_charge_with_work(attempt.goal, source_work)
                return false if report.analysis_1.certificate_facts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.analysis_1.certificate_facts.count
                for fact in report.analysis_1.certificate_facts |source_work|:
                    return false if not proof_replay_summary_expr_charge_with_work(fact, source_work)
                return false if report.analysis_1.kernel.certificate_facts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.analysis_1.kernel.certificate_facts.count
                return false if report.analysis_1.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.analysis_1.traces.records.count
                for candidate in report.analysis_1.traces.records |source_work|:
                    return false if not proof_replay_summary_expr_charge_with_work(candidate.expression, source_work)
                return proof_replay_linear_certificate_trace_valid(report, trace)
            if trace.kind == "collection-pop-value":
                return false if:
                    not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, source_work)
                    not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                    report.source.source_annotations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.source.source_annotations.count
                # `pop_value_source` has two independently reset declaration walks capped at
                # 4096 each. Reserve both against the report batch before invoking it.
                return false if 8192 > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + 8192
                return ElisaProofFrameSource::pop_value_source(&report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, trace.line, trace.expression)
            if trace.kind == "local-binding":
                if proof_replay_local_binding_source_valid_with_cache(report, trace, source_work, &cache.deterministic_calls):
                    return true
                if proof_replay_literal_call_argument_binding_valid_with_work(report, trace, source_work):
                    return true
                owner_line: mutable u32 = report.analysis_2.replay_owner_line
                owner_line <- 0 if owner_line == 4294967295
                call_result_source_start: usize = source_work
                return false if not proof_replay_summary_owner_source_preflight(report, trace.name, owner_line, source_work)
                call_result_source_cost: usize = source_work - call_result_source_start
                return false if:
                    not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                    report.analysis_1.traces.records.count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 12
                source_work <- source_work + report.analysis_1.traces.records.count * 12
                return false if report.source.source_annotations.count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 4
                source_work <- source_work + report.source.source_annotations.count * 4
                return false if call_result_source_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / 12
                source_work <- source_work + call_result_source_cost * 12
                return proof_replay_call_result_binding_valid_with_cache(report, trace, source_work, &cache.deterministic_calls)
            # A whitelisted kind is not evidence by itself. Every boundary fact admitted as an
            # axiom needs an explicit source reconstruction above; newly added kinds stay
            # untrusted until replay knows how to validate their source event.
            return false

        # Deterministic-call scalar witnesses are source claims, not trusted type facts. Replay
        # rebuilds the callee's call graph from declarations and accepts only an acyclic chain of
        # effect-free, by-value functions. Any mutable global in this source currently makes the
        # check conservative: that keeps a global read from being mistaken for a pure value.
