const PROOF_REPLAY_INCOMPLETE_SENTINEL_GAPS: u32 = 1

extend ElisaProof:
    public:
        def proof_replay_note_trace_lookup_budget(report: mutable ProofReport&) -> void:
            proof_kernel_budget_note(report, "replay-trace-lookup") if report.traces.lookup_work_used > PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET

        # This audit validates one trace entry. Do not leave the all-facts origin cache
        # behind: only the selected trace is validated below, so other rows must not become
        # newly presentable through snapshots the audit just rebuilt.
        def proof_replay_fact_trace_entry[@r](report: mutable ProofReport& @r, trace_index: usize) -> bool can[Global{Read, Write}]:
            valid: bool = (proof_replay_fact_trace_entry_with_cache(report, trace_index) can Global{Read,Write})
            report.traces.origin_indices.clear()
            report.traces.origin_snapshots.clear()
            return valid

    private:
        # Standalone provenance entry point for auditors and adversarial harnesses. Require both
        # independently implemented views so this audit API detects drift between source-level
        # reconstruction and the authoritative source-neutral kernel trace.
        def proof_replay_fact_trace_entry_with_cache[@r](report: mutable ProofReport& @r, trace_index: usize) -> bool can[Global{Read, Write}]:
            # This entry has no active certificate context. Ignore caller-retained report
            # context and rebuild every cache it uses from the current mutable report.
            report.replay_owner_line <- 0
            report.trace_owner_line <- 0
            report.trace_consumer_certificate_index <- 0
            return false if trace_index >= report.traces.records.count
            proof_replay_build_fact_trace_index(report)
            proof_replay_cache_fact_origins(report)
            proof_replay_note_trace_lookup_budget(report)
            return false if report.kernel.budget_exhausted
            report.kernel.arena_validated <- (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&report.kernel.nodes, &report.kernel.children) can Global{Read,Write})
            return false if not report.kernel.arena_validated
            trace: ProofFactTrace = report.traces.records[trace_index]
            dependency_stack: mutable darray[sview] = [trace.name]
            active_certificates: mutable darray[usize] = []
            validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            node_count: usize = report.kernel.nodes.count
            child_count: usize = report.kernel.children.count
            source_valid: bool = (proof_replay_fact_trace_is_valid_with_stack(report, trace, trace.name, 0, dependency_stack, active_certificates, validation_workspace) can Global{Read,Write})
            proof_replay_note_trace_lookup_budget(report)
            return false if report.kernel.budget_exhausted
            kernel_valid: mutable bool = (proof_replay_kernel_fact_trace_is_valid_with_stack(report, trace, trace.name, 0, dependency_stack, true, active_certificates, validation_workspace) can Global{Read,Write})
            if node_count != report.kernel.nodes.count or child_count != report.kernel.children.count:
                report.kernel.arena_validated <- (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&report.kernel.nodes, &report.kernel.children) can Global{Read,Write})
                kernel_valid <- false if not report.kernel.arena_validated
            proof_replay_note_trace_lookup_budget(report)
            return false if report.kernel.budget_exhausted
            return source_valid and kernel_valid

    public:
        def proof_replay_fact_trace_index(report: mutable ProofReport&, fact: Ast::Expr, owner: sview) -> usize:
            # Once replay reports a resource-budget failure, do not turn an unavailable index
            # into a repeated full scan for every certificate fact. Such a report cannot prove
            # certificates, and the budget diagnostic remains authoritative.
            return report.traces.records.count if report.kernel.budget_exhausted or report.traces.lookup_work_used > PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET
            index_capacity: usize = report.traces.index_values.count
            return report.traces.records.count if index_capacity > PROOF_REPLAY_TRACE_INDEX_SLOT_BUDGET
            index_ready: bool = index_capacity > 0 and report.traces.index_hashes.count == index_capacity and report.traces.next_indices.count == report.traces.records.count and report.traces.expression_index_values.count == index_capacity and report.traces.expression_index_hashes.count == index_capacity and report.traces.expression_hashes.count == report.traces.records.count and report.traces.next_expression_indices.count == report.traces.records.count
            # The index is rebuilt before certificate-origin lookup. If it is missing or has a
            # malformed shape, fail closed instead of doing a full trace scan for every fact.
            return report.traces.records.count if not index_ready
            expression_shape: (supported: bool, hash: u32) = proof_replay_trace_expression_hash(report, fact, 0)
            return report.traces.records.count if not expression_shape.supported
            expression_hash: u32 = expression_shape.hash
            indexed_head: usize = proof_replay_fact_expression_head(report, owner, expression_hash)
            return report.traces.records.count if indexed_head >= report.traces.records.count
            trace_index: mutable usize = indexed_head
            probes: mutable usize = 0
            while trace_index < report.traces.records.count and probes < report.traces.records.count |trace_index, report, fact, owner, probes|:
                trace: ProofFactTrace = report.traces.records[trace_index]
                return report.traces.records.count if not proof_replay_trace_lookup_charge_amount(report, sview_len(trace.name))
                return report.traces.records.count if trace.name != owner or trace_index >= report.traces.expression_hashes.count or report.traces.expression_hashes[trace_index] != expression_hash
                # The structural equality preflight bounds its two expression walks.
                return report.traces.records.count if not proof_replay_trace_expression_equality_work(report, fact)
                return report.traces.records.count if not proof_replay_trace_expression_equality_work(report, trace.expression)
                return trace_index if proof_replay_expr_equal(trace.expression, fact)
                trace_index <- proof_replay_trace_expression_chain_next(report, trace_index, owner, expression_hash)
                probes <- probes + 1
            return report.traces.records.count

        def proof_replay_fact_origin[@r](report: mutable ProofReport& @r, fact: Ast::Expr, owner: sview) -> (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) can[Global.Read, Global.Write]:
            index: usize = proof_replay_fact_trace_index(report, fact, owner)
            return (false, "", 0, "", "", 0) if index >= report.traces.records.count
            return (false, "", 0, "", "", 0) if not (proof_replay_fact_trace_entry(report, index) can Global{Read,Write})
            return (true, report.traces.records[index].kind, report.traces.records[index].line, report.traces.records[index].name, report.traces.records[index].dependency, report.traces.records[index].premises_count) if index < report.traces.records.count
            return (false, "", 0, "", "", 0)

    private:
        def proof_replay_cache_fact_origins(report: mutable ProofReport&) -> void:
            sentinel: usize = report.traces.records.count
            report.traces.origin_indices.clear()
            report.traces.origin_snapshots.clear()
            return if not proof_kernel_report_append_allowed(report, 0, report.certificate_facts.count, "replay-fact-origins")
            return if not proof_kernel_report_append_allowed(report, 0, report.certificate_facts.count, "replay-fact-origin-snapshots")
            return if not proof_kernel_report_append_allowed(report, 0, report.certificates.count, "replay-fact-origins")
            report.traces.origin_indices.resize(report.certificate_facts.count)
            report.traces.origin_snapshots.resize(report.certificate_facts.count)
            for index in 0..<report.traces.origin_indices.count |index, report, sentinel|:
                return if not proof_replay_trace_lookup_charge(report)
                report.traces.origin_indices[index] <- sentinel
            for certificate_index in 0..<report.certificates.count |certificate_index, report|:
                certificate: ProofGoalCertificate = report.certificates[certificate_index]
                return if not proof_replay_trace_lookup_charge(report)
                return if certificate.facts_start > report.certificate_facts.count or certificate.facts_count > report.certificate_facts.count - certificate.facts_start
                for offset in 0..<certificate.facts_count |offset, certificate, report|:
                    return if not proof_replay_trace_lookup_charge(report)
                    fact_index: usize = certificate.facts_start + offset
                    fact: Ast::Expr = report.certificate_facts[fact_index]
                    origin_index: usize = proof_replay_fact_trace_index(report, fact, certificate.name)
                    report.traces.origin_indices[fact_index] <- origin_index
                    if origin_index < report.traces.records.count:
                        origin: ProofFactTrace = report.traces.records[origin_index]
                        report.traces.origin_snapshots[fact_index] <- ProofFactOriginSnapshot{expression: fact, trace_index: origin_index, kind: origin.kind, line: origin.line, name: origin.name, dependency: origin.dependency, premises_count: origin.premises_count}
                    return if report.kernel.budget_exhausted

    public:
        def proof_replay_fact_origin_work_exhausted(work: usize) -> bool:
            return work > PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET

        def proof_replay_fact_origin_work_charge(amount: usize, work: mutable usize&) -> bool:
            if work > PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET or amount > PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET - work:
                work <- PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET + 1
                return false
            work <- work + amount
            return true

        def proof_replay_fact_origin_text_compare_charge(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if not proof_replay_fact_origin_work_charge(1, work)
            return false if not proof_replay_fact_origin_work_charge(sview_len(left), work)
            return false if not proof_replay_fact_origin_work_charge(sview_len(right), work)
            return true

        # A report's fact and trace arrays are public mutable data. Charge both cost passes and
        # the exact comparison before trusting that an output cache still describes this report.
        def proof_replay_fact_origin_expression_equal_with_work(left: Ast::Expr, right: Ast::Expr, work: mutable usize&) -> bool:
            if work >= PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET:
                work <- PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET + 1
                return false
            cost: mutable usize = 0
            if not proof_replay_summary_expr_cost(left, &cost, work, 0) or not proof_replay_summary_expr_cost(right, &cost, work, 0):
                work <- PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET + 1
                return false
            if cost > (PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET - work) / 2:
                work <- PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET + 1
                return false
            work <- work + cost * 2
            return proof_replay_expr_equal(left, right)

        # Structural expression equality intentionally ignores source spans; origin output
        # exposes the root line, so bind every root-position component to the replay snapshot.
        def proof_replay_fact_origin_position_equal_with_work(left: Ast::Expr, right: Ast::Expr, work: mutable usize&) -> bool:
            return false if not proof_replay_fact_origin_work_charge(6, work)
            left_position: Ast::Pos = Ast::expr_pos(left)
            right_position: Ast::Pos = Ast::expr_pos(right)
            return left_position.line == right_position.line and left_position.column == right_position.column and left_position.offset == right_position.offset and left_position.end_line == right_position.end_line and left_position.end_column == right_position.end_column and left_position.end_offset == right_position.end_offset

        def proof_replay_fact_origin_at_with_work(report: ProofReport&, fact_index: usize, owner: sview, work: mutable usize&) -> (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize):
            if report.kernel.budget_exhausted or report.traces.lookup_work_used > PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET or work > PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET:
                work <- PROOF_REPLAY_TRACE_LOOKUP_WORK_BUDGET + 1
                return (false, "", 0, "", "", 0)
            # Charge the cached lookup, its owner comparison, and each snapshot comparison.
            # The shared render counter makes repeated and all-pairs callers bounded.
            return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_work_charge(1, work)
            return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_work_charge(sview_len(owner), work)
            if fact_index < report.certificate_facts.count and fact_index < report.traces.origin_indices.count and fact_index < report.traces.origin_snapshots.count:
                trace_index: usize = report.traces.origin_indices[fact_index]
                snapshot: ProofFactOriginSnapshot = report.traces.origin_snapshots[fact_index]
                if trace_index < report.traces.records.count and trace_index == snapshot.trace_index:
                    cached: ProofFactTrace = report.traces.records[trace_index]
                    return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_text_compare_charge(snapshot.name, owner, work)
                    return (false, "", 0, "", "", 0) if snapshot.name != owner
                    return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_text_compare_charge(cached.name, snapshot.name, work)
                    return (false, "", 0, "", "", 0) if cached.name != snapshot.name
                    return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_text_compare_charge(cached.kind, snapshot.kind, work)
                    return (false, "", 0, "", "", 0) if cached.kind != snapshot.kind
                    return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_text_compare_charge(cached.dependency, snapshot.dependency, work)
                    return (false, "", 0, "", "", 0) if cached.dependency != snapshot.dependency
                    return (false, "", 0, "", "", 0) if cached.line != snapshot.line or cached.premises_count != snapshot.premises_count
                    return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_expression_equal_with_work(report.certificate_facts[fact_index], snapshot.expression, work)
                    return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_position_equal_with_work(report.certificate_facts[fact_index], snapshot.expression, work)
                    return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_expression_equal_with_work(cached.expression, snapshot.expression, work)
                    return (false, "", 0, "", "", 0) if not proof_replay_fact_origin_position_equal_with_work(cached.expression, snapshot.expression, work)
                    return (true, cached.kind, cached.line, cached.name, cached.dependency, cached.premises_count)
            return (false, "", 0, "", "", 0)

    private:
        # This report-bound cache is only valid inside a fresh replay batch, after every flag
        # was reset and before the mutable report escapes. Public consumers use the opaque
        # ProofReplayReceipt projection below instead.
        def proof_replay_attempt_certificate_replayed(report: ProofReport&, attempt: ProofGoalAttempt) -> bool:
            work: mutable usize = 0
            return proof_replay_attempt_certificate_replayed_with_work(report, attempt, &work)

        def proof_replay_attempt_certificate_replayed_with_work(report: ProofReport&, attempt: ProofGoalAttempt, source_work: mutable usize&) -> bool:
            return false if not attempt.has_certificate or attempt.certificate_index >= report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[attempt.certificate_index]
            return false if not proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, attempt.certificate_index, source_work)
            return certificate.replayed

        # The producer's result is only an internal candidate until its exact bound
        # certificate has passed independent replay.
        def proof_replay_attempt_is_proven(report: ProofReport&, attempt: ProofGoalAttempt) -> bool:
            return attempt.proven and proof_replay_attempt_certificate_replayed(report, attempt)

        def proof_replay_attempt_statuses_with_work(report: ProofReport&, replayed: mutable darray[bool]&, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            replayed.clear()
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or report.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + report.goal_attempts.count
            for attempt in report.goal_attempts |report, replayed, source_work|:
                replayed.push(proof_replay_attempt_certificate_replayed_with_work(report, attempt, source_work))
            return source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT

    public:
        # Shared output-cost meter. This charges formatting work only; it carries no proof
        # status and is safe for renderer callers to use directly.
        def proof_replay_source_work_charge(amount: usize, source_work: mutable usize&) -> bool:
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + amount
            true

    private:
        def proof_replay_source_work_charge_or_exhaust(amount: usize, source_work: mutable usize&) -> bool:
            return true if proof_replay_source_work_charge(amount, source_work)
            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            false

        def proof_replay_receipt_discharges_return_with_work[@r](report: ProofReport&, receipt: ProofReplayReceipt[r], name: sview, line: u32, source_work: mutable usize&) -> (complete: bool, discharged: bool):
            return (true, false) if name == "" or line == 0 or not receipt.issued
            for finding in report.findings |finding, name, line, source_work|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(sview_len(finding.name), source_work)
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(sview_len(name), source_work)
                finding_name_matches: bool = finding.name == name
                return (true, false) if finding_name_matches or finding.line == line
            discharged: mutable bool = false
            for goal_id in 0..<report.goal_attempts.count |goal_id, report, receipt, name, line, discharged, source_work|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(sview_len(attempt.name), source_work)
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(sview_len(name), source_work)
                attempt_name_matches: bool = attempt.name == name
                if attempt_name_matches and attempt.line == line:
                    return (true, false) if not attempt.proven or not proof_replay_receipt_attempt_status(receipt, goal_id)
                    discharged <- true
            (true, discharged)

        def proof_replay_filter_refined_diagnostics_with_work[@r](diagnostics: darray[Semantic::Diagnostic]&, report: ProofReport&, receipt: ProofReplayReceipt[r], refined_functions: darray[sview]&, source_work: mutable usize&) -> (complete: bool, kept: darray[Semantic::Diagnostic]) can[Memory.Allocate]:
            kept: mutable darray[Semantic::Diagnostic] = []
            for diagnostic in diagnostics |diagnostic, kept, report, receipt, refined_functions, source_work|:
                return (false, kept) if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                candidate: bool = diagnostic.kind == Semantic::DiagnosticKind.EnsureNotProven and diagnostic.detail != "violated"
                refined: mutable bool = false
                if candidate:
                    for refined_name in refined_functions |diagnostic, refined, source_work|:
                        return (false, kept) if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                        return (false, kept) if not proof_replay_source_work_charge_or_exhaust(sview_len(refined_name), source_work)
                        return (false, kept) if not proof_replay_source_work_charge_or_exhaust(sview_len(diagnostic.name), source_work)
                        refined <- true if refined_name == diagnostic.name
                        break if refined
                superseded: mutable bool = false
                if candidate and refined:
                    discharge: (complete: bool, discharged: bool) = proof_replay_receipt_discharges_return_with_work(report, receipt, diagnostic.name, diagnostic.line, source_work)
                    return (false, kept) if not discharge.complete
                    superseded <- discharge.discharged
                kept.push(diagnostic) if not superseded
            (true, kept)

        def proof_replay_attempt_statuses_and_complete_with_work(report: ProofReport&, replayed: mutable darray[bool]&, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            return false if not proof_replay_attempt_statuses_with_work(report, replayed, source_work)
            return false if report.replay_gaps != 0 or report.replayed != report.certificates.count
            return false if replayed.count != report.goal_attempts.count
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or report.certificates.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + report.certificates.count
            for certificate in report.certificates:
                return false if not certificate.replayed
            for index in 0..<report.goal_attempts.count |index, report, replayed|:
                return false if report.goal_attempts[index].proven and not replayed[index]
            true

        # A zero gap counter alone is not proof that replay completed: bounded setup can reject
        # the replay batch before visiting any certificate, and reports may be revalidated after
        # their counters or per-certificate flags were changed. Completion requires exact counts,
        # every certificate flag, and a replayed certificate bound to each proven attempt.
        def proof_replay_certificates_complete(report: ProofReport&) -> bool:
            return false if report.replay_gaps != 0 or report.replayed != report.certificates.count
            for certificate in report.certificates:
                return false if not certificate.replayed
            attempt_work: mutable usize = 0
            return false if report.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            attempt_work <- report.goal_attempts.count
            for attempt in report.goal_attempts |report, attempt_work|:
                if attempt.proven:
                    return false if not proof_replay_attempt_certificate_replayed_with_work(report, attempt, attempt_work)
            return true

        def proof_replay_receipt_from_report[@r](report: ProofReport& @r, source_validated: bool) -> ProofReplayReceipt[r] can[Memory.Allocate]:
            attempt_statuses: mutable darray[bool] = []
            source_work: mutable usize = 0
            complete: mutable bool = proof_replay_attempt_statuses_and_complete_with_work(report, &attempt_statuses, &source_work)
            return ProofReplayReceipt{} if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            proven_statuses: mutable darray[bool] = []
            certificate_statuses: mutable darray[bool] = []
            if report.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                complete <- false
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            else:
                source_work <- source_work + report.goal_attempts.count
                for index in 0..<report.goal_attempts.count |index, report, attempt_statuses, proven_statuses, complete, source_work|:
                    return ProofReplayReceipt{} if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    source_work <- source_work + 1
                    replayed: bool = index < attempt_statuses.count and attempt_statuses[index]
                    proven_statuses.push(report.goal_attempts[index].proven and replayed)
            if report.certificates.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                complete <- false
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            else:
                source_work <- source_work + report.certificates.count
                for certificate in report.certificates |certificate, certificate_statuses, source_work|:
                    return ProofReplayReceipt{} if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    source_work <- source_work + 1
                    certificate_statuses.push(certificate.replayed)
            return ProofReplayReceipt{} if attempt_statuses.count != report.goal_attempts.count
            return ProofReplayReceipt{} if proven_statuses.count != report.goal_attempts.count
            return ProofReplayReceipt{} if certificate_statuses.count != report.certificates.count
            return ProofReplayReceipt{attempt_statuses: attempt_statuses, attempt_proven_statuses: proven_statuses, certificate_statuses: certificate_statuses, replay_gap_count: report.replay_gaps, complete: complete, source_validated: source_validated, issued: true}

        def proof_replay_revoke_certificate_batch(report: mutable ProofReport&) -> void:
            report.replayed <- 0
            report.replay_gaps <- 0
            for certificate in report.certificates |certificate, report|:
                certificate.replayed <- false
                report.replay_gaps <- report.replay_gaps + 1

        def proof_replay_certificates_mutating[@r](report: mutable ProofReport& @r) -> void can[Global.Read, Global.Write]:
            # Replay is a query over the current immutable certificate set. Reset presentation
            # counters and per-certificate flags so repeated API calls cannot accumulate stale
            # results from an earlier replay pass.
            report.replayed <- 0
            report.replay_gaps <- 0
            report.trace_owner_line <- 0
            report.trace_consumer_certificate_index <- 0
            report.replay_owner_line <- 0
            (ElisaProofKernelReplay::proof_kernel_replay_reset_disjunction_work_measurements() can Global.Write)
            (ElisaProofKernelReplay::proof_kernel_replay_reset_arena_scan_measurements() can Global.Write)
            for certificate in report.certificates |certificate|:
                certificate.replayed <- false
            report.kernel.arena_validated <- (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&report.kernel.nodes, &report.kernel.children) can Global{Read,Write})
            validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            proof_replay_build_fact_trace_index(report)
            proof_replay_cache_fact_origins(report)
            proof_replay_note_trace_lookup_budget(report)
            if report.kernel.budget_exhausted:
                proof_replay_revoke_certificate_batch(report)
                return
            if not proof_kernel_report_append_allowed(report, 0, report.certificates.count, "replay-certificates"):
                max_gap_count: u32 = ElisaProofKernelCore::PROOF_KERNEL_U32_MAX.u32()
                report.replay_gaps <- max_gap_count if report.certificates.count > max_gap_count.usize() else report.certificates.count.u32()
                return
            arena_grew: mutable bool = false
            validation_workspace.allow_replayed_dependency_memo <- true
            for index in 0..<report.certificates.count |index, report, validation_workspace|:
                node_count: usize = report.kernel.nodes.count
                child_count: usize = report.kernel.children.count
                replayed: mutable bool = (proof_replay_certificate(report, report.certificates[index], index, validation_workspace) can Global{Read,Write})
                proof_replay_note_trace_lookup_budget(report)
                if report.kernel.budget_exhausted:
                    proof_replay_revoke_certificate_batch(report)
                    return
                # Quantifier instantiation and equality rewriting are intentionally append-only:
                # they construct derived roots in the same arena while replaying a certificate.
                # Each kernel rule independently checks the reachable facts/goal it consumes.
                # Defer the global disconnected-node check until this synchronous batch is over.
                # No certificate result escapes the batch before that final admission.
                if node_count != report.kernel.nodes.count or child_count != report.kernel.children.count:
                    arena_grew <- true
                report.certificates[index].replayed <- replayed
                if replayed:
                    report.replayed <- report.replayed + 1
                else:
                    report.replay_gaps <- report.replay_gaps + 1
            if arena_grew:
                report.kernel.arena_validated <- (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&report.kernel.nodes, &report.kernel.children) can Global{Read,Write})
                if not report.kernel.arena_validated:
                    # The complete arena is the public serialization boundary. If any appended
                    # disconnected component is malformed, revoke provisional results from this
                    # batch rather than exposing certificates checked against a partial view.
                    report.replayed <- 0
                    report.replay_gaps <- 0
                    for certificate in report.certificates |certificate, report|:
                        certificate.replayed <- false
                        report.replay_gaps <- report.replay_gaps + 1
            validation_workspace.allow_replayed_dependency_memo <- false
            if not proof_replay_certificates_complete(report) and report.replay_gaps == 0:
                report.replay_gaps <- PROOF_REPLAY_INCOMPLETE_SENTINEL_GAPS

    public:
        # Renderers and other modules may share the replay work cap without depending on
        # ElisaProof's private budget constant.
        def proof_replay_summary_source_work_limit() -> usize:
            PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT

        # Replay bookkeeping stays private on the mutable report. These accessors expose
        # diagnostics without giving renderer modules authority to change replay state.
        def proof_report_replay_gap_count(report: ProofReport&) -> u32:
            report.replay_gaps

        # Standalone compatibility API: the returned receipt is a replay-status snapshot only.
        # It does not freeze or source-bind the mutable caller report; use the combined checked
        # view below for any claim that needs source authorization.
        def proof_replay_certificates[@r](report: mutable ProofReport& @r) -> ProofReplayReceipt[r] can[Memory.Allocate, Global.Read, Global.Write]:
            (proof_replay_certificates_mutating(report) can Global{Read,Write})
            return proof_replay_receipt_from_report(report, false)

    public:

        def proof_check_and_replay_with_source[@r](source_arena: mutable Arena& @r, diagnostics: mutable darray[Semantic::Diagnostic]& @r, source: ProofSourceAnalysis[r], focus_function: sview, linear_hints: darray[i64]&) -> ProofCheckedView[r] can[Memory.Allocate, Global.Read, Global.Write]:
            in source_arena:
                report: mutable ProofReport& @r = new[r] proof_empty_report()
                diagnostics.clear()
                view_source: ProofSourceAnalysis[r] = source
                empty_receipt: ProofReplayReceipt[r]& @r = new[r] ProofReplayReceipt{}
                return ProofCheckedView{report: report, receipt: empty_receipt, source_analysis: view_source} if not view_source.issued
                source_identity: uintptr = view_source.source_identity
                source_file_identity: uintptr = view_source.file_identity
                source_bytes: usize = view_source.source_bytes
                source_fingerprint: u32 = view_source.source_fingerprint
                source_import_failed: bool = view_source.import_failed
                source_stray_nul_line: u32 = view_source.stray_nul_line
                pass_statement_offsets: darray[u32] = view_source.pass_statement_offsets
                refinement_findings: darray[ProofFinding] = view_source.refinement_findings
                refined_functions: darray[sview] = view_source.refined_functions
                literal_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = view_source.literal_ensure_inventory
                assert_by_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = view_source.assert_by_inventory
                file: Ast::File& = view_source.file
                parse_failed: bool = file.errors.count > 0 or source_stray_nul_line > 0
                report.pass_statement_offsets <- pass_statement_offsets
                for hint in linear_hints |report|:
                    report.linear_hints.push(hint)
                if parse_failed:
                    for parse_error in file.errors |report|:
                        proof_add_finding(report, "parse-error", parse_error.line, "", "source could not be parsed; verification was not attempted")
                    proof_add_finding(report, "parse-error", source_stray_nul_line, "", "source has a NUL byte outside a comment; verification was not attempted") if source_stray_nul_line > 0
                else:
                    return ProofCheckedView{report: report, receipt: empty_receipt, source_analysis: view_source} if not (proof_check_with_source_analysis(report, diagnostics, view_source, focus_function) can Global{Read,Write})
                    for finding in refinement_findings |report|:
                        report.proof_obligation(false)
                        proof_add_finding(report, finding.kind, finding.line, finding.name, finding.message)
                    if focus_function == "":
                        if not proof_source_literal_ensure_binding_coverage(literal_inventory, report):
                            source_binding_finding: mutable usize = report.findings.count
                            for finding_index in 0..<report.findings.count |finding_index, source_binding_finding, report|:
                                finding: ProofFinding = report.findings[finding_index]
                                source_binding_finding <- finding_index if finding.kind == "source-obligation-inventory" and finding.name == "" and finding.message == "a supported source postcondition has no distinct source-bound proof attempt"
                            if source_binding_finding == report.findings.count:
                                proof_add_finding(report, "source-obligation-inventory", 0, "", "a supported source postcondition has no distinct proof attempt")
                                source_binding_finding <- report.findings.count - 1
                            if proof_source_literal_ensure_inventory_has_unsupported(literal_inventory):
                                report.findings[source_binding_finding].status <- "unsupported"
                    elif report.findings.count == 0 and diagnostics.count == 0 and not proof_source_analysis_focused_obligations_bound(view_source, report):
                        proof_add_finding(report, "source-obligation-inventory", 0, focus_function, "a focused source obligation is unsupported or has no distinct replayed proof attempt")
                        report.findings[report.findings.count - 1].status <- "unsupported" if report.findings.count > 0
                proof_add_finding(report, "import-error", 0, "", "one or more Elisa include files could not be read") if source_import_failed
                (proof_replay_certificates_mutating(report) can Global{Read,Write})
                receipt_value: ProofReplayReceipt[r] = proof_replay_receipt_from_report(report, false)
                receipt: mutable ProofReplayReceipt[r]& @r = new[r] receipt_value
                return ProofCheckedView{report: report, receipt: empty_receipt, source_analysis: view_source} if not receipt.issued
                source_work: mutable usize = 0
                if not parse_failed:
                    filtered: (complete: bool, kept: darray[Semantic::Diagnostic]) = proof_replay_filter_refined_diagnostics_with_work(diagnostics, report, receipt, refined_functions, &source_work)
                    filtered_complete: bool = filtered.complete
                    diagnostics <- filtered.kept if filtered_complete
                semantic_counts: mutable (visible: u32, errors: u32) = (0, 1)
                semantic_count_status: (complete: bool, visible: u32, errors: u32) = proof_semantic_diagnostic_counts_with_work(diagnostics, report, &source_work)
                semantic_counts <- (semantic_count_status.visible, semantic_count_status.errors) if semantic_count_status.complete
                receipt.semantic_visible <- semantic_counts.visible
                receipt.semantic_errors <- semantic_counts.errors
                source_structure_failure: sview = "source-validation-incomplete" if parse_failed else proof_source_analysis_report_structure_bound_failure(true, source_file_identity, report, &source_work)
                if source_structure_failure == "":
                    receipt.source_identity <- source_identity
                    receipt.source_file_identity <- source_file_identity
                    receipt.source_bytes <- source_bytes
                    receipt.source_fingerprint <- source_fingerprint
                    receipt.source_bound <- true
                    receipt.source_validated <- true
                    goal_finding_clear: mutable darray[bool] = []
                    goal_finding_snapshot_ready: mutable bool = false
                    source_admission_snapshot: (complete: bool, failure: sview, source_checks_complete: bool, source_complete: bool, source_admissible: bool) = proof_source_analysis_report_admission_snapshot(view_source, report, source_import_failed, semantic_counts.errors, receipt.complete, &goal_finding_clear, &goal_finding_snapshot_ready, &source_work)
                    receipt.source_admission_snapshot_complete <- source_admission_snapshot.complete
                    receipt.source_admission_failure <- source_admission_snapshot.failure
                    receipt.source_checks_complete <- source_admission_snapshot.source_checks_complete
                    receipt.source_report_complete <- source_admission_snapshot.source_complete
                    receipt.source_report_admissible <- source_admission_snapshot.source_admissible
                    source_goal_snapshot: (statuses: darray[bool], complete: bool, claims_admissible: bool) = proof_source_analysis_goal_admission_snapshot(view_source, report, source_import_failed, semantic_counts.errors, &goal_finding_clear, goal_finding_snapshot_ready, source_work)
                    source_goal_statuses_complete: bool = source_goal_snapshot.complete
                    source_claims_admissible: bool = source_goal_snapshot.claims_admissible
                    receipt.source_goal_statuses <- source_goal_snapshot.statuses if source_goal_statuses_complete else []
                    receipt.source_goal_statuses_complete <- source_goal_statuses_complete
                    receipt.source_claims_admissible <- source_claims_admissible
                    theorem_source_snapshot: (statuses: darray[(source_admissible: bool, declaration_identity_unambiguous: bool)], complete: bool) = proof_report_theorem_source_status_snapshot(report, receipt.source_goal_statuses, receipt.source_goal_statuses_complete, source_import_failed, semantic_counts.errors, &source_work)
                    theorem_source_snapshot_complete: bool = theorem_source_snapshot.complete
                    receipt.theorem_source_admissions <- theorem_source_snapshot.statuses if theorem_source_snapshot_complete else []
                    receipt.theorem_source_admissions_complete <- theorem_source_snapshot_complete
                else:
                    receipt.source_admission_snapshot_complete <- false
                    receipt.source_admission_failure <- source_structure_failure
                return proof_checked_view_create(report, receipt, view_source)


        def proof_replay_receipt_is_issued[@r](receipt: ProofReplayReceipt[r]) -> bool:
            receipt.issued

        def proof_replay_receipt_is_complete[@r](receipt: ProofReplayReceipt[r]) -> bool:
            receipt.issued and receipt.complete

        def proof_replay_receipt_source_validated[@r](receipt: ProofReplayReceipt[r]) -> bool:
            receipt.issued and receipt.source_validated

        def proof_replay_receipt_attempt_count[@r](receipt: ProofReplayReceipt[r]) -> usize:
            return 0 if not receipt.issued
            receipt.attempt_statuses.count

        def proof_replay_receipt_certificate_count[@r](receipt: ProofReplayReceipt[r]) -> usize:
            return 0 if not receipt.issued
            receipt.certificate_statuses.count

        def proof_replay_receipt_gap_count[@r](receipt: ProofReplayReceipt[r]) -> (available: bool, count: u32):
            return (false, 0) if not receipt.issued
            (true, receipt.replay_gap_count)

        def proof_replay_receipt_attempt_status[@r](receipt: ProofReplayReceipt[r], attempt_index: usize) -> bool:
            return false if not receipt.issued or attempt_index >= receipt.attempt_statuses.count
            receipt.attempt_statuses[attempt_index]

        def proof_replay_receipt_attempt_is_proven[@r](receipt: ProofReplayReceipt[r], attempt_index: usize) -> bool:
            return false if not receipt.issued or not receipt.source_validated or attempt_index >= receipt.attempt_proven_statuses.count
            receipt.attempt_proven_statuses[attempt_index]

        def proof_replay_receipt_certificate_status[@r](receipt: ProofReplayReceipt[r], certificate_index: usize) -> bool:
            return false if not receipt.issued or certificate_index >= receipt.certificate_statuses.count
            receipt.certificate_statuses[certificate_index]

        def proof_replay_receipt_attempt_statuses_with_work[@r](receipt: ProofReplayReceipt[r], replayed: mutable darray[bool]&, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            replayed.clear()
            return false if not receipt.issued or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or receipt.attempt_statuses.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + receipt.attempt_statuses.count
            for status in receipt.attempt_statuses |replayed|:
                replayed.push(status)
            return true

        def proof_replay_receipt_certificate_statuses_with_work[@r](receipt: ProofReplayReceipt[r], replayed: mutable darray[bool]&, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            replayed.clear()
            return false if not receipt.issued or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or receipt.certificate_statuses.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + receipt.certificate_statuses.count
            for status in receipt.certificate_statuses |replayed|:
                replayed.push(status)
            return true

        def proof_replay_receipt_certificate_statuses_and_count_with_work[@r](receipt: ProofReplayReceipt[r], replayed: mutable darray[bool]&, replayed_count: mutable u32&, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            replayed.clear()
            replayed_count <- 0
            return false if not receipt.issued or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or receipt.certificate_statuses.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + receipt.certificate_statuses.count
            for status in receipt.certificate_statuses |replayed, replayed_count|:
                replayed.push(status)
                replayed_count <- replayed_count + 1 if status
            return true
