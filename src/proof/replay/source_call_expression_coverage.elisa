extend ElisaProof:
    private:
        def proof_replay_source_expression_calls_with_work(parameters: darray[Ast::ParamDecl]&, expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, calls: mutable darray[sview]&, work: mutable usize&) -> bool:
            target: mutable ProofReplayCallSiteTarget = ProofReplayCallSiteTarget{selection: ProofReplayCallSiteTargetSelection{enabled: false, ignore_unmatched_scoped_edges: false, allow_scoped_target: false, include_nonassert_contract_calls: false, offset: 0, line: 0, name: "", calls_at_offset: 0, matched_calls: 0, track_unresolved_dispatch: false, unresolved_dispatch_found: false, source_annotations: annotations}, conversions: ProofReplayCallSiteTargetConversions{field_conversion_parameters: [], field_conversion_names: [], field_conversion_index_valid: false, field_conversion_index_hashes: [], field_conversion_index_values: [], field_conversion_index_counts: [], field_conversion_custom_cast_present: false}, aliases: ProofReplayCallSiteTargetAliases{field_conversion_alias_names: [], field_conversion_alias_targets: [], field_conversion_alias_lines: [], field_conversion_bare_alias_root_fallback_valid: false, field_conversion_alias_owners: [], field_conversion_alias_has_formals: [], field_conversion_alias_scope_index_valid: false, field_conversion_alias_scope_index_hashes: [], field_conversion_alias_scope_index_values: [], field_conversion_alias_scope_index_counts: [], field_conversion_alias_index_valid: false, field_conversion_alias_index_hashes: [], field_conversion_alias_index_values: [], field_conversion_alias_index_counts: []}, generics: ProofReplayCallSiteTargetGenerics{field_conversion_generic_params_valid: false, field_conversion_generic_param_lines: [], field_conversion_generic_param_names: [], field_conversion_generic_param_line: 0, field_conversion_generic_param_owner: "", field_conversion_generic_param_owner_known: false, field_conversion_generic_param_index_valid: false, field_conversion_generic_param_index_hashes: [], field_conversion_generic_param_index_values: [], field_conversion_generic_param_index_counts: []}, types: ProofReplayCallSiteTargetTypes{field_conversion_declared_types: [], field_conversion_declared_type_owners: [], field_conversion_declared_type_scope_index_valid: false, field_conversion_declared_type_scope_index_hashes: [], field_conversion_declared_type_scope_index_values: [], field_conversion_declared_type_scope_index_counts: [], field_conversion_declared_type_index_valid: false, field_conversion_declared_type_index_hashes: [], field_conversion_declared_type_index_values: [], field_conversion_declared_type_index_counts: []}}
            return proof_replay_source_expression_calls_with_target_work(parameters, expression, annotations, calls, target, work)

        def proof_replay_source_expression_calls_with_target_work(parameters: darray[Ast::ParamDecl]&, expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            call_index: mutable ProofReplayCallNameIndex = ProofReplayCallNameIndex{}
            return false if not proof_replay_call_name_index_build(calls, call_index, work)
            return proof_replay_source_expression_calls_with_target_index_work(parameters, expression, annotations, calls, call_index, call_target, work)

        def proof_replay_source_expression_calls_with_target_index_work(parameters: darray[Ast::ParamDecl]&, expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, calls: mutable darray[sview]&, call_index: mutable ProofReplayCallNameIndex&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            bindings: mutable darray[sview] = []
            return false if not proof_replay_call_work_add(work, parameters.count)
            for parameter in parameters |bindings, work|:
                return false if not proof_replay_call_work_add(work, sview_len(parameter.name))
                bindings.push(parameter.name)
            call_target.selection.source_annotations <- annotations
            return proof_replay_call_expression_with_index(expression, &bindings, calls, call_index, call_target, work, 0)

        def proof_replay_source_call_set_matches(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, annotations: darray[Ast::EnumAnnotation]&, expected: darray[sview]&) -> bool:
            work: mutable usize = 0
            return proof_replay_source_call_set_matches_with_work(parameters, body, annotations, expected, &work)

        def proof_replay_source_call_set_matches_with_work(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, annotations: darray[Ast::EnumAnnotation]&, expected: darray[sview]&, work: mutable usize&) -> bool:
            calls: mutable darray[sview] = []
            return false if not proof_replay_source_calls_with_work(parameters, body, annotations, &calls, work) or calls.count != expected.count
            expected_names: mutable darray[sview] = []
            expected_index: mutable ProofReplayCallNameIndex = ProofReplayCallNameIndex{}
            for name in expected |name, expected_names, expected_index, work|:
                previous_count: usize = expected_names.count
                return false if:
                    not proof_replay_call_name_index_add(&expected_names, &expected_index, name, work)
                    expected_names.count == previous_count
            for called in calls |called, expected_names, expected_index, work|:
                found: (complete: bool, present: bool) = proof_replay_call_name_index_contains(expected_names, expected_index, called, work)
                return false if not found.complete or not found.present
            return true
