extend ElisaProof:
    private:
        # Direct storage allocations in declarations and assignments produce state-changing
        # events whose source bridge is not admitted by the fact boundary yet. Do not let a
        # forged trace omit such an event and thereby erase the source transition.
        def proof_replay_resource_unbridged_storage_allocation(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, found: bool):
            return (false, false) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_replay_resource_unbridged_storage_allocation(inner, source_work, depth + 1)
                Ast::Expr.RegionNew(_, _, _):
                    (true, true)
                _:
                    (true, false)

        def proof_replay_resource_unbridged_storage_allocations_absent(body: darray[Ast::Stmt]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for statement in body |source_work, depth|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        allocation: (complete: bool, found: bool) = proof_replay_resource_unbridged_storage_allocation(initializer, source_work, 0)
                        return false if not allocation.complete or allocation.found
                    Ast::Stmt.Assign(_, _, value, _):
                        allocation: (complete: bool, found: bool) = proof_replay_resource_unbridged_storage_allocation(value, source_work, 0)
                        return false if not allocation.complete or allocation.found
                    Ast::Stmt.If(_, yes, no, _):
                        return false if not proof_replay_resource_unbridged_storage_allocations_absent(yes, source_work, depth + 1)
                        return false if not proof_replay_resource_unbridged_storage_allocations_absent(no, source_work, depth + 1)
                    Ast::Stmt.While(_, nested, _) | Ast::Stmt.For(_, _, _, nested, _) | Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_resource_unbridged_storage_allocations_absent(nested, source_work, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |source_work, depth|:
                            return false if not proof_replay_owner_work_charge(1, source_work)
                            return false if not proof_replay_resource_unbridged_storage_allocations_absent(arm.body, source_work, depth + 1)
                    Ast::Stmt.Expr(expression, _):
                        match expression:
                            Ast::Expr.RegionNew(_, _, _):
                                pass # Discarded allocations have an exact offset census.
                            _:
                                allocation: (complete: bool, found: bool) = proof_replay_resource_unbridged_storage_allocation(expression, source_work, 0)
                                return false if not allocation.complete or allocation.found
                    Ast::Stmt.Return(expression, _):
                        # Direct return allocations have their own source-linked witness.
                        match expression:
                            Ast::Expr.RegionNew(_, _, _):
                                pass
                            _:
                                allocation: (complete: bool, found: bool) = proof_replay_resource_unbridged_storage_allocation(expression, source_work, 0)
                                return false if not allocation.complete or allocation.found
                    Ast::Stmt.Contract(_, _, _) | Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        return false
                    _:
                        return false
            true

        def proof_replay_resource_event_find_expression_with_work(expression: Ast::Expr, offset: usize, wanted_kind: sview, wanted_name: sview, matches: mutable usize&, found: mutable Ast::Expr&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, position):
                    if wanted_kind == "resource-use" and position.offset == offset.u32():
                        return false if not proof_replay_owner_work_charge(sview_len(name), source_work) or not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
                        if name == wanted_name:
                            return false if matches != 0
                            matches <- matches + 1
                            found <- expression
                Ast::Expr.Move(operand, position):
                    if wanted_kind == "resource-move-inventory":
                        moved_root: (complete: bool, name: sview, position: Ast::Pos) = proof_replay_resource_return_place_root_with_work(operand, source_work, depth + 1)
                        return false if not moved_root.complete
                        # An empty requested name means inventory every named move in this
                        # owner, including moves of locals. The old parameter-by-parameter
                        # census left local moves out of the reverse coverage check.
                        if moved_root.name != "" and (wanted_name == "" or moved_root.name == wanted_name):
                            return false if not proof_replay_owner_work_charge(sview_len(moved_root.name), source_work)
                            return false if wanted_name != "" and not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
                            matches <- matches + 1
                    elif wanted_kind == "resource-move" and position.offset == offset.u32():
                        moved_root: (complete: bool, name: sview, position: Ast::Pos) = proof_replay_resource_return_place_root_with_work(operand, source_work, depth + 1)
                        return false if not moved_root.complete or not proof_replay_owner_work_charge(sview_len(moved_root.name), source_work) or not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
                        return false if moved_root.name != wanted_name
                        return false if matches != 0
                        matches <- matches + 1
                        found <- operand
                    return proof_replay_resource_event_find_expression_with_work(operand, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(callee, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    for argument in arguments |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(argument, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    return false if candidates.count != 1
                    for capture in candidates[0].captures |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(capture, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    for argument in arguments |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(argument, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_replay_resource_event_find_expression_with_work(inner, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(base, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return proof_replay_resource_event_find_expression_with_work(predicate, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.RegionNew(operand, region, position):
                    if wanted_kind == "resource-region-alloc-discard" and position.offset == offset.u32():
                        return false if not proof_replay_owner_work_charge(sview_len(region), source_work) or not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
                        if region == wanted_name:
                            return false if matches != 0
                            matches <- matches + 1
                            found <- expression
                    return proof_replay_resource_event_find_expression_with_work(operand, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(left, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return proof_replay_resource_event_find_expression_with_work(right, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(object, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    for argument in arguments |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(argument, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Array(arguments, _) | Ast::Expr.Tuple(arguments, _) | Ast::Expr.SetLit(arguments, _):
                    for argument in arguments |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(argument, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(object, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return false if not proof_replay_resource_event_find_expression_with_work(low, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return proof_replay_resource_event_find_expression_with_work(high, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(entry.key, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                        return false if not proof_replay_resource_event_find_expression_with_work(entry.value, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(field.value, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(base, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    for field in fields |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(field.value, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(condition, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return false if not proof_replay_resource_event_find_expression_with_work(yes, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return proof_replay_resource_event_find_expression_with_work(no, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(iterable, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return false if not proof_replay_resource_event_find_expression_with_work(condition, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return proof_replay_resource_event_find_expression_with_work(body, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _) | Ast::Expr.Catch(scrutinee, arms, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(scrutinee, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    for arm in arms |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                        return false if not proof_replay_resource_event_find_expression_with_work(arm.guard, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                        return false if not proof_replay_resource_event_find_statements_with_work(arm.body, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_resource_event_find_expression_with_work(guarded, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return proof_replay_resource_event_find_statements_with_work(recovery, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    return proof_replay_resource_event_find_statements_with_work(body, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_resource_event_find_statements_with_work(statements, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    return proof_replay_resource_event_find_expression_with_work(value, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Invalid:
                    return false
                _:
                    return false
            true

        def proof_replay_resource_event_find_statements_with_work(body: darray[Ast::Stmt]&, offset: usize, wanted_kind: sview, wanted_name: sview, matches: mutable usize&, found: mutable Ast::Expr&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for statement in body |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, initializer, position):
                        if wanted_kind == "resource-bind-name-inventory" or wanted_kind == "resource-bind-nested-inventory" and depth > 0:
                            return false if not proof_replay_owner_work_charge(sview_len(name), source_work) or not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
                            if name == wanted_name:
                                matches <- matches + 1
                                found <- type_expression
                        if wanted_kind == "resource-bind-inventory" and position.end_offset == offset.u32():
                            return false if not proof_replay_owner_work_charge(sview_len(name), source_work) or not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
                            if name == wanted_name:
                                return false if matches != 0
                                matches <- matches + 1
                                found <- type_expression
                        return false if not proof_replay_resource_event_find_expression_with_work(type_expression, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                        return false if not proof_replay_resource_event_find_expression_with_work(initializer, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    Ast::Stmt.Expr(expression, _):
                        if wanted_kind == "resource-region-alloc-discard-inventory":
                            match expression:
                                Ast::Expr.RegionNew(_, _, position):
                                    return false if position.offset == 0 or position.offset > 4294967295
                                    matches <- matches + 1
                                _:
                                    stripped: (complete: bool, expression: Ast::Expr) = proof_replay_resource_write_strip_parens_with_work(expression, source_work, 0)
                                    return false if stripped.complete and stripped.expression is Ast::Expr.RegionNew
                        return false if not proof_replay_resource_event_find_expression_with_work(expression, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    Ast::Stmt.Return(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_resource_event_find_expression_with_work(expression, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if not proof_replay_resource_event_find_expression_with_work(target, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                        return false if not proof_replay_resource_event_find_expression_with_work(value, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if not proof_replay_resource_event_find_expression_with_work(condition, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                        return false if not proof_replay_resource_event_find_statements_with_work(yes, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                        return false if not proof_replay_resource_event_find_statements_with_work(no, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    Ast::Stmt.While(condition, nested, _) | Ast::Stmt.For(_, _, condition, nested, _):
                        match statement:
                            Ast::Stmt.For(_, variables, iterable, _, _):
                                if wanted_kind == "resource-bind-loop-inventory":
                                    iterable_position: Ast::Pos = Ast::expr_pos(iterable)
                                    if iterable_position.end_offset == offset.u32():
                                        for variable in variables |variable, wanted_name, matches, found, source_work|:
                                            return false if not proof_replay_owner_work_charge(sview_len(variable), source_work) or not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
                                            if variable == wanted_name:
                                                matches <- matches + 1
                                                found <- iterable
                            _:
                                pass
                        return false if not proof_replay_resource_event_find_expression_with_work(condition, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                        return false if not proof_replay_resource_event_find_statements_with_work(nested, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return false if not proof_replay_resource_event_find_expression_with_work(scrutinee, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                        for arm in arms |offset, wanted_kind, wanted_name, matches, found, source_work, depth|:
                            return false if not proof_replay_resource_event_find_expression_with_work(arm.guard, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                            return false if not proof_replay_resource_event_find_statements_with_work(arm.body, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_resource_event_find_statements_with_work(nested, offset, wanted_kind, wanted_name, matches, found, source_work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        return false
                    _:
                        return false
            true

        def proof_replay_resource_moves_covered_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, body: darray[Ast::Stmt]&, source_work: mutable usize&) -> bool:
            source_moves: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, 0, "resource-move-inventory", "", source_moves, found, source_work, 0)
            all_recorded: (complete: bool, count: usize) = proof_replay_resource_event_kind_count_in_root_with_work(report, root, "resource-move", "", source_work)
            all_recorded.complete and all_recorded.count == source_moves

        def proof_replay_resource_discard_allocations_covered_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, body: darray[Ast::Stmt]&, source_work: mutable usize&) -> bool:
            source_allocations: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, 0, "resource-region-alloc-discard-inventory", "", source_allocations, found, source_work, 0)
            recorded: (complete: bool, count: usize) = proof_replay_resource_event_kind_count_in_root_with_work(report, root, "resource-region-alloc-discard", "", source_work)
            recorded.complete and recorded.count == source_allocations

        def proof_replay_resource_use_or_move_source_valid_with_work(report: ProofReport&, event: ElisaProofKernelCore::ProofKernelNode, owner: sview, owner_line: u32, owner_offset: usize, owner_module: sview, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if event.kind != "resource-use" and event.kind != "resource-move"
            return false if event.value <= 0 or event.value > 4294967295 or event.auxiliary == 0 or owner == "" or owner_line == 0 or owner_offset > 4294967295
            return false if not proof_replay_deterministic_call_declaration_index_ensure(report, source_work, &cache.deterministic_calls)
            caller: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.deterministic_calls.declaration_index, owner, owner_line, owner_offset, source_work)
            return false if not caller.complete or caller.matches != 1 or caller.row >= cache.deterministic_calls.declaration_index.entries.count
            entry: ProofReplayDeterministicDeclarationEntry = cache.deterministic_calls.declaration_index.entries[caller.row]
            return false if entry.owner != owner_module
            body: darray[Ast::Stmt] = []
            match entry.declaration:
                Ast::Decl.Func(_, _, _, declared_body, _, _, _):
                    body <- declared_body
                _:
                    return false
            # Lexical binding identity is reconstructed by the owner-wide source walk below
            # in resource_binding_identity_validation. Do not collapse distinct binders by
            # spelling here: same-name locals and formal shadowing are valid when the walk
            # attaches each operation to the declaration active at that source position.
            matches: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, event.value.usize(), event.kind, event.name, matches, found, source_work, 0)
            return false if matches != 1 or found is Ast::Expr.Invalid
            proof_replay_ast_matches_kernel_with_work(report, found, event.left, source_work, 0)

        def proof_replay_resource_binding_iterable_is_range_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_replay_resource_binding_iterable_is_range_with_work(inner, source_work, depth + 1)
                Ast::Expr.Binary(_, operator, _, _):
                    operator in {TokenKind.RangeLt, TokenKind.RangeLe, TokenKind.RangeGt}
                _:
                    false

        # Body-local value binds are admitted only when the event names one exact parser
        # declaration at this source position. Reference binds need a separate source bridge.
        def proof_replay_resource_local_value_bind_source_valid_with_work(report: ProofReport&, event: ElisaProofKernelCore::ProofKernelNode, owner: sview, owner_line: u32, owner_offset: usize, owner_module: sview, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if not proof_replay_owner_work_charge(sview_len(event.kind), source_work) or not proof_replay_owner_work_charge(sview_len(event.operator), source_work) or not proof_replay_owner_work_charge(sview_len(event.name), source_work) or not proof_replay_owner_work_charge(sview_len(event.secondary_name), source_work) or not proof_replay_owner_work_charge(sview_len(owner), source_work) or not proof_replay_owner_work_charge(sview_len(owner_module), source_work)
            return false if event.kind != "resource-bind" or event.operator != "value" or event.name == "" or event.secondary_name != "" or event.left != 0 or event.auxiliary != 0 or event.value <= 0 or event.value > 4294967295 or owner == "" or owner_line == 0 or owner_offset > 4294967295
            return false if not proof_replay_deterministic_call_declaration_index_ensure(report, source_work, &cache.deterministic_calls)
            caller: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.deterministic_calls.declaration_index, owner, owner_line, owner_offset, source_work)
            return false if not caller.complete or caller.matches != 1 or caller.row >= cache.deterministic_calls.declaration_index.entries.count
            entry: ProofReplayDeterministicDeclarationEntry = cache.deterministic_calls.declaration_index.entries[caller.row]
            return false if not proof_replay_owner_work_charge(sview_len(entry.owner), source_work) or not proof_replay_owner_work_charge(sview_len(owner_module), source_work)
            return false if entry.owner != owner_module
            body: darray[Ast::Stmt] = []
            match entry.declaration:
                Ast::Decl.Func(_, _, _, declared_body, _, _, _):
                    body <- declared_body
                _:
                    return false
            matches: mutable usize = 0
            source_type: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, event.value.usize(), "resource-bind-inventory", event.name, matches, source_type, source_work, 0)
            if matches == 0:
                loop_matches: mutable usize = 0
                loop_iterable: mutable Ast::Expr = Ast::Expr.Invalid
                return false if not proof_replay_resource_event_find_statements_with_work(body, event.value.usize(), "resource-bind-loop-inventory", event.name, loop_matches, loop_iterable, source_work, 0)
                return false if loop_matches != 1 or loop_iterable is Ast::Expr.Invalid
                return false if not proof_replay_resource_binding_iterable_is_range_with_work(loop_iterable, source_work, 0)
                return true
            return false if matches != 1 or source_type is Ast::Expr.Invalid
            markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(source_type, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, owner_line, owner_offset.u32(), report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &source_work)
            markers.complete and not markers.reference and not markers.mutable_reference and not markers.is_mutable

        def proof_replay_resource_discard_event_position_count_with_work(report: ProofReport&, root: usize, offset: usize, source_work: mutable usize&, depth: usize) -> (complete: bool, count: usize):
            return (false, 0) if depth >= PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT or root >= report.analysis_1.kernel.nodes.count or not proof_replay_owner_work_charge(1, source_work)
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[root]
            return (false, 0) if node.children_start > report.analysis_1.kernel.children.count or node.children_count > report.analysis_1.kernel.children.count - node.children_start
            return (true, 0) if node.kind == "resource-disjoint"
            return (true, 1 if node.kind == "resource-region-alloc-discard" and node.value == offset.i64() else 0) if node.kind not in {"resource-safety", "resource-scope", "resource-alternatives"}
            count: mutable usize = 0
            for index in 0..<node.children_count |index, report, node, offset, source_work, depth, count|:
                return (false, 0) if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[node.children_start + index]
                nested: (complete: bool, count: usize) = proof_replay_resource_discard_event_position_count_with_work(report, child, offset, source_work, depth + 1)
                return (false, 0) if not nested.complete or count > report.analysis_1.kernel.nodes.count or nested.count > report.analysis_1.kernel.nodes.count - count
                count <- count + nested.count
            (true, count)

        def proof_replay_resource_discard_allocation_source_valid_with_work(report: ProofReport&, resource_root: usize, event: ElisaProofKernelCore::ProofKernelNode, owner: sview, owner_line: u32, owner_offset: usize, owner_module: sview, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if event.kind != "resource-region-alloc-discard" or event.value <= 0 or event.value > 4294967295 or event.name != "" or event.secondary_name == "" or owner == "" or owner_line == 0 or owner_offset > 4294967295
            positioned_events: (complete: bool, count: usize) = proof_replay_resource_discard_event_position_count_with_work(report, resource_root, event.value.usize(), source_work, 0)
            return false if not positioned_events.complete or positioned_events.count != 1
            return false if not proof_replay_deterministic_call_declaration_index_ensure(report, source_work, &cache.deterministic_calls)
            caller: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.deterministic_calls.declaration_index, owner, owner_line, owner_offset, source_work)
            return false if not caller.complete or caller.matches != 1 or caller.row >= cache.deterministic_calls.declaration_index.entries.count
            entry: ProofReplayDeterministicDeclarationEntry = cache.deterministic_calls.declaration_index.entries[caller.row]
            return false if entry.owner != owner_module
            body: darray[Ast::Stmt] = []
            match entry.declaration:
                Ast::Decl.Func(_, _, _, declared_body, _, _, _):
                    body <- declared_body
                _:
                    return false
            matches: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, event.value.usize(), event.kind, event.secondary_name, matches, found, source_work, 0)
            return false if matches != 1
            operand: Ast::Expr = Ast::Expr.Invalid
            source_region: mutable sview = ""
            match found:
                Ast::Expr.RegionNew(source_operand, source_region_name, _):
                    operand <- source_operand
                    source_region <- source_region_name
                _:
                    return false
            return false if source_region != event.secondary_name or event.left >= report.analysis_1.kernel.nodes.count
            proof_replay_ast_matches_kernel_with_work(report, operand, event.left, source_work, 0)
