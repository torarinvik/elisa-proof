extend ElisaProof:
    private:
        # Return the region label carried by the unique assignment event at one source offset.
        # The owner census uses this to bind that serialized label to parser-derived region
        # metadata rather than trusting it as an unrelated event field.
        def proof_replay_resource_region_assignment_event_label_with_work(report: ProofReport&, root: usize, offset: usize, name: sview, source_work: mutable usize&, depth: usize) -> (complete: bool, count: usize, region: sview):
            return (false, 0, "") if depth >= PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT or root >= report.analysis_1.kernel.nodes.count or not proof_replay_owner_work_charge(1, source_work)
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[root]
            return (false, 0, "") if node.children_start > report.analysis_1.kernel.children.count or node.children_count > report.analysis_1.kernel.children.count - node.children_start
            return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(node.kind), source_work)
            return (true, 0, "") if node.kind == "resource-disjoint"
            return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(node.kind), source_work)
            return (true, 0, "") if node.kind == "resource-call"
            return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(node.kind), source_work)
            # Call payloads contain a callee-owned resource root. Its assignments are
            # validated against that callee's source owner in the linked summary walk.
            return (true, 0, "") if node.kind == "resource-call-lend"
            is_container: mutable bool = false
            return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(node.kind), source_work)
            is_container <- node.kind == "resource-safety"
            if not is_container:
                return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(node.kind), source_work)
                is_container <- node.kind == "resource-scope"
            if not is_container:
                return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(node.kind), source_work)
                is_container <- node.kind == "resource-alternatives"
            if not is_container:
                return (false, 0, "") if node.children_count != 0 or node.children_start != 0
                is_assignment: mutable bool = false
                return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(node.kind), source_work)
                is_assignment <- node.kind == "resource-region-assign"
                if is_assignment:
                    return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(node.name), source_work) or not proof_replay_owner_work_charge(sview_len(name), source_work) or not proof_replay_owner_work_charge(sview_len(node.secondary_name), source_work)
                return (true, 1, node.secondary_name) if is_assignment and node.value == offset.i64() and node.name == name
                return (true, 0, "")
            count: mutable usize = 0
            region: mutable sview = ""
            for index in 0..<node.children_count |index, report, node, offset, name, source_work, depth, count, region|:
                return (false, 0, "") if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[node.children_start + index]
                found: (complete: bool, count: usize, region: sview) = proof_replay_resource_region_assignment_event_label_with_work(report, child, offset, name, source_work, depth + 1)
                return (false, 0, "") if not found.complete or found.count > report.analysis_1.kernel.nodes.count - count
                count <- count + found.count
                region <- found.region if found.count == 1
            (true, count, region)

        def proof_replay_resource_region_assignment_event_label_in_root_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, offset: usize, name: sview, source_work: mutable usize&) -> (complete: bool, count: usize, region: sview):
            return (false, 0, "") if not proof_replay_owner_work_charge(sview_len(root.kind), source_work)
            return (false, 0, "") if root.kind != "resource-safety" or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start
            count: mutable usize = 0
            region: mutable sview = ""
            for index in 0..<root.children_count |index, report, root, offset, name, source_work, count, region|:
                return (false, 0, "") if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[root.children_start + index]
                found: (complete: bool, count: usize, region: sview) = proof_replay_resource_region_assignment_event_label_with_work(report, child, offset, name, source_work, 1)
                return (false, 0, "") if not found.complete or count > report.analysis_1.kernel.nodes.count or found.count > report.analysis_1.kernel.nodes.count - count
                count <- count + found.count
                region <- found.region if found.count == 1
            (true, count, region)
