# Bounded scan for Stage1's final globally unique module-alias fallback.
extend ElisaProof:
    private:
        def proof_replay_type_bound_global_alias_lookup_with_work(report: ProofReport&, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, current_scope: mutable darray[sview]&, wanted: sview, alias_count: mutable usize&, concrete_count: mutable usize&, target: mutable Ast::Expr&, line: mutable u32&, offset: mutable usize&, owner: mutable darray[sview]&, opaque_classified: mutable bool&, opaque_policy: mutable i64&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |annotations, current_scope, wanted, alias_count, concrete_count, target, line, offset, owner, opaque_classified, opaque_policy, work, depth|:
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                match declaration:
                    Ast::Decl.Alias(name, alias_target, position):
                        return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work)
                        if name == wanted:
                            alias_count <- alias_count + 1
                            return false if alias_count > 1 or not proof_replay_type_bound_local_work_charge(current_scope.count, work)
                            target <- alias_target
                            line <- position.line
                            offset <- position.offset.usize()
                            owner.clear()
                            owner.extend(current_scope)
                    Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work)
                        concrete_count <- concrete_count + 1 if name == wanted
                    Ast::Decl.Module(name, nested, _):
                        nested_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(current_scope, name, work)
                        return false if not nested_scope.complete
                        saved_count: usize = current_scope.count
                        current_scope <- nested_scope.scope
                        return false if not proof_replay_type_bound_global_alias_lookup_with_work(report, nested, annotations, current_scope, wanted, alias_count, concrete_count, target, line, offset, owner, opaque_classified, opaque_policy, work, depth + 1)
                        current_scope.resize(saved_count)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_type_bound_global_alias_lookup_with_work(report, nested, annotations, current_scope, wanted, alias_count, concrete_count, target, line, offset, owner, opaque_classified, opaque_policy, work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Extern(name, _, arity, _, callable, return_type_name, _, position):
                        return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work)
                        if name == wanted:
                            return false if not proof_replay_type_bound_local_work_charge(sview_len(return_type_name), work)
                            take_opaque: mutable bool = false
                            if not opaque_classified and not callable and arity == 0 and return_type_name == "":
                                opaque: (complete: bool, opaque_alias: bool, policy: i64) = proof_replay_type_bound_call_opaque_extern_alias_with_work(report, name, arity, callable, return_type_name, position.offset.usize(), work)
                                return false if not opaque.complete
                                opaque_classified <- true
                                opaque_policy <- opaque.policy
                                take_opaque <- opaque.opaque_alias
                            elif opaque_classified and opaque_policy == 2 and not callable and arity == 0 and return_type_name == "":
                                take_opaque <- true
                            if take_opaque:
                                opaque_policy <- 0 if current_scope.count == 0
                                alias_count <- alias_count + 1
                                return false if alias_count > 1 or not proof_replay_type_bound_local_work_charge(current_scope.count, work)
                                target <- Ast::Expr.Invalid
                                line <- position.line
                                offset <- position.offset.usize()
                                owner.clear()
                                owner.extend(current_scope)
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            if depth == 0:
                for annotation in annotations |wanted, concrete_count, work|:
                    return false if not proof_replay_type_bound_local_work_charge(1, work)
                    return false if not proof_replay_type_bound_local_text_compare_charge(annotation.name, "__extern_resource", work)
                    if annotation.name == "__extern_resource":
                        return false if not proof_replay_type_bound_local_text_compare_charge(annotation.owner, wanted, work)
                        concrete_count <- concrete_count + 1 if annotation.owner == wanted
            return true
