# Producer bridge for source-bound frame events. Replay must independently bind
# these certificates to the original source before any report admission.
extend ElisaProof:
    private:
        def proof_record_direct_frame_events(report: mutable ProofReport&, declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            # Do not let a preceding unaccounted attempt join the first frame event.
            accounted: usize = 0 if report.obligation_inventory.count == 0 else report.obligation_inventory[report.obligation_inventory.count - 1].attempts_start + report.obligation_inventory[report.obligation_inventory.count - 1].attempts_count
            return false if accounted != report.goal_attempts.count or report.kernel.budget_exhausted
            lowered = ElisaProofFrameSource::lower_direct_events(declarations, name, line, tokens, source, source_length, &report.kernel.nodes, &report.kernel.children, ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET, ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET)
            return false if not lowered.known
            outcomes = ElisaProofFrameSource::direct_event_decisions(declarations, name, line, tokens, source, source_length, &report.kernel.nodes, &report.kernel.children, &lowered.roots)
            return false if not outcomes.known
            for index in 0..<outcomes.decisions.count |index, outcomes, report, name, line|:
                decision = outcomes.decisions[index]
                event = decision.event
                rule: sview = "frame-allow" if event.kind == "allow" else "frame-preserve" if event.kind == "preserve" else "frame-spec"
                mirror: Ast::Expr = Ast::Expr.BoolLit(true, event.position)
                certificate_index: usize = report.certificates.count
                report.goal_attempts.push(ProofGoalAttempt{goal: mirror, budget_exhausted: false, facts_start: report.certificate_facts.count, facts_count: 0, kernel_goal: decision.kernel_root, kernel_facts_start: report.kernel.certificate_facts.count, kernel_facts_count: 0, line: event.position.line, name: name, rule: rule, proven: decision.proven, has_certificate: decision.proven, certificate_index: certificate_index})
                if decision.proven:
                    report.certificates.push(ProofGoalCertificate{goal: mirror, facts_start: report.certificate_facts.count, facts_count: 0, kernel_goal: decision.kernel_root, kernel_facts_start: report.kernel.certificate_facts.count, kernel_facts_count: 0, line: event.position.line, name: name, rule: rule, replayed: false})
                report.proof_obligation_for_source(decision.proven, line, name, event.kind, index)
                if not decision.proven:
                    kind: sview = "frame-write-outside" if event.kind == "allow" else "frame-preserve-write" if event.kind == "preserve" else "kernel-certificate-invalid"
                    proof_add_latest_goal_finding(report, kind, event.position.line, name, "source-bound frame event did not replay")
            return true
