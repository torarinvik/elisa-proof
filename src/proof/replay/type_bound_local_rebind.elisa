# Synthetic unsigned rebind symbols may name either a loop self-update or the result of a
# source-local call initializer. Their bounds are justified by the exact source definition and
# the corresponding source type; an internal name by itself proves nothing.
extend ElisaProof:
    private:
        def proof_replay_type_bound_unsigned_rebind_target(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_type_bound_unsigned_rebind_target(inner, depth + 1)
                Ast::Expr.Binary(Ast::Expr.Ident(name, _), operator, _, _):
                    return name if operator == TokenKind.Plus or operator == TokenKind.Minus
                    return ""
                _:
                    return ""

        def proof_replay_type_bound_unsigned_rebind_fact(report: ProofReport&, trace: ProofFactTrace, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&) -> bool:
            symbol: mutable sview = ""
            symbol_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            width: mutable i64 = 0
            match trace.expression:
                Ast::Expr.Call(Ast::Expr.Ident(marker, _), arguments, argument_names, _):
                    return false if marker != "__elisa_unsigned_type_bound" or arguments.count != 2 or argument_names.count != 0
                    match arguments[0]:
                        Ast::Expr.Ident(name, position):
                            symbol <- name
                            symbol_position <- position
                        _:
                            return false
                    match arguments[1]:
                        Ast::Expr.IntLit(value, _):
                            width <- value
                        _:
                            return false
                _:
                    return false
            return false if not proof_internal_name_is_rebind(symbol) or width <= 0
            return false if symbol_position.line != trace.line
            binding_matches: mutable usize = 0
            target: mutable sview = ""
            for candidate in report.traces.records |trace, symbol, symbol_position, binding_matches, target, report|:
                continue if candidate.kind != "local-binding" or candidate.name != trace.name or candidate.line != trace.line
                match candidate.expression:
                    Ast::Expr.Binary(Ast::Expr.Ident(candidate_symbol, _), TokenKind.EqEq, value, _):
                        continue if candidate_symbol != symbol or not proof_replay_local_binding_pos_matches(candidate.expression, symbol_position)
                        binding_matches <- binding_matches + 1
                        return false if not proof_replay_local_binding_source_valid(report, candidate)
                        target <- proof_replay_type_bound_unsigned_rebind_target(value, 0)
                    _:
                        pass
            if binding_matches == 0:
                # Call results are stored under a fresh symbol, then linked to the declared
                # local by `local == symbol`. There is no `symbol == call(...)` proof fact to
                # trust. Recover that exact declaration/call from source, require its declared
                # local width to match, and independently resolve the call's return width.
                definition = proof_replay_result_symbol_definition(report, trace.name, symbol, symbol_position)
                return false if not definition.known
                return false if proof_unsigned_type_width(definition.local_type, report.source_declarations, 0) != width
                return false if not proof_replay_result_symbol_source_available(report, trace, symbol_position, definition.local, definition.call)
                marker_arguments: darray[Ast::Expr] = [definition.call, Ast::Expr.IntLit(width, symbol_position)]
                marker_names: darray[sview] = []
                marker: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("__elisa_unsigned_type_bound", symbol_position), marker_arguments, marker_names, symbol_position)
                return proof_replay_type_bound_call_result_fact(report, parameters, body, marker)
            return false if binding_matches != 1 or target == ""
            return false if any parameter in parameters where parameter.name == target
            typed_source_matches: mutable usize = 0
            for candidate in report.traces.records |report, trace, parameters, body, target, width, typed_source_matches|:
                continue if candidate.kind != "type-bound" or candidate.name != trace.name
                match candidate.expression:
                    Ast::Expr.Call(Ast::Expr.Ident(marker, _), arguments, argument_names, _):
                        continue if marker != "__elisa_unsigned_type_bound" or arguments.count != 2 or argument_names.count != 0
                        match arguments[0]:
                            Ast::Expr.Ident(name, _):
                                continue if name != target
                            _:
                                continue
                        match arguments[1]:
                            Ast::Expr.IntLit(candidate_width, _):
                                if candidate_width == width and proof_replay_type_bound_local_scalar_fact(report, parameters, body, candidate.expression, candidate.line):
                                    typed_source_matches <- typed_source_matches + 1
                            _:
                                pass
                    _:
                        pass
            return typed_source_matches == 1

        # The producer emits all three canonical facts for a narrow unsigned binding: its lower
        # bound, width marker, and upper bound. The marker is the source-backed witness; accept a
        # lower/upper row only when it is the exact canonical inequality for that unique marker.
        def proof_replay_type_bound_unsigned_rebind_range_fact(report: ProofReport&, trace: ProofFactTrace, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&) -> bool:
            symbol: mutable sview = ""
            symbol_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            is_lower: mutable bool = false
            upper_value: mutable i64 = -1
            if trace.expression is Ast::Expr.Binary(left, operator, right, expression_position):
                return false if operator != TokenKind.LtEq
                if left is Ast::Expr.IntLit(zero, zero_position):
                    return false if zero != 0
                    if right is Ast::Expr.Ident(name, position):
                        return false if not proof_replay_source_position_equal(zero_position, position) or not proof_replay_source_position_equal(expression_position, position)
                        symbol <- name
                        symbol_position <- position
                        is_lower <- true
                    else:
                        return false
                elif left is Ast::Expr.Ident(name, position):
                    if right is Ast::Expr.IntLit(bound, bound_position):
                        return false if not proof_replay_source_position_equal(bound_position, position) or not proof_replay_source_position_equal(expression_position, position)
                        symbol <- name
                        symbol_position <- position
                        upper_value <- bound
                    else:
                        return false
                else:
                    return false
            else:
                return false
            return false if not proof_internal_name_is_rebind(symbol) or symbol_position.line != trace.line
            marker_matches: mutable usize = 0
            marker_width: mutable i64 = 0
            for candidate in report.traces.records |candidate, report, trace, symbol, symbol_position, marker_matches, marker_width, parameters, body|:
                continue if candidate.kind != "type-bound" or candidate.name != trace.name or candidate.line != trace.line
                if candidate.expression is Ast::Expr.Call(callee, arguments, argument_names, _):
                    continue if arguments.count != 2 or argument_names.count != 0
                    if callee is Ast::Expr.Ident(marker_name, _):
                        continue if marker_name != "__elisa_unsigned_type_bound"
                    else:
                        continue
                    if arguments[0] is Ast::Expr.Ident(candidate_symbol, candidate_position):
                        continue if candidate_symbol != symbol or not proof_replay_source_position_equal(candidate_position, symbol_position)
                    else:
                        continue
                    width_value: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    continue if not width_value.known or width_value.value <= 0 or width_value.value >= PROOF_UNSIGNED_RANGE_BOUND_MAX_WIDTH
                    return false if marker_matches > 0 and marker_width != width_value.value
                    return false if not proof_replay_type_bound_unsigned_rebind_fact(report, candidate, parameters, body)
                    marker_width <- width_value.value
                    marker_matches <- marker_matches + 1
            return false if marker_matches == 0
            if is_lower:
                expected: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, symbol_position), TokenKind.LtEq, Ast::Expr.Ident(symbol, symbol_position), symbol_position)
                return proof_replay_expr_equal(trace.expression, expected)
            expected_upper: i64 = proof_unsigned_width_max(marker_width)
            return upper_value == expected_upper
