extend ElisaProofFrameSource:
    private:
        def value_scalar_type(expression: Ast::Expr, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64 or not replay_work_charge(1, work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if not replay_work_charge(sview_len(name), work)
                    return contract_primitive(name)
                Ast::Expr.Paren(inner, _):
                    return value_scalar_type(inner, depth + 1, work)
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Mutable and operator != TokenKind.Ampersand and operator != TokenKind.Lmut
                    return value_scalar_type(inner, depth + 1, work)
                _:
                    return false

        # Reconstruct absence of additional writes, never an arithmetic theorem.
        # Caller must independently exclude unknown operator implementations.
        def scalar_value(expression: Ast::Expr, formals: darray[sview]&, types: darray[Ast::Expr]&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64 or formals.count != types.count or not replay_work_charge(1, work)
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return false if not replay_work_charge(formals.count, work)
                    for index in 0..<formals.count |index, formals, types, name, work|:
                        return false if:
                            not replay_work_charge(sview_len(formals[index]), work)
                            not replay_work_charge(sview_len(name), work)
                        return value_scalar_type(types[index], 0, work) if formals[index] == name
                    return false
                Ast::Expr.Paren(inner, _):
                    return scalar_value(inner, formals, types, depth + 1, work)
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Not
                    return scalar_value(inner, formals, types, depth + 1, work)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or and operator != TokenKind.Ampersand and operator != TokenKind.Pipe and operator != TokenKind.Caret and operator != TokenKind.LShift and operator != TokenKind.RShift
                    return scalar_value(left, formals, types, depth + 1, work) and scalar_value(right, formals, types, depth + 1, work)
                _:
                    return false
