extend ElisaProof:
    private:
        def proof_replay_type_bound_generic_identity_hash(name: sview, declaration_line: u32, declaration_offset: usize, owner_module: sview) -> u32:
            hash: mutable u32 = proof_expr_shape_mix(proof_name_hash(name), declaration_line.i64())
            hash <- proof_expr_shape_mix(hash, declaration_offset.i64())
            proof_expr_shape_mix(hash, proof_name_hash(owner_module).i64())

        def proof_replay_type_bound_generic_identity_index_ensure(report: ProofReport&, cache: mutable ProofReplayDeterministicCallReplayCache&, work: mutable usize&) -> bool:
            identity: mutable ProofGenericDeclarationIdentityIndex& = &cache.generic_identity_index
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if identity.attempted and identity.report_identity == report_identity and identity.source_identity == source_identity:
                return identity.valid
            identity.hashes.clear()
            identity.rows.clear()
            identity.counts.clear()
            identity.entries <- 0
            identity.attempted <- true
            identity.valid <- false
            identity.report_identity <- report_identity
            identity.source_identity <- source_identity
            markers: mutable usize = 0
            for annotation_index in 0..<report.source.source_annotations.count |annotation_index, report, identity, markers, work|:
                annotation: Ast::EnumAnnotation = report.source.source_annotations[annotation_index]
                return false if:
                    not proof_replay_type_bound_local_work_charge(1, work)
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                if annotation.name == "__generic_param_identity" and annotation.line == 3900000131:
                    return false if:
                        not proof_replay_type_bound_local_work_charge(sview_len(annotation.owner), work)
                        not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                        not proof_replay_type_bound_local_work_charge(sview_len(annotation.module), work)
                    markers <- markers + 1
            return false if markers > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT / 2
            capacity: usize = proof_name_index_capacity(markers)
            return false if markers > 0 and capacity == 0
            return false if:
                not proof_replay_type_bound_local_work_charge(capacity, work)
                not proof_replay_type_bound_local_work_charge(capacity, work)
                not proof_replay_type_bound_local_work_charge(capacity, work)
                not proof_replay_type_bound_local_work_charge(capacity, work)
                not proof_replay_type_bound_local_work_charge(capacity, work)
                not proof_replay_type_bound_local_work_charge(markers, work)
            identity.hashes.resize(capacity)
            identity.rows.resize(capacity)
            identity.counts.resize(capacity)
            annotation_count: usize = report.source.source_annotations.count
            for slot in 0..<capacity |slot, identity, annotation_count|:
                identity.rows[slot] <- annotation_count
                identity.counts[slot] <- 0
            for annotation_index in 0..<annotation_count |annotation_index, report, identity, markers, capacity, work|:
                annotation: Ast::EnumAnnotation = report.source.source_annotations[annotation_index]
                return false if:
                    not proof_replay_type_bound_local_work_charge(1, work)
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                continue if annotation.name != "__generic_param_identity" or annotation.line != 3900000131
                return false if:
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.owner), work)
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.module), work)
                hash: u32 = proof_replay_type_bound_generic_identity_hash(annotation.owner, annotation.detail_line, annotation.offset.usize(), annotation.module)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, annotation_index, annotation, identity, markers, capacity, annotation_count, hash, report, work, placed|:
                    return false if not proof_replay_type_bound_local_work_charge(1, work)
                    current: usize = identity.rows[slot]
                    if current == annotation_count:
                        identity.hashes[slot] <- hash
                        identity.rows[slot] <- annotation_index
                        identity.counts[slot] <- 1
                        placed <- true
                        break
                    return false if current >= annotation_count
                    prior: Ast::EnumAnnotation = report.source.source_annotations[current]
                    return false if:
                        not proof_replay_type_bound_local_work_charge(sview_len(prior.owner), work)
                        not proof_replay_type_bound_local_work_charge(sview_len(prior.module), work)
                        not proof_replay_type_bound_local_work_charge(sview_len(annotation.owner), work)
                        not proof_replay_type_bound_local_work_charge(sview_len(annotation.module), work)
                    if identity.hashes[slot] == hash and prior.owner == annotation.owner and prior.detail_line == annotation.detail_line and prior.offset == annotation.offset and prior.module == annotation.module:
                        identity.counts[slot] <- identity.counts[slot] + 1
                        placed <- true
                        break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            identity.entries <- markers
            cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(identity.rows, annotation_count, work)
            identity.valid <- cluster.complete and cluster.bounded and work <= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            return identity.valid

        def proof_replay_type_bound_enum_generic_identity_shadowed_with_work(report: ProofReport&, declaration_line: u32, declaration_offset: usize, owner_module: sview, wanted: sview, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return true if declaration_line == 0 or not proof_replay_type_bound_generic_identity_index_ensure(report, cache, work)
            identity: ProofGenericDeclarationIdentityIndex& = cache.generic_identity_index
            return true if not identity.valid or identity.hashes.count != identity.rows.count or identity.hashes.count != identity.counts.count
            markers: usize = identity.entries
            return true if markers > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT / 2
            expected_capacity: usize = proof_name_index_capacity(markers)
            return true if identity.rows.count != expected_capacity
            return false if markers == 0
            return true if:
                not proof_replay_type_bound_local_work_charge(sview_len(wanted), work)
                not proof_replay_type_bound_local_work_charge(sview_len(owner_module), work)
            wanted_hash: u32 = proof_replay_type_bound_generic_identity_hash(wanted, declaration_line, declaration_offset, owner_module)
            slot: mutable usize = (wanted_hash.i64() % identity.rows.count.i64()).usize()
            probes: mutable usize = 0
            while probes < identity.rows.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, declaration_line, declaration_offset, owner_module, report, identity, work|:
                return true if not proof_replay_type_bound_local_work_charge(1, work)
                current: usize = identity.rows[slot]
                return false if current == report.source.source_annotations.count
                return true if current >= report.source.source_annotations.count
                annotation: Ast::EnumAnnotation = report.source.source_annotations[current]
                if identity.hashes[slot] == wanted_hash:
                    return true if:
                        not proof_replay_type_bound_local_work_charge(sview_len(annotation.owner), work)
                        not proof_replay_type_bound_local_work_charge(sview_len(annotation.module), work)
                    if annotation.owner == wanted and annotation.detail_line == declaration_line and annotation.offset.usize() == declaration_offset and annotation.module == owner_module:
                        return identity.counts[slot] > 0
                slot <- (slot + 1) % identity.rows.count
                probes <- probes + 1
            return true
