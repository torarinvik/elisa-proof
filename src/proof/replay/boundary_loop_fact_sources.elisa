extend ElisaProof:
    private:
        def proof_replay_control_find_loop_source(statements: darray[Ast::Stmt]&, line: u32, condition: mutable Ast::Expr&, loop_body: mutable darray[Ast::Stmt]&, lexical_body: mutable darray[Ast::Stmt]&, loop_position: mutable Ast::Pos&, matches: mutable usize&, depth: usize, work: mutable usize&, work_limit: usize, include_for: bool) -> bool:
            return false if depth >= 64
            for statement in statements |statements, line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                return false if work >= work_limit
                work <- work + 1
                match statement:
                    Ast::Stmt.While(source_condition, inner, position):
                        if position.line == line:
                            matches <- matches + 1
                            condition <- source_condition
                            if inner.count > work_limit - work:
                                work <- work_limit
                                return false
                            work <- work + inner.count
                            if statements.count > work_limit - work:
                                work <- work_limit
                                return false
                            work <- work + statements.count
                            loop_body.clear()
                            loop_body.extend(inner)
                            lexical_body.clear()
                            lexical_body.extend(statements)
                            loop_position <- position
                        return false if:
                            not proof_replay_control_find_loop_source_expr(source_condition, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                            not proof_replay_control_find_loop_source(inner, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    Ast::Stmt.For(_, _, iterable, inner, position):
                        if position.line == line and include_for:
                            matches <- matches + 1
                            condition <- iterable
                            if inner.count > work_limit - work:
                                work <- work_limit
                                return false
                            work <- work + inner.count
                            if statements.count > work_limit - work:
                                work <- work_limit
                                return false
                            work <- work + statements.count
                            loop_body.clear()
                            loop_body.extend(inner)
                            lexical_body.clear()
                            lexical_body.extend(statements)
                            loop_position <- position
                        return false if:
                            not proof_replay_control_find_loop_source_expr(iterable, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                            not proof_replay_control_find_loop_source(inner, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    Ast::Stmt.Block(kind, _, _, inner, _):
                        return false if kind != "assert_by" and not proof_replay_control_find_loop_source(inner, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    Ast::Stmt.If(test, yes, no, _):
                        return false if:
                            not proof_replay_control_find_loop_source_expr(test, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                            not proof_replay_control_find_loop_source(yes, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                            not proof_replay_control_find_loop_source(no, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    Ast::Stmt.Match(subject, arms, _):
                        return false if not proof_replay_control_find_loop_source_expr(subject, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                        for arm in arms |statements, line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                            return false if work >= work_limit
                            work <- work + 1
                            return false if:
                                not proof_replay_control_find_loop_source_expr(arm.guard, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                                not proof_replay_control_find_loop_source(arm.body, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_control_find_loop_source_expr(expression, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    Ast::Stmt.VarDecl(_, type_expression, initializer, _):
                        return false if:
                            not proof_replay_control_find_loop_source_expr(type_expression, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                            not proof_replay_control_find_loop_source_expr(initializer, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if:
                            not proof_replay_control_find_loop_source_expr(target, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                            not proof_replay_control_find_loop_source_expr(value, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_control_find_loop_source_expr(expression: Ast::Expr, line: u32, condition: mutable Ast::Expr&, loop_body: mutable darray[Ast::Stmt]&, lexical_body: mutable darray[Ast::Stmt]&, loop_position: mutable Ast::Pos&, matches: mutable usize&, depth: usize, work: mutable usize&, work_limit: usize, include_for: bool) -> bool:
            return false if depth >= 64 or work >= work_limit
            work <- work + 1
            match expression:
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_control_find_loop_source_expr(callee, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    for argument in arguments |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if not proof_replay_control_find_loop_source_expr(argument, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if work >= work_limit
                        work <- work + 1
                        for capture in candidate.captures |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                            return false if not proof_replay_control_find_loop_source_expr(capture, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    for argument in arguments |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if not proof_replay_control_find_loop_source_expr(argument, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_control_find_loop_source_expr(object, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return false if not proof_replay_control_find_loop_source_expr(object, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    return proof_replay_control_find_loop_source_expr(index, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return false if:
                        not proof_replay_control_find_loop_source_expr(object, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                        not proof_replay_control_find_loop_source_expr(low, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    return proof_replay_control_find_loop_source_expr(high, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_control_find_loop_source_expr(object, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    for argument in arguments |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if not proof_replay_control_find_loop_source_expr(argument, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if not proof_replay_control_find_loop_source_expr(element, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if:
                            not proof_replay_control_find_loop_source_expr(entry.key, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                            not proof_replay_control_find_loop_source_expr(entry.value, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_control_find_loop_source_expr(base, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    for field in fields |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if not proof_replay_control_find_loop_source_expr(field.value, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return false if not proof_replay_control_find_loop_source_expr(subject, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    for arm in arms |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if work >= work_limit
                        work <- work + 1
                        return false if:
                            not proof_replay_control_find_loop_source_expr(arm.guard, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                            not proof_replay_control_find_loop_source(arm.body, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Comprehension(_, iterable, comprehension_condition, value, _):
                    return false if:
                        not proof_replay_control_find_loop_source_expr(iterable, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                        not proof_replay_control_find_loop_source_expr(comprehension_condition, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    return proof_replay_control_find_loop_source_expr(value, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_control_find_loop_source_expr(guarded, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    return proof_replay_control_find_loop_source(recovery, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Lambda(parameters, nested, _):
                    for parameter in parameters |line, condition, loop_body, lexical_body, loop_position, matches, depth, work, work_limit, include_for|:
                        return false if work >= work_limit
                        work <- work + 1
                    return proof_replay_control_find_loop_source(nested, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                Ast::Expr.Block(block_statements, value, _, _):
                    return false if not proof_replay_control_find_loop_source(block_statements, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                    return proof_replay_control_find_loop_source_expr(value, line, condition, loop_body, lexical_body, loop_position, matches, depth + 1, work, work_limit, include_for)
                _:
                    return false
            return true

        def proof_replay_control_loop_invariant_context(report: ProofReport&, trace: ProofFactTrace, whole_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt], lexical_body: darray[Ast::Stmt]) -> bool:
            work: mutable usize = 0
            proof_replay_control_loop_invariant_context_with_work(report, trace, whole_body, loop_body, lexical_body, &work)

        def proof_replay_control_loop_invariant_context_with_work(report: ProofReport&, trace: ProofFactTrace, whole_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt], lexical_body: darray[Ast::Stmt], source_work: mutable usize&) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                certificate.name != trace.name
                not proof_replay_control_assertion_in_scope_with_work(report, whole_body, whole_body, certificate, source_work)
            return true if proof_replay_control_assertion_in_scope_with_work(report, whole_body, loop_body, certificate, source_work)
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            remaining_work: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            no_break_work: mutable usize = 0
            has_break: bool = proof_replay_control_body_has_break(loop_body, 0, 0, &no_break_work, remaining_work)
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT or no_break_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + no_break_work
            return false if has_break
            proof_replay_control_assertion_after_loop_with_work(report, whole_body, lexical_body, certificate, trace.line, source_work)

        def proof_replay_control_certificate_has_invariant(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate) -> bool:
            work: mutable usize = 0
            proof_replay_control_certificate_has_invariant_with_work(report, trace, certificate, &work)

        def proof_replay_control_certificate_has_invariant_with_work(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, source_work: mutable usize&) -> bool:
            return false if certificate.facts_start > report.analysis_1.traces.origin_indices.count or certificate.facts_count > report.analysis_1.traces.origin_indices.count - certificate.facts_start
            for index in 0..<certificate.facts_count |index, report, trace, certificate, source_work|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                origin: usize = report.analysis_1.traces.origin_indices[certificate.facts_start + index]
                continue if origin >= report.analysis_1.traces.records.count
                candidate: ProofFactTrace = report.analysis_1.traces.records[origin]
                continue if candidate.kind != "loop-invariant" or candidate.name != trace.name or candidate.line != trace.line
                return true if proof_replay_control_expr_source_equal_with_work(candidate.expression, trace.expression, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
            return false

        # The body-entry condition/range facts are consumed by the loop's preservation
        # obligation itself. That obligation is anchored to the exact source invariant and
        # carries the matching invariant hypothesis; ordinary consumers still need an assert.
        def proof_replay_control_preservation_contract_source(report: ProofReport&, trace: ProofFactTrace, loop_body: darray[Ast::Stmt]) -> bool:
            work: mutable usize = 0
            return proof_replay_control_preservation_contract_source_with_work(report, trace, loop_body, &work)

        def proof_replay_control_preservation_contract_source_with_work(report: ProofReport&, trace: ProofFactTrace, loop_body: darray[Ast::Stmt], source_work: mutable usize&) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                certificate.source_phase != "loop-invariant-preservation" or certificate.name != trace.name or certificate.line != trace.line
                source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
                not proof_replay_control_certificate_attempt_unique_with_work(report, certificate, source_work)
            matches: mutable usize = 0
            for statement in loop_body |report, trace, certificate, matches, source_work|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Contract("invariant", invariant, _):
                        if proof_replay_control_expr_source_equal_with_work(invariant, certificate.goal, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_control_stable_expression(report, trace, invariant, source_work):
                            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            invariant_trace: ProofFactTrace = ProofFactTrace{expression: invariant, kernel_expression: trace.kernel_expression, kind: "loop-invariant", line: trace.line, name: trace.name, dependency: "", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 0}
                            if proof_replay_control_certificate_has_invariant_with_work(report, invariant_trace, certificate, source_work):
                                matches <- matches + 1
                    _:
                        pass
            matches == 1

        # A preservation certificate may consume its exact invariant as an induction hypothesis,
        # but only after the corresponding entry certificate is independently replayed.
        def proof_replay_control_loop_invariant_induction_premise(report: mutable ProofReport&, trace: ProofFactTrace, source_invariant: Ast::Expr, owner_body: darray[Ast::Stmt], lexical_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt]) -> bool can[Global.Read, Global.Write]:
            work: mutable usize = 0
            workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            return (proof_replay_control_loop_invariant_induction_premise_with_workspace(report, trace, source_invariant, owner_body, lexical_body, loop_body, &work, &workspace) can Global{Read,Write})

        def proof_replay_control_loop_invariant_induction_premise_with_workspace(report: mutable ProofReport&, trace: ProofFactTrace, source_invariant: Ast::Expr, owner_body: darray[Ast::Stmt], lexical_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt], source_work: mutable usize&, workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool can[Global.Read, Global.Write]:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                certificate.source_phase != "loop-invariant-preservation" or certificate.name != trace.name or certificate.line != trace.line
                not proof_replay_control_expr_source_equal_with_work(certificate.goal, source_invariant, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                not proof_replay_control_certificate_has_invariant_with_work(report, trace, certificate, source_work)
            entry_matches: mutable usize = 0
            entry_index: mutable usize = report.analysis_1.certificates.count
            for index in 0..<report.analysis_1.certificates.count |report, trace, owner_body, lexical_body, loop_body, index, entry_matches, entry_index, source_work|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                candidate: ProofGoalCertificate = report.analysis_1.certificates[index]
                if candidate.source_phase == "loop-invariant-entry" and proof_replay_control_loop_entry_certificate_with_work(report, trace, candidate, index, owner_body, lexical_body, loop_body, source_work):
                    entry_matches <- entry_matches + 1
                    entry_index <- index
            return false if entry_matches != 1
            entry: ProofGoalCertificate = report.analysis_1.certificates[entry_index]
            return (proof_replay_certificate(report, entry, entry_index, workspace) can Global{Read,Write})

        def proof_replay_control_loop_invariant_source(report: mutable ProofReport&, trace: ProofFactTrace) -> bool can[Global.Read, Global.Write]:
            work: mutable usize = 0
            return (proof_replay_control_loop_invariant_source_with_work(report, trace, &work) can Global{Read,Write})

        def proof_replay_control_loop_invariant_source_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            return (proof_replay_control_loop_invariant_source_with_workspace(report, trace, source_work, &workspace) can Global{Read,Write})

        def proof_replay_control_loop_invariant_source_with_workspace(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&, workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool can[Global.Read, Global.Write]:
            return false if trace.name == "" or trace.line == 0 or report.analysis_2.replay_owner_line == 0 or report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &body, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            loop_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            return false if:
                not proof_replay_loop_scope_with_limit(body, trace.line, &condition, &loop_body, &lexical_body, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            invariant_matches: mutable usize = 0
            source_invariant: mutable Ast::Expr = Ast::Expr.Invalid
            for statement in loop_body |report, trace, invariant_matches, source_invariant, source_work|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Contract("invariant", expression, _):
                        if proof_replay_control_expr_source_equal_with_work(expression, trace.expression, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_control_stable_expression(report, trace, expression, source_work):
                            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            invariant_matches <- invariant_matches + 1
                            source_invariant <- expression
                    _:
                        pass
            return false if invariant_matches != 1
            # During replay of the preservation certificate, this exact contract is the
            # induction hypothesis. The outer admission path still has to replay entry and
            # preservation independently before using it anywhere else.
            if proof_replay_control_loop_invariant_induction_premise_with_workspace(report, trace, source_invariant, body, lexical_body, loop_body, source_work, workspace) can Global{Read,Write}:
                return true
            return false if not proof_replay_control_loop_invariant_context_with_work(report, trace, body, loop_body, lexical_body, source_work)
            entry_matches: mutable usize = 0
            preservation_matches: mutable usize = 0
            entry_certificates: darray[usize] = []
            preservation_certificates: darray[usize] = []
            for index in 0..<report.analysis_1.certificates.count |report, trace, body, source_invariant, index, entry_matches, preservation_matches, entry_certificates, preservation_certificates, source_work|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                candidate: ProofGoalCertificate = report.analysis_1.certificates[index]
                continue if candidate.name != trace.name or candidate.line != trace.line
                if candidate.source_phase == "loop-invariant-entry" and proof_replay_control_loop_entry_certificate_with_work(report, trace, candidate, index, body, lexical_body, loop_body, source_work):
                    entry_matches <- entry_matches + 1
                    entry_certificates.push(index)
                if candidate.source_phase == "loop-invariant-preservation" and proof_replay_control_certificate_attempt_index_unique_with_work(report, candidate, index, source_work) and proof_replay_control_expr_source_equal_with_work(candidate.goal, source_invariant, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_control_certificate_has_invariant_with_work(report, trace, candidate, source_work):
                    preservation_matches <- preservation_matches + 1
                    preservation_certificates.push(index)
            return false if entry_matches != 1 or preservation_matches != 1 or entry_certificates[0] == preservation_certificates[0]
            entry: ProofGoalCertificate = report.analysis_1.certificates[entry_certificates[0]]
            preserved: ProofGoalCertificate = report.analysis_1.certificates[preservation_certificates[0]]
            return false if not (proof_replay_certificate(report, entry, entry_certificates[0], workspace) can Global{Read,Write})
            return (proof_replay_certificate(report, preserved, preservation_certificates[0], workspace) can Global{Read,Write})

        def proof_replay_control_loop_entry_certificate(report: mutable ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, certificate_index: usize, owner_body: darray[Ast::Stmt], lexical_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt]) -> bool:
            work: mutable usize = 0
            proof_replay_control_loop_entry_certificate_with_work(report, trace, certificate, certificate_index, owner_body, lexical_body, loop_body, &work)

        def proof_replay_control_loop_entry_certificate_with_work(report: mutable ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, certificate_index: usize, owner_body: darray[Ast::Stmt], lexical_body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt], source_work: mutable usize&) -> bool:
            return false if:
                certificate.source_phase != "loop-invariant-entry"
                not proof_replay_control_certificate_attempt_index_unique_with_work(report, certificate, certificate_index, source_work)
                certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
                certificate.name != trace.name or certificate.line != trace.line
                certificate.facts_start > report.analysis_1.traces.origin_indices.count or certificate.facts_count > report.analysis_1.traces.origin_indices.count - certificate.facts_start
            for index in 0..<certificate.facts_count |index, report, certificate, source_work|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                origin: usize = report.analysis_1.traces.origin_indices[certificate.facts_start + index]
                continue if origin >= report.analysis_1.traces.records.count
                candidate: ProofFactTrace = report.analysis_1.traces.records[origin]
                # A range trace is serialized in the producer's for-loop entry context but
                # remains untrusted here; the range validator will omit it from entry replay.
                # Condition and invariant traces can describe loop-body state and stay barred.
                return false if candidate.line == certificate.line and (candidate.kind in {"loop-condition", "loop-invariant"})
            complete: mutable bool = true
            for statement in loop_body |report, trace, certificate, lexical_body, source_work, complete|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Contract("invariant", invariant, _):
                        if proof_replay_control_expr_source_equal_with_work(invariant, trace.expression, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT):
                            matched: bool = proof_replay_summary_call_argument_equal_with_work(report, trace, invariant, certificate.goal, 0, source_work, &complete, 0)
                            return false if:
                                not complete
                                source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            if matched:
                                return proof_replay_control_expr_source_equal_with_work(invariant, certificate.goal, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                            expanded_match: bool = proof_replay_loop_entry_expanded_goal_with_limit(report, trace, certificate, lexical_body, owner_body, invariant, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                            return true if expanded_match and proof_replay_control_expr_source_equal_with_work(invariant, trace.expression, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                    _:
                        pass
            return false

        def proof_replay_control_loop_condition_source(report: mutable ProofReport&, trace: ProofFactTrace) -> bool can[Global.Read, Global.Write]:
            work: mutable usize = 0
            return (proof_replay_control_loop_condition_source_with_work(report, trace, &work) can Global{Read,Write})

        def proof_replay_control_loop_condition_source_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count or trace.name == "" or trace.line == 0 or report.analysis_2.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &body, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            loop_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            loop_position: mutable Ast::Pos = Ast::pos_at_line(0)
            loop_matches: mutable usize = 0
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            remaining_work: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            work: mutable usize = 0
            found_loop: bool = proof_replay_control_find_loop_source(body, trace.line, &condition, &loop_body, &lexical_body, &loop_position, &loop_matches, 0, &work, remaining_work, false)
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT or work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + work
            return false if:
                not found_loop or loop_matches != 1
                not proof_replay_control_stable_expression(report, trace, condition, source_work)
            if proof_replay_control_expr_source_equal_with_work(trace.expression, condition, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT):
                # The exact assertion AST is inside the loop body, which places its
                # evaluation after the test even when the whole construct is on one line.
                return proof_replay_control_assertion_in_scope_with_work(report, body, loop_body, certificate, source_work) or proof_replay_control_preservation_contract_source_with_work(report, trace, loop_body, source_work)
            expected_exit: Ast::Expr = proof_replay_control_negation(condition, loop_position)
            return false if:
                not proof_replay_summary_expr_equal_with_limit(trace.expression, expected_exit, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                not proof_replay_control_assertion_after_loop_with_work(report, body, lexical_body, certificate, trace.line, source_work)
                source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            break_remaining_work: usize = PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            break_work: mutable usize = 0
            has_break: bool = proof_replay_control_body_has_break(loop_body, 0, 0, &break_work, break_remaining_work)
            return false if source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT or break_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + break_work
            return false if has_break
            return (proof_replay_control_loop_has_certified_invariant_with_work(report, trace, body, loop_body, source_work) can Global{Read,Write})

        def proof_replay_control_loop_has_certified_invariant(report: mutable ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt]) -> bool can[Global.Read, Global.Write]:
            work: mutable usize = 0
            return (proof_replay_control_loop_has_certified_invariant_with_work(report, trace, body, loop_body, &work) can Global{Read,Write})

        def proof_replay_control_loop_has_certified_invariant_with_work(report: mutable ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt], source_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            return (proof_replay_control_loop_has_certified_invariant_with_workspace(report, trace, body, loop_body, source_work, &workspace) can Global{Read,Write})

        def proof_replay_control_loop_has_certified_invariant_with_workspace(report: mutable ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt], loop_body: darray[Ast::Stmt], source_work: mutable usize&, workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool can[Global.Read, Global.Write]:
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            source_loop_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            return false if:
                not proof_replay_loop_scope_with_limit(body, trace.line, &condition, &source_loop_body, &lexical_body, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
            invariants: mutable darray[Ast::Expr] = []
            for statement in source_loop_body |invariants, source_work|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Contract("invariant", expression, _):
                        return false if not proof_replay_summary_expr_charge_with_limit(expression, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                        invariants.push(expression)
                    _:
                        pass
            return false if invariants.count == 0
            for invariant in invariants |report, trace, source_loop_body, invariant, source_work, workspace|:
                invariant_trace: ProofFactTrace = ProofFactTrace{expression: invariant, kernel_expression: trace.kernel_expression, kind: "loop-invariant", line: trace.line, name: trace.name, dependency: "", premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: 0}
                return false if not (proof_replay_control_loop_invariant_source_with_workspace(report, invariant_trace, source_work, workspace) can Global{Read,Write})
            return true

        def proof_replay_control_loop_range_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_control_loop_range_source_with_work(report, trace, &work)

        def proof_replay_control_loop_range_source_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count or trace.name == "" or trace.line == 0 or report.analysis_2.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &body, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            loop_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            return false if:
                not proof_replay_loop_scope_with_limit(body, trace.line, &condition, &loop_body, &lexical_body, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                source_work > PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                not (proof_replay_control_assertion_in_scope_with_work(report, body, loop_body, certificate, source_work) or proof_replay_control_preservation_contract_source_with_work(report, trace, loop_body, source_work))
            for statement in lexical_body |report, trace, certificate, loop_body, source_work|:
                return false if source_work >= PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.For(_, variables, iterable, inner, position):
                        continue if position.line != trace.line or variables.count != 1 or variables[0] == ""
                        # The checks below traverse `iterable` independently. Reserve the same
                        # bounded structural cost for each walk before running either predicate.
                        return false if:
                            not proof_replay_summary_expr_charge_with_limit(iterable, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                            not proof_replay_summary_expr_charge_with_limit(iterable, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                            not proof_replay_summary_expr_charge_with_limit(iterable, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT)
                            proof_expr_has_call(iterable) or proof_source_expression_has_overloaded_operator(iterable, report.source.source_primitive_operator_mask, 0)
                        binder_parts: mutable darray[Ast::Expr] = []
                        binder_parts.push(Ast::Expr.Ident(variables[0], position))
                        binder_parts.push(Ast::Expr.IntLit(position.offset.i64(), position))
                        binder: Ast::Expr = Ast::Expr.Tuple(binder_parts, position)
                        base: mutable Ast::Expr = iterable
                        while true:
                            match base:
                                Ast::Expr.Refinement(source, _, _) | Ast::Expr.Paren(source, _):
                                    base <- source
                                _:
                                    break
                        match base:
                            Ast::Expr.Binary(low, operator, high, range_position):
                                return false if:
                                    operator != TokenKind.RangeLt and operator != TokenKind.RangeLe
                                    not proof_replay_control_stable_expression(report, trace, low, source_work) or not proof_replay_control_stable_expression(report, trace, high, source_work)
                                lower: Ast::Expr = Ast::Expr.Binary(low, TokenKind.LtEq, binder, range_position)
                                upper_operator: TokenKind = TokenKind.Lt if operator == TokenKind.RangeLt else TokenKind.LtEq
                                upper: Ast::Expr = Ast::Expr.Binary(binder, upper_operator, high, range_position)
                                return (proof_replay_summary_expr_equal_with_limit(trace.expression, lower, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_control_expr_position_equal(trace.expression, lower)) or (proof_replay_summary_expr_equal_with_limit(trace.expression, upper, source_work, PROOF_REPLAY_CONTROL_SOURCE_WORK_LIMIT) and proof_replay_control_expr_position_equal(trace.expression, upper))
                            _:
                                return false
                    _:
                        pass
            return false

        def proof_replay_control_loop_fact_source(report: mutable ProofReport&, trace: ProofFactTrace) -> bool can[Global.Read, Global.Write]:
            work: mutable usize = 0
            return (proof_replay_control_loop_fact_source_with_work(report, trace, &work) can Global{Read,Write})

        def proof_replay_control_loop_fact_source_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            if trace.kind == "loop-condition":
                return (proof_replay_control_loop_condition_source_with_work(report, trace, source_work) can Global{Read,Write})
            if trace.kind == "loop-invariant":
                return (proof_replay_control_loop_invariant_source_with_work(report, trace, source_work) can Global{Read,Write})
            if trace.kind == "loop-range":
                return proof_replay_control_loop_range_source_with_work(report, trace, source_work)
            return false
