# Authenticate only the narrow local-binding form introduced when a signed call argument is
# rebound to preserve its primitive width. Other local-binding traces remain unsupported.
extend ElisaProof:
    private:
        def proof_replay_literal_call_find_expression(expression: Ast::Expr, expected_position: Ast::Pos, matches: mutable usize&, found_call: mutable Ast::Expr&, safe: mutable bool&, nested: bool, conditional: bool, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, position):
                    if proof_replay_source_position_equal(position, expected_position):
                        matches <- matches + 1
                        found_call <- expression
                        safe <- false if nested or conditional
                    return false if not proof_replay_literal_call_find_expression(callee, expected_position, matches, found_call, safe, true, conditional, depth + 1)
                    for argument in arguments |expected_position, matches, found_call, safe, conditional, depth|:
                        return false if not proof_replay_literal_call_find_expression(argument, expected_position, matches, found_call, safe, true, conditional, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return false
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_literal_call_find_expression(inner, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    short_circuit: bool = operator == TokenKind.And or operator == TokenKind.Or
                    return false if not proof_replay_literal_call_find_expression(left, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                    return proof_replay_literal_call_find_expression(right, expected_position, matches, found_call, safe, nested, conditional or short_circuit, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                    return proof_replay_literal_call_find_expression(object, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return false if not proof_replay_literal_call_find_expression(object, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                    return proof_replay_literal_call_find_expression(index, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return false if:
                        not proof_replay_literal_call_find_expression(object, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                        not proof_replay_literal_call_find_expression(low, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                    return proof_replay_literal_call_find_expression(high, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_literal_call_find_expression(object, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                    for argument in arguments |expected_position, matches, found_call, safe, nested, conditional, depth|:
                        return false if not proof_replay_literal_call_find_expression(argument, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |expected_position, matches, found_call, safe, nested, conditional, depth|:
                        return false if not proof_replay_literal_call_find_expression(element, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |expected_position, matches, found_call, safe, nested, conditional, depth|:
                        return false if:
                            not proof_replay_literal_call_find_expression(entry.key, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                            not proof_replay_literal_call_find_expression(entry.value, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_literal_call_find_expression(base, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                    for field in fields |expected_position, matches, found_call, safe, nested, conditional, depth|:
                        return false if not proof_replay_literal_call_find_expression(field.value, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return false if:
                        not proof_replay_literal_call_find_expression(condition, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                        not proof_replay_literal_call_find_expression(yes, expected_position, matches, found_call, safe, nested, true, depth + 1)
                    return proof_replay_literal_call_find_expression(no, expected_position, matches, found_call, safe, nested, true, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_replay_literal_call_find_expression(base, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                    return proof_replay_literal_call_find_expression(predicate, expected_position, matches, found_call, safe, nested, conditional, depth + 1)
                Ast::Expr.Match(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _):
                    return false
                _:
                    pass
            return true

        def proof_replay_literal_call_find_statements(body: darray[Ast::Stmt]&, expected_position: Ast::Pos, matches: mutable usize&, found_call: mutable Ast::Expr&, safe: mutable bool&, conditional: bool, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for statement in body |expected_position, matches, found_call, safe, conditional, depth|:
                match statement:
                    Ast::Stmt.Expr(expression, _):
                        return false if not proof_replay_literal_call_find_expression(expression, expected_position, matches, found_call, safe, false, conditional, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_literal_call_find_statements(nested, expected_position, matches, found_call, safe, true, depth + 1)
                    Ast::Stmt.VarDecl(_, _, value, _):
                        return false if not proof_replay_literal_call_find_expression(value, expected_position, matches, found_call, safe, false, conditional, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if:
                            not proof_replay_literal_call_find_expression(target, expected_position, matches, found_call, safe, false, conditional, depth + 1)
                            not proof_replay_literal_call_find_expression(value, expected_position, matches, found_call, safe, false, conditional, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if:
                            not proof_replay_literal_call_find_expression(condition, expected_position, matches, found_call, safe, false, conditional, depth + 1)
                            not proof_replay_literal_call_find_statements(yes, expected_position, matches, found_call, safe, true, depth + 1)
                            not proof_replay_literal_call_find_statements(no, expected_position, matches, found_call, safe, true, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        return false if:
                            not proof_replay_literal_call_find_expression(condition, expected_position, matches, found_call, safe, false, true, depth + 1)
                            not proof_replay_literal_call_find_statements(nested, expected_position, matches, found_call, safe, true, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        return false if:
                            not proof_replay_literal_call_find_expression(iterable, expected_position, matches, found_call, safe, false, true, depth + 1)
                            not proof_replay_literal_call_find_statements(nested, expected_position, matches, found_call, safe, true, depth + 1)
                    Ast::Stmt.Return(value, _):
                        return false if not proof_replay_literal_call_find_expression(value, expected_position, matches, found_call, safe, false, conditional, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return false if not proof_replay_literal_call_find_expression(scrutinee, expected_position, matches, found_call, safe, false, conditional, depth + 1)
                        for arm in arms |expected_position, matches, found_call, safe, depth|:
                            return false if:
                                not proof_replay_literal_call_find_expression(arm.guard, expected_position, matches, found_call, safe, false, true, depth + 1)
                                not proof_replay_literal_call_find_statements(arm.body, expected_position, matches, found_call, safe, true, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_literal_call_find_expression(expression, expected_position, matches, found_call, safe, false, conditional, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_literal_call_source_declaration(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, current_module: sview, expected_position: Ast::Pos, matches: mutable usize&, found_call: mutable Ast::Expr&, safe: mutable bool&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, owner_offset, current_module, expected_position, matches, found_call, safe, depth|:
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, position):
                        if name == owner and position.line == owner_line and position.offset.usize() == owner_offset:
                            return false if not proof_replay_literal_call_find_statements(body, expected_position, matches, found_call, safe, false, 0)
                    Ast::Decl.Module(module_name, nested, _):
                        return false if not proof_replay_literal_call_source_declaration(nested, owner, owner_line, owner_offset, module_name, expected_position, matches, found_call, safe, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_literal_call_source_declaration(nested, owner, owner_line, owner_offset, current_module, expected_position, matches, found_call, safe, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_literal_call_signature(declarations: darray[Ast::Decl]&, name: sview, target_scope: darray[sview]&, current_scope: darray[sview]&, argument_count: usize, argument_names: darray[sview]&, argument_index: usize, width: mutable i64&, function_matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + declarations.count
            for declaration in declarations |name, target_scope, current_scope, argument_count, argument_names, argument_index, width, function_matches, work, depth|:
                match declaration:
                    Ast::Decl.Func(candidate_name, parameters, _, _, _, _, _):
                        same_name: (equal: bool, complete: bool) = proof_replay_global_constant_text_equal_with_work(candidate_name, name, work)
                        return false if not same_name.complete
                        if same_name.equal:
                            same_scope: (equal: bool, complete: bool) = proof_replay_global_constant_scope_equal_with_work(current_scope, target_scope, work)
                            return false if not same_scope.complete
                            continue if not same_scope.equal
                            function_matches <- function_matches + 1
                            return false if:
                                argument_count != parameters.count or argument_index >= parameters.count
                                argument_names.count != 0 and argument_names.count != argument_count
                            for index in 0..<argument_count |index, argument_names, work|:
                                return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                work <- work + 1
                                return false if argument_names.count > 0 and argument_names[index] != ""
                            parameter: Ast::ParamDecl = parameters[argument_index]
                            return false if sview_len(parameter.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(parameter.name)
                            return false if:
                                not proof_replay_summary_expr_charge_with_work(parameter.type_expression, work)
                                parameter.is_mutable or parameter.has_default
                            match parameter.type_expression:
                                Ast::Expr.Ident(type_name, _):
                                    width <- proof_signed_primitive_width(Ast::Expr.Ident(type_name, Ast::expr_pos(parameter.type_expression)))
                                _:
                                    return false
                    Ast::Decl.Module(module_name, nested, _):
                        next_scope_result: (complete: bool, scope: darray[sview]) = proof_replay_global_constant_scope_with_module_and_work(current_scope, module_name, work)
                        return false if not next_scope_result.complete
                        return false if not proof_replay_literal_call_signature(nested, name, target_scope, next_scope_result.scope, argument_count, argument_names, argument_index, width, function_matches, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_literal_call_signature(nested, name, target_scope, current_scope, argument_count, argument_names, argument_index, width, function_matches, work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_literal_binding_symbol_index(name: sview) -> usize:
            for index in 0..<PROOF_INTERNAL_REBIND_SYMBOL_COUNT |index, name|:
                return index if proof_internal_rebind_name(index) == name
            return PROOF_INTERNAL_REBIND_SYMBOL_COUNT

        def proof_replay_literal_binding_width_matches(report: ProofReport&, symbol: sview, expected_width: i64, expected_position: Ast::Pos, owner: sview, call_line: u32, work: mutable usize&) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or report.analysis_1.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + report.analysis_1.traces.records.count
            signed_found: mutable bool = false
            for trace in report.analysis_1.traces.records |trace, symbol, expected_width, owner, call_line, signed_found|:
                kind_match: (equal: bool, complete: bool) = proof_replay_global_constant_text_equal_with_work(trace.kind, "type-bound", work)
                owner_match: (equal: bool, complete: bool) = proof_replay_global_constant_text_equal_with_work(trace.name, owner, work)
                return false if not kind_match.complete or not owner_match.complete
                continue if not kind_match.equal or not owner_match.equal or trace.line != call_line
                return false if not proof_replay_summary_expr_charge_with_work(trace.expression, work)
                match trace.expression:
                    Ast::Expr.Call(Ast::Expr.Ident(callee, _), arguments, argument_names, position):
                        signed_marker: (equal: bool, complete: bool) = proof_replay_global_constant_text_equal_with_work(callee, "__elisa_signed_type_bound", work)
                        unsigned_marker: (equal: bool, complete: bool) = proof_replay_global_constant_text_equal_with_work(callee, "__elisa_unsigned_type_bound", work)
                        place_marker: (equal: bool, complete: bool) = proof_replay_global_constant_text_equal_with_work(callee, "__elisa_signed_place_type_bound", work)
                        return false if not signed_marker.complete or not unsigned_marker.complete or not place_marker.complete
                        if signed_marker.equal or unsigned_marker.equal or place_marker.equal:
                            return false if position.line != call_line or not proof_replay_source_position_equal(position, expected_position) or argument_names.count != 0
                            continue if arguments.count == 0
                            match arguments[0]:
                                Ast::Expr.Ident(bound_name, _):
                                    same_symbol: (equal: bool, complete: bool) = proof_replay_global_constant_text_equal_with_work(bound_name, symbol, work)
                                    return false if not same_symbol.complete
                                    if same_symbol.equal:
                                        return false if not signed_marker.equal or arguments.count != 2
                                        match arguments[1]:
                                            Ast::Expr.IntLit(width, _) if width == expected_width:
                                                signed_found <- true
                                            _:
                                                return false
                                _:
                                    pass
                    _:
                        pass
            return signed_found

        def proof_replay_literal_binding_unique(report: ProofReport&, symbol: sview, expected: Ast::Expr, owner: sview, call_line: u32) -> bool:
            work: mutable usize = 0
            return proof_replay_literal_binding_unique_with_work(report, symbol, expected, owner, call_line, &work)

        def proof_replay_literal_binding_unique_with_work(report: ProofReport&, symbol: sview, expected: Ast::Expr, owner: sview, call_line: u32, work: mutable usize&) -> bool:
            return false if report.analysis_1.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + report.analysis_1.traces.records.count
            for trace in report.analysis_1.traces.records |trace, symbol, expected, owner, call_line, work|:
                continue if trace.kind != "local-binding" or trace.name != owner or trace.line != call_line
                match trace.expression:
                    Ast::Expr.Binary(Ast::Expr.Ident(name, _), TokenKind.EqEq, _, _) if name == symbol:
                        return false if:
                            not proof_replay_summary_expr_equal_with_work(trace.expression, expected, work)
                            not proof_replay_source_position_equal(Ast::expr_pos(trace.expression), Ast::expr_pos(expected))
                    _:
                        pass
            return true

        def proof_replay_literal_call_argument_binding_valid(report: mutable ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_literal_call_argument_binding_valid_with_work(report, trace, &work)

        def proof_replay_literal_call_argument_binding_valid_with_work(report: mutable ProofReport&, trace: ProofFactTrace, work: mutable usize&) -> bool:
            return false if:
                report.analysis_2.trace_owner_line != trace.line
                report.analysis_2.replay_owner_line == 0 or report.analysis_2.replay_owner_line == 4294967295
                not report.analysis_2.replay_owner_offset_valid
                not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, work)
                proof_replay_summary_has_unresolved_import(report.source.source_annotations, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                report.source.source_declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + report.source.source_declarations.count
            return false if proof_replay_summary_has_unresolved_declaration_import(report.source.source_declarations, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, literal, position):
                    return false if:
                        symbol == "" or not proof_replay_source_position_equal(symbol_position, position)
                        position.line != trace.line or trace.line != report.analysis_2.trace_owner_line
                    symbol_index: usize = proof_replay_literal_binding_symbol_index(symbol)
                    # Rebind counters restart per function, while this report field is only
                    # scratch for whichever function was checked last. The reserved spelling
                    # plus exact source-call evidence is the stable identity; do not trust that
                    # transient counter during replay.
                    return false if symbol_index >= PROOF_INTERNAL_REBIND_SYMBOL_COUNT or not proof_replay_literal_binding_unique_with_work(report, symbol, trace.expression, trace.name, trace.line, work)
                    caller_scope: mutable darray[sview] = []
                    caller_count: mutable usize = 0
                    root_scope: darray[sview] = []
                    proof_replay_summary_call_owner_scope(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, true, root_scope, &caller_scope, &caller_count, work, 0)
                    return false if caller_count != 1 or not proof_replay_summary_scope_work_charge(caller_scope, work)
                    source_matches: mutable usize = 0
                    source_call: mutable Ast::Expr = Ast::Expr.Invalid
                    source_safe: mutable bool = true
                    return false if:
                        not proof_replay_literal_call_source_declaration(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, "", position, &source_matches, &source_call, &source_safe, 0)
                        source_matches != 1 or not source_safe
                    match source_call:
                        Ast::Expr.Call(Ast::Expr.Ident(callee_name, _), arguments, argument_names, call_position):
                            return false if:
                                callee_name == "" or proof_name_is_reserved_internal(callee_name)
                                not proof_replay_source_position_equal(call_position, position)
                                proof_replay_local_binding_parameter_name_present_at_offset_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, true, callee_name, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                            caller_body: mutable darray[Ast::Stmt] = []
                            return false if:
                                not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &caller_body, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                not proof_replay_source_call_locals_unshadowed_at_with_work(caller_body, report.source.source_annotations, source_call, work)
                            argument_index: mutable usize = arguments.count
                            for index in 0..<arguments.count |index, arguments, literal, argument_index|:
                                return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                work <- work + 1
                                if proof_replay_source_position_equal(Ast::expr_pos(arguments[index]), Ast::expr_pos(literal)) and proof_replay_summary_expr_equal_with_work(arguments[index], literal, work):
                                    return false if argument_index != arguments.count
                                    argument_index <- index
                            return false if:
                                argument_index >= arguments.count
                                not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, work)
                            overload_count: mutable usize = 0
                            return false if:
                                not proof_replay_same_module_name_count_at_scope(report.source.source_declarations, callee_name, caller_scope, root_scope, &overload_count, work, 0)
                                overload_count != 1
                            function_matches: mutable usize = 0
                            width: mutable i64 = 0
                            return false if:
                                not proof_replay_literal_call_signature(report.source.source_declarations, callee_name, caller_scope, root_scope, arguments.count, argument_names, argument_index, &width, &function_matches, work, 0)
                                function_matches != 1 or width <= 0 or not proof_literal_argument_fits(literal, width, 0)
                            return proof_replay_literal_binding_width_matches(report, symbol, width, position, trace.name, trace.line, work)
                        _:
                            return false
                _:
                    return false
