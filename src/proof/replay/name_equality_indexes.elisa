extend ElisaProof:
    private:
        def proof_replay_bound_index_with_work(bounds: darray[ProofReplayBound]&, name: sview, work: mutable usize&) -> (complete: bool, index: usize):
            for index in 0..<bounds.count |index, bounds, name, work|:
                return (false, bounds.count) if:
                    not proof_replay_equality_work_charge(1, work)
                    not proof_replay_equality_work_charge(sview_len(bounds[index].name), work)
                    not proof_replay_equality_work_charge(sview_len(name), work)
                return (true, index) if bounds[index].name == name
            return (true, bounds.count)

        def proof_replay_alias_name_index(names: darray[sview]&, name: sview, work: mutable usize&) -> (complete: bool, index: usize):
            index: mutable usize = 0
            while index < names.count |index, names, name, work|:
                return (false, names.count) if:
                    not proof_replay_equality_work_charge(1, work)
                    not proof_replay_equality_work_charge(sview_len(names[index]), work)
                    not proof_replay_equality_work_charge(sview_len(name), work)
                return (true, index) if names[index] == name
                index <- index + 1
            return (true, names.count)

        def proof_replay_equality_sort_cache_index(name: sview, names: darray[sview]&, hashes: darray[u32]&, slots: darray[usize]&, work: mutable usize&) -> (complete: bool, found: bool, index: usize):
            capacity: usize = slots.count
            return (false, false, 0) if capacity == 0 or names.count != hashes.count or names.count >= capacity
            return (false, false, 0) if not proof_replay_equality_work_charge(sview_len(name), work)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity |probes, slot, wanted_hash, name, names, hashes, slots, capacity, work|:
                return (false, false, 0) if not proof_replay_equality_work_charge(1, work)
                current: usize = slots[slot]
                if current == capacity:
                    return (true, false, 0)
                return (false, false, 0) if current >= names.count
                if hashes[current] == wanted_hash:
                    return (false, false, 0) if not proof_replay_equality_work_charge(sview_len(names[current]), work) or not proof_replay_equality_work_charge(sview_len(name), work)
                    return (true, true, current) if names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, 0)
