extend ElisaProofFrameSource:
    public:
        # Replay a caller predicate for one original callee changes ordinal.
        # Complete caller coverage and logical call admission remain separate.
        def call_allowance_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, change_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return false if not ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(nodes, children, facts, root)
            return false if nodes[root].operator != "allow"
            policy = source_policy(declarations, name, line, tokens, source, source_length)
            return false if not policy.known or not lists_match(name, policy.parameter_count, &policy.clauses, nodes, children, root)
            for clause in policy.clauses |declarations, name, line|:
                return false if not place_typed(declarations, name, line, clause.place)
            mapping = source_call_changes(declarations, name, line, position, tokens, source, source_length)
            return false if not mapping.known or change_index >= mapping.places.count
            node = nodes[root]
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return certified.known and same_place(mapping.places[change_index], certified.place)

        def call_preserve_clause_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, change_index: usize, clause_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return false if not ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(nodes, children, facts, root)
            node = nodes[root]
            return false if node.operator != "preserve" or node.name != name or node.children_count != 1
            policy = source_policy(declarations, name, line, tokens, source, source_length)
            return false if not policy.known or policy.parameter_count != node.auxiliary or clause_index >= policy.clauses.count
            clause = policy.clauses[clause_index]
            return false if clause.kind != "preserves" or not place_typed(declarations, name, line, clause.place)
            preserved = ElisaProofKernelFramePolicy::decode_place(nodes, children, children[node.children_start], node.auxiliary)
            return false if not preserved.known or not same_place(clause.place, preserved.place)
            mapping = source_call_changes(declarations, name, line, position, tokens, source, source_length)
            return false if not mapping.known or change_index >= mapping.places.count
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return certified.known and same_place(mapping.places[change_index], certified.place)
