extend ElisaProofFrameSource:
    public:
        # Replay a caller predicate for one original callee changes ordinal.
        # Complete caller coverage and logical call admission remain separate.
        def call_allowance_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, change_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (call_allowance_replays_with_work(declarations, name, line, position, change_index, tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def call_allowance_replays_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, change_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return false if not replay_work_charge(nodes.count, work)
            return false if not replay_work_charge(children.count, work)
            return false if not (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(nodes, children) can Global{Read,Write})
            return false if not (frame_policy_replays_after_arena_with_work(nodes, children, root, work) can Global{Read,Write})
            return (call_allowance_replays_after_arena_with_work(declarations, name, line, position, change_index, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})

    private:
        def call_allowance_replays_after_arena_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, change_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return false if nodes[root].operator != "allow"
            policy = source_policy_with_work(declarations, name, line, tokens, source, source_length, work)
            return false if not policy.known or not lists_match_with_work(name, policy.parameter_count, &policy.clauses, nodes, children, root, work)
            return false if not replay_work_charge(policy.clauses.count, work)
            for clause in policy.clauses |declarations, name, line, work|:
                return false if not place_typed_with_work(declarations, name, line, clause.place, work)
            mapping = (source_call_changes_with_work(declarations, name, line, position, tokens, source, source_length, work) can Global{Read,Write})
            return false if not mapping.known or change_index >= mapping.places.count
            node = nodes[root]
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return false if not certified.known
            return false if not replay_work_charge(sview_len(mapping.places[change_index].field), work)
            return false if not replay_work_charge(sview_len(mapping.places[change_index].field2), work)
            return false if not replay_work_charge(sview_len(mapping.places[change_index].field3), work)
            return false if not replay_work_charge(sview_len(certified.place.field), work)
            return false if not replay_work_charge(sview_len(certified.place.field2), work)
            return false if not replay_work_charge(sview_len(certified.place.field3), work)
            return same_place(mapping.places[change_index], certified.place)

    public:
        def call_preserve_clause_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, change_index: usize, clause_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (call_preserve_clause_replays_with_work(declarations, name, line, position, change_index, clause_index, tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def call_preserve_clause_replays_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, change_index: usize, clause_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return false if not replay_work_charge(nodes.count, work)
            return false if not replay_work_charge(children.count, work)
            return false if not (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(nodes, children) can Global{Read,Write})
            return false if not (frame_policy_replays_after_arena_with_work(nodes, children, root, work) can Global{Read,Write})
            return (call_preserve_clause_replays_after_arena_with_work(declarations, name, line, position, change_index, clause_index, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})

    private:
        def call_preserve_clause_replays_after_arena_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, position: Ast::Pos, change_index: usize, clause_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            node = nodes[root]
            return false if not replay_work_charge(sview_len(name), work)
            return false if not replay_work_charge(sview_len(node.name), work)
            return false if node.operator != "preserve" or node.name != name or node.children_count != 1
            policy = source_policy_with_work(declarations, name, line, tokens, source, source_length, work)
            return false if not policy.known or policy.parameter_count != node.auxiliary or clause_index >= policy.clauses.count
            clause = policy.clauses[clause_index]
            return false if not replay_work_charge(sview_len(clause.kind), work)
            return false if clause.kind != "preserves" or not place_typed_with_work(declarations, name, line, clause.place, work)
            preserved = ElisaProofKernelFramePolicy::decode_place(nodes, children, children[node.children_start], node.auxiliary)
            return false if not preserved.known
            return false if not replay_work_charge(sview_len(clause.place.field), work)
            return false if not replay_work_charge(sview_len(clause.place.field2), work)
            return false if not replay_work_charge(sview_len(clause.place.field3), work)
            return false if not replay_work_charge(sview_len(preserved.place.field), work)
            return false if not replay_work_charge(sview_len(preserved.place.field2), work)
            return false if not replay_work_charge(sview_len(preserved.place.field3), work)
            return false if not same_place(clause.place, preserved.place)
            mapping = (source_call_changes_with_work(declarations, name, line, position, tokens, source, source_length, work) can Global{Read,Write})
            return false if not mapping.known or change_index >= mapping.places.count
            certified = ElisaProofKernelFramePolicy::decode_place(nodes, children, node.left, node.auxiliary)
            return false if not certified.known
            return false if not replay_work_charge(sview_len(mapping.places[change_index].field), work)
            return false if not replay_work_charge(sview_len(mapping.places[change_index].field2), work)
            return false if not replay_work_charge(sview_len(mapping.places[change_index].field3), work)
            return false if not replay_work_charge(sview_len(certified.place.field), work)
            return false if not replay_work_charge(sview_len(certified.place.field2), work)
            return false if not replay_work_charge(sview_len(certified.place.field3), work)
            return same_place(mapping.places[change_index], certified.place)
