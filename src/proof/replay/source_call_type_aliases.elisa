# Bounded transparent type-alias normalization shared by source-call replay.
extend ElisaProof:
    private:
        def proof_replay_call_conversion_alias_work_add(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + amount
            return true

        def proof_replay_call_conversion_name_lookup(name: sview, names: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, work: mutable usize&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if:
                name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
                not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, names, hashes, values, counts, name_count, work|:
                return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == wanted_hash:
                    current_name: sview = names[current]
                    return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, sview_len(current_name))
                    if current_name == name:
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_replay_call_conversion_scoped_lookup(name: sview, head: Ast::Expr, names: darray[sview]&, owners: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, work: mutable usize&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid or owners.count != name_count
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
            key: (complete: bool, hash: u32) = proof_source_conversion_scope_expression_key_hash(head, name, work)
            return (false, 2, name_count) if not key.complete
            slot: mutable usize = (key.hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, head, name, names, owners, hashes, values, counts, name_count, work|:
                return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == key.hash:
                    current_name: sview = names[current]
                    return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, sview_len(current_name))
                    if current_name == name and proof_source_conversion_scope_matches_owner(head, owners[current], sview_len(owners[current]), work, 0):
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_replay_call_conversion_scoped_owner_lookup(name: sview, owner: sview, names: darray[sview]&, owners: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, work: mutable usize&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid or owners.count != name_count
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
            key: (complete: bool, hash: u32) = proof_source_conversion_scope_key_hash(owner, name, work)
            return (false, 2, name_count) if not key.complete
            slot: mutable usize = (key.hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, owner, name, names, owners, hashes, values, counts, name_count, work|:
                return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == key.hash:
                    current_name: sview = names[current]
                    current_owner: sview = owners[current]
                    return (false, 2, name_count) if:
                        not proof_replay_call_conversion_alias_work_add(work, sview_len(current_name))
                        not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
                        not proof_replay_call_conversion_alias_work_add(work, sview_len(current_owner))
                        not proof_replay_call_conversion_alias_work_add(work, sview_len(owner))
                    if current_name == name and current_owner == owner:
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_replay_call_conversion_generic_root(head: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_replay_call_conversion_alias_work_add(work, 1)
            match head:
                Ast::Expr.Ident(name, _):
                    return (false, "") if not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
                    return (true, name)
                Ast::Expr.Scope(parent, _, _):
                    return proof_replay_call_conversion_generic_root(parent, work, depth + 1)
                _:
                    return (true, "")

        def proof_replay_call_conversion_generic_name(name: sview, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, count: usize):
            active_function_line: u32 = call_target.generics.field_conversion_generic_param_line
            # The generic binder check is about the function whose call site is being
            # replayed. Alias expansion carries the alias declaration line separately;
            # accepting that line here could miss a same-named caller generic.
            return (false, 0) if active_function_line == 0
            lookup: (complete: bool, present: bool) = proof_replay_call_generic_param_name(name, active_function_line, call_target, work)
            return (lookup.complete, 1 if lookup.present else 0)

        def proof_replay_call_conversion_builtin_type_name(name: sview) -> bool:
            return true if proof_builtin_scalar_type_name(name)
            return name in {"darray", "view", "array", "sview", "cstr", "dstr", "str", "void", "never", "type"}

        def proof_replay_call_conversion_alias_target(name: sview, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr):
            alias_count: usize = call_target.aliases.field_conversion_alias_names.count
            return (false, 2, alias_count, Ast::Expr.Invalid) if alias_count != call_target.aliases.field_conversion_alias_targets.count or alias_count != call_target.aliases.field_conversion_alias_lines.count or alias_count != call_target.aliases.field_conversion_alias_owners.count
            alias: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_name_lookup(name, call_target.aliases.field_conversion_alias_names, call_target.aliases.field_conversion_alias_index_hashes, call_target.aliases.field_conversion_alias_index_values, call_target.aliases.field_conversion_alias_index_counts, call_target.aliases.field_conversion_alias_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
            nominal: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_name_lookup(name, call_target.types.field_conversion_declared_types, call_target.types.field_conversion_declared_type_index_hashes, call_target.types.field_conversion_declared_type_index_values, call_target.types.field_conversion_declared_type_index_counts, call_target.types.field_conversion_declared_type_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid) if:
                not nominal.complete
                alias.count == 0 and nominal.count > 0 and proof_replay_call_conversion_builtin_type_name(name)
            return (true, 0, alias_count, Ast::Expr.Invalid) if alias.count == 0
            return (false, 2, alias_count, Ast::Expr.Invalid) if:
                nominal.count > 0 or proof_replay_call_conversion_builtin_type_name(name)
                call_target.aliases.field_conversion_alias_has_formals.count != alias_count
            return (true, 0, alias_count, Ast::Expr.Invalid) if:
                call_target.aliases.field_conversion_alias_has_formals[alias.row]
                call_target.aliases.field_conversion_alias_owners[alias.row] != "" or not call_target.aliases.field_conversion_bare_alias_root_fallback_valid
            return (true, 1, alias.row, call_target.aliases.field_conversion_alias_targets[alias.row])

        def proof_replay_call_conversion_qualified_alias_target(head: Ast::Expr, name: sview, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr):
            alias_count: usize = call_target.aliases.field_conversion_alias_names.count
            alias: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_scoped_lookup(name, head, call_target.aliases.field_conversion_alias_names, call_target.aliases.field_conversion_alias_owners, call_target.aliases.field_conversion_alias_scope_index_hashes, call_target.aliases.field_conversion_alias_scope_index_values, call_target.aliases.field_conversion_alias_scope_index_counts, call_target.aliases.field_conversion_alias_scope_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
            nominal: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_scoped_lookup(name, head, call_target.types.field_conversion_declared_types, call_target.types.field_conversion_declared_type_owners, call_target.types.field_conversion_declared_type_scope_index_hashes, call_target.types.field_conversion_declared_type_scope_index_values, call_target.types.field_conversion_declared_type_scope_index_counts, call_target.types.field_conversion_declared_type_scope_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid) if not nominal.complete or nominal.count > 0
            return (true, 0, alias_count, Ast::Expr.Invalid) if alias.count == 0
            return (false, 2, alias_count, Ast::Expr.Invalid) if call_target.aliases.field_conversion_alias_has_formals.count != alias_count or call_target.aliases.field_conversion_alias_lines.count != alias_count
            return (true, 0, alias_count, Ast::Expr.Invalid) if call_target.aliases.field_conversion_alias_has_formals[alias.row]
            return (true, 1, alias.row, call_target.aliases.field_conversion_alias_targets[alias.row])

        def proof_replay_call_conversion_alias_target_in_owner(name: sview, owner: sview, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool):
            alias_count: usize = call_target.aliases.field_conversion_alias_names.count
            aliases: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_scoped_owner_lookup(name, owner, call_target.aliases.field_conversion_alias_names, call_target.aliases.field_conversion_alias_owners, call_target.aliases.field_conversion_alias_scope_index_hashes, call_target.aliases.field_conversion_alias_scope_index_values, call_target.aliases.field_conversion_alias_scope_index_counts, call_target.aliases.field_conversion_alias_scope_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid, false) if not aliases.complete or aliases.count > 1
            nominals: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_scoped_owner_lookup(name, owner, call_target.types.field_conversion_declared_types, call_target.types.field_conversion_declared_type_owners, call_target.types.field_conversion_declared_type_scope_index_hashes, call_target.types.field_conversion_declared_type_scope_index_values, call_target.types.field_conversion_declared_type_scope_index_counts, call_target.types.field_conversion_declared_type_scope_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid, false) if not nominals.complete or nominals.count > 1 or (aliases.count > 0 and nominals.count > 0)
            return (true, 0, alias_count, Ast::Expr.Absent, true) if nominals.count == 1
            return (true, 0, alias_count, Ast::Expr.Absent, false) if aliases.count == 0
            return (false, 2, alias_count, Ast::Expr.Invalid, false) if:
                alias_count != call_target.aliases.field_conversion_alias_targets.count or alias_count != call_target.aliases.field_conversion_alias_has_formals.count or aliases.row >= alias_count
                call_target.aliases.field_conversion_alias_has_formals[aliases.row]
            return (true, 1, aliases.row, call_target.aliases.field_conversion_alias_targets[aliases.row], false)

        def proof_replay_call_conversion_alias_expand(row: usize, target: Ast::Expr, call_target: ProofReplayCallSiteTarget&, seen: mutable darray[usize]&, work: mutable usize&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if row >= call_target.aliases.field_conversion_alias_lines.count or call_target.aliases.field_conversion_alias_lines.count != call_target.aliases.field_conversion_alias_names.count or call_target.aliases.field_conversion_alias_owners.count != call_target.aliases.field_conversion_alias_names.count
            for active in seen |active, row, work|:
                return (false, Ast::Expr.Invalid) if:
                    not proof_replay_call_conversion_alias_work_add(work, 1)
                    active == row
            mark: usize = seen.count
            return (false, Ast::Expr.Invalid) if not proof_replay_call_conversion_alias_work_add(work, 1)
            seen.push(row)
            # Generic shadowing applies to explicit call-site syntax. Once an alias is entered,
            # bare names in its RHS resolve in the alias's declaring module.
            expanded: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(target, call_target.aliases.field_conversion_alias_lines[row], false, call_target.aliases.field_conversion_alias_owners[row], call_target, seen, work, depth + 1)
            seen.resize(mark)
            return expanded

        def proof_replay_call_conversion_type_alias_unwrap(expression: Ast::Expr, declaration_line: u32, check_caller_generics: bool, resolution_owner: sview, call_target: ProofReplayCallSiteTarget&, seen: mutable darray[usize]&, work: mutable usize&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_replay_call_conversion_alias_work_add(work, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    if check_caller_generics:
                        generic: (complete: bool, count: usize) = proof_replay_call_conversion_generic_name(name, call_target, work)
                        return (false, Ast::Expr.Invalid) if not generic.complete or generic.count > 0
                    if resolution_owner != "":
                        local: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool) = proof_replay_call_conversion_alias_target_in_owner(name, resolution_owner, call_target, work)
                        return (false, Ast::Expr.Invalid) if:
                            not local.complete
                            local.nominal
                        return proof_replay_call_conversion_alias_expand(local.row, local.target, call_target, seen, work, depth) if local.count == 1
                    alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_replay_call_conversion_alias_target(name, call_target, work)
                    return (false, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
                    return (true, expression) if alias.count == 0
                    return proof_replay_call_conversion_alias_expand(alias.row, alias.target, call_target, seen, work, depth)
                Ast::Expr.Scope(head, name, _):
                    root: (complete: bool, name: sview) = proof_replay_call_conversion_generic_root(head, work, 0)
                    return (false, Ast::Expr.Invalid) if not root.complete
                    if root.name != "" and check_caller_generics:
                        generic: (complete: bool, count: usize) = proof_replay_call_conversion_generic_name(root.name, call_target, work)
                        return (false, Ast::Expr.Invalid) if not generic.complete or generic.count > 0
                    alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_replay_call_conversion_qualified_alias_target(head, name, call_target, work)
                    return (false, Ast::Expr.Invalid) if not alias.complete or alias.count != 1
                    return proof_replay_call_conversion_alias_expand(alias.row, alias.target, call_target, seen, work, depth)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_call_conversion_type_alias_unwrap(inner, declaration_line, check_caller_generics, resolution_owner, call_target, seen, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_call_conversion_type_alias_unwrap(inner, declaration_line, check_caller_generics, resolution_owner, call_target, seen, work, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return (true, expression)
                Ast::Expr.Index(head, element, position):
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(head, declaration_line, check_caller_generics, resolution_owner, call_target, seen, work, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_head.complete
                    unwrapped_element: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(element, declaration_line, check_caller_generics, resolution_owner, call_target, seen, work, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_element.complete
                    return (true, Ast::Expr.Index(unwrapped_head.type_expression, unwrapped_element.type_expression, position))
                Ast::Expr.IndexN(head, arguments, position):
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(head, declaration_line, check_caller_generics, resolution_owner, call_target, seen, work, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_head.complete
                    unwrapped_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |call_target, seen, unwrapped_arguments, work, depth, check_caller_generics|:
                        unwrapped: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(argument, declaration_line, check_caller_generics, resolution_owner, call_target, seen, work, depth + 1)
                        return (false, Ast::Expr.Invalid) if not unwrapped.complete
                        unwrapped_arguments.push(unwrapped.type_expression)
                    return (true, Ast::Expr.IndexN(unwrapped_head.type_expression, unwrapped_arguments, position))
                Ast::Expr.Field(_, _, _):
                    return (false, Ast::Expr.Invalid)
                _:
                    return (true, expression)
