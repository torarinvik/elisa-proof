# Bounded transparent type-alias normalization shared by source-call replay.
extend ElisaProof:
    private:
        def proof_replay_call_conversion_alias_work_add(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + amount
            return true

        def proof_replay_call_conversion_name_lookup(name: sview, names: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, work: mutable usize&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if:
                name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
                not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, names, hashes, values, counts, name_count, work|:
                return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == wanted_hash:
                    current_name: sview = names[current]
                    return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, sview_len(current_name))
                    if current_name == name:
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_replay_call_conversion_scoped_lookup(name: sview, head: Ast::Expr, names: darray[sview]&, owners: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, work: mutable usize&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid or owners.count != name_count
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
            key: (complete: bool, hash: u32) = proof_source_conversion_scope_expression_key_hash(head, name, work)
            return (false, 2, name_count) if not key.complete
            slot: mutable usize = (key.hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, head, name, names, owners, hashes, values, counts, name_count, work|:
                return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == key.hash:
                    current_name: sview = names[current]
                    return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, sview_len(current_name))
                    if current_name == name and proof_source_conversion_scope_matches_owner(head, owners[current], sview_len(owners[current]), work, 0):
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_replay_call_conversion_scoped_owner_lookup(name: sview, owner: sview, names: darray[sview]&, owners: darray[sview]&, hashes: darray[u32]&, values: darray[usize]&, counts: darray[usize]&, valid: bool, work: mutable usize&) -> (complete: bool, count: usize, row: usize):
            name_count: usize = names.count
            return (false, 2, name_count) if:
                not valid or owners.count != name_count
                hashes.count != values.count or hashes.count != counts.count
            return (true, 0, name_count) if name_count == 0 and hashes.count == 0
            expected_capacity: usize = proof_name_index_capacity(name_count)
            return (false, 2, name_count) if name_count == 0 or expected_capacity == 0 or hashes.count != expected_capacity
            key: (complete: bool, hash: u32) = proof_source_conversion_scope_key_hash(owner, name, work)
            return (false, 2, name_count) if not key.complete
            slot: mutable usize = (key.hash.i64() % hashes.count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, key, owner, name, names, owners, hashes, values, counts, name_count, work|:
                return (false, 2, name_count) if not proof_replay_call_conversion_alias_work_add(work, 1)
                current: usize = values[slot]
                return (true, 0, name_count) if current == name_count
                return (false, 2, name_count) if current > name_count
                if hashes[slot] == key.hash:
                    current_name: sview = names[current]
                    current_owner: sview = owners[current]
                    return (false, 2, name_count) if:
                        not proof_replay_call_conversion_alias_work_add(work, sview_len(current_name))
                        not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
                        not proof_replay_call_conversion_alias_work_add(work, sview_len(current_owner))
                        not proof_replay_call_conversion_alias_work_add(work, sview_len(owner))
                    if current_name == name and current_owner == owner:
                        return (false, 2, name_count) if counts[slot] == 0
                        return (true, counts[slot], current)
                slot <- (slot + 1) % hashes.count
                probes <- probes + 1
            return (false, 2, name_count)

        def proof_replay_call_conversion_generic_root(head: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_replay_call_conversion_alias_work_add(work, 1)
            match head:
                Ast::Expr.Ident(name, _):
                    return (false, "") if not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
                    return (true, name)
                Ast::Expr.Scope(parent, _, _):
                    return proof_replay_call_conversion_generic_root(parent, work, depth + 1)
                _:
                    return (true, "")

        def proof_replay_call_conversion_module_alias_root(name: sview, caller_owner: sview, caller_owner_known: bool, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, name: sview):
            if not call_target.selection.module_aliases_attempted:
                call_target.selection.module_aliases_attempted <- true
                built: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_module_alias_index(call_target.selection.source_annotations, &call_target.selection.module_aliases, work)
                return (false, "") if not built.complete
            aliases: ProofModuleAliasIndex& = call_target.selection.module_aliases
            return (false, "") if not aliases.complete
            resolved: mutable sview = name
            seen: mutable darray[sview] = []
            steps: mutable usize = 0
            while steps <= aliases.names.count |steps, aliases, resolved, seen, work|:
                if caller_owner_known:
                    lexical: (complete: bool, matched: bool, valid: bool, target: sview, scope: sview) = proof_module_alias_target(aliases, caller_owner, resolved, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return (false, "") if not lexical.complete
                    if lexical.matched:
                        return (false, "") if not lexical.valid
                        compatible: (complete: bool, compatible: bool, target: sview) = proof_module_alias_targets_compatible(aliases, lexical.scope, lexical.target, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return (false, "") if not compatible.complete or not compatible.compatible
                        return (true, compatible.target)
                lookup: (complete: bool, matched: bool, valid: bool, row: usize) = proof_module_alias_lookup_global(aliases, resolved, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return (false, "") if not lookup.complete
                return (true, resolved) if not lookup.matched
                return (false, "") if not lookup.valid or lookup.row >= aliases.targets.count
                for active in seen |active, resolved, work|:
                    return (false, "") if not proof_replay_call_conversion_alias_work_add(work, 1) or not proof_replay_call_conversion_alias_work_add(work, sview_len(active)) or not proof_replay_call_conversion_alias_work_add(work, sview_len(resolved)) or active == resolved
                seen.push(resolved)
                next: sview = aliases.targets[lookup.row]
                return (false, "") if next == "" or not proof_replay_call_conversion_alias_work_add(work, sview_len(next))
                resolved <- next
                steps <- steps + 1
            return (false, "")

        def proof_replay_call_conversion_module_alias_head(head: Ast::Expr, caller_owner: sview, caller_owner_known: bool, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, head: Ast::Expr):
            match head:
                Ast::Expr.Ident(name, position):
                    resolved: (complete: bool, name: sview) = proof_replay_call_conversion_module_alias_root(name, caller_owner, caller_owner_known, call_target, work)
                    return (false, Ast::Expr.Invalid) if not resolved.complete
                    return (true, head) if resolved.name == name
                    return (true, Ast::Expr.Ident(resolved.name, position))
                Ast::Expr.Scope(parent, member, position):
                    normalized_parent: (complete: bool, head: Ast::Expr) = proof_replay_call_conversion_module_alias_head(parent, caller_owner, caller_owner_known, call_target, work)
                    return (true, Ast::Expr.Scope(normalized_parent.head, member, position)) if normalized_parent.complete
                    return (false, Ast::Expr.Invalid)
                _:
                    return (true, head)

        def proof_replay_call_conversion_generic_name(name: sview, active_function_line: u32, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, count: usize):
            # The generic binder check is about the function whose call site is being
            # replayed. Alias expansion carries the alias declaration line separately;
            # accepting that line here could miss a same-named caller generic.
            return (false, 0) if active_function_line == 0
            lookup: (complete: bool, present: bool) = proof_replay_call_generic_param_name(name, active_function_line, call_target, work)
            return (lookup.complete, 1 if lookup.present else 0)

        # Keep aligned with Stage1's names resolved before aliases in
        # annotation_ident_value_type; this is intentionally narrower than the
        # generic proof-kernel builtin predicate.
        def proof_replay_call_conversion_builtin_type_name(name: sview) -> bool:
            return proof_stage1_annotation_builtin_type_name(name)

        def proof_replay_call_conversion_alias_target(name: sview, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr):
            alias_count: usize = call_target.aliases.field_conversion_alias_names.count
            return (false, 2, alias_count, Ast::Expr.Invalid) if not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
            return (false, 2, alias_count, Ast::Expr.Invalid) if alias_count != call_target.aliases.field_conversion_alias_targets.count or alias_count != call_target.aliases.field_conversion_alias_lines.count or alias_count != call_target.aliases.field_conversion_alias_owners.count
            alias: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_name_lookup(name, call_target.aliases.field_conversion_alias_names, call_target.aliases.field_conversion_alias_index_hashes, call_target.aliases.field_conversion_alias_index_values, call_target.aliases.field_conversion_alias_index_counts, call_target.aliases.field_conversion_alias_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
            nominal: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_name_lookup(name, call_target.types.field_conversion_declared_types, call_target.types.field_conversion_declared_type_index_hashes, call_target.types.field_conversion_declared_type_index_values, call_target.types.field_conversion_declared_type_index_counts, call_target.types.field_conversion_declared_type_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid) if:
                not nominal.complete
                alias.count == 0 and nominal.count > 0 and proof_replay_call_conversion_builtin_type_name(name)
            return (true, 0, alias_count, Ast::Expr.Invalid) if alias.count == 0
            return (false, 2, alias_count, Ast::Expr.Invalid) if:
                nominal.count > 0 or proof_replay_call_conversion_builtin_type_name(name)
                call_target.aliases.field_conversion_alias_has_formals.count != alias_count
            return (true, 0, alias_count, Ast::Expr.Invalid) if call_target.aliases.field_conversion_alias_has_formals[alias.row]
            return (true, 1, alias.row, call_target.aliases.field_conversion_alias_targets[alias.row])

        def proof_replay_call_conversion_qualified_alias_target(head: Ast::Expr, name: sview, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal_count: usize):
            alias_count: usize = call_target.aliases.field_conversion_alias_names.count
            alias: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_scoped_lookup(name, head, call_target.aliases.field_conversion_alias_names, call_target.aliases.field_conversion_alias_owners, call_target.aliases.field_conversion_alias_scope_index_hashes, call_target.aliases.field_conversion_alias_scope_index_values, call_target.aliases.field_conversion_alias_scope_index_counts, call_target.aliases.field_conversion_alias_scope_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid, 0) if not alias.complete or alias.count > 1
            nominal: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_scoped_lookup(name, head, call_target.types.field_conversion_declared_types, call_target.types.field_conversion_declared_type_owners, call_target.types.field_conversion_declared_type_scope_index_hashes, call_target.types.field_conversion_declared_type_scope_index_values, call_target.types.field_conversion_declared_type_scope_index_counts, call_target.types.field_conversion_declared_type_scope_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid, 0) if not nominal.complete
            return (true, 0, alias_count, Ast::Expr.Invalid, nominal.count) if alias.count == 0
            return (false, 2, alias_count, Ast::Expr.Invalid, nominal.count) if call_target.aliases.field_conversion_alias_has_formals.count != alias_count or call_target.aliases.field_conversion_alias_lines.count != alias_count or alias.row >= alias_count
            return (false, 2, alias_count, Ast::Expr.Invalid, nominal.count) if call_target.aliases.field_conversion_alias_has_formals[alias.row]
            return (true, 1, alias.row, call_target.aliases.field_conversion_alias_targets[alias.row], nominal.count)

        def proof_replay_call_conversion_alias_target_in_owner(name: sview, owner: sview, call_target: ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool):
            alias_count: usize = call_target.aliases.field_conversion_alias_names.count
            return (false, 2, alias_count, Ast::Expr.Invalid, false, false) if not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
            aliases: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_scoped_owner_lookup(name, owner, call_target.aliases.field_conversion_alias_names, call_target.aliases.field_conversion_alias_owners, call_target.aliases.field_conversion_alias_scope_index_hashes, call_target.aliases.field_conversion_alias_scope_index_values, call_target.aliases.field_conversion_alias_scope_index_counts, call_target.aliases.field_conversion_alias_scope_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid, false, false) if not aliases.complete or aliases.count > 1
            nominals: (complete: bool, count: usize, row: usize) = proof_replay_call_conversion_scoped_owner_lookup(name, owner, call_target.types.field_conversion_declared_types, call_target.types.field_conversion_declared_type_owners, call_target.types.field_conversion_declared_type_scope_index_hashes, call_target.types.field_conversion_declared_type_scope_index_values, call_target.types.field_conversion_declared_type_scope_index_counts, call_target.types.field_conversion_declared_type_scope_index_valid, work)
            return (false, 2, alias_count, Ast::Expr.Invalid, false, false) if not nominals.complete or nominals.count > 1
            # The compiler gives exact module aliases precedence over that module's
            # concrete declarations, but root concrete declarations precedence over aliases.
            return (true, 0, alias_count, Ast::Expr.Absent, true, true) if owner == "" and nominals.count == 1
            return (true, 0, alias_count, Ast::Expr.Absent, true, true) if owner != "" and aliases.count == 0 and nominals.count == 1
            return (true, 0, alias_count, Ast::Expr.Absent, false, false) if aliases.count == 0
            return (false, 2, alias_count, Ast::Expr.Invalid, false, false) if:
                alias_count != call_target.aliases.field_conversion_alias_targets.count or alias_count != call_target.aliases.field_conversion_alias_has_formals.count or aliases.row >= alias_count
            return (true, 0, alias_count, Ast::Expr.Absent, false, true) if call_target.aliases.field_conversion_alias_has_formals[aliases.row]
            return (true, 1, aliases.row, call_target.aliases.field_conversion_alias_targets[aliases.row], false, true)

        def proof_replay_call_conversion_alias_expand(row: usize, target: Ast::Expr, call_target: mutable ProofReplayCallSiteTarget&, seen: mutable darray[usize]&, work: mutable usize&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if row >= call_target.aliases.field_conversion_alias_lines.count or call_target.aliases.field_conversion_alias_lines.count != call_target.aliases.field_conversion_alias_names.count or call_target.aliases.field_conversion_alias_owners.count != call_target.aliases.field_conversion_alias_names.count or target is Ast::Expr.Invalid or target is Ast::Expr.Absent
            for active in seen |active, row, work|:
                return (false, Ast::Expr.Invalid) if:
                    not proof_replay_call_conversion_alias_work_add(work, 1)
                    active == row
            mark: usize = seen.count
            return (false, Ast::Expr.Invalid) if not proof_replay_call_conversion_alias_work_add(work, 1)
            seen.push(row)
            # Generic shadowing applies to explicit call-site syntax. Once an alias is entered,
            # bare names in its RHS resolve in the alias's declaring module.
            expanded: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(target, call_target.aliases.field_conversion_alias_lines[row], false, call_target.aliases.field_conversion_alias_owners[row], call_target, seen, work, depth + 1)
            seen.resize(mark)
            return expanded

        def proof_replay_call_conversion_type_alias_unwrap(expression: Ast::Expr, declaration_line: u32, check_caller_generics: bool, resolution_owner: sview, call_target: mutable ProofReplayCallSiteTarget&, seen: mutable darray[usize]&, work: mutable usize&, depth: usize) -> (complete: bool, type_expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if depth >= PROOF_SOURCE_CONVERSION_ALIAS_DEPTH_LIMIT or not proof_replay_call_conversion_alias_work_add(work, 1)
            caller_owner: sview = call_target.generics.field_conversion_generic_param_owner if check_caller_generics and resolution_owner == "" else resolution_owner
            caller_owner_known: bool = (call_target.generics.field_conversion_generic_param_owner_known if resolution_owner == "" else true) if check_caller_generics else true
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, Ast::Expr.Invalid) if not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
                    if check_caller_generics:
                        generic: (complete: bool, count: usize) = proof_replay_call_conversion_generic_name(name, call_target.generics.field_conversion_generic_param_line, call_target, work)
                        return (false, Ast::Expr.Invalid) if not generic.complete or generic.count > 0
                    # Stage1 resolves scalar and builtin names before consulting aliases.
                    # Keep this rule for bare names only; qualified paths are handled below.
                    return (true, expression) if proof_replay_call_conversion_builtin_type_name(name)
                    if caller_owner_known:
                        owner_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_replay_call_conversion_alias_target_in_owner(name, caller_owner, call_target, work)
                        return (false, Ast::Expr.Invalid) if not owner_target.complete or (owner_target.nominal and proof_replay_call_conversion_builtin_type_name(name))
                        return (true, expression) if owner_target.nominal
                        if owner_target.count == 1:
                            return proof_replay_call_conversion_alias_expand(owner_target.row, owner_target.target, call_target, seen, work, depth)
                        return (true, expression) if owner_target.blocks_parent
                        # Stage1 checks the exact owner, then root declarations. It does not
                        # search enclosing module aliases before root aliases or global types.
                        if caller_owner != "":
                            root_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_replay_call_conversion_alias_target_in_owner(name, "", call_target, work)
                            return (false, Ast::Expr.Invalid) if not root_target.complete or (root_target.nominal and proof_replay_call_conversion_builtin_type_name(name))
                            return (true, expression) if root_target.nominal
                            return proof_replay_call_conversion_alias_expand(root_target.row, root_target.target, call_target, seen, work, depth) if root_target.count == 1
                            return (true, expression) if root_target.blocks_parent
                        # Stage1's final legacy fallback accepts a globally unique alias only
                        # after concrete type registries have failed to resolve the spelling.
                        global_alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_replay_call_conversion_alias_target(name, call_target, work)
                        return (false, Ast::Expr.Invalid) if not global_alias.complete or global_alias.count > 1
                        return (true, expression) if global_alias.count == 0
                        return proof_replay_call_conversion_alias_expand(global_alias.row, global_alias.target, call_target, seen, work, depth)
                    # This path has no caller module owner, so require a globally unique alias
                    # before expanding.
                    alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_replay_call_conversion_alias_target(name, call_target, work)
                    return (false, Ast::Expr.Invalid) if not alias.complete or alias.count > 1
                    return (true, expression) if alias.count == 0
                    return (false, Ast::Expr.Invalid) if alias.row >= call_target.aliases.field_conversion_alias_owners.count or call_target.aliases.field_conversion_alias_owners.count != call_target.aliases.field_conversion_alias_names.count
                    return proof_replay_call_conversion_alias_expand(alias.row, alias.target, call_target, seen, work, depth)
                Ast::Expr.Scope(head, name, position):
                    root: (complete: bool, name: sview) = proof_replay_call_conversion_generic_root(head, work, 0)
                    return (false, Ast::Expr.Invalid) if not root.complete
                    if root.name != "" and check_caller_generics:
                        generic: (complete: bool, count: usize) = proof_replay_call_conversion_generic_name(root.name, call_target.generics.field_conversion_generic_param_line, call_target, work)
                        return (false, Ast::Expr.Invalid) if not generic.complete or generic.count > 0
                    caller_owner: sview = call_target.generics.field_conversion_generic_param_owner if check_caller_generics and resolution_owner == "" else resolution_owner
                    caller_owner_known: bool = (call_target.generics.field_conversion_generic_param_owner_known if resolution_owner == "" else true) if check_caller_generics else true
                    normalized_head: (complete: bool, head: Ast::Expr) = proof_replay_call_conversion_module_alias_head(head, caller_owner, caller_owner_known, call_target, work)
                    return (false, Ast::Expr.Invalid) if not normalized_head.complete
                    alias: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal_count: usize) = proof_replay_call_conversion_qualified_alias_target(normalized_head.head, name, call_target, work)
                    return (false, Ast::Expr.Invalid) if not alias.complete
                    return proof_replay_call_conversion_alias_expand(alias.row, alias.target, call_target, seen, work, depth) if alias.count == 1
                    return (false, Ast::Expr.Invalid) if alias.nominal_count > 1
                    return (true, expression) if alias.nominal_count == 1
                    if check_caller_generics:
                        generic_leaf: (complete: bool, count: usize) = proof_replay_call_conversion_generic_name(name, call_target.generics.field_conversion_generic_param_line, call_target, work)
                        return (false, Ast::Expr.Invalid) if not generic_leaf.complete
                        return (true, expression) if generic_leaf.count > 0
                    return (false, Ast::Expr.Invalid) if not proof_replay_call_conversion_alias_work_add(work, sview_len(name))
                    return (true, Ast::Expr.Ident(name, position)) if proof_replay_call_conversion_builtin_type_name(name)
                    simple_module_head: bool = match normalized_head.head:
                        Ast::Expr.Ident(_, _): true
                        _: false
                    if simple_module_head:
                        root_target: (complete: bool, count: usize, row: usize, target: Ast::Expr, nominal: bool, blocks_parent: bool) = proof_replay_call_conversion_alias_target_in_owner(name, "", call_target, work)
                        return (false, Ast::Expr.Invalid) if not root_target.complete
                        return (true, expression) if root_target.nominal
                        return proof_replay_call_conversion_alias_expand(root_target.row, root_target.target, call_target, seen, work, depth) if root_target.count == 1
                        return (false, Ast::Expr.Invalid) if root_target.count != 0 or root_target.blocks_parent
                        # Stage1's last alias fallback is global and unique. The helper
                        # also declines when any concrete type could take precedence.
                        global_alias: (complete: bool, count: usize, row: usize, target: Ast::Expr) = proof_replay_call_conversion_alias_target(name, call_target, work)
                        return (false, Ast::Expr.Invalid) if not global_alias.complete or global_alias.count > 1
                        return (true, expression) if global_alias.count == 0
                        return proof_replay_call_conversion_alias_expand(global_alias.row, global_alias.target, call_target, seen, work, depth)
                    return (false, Ast::Expr.Invalid)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_call_conversion_type_alias_unwrap(inner, declaration_line, check_caller_generics, caller_owner, call_target, seen, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_call_conversion_type_alias_unwrap(inner, declaration_line, check_caller_generics, caller_owner, call_target, seen, work, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return (true, expression)
                Ast::Expr.Index(head, element, position):
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(head, declaration_line, check_caller_generics, caller_owner, call_target, seen, work, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_head.complete
                    unwrapped_element: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(element, declaration_line, check_caller_generics, caller_owner, call_target, seen, work, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_element.complete
                    return (true, Ast::Expr.Index(unwrapped_head.type_expression, unwrapped_element.type_expression, position))
                Ast::Expr.IndexN(head, arguments, position):
                    unwrapped_head: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(head, declaration_line, check_caller_generics, caller_owner, call_target, seen, work, depth + 1)
                    return (false, Ast::Expr.Invalid) if not unwrapped_head.complete
                    unwrapped_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |call_target, seen, unwrapped_arguments, work, depth, check_caller_generics, caller_owner|:
                        unwrapped: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(argument, declaration_line, check_caller_generics, caller_owner, call_target, seen, work, depth + 1)
                        return (false, Ast::Expr.Invalid) if not unwrapped.complete
                        unwrapped_arguments.push(unwrapped.type_expression)
                    return (true, Ast::Expr.IndexN(unwrapped_head.type_expression, unwrapped_arguments, position))
                Ast::Expr.Field(_, _, _):
                    return (false, Ast::Expr.Invalid)
                _:
                    return (true, expression)
