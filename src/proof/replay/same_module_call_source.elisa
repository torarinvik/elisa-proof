# Reconstruct the producer's qualification of a bare same-module call.
# Only the callee spelling changes; arguments and the exact span remain intact.
extend ElisaProof:
    private:
        # Using/from annotations have no resolved-callee witness in replay. Charge each
        # possible name/owner comparison by the full annotation spelling before checking it.
        def proof_replay_same_module_unresolved_imports_with_work(annotations: darray[Ast::EnumAnnotation]&, work: mutable usize&) -> (complete: bool, unresolved: bool):
            for annotation in annotations |annotation, work|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1, work)
                name: sview = annotation.name
                for _ in 0..<6 |name, work|:
                    return (false, false) if:
                        not proof_replay_source_work_charge_or_exhaust(1, work)
                        not proof_replay_source_work_charge_or_exhaust(sview_len(name), work)
                owner: sview = annotation.owner
                for _ in 0..<2 |owner, work|:
                    return (false, false) if:
                        not proof_replay_source_work_charge_or_exhaust(1, work)
                        not proof_replay_source_work_charge_or_exhaust(sview_len(owner), work)
                # Stored spelling bytes and comparison steps were charged above. Reserve
                # the fixed bytes of all six name and two owner marker spellings as well.
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(PROOF_REPLAY_IMPORT_MARKER_COMPARE_WORK - 8, work)
                match name:
                    "__using" | "__using_alias" | "__using_alias_target" | "__using_member" | "__binding_wildcard_import" | "__from_decl":
                        return (true, true)
                    _:
                        pass
                match owner:
                    "__from_member" | "__from_src":
                        return (true, true)
                    _:
                        pass
            return (true, false)

        def proof_replay_same_module_bare_call_with_work(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&) -> (known: bool, call: Ast::Expr):
            unknown: (known: bool, call: Ast::Expr) = (false, Ast::Expr.Invalid)
            match call:
                Ast::Expr.Call(Ast::Expr.Scope(base, name, callee_position), arguments, labels, position):
                    unresolved_imports: (complete: bool, unresolved: bool) = proof_replay_same_module_unresolved_imports_with_work(report.source.source_annotations, work)
                    return unknown if not unresolved_imports.complete or unresolved_imports.unresolved
                    owner: mutable sview = ""
                    owners: mutable usize = 0
                    return unknown if:
                        not proof_replay_summary_function_owner_module(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, "", &owner, &owners, work, 0)
                        not proof_replay_source_work_charge_or_exhaust(sview_len(owner), work)
                        not proof_replay_summary_expr_charge_with_work(base, work)
                        owners != 1 or owner == "" or not proof_replay_exact_module_path_matches_owner(owner, base)
                    same_module_count: mutable usize = 0
                    return unknown if not proof_replay_summary_same_module_name_count(report.source.source_declarations, name, owner, "", &same_module_count, work, 0) or same_module_count != 1
                    body: mutable darray[Ast::Stmt] = []
                    return unknown if not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &body, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    # The source call is qualified, but rewriting it to a bare name is safe
                    # only where no live local binding shadows the member spelling.
                    return unknown if:
                        proof_replay_local_binding_parameter_name_present_with_default_limit(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, name, work, 0)
                        not proof_replay_source_call_locals_unshadowed_at_with_work(body, report.source.source_annotations, call, work)
                    return (true, Ast::Expr.Call(Ast::Expr.Ident(name, callee_position), arguments, labels, position))
                _:
                    return unknown
