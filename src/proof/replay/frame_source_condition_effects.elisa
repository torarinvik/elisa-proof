extend ElisaProofFrameSource:
    public:
        struct CallEffect:
            position: Ast::Pos
            change_index: usize
            place: ElisaProofKernelFramePolicy::Place

    private:
        def condition_effects_walk(expression: Ast::Expr, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, formals: darray[sview]&, types: darray[Ast::Expr]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, depth: usize, work: mutable usize&, expression_work: mutable usize&, effects: mutable darray[CallEffect]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= 64 or expression_work >= 4096 or not replay_work_charge(1, work)
            expression_work <- expression_work + 1
            match expression:
                Ast::Expr.Call(_, arguments, _, position):
                    # Arguments must be independently call-free scalar values.
                    # Nested calls need their own evaluation-order inventory.
                    for argument in arguments |formals, types, depth, work|:
                        return false if not scalar_value(argument, formals, types, depth + 1, work)
                    invocation = source_call_with_work(declarations, annotations, name, line, position, work)
                    return false if not invocation.known
                    callee = owner_with_work(declarations, invocation.callee, invocation.callee_line, work)
                    return false if not callee.known or not contract_scalar_type_with_work(callee.return_type, work)
                    mapping = (source_call_changes_with_work(declarations, annotations, name, line, position, tokens, source, source_length, work) can Global{Read,Write})
                    return false if not mapping.known
                    return false if not replay_work_charge(mapping.places.count, work)
                    for index in 0..<mapping.places.count |index, mapping, effects, position|:
                        return false if effects.count >= 4096
                        effects.push(CallEffect{position: position, change_index: index, place: mapping.places[index]})
                    return true
                Ast::Expr.Paren(inner, _):
                    return (condition_effects_walk(inner, declarations, annotations, name, line, formals, types, tokens, source, source_length, depth + 1, work, expression_work, effects) can Global{Read,Write})
                Ast::Expr.Unary(operator, inner, _):
                    return false if operator != TokenKind.Not and operator != TokenKind.Plus and operator != TokenKind.Minus
                    return (condition_effects_walk(inner, declarations, annotations, name, line, formals, types, tokens, source, source_length, depth + 1, work, expression_work, effects) can Global{Read,Write})
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or
                    return false if not (condition_effects_walk(left, declarations, annotations, name, line, formals, types, tokens, source, source_length, depth + 1, work, expression_work, effects) can Global{Read,Write})
                    before_right: usize = effects.count
                    return false if not (condition_effects_walk(right, declarations, annotations, name, line, formals, types, tokens, source, source_length, depth + 1, work, expression_work, effects) can Global{Read,Write})
                    # A skipped pure call adds no physical-write event. A skipped
                    # effectful call must not be claimed to have certainly run.
                    return false if (operator == TokenKind.And or operator == TokenKind.Or) and effects.count != before_right
                    return true
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    # The condition always runs; exactly one arm runs. Record every
                    # arm's possible call separately so each site must satisfy the
                    # same frame policy. This is an intentional conservative union:
                    # it never treats an arm call as an unconditional state update.
                    return false if not (condition_effects_walk(condition, declarations, annotations, name, line, formals, types, tokens, source, source_length, depth + 1, work, expression_work, effects) can Global{Read,Write})
                    return false if not (condition_effects_walk(then_expression, declarations, annotations, name, line, formals, types, tokens, source, source_length, depth + 1, work, expression_work, effects) can Global{Read,Write})
                    return (condition_effects_walk(else_expression, declarations, annotations, name, line, formals, types, tokens, source, source_length, depth + 1, work, expression_work, effects) can Global{Read,Write})
                _:
                    return scalar_read(expression, formals, types, depth + 1, work)

    public:
        # The condition is recovered from the original owner's statement ordinal;
        # callers cannot substitute a producer expression or omit an operand.
        def source_condition_effects(declarations: darray[Ast::Decl]&, name: sview, line: u32, statement_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> (known: bool, effects: darray[CallEffect]) can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (source_condition_effects_with_work(declarations, [], name, line, statement_index, tokens, source, source_length, &work) can Global{Read,Write})

        def source_condition_effects_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, statement_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, effects: darray[CallEffect]) can[Memory.Allocate, Abort.Panic]:
            context = owner_with_work(declarations, name, line, work)
            return (false, []) if not context.known or statement_index >= context.body.count
            return (false, []) if not contract_environment(declarations, 0, work)
            names: mutable darray[sview] = []
            types: mutable darray[Ast::Expr] = []
            return (false, []) if not replay_work_charge(context.formals.count, work)
            names.extend(context.formals)
            types.extend(context.formal_types)
            return (false, []) if not replay_work_charge(statement_index, work)
            for index in 0..<statement_index |index, context, names, types|:
                match context.body[index]:
                    Ast::Stmt.VarDecl(binding, declared_type, _, _):
                        return (false, []) if not contract_scalar_type_with_work(declared_type, work)
                        return (false, []) if not replay_work_charge(names.count, work)
                        for existing in names |binding|:
                            return (false, []) if not replay_work_charge(sview_len(existing), work)
                            return (false, []) if not replay_work_charge(sview_len(binding), work)
                            return (false, []) if existing == binding
                        names.push(binding)
                        types.push(declared_type)
                    _:
                        pass
            expression_work: mutable usize = 0
            effects: mutable darray[CallEffect] = []
            match context.body[statement_index]:
                Ast::Stmt.If(condition, _, _, _):
                    return (false, []) if not (condition_effects_walk(condition, declarations, annotations, name, line, &names, &types, tokens, source, source_length, 0, work, &expression_work, &effects) can Global{Read,Write})
                    return (true, effects)
                Ast::Stmt.VarDecl(_, declared_type, expression, _):
                    return (false, []) if not contract_scalar_type_with_work(declared_type, work)
                    match expression:
                        Ast::Expr.Call(_, _, _, position):
                            invocation = source_call_with_work(declarations, annotations, name, line, position, work)
                            return (false, []) if not invocation.known
                            callee = owner_with_work(declarations, invocation.callee, invocation.callee_line, work)
                            match declared_type:
                                Ast::Expr.Ident(expected, _):
                                    match callee.return_type:
                                        Ast::Expr.Ident(actual, _):
                                            return (false, []) if not replay_work_charge(sview_len(expected), work)
                                            return (false, []) if not replay_work_charge(sview_len(actual), work)
                                            return (false, []) if not callee.known or expected != actual
                                        _:
                                            return (false, [])
                                _:
                                    return (false, [])
                        _:
                            pass
                    return (false, []) if not (condition_effects_walk(expression, declarations, annotations, name, line, &names, &types, tokens, source, source_length, 0, work, &expression_work, &effects) can Global{Read,Write})
                    return (true, effects)
                _:
                    return (false, [])

        # Returning an effectful call evaluates its complete scalar return expression
        # before the caller exits. Recover that expression from the original statement
        # ordinal and reuse the same exact call-site and frame-change reconstruction as
        # conditional expressions.
        def source_return_effects_with_work(body: darray[Ast::Stmt]&, statement_index: usize, declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, names: darray[sview]&, types: darray[Ast::Expr]&, return_type: Ast::Expr, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, effects: darray[CallEffect]) can[Memory.Allocate, Abort.Panic]:
            return (false, []) if statement_index >= body.count or names.count != types.count
            return (false, []) if not contract_scalar_type_with_work(return_type, work)
            expression_work: mutable usize = 0
            effects: mutable darray[CallEffect] = []
            match body[statement_index]:
                Ast::Stmt.Return(expression, _):
                    return (false, []) if not (condition_effects_walk(expression, declarations, annotations, name, line, names, types, tokens, source, source_length, 0, work, &expression_work, &effects) can Global{Read,Write})
                    return (true, effects)
                _:
                    return (false, [])
