include "./same_module_call_source.elisa"
include "./signed_call_snapshots.elisa"
include "./typed_call_initializers.elisa"
extend ElisaProof:
    private:

        # Unknown or deep forms refuse, so a later AST constructor cannot bypass this boundary.
        def proof_replay_expression_contains_call_node(expression: Ast::Expr, depth: usize) -> bool:
            return true if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(_, _, _, _) | Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_expression_contains_call_node(object, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_replay_expression_contains_call_node(object, depth + 1) or proof_replay_expression_contains_call_node(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_replay_expression_contains_call_node(object, depth + 1) or proof_replay_expression_contains_call_node(low, depth + 1) or proof_replay_expression_contains_call_node(high, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_expression_contains_call_node(left, depth + 1) or proof_replay_expression_contains_call_node(right, depth + 1)
                Ast::Expr.IndexN(object, elements, _):
                    return true if proof_replay_expression_contains_call_node(object, depth + 1)
                    for element in elements |depth|:
                        return true if proof_replay_expression_contains_call_node(element, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |depth|:
                        return true if proof_replay_expression_contains_call_node(element, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth|:
                        return true if proof_replay_expression_contains_call_node(entry.key, depth + 1) or proof_replay_expression_contains_call_node(entry.value, depth + 1)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_replay_expression_contains_call_node(base, depth + 1)
                    for field in fields |depth|:
                        return true if proof_replay_expression_contains_call_node(field.value, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return proof_replay_expression_contains_call_node(condition, depth + 1) or proof_replay_expression_contains_call_node(yes, depth + 1) or proof_replay_expression_contains_call_node(no, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return proof_replay_expression_contains_call_node(iterable, depth + 1) or proof_replay_expression_contains_call_node(condition, depth + 1) or proof_replay_expression_contains_call_node(value, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_replay_expression_contains_call_node(base, depth + 1) or proof_replay_expression_contains_call_node(predicate, depth + 1)
                Ast::Expr.Match(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _):
                    return true
                _:
                    return true
            return false

        # Rebuild deterministic call sites from caller source, not the trace payload. The
        # matcher charges each candidate comparison through the source walk's shared counter.
        def proof_replay_deterministic_call_source_contains_bounded(expression: Ast::Expr, expected: Ast::Expr, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            if depth >= 96 or work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                complete <- false
                return false
            work <- work + 1
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    candidate_matches: bool = proof_replay_deterministic_call_expression_equal_with_work(expression, expected, work, complete, depth)
                    return true if candidate_matches
                    complete_now: bool = complete
                    return false if not complete_now
                    if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                        complete <- false
                        return false
                    return true if proof_replay_deterministic_call_source_contains_any_bounded(arguments, expected, work, complete, depth + 1)
                    return proof_replay_deterministic_call_source_contains_bounded(callee, expected, work, complete, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |expected, work, complete, depth|:
                        if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                            complete <- false
                            return false
                        work <- work + 1
                        return true if proof_replay_deterministic_call_source_contains_any_bounded(candidate.captures, expected, work, complete, depth + 1)
                        return false if not complete
                    return true if proof_replay_deterministic_call_source_contains_any_bounded(arguments, expected, work, complete, depth + 1)
                    return false
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_deterministic_call_source_contains_bounded(inner, expected, work, complete, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_deterministic_call_source_contains_bounded(left, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(right, expected, work, complete, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                    return proof_replay_deterministic_call_source_contains_bounded(object, expected, work, complete, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_replay_deterministic_call_source_contains_bounded(object, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(index, expected, work, complete, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_replay_deterministic_call_source_contains_bounded(object, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(low, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(high, expected, work, complete, depth + 1)
                Ast::Expr.IndexN(object, elements, _):
                    return true if proof_replay_deterministic_call_source_contains_bounded(object, expected, work, complete, depth + 1)
                    return proof_replay_deterministic_call_source_contains_any_bounded(elements, expected, work, complete, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    return proof_replay_deterministic_call_source_contains_any_bounded(elements, expected, work, complete, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, expected, work, complete, depth|:
                        if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                            complete <- false
                            return false
                        work <- work + 1
                        return true if proof_replay_deterministic_call_source_contains_bounded(entry.key, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(entry.value, expected, work, complete, depth + 1)
                    return false
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_replay_deterministic_call_source_contains_bounded(base, expected, work, complete, depth + 1)
                    for field in fields |field, expected, work, complete, depth|:
                        if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                            complete <- false
                            return false
                        work <- work + 1
                        return true if proof_replay_deterministic_call_source_contains_bounded(field.value, expected, work, complete, depth + 1)
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return proof_replay_deterministic_call_source_contains_bounded(iterable, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(condition, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(value, expected, work, complete, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_replay_deterministic_call_source_contains_bounded(base, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(predicate, expected, work, complete, depth + 1)
                Ast::Expr.Match(value, arms, _) | Ast::Expr.Catch(value, arms, _):
                    return true if proof_replay_deterministic_call_source_contains_bounded(value, expected, work, complete, depth + 1)
                    for arm in arms |arm, expected, work, complete, depth|:
                        if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                            complete <- false
                            return false
                        work <- work + 1
                        return true if proof_replay_deterministic_call_source_contains_bounded(arm.guard, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_statements_bounded(arm.body, expected, work, complete, depth + 1)
                    return false
                Ast::Expr.If(condition, yes, no, _):
                    return proof_replay_deterministic_call_source_contains_bounded(condition, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(yes, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(no, expected, work, complete, depth + 1)
                Ast::Expr.GetElse(value, recovery, _):
                    return proof_replay_deterministic_call_source_contains_bounded(value, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_statements_bounded(recovery, expected, work, complete, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_replay_deterministic_call_source_contains_statements_bounded(statements, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(value, expected, work, complete, depth + 1)
                Ast::Expr.Lambda(_, statements, _):
                    return proof_replay_deterministic_call_source_contains_statements_bounded(statements, expected, work, complete, depth + 1)
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Invalid:
                    complete <- false
                    return false
                _:
                    complete <- false
                    return false

        def proof_replay_deterministic_call_source_contains_statements(statements: darray[Ast::Stmt]&, expected: Ast::Expr, depth: usize) -> bool:
            work: mutable usize = 0
            complete: mutable bool = true
            found: bool = proof_replay_deterministic_call_source_contains_statements_bounded(statements, expected, &work, &complete, depth)
            return complete and found

        def proof_replay_deterministic_call_source_contains_statements_bounded(statements: darray[Ast::Stmt]&, expected: Ast::Expr, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            if depth >= 96 or work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                complete <- false
                return false
            for statement in statements |expected, work, complete, depth|:
                if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                    complete <- false
                    return false
                work <- work + 1
                match statement:
                    Ast::Stmt.VarDecl(_, _, value, _) | Ast::Stmt.Expr(value, _) | Ast::Stmt.Return(value, _) | Ast::Stmt.Contract(_, value, _):
                        return true if proof_replay_deterministic_call_source_contains_bounded(value, expected, work, complete, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        return true if proof_replay_deterministic_call_source_contains_bounded(target, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_bounded(value, expected, work, complete, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        return true if proof_replay_deterministic_call_source_contains_bounded(condition, expected, work, complete, depth + 1)
                        return true if proof_replay_deterministic_call_source_contains_statements_bounded(yes, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_statements_bounded(no, expected, work, complete, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        return true if proof_replay_deterministic_call_source_contains_bounded(condition, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_statements_bounded(nested, expected, work, complete, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        return true if proof_replay_deterministic_call_source_contains_bounded(iterable, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_statements_bounded(nested, expected, work, complete, depth + 1)
                    Ast::Stmt.Match(value, arms, _):
                        return true if proof_replay_deterministic_call_source_contains_bounded(value, expected, work, complete, depth + 1)
                        for arm in arms |arm, expected, work, complete, depth|:
                            if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                                complete <- false
                                return false
                            work <- work + 1
                            return true if proof_replay_deterministic_call_source_contains_bounded(arm.guard, expected, work, complete, depth + 1) or proof_replay_deterministic_call_source_contains_statements_bounded(arm.body, expected, work, complete, depth + 1)
                        return false
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return true if proof_replay_deterministic_call_source_contains_statements_bounded(nested, expected, work, complete, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        complete <- false
                        return false
            return false

        def proof_replay_deterministic_call_source_contains_any_bounded(expressions: darray[Ast::Expr]&, expected: Ast::Expr, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            if depth >= 96 or work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                complete <- false
                return false
            for expression in expressions |expected, work, complete, depth|:
                if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                    complete <- false
                    return false
                return true if proof_replay_deterministic_call_source_contains_bounded(expression, expected, work, complete, depth + 1)
            return false


        # Compare the marker only with the substituted source call (see deterministic_call_state).
        # A captured block may run with its captures rewritten by enclosing code the walk cannot
        # order, so it starts from a reset.
        def proof_replay_deterministic_call_source_expression(cast_sites: darray[Ast::Expr]&, declarations: darray[Ast::Decl]&, expression: Ast::Expr, expected: Ast::Expr, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            complete: mutable bool = true
            match expression:
                Ast::Expr.Block(statements, block_result, captures, _):
                    names_mark: usize = names.count
                    values_mark: usize = values.count
                    if captures.count > 0:
                        return false if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names_mark, work, &complete)
                    source_line: u32 = Ast::expr_pos(expected).line
                    statement_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(cast_sites, declarations, statements, expected, source_line, names, values, work, depth + 1)
                    return false if not statement_matches.known
                    tail_matches: bool = proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, block_result, expected, source_line, names, values, work, depth + 1)
                    tail_match_count: usize = 1 if tail_matches else 0
                    names.resize(names_mark)
                    values.resize(values_mark)
                    return complete and statement_matches.matches + tail_match_count == 1
                _:
                    pass
            # Another call evaluated in the same expression could write a local the matched call
            # reads, in an order this walk does not model.
            return false if proof_replay_deterministic_expr_writes_with_work(declarations, names, expression, Ast::expr_pos(expected), depth + 1, work, &complete)
            return false if not complete or not proof_replay_deterministic_call_unshadow_reserve(expected, names, work)
            return false if not proof_replay_deterministic_call_site_unshadowed(expected, names, depth + 1)
            return false if not proof_replay_deterministic_call_substitution_reserve(expression, names, values, work)
            resolved: Ast::Expr = proof_replay_substitute_many(expression, names, values)
            marker: Ast::Expr = proof_replay_deterministic_call_marker_resolved(expected, names, values, work, &complete)
            return false if not complete
            found: bool = proof_replay_deterministic_call_source_contains_bounded(resolved, expected, work, &complete, depth + 1)
            return false if not complete or found
            return proof_replay_deterministic_call_source_contains_bounded(resolved, marker, work, &complete, depth + 1) and complete

        def proof_replay_deterministic_call_source_expression_at_line(cast_sites: darray[Ast::Expr]&, declarations: darray[Ast::Decl]&, expression: Ast::Expr, expected: Ast::Expr, line: u32, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            complete: mutable bool = true
            return false if not proof_replay_deterministic_call_expr_contains_expected(expression, expected, work, &complete, depth + 1) or not complete
            return proof_replay_deterministic_call_source_expression(cast_sites, declarations, expression, expected, names, values, work, depth + 1)

        # Bind caller locals in statement order, reconstructing the resolved actuals that the
        # producer placed in the marker at the call's pre-state. Loops and joins that may rewrite
        # state reset every binding; a redeclared (shadowing) name or an unmodelled write target
        # fails closed.
        def proof_replay_deterministic_call_source_statements(cast_sites: darray[Ast::Expr]&, declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, expected: Ast::Expr, line: u32, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, work: mutable usize&, depth: usize) -> (known: bool, matches: usize):
            return (false, 0) if depth >= 96
            no_skip: Ast::Pos = Ast::pos_at_line(0)
            complete: mutable bool = true
            previous_end: mutable u32 = 0
            for statement in body |cast_sites, declarations, expected, line, names, values, work, complete, depth, no_skip, previous_end|:
                return (false, 0) if not proof_replay_deterministic_call_match_charge(1, work, &complete)
                ordering: (valid: bool, after_expected: bool, end_offset: u32) = proof_replay_deterministic_call_statement_order(statement, expected, previous_end, work, &complete)
                return (false, 0) if not ordering.valid or not complete
                return (true, 0) if ordering.after_expected
                previous_end <- ordering.end_offset
                match statement:
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, initializer, expected, line, names, values, work, depth + 1)
                        local_bound: bool = proof_replay_deterministic_call_name_bound_with_work(names, local_name, work, &complete)
                        return (false, 0) if not complete or local_bound
                        return (false, 0) if not proof_replay_deterministic_call_substitution_reserve(initializer, names, values, work)
                        resolved_initializer: Ast::Expr = proof_replay_substitute_many(initializer, names, values)
                        names.push(local_name)
                        if proof_replay_deterministic_call_immutable_type(type_expression):
                            # Count both the cost sizing pass and the legacy call-node visitor.
                            return (false, 0) if not proof_replay_summary_expr_repeat_charge_with_work(resolved_initializer, 1, work)
                            if proof_replay_expression_contains_call_node(resolved_initializer, 0):
                                values.push(Ast::Expr.Absent)
                            else:
                                values.push(resolved_initializer)
                        else:
                            values.push(resolved_initializer)
                        # A source-validated built-in widening cast does not mutate caller
                        # bindings. Other methods still reset all reconstructed values.
                        initializer_skip: mutable Ast::Pos = no_skip
                        for cast_site in cast_sites |cast_site, initializer, initializer_skip, work, complete, depth|:
                            same_cast: bool = proof_replay_deterministic_call_expression_equal_with_work(initializer, cast_site, work, &complete, depth + 1)
                            return (false, 0) if not complete or work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
                            initializer_skip <- Ast::expr_pos(cast_site) if same_cast
                        if proof_replay_deterministic_expr_writes_with_work(declarations, names, initializer, initializer_skip, depth + 1, work, &complete):
                            return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names.count, work, &complete)
                        return (false, 0) if not complete
                    Ast::Stmt.Assign(target, operator, value, position):
                        return (false, 0) if operator != TokenKind.Assign and operator != TokenKind.LArrow
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, value, expected, line, names, values, work, depth + 1)
                        return (false, 0) if not proof_replay_deterministic_call_substitution_reserve(value, names, values, work)
                        resolved_value: Ast::Expr = proof_replay_substitute_many(value, names, values)
                        match target:
                            Ast::Expr.Ident(local_name, _):
                                # A first entry must be a declaration's (marker-side resolution
                                # relies on it): an assigned parameter or global starts opaque.
                                local_bound: bool = proof_replay_deterministic_call_name_bound_with_work(names, local_name, work, &complete)
                                return (false, 0) if not complete
                                if not local_bound:
                                    names.push(local_name)
                                    values.push(Ast::Expr.Absent)
                                names.push(local_name)
                                values.push(resolved_value)
                            _:
                                return (false, 0)
                        if proof_replay_deterministic_expr_writes_with_work(declarations, names, value, no_skip, depth + 1, work, &complete):
                            return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names.count, work, &complete)
                        return (false, 0) if not complete
                    Ast::Stmt.Expr(value, position):
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, value, expected, line, names, values, work, depth + 1)
                        if proof_replay_deterministic_expr_writes_with_work(declarations, names, value, no_skip, depth + 1, work, &complete):
                            return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names.count, work, &complete)
                        return (false, 0) if not complete
                    Ast::Stmt.Return(value, position):
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, value, expected, line, names, values, work, depth + 1)
                    Ast::Stmt.Contract(_, expression, position):
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, expression, expected, line, names, values, work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, position):
                        condition_match: usize = 1 if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, condition, expected, line, names, values, work, depth + 1) else 0
                        names_mark: usize = names.count
                        values_mark: usize = values.count
                        yes_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(cast_sites, declarations, yes, expected, line, names, values, work, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        return (false, 0) if not yes_matches.known
                        no_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(cast_sites, declarations, no, expected, line, names, values, work, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        return (false, 0) if not no_matches.known
                        branch_matches: usize = condition_match + yes_matches.matches + no_matches.matches
                        return (true, branch_matches) if branch_matches > 0
                        # The call follows the join: either branch may have run.
                        condition_writes: bool = proof_replay_deterministic_expr_writes_with_work(declarations, names, condition, no_skip, depth + 1, work, &complete)
                        return (false, 0) if not complete
                        yes_writes: bool = proof_replay_deterministic_statements_write_with_work(declarations, names, yes, depth + 1, work, &complete)
                        return (false, 0) if not complete
                        no_writes: bool = proof_replay_deterministic_statements_write_with_work(declarations, names, no, depth + 1, work, &complete)
                        return (false, 0) if not complete
                        if condition_writes or yes_writes or no_writes:
                            return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names.count, work, &complete)
                            return (false, 0)
                    Ast::Stmt.Match(value, arms, position):
                        value_match: usize = 1 if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, value, expected, line, names, values, work, depth + 1) else 0
                        arm_match_count: mutable usize = value_match
                        arms_write: mutable bool = proof_replay_deterministic_expr_writes_with_work(declarations, names, value, no_skip, depth + 1, work, &complete)
                        return (false, 0) if not complete
                        rebind_index: mutable usize = 0
                        for arm in arms |cast_sites, arm, declarations, expected, line, names, values, work, complete, depth, arm_match_count, rebind_index, arms_write, no_skip|:
                            names_mark: usize = names.count
                            values_mark: usize = values.count
                            pattern_names: mutable darray[sview] = []
                            return (false, 0) if not proof_replay_call_pattern_bindings_with_work(arm.pattern, &pattern_names, work, depth + 1)
                            for pattern_name in pattern_names |cast_sites, pattern_name, names, values, work, complete|:
                                pattern_bound: bool = proof_replay_deterministic_call_name_bound_with_work(names, pattern_name, work, &complete)
                                return (false, 0) if not complete or pattern_bound
                                names.push(pattern_name)
                                values.push(Ast::Expr.Absent)
                                rebind_name: sview = proof_internal_rebind_name(rebind_index)
                                return (false, 0) if rebind_name == "" or pattern_name == rebind_name
                                names.push(rebind_name)
                                values.push(Ast::Expr.Ident(pattern_name, Ast::expr_pos(expected)))
                                rebind_index <- rebind_index + 1
                            guard_match: usize = 1 if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, arm.guard, expected, line, names, values, work, depth + 1) else 0
                            arm_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(cast_sites, declarations, arm.body, expected, line, names, values, work, depth + 1)
                            names.resize(names_mark)
                            values.resize(values_mark)
                            return (false, 0) if not arm_matches.known
                            arm_match_count <- arm_match_count + guard_match + arm_matches.matches
                            guard_writes: bool = proof_replay_deterministic_expr_writes_with_work(declarations, names, arm.guard, no_skip, depth + 1, work, &complete)
                            return (false, 0) if not complete
                            body_writes: bool = proof_replay_deterministic_statements_write_with_work(declarations, names, arm.body, depth + 1, work, &complete)
                            return (false, 0) if not complete
                            arms_write <- true if guard_writes or body_writes
                        return (true, arm_match_count) if arm_match_count > 0
                        # The call follows the match: any arm may have run.
                        if arms_write:
                            return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names.count, work, &complete)
                            return (false, 0)
                    Ast::Stmt.Block(_, _, _, nested, position):
                        names_mark: usize = names.count
                        values_mark: usize = values.count
                        scoped_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(cast_sites, declarations, nested, expected, line, names, values, work, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        return (false, 0) if not scoped_matches.known
                        if scoped_matches.matches == 0:
                            block_writes: bool = proof_replay_deterministic_statements_write_with_work(declarations, names, nested, depth + 1, work, &complete)
                            return (false, 0) if not complete
                            if block_writes:
                                return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names.count, work, &complete)
                                return (false, 0)
                        return scoped_matches
                    Ast::Stmt.For(bind, variables, _, nested, position):
                        # Calls in a simple sequential counting/foreach body can be checked
                        # against the exact source AST. Give its sole binder the same opaque
                        # source-positioned value used by proof generation, so a summary over
                        # `index` cannot be confused with an outer variable of the same name.
                        # Parallel loops and destructuring binders need separate semantics.
                        # Like a while body, an iteration may follow earlier ones that rewrote
                        # any binding, so the body starts from a reset. A call after the loop
                        # is not matched.
                        return (false, 0) if bind != "" or variables.count != 1 or variables[0] == ""
                        binder_bound: bool = proof_replay_deterministic_call_name_bound_with_work(names, variables[0], work, &complete)
                        return (false, 0) if not complete or binder_bound
                        names_mark: usize = names.count
                        values_mark: usize = values.count
                        return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names_mark, work, &complete)
                        names.push(variables[0])
                        values.push(proof_loop_binder_value(variables[0], position))
                        nested_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(cast_sites, declarations, nested, expected, line, names, values, work, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        return (false, 0) if not nested_matches.known or nested_matches.matches == 0
                        return nested_matches
                    Ast::Stmt.While(condition, while_body, position):
                        # Any earlier iteration may have rewritten a binding, so neither the
                        # guard nor the body may reuse a pre-loop value. Within one iteration the
                        # body's own declarations and assignments are bound in statement order.
                        names_mark: usize = names.count
                        values_mark: usize = values.count
                        return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names_mark, work, &complete)
                        condition_match: usize = 1 if proof_replay_deterministic_call_source_expression_at_line(cast_sites, declarations, condition, expected, line, names, values, work, depth + 1) else 0
                        body_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(cast_sites, declarations, while_body, expected, line, names, values, work, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        return (false, 0) if not body_matches.known
                        loop_matches: usize = condition_match + body_matches.matches
                        return (true, loop_matches) if loop_matches > 0
                        # The call follows the loop: the loop may have rewritten any binding.
                        return (false, 0) if not proof_replay_deterministic_call_havoc_bindings_with_work(names, values, names_mark, work, &complete)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return (false, 0)
            return (true, 0)

        def proof_replay_deterministic_call_source_declarations(cast_sites: darray[Ast::Expr]&, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, expected: Ast::Expr, line: u32, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return proof_replay_deterministic_call_source_declarations_in(cast_sites, declarations, declarations, owner, owner_line, expected, line, matches, work, depth)

        # `all` is the whole source tree, used to resolve callees; `declarations` is the level
        # being searched for the owner.
        def proof_replay_deterministic_call_source_declarations_in(cast_sites: darray[Ast::Expr]&, all: darray[Ast::Decl]&, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, expected: Ast::Expr, line: u32, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            complete: mutable bool = true
            for declaration in declarations |cast_sites, all, owner, owner_line, expected, line, matches, depth, work, complete|:
                return false if not proof_replay_deterministic_call_match_charge(1, work, &complete)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, position):
                        same_owner: bool = proof_replay_deterministic_call_match_text_equal(name, owner, work, &complete)
                        return false if not complete
                        if same_owner and (owner_line == 0 or position.line == owner_line):
                            names: mutable darray[sview] = []
                            values: mutable darray[Ast::Expr] = []
                            for parameter in parameters |cast_sites, names, values, work, complete|:
                                return false if not proof_replay_deterministic_call_match_text_charge(parameter.name, work, &complete)
                                names.push(parameter.name)
                                values.push(Ast::Expr.Absent)
                            source_matches = proof_replay_deterministic_call_source_statements(cast_sites, all, body, expected, line, &names, &values, work, 0)
                            return false if not source_matches.known
                            matches <- matches + source_matches.matches
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_deterministic_call_source_declarations_in(cast_sites, all, nested, owner, owner_line, expected, line, matches, work, depth + 1)
                    _:
                        pass
            return true

        # Read exact cast expressions from source after the independent widening
        # validator admits their binding. Neither a name nor a colliding span is a purity claim.
        def proof_replay_deterministic_source_cast_sites(body: darray[Ast::Stmt]&, target: sview, line: u32, sites: mutable darray[Ast::Expr]&, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT:
                complete <- false
                return false
            for statement in body |statement, target, line, sites, work, complete, depth|:
                return false if not proof_replay_deterministic_call_match_charge(1, work, complete)
                match statement:
                    Ast::Stmt.VarDecl(name, _, initializer, declaration_position):
                        same_name: bool = proof_replay_deterministic_call_match_text_equal(name, target, work, complete)
                        complete_after_name: bool = complete
                        return false if not complete_after_name
                        if same_name and declaration_position.line == line:
                            match initializer:
                                Ast::Expr.Call(_, arguments, _, _):
                                    if arguments.count == 0:
                                        duplicate: mutable bool = false
                                        for site in sites |site, initializer, duplicate, work, complete, depth|:
                                            if proof_replay_deterministic_call_expression_equal_with_work(site, initializer, work, complete, depth + 1):
                                                duplicate <- true
                                                if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                                                    complete <- false
                                                    return false
                                                break
                                            complete_after_site: bool = complete
                                            return false if not complete_after_site or work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
                                        sites.push(initializer) if not duplicate
                                _:
                                    pass
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |arm, target, line, sites, work, complete, depth|:
                            return false if not proof_replay_deterministic_call_match_charge(1, work, complete)
                            return false if not proof_replay_deterministic_source_cast_sites(arm.body, target, line, sites, work, complete, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_deterministic_validated_cast_sites(report: mutable ProofReport&, owner: sview, sites: mutable darray[Ast::Expr]&, work: mutable usize&, complete: mutable bool&) -> bool:
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body_with_work(report, owner, report.replay_owner_line, &body, work, PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT)
            # The owner index narrows this lookup; source validation still decides admission.
            return false if not proof_replay_trace_lookup_charge(report)
            candidate_index: mutable usize = proof_replay_fact_trace_head(report, owner)
            while candidate_index < report.traces.records.count |candidate_index, report, owner, sites, body, work, complete|:
                return false if not proof_replay_deterministic_call_match_charge(1, work, complete)
                candidate: ProofFactTrace = report.traces.records[candidate_index]
                candidate_index <- proof_replay_trace_chain_next(report, candidate_index)
                same_kind: bool = proof_replay_deterministic_call_match_text_equal(candidate.kind, "local-binding", work, complete)
                complete_after_kind: bool = complete
                return false if not complete_after_kind
                continue if not same_kind
                same_name: bool = proof_replay_deterministic_call_match_text_equal(candidate.name, owner, work, complete)
                complete_after_owner: bool = complete
                return false if not complete_after_owner
                continue if not same_name
                return false if not proof_replay_summary_owner_source_preflight(report, owner, report.replay_owner_line, work)
                continue if not proof_replay_local_binding_widening_cast_declaration_source(report, candidate, work)
                match candidate.expression:
                    Ast::Expr.Binary(Ast::Expr.Ident(target, _), TokenKind.EqEq, _, _):
                        return false if not proof_replay_deterministic_source_cast_sites(body, target, candidate.line, sites, work, complete, 0)
                    _:
                        pass
            return true

        # The widening-cast sites depend on the owner, resolved declaration line, immutable
        # source snapshot, and current certificate line used to validate declaration order. Cache
        # them for the replay batch so each deterministic-call edge does not repeat the owner-body
        # and trace walks. Incomplete rows remain permanently unusable in this batch.
        def proof_replay_deterministic_validated_cast_sites_cached(report: mutable ProofReport&, owner: sview, sites: mutable darray[Ast::Expr]&, work: mutable usize&, complete: mutable bool&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            owner_line: mutable u32 = report.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            consumer_line: u32 = report.trace_owner_line
            key: (valid: bool, hash: u32) = proof_replay_cast_site_owner_key_hash(owner, owner_line, consumer_line, work, complete)
            return false if not key.valid
            if cache.cast_site_owners.count == 0 or not cache.cast_site_owner_index_valid or cache.cast_site_owner_bucket_values.count == 0:
                return false if not proof_replay_cast_site_owner_index_reserve(cache, cache.cast_site_owners.count + 1, work, complete)
            lookup: (valid: bool, found: bool, row_index: usize, empty_slot: usize) = proof_replay_cast_site_owner_index_probe(cache, owner, owner_line, consumer_line, key.hash, work, complete)
            return false if not lookup.valid
            if lookup.found:
                row: ProofReplayDeterministicCastSiteOwner = cache.cast_site_owners[lookup.row_index]
                return false if not row.complete or row.sites_start > cache.cast_sites.count or row.sites_count > cache.cast_sites.count - row.sites_start
                return false if not proof_replay_deterministic_call_match_charge(row.sites_count, work, complete)
                for offset in 0..<row.sites_count |offset, row, cache, sites|:
                    sites.push(cache.cast_sites[row.sites_start + offset])
                return true
            return false if not proof_replay_cast_site_owner_index_reserve(cache, cache.cast_site_owners.count + 1, work, complete)
            insertion: (valid: bool, found: bool, row_index: usize, empty_slot: usize) = proof_replay_cast_site_owner_index_probe(cache, owner, owner_line, consumer_line, key.hash, work, complete)
            return false if not insertion.valid or insertion.found
            return false if not proof_replay_deterministic_call_match_charge(1, work, complete)
            row_index: usize = cache.cast_site_owners.count
            sites_start: usize = cache.cast_sites.count
            cache.cast_site_owners.push(ProofReplayDeterministicCastSiteOwner{owner: owner, owner_line: owner_line, trace_owner_line: consumer_line, key_hash: key.hash, sites_start: sites_start, sites_count: 0, complete: false})
            cache.cast_site_owner_bucket_values[insertion.empty_slot] <- row_index
            cache.cast_site_owner_bucket_occupied[insertion.empty_slot] <- true
            discovered: mutable darray[Ast::Expr] = []
            return false if not proof_replay_deterministic_validated_cast_sites(report, owner, &discovered, work, complete)
            return false if not proof_replay_deterministic_call_match_charge(discovered.count, work, complete)
            for site in discovered |site, cache, sites, complete|:
                cache.cast_sites.push(site)
                sites.push(site)
            cache.cast_site_owners[row_index].sites_count <- discovered.count
            cache.cast_site_owners[row_index].complete <- true
            return true

        def proof_replay_deterministic_call_source_site(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_replay_deterministic_call_source_site_with_work(report, trace, call, &work)

        def proof_replay_deterministic_call_source_site_with_work(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_deterministic_call_source_site_with_cache(report, trace, call, work, &cache)

        def proof_replay_deterministic_call_source_site_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            # The owner-body walk below resolves the exact owner and call-site multiplicity, and
            # the source index builder meters the one-time trace/annotation scans. Do not charge
            # those whole-array sizes again on every cached lookup.
            return false if not proof_replay_summary_expr_charge_with_work(call, work)
            return proof_replay_deterministic_call_source_site_scan_with_cache(report, trace, call, work, cache)

        def proof_replay_deterministic_call_source_site_scan_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, call: Ast::Expr, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            cast_sites: mutable darray[Ast::Expr] = []
            complete: mutable bool = true
            return false if not proof_replay_deterministic_validated_cast_sites_cached(report, trace.name, &cast_sites, work, &complete, cache)
            matches: mutable usize = 0
            owner_line: mutable u32 = report.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            # Contract expressions are attached to their function declaration, while their
            # calls retain the contract's own source position. Use the call site itself so a
            # precondition call on the following line is matched exactly instead of omitted by
            # the declaration line stored on its trace.
            call_line: u32 = Ast::expr_pos(call).line
            return false if call_line == 0 or not proof_replay_deterministic_call_source_declarations(cast_sites, report.source_declarations, trace.name, owner_line, call, call_line, &matches, work, 0)
            return matches == 1
