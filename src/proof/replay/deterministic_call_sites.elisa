include "./same_module_call_source.elisa"
include "./signed_call_snapshots.elisa"
include "./typed_call_initializers.elisa"
extend ElisaProof:
    private:
        # Rebuild deterministic call sites from caller source, not the trace payload.
        def proof_replay_deterministic_call_arguments_equal(source: darray[Ast::Expr]&, source_names: darray[sview]&, expected: darray[Ast::Expr]&, expected_names: darray[sview]&) -> bool:
            return false if source.count != expected.count
            return false if source_names.count != 0 and source_names.count != source.count
            return false if expected_names.count != 0 and expected_names.count != expected.count
            for index in 0..<source.count |index, source, source_names, expected, expected_names|:
                source_name: sview = source_names[index] if source_names.count > 0 else ""
                expected_name: sview = expected_names[index] if expected_names.count > 0 else ""
                return false if source_name != expected_name or not proof_replay_deterministic_call_expression_equal(source[index], expected[index])
            return true

        def proof_replay_deterministic_call_expression_equal(source: Ast::Expr, expected: Ast::Expr) -> bool:
            match source:
                Ast::Expr.Call(source_callee, source_arguments, source_names, source_position):
                    match expected:
                        Ast::Expr.Call(expected_callee, expected_arguments, expected_names, expected_position):
                            return source_position.line == expected_position.line and source_position.column == expected_position.column and source_position.offset == expected_position.offset and source_position.end_line == expected_position.end_line and source_position.end_column == expected_position.end_column and source_position.end_offset == expected_position.end_offset and proof_replay_expr_equal(source_callee, expected_callee) and proof_replay_deterministic_call_arguments_equal(source_arguments, source_names, expected_arguments, expected_names)
                        _:
                            return false
                Ast::Expr.Binary(source_left, source_operator, source_right, _):
                    match expected:
                        Ast::Expr.Binary(expected_left, expected_operator, expected_right, _):
                            return source_operator == expected_operator and proof_replay_deterministic_call_expression_equal(source_left, expected_left) and proof_replay_deterministic_call_expression_equal(source_right, expected_right)
                        _:
                            return false
                Ast::Expr.Unary(source_operator, source_inner, _):
                    match expected:
                        Ast::Expr.Unary(expected_operator, expected_inner, _):
                            return source_operator == expected_operator and proof_replay_deterministic_call_expression_equal(source_inner, expected_inner)
                        _:
                            return false
                Ast::Expr.Paren(source_inner, _):
                    match expected:
                        Ast::Expr.Paren(expected_inner, _):
                            return proof_replay_deterministic_call_expression_equal(source_inner, expected_inner)
                        _:
                            return false
                _:
                    return proof_replay_expr_equal(source, expected)

        def proof_replay_deterministic_call_source_contains(expression: Ast::Expr, expected: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_replay_deterministic_call_expression_equal(expression, expected)
                    return true if proof_replay_deterministic_call_source_contains_any(arguments, expected, depth + 1)
                    return proof_replay_deterministic_call_source_contains(callee, expected, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_deterministic_call_source_contains(inner, expected, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_deterministic_call_source_contains(left, expected, depth + 1) or proof_replay_deterministic_call_source_contains(right, expected, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                    return proof_replay_deterministic_call_source_contains(object, expected, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_replay_deterministic_call_source_contains(object, expected, depth + 1) or proof_replay_deterministic_call_source_contains(index, expected, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_replay_deterministic_call_source_contains(object, expected, depth + 1) or proof_replay_deterministic_call_source_contains(low, expected, depth + 1) or proof_replay_deterministic_call_source_contains(high, expected, depth + 1)
                Ast::Expr.IndexN(object, elements, _):
                    return true if proof_replay_deterministic_call_source_contains(object, expected, depth + 1)
                    return proof_replay_deterministic_call_source_contains_any(elements, expected, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    return proof_replay_deterministic_call_source_contains_any(elements, expected, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, expected, depth|:
                        return true if proof_replay_deterministic_call_source_contains(entry.key, expected, depth + 1) or proof_replay_deterministic_call_source_contains(entry.value, expected, depth + 1)
                    return false
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_replay_deterministic_call_source_contains(base, expected, depth + 1)
                    for field in fields |field, expected, depth|:
                        return true if proof_replay_deterministic_call_source_contains(field.value, expected, depth + 1)
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    return proof_replay_deterministic_call_source_contains(iterable, expected, depth + 1) or proof_replay_deterministic_call_source_contains(condition, expected, depth + 1) or proof_replay_deterministic_call_source_contains(value, expected, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_replay_deterministic_call_source_contains(base, expected, depth + 1) or proof_replay_deterministic_call_source_contains(predicate, expected, depth + 1)
                Ast::Expr.Match(value, arms, _) | Ast::Expr.Catch(value, arms, _):
                    return true if proof_replay_deterministic_call_source_contains(value, expected, depth + 1)
                    for arm in arms |arm, expected, depth|:
                        return true if proof_replay_deterministic_call_source_contains(arm.guard, expected, depth + 1) or proof_replay_deterministic_call_source_contains_statements(arm.body, expected, depth + 1)
                    return false
                Ast::Expr.If(condition, yes, no, _):
                    return proof_replay_deterministic_call_source_contains(condition, expected, depth + 1) or proof_replay_deterministic_call_source_contains(yes, expected, depth + 1) or proof_replay_deterministic_call_source_contains(no, expected, depth + 1)
                Ast::Expr.GetElse(value, recovery, _):
                    return proof_replay_deterministic_call_source_contains(value, expected, depth + 1) or proof_replay_deterministic_call_source_contains_statements(recovery, expected, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_replay_deterministic_call_source_contains_statements(statements, expected, depth + 1) or proof_replay_deterministic_call_source_contains(value, expected, depth + 1)
                _:
                    return false

        def proof_replay_deterministic_call_source_contains_statements(statements: darray[Ast::Stmt]&, expected: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 96
            for statement in statements |expected, depth|:
                match statement:
                    Ast::Stmt.VarDecl(_, _, value, _) | Ast::Stmt.Expr(value, _) | Ast::Stmt.Return(value, _) | Ast::Stmt.Contract(_, value, _):
                        return true if proof_replay_deterministic_call_source_contains(value, expected, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        return true if proof_replay_deterministic_call_source_contains(target, expected, depth + 1) or proof_replay_deterministic_call_source_contains(value, expected, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        return true if proof_replay_deterministic_call_source_contains(condition, expected, depth + 1)
                        return true if proof_replay_deterministic_call_source_contains_statements(yes, expected, depth + 1) or proof_replay_deterministic_call_source_contains_statements(no, expected, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        return true if proof_replay_deterministic_call_source_contains(condition, expected, depth + 1) or proof_replay_deterministic_call_source_contains_statements(nested, expected, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        return true if proof_replay_deterministic_call_source_contains(iterable, expected, depth + 1) or proof_replay_deterministic_call_source_contains_statements(nested, expected, depth + 1)
                    Ast::Stmt.Match(value, arms, _):
                        return true if proof_replay_deterministic_call_source_contains(value, expected, depth + 1)
                        for arm in arms |arm, expected, depth|:
                            return true if proof_replay_deterministic_call_source_contains(arm.guard, expected, depth + 1) or proof_replay_deterministic_call_source_contains_statements(arm.body, expected, depth + 1)
                        return false
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return true if proof_replay_deterministic_call_source_contains_statements(nested, expected, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return false

        def proof_replay_deterministic_call_source_contains_any(expressions: darray[Ast::Expr]&, expected: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 96
            for expression in expressions |expected, depth|:
                return true if proof_replay_deterministic_call_source_contains(expression, expected, depth + 1)
            return false


        # Compare the marker only with the substituted source call (see deterministic_call_state).
        # A captured block may run with its captures rewritten by enclosing code the walk cannot
        # order, so it starts from a reset.
        def proof_replay_deterministic_call_source_expression(declarations: darray[Ast::Decl]&, expression: Ast::Expr, expected: Ast::Expr, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, types: mutable darray[(name: sview, expression: Ast::Expr)]&, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Block(statements, block_result, captures, _):
                    names_mark: usize = names.count
                    values_mark: usize = values.count
                    types_mark: usize = types.count
                    proof_replay_deterministic_call_havoc_bindings(names, values, names_mark) if captures.count > 0
                    source_line: u32 = Ast::expr_pos(expected).line
                    statement_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(declarations, statements, expected, source_line, names, values, types, depth + 1)
                    tail_matches: mutable bool = false
                    tail_matches <- proof_replay_deterministic_call_source_expression_at_line(declarations, block_result, expected, source_line, names, values, types, depth + 1)
                    tail_match_count: mutable usize = 0
                    tail_match_count <- 1 if statement_matches.known and tail_matches
                    names.resize(names_mark)
                    values.resize(values_mark)
                    types.resize(types_mark)
                    return statement_matches.known and statement_matches.matches + tail_match_count == 1
                _:
                    pass
            # Another call evaluated in the same expression could write a local the matched call
            # reads, in an order this walk does not model.
            return false if proof_replay_deterministic_expr_writes(declarations, expression, Ast::expr_pos(expected), depth + 1)
            resolved: Ast::Expr = proof_replay_substitute_many(expression, names, values)
            marker: Ast::Expr = proof_replay_deterministic_call_marker_resolved(expected, names, values)
            return proof_replay_deterministic_call_source_contains(resolved, expected, depth + 1) or proof_replay_deterministic_call_source_contains(resolved, marker, depth + 1)

        def proof_replay_deterministic_call_source_expression_at_line(declarations: darray[Ast::Decl]&, expression: Ast::Expr, expected: Ast::Expr, line: u32, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, types: mutable darray[(name: sview, expression: Ast::Expr)]&, depth: usize) -> bool:
            return false if depth >= 96
            return Ast::expr_pos(expected).line == line and proof_replay_deterministic_call_source_expression(declarations, expression, expected, names, values, types, depth + 1)

        # Bind caller locals in statement order, reconstructing the resolved actuals that the
        # producer placed in the marker at the call's pre-state. Loops and joins that may rewrite
        # state reset every binding; a redeclared (shadowing) name or an unmodelled write target
        # fails closed.
        def proof_replay_deterministic_call_source_statements(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, expected: Ast::Expr, line: u32, names: mutable darray[sview]&, values: mutable darray[Ast::Expr]&, types: mutable darray[(name: sview, expression: Ast::Expr)]&, depth: usize) -> (known: bool, matches: usize):
            return (false, 0) if depth >= 96
            no_skip: Ast::Pos = Ast::pos_at_line(0)
            for statement in body |declarations, expected, line, names, values, types, depth, no_skip|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(declarations, initializer, expected, line, names, values, types, depth + 1)
                        return (true, 0) if position.line > line
                        return (false, 0) if proof_replay_deterministic_call_name_bound(names, local_name)
                        resolved_initializer: Ast::Expr = proof_replay_substitute_many(initializer, names, values)
                        names.push(local_name)
                        # A signed source call captures one value under this local. Keep its
                        # identity; evaluating the initializer again is a different operation.
                        snapshot: bool = proof_replay_signed_call_snapshot(declarations, type_expression, initializer)
                        values.push(Ast::Expr.Ident(local_name, position) if snapshot else resolved_initializer)
                        readonly_cast: bool = proof_replay_typed_integer_cast(declarations, initializer, types)
                        types.push((local_name, type_expression))
                        proof_replay_deterministic_call_havoc_bindings(names, values, names.count) if not readonly_cast and proof_replay_deterministic_expr_writes(declarations, initializer, no_skip, depth + 1)
                    Ast::Stmt.Assign(target, operator, value, position):
                        return (true, 0) if position.line > line
                        return (false, 0) if operator != TokenKind.Assign and operator != TokenKind.LArrow
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(declarations, value, expected, line, names, values, types, depth + 1)
                        resolved_value: Ast::Expr = proof_replay_substitute_many(value, names, values)
                        match target:
                            Ast::Expr.Ident(local_name, _):
                                names.push(local_name)
                                values.push(resolved_value)
                            _:
                                return (false, 0)
                        proof_replay_deterministic_call_havoc_bindings(names, values, names.count) if proof_replay_deterministic_expr_writes(declarations, value, no_skip, depth + 1)
                    Ast::Stmt.Expr(value, position):
                        return (true, 0) if position.line > line
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(declarations, value, expected, line, names, values, types, depth + 1)
                        proof_replay_deterministic_call_havoc_bindings(names, values, names.count) if proof_replay_deterministic_expr_writes(declarations, value, no_skip, depth + 1)
                    Ast::Stmt.Return(value, position):
                        return (true, 0) if position.line > line
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(declarations, value, expected, line, names, values, types, depth + 1)
                    Ast::Stmt.Contract(_, expression, position):
                        return (true, 0) if position.line > line
                        return (true, 1) if proof_replay_deterministic_call_source_expression_at_line(declarations, expression, expected, line, names, values, types, depth + 1)
                    Ast::Stmt.If(condition, yes, no, position):
                        return (true, 0) if position.line > line
                        condition_match: usize = 1 if proof_replay_deterministic_call_source_expression_at_line(declarations, condition, expected, line, names, values, types, depth + 1) else 0
                        names_mark: usize = names.count
                        values_mark: usize = values.count
                        types_mark: usize = types.count
                        yes_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(declarations, yes, expected, line, names, values, types, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        types.resize(types_mark)
                        return (false, 0) if not yes_matches.known
                        no_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(declarations, no, expected, line, names, values, types, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        types.resize(types_mark)
                        return (false, 0) if not no_matches.known
                        branch_matches: usize = condition_match + yes_matches.matches + no_matches.matches
                        return (true, branch_matches) if branch_matches > 0
                        # The call follows the join: either branch may have run.
                        if proof_replay_deterministic_expr_writes(declarations, condition, no_skip, depth + 1) or proof_replay_deterministic_statements_write(declarations, yes, depth + 1) or proof_replay_deterministic_statements_write(declarations, no, depth + 1):
                            proof_replay_deterministic_call_havoc_bindings(names, values, names.count)
                    Ast::Stmt.Match(value, arms, position):
                        return (true, 0) if position.line > line
                        value_match: usize = 1 if proof_replay_deterministic_call_source_expression_at_line(declarations, value, expected, line, names, values, types, depth + 1) else 0
                        arm_match_count: mutable usize = value_match
                        arms_write: mutable bool = proof_replay_deterministic_expr_writes(declarations, value, no_skip, depth + 1)
                        rebind_index: mutable usize = 0
                        for arm in arms |arm, declarations, expected, line, names, values, types, depth, arm_match_count, rebind_index, arms_write, no_skip|:
                            names_mark: usize = names.count
                            values_mark: usize = values.count
                            types_mark: usize = types.count
                            pattern_names: mutable darray[sview] = []
                            return (false, 0) if not proof_replay_call_pattern_bindings(arm.pattern, &pattern_names, depth + 1)
                            payload_types: darray[Ast::Expr] = proof_replay_call_payload_types(declarations, value, arm.pattern, types)
                            for pattern_index in 0..<pattern_names.count |pattern_names, payload_types, names, values, types|:
                                pattern_name: sview = pattern_names[pattern_index]
                                types.push((pattern_name, payload_types[pattern_index])) if payload_types.count == pattern_names.count
                                return (false, 0) if proof_replay_deterministic_call_name_bound(names, pattern_name)
                                names.push(pattern_name)
                                values.push(Ast::Expr.Absent)
                                rebind_name: sview = proof_internal_rebind_name(rebind_index)
                                return (false, 0) if rebind_name == "" or pattern_name == rebind_name
                                names.push(rebind_name)
                                values.push(Ast::Expr.Ident(pattern_name, Ast::expr_pos(expected)))
                                rebind_index <- rebind_index + 1
                            guard_match: usize = 1 if proof_replay_deterministic_call_source_expression_at_line(declarations, arm.guard, expected, line, names, values, types, depth + 1) else 0
                            arm_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(declarations, arm.body, expected, line, names, values, types, depth + 1)
                            names.resize(names_mark)
                            values.resize(values_mark)
                            types.resize(types_mark)
                            return (false, 0) if not arm_matches.known
                            arm_match_count <- arm_match_count + guard_match + arm_matches.matches
                            arms_write <- true if proof_replay_deterministic_expr_writes(declarations, arm.guard, no_skip, depth + 1) or proof_replay_deterministic_statements_write(declarations, arm.body, depth + 1)
                        return (true, arm_match_count) if arm_match_count > 0
                        # The call follows the match: any arm may have run.
                        proof_replay_deterministic_call_havoc_bindings(names, values, names.count) if arms_write
                    Ast::Stmt.Block(_, _, _, nested, position):
                        return (true, 0) if position.line > line
                        names_mark: usize = names.count
                        values_mark: usize = values.count
                        types_mark: usize = types.count
                        scoped_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(declarations, nested, expected, line, names, values, types, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        types.resize(types_mark)
                        return scoped_matches
                    Ast::Stmt.For(bind, variables, _, nested, position):
                        return (true, 0) if position.line > line
                        # Calls in a simple sequential counting/foreach body can be checked
                        # against the exact source AST. Give its sole binder the same opaque
                        # source-positioned value used by proof generation, so a summary over
                        # `index` cannot be confused with an outer variable of the same name.
                        # Parallel loops and destructuring binders need separate semantics.
                        # Like a while body, an iteration may follow earlier ones that rewrote
                        # any binding, so the body starts from a reset. A call after the loop
                        # is not matched.
                        return (false, 0) if bind != "" or variables.count != 1 or variables[0] == ""
                        return (false, 0) if proof_replay_deterministic_call_name_bound(names, variables[0])
                        names_mark: usize = names.count
                        values_mark: usize = values.count
                        types_mark: usize = types.count
                        proof_replay_deterministic_call_havoc_bindings(names, values, names_mark)
                        names.push(variables[0])
                        values.push(proof_loop_binder_value(variables[0], position))
                        nested_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(declarations, nested, expected, line, names, values, types, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        types.resize(types_mark)
                        return nested_matches
                    Ast::Stmt.While(condition, while_body, position):
                        return (true, 0) if position.line > line
                        # Any earlier iteration may have rewritten a binding, so neither the
                        # guard nor the body may reuse a pre-loop value. Within one iteration the
                        # body's own declarations and assignments are bound in statement order.
                        names_mark: usize = names.count
                        values_mark: usize = values.count
                        types_mark: usize = types.count
                        proof_replay_deterministic_call_havoc_bindings(names, values, names_mark)
                        condition_match: usize = 1 if proof_replay_deterministic_call_source_expression_at_line(declarations, condition, expected, line, names, values, types, depth + 1) else 0
                        body_matches: (known: bool, matches: usize) = proof_replay_deterministic_call_source_statements(declarations, while_body, expected, line, names, values, types, depth + 1)
                        names.resize(names_mark)
                        values.resize(values_mark)
                        types.resize(types_mark)
                        return (false, 0) if not body_matches.known
                        loop_matches: usize = condition_match + body_matches.matches
                        return (true, loop_matches) if loop_matches > 0
                        # The call follows the loop: the loop may have rewritten any binding.
                        proof_replay_deterministic_call_havoc_bindings(names, values, names_mark)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return (false, 0)
            return (true, 0)

        def proof_replay_deterministic_call_source_declarations(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, expected: Ast::Expr, line: u32, matches: mutable usize&, depth: usize) -> bool:
            return proof_replay_deterministic_call_source_declarations_in(declarations, declarations, owner, owner_line, expected, line, matches, depth)

        # `all` is the whole source tree, used to resolve callees; `declarations` is the level
        # being searched for the owner.
        def proof_replay_deterministic_call_source_declarations_in(all: darray[Ast::Decl]&, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, expected: Ast::Expr, line: u32, matches: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for declaration in declarations |all, owner, owner_line, expected, line, matches, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, position):
                        if name == owner and (owner_line == 0 or position.line == owner_line):
                            names: mutable darray[sview] = []
                            values: mutable darray[Ast::Expr] = []
                            types: mutable darray[(name: sview, expression: Ast::Expr)] = []
                            for parameter in parameters |names, values, types|:
                                names.push(parameter.name)
                                values.push(Ast::Expr.Absent)
                                types.push((parameter.name, parameter.type_expression)) if not parameter.is_mutable
                            source_matches = proof_replay_deterministic_call_source_statements(all, body, expected, line, &names, &values, &types, 0)
                            return false if not source_matches.known
                            matches <- matches + source_matches.matches
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_deterministic_call_source_declarations_in(all, nested, owner, owner_line, expected, line, matches, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_deterministic_call_source_site(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr) -> bool:
            matches: mutable usize = 0
            owner_line: mutable u32 = report.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            # Contract expressions are attached to their function declaration, while their
            # calls retain the contract's own source position. Use the call site itself so a
            # precondition call on the following line is matched exactly instead of omitted by
            # the declaration line stored on its trace.
            call_line: u32 = Ast::expr_pos(call).line
            return false if call_line == 0
            source_valid: bool = proof_replay_deterministic_call_source_declarations(report.source_declarations, trace.name, owner_line, call, call_line, &matches, 0)
            return true if source_valid and matches == 1
            bare = proof_replay_same_module_bare_call(report, trace, call)
            return false if not bare.known
            matches <- 0
            return proof_replay_deterministic_call_source_declarations(report.source_declarations, trace.name, owner_line, bare.call, call_line, &matches, 0) and matches == 1
