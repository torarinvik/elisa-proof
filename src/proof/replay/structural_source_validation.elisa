# Source authority for structural recursion certificates.
extend ElisaProof:
    private:
        def proof_replay_structural_source_graph_empty() -> ProofReplayStructuralSourceGraph:
            return ProofReplayStructuralSourceGraph{declarations: [], node_by_source_entry: [], direct_extern_contract_unsafe: [], reachable_extern_contract_unsafe: [], direct_unresolved_calls: [], reachable_unresolved_calls: [], component_ids: [], out_starts: [], out_counts: [], out_targets: [], reverse_starts: [], reverse_counts: [], reverse_targets: [], edge_sources: [], edge_hashes: [], edge_slots: [], call_site_scan_valid: [], call_site_raw_callers: [], call_site_raw_offsets: [], call_site_raw_names: [], call_site_raw_lines: [], call_site_raw_scoped: [], call_site_hashes: [], call_site_slots: [], call_site_callers: [], call_site_offsets: [], call_site_counts: [], call_site_names: [], call_site_lines: [], call_site_scoped: []}

        def proof_replay_structural_lemma_name(names: darray[sview]&, index: ProofReplayCallNameIndex&, wanted: sview, source_work: mutable usize&) -> (complete: bool, found: bool):
            capacity: usize = index.slots.count
            return (false, false) if index.hashes.count != names.count
            return (true, false) if capacity == 0 and names.count == 0
            return (false, false) if capacity == 0 or capacity != proof_name_index_capacity(names.count)
            return (false, false) if not proof_replay_structural_work_charge(source_work, sview_len(wanted))
            wanted_hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, names, index, capacity, source_work|:
                return (false, false) if not proof_replay_structural_work_charge(source_work, 1)
                encoded: usize = index.slots[slot]
                return (true, false) if encoded == 0
                row: usize = encoded - 1
                return (false, false) if row >= names.count or row >= index.hashes.count
                if index.hashes[row] == wanted_hash:
                    return (false, false) if not proof_replay_structural_text_compare(names[row], wanted, source_work)
                    return (true, true) if names[row] == wanted
                slot <- slot + 1 if slot + 1 < capacity else 0
                probes <- probes + 1
            return (false, false)

        def proof_replay_structural_collect_source_entries(declarations: darray[Ast::Decl]&, lemma_names: darray[sview]&, lemma_index: ProofReplayCallNameIndex&, entries: mutable darray[ProofReplayStructuralSourceEntry]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for declaration in declarations |entries, lemma_names, lemma_index, source_work, depth|:
                return false if not proof_replay_structural_work_charge(source_work, 1)
                name: mutable sview = ""
                lemma: mutable bool = false
                match declaration:
                    Ast::Decl.Func(found, _, _, _, _, _, _):
                        name <- found
                        marker: (complete: bool, found: bool) = proof_replay_structural_lemma_name(lemma_names, lemma_index, name, source_work)
                        return false if not marker.complete
                        lemma <- marker.found
                    Ast::Decl.Extern(found, _, _, _, _, _, _, _) | Ast::Decl.Const(found, _, _, _, _) | Ast::Decl.Struct(found, _, _, _, _, _, _) | Ast::Decl.Enum(found, _, _, _, _) | Ast::Decl.Alias(found, _, _) | Ast::Decl.Law(found, _, _):
                        name <- found
                    Ast::Decl.Import(_, _):
                        # Imports have no selected-callee identity in this report. Their
                        # declarations may satisfy calls absent from the retained source index.
                        return false
                    Ast::Decl.Module(found, nested, _):
                        name <- found
                        return false if not proof_replay_structural_collect_source_entries(nested, lemma_names, lemma_index, entries, source_work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_structural_collect_source_entries(nested, lemma_names, lemma_index, entries, source_work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                if name != "":
                    return false if not proof_replay_structural_text_compare(name, name, source_work)
                    entries.push(ProofReplayStructuralSourceEntry{name: name, declaration: declaration, lemma: lemma})
            return true

        def proof_replay_structural_source_index_build(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> (complete: bool, index: ProofReplayStructuralSourceIndex):
            index: mutable ProofReplayStructuralSourceIndex = ProofReplayStructuralSourceIndex{entries: [], hashes: [], slots: [], ambiguous: []}
            lemma_names: mutable darray[sview] = []
            lemma_index: mutable ProofReplayCallNameIndex = ProofReplayCallNameIndex{}
            for annotation in annotations |lemma_names, lemma_index, source_work|:
                return (false, index) if not proof_replay_structural_work_charge(source_work, 1)
                import_metadata: (complete: bool, unresolved: bool) = proof_replay_structural_import_annotation_unresolved(annotation, source_work)
                return (false, index) if not import_metadata.complete or import_metadata.unresolved
                return (false, index) if not proof_replay_structural_text_compare(annotation.owner, "__lemma", source_work)
                if annotation.owner == "__lemma":
                    return (false, index) if not proof_replay_call_name_index_add(&lemma_names, &lemma_index, annotation.name, source_work)
            return (false, index) if not proof_replay_structural_collect_source_entries(declarations, lemma_names, lemma_index, &index.entries, source_work, 0)
            return (true, index) if index.entries.count == 0
            capacity: usize = proof_name_index_capacity(index.entries.count)
            return (false, index) if capacity == 0 or not proof_replay_structural_work_charge(source_work, capacity)
            return (false, index) if not proof_replay_structural_work_charge(source_work, index.entries.count)
            index.hashes.resize(capacity)
            index.slots.resize(capacity)
            index.ambiguous.resize(capacity)
            for slot in 0..<capacity |slot, index|:
                index.slots[slot] <- index.entries.count
                index.ambiguous[slot] <- false
            for entry_index in 0..<index.entries.count |entry_index, index, capacity, source_work|:
                entry: ProofReplayStructuralSourceEntry = index.entries[entry_index]
                return (false, index) if not proof_replay_structural_text_compare(entry.name, entry.name, source_work)
                return (false, index) if not proof_replay_structural_work_charge(source_work, sview_len(entry.name))
                hash: u32 = proof_name_hash(entry.name)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, entry_index, index, capacity, source_work, placed|:
                    return (false, index) if not proof_replay_structural_work_charge(source_work, 1)
                    current: usize = index.slots[slot]
                    if current == index.entries.count:
                        index.hashes[slot] <- hash
                        index.slots[slot] <- entry_index
                        placed <- true
                        break
                    if index.hashes[slot] == hash:
                        current_name: sview = index.entries[current].name
                        return (false, index) if not proof_replay_structural_text_compare(current_name, index.entries[entry_index].name, source_work)
                        if current_name == index.entries[entry_index].name:
                            index.ambiguous[slot] <- true
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return (false, index) if not placed
            return (true, index)

        def proof_replay_structural_source_lookup(index: ProofReplayStructuralSourceIndex&, wanted: sview, source_work: mutable usize&) -> (complete: bool, matches: usize, entry_index: usize, declaration: Ast::Decl, lemma: bool):
            capacity: usize = index.slots.count
            return (true, 0, 0, Ast::Decl.Invalid, false) if capacity == 0 or wanted == ""
            return (false, 0, 0, Ast::Decl.Invalid, false) if index.hashes.count != capacity or index.ambiguous.count != capacity
            return (false, 0, 0, Ast::Decl.Invalid, false) if not proof_replay_structural_work_charge(source_work, sview_len(wanted))
            hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, wanted, index, capacity, source_work|:
                return (false, 0, 0, Ast::Decl.Invalid, false) if not proof_replay_structural_work_charge(source_work, 1)
                current: usize = index.slots[slot]
                return (true, 0, 0, Ast::Decl.Invalid, false) if current == index.entries.count
                return (false, 0, 0, Ast::Decl.Invalid, false) if current >= index.entries.count
                if index.hashes[slot] == hash:
                    current_name: sview = index.entries[current].name
                    return (false, 0, 0, Ast::Decl.Invalid, false) if not proof_replay_structural_text_compare(current_name, wanted, source_work)
                    if current_name == wanted:
                        entry: ProofReplayStructuralSourceEntry = index.entries[current]
                        return (true, 2, current, entry.declaration, entry.lemma) if index.ambiguous[slot]
                        return (true, 1, current, entry.declaration, entry.lemma)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, 0, 0, Ast::Decl.Invalid, false)

        def proof_replay_structural_charge_check_preflight(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, source_work: mutable usize&) -> bool:
            cost: mutable usize = 1
            return false if not proof_replay_summary_expr_cost_body(body, cost, source_work, 0)
            for parameter in parameters |cost, source_work|:
                return false if not proof_replay_summary_expr_cost_add(cost, source_work, 1 + sview_len(parameter.name))
                return false if not proof_replay_summary_expr_cost(parameter.type_expression, cost, source_work, 0)
                return false if parameter.has_default and not proof_replay_summary_expr_cost(parameter.default_value, cost, source_work, 0)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            remaining: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            return false if cost > remaining / cost
            square: usize = cost * cost
            return false if cost > remaining / square
            source_work <- source_work + square * cost
            return true

        def proof_replay_structural_metadata_with_work(enum_index: ProofEnumIndex, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt], source_work: mutable usize&) -> (complete: bool, member: bool, position: usize, type_name: sview):
            return (false, false, parameters.count, "") if parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + parameters.count
            body_cost: mutable usize = 0
            return (false, false, parameters.count, "") if not proof_replay_summary_expr_cost_body(body, body_cost, source_work, 0)
            return (false, false, parameters.count, "") if body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + body_cost
            max_enum_name_length: mutable usize = 0
            for enum_name in enum_index.names |enum_name, source_work, max_enum_name_length|:
                return (false, false, parameters.count, "") if not proof_replay_structural_text_compare(enum_name, enum_name, source_work)
                max_enum_name_length <- sview_len(enum_name) if sview_len(enum_name) > max_enum_name_length
            for parameter in parameters |source_work|:
                return (false, false, parameters.count, "") if not proof_replay_structural_text_compare(parameter.name, parameter.name, source_work)
                return (false, false, parameters.count, "") if not proof_replay_summary_expr_repeat_charge_with_work(parameter.type_expression, 1, source_work)
                parameter_type_name: sview = proof_head_name(parameter.type_expression)
                lookup_unit: usize = 1 + sview_len(parameter_type_name) + max_enum_name_length
                return (false, false, parameters.count, "") if lookup_unit > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / (PROOF_INDEX_MAX_CHAIN * 2)
                source_work <- source_work + lookup_unit * PROOF_INDEX_MAX_CHAIN * 2
            components: mutable darray[Ast::Expr] = []
            has_unbounded: mutable bool = false
            for statement in body |source_work, has_unbounded|:
                return (false, false, parameters.count, "") if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Contract(kind, expression, _):
                        proof_decreases_components(expression, &components) if kind == "decreases"
                        has_unbounded <- true if kind == "decreases*"
                    _:
                        pass
            if components.count == 0 and not has_unbounded:
                inferred: (known: bool, parameter: sview, position: usize, type_name: sview) = proof_infer_structural_decrease(enum_index, parameters)
                if inferred.known:
                    components.push(Ast::Expr.Ident(inferred.parameter, Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}))
            member: mutable bool = false
            position: mutable usize = parameters.count
            type_name: mutable sview = ""
            if components.count == 1:
                subject: sview = proof_ident_name(components[0])
                for parameter in parameters |parameter, subject, source_work|:
                    return (false, false, parameters.count, "") if not proof_replay_structural_text_compare(parameter.name, subject, source_work)
                position <- proof_enum_parameter_position(enum_index, parameters, subject)
                member <- position < parameters.count
                type_name <- proof_head_name(parameters[position].type_expression) if member
            return (true, member, position, type_name)

        def proof_replay_structural_table_add(report: mutable ProofReport&, name: sview, metadata: (complete: bool, member: bool, position: usize, type_name: sview), component: usize) -> bool:
            return false if not metadata.complete or name == ""
            report.structural.names.push(name)
            report.structural.subject_positions.push(metadata.position)
            report.structural.subject_types.push(metadata.type_name)
            report.structural.component_ids.push(component)
            report.structural.members.push(metadata.member)
            return true

        def proof_replay_structural_nodes_same_with_work(expected_nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, expected_children: darray[usize]&, actual_nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, actual_children: darray[usize]&, expected_edge: ElisaProofKernelCore::ProofKernelNode, actual_edge: ElisaProofKernelCore::ProofKernelNode, source_work: mutable usize&) -> bool:
            return false if expected_edge.children_count != actual_edge.children_count or expected_edge.children_count == 0
            return false if expected_edge.children_start > expected_children.count or expected_edge.children_count > expected_children.count - expected_edge.children_start
            return false if actual_edge.children_start > actual_children.count or actual_edge.children_count > actual_children.count - actual_edge.children_start
            for index in 0..<expected_edge.children_count |index, expected_nodes, expected_children, actual_nodes, actual_children, expected_edge, actual_edge, source_work|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                expected_id: usize = expected_children[expected_edge.children_start + index]
                actual_id: usize = actual_children[actual_edge.children_start + index]
                return false if expected_id >= expected_nodes.count or actual_id >= actual_nodes.count
                expected: ElisaProofKernelCore::ProofKernelNode = expected_nodes[expected_id]
                actual: ElisaProofKernelCore::ProofKernelNode = actual_nodes[actual_id]
                return false if expected.kind != "structural-argument" or actual.kind != "structural-argument"
                return false if not proof_replay_structural_text_compare(expected.operator, actual.operator, source_work)
                return false if not proof_replay_structural_text_compare(expected.name, actual.name, source_work) or not proof_replay_structural_text_compare(expected.secondary_name, actual.secondary_name, source_work)
                return false if expected.operator != actual.operator or expected.name != actual.name or expected.secondary_name != actual.secondary_name
                for prior in 0..<index |prior, expected_nodes, expected_children, actual_nodes, actual_children, expected_edge, actual_edge, expected, actual, source_work|:
                    return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - 4
                    source_work <- source_work + 4
                    expected_prior_id: usize = expected_children[expected_edge.children_start + prior]
                    actual_prior_id: usize = actual_children[actual_edge.children_start + prior]
                    return false if expected_prior_id >= expected_nodes.count or actual_prior_id >= actual_nodes.count
                    expected_prior: ElisaProofKernelCore::ProofKernelNode = expected_nodes[expected_prior_id]
                    actual_prior: ElisaProofKernelCore::ProofKernelNode = actual_nodes[actual_prior_id]
                    return false if (expected.value == expected_prior.value) != (actual.value == actual_prior.value)
                    return false if (expected.value == expected_prior.auxiliary) != (actual.value == actual_prior.auxiliary)
                    return false if (expected.auxiliary == expected_prior.value) != (actual.auxiliary == actual_prior.value)
                    return false if (expected.auxiliary == expected_prior.auxiliary) != (actual.auxiliary == actual_prior.auxiliary)
                return false if (expected.value == expected.auxiliary) != (actual.value == actual.auxiliary)
            return true

        def proof_replay_structural_certificate_set_matches_with_work(report: ProofReport&, certificate_index: ProofReplayStructuralCertificateIndex&, owner: sview, expected: ProofReport&, source_work: mutable usize&) -> bool:
            expected_count: usize = expected.certificates.count
            return false if expected_count == 0
            owner_lookup: (complete: bool, owner_index: usize) = proof_replay_structural_certificate_owner_lookup(certificate_index, owner, source_work)
            return false if not owner_lookup.complete or owner_lookup.owner_index >= certificate_index.owners.count
            return false if certificate_index.certificate_indices.count != certificate_index.next_indices.count
            indexed_owner: ProofReplayStructuralCertificateOwner = certificate_index.owners[owner_lookup.owner_index]
            return false if indexed_owner.count != expected_count
            sentinel: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            actual_row: mutable usize = indexed_owner.head
            for expected_index in 0..<expected_count |expected_index, report, certificate_index, owner, expected, source_work, actual_row, sentinel|:
                return false if actual_row >= certificate_index.certificate_indices.count
                actual_certificate_index: usize = certificate_index.certificate_indices[actual_row]
                return false if actual_certificate_index >= report.certificates.count
                actual_certificate: ProofGoalCertificate = report.certificates[actual_certificate_index]
                return false if actual_certificate.rule != "structural-safety" or not proof_replay_structural_text_compare(actual_certificate.name, owner, source_work) or actual_certificate.name != owner
                expected_certificate: ProofGoalCertificate = expected.certificates[expected_index]
                return false if actual_certificate.line != expected_certificate.line or actual_certificate.rule != expected_certificate.rule
                return false if actual_certificate.kernel_goal >= report.kernel.nodes.count or expected_certificate.kernel_goal >= expected.kernel.nodes.count
                actual_root: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[actual_certificate.kernel_goal]
                expected_root: ElisaProofKernelCore::ProofKernelNode = expected.kernel.nodes[expected_certificate.kernel_goal]
                return false if actual_root.kind != "structural-safety" or expected_root.kind != "structural-safety" or actual_root.secondary_name != "structural-v2" or expected_root.secondary_name != "structural-v2"
                return false if actual_root.left != expected_root.left or actual_root.children_count != 1 or expected_root.children_count != 1
                return false if not proof_replay_structural_text_compare(actual_root.name, expected_root.name, source_work) or actual_root.name != expected_root.name
                return false if actual_root.children_start > report.kernel.children.count or expected_root.children_start > expected.kernel.children.count
                return false if actual_root.children_count > report.kernel.children.count - actual_root.children_start or expected_root.children_count > expected.kernel.children.count - expected_root.children_start
                actual_edge_id: usize = report.kernel.children[actual_root.children_start]
                expected_edge_id: usize = expected.kernel.children[expected_root.children_start]
                return false if actual_edge_id >= report.kernel.nodes.count or expected_edge_id >= expected.kernel.nodes.count
                actual_edge: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[actual_edge_id]
                expected_edge: ElisaProofKernelCore::ProofKernelNode = expected.kernel.nodes[expected_edge_id]
                return false if actual_edge.kind != "structural-edge" or expected_edge.kind != "structural-edge"
                return false if not proof_replay_structural_text_compare(actual_edge.name, expected_edge.name, source_work) or not proof_replay_structural_text_compare(actual_edge.secondary_name, expected_edge.secondary_name, source_work)
                return false if actual_edge.name != expected_edge.name or actual_edge.secondary_name != expected_edge.secondary_name
                return false if not proof_replay_structural_nodes_same_with_work(expected.kernel.nodes, expected.kernel.children, report.kernel.nodes, report.kernel.children, expected_edge, actual_edge, source_work)
                return false if actual_row >= certificate_index.next_indices.count
                actual_row <- certificate_index.next_indices[actual_row]
            return actual_row == sentinel

        # Build the exact supported source call graph. The caller refuses scoped, shadowed,
        # ambiguous, or unsupported call walks, so no omitted edge can change a mutual-SCC
        # decision. A zero-match direct name has no declaration in the complete retained source
        # tree, so it cannot name a row in the producer's source-function table (for example, an
        # imported or intrinsic callable). Lemmas are also absent from that executable table.
        def proof_replay_structural_source_graph_build(index: ProofReplayStructuralSourceIndex&, signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, enum_index: ProofEnumIndex, scratch: mutable ProofReport&, source_work: mutable usize&, graph: mutable ProofReplayStructuralSourceGraph&) -> bool:
            graph <- proof_replay_structural_source_graph_empty()
            return false if signature_lines.count != signature_kinds.count or signature_lines.count != signature_contracts.count
            return false if not proof_structural_signature_contract_table_valid(signature_lines, signature_kinds, signature_contracts, source_work)
            return false if index.entries.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + index.entries.count
            graph.node_by_source_entry.resize(index.entries.count)
            for entry_index in 0..<index.entries.count |entry_index, index, graph, scratch, source_work, enum_index|:
                graph.node_by_source_entry[entry_index] <- index.entries.count
                entry: ProofReplayStructuralSourceEntry = index.entries[entry_index]
                match entry.declaration:
                    Ast::Decl.Func(_, parameters, _, body, _, _, _):
                        continue if entry.lemma
                        # Graph nodes are keyed by their exact source-entry identity, so
                        # unrelated overloaded declarations can remain in the graph without
                        # making an otherwise unique recursive component unreplayable. Bare
                        # calls to ambiguous names are marked unresolved below, while
                        # certificate admission still requires a unique owner and callee.
                        metadata: (complete: bool, member: bool, position: usize, type_name: sview) = proof_replay_structural_metadata_with_work(enum_index, parameters, body, source_work)
                        return false if not metadata.complete
                        node_index: usize = graph.declarations.count
                        return false if not proof_replay_structural_table_add(scratch, entry.name, metadata, node_index)
                        graph.declarations.push(entry.declaration)
                        graph.direct_extern_contract_unsafe.push(false)
                        graph.direct_unresolved_calls.push(false)
                        graph.node_by_source_entry[entry_index] <- node_index
                    _:
                        pass
            node_count: usize = graph.declarations.count
            return false if node_count != scratch.structural.names.count or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return false if not proof_replay_structural_work_charge(source_work, node_count)
            graph.call_site_scan_valid.resize(node_count)
            for node in 0..<node_count |node, graph, source_work|:
                return false if not proof_replay_structural_work_charge(source_work, 1)
                graph.call_site_scan_valid[node] <- false
            for source_index in 0..<node_count |source_index, graph, index, source_work|:
                return false if not proof_replay_structural_work_charge(source_work, 1)
                graph.out_starts.push(graph.out_targets.count)
                match graph.declarations[source_index]:
                    Ast::Decl.Func(name, parameters, _, body, _, _, position):
                        calls: mutable darray[sview] = []
                        target: mutable ProofReplayCallSiteTarget = ProofReplayCallSiteTarget{enabled: false, ignore_unmatched_scoped_edges: false, allow_scoped_target: false, include_nonassert_contract_calls: true, offset: 0, line: 0, name: "", calls_at_offset: 0, matched_calls: 0, track_unresolved_dispatch: true, unresolved_dispatch_found: false, source_annotations: scratch.source_annotations, field_conversion_parameters: parameters, field_conversion_names: scratch.source_effect_index.field_conversion_names, field_conversion_index_valid: scratch.source_effect_index.field_conversion_index_valid, field_conversion_index_hashes: scratch.source_effect_index.field_conversion_index_hashes, field_conversion_index_values: scratch.source_effect_index.field_conversion_index_values, field_conversion_index_counts: scratch.source_effect_index.field_conversion_index_counts, field_conversion_custom_cast_present: scratch.source_effect_index.field_conversion_custom_cast_present, field_conversion_alias_names: scratch.source_effect_index.alias_names, field_conversion_alias_targets: scratch.source_effect_index.alias_targets, field_conversion_alias_lines: scratch.source_effect_index.alias_lines, field_conversion_bare_alias_root_fallback_valid: scratch.source_effect_index.bare_alias_root_fallback_valid, field_conversion_alias_owners: scratch.source_effect_index.alias_owners, field_conversion_alias_has_formals: scratch.source_effect_index.alias_has_formals, field_conversion_alias_scope_index_valid: scratch.source_effect_index.alias_scope_index_valid, field_conversion_alias_scope_index_hashes: scratch.source_effect_index.alias_scope_index_hashes, field_conversion_alias_scope_index_values: scratch.source_effect_index.alias_scope_index_values, field_conversion_alias_scope_index_counts: scratch.source_effect_index.alias_scope_index_counts, field_conversion_alias_index_valid: scratch.source_effect_index.alias_index_valid, field_conversion_alias_index_hashes: scratch.source_effect_index.alias_index_hashes, field_conversion_alias_index_values: scratch.source_effect_index.alias_index_values, field_conversion_alias_index_counts: scratch.source_effect_index.alias_index_counts, field_conversion_generic_params_valid: scratch.source_generic_params_valid and scratch.source_generic_param_lines.count == scratch.source_generic_param_names.count, field_conversion_generic_param_lines: scratch.source_generic_param_lines, field_conversion_generic_param_names: scratch.source_generic_param_names, field_conversion_generic_param_line: position.line, field_conversion_generic_param_index_valid: scratch.source_effect_index.generic_param_line_index_valid, field_conversion_generic_param_index_hashes: scratch.source_effect_index.generic_param_line_index_hashes, field_conversion_generic_param_index_values: scratch.source_effect_index.generic_param_line_index_values, field_conversion_generic_param_index_counts: scratch.source_effect_index.generic_param_line_index_counts, field_conversion_declared_types: scratch.source_effect_index.declared_types, field_conversion_declared_type_owners: scratch.source_effect_index.declared_type_owners, field_conversion_declared_type_scope_index_valid: scratch.source_effect_index.declared_type_scope_index_valid, field_conversion_declared_type_scope_index_hashes: scratch.source_effect_index.declared_type_scope_index_hashes, field_conversion_declared_type_scope_index_values: scratch.source_effect_index.declared_type_scope_index_values, field_conversion_declared_type_scope_index_counts: scratch.source_effect_index.declared_type_scope_index_counts, field_conversion_declared_type_index_valid: scratch.source_effect_index.declared_type_index_valid, field_conversion_declared_type_index_hashes: scratch.source_effect_index.declared_type_index_hashes, field_conversion_declared_type_index_values: scratch.source_effect_index.declared_type_index_values, field_conversion_declared_type_index_counts: scratch.source_effect_index.declared_type_index_counts}
                        body_work_start: usize = source_work
                        calls_complete: bool = proof_replay_source_calls_with_target_work(parameters, body, scratch.source_annotations, &calls, target, source_work)
                        return false if not calls_complete
                        body_source_work: usize = source_work - body_work_start
                        site_calls: mutable darray[sview] = []
                        site_target: mutable ProofReplayCallSiteTarget = target
                        site_target.enabled <- true
                        site_target.ignore_unmatched_scoped_edges <- false
                        site_target.allow_scoped_target <- false
                        site_target.include_nonassert_contract_calls <- false
                        site_target.offset <- 0
                        site_target.line <- 0
                        site_target.name <- ""
                        site_target.track_unresolved_dispatch <- false
                        site_target.unresolved_dispatch_found <- false
                        site_target.capture_all_call_sites <- true
                        site_scan_valid: bool = proof_replay_source_calls_with_target_work(parameters, body, scratch.source_annotations, &site_calls, site_target, source_work)
                        graph.call_site_scan_valid[source_index] <- site_scan_valid
                        return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return false if site_scan_valid and not proof_replay_structural_call_site_events_append(graph, source_index, site_target, source_work)
                        # The structural graph below resolves leaf names globally. It does
                        # not reconstruct namespace-qualified callee identity, so a scoped
                        # call must taint reachability instead of being connected to an
                        # unrelated declaration with the same leaf name.
                        graph.direct_unresolved_calls[source_index] <- true if not site_scan_valid or site_target.captured_scope_offsets.count > 0
                        contract_range: (complete: bool, start: usize, count: usize) = proof_structural_signature_contract_range_for_line(signature_lines, signature_kinds, signature_contracts, position.line, source_work)
                        return false if not contract_range.complete or contract_range.start > signature_lines.count or contract_range.count > signature_lines.count - contract_range.start
                        contract_work_start: usize = source_work
                        call_index: mutable ProofReplayCallNameIndex = ProofReplayCallNameIndex{}
                        if contract_range.count > 0:
                            return false if not proof_replay_call_name_index_build(calls, call_index, source_work)
                        # Capture scoped calls in source contracts as well. Direct names
                        # still enter `calls`; qualified names are rejected below because
                        # this graph has no namespace-aware resolver.
                        target.enabled <- true
                        target.capture_all_call_sites <- true
                        for contract_offset in 0..<contract_range.count |contract_offset, contract_range, signature_kinds, signature_contracts, parameters, calls, call_index, scratch, source_work|:
                            return false if not proof_replay_structural_work_charge(source_work, 1)
                            signature_index: usize = contract_range.start + contract_offset
                            kind: sview = signature_kinds[signature_index]
                            return false if not proof_replay_structural_work_charge(source_work, sview_len(kind))
                            continue if kind != "requires" and kind != "ensure"
                            return false if not proof_replay_source_expression_calls_with_target_index_work(parameters, signature_contracts[signature_index], scratch.source_annotations, &calls, call_index, target, source_work)
                        graph.direct_unresolved_calls[source_index] <- true if target.captured_scope_offsets.count > 0
                        contract_source_work: usize = source_work - contract_work_start
                        implicit_dispatch_risk: bool = proof_structural_function_has_implicit_dispatch_risk_range(name, position.line, parameters, body, signature_lines, signature_kinds, signature_contracts, contract_range.start, contract_range.count, source_work, scratch)
                        return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or scratch.source_effect_index.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return false if body_source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 5 or contract_source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
                        return false if not proof_replay_structural_work_charge(source_work, body_source_work * 5)
                        return false if not proof_replay_structural_work_charge(source_work, contract_source_work * 2)
                        graph.direct_unresolved_calls[source_index] <- true if target.unresolved_dispatch_found or implicit_dispatch_risk
                        for call in calls |call, graph, index, source_work|:
                            target_source: (complete: bool, matches: usize, entry_index: usize, declaration: Ast::Decl, lemma: bool) = proof_replay_structural_source_lookup(index, call, source_work)
                            return false if not target_source.complete
                            if target_source.matches == 2:
                                graph.direct_unresolved_calls[source_index] <- true
                                continue
                            # No local declaration and erased lemma declarations are not rows in
                            # `ProofFunctionTable`; neither can connect executable SCCs.
                            continue if target_source.matches == 0
                            continue if target_source.lemma
                            match target_source.declaration:
                                Ast::Decl.Func(_, _, _, _, _, _, _):
                                    return false if target_source.entry_index >= graph.node_by_source_entry.count
                                    target_index: usize = graph.node_by_source_entry[target_source.entry_index]
                                    return false if target_index >= node_count
                                    return false if not proof_replay_structural_work_charge(source_work, 1)
                                    graph.out_targets.push(target_index)
                                Ast::Decl.Extern(_, _, _, _, callable, _, decorators, _):
                                    if callable:
                                        extern_risk: (complete: bool, found: bool, unsafe: bool) = proof_source_extern_contract_unsafe_with_work(scratch, call, source_work)
                                        return false if not extern_risk.complete
                                        graph.direct_extern_contract_unsafe[source_index] <- true if extern_risk.found and extern_risk.unsafe
                                        # The runtime ensure index mirrors backend scope and
                                        # excludes deeper Modules/Scoped declarations. The
                                        # recursive structural source index selected this exact
                                        # extern declaration, so inspect its own trust marker
                                        # independently of whether it participates in runtime
                                        # ensure validation.
                                        trusted_marker_seen: mutable bool = false
                                        trusted_markers_valid: mutable bool = true
                                        for decorator in decorators |decorator, source_work, trusted_marker_seen, trusted_markers_valid|:
                                            return false if not proof_replay_structural_work_charge(source_work, 1 + sview_len(decorator.name))
                                            continue if decorator.name != "trusted"
                                            trusted_marker_seen <- true
                                            argument_start: usize = decorator.arg_start.usize()
                                            if decorator.arg_count == 1 and argument_start < scratch.source_annotation_args.count:
                                                reason: sview = scratch.source_annotation_args[argument_start]
                                                return false if not proof_replay_structural_work_charge(source_work, sview_len(reason))
                                                trusted_markers_valid <- false if reason == ""
                                            else:
                                                trusted_markers_valid <- false
                                        trusted: bool = trusted_marker_seen and trusted_markers_valid
                                        # An untrusted extern has no checked body and may diverge
                                        # or call back into structural recursion regardless of
                                        # its ensures. `@trusted` remains the explicit boundary.
                                        graph.direct_unresolved_calls[source_index] <- true if not trusted or extern_risk.found
                                    else:
                                        # A non-callable extern can still be a function-typed
                                        # global invoked through an indirect Fn value. Its target
                                        # cannot be connected to a source body, so keep the call
                                        # opaque for structural-recursion validation.
                                        graph.direct_unresolved_calls[source_index] <- true
                                Ast::Decl.Const(_, _, _, _, _):
                                    graph.direct_unresolved_calls[source_index] <- true
                                _:
                                    pass
                    _:
                        return false
                graph.out_counts.push(graph.out_targets.count - graph.out_starts[source_index])
            return false if not proof_replay_structural_call_site_index_build(graph, source_work)
            graph.reverse_counts.resize(node_count)
            return false if not proof_replay_structural_work_charge(source_work, node_count)
            for target_index in graph.out_targets |target_index, graph, node_count|:
                return false if not proof_replay_structural_work_charge(source_work, 1)
                return false if target_index >= node_count
                graph.reverse_counts[target_index] <- graph.reverse_counts[target_index] + 1
            reverse_cursor: mutable usize = 0
            for incoming in graph.reverse_counts |incoming, graph, reverse_cursor, source_work|:
                return false if not proof_replay_structural_work_charge(source_work, 1)
                graph.reverse_starts.push(reverse_cursor)
                return false if incoming > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - reverse_cursor
                reverse_cursor <- reverse_cursor + incoming
            return false if not proof_replay_structural_work_charge(source_work, reverse_cursor)
            graph.reverse_targets.resize(reverse_cursor)
            return false if not proof_replay_structural_work_charge(source_work, node_count)
            write_cursor: mutable darray[usize] = []
            write_cursor.extend(graph.reverse_starts)
            for source_index in 0..<node_count |source_index, graph, write_cursor|:
                return false if not proof_replay_structural_work_charge(source_work, 1)
                start: usize = graph.out_starts[source_index]
                count: usize = graph.out_counts[source_index]
                return false if start > graph.out_targets.count or count > graph.out_targets.count - start
                for offset in 0..<count |offset, source_index, graph, write_cursor|:
                    return false if not proof_replay_structural_work_charge(source_work, 1)
                    target_index: usize = graph.out_targets[start + offset]
                    slot: usize = write_cursor[target_index]
                    graph.reverse_targets[slot] <- source_index
                    write_cursor[target_index] <- slot + 1
            return source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT and scratch.source_effect_index.implicit_effect_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT

        def proof_replay_structural_validation_cache_build(report: ProofReport&, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if cache.initialized
            cache.initialized <- true
            certificate_index_result: (complete: bool, index: ProofReplayStructuralCertificateIndex) = proof_replay_structural_certificate_index_build(report, source_work)
            return false if not certificate_index_result.complete
            cache.certificate_index <- certificate_index_result.index
            source_index_result: (complete: bool, index: ProofReplayStructuralSourceIndex) = proof_replay_structural_source_index_build(report.source_declarations, report.source_annotations, source_work)
            return false if not source_index_result.complete
            cache.source_index <- source_index_result.index
            cache.enum_index <- proof_build_enum_index(report.source_declarations, source_work)
            return false if not cache.enum_index.complete
            return false if not proof_replay_structural_work_charge(source_work, report.source_declarations.count)
            cache.scratch.source_declarations.extend(report.source_declarations)
            return false if not proof_replay_structural_work_charge(source_work, report.source_annotations.count)
            cache.scratch.source_annotations.extend(report.source_annotations)
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or report.source_annotation_args.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + report.source_annotation_args.count
            for argument in report.source_annotation_args |cache, source_work|:
                return false if not proof_replay_structural_work_charge(source_work, sview_len(argument))
                cache.scratch.source_annotation_args.push(argument)
            return false if not proof_replay_source_generic_param_rows_copy(report.source_generic_param_lines, report.source_generic_param_names, report.source_generic_params_valid, &cache.scratch, source_work)
            return false if not proof_source_conversion_generic_indexes_build(&cache.scratch, source_work)
            return false if not proof_replay_structural_work_charge(source_work, report.source_signature_contract_lines.count)
            cache.scratch.source_signature_contract_lines.extend(report.source_signature_contract_lines)
            return false if not proof_replay_structural_work_charge(source_work, report.source_signature_contract_kinds.count)
            cache.scratch.source_signature_contract_kinds.extend(report.source_signature_contract_kinds)
            return false if not proof_replay_structural_work_charge(source_work, report.source_signature_contracts.count)
            cache.scratch.source_signature_contracts.extend(report.source_signature_contracts)
            return false if not proof_replay_structural_work_charge(source_work, report.source_extern_parameters.count)
            cache.scratch.source_extern_parameters.extend(report.source_extern_parameters)
            operator_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_operator_impl_index(&cache.scratch, source_work)
            return false if not operator_index_status.complete
            operator_mask_status: (complete: bool, primitive_mask: usize, protocol_mask: usize) = proof_source_operator_masks_from_index(cache.scratch, source_work)
            return false if not operator_mask_status.complete
            cache.scratch.source_primitive_operator_mask <- operator_mask_status.primitive_mask
            cache.scratch.source_operator_protocol_mask <- operator_mask_status.protocol_mask
            alias_visibility: (complete: bool, safe: bool) = proof_source_conversion_root_alias_visibility_scan(cache.scratch.source_declarations, cache.scratch.source_annotations, source_work, 0)
            return false if not alias_visibility.complete
            cache.scratch.source_effect_index.bare_alias_root_fallback_valid <- alias_visibility.safe
            drop_type_index: (complete: bool, declared_types: darray[sview], drop_hook_types: darray[sview], alias_names: darray[sview], alias_targets: darray[Ast::Expr], callable_names: darray[sview], callable_return_types: darray[Ast::Expr], callable_lines: darray[u32], field_conversion_names: darray[sview], field_conversion_custom_cast_present: bool, declaration_count: usize) = proof_source_drop_type_index_with_work(cache.scratch.source_declarations, cache.scratch.source_annotations, cache.scratch.source_generic_param_lines, cache.scratch.source_generic_param_names, cache.scratch.source_generic_params_valid and cache.scratch.source_generic_param_lines.count == cache.scratch.source_generic_param_names.count, cache.scratch.source_effect_index, cache.scratch.source_effect_index.bare_alias_root_fallback_valid, &cache.scratch.source_effect_index.alias_index_hashes, &cache.scratch.source_effect_index.alias_index_values, &cache.scratch.source_effect_index.alias_index_counts, source_work)
            return false if not drop_type_index.complete
            cache.scratch.source_effect_index.declared_types <- drop_type_index.declared_types
            cache.scratch.source_effect_index.drop_hook_types <- drop_type_index.drop_hook_types
            cache.scratch.source_effect_index.alias_names <- drop_type_index.alias_names
            cache.scratch.source_effect_index.alias_targets <- drop_type_index.alias_targets
            cache.scratch.source_effect_index.alias_index_valid <- true
            cache.scratch.source_effect_index.callable_names <- drop_type_index.callable_names
            cache.scratch.source_effect_index.callable_return_types <- drop_type_index.callable_return_types
            cache.scratch.source_effect_index.callable_lines <- drop_type_index.callable_lines
            cache.scratch.source_effect_index.field_conversion_names <- drop_type_index.field_conversion_names
            cache.scratch.source_effect_index.field_conversion_custom_cast_present <- drop_type_index.field_conversion_custom_cast_present
            cache.scratch.source_effect_index.declaration_count <- drop_type_index.declaration_count
            return false if not proof_source_effect_callable_index_build(&cache.scratch, source_work)
            return false if not proof_source_effect_field_conversion_index_build(&cache.scratch, source_work)
            return false if not proof_source_conversion_indexes_build(&cache.scratch, source_work)
            return false if not proof_replay_source_generic_param_line_index_build(&cache.scratch, source_work)
            return false if not proof_source_callable_extern_contract_index_build(cache.scratch.source_declarations, cache.scratch.source_extern_parameters, cache.scratch.source_signature_contract_lines, cache.scratch.source_signature_contract_kinds, cache.scratch.source_signature_contracts, &cache.scratch, source_work)
            return false if not proof_replay_structural_source_graph_build(cache.source_index, cache.scratch.source_signature_contract_lines, cache.scratch.source_signature_contract_kinds, cache.scratch.source_signature_contracts, cache.enum_index, &cache.scratch, source_work, &cache.graph)
            return false if not proof_structural_name_index_build(&cache.scratch, &source_work)
            return false if not proof_replay_structural_graph_cache_indexes_build(&cache.graph, source_work)
            return false if cache.scratch.structural.component_ids.count != cache.graph.component_ids.count
            for node_index in 0..<cache.graph.component_ids.count |node_index, cache, source_work|:
                return false if not proof_replay_structural_work_charge(source_work, 1)
                cache.scratch.structural.component_ids[node_index] <- cache.graph.component_ids[node_index]
            cache.complete <- true
            return true

        def proof_replay_structural_certificate_source_valid_with_work(report: ProofReport&, certificate: ProofGoalCertificate, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if certificate.kernel_goal >= report.kernel.nodes.count
            root: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[certificate.kernel_goal]
            return false if root.kind != "structural-safety" or root.secondary_name != "structural-v2" or root.children_count != 1 or root.children_start > report.kernel.children.count or root.children_count > report.kernel.children.count - root.children_start
            return false if not proof_replay_structural_text_compare(root.name, certificate.name, source_work) or root.name != certificate.name
            edge_id: usize = report.kernel.children[root.children_start]
            return false if edge_id >= report.kernel.nodes.count
            edge: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[edge_id]
            return false if edge.kind != "structural-edge"
            return false if not proof_replay_structural_text_compare(edge.name, certificate.name, source_work) or edge.name != certificate.name
            if not cache.initialized:
                return false if not proof_replay_structural_validation_cache_build(report, source_work, &cache)
            return false if not cache.complete
            certificate_owner: (complete: bool, owner_index: usize) = proof_replay_structural_certificate_owner_lookup(cache.certificate_index, certificate.name, source_work)
            return false if not certificate_owner.complete or certificate_owner.owner_index >= cache.certificate_index.owners.count
            return true if cache.certificate_index.owners[certificate_owner.owner_index].source_validated
            source_owner: (complete: bool, matches: usize, entry_index: usize, declaration: Ast::Decl, lemma: bool) = proof_replay_structural_source_lookup(cache.source_index, certificate.name, source_work)
            source_callee: (complete: bool, matches: usize, entry_index: usize, declaration: Ast::Decl, lemma: bool) = proof_replay_structural_source_lookup(cache.source_index, edge.secondary_name, source_work)
            return false if not source_owner.complete or source_owner.matches != 1 or source_owner.lemma
            return false if not source_callee.complete or source_callee.matches != 1 or source_callee.lemma
            match source_owner.declaration:
                Ast::Decl.Func(_, parameters, _, body, _, _, position):
                    callee_is_function: mutable bool = false
                    match source_callee.declaration:
                        Ast::Decl.Func(_, _, _, _, _, _, _):
                            callee_is_function <- true
                        _:
                            pass
                    return false if not callee_is_function
                    return false if source_owner.entry_index >= cache.graph.node_by_source_entry.count or source_callee.entry_index >= cache.graph.node_by_source_entry.count
                    caller_node: usize = cache.graph.node_by_source_entry[source_owner.entry_index]
                    callee_node: usize = cache.graph.node_by_source_entry[source_callee.entry_index]
                    return false if caller_node >= cache.graph.declarations.count or callee_node >= cache.graph.declarations.count
                    return false if not proof_replay_structural_call_site_matches(cache.graph, caller_node, root.left, edge.secondary_name, certificate.line, source_work)
                    return false if caller_node >= cache.scratch.structural.members.count or not cache.scratch.structural.members[caller_node]
                    return false if not proof_replay_structural_graph_has_edge(cache.graph, caller_node, callee_node, source_work)
                    return false if cache.graph.component_ids.count != cache.graph.declarations.count or cache.graph.reachable_extern_contract_unsafe.count != cache.graph.declarations.count or cache.graph.reachable_unresolved_calls.count != cache.graph.declarations.count
                    return false if cache.graph.component_ids[caller_node] != cache.graph.component_ids[callee_node]
                    extern_unsafe: bool = cache.graph.reachable_extern_contract_unsafe[caller_node]
                    return false if not proof_replay_structural_charge_check_preflight(parameters, body, source_work)
                    cache.scratch.findings.clear()
                    cache.scratch.counterexample_facts.clear()
                    cache.scratch.goal_attempts.clear()
                    cache.scratch.obligation_inventory.clear()
                    cache.scratch.certificates.clear()
                    cache.scratch.certificate_facts.clear()
                    cache.scratch.kernel <- ProofKernelArena{}
                    cache.scratch.failed <- 0
                    cache.scratch.obligations <- 0
                    cache.scratch.proven <- 0
                    cache.scratch.structural.verified_names.clear()
                    cache.scratch.structural.identity_next <- 0
                    unresolved_reachable: bool = caller_node >= cache.graph.reachable_unresolved_calls.count or cache.graph.reachable_unresolved_calls[caller_node]
                    proof_check_structural_function(cache.enum_index, certificate.name, position.line, parameters, body, true, extern_unsafe, unresolved_reachable, report.source_signature_contract_lines, report.source_signature_contract_kinds, report.source_signature_contracts, source_work, &cache.scratch)
                    return false if cache.scratch.source_effect_index.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return false if cache.scratch.failed != 0 or cache.scratch.kernel.budget_exhausted
                    owner_verified: mutable bool = false
                    for verified_name in cache.scratch.structural.verified_names |certificate, source_work, owner_verified|:
                        return false if not proof_replay_structural_text_compare(verified_name, certificate.name, source_work)
                        owner_verified <- true if verified_name == certificate.name
                    return false if not owner_verified
                    return false if not proof_replay_structural_certificate_set_matches_with_work(report, cache.certificate_index, certificate.name, cache.scratch, source_work)
                    return false if not proof_replay_structural_text_compare(certificate.name, certificate.name, source_work)
                    cache.certificate_index.owners[certificate_owner.owner_index].source_validated <- true
                    return true
                _:
                    return false
