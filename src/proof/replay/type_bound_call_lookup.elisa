# Owner-aware lookup for type-bound return shapes.
extend ElisaProof:
    private:
        def proof_replay_type_bound_call_type_lookup_with_work(report: ProofReport&, declarations: darray[Ast::Decl]&, current_scope: mutable darray[sview]&, wanted_scope: darray[sview]&, wanted_name: sview, exact_scope: bool, best_depth: mutable usize&, matches: mutable usize&, kind: mutable i64&, target: mutable Ast::Expr&, is_const_enum: mutable bool&, alias_line: mutable u32&, alias_offset: mutable usize&, owner_scope: mutable darray[sview]&, opaque_classified: mutable bool&, opaque_policy: mutable i64&, work: mutable usize&, depth: usize) -> bool:
            can Abort.Panic:
                return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
                for declaration in declarations |current_scope, wanted_scope, wanted_name, exact_scope, best_depth, matches, kind, target, is_const_enum, alias_line, alias_offset, owner_scope, opaque_classified, opaque_policy, work, depth|:
                    return false if not proof_replay_type_bound_local_work_charge(1, work)
                    match declaration:
                        Ast::Decl.Alias(name, alias_target, position):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                scope_match: (complete: bool, allowed: bool, local: bool, root: bool) = proof_replay_type_bound_call_scope_match_with_work(current_scope, wanted_scope, exact_scope, work)
                                return false if not scope_match.complete
                                if scope_match.allowed:
                                    rank: usize = 3 if exact_scope else 5 if scope_match.local else 1
                                    if rank > best_depth:
                                        best_depth <- rank
                                        matches <- 1
                                        kind <- 1
                                        target <- alias_target
                                        alias_line <- position.line
                                        alias_offset <- position.offset.usize()
                                        is_const_enum <- false
                                        return false if not proof_replay_type_bound_local_work_charge(current_scope.count, work)
                                        owner_scope.clear()
                                        owner_scope.extend(current_scope)
                                    elif rank == best_depth:
                                        matches <- matches + 1
                                        return false if matches > 1
                        Ast::Decl.Struct(name, _, _, _, _, _, _):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                scope_match: (complete: bool, allowed: bool, local: bool, root: bool) = proof_replay_type_bound_call_scope_match_with_work(current_scope, wanted_scope, exact_scope, work)
                                return false if not scope_match.complete
                                if scope_match.allowed:
                                    rank: usize = 1 if exact_scope else 3 if scope_match.local else 2
                                    if rank > best_depth:
                                        best_depth <- rank
                                        matches <- 1
                                        kind <- 2
                                        is_const_enum <- false
                                        return false if not proof_replay_type_bound_local_work_charge(current_scope.count, work)
                                        owner_scope.clear()
                                        owner_scope.extend(current_scope)
                                    elif rank == best_depth:
                                        matches <- matches + 1
                                        return false if matches > 1
                        Ast::Decl.Enum(name, _, enum_is_const, _, _):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                scope_match: (complete: bool, allowed: bool, local: bool, root: bool) = proof_replay_type_bound_call_scope_match_with_work(current_scope, wanted_scope, exact_scope, work)
                                return false if not scope_match.complete
                                if scope_match.allowed:
                                    rank: usize = 1 if exact_scope else 3 if scope_match.local else 2
                                    if rank > best_depth:
                                        best_depth <- rank
                                        matches <- 1
                                        kind <- 3
                                        is_const_enum <- enum_is_const
                                        return false if not proof_replay_type_bound_local_work_charge(current_scope.count, work)
                                        owner_scope.clear()
                                        owner_scope.extend(current_scope)
                                    elif rank == best_depth:
                                        matches <- matches + 1
                                        return false if matches > 1
                        Ast::Decl.Module(module_name, nested, _):
                            nested_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(current_scope, module_name, work)
                            return false if not nested_scope.complete
                            saved_count: usize = current_scope.count
                            current_scope <- nested_scope.scope
                            return false if not proof_replay_type_bound_call_type_lookup_with_work(report, nested, current_scope, wanted_scope, wanted_name, exact_scope, best_depth, matches, kind, target, is_const_enum, alias_line, alias_offset, owner_scope, opaque_classified, opaque_policy, work, depth + 1)
                            current_scope.resize(saved_count)
                        Ast::Decl.Scoped(nested, _):
                            return false if not proof_replay_type_bound_call_type_lookup_with_work(report, nested, current_scope, wanted_scope, wanted_name, exact_scope, best_depth, matches, kind, target, is_const_enum, alias_line, alias_offset, owner_scope, opaque_classified, opaque_policy, work, depth + 1)
                        Ast::Decl.Invalid:
                            return false
                        Ast::Decl.Import(import_name, _):
                            return false if not proof_replay_type_bound_local_text_compare_charge(import_name, wanted_name, work)
                            visible: mutable (complete: bool, visible: bool) = (true, false)
                            if import_name == wanted_name and not exact_scope:
                                visible <- proof_replay_type_bound_scope_prefix_with_work(current_scope, wanted_scope, work)
                            return false if import_name == wanted_name and not exact_scope and (not visible.complete or visible.visible)
                        Ast::Decl.Extern(name, _, arity, _, callable, return_type_name, _, position):
                            return false if not proof_replay_type_bound_local_text_compare_charge(name, wanted_name, work)
                            if name == wanted_name:
                                return false if not proof_replay_type_bound_local_work_charge(sview_len(return_type_name), work)
                                take_opaque: mutable bool = false
                                if not proof_goal_bool_ref_value(opaque_classified) and not callable and arity == 0 and return_type_name == "":
                                    opaque: (complete: bool, opaque_alias: bool, policy: i64) = proof_replay_type_bound_call_opaque_extern_alias_with_work(report, name, arity, callable, return_type_name, position.offset.usize(), work)
                                    return false if not opaque.complete
                                    opaque_classified <- true
                                    opaque_policy <- opaque.policy
                                    take_opaque <- opaque.opaque_alias
                                elif proof_goal_bool_ref_value(opaque_classified) and opaque_policy == 2 and not callable and arity == 0 and return_type_name == "":
                                    take_opaque <- true
                                if take_opaque:
                                    opaque_policy <- 0 if current_scope.count == 0
                                    scope_match: (complete: bool, allowed: bool, local: bool, root: bool) = proof_replay_type_bound_call_scope_match_with_work(current_scope, wanted_scope, exact_scope, work)
                                    return false if not scope_match.complete
                                    if scope_match.allowed:
                                        rank: usize = 2 if exact_scope else 4 if scope_match.local else 1
                                        if rank > best_depth:
                                            best_depth <- rank
                                            matches <- 1
                                            kind <- 2
                                            return false if not proof_replay_type_bound_local_work_charge(current_scope.count, work)
                                            owner_scope.clear()
                                            owner_scope.extend(current_scope)
                                        elif rank == best_depth:
                                            matches <- matches + 1
                                            return false if matches > 1
                        Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Law(_, _, _):
                            pass
                        _:
                            return false
                return true
