# Report-scoped caches for source-backed deterministic replay.
extend ElisaProof:
    private:
        # Cache the metered index only for the report and source snapshot that produced it.
        def proof_replay_deterministic_call_declaration_index_ensure(report: ProofReport&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if not cache.declaration_index_attempted or cache.declaration_index_report_identity != report_identity or cache.declaration_index_source_identity != source_identity:
                cache.declaration_index <- ProofReplayDeterministicDeclarationIndex{}
                cache.declaration_index_attempted <- true
                cache.declaration_index_report_identity <- report_identity
                cache.declaration_index_source_identity <- source_identity
                return false if not proof_replay_deterministic_declaration_index_build(report.source.source_declarations, report.source.source_annotations, &cache.declaration_index, work)
            return cache.declaration_index.valid
        def proof_replay_deterministic_call_alias_index_ensure(report: ProofReport&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if not cache.alias_index_attempted or cache.alias_index_report_identity != report_identity or cache.alias_index_source_identity != source_identity:
                cache.alias_index <- ProofModuleAliasIndex{names: [], targets: [], scopes: [], lines: [], offsets: [], alias_lookup_hashes: [], alias_lookup_values: [], alias_lookup_ambiguous: [], global_alias_lookup_hashes: [], global_alias_lookup_values: [], function_lookup_hashes: [], function_lookup_values: [], function_lookup_ambiguous: [], function_lookup_complete: false, complete: false}
                cache.alias_index_attempted <- true
                cache.alias_index_report_identity <- report_identity
                cache.alias_index_source_identity <- source_identity
                status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_module_alias_index(report.source.source_annotations, &cache.alias_index, work)
                return false if not status.complete or not cache.alias_index.complete
            return cache.alias_index.complete

        def proof_replay_deterministic_call_alias_imports_ensure(report: ProofReport&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if not cache.alias_imports_checked or cache.alias_imports_report_identity != report_identity or cache.alias_imports_source_identity != source_identity:
                cache.alias_imports_checked <- true
                cache.alias_imports_report_identity <- report_identity
                cache.alias_imports_source_identity <- source_identity
                cache.alias_imports_supported <- false
                alias_count: mutable usize = 0
                return false if not proof_replay_deterministic_module_alias_imports_supported(report.source.source_annotations, &alias_count, work)
                import_count: mutable usize = 0
                matched_import_count: mutable usize = 0
                return false if not proof_replay_deterministic_alias_import_declarations_supported(report.source.source_declarations, report.source.source_annotations, &import_count, &matched_import_count, work, 0)
                cache.alias_imports_supported <- import_count == alias_count and matched_import_count == import_count
            return cache.alias_imports_supported

        def proof_replay_deterministic_analysis_context_ensure(report: ProofReport&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if not cache.analysis_context_attempted or cache.analysis_context_report_identity != report_identity or cache.analysis_context_source_identity != source_identity:
                cache.analysis_scratch <- ProofReport{}
                cache.analysis_context_attempted <- true
                cache.analysis_context_report_identity <- report_identity
                cache.analysis_context_source_identity <- source_identity
                cache.analysis_context_valid <- proof_replay_deterministic_analysis_context_build(report.source.source_declarations, report.source.source_annotations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_generic_param_owner_offsets, report.source_types.source_generic_params_valid, report.source_types.source_generic_owner_params_valid, &cache.analysis_scratch, work)
            return cache.analysis_context_valid
