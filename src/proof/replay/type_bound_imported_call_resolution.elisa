extend ElisaProof:
    private:
        def proof_replay_type_bound_imported_callee_with_work(report: ProofReport&, caller_scope: darray[sview]&, wanted: sview, argument_count: usize, argument_names: darray[sview]&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> (known: bool, line: u32, offset: u32, module_path: darray[sview]):
            target_module: mutable sview = ""
            for index in 0..<report.source.source_annotations.count |index, report, caller_scope, wanted, target_module, work|:
                annotation: Ast::EnumAnnotation = report.source.source_annotations[index]
                return (false, 0, 0, []) if not proof_replay_type_bound_local_work_charge(1, work)
                wildcard: mutable bool = false
                member: mutable bool = false
                return (false, 0, 0, []) if not proof_replay_type_bound_local_text_compare_charge(annotation.name, "__binding_wildcard_import", work)
                wildcard <- annotation.name == "__binding_wildcard_import"
                return (false, 0, 0, []) if not proof_replay_type_bound_local_text_compare_charge(annotation.owner, "__from_member", work)
                member <- annotation.owner == "__from_member"
                if member:
                    return (false, 0, 0, []) if not proof_replay_type_bound_local_text_compare_charge(annotation.name, wanted, work)
                continue if not wildcard and (not member or annotation.name != wanted)
                importer: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work([], annotation.module, work)
                return (false, 0, 0, []) if not importer.complete or importer.scope.count > caller_scope.count
                visible: mutable bool = true
                for scope_index in 0..<importer.scope.count |scope_index, importer, caller_scope, visible, work|:
                    return (false, 0, 0, []) if not proof_replay_type_bound_local_text_compare_charge(importer.scope[scope_index], caller_scope[scope_index], work)
                    visible <- false if importer.scope[scope_index] != caller_scope[scope_index]
                continue if not visible
                imported_module: mutable sview = ""
                if wildcard:
                    return (false, 0, 0, []) if index == 0
                    using: Ast::EnumAnnotation = report.source.source_annotations[index - 1]
                    return (false, 0, 0, []) if:
                        not proof_replay_type_bound_local_text_compare_charge(using.name, "__using", work) or not proof_replay_type_bound_local_text_compare_charge(using.owner, annotation.owner, work) or not proof_replay_type_bound_local_text_compare_charge(using.module, annotation.module, work)
                        using.name != "__using" or using.owner != annotation.owner or using.module != annotation.module or using.line != annotation.line or using.offset != annotation.offset
                    imported_module <- annotation.owner
                else:
                    return (false, 0, 0, []) if index + 1 >= report.source.source_annotations.count
                    source: Ast::EnumAnnotation = report.source.source_annotations[index + 1]
                    return (false, 0, 0, []) if:
                        not proof_replay_type_bound_local_text_compare_charge(source.owner, "__from_src", work) or not proof_replay_type_bound_local_text_compare_charge(source.module, annotation.module, work)
                        source.owner != "__from_src" or source.name == "" or source.module != annotation.module or source.line != annotation.line or source.offset != annotation.offset
                    if index + 2 < report.source.source_annotations.count:
                        using: Ast::EnumAnnotation = report.source.source_annotations[index + 2]
                        return (false, 0, 0, []) if not proof_replay_type_bound_local_text_compare_charge(using.name, "__using_member", work)
                        if using.name == "__using_member":
                            return (false, 0, 0, []) if:
                                not proof_replay_type_bound_local_text_compare_charge(using.owner, source.name, work) or not proof_replay_type_bound_local_text_compare_charge(using.module, annotation.name, work)
                                using.owner != source.name or using.module != annotation.name or using.line != annotation.line or using.offset != annotation.offset
                    imported_module <- source.name
                return (false, 0, 0, []) if imported_module == ""
                if target_module == "":
                    target_module <- imported_module
                else:
                return (false, 0, 0, []) if:
                        not proof_replay_type_bound_local_text_compare_charge(target_module, imported_module, work)
                        target_module != imported_module
            return (false, 0, 0, []) if:
                target_module == ""
                not proof_replay_deterministic_call_declaration_index_ensure(report.source.source_declarations, report.source.source_annotations, work, cache)
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(cache.declaration_index, wanted, work)
            return (false, 0, 0, []) if not group.complete
            selected_line: mutable u32 = 0
            selected_offset: mutable u32 = 0
            selected_count: mutable usize = 0
            row: mutable usize = group.head
            for _ in 0..<group.count |group, cache, target_module, row, selected_line, selected_offset, selected_count, argument_count, argument_names, report, work|:
                return (false, 0, 0, []) if row >= cache.declaration_index.entries.count
                entry: ProofReplayDeterministicDeclarationEntry = cache.declaration_index.entries[row]
                return (false, 0, 0, []) if not proof_replay_type_bound_local_work_charge(1, work) or not proof_replay_type_bound_local_text_compare_charge(entry.owner, target_module, work)
                if entry.is_function and not entry.is_lemma and entry.owner == target_module:
                    match entry.declaration:
                        Ast::Decl.Func(_, parameters, _, _, _, _, position):
                            shape: (complete: bool, matches: bool) = proof_replay_type_bound_candidate_accepts_call_shape_with_work(cache.declaration_index, parameters, argument_count, argument_names, report.source.source_annotations, position.line, work)
                            return (false, 0, 0, []) if not shape.complete
                            if shape.matches:
                                selected_line <- position.line
                                selected_offset <- position.offset
                                selected_count <- selected_count + 1
                        _:
                            return (false, 0, 0, [])
                row <- entry.next_index
            return (false, 0, 0, []) if row != cache.declaration_index.entries.count
            return (false, 0, 0, []) if selected_count > 1
            return (false, 0, 0, []) if selected_count == 0
            return (false, 0, 0, []) if selected_line == 0
            selected_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work([], target_module, work)
            return (false, 0, 0, []) if not selected_scope.complete
            return (true, selected_line, selected_offset, selected_scope.scope)

        # The backend dispatches these bare call shapes before ordinary function lookup.
        # This witness has no argument-type resolver, so it cannot safely borrow a declared
        # return type when one of these intrinsics handles the call first.
        def proof_replay_type_bound_bare_intrinsic_call_with_work(name: sview, argument_count: usize, work: mutable usize&) -> (complete: bool, intrinsic: bool):
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "pop", work)
            return (true, true) if name == "pop" and argument_count == 1
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "dense_key", work)
            return (true, true) if name == "dense_key" and argument_count == 2
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "llvm_va_copy", work)
            return (true, true) if name == "llvm_va_copy" and argument_count == 2
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "ctx_hash_value", work)
            return (true, true) if name == "ctx_hash_value" and argument_count == 1
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "__fstr", work)
            return (true, true) if name == "__fstr"
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "size_of", work)
            return (true, true) if name == "size_of" and argument_count == 1
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "split_at", work)
            return (true, true) if name == "split_at" and argument_count == 2
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "reduce_sum", work)
            return (true, true) if name == "reduce_sum" and argument_count >= 2
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "zip_map", work)
            return (true, true) if name == "zip_map" and argument_count == 4
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "chunks_exact", work)
            return (true, true) if name == "chunks_exact" and argument_count == 2
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "readonly", work)
            return (true, true) if name == "readonly" and argument_count == 1
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "sview", work)
            return (true, true) if name == "sview" and argument_count == 3
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "arena_alloc", work)
            return (true, true) if name == "arena_alloc" and argument_count == 2
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "load", work)
            return (true, true) if name == "load" and argument_count == 2
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "store", work)
            return (true, true) if name == "store" and argument_count == 3
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "exchange", work)
            return (true, true) if name == "exchange" and argument_count == 3
            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "compare_exchange", work)
            return (true, true) if name == "compare_exchange" and argument_count == 5
            for operation in ["fetch_add", "fetch_sub", "fetch_or", "fetch_and", "fetch_xor", "fence"] |operation, name, argument_count, work|:
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, operation, work)
                return (true, true) if name == operation and (argument_count == 1 if operation == "fence" else argument_count == 3)
            for scalar_name in ["cstr", "sview", "i8", "i16", "i32", "isize", "int", "i64", "u8", "u16", "u32", "usize", "uintptr", "u64", "bool", "char", "f32", "f64", "void"] |scalar_name, name, argument_count, work|:
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, scalar_name, work)
                return (true, true) if name == scalar_name and argument_count == 1
            return (true, false)

        # Prefix casts to packed/payload enum types dispatch through a matching
        # `__cast__` hook before ordinary bare function lookup. Without source type
        # inference, any same-named enum or struct is a possible cast target.
        def proof_replay_type_bound_bare_prefix_cast_type_collision_with_work(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, argument_count: usize, work: mutable usize&) -> (complete: bool, collision: bool):
            return (true, false) if argument_count != 1
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(index, wanted, work)
            return (false, false) if not group.complete
            row: mutable usize = group.head
            for _ in 0..<group.count |group, index, wanted, row, work|:
                return (false, false) if row >= index.entries.count or not proof_replay_type_bound_local_work_charge(1, work)
                entry: ProofReplayDeterministicDeclarationEntry = index.entries[row]
                match entry.declaration:
                    Ast::Decl.Enum(name, _, _, _, _):
                        return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work)
                        return (true, true) if name == wanted
                    _:
                        pass
                row <- entry.next_index
            return (false, false) if row != index.entries.count
            return (true, false)

        def proof_replay_type_bound_no_callable_extern_name_with_work(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, work: mutable usize&) -> bool:
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(index, wanted, work)
            return false if not group.complete
            row: mutable usize = group.head
            for _ in 0..<group.count |group, index, row, wanted, work|:
                return false if row >= index.entries.count or not proof_replay_type_bound_local_work_charge(1, work)
                entry: ProofReplayDeterministicDeclarationEntry = index.entries[row]
                match entry.declaration:
                    Ast::Decl.Extern(name, _, _, _, callable, _, _, _):
                        return false if:
                            callable and not proof_replay_type_bound_local_text_compare_charge(name, wanted, work)
                            callable and name == wanted
                    _:
                        pass
                row <- entry.next_index
            return row == index.entries.count

        def proof_replay_type_bound_function_line_unique_with_work(index: ProofReplayDeterministicDeclarationIndex&, function_line: u32, work: mutable usize&) -> (complete: bool, unique: bool):
            function_count: mutable usize = 0
            for entry in index.entries |entry, function_line, function_count, work|:
                return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                match entry.declaration:
                    Ast::Decl.Func(_, _, _, _, _, _, position):
                        if position.line == function_line:
                            function_count <- function_count + 1
                            return (true, false) if function_count > 1
                    _:
                        pass
            return (true, function_count == 1)

        def proof_replay_type_bound_candidate_accepts_call_shape_with_work(index: ProofReplayDeterministicDeclarationIndex&, parameters: darray[Ast::ParamDecl]&, argument_count: usize, argument_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, function_line: u32, work: mutable usize&) -> (complete: bool, matches: bool):
            return (false, false) if argument_names.count != 0 and argument_names.count != argument_count
            has_named: mutable bool = false
            for argument_name in argument_names |argument_name, has_named, work|:
                return (false, false) if not proof_replay_type_bound_local_work_charge(sview_len(argument_name), work)
                has_named <- true if argument_name != ""
            variadic: mutable bool = false
            variadic_annotations: mutable usize = 0
            if argument_count > parameters.count or has_named:
                for annotation in annotations |annotation, function_line, variadic, variadic_annotations, work|:
                    return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                    return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.owner, "__variadic", work) or not proof_replay_type_bound_local_text_compare_charge(annotation.name, "__variadic", work)
                    if annotation.owner == "__variadic" and annotation.name == "__variadic" and annotation.line == function_line:
                        variadic <- true
                        variadic_annotations <- variadic_annotations + 1
                if variadic:
                    return (false, false) if variadic_annotations != 1
                    line_identity: (complete: bool, unique: bool) = proof_replay_type_bound_function_line_unique_with_work(index, function_line, work)
                    return (false, false) if not line_identity.complete or not line_identity.unique
            return (true, false) if variadic and has_named
            if not has_named:
                return (true, false) if argument_count > parameters.count and not variadic
                if argument_count < parameters.count:
                    for parameter_index in argument_count..<parameters.count |parameter_index, argument_count, parameters, work|:
                        return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                        return (true, false) if not parameters[parameter_index].has_default
                return (true, true)
            return (true, false) if argument_count > parameters.count and not variadic
            return (false, false) if not proof_replay_type_bound_local_work_charge(parameters.count, work)
            assigned: mutable darray[bool] = [false for _ in 0..<parameters.count]
            next_position: mutable usize = 0
            for source_position in 0..<argument_count |source_position, argument_count, argument_names, parameters, assigned, next_position, variadic, work|:
                argument_name: sview = argument_names[source_position] if argument_names.count > 0 else ""
                if source_position >= parameters.count:
                    return (true, false) if not variadic or argument_name != ""
                    continue
                selected: mutable usize = parameters.count
                if argument_name != "":
                    label_matches: mutable usize = 0
                    for parameter_index in 0..<parameters.count |parameter_index, parameters, argument_name, selected, work|:
                        return (false, false) if not proof_replay_type_bound_local_text_compare_charge(parameters[parameter_index].name, argument_name, work)
                        if parameters[parameter_index].name == argument_name:
                            selected <- parameter_index
                            label_matches <- label_matches + 1
                    return (true, false) if label_matches != 1
                else:
                    while next_position < parameters.count and assigned[next_position] |next_position, assigned|:
                        next_position <- next_position + 1
                    selected <- next_position
                    next_position <- next_position + 1 if next_position < parameters.count
                return (true, false) if selected >= parameters.count or assigned[selected]
                assigned[selected] <- true
            for parameter_index in 0..<parameters.count |parameter_index, parameters, assigned, work|:
                return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                return (true, false) if not assigned[parameter_index] and not parameters[parameter_index].has_default
            return (true, true)

        def proof_replay_type_bound_bare_type_mentions_name_with_work(expression: Ast::Expr, wanted: sview, work: mutable usize&, depth: usize) -> (complete: bool, present: bool):
            return (false, false) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Absent:
                    return (true, false)
                Ast::Expr.Ident(name, _):
                    return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work)
                    return (true, name == wanted)
                Ast::Expr.Scope(base, name, _):
                    return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work)
                    return (true, true) if name == wanted
                    return proof_replay_type_bound_bare_type_mentions_name_with_work(base, wanted, work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_type_bound_bare_type_mentions_name_with_work(inner, wanted, work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    left: (complete: bool, present: bool) = proof_replay_type_bound_bare_type_mentions_name_with_work(base, wanted, work, depth + 1)
                    return (false, false) if not left.complete
                    return (true, true) if left.present
                    proof_replay_type_bound_bare_type_mentions_name_with_work(predicate, wanted, work, depth + 1)
                Ast::Expr.Index(head, argument, _) | Ast::Expr.Binary(head, _, argument, _):
                    left: (complete: bool, present: bool) = proof_replay_type_bound_bare_type_mentions_name_with_work(head, wanted, work, depth + 1)
                    return (false, false) if not left.complete
                    return (true, true) if left.present
                    proof_replay_type_bound_bare_type_mentions_name_with_work(argument, wanted, work, depth + 1)
                Ast::Expr.IndexN(head, arguments, _):
                    left: (complete: bool, present: bool) = proof_replay_type_bound_bare_type_mentions_name_with_work(head, wanted, work, depth + 1)
                    return (false, false) if not left.complete
                    return (true, true) if left.present
                    for argument in arguments |argument, wanted, work, depth|:
                        found: (complete: bool, present: bool) = proof_replay_type_bound_bare_type_mentions_name_with_work(argument, wanted, work, depth + 1)
                        return (false, false) if not found.complete
                        return (true, true) if found.present
                    return (true, false)
                Ast::Expr.Tuple(elements, _) | Ast::Expr.Array(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |element, wanted, work, depth|:
                        found: (complete: bool, present: bool) = proof_replay_type_bound_bare_type_mentions_name_with_work(element, wanted, work, depth + 1)
                        return (false, false) if not found.complete
                        return (true, true) if found.present
                    return (true, false)
                _:
                    return (false, false)

        def proof_replay_type_bound_bare_generic_parameter_inferred_with_work(parameters: darray[Ast::ParamDecl]&, argument_count: usize, generic_name: sview, work: mutable usize&) -> (complete: bool, present: bool):
            # The pinned Stage1 infer_generic_args routine pairs raw arguments and formals by
            # source position, even when call labels are present. Mirror that behavior here.
            limit: usize = parameters.count if parameters.count < argument_count else argument_count
            for parameter_index in 0..<limit |parameter_index, parameters, generic_name, work|:
                mentions: (complete: bool, present: bool) = proof_replay_type_bound_bare_type_mentions_name_with_work(parameters[parameter_index].type_expression, generic_name, work, 0)
                return (false, false) if not mentions.complete
                return (true, true) if mentions.present
            return (true, false)

        def proof_replay_type_bound_bare_generic_line_unique_with_work(index: ProofReplayDeterministicDeclarationIndex&, line: u32, work: mutable usize&) -> bool:
            return false if line == 0
            declarations: mutable usize = 0
            for entry in index.entries |entry, line, declarations, work|:
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                match entry.declaration:
                    Ast::Decl.Func(_, _, _, _, _, _, position) | Ast::Decl.Struct(_, _, _, _, _, _, position):
                        if position.line == line:
                            declarations <- declarations + 1
                            return false if declarations > 1
                    _:
                        pass
            return declarations == 1

        def proof_replay_type_bound_bare_generic_candidate_with_work(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, argument_count: usize, argument_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, caller_scope: darray[sview]&, generic_lines: darray[u32]&, generic_names: darray[sview]&, generic_metadata_valid: bool, work: mutable usize&) -> (complete: bool, present: bool):
            # Bare inferred generic calls need an argument from which to infer the type slot;
            # the pinned emitter declines the zero-argument case before generic dispatch.
            return (true, false) if argument_count == 0
            return (false, false) if not generic_metadata_valid or generic_lines.count != generic_names.count
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(index, wanted, work)
            return (false, false) if not group.complete
            row: mutable usize = group.head
            selected_priority: mutable usize = 3
            selected_row: mutable usize = index.entries.count
            for _ in 0..<group.count |group, index, wanted, row, generic_lines, generic_names, caller_scope, selected_priority, selected_row, work|:
                return (false, false) if row >= index.entries.count or not proof_replay_type_bound_local_work_charge(1, work)
                entry: ProofReplayDeterministicDeclarationEntry = index.entries[row]
                if entry.is_function and not entry.is_lemma:
                    match entry.declaration:
                        Ast::Decl.Func(name, parameters, _, _, _, _, position):
                            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work)
                            if name == wanted:
                                generic_parameters: mutable darray[sview] = []
                                for generic_index in 0..<generic_lines.count |generic_index, generic_lines, generic_names, position, generic_parameters, work|:
                                    return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                                    generic_parameters.push(generic_names[generic_index]) if generic_lines[generic_index] == position.line
                                if generic_parameters.count > 0:
                                    candidate_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work([], entry.owner, work)
                                    return (false, false) if not candidate_scope.complete
                                    same_owner: (complete: bool, equal: bool) = proof_replay_type_bound_scope_equal_with_work(candidate_scope.scope, caller_scope, work)
                                    return (false, false) if not same_owner.complete
                                    priority: mutable usize = 2 if caller_scope.count > 0 else 1
                                    priority <- 0 if caller_scope.count > 0 and same_owner.equal
                                    priority <- 1 if caller_scope.count > 0 and candidate_scope.scope.count == 0
                                    priority <- 0 if caller_scope.count == 0 and candidate_scope.scope.count == 0
                                    if priority < selected_priority or (priority == selected_priority and row < selected_row):
                                        selected_priority <- priority
                                        selected_row <- row
                        _:
                            return (false, false)
                row <- entry.next_index
            return (false, false) if row != index.entries.count
            return (true, false) if selected_priority == 3
            return (false, false) if selected_row >= index.entries.count or not proof_replay_type_bound_local_work_charge(1, work)
            selected: ProofReplayDeterministicDeclarationEntry = index.entries[selected_row]
            return (false, false) if not selected.is_function or selected.is_lemma
            match selected.declaration:
                Ast::Decl.Func(name, parameters, _, _, _, _, position):
                    return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work) or name != wanted
                    generic_parameters: mutable darray[sview] = []
                    for generic_index in 0..<generic_lines.count |generic_index, generic_lines, generic_names, position, generic_parameters, work|:
                        return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                        generic_parameters.push(generic_names[generic_index]) if generic_lines[generic_index] == position.line
                    return (false, false) if generic_parameters.count == 0
                    return (false, false) if not proof_replay_type_bound_bare_generic_line_unique_with_work(index, position.line, work)
                    return (false, false) if position.line == 0
                    shape: (complete: bool, matches: bool) = proof_replay_type_bound_candidate_accepts_call_shape_with_work(index, parameters, argument_count, argument_names, annotations, position.line, work)
                    return (false, false) if not shape.complete
                    return (true, false) if not shape.matches
                    all_inferable: mutable bool = true
                    for generic_name in generic_parameters |generic_name, parameters, argument_count, all_inferable, work|:
                        inferred: (complete: bool, present: bool) = proof_replay_type_bound_bare_generic_parameter_inferred_with_work(parameters, argument_count, generic_name, work)
                        return (false, false) if not inferred.complete
                        all_inferable <- false if not inferred.present
                    return (true, all_inferable)
                _:
                    return (false, false)

        def proof_replay_type_bound_bare_target_emitter_safe_with_work(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, wanted_line: u32, wanted_offset: usize, exact_owner: bool, argument_count: usize, argument_names: darray[sview]&, annotations: darray[Ast::EnumAnnotation]&, caller_scope: darray[sview]&, target_scope: darray[sview]&, generic_lines: darray[u32]&, generic_names: darray[sview]&, generic_metadata_valid: bool, work: mutable usize&) -> bool:
            # Replay does not infer argument sorts. Mirror shape-based owner precedence,
            # including defaults and labels, then require one accepting row in that owner.
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(index, wanted, work)
            return false if not group.complete
            function_count: mutable usize = 0
            selected_count: mutable usize = 0
            caller_shape_count: mutable usize = 0
            root_shape_count: mutable usize = 0
            selected_caller_shape: mutable bool = false
            selected_root_shape: mutable bool = false
            row: mutable usize = group.head
            for _ in 0..<group.count |group, index, row, function_count, selected_count, caller_shape_count, root_shape_count, selected_caller_shape, selected_root_shape, wanted_line, wanted_offset, exact_owner, argument_count, argument_names, annotations, caller_scope, target_scope, work|:
                return false if row >= index.entries.count or not proof_replay_type_bound_local_work_charge(1, work)
                entry: ProofReplayDeterministicDeclarationEntry = index.entries[row]
                if entry.is_function and not entry.is_lemma:
                    match entry.declaration:
                        Ast::Decl.Func(_, parameters, _, _, _, _, position):
                            function_count <- function_count + 1
                            if position.line == wanted_line and (not exact_owner or position.offset.usize() == wanted_offset):
                                selected_count <- selected_count + 1
                            shape: (complete: bool, matches: bool) = proof_replay_type_bound_candidate_accepts_call_shape_with_work(index, parameters, argument_count, argument_names, annotations, position.line, work)
                            return false if not shape.complete
                            if shape.matches:
                                candidate_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work([], entry.owner, work)
                                return false if not candidate_scope.complete
                                in_caller_scope: mutable bool = candidate_scope.scope.count == caller_scope.count
                                if in_caller_scope:
                                    for scope_index in 0..<caller_scope.count |scope_index, candidate_scope, caller_scope, in_caller_scope, work|:
                                        return false if not proof_replay_type_bound_local_text_compare_charge(candidate_scope.scope[scope_index], caller_scope[scope_index], work)
                                        in_caller_scope <- false if candidate_scope.scope[scope_index] != caller_scope[scope_index]
                                in_target_scope: mutable bool = candidate_scope.scope.count == target_scope.count
                                if in_target_scope:
                                    for scope_index in 0..<target_scope.count |scope_index, candidate_scope, target_scope, in_target_scope, work|:
                                        return false if not proof_replay_type_bound_local_text_compare_charge(candidate_scope.scope[scope_index], target_scope[scope_index], work)
                                        in_target_scope <- false if candidate_scope.scope[scope_index] != target_scope[scope_index]
                                caller_shape_count <- caller_shape_count + 1 if in_caller_scope
                                root_shape_count <- root_shape_count + 1 if in_target_scope and target_scope.count == 0
                                selected_caller_shape <- in_caller_scope if position.line == wanted_line and (not exact_owner or position.offset.usize() == wanted_offset)
                                selected_root_shape <- in_target_scope if position.line == wanted_line and (not exact_owner or position.offset.usize() == wanted_offset) and target_scope.count == 0
                        _:
                            return false
                row <- entry.next_index
            return false if row != index.entries.count or selected_count != 1
            same_scope: mutable bool = target_scope.count == caller_scope.count
            if same_scope:
                for scope_index in 0..<target_scope.count |scope_index, target_scope, caller_scope, same_scope, work|:
                    return false if not proof_replay_type_bound_local_text_compare_charge(target_scope[scope_index], caller_scope[scope_index], work)
                    same_scope <- false if target_scope[scope_index] != caller_scope[scope_index]
            if same_scope and caller_scope.count > 0:
                return selected_caller_shape and caller_shape_count == 1
            generic_candidate: (complete: bool, present: bool) = proof_replay_type_bound_bare_generic_candidate_with_work(index, wanted, argument_count, argument_names, annotations, caller_scope, generic_lines, generic_names, generic_metadata_valid, work)
            return false if not generic_candidate.complete or generic_candidate.present
            return selected_caller_shape and caller_shape_count == 1 if same_scope
            if target_scope.count == 0:
                return false if caller_shape_count != 0
                return selected_root_shape and root_shape_count == 1
            return function_count == 1
