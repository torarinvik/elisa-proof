extend ElisaProof:
    private:
        # Reserve byte work before repeatedly matching an untrusted arena tag against a fixed
        # dispatch set. The caller supplies a conservative upper bound on comparisons.
        def proof_replay_resource_event_kind_dispatch_work(kind: sview, wanted_kind: sview, comparisons: usize, source_work: mutable usize&) -> bool:
            kind_bytes: usize = sview_len(kind)
            return false if comparisons == 0
            return false if kind_bytes > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / comparisons
            return false if not proof_replay_owner_work_charge(kind_bytes * comparisons, source_work) or not proof_replay_owner_work_charge(sview_len(wanted_kind), source_work)
            true

        def proof_replay_resource_return_allocation_operand_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, is_allocation: bool, operand: Ast::Expr):
            return (false, false, Ast::Expr.Invalid) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.RegionNew(operand, _, _):
                    (true, true, operand)
                Ast::Expr.Paren(inner, _):
                    proof_replay_resource_return_allocation_operand_with_work(inner, source_work, depth + 1)
                _:
                    (true, false, Ast::Expr.Invalid)

        # Recover the binding root of a source place without reducing field/index identity.
        # These forms preserve the base binding; every other expression is unsupported.
        def proof_replay_resource_write_source_root_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, "") if not proof_replay_owner_work_charge(sview_len(name), source_work)
                    (true, name)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Mutable, inner, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    proof_replay_resource_write_source_root_with_work(inner, source_work, depth + 1)
                Ast::Expr.Index(inner, _, _):
                    proof_replay_resource_write_source_root_with_work(inner, source_work, depth + 1)
                _:
                    (false, "")

        # Count only owner-local trace containers. Call children belong to the callee owner and
        # are validated through the authenticated call-summary edge instead.
        def proof_replay_resource_event_count_at_with_work(report: ProofReport&, event_root: usize, wanted_kind: sview, offset: usize, wanted_name: sview, source_work: mutable usize&, depth: usize) -> (complete: bool, count: usize):
            return (false, 0) if depth >= PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work) or event_root >= report.analysis_1.kernel.nodes.count
            event: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[event_root]
            return (false, 0) if not proof_replay_resource_event_kind_dispatch_work(event.kind, wanted_kind, 28, source_work)
            if event.kind == wanted_kind:
                return (false, 0) if event.value < 0 or event.value > 4294967295
                if wanted_name != "":
                    return (false, 0) if not proof_replay_owner_work_charge(sview_len(event.name), source_work) or not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
                    return (true, 0) if event.name != wanted_name
                return (true, 1) if event.value.usize() == offset
                return (true, 0)
            if event.kind not in {"resource-safety", "resource-scope", "resource-alternatives"}:
                return (true, 0) if event.kind in {"resource-disjoint", "resource-region-open", "resource-region-close", "resource-region-alloc", "resource-region-bind", "resource-sview-param", "resource-region-alloc-discard", "resource-region-return-alloc", "resource-region-call-alloc", "resource-region-rebind-alloc", "resource-region-assign", "resource-region-return", "resource-region-param", "resource-move", "resource-use", "resource-write", "resource-join-move", "resource-call", "resource-call-lend", "resource-call-arg", "resource-call-formal", "resource-call-region", "resource-call-result", "resource-bind"}
                return (false, 0)
            return (false, 0) if event.children_start > report.analysis_1.kernel.children.count or event.children_count > report.analysis_1.kernel.children.count - event.children_start
            count: mutable usize = 0
            for index in 0..<event.children_count |index, report, event, offset, source_work, depth, count|:
                return (false, 0) if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[event.children_start + index]
                nested: (complete: bool, count: usize) = proof_replay_resource_event_count_at_with_work(report, child, wanted_kind, offset, wanted_name, source_work, depth + 1)
                return (false, 0) if not nested.complete or nested.count > 1
                return (false, 0) if count > 1 - nested.count
                count <- count + nested.count
            (true, count)

        def proof_replay_resource_event_count_in_root_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, wanted_kind: sview, offset: usize, wanted_name: sview, source_work: mutable usize&) -> (complete: bool, count: usize):
            return (false, 0) if not proof_replay_owner_work_charge(sview_len(root.kind), source_work) or root.kind != "resource-safety" or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start
            count: mutable usize = 0
            for index in 0..<root.children_count |index, report, root, offset, source_work, count|:
                return (false, 0) if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[root.children_start + index]
                nested: (complete: bool, count: usize) = proof_replay_resource_event_count_at_with_work(report, child, wanted_kind, offset, wanted_name, source_work, 0)
                return (false, 0) if not nested.complete or nested.count > 1
                return (false, 0) if count > 1 - nested.count
                count <- count + nested.count
            (true, count)

        def proof_replay_resource_event_kind_count_at_with_work(report: ProofReport&, event_root: usize, wanted_kind: sview, wanted_name: sview, source_work: mutable usize&, depth: usize) -> (complete: bool, count: usize):
            return (false, 0) if depth >= PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work) or event_root >= report.analysis_1.kernel.nodes.count
            event: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[event_root]
            return (false, 0) if not proof_replay_resource_event_kind_dispatch_work(event.kind, wanted_kind, 4, source_work)
            return (false, 0) if not proof_replay_owner_work_charge(sview_len(wanted_name), source_work)
            return (false, 0) if event.kind == wanted_kind and not proof_replay_owner_work_charge(sview_len(event.name), source_work)
            count: mutable usize = 1 if event.kind == wanted_kind and (wanted_name == "" or event.name == wanted_name) else 0
            return (true, count) if event.kind not in {"resource-safety", "resource-scope", "resource-alternatives"}
            return (false, 0) if event.children_start > report.analysis_1.kernel.children.count or event.children_count > report.analysis_1.kernel.children.count - event.children_start
            for index in 0..<event.children_count |index, report, event, wanted_kind, wanted_name, source_work, depth, count|:
                return (false, 0) if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[event.children_start + index]
                nested: (complete: bool, count: usize) = proof_replay_resource_event_kind_count_at_with_work(report, child, wanted_kind, wanted_name, source_work, depth + 1)
                return (false, 0) if not nested.complete or count > report.analysis_1.kernel.nodes.count or nested.count > report.analysis_1.kernel.nodes.count - count
                count <- count + nested.count
            (true, count)

        def proof_replay_resource_event_kind_count_in_root_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, wanted_kind: sview, wanted_name: sview, source_work: mutable usize&) -> (complete: bool, count: usize):
            return (false, 0) if not proof_replay_owner_work_charge(sview_len(root.kind), source_work) or root.kind != "resource-safety" or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start
            count: mutable usize = 0
            for index in 0..<root.children_count |index, report, root, wanted_kind, wanted_name, source_work, count|:
                return (false, 0) if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[root.children_start + index]
                nested: (complete: bool, count: usize) = proof_replay_resource_event_kind_count_at_with_work(report, child, wanted_kind, wanted_name, source_work, 0)
                return (false, 0) if not nested.complete or count > report.analysis_1.kernel.nodes.count or nested.count > report.analysis_1.kernel.nodes.count - count
                count <- count + nested.count
            (true, count)

        # Every source branch construct, including short-circuit RHS evaluation, is emitted
        # by the resource producer as an alternatives node. Per-node validation checks its
        # exact control offset and arm scopes; this reverse count prevents a forged trace
        # from flattening a branch into a plain scope and making state updates unconditional.
        def proof_replay_resource_alternatives_covered_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, body: darray[Ast::Stmt]&, source_work: mutable usize&) -> bool:
            source_count: mutable usize = 0
            found: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, 0, "resource-alternatives-inventory", "", source_count, found, source_work, 0)
            recorded: (complete: bool, count: usize) = proof_replay_resource_event_kind_count_in_root_with_work(report, root, "resource-alternatives", "", source_work)
            recorded.complete and recorded.count == source_count

        # Local borrow bindings currently lack source binder identities. Refuse summaries
        # containing one until its declaration and scope are source-bound.
        def proof_replay_resource_local_borrows_absent_at_with_work(report: ProofReport&, event_root: usize, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_RESOURCE_FACT_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work) or event_root >= report.analysis_1.kernel.nodes.count
            event: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[event_root]
            return false if not proof_replay_resource_event_kind_dispatch_work(event.kind, "", 28, source_work)
            if event.kind == "resource-bind":
                return false if not proof_replay_owner_work_charge(sview_len(event.operator), source_work)
                return event.operator == "value"
            if event.kind not in {"resource-safety", "resource-scope", "resource-alternatives"}:
                return true if event.kind in {"resource-disjoint", "resource-region-open", "resource-region-close", "resource-region-alloc", "resource-region-bind", "resource-sview-param", "resource-region-alloc-discard", "resource-region-return-alloc", "resource-region-call-alloc", "resource-region-rebind-alloc", "resource-region-assign", "resource-region-return", "resource-region-param", "resource-move", "resource-use", "resource-join-move", "resource-call-arg", "resource-call-formal", "resource-call-region", "resource-call-result", "resource-write"}
                return false
            return false if event.children_start > report.analysis_1.kernel.children.count or event.children_count > report.analysis_1.kernel.children.count - event.children_start
            for index in 0..<event.children_count |index, report, event, source_work, depth|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[event.children_start + index]
                return false if not proof_replay_resource_local_borrows_absent_at_with_work(report, child, source_work, depth + 1)
            true

        def proof_replay_resource_local_borrows_absent_in_root_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, first_body_event: usize, source_work: mutable usize&) -> bool:
            return false if root.kind != "resource-safety" or first_body_event > root.children_count or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start
            for index in first_body_event..<root.children_count |index, report, root, source_work|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                child: usize = report.analysis_1.kernel.children[root.children_start + index]
                return false if not proof_replay_resource_local_borrows_absent_at_with_work(report, child, source_work, 0)
            true

        def proof_replay_resource_write_builtin_call_covered_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, resource_positions: ProofReplayResourceBindingPositionIndex&, parameters: darray[Ast::ParamDecl]&, index: ProofReplayDeterministicDeclarationIndex&, expression: Ast::Expr, parameter_name: sview, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Call(callee, arguments, _, position):
                    return false if not proof_replay_owner_work_charge(sview_len(parameter_name), source_work)
                    stripped: mutable Ast::Expr = callee
                    strip_depth: mutable usize = 0
                    while strip_depth < PROOF_REPLAY_AST_DEPTH_LIMIT |stripped, strip_depth, source_work|:
                        return false if not proof_replay_owner_work_charge(1, source_work)
                        match stripped:
                            Ast::Expr.Paren(inner, _):
                                stripped <- inner
                                strip_depth <- strip_depth + 1
                            _:
                                break
                    match stripped:
                        Ast::Expr.Field(receiver, method, _):
                            return false if not proof_replay_owner_work_charge(sview_len(method), source_work)
                            if method == "as_sview":
                                return false if arguments.count != 0
                                # This conversion only reads its receiver. Owner-wide source-call
                                # coverage separately proves the byte-darray receiver type and
                                # rejects declared methods and custom dispatch, so no write event
                                # is required for this call.
                            else:
                                return false if method not in {"push", "extend", "clear", "resize", "pop", "truncate"}
                                target_root: (complete: bool, name: sview) = proof_replay_resource_write_source_root_with_work(receiver, source_work, 0)
                                return false if not target_root.complete
                                return false if not proof_replay_owner_work_charge(sview_len(method), source_work)
                                receiver_formal_matches: mutable usize = 0
                                for formal in parameters |formal, target_root, receiver_formal_matches, source_work|:
                                    return false if not proof_replay_owner_work_charge(sview_len(formal.name), source_work) or not proof_replay_owner_work_charge(sview_len(target_root.name), source_work)
                                    receiver_formal_matches <- receiver_formal_matches + 1 if formal.name == target_root.name
                                return false if receiver_formal_matches != 1
                                shadow_count: mutable usize = 0
                                for declaration in index.entries |declaration, method, shadow_count, source_work|:
                                    return false if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_owner_work_charge(sview_len(declaration.name), source_work) or not proof_replay_owner_work_charge(sview_len(method), source_work)
                                    shadow_count <- shadow_count + 1 if declaration.name == method
                                # A same-named source method has unknown effects; do not treat it as
                                # the builtin mutator that the producer's fast path recognizes.
                                return false if shadow_count != 0
                                if target_root.name == parameter_name:
                                    return false if not proof_replay_resource_write_builtin_arguments_valid_with_work(arguments, source_work)
                                    return false if position.offset == 0 or position.offset > 4294967295
                                    event_count: (complete: bool, count: usize) = proof_replay_resource_binding_position_kind_count_at_with_work(resource_positions, "resource-write", position.offset.usize(), source_work)
                                    return false if not event_count.complete or event_count.count != 1
                        Ast::Expr.Ident(_, _):
                            # Direct calls are checked by the separate owner-wide resource-call
                            # coverage pass. This walk still descends through the callee and
                            # arguments to find nested builtin writes.
                            pass
                        _:
                            return false
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, callee, parameter_name, source_work, depth + 1)
                    for argument in arguments |report, root, resource_positions, index, parameter_name, source_work, depth|:
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, argument, parameter_name, source_work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return false
                Ast::Expr.Move(operand, _):
                    # Move state is replayed in event order. The owner preflight separately
                    # requires a source-exact event for every named place-root move and compares the
                    # normalized transition offsets across the complete trace.
                    return proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, operand, parameter_name, source_work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, inner, parameter_name, source_work, depth + 1)
                # These constructs introduce capabilities or binders whose resource events
                # need their own source bridge. Do not let an omitted event erase them.
                Ast::Expr.RegionNew(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Comprehension(_, _, _, _, _) | Ast::Expr.Match(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _):
                    return false
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, base, parameter_name, source_work, depth + 1)
                    return proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, predicate, parameter_name, source_work, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, left, parameter_name, source_work, depth + 1)
                    return proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, right, parameter_name, source_work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, object, parameter_name, source_work, depth + 1)
                    for argument in arguments |report, root, resource_positions, index, parameter_name, source_work, depth|:
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, argument, parameter_name, source_work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, object, parameter_name, source_work, depth + 1)
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, low, parameter_name, source_work, depth + 1)
                    return proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, high, parameter_name, source_work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |report, root, resource_positions, index, parameter_name, source_work, depth|:
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, element, parameter_name, source_work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |report, root, resource_positions, index, parameter_name, source_work, depth|:
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, entry.key, parameter_name, source_work, depth + 1)
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, entry.value, parameter_name, source_work, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |report, root, resource_positions, index, parameter_name, source_work, depth|:
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, field.value, parameter_name, source_work, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, base, parameter_name, source_work, depth + 1)
                    for field in fields |report, root, resource_positions, index, parameter_name, source_work, depth|:
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, field.value, parameter_name, source_work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, condition, parameter_name, source_work, depth + 1)
                    return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, yes, parameter_name, source_work, depth + 1)
                    return proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, no, parameter_name, source_work, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_resource_parameter_writes_covered_with_work(report, root, resource_positions, statements, parameters, parameter_name, index, source_work, depth + 1)
                    return proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, value, parameter_name, source_work, depth + 1)
                Ast::Expr.Ident(_, _) | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                _:
                    return false
            true

        def proof_replay_resource_parameter_writes_covered_with_work(report: ProofReport&, root: ElisaProofKernelCore::ProofKernelNode, resource_positions: ProofReplayResourceBindingPositionIndex&, body: darray[Ast::Stmt]&, parameters: darray[Ast::ParamDecl]&, parameter_name: sview, index: ProofReplayDeterministicDeclarationIndex&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_owner_work_charge(1, source_work)
            for statement in body |report, root, resource_positions, body, parameters, parameter_name, index, source_work, depth|:
                return false if not proof_replay_owner_work_charge(1, source_work)
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, initializer, parameter_name, source_work, depth + 1)
                    Ast::Stmt.Expr(expression, _):
                        return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, expression, parameter_name, source_work, depth + 1)
                    Ast::Stmt.Return(expression, _):
                        allocation: (complete: bool, is_allocation: bool, operand: Ast::Expr) = proof_replay_resource_return_allocation_operand_with_work(expression, source_work, 0)
                        return false if not allocation.complete
                        if allocation.is_allocation:
                            return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, allocation.operand, parameter_name, source_work, depth + 1)
                        else:
                            return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, expression, parameter_name, source_work, depth + 1)
                    Ast::Stmt.Contract(kind, expression, _):
                        if kind in {"assert", "requires"} or proof_is_ensure_kind(kind):
                            return false if not proof_replay_resource_write_builtin_call_covered_with_work(report, root, resource_positions, parameters, index, expression, parameter_name, source_work, depth + 1)
                    Ast::Stmt.Assign(target, operator, value, position):
                        target_root: (complete: bool, name: sview) = proof_replay_resource_write_source_root_with_work(target, source_work, 0)
                        return false if not target_root.complete
                        return false if not proof_replay_owner_work_charge(sview_len(parameter_name), source_work)
                        if parameter_name == "":
                            formal_root_matches: mutable usize = 0
                            for formal in parameters |formal, target_root, formal_root_matches, source_work|:
                                return false if not proof_replay_owner_work_charge(sview_len(formal.name), source_work) or not proof_replay_owner_work_charge(sview_len(target_root.name), source_work)
