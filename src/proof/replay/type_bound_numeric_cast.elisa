extend ElisaProof:
    private:
        def proof_replay_type_bound_cast_hook_present_with_work(declarations: darray[Ast::Decl]&, depth: usize, work: mutable usize&) -> (complete: bool, present: bool):
            return (false, false) if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT
            for declaration in declarations |depth, work|:
                return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, _):
                        return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "__cast__", work)
                        return (true, true) if name == "__cast__"
                    Ast::Decl.Extern(name, _, arity, _, callable, _, _, _):
                        return (false, false) if not proof_replay_type_bound_local_text_compare_charge(name, "__cast__", work)
                        return (true, true) if name == "__cast__" and arity == 1 and callable
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        nested_result: (complete: bool, present: bool) = proof_replay_type_bound_cast_hook_present_with_work(nested, depth + 1, work)
                        return (false, false) if not nested_result.complete
                        return (true, true) if nested_result.present
                    Ast::Decl.Invalid:
                        return (false, false)
                    Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return (false, false)
            return (true, false)

        # A builtin integer cast's result has the target's primitive scalar and range type,
        # regardless of whether the conversion preserves its receiver's value. Reconstruct the
        # dispatch conditions independently so a method with the same spelling or a custom cast
        # hook cannot authorize a type-bound fact.
        def proof_replay_type_bound_numeric_cast_fact(report: ProofReport&, trace: ProofFactTrace) -> bool:
            marker_name: mutable sview = ""
            marker_width: mutable i64 = 0
            cast: mutable Ast::Expr = Ast::Expr.Invalid
            match trace.expression:
                Ast::Expr.Call(Ast::Expr.Ident(name, _), arguments, argument_names, _):
                    marker_name <- name
                    if name == "__elisa_primitive_scalar_type":
                        return false if arguments.count != 1 or argument_names.count != 0
                        cast <- arguments[0]
                    elif name in {"__elisa_signed_place_type_bound", "__elisa_unsigned_place_type_bound"}:
                        return false if arguments.count != 2 or argument_names.count != 0
                        cast <- arguments[0]
                        width: (known: bool, value: i64) = proof_constant_int(arguments[1])
                        return false if not width.known
                        marker_width <- width.value
                    else:
                        return false
                _:
                    return false
            receiver: mutable Ast::Expr = Ast::Expr.Invalid
            target: mutable sview = ""
            match cast:
                Ast::Expr.Call(Ast::Expr.Field(source, method, _), arguments, argument_names, _):
                    return false if arguments.count != 0 or argument_names.count != 0
                    receiver <- source
                    target <- method
                _:
                    return false
            target_type: Ast::Expr = Ast::Expr.Ident(target, Ast::expr_pos(cast))
            signed_width: i64 = proof_signed_primitive_width(target_type)
            unsigned_width: i64 = proof_unsigned_primitive_width(target_type)
            return false if signed_width == 0 and unsigned_width == 0
            work: mutable usize = 0
            return false if:
                not proof_replay_summary_expr_charge_with_work(receiver, work)
                proof_expr_has_call(receiver)
                not proof_replay_summary_expr_charge_with_work(receiver, work)
                proof_expr_has_move(receiver)
            cast_hook: (complete: bool, present: bool) = proof_replay_type_bound_cast_hook_present_with_work(report.source.source_declarations, 0, &work)
            return false if not cast_hook.complete or cast_hook.present
            # Scalar cast syntax takes precedence over ordinary UFCS lookup in the pinned
            # compiler, so a function named `i64` (or another selector) cannot shadow this.
            # Custom `__cast__` hooks are checked separately above.
            if marker_name == "__elisa_primitive_scalar_type":
                return true if marker_width == 0
                return false
            if marker_name == "__elisa_signed_place_type_bound":
                return signed_width > 0 and marker_width == signed_width
            if marker_name == "__elisa_unsigned_place_type_bound":
                return unsigned_width > 0 and marker_width == unsigned_width
            return false
