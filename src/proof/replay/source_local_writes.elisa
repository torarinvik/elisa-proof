# Independent source scans for one local spelling. Replay asks two questions of a function body:
# does any construct anywhere in it introduce this name (a declaration, `=` definition, loop
# variable, pattern binder, block binding, lambda parameter or comprehension variable), and may
# any construct change the value the name denotes (those, plus assignments, explicit lends,
# moves, receiver calls and implicit lends to reference parameters)? Every unsupported or
# too-deep form answers yes, so a caller that trusts a "no" never trusts an unread construct.
const module ProofReplaySourceLocal:
    DEPTH_LIMIT: usize = 96
    # A zero-argument field-call reservation includes up to 30 units for checking the ten
    # fixed numeric selectors (including same-length character comparisons); the rest is
    # reserved for the declaration scan.
    CAST_HOOK_SCAN_LIMIT: usize = 64
    CAST_HOOK_SELECTOR_SCAN_LIMIT: usize = 30
    CAST_HOOK_DECLARATION_SCAN_LIMIT: usize = CAST_HOOK_SCAN_LIMIT - CAST_HOOK_SELECTOR_SCAN_LIMIT
    CAST_HOOK_NAME_COMPARE_LIMIT: usize = 8

extend ElisaProof:
    private:
        def proof_replay_source_pattern_binds(pattern: Ast::Pattern, name: sview, depth: usize) -> bool:
            work: mutable usize = 0
            proof_replay_source_pattern_binds_with_work(pattern, name, &work, depth)

        def proof_replay_source_pattern_binds_with_work(pattern: Ast::Pattern, name: sview, work: mutable usize&, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            return true if not proof_replay_call_work_add(work, sview_len(name))
            bindings: mutable darray[sview] = []
            return true if not proof_replay_call_pattern_bindings_with_work(pattern, &bindings, work, 0)
            for bound in bindings |bound, name, work|:
                return true if not proof_replay_call_string_compare_charge(bound, name, work)
                return true if bound == name
            false

        # The local a place expression reads or writes through, or "" when it has none.
        def proof_replay_source_place_root(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _) | Ast::Expr.Index(object, _, _) | Ast::Expr.Paren(object, _) | Ast::Expr.Move(object, _):
                    return proof_replay_source_place_root(object, depth + 1)
                Ast::Expr.Slice(object, _, _, _) | Ast::Expr.IndexN(object, _, _):
                    return proof_replay_source_place_root(object, depth + 1)
                Ast::Expr.Unary(_, inner, _):
                    return proof_replay_source_place_root(inner, depth + 1)
                _:
                    return ""

        def proof_replay_source_callee_name(callee: Ast::Expr) -> sview:
            match callee:
                Ast::Expr.Ident(name, _) | Ast::Expr.Scope(_, name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_replay_source_callee_name(inner)
                _:
                    return ""

        # A place passed to a function parameter declared by value is copied. Any other callee
        # (unknown, extern, overloaded with a reference slot, or a named argument that resolves
        # to no parameter) may take the argument by implicit lend and write through it.
        def proof_replay_source_call_slot_by_value(declarations: darray[Ast::Decl]&, callee_name: sview, slot: usize, argument_name: sview, found: mutable usize&, depth: usize) -> bool:
            return false if depth >= ProofReplaySourceLocal::DEPTH_LIMIT or callee_name == ""
            for declaration in declarations |callee_name, slot, argument_name, found, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, _):
                        if name == callee_name:
                            found <- found + 1
                            parameter_index: mutable usize = parameters.count
                            if argument_name == "":
                                parameter_index <- slot
                            else:
                                for index in 0..<parameters.count |index, parameters, argument_name, parameter_index|:
                                    parameter_index <- index if parameters[index].name == argument_name
                            return false if:
                                parameter_index >= parameters.count
                                proof_replay_deterministic_parameter_type(parameters[parameter_index].type_expression, 0)
                    Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if name == callee_name
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_source_call_slot_by_value(nested, callee_name, slot, argument_name, found, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_source_numeric_selector(method: sview) -> bool:
            return false if sview_len(method) > 5
            return method in {"i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize"}

        # A numeric selector is a non-mutating builtin only when the source snapshot proves
        # there is no visible cast hook. Imports are unresolved here, and exhausting this small
        # scan also means dispatch is unknown. The caller reserves CAST_HOOK_SCAN_LIMIT work for
        # every zero-argument method call before running this source-touch visitor. Charge
        # declaration nodes and the bytes inspected by each possible hook name. String
        # equality checks lengths first, so only an eight-byte name needs the byte charge.
        def proof_replay_source_custom_cast_possible(declarations: darray[Ast::Decl]&, work: mutable usize&, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT or work >= ProofReplaySourceLocal::CAST_HOOK_DECLARATION_SCAN_LIMIT
            for declaration in declarations |work, depth|:
                return true if work >= ProofReplaySourceLocal::CAST_HOOK_DECLARATION_SCAN_LIMIT
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, _):
                        name_compare_work: usize = ProofReplaySourceLocal::CAST_HOOK_NAME_COMPARE_LIMIT if sview_len(name) == ProofReplaySourceLocal::CAST_HOOK_NAME_COMPARE_LIMIT else 0
                        return true if name_compare_work > ProofReplaySourceLocal::CAST_HOOK_DECLARATION_SCAN_LIMIT - work
                        work <- work + name_compare_work
                        return true if name == "__cast__"
                    Ast::Decl.Extern(name, _, arity, _, callable, _, _, _):
                        name_compare_work: usize = ProofReplaySourceLocal::CAST_HOOK_NAME_COMPARE_LIMIT if sview_len(name) == ProofReplaySourceLocal::CAST_HOOK_NAME_COMPARE_LIMIT else 0
                        return true if name_compare_work > ProofReplaySourceLocal::CAST_HOOK_DECLARATION_SCAN_LIMIT - work
                        work <- work + name_compare_work
                        return true if name == "__cast__" and arity == 1 and callable
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_source_custom_cast_possible(nested, work, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Invalid:
                        return true
                    Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return true
            return false

        def proof_replay_source_call_touches(declarations: darray[Ast::Decl]&, callee: Ast::Expr, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, name: sview, writes: bool, depth: usize) -> bool:
            if writes:
                match callee:
                    Ast::Expr.Field(receiver, method, _):
                        cast_work: mutable usize = 0
                        cast: bool = arguments.count == 0 and proof_replay_source_numeric_selector(method) and not proof_replay_source_custom_cast_possible(declarations, &cast_work, 0)
                        return true if not cast and proof_replay_source_place_root(receiver, depth + 1) == name
                    _:
                        pass
                for index in 0..<arguments.count |index, arguments, argument_names, declarations, callee, name, depth|:
                    continue if proof_replay_source_place_root(arguments[index], depth + 1) != name
                    argument_name: sview = argument_names[index] if index < argument_names.count else ""
                    found: mutable usize = 0
                    by_value: bool = proof_replay_source_call_slot_by_value(declarations, proof_replay_source_callee_name(callee), index, argument_name, &found, 0)
                    return true if not by_value or found == 0
            return true if proof_replay_source_expr_touches(declarations, callee, name, writes, depth + 1)
            for argument in arguments |declarations, name, writes, depth|:
                return true if proof_replay_source_expr_touches(declarations, argument, name, writes, depth + 1)
            return false

        # A local lambda can mutate a captured place even when called with no arguments. The
        # ordinary call visitor cannot resolve that through its global declaration index, so
        # source-site validators use this owner-body check for calls in a binding's live range.
        def proof_replay_source_body_has_call(body: darray[Ast::Stmt]&, work: mutable usize&, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            for statement in body |work, depth|:
                return true if not proof_replay_source_touch_work_charge(1, work)
                match statement:
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return true if not proof_replay_mutable_local_expr_work_charge(expression, work)
                        return true if proof_replay_expression_contains_call_node(expression, 0)
                    Ast::Stmt.Return(value, _):
                        if value is expression:
                            return true if not proof_replay_mutable_local_expr_work_charge(expression, work)
                            return true if proof_replay_expression_contains_call_node(expression, 0)
                    Ast::Stmt.VarDecl(_, _, expression, _) | Ast::Stmt.Assign(_, _, expression, _):
                        return true if not proof_replay_mutable_local_expr_work_charge(expression, work)
                        return true if proof_replay_expression_contains_call_node(expression, 0)
                    Ast::Stmt.If(condition, yes, no, _):
                        return true if not proof_replay_mutable_local_expr_work_charge(condition, work)
                        return true if proof_replay_expression_contains_call_node(condition, 0)
                        return true if proof_replay_source_body_has_call(yes, work, depth + 1) or proof_replay_source_body_has_call(no, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _) | Ast::Stmt.For(_, _, condition, nested, _):
                        return true if not proof_replay_mutable_local_expr_work_charge(condition, work)
                        return true if proof_replay_expression_contains_call_node(condition, 0) or proof_replay_source_body_has_call(nested, work, depth + 1)
                    Ast::Stmt.Match(subject, arms, _):
                        return true if not proof_replay_mutable_local_expr_work_charge(subject, work)
                        return true if proof_replay_expression_contains_call_node(subject, 0)
                        for arm in arms |work, depth|:
                            return true if not proof_replay_source_touch_work_charge(1, work)
                            return true if not proof_replay_mutable_local_expr_work_charge(arm.guard, work)
                            return true if proof_replay_expression_contains_call_node(arm.guard, 0) or proof_replay_source_body_has_call(arm.body, work, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _) | Ast::Stmt.Expr(Ast::Expr.Block(nested, _, _, _), _):
                        return true if proof_replay_source_body_has_call(nested, work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return true
            return false

        def proof_replay_source_local_lambda_writes_body(body: darray[Ast::Stmt]&, callable: sview, tracked: sview, call_position: Ast::Pos, work: mutable usize&, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            found_direct_lambda: mutable bool = false
            for statement in body |body, callable, tracked, call_position, work, depth, found_direct_lambda|:
                return true if not proof_replay_source_touch_work_charge(1, work)
                match statement:
                    Ast::Stmt.VarDecl(local_name, _, Ast::Expr.Lambda(_, lambda_body, _), declaration_position):
                        if local_name == callable and declaration_position.offset > 0 and declaration_position.offset < call_position.offset:
                            found_direct_lambda <- true
                            return true if not proof_replay_mutable_local_body_work_charge(lambda_body, work, 0)
                            return true if proof_replay_source_body_touches([], lambda_body, tracked, true, 0) or proof_replay_source_body_has_call(lambda_body, work, 0)
                    Ast::Stmt.VarDecl(local_name, _, _, declaration_position):
                        return true if local_name == callable and declaration_position.offset > 0 and declaration_position.offset < call_position.offset
                    Ast::Stmt.Assign(Ast::Expr.Ident(local_name, _), TokenKind.Assign, Ast::Expr.Lambda(_, lambda_body, _), declaration_position):
                        if local_name == callable and declaration_position.offset > 0 and declaration_position.offset < call_position.offset:
                            found_direct_lambda <- true
                            return true if not proof_replay_mutable_local_body_work_charge(lambda_body, work, 0)
                            return true if proof_replay_source_body_touches([], lambda_body, tracked, true, 0) or proof_replay_source_body_has_call(lambda_body, work, 0)
                    Ast::Stmt.Assign(Ast::Expr.Ident(local_name, _), _, _, declaration_position):
                        return true if local_name == callable and declaration_position.offset > 0 and declaration_position.offset < call_position.offset
                    Ast::Stmt.If(_, yes, no, _):
                        return true if proof_replay_source_local_lambda_writes_body(yes, callable, tracked, call_position, work, depth + 1)
                        return true if proof_replay_source_local_lambda_writes_body(no, callable, tracked, call_position, work, depth + 1)
                    Ast::Stmt.For(_, variables, _, nested, _):
                        return true if any variable in variables where variable == callable
                        return true if proof_replay_source_local_lambda_writes_body(nested, callable, tracked, call_position, work, depth + 1)
                    Ast::Stmt.While(_, nested, _):
                        return true if proof_replay_source_local_lambda_writes_body(nested, callable, tracked, call_position, work, depth + 1)
                    Ast::Stmt.Block(_, clause, binding, nested, _):
                        return true if binding == callable or any word in clause where word == callable
                        return true if proof_replay_source_local_lambda_writes_body(nested, callable, tracked, call_position, work, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |callable, tracked, call_position, work, depth|:
                            return true if not proof_replay_source_touch_work_charge(1, work)
                            return true if proof_replay_source_pattern_binds_with_work(arm.pattern, callable, work, 0)
                            return true if proof_replay_source_local_lambda_writes_body(arm.body, callable, tracked, call_position, work, depth + 1)
                    Ast::Stmt.Expr(Ast::Expr.Block(nested, _, _, _), _):
                        return true if proof_replay_source_local_lambda_writes_body(nested, callable, tracked, call_position, work, depth + 1)
                    _:
                        pass
            if not found_direct_lambda:
                return true if not proof_replay_mutable_local_body_work_charge(body, work, 0)
                return proof_replay_source_body_declares_unmetered([], body, callable)
            return false

        def proof_replay_source_expr_calls_mutating_local_lambda(body: darray[Ast::Stmt]&, expression: Ast::Expr, tracked: sview, work: mutable usize&, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            return true if not proof_replay_source_touch_work_charge(1, work)
            match expression:
                Ast::Expr.Call(callee, arguments, _, position):
                    callable: sview = proof_replay_source_callee_name(callee)
                    return true if callable == ""
                    return true if proof_replay_source_local_lambda_writes_body(body, callable, tracked, position, work, 0)
                    return true if proof_replay_source_expr_calls_mutating_local_lambda(body, callee, tracked, work, depth + 1)
                    for argument in arguments |body, tracked, work, depth|:
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(body, argument, tracked, work, depth + 1)
                    return false
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_replay_source_expr_calls_mutating_local_lambda(body, inner, tracked, work, depth + 1)
                Ast::Expr.Index(left, right, _) | Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Refinement(left, right, _):
                    return proof_replay_source_expr_calls_mutating_local_lambda(body, left, tracked, work, depth + 1) or proof_replay_source_expr_calls_mutating_local_lambda(body, right, tracked, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return proof_replay_source_expr_calls_mutating_local_lambda(body, object, tracked, work, depth + 1) or proof_replay_source_expr_calls_mutating_local_lambda(body, low, tracked, work, depth + 1) or proof_replay_source_expr_calls_mutating_local_lambda(body, high, tracked, work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_replay_source_expr_calls_mutating_local_lambda(body, object, tracked, work, depth + 1)
                    for argument in arguments |body, tracked, work, depth|:
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(body, argument, tracked, work, depth + 1)
                    return false
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |body, tracked, work, depth|:
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(body, element, tracked, work, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |body, tracked, work, depth|:
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(body, entry.key, tracked, work, depth + 1) or proof_replay_source_expr_calls_mutating_local_lambda(body, entry.value, tracked, work, depth + 1)
                    return false
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_replay_source_expr_calls_mutating_local_lambda(body, base, tracked, work, depth + 1)
                    for field in fields |body, tracked, work, depth|:
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(body, field.value, tracked, work, depth + 1)
                    return false
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return true if proof_replay_source_expr_calls_mutating_local_lambda(body, subject, tracked, work, depth + 1)
                    for arm in arms |body, tracked, work, depth|:
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(body, arm.guard, tracked, work, depth + 1) or proof_replay_source_body_calls_mutating_local_lambda(body, arm.body, tracked, work, depth + 1)
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, result, _):
                    return proof_replay_source_expr_calls_mutating_local_lambda(body, iterable, tracked, work, depth + 1) or proof_replay_source_expr_calls_mutating_local_lambda(body, condition, tracked, work, depth + 1) or proof_replay_source_expr_calls_mutating_local_lambda(body, result, tracked, work, depth + 1)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_replay_source_expr_calls_mutating_local_lambda(body, guarded, tracked, work, depth + 1) or proof_replay_source_body_calls_mutating_local_lambda(body, recovery, tracked, work, depth + 1)
                Ast::Expr.Lambda(_, nested, _):
                    return proof_replay_source_body_calls_mutating_local_lambda(body, nested, tracked, work, depth + 1)
                Ast::Expr.Block(nested, value, _, _):
                    return proof_replay_source_body_calls_mutating_local_lambda(body, nested, tracked, work, depth + 1) or proof_replay_source_expr_calls_mutating_local_lambda(body, value, tracked, work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, _, arguments, _, _):
                    for argument in arguments |body, tracked, work, depth|:
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(body, argument, tracked, work, depth + 1)
                    return false
                _:
                    return false

        def proof_replay_source_body_calls_mutating_local_lambda(owner_body: darray[Ast::Stmt]&, body: darray[Ast::Stmt]&, tracked: sview, work: mutable usize&, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            for statement in body |owner_body, tracked, work, depth|:
                return true if not proof_replay_source_touch_work_charge(1, work)
                match statement:
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(owner_body, expression, tracked, work, depth + 1)
                    Ast::Stmt.Return(value, _):
                        if value is expression:
                            return true if proof_replay_source_expr_calls_mutating_local_lambda(owner_body, expression, tracked, work, depth + 1)
                    Ast::Stmt.VarDecl(_, _, expression, _) | Ast::Stmt.Assign(_, _, expression, _):
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(owner_body, expression, tracked, work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(owner_body, condition, tracked, work, depth + 1)
                        return true if proof_replay_source_body_calls_mutating_local_lambda(owner_body, yes, tracked, work, depth + 1) or proof_replay_source_body_calls_mutating_local_lambda(owner_body, no, tracked, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _) | Ast::Stmt.For(_, _, condition, nested, _):
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(owner_body, condition, tracked, work, depth + 1) or proof_replay_source_body_calls_mutating_local_lambda(owner_body, nested, tracked, work, depth + 1)
                    Ast::Stmt.Match(subject, arms, _):
                        return true if proof_replay_source_expr_calls_mutating_local_lambda(owner_body, subject, tracked, work, depth + 1)
                        for arm in arms |owner_body, tracked, work, depth|:
                            return true if not proof_replay_source_touch_work_charge(1, work)
                            return true if proof_replay_source_expr_calls_mutating_local_lambda(owner_body, arm.guard, tracked, work, depth + 1) or proof_replay_source_body_calls_mutating_local_lambda(owner_body, arm.body, tracked, work, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _) | Ast::Stmt.Expr(Ast::Expr.Block(nested, _, _, _), _):
                        return true if proof_replay_source_body_calls_mutating_local_lambda(owner_body, nested, tracked, work, depth + 1)
                    _:
                        pass
            return false

        def proof_replay_source_arms_touch(declarations: darray[Ast::Decl]&, arms: darray[Ast::MatchArm]&, name: sview, writes: bool, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            for arm in arms |declarations, name, writes, depth|:
                return true if:
                    proof_replay_source_pattern_binds(arm.pattern, name, depth + 1)
                    proof_replay_source_expr_touches(declarations, arm.guard, name, writes, depth + 1)
                    proof_replay_source_body_touches(declarations, arm.body, name, writes, depth + 1)
            return false

        def proof_replay_source_exprs_touch(declarations: darray[Ast::Decl]&, expressions: darray[Ast::Expr]&, name: sview, writes: bool, depth: usize) -> bool:
            for expression in expressions |declarations, name, writes, depth|:
                return true if proof_replay_source_expr_touches(declarations, expression, name, writes, depth + 1)
            return false

        def proof_replay_source_fields_touch(declarations: darray[Ast::Decl]&, fields: darray[Ast::FieldInit]&, name: sview, writes: bool, depth: usize) -> bool:
            for field in fields |declarations, name, writes, depth|:
                return true if proof_replay_source_expr_touches(declarations, field.value, name, writes, depth + 1)
            return false

        # `writes == false` asks only whether the expression introduces `name`; `writes == true`
        # also asks whether evaluating it may change the value `name` denotes.
        def proof_replay_source_expr_touches(declarations: darray[Ast::Decl]&, expression: Ast::Expr, name: sview, writes: bool, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            match expression:
                # The parser fills an absent loop-header yield with `Invalid`; neither leaf
                # carries a payload, so neither can introduce or change a name.
                Ast::Expr.Absent | Ast::Expr.Invalid:
                    return false
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Unary(operator, inner, _):
                    lend: bool = operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    return true if writes and lend and proof_replay_source_place_root(inner, depth + 1) == name
                    return proof_replay_source_expr_touches(declarations, inner, name, writes, depth + 1)
                Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return true if writes and proof_replay_source_place_root(inner, depth + 1) == name
                    return proof_replay_source_expr_touches(declarations, inner, name, writes, depth + 1)
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return proof_replay_source_call_touches(declarations, callee, arguments, argument_names, name, writes, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    return true if writes
                    for candidate in candidates |declarations, name, writes, depth|:
                        for capture in candidate.captures |declarations, name, writes, depth|:
                            return true if proof_replay_source_expr_touches(declarations, capture, name, writes, depth + 1)
                    return proof_replay_source_exprs_touch(declarations, arguments, name, writes, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_source_expr_touches(declarations, object, name, writes, depth + 1)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return proof_replay_source_expr_touches(declarations, object, name, writes, depth + 1) or proof_replay_source_expr_touches(declarations, index, name, writes, depth + 1)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return proof_replay_source_expr_touches(declarations, object, name, writes, depth + 1) or proof_replay_source_expr_touches(declarations, low, name, writes, depth + 1) or proof_replay_source_expr_touches(declarations, high, name, writes, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return proof_replay_source_expr_touches(declarations, object, name, writes, depth + 1) or proof_replay_source_exprs_touch(declarations, arguments, name, writes, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    return proof_replay_source_exprs_touch(declarations, elements, name, writes, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |declarations, name, writes, depth|:
                        return true if proof_replay_source_expr_touches(declarations, entry.key, name, writes, depth + 1) or proof_replay_source_expr_touches(declarations, entry.value, name, writes, depth + 1)
                    return false
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return proof_replay_source_expr_touches(declarations, base, name, writes, depth + 1) or proof_replay_source_fields_touch(declarations, fields, name, writes, depth + 1)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return proof_replay_source_expr_touches(declarations, subject, name, writes, depth + 1) or proof_replay_source_arms_touch(declarations, arms, name, writes, depth + 1)
                Ast::Expr.Comprehension(variable, iterable, condition, body, _):
                    return true if variable == name
                    return proof_replay_source_expr_touches(declarations, iterable, name, writes, depth + 1) or proof_replay_source_expr_touches(declarations, condition, name, writes, depth + 1) or proof_replay_source_expr_touches(declarations, body, name, writes, depth + 1)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_replay_source_expr_touches(declarations, guarded, name, writes, depth + 1) or proof_replay_source_body_touches(declarations, recovery, name, writes, depth + 1)
                Ast::Expr.Lambda(parameters, body, _):
                    return true if any parameter in parameters where parameter == name
                    return proof_replay_source_body_touches(declarations, body, name, writes, depth + 1)
                Ast::Expr.Block(statements, value, captures, _):
                    return true if any capture in captures where capture == name
                    return proof_replay_source_body_touches(declarations, statements, name, writes, depth + 1) or proof_replay_source_expr_touches(declarations, value, name, writes, depth + 1)
                _:
                    return true

        def proof_replay_source_statement_touches(declarations: darray[Ast::Decl]&, statement: Ast::Stmt, name: sview, writes: bool, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            match statement:
                Ast::Stmt.VarDecl(local_name, _, initializer, _):
                    return local_name == name or proof_replay_source_expr_touches(declarations, initializer, name, writes, depth + 1)
                Ast::Stmt.Assign(target, operator, value, _):
                    root: sview = proof_replay_source_place_root(target, 0)
                    # `=` defines a local; `<-` and compound forms write an existing place.
                    defines: bool = operator == TokenKind.Assign and proof_replay_ident_name(target) == name
                    return true if defines or (writes and (root == name or root == ""))
                    return proof_replay_source_expr_touches(declarations, target, name, writes, depth + 1) or proof_replay_source_expr_touches(declarations, value, name, writes, depth + 1)
                Ast::Stmt.Expr(expression, _):
                    return proof_replay_source_expr_touches(declarations, expression, name, writes, depth + 1)
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        return proof_replay_source_expr_touches(declarations, returned, name, writes, depth + 1)
                    return false
                Ast::Stmt.If(condition, yes, no, _):
                    return proof_replay_source_expr_touches(declarations, condition, name, writes, depth + 1) or proof_replay_source_body_touches(declarations, yes, name, writes, depth + 1) or proof_replay_source_body_touches(declarations, no, name, writes, depth + 1)
                Ast::Stmt.While(condition, body, _):
                    return proof_replay_source_expr_touches(declarations, condition, name, writes, depth + 1) or proof_replay_source_body_touches(declarations, body, name, writes, depth + 1)
                Ast::Stmt.For(_, variables, iterable, body, _):
                    return true if any variable in variables where variable == name
                    return proof_replay_source_expr_touches(declarations, iterable, name, writes, depth + 1) or proof_replay_source_body_touches(declarations, body, name, writes, depth + 1)
                Ast::Stmt.Match(subject, arms, _):
                    return proof_replay_source_expr_touches(declarations, subject, name, writes, depth + 1) or proof_replay_source_arms_touch(declarations, arms, name, writes, depth + 1)
                Ast::Stmt.Block(_, clause, binding, body, _):
                    return true if binding == name or (any word in clause where word == name)
                    return proof_replay_source_body_touches(declarations, body, name, writes, depth + 1)
                Ast::Stmt.Contract(_, expression, _):
                    return proof_replay_source_expr_touches(declarations, expression, name, writes, depth + 1)
                Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                    return false
                _:
                    return true

        def proof_replay_source_body_touches(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, writes: bool, depth: usize) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            for statement in body |declarations, name, writes, depth|:
                return true if proof_replay_source_statement_touches(declarations, statement, name, writes, depth + 1)
            return false

        # Whether a function body introduces `name` anywhere, at any nesting depth.
        def proof_replay_source_body_declares_unmetered(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview) -> bool:
            return true if name == ""
            return proof_replay_source_body_touches(declarations, body, name, false, 0)

        def proof_replay_source_body_declares(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview) -> bool:
            source_work: mutable usize = 0
            proof_replay_source_body_declares_with_work(declarations, body, name, source_work)

        # Whether `name` is declared exactly once in a function body: by one top-level
        # declaration, with nothing else anywhere (including that declaration's initializer)
        # introducing the same spelling.
        def proof_replay_source_single_declaration_unmetered(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview) -> bool:
            return false if name == ""
            count: mutable usize = 0
            for statement in body |declarations, name, count|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, _, initializer, _):
                        if local_name == name:
                            count <- count + 1
                            return false if proof_replay_source_expr_touches(declarations, initializer, name, false, 0)
                        else:
                            return false if proof_replay_source_statement_touches(declarations, statement, name, false, 0)
                    _:
                        return false if proof_replay_source_statement_touches(declarations, statement, name, false, 0)
            return count == 1

        def proof_replay_source_single_declaration(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview) -> bool:
            source_work: mutable usize = 0
            proof_replay_source_single_declaration_with_work(declarations, body, name, source_work)

        # A multiline value RHS wraps its tail loop in an empty, capture-free block.
        # Only that transparent wrapper can be removed: statements or captures may carry
        # state and scope effects. Preserve the actual loop block and all its source spans.
        def proof_replay_source_unwrap_empty_value_block(expression: Ast::Expr, depth: usize) -> Ast::Expr:
            return Ast::Expr.Invalid if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            match expression:
                Ast::Expr.Block(statements, value, captures, _):
                    return proof_replay_source_unwrap_empty_value_block(value, depth + 1) if statements.count == 0 and captures.count == 0
                _:
                    pass
            return expression

        # The unique function body declared for `owner` at `owner_line`; `known` is false when the
        # owner is unidentified or ambiguous.
        def proof_replay_source_owner_body(report: ProofReport&, owner: sview, owner_line: u32, body: mutable darray[Ast::Stmt]&) -> bool:
            return false if owner == "" or owner_line == 0 or owner_line == 4294967295
            matches: mutable usize = 0
            proof_replay_local_binding_find_owner(report.source.source_declarations, owner, owner_line, body, &matches, 0)
            return matches == 1

        # CONTROL callers share their source-work counter with owner lookup. Charge each
        # declaration, candidate function-name comparison, and selected-body copy before doing
        # that work; a second matching owner is rejected before another body is copied.
        def proof_replay_local_binding_find_owner_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, body: mutable darray[Ast::Stmt]&, matches: mutable usize&, work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return false if depth >= 64 or work > work_limit
            for declaration in declarations |owner, owner_line, body, matches, work, work_limit, depth|:
                if work >= work_limit:
                    work <- work_limit
                    return false
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, _, _, statements, _, _, position):
                        if sview_len(name) > work_limit - work:
                            work <- work_limit
                            return false
                        work <- work + sview_len(name)
                        if name == owner and position.line == owner_line:
                            matches <- matches + 1
                            return false if matches != 1
                            if statements.count > work_limit - work:
                                work <- work_limit
                                return false
                            work <- work + statements.count
                            body.extend(statements)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_local_binding_find_owner_with_work(nested, owner, owner_line, body, matches, work, work_limit, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        # Check the exact `(name, line)` owner identity without copying a body that the caller
        # does not need. This keeps owner disambiguation bounded while avoiding a second
        # allocation and body-sized charge after the source-span walk.
        def proof_replay_local_binding_owner_count_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, matches: mutable usize&, work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return false if depth >= 64 or work > work_limit
            for declaration in declarations |owner, owner_line, matches, work, work_limit, depth|:
                if work >= work_limit:
                    work <- work_limit
                    return false
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, position):
                        if sview_len(name) > work_limit - work:
                            work <- work_limit
                            return false
                        work <- work + sview_len(name)
                        if name == owner and position.line == owner_line:
                            matches <- matches + 1
                            return false if matches != 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_local_binding_owner_count_with_work(nested, owner, owner_line, matches, work, work_limit, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        # Resolve a replay owner from its authenticated source declaration coordinates. This
        # allows same-name declarations on one line to remain distinct without weakening the
        # legacy line-only helper used by context-free callers.
        def proof_replay_local_binding_find_owner_at_offset_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, body: mutable darray[Ast::Stmt]&, matches: mutable usize&, work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return false if depth >= 64 or work > work_limit
            for declaration in declarations |owner, owner_line, owner_offset, body, matches, work, work_limit, depth|:
                if work >= work_limit:
                    work <- work_limit
                    return false
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(name, _, _, statements, _, _, position):
                        if sview_len(name) > work_limit - work:
                            work <- work_limit
                            return false
                        work <- work + sview_len(name)
                        if name == owner and position.line == owner_line and position.offset.usize() == owner_offset:
                            matches <- matches + 1
                            return false if matches != 1
                            if statements.count > work_limit - work:
                                work <- work_limit
                                return false
                            work <- work + statements.count
                            body.extend(statements)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_local_binding_find_owner_at_offset_with_work(nested, owner, owner_line, owner_offset, body, matches, work, work_limit, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_source_owner_body_with_work(report: ProofReport&, owner: sview, owner_line: u32, body: mutable darray[Ast::Stmt]&, work: mutable usize&, work_limit: usize) -> bool:
            return false if owner == "" or owner_line == 0 or owner_line == 4294967295 or work > work_limit
            body.clear()
            matches: mutable usize = 0
            if report.analysis_2.replay_owner_offset_valid:
                return false if report.analysis_2.replay_owner_line != owner_line
                return false if not proof_replay_local_binding_find_owner_at_offset_with_work(report.source.source_declarations, owner, owner_line, report.analysis_2.replay_owner_offset, body, &matches, work, work_limit, 0)
                return matches == 1
            return false if not proof_replay_local_binding_find_owner_with_work(report.source.source_declarations, owner, owner_line, body, &matches, work, work_limit, 0)
            return matches == 1
