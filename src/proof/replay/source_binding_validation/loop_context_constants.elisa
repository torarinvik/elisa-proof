# Match current loop context expressions while authenticating substituted constant leaves.
# Variable names and operator structure stay exact; no rebind or call normalization is admitted.
extend ElisaProof:
    private:
        def proof_replay_loop_context_constant_expression(report: ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, depth: usize, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            if depth == 0:
                return false if:
                    not proof_replay_summary_expr_charge_with_work(source, source_work)
                    proof_source_expression_has_overloaded_operator(source, report.source_primitive_operator_mask, 0)
            return true if proof_replay_summary_expr_equal_with_work(source, expected, source_work)
            match source:
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    return proof_replay_summary_call_global_constant_matches_with_work(report, trace, source, expected, source_work)
                Ast::Expr.Paren(inner, _):
                    match expected:
                        Ast::Expr.Paren(other, _):
                            return proof_replay_loop_context_constant_expression(report, trace, inner, other, depth + 1, source_work)
                        _:
                            return false
                Ast::Expr.Binary(left, operator, right, _):
                    match expected:
                        Ast::Expr.Binary(other_left, other_operator, other_right, _):
                            return operator == other_operator and proof_replay_loop_context_constant_expression(report, trace, left, other_left, depth + 1, source_work) and proof_replay_loop_context_constant_expression(report, trace, right, other_right, depth + 1, source_work)
                        _:
                            return false
                Ast::Expr.Unary(operator, inner, _):
                    match expected:
                        Ast::Expr.Unary(other_operator, other, _):
                            return operator == other_operator and proof_replay_loop_context_constant_expression(report, trace, inner, other, depth + 1, source_work)
                        _:
                            return false
                _:
                    return false
