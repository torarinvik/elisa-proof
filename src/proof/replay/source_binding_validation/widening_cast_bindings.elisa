# Source-backed match payloads and value-preserving widening casts.
extend ElisaProof:
    private:
        def proof_replay_local_binding_payload_names(pattern: Ast::Pattern, names: mutable darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match pattern:
                Ast::Pattern.Variant(_, fields):
                    for field in fields |names, depth|:
                        match field:
                            Ast::Pattern.Binding(name):
                                return false if name == "" or any existing in names where existing == name
                                names.push(name)
                            Ast::Pattern.Wildcard:
                                pass
                            _:
                                return false
                    return true
                _:
                    return false

        def proof_replay_local_binding_variant_enum_name_with_work(pattern: Ast::Pattern, source_work: mutable usize&) -> (complete: bool, name: sview):
            match pattern:
                Ast::Pattern.Variant(path, _):
                    return (false, "") if not proof_replay_source_work_charge_or_exhaust(sview_len(path), source_work)
                    split: mutable usize = 0
                    dots: mutable usize = 0
                    for offset in 0..<sview_len(path) |offset, path, split, dots|:
                        if sview_at(path, offset) == PROOF_ASCII_DECIMAL_POINT:
                            split <- offset
                            dots <- dots + 1
                    return (true, "") if dots != 1 or split == 0
                    return (true, string_view_slice(path, 0, split.i64()))
                _:
                    return (true, "")

        def proof_replay_local_binding_enum_parameter_type_name_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, depth: usize) -> (complete: bool, type_name: sview):
            scanned: (complete: bool, matches: usize, type_name: sview) = proof_replay_local_binding_enum_parameter_type_scan_with_work(declarations, owner, owner_line, parameter_name, source_work, depth)
            return (false, "") if scanned.complete and scanned.matches > 1
            return (scanned.complete, scanned.type_name) if scanned.complete and scanned.matches == 1
            return (scanned.complete, "")

        def proof_replay_local_binding_enum_parameter_type_scan_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, depth: usize) -> (complete: bool, matches: usize, type_name: sview):
            return (false, 0, "") if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or owner == "" or owner_line == 0 or parameter_name == ""
            matches: mutable usize = 0
            type_name: mutable sview = ""
            for declaration in declarations |owner, owner_line, parameter_name, depth, matches, type_name, source_work|:
                return (false, 0, "") if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return (false, 0, "") if not proof_replay_mutable_local_text_compare_work_charge(name, owner, source_work)
                        if name == owner and position.line == owner_line:
                            for parameter in parameters |parameter_name, matches, type_name, source_work|:
                                return (false, 0, "") if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                                return (false, 0, "") if not proof_replay_mutable_local_text_compare_work_charge(parameter.name, parameter_name, source_work)
                                if parameter.name == parameter_name:
                                    matches <- matches + 1
                                    return (false, 0, "") if not proof_replay_summary_expr_repeat_charge_with_limit(parameter.type_expression, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                    match parameter.type_expression:
                                        Ast::Expr.Ident(found, _):
                                            type_name <- found if not proof_replay_local_binding_mutable_integer_type(parameter.type_expression)
                                        _:
                                            type_name <- ""
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        nested_result: (complete: bool, matches: usize, type_name: sview) = proof_replay_local_binding_enum_parameter_type_scan_with_work(nested, owner, owner_line, parameter_name, source_work, depth + 1)
                        return nested_result if not nested_result.complete
                        matches <- matches + nested_result.matches
                        type_name <- nested_result.type_name if nested_result.matches == 1
                    Ast::Decl.Invalid:
                        return (false, 0, "")
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return (false, 0, "")
            (true, matches, type_name)

        def proof_replay_local_binding_arm_prefix_safe(arm: Ast::MatchArm) -> bool:
            match arm.guard:
                Ast::Expr.Absent:
                    pass
                _:
                    return false
            for statement in arm.body:
                match statement:
                    Ast::Stmt.Return(Ast::Expr.IntLit(_, _), _):
                        pass
                    _:
                        return false
            return true

        # The widening-cast binder slice permits the checked local initializer, unrelated local
        # declarations that do not shadow its payload, and the consuming return. Other statements
        # could rebind the payload or change the path between pattern introduction and use.
        def proof_replay_local_binding_widening_arm_shape(arm: Ast::MatchArm, target: sview, source_name: sview, target_line: u32, consumer_line: u32) -> bool:
            return false if target == "" or source_name == "" or target_line == 0 or consumer_line == 0
            target_count: mutable usize = 0
            target_seen: mutable bool = false
            return_seen: mutable bool = false
            for statement in arm.body |target, target_line, consumer_line, target_count, target_seen, return_seen|:
                match statement:
                    Ast::Stmt.VarDecl(name, _, _, position):
                        return false if return_seen or name == source_name
                        if name == target:
                            return false if target_seen or position.line != target_line
                            target_count <- target_count + 1
                            target_seen <- true
                    Ast::Stmt.Return(_, position):
                        return false if not target_seen or return_seen or position.line != consumer_line
                        return_seen <- true
                    _:
                        return false
            return target_count == 1 and return_seen

        # Positional enum binders are source-backed only when the exact unique match arm has a
        # simple payload pattern, the scrutinee is an immutable enum parameter, and every earlier
        # source path is unable to allocate a fresh witness.
        def proof_replay_local_binding_match_widening_cast_source(report: ProofReport&, trace: ProofFactTrace, target: sview, receiver: sview, trace_method: sview, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or target == "" or receiver == "" or report.replay_owner_line == 0 or report.trace_owner_line == 0
            function_body: mutable darray[Ast::Stmt] = []
            owner_matches: mutable usize = 0
            return false if not proof_replay_local_binding_find_owner_with_work(report.source_declarations, trace.name, report.replay_owner_line, &function_body, &owner_matches, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0) or owner_matches != 1
            return false if proof_replay_local_binding_cast_hook_present(report.source_declarations, source_work, 0)
            candidate_matches: mutable usize = 0
            valid: mutable bool = false
            prefix_unambiguous: mutable bool = true
            for statement_index in 0..<function_body.count |statement_index, function_body, target, receiver, trace_method, trace, report, candidate_matches, valid, prefix_unambiguous, source_work|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                if statement_index >= 2 and prefix_unambiguous:
                    prefix_unambiguous <- proof_replay_local_binding_first_rebind_prefix_statement_with_work(function_body[statement_index - 2], source_work)
                    return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                match function_body[statement_index]:
                    Ast::Stmt.Match(subject, arms, _):
                        return false if arms.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + arms.count
                        for arm_index in 0..<arms.count |arm_index, subject, arms, statement_index, function_body, target, receiver, trace_method, trace, report, candidate_matches, valid, source_work, prefix_unambiguous|:
                            arm: Ast::MatchArm = arms[arm_index]
                            target_count: mutable usize = 0
                            target_type_expression: mutable Ast::Expr = Ast::Expr.Invalid
                            target_initializer: mutable Ast::Expr = Ast::Expr.Invalid
                            consumer_return: mutable bool = false
                            return false if arm.body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                            source_work <- source_work + arm.body.count
                            for arm_statement in arm.body |arm, target, trace, report, target_count, target_type_expression, target_initializer, consumer_return, source_work|:
                                match arm_statement:
                                    Ast::Stmt.VarDecl(name, type_expression, initializer, position):
                                        if name == target and position.line == trace.line:
                                            return false if position.line > report.trace_owner_line
                                            target_count <- target_count + 1
                                            target_type_expression <- type_expression
                                            target_initializer <- initializer
                                    Ast::Stmt.Return(_, position):
                                        consumer_return <- true if position.line == report.trace_owner_line
                                    _:
                                        pass
                            continue if target_count == 0
                            candidate_matches <- candidate_matches + target_count
                            continue if target_count != 1
                            subject_name: sview = proof_ident_name(subject)
                            pattern_enum_result: (complete: bool, name: sview) = proof_replay_local_binding_variant_enum_name_with_work(arm.pattern, source_work)
                            return false if not pattern_enum_result.complete
                            pattern_enum: sview = pattern_enum_result.name
                            return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                            return false if pattern_enum == "" or not proof_replay_local_binding_parameter_source_unshadowed_with_work(report.source_declarations, trace.name, report.replay_owner_line, subject_name, source_work)
                            enum_parameter_type: (complete: bool, type_name: sview) = proof_replay_local_binding_enum_parameter_type_name_with_work(report.source_declarations, trace.name, report.replay_owner_line, subject_name, source_work, 0)
                            return false if not enum_parameter_type.complete or enum_parameter_type.type_name != pattern_enum
                            return false if not prefix_unambiguous
                            names: mutable darray[sview] = []
                            types: mutable darray[Ast::Expr] = []
                            return false if not proof_replay_local_binding_payload_names(arm.pattern, &names, 0)
                            return false if not proof_payload_binder_types(arm.pattern, report.source_declarations, report.source_annotations, &types)
                            return false if names.count == 0 or names.count != types.count or not consumer_return
                            target_source_name: mutable sview = ""
                            binder_ordinal: mutable usize = 0
                            for binder_index in 0..<names.count |binder_index, names, receiver, target_source_name, binder_ordinal|:
                                target_source_name <- names[binder_index] if names[binder_index] == proof_replay_local_binding_cast_receiver_name(target_initializer)
                                binder_ordinal <- binder_index if names[binder_index] == proof_replay_local_binding_cast_receiver_name(target_initializer)
                            return false if target_source_name == ""
                            return false if not proof_replay_local_binding_widening_arm_shape(arm, target, target_source_name, trace.line, report.trace_owner_line)
                            prior_fresh_symbols: mutable usize = 0
                            return false if arm_index > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                            source_work <- source_work + arm_index
                            for prior_arm_index in 0..<arm_index |prior_arm_index, arms, report, prior_fresh_symbols, source_work|:
                                prior_arm: Ast::MatchArm = arms[prior_arm_index]
                                prior_names: mutable darray[sview] = []
                                prior_types: mutable darray[Ast::Expr] = []
                                return false if not proof_replay_local_binding_payload_names(prior_arm.pattern, &prior_names, 0)
                                return false if not proof_payload_binder_types(prior_arm.pattern, report.source_declarations, report.source_annotations, &prior_types)
                                return false if prior_names.count != prior_types.count or not proof_replay_local_binding_arm_prefix_safe(prior_arm)
                                prior_fresh_symbols <- prior_fresh_symbols + prior_names.count
                            fresh_index: usize = prior_fresh_symbols + binder_ordinal
                            return false if fresh_index >= PROOF_INTERNAL_REBIND_SYMBOL_COUNT or receiver != proof_internal_rebind_name(fresh_index)
                            source_type: Ast::Expr = types[binder_ordinal]
                            source_type_name: sview = proof_replay_local_binding_integer_type_name(source_type, 0)
                            target_type_name: sview = proof_replay_local_binding_integer_type_name(target_type_expression, 0)
                            return false if source_type_name == "" or target_type_name == "" or proof_replay_local_binding_mutable_integer_type(target_type_expression)
                            target_unsigned: i64 = proof_unsigned_type_width_with_work(target_type_expression, report.source_declarations, 0, source_work)
                            target_signed: i64 = proof_signed_type_width_with_work(target_type_expression, report.source_declarations, 0, source_work)
                            source_unsigned: i64 = proof_unsigned_type_width_with_work(source_type, report.source_declarations, 0, source_work)
                            source_signed: i64 = proof_signed_type_width_with_work(source_type, report.source_declarations, 0, source_work)
                            widening: bool = (source_unsigned > 0 and ((target_unsigned > 0 and target_unsigned >= source_unsigned) or (target_signed > 0 and target_signed > source_unsigned))) or (source_signed > 0 and target_signed > 0 and target_signed >= source_signed)
                            match target_initializer:
                                Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(source_name, _), method, _), arguments, _, _):
                                    valid <- arguments.count == 0 and source_name == target_source_name and method == target_type_name and widening and (trace_method == "" or trace_method == method)
                                _:
                                    valid <- false
                    _:
                        pass
            return candidate_matches == 1 and valid

        def proof_replay_local_binding_cast_receiver_name(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), _, _), arguments, _, _):
                    if arguments.count == 0:
                        return receiver
                    return ""
                _:
                    return ""

        # A derived equality is admitted only for a source-declared widening cast: its receiver
        # must be an immutable integer parameter, and the target must preserve the whole range.
        def proof_replay_local_binding_widening_cast_declaration_source(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or report.replay_owner_line == 0 or report.trace_owner_line == 0 or trace.line == 0
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(target, _), TokenKind.EqEq, Ast::Expr.Ident(receiver, _), _):
                    return false if target == "" or receiver == "" or target == receiver or proof_internal_name_is_rebind(target)
                    # A pattern payload has a reserved branch symbol. Validate it through the
                    # exact source match arm before considering ordinary parameter receivers.
                    return false if proof_internal_name_is_rebind(receiver)
                    function_body: mutable darray[Ast::Stmt] = []
                    owner_matches: mutable usize = 0
                    return false if not proof_replay_local_binding_find_owner_with_work(report.source_declarations, trace.name, report.replay_owner_line, &function_body, &owner_matches, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0) or owner_matches != 1
                    consumer_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    return false if not proof_replay_mutable_local_consumer_position_with_work(report, trace, function_body, &consumer_position, source_work)
                    return false if consumer_position.offset == 0 or consumer_position.end_offset <= consumer_position.offset
                    return false if proof_replay_local_binding_cast_hook_present(report.source_declarations, source_work, 0)
                    declarations: mutable usize = 0
                    valid: mutable bool = false
                    for statement in function_body |target, receiver, trace, report, declarations, valid|:
                        match statement:
                            Ast::Stmt.VarDecl(name, type_expression, initializer, position):
                                if name == target:
                                    declarations <- declarations + 1
                                    single: mutable darray[Ast::Stmt] = [statement]
                                    extent_cost: mutable usize = 0
                                    return false if not proof_replay_summary_expr_cost_body(single, &extent_cost, source_work, 0)
                                    return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or extent_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                                    source_work <- source_work + extent_cost
                                    declaration_extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(statement, 0)
                                    return false if not declaration_extent.offsets_complete or position.offset == 0 or declaration_extent.end_offset <= position.offset or declaration_extent.end_offset > consumer_position.offset
                                    target_type: sview = proof_replay_local_binding_integer_type_name(type_expression, 0)
                                    match initializer:
                                        Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(source_name, _), method, _), arguments, _, _):
                                            source_type_result: (complete: bool, type_name: sview) = proof_replay_local_binding_integer_parameter_type_name_with_work(report.source_declarations, trace.name, report.replay_owner_line, source_name, source_work, 0)
                                            return false if not source_type_result.complete
                                            source_type: mutable sview = source_type_result.type_name
                                            source_type <- proof_replay_local_binding_unwritten_parameter_type_name(report.source_declarations, trace.name, report.replay_owner_line, source_name, source_work) if source_type == ""
                                            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                            source_expression: Ast::Expr = Ast::Expr.Ident(source_type, position)
                                            target_unsigned: i64 = proof_unsigned_type_width_with_work(type_expression, report.source_declarations, 0, source_work)
                                            target_signed: i64 = proof_signed_type_width_with_work(type_expression, report.source_declarations, 0, source_work)
                                            source_unsigned: i64 = proof_unsigned_type_width_with_work(source_expression, report.source_declarations, 0, source_work)
                                            source_signed: i64 = proof_signed_type_width_with_work(source_expression, report.source_declarations, 0, source_work)
                                            widening: bool = (source_unsigned > 0 and ((target_unsigned > 0 and target_unsigned >= source_unsigned) or (target_signed > 0 and target_signed > source_unsigned))) or (source_signed > 0 and target_signed > 0 and target_signed >= source_signed)
                                            valid <- not proof_replay_local_binding_mutable_integer_type(type_expression) and proof_replay_local_binding_parameter_source_unshadowed_with_work(report.source_declarations, trace.name, report.replay_owner_line, source_name, source_work) and arguments.count == 0 and receiver == source_name and method == target_type and target_type != "" and source_type != "" and widening
                                        _:
                                            pass
                            _:
                                pass
                    # The top-level declaration must be the only introduction of the target
                    # anywhere in the body; a nested redeclaration would make the fact name it.
                    return true if declarations == 1 and valid and proof_replay_source_single_declaration_with_work(report.source_declarations, function_body, target, source_work)
                    # The fallback inspects enum-arm candidates with logical-line ordering.
                    # Keep it unavailable until that route is tied to exact source spans too.
                    return false
                # The producer may keep the cast spelled on a payload symbol (`wide == r.i64()`);
                # the source declaration must then use the same conversion.
                Ast::Expr.Binary(Ast::Expr.Ident(target, _), TokenKind.EqEq, Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), method, _), arguments, _, _), _):
                    return false if arguments.count != 0 or target == "" or proof_internal_name_is_rebind(target) or not proof_internal_name_is_rebind(receiver)
                    # Pattern-rebind cast selection still uses line-based arm recovery. It is
                    # not safe under #line remapping, so keep this source route unavailable.
                    return false
                _:
                    return false

