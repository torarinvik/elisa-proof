# `old(v.count)` for a darray reference parameter names a fresh symbol fixed at function entry
# by `E == v.count` (proof_seed_entry_counts). Replay accepts that definition only when
#   - it is traced at the owner function's own declaration line, in the certificate's owner;
#   - `v` is an unshadowed parameter of the owner and `E` a reserved rebind symbol that no other
#     binding or summary of the owner defines differently (the shared uniqueness rule);
#   - the receiver is readonly throughout the owner body, matching the primary entry-count
#     route; no source-prefix cutoff can justify a post-state equality. A
#     compound statement that starts at or before the consumer counts as a whole, so writes
#     later in a loop body are seen too; outside a loop-preservation context, a loop on the
#     consumer's own line is a loop-entry check and is not entered.
extend ElisaProof:
    private:
        def proof_replay_entry_count_old_name_clear(declarations: darray[Ast::Decl]&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for declaration in declarations |depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, _):
                        return false if name == "old" or any parameter in parameters where parameter.name == "old"
                        return false if proof_replay_source_body_declares(declarations, body, "old")
                    Ast::Decl.Const(name, _, _, _, _) | Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if name == "old"
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_entry_count_old_name_clear(nested, depth + 1)
                    _:
                        pass
            return true

        # Recognize only the source old-count snapshot in a postcondition. Other calls,
        # explicit lends, moves and unsupported forms keep the ordinary conservative scan.
        def proof_replay_entry_count_postcondition_written(declarations: darray[Ast::Decl]&, expression: Ast::Expr, name: sview, depth: usize) -> bool:
            return true if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_entry_count_postcondition_written(declarations, left, name, depth + 1) or proof_replay_entry_count_postcondition_written(declarations, right, name, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_entry_count_postcondition_written(declarations, inner, name, depth + 1)
                Ast::Expr.Call(Ast::Expr.Ident(callee, _), arguments, argument_names, _):
                    if callee == "old" and arguments.count == 1 and (argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == "")):
                        match arguments[0]:
                            Ast::Expr.Field(Ast::Expr.Ident(parameter, _), field, _):
                                if parameter == name and field == "count":
                                    return not proof_replay_entry_count_old_name_clear(declarations, 0)
                            _:
                                pass
                    return proof_replay_source_expr_touches(declarations, expression, name, true, depth + 1)
                _:
                    return proof_replay_source_expr_touches(declarations, expression, name, true, depth + 1)

        def proof_replay_entry_count_written(declarations: darray[Ast::Decl]&, statement: Ast::Stmt, name: sview, depth: usize) -> bool:
            return true if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match statement:
                Ast::Stmt.Contract(kind, expression, _):
                    return proof_replay_entry_count_postcondition_written(declarations, expression, name, depth + 1) if kind == "ensure" or kind == "ensures"
                    return proof_replay_source_statement_touches(declarations, statement, name, true, 0)
                Ast::Stmt.Assign(Ast::Expr.Index(Ast::Expr.Ident(root, _), index, _), _, value, _):
                    return proof_replay_source_statement_touches(declarations, statement, name, true, 0) if root != name
                    return proof_replay_source_expr_touches(declarations, index, name, true, 0) or proof_replay_source_expr_touches(declarations, value, name, true, 0)
                Ast::Stmt.If(condition, yes, no, _):
                    return true if proof_replay_source_expr_touches(declarations, condition, name, true, 0)
                    return proof_replay_entry_count_body_written(declarations, yes, name, depth + 1) or proof_replay_entry_count_body_written(declarations, no, name, depth + 1)
                Ast::Stmt.While(condition, nested, _) | Ast::Stmt.For(_, _, condition, nested, _):
                    return true if proof_replay_source_expr_touches(declarations, condition, name, true, 0)
                    return proof_replay_entry_count_body_written(declarations, nested, name, depth + 1)
                Ast::Stmt.Expr(Ast::Expr.Block(nested, value, _, _), _):
                    return true if proof_replay_source_expr_touches(declarations, value, name, true, 0)
                    return proof_replay_entry_count_body_written(declarations, nested, name, depth + 1)
                _:
                    return proof_replay_source_statement_touches(declarations, statement, name, true, 0)

        def proof_replay_entry_count_body_written(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, depth: usize) -> bool:
            return true if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for statement in body |declarations, name, depth|:
                return true if proof_replay_entry_count_written(declarations, statement, name, depth + 1)
            return false

        def proof_replay_local_binding_entry_count_source(report: ProofReport&, trace: ProofFactTrace, loop_entry: bool) -> bool:
            return false if trace.name == "" or trace.line == 0 or report.trace_owner_line == 0
            return false if trace.line != report.replay_owner_line
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, Ast::Expr.Field(Ast::Expr.Ident(parameter, _), field, _), _):
                    return false if field != "count" or not proof_internal_name_is_rebind(symbol) or symbol_position.line != trace.line
                    definitions: mutable usize = 0
                    for candidate in report.traces.records |trace, symbol, definitions|:
                        continue if candidate.kind != "local-binding" or candidate.name != trace.name
                        match candidate.expression:
                            Ast::Expr.Binary(Ast::Expr.Ident(bound, _), TokenKind.EqEq, _, _):
                                definitions <- definitions + 1 if bound == symbol
                            _:
                                pass
                    return false if definitions != 1
                    return false if not proof_replay_local_binding_parameter_name_present(report.source_declarations, trace.name, report.replay_owner_line, parameter, 0)
                    return false if not proof_replay_local_binding_parameter_source_unshadowed(report.source_declarations, trace.name, report.replay_owner_line, parameter)
                    match trace.expression:
                        Ast::Expr.Binary(_, _, count_place, _):
                            return false if not proof_replay_literal_rebind_unique(report, trace, symbol, symbol_position, count_place)
                        _:
                            return false
                    body: mutable darray[Ast::Stmt] = []
                    return false if not proof_replay_source_owner_body(report, trace.name, report.replay_owner_line, &body)
                    # Function-level certificates can be stamped at the declaration
                    # line even when they describe the post-state. A line cutoff
                    # cannot establish that the receiver is still its entry value.
                    # Match the readonly entry-count route before considering any
                    # loop-entry or source-prefix shortcut.
                    for statement in body |report, parameter|:
                        return false if proof_replay_source_statement_touches(report.source_declarations, statement, parameter, true, 0)
                    for statement in body |report, parameter, loop_entry|:
                        position: Ast::Pos = proof_replay_statement_position(statement)
                        if position.line > report.trace_owner_line:
                            break
                        if position.line == report.trace_owner_line and loop_entry:
                            match statement:
                                Ast::Stmt.While(_, _, _) | Ast::Stmt.For(_, _, _, _, _) | Ast::Stmt.Expr(Ast::Expr.Block(_, _, _, _), _):
                                    break
                                _:
                                    pass
                        return false if proof_replay_entry_count_written(report.source_declarations, statement, parameter, 0)
                    return true
                _:
                    return false
