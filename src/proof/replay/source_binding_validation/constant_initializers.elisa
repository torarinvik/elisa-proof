# Normalize only independently validated literal constants in local source equations.
extend ElisaProof:
    private:
        def proof_replay_local_initializer_constants(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, depth: usize) -> Ast::Expr:
            return expression if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return expression if not proof_replay_local_binding_parameter_source_unshadowed(report.source_declarations, trace.name, report.replay_owner_line, name)
                    for candidate in report.traces.records |candidate, report, trace, expression|:
                        continue if candidate.name != trace.name or (candidate.kind != "global-constant" and candidate.kind != "global-constant-qualified")
                        match candidate.expression:
                            Ast::Expr.Binary(_, TokenKind.EqEq, value, _):
                                return value if proof_replay_summary_call_global_constant_matches(report, trace, expression, value)
                            _:
                                pass
                    return expression
                Ast::Expr.Binary(left, operator, right, position):
                    return Ast::Expr.Binary(proof_replay_local_initializer_constants(report, trace, left, depth + 1), operator, proof_replay_local_initializer_constants(report, trace, right, depth + 1), position)
                Ast::Expr.Unary(operator, value, position):
                    return Ast::Expr.Unary(operator, proof_replay_local_initializer_constants(report, trace, value, depth + 1), position)
                Ast::Expr.Paren(value, position):
                    return Ast::Expr.Paren(proof_replay_local_initializer_constants(report, trace, value, depth + 1), position)
                Ast::Expr.If(condition, then_value, else_value, position):
                    return Ast::Expr.If(proof_replay_local_initializer_constants(report, trace, condition, depth + 1), proof_replay_local_initializer_constants(report, trace, then_value, depth + 1), proof_replay_local_initializer_constants(report, trace, else_value, depth + 1), position)
                _:
                    return expression
