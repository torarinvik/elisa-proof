# Normalize only independently validated literal constants in local source equations.
extend ElisaProof:
    private:
        # Source replay callers that already carry a shared counter use this version so each
        # recursive node, trace candidate and owner/global-constant lookup is included in the
        # same batch limit as the surrounding validator.
        def proof_replay_local_initializer_constants_with_work(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, work: mutable usize&, depth: usize) -> Ast::Expr:
            return Ast::Expr.Invalid if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    if not proof_replay_summary_call_constant_source_unshadowed(report, trace, expression, work):
                        return Ast::Expr.Invalid if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return expression
                    for candidate in report.traces.records |candidate, report, trace, expression, work|:
                        return Ast::Expr.Invalid if not proof_replay_mutable_local_text_compare_work_charge(candidate.name, trace.name, work)
                        continue if candidate.name != trace.name
                        return Ast::Expr.Invalid if not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "global-constant", work)
                        return Ast::Expr.Invalid if not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "global-constant-qualified", work)
                        continue if candidate.kind != "global-constant" and candidate.kind != "global-constant-qualified"
                        return Ast::Expr.Invalid if not proof_replay_summary_expr_charge_with_work(candidate.expression, work)
                        match candidate.expression:
                            Ast::Expr.Binary(_, TokenKind.EqEq, value, _):
                                return value if proof_replay_summary_call_global_constant_matches_with_work(report, trace, expression, value, work)
                            _:
                                pass
                    return Ast::Expr.Invalid if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return expression
                Ast::Expr.Binary(left, operator, right, position):
                    normalized_left: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, left, work, depth + 1)
                    return Ast::Expr.Invalid if proof_replay_expr_is_invalid(normalized_left)
                    normalized_right: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, right, work, depth + 1)
                    return Ast::Expr.Invalid if proof_replay_expr_is_invalid(normalized_right)
                    return Ast::Expr.Binary(normalized_left, operator, normalized_right, position)
                Ast::Expr.Unary(operator, value, position):
                    normalized: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, value, work, depth + 1)
                    return Ast::Expr.Invalid if proof_replay_expr_is_invalid(normalized)
                    return Ast::Expr.Unary(operator, normalized, position)
                Ast::Expr.Paren(value, position):
                    normalized: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, value, work, depth + 1)
                    return Ast::Expr.Invalid if proof_replay_expr_is_invalid(normalized)
                    return Ast::Expr.Paren(normalized, position)
                Ast::Expr.If(condition, then_value, else_value, position):
                    normalized_condition: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, condition, work, depth + 1)
                    return Ast::Expr.Invalid if proof_replay_expr_is_invalid(normalized_condition)
                    normalized_then: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, then_value, work, depth + 1)
                    return Ast::Expr.Invalid if proof_replay_expr_is_invalid(normalized_then)
                    normalized_else: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, else_value, work, depth + 1)
                    return Ast::Expr.Invalid if proof_replay_expr_is_invalid(normalized_else)
                    return Ast::Expr.If(normalized_condition, normalized_then, normalized_else, position)
                _:
                    return expression
