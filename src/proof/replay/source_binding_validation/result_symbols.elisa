# A verified call that initializes a local (`child: u64 = f(...)`) may have its result stored
# under a fresh proof symbol (`__elisa_rebind_N`) instead of the repeatable call expression. The
# symbol names that one invocation's value, so facts over it hold for the rest of the function,
# across later opaque calls; the local is tied to it by `child == symbol` only while the local
# still holds the call's value. Replay accepts the symbol only as such a definition:
#   - its position is the exact declaration statement, in the certificate's owner function,
#     whose initializer is a direct call;
#   - at least one local-binding of that function binds `local == symbol` at that unique
#     declaration, and no other local-binding mentions the symbol (duplicate trace records for
#     the same source fact are allowed);
#   - every function-summary value mentioning the symbol is exactly that symbol at that
#     position (the call's result binding);
#   - `local == symbol` additionally needs the local to still hold the call's value at the
#     consumer (the same reaching-definition check as a local-alias summary).
extend ElisaProof:
    private:
        def proof_replay_result_symbol_find(body: darray[Ast::Stmt]&, position: Ast::Pos, found: mutable usize&, local: mutable sview&, local_type: mutable Ast::Expr&, call: mutable Ast::Expr&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            for statement in body |position, found, local, local_type, call, source_work, depth|:
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    return proof_replay_mutable_local_work_exhaust(source_work)
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.VarDecl(name, declared_type, initializer, statement_position):
                        if proof_replay_source_position_equal(statement_position, position):
                            found <- found + 1
                            local <- name
                            local_type <- declared_type
                            call <- initializer
                            match initializer:
                                Ast::Expr.Paren(inner, _):
                                    call <- inner
                                _:
                                    pass
                    Ast::Stmt.If(_, yes, no, _):
                        return false if not proof_replay_result_symbol_find(yes, position, found, local, local_type, call, source_work, depth + 1)
                        return false if not proof_replay_result_symbol_find(no, position, found, local, local_type, call, source_work, depth + 1)
                    Ast::Stmt.While(_, nested, _) | Ast::Stmt.For(_, _, _, nested, _) | Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_result_symbol_find(nested, position, found, local, local_type, call, source_work, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |position, found, local, local_type, call, source_work, depth|:
                            if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                                return proof_replay_mutable_local_work_exhaust(source_work)
                            source_work <- source_work + 1
                            return false if not proof_replay_result_symbol_find(arm.body, position, found, local, local_type, call, source_work, depth + 1)
                    Ast::Stmt.Expr(Ast::Expr.Block(nested, _, _, _), _):
                        return false if not proof_replay_result_symbol_find(nested, position, found, local, local_type, call, source_work, depth + 1)
                    _:
                        pass
            return true

        # Find the result call as a direct body statement. The caller binds its consumer to the
        # actual loop-header certificate; separate return/break/continue certificates use their
        # transfer statement's line and cannot borrow this normal-fallthrough context.
        def proof_replay_result_symbol_direct_loop_declaration(body: darray[Ast::Stmt]&, position: Ast::Pos, found: mutable usize&, local: mutable sview&, local_type: mutable Ast::Expr&, call: mutable Ast::Expr&) -> void:
            for statement in body |position, found, local, local_type, call|:
                continue if found > 0
                match statement:
                    Ast::Stmt.VarDecl(name, declared_type, initializer, statement_position):
                        if proof_replay_source_position_equal(statement_position, position):
                            found <- found + 1
                            local <- name
                            local_type <- declared_type
                            call <- initializer
                            match initializer:
                                Ast::Expr.Paren(inner, _):
                                    call <- inner
                                _:
                                    pass
                    _:
                        pass

        # Find the consumer's innermost loop and return the byte end of this statement tree in
        # the same charged traversal. Loop headers have start positions only, so the body extent
        # closes their source span; line numbers are diagnostic metadata and may be remapped.
        def proof_replay_result_symbol_preservation_loop_site_with_work(body: darray[Ast::Stmt]&, consumer_position: Ast::Pos, symbol_position: Ast::Pos, selected_extent: mutable u32&, selected_loop_line: mutable u32&, selected_condition: mutable Ast::Expr&, selected_invariants: mutable darray[Ast::Expr]&, loops: mutable usize&, declarations: mutable usize&, local: mutable sview&, local_type: mutable Ast::Expr&, call: mutable Ast::Expr&, depth: usize, source_work: mutable usize&) -> (complete: bool, last_offset: u32):
            return (false, 0) if depth >= 96
            last: mutable u32 = 0
            for statement in body |body, consumer_position, symbol_position, selected_extent, selected_condition, selected_invariants, loops, declarations, local, local_type, call, depth, source_work, last|:
                return (false, last) if not proof_replay_mutable_local_statement_work_charge(statement, source_work, depth)
                position: Ast::Pos = proof_replay_statement_position(statement)
                last <- position.end_offset if position.end_offset > last
                nested_end: mutable u32 = 0
                match statement:
                    Ast::Stmt.While(_, nested, loop_position) | Ast::Stmt.For(_, _, _, nested, loop_position):
                        nested_status: (complete: bool, last_offset: u32) = proof_replay_result_symbol_preservation_loop_site_with_work(nested, consumer_position, symbol_position, selected_extent, selected_loop_line, selected_condition, selected_invariants, loops, declarations, local, local_type, call, depth + 1, source_work)
                        return (false, last) if not nested_status.complete
                        nested_end <- nested_status.last_offset
                        scope_end: mutable u32 = loop_position.end_offset
                        scope_end <- nested_end if nested_end > scope_end
                        return (false, last) if loop_position.offset == 0 or scope_end == 0 or scope_end < loop_position.offset
                        if consumer_position.offset >= loop_position.offset and consumer_position.offset < scope_end:
                            extent: u32 = scope_end - loop_position.offset
                            if extent < selected_extent:
                                selected_extent <- extent
                                loops <- 0
                                declarations <- 0
                                local <- ""
                                local_type <- Ast::Expr.Invalid
                                call <- Ast::Expr.Invalid
                                selected_condition <- Ast::Expr.Invalid
                                selected_invariants <- selected_invariants.truncate(0)
                                selected_loop_line <- loop_position.line
                                match statement:
                                    Ast::Stmt.While(condition, _, _):
                                        selected_condition <- condition
                                    _:
                                        pass
                                for loop_statement in nested |loop_statement, selected_invariants, source_work|:
                                    return (false, last) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                    source_work <- source_work + 1
                                    match loop_statement:
                                        Ast::Stmt.Contract(kind, expression, _):
                                            if kind == "invariant":
                                                return (false, last) if not proof_replay_summary_expr_charge_with_work(expression, source_work)
                                                selected_invariants.push(expression)
                                        _:
                                            pass
                            if extent == selected_extent:
                                loops <- loops + 1
                                return (false, last) if not proof_replay_mutable_local_body_work_charge(nested, source_work, 0)
                                proof_replay_result_symbol_direct_loop_declaration(nested, symbol_position, declarations, local, local_type, call)
                    Ast::Stmt.If(_, yes, no, _):
                        yes_status: (complete: bool, last_offset: u32) = proof_replay_result_symbol_preservation_loop_site_with_work(yes, consumer_position, symbol_position, selected_extent, selected_loop_line, selected_condition, selected_invariants, loops, declarations, local, local_type, call, depth + 1, source_work)
                        return (false, last) if not yes_status.complete
                        no_status: (complete: bool, last_offset: u32) = proof_replay_result_symbol_preservation_loop_site_with_work(no, consumer_position, symbol_position, selected_extent, selected_loop_line, selected_condition, selected_invariants, loops, declarations, local, local_type, call, depth + 1, source_work)
                        return (false, last) if not no_status.complete
                        nested_end <- yes_status.last_offset if yes_status.last_offset > nested_end
                        nested_end <- no_status.last_offset if no_status.last_offset > nested_end
                    Ast::Stmt.Block(_, _, _, nested, _) | Ast::Stmt.Expr(Ast::Expr.Block(nested, _, _, _), _):
                        nested_status: (complete: bool, last_offset: u32) = proof_replay_result_symbol_preservation_loop_site_with_work(nested, consumer_position, symbol_position, selected_extent, selected_loop_line, selected_condition, selected_invariants, loops, declarations, local, local_type, call, depth + 1, source_work)
                        return (false, last) if not nested_status.complete
                        nested_end <- nested_status.last_offset
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |consumer_position, symbol_position, selected_extent, selected_loop_line, selected_condition, selected_invariants, loops, declarations, local, local_type, call, depth, source_work, nested_end|:
                            return (false, last) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            source_work <- source_work + 1
                            arm_status: (complete: bool, last_offset: u32) = proof_replay_result_symbol_preservation_loop_site_with_work(arm.body, consumer_position, symbol_position, selected_extent, selected_loop_line, selected_condition, selected_invariants, loops, declarations, local, local_type, call, depth + 1, source_work)
                            return (false, last) if not arm_status.complete
                            nested_end <- arm_status.last_offset if arm_status.last_offset > nested_end
                    _:
                        pass
                last <- nested_end if nested_end > last
            return (true, last)

        def proof_replay_result_symbol_trace_in_consumer_certificate_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                not proof_replay_mutable_local_text_compare_work_charge(certificate.name, trace.name, source_work)
                certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
                not proof_replay_mutable_local_text_compare_work_charge(certificate.rule, "goal", source_work)
                not proof_replay_mutable_local_text_compare_work_charge(certificate.rule, "quantifier-forall", source_work)
                not proof_replay_mutable_local_text_compare_work_charge(certificate.rule, "quantifier-exists", source_work)
            # Loop preservation is certified through the ordinary goal path, which may select a
            # quantifier rule for quantified invariants. Specialized safety/index/frame rules do
            # not establish the normal-iteration preservation phase, even if they share premises.
            return false if:
                certificate.rule != "goal" and certificate.rule != "quantifier-forall" and certificate.rule != "quantifier-exists"
                certificate.facts_start > report.analysis_1.certificate_facts.count or certificate.facts_count > report.analysis_1.certificate_facts.count - certificate.facts_start
                certificate.facts_start > report.analysis_1.traces.origin_indices.count or certificate.facts_count > report.analysis_1.traces.origin_indices.count - certificate.facts_start
            if certificate.facts_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                return proof_replay_mutable_local_work_exhaust(source_work)
            source_work <- source_work + certificate.facts_count
            for fact_index in 0..<certificate.facts_count |fact_index, report, certificate, trace, source_work|:
                fact: Ast::Expr = report.analysis_1.certificate_facts[certificate.facts_start + fact_index]
                exact: mutable bool = false
                return false if not proof_replay_mutable_local_expr_equal_with_work(fact, trace.expression, &exact, source_work)
                return true if exact and proof_replay_local_binding_expr_positions_match(fact, trace.expression)
            return false

        # A body-local result may enter the context only for normal loop preservation. The
        # certificate's exact goal position selects its innermost enclosing loop by source span;
        # line numbers are only diagnostic metadata and can be remapped by `#line`.
        def proof_replay_result_symbol_loop_preservation_available(report: ProofReport&, trace: ProofFactTrace, symbol_position: Ast::Pos, local: sview, call: Ast::Expr) -> bool:
            source_work: mutable usize = 0
            return proof_replay_result_symbol_loop_preservation_available_with_work(report, trace, symbol_position, local, call, &source_work)

        def proof_replay_result_symbol_loop_preservation_available_with_work(report: ProofReport&, trace: ProofFactTrace, symbol_position: Ast::Pos, local: sview, call: Ast::Expr, source_work: mutable usize&) -> bool:
            return false if symbol_position.offset == 0
            consumer: (known: bool, position: Ast::Pos) = proof_replay_local_alias_consumer_position(report, trace.name, source_work)
            return false if not consumer.known
            return proof_replay_result_symbol_loop_preservation_available_at_with_work(report, trace, symbol_position, local, call, consumer.position, source_work)

        def proof_replay_result_symbol_loop_preservation_available_at_with_work(report: ProofReport&, trace: ProofFactTrace, symbol_position: Ast::Pos, local: sview, call: Ast::Expr, consumer_position: Ast::Pos, source_work: mutable usize&) -> bool:
            return false if:
                symbol_position.offset == 0 or consumer_position.offset == 0 or consumer_position.end_offset < consumer_position.offset
                not proof_replay_mutable_local_trace_work_charge_fail_closed(report, source_work, 1)
                not proof_replay_result_symbol_trace_in_consumer_certificate_with_work(report, trace, source_work)
                not proof_replay_mutable_local_owner_preflight_work_charge(report, trace.name, report.analysis_2.replay_owner_line, source_work)
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            loops: mutable usize = 0
            declarations: mutable usize = 0
            selected_extent: mutable u32 = 4294967295
            selected_loop_line: mutable u32 = 0
            selected_condition: mutable Ast::Expr = Ast::Expr.Invalid
            selected_invariants: mutable darray[Ast::Expr] = []
            found_local: mutable sview = ""
            found_type: mutable Ast::Expr = Ast::Expr.Invalid
            found_call: mutable Ast::Expr = Ast::Expr.Invalid
            loop_scan: (complete: bool, last_offset: u32) = proof_replay_result_symbol_preservation_loop_site_with_work(body, consumer_position, symbol_position, &selected_extent, &selected_loop_line, &selected_condition, &selected_invariants, &loops, &declarations, &found_local, &found_type, &found_call, 0, source_work)
            return false if:
                not loop_scan.complete
                loops != 1 or declarations != 1 or found_local != local or not proof_replay_call_source_position_equal(found_call, call)
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            guard_found: mutable bool = false
            invariant_expressions: mutable darray[Ast::Expr] = []
            update_names: mutable darray[sview] = []
            update_values: mutable darray[Ast::Expr] = []
            return false if certificate.facts_start > report.analysis_1.traces.origin_indices.count or certificate.facts_count > report.analysis_1.traces.origin_indices.count - certificate.facts_start
            if certificate.facts_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                return proof_replay_mutable_local_work_exhaust(source_work)
            source_work <- source_work + certificate.facts_count
            for fact_index in 0..<certificate.facts_count |fact_index, report, certificate, trace, guard_found, invariant_expressions, update_names, update_values, source_work|:
                origin: usize = report.analysis_1.traces.origin_indices[certificate.facts_start + fact_index]
                continue if origin >= report.analysis_1.traces.records.count
                candidate: ProofFactTrace = report.analysis_1.traces.records[origin]
                return false if not proof_replay_mutable_local_text_compare_work_charge(candidate.name, trace.name, source_work)
                continue if candidate.name != trace.name
                return false if not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "loop-condition", source_work)
                if candidate.kind == "loop-condition":
                    return false if not proof_replay_mutable_local_owner_preflight_work_charge(report, trace.name, report.analysis_2.replay_owner_line, source_work)
                    guard_found <- true if proof_replay_local_binding_context_fact_matches_selected_loop(report, candidate, selected_loop_line, selected_condition, selected_invariants, source_work)
                return false if not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "loop-invariant", source_work)
                if candidate.kind == "loop-invariant":
                    return false if not proof_replay_mutable_local_owner_preflight_work_charge(report, trace.name, report.analysis_2.replay_owner_line, source_work)
                    if proof_replay_local_binding_context_fact_matches_selected_loop(report, candidate, selected_loop_line, selected_condition, selected_invariants, source_work):
                        invariant_expressions.push(candidate.expression)
                return false if not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "local-binding", source_work)
                if candidate.kind == "local-binding":
                    candidate_update_valid: bool = proof_replay_local_binding_loop_self_update_source_with_work(report, candidate, true, source_work)
                    return false if not candidate_update_valid and source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    if candidate_update_valid:
                        match candidate.expression:
                            Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, value, _):
                                target: sview = proof_replay_local_binding_update_target(value)
                                continue if target == ""
                                duplicate_update: mutable bool = false
                                for update_index in 0..<update_names.count |update_index, update_names, update_values, target, symbol, symbol_position, duplicate_update, source_work|:
                                    return false if not proof_replay_mutable_local_identifier_scan_charge(Ast::Expr.Ident(update_names[update_index], symbol_position), 0, source_work)
                                    if update_names[update_index] == target:
                                        exact: mutable bool = false
                                        return false if not proof_replay_mutable_local_expr_equal_with_work(update_values[update_index], Ast::Expr.Ident(symbol, symbol_position), &exact, source_work) or not exact or not proof_replay_source_position_equal(Ast::expr_pos(update_values[update_index]), symbol_position)
                                        duplicate_update <- true
                                continue if duplicate_update
                                update_names.push(target)
                                update_values.push(Ast::Expr.Ident(symbol, symbol_position))
                            _:
                                pass
            return false if not guard_found or invariant_expressions.count == 0 or update_names.count == 0
            for invariant in invariant_expressions |invariant, update_names, update_values, certificate, source_work|:
                return false if not proof_replay_summary_expr_repeat_charge_with_work(invariant, update_names.count + 1, source_work)
                expected_goal: Ast::Expr = proof_replay_substitute_many(invariant, update_names, update_values)
                return false if not proof_replay_summary_expr_charge_with_work(expected_goal, source_work) or not proof_replay_summary_expr_charge_with_work(invariant, source_work) or not proof_replay_summary_expr_charge_with_work(certificate.goal, source_work)
                different_from_invariant: mutable bool = false
                matches_goal: mutable bool = false
                return false if:
                    not proof_replay_mutable_local_expr_equal_with_work(expected_goal, invariant, &different_from_invariant, source_work)
                    not proof_replay_mutable_local_expr_equal_with_work(expected_goal, certificate.goal, &matches_goal, source_work)
                return true if not different_from_invariant and matches_goal
            return false

        def proof_replay_result_symbol_source_available(report: ProofReport&, trace: ProofFactTrace, symbol_position: Ast::Pos, local: sview, call: Ast::Expr) -> bool:
            source_work: mutable usize = 0
            return proof_replay_result_symbol_source_available_with_work(report, trace, symbol_position, local, call, &source_work)

        def proof_replay_result_symbol_source_available_with_work(report: ProofReport&, trace: ProofFactTrace, symbol_position: Ast::Pos, local: sview, call: Ast::Expr, source_work: mutable usize&) -> bool:
            # `#line` can remap source lines without changing evaluation order. Bind liveness to
            # the exact goal AST position captured by the active certificate, and reject a goal
            # nested inside the call span until that call has completed.
            return false if symbol_position.offset == 0
            consumer: (known: bool, position: Ast::Pos) = proof_replay_local_alias_consumer_position(report, trace.name, source_work)
            return false if not consumer.known
            call_position: Ast::Pos = Ast::expr_pos(call)
            return false if:
                call_position.offset == 0 or call_position.end_offset < call_position.offset
                consumer.position.offset >= call_position.offset and consumer.position.offset < call_position.end_offset
            return true if proof_replay_summary_local_alias_valid_at_with_work(report, trace.name, local, symbol_position, call, consumer.position, source_work)
            return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return proof_replay_result_symbol_loop_preservation_available_at_with_work(report, trace, symbol_position, local, call, consumer.position, source_work)

        # Authenticate the equality that links the source local to the result symbol at the
        # declaration itself. Consumer-line liveness is checked separately when that equality
        # is used as a local fact; the synthetic call result remains meaningful afterward.
        def proof_replay_result_symbol_alias_source_valid(report: ProofReport&, trace: ProofFactTrace, local: sview, symbol: sview, symbol_position: Ast::Pos, call: Ast::Expr) -> bool:
            source_work: mutable usize = 0
            return proof_replay_result_symbol_alias_source_valid_with_work(report, trace, local, symbol, symbol_position, call, &source_work)

        def proof_replay_result_symbol_alias_source_valid_with_work(report: ProofReport&, trace: ProofFactTrace, local: sview, symbol: sview, symbol_position: Ast::Pos, call: Ast::Expr, source_work: mutable usize&) -> bool:
            return false if trace.kind != "local-binding" or trace.name == "" or trace.line != symbol_position.line
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(bound, _), TokenKind.EqEq, Ast::Expr.Ident(value, value_position), _):
                    return false if:
                        bound != local or value != symbol or not proof_replay_source_position_equal(value_position, symbol_position)
                        not proof_replay_summary_raw_call_source_site_with_work(report, trace, call, source_work)
                        source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_replay_summary_local_alias_valid_at_with_work(report, trace.name, local, symbol_position, call, symbol_position, source_work)
                _:
                    return false

        # The declaration a result symbol names: (known, local, local type, call). Unknown when the position
        # is not exactly one declaration of the owner whose initializer is a direct call, or when
        # any binding or summary of the owner uses the symbol other than as that definition.
        def proof_replay_result_symbol_definition(report: ProofReport&, owner: sview, symbol: sview, symbol_position: Ast::Pos) -> (known: bool, local: sview, local_type: Ast::Expr, call: Ast::Expr):
            source_work: mutable usize = 0
            return proof_replay_result_symbol_definition_with_work(report, owner, symbol, symbol_position, &source_work)

        def proof_replay_result_symbol_definition_with_work(report: ProofReport&, owner: sview, symbol: sview, symbol_position: Ast::Pos, source_work: mutable usize&) -> (known: bool, local: sview, local_type: Ast::Expr, call: Ast::Expr):
            return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if:
                owner == "" or not proof_internal_name_is_rebind(symbol) or symbol_position.line == 0
                not proof_replay_mutable_local_owner_preflight_work_charge(report, owner, report.analysis_2.replay_owner_line, source_work)
            body: mutable darray[Ast::Stmt] = []
            return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if:
                not proof_replay_source_owner_body_with_work(report, owner, report.analysis_2.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                not proof_replay_mutable_local_body_work_charge_fail_closed(body, source_work, 0)
            # Definition discovery scans every trace/value for this symbol, then validates the
            # matching alias and summary values. Reserve three complete trace payload passes.
            return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if not proof_replay_mutable_local_trace_work_charge_fail_closed(report, source_work, 3)
            found: mutable usize = 0
            local: mutable sview = ""
            local_type: mutable Ast::Expr = Ast::Expr.Invalid
            call: mutable Ast::Expr = Ast::Expr.Invalid
            return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if not proof_replay_result_symbol_find(body, symbol_position, &found, &local, &local_type, &call, source_work, 0)
            return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if found != 1 or local == "" or not proof_replay_is_call(call)
            alias_found: mutable bool = false
            for candidate in report.analysis_1.traces.records |candidate, report, owner, symbol, symbol_position, local, alias_found, source_work|:
                continue if candidate.name != owner
                continue if candidate.kind != "local-binding" and candidate.kind != "function-summary"
                continue if proof_replay_trace_owner_source_position_line_for_trace_with_work(report, candidate, source_work) != report.analysis_2.replay_owner_line
                if candidate.kind == "local-binding":
                    continue if not proof_expr_mentions_name(candidate.expression, symbol)
                    match candidate.expression:
                        Ast::Expr.Binary(Ast::Expr.Ident(bound, _), TokenKind.EqEq, Ast::Expr.Ident(value, value_position), _):
                            return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if:
                                bound != local or value != symbol or not proof_replay_source_position_equal(value_position, symbol_position) or candidate.line != symbol_position.line
                                not proof_replay_result_symbol_alias_source_valid_with_work(report, candidate, local, symbol, symbol_position, call, source_work)
                            alias_found <- true
                        _:
                            return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid)
                else:
                    return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if candidate.summary_bindings_start > report.analysis_1.traces.summary_values.count or candidate.summary_bindings_count > report.analysis_1.traces.summary_values.count - candidate.summary_bindings_start
                    for offset in 0..<candidate.summary_bindings_count |offset, candidate, report, symbol, symbol_position|:
                        value: Ast::Expr = report.analysis_1.traces.summary_values[candidate.summary_bindings_start + offset]
                        continue if not proof_expr_mentions_name(value, symbol)
                        return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if not proof_replay_literal_rebind_summary_use_valid(value, symbol, symbol_position)
            return (false, "", Ast::Expr.Invalid, Ast::Expr.Invalid) if not alias_found
            return (true, local, local_type, call)

        # `local == symbol` for a result symbol: the definition is valid and the local still holds
        # its call's value at the consumer.
        def proof_replay_local_binding_result_symbol_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            source_work: mutable usize = 0
            return proof_replay_local_binding_result_symbol_source_with_work(report, trace, &source_work)

        def proof_replay_local_binding_result_symbol_source_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(local, local_position), TokenKind.EqEq, Ast::Expr.Ident(symbol, symbol_position), _):
                    return false if:
                        proof_internal_name_is_rebind(local) or not proof_internal_name_is_rebind(symbol)
                        trace.line != symbol_position.line
                    definition = proof_replay_result_symbol_definition_with_work(report, trace.name, symbol, symbol_position, source_work)
                    return false if not definition.known or definition.local != local
                    return proof_replay_summary_local_alias_valid_with_work(report, trace.name, local, symbol_position, definition.call, source_work)
                _:
                    return false

        def proof_replay_is_result_symbol_binding(trace: ProofFactTrace) -> bool:
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(local, _), TokenKind.EqEq, Ast::Expr.Ident(symbol, _), _):
                    return not proof_internal_name_is_rebind(local) and proof_internal_name_is_rebind(symbol)
                _:
                    return false
