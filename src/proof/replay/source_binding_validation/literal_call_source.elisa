# A failed precondition suppresses all postcondition summaries, but passing a
# source literal still defines its fresh parameter symbol. Authenticate that
# definition without using the callee's postconditions or assuming its requires.
extend ElisaProof:
    private:
        def proof_replay_literal_source_slot(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, literal: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_replay_literal_source_slot_with_work(report, trace, call, literal, &work)

        def proof_replay_literal_source_slot_with_work(report: ProofReport&, trace: ProofFactTrace, call: Ast::Expr, literal: Ast::Expr, work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            match call:
                Ast::Expr.Call(_, arguments, argument_names, _):
                    return false if argument_names.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                    work <- work + argument_names.count
                    return false if any label in argument_names where label != ""
                    slots: mutable usize = 0
                    return false if report.analysis_1.executables.summaries.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                    work <- work + report.analysis_1.executables.summaries.count
                    for summary in report.analysis_1.executables.summaries |report, trace, call, arguments, literal, slots, work|:
                        candidate: ProofFactTrace = ProofFactTrace{expression: trace.expression, kernel_expression: 0, kind: "local-binding", line: trace.line, name: trace.name, dependency: summary.name, premises_start: 0, premises_count: 0, kernel_premises_start: 0, kernel_premises_count: 0, summary_bindings_start: 0, summary_bindings_count: 0, summary_requires_start: 0, summary_requires_count: 0, summary_ensure_index: 0, owner_line: summary.line, source_call_position: trace.source_call_position}
                        continue if not proof_replay_summary_owner_matches_call_bounded_with_cache(report, candidate, summary, call, work, &cache)
                        return false if:
                            arguments.count != summary.parameters_count or summary.parameters_start > report.analysis_1.executables.parameters.count or summary.parameters_count > report.analysis_1.executables.parameters.count - summary.parameters_start
                            arguments.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work or summary.parameters_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work - arguments.count
                        work <- work + arguments.count + summary.parameters_count
                        for slot in 0..<arguments.count |report, summary, arguments, literal, slots, work|:
                            argument: Ast::Expr = arguments[slot]
                            continue if not proof_replay_summary_expr_equal_with_work(argument, literal, work) or not proof_replay_local_binding_expr_positions_match(argument, literal)
                            formal: sview = report.analysis_1.executables.parameters[summary.parameters_start + slot]
                            type_result: (complete: bool, type_name: sview) = proof_replay_local_binding_integer_parameter_type_name_with_work(report.source.source_declarations, summary.name, summary.line, formal, work, 0)
                            return false if not type_result.complete
                            type_name: sview = type_result.type_name
                            continue if type_name != "i8" and type_name != "i16" and type_name != "i32" and type_name != "i64"
                            width: i64 = 8 if type_name == "i8" else (16 if type_name == "i16" else (32 if type_name == "i32" else 64))
                            fits: bool = proof_replay_literal_source_fits(literal, width)
                            slots <- slots + 1 if fits
                    return slots == 1
                _:
                    return false

        def proof_replay_literal_direct_call_source(report: ProofReport&, trace: ProofFactTrace, position: Ast::Pos, literal: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_replay_literal_direct_call_source_with_work(report, trace, position, literal, &work)

        def proof_replay_literal_direct_call_source_with_work(report: ProofReport&, trace: ProofFactTrace, position: Ast::Pos, literal: Ast::Expr, work: mutable usize&) -> bool:
            body: mutable darray[Ast::Stmt] = []
            owners: mutable usize = 0
            return false if:
                not proof_replay_local_binding_find_owner_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, &body, &owners, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0) or owners != 1 or trace.line != position.line
                body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + body.count
            matches: mutable usize = 0
            for statement in body |report, trace, position, literal, matches, work|:
                call: Ast::Expr = proof_replay_literal_statement_call(statement)
                continue if not proof_replay_source_position_equal(Ast::expr_pos(call), position)
                matches <- matches + 1 if proof_replay_literal_source_slot_with_work(report, trace, call, literal, work)
            return matches == 1

        def proof_replay_literal_statement_call(statement: Ast::Stmt) -> Ast::Expr:
            match statement:
                Ast::Stmt.Return(value, _):
                    return expression if value is expression
                Ast::Stmt.VarDecl(_, _, initializer, _):
                    return initializer
                Ast::Stmt.Expr(expression, _):
                    return expression
                _:
                    pass
            return Ast::Expr.Invalid

        def proof_replay_literal_source_fits(literal: Ast::Expr, width: i64) -> bool:
            return false if width <= 0 or width > 64
            match literal:
                Ast::Expr.IntLit(value, _):
                    return false if value < 0
                    return true if width == 64
                    limit: i64 = 1 << (width - 1)
                    return value < limit
                Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(value, _), _):
                    return false if value < 0
                    return true if width == 64
                    limit: i64 = 1 << (width - 1)
                    return value <= limit
                _:
                    return false
