# Mutable locals captured by a for statement have their initial equality at
# each original invariant entry. No initial equality is granted at preservation.
extend ElisaProof:
    private:
        def proof_replay_mutable_for_invariant(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, statement: Ast::Stmt, target: sview, source_work: mutable usize&) -> bool:
            match statement:
                Ast::Stmt.For(bind, variables, iterable, body, position):
                    return false if:
                        bind != "" or variables.count != 1 or variables[0] == target or position.line != certificate.line
                        not proof_replay_summary_expr_charge_with_work(iterable, source_work)
                        not proof_replay_summary_expr_charge_with_work(iterable, source_work)
                        proof_expr_has_call(iterable) or proof_source_expression_has_overloaded_operator(iterable, report.source.source_primitive_operator_mask, 0)
                    matching: mutable usize = 0
                    for member in body |report, trace, certificate, matching, target, source_work|:
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        source_work <- source_work + 1
                        match member:
                            Ast::Stmt.VarDecl(local, _, _, _):
                                return false if local == target
                            Ast::Stmt.Contract("invariant", expression, _):
                                expected: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, expression, source_work, 0)
                                matching <- matching + 1 if proof_replay_summary_expr_equal_with_work(expected, certificate.goal, source_work) and proof_replay_captured_entry_position(expression, certificate.goal)
                            _:
                                pass
                    return matching == 1
                Ast::Stmt.Expr(Ast::Expr.Block(statements, value, captures, _), _):
                    return false if statements.count != 1
                    capture_count: mutable usize = 0
                    for capture in captures |target, capture_count|:
                        capture_count <- capture_count + 1 if capture == target
                    return false if capture_count != 1
                    match value:
                        Ast::Expr.Invalid:
                            pass
                        _:
                            return false
                    match statements[0]:
                        Ast::Stmt.For(_, _, _, _, _):
                            return proof_replay_mutable_for_invariant(report, trace, certificate, statements[0], target, source_work)
                        _:
                            return false
                _:
                    return false

        def proof_replay_mutable_for_initial_value_with_work(report: ProofReport&, trace: ProofFactTrace, expression: Ast::Expr, source_work: mutable usize&) -> bool:
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.analysis_2.replay_owner_line, source_work)
                    return proof_replay_local_binding_parameter_source_unshadowed_at_offset_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, source_work) and proof_replay_local_binding_immutable_integer_parameter_at_offset_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, name, source_work, 0)
                _:
                    return false

        def proof_replay_mutable_for_entry_source(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count or report.analysis_2.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                certificate.name != trace.name or certificate.rule != "goal" or certificate.line != report.analysis_2.trace_owner_line
                not proof_replay_captured_entry_no_loop_facts(report, certificate, source_work)
                not proof_replay_captured_entry_environment_with_source_work(report.source.source_declarations, source_work)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(target, target_position), TokenKind.EqEq, source_value, _):
                    return false if:
                        target == "" or proof_internal_name_is_rebind(target)
                        proof_replay_local_binding_parameter_name_present_with_default_limit(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, target, source_work, 0)
                    context = ElisaProofFrameSource::owner(&report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line)
                    return false if not context.known or context.body.count > 4096
                    declarations: mutable usize = 0
                    for member in context.body |target, declarations, source_work|:
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        source_work <- source_work + 1
                        match member:
                            Ast::Stmt.VarDecl(local, _, _, _):
                                declarations <- declarations + 1 if local == target
                            _:
                                pass
                    return false if declarations != 1
                    initialized: mutable bool = false
                    for member in context.body |report, trace, certificate, target, target_position, source_value, initialized, source_work|:
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        source_work <- source_work + 1
                        if proof_replay_mutable_for_invariant(report, trace, certificate, member, target, source_work):
                            return initialized
                        match member:
                            Ast::Stmt.VarDecl(local, type_expression, initializer, position):
                                normalized: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, initializer, source_work, 0)
                                if local == target:
                                    return false if:
                                        position.line != trace.line or not proof_replay_local_binding_pos_matches(trace.expression, position) or not proof_replay_local_binding_pos_matches(Ast::Expr.Ident(target, target_position), position)
                                        not proof_replay_local_binding_integer_type(type_expression, 0) or not proof_replay_local_binding_mutable_integer_type(type_expression)
                                        not proof_replay_summary_expr_equal_with_work(normalized, source_value, source_work) or not proof_replay_mutable_for_initial_value_with_work(report, trace, normalized, source_work)
                                    initialized <- true
                                elif initialized:
                                    # Later declarations cannot write or alias the captured scalar.
                                    return false if:
                                        not proof_replay_local_binding_integer_type(type_expression, 0) or not proof_replay_mutable_for_initial_value_with_work(report, trace, normalized, source_work)
                                        not proof_replay_summary_expr_charge_with_work(initializer, source_work)
                                        proof_source_expression_has_overloaded_operator(initializer, report.source.source_primitive_operator_mask, 0)
                            _:
                                return false if initialized
                    return false
                _:
                    return false
