# Certificates at a loop header's line check the invariant on entry, the invariant's preservation
# by one iteration, or what holds after the loop. Only the first may read a binding made before
# the loop: inside or after it the body may have changed the local. A missing guard, invariant or
# range fact is not evidence of an entry check (a forged certificate could omit them), so replay
# identifies an entry check positively:
#   - the certificate carries no loop-condition, loop-invariant or loop-range fact at that line;
#   - its goal is one of the source invariants of the unique loop on that line, matched as call
#     arguments are (global constants may appear by value, rebind symbols by their source local).
# An ensure that happens to spell an invariant is harmless here: that invariant holds after the
# loop too, because its entry and preservation are checked by their own certificates.
extend ElisaProof:
    private:
        # Per-query costs for the legacy immutable-local check and its preflight sizing walk.
        const PROOF_REPLAY_LOOP_ENTRY_LOCAL_QUERY_COMPARISONS: usize = 2
        const PROOF_REPLAY_LOOP_ENTRY_SIZING_STATEMENT_COST: usize = 1
        const PROOF_REPLAY_LOOP_ENTRY_SIZING_NAME_COMPARISONS: usize = 1
        const PROOF_REPLAY_LOOP_ENTRY_TYPE_PREDICATE_WALKS: usize = 2
        const PROOF_REPLAY_LOOP_ENTRY_DECLARATION_SCAN_MULTIPLIER: usize = 12
        const PROOF_REPLAY_LOOP_ENTRY_LOCAL_AST_SCAN_MULTIPLIER: usize = 8
        # The stable-parameter classifier performs two type predicates and, when needed,
        # the integer-layer query: at most four type-AST walks per queried formal.
        const PROOF_REPLAY_LOOP_ENTRY_TYPE_AST_QUERY_MULTIPLIER: usize = 4

        # Signed locals may be expanded to their initializer in an entry goal.
        # Reconstruct that expansion from an effect-free source prefix only;
        # unsigned locals keep their names and their separately replayed bindings.
        def proof_replay_loop_entry_expansion_work_charge_product(work: mutable usize&, count: usize, cost: usize, work_limit: usize) -> bool:
            return false if work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or work > work_limit
            if count != 0 and cost > (work_limit - work) / count:
                work <- work_limit
                return false
            work <- work + count * cost
            true

        # Reuse the detailed legacy-query reservation while preserving this caller's
        # possibly smaller CONTROL budget. Offset the helper's global meter so its
        # remaining allowance equals `work_limit - source_work`, then merge the
        # charged delta back into the shared counter.
        def proof_replay_loop_entry_single_declaration_with_limit(report: ProofReport&, body: darray[Ast::Stmt]&, name: sview, source_work: mutable usize&, work_limit: usize) -> bool:
            return false if work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or source_work > work_limit
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, 1, work_limit)
            virtual_seed: usize = source_work + (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work_limit)
            virtual_work: mutable usize = virtual_seed
            single_declaration: bool = proof_replay_source_single_declaration_with_work(report.source_declarations, body, name, &virtual_work)
            if virtual_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or virtual_work < virtual_seed:
                source_work <- work_limit
                return false
            query_work: usize = virtual_work - virtual_seed
            if query_work > work_limit - source_work:
                source_work <- work_limit
                return false
            source_work <- source_work + query_work
            single_declaration

        # Reserve a stable-name body query without running its legacy semantic visitor.
        # The virtual offset narrows the shared query helper to this caller's budget.
        def proof_replay_loop_entry_touch_query_with_limit(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, writes: bool, source_work: mutable usize&, work_limit: usize) -> bool:
            return false if work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or source_work > work_limit
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, 1, work_limit)
            virtual_seed: usize = source_work + (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work_limit)
            virtual_work: mutable usize = virtual_seed
            query_complete: bool = proof_replay_source_touch_query_reserve(declarations, body, name, writes, &virtual_work)
            if virtual_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or virtual_work < virtual_seed:
                source_work <- work_limit
                return false
            query_work: usize = virtual_work - virtual_seed
            if query_work > work_limit - source_work:
                source_work <- work_limit
                return false
            source_work <- source_work + query_work
            query_complete

        # Charge only the formal type ASTs reached by this identifier query. The caller has
        # already reserved the bounded declaration/name scan; this helper adds the exact type
        # traversal cost and combines duplicate formal names conservatively.
        def proof_replay_loop_entry_owner_parameter_type_cost(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, declaration_work: usize, source_work: mutable usize&, parameter_type_work: mutable usize&, matches: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or source_work > work_limit
            # Precharge the full declaration/name/formal scan before searching the owner.
            if depth == 0:
                return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, declaration_work, work_limit)
            for declaration in declarations |owner, owner_line, parameter_name, declaration_work, source_work, parameter_type_work, matches, work_limit, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        if name == owner and position.line == owner_line:
                            for parameter in parameters |parameter_name, source_work, parameter_type_work, matches, work_limit|:
                                return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, sview_len(parameter.name), work_limit)
                                return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, sview_len(parameter_name), work_limit)
                                return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, PROOF_REPLAY_LOOP_ENTRY_SIZING_NAME_COMPARISONS, work_limit)
                                if parameter.name == parameter_name:
                                    before_type: usize = source_work
                                    return false if not proof_replay_summary_expr_charge_with_limit(parameter.type_expression, source_work, work_limit)
                                    parameter_type_work <- parameter_type_work + source_work - before_type
                                    matches <- matches + 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_loop_entry_owner_parameter_type_cost(nested, owner, owner_line, parameter_name, declaration_work, source_work, parameter_type_work, matches, work_limit, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_loop_entry_reserve_stable_identifier(name: sview, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_body: darray[Ast::Stmt]&, target: sview, declaration_work: usize, replay_parameter_type_work: mutable usize&, source_work: mutable usize&, work_limit: usize) -> bool:
            return true if name == ""
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, declaration_work, work_limit)
            parameter: bool = proof_replay_local_binding_parameter_name_present_with_work(declarations, owner, owner_line, name, source_work, work_limit, 0)
            if parameter:
                parameter_type_work: mutable usize = 0
                parameter_matches: mutable usize = 0
                return false if not proof_replay_loop_entry_owner_parameter_type_cost(declarations, owner, owner_line, name, declaration_work, source_work, &parameter_type_work, &parameter_matches, work_limit, 0)
                return false if parameter_matches == 0
                return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, parameter_type_work, PROOF_REPLAY_LOOP_ENTRY_TYPE_AST_QUERY_MULTIPLIER, work_limit)
                replay_parameter_type_work <- replay_parameter_type_work + parameter_type_work
                return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, declaration_work, work_limit)
                immutable_integer: bool = proof_replay_local_binding_immutable_integer_parameter_with_work(declarations, owner, owner_line, name, source_work, 0)
                return false if not proof_replay_loop_entry_touch_query_with_limit(declarations, owner_body, name, false, source_work, work_limit)
                return true if immutable_integer
                layer_matches: mutable usize = 0
                parameter_type: mutable sview = ""
                return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, declaration_work, work_limit)
                proof_replay_local_binding_parameter_integer_layers(declarations, owner, owner_line, name, &layer_matches, &parameter_type, 0)
                if layer_matches == 1 and parameter_type != "":
                    return proof_replay_loop_entry_touch_query_with_limit(declarations, owner_body, name, true, source_work, work_limit)
                return true
            name_bytes: usize = sview_len(name)
            target_bytes: usize = sview_len(target)
            return false if name_bytes >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - PROOF_REPLAY_LOOP_ENTRY_LOCAL_QUERY_COMPARISONS
            return false if target_bytes >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - name_bytes - PROOF_REPLAY_LOOP_ENTRY_LOCAL_QUERY_COMPARISONS
            # Each VarDecl compares its spelling with both `name` and `target`.
            compare_cost: usize = name_bytes + target_bytes + PROOF_REPLAY_LOOP_ENTRY_LOCAL_QUERY_COMPARISONS
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, owner_body.count, compare_cost, work_limit)
            # `prior_immutable_local` also compares every stored VarDecl name with both
            # query names. Include those bytes per candidate; query-name lengths alone
            # under-reserve bodies containing long local identifiers.
            # This cost-inspection pass traverses the statements once as well.
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, owner_body.count, PROOF_REPLAY_LOOP_ENTRY_SIZING_STATEMENT_COST, work_limit)
            for statement in owner_body |statement, source_work, work_limit, name_bytes|:
                match statement:
                    Ast::Stmt.VarDecl(local, type_expression, _, _):
                        local_name_bytes: usize = sview_len(local)
                        return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, PROOF_REPLAY_LOOP_ENTRY_LOCAL_QUERY_COMPARISONS, local_name_bytes, work_limit)
                        # The sizing pass compares the local against `name` to decide
                        # whether the legacy query will inspect its type.
                        return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, PROOF_REPLAY_LOOP_ENTRY_SIZING_NAME_COMPARISONS, name_bytes, work_limit)
                        return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, PROOF_REPLAY_LOOP_ENTRY_SIZING_NAME_COMPARISONS, local_name_bytes, work_limit)
                        return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, PROOF_REPLAY_LOOP_ENTRY_SIZING_NAME_COMPARISONS, PROOF_REPLAY_LOOP_ENTRY_SIZING_NAME_COMPARISONS, work_limit)
                        if local == name:
                            # The semantic query checks both integer-ness and mutability
                            # for every same-named declaration, including duplicates.
                            for _ in 0..<PROOF_REPLAY_LOOP_ENTRY_TYPE_PREDICATE_WALKS |type_expression, source_work, work_limit|:
                                return false if not proof_replay_summary_expr_charge_with_limit(type_expression, source_work, work_limit)
                    _:
                        pass
            true

        # The stable initializer can ask whether each identifier is shadowed and
        # whether a mutable parameter is written. Reserve only the paths its source
        # binding can take, including call-slot/declaration work for mutable parameters.
        def proof_replay_loop_entry_reserve_stable_name_queries(expression: Ast::Expr, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_body: darray[Ast::Stmt]&, target: sview, declaration_work: usize, replay_parameter_type_work: mutable usize&, replay_index_copy_type_work: mutable usize&, source_work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, 1, work_limit)
            match expression:
                Ast::Expr.Ident(name, _):
                    return true if name == target
                    return proof_replay_loop_entry_reserve_stable_identifier(name, declarations, owner, owner_line, owner_body, target, declaration_work, replay_parameter_type_work, source_work, work_limit)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Minus, inner, _) | Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_replay_loop_entry_reserve_stable_name_queries(inner, declarations, owner, owner_line, owner_body, target, declaration_work, replay_parameter_type_work, replay_index_copy_type_work, source_work, work_limit, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return false if not proof_replay_loop_entry_reserve_stable_name_queries(left, declarations, owner, owner_line, owner_body, target, declaration_work, replay_parameter_type_work, replay_index_copy_type_work, source_work, work_limit, depth + 1)
                    return proof_replay_loop_entry_reserve_stable_name_queries(right, declarations, owner, owner_line, owner_body, target, declaration_work, replay_parameter_type_work, replay_index_copy_type_work, source_work, work_limit, depth + 1)
                Ast::Expr.If(condition, then_value, else_value, _):
                    return false if not proof_replay_loop_entry_reserve_stable_name_queries(condition, declarations, owner, owner_line, owner_body, target, declaration_work, replay_parameter_type_work, replay_index_copy_type_work, source_work, work_limit, depth + 1)
                    return false if not proof_replay_loop_entry_reserve_stable_name_queries(then_value, declarations, owner, owner_line, owner_body, target, declaration_work, replay_parameter_type_work, replay_index_copy_type_work, source_work, work_limit, depth + 1)
                    return proof_replay_loop_entry_reserve_stable_name_queries(else_value, declarations, owner, owner_line, owner_body, target, declaration_work, replay_parameter_type_work, replay_index_copy_type_work, source_work, work_limit, depth + 1)
                Ast::Expr.Index(Ast::Expr.Ident(name, _), Ast::Expr.IntLit(index, _), _):
                    return true if index < 0
                    parameter_type_work: mutable usize = 0
                    parameter_matches: mutable usize = 0
                    return false if not proof_replay_loop_entry_owner_parameter_type_cost(declarations, owner, owner_line, name, declaration_work, source_work, &parameter_type_work, &parameter_matches, work_limit, 0)
                    # The replay-side index-copy check walks each matching formal type once
                    # through `proof_replay_index_copy_element` (bounded to 32 wrappers).
                    replay_index_copy_type_work <- replay_index_copy_type_work + parameter_type_work
                    proof_replay_loop_entry_touch_query_with_limit(declarations, owner_body, name, false, source_work, work_limit)
                Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(name, _), method, _), arguments, _, _):
                    return true if arguments.count != 0 or (method != "i8" and method != "i16" and method != "i32" and method != "i64" and method != "isize" and method != "u8" and method != "u16" and method != "u32" and method != "u64" and method != "usize")
                    return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, declaration_work, work_limit)
                    return true if proof_replay_local_binding_cast_hook_present(declarations, 0)
                    proof_replay_loop_entry_reserve_stable_identifier(name, declarations, owner, owner_line, owner_body, target, declaration_work, replay_parameter_type_work, source_work, work_limit)
                _:
                    pass
            return true

        def proof_replay_loop_entry_expansion_reserve(report: ProofReport&, owner: sview, body: darray[Ast::Stmt]&, owner_body: darray[Ast::Stmt]&, invariant: Ast::Expr, goal: Ast::Expr, source_work: mutable usize&, work_limit: usize) -> bool:
            return false if body.count > 4096 or source_work > work_limit or work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            invariant_start: usize = source_work
            return false if not proof_replay_summary_expr_charge_with_limit(invariant, source_work, work_limit)
            invariant_work: usize = source_work - invariant_start
            return false if not proof_replay_summary_expr_charge_with_limit(goal, source_work, work_limit)
            declaration_seed: usize = PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - (work_limit - source_work)
            declaration_work: mutable usize = declaration_seed
            declaration_scan_complete: bool = proof_replay_deterministic_declaration_scan_charge(report.source_declarations, &declaration_work, 0)
            declaration_scan_work: usize = declaration_work - declaration_seed
            return false if declaration_scan_work > work_limit - source_work
            source_work <- source_work + declaration_scan_work
            return false if not declaration_scan_complete
            declaration_work <- declaration_scan_work
            local_count: mutable usize = 0
            local_name_work: mutable usize = 0
            local_ast_work: mutable usize = 0
            replay_parameter_type_work: mutable usize = 0
            replay_index_copy_type_work: mutable usize = 0
            for statement in body |statement, report, owner, source_work, local_count, local_name_work, local_ast_work, owner_body, declaration_work, replay_parameter_type_work, replay_index_copy_type_work, work_limit|:
                return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, 1, work_limit)
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, initializer, _):
                        local_count <- local_count + 1
                        return false if not proof_replay_loop_entry_expansion_work_charge_product(&local_name_work, 1, sview_len(name), work_limit)
                        before_type: usize = source_work
                        return false if not proof_replay_summary_expr_charge_with_limit(type_expression, source_work, work_limit)
                        local_ast_work <- local_ast_work + source_work - before_type
                        before_initializer: usize = source_work
                        return false if not proof_replay_summary_expr_charge_with_limit(initializer, source_work, work_limit)
                        local_ast_work <- local_ast_work + source_work - before_initializer
                        return false if not proof_replay_loop_entry_reserve_stable_name_queries(initializer, report.source_declarations, owner, report.replay_owner_line, owner_body, name, declaration_work, replay_parameter_type_work, replay_index_copy_type_work, source_work, work_limit, 0)
                    _:
                        pass
            # Reserve the second set of at-most-four type-AST walks performed by the later
            # stable-initializer replay; the matching-formal helper above charged preflight.
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, replay_parameter_type_work, PROOF_REPLAY_LOOP_ENTRY_TYPE_AST_QUERY_MULTIPLIER, work_limit)
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, replay_index_copy_type_work, 1, work_limit)
            # The later stable-initializer walk visits the same local AST once.
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, local_ast_work, work_limit)
            # The later prefix scan in `expanded_goal` runs once even when there
            # are no local candidates for the per-local reservation to cover.
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, body.count, work_limit)
            per_local_scan_work: mutable usize = 0
            return false if not proof_replay_loop_entry_expansion_work_charge_product(&per_local_scan_work, declaration_work, PROOF_REPLAY_LOOP_ENTRY_DECLARATION_SCAN_MULTIPLIER, work_limit)
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, local_count, per_local_scan_work, work_limit)
            return false if local_ast_work > work_limit / PROOF_REPLAY_LOOP_ENTRY_LOCAL_AST_SCAN_MULTIPLIER
            return false if not proof_replay_loop_entry_expansion_work_charge_product(source_work, declaration_work, local_ast_work * PROOF_REPLAY_LOOP_ENTRY_LOCAL_AST_SCAN_MULTIPLIER, work_limit)
            substitution_work: mutable usize = 0
            return false if not proof_replay_loop_entry_expansion_work_charge_product(&substitution_work, invariant_work, local_count, work_limit)
            return false if not proof_replay_loop_entry_expansion_work_charge_product(&substitution_work, invariant_work, local_name_work, work_limit)
            proof_replay_loop_entry_expansion_work_charge_product(source_work, 1, substitution_work, work_limit)

        def proof_replay_loop_entry_expanded_goal(report: mutable ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, owner_body: darray[Ast::Stmt]&, invariant: Ast::Expr) -> bool:
            work: mutable usize = 0
            proof_replay_loop_entry_expanded_goal_with_work(report, trace, certificate, body, owner_body, invariant, &work)

        def proof_replay_loop_entry_expanded_goal_with_work(report: mutable ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, owner_body: darray[Ast::Stmt]&, invariant: Ast::Expr, source_work: mutable usize&) -> bool:
            proof_replay_loop_entry_expanded_goal_with_limit(report, trace, certificate, body, owner_body, invariant, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_replay_loop_entry_expanded_goal_with_limit(report: mutable ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, owner_body: darray[Ast::Stmt]&, invariant: Ast::Expr, source_work: mutable usize&, work_limit: usize) -> bool:
            return false if proof_replay_summary_has_unresolved_import(report.source_annotations, source_work, work_limit)
            return false if proof_replay_summary_has_unresolved_declaration_import(report.source_declarations, source_work, work_limit, 0)
            return false if not proof_replay_loop_entry_expansion_reserve(report, trace.name, body, owner_body, invariant, certificate.goal, source_work, work_limit)
            names: mutable darray[sview] = []
            values: mutable darray[Ast::Expr] = []
            found: mutable bool = false
            return false if not ElisaProofFrameSource::index_copy_environment(report.source_declarations)
            for statement in body |report, trace, certificate, body, names, values, found, source_work|:
                position: Ast::Pos = proof_replay_statement_position(statement)
                if position.line == certificate.line:
                    match statement:
                        Ast::Stmt.While(_, _, _) | Ast::Stmt.For(_, _, _, _, _):
                            found <- true
                            break
                        _:
                            return false
                return false if position.line > certificate.line
                match statement:
                    Ast::Stmt.Contract(kind, _, _):
                        return false if kind != "requires" and kind != "ensure" and kind != "ensures"
                    Ast::Stmt.VarDecl(name, type_expression, initializer, _):
                        return false if not proof_replay_local_binding_integer_type(type_expression, 0)
                        type_name: sview = proof_replay_local_binding_reference_integer_name(type_expression, 0)
                        return false if type_name == "" or not proof_replay_loop_entry_single_declaration_with_limit(report, body, name, source_work, work_limit)
                        return false if proof_replay_local_binding_parameter_name_present_with_work(report.source_declarations, trace.name, report.replay_owner_line, name, source_work, work_limit, 0)
                        scalar_work: mutable usize = 0
                        return false if not proof_replay_scalar_copy_type_unshadowed(report.source_declarations, type_name, 0, &scalar_work)
                        pure: mutable bool = proof_replay_local_binding_stable_initializer_with_limit(initializer, name, report.source_declarations, trace.name, report.replay_owner_line, source_work, 0, work_limit)
                        match initializer:
                            Ast::Expr.Index(Ast::Expr.Ident(receiver, _), Ast::Expr.IntLit(at, _), _):
                                return false if at < 0 or not proof_replay_local_binding_parameter_source_unshadowed_with_limit(report.source_declarations, trace.name, report.replay_owner_line, receiver, source_work, work_limit)
                                context = ElisaProofFrameSource::owner(&report.source_declarations, trace.name, report.replay_owner_line)
                                matches: mutable usize = 0
                                for index in 0..<context.formals.count |context, receiver, type_name, matches|:
                                    matches <- matches + 1 if context.formals[index] == receiver and proof_replay_index_copy_element(context.formal_types[index], 0) == type_name
                                pure <- matches == 1
                            _:
                                pass
                        # The overloaded-operator classifier is a separate recursive
                        # traversal after the stable-initializer proof above.
                        return false if not proof_replay_summary_expr_charge_with_limit(initializer, source_work, work_limit)
                        return false if not pure or proof_source_expression_has_overloaded_operator(initializer, report.source_primitive_operator_mask, 0)
                        if proof_replay_local_binding_unsigned_type_name(type_expression, 0) == "":
                            names.push(name)
                            values.push(initializer)
                    _:
                        return false
            return false if not found or names.count == 0
            expanded: Ast::Expr = proof_replay_substitute_many(invariant, names, values)
            complete: mutable bool = true
            proof_replay_summary_call_argument_equal_with_work(report, trace, expanded, certificate.goal, 0, source_work, &complete, 0) and complete

        def proof_replay_loop_entry_invariants(statements: darray[Ast::Stmt]&, line: u32, invariants: mutable darray[Ast::Expr]&, loops: mutable usize&, nested: bool) -> void:
            for statement in statements |line, invariants, loops, nested|:
                match statement:
                    Ast::Stmt.While(_, body, position) | Ast::Stmt.For(_, _, _, body, position):
                        if position.line == line:
                            loops <- loops + 1
                            for inner in body |invariants|:
                                match inner:
                                    Ast::Stmt.Contract(kind, expression, _):
                                        invariants.push(expression) if kind == "invariant"
                                    _:
                                        pass
                    Ast::Stmt.Expr(block, _) | Ast::Stmt.Return(block, _) | Ast::Stmt.VarDecl(_, _, block, _):
                        if not nested:
                            match proof_replay_source_unwrap_empty_value_block(block, 0):
                                Ast::Expr.Block(inner, _, _, _):
                                    proof_replay_loop_entry_invariants(inner, line, invariants, loops, true)
                                _:
                                    pass
                    _:
                        pass

        def proof_replay_loop_entry_certificate(report: mutable ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            proof_replay_loop_entry_certificate_with_work(report, trace, &work)

        def proof_replay_loop_entry_certificate_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line
            return false if certificate.facts_start > report.traces.origin_indices.count or certificate.facts_count > report.traces.origin_indices.count - certificate.facts_start
            for index in 0..<certificate.facts_count |index, certificate, report, source_work|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                trace_index: usize = report.traces.origin_indices[certificate.facts_start + index]
                continue if trace_index >= report.traces.records.count
                candidate: ProofFactTrace = report.traces.records[trace_index]
                if candidate.line == certificate.line and (candidate.kind == "loop-condition" or candidate.kind == "loop-invariant" or candidate.kind == "loop-range"):
                    return false
            body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            condition: mutable Ast::Expr = Ast::Expr.Invalid
            loop_body: mutable darray[Ast::Stmt] = []
            lexical_body: mutable darray[Ast::Stmt] = []
            return false if not proof_replay_loop_scope_with_work(body, certificate.line, &condition, &loop_body, &lexical_body, source_work)
            complete: mutable bool = true
            for statement in loop_body |report, trace, certificate, lexical_body, source_work, complete|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Contract("invariant", invariant, _):
                        return true if proof_replay_summary_call_argument_equal_with_work(report, trace, invariant, certificate.goal, 0, source_work, &complete, 0) and complete
                        return false if not complete
                        return true if proof_replay_loop_entry_expanded_goal_with_work(report, trace, certificate, lexical_body, body, invariant, source_work)
                    _:
                        pass
            false
