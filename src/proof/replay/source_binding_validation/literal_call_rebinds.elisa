include "./literal_call_source.elisa"
# Literal arguments to a typed call are represented by fresh proof symbols (`fresh == literal`).
# The symbol is a definition, so replay must establish that it has exactly one: the producer
# draws it from a per-function pool, and two traces giving one symbol two values would let the
# kernel derive `5 == 7`. A binding is accepted only when
#   - it is reconstructed from the exact source call and callee parameter slot at its own line;
#   - its owner function is the certificate's owner function;
#   - no other local-binding trace of that function binds the symbol to another value, site or
#     line, and no function summary of that function uses the symbol anywhere but as this
#     call's own parameter value at this site.
# The symbol's pool index is not otherwise reconstructed: once the definition is unique within
# the function, the index carries no meaning, and any second definition is refused above.
extend ElisaProof:
    private:
        # A summary value may mention the symbol only as this call's exact parameter value.
        def proof_replay_literal_rebind_summary_use_valid(value: Ast::Expr, symbol: sview, symbol_position: Ast::Pos) -> bool:
            return true if not proof_expr_mentions_name(value, symbol)
            match value:
                Ast::Expr.Ident(name, position):
                    return name == symbol and proof_replay_source_position_equal(position, symbol_position)
                _:
                    return false

        def proof_replay_literal_rebind_unique(report: ProofReport&, trace: ProofFactTrace, symbol: sview, symbol_position: Ast::Pos, literal: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_replay_rebind_definition_unique_with_work(report, trace, symbol, symbol_position, literal, false, &work)

        # Separate loop preservation and decreases checks can instantiate the same assignment
        # with distinct fresh names. The loop source route has already reconstructed its exact
        # value and span; identical definitions remain aliases of that iteration-start value.
        # Other callers retain the single-symbol rule, and conflicting definitions or uses of
        # the requested symbol are refused in both modes.
        def proof_replay_rebind_definition_unique(report: ProofReport&, trace: ProofFactTrace, symbol: sview, symbol_position: Ast::Pos, literal: Ast::Expr, allow_loop_alias: bool) -> bool:
            work: mutable usize = 0
            return proof_replay_rebind_definition_unique_with_work(report, trace, symbol, symbol_position, literal, allow_loop_alias, &work)

        def proof_replay_rebind_definition_unique_with_work(report: ProofReport&, trace: ProofFactTrace, symbol: sview, symbol_position: Ast::Pos, literal: Ast::Expr, allow_loop_alias: bool, work: mutable usize&) -> bool:
            owner_line: u32 = proof_replay_trace_owner_source_position_line_for_trace_with_work(report, trace, work)
            return false if owner_line == 0 or owner_line != report.replay_owner_line
            for candidate in report.traces.records |candidate, report, trace, symbol, symbol_position, literal, owner_line, allow_loop_alias, work|:
                return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                work <- work + 1
                continue if candidate.name != trace.name
                continue if candidate.kind != "local-binding" and candidate.kind != "function-summary"
                candidate_owner_line: u32 = proof_replay_trace_owner_source_position_line_for_trace_with_work(report, candidate, work)
                return false if candidate_owner_line == 0
                continue if candidate_owner_line != owner_line
                if candidate.kind == "local-binding":
                    # One source definition cannot acquire a second reserved symbol
                    # merely by appending an otherwise identical binding trace.
                    match candidate.expression:
                        Ast::Expr.Binary(Ast::Expr.Ident(other, other_position), TokenKind.EqEq, other_value, _):
                            if not allow_loop_alias and proof_internal_name_is_rebind(symbol) and other != symbol and proof_internal_name_is_rebind(other) and candidate.line == trace.line and proof_replay_source_position_equal(other_position, symbol_position) and proof_replay_summary_expr_equal_with_work(other_value, literal, work) and proof_replay_local_binding_expr_positions_match(other_value, literal):
                                return false
                        _:
                            pass
                    return false if not proof_replay_summary_expr_charge_with_work(candidate.expression, work)
                    continue if not proof_expr_mentions_name(candidate.expression, symbol)
                    # Every binding that mentions the symbol must be this very definition.
                    return false if candidate.line != trace.line
                    match candidate.expression:
                        Ast::Expr.Binary(Ast::Expr.Ident(bound, bound_position), TokenKind.EqEq, value, _):
                            return false if bound != symbol or not proof_replay_source_position_equal(bound_position, symbol_position)
                            return false if not proof_replay_summary_expr_equal_with_work(value, literal, work) or not proof_replay_local_binding_expr_positions_match(value, literal)
                        _:
                            return false
                else:
                    return false if candidate.summary_bindings_start > report.traces.summary_values.count or candidate.summary_bindings_count > report.traces.summary_values.count - candidate.summary_bindings_start
                    return false if candidate.summary_bindings_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                    work <- work + candidate.summary_bindings_count
                    for offset in 0..<candidate.summary_bindings_count |offset, candidate, report, trace, symbol, symbol_position, work|:
                        value: Ast::Expr = report.traces.summary_values[candidate.summary_bindings_start + offset]
                        # The symbol's position is its call's span, which pins the site even when
                        # a restated summary is recorded at a multi-line statement's first line.
                        return false if not proof_replay_summary_expr_charge_with_work(value, work)
                        continue if not proof_expr_mentions_name(value, symbol)
                        return false if not proof_replay_literal_rebind_summary_use_valid(value, symbol, symbol_position)
            return true

        def proof_replay_local_binding_literal_call_argument_source(report: mutable ProofReport&, trace: ProofFactTrace) -> bool:
            return proof_replay_local_binding_literal_call_argument_source_at(report, trace, 0)

        # Reconstruct the binding from the exact source call and the callee parameter slot instead
        # of trusting an internal-name equality from the producer. This accepts only a unique
        # direct call at the binding's source span, with one literal argument that is recorded
        # for exactly one formal parameter in that call's summary.
        def proof_replay_local_binding_literal_call_argument_source_at(report: mutable ProofReport&, trace: ProofFactTrace, rebind_depth: usize) -> bool:
            work: mutable usize = 0
            return proof_replay_local_binding_literal_call_argument_source_at_with_work(report, trace, rebind_depth, &work)

        def proof_replay_local_binding_literal_call_argument_source_at_with_work(report: mutable ProofReport&, trace: ProofFactTrace, rebind_depth: usize, work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_local_binding_literal_call_argument_source_at_with_cache(report, trace, rebind_depth, work, &cache)

        def proof_replay_local_binding_literal_call_argument_source_at_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, rebind_depth: usize, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if trace.name == "" or trace.line == 0
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, literal, _):
                    return false if not proof_internal_name_is_rebind(symbol) or not proof_replay_literal_value(literal)
                    return false if not proof_replay_rebind_definition_unique_with_work(report, trace, symbol, symbol_position, literal, false, work)
                    accepted_bindings: mutable usize = 0
                    accepted_call: mutable Ast::Expr = Ast::Expr.Invalid
                    for candidate_index in 0..<report.traces.records.count |candidate_index, report, trace, symbol, literal, accepted_bindings, accepted_call, rebind_depth, work, cache|:
                        candidate: ProofFactTrace = report.traces.records[candidate_index]
                        return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        work <- work + 1
                        continue if candidate.kind != "function-summary" or candidate.name != trace.name or candidate.line != trace.line
                        continue if candidate.summary_bindings_start > report.traces.summary_values.count or candidate.summary_bindings_count > report.traces.summary_values.count - candidate.summary_bindings_start
                        continue if candidate.summary_bindings_start > report.traces.summary_names.count or candidate.summary_bindings_count > report.traces.summary_names.count - candidate.summary_bindings_start
                        continue if candidate.summary_bindings_count == 0
                        summary_found: mutable bool = false
                        summary: mutable ProofExecutableSummary = ProofExecutableSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, pure: false, verified: false, verification_reason: ""}
                        return false if report.executables.summaries.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + report.executables.summaries.count
                        for executable in report.executables.summaries |executable, candidate, summary_found, summary|:
                            if executable.name == candidate.dependency and (candidate.owner_line == 0 or executable.line == candidate.owner_line):
                                return false if summary_found
                                summary_found <- true
                                summary <- executable
                        continue if not summary_found or summary.parameters_count == 0 or summary.parameters_start > report.executables.parameters.count or summary.parameters_count > report.executables.parameters.count - summary.parameters_start
                        source_call: (known: bool, call: Ast::Expr) = proof_replay_summary_source_call_at_with_cache(report, candidate, summary, rebind_depth, work, cache)
                        continue if not source_call.known
                        call_owner_matches: bool = match source_call.call:
                            Ast::Expr.Call(callee, _, _, _): proof_replay_summary_owner_matches_call_bounded(report, candidate, summary, callee, work)
                            _: false
                        continue if not call_owner_matches
                        match source_call.call:
                            Ast::Expr.Call(_, arguments, argument_names, _):
                                continue if arguments.count > summary.parameters_count or (argument_names.count != 0 and argument_names.count != arguments.count)
                                continue if arguments.count < summary.parameters_count and argument_names.count != 0
                                matched_slots: mutable usize = 0
                                if summary.parameters_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                                    return false
                                work <- work + summary.parameters_count
                                for slot in 0..<summary.parameters_count |slot, arguments, argument_names, summary, report, candidate, symbol, literal, matched_slots, work|:
                                    binding_index: usize = candidate.summary_bindings_start + slot
                                    continue if report.traces.summary_names[binding_index] != report.executables.parameters[summary.parameters_start + slot]
                                    bound_name_matches: mutable bool = false
                                    match report.traces.summary_values[binding_index]:
                                        Ast::Expr.Ident(bound_name, _): bound_name_matches <- bound_name == symbol
                                        _:
                                            pass
                                    continue if not bound_name_matches
                                    argument_index: mutable usize = slot
                                    if argument_names.count > 0 and argument_names[slot] != "":
                                        argument_index <- arguments.count
                                        for index in 0..<arguments.count |index, argument_names, report, summary, slot, argument_index|:
                                            formal_index: usize = summary.parameters_start + slot
                                            argument_index <- index if argument_names[index] == report.executables.parameters[formal_index]
                                    elif argument_names.count > 0:
                                        saw_named: mutable bool = false
                                        for argument_name in argument_names |argument_name, saw_named|:
                                            saw_named <- true if argument_name != ""
                                        return false if saw_named
                                    if argument_names.count == 0 and argument_index >= arguments.count:
                                        # An omitted trailing slot takes the callee's literal default.
                                        default_value = proof_replay_summary_parameter_default_with_work(report, summary, slot, work)
                                        matched_slots <- matched_slots + 1 if default_value.known and proof_replay_summary_expr_equal_with_work(default_value.value, literal, work)
                                        continue
                                    continue if argument_index >= arguments.count
                                    source_argument: Ast::Expr = arguments[argument_index]
                                    source_argument_matches: bool = proof_replay_summary_expr_equal_with_work(source_argument, literal, work) or proof_replay_summary_call_global_constant_matches_with_work(report, candidate, source_argument, literal, work)
                                    continue if not source_argument_matches
                                    continue if proof_replay_summary_expr_equal_with_work(source_argument, literal, work) and not proof_replay_local_binding_expr_positions_match(literal, source_argument)
                                    matched_slots <- matched_slots + 1
                                if matched_slots == 1:
                                    if accepted_bindings == 0:
                                        accepted_bindings <- 1
                                        accepted_call <- source_call.call
                                    else:
                                        same_span_complete: mutable bool = true
                                        return false if not proof_replay_summary_call_same_source_span(report, trace, source_call.call, accepted_call, rebind_depth, work, &same_span_complete, 0) or not same_span_complete
                                        return false
                            _:
                                pass
                    return true if accepted_bindings == 1
                    return proof_replay_literal_direct_call_source_with_work(report, trace, symbol_position, literal, work)
                _:
                    return false

        def proof_replay_local_binding_literal_call_argument_source_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return proof_replay_local_binding_literal_call_argument_source_at_with_work(report, trace, 0, source_work)

        def proof_replay_local_binding_literal_call_argument_source_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return proof_replay_local_binding_literal_call_argument_source_at_with_cache(report, trace, 0, source_work, cache)

        # A literal-argument binding used to restate a call's preconditions over the literal: it
        # must have no derivation or summary payload of its own, be bound at the call's line,
        # and pass the same source reconstruction and uniqueness checks as the binding itself.
        def proof_replay_literal_rebind_substitution_valid(report: mutable ProofReport&, trace: ProofFactTrace, call_line: u32) -> bool:
            source_work: mutable usize = 0
            return proof_replay_literal_rebind_substitution_valid_with_work(report, trace, call_line, &source_work)

        def proof_replay_literal_rebind_substitution_valid_with_work(report: mutable ProofReport&, trace: ProofFactTrace, call_line: u32, source_work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_literal_rebind_substitution_valid_with_cache(report, trace, call_line, source_work, &cache)

        def proof_replay_literal_rebind_substitution_valid_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, call_line: u32, source_work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if trace.kind != "local-binding" or trace.line != call_line or call_line == 0
            return false if trace.dependency != "" or trace.premises_count != 0 or trace.kernel_premises_count != 0
            return false if trace.summary_bindings_count != 0 or trace.summary_requires_count != 0 or trace.summary_ensure_index != 0
            return proof_replay_local_binding_literal_call_argument_source_with_cache(report, trace, source_work, cache)

        def proof_replay_literal_call_site_count(expression: Ast::Expr, position: Ast::Pos, literal: Ast::Expr, found: mutable usize&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, call_position):
                    if proof_replay_source_position_equal(call_position, position):
                        argument_matches: mutable usize = 0
                        for argument in arguments |argument, literal, argument_matches|:
                            argument_matches <- argument_matches + 1 if proof_replay_expr_equal(argument, literal) and proof_replay_local_binding_expr_positions_match(literal, argument)
                        found <- found + 1 if argument_matches == 1
                    proof_replay_literal_call_site_count(callee, position, literal, found, depth + 1)
                    for argument in arguments |argument, position, literal, found, depth|:
                        proof_replay_literal_call_site_count(argument, position, literal, found, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _):
                    proof_replay_literal_call_site_count(inner, position, literal, found, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    proof_replay_literal_call_site_count(left, position, literal, found, depth + 1)
                    proof_replay_literal_call_site_count(right, position, literal, found, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                    proof_replay_literal_call_site_count(object, position, literal, found, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    proof_replay_literal_call_site_count(condition, position, literal, found, depth + 1)
                    proof_replay_literal_call_site_count(yes, position, literal, found, depth + 1)
                    proof_replay_literal_call_site_count(no, position, literal, found, depth + 1)
                _:
                    pass

        def proof_replay_literal_call_site_count_statements(statements: darray[Ast::Stmt]&, position: Ast::Pos, literal: Ast::Expr, found: mutable usize&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for statement in statements |position, literal, found, depth|:
                match statement:
                    Ast::Stmt.VarDecl(_, _, value, _) | Ast::Stmt.Expr(value, _) | Ast::Stmt.Contract(_, value, _):
                        proof_replay_literal_call_site_count(value, position, literal, found, depth + 1)
                    Ast::Stmt.Return(returned, _):
                        if returned is value:
                            proof_replay_literal_call_site_count(value, position, literal, found, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        proof_replay_literal_call_site_count(target, position, literal, found, depth + 1)
                        proof_replay_literal_call_site_count(value, position, literal, found, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        proof_replay_literal_call_site_count(condition, position, literal, found, depth + 1)
                        proof_replay_literal_call_site_count_statements(yes, position, literal, found, depth + 1)
                        proof_replay_literal_call_site_count_statements(no, position, literal, found, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        proof_replay_literal_call_site_count(condition, position, literal, found, depth + 1)
                        proof_replay_literal_call_site_count_statements(nested, position, literal, found, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        proof_replay_literal_call_site_count(iterable, position, literal, found, depth + 1)
                        proof_replay_literal_call_site_count_statements(nested, position, literal, found, depth + 1)
                    Ast::Stmt.Match(value, arms, _):
                        proof_replay_literal_call_site_count(value, position, literal, found, depth + 1)
                        for arm in arms |arm, position, literal, found, depth|:
                            proof_replay_literal_call_site_count_statements(arm.body, position, literal, found, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        proof_replay_literal_call_site_count_statements(nested, position, literal, found, depth + 1)
                    _:
                        pass

        # The legacy recursive scanner visits each body node once and compares each call
        # argument once with a literal restricted to at most two nodes. The weighted body size
        # bounds those argument scans, including the replay comparator's cost and compare pass.
        def proof_replay_literal_call_site_scan_reserve(body: darray[Ast::Stmt]&, literal: Ast::Expr, work: mutable usize&) -> bool:
            cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost_body(body, &cost, work, 0)
            literal_cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost(literal, &literal_cost, work, 0)
            remaining: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            return false if literal_cost >= remaining
            repeated_factor: usize = literal_cost + 1
            return false if cost > (remaining / 8) / repeated_factor
            work <- work + cost * repeated_factor * 8
            return true

        def proof_replay_local_binding_literal_call_site_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_local_binding_literal_call_site_source_with_work(report, trace, &work)

        def proof_replay_local_binding_literal_call_site_source_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or trace.line == 0
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, literal, _):
                    return false if not proof_internal_name_is_rebind(symbol) or not proof_replay_literal_value(literal) or symbol_position.line != trace.line
                    return false if not proof_replay_rebind_definition_unique_with_work(report, trace, symbol, symbol_position, literal, false, source_work)
                    return false if report.traces.records.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                    source_work <- source_work + report.traces.records.count
                    for candidate in report.traces.records |candidate, report, trace, symbol, source_work|:
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        source_work <- source_work + 1
                        return false if sview_len(candidate.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + sview_len(candidate.name)
                        return false if sview_len(candidate.kind) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + sview_len(candidate.kind)
                        continue if candidate.kind != "function-summary" or candidate.name != trace.name
                        return false if candidate.summary_bindings_start > report.traces.summary_values.count or candidate.summary_bindings_count > report.traces.summary_values.count - candidate.summary_bindings_start
                        return false if candidate.summary_bindings_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + candidate.summary_bindings_count
                        for offset in 0..<candidate.summary_bindings_count |offset, candidate, report, symbol, source_work|:
                            value: Ast::Expr = report.traces.summary_values[candidate.summary_bindings_start + offset]
                            return false if not proof_replay_summary_expr_charge_with_work(value, source_work)
                            return false if proof_expr_mentions_name(value, symbol)
                        return false if not proof_replay_summary_expr_charge_with_work(candidate.expression, source_work)
                        return false if proof_expr_mentions_name(candidate.expression, symbol)
                    body: mutable darray[Ast::Stmt] = []
                    return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                    return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return false if not proof_replay_literal_call_site_scan_reserve(body, literal, source_work)
                    found: mutable usize = 0
                    proof_replay_literal_call_site_count_statements(body, symbol_position, literal, &found, 0)
                    return found == 1
                _:
                    return false
