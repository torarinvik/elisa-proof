# A self-referential update of an integer local inside a loop body (`count <- count + 1`) takes a
# fresh symbol `S == count + 1` (proof_bind_unsigned_symbol), and the loop's preservation check
# consumes it at the loop header's line. In that certificate `count` denotes the local's value at
# the start of the iteration (the producer havocs it at the header and states the invariant and
# guard over it). Replay accepts the equation only when
#   - the consumer is a preservation context (source guard and invariant facts are present);
#   - exactly one loop statement of the owner sits on the consumer's line, in its lexical source body, and the equation's span pins exactly one plain
#     assignment `x <- value` among that loop's top-level body statements;
#   - the value mentions x and is otherwise stable (self_updates.elisa), and x is a once-declared
#     integer local of the owner (or of that capture block), not a parameter or global constant;
#   - neither the loop condition nor any statement before the assignment in the body may write x,
#     other than an earlier resymbolized self-update, so `x` still names the iteration-start value;
#   - no other binding or summary of the owner defines S differently (the shared rule).
extend ElisaProof:
    private:
        def proof_replay_loop_source_call_parameter_cost(declarations: darray[Ast::Decl]&, cost: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - cost
            cost <- cost + declarations.count
            for declaration in declarations |cost, depth|:
                match declaration:
                    Ast::Decl.Func(_, parameters, _, _, _, _, _):
                        return false if parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - cost
                        cost <- cost + parameters.count
                        for parameter in parameters |parameter, cost|:
                            return false if sview_len(parameter.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - cost
                            cost <- cost + sview_len(parameter.name)
                            return false if not proof_replay_summary_expr_cost(parameter.type_expression, cost, 0, 0)
                    Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - cost
                        cost <- cost + sview_len(name)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_loop_source_call_parameter_cost(nested, cost, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_loop_source_call_parameter_cost_charge(report: ProofReport&, parameter_cost: mutable usize&, source_work: mutable usize&) -> bool:
            measured_cost: mutable usize = 0
            if not proof_replay_loop_source_call_parameter_cost(report.source_declarations, &measured_cost, 0):
                return proof_replay_mutable_local_work_exhaust(source_work)
            if measured_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                return proof_replay_mutable_local_work_exhaust(source_work)
            source_work <- source_work + measured_cost
            parameter_cost <- measured_cost
            return true

        # The source touch walk can resolve every call argument against declarations and scan a
        # matching function's parameter list/type. Reserve that full lookup per possible
        # argument, bounded by the statement's AST cost, before running the walk.
        def proof_replay_loop_prefix_source_touch_work_charge(statement: Ast::Stmt, source_call_lookup_work: usize, source_work: mutable usize&) -> bool:
            statement_cost: mutable usize = 0
            if not proof_replay_mutable_local_statement_work_charge(statement, statement_cost, 0):
                return proof_replay_mutable_local_work_exhaust(source_work)
            if statement_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                return proof_replay_mutable_local_work_exhaust(source_work)
            source_work <- source_work + statement_cost
            if statement_cost != 0 and source_call_lookup_work > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / statement_cost:
                return proof_replay_mutable_local_work_exhaust(source_work)
            source_work <- source_work + statement_cost * source_call_lookup_work
            return true

        # VALID when exactly one matching assignment is found in this loop's body, INVALID when
        # one is found but a write of x precedes it, ABSENT otherwise.
        def proof_replay_loop_self_update_in_loop_with_work(report: ProofReport&, owner: sview, condition: Ast::Expr, body: darray[Ast::Stmt]&, binding: Ast::Expr, value: Ast::Expr, local_name: mutable sview&, owner_scan_work: usize, source_call_lookup_work: usize, source_work: mutable usize&) -> usize:
            found: mutable usize = ProofReplayLocalAlias::ABSENT
            for index in 0..<body.count |index, body, report, owner, condition, binding, value, local_name, found, owner_scan_work, source_call_lookup_work, source_work|:
                return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_statement_work_charge_fail_closed(body[index], source_work, 0)
                match body[index]:
                    Ast::Stmt.Assign(Ast::Expr.Ident(name, _), operator, assigned, statement_position):
                        if (operator == TokenKind.Assign or operator == TokenKind.LArrow) and proof_replay_local_binding_pos_matches(binding, statement_position):
                            here: mutable usize = ProofReplayLocalAlias::INVALID
                            return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_expr_work_charge(assigned, source_work)
                            if proof_expr_mentions_name(assigned, name):
                                exact_value: bool = proof_replay_summary_expr_equal_with_work(assigned, value, source_work)
                                return ProofReplayLocalAlias::INVALID if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                if exact_value:
                                    return ProofReplayLocalAlias::INVALID if:
                                        not proof_replay_mutable_local_expr_work_charge(assigned, source_work)
                                        not proof_replay_mutable_local_identifier_scan_charge(assigned, owner_scan_work, source_work)
                                        not proof_replay_mutable_local_expr_work_charge(condition, source_work)
                                    condition_statement: Ast::Stmt = Ast::Stmt.Expr(condition, Ast::expr_pos(condition))
                                    if proof_replay_self_update_value(report, assigned, name, owner, 0):
                                        return ProofReplayLocalAlias::INVALID if not proof_replay_loop_prefix_source_touch_work_charge(condition_statement, source_call_lookup_work, source_work)
                                        if not proof_replay_source_expr_touches(report.source_declarations, condition, name, true, 0):
                                            clean: mutable bool = true
                                            for earlier in 0..<index |earlier, body, report, owner, name, clean, source_call_lookup_work, source_work|:
                                                return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_statement_work_charge_fail_closed(body[earlier], source_work, 0)
                                                match body[earlier]:
                                                    Ast::Stmt.Contract(_, _, _):
                                                        pass
                                                    _:
                                                        return ProofReplayLocalAlias::INVALID if not proof_replay_loop_prefix_source_touch_work_charge(body[earlier], source_call_lookup_work, source_work)
                                                        if not proof_replay_self_update_resymbolized_with_work(report, owner, body[earlier], name, source_work):
                                                            return ProofReplayLocalAlias::INVALID if:
                                                                source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                                                not proof_replay_mutable_local_owner_preflight_work_charge(report, owner, report.replay_owner_line, source_work)
                                                                not proof_replay_mutable_local_statement_work_charge_fail_closed(body[earlier], source_work, 0)
                                                                not proof_replay_loop_prefix_source_touch_work_charge(body[earlier], source_call_lookup_work, source_work)
                                                            clean <- false if proof_replay_source_statement_touches(report.source_declarations, body[earlier], name, true, 0)
                                            if clean:
                                                local_name <- name
                                                here <- ProofReplayLocalAlias::VALID
                            found <- proof_replay_mutable_local_merge(found, here)
                    _:
                        pass
            return found

        # The unique loop on `line`; `loop_scope` receives its lexical statement list.
        def proof_replay_loop_self_update_site_with_work(report: ProofReport&, owner: sview, statements: darray[Ast::Stmt]&, line: u32, binding: Ast::Expr, value: Ast::Expr, local_name: mutable sview&, loops: mutable usize&, loop_scope: mutable darray[Ast::Stmt]&, nested: bool, owner_scan_work: usize, source_call_lookup_work: usize, source_work: mutable usize&) -> usize:
            found: mutable usize = ProofReplayLocalAlias::ABSENT
            for statement in statements |report, owner, statements, line, binding, value, local_name, loops, loop_scope, nested, found, owner_scan_work, source_call_lookup_work, source_work|:
                return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_statement_work_charge_fail_closed(statement, source_work, 0)
                match statement:
                    Ast::Stmt.While(condition, body, position):
                        if position.line == line:
                            loops <- loops + 1
                            here: usize = proof_replay_loop_self_update_in_loop_with_work(report, owner, condition, body, binding, value, local_name, owner_scan_work, source_call_lookup_work, source_work)
                            if here != ProofReplayLocalAlias::ABSENT:
                                loop_scope.clear()
                                loop_scope.extend(statements)
                            found <- proof_replay_mutable_local_merge(found, here)
                    Ast::Stmt.For(_, _, condition, body, position):
                        if position.line == line:
                            loops <- loops + 1
                            here: usize = proof_replay_loop_self_update_in_loop_with_work(report, owner, condition, body, binding, value, local_name, owner_scan_work, source_call_lookup_work, source_work)
                            if here != ProofReplayLocalAlias::ABSENT:
                                loop_scope.clear()
                                loop_scope.extend(statements)
                            found <- proof_replay_mutable_local_merge(found, here)
                    Ast::Stmt.Expr(block, _) | Ast::Stmt.Return(block, _) | Ast::Stmt.VarDecl(_, _, block, _):
                        if not nested:
                            match proof_replay_source_unwrap_empty_value_block(block, 0):
                                Ast::Expr.Block(inner, _, _, _):
                                    found <- proof_replay_mutable_local_merge(found, proof_replay_loop_self_update_site_with_work(report, owner, inner, line, binding, value, local_name, loops, loop_scope, true, owner_scan_work, source_call_lookup_work, source_work))
                                _:
                                    pass
                    _:
                            pass
            return found

        # A loop instance's reserved name must occur in the consuming certificate's
        # fact snapshot. Appending a new trace cannot mint another instance for that check.
        def proof_replay_loop_binding_in_certificate_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if:
                not proof_replay_mutable_local_text_compare_work_charge(certificate.name, trace.name, source_work)
                certificate.name != trace.name or certificate.line != report.trace_owner_line
                not proof_replay_mutable_local_text_compare_work_charge(certificate.rule, "goal", source_work)
                not proof_replay_mutable_local_text_compare_work_charge(certificate.rule, "quantifier-forall", source_work)
                not proof_replay_mutable_local_text_compare_work_charge(certificate.rule, "quantifier-exists", source_work)
                certificate.facts_start > report.certificate_facts.count or certificate.facts_count > report.certificate_facts.count - certificate.facts_start
            if certificate.facts_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                return proof_replay_mutable_local_work_exhaust(source_work)
            source_work <- source_work + certificate.facts_count
            for index in 0..<certificate.facts_count |index, report, certificate, trace, source_work|:
                fact: Ast::Expr = report.certificate_facts[certificate.facts_start + index]
                exact: mutable bool = false
                return false if not proof_replay_mutable_local_expr_equal_with_work(fact, trace.expression, &exact, source_work)
                return true if exact and proof_replay_local_binding_expr_positions_match(fact, trace.expression)
            false

        def proof_replay_local_binding_loop_self_update_source(report: ProofReport&, trace: ProofFactTrace, preservation_context: bool) -> bool:
            work: mutable usize = 0
            return proof_replay_local_binding_loop_self_update_source_with_work(report, trace, preservation_context, &work)

        def proof_replay_local_binding_loop_self_update_source_with_work(report: ProofReport&, trace: ProofFactTrace, preservation_context: bool, source_work: mutable usize&) -> bool:
            return false if:
                not preservation_context or trace.name == "" or trace.line == 0 or report.trace_owner_line == 0
                not proof_replay_mutable_local_expr_work_charge(trace.expression, source_work)
                not proof_replay_loop_binding_in_certificate_with_work(report, trace, source_work)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, value, _):
                    return false if:
                        not proof_internal_name_is_rebind(symbol) or symbol_position.line != trace.line
                        not proof_replay_mutable_local_expr_work_charge(value, source_work)
                    owner_scan_start: usize = source_work
                    return false if not proof_replay_mutable_local_owner_preflight_work_charge(report, trace.name, report.replay_owner_line, source_work)
                    owner_scan_work: usize = source_work - owner_scan_start
                    return false if:
                        not proof_replay_mutable_local_identifier_scan_charge(value, owner_scan_work, source_work)
                        proof_source_expression_has_overloaded_operator(value, report.source_primitive_operator_mask, 0)
                    parameter_cost: mutable usize = 0
                    return false if not proof_replay_loop_source_call_parameter_cost_charge(report, &parameter_cost, source_work)
                    source_call_lookup_work: usize = owner_scan_work + parameter_cost
                    body: mutable darray[Ast::Stmt] = []
                    return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    local_name: mutable sview = ""
                    loops: mutable usize = 0
                    loop_scope: mutable darray[Ast::Stmt] = []
                    site: usize = proof_replay_loop_self_update_site_with_work(report, trace.name, body, report.trace_owner_line, trace.expression, value, &local_name, &loops, &loop_scope, false, owner_scan_work, source_call_lookup_work, source_work)
                    return false if:
                        source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or site != ProofReplayLocalAlias::VALID
                        loops != 1 or local_name == ""
                        proof_replay_local_binding_parameter_name_present_with_default_limit(report.source_declarations, trace.name, report.replay_owner_line, local_name, source_work, 0)
                        proof_replay_local_binding_global_constant_named_with_work(report.source_declarations, local_name, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                    # Declared once in the loop's own block (a capture header), or else once at
                    # the top level of the owner body.
                    return false if not proof_replay_mutable_local_body_work_charge_fail_closed(loop_scope, source_work, 0)
                    in_scope: bool = proof_replay_source_single_declaration_with_work(report.source_declarations, loop_scope, local_name, source_work) and proof_replay_mutable_local_declared(loop_scope, local_name)
                    if not in_scope:
                        return false if:
                            not proof_replay_mutable_local_body_work_charge_fail_closed(body, source_work, 0)
                            not proof_replay_source_single_declaration_with_work(report.source_declarations, body, local_name, source_work) or not proof_replay_mutable_local_declared(body, local_name)
                    # One exact source assignment cannot introduce two fresh witnesses.
                    # A renamed copy must not pass merely because its new name is unused.
                    return false if not proof_replay_mutable_local_trace_work_charge_fail_closed(report, source_work, 1)
                    for candidate in report.traces.records |candidate, trace, symbol, symbol_position, value, source_work|:
                        return false if:
                            not proof_replay_mutable_local_text_compare_work_charge(candidate.kind, "local-binding", source_work)
                            not proof_replay_mutable_local_text_compare_work_charge(candidate.name, trace.name, source_work)
                        continue if candidate.kind != "local-binding" or candidate.name != trace.name or candidate.line != trace.line
                        match candidate.expression:
                            Ast::Expr.Binary(Ast::Expr.Ident(other_symbol, other_position), TokenKind.EqEq, other_value, _):
                                if proof_replay_source_position_equal(other_position, symbol_position):
                                    exact_value: mutable bool = false
                                    return false if:
                                        not proof_replay_mutable_local_expr_equal_with_work(other_value, value, &exact_value, source_work)
                                        exact_value and other_symbol != symbol
                            _:
                                pass
                    return proof_replay_rebind_definition_unique_with_work(report, trace, symbol, symbol_position, value, true, source_work)
                _:
                    return false
