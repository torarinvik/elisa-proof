include "./value_block_immutable_bindings.elisa"
# Replay local facts from unique, immutable scalar declarations. This module admits only
# source-exact or independently authenticated constant-substituted initializers and the
# separately checked value-preserving widening-cast equation.
extend ElisaProof:
    private:
        # Bare names in an initializer are not stable merely because a parameter or module
        # constant with the same spelling exists somewhere in the source tree. Require one
        # unique owner and reject every local introduction of that spelling at any nesting
        # depth (declaration, `=` definition, loop variable, pattern binder, block binding);
        # the global constant path stays closed until its resolved module identity is carried
        # in traces.
        def proof_replay_local_binding_parameter_source_unshadowed_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, source_work: mutable usize&) -> bool:
            proof_replay_local_binding_parameter_source_unshadowed_with_limit(declarations, owner, owner_line, name, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_replay_local_binding_parameter_source_unshadowed_with_limit(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, source_work: mutable usize&, work_limit: usize) -> bool:
            return false if:
                owner == "" or owner_line == 0 or name == ""
                work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or source_work > work_limit
            virtual_seed: usize = source_work + (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work_limit)
            virtual_work: mutable usize = virtual_seed
            body: mutable darray[Ast::Stmt] = []
            owner_matches: mutable usize = 0
            owner_complete: bool = proof_replay_local_binding_find_owner_with_work(declarations, owner, owner_line, &body, &owner_matches, virtual_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
            if not owner_complete or owner_matches != 1:
                source_work <- work_limit if virtual_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT else source_work + (virtual_work - virtual_seed)
                return false
            declares: bool = proof_replay_source_body_declares_with_work(declarations, body, name, virtual_work)
            charged: usize = virtual_work - virtual_seed
            if virtual_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or charged > work_limit - source_work:
                source_work <- work_limit
                return false
            source_work <- source_work + charged
            not declares

        def proof_replay_local_binding_parameter_present_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, source_work: mutable usize&, depth: usize) -> (complete: bool, found: bool):
            return (false, false) if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, name, source_work, depth|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Func(found_name, parameters, _, _, _, _, position):
                        return (false, false) if:
                            not proof_replay_source_work_charge_or_exhaust(sview_len(found_name), source_work)
                            not proof_replay_source_work_charge_or_exhaust(sview_len(owner), source_work)
                        if found_name == owner and position.line == owner_line:
                            for parameter in parameters |name, source_work|:
                                return (false, false) if:
                                    not proof_replay_source_work_charge_or_exhaust(1, source_work)
                                    not proof_replay_source_work_charge_or_exhaust(sview_len(parameter.name), source_work)
                                    not proof_replay_source_work_charge_or_exhaust(sview_len(name), source_work)
                                return (true, true) if parameter.name == name
                            return (true, false)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        result: (complete: bool, found: bool) = proof_replay_local_binding_parameter_present_with_work(nested, owner, owner_line, name, source_work, depth + 1)
                        return result if not result.complete or result.found
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return (false, false)
                    _:
                        return (false, false)
            return (true, false)

        def proof_replay_local_binding_stable_name(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, target: sview, source_work: mutable usize&) -> bool:
            return false if name == "" or name == target
            parameter: (complete: bool, found: bool) = proof_replay_local_binding_parameter_present_with_work(declarations, owner, owner_line, name, source_work, 0)
            return false if not parameter.complete
            if not parameter.found:
                return proof_replay_local_binding_prior_immutable_local_with_work(declarations, owner, owner_line, name, target, source_work)
            return false if not proof_replay_local_binding_parameter_source_unshadowed_with_work(declarations, owner, owner_line, name, source_work)
            return true if proof_replay_local_binding_immutable_integer_parameter_with_work(declarations, owner, owner_line, name, source_work, 0)
            return proof_replay_local_binding_unwritten_integer_parameter_with_work(declarations, owner, owner_line, name, source_work)

        # A mutable or by-reference integer parameter is as stable as an immutable one when the
        # body never writes it: no assignment, lend, move or receiver call reaches its place
        # (numeric conversions read only). Another `mutable` reference cannot alias it, since
        # exclusive borrows are a language guarantee the producer also relies on.
        def proof_replay_local_binding_unwritten_integer_parameter_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, source_work: mutable usize&) -> bool:
            proof_replay_local_binding_unwritten_parameter_type_name_with_work(declarations, owner, owner_line, name, source_work) != ""

        def proof_replay_local_binding_unwritten_parameter_type_name_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, source_work: mutable usize&) -> sview:
            type_result: (complete: bool, type_name: sview) = proof_replay_local_binding_parameter_type_name_with_work(declarations, owner, owner_line, name, source_work, true, 0)
            return "" if not type_result.complete or type_result.type_name == ""
            body: mutable darray[Ast::Stmt] = []
            owner_matches: mutable usize = 0
            return "" if:
                not proof_replay_local_binding_find_owner_with_work(declarations, owner, owner_line, &body, &owner_matches, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0) or owner_matches != 1
                proof_replay_source_body_touches_with_work(declarations, body, name, true, source_work)
            type_result.type_name

        # The integer type under an unwritten mutable or by-reference parameter, or "".
        def proof_replay_local_binding_unwritten_parameter_type_name(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, source_work: mutable usize&) -> sview:
            proof_replay_local_binding_unwritten_parameter_type_name_with_work(declarations, owner, owner_line, name, source_work)

        # The loop-entry caller reserves the declaration and type-expression costs before this
        # legacy walk. Other admission paths use the shared-work parameter-type query below.
        def proof_replay_local_binding_parameter_integer_layers(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, matches: mutable usize&, type_name: mutable sview&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, name, matches, type_name, depth|:
                match declaration:
                    Ast::Decl.Func(function_name, parameters, _, _, _, _, position):
                        if function_name == owner and position.line == owner_line:
                            for parameter in parameters |name, matches, type_name|:
                                if parameter.name == name:
                                    matches <- matches + 1
                                    type_name <- proof_replay_local_binding_reference_integer_name(parameter.type_expression, 0)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_replay_local_binding_parameter_integer_layers(nested, owner, owner_line, name, matches, type_name, depth + 1)
                    _:
                        pass

        def proof_replay_local_binding_reference_integer_name(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(operator, inner, _):
                    return "" if operator != TokenKind.Mutable and operator != TokenKind.Ampersand and operator != TokenKind.Lmut
                    return proof_replay_local_binding_reference_integer_name(inner, depth + 1)
                _:
                    return proof_replay_local_binding_integer_type_name(expression, 0)

        # Reading a prior immutable scalar reads its captured value, regardless
        # of how it was computed. This does not substitute its initializer or
        # assert any equation about a call. Require unique direct declarations
        # in the same owner and source order; parameter shadowing is refused by
        # the caller. Forward references and cycles cannot pass this order.
        def proof_replay_local_binding_prior_immutable_local_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, name: sview, target: sview, source_work: mutable usize&) -> bool:
            body: mutable darray[Ast::Stmt] = []
            owners: mutable usize = 0
            return false if:
                not proof_replay_local_binding_find_owner_with_work(declarations, owner, owner_line, &body, &owners, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0) or owners != 1
                not proof_replay_source_single_declaration_with_work(declarations, body, name, source_work)
                not proof_replay_source_single_declaration_with_work(declarations, body, target, source_work)
            source_count: mutable usize = 0
            target_count: mutable usize = 0
            source_index: mutable usize = body.count
            target_index: mutable usize = 0
            valid: mutable bool = false
            for index in 0..<body.count |index, body, name, target, source_count, target_count, source_index, target_index, valid|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match body[index]:
                    Ast::Stmt.VarDecl(local, type_expression, _, _):
                        if local == name:
                            source_count <- source_count + 1
                            source_index <- index
                            valid <- proof_replay_local_binding_integer_type(type_expression, 0) and not proof_replay_local_binding_mutable_integer_type(type_expression)
                        if local == target:
                            target_count <- target_count + 1
                            target_index <- index
                    _:
                        pass
            return source_count == 1 and target_count == 1 and source_index < target_index and valid

        # Replay has no resolved cast-dispatch witness in local-binding traces. If any ordinary
        # or extern `__cast__` could occur in the imported unit, keep method-shaped numeric calls
        # opaque here; selector spelling alone cannot establish builtin conversion semantics.
        def proof_replay_local_binding_cast_hook_present(declarations: darray[Ast::Decl]&, source_work: mutable usize&, depth: usize) -> bool:
            return true if:
                depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
                source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + declarations.count
            for declaration in declarations |source_work, depth|:
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, _):
                        return true if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + sview_len(name)
                        return true if name == "__cast__"
                    Ast::Decl.Extern(name, _, arity, _, callable, _, _, _):
                        return true if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + sview_len(name)
                        return true if name == "__cast__" and arity == 1 and callable
                    Ast::Decl.Module(module_name, nested, _):
                        return true if sview_len(module_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + sview_len(module_name)
                        return true if proof_replay_local_binding_cast_hook_present(nested, source_work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_local_binding_cast_hook_present(nested, source_work, depth + 1)
                    _:
                        pass
            return false

        # Retain only source-pure integer initializers over immutable inputs. Numeric conversions
        # are Elisa special forms; an exact equation to the conversion expression is valid even
        # when that conversion narrows its input.
        def proof_replay_local_binding_stable_initializer(expression: Ast::Expr, target: sview, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return proof_replay_local_binding_stable_name(declarations, owner, owner_line, name, target, source_work)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_stable_initializer(inner, target, declarations, owner, owner_line, source_work, depth + 1)
                Ast::Expr.Unary(TokenKind.Minus, inner, _):
                    return proof_replay_local_binding_stable_initializer(inner, target, declarations, owner, owner_line, source_work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent
                    return proof_replay_local_binding_stable_initializer(left, target, declarations, owner, owner_line, source_work, depth + 1) and proof_replay_local_binding_stable_initializer(right, target, declarations, owner, owner_line, source_work, depth + 1)
                Ast::Expr.If(condition, then_value, else_value, _):
                    return proof_replay_local_binding_stable_condition(condition, target, declarations, owner, owner_line, source_work, depth + 1) and proof_replay_local_binding_conditional_value(then_value, target, declarations, owner, owner_line, source_work, depth + 1) and proof_replay_local_binding_conditional_value(else_value, target, declarations, owner, owner_line, source_work, depth + 1)
                Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(receiver, _), method, _), arguments, _, _):
                    return false if:
                        arguments.count != 0
                        method != "i8" and method != "i16" and method != "i32" and method != "i64" and method != "isize" and method != "u8" and method != "u16" and method != "u32" and method != "u64" and method != "usize"
                        proof_replay_local_binding_cast_hook_present(declarations, source_work, 0)
                    return proof_replay_local_binding_stable_name(declarations, owner, owner_line, receiver, target, source_work)
                _:
                    return false

        def proof_replay_local_binding_stable_initializer_with_limit(expression: Ast::Expr, target: sview, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, source_work: mutable usize&, depth: usize, work_limit: usize) -> bool:
            return false if work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or source_work > work_limit
            virtual_seed: usize = source_work + (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work_limit)
            virtual_work: mutable usize = virtual_seed
            stable: bool = proof_replay_local_binding_stable_initializer(expression, target, declarations, owner, owner_line, virtual_work, depth)
            charged: usize = virtual_work - virtual_seed
            return false if charged > work_limit - source_work
            source_work <- source_work + charged
            stable

        # Comparisons of stable integer operands, joined by `and`, `or` and `not`.
        # A conditional equation is source-exact only when its predicate and
        # both arms read stable integer inputs, including prior immutable
        # captures. The caller separately refuses overloaded primitive operators.
        def proof_replay_local_binding_conditional_value(expression: Ast::Expr, target: sview, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if name == "" or name == target
                    parameter: (complete: bool, found: bool) = proof_replay_local_binding_parameter_present_with_work(declarations, owner, owner_line, name, source_work, 0)
                    return false if not parameter.complete
                    if not parameter.found:
                        return proof_replay_local_binding_prior_immutable_local_with_work(declarations, owner, owner_line, name, target, source_work)
                _:
                    pass
            return proof_replay_local_binding_stable_initializer(expression, target, declarations, owner, owner_line, source_work, depth + 1)

        def proof_replay_local_binding_stable_condition(expression: Ast::Expr, target: sview, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_stable_condition(inner, target, declarations, owner, owner_line, source_work, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_replay_local_binding_stable_condition(inner, target, declarations, owner, owner_line, source_work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        return proof_replay_local_binding_stable_condition(left, target, declarations, owner, owner_line, source_work, depth + 1) and proof_replay_local_binding_stable_condition(right, target, declarations, owner, owner_line, source_work, depth + 1)
                    return false if not proof_is_comparison(operator)
                    return proof_replay_local_binding_conditional_value(left, target, declarations, owner, owner_line, source_work, depth + 1) and proof_replay_local_binding_conditional_value(right, target, declarations, owner, owner_line, source_work, depth + 1)
                _:
                    return false

        def proof_replay_local_binding_integer_type_name(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name if name in {"i8", "i16", "i32", "i64", "isize", "int", "u8", "u16", "u32", "u64", "usize", "uintptr"}
                    return ""
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_integer_type_name(inner, depth + 1)
                _:
                    return ""

        def proof_replay_local_binding_integer_parameter_type_name_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, depth: usize) -> (complete: bool, type_name: sview):
            proof_replay_local_binding_parameter_type_name_with_work(declarations, owner, owner_line, parameter_name, source_work, false, depth)

        def proof_replay_local_binding_immutable_integer_parameter_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, depth: usize) -> bool:
            result: (complete: bool, type_name: sview) = proof_replay_local_binding_integer_parameter_type_name_with_work(declarations, owner, owner_line, parameter_name, source_work, depth)
            result.complete and result.type_name != ""

        def proof_replay_local_binding_parameter_type_name_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, reference_layers: bool, depth: usize) -> (complete: bool, type_name: sview):
            scanned: (complete: bool, matches: usize, type_name: sview) = proof_replay_local_binding_parameter_type_scan_with_work(declarations, owner, owner_line, parameter_name, source_work, reference_layers, depth)
            return (false, "") if scanned.complete and scanned.matches > 1
            return (scanned.complete, scanned.type_name) if scanned.complete and scanned.matches == 1
            return (scanned.complete, "")

        def proof_replay_local_binding_parameter_type_scan_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, reference_layers: bool, depth: usize) -> (complete: bool, matches: usize, type_name: sview):
            return (false, 0, "") if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or owner == "" or owner_line == 0 or parameter_name == ""
            matches: mutable usize = 0
            type_name: mutable sview = ""
            for declaration in declarations |owner, owner_line, parameter_name, reference_layers, depth, matches, type_name, source_work|:
                return (false, 0, "") if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return (false, 0, "") if not proof_replay_mutable_local_text_compare_work_charge(name, owner, source_work)
                        if name == owner and position.line == owner_line:
                            for parameter in parameters |parameter_name, reference_layers, matches, type_name, source_work|:
                                return (false, 0, "") if:
                                    not proof_replay_source_work_charge_or_exhaust(1, source_work)
                                    not proof_replay_mutable_local_text_compare_work_charge(parameter.name, parameter_name, source_work)
                                if parameter.name == parameter_name:
                                    matches <- matches + 1
                                    return (false, 0, "") if not proof_replay_summary_expr_repeat_charge_with_limit(parameter.type_expression, 2, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                    if reference_layers:
                                        type_name <- proof_replay_local_binding_reference_integer_name(parameter.type_expression, 0)
                                    else:
                                        type_name <- proof_replay_local_binding_integer_type_name(parameter.type_expression, 0) if not proof_replay_local_binding_mutable_integer_type(parameter.type_expression)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        nested_result: (complete: bool, matches: usize, type_name: sview) = proof_replay_local_binding_parameter_type_scan_with_work(nested, owner, owner_line, parameter_name, source_work, reference_layers, depth + 1)
                        return nested_result if not nested_result.complete
                        matches <- matches + nested_result.matches
                        type_name <- nested_result.type_name if nested_result.matches == 1
                    Ast::Decl.Invalid:
                        return (false, 0, "")
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return (false, 0, "")
            (true, matches, type_name)

        # Built-in arithmetic in the kernel is not evidence about overloaded Elisa operators.
        # Reject a local equation whenever its initializer contains any source-overloaded
        # primitive operation; the source operator mask is computed from the imported unit.
        def proof_replay_local_binding_immutable_declaration_source_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or report.analysis_2.replay_owner_line == 0 or report.analysis_2.trace_owner_line == 0 or trace.line == 0
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(target, target_position), TokenKind.EqEq, source_value, _):
                    return false if:
                        target == "" or proof_internal_name_is_rebind(target)
                        not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                    owner_scan_start: usize = source_work
                    return false if not proof_replay_mutable_local_owner_preflight_work_charge(report, trace.name, report.analysis_2.replay_owner_line, source_work)
                    owner_scan_work: usize = source_work - owner_scan_start
                    function_body: mutable darray[Ast::Stmt] = []
                    owner_matches: mutable usize = 0
                    return false if not proof_replay_local_binding_find_owner_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, &function_body, &owner_matches, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0) or owner_matches != 1
                    consumer_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    return false if:
                        not proof_replay_mutable_local_consumer_position_with_work(report, trace, function_body, &consumer_position, source_work)
                        consumer_position.offset == 0 or consumer_position.end_offset <= consumer_position.offset
                    declarations: mutable usize = 0
                    valid: mutable bool = false
                    for statement in function_body |target, source_value, trace, report, consumer_position, source_work, declarations, valid|:
                        match statement:
                            Ast::Stmt.VarDecl(name, type_expression, initializer, position):
                                if name == target:
                                    declarations <- declarations + 1
                                    return false if not proof_replay_summary_expr_charge_with_work(type_expression, source_work) or not proof_replay_summary_expr_charge_with_work(type_expression, source_work)
                                    single: mutable darray[Ast::Stmt] = [statement]
                                    extent_cost: mutable usize = 0
                                    return false if:
                                        not proof_replay_summary_expr_cost_body(single, &extent_cost, source_work, 0)
                                        source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or extent_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                                    source_work <- source_work + extent_cost
                                    declaration_extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(statement, 0)
                                    candidate_valid: mutable bool = declaration_extent.offsets_complete and position.offset != 0 and declaration_extent.end_offset > position.offset and declaration_extent.end_offset <= consumer_position.offset and proof_replay_local_binding_pos_matches(trace.expression, position) and proof_replay_local_binding_pos_matches(Ast::Expr.Ident(target, target_position), position) and proof_replay_local_binding_integer_type(type_expression, 0) and not proof_replay_local_binding_mutable_integer_type(type_expression)
                                    if candidate_valid:
                                        return false if:
                                            not proof_replay_summary_expr_charge_with_work(initializer, source_work)
                                            not proof_replay_mutable_local_identifier_scan_charge(initializer, owner_scan_work, source_work)
                                        candidate_valid <- not proof_source_expression_has_overloaded_operator(initializer, report.source.source_primitive_operator_mask, 0)
                                        if candidate_valid:
                                            candidate_valid <- proof_replay_mutable_local_authenticated_initializer_with_work(report, trace, initializer, source_value, target, source_work, 0, true)
                                    valid <- candidate_valid
                            _:
                                pass
                    return declarations == 1 and valid and proof_replay_source_single_declaration_with_work(report.source.source_declarations, function_body, target, source_work) or proof_replay_value_block_immutable_binding_with_work(report, trace, source_work)
                _:
                    return false
