# Validate the synthetic typed witness used when a signed return constant needs its
# declared width. The witness is live only for the exact source return and exact type.
extend ElisaProof:
    private:
        const PROOF_REPLAY_TYPED_RETURN_DEPTH_LIMIT: usize = 64

        def proof_replay_typed_return_pos_equal(left: Ast::Pos, right: Ast::Pos) -> bool:
            return left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        def proof_replay_typed_return_signed_width(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, width: mutable i64&, body: mutable darray[Ast::Stmt]&, matches: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_TYPED_RETURN_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            for declaration in declarations |owner, owner_line, width, body, matches, source_work, depth|:
                return false if not proof_type_audit_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, return_type, statements, _, _, position):
                        return false if:
                            not proof_type_audit_work_charge(sview_len(name), source_work)
                            not proof_type_audit_work_charge(sview_len(owner), source_work)
                        if name == owner and position.line == owner_line:
                            return false if not proof_type_audit_work_charge(statements.count, source_work)
                            matches <- matches + 1
                            width <- proof_signed_type_width_with_work(return_type, declarations, 0, source_work)
                            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            body.clear()
                            body.extend(statements)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_typed_return_signed_width(nested, owner, owner_line, width, body, matches, source_work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_typed_return_find_source_with_work(body: darray[Ast::Stmt]&, value: Ast::Expr, position: Ast::Pos, matches: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_TYPED_RETURN_DEPTH_LIMIT
            for statement in body |body, value, position, matches, source_work, depth|:
                return false if not proof_type_audit_work_charge(1, source_work)
                match statement:
                    Ast::Stmt.Return(returned, return_position):
                        if proof_replay_typed_return_pos_equal(return_position, position):
                            return false if:
                                not proof_replay_summary_expr_equal_with_work(returned, value, source_work)
                                not proof_replay_summary_expr_repeat_charge_with_work(returned, 1, source_work) or not proof_replay_summary_expr_repeat_charge_with_work(value, 1, source_work)
                            if proof_replay_local_binding_expr_positions_match(returned, value):
                                matches <- matches + 1
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return false if:
                            not proof_replay_typed_return_find_source_with_work(then_body, value, position, matches, source_work, depth + 1)
                            not proof_replay_typed_return_find_source_with_work(else_body, value, position, matches, source_work, depth + 1)
                    Ast::Stmt.While(_, nested, _) | Ast::Stmt.For(_, _, _, nested, _) | Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_typed_return_find_source_with_work(nested, value, position, matches, source_work, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        return false if arms.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + arms.count
                        for arm in arms |arm, value, position, matches, source_work, depth|:
                            return false if not proof_replay_typed_return_find_source_with_work(arm.body, value, position, matches, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_local_binding_typed_return_constant_source_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or report.analysis_2.replay_owner_line == 0 or report.analysis_2.trace_owner_line != trace.line
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol, _), TokenKind.EqEq, value, _):
                    return false if not proof_internal_name_is_rebind(symbol) or not proof_replay_summary_expr_repeat_charge_with_work(value, 2, source_work) or not proof_closed_integer_arithmetic(value, 0)
                    width: mutable i64 = 0
                    declaration_matches: mutable usize = 0
                    body: mutable darray[Ast::Stmt] = []
                    return false if:
                        not proof_replay_typed_return_signed_width(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, &width, &body, &declaration_matches, source_work, 0)
                        declaration_matches != 1 or width <= 0 or not proof_signed_constant_at_width(value, width, 0).known
                    position: Ast::Pos = Ast::expr_pos(trace.expression)
                    return false if position.line != trace.line
                    source_matches: mutable usize = 0
                    return false if not proof_replay_typed_return_find_source_with_work(body, value, position, &source_matches, source_work, 0)
                    return source_matches == 1
                _:
                    return false

# A closed constant returned from a signed function is bound to a fresh proof symbol carrying
# the declared return type (`symbol == constant`, see proof_add_typed_return_constant), so the
# ensure compares typed values instead of ambiguous bare constants. The symbol is a definition;
# replay accepts it only when
#   - its owner function is the certificate's owner and declares a signed integer return type
#     whose width holds the constant (so the symbol's type facts stay consistent with it);
#   - the symbol sits at exactly one source return of that function (or the function's tail
#     expression) whose value is the constant on every arm of any conditional, at the same
#     source positions, or a named constant whose validated global-constant fact gives it;
#   - no other local-binding or summary of the function gives the symbol another value or site
#     (the uniqueness rule shared with literal-argument definitions);
#   - and it is consumed only by certificates at its own return line.
extend ElisaProof:
    private:
        def proof_replay_typed_return_owner_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, return_type: mutable Ast::Expr&, body: mutable darray[Ast::Stmt]&, matches: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, return_type, body, matches, source_work, depth|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, declared_return, statements, _, _, position):
                        return false if:
                            not proof_replay_source_work_charge_or_exhaust(sview_len(name), source_work)
                            not proof_replay_source_work_charge_or_exhaust(sview_len(owner), source_work)
                        if name == owner and position.line == owner_line:
                            return false if not proof_replay_source_work_charge_or_exhaust(statements.count, source_work)
                            matches <- matches + 1
                            return_type <- declared_return
                            body.clear()
                            body.extend(statements)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_typed_return_owner_with_work(nested, owner, owner_line, return_type, body, matches, source_work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

        # The source return value, or one arm of its conditional, is the bound constant.
        # A named constant matches through a validated global-constant fact of the owner.
        def proof_replay_typed_return_value_matches_with_work(report: ProofReport&, trace: ProofFactTrace, source: Ast::Expr, value: Ast::Expr, source_work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
                source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work <- source_work + 1
            if proof_replay_expr_equal_with_work(source, value, source_work):
                return false if not proof_replay_summary_expr_repeat_charge_with_work(source, 1, source_work) or not proof_replay_summary_expr_repeat_charge_with_work(value, 1, source_work)
                return true if proof_replay_local_binding_expr_positions_match(value, source)
            match source:
                Ast::Expr.If(_, then_value, else_value, _):
                    then_matches: bool = proof_replay_typed_return_value_matches_with_work(report, trace, then_value, value, source_work, depth + 1)
                    return false if not then_matches
                    proof_replay_typed_return_value_matches_with_work(report, trace, else_value, value, source_work, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_typed_return_value_matches_with_work(report, trace, inner, value, source_work, depth + 1)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    return proof_replay_summary_call_global_constant_matches_with_work(report, trace, source, value, source_work)
                _:
                    return false

        # Count the source returns at `position` whose value is `value`; `at_tail` admits the
        # function's final expression statement, which the producer checks as a return.
        def proof_replay_typed_return_sites_with_work(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&, position: Ast::Pos, value: Ast::Expr, at_tail: bool, found: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            index: mutable usize = 0
            body_count: usize = body.count
            for statement in body |report, trace, body_count, position, value, at_tail, found, source_work, depth, index|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                index <- index + 1
                match statement:
                    Ast::Stmt.Return(source_value, statement_position):
                        if proof_replay_source_position_equal(statement_position, position):
                            if proof_replay_typed_return_value_matches_with_work(report, trace, source_value, value, source_work, 0):
                                found <- found + 1
                    Ast::Stmt.Expr(source_value, statement_position):
                        if at_tail and index == body_count and proof_replay_source_position_equal(statement_position, position):
                            if proof_replay_typed_return_value_matches_with_work(report, trace, source_value, value, source_work, 0):
                                found <- found + 1
                    Ast::Stmt.If(_, yes, no, _):
                        return false if:
                            not proof_replay_typed_return_sites_with_work(report, trace, yes, position, value, false, found, source_work, depth + 1)
                            not proof_replay_typed_return_sites_with_work(report, trace, no, position, value, false, found, source_work, depth + 1)
                    Ast::Stmt.While(_, nested, _) | Ast::Stmt.For(_, _, _, nested, _) | Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_typed_return_sites_with_work(report, trace, nested, position, value, false, found, source_work, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        return false if arms.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + arms.count
                        for arm in arms |arm, report, trace, position, value, found, source_work, depth|:
                            return false if not proof_replay_typed_return_sites_with_work(report, trace, arm.body, position, value, false, found, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_local_binding_typed_return_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_local_binding_typed_return_source_with_work(report, trace, &work)

        def proof_replay_local_binding_typed_return_source_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or trace.line == 0
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, value, _):
                    return false if not proof_internal_name_is_rebind(symbol) or symbol_position.line != trace.line
                    owner_line: u32 = proof_replay_trace_owner_source_position_line_for_trace_with_work(report, trace, source_work)
                    return false if owner_line == 0 or owner_line != report.analysis_2.replay_owner_line
                    return_type: mutable Ast::Expr = Ast::Expr.Absent
                    body: mutable darray[Ast::Stmt] = []
                    matches: mutable usize = 0
                    return false if:
                        not proof_replay_typed_return_owner_with_work(report.source.source_declarations, trace.name, owner_line, &return_type, &body, &matches, source_work, 0) or matches != 1
                        not proof_replay_summary_expr_repeat_charge_with_work(value, 2, source_work)
                    width: i64 = proof_signed_type_width_with_work(return_type, report.source.source_declarations, 0, source_work)
                    return false if width <= 0 or not proof_signed_constant_at_width(value, width, 0).known
                    found: mutable usize = 0
                    return false if:
                        not proof_replay_typed_return_sites_with_work(report, trace, body, symbol_position, value, true, &found, source_work, 0)
                        found != 1
                    return proof_replay_rebind_definition_unique_with_work(report, trace, symbol, symbol_position, value, false, source_work)
                _:
                    return false
