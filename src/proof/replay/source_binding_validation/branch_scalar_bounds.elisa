# Reconstruct a scalar upper bound from both source branch arms. No arm-local
# binding trace is promoted past its write; every reaching value has its own
# source contract. Keep calls, arithmetic, loops and aliases outside this route.
extend ElisaProof:
    private:
        def proof_replay_branch_value_bound(report: ProofReport&, owner: sview, value: Ast::Expr, type_name: sview, bound: i64, requirements: darray[Ast::Expr]&, source_work: mutable usize&) -> bool:
            match value:
                Ast::Expr.IntLit(number, _):
                    return false if number < 0 or number > bound
                    width: i64 = proof_unsigned_type_width_with_work(Ast::Expr.Ident(type_name, Ast::expr_pos(value)), report.source_declarations, 0, source_work)
                    return width >= 63 or (width > 0 and number <= proof_unsigned_width_max(width))
                Ast::Expr.Ident(name, _):
                    return false if not proof_replay_local_binding_parameter_source_unshadowed_with_work(report.source_declarations, owner, report.replay_owner_line, name, source_work)
                    return false if not proof_replay_local_binding_immutable_integer_parameter_with_work(report.source_declarations, owner, report.replay_owner_line, name, source_work, 0)
                    parameter_type: sview = proof_replay_local_binding_unsigned_parameter_type_name_with_work(report.source_declarations, owner, report.replay_owner_line, name, source_work, 0)
                    return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or parameter_type != type_name
                    for requirement in requirements |name, bound, source_work|:
                        return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                        match requirement:
                            Ast::Expr.Binary(Ast::Expr.Ident(input, _), operator, Ast::Expr.IntLit(limit, _), _):
                                continue if input != name or limit < 0
                                return true if operator == TokenKind.LtEq and limit <= bound
                                return true if operator == TokenKind.Lt and limit > 0 and limit - 1 <= bound
                            _:
                                pass
                    return false
                _:
                    return false

        def proof_replay_branch_scalar_bound_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            source_work: mutable usize = 0
            return false if trace.kind != "branch-join" or trace.line == 0 or trace.line > report.trace_owner_line
            return false if trace.dependency != "" or trace.summary_bindings_count != 0 or trace.summary_requires_count != 0 or trace.summary_ensure_index != 0
            return false if proof_replay_summary_has_unresolved_import(report.source_annotations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            return false if proof_replay_summary_has_unresolved_declaration_import(report.source_declarations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
            target: mutable sview = ""
            bound: mutable i64 = -1
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(name, _), TokenKind.LtEq, Ast::Expr.IntLit(limit, _), _):
                    target <- name
                    bound <- limit
                _:
                    return false
            return false if bound < 0 or proof_source_expression_has_overloaded_operator(trace.expression, report.source_primitive_operator_mask, 0)
            return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
            context = ElisaProofFrameSource::owner(&report.source_declarations, trace.name, report.replay_owner_line)
            return false if not context.known or context.body.count > 4096
            return false if not ElisaProofFrameSource::index_copy_environment(report.source_declarations)
            return false if proof_replay_index_copy_formal_name_present_with_work(context.formals, target, source_work)
            return false if not proof_replay_source_single_declaration_with_work(report.source_declarations, context.body, target, source_work)
            requirements: mutable darray[Ast::Expr] = []
            declared: mutable bool = false
            joined: mutable bool = false
            type_name: mutable sview = ""
            initial: mutable Ast::Expr = Ast::Expr.Invalid
            for statement in context.body |report, trace, target, bound, requirements, declared, joined, type_name, initial, source_work|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match statement:
                    Ast::Stmt.Contract(kind, proposition, _):
                        return false if declared or joined
                        requirements.push(proposition) if kind == "requires"
                        return false if kind != "requires" and kind != "ensure" and kind != "ensures"
                    Ast::Stmt.VarDecl(name, type_expression, initializer, _):
                        return false if declared or joined or name != target
                        type_name <- proof_replay_local_binding_unsigned_type_name(type_expression, 0)
                        return false if type_name == "" or not proof_replay_local_binding_mutable_integer_type(type_expression)
                        return false if not proof_replay_scalar_copy_type_unshadowed(report.source_declarations, type_name, 0, &source_work)
                        return false if not proof_replay_scalar_copy_type_unshadowed(report.source_declarations, "bool", 0, &source_work)
                        initial <- initializer
                        declared <- true
                    Ast::Stmt.If(Ast::Expr.Ident(condition, _), yes, no, position):
                        return false if not declared or joined or position.line != trace.line
                        return false if yes.count > 1 or no.count > 1
                        return false if not proof_replay_local_binding_parameter_source_unshadowed_with_work(report.source_declarations, trace.name, report.replay_owner_line, condition, source_work)
                        condition_matches: mutable usize = 0
                        for index in 0..<context.formals.count |context, condition, condition_matches, source_work|:
                            return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                            condition_matches <- condition_matches + 1 if context.formals[index] == condition and proof_ident_name(context.formal_types[index]) == "bool"
                        return false if condition_matches != 1
                        for arm in [yes, no] |report, trace, target, bound, requirements, type_name, initial, source_work|:
                            reaching: mutable Ast::Expr = initial
                            if arm.count == 1:
                                match arm[0]:
                                    Ast::Stmt.Assign(Ast::Expr.Ident(name, _), operator, value, _):
                                        return false if name != target or (operator != TokenKind.LArrow and operator != TokenKind.Assign)
                                        reaching <- value
                                    _:
                                        return false
                            return false if not proof_replay_branch_value_bound(report, trace.name, reaching, type_name, bound, requirements, source_work)
                        joined <- true
                    Ast::Stmt.Expr(Ast::Expr.Ident(name, _), _) | Ast::Stmt.Return(Ast::Expr.Ident(name, _), _):
                        return false if not joined or name != target
                    _:
                        return false
            joined
