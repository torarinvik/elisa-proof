# A first, identity-only for update captures the loop's current scalar value.
# Its equation is available solely in the exact original preservation goal.
extend ElisaProof:
    private:
        def proof_replay_for_identity_loop(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, statement: Ast::Stmt, target: sview, symbol: Ast::Expr, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64
            match statement:
                Ast::Stmt.Expr(Ast::Expr.Block(statements, _, captures, _), _):
                    return false if:
                        statements.count != 1
                        captures.count != 1 or captures[0] != target
                    return proof_replay_for_identity_loop(report, trace, certificate, statements[0], target, symbol, source_work, depth + 1)
                Ast::Stmt.For(bind, variables, iterable, body, position):
                    return false if:
                        bind != "" or variables.count != 1 or variables[0] == target or position.line != certificate.line
                        body.count != 2
                    # Both legacy classifiers recurse over the complete iterable. Debit its
                    # metered structural cost before each traversal, including on the early
                    # call-found path.
                    return false if:
                        not proof_replay_summary_expr_charge_with_work(iterable, source_work)
                        proof_expr_has_call(iterable)
                        not proof_replay_summary_expr_charge_with_work(iterable, source_work)
                        proof_source_expression_has_overloaded_operator(iterable, report.source.source_primitive_operator_mask, 0)
                    match body[1]:
                        Ast::Stmt.Assign(Ast::Expr.Ident(assigned, _), TokenKind.LArrow, Ast::Expr.Ident(value, _), assignment_position):
                            return false if:
                                assigned != target or value != target or assignment_position.line != trace.line
                                not proof_replay_local_binding_pos_matches(trace.expression, assignment_position)
                                not proof_replay_local_binding_pos_matches(symbol, assignment_position)
                        _:
                            return false
                    match body[0]:
                        Ast::Stmt.Contract("invariant", expression, _):
                            return false if:
                                not proof_replay_summary_expr_charge_with_work(expression, source_work)
                                proof_source_expression_has_overloaded_operator(expression, report.source.source_primitive_operator_mask, 0)
                            normalized: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, expression, source_work, 0)
                            expected: Ast::Expr = proof_replay_substitute(normalized, target, symbol)
                            return false if not proof_replay_summary_expr_equal_with_work(expected, certificate.goal, source_work)
                            # Entry certificates contain no loop invariant. Preservation must
                            # carry this exact source invariant, not an arbitrary stamped fact.
                            for index in 0..<certificate.facts_count |report, certificate, normalized, position, source_work|:
                                origin: usize = report.analysis_1.traces.origin_indices[certificate.facts_start + index]
                                continue if origin >= report.analysis_1.traces.records.count
                                fact: ProofFactTrace = report.analysis_1.traces.records[origin]
                                return true if fact.kind == "loop-invariant" and fact.name == trace.name and fact.line == position.line and proof_replay_source_position_equal(fact.loop_source_position, position) and proof_replay_summary_expr_equal_with_work(fact.expression, normalized, source_work)
                            return false
                        _:
                            return false
                _:
                    return false

        def proof_replay_for_identity_initializer(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, expression: Ast::Expr, target: sview, symbol: Ast::Expr, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64
            match expression:
                Ast::Expr.Block(statements, value, captures, _):
                    return false if captures.count != 0
                    return proof_replay_for_identity_initializer(report, trace, certificate, value, target, symbol, source_work, depth + 1) if statements.count == 0
                    return false if statements.count != 2
                    match value:
                        Ast::Expr.Ident(yielded, _):
                            return false if yielded != target
                        _:
                            return false
                    match statements[0]:
                        Ast::Stmt.VarDecl(local, type_expression, _, _):
                            return false if local != target or proof_replay_local_binding_unsigned_type_name(type_expression, 0) == ""
                        _:
                            return false
                    return proof_replay_for_identity_loop(report, trace, certificate, statements[1], target, symbol, source_work, 0)
                _:
                    return false

        def proof_replay_for_identity_update_source(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                certificate.name != trace.name or certificate.rule != "goal" or certificate.line != report.analysis_2.trace_owner_line
                certificate.facts_start > report.analysis_1.traces.origin_indices.count or certificate.facts_count > report.analysis_1.traces.origin_indices.count - certificate.facts_start
                not proof_replay_captured_entry_environment_with_source_work(report.source.source_declarations, source_work)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol_name, symbol_position), TokenKind.EqEq, Ast::Expr.Ident(target, _), _):
                    return false if symbol_name != proof_internal_rebind_name(0) or target == "" or proof_internal_name_is_rebind(target)
                    context = ElisaProofFrameSource::owner(&report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line)
                    return false if not context.known or context.body.count > 4096
                    symbol: Ast::Expr = Ast::Expr.Ident(symbol_name, symbol_position)
                    # A sole returned/bound loop value has its header declaration inside
                    # the value block, before the first source update.
                    if context.body.count == 1:
                        match context.body[0]:
                            Ast::Stmt.Return(returned, _):
                                if returned is expression:
                                    return proof_replay_for_identity_initializer(report, trace, certificate, expression, target, symbol, source_work, 0)
                            _:
                                pass
                    if context.body.count == 2:
                        match context.body[0]:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return true if proof_replay_for_identity_initializer(report, trace, certificate, initializer, target, symbol, source_work, 0)
                            _:
                                pass
                    prefix_unambiguous: mutable bool = true
                    for index in 0..<context.body.count |index, report, trace, certificate, context, target, symbol, source_work, prefix_unambiguous|:
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        source_work <- source_work + 1
                        if index >= 2 and prefix_unambiguous:
                            prefix_unambiguous <- proof_replay_local_binding_first_rebind_prefix_statement_with_work(context.body[index - 2], source_work)
                            return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        continue if index == 0
                        continue if not prefix_unambiguous
                        match context.body[index - 1]:
                            Ast::Stmt.VarDecl(local, type_expression, _, _):
                                continue if local != target or not proof_replay_local_binding_mutable_integer_type(type_expression)
                                continue if proof_replay_local_binding_unsigned_type_name(type_expression, 0) == ""
                                return true if proof_replay_for_identity_loop(report, trace, certificate, context.body[index], target, symbol, source_work, 0)
                            _:
                                pass
                    return false
                _:
                    return false
