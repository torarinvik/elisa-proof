# A first, identity-only for update captures the loop's current scalar value.
# Its equation is available solely in the exact original preservation goal.
extend ElisaProof:
    private:
        def proof_replay_for_identity_loop(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, statement: Ast::Stmt, target: sview, symbol: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 64
            match statement:
                Ast::Stmt.Expr(Ast::Expr.Block(statements, _, captures, _), _):
                    return false if statements.count != 1
                    return false if captures.count != 1 or captures[0] != target
                    return proof_replay_for_identity_loop(report, trace, certificate, statements[0], target, symbol, depth + 1)
                Ast::Stmt.For(bind, variables, iterable, body, position):
                    return false if bind != "" or variables.count != 1 or variables[0] == target or position.line != certificate.line
                    return false if body.count != 2 or proof_expr_has_call(iterable)
                    return false if proof_source_expression_has_overloaded_operator(iterable, report.source_primitive_operator_mask, 0)
                    match body[1]:
                        Ast::Stmt.Assign(Ast::Expr.Ident(assigned, _), TokenKind.LArrow, Ast::Expr.Ident(value, _), assignment_position):
                            return false if assigned != target or value != target or assignment_position.line != trace.line
                            return false if not proof_replay_local_binding_pos_matches(trace.expression, assignment_position)
                            return false if not proof_replay_local_binding_pos_matches(symbol, assignment_position)
                        _:
                            return false
                    match body[0]:
                        Ast::Stmt.Contract("invariant", expression, _):
                            return false if proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
                            normalized: Ast::Expr = proof_replay_local_initializer_constants(report, trace, expression, 0)
                            expected: Ast::Expr = proof_replay_substitute(normalized, target, symbol)
                            return false if not proof_replay_expr_equal(expected, certificate.goal)
                            # Entry certificates contain no loop invariant. Preservation must
                            # carry this exact source invariant, not an arbitrary stamped fact.
                            for index in 0..<certificate.facts_count |report, certificate, normalized, position|:
                                origin: usize = report.traces.origin_indices[certificate.facts_start + index]
                                continue if origin >= report.traces.records.count
                                fact: ProofFactTrace = report.traces.records[origin]
                                return true if fact.kind == "loop-invariant" and fact.name == trace.name and fact.line == position.line and proof_replay_expr_equal(fact.expression, normalized)
                            return false
                        _:
                            return false
                _:
                    return false

        def proof_replay_for_identity_initializer(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, expression: Ast::Expr, target: sview, symbol: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 64
            match expression:
                Ast::Expr.Block(statements, value, captures, _):
                    return false if captures.count != 0
                    return proof_replay_for_identity_initializer(report, trace, certificate, value, target, symbol, depth + 1) if statements.count == 0
                    return false if statements.count != 2
                    match value:
                        Ast::Expr.Ident(yielded, _):
                            return false if yielded != target
                        _:
                            return false
                    match statements[0]:
                        Ast::Stmt.VarDecl(local, type_expression, _, _):
                            return false if local != target or proof_replay_local_binding_unsigned_type_name(type_expression, 0) == ""
                        _:
                            return false
                    return proof_replay_for_identity_loop(report, trace, certificate, statements[1], target, symbol, 0)
                _:
                    return false

        def proof_replay_for_identity_update_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.rule != "goal" or certificate.line != report.trace_owner_line
            return false if certificate.facts_start > report.traces.origin_indices.count or certificate.facts_count > report.traces.origin_indices.count - certificate.facts_start
            work: mutable usize = 0
            return false if not proof_replay_captured_entry_environment(&report.source_declarations, 0, &work)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol_name, symbol_position), TokenKind.EqEq, Ast::Expr.Ident(target, _), _):
                    return false if symbol_name != proof_internal_rebind_name(0) or target == "" or proof_internal_name_is_rebind(target)
                    context = ElisaProofFrameSource::owner(&report.source_declarations, trace.name, report.replay_owner_line)
                    return false if not context.known or context.body.count > 4096
                    symbol: Ast::Expr = Ast::Expr.Ident(symbol_name, symbol_position)
                    # A sole returned/bound loop value has its header declaration inside
                    # the value block, before the first source update.
                    if context.body.count == 1:
                        match context.body[0]:
                            Ast::Stmt.Return(returned, _):
                                if returned is expression:
                                    return proof_replay_for_identity_initializer(report, trace, certificate, expression, target, symbol, 0)
                            _:
                                pass
                    if context.body.count == 2:
                        match context.body[0]:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return true if proof_replay_for_identity_initializer(report, trace, certificate, initializer, target, symbol, 0)
                            _:
                                pass
                    for index in 0..<context.body.count |index, report, trace, certificate, context, target, symbol|:
                        continue if index == 0
                        continue if not proof_replay_local_binding_first_rebind_is_unambiguous(context.body, index, 0)
                        match context.body[index - 1]:
                            Ast::Stmt.VarDecl(local, type_expression, _, _):
                                continue if local != target or not proof_replay_local_binding_mutable_integer_type(type_expression)
                                continue if proof_replay_local_binding_unsigned_type_name(type_expression, 0) == ""
                                return true if proof_replay_for_identity_loop(report, trace, certificate, context.body[index], target, symbol, 0)
                            _:
                                pass
                    return false
                _:
                    return false
