# A header accumulator's initial equality is available at its invariant entry,
# not during preservation or after the loop. Reconstruct the parser's returned
# block and the exact original invariant; a local-binding tag alone grants none.
extend ElisaProof:
    private:
        def proof_replay_captured_entry_environment(declarations: darray[Ast::Decl]&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64
            for declaration in declarations |depth, work|:
                return false if work >= 4096
                work <- work + 1
                match declaration:
                    Ast::Decl.Import(_, _) | Ast::Decl.Scoped(_, _):
                        return false
                    Ast::Decl.Module(_, nested, _):
                        return false if not proof_replay_captured_entry_environment(nested, depth + 1, work)
                    Ast::Decl.Alias(name, _, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        return false if proof_replay_local_binding_integer_type(Ast::Expr.Ident(name, Ast::pos_at_line(0)), 0)
                    _:
                        pass
            return true

        def proof_replay_captured_entry_environment_with_source_work(declarations: darray[Ast::Decl]&, source_work: mutable usize&) -> bool:
            bounded_work: mutable usize = 0
            proof_replay_captured_entry_environment_with_work_depth(declarations, 0, &bounded_work, source_work)

        def proof_replay_captured_entry_environment_with_work_depth(declarations: darray[Ast::Decl]&, depth: usize, bounded_work: mutable usize&, source_work: mutable usize&) -> bool:
            return false if depth >= 64
            for declaration in declarations |depth, bounded_work, source_work|:
                return false if bounded_work >= 4096 or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                bounded_work <- bounded_work + 1
                source_work <- source_work + 1
                match declaration:
                    Ast::Decl.Import(_, _) | Ast::Decl.Scoped(_, _):
                        return false
                    Ast::Decl.Module(_, nested, _):
                        return false if not proof_replay_captured_entry_environment_with_work_depth(nested, depth + 1, bounded_work, source_work)
                    Ast::Decl.Alias(name, _, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        return false if proof_replay_local_binding_integer_type(Ast::Expr.Ident(name, Ast::pos_at_line(0)), 0)
                    _:
                        pass
            return true

        def proof_replay_captured_entry_position(left: Ast::Expr, right: Ast::Expr) -> bool:
            a: Ast::Pos = Ast::expr_pos(left)
            b: Ast::Pos = Ast::expr_pos(right)
            return a.line == b.line and a.column == b.column and a.offset == b.offset and a.end_line == b.end_line and a.end_column == b.end_column and a.end_offset == b.end_offset

        def proof_replay_captured_entry_no_loop_facts(report: ProofReport&, certificate: ProofGoalCertificate, source_work: mutable usize&) -> bool:
            return false if certificate.facts_start > report.traces.origin_indices.count or certificate.facts_count > report.traces.origin_indices.count - certificate.facts_start
            for index in 0..<certificate.facts_count |index, report, certificate, source_work|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                origin: usize = report.traces.origin_indices[certificate.facts_start + index]
                return false if origin >= report.traces.records.count
                trace: ProofFactTrace = report.traces.records[origin]
                return false if trace.name == certificate.name and (trace.kind in {"loop-invariant", "loop-condition"})
            return true

        def proof_replay_captured_entry_block(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, statements: darray[Ast::Stmt]&, value: Ast::Expr, target: sview, source_value: Ast::Expr, source_work: mutable usize&) -> bool:
            return false if statements.count != 2
            match value:
                Ast::Expr.Ident(yield_name, _):
                    return false if yield_name != target
                _:
                    return false
            match statements[0]:
                Ast::Stmt.VarDecl(local, type_expression, initializer, position):
                    return false if:
                        local != target or not proof_replay_local_binding_integer_type(type_expression, 0)
                        position.line != trace.line or not proof_replay_local_binding_pos_matches(trace.expression, position)
                    match trace.expression:
                        Ast::Expr.Binary(left, TokenKind.EqEq, _, _):
                            return false if not proof_replay_local_binding_pos_matches(left, position)
                        _:
                            return false
                    normalized: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, initializer, source_work, 0)
                    return false if not proof_replay_summary_expr_equal_with_work(normalized, source_value, source_work)
                    match normalized:
                        Ast::Expr.IntLit(_, _):
                            pass
                        _:
                            return false
                _:
                    return false
            match statements[1]:
                Ast::Stmt.For(bind, variables, iterable, body, position):
                    return false if bind != "" or variables.count != 1 or variables[0] == target or position.line != certificate.line
                    # These two source classifiers each recurse through the untrusted range.
                    return false if:
                        not proof_replay_summary_expr_charge_with_work(iterable, source_work)
                        proof_expr_has_call(iterable)
                        not proof_replay_summary_expr_charge_with_work(iterable, source_work)
                        proof_source_expression_has_overloaded_operator(iterable, report.source_primitive_operator_mask, 0)
                    invariants: mutable usize = 0
                    matching: mutable usize = 0
                    for statement in body |report, trace, certificate, invariants, matching, source_work|:
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        source_work <- source_work + 1
                        match statement:
                            Ast::Stmt.Contract("invariant", expression, _):
                                invariants <- invariants + 1
                                expected: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, expression, source_work, 0)
                                if proof_replay_summary_expr_equal_with_work(expected, certificate.goal, source_work) and proof_replay_captured_entry_position(expression, certificate.goal):
                                    matching <- matching + 1
                            _:
                                pass
                    return invariants == 1 and matching == 1
                _:
                    return false

        # A bare value block can wrap the loop value in an empty block. Peel
        # only empty, capture-free wrappers; each nonempty scope stays exact.
        def proof_replay_captured_entry_initializer(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, expression: Ast::Expr, target: sview, source_value: Ast::Expr, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64
            match expression:
                Ast::Expr.Block(statements, value, captures, _):
                    # Unrelated captures do not alter the fresh accumulator's
                    # literal initialization. Never capture its own outer name,
                    # and never peel an empty wrapper carrying capture effects.
                    return false if any capture in captures where capture == target
                    if statements.count == 0:
                        return false if captures.count != 0
                        return proof_replay_captured_entry_initializer(report, trace, certificate, value, target, source_value, source_work, depth + 1)
                    return proof_replay_captured_entry_block(report, trace, certificate, statements, value, target, source_value, source_work)
                _:
                    return false

        # Assignment initializers execute in their own local scope. Locate the
        # original nested site without treating an outer binding of the same
        # name as the fresh accumulator's reaching definition.
        def proof_replay_captured_assignment_entries(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, body: darray[Ast::Stmt]&, target: sview, source_value: Ast::Expr, depth: usize, work: mutable usize&, source_work: mutable usize&, matches: mutable usize&) -> bool:
            return false if depth >= 64 or body.count > 4096
            for statement in body |report, trace, certificate, target, source_value, depth, work, source_work, matches|:
                return false if:
                    work >= 4096
                    source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                work <- work + 1
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Assign(Ast::Expr.Ident(_, _), TokenKind.LArrow, initializer, _):
                        matches <- matches + 1 if proof_replay_captured_entry_initializer(report, trace, certificate, initializer, target, source_value, source_work, 0)
                    Ast::Stmt.If(_, yes, no, _):
                        return false if:
                            not proof_replay_captured_assignment_entries(report, trace, certificate, yes, target, source_value, depth + 1, work, source_work, matches)
                            not proof_replay_captured_assignment_entries(report, trace, certificate, no, target, source_value, depth + 1, work, source_work, matches)
                    Ast::Stmt.Block(_, _, _, inner, _) | Ast::Stmt.While(_, inner, _) | Ast::Stmt.For(_, _, _, inner, _):
                        return false if not proof_replay_captured_assignment_entries(report, trace, certificate, inner, target, source_value, depth + 1, work, source_work, matches)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |report, trace, certificate, target, source_value, depth, work, source_work, matches|:
                            return false if not proof_replay_captured_assignment_entries(report, trace, certificate, arm.body, target, source_value, depth + 1, work, source_work, matches)
                    Ast::Stmt.Expr(Ast::Expr.Block(inner, _, _, _), _) | Ast::Stmt.VarDecl(_, _, Ast::Expr.Block(inner, _, _, _), _):
                        return false if not proof_replay_captured_assignment_entries(report, trace, certificate, inner, target, source_value, depth + 1, work, source_work, matches)
                    _:
                        pass
            return true

        def proof_replay_captured_loop_entry_source(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count or report.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if:
                certificate.name != trace.name or certificate.line != trace.line or certificate.rule != "goal"
                not proof_replay_captured_entry_no_loop_facts(report, certificate, source_work)
                not proof_replay_captured_entry_environment_with_source_work(report.source_declarations, source_work)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(target, _), TokenKind.EqEq, source_value, _):
                    return false if:
                        target == "" or proof_internal_name_is_rebind(target)
                        proof_replay_local_binding_parameter_name_present_with_default_limit(report.source_declarations, trace.name, report.replay_owner_line, target, source_work, 0)
                    context = ElisaProofFrameSource::owner(&report.source_declarations, trace.name, report.replay_owner_line)
                    return false if not context.known
                    matches: mutable usize = 0
                    assignment_work: mutable usize = 0
                    return false if not proof_replay_captured_assignment_entries(report, trace, certificate, context.body, target, source_value, 0, &assignment_work, source_work, &matches)
                    return matches == 1 if matches > 0
                    for statement in context.body |report, trace, certificate, target, source_value, matches, source_work|:
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        source_work <- source_work + 1
                        match statement:
                            Ast::Stmt.VarDecl(local, _, initializer, _):
                                match initializer:
                                    Ast::Expr.Block(statements, value, captures, _):
                                        return false if any capture in captures where capture == target
                                        entry_matches: bool = proof_replay_captured_entry_initializer(report, trace, certificate, initializer, target, source_value, source_work, 0)
                                        return false if local == target and not entry_matches
                                        matches <- matches + 1 if entry_matches
                                    _:
                                        return false if local == target
                            Ast::Stmt.Return(returned, _):
                                if returned is expression:
                                    match expression:
                                        Ast::Expr.Block(statements, value, captures, _):
                                            return false if any capture in captures where capture == target
                                            matches <- matches + 1 if proof_replay_captured_entry_block(report, trace, certificate, statements, value, target, source_value, source_work)
                                        _:
                                            pass
                            _:
                                pass
                    return matches == 1
                _:
                    return false
