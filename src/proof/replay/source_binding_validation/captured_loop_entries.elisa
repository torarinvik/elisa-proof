# A header accumulator's initial equality is available at its invariant entry,
# not during preservation or after the loop. Reconstruct the parser's returned
# block and the exact original invariant; a local-binding tag alone grants none.
extend ElisaProof:
    private:
        def proof_replay_captured_entry_environment(declarations: darray[Ast::Decl]&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64
            for declaration in declarations |depth, work|:
                return false if work >= 4096
                work <- work + 1
                match declaration:
                    Ast::Decl.Import(_, _) | Ast::Decl.Scoped(_, _):
                        return false
                    Ast::Decl.Module(_, nested, _):
                        return false if not proof_replay_captured_entry_environment(nested, depth + 1, work)
                    Ast::Decl.Alias(name, _, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _):
                        return false if proof_replay_local_binding_integer_type(Ast::Expr.Ident(name, Ast::pos_at_line(0)), 0)
                    _:
                        pass
            return true

        def proof_replay_captured_entry_position(left: Ast::Expr, right: Ast::Expr) -> bool:
            a: Ast::Pos = Ast::expr_pos(left)
            b: Ast::Pos = Ast::expr_pos(right)
            return a.line == b.line and a.column == b.column and a.offset == b.offset and a.end_line == b.end_line and a.end_column == b.end_column and a.end_offset == b.end_offset

        def proof_replay_captured_entry_no_loop_facts(report: ProofReport&, certificate: ProofGoalCertificate) -> bool:
            return false if certificate.facts_start > report.traces.origin_indices.count or certificate.facts_count > report.traces.origin_indices.count - certificate.facts_start
            for index in 0..<certificate.facts_count |index, report, certificate|:
                origin: usize = report.traces.origin_indices[certificate.facts_start + index]
                return false if origin >= report.traces.records.count
                trace: ProofFactTrace = report.traces.records[origin]
                return false if trace.name == certificate.name and (trace.kind == "loop-invariant" or trace.kind == "loop-condition")
            return true

        def proof_replay_captured_entry_block(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, statements: darray[Ast::Stmt]&, value: Ast::Expr, target: sview, source_value: Ast::Expr) -> bool:
            return false if statements.count != 2
            match value:
                Ast::Expr.Ident(yield_name, _):
                    return false if yield_name != target
                _:
                    return false
            match statements[0]:
                Ast::Stmt.VarDecl(local, type_expression, initializer, position):
                    return false if local != target or not proof_replay_local_binding_integer_type(type_expression, 0)
                    return false if position.line != trace.line or not proof_replay_local_binding_pos_matches(trace.expression, position)
                    match trace.expression:
                        Ast::Expr.Binary(left, TokenKind.EqEq, _, _):
                            return false if not proof_replay_local_binding_pos_matches(left, position)
                        _:
                            return false
                    normalized: Ast::Expr = proof_replay_local_initializer_constants(report, trace, initializer, 0)
                    return false if not proof_replay_expr_equal(normalized, source_value)
                    match normalized:
                        Ast::Expr.IntLit(_, _):
                            pass
                        _:
                            return false
                _:
                    return false
            match statements[1]:
                Ast::Stmt.For(bind, variables, iterable, body, position):
                    return false if bind != "" or variables.count != 1 or variables[0] == target or position.line != certificate.line
                    return false if proof_expr_has_call(iterable) or proof_source_expression_has_overloaded_operator(iterable, report.source_primitive_operator_mask, 0)
                    invariants: mutable usize = 0
                    matching: mutable usize = 0
                    for statement in body |report, trace, certificate, invariants, matching|:
                        match statement:
                            Ast::Stmt.Contract("invariant", expression, _):
                                invariants <- invariants + 1
                                expected: Ast::Expr = proof_replay_local_initializer_constants(report, trace, expression, 0)
                                if proof_replay_expr_equal(expected, certificate.goal) and proof_replay_captured_entry_position(expression, certificate.goal):
                                    matching <- matching + 1
                            _:
                                pass
                    return invariants == 1 and matching == 1
                _:
                    return false

        # A bare value block can wrap the loop value in an empty block. Peel
        # only empty, capture-free wrappers; each nonempty scope stays exact.
        def proof_replay_captured_entry_initializer(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, expression: Ast::Expr, target: sview, source_value: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 64
            match expression:
                Ast::Expr.Block(statements, value, captures, _):
                    return false if captures.count != 0
                    return proof_replay_captured_entry_initializer(report, trace, certificate, value, target, source_value, depth + 1) if statements.count == 0
                    return proof_replay_captured_entry_block(report, trace, certificate, statements, value, target, source_value)
                _:
                    return false

        def proof_replay_captured_loop_entry_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count or report.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != trace.line or certificate.rule != "goal"
            return false if not proof_replay_captured_entry_no_loop_facts(report, certificate)
            environment_work: mutable usize = 0
            return false if not proof_replay_captured_entry_environment(&report.source_declarations, 0, &environment_work)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(target, _), TokenKind.EqEq, source_value, _):
                    return false if target == "" or proof_internal_name_is_rebind(target)
                    return false if proof_replay_local_binding_parameter_name_present(report.source_declarations, trace.name, report.replay_owner_line, target, 0)
                    context = ElisaProofFrameSource::owner(&report.source_declarations, trace.name, report.replay_owner_line)
                    return false if not context.known
                    matches: mutable usize = 0
                    for statement in context.body |report, trace, certificate, target, source_value, matches|:
                        match statement:
                            Ast::Stmt.VarDecl(local, _, initializer, _):
                                match initializer:
                                    Ast::Expr.Block(statements, value, captures, _):
                                        return false if any capture in captures where capture == target
                                        entry_matches: bool = proof_replay_captured_entry_initializer(report, trace, certificate, initializer, target, source_value, 0)
                                        return false if local == target and not entry_matches
                                        matches <- matches + 1 if entry_matches
                                    _:
                                        return false if local == target
                            Ast::Stmt.Return(returned, _):
                                if returned is expression:
                                    match expression:
                                        Ast::Expr.Block(statements, value, captures, _):
                                            return false if any capture in captures where capture == target
                                            matches <- matches + 1 if proof_replay_captured_entry_block(report, trace, certificate, statements, value, target, source_value)
                                        _:
                                            pass
                            _:
                                pass
                    return matches == 1
                _:
                    return false
