# A self-referential update of an integer local (`x <- x + 1`) cannot be recorded over x's own
# symbol, so the producer binds the new value to a fresh reserved symbol `S == x + 1` and leaves
# `x` denoting the value it had (proof_bind_unsigned_symbol). Replay accepts that definition only
# when
#   - the local is a top-level, once-declared integer local of the certificate's owner;
#   - the equation sits at exactly one plain assignment `x <- value` of the owner outside any
#     loop body (a loop re-runs the statement; loop updates have their own route), pinned by the
#     statement span, whose value mentions x and is otherwise stable, and equals the source value;
#   - no other binding or summary of the owner defines S differently (the shared rule);
#   - x still denotes its old value at the consumer: no write of x between the assignment and
#     the consumer other than further resymbolized self-updates (the mutable-local liveness rule).
extend ElisaProof:
    private:
        # Whether `statement` is a self-referential plain assignment of `local_name` whose value the
        # producer bound to a fresh symbol (a rebind definition traced at its line in `owner`).
        def proof_replay_self_update_resymbolized(report: ProofReport&, owner: sview, statement: Ast::Stmt, local_name: sview) -> bool:
            source_work: mutable usize = 0
            return proof_replay_self_update_resymbolized_with_work(report, owner, statement, local_name, &source_work)

        def proof_replay_self_update_resymbolized_with_work(report: ProofReport&, owner: sview, statement: Ast::Stmt, local_name: sview, source_work: mutable usize&) -> bool:
            match statement:
                Ast::Stmt.Assign(Ast::Expr.Ident(name, _), operator, value, position):
                    return false if name != local_name or (operator != TokenKind.Assign and operator != TokenKind.LArrow)
                    return false if not proof_replay_mutable_local_statement_work_charge_fail_closed(statement, source_work, 0)
                    return false if not proof_replay_mutable_local_owner_preflight_work_charge(report, owner, report.replay_owner_line, source_work)
                    return false if not proof_replay_mutable_local_trace_work_charge_fail_closed(report, source_work, 1)
                    return false if not proof_expr_mentions_name(value, local_name) or proof_replay_source_expr_touches(report.source_declarations, value, local_name, true, 0)
                    for candidate in report.traces.records |candidate, report, owner, position, local_name, source_work|:
                        continue if candidate.kind != "local-binding" or candidate.name != owner or candidate.line != position.line
                        continue if proof_replay_trace_owner_source_position_line_for_trace_with_work(report, candidate, source_work) != report.replay_owner_line
                        match candidate.expression:
                            Ast::Expr.Binary(Ast::Expr.Ident(symbol, _), TokenKind.EqEq, bound, _):
                                return true if proof_internal_name_is_rebind(symbol) and proof_expr_mentions_name(bound, local_name) and proof_replay_local_binding_pos_matches(candidate.expression, position)
                            _:
                                pass
                    return false
                _:
                    return false

        # Stable apart from the updated local itself.
        def proof_replay_self_update_value(report: ProofReport&, value: Ast::Expr, local_name: sview, owner: sview, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match value:
                Ast::Expr.Ident(name, _):
                    return true if name == local_name
                    return proof_replay_mutable_local_stable_value(report, value, local_name, owner, depth + 1)
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Minus, inner, _):
                    return proof_replay_self_update_value(report, inner, local_name, owner, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent
                    return proof_replay_self_update_value(report, left, local_name, owner, depth + 1) and proof_replay_self_update_value(report, right, local_name, owner, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_replay_self_update_condition(report, condition, local_name, owner, depth + 1) and proof_replay_self_update_value(report, then_expression, local_name, owner, depth + 1) and proof_replay_self_update_value(report, else_expression, local_name, owner, depth + 1)
                _:
                    return false

        # A conditional update's guard: comparisons of such values under `and`, `or` and `not`.
        def proof_replay_self_update_condition(report: ProofReport&, condition: Ast::Expr, local_name: sview, owner: sview, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match condition:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_replay_self_update_condition(report, inner, local_name, owner, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        return proof_replay_self_update_condition(report, left, local_name, owner, depth + 1) and proof_replay_self_update_condition(report, right, local_name, owner, depth + 1)
                    return false if operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.EqEq and operator != TokenKind.BangEq
                    return proof_replay_self_update_value(report, left, local_name, owner, depth + 1) and proof_replay_self_update_value(report, right, local_name, owner, depth + 1)
                _:
                    return false

        # VALID / INVALID / ABSENT as for mutable-local sites; loop bodies are not entered.
        def proof_replay_self_update_site(report: ProofReport&, owner: sview, body: darray[Ast::Stmt]&, binding: Ast::Expr, value: Ast::Expr, local_name: mutable sview&, consumer_line: u32, consumer_position: Ast::Pos, nested: bool, depth: usize, owner_scan_work: usize, source_work: mutable usize&) -> usize:
            return ProofReplayLocalAlias::INVALID if depth >= ProofReplayLocalAlias::DEPTH_LIMIT
            found: mutable usize = ProofReplayLocalAlias::ABSENT
            for index in 0..<body.count |index, body, report, owner, binding, value, local_name, consumer_line, nested, depth, found, owner_scan_work, source_work|:
                return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_statement_work_charge(body[index], source_work, depth)
                here: mutable usize = ProofReplayLocalAlias::ABSENT
                match body[index]:
                    Ast::Stmt.Assign(Ast::Expr.Ident(name, _), operator, assigned, statement_position):
                        if (operator == TokenKind.Assign or operator == TokenKind.LArrow) and proof_replay_local_binding_pos_matches(binding, statement_position):
                            here <- ProofReplayLocalAlias::INVALID
                            return ProofReplayLocalAlias::INVALID if not proof_replay_summary_expr_charge_with_work(assigned, source_work)
                            if proof_expr_mentions_name(assigned, name):
                                return ProofReplayLocalAlias::INVALID if not proof_replay_summary_expr_charge_with_work(assigned, source_work) or not proof_replay_summary_expr_charge_with_work(value, source_work)
                                if proof_replay_expr_equal(assigned, value):
                                    return ProofReplayLocalAlias::INVALID if not proof_replay_summary_expr_charge_with_work(assigned, source_work)
                                    return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_identifier_scan_charge(assigned, owner_scan_work, source_work)
                                    if proof_replay_self_update_value(report, assigned, name, owner, 0):
                                        local_name <- name
                                        here <- ProofReplayLocalAlias::VALID if proof_replay_mutable_local_live_with_work(report, owner, body, index, name, consumer_line, nested, false, consumer_position, true, source_work)
                    Ast::Stmt.If(_, yes, no, _):
                        here <- proof_replay_mutable_local_merge(here, proof_replay_self_update_site(report, owner, yes, binding, value, local_name, consumer_line, consumer_position, true, depth + 1, owner_scan_work, source_work))
                        here <- proof_replay_mutable_local_merge(here, proof_replay_self_update_site(report, owner, no, binding, value, local_name, consumer_line, consumer_position, true, depth + 1, owner_scan_work, source_work))
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |here, report, owner, binding, value, local_name, consumer_line, consumer_position, depth, owner_scan_work, source_work|:
                            here <- proof_replay_mutable_local_merge(here, proof_replay_self_update_site(report, owner, arm.body, binding, value, local_name, consumer_line, consumer_position, true, depth + 1, owner_scan_work, source_work))
                    Ast::Stmt.Block(_, _, _, inner, _):
                        here <- proof_replay_self_update_site(report, owner, inner, binding, value, local_name, consumer_line, consumer_position, true, depth + 1, owner_scan_work, source_work)
                    _:
                        pass
                found <- proof_replay_mutable_local_merge(found, here)
            return found

        def proof_replay_local_binding_self_update_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_local_binding_self_update_source_with_work(report, trace, &work)

        def proof_replay_local_binding_self_update_source_with_work(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or trace.line == 0 or report.trace_owner_line == 0
            return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, value, _):
                    return false if not proof_internal_name_is_rebind(symbol) or symbol_position.line != trace.line
                    return false if not proof_replay_summary_expr_charge_with_work(value, source_work)
                    owner_scan_start: usize = source_work
                    return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                    owner_scan_work: usize = source_work - owner_scan_start
                    return false if not proof_replay_mutable_local_identifier_scan_charge(value, owner_scan_work, source_work)
                    return false if proof_source_expression_has_overloaded_operator(value, report.source_primitive_operator_mask, 0)
                    body: mutable darray[Ast::Stmt] = []
                    return false if not proof_replay_source_owner_body(report, trace.name, report.replay_owner_line, &body)
                    return false if not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
                    consumer_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    return false if not proof_replay_mutable_local_consumer_position_with_work(report, trace, body, &consumer_position, source_work)
                    local_name: mutable sview = ""
                    return false if proof_replay_self_update_site(report, trace.name, body, trace.expression, value, &local_name, report.trace_owner_line, consumer_position, false, 0, owner_scan_work, source_work) != ProofReplayLocalAlias::VALID
                    return false if local_name == "" or proof_replay_local_binding_parameter_name_present(report.source_declarations, trace.name, report.replay_owner_line, local_name, 0)
                    return false if not proof_replay_source_single_declaration(report.source_declarations, body, local_name)
                    return false if not proof_replay_mutable_local_declared(body, local_name)
                    return proof_replay_rebind_definition_unique_with_work(report, trace, symbol, symbol_position, value, false, source_work)
                _:
                    return false
