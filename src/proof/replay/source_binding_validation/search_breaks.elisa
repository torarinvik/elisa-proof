# A search break assigns its range binder immediately before leaving the loop.
# Authenticate the lowered assignment only for that break's invariant obligation.
extend ElisaProof:
    private:
        def proof_replay_search_assignment(trace: ProofFactTrace, certificate: ProofGoalCertificate, statement: Ast::Stmt, target: sview, binder: sview, loop_position: Ast::Pos) -> bool:
            match statement:
                Ast::Stmt.Assign(left, TokenKind.LArrow, right, position):
                    return false if proof_ident_name(left) != target or proof_ident_name(right) != binder
                    return false if position.line != trace.line or certificate.line != position.line
                    return false if not proof_replay_local_binding_pos_matches(trace.expression, position)
                    match trace.expression:
                        Ast::Expr.Binary(symbol, TokenKind.EqEq, value, _):
                            return false if proof_ident_name(symbol) != target or not proof_replay_local_binding_pos_matches(symbol, position)
                            return proof_replay_expr_equal(value, proof_loop_binder_value(binder, loop_position))
                        _:
                            return false
                _:
                    return false

        def proof_replay_search_break_update(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, statement: Ast::Stmt, target: sview, binder: sview, loop_position: Ast::Pos, depth: usize) -> bool:
            return false if depth >= 4
            match statement:
                Ast::Stmt.If(condition, then_body, else_body, _):
                    return false if else_body.count != 0
                    if then_body.count == 1:
                        return false if proof_expr_has_call(condition) or proof_expr_has_move(condition) or proof_source_expression_has_overloaded_operator(condition, report.source_primitive_operator_mask, 0)
                        return proof_replay_search_break_update(report, trace, certificate, then_body[0], target, binder, loop_position, depth + 1)
                    return false if then_body.count != 2
                    match condition:
                        Ast::Expr.BoolLit(value, _):
                            return false if not value
                        _:
                            return false
                    match then_body[1]:
                        Ast::Stmt.Break(label, _):
                            return false if label != ""
                        _:
                            return false
                    return proof_replay_search_assignment(trace, certificate, then_body[0], target, binder, loop_position)
                _:
                    return false

        def proof_replay_search_break_block(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 8
            match expression:
                Ast::Expr.Block(statements, yielded, captures, _):
                    return proof_replay_search_break_block(report, trace, certificate, yielded, depth + 1) if statements.count == 0 and captures.count == 0
                    return false if statements.count != 2
                    match statements[0]:
                        Ast::Stmt.VarDecl(target, type_expression, initializer, _):
                            return false if proof_replay_local_binding_unsigned_type_name(type_expression, 0) != "usize"
                            return false if proof_ident_name(yielded) != target
                            return false if proof_replay_local_binding_parameter_name_present(report.source_declarations, trace.name, report.replay_owner_line, target, 0)
                            match initializer:
                                Ast::Expr.IntLit(_, _):
                                    pass
                                _:
                                    return false
                            match statements[1]:
                                Ast::Stmt.For(bind, variables, iterable, body, position):
                                    return false if bind != "" or variables.count != 1 or variables[0] == target or body.count != 2
                                    return false if not proof_replay_local_binding_prefix_expression_safe(iterable, 0) or proof_source_expression_has_overloaded_operator(iterable, report.source_primitive_operator_mask, 0)
                                    match body[0]:
                                        Ast::Stmt.Contract("invariant", invariant, _):
                                            return false if not proof_replay_expr_equal(invariant, certificate.goal)
                                            return proof_replay_search_break_update(report, trace, certificate, body[1], target, variables[0], position, 0)
                                        _:
                                            return false
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false

        def proof_replay_search_break_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count or report.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line or certificate.rule != "goal"
            work: mutable usize = 0
            return false if not proof_replay_captured_entry_environment(&report.source_declarations, 0, &work)
            context = ElisaProofFrameSource::owner(&report.source_declarations, trace.name, report.replay_owner_line)
            return false if not context.known or context.body.count > 4096
            for statement in context.body |report, trace, certificate|:
                match statement:
                    Ast::Stmt.Contract(kind, expression, _):
                        return false if kind != "requires" and kind != "ensure" and kind != "ensures"
                        return false if not proof_replay_for_decimal_prefix_safe(expression, 0) or proof_source_expression_has_overloaded_operator(expression, report.source_primitive_operator_mask, 0)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return proof_replay_search_break_block(report, trace, certificate, initializer, 0)
                    Ast::Stmt.Return(value, _):
                        return proof_replay_search_break_block(report, trace, certificate, returned, 0) if value is returned
                        return false
                    _:
                        return false
            return false
