# A search break assigns its range binder immediately before leaving the loop.
# Authenticate the lowered assignment only for that break's invariant obligation.
extend ElisaProof:
    private:
        # A search-block candidate may be checked many times while the enclosing body is
        # scanned. Charge every declaration and parameter row in this repeated shadow query;
        # exhaustion means "possibly present" so callers refuse the witness.
        def proof_replay_search_parameter_name_present(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, depth: usize, source_work: mutable usize&) -> bool:
            return true if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for declaration in declarations |owner, owner_line, parameter_name, depth, source_work|:
                return true if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return true if not proof_replay_mutable_local_text_compare_work_charge(name, owner, source_work)
                        if name == owner and position.line == owner_line:
                            for parameter in parameters |parameter_name, source_work|:
                                return true if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                source_work <- source_work + 1
                                return true if:
                                    not proof_replay_mutable_local_text_compare_work_charge(parameter.name, parameter_name, source_work)
                                    parameter.name == parameter_name
                            return false
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_search_parameter_name_present(nested, owner, owner_line, parameter_name, depth + 1, source_work)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return true
                    _:
                        return true
            return false

        def proof_replay_search_assignment(trace: ProofFactTrace, certificate: ProofGoalCertificate, statement: Ast::Stmt, target: sview, binder: sview, loop_position: Ast::Pos, source_work: mutable usize&) -> bool:
            return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work <- source_work + 1
            match statement:
                Ast::Stmt.Assign(left, TokenKind.LArrow, right, position):
                    return false if:
                        proof_ident_name(left) != target or proof_ident_name(right) != binder
                        position.line != trace.line or certificate.line != position.line
                        not proof_replay_local_binding_pos_matches(trace.expression, position)
                    match trace.expression:
                        Ast::Expr.Binary(symbol, TokenKind.EqEq, value, _):
                            return false if proof_ident_name(symbol) != target or not proof_replay_local_binding_pos_matches(symbol, position)
                            expected: Ast::Expr = proof_loop_binder_value(binder, loop_position)
                            return proof_replay_summary_expr_equal_with_limit(value, expected, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        _:
                            return false
                _:
                    return false

        def proof_replay_search_break_update(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, statement: Ast::Stmt, target: sview, binder: sview, loop_position: Ast::Pos, depth: usize, source_work: mutable usize&) -> bool:
            return false if depth >= 4 or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work <- source_work + 1
            match statement:
                Ast::Stmt.If(condition, then_body, else_body, _):
                    return false if else_body.count != 0
                    if then_body.count == 1:
                        return false if:
                            not proof_replay_summary_expr_repeat_charge_with_limit(condition, 3, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                            proof_expr_has_call(condition) or proof_expr_has_move(condition) or proof_source_expression_has_overloaded_operator(condition, report.source_primitive_operator_mask, 0)
                        return proof_replay_search_break_update(report, trace, certificate, then_body[0], target, binder, loop_position, depth + 1, source_work)
                    return false if then_body.count != 2
                    match condition:
                        Ast::Expr.BoolLit(value, _):
                            return false if not value
                        _:
                            return false
                    match then_body[1]:
                        Ast::Stmt.Break(label, _):
                            return false if label != ""
                        _:
                            return false
                    return proof_replay_search_assignment(trace, certificate, then_body[0], target, binder, loop_position, source_work)
                _:
                    return false

        def proof_replay_search_break_block(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, expression: Ast::Expr, depth: usize, source_work: mutable usize&) -> bool:
            return false if:
                depth >= 8 or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                not proof_replay_summary_expr_charge_with_limit(expression, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            match expression:
                Ast::Expr.Block(statements, yielded, captures, _):
                    return proof_replay_search_break_block(report, trace, certificate, yielded, depth + 1, source_work) if statements.count == 0 and captures.count == 0
                    return false if statements.count != 2
                    match statements[0]:
                        Ast::Stmt.VarDecl(target, type_expression, initializer, _):
                            return false if:
                                not proof_replay_summary_expr_repeat_charge_with_limit(type_expression, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                proof_replay_local_binding_unsigned_type_name(type_expression, 0) != "usize"
                                proof_ident_name(yielded) != target
                                proof_replay_search_parameter_name_present(report.source_declarations, trace.name, report.replay_owner_line, target, 0, source_work)
                            normalized: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, initializer, source_work, 0)
                            return false if proof_replay_expr_is_invalid(normalized)
                            match normalized:
                                Ast::Expr.IntLit(_, _):
                                    pass
                                _:
                                    return false
                            match statements[1]:
                                Ast::Stmt.For(bind, variables, iterable, body, position):
                                    return false if bind != "" or variables.count != 1 or variables[0] == target or body.count != 2
                                    normalized_iterable: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, iterable, source_work, 0)
                                    return false if:
                                        proof_replay_expr_is_invalid(normalized_iterable)
                                        not proof_replay_summary_expr_repeat_charge_with_limit(normalized_iterable, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                        not proof_replay_summary_expr_repeat_charge_with_limit(iterable, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                        not proof_replay_local_binding_prefix_expression_safe(normalized_iterable, 0) or proof_source_expression_has_overloaded_operator(iterable, report.source_primitive_operator_mask, 0)
                                    match body[0]:
                                        Ast::Stmt.Contract("invariant", invariant, _):
                                            return false if:
                                                not proof_replay_summary_expr_repeat_charge_with_limit(invariant, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                                proof_source_expression_has_overloaded_operator(invariant, report.source_primitive_operator_mask, 0)
                                            expected: Ast::Expr = proof_replay_local_initializer_constants_with_work(report, trace, invariant, source_work, 0)
                                            return false if:
                                                proof_replay_expr_is_invalid(expected)
                                                not proof_replay_summary_expr_equal_with_limit(expected, certificate.goal, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                            return proof_replay_search_break_update(report, trace, certificate, body[1], target, variables[0], position, 0, source_work)
                                        _:
                                            return false
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false

        def proof_replay_search_break_sources(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, statements: darray[Ast::Stmt]&, depth: usize, work: mutable usize&) -> usize:
            return 2 if depth >= 64
            matches: mutable usize = 0
            for statement in statements |report, trace, certificate, depth, work, matches|:
                return 2 if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                work <- work + 1
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _) | Ast::Stmt.Assign(_, _, initializer, _):
                        matches <- matches + 1 if proof_replay_search_break_block(report, trace, certificate, initializer, 0, work)
                    Ast::Stmt.Return(value, _):
                        matches <- matches + 1 if value is returned and proof_replay_search_break_block(report, trace, certificate, returned, 0, work)
                    Ast::Stmt.If(_, then_body, else_body, _):
                        matches <- matches + proof_replay_search_break_sources(report, trace, certificate, then_body, depth + 1, work)
                        matches <- matches + proof_replay_search_break_sources(report, trace, certificate, else_body, depth + 1, work)
                    Ast::Stmt.For(_, _, _, body, _) | Ast::Stmt.While(_, body, _):
                        matches <- matches + proof_replay_search_break_sources(report, trace, certificate, body, depth + 1, work)
                    Ast::Stmt.Expr(Ast::Expr.Block(body, _, _, _), _):
                        matches <- matches + proof_replay_search_break_sources(report, trace, certificate, body, depth + 1, work)
                    _:
                        pass
                return 2 if matches > 1
            return 2 if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return matches

        def proof_replay_search_break_source_with_work(report: ProofReport&, trace: ProofFactTrace, work: mutable usize&) -> bool:
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count or report.replay_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if:
                certificate.name != trace.name or certificate.line != report.trace_owner_line or certificate.rule != "goal"
                not proof_replay_captured_entry_environment_with_source_work(&report.source_declarations, &work)
                not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, work)
            context = ElisaProofFrameSource::owner(&report.source_declarations, trace.name, report.replay_owner_line)
            return false if not context.known or context.body.count > 4096
            return proof_replay_search_break_sources(report, trace, certificate, context.body, 0, &work) == 1

        def proof_replay_search_break_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            proof_replay_search_break_source_with_work(report, trace, &work)
