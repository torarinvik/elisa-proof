# A mutable integer local is bound by `x == value` at its declaration (`x: mutable T = value`)
# and at each plain assignment (`x <- value`). Replay accepts the equation only when
#   - the local is declared exactly once in the owner function, at top level, with an integer
#     (non-reference) type, so no alias or global can name it;
#   - the equation sits at exactly one source declaration or plain assignment of the local in
#     the owner (pinned by the statement span), whose value is the same expression;
#   - the value is stable: built from integer literals, integer parameters the body never
#     writes and unshadowed global constants, with no source-overloaded operator, so it cannot
#     go stale through another write;
#   - nothing writes the local between that statement and the consuming certificate, and a
#     binding nested in a branch or loop body reaches only consumers inside that body. Ordering
#     uses offsets only after the certificate goal matches one exact source assertion/contract
#     and one successful attempt; unanchored consumers fail closed. Ambiguous consumers fail
#     closed; loop-entry checks keep their separate source-authenticated phase rule.
#     Self-referential updates with a fresh symbol and threaded calls can preserve a value at
#     later source positions.
extend ElisaProof:
    private:
        const PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID: usize = 0
        const PROOF_REPLAY_MUTABLE_LOCAL_ORDER_BEFORE: usize = 1
        const PROOF_REPLAY_MUTABLE_LOCAL_ORDER_AFTER: usize = 2
        const PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_OUTSIDE: usize = 3
        const PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE: usize = 4

        # A certificate consumer is tied to one exact source assertion/contract and its unique
        # proven attempt. An open source attempt may anchor only its own goal after the checked
        # view has admitted that exact obligation; unsupported consumer contexts still fail closed.
        def proof_replay_mutable_local_consumer_position(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&, position: mutable Ast::Pos&) -> bool:
            work: mutable usize = 0
            return proof_replay_mutable_local_consumer_position_with_work(report, trace, body, position, &work)

        def proof_replay_mutable_local_consumer_position_with_work(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&, position: mutable Ast::Pos&, source_work: mutable usize&) -> bool:
            certificate: mutable ProofGoalCertificate = ProofGoalCertificate{goal: Ast::Expr.Invalid, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 0, name: "", rule: "goal", replayed: false}
            if report.trace_consumer_certificate_index != 0:
                return false if report.trace_consumer_certificate_index > report.certificates.count
                certificate_index: usize = report.trace_consumer_certificate_index - 1
                certificate <- report.certificates[certificate_index]
                return false if:
                    certificate.name != trace.name or certificate.line != report.trace_owner_line
                    report.goal_attempts.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                    report.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                source_work <- source_work + report.goal_attempts.count
                attempt_matches: mutable usize = 0
                for attempt in report.goal_attempts |report, certificate, certificate_index, attempt_matches, source_work|:
                    return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    source_work <- source_work + 1
                    continue if not attempt.has_certificate or attempt.certificate_index != certificate_index
                    return false if:
                        not proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, certificate_index, source_work)
                        not proof_replay_type_bound_goal_position_matches(attempt.goal, certificate.goal)
                    attempt_matches <- attempt_matches + 1
                return false if attempt_matches != 1
            else:
                # An open attempt has no certificate. Its goal was admitted against the exact
                # source obligation before attempt-fact validation; retain that position as the
                # consumer anchor instead of disabling immutable source facts wholesale.
                return false if report.trace_consumer_attempt_index == 0 or report.trace_consumer_attempt_index > report.goal_attempts.count
                attempt_index: usize = report.trace_consumer_attempt_index - 1
                attempt: ProofGoalAttempt = report.goal_attempts[attempt_index]
                return false if:
                    attempt.proven or attempt.has_certificate or attempt.rule != "goal"
                    attempt.name != trace.name or attempt.line != report.trace_owner_line
                    attempt.facts_count != attempt.kernel_facts_count
                    attempt.facts_start > report.certificate_facts.count or attempt.facts_count > report.certificate_facts.count - attempt.facts_start
                    attempt.kernel_facts_start > report.kernel.certificate_facts.count or attempt.kernel_facts_count > report.kernel.certificate_facts.count - attempt.kernel_facts_start
                certificate <- ProofGoalCertificate{goal: attempt.goal, facts_start: attempt.facts_start, facts_count: attempt.facts_count, kernel_goal: attempt.kernel_goal, kernel_facts_start: attempt.kernel_facts_start, kernel_facts_count: attempt.kernel_facts_count, line: attempt.line, name: attempt.name, rule: attempt.rule, source_phase: attempt.source_phase, source_call_position: attempt.source_call_position, replayed: false}
            return false if:
                not proof_replay_summary_expr_charge_with_work(certificate.goal, source_work)
                not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
            extent_work: mutable usize = 0
            extent_complete: bool = proof_replay_type_bound_extent_preflight_with_work(body, Ast::Expr.Absent, false, certificate.goal, true, &extent_work)
            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or extent_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            source_work <- source_work + extent_work
            return false if:
                not extent_complete
                not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
            source_matches: mutable usize = 0
            site_work: mutable usize = 0
            proof_replay_type_bound_consumer_source_site_in_body_with_work(body, certificate, &source_matches, &site_work, 0)
            if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or site_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            source_work <- source_work + site_work
            return false if source_matches != 1
            position <- Ast::expr_pos(certificate.goal)
            return position.line != 0 and position.offset != 0 and position.end_offset != 0

        def proof_replay_mutable_local_source_order(position: Ast::Pos, extent: ProofReplayTypeBoundSourceExtent, consumer: Ast::Pos) -> usize:
            return PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID if:
                not extent.offsets_complete or extent.end_offset == 0 or consumer.offset == 0
                position.offset == 0
                position.offset <= consumer.offset and consumer.offset < extent.end_offset
            return PROOF_REPLAY_MUTABLE_LOCAL_ORDER_BEFORE if extent.end_offset <= consumer.offset
            return PROOF_REPLAY_MUTABLE_LOCAL_ORDER_AFTER if position.offset >= consumer.offset
            return PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID

        def proof_replay_mutable_local_extent_contains_consumer(position: Ast::Pos, extent: ProofReplayTypeBoundSourceExtent, consumer: Ast::Pos) -> bool:
            return false if position.offset == 0 or consumer.offset == 0 or not extent.offsets_complete or extent.end_offset == 0
            return position.offset <= consumer.offset and consumer.offset < extent.end_offset

        # Classify whether the authenticated consumer lies in this exact statement list.
        # The caller has already charged a complete walk of the enclosing AST before using it.
        def proof_replay_mutable_local_consumer_scope(body: darray[Ast::Stmt]&, consumer: Ast::Pos) -> usize:
            return PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID if consumer.offset == 0
            return PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_OUTSIDE if body.count == 0
            first: Ast::Pos = proof_replay_statement_position(body[0])
            extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmts_extent(body, 0)
            return PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID if:
                first.offset == 0 or not extent.offsets_complete or extent.end_offset == 0
                first.offset >= extent.end_offset
            return PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_OUTSIDE if consumer.offset < first.offset or consumer.offset >= extent.end_offset
            return PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE

        # A loop-entry certificate skips writes in its own loop body, but containment in a
        # statement extent is not enough: an enclosing loop also contains nested consumers.
        # Identify the loop whose direct invariant contract owns this exact source expression.
        def proof_replay_mutable_local_is_consumer_loop(statement: Ast::Stmt, consumer: Ast::Pos) -> bool:
            return false if consumer.offset == 0
            match statement:
                Ast::Stmt.While(_, loop_body, _) | Ast::Stmt.For(_, _, _, loop_body, _):
                    for child in loop_body |consumer|:
                        match child:
                            Ast::Stmt.Contract("invariant", expression, _):
                                return true if proof_replay_source_position_equal(Ast::expr_pos(expression), consumer)
                            _:
                                pass
                _:
                    pass
            return false

        def proof_replay_mutable_local_global_constant_collect_with_work(declarations: darray[Ast::Decl]&, target: sview, matches: mutable usize&, mutable_matches: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + declarations.count
            for declaration in declarations |target, matches, mutable_matches, source_work, depth|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match declaration:
                    Ast::Decl.Const(name, _, _, is_mutable, _):
                        return false if not proof_replay_mutable_local_text_compare_work_charge(name, target, source_work)
                        if name == target:
                            matches <- matches + 1
                            mutable_matches <- mutable_matches + 1 if is_mutable
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_mutable_local_global_constant_collect_with_work(nested, target, matches, mutable_matches, source_work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_mutable_local_global_constant_immutable_with_work(declarations: darray[Ast::Decl]&, target: sview, source_work: mutable usize&) -> bool:
            matches: mutable usize = 0
            mutable_matches: mutable usize = 0
            return false if target == "" or not proof_replay_mutable_local_global_constant_collect_with_work(declarations, target, &matches, &mutable_matches, &source_work, 0)
            return matches == 1 and mutable_matches == 0

        def proof_replay_mutable_local_live(report: ProofReport&, owner: sview, body: darray[Ast::Stmt]&, index: usize, local_name: sview, consumer_line: u32, nested: bool, loop_entry: bool, consumer_position: Ast::Pos, consumer_position_valid: bool) -> bool:
            source_work: mutable usize = 0
            return proof_replay_mutable_local_live_with_work(report, owner, body, index, local_name, consumer_line, nested, loop_entry, consumer_position, consumer_position_valid, &source_work)

        def proof_replay_mutable_local_live_with_work(report: ProofReport&, owner: sview, body: darray[Ast::Stmt]&, index: usize, local_name: sview, consumer_line: u32, nested: bool, loop_entry: bool, consumer_position: Ast::Pos, consumer_position_valid: bool, source_work: mutable usize&) -> bool:
            return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or index >= body.count or consumer_line == 0
            # A line-only consumer can be reordered by #line directives. Without an
            # authenticated source offset, no binding site is safe to use as a liveness proof.
            return false if:
                not consumer_position_valid
                body.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + body.count
            binding_position: Ast::Pos = proof_replay_statement_position(body[index])
            binding_extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(body[index], 0)
            return false if proof_replay_mutable_local_source_order(binding_position, binding_extent, consumer_position) != PROOF_REPLAY_MUTABLE_LOCAL_ORDER_BEFORE
            if nested and consumer_position_valid:
                return false if body.count == 0 or not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
                scope_extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmts_extent(body, 0)
                first_position: Ast::Pos = proof_replay_statement_position(body[0])
                return false if:
                    not scope_extent.offsets_complete or scope_extent.end_offset == 0 or first_position.offset == 0
                    consumer_position.offset < first_position.offset or consumer_position.offset >= scope_extent.end_offset
            first_later: usize = index + 1
            for later in first_later..<body.count |later, body, report, owner, local_name, consumer_line, loop_entry, consumer_position, consumer_position_valid, source_work|:
                return false if not proof_replay_mutable_local_statement_work_charge(body[later], source_work, 0)
                position: Ast::Pos = proof_replay_statement_position(body[later])
                statement_extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(body[later], 0)
                if loop_entry and consumer_position_valid and proof_replay_mutable_local_is_consumer_loop(body[later], consumer_position):
                    # Only this loop's entry check precedes its first iteration. A containing
                    # loop or a captured block may include the consumer without being its loop.
                    break
                order: usize = proof_replay_mutable_local_source_order(position, statement_extent, consumer_position)
                if consumer_position_valid and order == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID and proof_replay_mutable_local_extent_contains_consumer(position, statement_extent, consumer_position):
                    # This statement contains the anchored consumer. Only its prefix can
                    # invalidate the binding; the consumer expression itself may read it.
                    return false if proof_replay_source_statement_touches_with_work(report.source_declarations, body[later], local_name, true, source_work)
                    break
                break if order == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_AFTER
                return false if order != PROOF_REPLAY_MUTABLE_LOCAL_ORDER_BEFORE
                # A self-referential update that took a fresh symbol leaves the local's own
                # symbol denoting the value it had (proof_bind_unsigned_symbol).
                continue if proof_replay_self_update_resymbolized_with_work(report, owner, body[later], local_name, source_work)
                # So does a call that threads the local (threaded_summaries.elisa).
                continue if proof_replay_thread_call_resymbolized_with_work(report, owner, body[later], local_name, source_work)
                return false if proof_replay_source_statement_touches_with_work(report.source_declarations, body[later], local_name, true, source_work)
            return true

        # VALID when the binding statement is found and live at `consumer_line`, INVALID when
        # found and not live (or found more than once), ABSENT otherwise. `binding` is the traced
        # equation, whose span is the binding statement's.
        def proof_replay_mutable_local_site(report: ProofReport&, trace: ProofFactTrace, owner: sview, body: darray[Ast::Stmt]&, local_name: sview, binding: Ast::Expr, value: Ast::Expr, consumer_line: u32, consumer_position: Ast::Pos, consumer_position_valid: bool, nested: bool, loop_entry: bool, depth: usize, source_work: mutable usize&) -> usize:
            return ProofReplayLocalAlias::INVALID if:
                depth >= ProofReplayLocalAlias::DEPTH_LIMIT
                not consumer_position_valid or consumer_position.offset == 0
            found: mutable usize = ProofReplayLocalAlias::ABSENT
            for index in 0..<body.count |index, body, report, trace, owner, local_name, binding, value, consumer_line, consumer_position, consumer_position_valid, nested, loop_entry, depth, found, source_work|:
                return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_statement_work_charge(body[index], source_work, depth)
                statement: Ast::Stmt = body[index]
                here: mutable usize = ProofReplayLocalAlias::ABSENT
                written: mutable Ast::Expr = Ast::Expr.Absent
                site_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                site: mutable bool = false
                match statement:
                    Ast::Stmt.Assign(Ast::Expr.Ident(name, _), operator, assigned, statement_position):
                        if name == local_name and (operator == TokenKind.Assign or operator == TokenKind.LArrow) and proof_replay_local_binding_pos_matches(binding, statement_position):
                            site <- true
                            site_position <- statement_position
                            written <- assigned
                    Ast::Stmt.VarDecl(name, _, initializer, statement_position):
                        if name == local_name and proof_replay_local_binding_pos_matches(binding, statement_position):
                            site <- true
                            site_position <- statement_position
                            written <- initializer
                    Ast::Stmt.If(_, yes, no, _):
                        then_scope: usize = proof_replay_mutable_local_consumer_scope(yes, consumer_position)
                        else_scope: usize = proof_replay_mutable_local_consumer_scope(no, consumer_position)
                        if then_scope == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID or else_scope == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID or then_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE and else_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE:
                            here <- ProofReplayLocalAlias::INVALID
                        elif then_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE:
                            here <- proof_replay_mutable_local_site(report, trace, owner, yes, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                        elif else_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE:
                            here <- proof_replay_mutable_local_site(report, trace, owner, no, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                        else:
                            then_site: usize = proof_replay_mutable_local_site(report, trace, owner, yes, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                            else_site: usize = proof_replay_mutable_local_site(report, trace, owner, no, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                            here <- ProofReplayLocalAlias::INVALID if then_site != ProofReplayLocalAlias::ABSENT or else_site != ProofReplayLocalAlias::ABSENT
                    Ast::Stmt.Block(block_kind, _, _, inner, block_position):
                        # A can body executes once on every path that reaches its successor.
                        # Its outer-local writes can dominate a later consumer, but still need
                        # both the inner reaching check and the enclosing suffix's havoc check.
                        block_extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(statement, 0)
                        consumer_after_block: bool = consumer_position_valid and proof_replay_mutable_local_source_order(block_position, block_extent, consumer_position) == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_BEFORE
                        outside_can: bool = block_kind == "can" and consumer_after_block
                        inside_nested: bool = nested if outside_can else true
                        inner_scope: usize = proof_replay_mutable_local_consumer_scope(inner, consumer_position)
                        if inner_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE:
                            here <- proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                        elif outside_can:
                            here <- proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, inside_nested, loop_entry, depth + 1, source_work)
                            if here == ProofReplayLocalAlias::VALID:
                                here <- ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_live_with_work(report, owner, body, index, local_name, consumer_line, nested, loop_entry, consumer_position, true, source_work)
                        elif inner_scope == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID:
                            here <- ProofReplayLocalAlias::INVALID
                        else:
                            candidate: usize = proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                            here <- ProofReplayLocalAlias::INVALID if candidate != ProofReplayLocalAlias::ABSENT
                    Ast::Stmt.While(_, inner, _):
                        consumer_scope: usize = proof_replay_mutable_local_consumer_scope(inner, consumer_position)
                        if consumer_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE:
                            here <- proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                        elif consumer_scope == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID:
                            here <- ProofReplayLocalAlias::INVALID
                        else:
                            candidate: usize = proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                            here <- ProofReplayLocalAlias::INVALID if candidate != ProofReplayLocalAlias::ABSENT
                    Ast::Stmt.For(_, _, _, inner, _):
                        consumer_scope: usize = proof_replay_mutable_local_consumer_scope(inner, consumer_position)
                        if consumer_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE:
                            here <- proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                        elif consumer_scope == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID:
                            here <- ProofReplayLocalAlias::INVALID
                        else:
                            candidate: usize = proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                            here <- ProofReplayLocalAlias::INVALID if candidate != ProofReplayLocalAlias::ABSENT
                    Ast::Stmt.Match(_, arms, _):
                        matches_consumer: mutable usize = 0
                        selected_arm: mutable usize = 0
                        arm_index: mutable usize = 0
                        for arm in arms |consumer_position, matches_consumer, selected_arm, arm_index|:
                            consumer_scope: usize = proof_replay_mutable_local_consumer_scope(arm.body, consumer_position)
                            return ProofReplayLocalAlias::INVALID if consumer_scope == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID
                            if consumer_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE:
                                matches_consumer <- matches_consumer + 1
                                selected_arm <- arm_index
                            arm_index <- arm_index + 1
                        if matches_consumer > 1:
                            here <- ProofReplayLocalAlias::INVALID
                        elif matches_consumer == 1:
                            selected: Ast::MatchArm = arms[selected_arm]
                            here <- proof_replay_mutable_local_site(report, trace, owner, selected.body, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                        else:
                            arm_site: mutable usize = ProofReplayLocalAlias::ABSENT
                            for arm in arms |arm_site, report, trace, owner, local_name, binding, value, consumer_line, consumer_position, loop_entry, depth, source_work|:
                                candidate: usize = proof_replay_mutable_local_site(report, trace, owner, arm.body, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                                arm_site <- proof_replay_mutable_local_merge(arm_site, candidate)
                            here <- ProofReplayLocalAlias::INVALID if arm_site != ProofReplayLocalAlias::ABSENT
                    Ast::Stmt.Expr(Ast::Expr.Block(inner, _, _, _), _):
                        consumer_scope: usize = proof_replay_mutable_local_consumer_scope(inner, consumer_position)
                        if consumer_scope == PROOF_REPLAY_MUTABLE_LOCAL_SCOPE_INSIDE:
                            here <- proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                        elif consumer_scope == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_INVALID:
                            here <- ProofReplayLocalAlias::INVALID
                        else:
                            candidate: usize = proof_replay_mutable_local_site(report, trace, owner, inner, local_name, binding, value, consumer_line, consumer_position, true, true, loop_entry, depth + 1, source_work)
                            here <- ProofReplayLocalAlias::INVALID if candidate != ProofReplayLocalAlias::ABSENT
                    _:
                        pass
                if site:
                    # The producer records a global constant's value in place of its name.
                    owner_scan_start: usize = source_work
                    return ProofReplayLocalAlias::INVALID if not proof_replay_summary_owner_source_preflight(report, owner, report.replay_owner_line, source_work)
                    owner_scan_work: usize = source_work - owner_scan_start
                    return ProofReplayLocalAlias::INVALID if:
                        not proof_replay_summary_expr_charge_with_work(written, source_work) or not proof_replay_summary_expr_charge_with_work(value, source_work)
                        not proof_replay_mutable_local_identifier_scan_charge(written, owner_scan_work, source_work)
                    exact_value: mutable bool = false
                    return ProofReplayLocalAlias::INVALID if not proof_replay_mutable_local_expr_equal_with_work(written, value, &exact_value, source_work)
                    valid_value: bool = not proof_source_expression_has_overloaded_operator(written, report.source_primitive_operator_mask, 0) and (exact_value or proof_replay_summary_call_global_constant_matches_with_work(report, trace, written, value, source_work) or proof_replay_mutable_local_authenticated_initializer_with_work(report, trace, written, value, local_name, source_work, 0, false))
                    statement_extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(statement, 0)
                    before_consumer: bool = proof_replay_mutable_local_source_order(site_position, statement_extent, consumer_position) == PROOF_REPLAY_MUTABLE_LOCAL_ORDER_BEFORE
                    here <- ProofReplayLocalAlias::VALID if valid_value and before_consumer and proof_replay_mutable_local_live_with_work(report, owner, body, index, local_name, consumer_line, nested, loop_entry, consumer_position, consumer_position_valid, source_work) else ProofReplayLocalAlias::INVALID
                found <- proof_replay_mutable_local_merge(found, here)
            return found

        def proof_replay_mutable_local_merge(left: usize, right: usize) -> usize:
            return right if left == ProofReplayLocalAlias::ABSENT
            return left if right == ProofReplayLocalAlias::ABSENT
            return ProofReplayLocalAlias::INVALID

        def proof_replay_mutable_local_declared(body: darray[Ast::Stmt]&, local_name: sview) -> bool:
            for statement in body |local_name|:
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, _, _):
                        return proof_replay_local_binding_integer_type(type_expression, 0) if name == local_name
                    _:
                        pass
            return false

        # Stable values: the immutable-binding rule (literals and unwritten integer parameters under
        # + - * / %), plus unshadowed global constants, whose values the global-constant facts fix.
        def proof_replay_mutable_local_stable_value(report: ProofReport&, value: Ast::Expr, local_name: sview, owner: sview, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            return true if proof_replay_local_binding_stable_initializer(value, local_name, report.source_declarations, owner, report.replay_owner_line, source_work, 0)
            match value:
                Ast::Expr.Ident(name, _):
                    return false if:
                        name == "" or name == local_name or not proof_replay_mutable_local_global_constant_immutable_with_work(report.source_declarations, name, source_work)
                        proof_replay_local_binding_parameter_name_present_with_default_limit(report.source_declarations, owner, report.replay_owner_line, name, source_work, 0)
                    body: mutable darray[Ast::Stmt] = []
                    return false if not proof_replay_source_owner_body_with_work(report, owner, report.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return not proof_replay_source_body_declares_with_work(report.source_declarations, body, name, source_work)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Minus, inner, _):
                    return proof_replay_mutable_local_stable_value(report, inner, local_name, owner, source_work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent
                    return proof_replay_mutable_local_stable_value(report, left, local_name, owner, source_work, depth + 1) and proof_replay_mutable_local_stable_value(report, right, local_name, owner, source_work, depth + 1)
                _:
                    return false

        def proof_replay_mutable_local_identifier_scan_bound(expression: Ast::Expr) -> usize:
            cost: mutable usize = 0
            return PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT if not proof_replay_summary_expr_cost(expression, &cost, 0, 0)
            return cost

        def proof_replay_mutable_local_work_exhaust(source_work: mutable usize&) -> bool:
            source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return false

        def proof_replay_mutable_local_expr_work_charge(expression: Ast::Expr, source_work: mutable usize&) -> bool:
            return true if proof_replay_summary_expr_charge_with_work(expression, source_work)
            return proof_replay_mutable_local_work_exhaust(source_work)

        def proof_replay_mutable_local_owner_preflight_work_charge(report: ProofReport&, owner: sview, owner_line: u32, source_work: mutable usize&) -> bool:
            return true if proof_replay_summary_owner_source_preflight(report, owner, owner_line, source_work)
            return proof_replay_mutable_local_work_exhaust(source_work)

        def proof_replay_mutable_local_statement_work_charge_fail_closed(statement: Ast::Stmt, source_work: mutable usize&, depth: usize) -> bool:
            return true if proof_replay_mutable_local_statement_work_charge(statement, source_work, depth)
            return proof_replay_mutable_local_work_exhaust(source_work)

        def proof_replay_mutable_local_body_work_charge_fail_closed(body: darray[Ast::Stmt]&, source_work: mutable usize&, depth: usize) -> bool:
            return true if proof_replay_mutable_local_body_work_charge(body, source_work, depth)
            return proof_replay_mutable_local_work_exhaust(source_work)

        def proof_replay_mutable_local_trace_work_charge_fail_closed(report: ProofReport&, source_work: mutable usize&, repetitions: usize) -> bool:
            return true if proof_replay_mutable_local_trace_work_charge(report, source_work, repetitions)
            return proof_replay_mutable_local_work_exhaust(source_work)

        # Stable-name replay may perform up to twelve owner/declaration/body walks per
        # identifier: eight in the immutable-initializer path and four in its global-constant
        # fallback. `owner_scan_work` is itself the four-unit preflight scan bound, so three
        # copies per AST node conservatively cover that repeated work.
        def proof_replay_mutable_local_identifier_scan_charge(expression: Ast::Expr, owner_scan_work: usize, source_work: mutable usize&) -> bool:
            identifier_bound: usize = proof_replay_mutable_local_identifier_scan_bound(expression)
            if identifier_bound >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or identifier_bound > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                return proof_replay_mutable_local_work_exhaust(source_work)
            source_work <- source_work + identifier_bound
            if identifier_bound != 0 and owner_scan_work > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / identifier_bound / 3:
                return proof_replay_mutable_local_work_exhaust(source_work)
            source_work <- source_work + owner_scan_work * identifier_bound * 3
            return true

        def proof_replay_mutable_local_text_compare_work_charge(left: sview, right: sview, source_work: mutable usize&) -> bool:
            return proof_replay_mutable_local_work_exhaust(source_work) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work <- source_work + 1
            return proof_replay_mutable_local_work_exhaust(source_work) if sview_len(left) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + sview_len(left)
            return proof_replay_mutable_local_work_exhaust(source_work) if sview_len(right) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + sview_len(right)
            return true

        def proof_replay_mutable_local_expr_equal_with_work(source: Ast::Expr, expected: Ast::Expr, exact: mutable bool&, source_work: mutable usize&) -> bool:
            exact <- proof_replay_summary_expr_equal_with_work(source, expected, source_work)
            return exact or source_work < PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT

        # The legacy authenticated-initializer walk compares each recursive subtree before
        # descending. Charge those comparisons at their actual subtree widths, and reserve
        # repeated declaration/body work for stable identifiers once at the source root.
        def proof_replay_mutable_local_authenticated_initializer_with_work(report: ProofReport&, trace: ProofFactTrace, source: Ast::Expr, expected: Ast::Expr, target: sview, source_work: mutable usize&, depth: usize, check_current_equal: bool) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            if check_current_equal:
                exact: mutable bool = false
                return false if not proof_replay_mutable_local_expr_equal_with_work(source, expected, &exact, source_work)
                if exact:
                    return false if not proof_replay_summary_expr_charge_with_work(source, source_work)
                    return proof_replay_local_binding_stable_initializer(source, target, report.source_declarations, trace.name, report.replay_owner_line, source_work, depth)
            match source:
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    return proof_replay_summary_call_global_constant_matches_with_work(report, trace, source, expected, source_work)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_mutable_local_authenticated_initializer_with_work(report, trace, inner, expected, target, source_work, depth + 1, true)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent
                    match expected:
                        Ast::Expr.Binary(expected_left, expected_operator, expected_right, _):
                            return operator == expected_operator and proof_replay_mutable_local_authenticated_initializer_with_work(report, trace, left, expected_left, target, source_work, depth + 1, true) and proof_replay_mutable_local_authenticated_initializer_with_work(report, trace, right, expected_right, target, source_work, depth + 1, true)
                        _:
                            return false
                Ast::Expr.Unary(TokenKind.Minus, inner, _):
                    match expected:
                        Ast::Expr.Unary(TokenKind.Minus, expected_inner, _):
                            return proof_replay_mutable_local_authenticated_initializer_with_work(report, trace, inner, expected_inner, target, source_work, depth + 1, true)
                        _:
                            return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    match expected:
                        Ast::Expr.If(expected_condition, expected_then, expected_else, _):
                            condition_equal: mutable bool = false
                            return false if:
                                not proof_replay_mutable_local_expr_equal_with_work(condition, expected_condition, &condition_equal, source_work) or not condition_equal
                                not proof_replay_summary_expr_charge_with_work(condition, source_work)
                                not proof_replay_local_binding_stable_condition(condition, target, report.source_declarations, trace.name, report.replay_owner_line, depth + 1)
                            return proof_replay_mutable_local_authenticated_initializer_with_work(report, trace, then_expression, expected_then, target, source_work, depth + 1, true) and proof_replay_mutable_local_authenticated_initializer_with_work(report, trace, else_expression, expected_else, target, source_work, depth + 1, true)
                        _:
                            return false
                _:
                    return false

        def proof_replay_local_binding_mutable_local_source(report: ProofReport&, trace: ProofFactTrace, loop_entry: bool) -> bool:
            source_work: mutable usize = 0
            return proof_replay_local_binding_mutable_local_source_with_work(report, trace, loop_entry, &source_work)

        def proof_replay_local_binding_mutable_local_source_with_work(report: ProofReport&, trace: ProofFactTrace, loop_entry: bool, source_work: mutable usize&) -> bool:
            return false if trace.name == "" or trace.line == 0 or report.trace_owner_line == 0
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(local_name, _), TokenKind.EqEq, value, position):
                    return false if:
                        local_name == "" or proof_internal_name_is_rebind(local_name) or position.line != trace.line
                        not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                    owner_scan_start: usize = source_work
                    return false if not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                    owner_scan_work: usize = source_work - owner_scan_start
                    return false if:
                        not proof_replay_summary_expr_charge_with_work(value, source_work)
                        proof_source_expression_has_overloaded_operator(value, report.source_primitive_operator_mask, 0)
                        not proof_replay_summary_expr_charge_with_work(value, source_work)
                        not proof_replay_summary_expr_charge_with_work(value, source_work)
                        not proof_replay_mutable_local_identifier_scan_charge(value, owner_scan_work, source_work)
                        not proof_replay_mutable_local_stable_value(report, value, local_name, trace.name, source_work, 0)
                        proof_replay_local_binding_parameter_name_present_with_default_limit(report.source_declarations, trace.name, report.replay_owner_line, local_name, source_work, 0)
                        proof_replay_local_binding_global_constant_named_with_work(report.source_declarations, local_name, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                    body: mutable darray[Ast::Stmt] = []
                    return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    consumer_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    consumer_position_valid: bool = proof_replay_mutable_local_consumer_position_with_work(report, trace, body, &consumer_position, source_work)
                    return false if not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
                    single_top_level_declaration: bool = proof_replay_source_single_declaration_with_work(report.source_declarations, body, local_name, source_work)
                    if single_top_level_declaration:
                        return false if not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
                        if proof_replay_mutable_local_declared(body, local_name):
                            return proof_replay_mutable_local_site(report, trace, trace.name, body, local_name, trace.expression, value, report.trace_owner_line, consumer_position, consumer_position_valid, false, loop_entry, 0, source_work) == ProofReplayLocalAlias::VALID
                    # A nested loop can consume a local declared in its enclosing body.
                    # Require its unique lexical declaration and keep the consumer inside that
                    # body; the existing site rule still distinguishes entry from preservation.
                    condition: mutable Ast::Expr = Ast::Expr.Invalid
                    loop_body: mutable darray[Ast::Stmt] = []
                    lexical_body: mutable darray[Ast::Stmt] = []
                    nested_unique: bool = proof_replay_nested_local_unique_with_work(report.source_declarations, body, local_name, source_work)
                    loop_scope_found: bool = proof_replay_loop_scope_with_work(body, report.trace_owner_line, &condition, &loop_body, &lexical_body, source_work)
                    if nested_unique and loop_scope_found:
                        return false if not proof_replay_mutable_local_body_work_charge(lexical_body, source_work, 0)
                        if proof_replay_mutable_local_declared(lexical_body, local_name):
                            return proof_replay_mutable_local_site(report, trace, trace.name, lexical_body, local_name, trace.expression, value, report.trace_owner_line, consumer_position, consumer_position_valid, true, loop_entry, 0, source_work) == ProofReplayLocalAlias::VALID
                    return proof_replay_mutable_local_header_site(report, trace, body, local_name, value, consumer_position, consumer_position_valid, loop_entry, source_work)
                _:
                    return false

        # A loop header capture `|best: T = v|` declares its local inside a top-level block that
        # holds the declarations and the loop (a statement, the returned tail value, or a declaration's
        # initializer). Such a local is checked inside that block alone: it
        # must be declared exactly once there with an integer type, the binding site must be valid
        # within it, the consumer must lie inside it (nested), and exactly one such block may match.
        def proof_replay_mutable_local_header_site(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&, local_name: sview, value: Ast::Expr, consumer_position: Ast::Pos, consumer_position_valid: bool, loop_entry: bool, source_work: mutable usize&) -> bool:
            found: mutable usize = ProofReplayLocalAlias::ABSENT
            for statement in body |report, trace, local_name, value, consumer_position, consumer_position_valid, loop_entry, found, source_work|:
                return false if not proof_replay_mutable_local_statement_work_charge(statement, source_work, 0)
                match statement:
                    Ast::Stmt.Expr(block, _) | Ast::Stmt.Return(block, _) | Ast::Stmt.VarDecl(_, _, block, _):
                        match proof_replay_source_unwrap_empty_value_block(block, 0):
                            Ast::Expr.Block(inner, _, _, _):
                                return false if not proof_replay_mutable_local_body_work_charge(inner, source_work, 0)
                                if proof_replay_source_single_declaration_with_work(report.source_declarations, inner, local_name, source_work):
                                    return false if not proof_replay_mutable_local_body_work_charge(inner, source_work, 0)
                                    if proof_replay_mutable_local_declared(inner, local_name):
                                        found <- proof_replay_mutable_local_merge(found, proof_replay_mutable_local_site(report, trace, trace.name, inner, local_name, trace.expression, value, report.trace_owner_line, consumer_position, consumer_position_valid, true, loop_entry, 0, source_work))
                            _:
                                pass
                    _:
                        pass
            return found == ProofReplayLocalAlias::VALID
