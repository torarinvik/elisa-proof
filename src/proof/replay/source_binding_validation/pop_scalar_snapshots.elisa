# Independently reconstruct a scalar last-element snapshot. This route never admits the
# pre-pop array equality as a fact about the later array state.
extend ElisaProof:
    private:
        def proof_replay_pop_snapshot_name_clear_with_work(declarations: darray[Ast::Decl]&, target: sview, depth: usize, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or target == ""
            for declaration in declarations |declarations, target, depth, source_work|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, body, _, _, _):
                        return false if not proof_replay_mutable_local_text_compare_work_charge(name, target, source_work) or name == target
                        for parameter in parameters |target, source_work|:
                            return false if not proof_replay_mutable_local_text_compare_work_charge(parameter.name, target, source_work) or parameter.name == target
                        return false if proof_replay_source_body_declares_with_work(declarations, body, target, source_work)
                    Ast::Decl.Const(name, _, _, _, _) | Ast::Decl.Extern(name, _, _, _, _, _, _, _) | Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Enum(name, _, _, _, _) | Ast::Decl.Alias(name, _, _):
                        return false if not proof_replay_mutable_local_text_compare_work_charge(name, target, source_work) or name == target
                    Ast::Decl.Module(name, nested, _):
                        return false if not proof_replay_mutable_local_text_compare_work_charge(name, target, source_work) or name == target or not proof_replay_pop_snapshot_name_clear_with_work(nested, target, depth + 1, source_work)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_pop_snapshot_name_clear_with_work(nested, target, depth + 1, source_work)
                    _:
                        return false
            return true

        def proof_replay_pop_snapshot_element_type(expression: Ast::Expr, depth: usize) -> Ast::Expr:
            return Ast::Expr.Invalid if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_pop_snapshot_element_type(inner, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_pop_snapshot_element_type(inner, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                Ast::Expr.Index(Ast::Expr.Ident(name, _), element, _):
                    return element if name == "darray"
                _:
                    pass
            return Ast::Expr.Invalid

        def proof_replay_pop_snapshot_literal_fits(type_expression: Ast::Expr, value: i64) -> bool:
            return false if value < 0
            match type_expression:
                Ast::Expr.Ident(name, _):
                    return value <= 255 if name == "u8"
                    return value <= 65535 if name == "u16"
                    return value <= 4294967295 if name == "u32"
                    return true if name == "u64"
                _:
                    pass
            return false

        def proof_replay_pop_snapshot_count(expression: Ast::Expr, receiver: sview) -> bool:
            match expression:
                Ast::Expr.Field(Ast::Expr.Ident(name, _), field, _):
                    return name == receiver and field == "count"
                _:
                    return false

        def proof_replay_pop_snapshot_nonempty(expression: Ast::Expr, receiver: sview, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return proof_replay_pop_snapshot_nonempty(left, receiver, depth + 1) or proof_replay_pop_snapshot_nonempty(right, receiver, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_pop_snapshot_nonempty(inner, receiver, depth + 1)
                Ast::Expr.Binary(count, operator, Ast::Expr.IntLit(bound, _), _):
                    return proof_replay_pop_snapshot_count(count, receiver) and ((operator == TokenKind.GtEq and bound >= 1) or (operator == TokenKind.Gt and bound >= 0))
                Ast::Expr.Binary(Ast::Expr.IntLit(bound, _), operator, count, _):
                    return proof_replay_pop_snapshot_count(count, receiver) and ((operator == TokenKind.LtEq and bound >= 1) or (operator == TokenKind.Lt and bound >= 0))
                _:
                    return false

        def proof_replay_pop_snapshot_last(expression: Ast::Expr, receiver: sview) -> bool:
            match expression:
                Ast::Expr.Index(object, index, _):
                    return false if proof_replay_ident_name(object) != receiver
                    match index:
                        Ast::Expr.Binary(count, TokenKind.Minus, offset, _):
                            match offset:
                                Ast::Expr.IntLit(value, _):
                                    return value == 1 and proof_replay_pop_snapshot_count(count, receiver)
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false

        def proof_replay_pop_snapshot_receiver(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Call(callee, arguments, names, _):
                    return "" if arguments.count != 0 or names.count != 0
                    match callee:
                        Ast::Expr.Field(object, method, _):
                            return proof_replay_ident_name(object) if method == "pop"
                        _:
                            pass
                _:
                    pass
            return ""

        def proof_replay_pop_snapshot_value(expression: Ast::Expr, receiver: sview, wanted: i64, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return proof_replay_pop_snapshot_value(left, receiver, wanted, depth + 1) or proof_replay_pop_snapshot_value(right, receiver, wanted, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_pop_snapshot_value(inner, receiver, wanted, depth + 1)
                Ast::Expr.Binary(slot, TokenKind.EqEq, Ast::Expr.IntLit(value, _), _):
                    return value == wanted and proof_replay_pop_snapshot_last(slot, receiver)
                Ast::Expr.Binary(Ast::Expr.IntLit(value, _), TokenKind.EqEq, slot, _):
                    return value == wanted and proof_replay_pop_snapshot_last(slot, receiver)
                _:
                    return false

        def proof_replay_pop_snapshot_entry(report: ProofReport&, body: darray[Ast::Stmt]&, site: usize, receiver: sview, wanted: i64, source_work: mutable usize&) -> bool:
            nonempty: mutable bool = false
            value_known: mutable bool = false
            leading: mutable bool = true
            for index in 0..<site |index, report, body, receiver, wanted, nonempty, value_known, leading|:
                statement: Ast::Stmt = body[index]
                match statement:
                    Ast::Stmt.Contract(kind, expression, _):
                        if kind == "requires" and leading:
                            return false if not proof_replay_summary_expr_repeat_charge_with_work(expression, 2, source_work)
                            nonempty <- nonempty or proof_replay_pop_snapshot_nonempty(expression, receiver, 0)
                            value_known <- value_known or proof_replay_pop_snapshot_value(expression, receiver, wanted, 0)
                        if kind in {"ensure", "ensures"}:
                            return false if proof_replay_entry_count_postcondition_written(report.source_declarations, expression, receiver, 0, source_work)
                        elif kind != "requires":
                            return false
                        else:
                            return false if proof_replay_source_statement_touches_with_work(report.source_declarations, statement, receiver, true, source_work)
                    _:
                        return false
            return nonempty and value_known

        def proof_replay_pop_scalar_snapshot_source(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if trace.kind != "proof-step" or trace.name == "" or trace.line == 0
            match trace.expression:
                Ast::Expr.Binary(local_expression, TokenKind.EqEq, Ast::Expr.IntLit(wanted, _), _):
                    local: sview = proof_replay_ident_name(local_expression)
                    return false if local == "" or proof_internal_name_is_rebind(local)
                    source_work: mutable usize = 0
                    return false if:
                        not proof_replay_summary_owner_source_preflight(report, trace.name, report.replay_owner_line, source_work)
                        proof_replay_local_binding_parameter_name_present_with_default_limit(report.source_declarations, trace.name, report.replay_owner_line, local, source_work, 0)
                        proof_replay_local_binding_global_constant_named_with_work(report.source_declarations, local, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                    body: mutable darray[Ast::Stmt] = []
                    return false if not proof_replay_source_owner_body_with_work(report, trace.name, report.replay_owner_line, &body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    active_consumer: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    return false if:
                        not proof_replay_mutable_local_consumer_position_with_work(report, trace, body, &active_consumer, source_work)
                        not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
                        not proof_replay_source_single_declaration_with_work(report.source_declarations, body, local, source_work)
                    consumer_count: mutable usize = 0
                    return_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                    for statement in body |local, consumer_count, return_position|:
                        match statement:
                            Ast::Stmt.Return(Ast::Expr.Ident(name, position), _):
                                if name == local:
                                    consumer_count <- consumer_count + 1
                                    return_position <- position
                            _:
                                pass
                    return false if:
                        consumer_count != 1 or return_position.line == 0 or return_position.offset == 0 or return_position.end_offset <= return_position.offset
                        active_consumer.offset == 0 or active_consumer.offset >= return_position.offset
                    for index in 0..<body.count |index, body, local, local_expression, wanted, report, trace|:
                        match body[index]:
                            Ast::Stmt.VarDecl(name, local_type, initializer, position):
                                receiver: sview = proof_replay_pop_snapshot_receiver(initializer)
                                continue if name != local or receiver == ""
                                continue if not proof_replay_local_binding_pos_matches(local_expression, position)
                                return false if not proof_replay_pop_snapshot_literal_fits(local_type, wanted)
                                primitive: sview = proof_replay_ident_name(local_type)
                                return false if not proof_replay_pop_snapshot_name_clear_with_work(report.source_declarations, "pop", 0, source_work) or not proof_replay_pop_snapshot_name_clear_with_work(report.source_declarations, "darray", 0, source_work) or not proof_replay_pop_snapshot_name_clear_with_work(report.source_declarations, primitive, 0, source_work)
                                parameter: (count: usize, type_expression: Ast::Expr) = proof_scalar_reference_parameter_type_in_declarations_with_work(report.source_declarations, trace.name, receiver, 0, &source_work)
                                return false if parameter.count != 1 or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                parameter_markers: (reference: bool, mutable_reference: bool, mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_with_work(parameter.type_expression, report.source_declarations, report.source_generic_param_lines, report.source_generic_param_names, report.replay_owner_line, report.source_effect_index, report.source_generic_params_valid and report.source_generic_param_lines.count == report.source_generic_param_names.count, &source_work)
                                return false if:
                                    source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or not parameter_markers.reference or not parameter_markers.mutable_reference
                                    not proof_replay_summary_expr_equal_with_work(proof_replay_pop_snapshot_element_type(parameter.type_expression, 0), local_type, source_work)
                                    not proof_replay_local_binding_parameter_source_unshadowed_with_work(report.source_declarations, trace.name, report.replay_owner_line, receiver, source_work)
                                    not proof_replay_pop_snapshot_entry(report, body, index, receiver, wanted, source_work)
                                return proof_replay_mutable_local_live_with_work(report, trace.name, body, index, local, active_consumer.line, false, false, active_consumer, true, source_work)
                            _:
                                pass
                    return false
                _:
                    return false
