# Work-bounded queries over the source function's formal parameters.
extend ElisaProof:
    private:
        def proof_replay_local_binding_integer_parameter_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, parameter_name, source_work, depth|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return false if not proof_replay_mutable_local_text_compare_work_charge(name, owner, source_work)
                        if name == owner and position.line == owner_line:
                            matches: mutable usize = 0
                            valid: mutable bool = false
                            for parameter in parameters |parameter_name, matches, valid, source_work|:
                                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                                return false if not proof_replay_mutable_local_text_compare_work_charge(parameter.name, parameter_name, source_work)
                                if parameter.name == parameter_name:
                                    matches <- matches + 1
                                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(parameter.type_expression, 2, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                    valid <- proof_replay_local_binding_integer_type(parameter.type_expression, 0) and not proof_replay_local_binding_mutable_integer_type(parameter.type_expression)
                            return matches == 1 and valid
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_local_binding_integer_parameter_with_work(nested, owner, owner_line, parameter_name, source_work, depth + 1)
                    _:
                        pass
            return false

        def proof_replay_local_binding_unsigned_parameter_type_name_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, depth: usize) -> sview:
            return "" if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, parameter_name, source_work, depth|:
                return "" if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return "" if not proof_replay_mutable_local_text_compare_work_charge(name, owner, source_work)
                        if name == owner and position.line == owner_line:
                            matches: mutable usize = 0
                            type_name: mutable sview = ""
                            for parameter in parameters |parameter_name, matches, type_name, source_work|:
                                return "" if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                                return "" if not proof_replay_mutable_local_text_compare_work_charge(parameter.name, parameter_name, source_work)
                                if parameter.name == parameter_name:
                                    matches <- matches + 1
                                    return "" if not proof_replay_summary_expr_repeat_charge_with_limit(parameter.type_expression, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                    type_name <- proof_replay_local_binding_unsigned_type_name(parameter.type_expression, 0)
                            return "" if matches != 1
                            return type_name
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        nested_type: sview = proof_replay_local_binding_unsigned_parameter_type_name_with_work(nested, owner, owner_line, parameter_name, source_work, depth + 1)
                        return nested_type if nested_type != ""
                    _:
                        pass
            return ""

        def proof_replay_local_binding_initializer_valid_with_work(expression: Ast::Expr, target: sview, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return false if name == target
                    return proof_replay_local_binding_integer_parameter_with_work(declarations, owner, owner_line, name, source_work, 0)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_initializer_valid_with_work(inner, target, declarations, owner, owner_line, source_work, depth + 1)
                _:
                    return false

        def proof_replay_local_binding_condition_valid_with_work(condition: Ast::Expr, target: sview, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match condition:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_condition_valid_with_work(inner, target, declarations, owner, owner_line, source_work, depth + 1)
                Ast::Expr.Binary(Ast::Expr.Ident(left_name, _), operator, right, _):
                    return false if left_name != target or (operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq)
                    match right:
                        Ast::Expr.IntLit(_, _):
                            return true
                        Ast::Expr.Ident(right_name, _):
                            return proof_replay_local_binding_integer_parameter_with_work(declarations, owner, owner_line, right_name, source_work, 0)
                        _:
                            return false
                _:
                    return false

        def proof_replay_local_binding_rebind_bound_with_work(condition: Ast::Expr, target: sview, target_type: Ast::Expr, declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, source_work: mutable usize&, depth: usize) -> sview:
            return "" if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match condition:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_rebind_bound_with_work(inner, target, target_type, declarations, owner, owner_line, source_work, depth + 1)
                Ast::Expr.Binary(Ast::Expr.Ident(left_name, _), TokenKind.Lt, Ast::Expr.Ident(right_name, _), _):
                    return "" if left_name != target or right_name == target
                    return "" if not proof_replay_summary_expr_repeat_charge_with_limit(target_type, 1, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    target_type_name: sview = proof_replay_local_binding_unsigned_type_name(target_type, 0)
                    return "" if target_type_name == ""
                    bound_type_name: sview = proof_replay_local_binding_unsigned_parameter_type_name_with_work(declarations, owner, owner_line, right_name, source_work, 0)
                    return right_name if bound_type_name == target_type_name
                    return ""
                _:
                    return ""
