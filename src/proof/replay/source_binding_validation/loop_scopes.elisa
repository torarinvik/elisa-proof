# Locate a unique source loop and the lexical statement list containing it.
# Callers still establish entry/preservation and binding liveness independently.
extend ElisaProof:
    private:
        def proof_replay_loop_scope_walk(statements: darray[Ast::Stmt]&, line: u32, condition: mutable Ast::Expr&, loop_body: mutable darray[Ast::Stmt]&, lexical_body: mutable darray[Ast::Stmt]&, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            loop_position: mutable Ast::Pos = Ast::pos_at_line(0)
            proof_replay_control_find_loop_source(statements, line, condition, loop_body, lexical_body, &loop_position, matches, depth, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, true)

        def proof_replay_loop_scope(statements: darray[Ast::Stmt]&, line: u32, condition: mutable Ast::Expr&, loop_body: mutable darray[Ast::Stmt]&, lexical_body: mutable darray[Ast::Stmt]&) -> bool:
            source_work: mutable usize = 0
            proof_replay_loop_scope_with_work(statements, line, condition, loop_body, lexical_body, &source_work)

        def proof_replay_loop_scope_with_work(statements: darray[Ast::Stmt]&, line: u32, condition: mutable Ast::Expr&, loop_body: mutable darray[Ast::Stmt]&, lexical_body: mutable darray[Ast::Stmt]&, source_work: mutable usize&) -> bool:
            proof_replay_loop_scope_with_limit(statements, line, condition, loop_body, lexical_body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_replay_loop_scope_with_limit(statements: darray[Ast::Stmt]&, line: u32, condition: mutable Ast::Expr&, loop_body: mutable darray[Ast::Stmt]&, lexical_body: mutable darray[Ast::Stmt]&, source_work: mutable usize&, source_work_limit: usize) -> bool:
            return false if source_work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or line == 0 or source_work > source_work_limit
            matches: mutable usize = 0
            walk_work: mutable usize = 0
            remaining_work: usize = source_work_limit - source_work
            walk_limit: usize = remaining_work
            loop_position: mutable Ast::Pos = Ast::pos_at_line(0)
            walk_complete: bool = proof_replay_control_find_loop_source(statements, line, condition, loop_body, lexical_body, &loop_position, &matches, 0, &walk_work, walk_limit, true)
            return false if walk_work > remaining_work
            source_work <- source_work + walk_work
            return false if not walk_complete
            matches == 1

        def proof_replay_nested_local_expression(declarations: darray[Ast::Decl]&, expression: Ast::Expr, name: sview, count: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_nested_local_expression(declarations, callee, name, count, work, depth + 1)
                    for argument in arguments |declarations, name, count, work, depth|:
                        return false if not proof_replay_nested_local_expression(declarations, argument, name, count, work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |declarations, name, count, work, depth|:
                        return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        work <- work + 1
                        for capture in candidate.captures |declarations, name, count, work, depth|:
                            return false if not proof_replay_nested_local_expression(declarations, capture, name, count, work, depth + 1)
                    for argument in arguments |declarations, name, count, work, depth|:
                        return false if not proof_replay_nested_local_expression(declarations, argument, name, count, work, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_nested_local_expression(declarations, object, name, count, work, depth + 1)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return false if not proof_replay_nested_local_expression(declarations, object, name, count, work, depth + 1)
                    return proof_replay_nested_local_expression(declarations, index, name, count, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return false if:
                        not proof_replay_nested_local_expression(declarations, object, name, count, work, depth + 1)
                        not proof_replay_nested_local_expression(declarations, low, name, count, work, depth + 1)
                    return proof_replay_nested_local_expression(declarations, high, name, count, work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_nested_local_expression(declarations, object, name, count, work, depth + 1)
                    for argument in arguments |declarations, name, count, work, depth|:
                        return false if not proof_replay_nested_local_expression(declarations, argument, name, count, work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |declarations, name, count, work, depth|:
                        return false if not proof_replay_nested_local_expression(declarations, element, name, count, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |declarations, name, count, work, depth|:
                        return false if:
                            not proof_replay_nested_local_expression(declarations, entry.key, name, count, work, depth + 1)
                            not proof_replay_nested_local_expression(declarations, entry.value, name, count, work, depth + 1)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_nested_local_expression(declarations, base, name, count, work, depth + 1)
                    for field in fields |declarations, name, count, work, depth|:
                        return false if not proof_replay_nested_local_expression(declarations, field.value, name, count, work, depth + 1)
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return false if not proof_replay_nested_local_expression(declarations, subject, name, count, work, depth + 1)
                    for arm in arms |declarations, name, count, work, depth|:
                        return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        work <- work + 1
                        return false if:
                            proof_replay_source_pattern_binds_with_work(arm.pattern, name, work, 0)
                            not proof_replay_nested_local_expression(declarations, arm.guard, name, count, work, depth + 1)
                            not proof_replay_nested_local_declarations(declarations, arm.body, name, count, work, depth + 1)
                Ast::Expr.Comprehension(variable, iterable, condition, value, _):
                    return false if:
                        variable == name
                        not proof_replay_nested_local_expression(declarations, iterable, name, count, work, depth + 1)
                        not proof_replay_nested_local_expression(declarations, condition, name, count, work, depth + 1)
                    return proof_replay_nested_local_expression(declarations, value, name, count, work, depth + 1)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_nested_local_expression(declarations, guarded, name, count, work, depth + 1)
                    return proof_replay_nested_local_declarations(declarations, recovery, name, count, work, depth + 1)
                Ast::Expr.Lambda(parameters, body, _):
                    return false if any parameter in parameters where parameter == name
                    nested_count: mutable usize = 0
                    return false if not proof_replay_nested_local_declarations(declarations, body, name, &nested_count, work, depth + 1)
                    return nested_count == 0
                Ast::Expr.Block(statements, value, captures, _):
                    return false if:
                        any capture in captures where capture == name
                        not proof_replay_nested_local_declarations(declarations, statements, name, count, work, depth + 1)
                    return proof_replay_nested_local_expression(declarations, value, name, count, work, depth + 1)
                _:
                    return false
            return true

        def proof_replay_nested_local_declarations(declarations: darray[Ast::Decl]&, statements: darray[Ast::Stmt]&, name: sview, count: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64
            for statement in statements |declarations, name, count, work, depth|:
                return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                work <- work + 1
                match statement:
                    Ast::Stmt.VarDecl(local, _, initializer, _):
                        count <- count + 1 if local == name
                        return false if not proof_replay_nested_local_expression(declarations, initializer, name, count, work, depth + 1)
                    Ast::Stmt.While(condition, inner, _):
                        return false if:
                            not proof_replay_nested_local_expression(declarations, condition, name, count, work, depth + 1)
                            not proof_replay_nested_local_declarations(declarations, inner, name, count, work, depth + 1)
                    Ast::Stmt.For(_, variables, iterable, inner, _):
                        return false if:
                            any variable in variables where variable == name
                            not proof_replay_nested_local_expression(declarations, iterable, name, count, work, depth + 1)
                            not proof_replay_nested_local_declarations(declarations, inner, name, count, work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if:
                            not proof_replay_nested_local_expression(declarations, condition, name, count, work, depth + 1)
                            not proof_replay_nested_local_declarations(declarations, yes, name, count, work, depth + 1)
                            not proof_replay_nested_local_declarations(declarations, no, name, count, work, depth + 1)
                    Ast::Stmt.Match(subject, arms, _):
                        return false if not proof_replay_nested_local_expression(declarations, subject, name, count, work, depth + 1)
                        for arm in arms |declarations, name, count, work, depth|:
                            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            work <- work + 1
                            return false if:
                                proof_replay_source_pattern_binds_with_work(arm.pattern, name, work, 0)
                                not proof_replay_nested_local_expression(declarations, arm.guard, name, count, work, depth + 1)
                                not proof_replay_nested_local_declarations(declarations, arm.body, name, count, work, depth + 1)
                    Ast::Stmt.Block(_, clause, binding, inner, _):
                        return false if:
                            binding == name or any word in clause where word == name
                            not proof_replay_nested_local_declarations(declarations, inner, name, count, work, depth + 1)
                    Ast::Stmt.Assign(target, operator, value, _):
                        return false if:
                            operator == TokenKind.Assign and proof_replay_ident_name(target) == name
                            not proof_replay_nested_local_expression(declarations, target, name, count, work, depth + 1)
                            not proof_replay_nested_local_expression(declarations, value, name, count, work, depth + 1)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_nested_local_expression(declarations, expression, name, count, work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            true

        def proof_replay_nested_local_unique_with_work(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, source_work: mutable usize&) -> bool:
            count: mutable usize = 0
            work: mutable usize = 0
            return false if name == "" or not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
            # The first charge meters its full-tree cost walk. Reserve the actual recursive
            # declaration/expression traversal separately before entering the legacy scanners.
            return false if:
                not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
                not proof_replay_nested_local_declarations(declarations, body, name, &count, &work, 0)
            count == 1
