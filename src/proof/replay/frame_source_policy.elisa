# Source reconstruction only. Header clauses, field type checking and certificate
# correspondence must be checked before this policy can authorize admission.
extend ElisaProofFrameSource:
    public:
        struct Clause:
            kind: sview
            place: ElisaProofKernelFramePolicy::Place
            position: Ast::Pos

        def body_policy(declarations: darray[Ast::Decl]&, name: sview, line: u32) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            work: mutable usize = 0
            return body_policy_with_work(declarations, name, line, &work)

        def body_policy_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, work: mutable usize&) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            context = owner_with_work(declarations, name, line, work)
            return (false, 0, []) if:
                not context.known or context.body.count > 4096
                not replay_work_charge(context.body.count, work)
            clauses: mutable darray[Clause] = []
            for statement in context.body |context, clauses, work|:
                match statement:
                    Ast::Stmt.Contract(kind, expression, position):
                        return (false, 0, []) if not replay_work_charge(sview_len(kind), work)
                        if kind in {"changes", "preserves"}:
                            return (false, 0, []) if clauses.count >= 64 or position.line == 0
                            decoded = place_with_work(expression, &context.formals, work)
                            return (false, 0, []) if not decoded.known
                            clauses.push(Clause{kind: kind, place: decoded.place, position: position})
                    _:
                        pass
            return (true, context.formals.count, clauses)
