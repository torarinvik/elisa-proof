# Source reconstruction only. Header clauses, field type checking and certificate
# correspondence must be checked before this policy can authorize admission.
extend ElisaProofFrameSource:
    public:
        struct Clause:
            kind: sview
            place: ElisaProofKernelFramePolicy::Place
            position: Ast::Pos

        def body_policy(declarations: darray[Ast::Decl]&, name: sview, line: u32) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            context = owner(declarations, name, line)
            return (false, 0, []) if not context.known or context.body.count > 4096
            clauses: mutable darray[Clause] = []
            for statement in context.body |context, clauses|:
                match statement:
                    Ast::Stmt.Contract(kind, expression, position):
                        if kind == "changes" or kind == "preserves":
                            return (false, 0, []) if clauses.count >= 64 or position.line == 0
                            decoded = place(expression, &context.formals)
                            return (false, 0, []) if not decoded.known
                            clauses.push(Clause{kind: kind, place: decoded.place, position: position})
                    _:
                        pass
            return (true, context.formals.count, clauses)
