# Replay-owned index for generic-formal markers on type aliases.
extend ElisaProof:
    private:
        def proof_replay_type_bound_alias_formal_key_hash(name: sview, line: u32) -> u32:
            proof_expr_shape_mix(proof_name_hash(name), line.i64())

        def proof_replay_type_bound_alias_formal_index_ensure(report: ProofReport&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            index: mutable ProofReplayAliasFormalIndex& = &cache.alias_formal_index
            report_identity: uintptr = (&report).cast[uintptr]
            source_identity: uintptr = report.source.source_file_identity
            if index.attempted and index.report_identity == report_identity and index.source_identity == source_identity:
                return index.valid
            index.hashes.clear()
            index.rows.clear()
            index.counts.clear()
            index.entries <- 0
            index.attempted <- true
            index.valid <- false
            index.report_identity <- report_identity
            index.source_identity <- source_identity
            annotation_count: usize = report.source.source_annotations.count
            entries: mutable usize = 0
            for row in 0..<annotation_count |row, report, entries, work|:
                annotation: Ast::EnumAnnotation = report.source.source_annotations[row]
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                return false if not proof_replay_type_bound_local_text_compare_charge(annotation.owner, "__alias_owner", work)
                marker: bool = annotation.owner == "__alias_owner"
                if marker:
                    return false if not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                    entries <- entries + 1
            return false if entries > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT / 2
            capacity: usize = proof_name_index_capacity(entries)
            return false if entries > 0 and capacity == 0
            return false if not proof_replay_type_bound_local_work_charge(capacity, work)
            index.hashes.resize(capacity)
            index.rows.resize(capacity)
            index.counts.resize(capacity)
            for slot in 0..<capacity |slot, index, annotation_count|:
                index.rows[slot] <- annotation_count
                index.counts[slot] <- 0
            for row in 0..<annotation_count |row, report, index, entries, capacity, work|:
                annotation: Ast::EnumAnnotation = report.source.source_annotations[row]
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                return false if not proof_replay_type_bound_local_text_compare_charge(annotation.owner, "__alias_owner", work)
                marker: bool = annotation.owner == "__alias_owner"
                continue if not marker
                return false if not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                hash: u32 = proof_replay_type_bound_alias_formal_key_hash(annotation.name, annotation.line)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, row, annotation, index, capacity, hash, report, annotation_count, work, placed|:
                    return false if not proof_replay_type_bound_local_work_charge(1, work)
                    current: usize = index.rows[slot]
                    if current == annotation_count:
                        index.hashes[slot] <- hash
                        index.rows[slot] <- row
                        index.counts[slot] <- 1
                        placed <- true
                        break
                    return false if current >= annotation_count
                    prior: Ast::EnumAnnotation = report.source.source_annotations[current]
                    return false if not proof_replay_type_bound_local_text_compare_charge(prior.owner, annotation.owner, work)
                    if index.hashes[slot] == hash and prior.owner == annotation.owner:
                        return false if not proof_replay_type_bound_local_text_compare_charge(prior.name, annotation.name, work)
                        if prior.name == annotation.name and prior.line == annotation.line:
                            index.counts[slot] <- index.counts[slot] + 1
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not placed
            index.entries <- entries
            cluster: (complete: bool, bounded: bool, observed: usize) = proof_name_index_cluster_status(index.rows, annotation_count, work)
            index.valid <- cluster.complete and cluster.bounded and work <= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            return index.valid

        def proof_replay_type_bound_enum_alias_has_formals_with_work(report: ProofReport&, alias_name: sview, alias_line: u32, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> (complete: bool, has_formals: bool):
            return (false, false) if alias_line == 0 or not proof_replay_type_bound_alias_formal_index_ensure(report, work, cache)
            index: ProofReplayAliasFormalIndex& = cache.alias_formal_index
            return (false, false) if not index.valid or index.hashes.count != index.rows.count or index.hashes.count != index.counts.count
            annotation_count: usize = report.source.source_annotations.count
            expected_capacity: usize = proof_name_index_capacity(index.entries)
            return (false, false) if index.rows.count != expected_capacity
            return (true, false) if index.entries == 0
            return (false, false) if not proof_replay_type_bound_local_work_charge(sview_len(alias_name), work)
            hash: u32 = proof_replay_type_bound_alias_formal_key_hash(alias_name, alias_line)
            slot: mutable usize = (hash.i64() % index.rows.count.i64()).usize()
            probes: mutable usize = 0
            while probes < index.rows.count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, alias_name, alias_line, index, annotation_count, report, work|:
                return (false, false) if not proof_replay_type_bound_local_work_charge(1, work)
                row: usize = index.rows[slot]
                return (true, false) if row == annotation_count
                return (false, false) if row >= annotation_count
                if index.hashes[slot] == hash:
                    annotation: Ast::EnumAnnotation = report.source.source_annotations[row]
                    return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.name, alias_name, work)
                    if annotation.name == alias_name and annotation.line == alias_line:
                        return (false, false) if index.counts[slot] != 1
                        return (true, true)
                slot <- (slot + 1) % index.rows.count
                probes <- probes + 1
            return (false, false)
