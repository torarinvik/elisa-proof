extend ElisaProof:
    private:
        const PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT: usize = 1048576

        # Budget the exact call-site matcher independently from the enclosing source walk.
        # A failed candidate may still recurse through its arguments looking for the expected
        # nested call, so charge each recursive comparison and every compared argument name.
        def proof_replay_deterministic_call_match_charge(amount: usize, work: mutable usize&, complete: mutable bool&) -> bool:
            complete_now: bool = complete
            if not complete_now or work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
                complete <- false
                return false
            work <- work + amount
            return true

        def proof_replay_deterministic_call_match_text_charge(value: sview, work: mutable usize&, complete: mutable bool&) -> bool:
            return false if not proof_replay_deterministic_call_match_charge(1, work, complete)
            return proof_replay_deterministic_call_match_charge(sview_len(value), work, complete)

        def proof_replay_deterministic_call_match_text_equal(left: sview, right: sview, work: mutable usize&, complete: mutable bool&) -> bool:
            return false if:
                not proof_replay_deterministic_call_match_text_charge(left, work, complete)
                not proof_replay_deterministic_call_match_text_charge(right, work, complete)
            return left == right

        def proof_replay_deterministic_call_arguments_equal_with_work(source: darray[Ast::Expr]&, source_names: darray[sview]&, expected: darray[Ast::Expr]&, expected_names: darray[sview]&, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            return false if:
                not proof_replay_deterministic_call_match_charge(1, work, complete)
                source.count != expected.count
                source_names.count != 0 and source_names.count != source.count
                expected_names.count != 0 and expected_names.count != expected.count
            for index in 0..<source.count |index, source, source_names, expected, expected_names, work, complete, depth|:
                return false if not proof_replay_deterministic_call_match_charge(1, work, complete)
                source_name: sview = source_names[index] if source_names.count > 0 else ""
                expected_name: sview = expected_names[index] if expected_names.count > 0 else ""
                return false if:
                    not proof_replay_deterministic_call_match_charge(1, work, complete)
                    not proof_replay_deterministic_call_match_charge(sview_len(source_name), work, complete)
                    not proof_replay_deterministic_call_match_charge(sview_len(expected_name), work, complete)
                    source_name != expected_name
                    not proof_replay_deterministic_call_expression_equal_with_work(source[index], expected[index], work, complete, depth + 1)
            return true

        def proof_replay_deterministic_call_expression_equal_with_work(source: Ast::Expr, expected: Ast::Expr, work: mutable usize&, complete: mutable bool&, depth: usize) -> bool:
            if depth >= 96 or not proof_replay_deterministic_call_match_charge(1, work, complete):
                complete <- false
                return false
            match source:
                Ast::Expr.Call(source_callee, source_arguments, source_names, source_position):
                    match expected:
                        Ast::Expr.Call(expected_callee, expected_arguments, expected_names, expected_position):
                            return false if:
                                not proof_replay_deterministic_call_match_charge(7, work, complete)
                                source_position.line != expected_position.line or source_position.column != expected_position.column or source_position.offset != expected_position.offset or source_position.end_line != expected_position.end_line or source_position.end_column != expected_position.end_column or source_position.end_offset != expected_position.end_offset
                            callee_equal: bool = proof_replay_summary_expr_equal_with_work(source_callee, expected_callee, work)
                            if not callee_equal and work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT:
                                complete <- false
                            return false if not callee_equal
                            return proof_replay_deterministic_call_arguments_equal_with_work(source_arguments, source_names, expected_arguments, expected_names, work, complete, depth + 1)
                        _:
                            return false
                Ast::Expr.Binary(source_left, source_operator, source_right, _):
                    match expected:
                        Ast::Expr.Binary(expected_left, expected_operator, expected_right, _):
                            return false if:
                                source_operator != expected_operator
                                not proof_replay_deterministic_call_expression_equal_with_work(source_left, expected_left, work, complete, depth + 1)
                            return proof_replay_deterministic_call_expression_equal_with_work(source_right, expected_right, work, complete, depth + 1)
                        _:
                            return false
                Ast::Expr.Unary(source_operator, source_inner, _):
                    match expected:
                        Ast::Expr.Unary(expected_operator, expected_inner, _):
                            return false if source_operator != expected_operator
                            return proof_replay_deterministic_call_expression_equal_with_work(source_inner, expected_inner, work, complete, depth + 1)
                        _:
                            return false
                Ast::Expr.Paren(source_inner, _):
                    match expected:
                        Ast::Expr.Paren(expected_inner, _):
                            return proof_replay_deterministic_call_expression_equal_with_work(source_inner, expected_inner, work, complete, depth + 1)
                        _:
                            return false
                _:
                    equal: bool = proof_replay_summary_expr_equal_with_work(source, expected, work)
                    complete <- false if not equal and work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
                    return equal

