# Reconstruct the deliberately small local-binding subset from the imported source AST. A fact
# is not trusted because its expression or line looks plausible: the enclosing initializer,
# loop wrapper, invariant, and sole loop-body update must all match the source tree.
extend ElisaProof:
    private:
        const PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT: usize = 64
        const PROOF_REPLAY_LOCAL_BINDING_MAX_STEP: i64 = 1

        def proof_replay_local_binding_find_owner(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, body: mutable darray[Ast::Stmt]&, matches: mutable usize&, depth: usize) -> void:
            # Callers accept only exactly one owner. Mark a truncated traversal ambiguous so a
            # function found before an over-deep subtree cannot be mistaken for a unique owner.
            if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT:
                matches <- 2
                return
            for declaration in declarations |owner, owner_line, body, matches, depth|:
                match declaration:
                    Ast::Decl.Func(name, _, _, statements, _, _, position):
                        if name == owner and position.line == owner_line:
                            matches <- matches + 1
                            body.extend(statements)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_replay_local_binding_find_owner(nested, owner, owner_line, body, matches, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        matches <- 2
                    _:
                        matches <- 2


        def proof_replay_local_binding_pos_matches(expression: Ast::Expr, position: Ast::Pos) -> bool:
            expression_position: Ast::Pos = Ast::expr_pos(expression)
            return expression_position.line == position.line and expression_position.column == position.column and expression_position.offset == position.offset

        def proof_replay_local_binding_expr_positions_match(left: Ast::Expr, right: Ast::Expr) -> bool:
            return proof_replay_local_binding_pos_matches(left, Ast::expr_pos(right))

        def proof_replay_local_binding_integer_type(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(TokenKind.Mutable, inner, _):
                    return proof_replay_local_binding_integer_type(inner, depth + 1)
                Ast::Expr.Ident(name, _):
                    return name in {"i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize"}
                _:
                    return false

        def proof_replay_local_binding_mutable_integer_type(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Unary(TokenKind.Mutable, inner, _):
                    return proof_replay_local_binding_integer_type(inner, 0)
                _:
                    return false

        def proof_replay_local_binding_unsigned_type_name(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(TokenKind.Mutable, inner, _):
                    return proof_replay_local_binding_unsigned_type_name(inner, depth + 1)
                Ast::Expr.Ident(name, _):
                    return name if name in {"u8", "u16", "u32", "u64", "usize"}
                    return ""
                _:
                    return ""

        # Initializers in this rule are literals or a plain value read. Calls, indexing, fields,
        # and compound expressions are deliberately outside this rule.
        def proof_replay_local_binding_simple_initializer(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(_, _) | Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_simple_initializer(inner, depth + 1)
                _:
                    return false

        def proof_replay_local_binding_parameter_name_present_with_default_limit(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, depth: usize) -> bool:
            proof_replay_local_binding_parameter_name_present_with_work(declarations, owner, owner_line, parameter_name, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, depth)

        def proof_replay_local_binding_parameter_name_present_work_charge(amount: usize, source_work: mutable usize&, work_limit: usize) -> bool:
            if work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or source_work > work_limit or amount > work_limit - source_work:
                source_work <- work_limit + 1
                return false
            source_work <- source_work + amount
            true

        def proof_replay_local_binding_parameter_name_present_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, parameter_name: sview, source_work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return true if:
                depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or owner == "" or owner_line == 0 or parameter_name == ""
                not proof_replay_local_binding_parameter_name_present_work_charge(1, source_work, work_limit)
                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(owner), source_work, work_limit)
                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(parameter_name), source_work, work_limit)
                not proof_replay_local_binding_parameter_name_present_work_charge(declarations.count, source_work, work_limit)
            found: mutable bool = false
            for declaration in declarations |owner, owner_line, parameter_name, source_work, work_limit, depth, found|:
                return true if found
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return true if:
                            not proof_replay_local_binding_parameter_name_present_work_charge(1, source_work, work_limit)
                            not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(name), source_work, work_limit)
                        if name == owner and position.line == owner_line:
                            return true if not proof_replay_local_binding_parameter_name_present_work_charge(parameters.count, source_work, work_limit)
                            for parameter in parameters |parameter_name, source_work, work_limit, found|:
                                return true if:
                                    not proof_replay_local_binding_parameter_name_present_work_charge(1, source_work, work_limit)
                                    not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(parameter.name), source_work, work_limit)
                                    not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(parameter_name), source_work, work_limit)
                                found <- true if parameter.name == parameter_name
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        found <- true if proof_replay_local_binding_parameter_name_present_with_work(nested, owner, owner_line, parameter_name, source_work, work_limit, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return true
                    _:
                        return true
            return found

        def proof_replay_local_binding_parameter_name_present_at_offset_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, owner_offset: usize, exact_owner: bool, parameter_name: sview, source_work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return true if:
                not exact_owner or depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or owner == "" or owner_line == 0 or parameter_name == ""
                not proof_replay_local_binding_parameter_name_present_work_charge(1, source_work, work_limit)
                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(owner), source_work, work_limit)
                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(parameter_name), source_work, work_limit)
                not proof_replay_local_binding_parameter_name_present_work_charge(declarations.count, source_work, work_limit)
            for declaration in declarations |owner, owner_line, owner_offset, exact_owner, parameter_name, source_work, work_limit, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, position):
                        return true if:
                            not proof_replay_local_binding_parameter_name_present_work_charge(1, source_work, work_limit)
                            not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(name), source_work, work_limit)
                        if name == owner and position.line == owner_line and position.offset.usize() == owner_offset:
                            return true if not proof_replay_local_binding_parameter_name_present_work_charge(parameters.count, source_work, work_limit)
                            for parameter in parameters |parameter_name, source_work, work_limit|:
                                return true if:
                                    not proof_replay_local_binding_parameter_name_present_work_charge(1, source_work, work_limit)
                                    not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(parameter.name), source_work, work_limit)
                                    not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(parameter_name), source_work, work_limit)
                                    parameter.name == parameter_name
                            return false
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_local_binding_parameter_name_present_at_offset_with_work(nested, owner, owner_line, owner_offset, exact_owner, parameter_name, source_work, work_limit, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return true
                    _:
                        return true
            return false

        def proof_replay_local_binding_parameter_name_present_for_report_owner_with_work(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, report: ProofReport&, parameter_name: sview, source_work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return proof_replay_local_binding_parameter_name_present_at_offset_with_work(declarations, owner, owner_line, report.analysis_2.replay_owner_offset, true, parameter_name, source_work, work_limit, depth) if report.analysis_2.replay_owner_offset_valid and owner_line == report.analysis_2.replay_owner_line
            proof_replay_local_binding_parameter_name_present_with_work(declarations, owner, owner_line, parameter_name, source_work, work_limit, depth)

        # A truncated or unrecognized declaration walk counts as a possible source global, so
        # callers cannot accept a generated local when collision freedom is unknown.
        def proof_replay_local_binding_global_constant_named_with_work(declarations: darray[Ast::Decl]&, target: sview, source_work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return true if:
                depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
                not proof_replay_local_binding_parameter_name_present_work_charge(1, source_work, work_limit)
                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(target), source_work, work_limit)
                not proof_replay_local_binding_parameter_name_present_work_charge(declarations.count, source_work, work_limit)
            for declaration in declarations |target, source_work, work_limit, depth|:
                return true if not proof_replay_local_binding_parameter_name_present_work_charge(1, source_work, work_limit)
                match declaration:
                    Ast::Decl.Const(name, _, _, _, _):
                        return true if:
                            not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(name), source_work, work_limit)
                            name == target
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return true if proof_replay_local_binding_global_constant_named_with_work(nested, target, source_work, work_limit, depth + 1)
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return true
                    _:
                        return true
            return false

        def proof_replay_local_binding_prefix_expression_safe(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(_, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_prefix_expression_safe(inner, depth + 1)
                Ast::Expr.Unary(_, inner, _):
                    return proof_replay_local_binding_prefix_expression_safe(inner, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_local_binding_prefix_expression_safe(left, depth + 1) and proof_replay_local_binding_prefix_expression_safe(right, depth + 1)
                _:
                    return false

        # The current witness format uses a fixed fresh-symbol pool without recording a source
        # binder id. Admit its first symbol only when no earlier executable source construct in
        # this function could have allocated one; otherwise provenance is ambiguous and refused.
        def proof_replay_local_binding_first_rebind_is_unambiguous(body: darray[Ast::Stmt]&, loop_index: usize, depth: usize) -> bool:
            return false if:
                depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or loop_index == 0
                loop_index > body.count or loop_index < 1
            for index in 0..<(loop_index - 1) |index, body|:
                match body[index]:
                    Ast::Stmt.Contract(kind, expression, _):
                        return false if:
                            kind != "requires" and kind != "ensure" and kind != "ensures"
                            not proof_replay_local_binding_prefix_expression_safe(expression, depth + 1)
                    _:
                        return false
            return true

        def proof_replay_local_binding_first_rebind_prefix_statement_with_work(statement: Ast::Stmt, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work <- work + 1
            match statement:
                Ast::Stmt.Contract(kind, expression, _):
                    return false if:
                        kind != "requires" and kind != "ensure" and kind != "ensures"
                        not proof_replay_summary_expr_repeat_charge_with_limit(expression, 1, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    # Reserve a cost walk and the one legacy prefix-expression pass.
                    proof_replay_local_binding_prefix_expression_safe(expression, 0)
                _:
                    return false

        def proof_replay_local_binding_self_update(expression: Ast::Expr, target: sview, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match expression:
                Ast::Expr.Binary(left, TokenKind.Plus, Ast::Expr.IntLit(amount, _), _):
                    return false if amount != PROOF_REPLAY_LOCAL_BINDING_MAX_STEP
                    match left:
                        Ast::Expr.Ident(name, _):
                            return name == target
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_self_update(inner, target, depth + 1)
                _:
                    return false

        # This initial rule admits only the bounded-counter transition whose strict guard and
        # source invariant jointly prove `target + 1` cannot overflow: both variables have the
        # same unsigned machine type, and the invariant bounds target by the guard parameter.
        def proof_replay_local_binding_bound_invariant(body: darray[Ast::Stmt]&, target: sview, bound: sview, owner: sview, consumer_line: u32, report: ProofReport&, source_work: mutable usize&) -> bool:
            matches: mutable usize = 0
            for statement in body |target, bound, owner, consumer_line, report, matches, source_work|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Contract(kind, expression, invariant_position):
                        continue if kind != "invariant"
                        match expression:
                            Ast::Expr.Binary(Ast::Expr.Ident(left_name, _), TokenKind.LtEq, Ast::Expr.Ident(right_name, _), _):
                                return false if:
                                    not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(left_name), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                    not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(right_name), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                    not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(target), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                    not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(bound), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                continue if left_name != target or right_name != bound
                                source_trace_matches: mutable bool = false
                                for trace in report.analysis_1.traces.records |owner, consumer_line, expression, invariant_position, source_work|:
                                    return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                    source_work <- source_work + 1
                                    return false if:
                                        not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(trace.kind), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                        not proof_replay_local_binding_parameter_name_present_work_charge(sview_len("loop-invariant"), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                        not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(trace.name), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                        not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(owner), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                    if trace.kind == "loop-invariant" and trace.name == owner and trace.line == consumer_line and proof_replay_source_position_equal(trace.loop_source_position, invariant_position) and proof_replay_summary_expr_equal_with_work(trace.expression, expression, source_work) and proof_replay_local_binding_expr_positions_match(trace.expression, expression):
                                        source_trace_matches <- true
                                matches <- matches + 1 if source_trace_matches
                            _:
                                pass
                    _:
                        pass
            return matches == 1

        def proof_replay_local_binding_contract_match(body: darray[Ast::Stmt]&, owner: sview, consumer_line: u32, report: ProofReport&, source_work: mutable usize&) -> bool:
            matches: mutable usize = 0
            for statement in body |owner, consumer_line, report, source_work|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match statement:
                    Ast::Stmt.Contract(kind, expression, invariant_position):
                        continue if kind != "invariant"
                        return false if not proof_replay_local_binding_parameter_name_present_work_charge(sview_len("invariant"), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        source_contract_matches: mutable bool = false
                        for trace in report.analysis_1.traces.records |owner, consumer_line, expression, invariant_position, source_work|:
                            return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            source_work <- source_work + 1
                            return false if:
                                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(trace.kind), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len("loop-invariant"), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(trace.name), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                not proof_replay_local_binding_parameter_name_present_work_charge(sview_len(owner), source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                            if trace.kind == "loop-invariant" and trace.name == owner and trace.line == consumer_line and proof_replay_source_position_equal(trace.loop_source_position, invariant_position) and proof_replay_summary_expr_equal_with_work(trace.expression, expression, source_work) and proof_replay_local_binding_expr_positions_match(trace.expression, expression):
                                source_contract_matches <- true
                        matches <- matches + 1 if source_contract_matches
                    _:
                        pass
            return matches == 1

        # Add a candidate only for a direct while statement or the parser's exact captured-loop
        # wrapper: Expr(Block(header declarations..., While(...), ..., captures)).
        def proof_replay_local_binding_candidate(body: darray[Ast::Stmt]&, index: usize, consumer_line: u32, report: ProofReport&, owner: sview, expected_binding: sview, loop_body: mutable darray[Ast::Stmt]&, loop_condition: mutable Ast::Expr&, binding_type: mutable Ast::Expr&, initializer: mutable Ast::Expr&, binding_position: mutable Ast::Pos&, source_work: mutable usize&) -> bool:
            return false if:
                index == 0 or index >= body.count
                not proof_replay_summary_owner_source_preflight(report, owner, report.analysis_2.replay_owner_line, source_work)
            match body[index - 1]:
                Ast::Stmt.VarDecl(declared_name, declared_type, declared_value, declared_position):
                    return false if:
                        declared_name != expected_binding or not proof_replay_local_binding_integer_type(declared_type, 0)
                        proof_replay_local_binding_parameter_name_present_for_report_owner_with_work(report.source.source_declarations, owner, report.analysis_2.replay_owner_line, report, expected_binding, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                        proof_replay_local_binding_global_constant_named_with_work(report.source.source_declarations, expected_binding, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                        not proof_replay_local_binding_simple_initializer(declared_value, 0)
                        not proof_replay_local_binding_initializer_valid_with_work(declared_value, expected_binding, report.source.source_declarations, owner, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, source_work, 0)
                    match body[index]:
                        Ast::Stmt.While(condition, statements, position):
                            return false if:
                                position.line != consumer_line
                                not proof_replay_local_binding_contract_match(statements, owner, consumer_line, report, source_work)
                                not proof_replay_local_binding_condition_valid_with_work(condition, expected_binding, report.source.source_declarations, owner, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, source_work, 0)
                            loop_body.extend(statements)
                            loop_condition <- condition
                            binding_type <- declared_type
                            initializer <- declared_value
                            binding_position <- declared_position
                            return true
                        Ast::Stmt.Expr(Ast::Expr.Block(block_statements, _, captures, block_position), _):
                            return false if:
                                captures.count == 0 or block_statements.count != 1
                                block_position.line == 0
                            for capture in captures |expected_binding|:
                                return false if capture == ""
                            match block_statements[0]:
                                Ast::Stmt.While(condition, statements, position):
                                    return false if:
                                        position.line != block_position.line
                                        position.line != consumer_line
                                        not proof_replay_local_binding_contract_match(statements, owner, consumer_line, report, source_work)
                                        not proof_replay_local_binding_condition_valid_with_work(condition, expected_binding, report.source.source_declarations, owner, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, source_work, 0)
                                        not any captured in captures where captured == expected_binding
                                    match condition:
                                        Ast::Expr.Binary(_, _, Ast::Expr.Ident(condition_capture, _), _):
                                            return false if not any captured in captures where captured == condition_capture
                                        _:
                                            pass
                                    loop_body.extend(statements)
                                    loop_condition <- condition
                                    binding_type <- declared_type
                                    initializer <- declared_value
                                    binding_position <- declared_position
                                    return true
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false

        # Select the unique innermost loop that contains the source-authenticated consumer.
        # The result-symbol walker also collects only direct invariants from that loop body.
        def proof_replay_local_binding_context_loop_select(body: darray[Ast::Stmt]&, consumer: Ast::Pos, report: ProofReport&, loop_line: mutable u32&, condition: mutable Ast::Expr&, invariants: mutable darray[Ast::Expr]&, loop_position: mutable Ast::Pos&, source_work: mutable usize&) -> bool:
            return false if consumer.offset == 0
            selected_extent: mutable u32 = 4294967295
            selected_loop_line: mutable u32 = 0
            selected_loop_position: mutable Ast::Pos = Ast::pos_at_line(0)
            loops: mutable usize = 0
            declarations: mutable usize = 0
            local: mutable sview = ""
            local_type: mutable Ast::Expr = Ast::Expr.Invalid
            call: mutable Ast::Expr = Ast::Expr.Invalid
            dummy_position: Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            # This selector only locates the consumer's unique loop. It has no result-symbol
            # binding to track, so pass an empty tracked name and the same owner/body snapshot.
            scan: (complete: bool, last_offset: u32) = proof_replay_result_symbol_preservation_loop_site_with_work(report, body, body, consumer, dummy_position, "", &selected_extent, &selected_loop_line, &selected_loop_position, condition, invariants, &loops, &declarations, &local, &local_type, &call, 0, source_work)
            loop_line <- selected_loop_line if scan.complete and loops == 1
            loop_position <- selected_loop_position if scan.complete and loops == 1
            return scan.complete and loops == 1

        # Bind a context fact to that selected loop's exact source expression. Consumer offsets
        # select the loop; the already source-validated fact must also carry its header's unique
        # logical line, which rejects a same-spelling fact from another loop.
        def proof_replay_local_binding_context_fact_matches_selected_loop(report: ProofReport&, context_trace: ProofFactTrace, loop_line: u32, loop_position: Ast::Pos, condition: Ast::Expr, invariants: darray[Ast::Expr]&, source_work: mutable usize&) -> bool:
            # The loop-fact source validator resolves a fact by its diagnostic logical line and
            # rejects ambiguous lines. Tie that verified row to the exact consumer-selected loop
            # so an identical formula from a shadowed loop cannot lend its binding to this loop.
            return false if context_trace.name == "" or loop_line == 0 or context_trace.line != loop_line or not proof_replay_source_position_equal(context_trace.loop_source_position, loop_position)
            if context_trace.kind == "loop-condition":
                return false if condition is Ast::Expr.Invalid
                # The source loop itself is selected by its authenticated consumer span. The
                # instantiated fact can have a replacement's position (for example, a mutable
                # boolean resymbolized at loop entry), so its root position is not the origin site.
                # Formula shape and any global-constant substitution are checked below.
                return proof_replay_loop_context_constant_expression(report, context_trace, condition, context_trace.expression, 0, source_work)
            return false if context_trace.kind != "loop-invariant"
            for expression in invariants |expression, report, context_trace, source_work|:
                return true if proof_replay_loop_context_constant_expression(report, context_trace, expression, context_trace.expression, 0, source_work)
            return false

        def proof_replay_local_binding_loop_source(report: ProofReport&, trace: ProofFactTrace, target: sview, source_value: Ast::Expr, consumer_line: u32, require_rebind: bool, source_work: mutable usize&) -> bool:
            return false if consumer_line == 0 or target == ""
            function_body: mutable darray[Ast::Stmt] = []
            owner_matches: mutable usize = 0
            return false if not proof_replay_local_binding_find_owner_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, &function_body, &owner_matches, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0) or owner_matches != 1
            candidates: mutable usize = 0
            prefix_unambiguous: mutable bool = true
            for index in 0..<function_body.count |index, function_body, consumer_line, report, trace, target, source_value, require_rebind, candidates, prefix_unambiguous, source_work|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                if index >= 2 and prefix_unambiguous:
                    prefix_unambiguous <- proof_replay_local_binding_first_rebind_prefix_statement_with_work(function_body[index - 2], source_work)
                    return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                loop_body: mutable darray[Ast::Stmt] = []
                condition: mutable Ast::Expr = Ast::Expr.Invalid
                binding_type: mutable Ast::Expr = Ast::Expr.Invalid
                initializer: mutable Ast::Expr = Ast::Expr.Invalid
                binding_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                if proof_replay_local_binding_candidate(function_body, index, consumer_line, report, trace.name, target, &loop_body, &condition, &binding_type, &initializer, &binding_position, source_work):
                    return false if binding_position.line == 0
                    if require_rebind:
                        return false if proof_replay_local_binding_unsigned_type_name(binding_type, 0) == ""
                        assignment_count: mutable usize = 0
                        invariant_count: mutable usize = 0
                        valid_body: mutable bool = true
                        source_assignment_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                        for statement in loop_body |target, source_value, trace, assignment_count, invariant_count, valid_body, source_assignment_position, source_work|:
                            return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            source_work <- source_work + 1
                            match statement:
                                Ast::Stmt.Contract(kind, _, _):
                                    invariant_count <- invariant_count + 1 if kind == "invariant"
                                    valid_body <- false if kind != "invariant" and kind != "decreases" and kind != "decreases*"
                                Ast::Stmt.Assign(Ast::Expr.Ident(assigned_name, _), TokenKind.LArrow, assigned_value, assignment_position):
                                    assignment_count <- assignment_count + 1
                                    source_assignment_position <- assignment_position
                                    valid_body <- false if assigned_name != target or assignment_position.line != trace.line
                                    valid_body <- false if not proof_replay_local_binding_pos_matches(trace.expression, assignment_position)
                                    valid_body <- false if not proof_replay_local_binding_expr_positions_match(source_value, assigned_value)
                                    valid_body <- false if not proof_replay_summary_expr_equal_with_work(assigned_value, source_value, source_work)
                                _:
                                    valid_body <- false
                        continue if not valid_body or invariant_count == 0 or assignment_count != 1
                        return false if not proof_replay_local_binding_self_update(source_value, target, 0)
                        bound_name: sview = proof_replay_local_binding_rebind_bound_with_work(condition, target, binding_type, report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, report.analysis_2.replay_owner_offset_valid, source_work, 0)
                        return false if:
                            bound_name == ""
                            not proof_replay_local_binding_bound_invariant(loop_body, target, bound_name, trace.name, consumer_line, report, source_work)
                        match trace.expression:
                            Ast::Expr.Binary(Ast::Expr.Ident(symbol, symbol_position), TokenKind.EqEq, _, _):
                                return false if:
                                    symbol != proof_internal_rebind_name(0)
                                    not proof_replay_local_binding_pos_matches(Ast::Expr.Ident(symbol, symbol_position), source_assignment_position)
                            _:
                                return false
                        return false if not prefix_unambiguous
                    else:
                        return false if:
                            not proof_replay_summary_expr_equal_with_work(initializer, source_value, source_work)
                            not proof_replay_local_binding_expr_positions_match(source_value, initializer)
                            binding_position.line != trace.line
                            not proof_replay_local_binding_pos_matches(trace.expression, binding_position)
                        match trace.expression:
                            Ast::Expr.Binary(left, TokenKind.EqEq, _, _):
                                return false if not proof_replay_local_binding_pos_matches(left, binding_position)
                            _:
                                return false
                    candidates <- candidates + 1
            return candidates == 1

        # The binding equation must be live in this certificate, not merely true at an earlier
        # source point. Loop-entry equalities are excluded from preservation contexts; source
        # replay then checks the certificate with that stale premise removed. This is the only
        # source route for local bindings (see proof_replay_local_binding_source_valid), so it
        # holds whether the binding is a certificate fact or a premise of a derived step.
        def proof_replay_local_binding_trace_work_charge(report: ProofReport&, query_name: sview, source_work: mutable usize&, repetitions: usize) -> bool:
            trace_cost: mutable usize = report.analysis_1.traces.records.count
            return false if trace_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for candidate in report.analysis_1.traces.records |trace_cost|:
                expression_cost: mutable usize = 0
                return false if:
                    not proof_replay_summary_expr_cost(candidate.expression, expression_cost, 0, 0)
                    expression_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - trace_cost
                trace_cost <- trace_cost + expression_cost
                return false if:
                    not proof_replay_summary_expr_cost_add(trace_cost, source_work, sview_len(candidate.name))
                    not proof_replay_summary_expr_cost_add(trace_cost, source_work, sview_len(query_name))
                # Liveness tests loop-condition, loop-invariant, and loop-range rows separately.
                # Reserve all three candidate-kind comparisons, even when an earlier one matches.
                for _ in 0..<3 |trace_cost, source_work, candidate|:
                    return false if not proof_replay_summary_expr_cost_add(trace_cost, source_work, sview_len(candidate.kind))
                return false if:
                    not proof_replay_summary_expr_cost_add(trace_cost, source_work, sview_len("loop-condition"))
                    not proof_replay_summary_expr_cost_add(trace_cost, source_work, sview_len("loop-invariant"))
                    not proof_replay_summary_expr_cost_add(trace_cost, source_work, sview_len("loop-range"))
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if repetitions != 0:
                return false if trace_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / repetitions
            source_work <- source_work + trace_cost * repetitions
            return true

        def proof_replay_local_binding_update_target(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Binary(Ast::Expr.Ident(name, _), TokenKind.Plus, _, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_replay_local_binding_update_target(inner)
                _:
                    return ""

        # Every route that admits a local binding -- an attempt/certificate's own fact, or a
        # premise of a derived step found through the trace index -- comes through here, so the
        # binding must be live at the source-anchored consumer.
        def proof_replay_local_binding_source_valid(report: mutable ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_local_binding_source_valid_with_work(report, trace, &work)

        def proof_replay_local_binding_source_valid_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_local_binding_source_valid_with_cache(report, trace, source_work, &cache)

        def proof_replay_local_binding_source_valid_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            replay_owner_line: u32 = report.analysis_2.replay_owner_line
            trace_owner_line: u32 = report.analysis_2.trace_owner_line
            return false if trace.name == "" or replay_owner_line == 0 or trace_owner_line == 0
            # Local-binding reconstruction consults source names and aliases without a resolved
            # import witness. Refuse it when an imported declaration may change that identity.
            return false if:
                proof_replay_summary_has_unresolved_import(report.source.source_annotations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                proof_replay_summary_has_unresolved_declaration_import(report.source.source_declarations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(_, _), TokenKind.EqEq, _, _):
                    return proof_replay_local_binding_fact_live_with_cache(report, trace, source_work, cache)
                _:
                    return false
