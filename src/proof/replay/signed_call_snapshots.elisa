# Reconstruct a captured signed call result as its source local, not a second call.
# This establishes identity only; summary provenance and all call effects are audited separately.
extend ElisaProof:
    private:
        def proof_replay_snapshot_signed_type(expression: Ast::Expr) -> sview:
            match expression:
                Ast::Expr.Ident(name, _):
                    return name if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize"
                _:
                    pass
            return ""

        def proof_replay_snapshot_return_types(declarations: darray[Ast::Decl]&, name: sview, expected: sview, matches: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64
            for declaration in declarations |name, expected, matches, depth|:
                match declaration:
                    Ast::Decl.Func(found, _, return_type, _, _, _, _):
                        if found == name:
                            matches <- matches + 1
                            return false if proof_replay_snapshot_signed_type(return_type) != expected
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_snapshot_return_types(nested, name, expected, matches, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_signed_call_snapshot(declarations: darray[Ast::Decl]&, type_expression: Ast::Expr, initializer: Ast::Expr) -> bool:
            expected: sview = proof_replay_snapshot_signed_type(type_expression)
            return false if expected == ""
            match initializer:
                Ast::Expr.Call(callee, _, _, _):
                    name: mutable sview = ""
                    match callee:
                        Ast::Expr.Ident(found, _) | Ast::Expr.Scope(_, found, _):
                            name <- found
                        _:
                            return false
                    matches: mutable usize = 0
                    return proof_replay_snapshot_return_types(declarations, name, expected, &matches, 0) and matches == 1
                _:
                    return false
