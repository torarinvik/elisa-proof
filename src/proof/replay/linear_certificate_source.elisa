# Linear-certificate traces are synthetic proof objects, not source axioms. Replay admits one
# only as a fact of the exact active goal certificate; the kernel's independent linear closer
# validates its multipliers, premise membership, cancellation, and positive contradiction.
extend ElisaProof:
    private:
        def proof_replay_linear_source_position_equal(left: Ast::Pos, right: Ast::Pos) -> bool:
            return left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        def proof_replay_linear_source_expression_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return proof_replay_expr_equal(left, right) and proof_replay_linear_source_position_equal(Ast::expr_pos(left), Ast::expr_pos(right))

        def proof_replay_linear_trace_record_equal(left: ProofFactTrace, right: ProofFactTrace) -> bool:
            return left.kind == right.kind and left.line == right.line and left.name == right.name and left.dependency == right.dependency and left.premises_start == right.premises_start and left.premises_count == right.premises_count and left.kernel_premises_start == right.kernel_premises_start and left.kernel_premises_count == right.kernel_premises_count and left.summary_bindings_start == right.summary_bindings_start and left.summary_bindings_count == right.summary_bindings_count and left.summary_requires_start == right.summary_requires_start and left.summary_requires_count == right.summary_requires_count and left.summary_ensure_index == right.summary_ensure_index and left.owner_line == right.owner_line and left.kernel_expression == right.kernel_expression and proof_replay_linear_source_expression_equal(left.expression, right.expression)

        def proof_replay_linear_certificate_trace_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return false if trace.kind != "linear-certificate" or trace.name == "" or trace.line == 0
            return false if report.trace_consumer_certificate_index == 0 or report.trace_consumer_certificate_index > report.certificates.count
            certificate_index: usize = report.trace_consumer_certificate_index - 1
            certificate: ProofGoalCertificate = report.certificates[certificate_index]
            return false if certificate.rule != "goal" or certificate.name != trace.name or certificate.line != report.trace_owner_line or trace.line != certificate.line
            # The ordinary exact-fact rule runs before the linear closer. A marker-shaped goal
            # could therefore close by equality without its multiplier witness being checked.
            return false if proof_linear_certificate_marker(certificate.goal)
            attempt_work: mutable usize = 0
            return false if report.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            attempt_work <- report.goal_attempts.count
            attempt_matches: mutable usize = 0
            for attempt in report.goal_attempts |report, certificate, certificate_index, attempt_matches, attempt_work|:
                continue if not attempt.has_certificate or attempt.certificate_index != certificate_index
                return false if not proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, certificate_index, attempt_work)
                attempt_matches <- attempt_matches + 1
            return false if attempt_matches != 1
            return false if certificate.facts_count != certificate.kernel_facts_count
            return false if certificate.facts_start > report.certificate_facts.count or certificate.facts_count > report.certificate_facts.count - certificate.facts_start
            return false if certificate.kernel_facts_start > report.kernel.certificate_facts.count or certificate.kernel_facts_count > report.kernel.certificate_facts.count - certificate.kernel_facts_start
            return false if certificate.facts_start > report.traces.origin_indices.count or certificate.facts_count > report.traces.origin_indices.count - certificate.facts_start
            matching_facts: mutable usize = 0
            for offset in 0..<certificate.facts_count |offset, report, certificate, trace, matching_facts|:
                source_fact: Ast::Expr = report.certificate_facts[certificate.facts_start + offset]
                kernel_fact: usize = report.kernel.certificate_facts[certificate.kernel_facts_start + offset]
                continue if kernel_fact != trace.kernel_expression or not proof_replay_linear_source_expression_equal(source_fact, trace.expression)
                origin_index: usize = report.traces.origin_indices[certificate.facts_start + offset]
                continue if origin_index >= report.traces.records.count
                origin: ProofFactTrace = report.traces.records[origin_index]
                return false if not proof_replay_linear_trace_record_equal(origin, trace)
                matching_facts <- matching_facts + 1
            return matching_facts == 1 and proof_linear_certificate_marker(trace.expression)
