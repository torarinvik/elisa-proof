# Linear-certificate traces are synthetic proof objects, not source axioms. Replay admits one
# only as a fact of the exact active goal certificate; the kernel's independent linear closer
# validates its multipliers, premise membership, cancellation, and positive contradiction.
extend ElisaProof:
    private:
        def proof_replay_linear_certificate_source_work_charge(source_work: mutable usize&, amount: usize) -> bool:
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            source_work <- source_work + amount
            return true

        def proof_replay_linear_source_position_equal_with_work(left: Ast::Pos, right: Ast::Pos, source_work: mutable usize&) -> bool:
            return false if not proof_replay_linear_certificate_source_work_charge(source_work, 6)
            return left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        def proof_replay_linear_source_expression_equal_with_work(left: Ast::Expr, right: Ast::Expr, source_work: mutable usize&) -> bool:
            return false if not proof_replay_summary_expr_equal_with_work(left, right, source_work)
            return proof_replay_linear_source_position_equal_with_work(Ast::expr_pos(left), Ast::expr_pos(right), source_work)

        def proof_replay_linear_trace_record_equal_with_work(left: ProofFactTrace, right: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if not proof_replay_attempt_text_compare_with_limit(left.kind, right.kind, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or left.kind != right.kind
            return false if not proof_replay_attempt_text_compare_with_limit(left.name, right.name, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or left.name != right.name
            return false if not proof_replay_attempt_text_compare_with_limit(left.dependency, right.dependency, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or left.dependency != right.dependency
            return false if not proof_replay_linear_certificate_source_work_charge(source_work, 12)
            return false if:
                left.line != right.line
                left.premises_start != right.premises_start or left.premises_count != right.premises_count
                left.kernel_premises_start != right.kernel_premises_start or left.kernel_premises_count != right.kernel_premises_count
                left.summary_bindings_start != right.summary_bindings_start or left.summary_bindings_count != right.summary_bindings_count
                left.summary_requires_start != right.summary_requires_start or left.summary_requires_count != right.summary_requires_count
                left.summary_ensure_index != right.summary_ensure_index or left.owner_line != right.owner_line
                left.kernel_expression != right.kernel_expression
            return proof_replay_linear_source_expression_equal_with_work(left.expression, right.expression, source_work)

        def proof_replay_linear_certificate_trace_valid(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            return false if not proof_replay_attempt_text_compare_with_limit(trace.kind, "linear-certificate", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or trace.kind != "linear-certificate"
            return false if not proof_replay_attempt_text_compare_with_limit(trace.name, "", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or trace.name == "" or trace.line == 0
            return false if not proof_replay_linear_certificate_source_work_charge(source_work, 2)
            return false if report.analysis_2.trace_consumer_certificate_index == 0 or report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate_index: usize = report.analysis_2.trace_consumer_certificate_index - 1
            certificate: ProofGoalCertificate = report.analysis_1.certificates[certificate_index]
            return false if not proof_replay_attempt_text_compare_with_limit(certificate.rule, "goal", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or certificate.rule != "goal"
            return false if not proof_replay_attempt_text_compare_with_limit(certificate.name, trace.name, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or certificate.name != trace.name
            return false if not proof_replay_linear_certificate_source_work_charge(source_work, 2) or certificate.line != report.analysis_2.trace_owner_line or trace.line != certificate.line
            # The ordinary exact-fact rule runs before the linear closer. A marker-shaped goal
            # could therefore close by equality without its multiplier witness being checked.
            certificate_goal_marker: sview = match certificate.goal:
                Ast::Expr.Call(Ast::Expr.Ident(marker, _), _, _, _): marker
                _: ""
            return false if not proof_replay_attempt_text_compare_with_limit(certificate_goal_marker, "__elisa_linear_certificate", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT) or certificate_goal_marker == "__elisa_linear_certificate"
            attempt_matches: mutable usize = 0
            for attempt in report.results.goal_attempts |report, certificate, certificate_index, attempt_matches, source_work|:
                return false if not proof_replay_linear_certificate_source_work_charge(source_work, 1)
                continue if not attempt.has_certificate or attempt.certificate_index != certificate_index
                # The shared matcher compares the call position and the goal position as six
                # scalar fields each; account for those fixed-cost comparisons on this path.
                return false if not proof_replay_linear_certificate_source_work_charge(source_work, 12)
                return false if not proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, certificate_index, source_work)
                attempt_matches <- attempt_matches + 1
            return false if not proof_replay_linear_certificate_source_work_charge(source_work, 6)
            return false if:
                attempt_matches != 1
                certificate.facts_count != certificate.kernel_facts_count
                certificate.facts_start > report.analysis_1.certificate_facts.count or certificate.facts_count > report.analysis_1.certificate_facts.count - certificate.facts_start
                certificate.kernel_facts_start > report.analysis_1.kernel.certificate_facts.count or certificate.kernel_facts_count > report.analysis_1.kernel.certificate_facts.count - certificate.kernel_facts_start
                certificate.facts_start > report.analysis_1.traces.origin_indices.count or certificate.facts_count > report.analysis_1.traces.origin_indices.count - certificate.facts_start
            matching_facts: mutable usize = 0
            for offset in 0..<certificate.facts_count |offset, report, certificate, trace, matching_facts, source_work|:
                return false if not proof_replay_linear_certificate_source_work_charge(source_work, 1)
                source_fact: Ast::Expr = report.analysis_1.certificate_facts[certificate.facts_start + offset]
                kernel_fact: usize = report.analysis_1.kernel.certificate_facts[certificate.kernel_facts_start + offset]
                continue if kernel_fact != trace.kernel_expression or not proof_replay_linear_source_expression_equal_with_work(source_fact, trace.expression, source_work)
                return false if not proof_replay_linear_certificate_source_work_charge(source_work, 1)
                origin_index: usize = report.analysis_1.traces.origin_indices[certificate.facts_start + offset]
                continue if origin_index >= report.analysis_1.traces.records.count
                origin: ProofFactTrace = report.analysis_1.traces.records[origin_index]
                return false if not proof_replay_linear_trace_record_equal_with_work(origin, trace, source_work)
                matching_facts <- matching_facts + 1
            trace_expression_marker: sview = match trace.expression:
                Ast::Expr.Call(Ast::Expr.Ident(marker, _), _, _, _): marker
                _: ""
            return false if not proof_replay_attempt_text_compare_with_limit(trace_expression_marker, "__elisa_linear_certificate", source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            return matching_facts == 1 and trace_expression_marker == "__elisa_linear_certificate"
