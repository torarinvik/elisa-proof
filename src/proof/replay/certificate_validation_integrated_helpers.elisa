# Factored helpers retained by the branch integration.
extend ElisaProof:
    private:
        def proof_replay_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, work: mutable usize&) -> bool:
            return proof_replay_goal_with_work(facts, goal, 0, work)

        def proof_replay_trace_range_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            return trace.premises_start <= report.analysis_1.traces.premises.count and trace.premises_count <= report.analysis_1.traces.premises.count - trace.premises_start

        def proof_replay_dependency_in_stack(names: darray[sview]&, dependency: sview) -> bool:
            return any existing in names where existing == dependency

        # Dependency names describe declaration-level SCCs, but several obligations can belong
        # to one declaration. Track the exact certificate index as well: a summary may use an SCC
        # induction edge, while direct validation of the same obligation must never re-enter that
        # certificate and consume the native stack.
        def proof_replay_certificate_in_stack(certificates: darray[usize]&, certificate_index: usize) -> bool:
            return any existing in certificates where existing == certificate_index

        # Certificate rules are a closed kernel protocol. An unknown label must not fall through
        # to ordinary proposition replay: doing so would let a future or malformed specialized
        # certificate claim the generic rule merely because its goal happens to be provable.
        def proof_replay_certificate_rule_valid(rule: sview) -> bool:
            match rule:
                "goal":
                    return true
                "index-lower":
                    return true
                "index-upper":
                    return true
                "slice-lower":
                    return true
                "slice-upper":
                    return true
                "slice-order":
                    return true
                "checked-index":
                    return true
                "checked-get":
                    return true
                "quantifier-forall":
                    return true
                "quantifier-exists":
                    return true
                "resource-safety":
                    return true
                "structural-safety":
                    return true
                "effect-containment":
                    return true
                _:
                    return false

        # The producer's `proof_finding_only_widens_state`, restated here rather than called.
        # Replay is a second opinion on the same report and shares no code with the checker that
        # produced it; a predicate imported from `check.elisa` would make the two agree by
        # construction. Both list the same two kinds, and they must be kept in step by hand -- the
        # same arrangement the scalar-term witness already has on both sides of this boundary.
        def proof_replay_finding_only_widens_state(kind: sview) -> bool:
            return true if kind == "captured-block-unsupported"
            return kind == "loop-invariant-missing"

        def proof_replay_dependency_work_charge(amount: usize, source_work: mutable usize&) -> bool:
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + amount
            return true

        def proof_replay_dependency_text_compare(left: sview, right: sview, source_work: mutable usize&) -> bool:
            return false if:
                not proof_replay_dependency_work_charge(1, source_work)
                not proof_replay_dependency_work_charge(sview_len(left), source_work)
                not proof_replay_dependency_work_charge(sview_len(right), source_work)
            return true

        def proof_replay_dependency_row_index_build(names: darray[sview]&, source_work: mutable usize&) -> (complete: bool, rows: ProofReplayDependencyRowIndex):
            rows: mutable ProofReplayDependencyRowIndex = ProofReplayDependencyRowIndex{}
            row_count: usize = names.count
            if row_count == 0:
                rows.complete <- true
                return (true, rows)
            capacity: usize = proof_name_index_capacity(row_count)
            return (false, rows) if:
                capacity == 0
                capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3
                row_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
                not proof_replay_dependency_work_charge(capacity * 3, source_work)
                not proof_replay_dependency_work_charge(row_count * 2, source_work)
            rows.names.extend(names)
            rows.hashes.resize(capacity)
            rows.heads.resize(capacity)
            rows.tails.resize(capacity)
            rows.next_indices.resize(row_count)
            for slot in 0..<capacity |slot, rows, row_count|:
                rows.heads[slot] <- row_count
                rows.tails[slot] <- row_count
            for row in 0..<row_count |row, rows, capacity, source_work, row_count|:
                return (false, rows) if not proof_replay_dependency_work_charge(sview_len(rows.names[row]), source_work)
                rows.next_indices[row] <- row_count
                hash: u32 = proof_name_hash(rows.names[row])
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                placed: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, rows, capacity, source_work, row_count, placed|:
                    return (false, rows) if not proof_replay_dependency_work_charge(1, source_work)
                    head: usize = rows.heads[slot]
                    if head == row_count:
                        rows.hashes[slot] <- hash
                        rows.heads[slot] <- row
                        rows.tails[slot] <- row
                        placed <- true
                        break
                    if head >= row_count:
                        return (false, rows)
                    if rows.hashes[slot] == hash:
                        previous_name: sview = rows.names[head]
                        return (false, rows) if not proof_replay_dependency_text_compare(previous_name, rows.names[row], source_work)
                        if previous_name == rows.names[row]:
                            tail_index: usize = rows.tails[slot]
                            return (false, rows) if tail_index >= row or tail_index >= row_count
                            rows.next_indices[tail_index] <- row
                            rows.tails[slot] <- row
                            placed <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return (false, rows) if not placed
            rows.complete <- true
            return (true, rows)

        def proof_replay_dependency_row_index_shape_valid(index: ProofReplayDependencyRowIndex, expected_rows: usize) -> bool:
            return false if not index.complete or index.names.count != expected_rows or index.next_indices.count != expected_rows
            return true if expected_rows == 0 and index.hashes.count == 0 and index.heads.count == 0 and index.tails.count == 0
            return false if:
                expected_rows == 0 or index.hashes.count == 0 or index.hashes.count != index.heads.count or index.hashes.count != index.tails.count
                index.hashes.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return true

        def proof_replay_dependency_owner_cache_initialize(owner_lines: mutable darray[u32]&, owner_resolved: mutable darray[bool]&, row_count: usize, source_work: mutable usize&) -> bool:
            return false if row_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            return false if not proof_replay_dependency_work_charge(row_count * 2, source_work)
            owner_lines.resize(row_count)
            owner_resolved.resize(row_count)
            for row in 0..<row_count |row, owner_lines, owner_resolved|:
                owner_lines[row] <- 0
                owner_resolved[row] <- false
            return true

        def proof_replay_dependency_attempt_owner_line(report: ProofReport&, index: ProofReplayDependencyRowIndex, owner_lines: mutable darray[u32]&, owner_resolved: mutable darray[bool]&, row: usize, attempt: ProofGoalAttempt, source_work: mutable usize&) -> u32:
            return 0 if row >= index.names.count or owner_lines.count != index.names.count or owner_resolved.count != index.names.count
            if not owner_resolved[row]:
                owner_lines[row] <- proof_replay_trace_owner_source_position_line_for_attempt_with_work(report, attempt, source_work)
                owner_resolved[row] <- true
            return owner_lines[row]

        def proof_replay_dependency_attempt_owner_cache_build(report: ProofReport&, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return cache.dependency_attempt_owner_cache_complete if cache.dependency_attempt_owner_cache_attempted
            cache.dependency_attempt_owner_cache_attempted <- true
            return false if not proof_replay_dependency_owner_cache_initialize(&cache.dependency_attempt_owner_lines, &cache.dependency_attempt_owner_resolved, report.results.goal_attempts.count, source_work)
            cache.dependency_attempt_owner_cache_complete <- true
            return true

        def proof_replay_dependency_certificate_owner_line(report: ProofReport&, index: ProofReplayDependencyRowIndex, owner_lines: mutable darray[u32]&, owner_resolved: mutable darray[bool]&, row: usize, certificate: ProofGoalCertificate, source_work: mutable usize&) -> u32:
            return 0 if row >= index.names.count or owner_lines.count != index.names.count or owner_resolved.count != index.names.count
            if not owner_resolved[row]:
                owner_lines[row] <- proof_replay_trace_owner_source_position_line_with_work(report, certificate, source_work)
                owner_resolved[row] <- true
            return owner_lines[row]

        def proof_replay_dependency_certificate_owner_cache_build(report: ProofReport&, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return cache.dependency_certificate_owner_cache_complete if cache.dependency_certificate_owner_cache_attempted
            cache.dependency_certificate_owner_cache_attempted <- true
            return false if not proof_replay_dependency_owner_cache_initialize(&cache.dependency_certificate_owner_lines, &cache.dependency_certificate_owner_resolved, report.analysis_1.certificates.count, source_work)
            cache.dependency_certificate_owner_cache_complete <- true
            return true

        def proof_replay_dependency_indexes_build(report: ProofReport&, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return cache.dependency_indexes_complete if cache.dependency_indexes_attempted
            cache.dependency_indexes_attempted <- true
            return false if report.results.goal_attempts.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2 or report.results.findings.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            attempts: mutable darray[sview] = []
            for attempt in report.results.goal_attempts |attempts, source_work|:
                return false if not proof_replay_dependency_work_charge(1, source_work)
                attempts.push(attempt.name)
            findings: mutable darray[sview] = []
            for finding in report.results.findings |findings, source_work|:
                return false if not proof_replay_dependency_work_charge(1, source_work)
                findings.push(finding.name)
            attempt_index: (complete: bool, rows: ProofReplayDependencyRowIndex) = proof_replay_dependency_row_index_build(attempts, source_work)
            return false if not attempt_index.complete
            cache.dependency_attempt_rows <- attempt_index.rows
            finding_index: (complete: bool, rows: ProofReplayDependencyRowIndex) = proof_replay_dependency_row_index_build(findings, source_work)
            return false if not finding_index.complete
            cache.dependency_finding_rows <- finding_index.rows
            cache.dependency_indexes_complete <- true
            return true

        def proof_replay_dependency_certificate_index_build(report: ProofReport&, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return cache.dependency_certificate_index_complete if cache.dependency_certificate_index_attempted
            cache.dependency_certificate_index_attempted <- true
            return false if report.analysis_1.certificates.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            certificates: mutable darray[sview] = []
            for certificate in report.analysis_1.certificates |certificates, source_work|:
                return false if not proof_replay_dependency_work_charge(1, source_work)
                certificates.push(certificate.name)
            certificate_index: (complete: bool, rows: ProofReplayDependencyRowIndex) = proof_replay_dependency_row_index_build(certificates, source_work)
            return false if not certificate_index.complete
            cache.dependency_certificate_rows <- certificate_index.rows
            cache.dependency_certificate_index_complete <- true
            return true

        def proof_replay_dependency_row_lookup(index: ProofReplayDependencyRowIndex, wanted: sview, source_work: mutable usize&) -> (complete: bool, head: usize):
            missing: usize = index.names.count
            return (false, missing) if:
                not proof_replay_dependency_row_index_shape_valid(index, missing)
                not proof_replay_dependency_text_compare(wanted, wanted, source_work)
            return (true, missing) if missing == 0
            capacity: usize = index.hashes.count
            return (false, missing) if capacity == 0
            hash: u32 = proof_name_hash(wanted)
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, wanted, index, capacity, missing, source_work|:
                return (false, missing) if not proof_replay_dependency_work_charge(1, source_work)
                head: usize = index.heads[slot]
                return (true, missing) if head == missing
                return (false, missing) if head >= missing
                if index.hashes[slot] == hash:
                    name: sview = index.names[head]
                    return (false, missing) if not proof_replay_dependency_text_compare(name, wanted, source_work)
                    return (true, head) if name == wanted
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, missing)

        def proof_replay_dependency_row_matches(index: ProofReplayDependencyRowIndex, row: usize, actual_name: sview, wanted: sview, source_work: mutable usize&) -> bool:
            return false if row >= index.names.count or row >= index.next_indices.count
            indexed_name: sview = index.names[row]
            return false if:
                not proof_replay_dependency_text_compare(indexed_name, actual_name, source_work)
                indexed_name != actual_name
                not proof_replay_dependency_text_compare(indexed_name, wanted, source_work)
            return indexed_name == wanted

        # Replay every certificate owned by a modular dependency before allowing its summary to
        # support a caller. A dependency already on the stack is an SCC induction edge: the main
        # checker must have supplied the corresponding termination proof, while replay stops at
        # that fixed-point boundary instead of recursing forever. Acyclic summary chains therefore
        # receive full replay, and cyclic summaries remain visibly tied to the main termination
        # checker rather than being mistaken for ordinary facts.
        # Dependency records are classified by their exact source span. Logical line ordering
        # can pair a #line-rewound sibling function's proof with another module's declaration.
        # Unknown findings veto the dependency; unknown goals/certificates never vouch for it.
        def proof_replay_dependency_attempt_row_matches_with_work(report: ProofReport&, dependency: sview, attempt: ProofGoalAttempt, attempt_index: usize, owner_index: ProofReplayDependencyRowIndex, owner_lines: mutable darray[u32]&, owner_resolved: mutable darray[bool]&, owner_line: u32, unknown_matches: bool, source_work: mutable usize&) -> bool:
            return true if owner_line == 0
            return false if attempt.name != dependency
            row: u32 = proof_replay_dependency_attempt_owner_line(report, owner_index, &owner_lines, &owner_resolved, attempt_index, attempt, source_work)
            return unknown_matches if row == 0
            return row == owner_line

        def proof_replay_dependency_finding_row_matches_with_work(report: ProofReport&, dependency: sview, finding: ProofFinding, owner_line: u32, attempt_index: ProofReplayDependencyRowIndex, owner_lines: mutable darray[u32]&, owner_resolved: mutable darray[bool]&, source_work: mutable usize&) -> bool:
            return true if:
                owner_line == 0
                not finding.has_goal or finding.goal_id >= report.results.goal_attempts.count
            attempt_index_value: usize = finding.goal_id
            attempt: ProofGoalAttempt = report.results.goal_attempts[attempt_index_value]
            return true if attempt.name != dependency
            return proof_replay_dependency_attempt_row_matches_with_work(report, dependency, attempt, attempt_index_value, attempt_index, owner_lines, owner_resolved, owner_line, true, source_work)

        def proof_replay_dependency_is_checked[@r](report: mutable ProofReport& @r, dependency: sview, owner_line: u32, dependency_stack: darray[sview]&, dependency_depth: usize, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global.Read, Global.Write]:
            return false if:
                dependency == ""
                not proof_replay_dependency_indexes_build(report, validation_workspace.source_scan_work_used, &structural_cache)
                not proof_replay_dependency_row_index_shape_valid(structural_cache.dependency_attempt_rows, report.results.goal_attempts.count)
                not proof_replay_dependency_row_index_shape_valid(structural_cache.dependency_finding_rows, report.results.findings.count)
            return false if owner_line != 0 and not proof_replay_dependency_attempt_owner_cache_build(report, validation_workspace.source_scan_work_used, &structural_cache)
            found_goal: mutable bool = false
            all_goals_proven: mutable bool = true
            # A function-summary dependency names one declaration row (`owner_line`, the callee's
            # declaration line). Same-named functions of other modules are different rows: their
            # goals, findings, and certificates neither vouch for nor veto this callee. 0 keeps
            # the name-wide check (lemma summaries, whose names are unique). The linked row index
            # retains duplicates and unresolved same-name rows, so owner ambiguity still fails
            # closed rather than disappearing from this selection.
            attempt_lookup: (complete: bool, head: usize) = proof_replay_dependency_row_lookup(structural_cache.dependency_attempt_rows, dependency, validation_workspace.source_scan_work_used)
            return false if not attempt_lookup.complete
            attempt_index: mutable usize = attempt_lookup.head
            attempt_visits: mutable usize = 0
            while attempt_index < report.results.goal_attempts.count and attempt_visits < report.results.goal_attempts.count |attempt_index, attempt_visits, report, dependency, owner_line, validation_workspace, structural_cache, found_goal, all_goals_proven|:
                attempt: ProofGoalAttempt = report.results.goal_attempts[attempt_index]
                return false if:
                    not proof_replay_dependency_row_matches(structural_cache.dependency_attempt_rows, attempt_index, attempt.name, dependency, validation_workspace.source_scan_work_used)
                    not proof_replay_dependency_work_charge(1, validation_workspace.source_scan_work_used)
                attempt_owner_line: u32 = owner_line
                attempt_owner_line <- proof_replay_dependency_attempt_owner_line(report, structural_cache.dependency_attempt_rows, &structural_cache.dependency_attempt_owner_lines, &structural_cache.dependency_attempt_owner_resolved, attempt_index, attempt, validation_workspace.source_scan_work_used) if owner_line != 0
                # An unresolved same-name attempt could be an unproven goal owned by this
                # dependency. It must not disappear just because its source owner could not
                # be authenticated; failed attempts need not have a finding or certificate.
                return false if owner_line != 0 and attempt_owner_line == 0
                if owner_line == 0 or attempt_owner_line == owner_line:
                    found_goal <- true
                    all_goals_proven <- false if not attempt.proven
                next_attempt: usize = structural_cache.dependency_attempt_rows.next_indices[attempt_index]
                return false if next_attempt != report.results.goal_attempts.count and (next_attempt <= attempt_index or next_attempt >= report.results.goal_attempts.count)
                attempt_index <- next_attempt
                attempt_visits <- attempt_visits + 1
            return false if attempt_index < report.results.goal_attempts.count or attempt_visits > report.results.goal_attempts.count
            # Same filter the scheduler applies: a finding that only records a construct whose
            # effect was over-approximated did not enter this dependency's contract derivation,
            # and the two conditions that carry the weight here are untouched -- every goal the
            # dependency recorded must be proven, and every certificate it owns must replay.
            finding_lookup: (complete: bool, head: usize) = proof_replay_dependency_row_lookup(structural_cache.dependency_finding_rows, dependency, validation_workspace.source_scan_work_used)
            return false if not finding_lookup.complete
            finding_index: mutable usize = finding_lookup.head
            finding_visits: mutable usize = 0
            while finding_index < report.results.findings.count and finding_visits < report.results.findings.count |finding_index, finding_visits, report, dependency, owner_line, validation_workspace, structural_cache|:
                finding: ProofFinding = report.results.findings[finding_index]
                return false if:
                    not proof_replay_dependency_row_matches(structural_cache.dependency_finding_rows, finding_index, finding.name, dependency, validation_workspace.source_scan_work_used)
                    not proof_replay_dependency_work_charge(1, validation_workspace.source_scan_work_used)
                if proof_replay_dependency_finding_row_matches_with_work(report, dependency, finding, owner_line, structural_cache.dependency_attempt_rows, &structural_cache.dependency_attempt_owner_lines, &structural_cache.dependency_attempt_owner_resolved, validation_workspace.source_scan_work_used):
                    return false if not proof_replay_finding_only_widens_state(finding.kind)
                next_finding: usize = structural_cache.dependency_finding_rows.next_indices[finding_index]
                return false if next_finding != report.results.findings.count and (next_finding <= finding_index or next_finding >= report.results.findings.count)
                finding_index <- next_finding
                finding_visits <- finding_visits + 1
            return false if:
                finding_index < report.results.findings.count or finding_visits > report.results.findings.count
                not found_goal or not all_goals_proven
            return true if proof_replay_dependency_in_stack(dependency_stack, dependency)
            return false if dependency_depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            next_stack: mutable darray[sview] = []
            next_stack.extend(dependency_stack)
            next_stack.push(dependency)
            found_certificate: mutable bool = false
            return false if:
                not proof_replay_dependency_certificate_index_build(report, validation_workspace.source_scan_work_used, &structural_cache)
                not proof_replay_dependency_row_index_shape_valid(structural_cache.dependency_certificate_rows, report.analysis_1.certificates.count)
            return false if owner_line != 0 and not proof_replay_dependency_certificate_owner_cache_build(report, validation_workspace.source_scan_work_used, &structural_cache)
            certificate_lookup: (complete: bool, head: usize) = proof_replay_dependency_row_lookup(structural_cache.dependency_certificate_rows, dependency, validation_workspace.source_scan_work_used)
            return false if not certificate_lookup.complete
            certificate_index: mutable usize = certificate_lookup.head
            certificate_visits: mutable usize = 0
            while certificate_index < report.analysis_1.certificates.count and certificate_visits < report.analysis_1.certificates.count |certificate_index, report, next_stack, dependency_depth, found_certificate, active_certificates, dependency, validation_workspace, structural_cache, certificate_visits|:
                certificate: ProofGoalCertificate = report.analysis_1.certificates[certificate_index]
                return false if:
                    not proof_replay_dependency_row_matches(structural_cache.dependency_certificate_rows, certificate_index, certificate.name, dependency, validation_workspace.source_scan_work_used)
                    not proof_replay_dependency_work_charge(1, validation_workspace.source_scan_work_used)
                certificate_owner_line: u32 = owner_line
                certificate_owner_line <- proof_replay_dependency_certificate_owner_line(report, structural_cache.dependency_certificate_rows, &structural_cache.dependency_certificate_owner_lines, &structural_cache.dependency_certificate_owner_resolved, certificate_index, certificate, validation_workspace.source_scan_work_used) if owner_line != 0
                return false if owner_line != 0 and certificate_owner_line == 0
                if owner_line == 0 or certificate_owner_line == owner_line:
                    found_certificate <- true
                    return false if not (proof_replay_certificate_with_stack(report, certificate, certificate_index, next_stack, dependency_depth + 1, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
                next_certificate: usize = structural_cache.dependency_certificate_rows.next_indices[certificate_index]
                return false if next_certificate != report.analysis_1.certificates.count and (next_certificate <= certificate_index or next_certificate >= report.analysis_1.certificates.count)
                certificate_index <- next_certificate
                certificate_visits <- certificate_visits + 1
            return false if certificate_index < report.analysis_1.certificates.count or certificate_visits > report.analysis_1.certificates.count
            return found_certificate

        # A reusable lemma fact is valid only when it is the recorded postcondition instance for
        # the exact normalized arguments and every instantiated precondition is tied to a caller
        # certificate. Merely finding some replayable certificate with the same lemma name is not
        # enough: that would allow a buggy elaborator to manufacture an unrelated summary fact.
        def proof_replay_lemma_summary_call_source_valid(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            position: Ast::Pos = trace.source_call_position
            return false if:
                trace.name == "" or trace.dependency == "" or trace.line == 0
                position.line != trace.line or position.offset == 0 or position.end_offset <= position.offset
            owner_line: u32 = report.analysis_2.replay_owner_line
            return false if owner_line == 4294967295
            expected_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Invalid, [], [], position)
            source_call: mutable Ast::Expr = Ast::Expr.Invalid
            source_owner_line: mutable u32 = 0
            matches: mutable usize = 0
            owners: mutable usize = 0
            return false if:
                not proof_replay_summary_call_exact_span_in_declarations(report.source.source_declarations, trace.name, owner_line, expected_call, &source_call, &source_owner_line, &matches, &owners, source_work, 0)
                matches != 1 or owners != 1 or source_owner_line == 0
            match source_call:
                Ast::Expr.Call(Ast::Expr.Ident(callee_name, _), _, _, call_position):
                    return false if:
                        not proof_replay_source_position_equal(call_position, position)
                        not proof_replay_mutable_local_text_compare_work_charge(callee_name, trace.dependency, source_work)
                        callee_name != trace.dependency
                        proof_replay_local_binding_parameter_name_present_with_default_limit(report.source.source_declarations, trace.name, source_owner_line, callee_name, source_work, 0)
                    caller_body: mutable darray[Ast::Stmt] = []
                    return false if not proof_replay_source_owner_body_with_work(report, trace.name, source_owner_line, &caller_body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return proof_replay_source_call_locals_unshadowed_at_with_work(caller_body, report.source.source_annotations, source_call, source_work)
                _:
                    return false

        def proof_replay_lemma_summary_is_valid[@r](report: mutable ProofReport& @r, trace: ProofFactTrace, dependency_stack: darray[sview]&, dependency_depth: usize, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global.Read, Global.Write]:
            return false if:
                trace.kind != "lemma-summary" or trace.dependency == ""
                trace.summary_bindings_start > report.analysis_1.traces.summary_names.count or trace.summary_bindings_count > report.analysis_1.traces.summary_names.count - trace.summary_bindings_start
                trace.summary_bindings_start > report.analysis_1.traces.summary_values.count or trace.summary_bindings_count > report.analysis_1.traces.summary_values.count - trace.summary_bindings_start
                trace.summary_requires_start > report.analysis_1.traces.summary_require_goal_ids.count or trace.summary_requires_count > report.analysis_1.traces.summary_require_goal_ids.count - trace.summary_requires_start
                not proof_replay_lemma_summary_call_source_valid(report, trace, validation_workspace.source_scan_work_used)
            call_position: Ast::Pos = trace.source_call_position
            theorem_found: mutable bool = false
            theorem: mutable ProofTheoremSummary = ProofTheoremSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, decreases_start: 0, decreases_count: 0, proof_goals_start: 0, proof_goals_count: 0, recursive: false, verified: false, verification_reason: ""}
            return false if report.analysis_1.theorems.summaries.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + report.analysis_1.theorems.summaries.count
            for candidate in report.analysis_1.theorems.summaries |candidate, trace, theorem_found, theorem|:
                return false if sview_len(candidate.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(candidate.name)
                return false if sview_len(trace.dependency) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(trace.dependency)
                if candidate.name == trace.dependency:
                    return false if theorem_found
                    theorem_found <- true
                    theorem <- candidate
            return false if:
                not theorem_found or not theorem.verified
                theorem.parameters_start > report.analysis_1.theorems.parameters.count or theorem.parameters_count > report.analysis_1.theorems.parameters.count - theorem.parameters_start
                theorem.requires_start > report.analysis_1.theorems.requires.count or theorem.requires_count > report.analysis_1.theorems.requires.count - theorem.requires_start
                theorem.ensures_start > report.analysis_1.theorems.ensures.count or theorem.ensures_count > report.analysis_1.theorems.ensures.count - theorem.ensures_start
                trace.summary_bindings_count != theorem.parameters_count or trace.summary_requires_count != theorem.requires_count or trace.summary_ensure_index >= theorem.ensures_count
                theorem.parameters_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + theorem.parameters_count
            return false if theorem.requires_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + theorem.requires_count
            return false if theorem.ensures_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + theorem.ensures_count
            return false if trace.summary_requires_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
            validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + trace.summary_requires_count
            instance: mutable Ast::Expr = report.analysis_1.theorems.ensures[theorem.ensures_start + trace.summary_ensure_index]
            substitution_names: mutable darray[sview] = []
            substitution_values: mutable darray[Ast::Expr] = []
            for index in 0..<theorem.parameters_count |index, theorem, report, trace, substitution_names, substitution_values|:
                expected_name: sview = report.analysis_1.theorems.parameters[theorem.parameters_start + index]
                actual_name: sview = report.analysis_1.traces.summary_names[trace.summary_bindings_start + index]
                return false if sview_len(expected_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(expected_name)
                return false if sview_len(actual_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(actual_name)
                return false if expected_name != actual_name
                substitution_names.push(expected_name)
                substitution_values.push(report.analysis_1.traces.summary_values[trace.summary_bindings_start + index])
            return false if not proof_replay_summary_expr_repeat_charge_with_work(instance, theorem.parameters_count + 1, validation_workspace.source_scan_work_used)
            instance <- proof_replay_substitute_many(instance, substitution_names, substitution_values)
            return false if not proof_replay_summary_expr_equal_with_work(instance, trace.expression, validation_workspace.source_scan_work_used)
            for require_index in 0..<theorem.requires_count |require_index, theorem, report, trace, dependency_stack, dependency_depth, validation_workspace, call_position|:
                required: mutable Ast::Expr = report.analysis_1.theorems.requires[theorem.requires_start + require_index]
                return false if not proof_replay_summary_expr_repeat_charge_with_work(required, theorem.parameters_count + 1, validation_workspace.source_scan_work_used)
                for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, trace, required|:
                    required <- proof_replay_substitute(required, report.analysis_1.theorems.parameters[theorem.parameters_start + parameter_index], report.analysis_1.traces.summary_values[trace.summary_bindings_start + parameter_index])
                goal_id: usize = report.analysis_1.traces.summary_require_goal_ids[trace.summary_requires_start + require_index]
                return false if goal_id >= report.results.goal_attempts.count
                attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                return false if sview_len(attempt.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(attempt.name)
                return false if sview_len(trace.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(trace.name)
                return false if:
                    attempt.name != trace.name or not attempt.proven or not attempt.has_certificate or attempt.certificate_index >= report.analysis_1.certificates.count
                    attempt.line != call_position.line or not proof_replay_source_position_equal(attempt.source_call_position, call_position)
                require_certificate: ProofGoalCertificate = report.analysis_1.certificates[attempt.certificate_index]
                return false if:
                    not proof_replay_source_position_equal(require_certificate.source_call_position, call_position)
                    not proof_replay_summary_expr_equal_with_work(attempt.goal, required, validation_workspace.source_scan_work_used)
                    not (proof_replay_certificate_with_stack(report, report.analysis_1.certificates[attempt.certificate_index], attempt.certificate_index, dependency_stack, dependency_depth + 1, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
            return true

        # The innermost module that declares function `name` at `line`, counted over the whole
        # source tree so a repeated declaration line cannot pick between two owners.
        # A nested module may be recorded under its qualified spelling (`Outer::Inner`), while a
        # qualified callee keeps only its innermost segment, so the owner matches when it is the
        # segment or ends in `::segment`. Kept local so replay does not borrow checker code.
