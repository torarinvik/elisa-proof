extend ElisaProof:
    private:
        def proof_replay_source_calls(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, annotations: darray[Ast::EnumAnnotation]&, calls: mutable darray[sview]&) -> bool:
            work: mutable usize = 0
            return proof_replay_source_calls_with_work(parameters, body, annotations, calls, &work)

        def proof_replay_source_calls_with_work(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, annotations: darray[Ast::EnumAnnotation]&, calls: mutable darray[sview]&, work: mutable usize&, target_offset: usize = 0, target_name: sview = "", select_target: bool = false, preserve_occurrences: bool = false, require_resolved_dispatch: bool = false, include_nonassert_contract_calls: bool = false, field_conversion_names: darray[sview] = [], field_conversion_index_valid: bool = false, field_conversion_index_hashes: darray[u32] = [], field_conversion_index_values: darray[usize] = [], field_conversion_index_counts: darray[usize] = [], field_conversion_custom_cast_present: bool = false) -> bool:
            target: mutable ProofReplayCallSiteTarget = ProofReplayCallSiteTarget{selection: ProofReplayCallSiteTargetSelection{enabled: false, ignore_unmatched_scoped_edges: false, allow_scoped_target: false, include_nonassert_contract_calls: false, offset: 0, line: 0, name: "", calls_at_offset: 0, matched_calls: 0, track_unresolved_dispatch: false, unresolved_dispatch_found: false, source_annotations: []}, conversions: ProofReplayCallSiteTargetConversions{field_conversion_parameters: [], field_conversion_names: [], field_conversion_index_valid: false, field_conversion_index_hashes: [], field_conversion_index_values: [], field_conversion_index_counts: [], field_conversion_custom_cast_present: false}, aliases: ProofReplayCallSiteTargetAliases{field_conversion_alias_names: [], field_conversion_alias_targets: [], field_conversion_alias_lines: [], field_conversion_bare_alias_root_fallback_valid: false, field_conversion_alias_owners: [], field_conversion_alias_has_formals: [],
                        field_conversion_alias_generic_formal_names: [],
                        field_conversion_alias_generic_formal_starts: [],
                        field_conversion_alias_generic_formal_counts: [],
                        field_conversion_alias_generic_application_valid: [], field_conversion_alias_scope_index_valid: false, field_conversion_alias_scope_index_hashes: [], field_conversion_alias_scope_index_values: [], field_conversion_alias_scope_index_counts: [], field_conversion_alias_index_valid: false, field_conversion_alias_index_hashes: [], field_conversion_alias_index_values: [], field_conversion_alias_index_counts: []}, generics: ProofReplayCallSiteTargetGenerics{field_conversion_generic_params_valid: false, field_conversion_generic_param_lines: [], field_conversion_generic_param_names: [], field_conversion_generic_param_owner_offsets: [], field_conversion_generic_param_line: 0, field_conversion_generic_param_owner: "", field_conversion_generic_param_owner_known: false, field_conversion_generic_param_owner_offset: 0, field_conversion_generic_param_owner_offset_valid: false, field_conversion_generic_param_index_valid: false, field_conversion_generic_param_index_hashes: [], field_conversion_generic_param_index_values: [], field_conversion_generic_param_index_counts: [], field_conversion_generic_owner_index_valid: false, field_conversion_generic_owner_index_hashes: [], field_conversion_generic_owner_index_values: [], field_conversion_generic_owner_index_counts: [], field_conversion_generic_owner_index_entries: 0, field_conversion_generic_function_index_valid: false, field_conversion_generic_function_index_hashes: [], field_conversion_generic_function_index_values: [], field_conversion_generic_function_index_counts: [], field_conversion_generic_function_index_entries: 0}, types: ProofReplayCallSiteTargetTypes{field_conversion_declared_types: [], field_conversion_declared_type_owners: [], field_conversion_declared_type_scope_index_valid: false, field_conversion_declared_type_scope_index_hashes: [], field_conversion_declared_type_scope_index_values: [], field_conversion_declared_type_scope_index_counts: [], field_conversion_declared_type_index_valid: false, field_conversion_declared_type_index_hashes: [], field_conversion_declared_type_index_values: [], field_conversion_declared_type_index_counts: []}}
            target.selection.enabled <- select_target
            target.selection.allow_scoped_target <- select_target
            target.selection.include_nonassert_contract_calls <- select_target or include_nonassert_contract_calls
            target.selection.offset <- target_offset
            target.selection.name <- target_name
            target.selection.track_unresolved_dispatch <- select_target or require_resolved_dispatch
            target.selection.offset_line_any <- select_target
            target.capture.preserve_call_occurrences <- preserve_occurrences
            target.conversions.field_conversion_names <- field_conversion_names
            target.conversions.field_conversion_index_valid <- field_conversion_index_valid
            target.conversions.field_conversion_index_hashes <- field_conversion_index_hashes
            target.conversions.field_conversion_index_values <- field_conversion_index_values
            target.conversions.field_conversion_index_counts <- field_conversion_index_counts
            target.conversions.field_conversion_custom_cast_present <- field_conversion_custom_cast_present
            complete: bool = proof_replay_source_calls_with_target_work(parameters, body, annotations, calls, target, work)
            return false if not complete
            return false if require_resolved_dispatch and target.selection.unresolved_dispatch_found
            return target.selection.calls_at_offset == 1 and target.selection.matched_calls == 1 and not target.selection.unresolved_dispatch_found and not target.selection.unresolved_scope_at_target if select_target
            return true

        def proof_replay_source_calls_with_target_work(parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, annotations: darray[Ast::EnumAnnotation]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            calls.clear()
            call_target.selection.calls_at_offset <- 0
            call_target.selection.matched_calls <- 0
            call_target.selection.unresolved_dispatch_found <- false
            call_target.selection.unresolved_scope_at_target <- false
            call_target.capture.captured_local_type_names.clear()
            call_target.capture.captured_local_type_expressions.clear()
            if call_target.capture.capture_resource_call_expressions:
                call_target.capture.resource_call_offsets.clear()
                call_target.capture.resource_call_expressions.clear()
            if call_target.capture.capture_all_call_sites:
                call_target.capture.captured_call_offsets.clear()
                call_target.capture.captured_call_lines.clear()
                call_target.capture.captured_call_names.clear()
                call_target.capture.captured_callee_paths.clear()
                call_target.capture.captured_callee_path_hashes.clear()
                call_target.capture.captured_callee_path_slots.clear()
                call_target.capture.captured_scope_offsets.clear()
            elif call_target.capture.capture_callee_paths:
                call_target.capture.captured_callee_paths.clear()
                call_target.capture.captured_callee_path_hashes.clear()
                call_target.capture.captured_callee_path_slots.clear()
            call_target.selection.source_annotations <- annotations
            bindings: mutable darray[sview] = []
            call_index: mutable ProofReplayCallNameIndex = ProofReplayCallNameIndex{}
            return false if not proof_replay_call_work_add(work, parameters.count)
            # Defaults execute for omitted arguments, so preserve their call edges.
            for parameter in parameters |bindings, work|:
                return false if not proof_replay_call_work_add(work, sview_len(parameter.name)) or not proof_replay_call_work_add(work, 2)
                bindings.push(parameter.name)
            return false if not proof_replay_call_work_add(work, parameters.count)
            for parameter in parameters |bindings, calls, work|:
                return false if not proof_replay_call_work_add(work, 1)
                if parameter.has_default:
                    body_target_enabled: bool = call_target.selection.enabled
                    body_expression_capture: bool = call_target.capture.capture_resource_call_expressions
                    call_target.selection.enabled <- false
                    call_target.capture.capture_resource_call_expressions <- false
                    if not proof_replay_call_expression_with_index(parameter.default_value, &bindings, calls, call_index, call_target, work, 0):
                        calls.clear()
                        return false
                    call_target.selection.enabled <- body_target_enabled
                    call_target.capture.capture_resource_call_expressions <- body_expression_capture
            if not proof_replay_call_body(body, &bindings, calls, call_index, call_target, work, 0):
                calls.clear()
                return false
            return true

        # Signature contracts are outside the body but contribute calls to the producer's SCC
        # table. Callers pass one expression at a time and share the graph's cumulative work meter.
