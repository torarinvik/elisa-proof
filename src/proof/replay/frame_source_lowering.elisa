extend ElisaProofFrameSource:
    private:
        def lower_place(actual: ElisaProofKernelFramePolicy::Place, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&) -> usize can[Memory.Allocate, Abort.Panic]:
            fields: mutable darray[usize] = []
            for index in 0..<actual.depth |index, actual, nodes, fields|:
                field: sview = actual.field if index == 0 else actual.field2 if index == 1 else actual.field3
                fields.push(nodes.count)
                nodes.push(ElisaProofKernelCore::ProofKernelNode{kind: "frame-field", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: field, secondary_name: ""})
            start: usize = children.count if fields.count > 0 else 0
            for field in fields |children|:
                children.push(field)
            root: usize = nodes.count
            nodes.push(ElisaProofKernelCore::ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: actual.parameter, children_start: start, children_count: fields.count, value: 0, name: "", secondary_name: ""})
            return root

    public:
        # Reserve a conservative bounded upper limit before changing either
        # arena. Refused source/budgets leave both existing prefixes untouched.
        def lower_direct_events(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, node_limit: usize, child_limit: usize) -> (known: bool, roots: darray[usize]) can[Memory.Allocate, Abort.Panic, Global{Read,Write}]:
            work: mutable usize = 0
            return (lower_direct_events_with_work(declarations, [], name, line, tokens, source, source_length, nodes, children, node_limit, child_limit, &work) can Global{Read,Write})

        def lower_direct_events_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, node_limit: usize, child_limit: usize, work: mutable usize&) -> (known: bool, roots: darray[usize]) can[Memory.Allocate, Abort.Panic]:
            inventory = (direct_events_with_work(declarations, annotations, name, line, tokens, source, source_length, work) can Global{Read,Write})
            return (false, []) if not inventory.known
            return lower_direct_events_from_inventory_with_work(declarations, name, line, inventory.events, tokens, source, source_length, nodes, children, node_limit, child_limit, work)

        def lower_direct_events_at_offset_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, node_limit: usize, child_limit: usize, work: mutable usize&) -> (known: bool, roots: darray[usize]) can[Memory.Allocate, Abort.Panic]:
            inventory = (direct_events_at_offset_with_work(declarations, annotations, name, line, owner_offset, tokens, source, source_length, work) can Global{Read,Write})
            return (false, []) if not inventory.known
            policy = source_policy_at_offset_with_work(declarations, name, line, owner_offset, tokens, source, source_length, work)
            return lower_direct_events_with_policy_and_inventory_with_work(declarations, name, inventory.events, policy, nodes, children, node_limit, child_limit, work)
        def lower_direct_events_from_inventory_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, events: darray[Event]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, node_limit: usize, child_limit: usize, work: mutable usize&) -> (known: bool, roots: darray[usize]) can[Memory.Allocate, Abort.Panic]:
            policy = source_policy_with_work(declarations, name, line, tokens, source, source_length, work)
            return lower_direct_events_with_policy_and_inventory_with_work(declarations, name, events, policy, nodes, children, node_limit, child_limit, work)

        def lower_direct_events_from_inventory_at_offset_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, owner_offset: u32, events: darray[Event]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, node_limit: usize, child_limit: usize, work: mutable usize&) -> (known: bool, roots: darray[usize]) can[Memory.Allocate, Abort.Panic]:
            policy = source_policy_at_offset_with_work(declarations, name, line, owner_offset, tokens, source, source_length, work)
            return lower_direct_events_with_policy_and_inventory_with_work(declarations, name, events, policy, nodes, children, node_limit, child_limit, work)
        def lower_direct_events_with_policy_and_inventory_with_work(declarations: darray[Ast::Decl]&, name: sview, events: darray[Event]&, policy: (known: bool, parameter_count: usize, clauses: darray[Clause]), nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, node_limit: usize, child_limit: usize, work: mutable usize&) -> (known: bool, roots: darray[usize]) can[Memory.Allocate, Abort.Panic]:
            return (false, []) if:
                not policy.known
                node_limit > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or child_limit > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
            # Compute the reservation against remaining capacity using division before
            # multiplication. Source caps currently keep these products small, but this
            # boundary must remain safe if those caps or its callers change.
            return (false, []) if nodes.count > node_limit or children.count > child_limit
            remaining_nodes: usize = node_limit - nodes.count
            remaining_children: usize = child_limit - children.count
            return (false, []) if events.count > remaining_nodes / 5
            event_node_cost: usize = events.count * 5
            return (false, []) if policy.clauses.count > (remaining_nodes - event_node_cost) / 4
            clause_node_cost: usize = policy.clauses.count * 4
            node_addition: usize = event_node_cost + clause_node_cost
            return (false, []) if policy.clauses.count > remaining_children / 3
            clause_child_cost: usize = policy.clauses.count * 3
            remaining_event_children: usize = remaining_children - clause_child_cost
            children_per_event: usize = policy.clauses.count + 3
            return (false, []) if events.count > remaining_event_children / children_per_event
            event_child_cost: usize = events.count * children_per_event
            child_addition: usize = clause_child_cost + event_child_cost
            # Debit every later arena traversal before mutating either arena, so a
            # budget refusal preserves the caller's existing arena prefixes.
            return (false, []) if not replay_work_charge(policy.clauses.count, work)
            for clause in policy.clauses |work|:
                return (false, []) if:
                    not replay_work_charge(1, work)
                    not replay_work_charge(sview_len(clause.kind), work)
                    not replay_work_charge(clause.place.depth, work)
                    not replay_work_charge(sview_len(clause.place.field), work)
                    not replay_work_charge(sview_len(clause.place.field2), work)
                    not replay_work_charge(sview_len(clause.place.field3), work)
            return (false, []) if not replay_work_charge(events.count, work)
            for event in events |event, policy, work|:
                return (false, []) if:
                    not replay_work_charge(1, work)
                    not replay_work_charge(sview_len(event.kind), work)
                    not replay_work_charge(event.place.depth, work)
                    not replay_work_charge(sview_len(event.place.field), work)
                    not replay_work_charge(sview_len(event.place.field2), work)
                    not replay_work_charge(sview_len(event.place.field3), work)
                    not replay_work_charge(sview_len(name), work)
                if event.kind == "allow":
                    for clause in policy.clauses |work|:
                        return (false, []) if not replay_work_charge(sview_len(clause.kind), work)
                    for clause in policy.clauses |work|:
                        return (false, []) if not replay_work_charge(sview_len(clause.kind), work)
            policy_roots: mutable darray[usize] = []
            for clause in policy.clauses |nodes, children, policy_roots|:
                policy_roots.push(lower_place(clause.place, nodes, children))
            roots: mutable darray[usize] = []
            for event in events |event, nodes, children, policy, policy_roots, roots, name|:
                actual: usize = lower_place(event.place, nodes, children)
                start: usize = children.count
                split: mutable usize = 0
                operation: mutable sview = "spec"
                if event.kind == "allow":
                    operation <- "allow"
                    for index in 0..<policy.clauses.count |index, policy, policy_roots, children, split|:
                        if policy.clauses[index].kind == "changes":
                            children.push(policy_roots[index])
                            split <- split + 1
                    for index in 0..<policy.clauses.count |index, policy, policy_roots, children|:
                        children.push(policy_roots[index]) if policy.clauses[index].kind == "preserves"
                elif event.kind == "preserve":
                    operation <- "preserve"
                    return (false, []) if event.clause_index >= policy_roots.count
                    children.push(policy_roots[event.clause_index])
                count: usize = children.count - start
                roots.push(nodes.count)
                nodes.push(ElisaProofKernelCore::ProofKernelNode{kind: "frame-policy", operator: operation, left: actual, right: split, auxiliary: policy.parameter_count, children_start: start if count > 0 else 0, children_count: count, value: 0, name: name, secondary_name: "frame-policy-v1"})
            return (true, roots)
