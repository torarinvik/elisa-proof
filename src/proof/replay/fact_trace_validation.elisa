extend ElisaProof:
    private:
        # Fact provenance is keyed by the owner name before exact expression/kernel equality is
        # checked. Hashes only select a probe path; the stored sview comparison remains the
        # authority, so collisions cannot admit a fact for another owner.
        def proof_replay_owner_hash(value: sview) -> u32:
            hash: mutable i64 = 2166136261
            for index in 0..<sview_len(value) |index, hash, value|:
                hash <- ((hash ^ sview_at(value, index).i64()) * 16777619) % 4294967296
            return hash.u32()

        def proof_replay_trace_index_capacity(count: usize) -> usize:
            return 0 if count == 0
            # The open-addressed table grows geometrically. Reject a count whose next power of
            # two would itself exceed the canonical report bound instead of overflowing or
            # allocating a table larger than the arena budget.
            return 0 if count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET / 2
            capacity: mutable usize = 1
            while capacity < count |capacity, count|:
                return 0 if capacity > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET / 2
                capacity <- capacity * 2
            return capacity

        def proof_replay_build_fact_trace_index(report: mutable ProofReport&) -> void:
            count: usize = report.fact_traces.count
            sentinel: usize = count
            report.fact_trace_index_hashes.clear()
            report.fact_trace_index_values.clear()
            report.fact_trace_next_indices.clear()
            return if not proof_kernel_report_append_allowed(report, 0, count, "replay-fact-index")
            return if count == 0
            report.fact_trace_next_indices.resize(count)
            for index in 0..<count |index, report, sentinel|:
                report.fact_trace_next_indices[index] <- sentinel
            capacity: usize = proof_replay_trace_index_capacity(count)
            if capacity == 0:
                proof_kernel_budget_note(report, "replay-fact-index")
                return
            report.fact_trace_index_hashes.resize(capacity)
            report.fact_trace_index_values.resize(capacity)
            for slot in 0..<capacity |slot, report, sentinel|:
                report.fact_trace_index_values[slot] <- sentinel
            for index in 0..<count |index, report, capacity, sentinel|:
                owner: sview = report.fact_traces[index].name
                hash: u32 = proof_replay_owner_hash(owner)
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity |probes, slot, hash, index, report, capacity, sentinel|:
                    current: usize = report.fact_trace_index_values[slot]
                    if current == sentinel:
                        report.fact_trace_index_hashes[slot] <- hash
                        report.fact_trace_index_values[slot] <- index
                        break
                    if report.fact_trace_index_hashes[slot] == hash and report.fact_traces[current].name == owner:
                        report.fact_trace_next_indices[index] <- current
                        report.fact_trace_index_values[slot] <- index
                        break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1

        def proof_replay_fact_trace_head(report: ProofReport&, owner: sview) -> usize:
            count: usize = report.fact_traces.count
            capacity: usize = report.fact_trace_index_values.count
            return count if capacity == 0
            # These arrays are an optimization, not authoritative report data. If a caller has
            # mutated one of them independently, abandon the index rather than dereferencing a
            # mismatched hash/next slot and turning malformed input into a replay crash.
            return count if report.fact_trace_index_hashes.count != capacity or report.fact_trace_next_indices.count != count
            hash: u32 = proof_replay_owner_hash(owner)
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity |probes, slot, hash, owner, report, capacity, count|:
                index: usize = report.fact_trace_index_values[slot]
                return count if index >= count
                return index if report.fact_trace_index_hashes[slot] == hash and report.fact_traces[index].name == owner
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return count

        def proof_replay_fact_trace_is_valid(report: mutable ProofReport&, trace: ProofFactTrace, owner: sview, depth: usize) -> bool:
            dependency_stack: mutable darray[sview] = [owner]
            active_certificates: mutable darray[usize] = []
            return proof_replay_fact_trace_is_valid_with_stack(report, trace, owner, depth, dependency_stack, active_certificates)

        def proof_replay_fact_is_traced_with_stack(report: mutable ProofReport&, fact: Ast::Expr, owner: sview, dependency_stack: darray[sview]&, active_certificates: darray[usize]&) -> bool:
            trace_index: mutable usize = proof_replay_fact_trace_head(report, owner)
            while trace_index < report.fact_traces.count |trace_index, report, fact, owner, dependency_stack, active_certificates|:
                trace: ProofFactTrace = report.fact_traces[trace_index]
                return true if proof_replay_expr_equal(trace.expression, fact) and proof_replay_fact_trace_is_valid_with_stack(report, trace, owner, 0, dependency_stack, active_certificates)
                trace_index <- report.fact_trace_next_indices[trace_index] if trace_index < report.fact_trace_next_indices.count else report.fact_traces.count
            return false

        def proof_replay_fact_is_traced(report: mutable ProofReport&, fact: Ast::Expr, owner: sview) -> bool:
            dependency_stack: mutable darray[sview] = [owner]
            active_certificates: mutable darray[usize] = []
            return proof_replay_fact_is_traced_with_stack(report, fact, owner, dependency_stack, active_certificates)

        # Certificates are not standalone propositions: each one must be the exact root emitted
        # for a successful goal attempt. Check both source-level fields and arena ranges before
        # replaying the logical claim. This prevents a future serialized certificate from
        # attaching an otherwise replayable root to an unrelated or fabricated obligation.
        def proof_replay_certificate_root_is_proven(report: ProofReport&, certificate: ProofGoalCertificate) -> bool:
            return false if certificate.facts_start > report.certificate_facts.count or certificate.facts_count > report.certificate_facts.count - certificate.facts_start
            for attempt in report.goal_attempts:
                continue if not attempt.has_certificate or not attempt.proven
                continue if attempt.facts_start != certificate.facts_start or attempt.facts_count != certificate.facts_count
                continue if attempt.kernel_goal != certificate.kernel_goal or attempt.kernel_facts_start != certificate.kernel_facts_start or attempt.kernel_facts_count != certificate.kernel_facts_count
                continue if attempt.line != certificate.line or attempt.name != certificate.name or attempt.rule != certificate.rule
                # `kernel_goal` is the canonical semantic identity. The source AST mirror is
                # presentation data and can contain compiler expression forms (for example
                # quantifier blocks) that the small source diagnostic equality intentionally does
                # not normalize; the exact arena root/range match above remains authoritative.
                return true
            return false

        def proof_replay_certificate_with_stack[@r](report: mutable ProofReport& @r, certificate: ProofGoalCertificate, certificate_index: usize, dependency_stack: darray[sview]&, dependency_depth: usize, active_certificates: darray[usize]&) -> bool:
            return false if proof_replay_certificate_in_stack(active_certificates, certificate_index)
            return false if not report.kernel_arena_validated
            return false if not proof_replay_certificate_root_is_proven(report, certificate)
            return false if certificate.kernel_facts_start > report.kernel_certificate_facts.count or certificate.kernel_facts_count > report.kernel_certificate_facts.count - certificate.kernel_facts_start
            return false if certificate.kernel_goal >= report.kernel_nodes.count
            return false if certificate.facts_count != certificate.kernel_facts_count
            next_active_certificates: mutable darray[usize] = []
            next_active_certificates.extend(active_certificates)
            next_active_certificates.push(certificate_index)
            if certificate.rule != "resource-safety" and certificate.rule != "structural-safety" and certificate.rule != "effect-containment":
                return false if not proof_replay_ast_matches_kernel(report, certificate.goal, certificate.kernel_goal, 0)
            for index in 0..<certificate.facts_count |index, report, certificate|:
                source_fact: Ast::Expr = report.certificate_facts[certificate.facts_start + index]
                kernel_fact: usize = report.kernel_certificate_facts[certificate.kernel_facts_start + index]
                return false if not proof_replay_ast_matches_kernel(report, source_fact, kernel_fact, 0)
            facts: mutable darray[usize] = []
            for index in 0..<certificate.kernel_facts_count |index, facts, report, certificate|:
                fact: usize = report.kernel_certificate_facts[certificate.kernel_facts_start + index]
                return false if fact >= report.kernel_nodes.count
                facts.push(fact)
            for fact in facts |fact, report, certificate, dependency_stack, next_active_certificates|:
                return false if not proof_replay_kernel_fact_root_is_traced_with_stack(report, fact, certificate.name, dependency_stack, false, next_active_certificates)
            return false if certificate.rule == "resource-safety" and not proof_replay_resource_event_facts_with_owner(report, certificate.kernel_goal, certificate.name, dependency_stack, 0, next_active_certificates)
            return ElisaProofKernelReplay::proof_kernel_replay_resource_report_after_arena(&report.kernel_nodes, &report.kernel_children, facts, certificate.kernel_goal) if certificate.rule == "resource-safety"
            return ElisaProofKernelReplay::proof_kernel_replay_structural_report_after_arena(&report.kernel_nodes, &report.kernel_children, facts, certificate.kernel_goal) if certificate.rule == "structural-safety"
            return ElisaProofKernelReplay::proof_kernel_replay_effect_report_after_arena(&report.kernel_nodes, &report.kernel_children, facts, certificate.kernel_goal) if certificate.rule == "effect-containment"
            return ElisaProofKernelReplay::proof_kernel_replay_checked_index_report_after_arena(&report.kernel_nodes, &report.kernel_children, facts, certificate.kernel_goal) if certificate.rule == "checked-index"
            return ElisaProofKernelReplay::proof_kernel_replay_checked_get_report_after_arena(&report.kernel_nodes, &report.kernel_children, facts, certificate.kernel_goal) if certificate.rule == "checked-get"
            return ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_after_arena(&report.kernel_nodes, &report.kernel_children, "forall", facts, certificate.kernel_goal) if certificate.rule == "quantifier-forall"
            return ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_after_arena(&report.kernel_nodes, &report.kernel_children, "exists", facts, certificate.kernel_goal) if certificate.rule == "quantifier-exists"
            return ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_after_arena(&report.kernel_nodes, &report.kernel_children, report.kernel_nodes[certificate.kernel_goal].operator, facts, certificate.kernel_goal) if report.kernel_nodes[certificate.kernel_goal].kind == "quantifier"
            return ElisaProofKernelReplay::proof_kernel_replay_goal_report_after_arena(&report.kernel_nodes, &report.kernel_children, facts, certificate.kernel_goal)

        def proof_replay_certificate[@r](report: mutable ProofReport& @r, certificate: ProofGoalCertificate, certificate_index: usize) -> bool:
            dependency_stack: mutable darray[sview] = [certificate.name]
            active_certificates: mutable darray[usize] = []
            return proof_replay_certificate_with_stack(report, certificate, certificate_index, dependency_stack, 0, active_certificates)
