extend ElisaProof:
    private:
        def proof_replay_fact_trace_is_valid(report: mutable ProofReport&, trace: ProofFactTrace, owner: sview, depth: usize) -> bool can[Global{Read,Write}]:
            dependency_stack: mutable darray[sview] = [owner]
            active_certificates: mutable darray[usize] = []
            validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            structural_cache: mutable ProofReplayStructuralValidationCache = ProofReplayStructuralValidationCache{}
            return (proof_replay_fact_trace_is_valid_with_stack(report, trace, report.analysis_1.traces.records.count, owner, depth, dependency_stack, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})

        def proof_replay_fact_is_traced_with_stack(report: mutable ProofReport&, fact: Ast::Expr, owner: sview, dependency_stack: darray[sview]&, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            expression_shape: (supported: bool, hash: u32) = proof_replay_trace_expression_hash(report, fact, 0)
            return false if not expression_shape.supported
            expression_hash: u32 = expression_shape.hash
            trace_index: mutable usize = proof_replay_fact_expression_head(report, owner, expression_hash)
            while trace_index < report.analysis_1.traces.records.count |trace_index, report, fact, owner, dependency_stack, active_certificates, validation_workspace|:
                trace: ProofFactTrace = report.analysis_1.traces.records[trace_index]
                return false if:
                    not proof_replay_trace_lookup_charge_amount(report, sview_len(trace.name))
                    trace.name != owner or trace_index >= report.analysis_1.traces.expression_hashes.count or report.analysis_1.traces.expression_hashes[trace_index] != expression_hash
                    not proof_replay_trace_expression_equality_work(report, fact)
                    not proof_replay_trace_expression_equality_work(report, trace.expression)
                return true if proof_replay_expr_equal_depth(trace.expression, fact, 0) and (proof_replay_fact_trace_is_valid_with_stack(report, trace, trace_index, owner, 0, dependency_stack, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
                trace_index <- proof_replay_trace_expression_chain_next(report, trace_index, owner, expression_hash)
            return false

        def proof_replay_fact_is_traced(report: mutable ProofReport&, fact: Ast::Expr, owner: sview) -> bool can[Global{Read,Write}]:
            dependency_stack: mutable darray[sview] = [owner]
            active_certificates: mutable darray[usize] = []
            validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            structural_cache: mutable ProofReplayStructuralValidationCache = ProofReplayStructuralValidationCache{}
            return (proof_replay_fact_is_traced_with_stack(report, fact, owner, dependency_stack, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})

        # Certificates are not standalone propositions: each one must be the exact root emitted
        # for a successful goal attempt. Check both source-level fields and arena ranges before
        # replaying the logical claim. This prevents a future serialized certificate from
        # attaching an otherwise replayable root to an unrelated or fabricated obligation.
        # This check is read-only and inspects a report-owned attempt containing mutable
        # bookkeeping plus an arena-backed AST handle. Borrow the exact attempt rather than
        # materializing a second record copy at the replay trust boundary.
        def proof_replay_attempt_source_goal_matches_certificate(attempt: ProofGoalAttempt&, certificate: ProofGoalCertificate) -> bool:
            work: mutable usize = 0
            return proof_replay_attempt_source_goal_matches_certificate_with_work(attempt, certificate, &work)

        def proof_replay_attempt_source_goal_matches_certificate_with_work(attempt: ProofGoalAttempt&, certificate: ProofGoalCertificate, source_work: mutable usize&) -> bool:
            proof_replay_attempt_source_goal_matches_certificate_with_limit(attempt, certificate, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_replay_attempt_source_goal_matches_certificate_with_limit(attempt: ProofGoalAttempt&, certificate: ProofGoalCertificate, source_work: mutable usize&, work_limit: usize) -> bool:
            return false if not proof_replay_summary_expr_equal_with_limit(attempt.goal, certificate.goal, source_work, work_limit)
            attempt_position: Ast::Pos = Ast::expr_pos(attempt.goal)
            certificate_position: Ast::Pos = Ast::expr_pos(certificate.goal)
            return attempt_position.line == certificate_position.line and attempt_position.column == certificate_position.column and attempt_position.offset == certificate_position.offset and attempt_position.end_line == certificate_position.end_line and attempt_position.end_column == certificate_position.end_column and attempt_position.end_offset == certificate_position.end_offset

        def proof_replay_attempt_matches_certificate(report: ProofReport&, attempt: ProofGoalAttempt&, certificate: ProofGoalCertificate, certificate_index: usize) -> bool:
            work: mutable usize = 0
            return proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, certificate_index, &work)

        def proof_replay_attempt_matches_certificate_with_work(report: ProofReport&, attempt: ProofGoalAttempt&, certificate: ProofGoalCertificate, certificate_index: usize, source_work: mutable usize&) -> bool:
            proof_replay_attempt_matches_certificate_with_limit(report, attempt, certificate, certificate_index, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)

        def proof_replay_attempt_text_compare_with_limit(left: sview, right: sview, work: mutable usize&, work_limit: usize) -> bool:
            return false if work_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or work >= work_limit
            work <- work + 1
            return false if sview_len(left) > work_limit - work
            work <- work + sview_len(left)
            return false if sview_len(right) > work_limit - work
            work <- work + sview_len(right)
            true

        def proof_replay_attempt_matches_certificate_with_limit(report: ProofReport&, attempt: ProofGoalAttempt&, certificate: ProofGoalCertificate, certificate_index: usize, source_work: mutable usize&, work_limit: usize) -> bool:
            return false if:
                not attempt.producer_proven or not attempt.has_certificate or attempt.certificate_index != certificate_index
                attempt.facts_start != certificate.facts_start or attempt.facts_count != certificate.facts_count
                attempt.kernel_goal != certificate.kernel_goal or attempt.kernel_facts_start != certificate.kernel_facts_start or attempt.kernel_facts_count != certificate.kernel_facts_count
                not proof_replay_attempt_text_compare_with_limit(attempt.name, certificate.name, source_work, work_limit)
                not proof_replay_attempt_text_compare_with_limit(attempt.rule, certificate.rule, source_work, work_limit)
                not proof_replay_attempt_text_compare_with_limit(attempt.source_phase, certificate.source_phase, source_work, work_limit)
                attempt.line != certificate.line or attempt.name != certificate.name or attempt.rule != certificate.rule
                not proof_replay_source_position_equal(attempt.source_call_position, certificate.source_call_position)
                attempt.source_call_obligation_selected != certificate.source_call_obligation_selected
                attempt.source_call_requires != certificate.source_call_requires or attempt.source_call_requires_index != certificate.source_call_requires_index
                attempt.source_call_callee_name != certificate.source_call_callee_name or attempt.source_call_callee_module != certificate.source_call_callee_module
                attempt.source_call_callee_line != certificate.source_call_callee_line or attempt.source_call_callee_offset != certificate.source_call_callee_offset
                attempt.source_phase == "loop-invariant-transfer" and not proof_replay_source_position_equal(attempt.loop_transfer_position, certificate.loop_transfer_position)
                (attempt.source_phase == "loop-invariant-entry" or attempt.source_phase == "loop-invariant-preservation") and not proof_replay_source_position_equal(attempt.loop_source_position, certificate.loop_source_position)
            # Source-aware validators use the certificate mirror as their position anchor. Tie
            # that mirror back to the goal attempt and its phase before treating either as source
            # evidence; the kernel term itself intentionally erases source positions.
            return false if:
                attempt.source_phase != certificate.source_phase or not proof_replay_attempt_source_goal_matches_certificate_with_limit(attempt, certificate, source_work, work_limit)
                certificate.source_phase != "" and certificate.source_phase != "loop-invariant-entry" and certificate.source_phase != "loop-invariant-preservation" and certificate.source_phase != "loop-invariant-transfer"
            # The source AST is presentation data, but it must still describe this same root.
            # Otherwise a mutated report could display one goal while pointing at another
            # replayed certificate.
            if certificate.rule in {"resource-safety", "structural-safety", "effect-containment", "frame-spec", "frame-allow", "frame-preserve"}:
                match attempt.goal:
                    Ast::Expr.BoolLit(value, _):
                        return value
                    _:
                        return false
            return proof_replay_ast_matches_kernel_with_work(report, attempt.goal, certificate.kernel_goal, source_work, 0)

        def proof_replay_certificate_root_is_proven(report: ProofReport&, certificate: ProofGoalCertificate, certificate_index: usize) -> bool:
            work: mutable usize = 0
            structural_cache: mutable ProofReplayStructuralValidationCache = ProofReplayStructuralValidationCache{}
            return proof_replay_certificate_root_is_proven_with_work(report, certificate, certificate_index, &work, &structural_cache)

        def proof_replay_certificate_attempt_index_build(report: ProofReport&, source_work: mutable usize&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return structural_cache.certificate_attempt_index_complete if structural_cache.certificate_attempt_index_attempted
            structural_cache.certificate_attempt_index_attempted <- true
            certificate_count: usize = report.analysis_1.certificates.count
            attempt_count: usize = report.results.goal_attempts.count
            return false if:
                source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                certificate_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2 or attempt_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3
                certificate_count * 2 > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + certificate_count * 2
            return false if attempt_count * 3 > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + attempt_count * 3
            index: mutable ProofReplayCertificateAttemptIndex = ProofReplayCertificateAttemptIndex{certificate_count: certificate_count, attempt_count: attempt_count}
            index.heads.resize(certificate_count)
            index.next_indices.resize(attempt_count)
            for certificate_id in 0..<certificate_count |certificate_id, index, attempt_count|:
                index.heads[certificate_id] <- attempt_count
            for attempt_id in 0..<attempt_count |attempt_id, index, attempt_count|:
                index.next_indices[attempt_id] <- attempt_count
            for attempt_id in 0..<attempt_count |attempt_id, report, index, certificate_count, attempt_count|:
                attempt: ProofGoalAttempt = report.results.goal_attempts[attempt_id]
                continue if not attempt.producer_proven or not attempt.has_certificate
                return false if attempt.certificate_index >= certificate_count
                index.next_indices[attempt_id] <- index.heads[attempt.certificate_index]
                index.heads[attempt.certificate_index] <- attempt_id
            structural_cache.certificate_attempt_index <- index
            structural_cache.certificate_attempt_index_complete <- true
            true

        def proof_replay_certificate_root_is_proven_with_work(report: ProofReport&, certificate: ProofGoalCertificate, certificate_index: usize, source_work: mutable usize&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if:
                certificate.facts_start > report.analysis_1.certificate_facts.count or certificate.facts_count > report.analysis_1.certificate_facts.count - certificate.facts_start
                not proof_replay_certificate_attempt_index_build(report, source_work, structural_cache)
            index: ProofReplayCertificateAttemptIndex& = &structural_cache.certificate_attempt_index
            return false if:
                index.certificate_count != report.analysis_1.certificates.count or index.attempt_count != report.results.goal_attempts.count
                certificate_index >= index.certificate_count or index.heads.count != index.certificate_count or index.next_indices.count != index.attempt_count
            attempt_index: mutable usize = index.heads[certificate_index]
            attempts_visited: mutable usize = 0
            while attempt_index < index.attempt_count and attempts_visited < index.attempt_count |attempt_index, attempts_visited, report, certificate, certificate_index, source_work, index|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                return false if attempt_index >= report.results.goal_attempts.count
                attempt: ProofGoalAttempt = report.results.goal_attempts[attempt_index]
                return true if proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, certificate_index, source_work)
                next_attempt: usize = index.next_indices[attempt_index]
                return false if next_attempt != index.attempt_count and next_attempt >= attempt_index
                attempt_index <- next_attempt
                attempts_visited <- attempts_visited + 1
            return false

        def proof_replay_certificate_with_stack[@r](report: mutable ProofReport& @r, certificate: ProofGoalCertificate, certificate_index: usize, dependency_stack: darray[sview]&, dependency_depth: usize, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            # A dependency that already passed its own full replay in this batch is not re-walked
            # per call path: chained summaries would otherwise revalidate it once per path, which
            # is exponential in the chain length. `proof_replay_certificates` clears every flag
            # first and sets one only after that certificate's complete check, and the batch still
            # requires every certificate to replay, so nothing is admitted that is not also
            # validated on its own.
            # Keep this shortcut batch-local: its flags are valid only for the unchanged report
            # between full certificate replay and the synchronous source-fact snapshot. Public
            # report replay resets and revalidates the flags on every call.
            return true if validation_workspace.allow_replayed_dependency_memo and dependency_depth > 0 and certificate_index < report.analysis_1.certificates.count and report.analysis_1.certificates[certificate_index].replayed
            active_lookup: (complete: bool, found: bool) = proof_replay_certificate_in_stack(active_certificates, certificate_index, validation_workspace.source_scan_work_used)
            return false if:
                not active_lookup.complete or active_lookup.found
                not proof_replay_certificate_rule_valid(certificate.rule)
                not report.analysis_1.kernel.arena_validated
                not proof_replay_certificate_root_is_proven_with_work(report, certificate, certificate_index, validation_workspace.source_scan_work_used, structural_cache)
                certificate.kernel_facts_start > report.analysis_1.kernel.certificate_facts.count or certificate.kernel_facts_count > report.analysis_1.kernel.certificate_facts.count - certificate.kernel_facts_start
                certificate.kernel_goal >= report.analysis_1.kernel.nodes.count
                certificate.facts_count != certificate.kernel_facts_count
                certificate.facts_start > report.analysis_1.traces.origin_indices.count or certificate.facts_count > report.analysis_1.traces.origin_indices.count - certificate.facts_start
            if certificate.rule == "resource-safety":
                resource_root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[certificate.kernel_goal]
                return false if resource_root.kind != "resource-safety" or not proof_replay_attempt_text_compare_with_limit(resource_root.name, certificate.name, validation_workspace.source_scan_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return false if not proof_replay_summary_owner_source_preflight(report, certificate.name, certificate.line, validation_workspace.source_scan_work_used)
            next_active_certificates: mutable darray[usize] = []
            return false if not proof_replay_source_work_charge_or_exhaust(active_certificates.count * 2, validation_workspace.source_scan_work_used)
            next_active_certificates.extend(active_certificates)
            return false if not proof_replay_source_work_charge_or_exhaust(2, validation_workspace.source_scan_work_used)
            next_active_certificates.push(certificate_index)
            if certificate.rule != "resource-safety" and certificate.rule != "structural-safety" and certificate.rule != "effect-containment":
                return false if not proof_replay_ast_matches_kernel_with_work(report, certificate.goal, certificate.kernel_goal, validation_workspace.source_scan_work_used, 0)
            for index in 0..<certificate.facts_count |index, report, certificate|:
                source_fact: Ast::Expr = report.analysis_1.certificate_facts[certificate.facts_start + index]
                kernel_fact: usize = report.analysis_1.kernel.certificate_facts[certificate.kernel_facts_start + index]
                return false if not proof_replay_ast_matches_kernel_with_work(report, source_fact, kernel_fact, validation_workspace.source_scan_work_used, 0)
            facts: mutable darray[usize] = []
            saved_owner_line: u32 = report.analysis_2.replay_owner_line
            saved_owner_offset: usize = report.analysis_2.replay_owner_offset
            saved_owner_offset_valid: bool = report.analysis_2.replay_owner_offset_valid
            saved_consumer_line: u32 = report.analysis_2.trace_owner_line
            saved_consumer_certificate: usize = report.analysis_2.trace_consumer_certificate_index
            saved_consumer_attempt: usize = report.analysis_2.trace_consumer_attempt_index
            owner_position: Ast::Pos = proof_replay_trace_owner_source_position_with_work(report, certificate, validation_workspace.source_scan_work_used)
            owner_line: u32 = owner_position.line
            # An unidentified owner gets a line no declaration has, so stamped constants never apply.
            report.analysis_2.replay_owner_line <- owner_line if owner_line != 0 else 4294967295
            report.analysis_2.replay_owner_offset <- owner_position.offset.usize()
            report.analysis_2.replay_owner_offset_valid <- owner_line != 0
            report.analysis_2.trace_owner_line <- certificate.line
            report.analysis_2.trace_consumer_certificate_index <- certificate_index + 1
            report.analysis_2.trace_consumer_attempt_index <- 0
            invalid_fact_reference: mutable bool = false
            fact_append_budget_exhausted: mutable bool = false
            for index in 0..<certificate.kernel_facts_count |index, facts, report, certificate, dependency_stack, next_active_certificates, validation_workspace, structural_cache|:
                fact: usize = report.analysis_1.kernel.certificate_facts[certificate.kernel_facts_start + index]
                if fact >= report.analysis_1.kernel.nodes.count:
                    invalid_fact_reference <- true
                    break
                source_fact: Ast::Expr = report.analysis_1.certificate_facts[certificate.facts_start + index]
                trace_index: usize = report.analysis_1.traces.origin_indices[certificate.facts_start + index]
                if trace_index < report.analysis_1.traces.records.count:
                    trace: ProofFactTrace = report.analysis_1.traces.records[trace_index]
                    # A matching kernel root is not enough to establish this source fact's
                    # provenance: AST lowering may intentionally erase source-only payloads
                    # (for example, a `get ... else` recovery block). Keep the origin selected
                    # for this exact fact and owner, and require its complete source expression
                    # to match before using any kernel-root fallback.
                    continue if:
                        not proof_replay_attempt_text_compare_with_limit(trace.name, certificate.name, validation_workspace.source_scan_work_used, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        not proof_replay_summary_expr_equal_with_work(source_fact, trace.expression, validation_workspace.source_scan_work_used)
                        # Structural equality intentionally ignores spans. Compare every
                        # supported node position so nested source annotations cannot be retargeted.
                        not proof_replay_trace_expression_positions_equal_for_report(report, source_fact, trace.expression, 0)
                    continue if trace.kind == "local-binding" and not proof_replay_local_binding_fact_live_with_cache(report, trace, validation_workspace.source_scan_work_used, &structural_cache.deterministic_calls)
                else:
                    # Unsupported expressions have no exact trace origin. Do not let a distinct
                    # source expression with an erased-equivalent kernel root supply provenance.
                    continue
                # A certificate may serialize premises whose source provenance this replay
                # deliberately does not support. They are not trusted: omit them and let the
                # kernel determine whether the remaining validated facts suffice. Rejecting the
                # whole certificate here would turn an unused opaque premise into a replay gap.
                continue if not (proof_replay_kernel_fact_root_is_traced_with_stack(report, fact, certificate.name, dependency_stack, false, false, next_active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
                if not proof_replay_source_work_charge_or_exhaust(2, validation_workspace.source_scan_work_used):
                    fact_append_budget_exhausted <- true
                    break
                facts.push(fact)
            report.analysis_2.replay_owner_line <- saved_owner_line
            report.analysis_2.replay_owner_offset <- saved_owner_offset
            report.analysis_2.replay_owner_offset_valid <- saved_owner_offset_valid
            report.analysis_2.trace_owner_line <- saved_consumer_line
            report.analysis_2.trace_consumer_certificate_index <- saved_consumer_certificate
            report.analysis_2.trace_consumer_attempt_index <- saved_consumer_attempt
            return false if invalid_fact_reference or fact_append_budget_exhausted
            if certificate.rule == "resource-safety":
                return false if certificate.kernel_goal >= report.analysis_1.kernel.nodes.count
                resource_root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[certificate.kernel_goal]
                # Resource goals use a synthetic Boolean term, so their source-owner position
                # comes from the resource root. The event walker authenticates that key against
                # exactly one parser-owned declaration before it validates any event facts.
                report.analysis_2.replay_owner_line <- resource_root.right.u32()
                report.analysis_2.replay_owner_offset <- resource_root.value.usize()
                report.analysis_2.replay_owner_offset_valid <- true
                report.analysis_2.trace_owner_line <- certificate.line
                report.analysis_2.trace_consumer_certificate_index <- certificate_index + 1
                report.analysis_2.trace_consumer_attempt_index <- 0
                resource_facts_valid: bool = proof_replay_resource_event_facts_with_owner(report, certificate.kernel_goal, certificate.kernel_goal, 0, certificate.name, 0, 0, "", dependency_stack, 0, next_active_certificates, validation_workspace, structural_cache) can Global{Read,Write}
                report.analysis_2.replay_owner_line <- saved_owner_line
                report.analysis_2.replay_owner_offset <- saved_owner_offset
                report.analysis_2.replay_owner_offset_valid <- saved_owner_offset_valid
                report.analysis_2.trace_owner_line <- saved_consumer_line
                report.analysis_2.trace_consumer_certificate_index <- saved_consumer_certificate
                report.analysis_2.trace_consumer_attempt_index <- saved_consumer_attempt
                return false if not resource_facts_valid
            if certificate.rule == "effect-containment":
                return false if:
                    not proof_replay_deterministic_declaration_scan_charge(report.source.source_declarations, validation_workspace.source_scan_work_used, 0)
                    not proof_replay_summary_owner_source_preflight(report, certificate.name, certificate.line, validation_workspace.source_scan_work_used)
                    report.source.source_annotations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + report.source.source_annotations.count
                for annotation in report.source.source_annotations |validation_workspace|:
                    return false if sview_len(annotation.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(annotation.name)
                    return false if sview_len(annotation.owner) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(annotation.owner)
                    return false if sview_len(annotation.module) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(annotation.module)
                return false if report.source_contracts.source_extern_parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + report.source_contracts.source_extern_parameters.count
                return false if certificate.kernel_goal >= report.analysis_1.kernel.nodes.count
                effect_root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[certificate.kernel_goal]
                return false if:
                    effect_root.kind != "effect-containment" or effect_root.children_start > report.analysis_1.kernel.children.count or effect_root.children_count > report.analysis_1.kernel.children.count - effect_root.children_start
                    not proof_replay_effect_pairwise_work_charge(effect_root.children_count, validation_workspace.source_scan_work_used)
                    effect_root.left >= report.analysis_1.kernel.nodes.count
                declared_row: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[effect_root.left]
                return false if:
                    declared_row.kind != "effect-row" or declared_row.children_start > report.analysis_1.kernel.children.count or declared_row.children_count > report.analysis_1.kernel.children.count - declared_row.children_start
                    declared_row.children_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + declared_row.children_count
                return false if not proof_replay_effect_pairwise_work_charge(declared_row.children_count, validation_workspace.source_scan_work_used)
                declared_member_name_work: mutable usize = 0
                for row_offset in 0..<declared_row.children_count |row_offset, declared_row, report, validation_workspace, declared_member_name_work|:
                    member_index: usize = report.analysis_1.kernel.children[declared_row.children_start + row_offset]
                    return false if member_index >= report.analysis_1.kernel.nodes.count
                    member_name: sview = report.analysis_1.kernel.nodes[member_index].name
                    return false if sview_len(member_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(member_name)
                    return false if sview_len(member_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - declared_member_name_work
                    declared_member_name_work <- declared_member_name_work + sview_len(member_name)
                if declared_row.children_count != 0:
                    return false if declared_row.children_count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used) / 2
                    declared_member_compare_factor: usize = declared_row.children_count * 2
                    return false if declared_member_name_work > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used) / declared_member_compare_factor
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + declared_member_name_work * declared_member_compare_factor
                owner_source = proof_replay_effect_named_declaration(report.source.source_declarations, certificate.name, 0)
                if owner_source.matches == 1:
                    match owner_source.declaration:
                        Ast::Decl.Func(_, owner_parameters, _, _, owner_effects, _, _):
                            return false if:
                                not proof_replay_effect_parameter_defaults_work_charge(owner_parameters, validation_workspace.source_scan_work_used)
                                not proof_replay_effect_names_work_charge(&owner_effects, validation_workspace.source_scan_work_used)
                        _:
                            pass
                for offset in 0..<effect_root.children_count |offset, effect_root, report, validation_workspace|:
                    call_index: usize = report.analysis_1.kernel.children[effect_root.children_start + offset]
                    return false if call_index >= report.analysis_1.kernel.nodes.count
                    call_node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[call_index]
                    return false if sview_len(call_node.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(call_node.name)
                    return false if call_node.left >= report.analysis_1.kernel.nodes.count
                    call_row: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[call_node.left]
                    return false if:
                        call_row.kind != "effect-row" or call_row.children_start > report.analysis_1.kernel.children.count or call_row.children_count > report.analysis_1.kernel.children.count - call_row.children_start
                        call_row.children_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                    validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + call_row.children_count
                    return false if not proof_replay_effect_pairwise_work_charge(call_row.children_count, validation_workspace.source_scan_work_used)
                    call_member_name_work: mutable usize = 0
                    for row_offset in 0..<call_row.children_count |row_offset, call_row, report, validation_workspace, call_member_name_work|:
                        member_index: usize = report.analysis_1.kernel.children[call_row.children_start + row_offset]
                        return false if member_index >= report.analysis_1.kernel.nodes.count
                        member_name: sview = report.analysis_1.kernel.nodes[member_index].name
                        return false if sview_len(member_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                        validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + sview_len(member_name)
                        return false if sview_len(member_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - call_member_name_work
                        call_member_name_work <- call_member_name_work + sview_len(member_name)
                    if call_row.children_count != 0:
                        return false if call_row.children_count > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used) / 2
                        call_member_compare_factor: usize = call_row.children_count * 2
                        return false if call_member_name_work > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used) / call_member_compare_factor
                        validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + call_member_name_work * call_member_compare_factor
                    return false if not proof_replay_deterministic_declaration_scan_charge(report.source.source_declarations, validation_workspace.source_scan_work_used, 0)
                    callee_source = proof_replay_effect_named_declaration(report.source.source_declarations, call_node.name, 0)
                    if callee_source.matches == 1:
                        return false if not proof_replay_effect_annotations_work_charge(&report.source.source_annotations, validation_workspace.source_scan_work_used)
                        match callee_source.declaration:
                            Ast::Decl.Func(_, callee_parameters, _, _, callee_effects, _, _):
                                return false if:
                                    not proof_replay_effect_parameter_defaults_work_charge(callee_parameters, validation_workspace.source_scan_work_used)
                                    not proof_replay_effect_names_work_charge(&callee_effects, validation_workspace.source_scan_work_used)
                                    not proof_replay_summary_owner_source_preflight(report, call_node.name, 0, validation_workspace.source_scan_work_used)
                            Ast::Decl.Extern(_, _, _, _, _, _, _, _):
                                return false if:
                                    not proof_replay_effect_annotations_work_charge(&report.source.source_annotations, validation_workspace.source_scan_work_used)
                                    not proof_replay_effect_annotations_work_charge(&report.source.source_annotations, validation_workspace.source_scan_work_used)
                                    report.source_contracts.source_extern_parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - validation_workspace.source_scan_work_used
                                validation_workspace.source_scan_work_used <- validation_workspace.source_scan_work_used + report.source_contracts.source_extern_parameters.count
                            _:
                                pass
                return false if not proof_replay_effect_source_valid_with_work(&report.source.source_declarations, &report.source.source_annotations, &report.source_contracts.source_extern_parameters, &report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, certificate.kernel_goal, certificate.name, certificate.line, validation_workspace.source_scan_work_used)
            # These public entry points independently admit every fact and the goal's reachable
            # graph. The report pass already admitted the complete arena before replay began;
            # its final pass re-admits any nodes appended by quantifier/rewrite replay. Using the
            # complete-arena entry points here would rescan every unrelated node for every
            # certificate, turning a large report into quadratic work.
            return (ElisaProofKernelReplay::proof_kernel_replay_resource_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, facts, certificate.kernel_goal, validation_workspace) can Global{Read,Write}) if certificate.rule == "resource-safety"
            if certificate.rule == "structural-safety":
                return false if not proof_replay_structural_certificate_source_valid_with_work(report, certificate, validation_workspace.source_scan_work_used, structural_cache)
                return (ElisaProofKernelReplay::proof_kernel_validate_structural_witness_shape_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, facts, certificate.kernel_goal, validation_workspace) can[Global{Read,Write}])
            return (ElisaProofKernelReplay::proof_kernel_replay_effect_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, facts, certificate.kernel_goal, validation_workspace) can[Global{Read,Write}]) if certificate.rule == "effect-containment"
            return (ElisaProofKernelReplay::proof_kernel_replay_checked_index_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, facts, certificate.kernel_goal, validation_workspace) can[Global{Read,Write}]) if certificate.rule == "checked-index"
            return (ElisaProofKernelReplay::proof_kernel_replay_checked_get_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, facts, certificate.kernel_goal, validation_workspace) can[Global{Read,Write}]) if certificate.rule == "checked-get"
            return (ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, "forall", facts, certificate.kernel_goal, validation_workspace) can Global{Read,Write}) if certificate.rule == "quantifier-forall"
            return (ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, "exists", facts, certificate.kernel_goal, validation_workspace) can Global{Read,Write}) if certificate.rule == "quantifier-exists"
            return (ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, report.analysis_1.kernel.nodes[certificate.kernel_goal].operator, facts, certificate.kernel_goal, validation_workspace) can Global{Read,Write}) if report.analysis_1.kernel.nodes[certificate.kernel_goal].kind == "quantifier"
            return (ElisaProofKernelReplay::proof_kernel_replay_goal_report_with_workspace(&report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, facts, certificate.kernel_goal, validation_workspace) can Global{Read,Write})

        def proof_replay_certificate[@r](report: mutable ProofReport& @r, certificate: ProofGoalCertificate, certificate_index: usize, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool can[Global{Read,Write}]:
            dependency_stack: mutable darray[sview] = [certificate.name]
            active_certificates: mutable darray[usize] = []
            structural_cache: mutable ProofReplayStructuralValidationCache = ProofReplayStructuralValidationCache{}
            return (proof_replay_certificate_with_stack(report, certificate, certificate_index, dependency_stack, 0, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})

        def proof_replay_certificate_with_cache[@r](report: mutable ProofReport& @r, certificate: ProofGoalCertificate, certificate_index: usize, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&, structural_cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            dependency_stack: mutable darray[sview] = [certificate.name]
            active_certificates: mutable darray[usize] = []
            return (proof_replay_certificate_with_stack(report, certificate, certificate_index, dependency_stack, 0, active_certificates, validation_workspace, structural_cache) can Global{Read,Write})
