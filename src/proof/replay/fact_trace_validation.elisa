extend ElisaProof:
    private:
        # Fact provenance is keyed by the owner name before exact expression/kernel equality is
        # checked. Hashes only select a probe path; the stored sview comparison remains the
        # authority, so collisions cannot admit a fact for another owner.
        def proof_replay_owner_hash(value: sview) -> u32:
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            for index in 0..<sview_len(value) |index, hash, value|:
                hash <- ((hash ^ sview_at(value, index).i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return hash.u32()

        def proof_replay_trace_index_capacity(count: usize) -> usize:
            return 0 if count == 0
            # The open-addressed table grows geometrically. Reject a count whose next power of
            # two would itself exceed the canonical report bound instead of overflowing or
            # allocating a table larger than the arena budget.
            return 0 if count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET / 2
            capacity: mutable usize = 1
            while capacity < count:
                return 0 if capacity > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET / 2
                capacity <- capacity * 2
            return capacity

        def proof_replay_build_fact_trace_index(report: mutable ProofReport&) -> void:
            count: usize = report.traces.records.count
            sentinel: usize = count
            report.traces.index_hashes.clear()
            report.traces.index_values.clear()
            report.traces.next_indices.clear()
            return if not proof_kernel_report_append_allowed(report, 0, count, "replay-fact-index")
            return if count == 0
            report.traces.next_indices.resize(count)
            index: mutable usize = 0
            while index < count:
                report.traces.next_indices[index] <- sentinel
                index <- index + 1
            capacity: usize = proof_replay_trace_index_capacity(count)
            if capacity == 0:
                proof_kernel_budget_note(report, "replay-fact-index")
                return
            report.traces.index_hashes.resize(capacity)
            report.traces.index_values.resize(capacity)
            slot: mutable usize = 0
            while slot < capacity:
                report.traces.index_values[slot] <- sentinel
                slot <- slot + 1
            index <- 0
            while index < count:
                owner: sview = report.traces.records[index].name
                hash: u32 = proof_replay_owner_hash(owner)
                probe_slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity:
                    current: usize = report.traces.index_values[probe_slot]
                    if current == sentinel:
                        report.traces.index_hashes[probe_slot] <- hash
                        report.traces.index_values[probe_slot] <- index
                        break
                    if report.traces.index_hashes[probe_slot] == hash and report.traces.records[current].name == owner:
                        report.traces.next_indices[index] <- current
                        report.traces.index_values[probe_slot] <- index
                        break
                    probe_slot <- (probe_slot + 1) % capacity
                    probes <- probes + 1
                index <- index + 1

        def proof_replay_fact_trace_head(report: ProofReport&, owner: sview) -> usize:
            count: usize = report.traces.records.count
            capacity: usize = report.traces.index_values.count
            return count if capacity == 0
            # These arrays are an optimization, not authoritative report data. If a caller has
            # mutated one of them independently, abandon the index rather than dereferencing a
            # mismatched hash/next slot and turning malformed input into a replay crash.
            return count if report.traces.index_hashes.count != capacity or report.traces.next_indices.count != count
            hash: u32 = proof_replay_owner_hash(owner)
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity |probes, slot, hash, owner, report, capacity, count|:
                index: usize = report.traces.index_values[slot]
                return count if index >= count
                return index if report.traces.index_hashes[slot] == hash and report.traces.records[index].name == owner
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return count

        # The index is rebuilt internally as a descending linked chain: a newer trace points to
        # an older trace with the same owner, and the sentinel is `count`. Reports are also
        # exposed to revalidation callers, so a mutated link must not become an infinite loop or
        # an out-of-range dereference. Invalid and non-decreasing links terminate the chain; the
        # caller then fails to find the requested provenance rather than trusting malformed data.
        def proof_replay_trace_chain_next(report: ProofReport&, current: usize) -> usize:
            count: usize = report.traces.records.count
            return count if current >= count or current >= report.traces.next_indices.count
            next: usize = report.traces.next_indices[current]
            return count if next >= count or next >= current
            return next

        def proof_replay_fact_trace_is_valid(report: mutable ProofReport&, trace: ProofFactTrace, owner: sview, depth: usize) -> bool:
            dependency_stack: mutable darray[sview] = [owner]
            active_certificates: mutable darray[usize] = []
            validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            return proof_replay_fact_trace_is_valid_with_stack(report, trace, owner, depth, dependency_stack, active_certificates, validation_workspace)

        def proof_replay_fact_is_traced_with_stack(report: mutable ProofReport&, fact: Ast::Expr, owner: sview, dependency_stack: darray[sview]&, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            trace_index: mutable usize = proof_replay_fact_trace_head(report, owner)
            while trace_index < report.traces.records.count |trace_index, report, fact, owner, dependency_stack, active_certificates, validation_workspace|:
                trace: ProofFactTrace = report.traces.records[trace_index]
                return true if proof_replay_expr_equal(trace.expression, fact) and proof_replay_fact_trace_is_valid_with_stack(report, trace, owner, 0, dependency_stack, active_certificates, validation_workspace)
                trace_index <- proof_replay_trace_chain_next(report, trace_index)
            return false

        def proof_replay_fact_is_traced(report: mutable ProofReport&, fact: Ast::Expr, owner: sview) -> bool:
            dependency_stack: mutable darray[sview] = [owner]
            active_certificates: mutable darray[usize] = []
            validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace = ElisaProofKernelReplay::proof_kernel_replay_validation_workspace_new()
            return proof_replay_fact_is_traced_with_stack(report, fact, owner, dependency_stack, active_certificates, validation_workspace)

        # Certificates are not standalone propositions: each one must be the exact root emitted
        # for a successful goal attempt. Check both source-level fields and arena ranges before
        # replaying the logical claim. This prevents a future serialized certificate from
        # attaching an otherwise replayable root to an unrelated or fabricated obligation.
        # This check is read-only and inspects a report-owned attempt containing mutable
        # bookkeeping plus an arena-backed AST handle. Borrow the exact attempt rather than
        # materializing a second record copy at the replay trust boundary.
        def proof_replay_attempt_matches_certificate(report: ProofReport&, attempt: ProofGoalAttempt&, certificate: ProofGoalCertificate, certificate_index: usize) -> bool:
            return false if not attempt.proven or not attempt.has_certificate or attempt.certificate_index != certificate_index
            return false if attempt.facts_start != certificate.facts_start or attempt.facts_count != certificate.facts_count
            return false if attempt.kernel_goal != certificate.kernel_goal or attempt.kernel_facts_start != certificate.kernel_facts_start or attempt.kernel_facts_count != certificate.kernel_facts_count
            return false if attempt.line != certificate.line or attempt.name != certificate.name or attempt.rule != certificate.rule
            # The source AST is presentation data, but it must still describe this same root.
            # Otherwise a mutated report could display one goal while pointing at another
            # replayed certificate.
            if certificate.rule == "resource-safety" or certificate.rule == "structural-safety" or certificate.rule == "effect-containment" or certificate.rule == "frame-spec" or certificate.rule == "frame-allow" or certificate.rule == "frame-preserve":
                return false if not proof_replay_expr_equal(attempt.goal, certificate.goal)
                match attempt.goal:
                    Ast::Expr.BoolLit(value, _):
                        return value
                    _:
                        return false
            return proof_replay_ast_matches_kernel(report, attempt.goal, certificate.kernel_goal, 0)

        def proof_replay_certificate_root_is_proven(report: ProofReport&, certificate: ProofGoalCertificate, certificate_index: usize) -> bool:
            return false if certificate.facts_start > report.certificate_facts.count or certificate.facts_count > report.certificate_facts.count - certificate.facts_start
            for attempt in report.goal_attempts:
                return true if proof_replay_attempt_matches_certificate(report, attempt, certificate, certificate_index)
            return false

        def proof_replay_certificate_with_stack[@r](report: mutable ProofReport& @r, certificate: ProofGoalCertificate, certificate_index: usize, dependency_stack: darray[sview]&, dependency_depth: usize, active_certificates: darray[usize]&, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            # A dependency that already passed its own full replay in this batch is not re-walked
            # per call path: chained summaries would otherwise revalidate it once per path, which
            # is exponential in the chain length. `proof_replay_certificates` clears every flag
            # first and sets one only after that certificate's complete check, and the batch still
            # requires every certificate to replay, so nothing is admitted that is not also
            # validated on its own.
            return true if dependency_depth > 0 and certificate_index < report.certificates.count and report.certificates[certificate_index].replayed
            return false if not proof_replay_certificate_rule_valid(certificate.rule)
            return false if proof_replay_certificate_in_stack(active_certificates, certificate_index)
            return false if not report.kernel.arena_validated
            return false if not proof_replay_certificate_root_is_proven(report, certificate, certificate_index)
            return false if certificate.kernel_facts_start > report.kernel.certificate_facts.count or certificate.kernel_facts_count > report.kernel.certificate_facts.count - certificate.kernel_facts_start
            return false if certificate.kernel_goal >= report.kernel.nodes.count
            return false if certificate.facts_count != certificate.kernel_facts_count
            return false if certificate.facts_start > report.traces.origin_indices.count or certificate.facts_count > report.traces.origin_indices.count - certificate.facts_start
            next_active_certificates: mutable darray[usize] = []
            next_active_certificates.extend(active_certificates)
            next_active_certificates.push(certificate_index)
            if certificate.rule != "resource-safety" and certificate.rule != "structural-safety" and certificate.rule != "effect-containment":
                return false if not proof_replay_ast_matches_kernel(report, certificate.goal, certificate.kernel_goal, 0)
            for index in 0..<certificate.facts_count |index, report, certificate|:
                source_fact: Ast::Expr = report.certificate_facts[certificate.facts_start + index]
                kernel_fact: usize = report.kernel.certificate_facts[certificate.kernel_facts_start + index]
                return false if not proof_replay_ast_matches_kernel(report, source_fact, kernel_fact, 0)
            facts: mutable darray[usize] = []
            saved_owner_line: u32 = report.replay_owner_line
            saved_consumer_line: u32 = report.trace_owner_line
            saved_consumer_certificate: usize = report.trace_consumer_certificate_index
            owner_line: mutable u32 = 0
            proof_replay_owner_function_line(report.source_declarations, certificate.name, certificate.line, &owner_line, 0)
            # An unidentified owner gets a line no declaration has, so stamped constants never apply.
            report.replay_owner_line <- owner_line if owner_line != 0 else 4294967295
            report.trace_owner_line <- certificate.line
            report.trace_consumer_certificate_index <- certificate_index + 1
            for index in 0..<certificate.kernel_facts_count |index, facts, report, certificate, dependency_stack, next_active_certificates, validation_workspace|:
                fact: usize = report.kernel.certificate_facts[certificate.kernel_facts_start + index]
                return false if fact >= report.kernel.nodes.count
                trace_index: usize = report.traces.origin_indices[certificate.facts_start + index]
                if trace_index < report.traces.records.count:
                    trace: ProofFactTrace = report.traces.records[trace_index]
                    continue if trace.kind == "local-binding" and not proof_replay_local_binding_fact_live(report, trace)
                # A certificate may serialize premises whose source provenance this replay
                # deliberately does not support. They are not trusted: omit them and let the
                # kernel determine whether the remaining validated facts suffice. Rejecting the
                # whole certificate here would turn an unused opaque premise into a replay gap.
                continue if not proof_replay_kernel_fact_root_is_traced_with_stack(report, fact, certificate.name, dependency_stack, false, next_active_certificates, validation_workspace)
                facts.push(fact)
            report.replay_owner_line <- saved_owner_line
            report.trace_owner_line <- saved_consumer_line
            report.trace_consumer_certificate_index <- saved_consumer_certificate
            return false if certificate.rule == "resource-safety" and not proof_replay_resource_event_facts_with_owner(report, certificate.kernel_goal, certificate.name, dependency_stack, 0, next_active_certificates, validation_workspace)
            if certificate.rule == "effect-containment":
                return false if not proof_replay_effect_source_valid(&report.source_declarations, &report.source_annotations, &report.source_extern_parameters, &report.kernel.nodes, &report.kernel.children, certificate.kernel_goal, certificate.name, certificate.line)
            # These public entry points independently admit every fact and the goal's reachable
            # graph. The report pass already admitted the complete arena before replay began;
            # its final pass re-admits any nodes appended by quantifier/rewrite replay. Using the
            # complete-arena entry points here would rescan every unrelated node for every
            # certificate, turning a large report into quadratic work.
            return ElisaProofKernelReplay::proof_kernel_replay_resource_report_with_workspace(&report.kernel.nodes, &report.kernel.children, facts, certificate.kernel_goal, validation_workspace) if certificate.rule == "resource-safety"
            return ElisaProofKernelReplay::proof_kernel_replay_structural_report_with_workspace(&report.kernel.nodes, &report.kernel.children, facts, certificate.kernel_goal, validation_workspace) if certificate.rule == "structural-safety"
            return ElisaProofKernelReplay::proof_kernel_replay_effect_report_with_workspace(&report.kernel.nodes, &report.kernel.children, facts, certificate.kernel_goal, validation_workspace) if certificate.rule == "effect-containment"
            return ElisaProofKernelReplay::proof_kernel_replay_checked_index_report_with_workspace(&report.kernel.nodes, &report.kernel.children, facts, certificate.kernel_goal, validation_workspace) if certificate.rule == "checked-index"
            return ElisaProofKernelReplay::proof_kernel_replay_checked_get_report_with_workspace(&report.kernel.nodes, &report.kernel.children, facts, certificate.kernel_goal, validation_workspace) if certificate.rule == "checked-get"
            return ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_with_workspace(&report.kernel.nodes, &report.kernel.children, "forall", facts, certificate.kernel_goal, validation_workspace) if certificate.rule == "quantifier-forall"
            return ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_with_workspace(&report.kernel.nodes, &report.kernel.children, "exists", facts, certificate.kernel_goal, validation_workspace) if certificate.rule == "quantifier-exists"
            return ElisaProofKernelReplay::proof_kernel_replay_quantifier_report_with_workspace(&report.kernel.nodes, &report.kernel.children, report.kernel.nodes[certificate.kernel_goal].operator, facts, certificate.kernel_goal, validation_workspace) if report.kernel.nodes[certificate.kernel_goal].kind == "quantifier"
            return ElisaProofKernelReplay::proof_kernel_replay_goal_report_with_workspace(&report.kernel.nodes, &report.kernel.children, facts, certificate.kernel_goal, validation_workspace)

        def proof_replay_certificate[@r](report: mutable ProofReport& @r, certificate: ProofGoalCertificate, certificate_index: usize, validation_workspace: mutable ElisaProofKernelReplay::ProofKernelReplayValidationWorkspace&) -> bool:
            dependency_stack: mutable darray[sview] = [certificate.name]
            active_certificates: mutable darray[usize] = []
            return proof_replay_certificate_with_stack(report, certificate, certificate_index, dependency_stack, 0, active_certificates, validation_workspace)
