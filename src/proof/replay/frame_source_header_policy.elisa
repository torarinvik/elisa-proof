extend ElisaProofFrameSource:
    private:
        def signature_clause(word: sview) -> bool:
            return when word:
                "can" | "requires" | "require" | "ensures" | "ensure" | "fulfills" | "changes" | "preserves" | "decreases" | "invariant" | "uses" | "raises" | "where" | "at" | "abi" -> true
                _ -> false

        def frame_policy_present_at_position(name: sview, position: Ast::Pos, body: darray[Ast::Stmt]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, present: bool) can[Memory.Allocate, Abort.Panic]:
            body_present: mutable bool = false
            for statement in body |statement, body_present, work|:
                return (false, false) if not replay_work_charge(1, work)
                match statement:
                    Ast::Stmt.Contract(kind, _, _):
                        return (false, false) if not replay_work_charge(sview_len(kind), work)
                        body_present <- true if kind == "changes" or kind == "preserves"
                    _:
                        pass
            definition: (known: bool, found: bool, token_index: usize) = source_def_token_at_position(position, tokens, source, source_length, work)
            return (false, false) if not definition.known
            return (false, false) if not definition.found and body_present
            return (true, false) if not definition.found
            bounds = header_bounds_at_position(name, position, tokens, source, source_length, work)
            return (false, false) if not bounds.known
            depth: mutable usize = 0
            for index in (bounds.start + 2)..<bounds.end |index, bounds, depth, tokens, source, work|:
                return (false, false) if not replay_work_charge(1, work)
                token: Lexer::Token = tokens[index]
                if token.kind == TokenKind.LParen or token.kind == TokenKind.LBracket or token.kind == TokenKind.LBrace:
                    depth <- depth + 1
                elif token.kind == TokenKind.RParen or token.kind == TokenKind.RBracket or token.kind == TokenKind.RBrace:
                    return (false, false) if depth == 0
                    depth <- depth - 1
                elif depth == 0 and token.kind == TokenKind.Ident:
                    return (false, false) if not replay_work_charge(token.length.usize(), work)
                    word: sview = Lexer::text_or_empty(token, source)
                    preceding_selector: bool = index > bounds.start and (tokens[index - 1].kind == TokenKind.Dot or tokens[index - 1].kind == TokenKind.Scope)
                    return (true, true) if not preceding_selector and word in {"changes", "preserves"}
            return (true, body_present)

        def header_target(tokens: darray[Lexer::Token]&, source: u8&, index: usize, end: usize, formals: darray[sview]&, work: mutable usize&) -> (known: bool, place: ElisaProofKernelFramePolicy::Place, next: usize, position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            empty: ElisaProofKernelFramePolicy::Place = ElisaProofKernelFramePolicy::Place{parameter: 0, depth: 0, field: "", field2: "", field3: ""}
            return (false, empty, 0, Ast::pos_at_line(0)) if:
                index >= end or tokens[index].kind != TokenKind.Ident
                not replay_work_charge(tokens[index].length.usize(), work)
            root = Lexer::text_or_empty(tokens[index], source)
            return (false, empty, 0, Ast::pos_at_line(0)) if signature_clause(root)
            position: mutable Ast::Pos = Ast::pos_of_token(tokens[index])
            expression: mutable Ast::Expr = Ast::Expr.Ident(root, position)
            next: mutable usize = index + 1
            depth: mutable usize = 0
            while next < end and tokens[next].kind == TokenKind.Dot |next, depth, expression, position, tokens, source, end|:
                return (false, empty, 0, Ast::pos_at_line(0)) if:
                    depth >= 3 or end - next < 2 or tokens[next + 1].kind != TokenKind.Ident
                    not replay_work_charge(2, work)
                    not replay_work_charge(tokens[next + 1].length.usize(), work)
                field = Lexer::text_or_empty(tokens[next + 1], source)
                expression <- Ast::Expr.Field(expression, field, position)
                last = Ast::pos_of_token(tokens[next + 1])
                position.end_line <- last.end_line
                position.end_column <- last.end_column
                position.end_offset <- last.end_offset
                depth <- depth + 1
                next <- next + 2
            decoded = place_with_work(expression, formals, work)
            return (decoded.known, decoded.place, next, position)

    public:
        def header_policy(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            work: mutable usize = 0
            return header_policy_with_work(declarations, name, line, tokens, source, source_length, &work)

        def header_policy_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            bounds = header_bounds_with_work(declarations, name, line, tokens, source, source_length, work)
            context = owner_with_work(declarations, name, line, work)
            return header_policy_for_context(name, bounds, context, tokens, source, source_length, work)

        def header_policy_at_offset_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, offset: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            context = owner_at_offset_with_work(declarations, name, line, offset, work)
            return (false, 0, []) if not context.known
            bounds = header_bounds_at_position(name, context.position, tokens, source, source_length, work)
            return header_policy_for_context(name, bounds, context, tokens, source, source_length, work)

    private:
        def header_policy_for_context(name: sview, bounds: (known: bool, start: usize, end: usize), context: (known: bool, formals: darray[sview], body: darray[Ast::Stmt], position: Ast::Pos, formal_types: darray[Ast::Expr], return_type: Ast::Expr), tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            return (false, 0, []) if not bounds.known or not context.known
            clauses: mutable darray[Clause] = []
            index: mutable usize = bounds.start + 2
            depth: mutable usize = 0
            return (false, 0, []) if not replay_work_charge(bounds.end - index, work)
            while index < bounds.end |index, depth, clauses, bounds, tokens, source, context, work|:
                token = tokens[index]
                if token.kind == TokenKind.LParen or token.kind == TokenKind.LBracket or token.kind == TokenKind.LBrace:
                    depth <- depth + 1
                elif token.kind == TokenKind.RParen or token.kind == TokenKind.RBracket or token.kind == TokenKind.RBrace:
                    return (false, 0, []) if depth == 0
                    depth <- depth - 1
                elif depth == 0 and token.kind == TokenKind.Ident:
                    return (false, 0, []) if not replay_work_charge(token.length.usize(), work)
                    kind = Lexer::text_or_empty(token, source)
                    preceding_selector: bool = index > bounds.start and (tokens[index - 1].kind == TokenKind.Dot or tokens[index - 1].kind == TokenKind.Scope)
                    if not preceding_selector and (kind in {"changes", "preserves"}):
                        index <- index + 1
                        while true |index, clauses, bounds, tokens, source, context, kind, work|:
                            return (false, 0, []) if clauses.count >= 64
                            target = header_target(tokens, source, index, bounds.end, &context.formals, work)
                            return (false, 0, []) if not target.known
                            clauses.push(Clause{kind: kind, place: target.place, position: target.position})
                            index <- target.next
                            break if index >= bounds.end or tokens[index].kind != TokenKind.Comma
                            index <- index + 1
                        if index < bounds.end:
                            return (false, 0, []) if tokens[index].kind != TokenKind.Ident or not signature_clause(Lexer::text_or_empty(tokens[index], source))
                        continue
                index <- index + 1
            return (true, context.formals.count, clauses)

    public:
        def source_policy(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            work: mutable usize = 0
            return source_policy_with_work(declarations, name, line, tokens, source, source_length, &work)

        def source_policy_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            header = header_policy_with_work(declarations, name, line, tokens, source, source_length, work)
            body = body_policy_with_work(declarations, name, line, work)
            return combine_source_policy(header, body, work)

        def source_policy_at_offset_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, offset: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            header = header_policy_at_offset_with_work(declarations, name, line, offset, tokens, source, source_length, work)
            body = body_policy_at_offset_with_work(declarations, name, line, offset, work)
            return combine_source_policy(header, body, work)

    private:
        def combine_source_policy(header: (known: bool, parameter_count: usize, clauses: darray[Clause]), body: (known: bool, parameter_count: usize, clauses: darray[Clause]), work: mutable usize&) -> (known: bool, parameter_count: usize, clauses: darray[Clause]) can[Memory.Allocate, Abort.Panic]:
            return (false, 0, []) if not header.known
            return (false, 0, []) if not body.known or body.parameter_count != header.parameter_count
            clauses: mutable darray[Clause] = []
            changes: mutable usize = 0
            preserves: mutable usize = 0
            return (false, 0, []) if:
                not replay_work_charge(header.clauses.count, work)
                not replay_work_charge(body.clauses.count, work)
            for clause in header.clauses |clauses, changes, preserves, work|:
                return (false, 0, []) if not replay_work_charge(sview_len(clause.kind), work)
                changes <- changes + 1 if clause.kind == "changes"
                preserves <- preserves + 1 if clause.kind == "preserves"
                return (false, 0, []) if changes > 64 or preserves > 64
                clauses.push(clause)
            for clause in body.clauses |clauses, changes, preserves, work|:
                return (false, 0, []) if not replay_work_charge(sview_len(clause.kind), work)
                changes <- changes + 1 if clause.kind == "changes"
                preserves <- preserves + 1 if clause.kind == "preserves"
                return (false, 0, []) if changes > 64 or preserves > 64
                clauses.push(clause)
            return (true, header.parameter_count, clauses)
