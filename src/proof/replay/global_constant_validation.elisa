# Independent replay validation for literal integer constants. This deliberately does not call the
# producer's importer: the replay boundary must derive the same binding from the source report
# with a separate implementation, including module scope and shadowing.
extend ElisaProof:
    private:
        const PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT: usize = 127

        def proof_replay_global_constant_scope_equal(left: darray[sview]&, right: darray[sview]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |index, left, right|:
                return false if left[index] != right[index]
            return true

        # A literal constant replays only for a supported integer type whose source initializer is the
        # expected value: a u8 literal must fit the byte range, and a negated literal is accepted only
        # for i64 with a magnitude that is representable before negation.
        def proof_replay_global_constant_initializer_matches(candidate_type: Ast::Expr, candidate_initializer: Ast::Expr, expected_value: i64) -> bool:
            type_name: sview = match candidate_type:
                Ast::Expr.Ident(name, _): name
                _: ""
            return false if type_name != "i64" and type_name != "usize" and type_name != "u8" and type_name != "u64"
            match candidate_initializer:
                Ast::Expr.IntLit(candidate_value, _):
                    return false if type_name == "u64" and candidate_value < 0
                    return candidate_value == expected_value and (type_name != "u8" or (candidate_value >= 0 and candidate_value <= 255))
                Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(magnitude, _), _):
                    return type_name == "i64" and magnitude >= 0 and expected_value == 0 - magnitude
                _:
                    return false

        def proof_replay_global_constant_lookup(declarations: darray[Ast::Decl]&, wanted_scope: darray[sview]&, current_scope: darray[sview]&, constant_name: sview, constant_line: u32, expected_value: i64, visible: mutable bool&, valid: mutable bool&, matches: mutable usize&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT
            in_scope: bool = proof_replay_global_constant_scope_equal(wanted_scope, current_scope)
            for declaration in declarations |wanted_scope, current_scope, constant_name, constant_line, expected_value, visible, valid, matches, depth, in_scope|:
                match declaration:
                    Ast::Decl.Const(candidate_name, candidate_type, candidate_initializer, candidate_mutable, candidate_position):
                        if in_scope and candidate_name == constant_name:
                            visible <- true
                            matches <- matches + 1
                            valid <- false
                            if not candidate_mutable and candidate_position.line == constant_line:
                                valid <- proof_replay_global_constant_initializer_matches(candidate_type, candidate_initializer, expected_value)
                    Ast::Decl.Module(module_name, body, _):
                        next_scope: mutable darray[sview] = []
                        next_scope.extend(current_scope)
                        next_scope.push(module_name)
                        proof_replay_global_constant_lookup(body, wanted_scope, &next_scope, constant_name, constant_line, expected_value, visible, valid, matches, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_global_constant_lookup(body, wanted_scope, current_scope, constant_name, constant_line, expected_value, visible, valid, matches, depth + 1)
                    _:
                        pass

        def proof_replay_global_constant_resolves(declarations: darray[Ast::Decl]&, function_scope: darray[sview]&, parameters: darray[Ast::ParamDecl]&, constant_name: sview, constant_line: u32, expected_value: i64) -> bool:
            return false if any parameter in parameters where parameter.name == constant_name
            local_visible: mutable bool = false
            local_valid: mutable bool = false
            local_matches: mutable usize = 0
            empty_scope: mutable darray[sview] = []
            proof_replay_global_constant_lookup(declarations, function_scope, &empty_scope, constant_name, constant_line, expected_value, &local_visible, &local_valid, &local_matches, 0)
            return local_matches == 1 and local_valid if local_visible
            return false if function_scope.count == 0
            root_visible: mutable bool = false
            root_valid: mutable bool = false
            root_matches: mutable usize = 0
            proof_replay_global_constant_lookup(declarations, &empty_scope, &empty_scope, constant_name, constant_line, expected_value, &root_visible, &root_valid, &root_matches, 0)
            root_matches == 1 and root_valid

        def proof_replay_global_constant_find_candidates(declarations: darray[Ast::Decl]&, all_declarations: darray[Ast::Decl]&, function_name: sview, constant_name: sview, constant_line: u32, expected_value: i64, current_scope: darray[sview]&, function_matches: mutable usize&, candidates: mutable usize&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT
            for declaration in declarations |declarations, all_declarations, function_name, constant_name, constant_line, expected_value, current_scope, function_matches, candidates, depth|:
                match declaration:
                    Ast::Decl.Func(candidate_name, parameters, _, _, _, _, _):
                        if candidate_name == function_name:
                            function_matches <- function_matches + 1
                            candidates <- candidates + 1 if proof_replay_global_constant_resolves(all_declarations, current_scope, parameters, constant_name, constant_line, expected_value)
                    Ast::Decl.Module(module_name, body, _):
                        next_scope: mutable darray[sview] = []
                        next_scope.extend(current_scope)
                        next_scope.push(module_name)
                        proof_replay_global_constant_find_candidates(body, all_declarations, function_name, constant_name, constant_line, expected_value, &next_scope, function_matches, candidates, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_global_constant_find_candidates(body, all_declarations, function_name, constant_name, constant_line, expected_value, current_scope, function_matches, candidates, depth + 1)
                    _:
                        pass

        def proof_replay_qualified_path(expression: Ast::Expr, path: mutable darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    path.push(name)
                    return true
                Ast::Expr.Scope(base, leaf, _):
                    return false if not proof_replay_qualified_path(base, path, depth + 1)
                    path.push(leaf)
                    return true
                _:
                    return false

        # The parser may record a nested module under its qualified spelling (`Outer::{name}`),
        # so a declared name matches when it is `name` or ends in `::name`.
        def proof_replay_qualified_segment_matches(declared: sview, name: sview) -> bool:
            return true if declared == name
            declared_length: usize = sview_len(declared)
            name_length: usize = sview_len(name)
            return false if name_length == 0 or declared_length < name_length + 2
            start: usize = declared_length - name_length
            return false if sview_at(declared, start - 1) != 58 or sview_at(declared, start - 2) != 58
            for offset in 0..<name_length |offset, declared, name, start|:
                return false if sview_at(declared, start + offset) != sview_at(name, offset)
            return true

        # Independent of the producer: a module, enum or struct named `name` below the root.
        def proof_replay_nested_namespace(declarations: darray[Ast::Decl]&, name: sview, nested: bool, depth: usize) -> bool:
            return true if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT
            for declaration in declarations |name, nested, depth|:
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        return true if ((nested or module_name != name) and proof_replay_qualified_segment_matches(module_name, name)) or proof_replay_nested_namespace(body, name, true, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return true if proof_replay_nested_namespace(body, name, nested, depth + 1)
                    Ast::Decl.Enum(enum_name, _, _, _, _):
                        return true if (nested or enum_name != name) and proof_replay_qualified_segment_matches(enum_name, name)
                    Ast::Decl.Struct(struct_name, _, _, _, _, _, _):
                        return true if (nested or struct_name != name) and proof_replay_qualified_segment_matches(struct_name, name)
                    _:
                        pass
            return false

        # A qualified constant resolves from the root for the sole function of its name with no
        # parameter spelled like the path's first segment, when that function is at the root or
        # the segment names no nested namespace that could be nearer.
        # A function inside a module counts only when `first` names no nested namespace.
        def proof_replay_qualified_function_count(declarations: darray[Ast::Decl]&, function_name: sview, first: sview, in_module: bool, shadowable: bool, total: mutable usize&, rooted: mutable usize&, depth: usize) -> void:
            return if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT
            for declaration in declarations |function_name, first, in_module, shadowable, total, rooted, depth|:
                match declaration:
                    Ast::Decl.Func(candidate_name, parameters, _, _, _, _, _):
                        if candidate_name == function_name:
                            total <- total + 1
                            rooted <- rooted + 1 if (in_module == false or shadowable == false) and not (any parameter in parameters where parameter.name == first)
                    Ast::Decl.Module(_, body, _):
                        proof_replay_qualified_function_count(body, function_name, first, true, shadowable, total, rooted, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_qualified_function_count(body, function_name, first, in_module, shadowable, total, rooted, depth + 1)
                    _:
                        pass

        def proof_replay_qualified_constant_fact_is_valid(report: ProofReport&, trace: ProofFactTrace, path: darray[sview]&, expected_value: i64) -> bool:
            return false if path.count < 2
            total: mutable usize = 0
            rooted: mutable usize = 0
            shadowable: bool = proof_replay_nested_namespace(report.source_declarations, path[0], false, 0)
            proof_replay_qualified_function_count(report.source_declarations, trace.name, path[0], false, shadowable, &total, &rooted, 0)
            return false if total != 1 or rooted != 1
            wanted_scope: mutable darray[sview] = []
            for index in 0..<path.count - 1 |index, path, wanted_scope|:
                wanted_scope.push(path[index])
            empty_scope: mutable darray[sview] = []
            visible: mutable bool = false
            valid: mutable bool = false
            matches: mutable usize = 0
            proof_replay_global_constant_lookup(report.source_declarations, &wanted_scope, &empty_scope, path[path.count - 1], trace.line, expected_value, &visible, &valid, &matches, 0)
            return matches == 1 and valid

        def proof_replay_global_constant_fact_is_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            match trace.expression:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    qualified_path: mutable darray[sview] = []
                    qualified_left: bool = match left:
                        Ast::Expr.Scope(_, _, _): proof_replay_qualified_path(left, &qualified_path, 0)
                        _: false
                    if qualified_left:
                        qualified_value: i64 = match right:
                            Ast::Expr.IntLit(value, _): value
                            _: 0
                        qualified_literal: bool = match right:
                            Ast::Expr.IntLit(_, _): true
                            _: false
                        return qualified_literal and proof_replay_qualified_constant_fact_is_valid(report, trace, &qualified_path, qualified_value)
                    constant_name: sview = match left:
                        Ast::Expr.Ident(name, _): name
                        _: ""
                    expected_value: i64 = match right:
                        Ast::Expr.IntLit(value, _): value
                        _: 0
                    return false if constant_name == ""
                    value_is_literal: bool = match right:
                        Ast::Expr.IntLit(_, _): true
                        _: false
                    return false if not value_is_literal
                    function_matches: mutable usize = 0
                    candidates: mutable usize = 0
                    root_scope: mutable darray[sview] = []
                    proof_replay_global_constant_find_candidates(report.source_declarations, report.source_declarations, trace.name, constant_name, trace.line, expected_value, &root_scope, &function_matches, &candidates, 0)
                    function_matches == 1 and candidates == 1
                _:
                    false
