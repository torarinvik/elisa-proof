# Independent replay validation for literal integer constants. This deliberately does not call the
# producer's importer: the replay boundary must derive the same binding from the source report
# with a separate implementation, including module scope and shadowing.
extend ElisaProof:
    private:
        const PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT: usize = 127

        def proof_replay_global_constant_work_charge(amount: usize, work: mutable usize&) -> bool:
            if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            work <- work + amount
            return true

        def proof_replay_global_constant_text_equal_with_work(left: sview, right: sview, work: mutable usize&) -> (equal: bool, complete: bool):
            return (false, false) if:
                not proof_replay_global_constant_work_charge(1, work)
                not proof_replay_global_constant_work_charge(sview_len(left), work)
                not proof_replay_global_constant_work_charge(sview_len(right), work)
            (left == right, true)

        # Decode only literal source spellings. Source lookup below independently
        # checks the declaration's type, initializer, scope and owner.
        def proof_replay_global_constant_fact_value(expression: Ast::Expr) -> (known: bool, value: i64):
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (true, value)
                Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(magnitude, _), _):
                    return (true, 0 - magnitude) if magnitude >= 0
                _:
                    pass
            return (false, 0)

        def proof_replay_global_constant_scope_equal_with_work(left: darray[sview]&, right: darray[sview]&, work: mutable usize&) -> (equal: bool, complete: bool):
            return (false, false) if:
                not proof_replay_global_constant_work_charge(left.count, work)
                not proof_replay_global_constant_work_charge(right.count, work)
            return (false, true) if left.count != right.count
            for index in 0..<left.count |index, left, right, work|:
                comparison = proof_replay_global_constant_text_equal_with_work(left[index], right[index], work)
                return (false, false) if not comparison.complete
                return (false, true) if not comparison.equal
            (true, true)

        # Independently canonicalize module names: qualified spellings are
        # complete paths, even when they partly overlap the current scope;
        # bare spellings are relative to the current AST traversal.
        def proof_replay_global_constant_scope_with_module(current: darray[sview]&, module_name: sview) -> darray[sview]:
            segments: mutable darray[sview] = []
            module_length: usize = sview_len(module_name)
            segment_start: mutable usize = 0
            qualified: mutable bool = false
            for cursor in 0..<module_length |cursor, module_name, segment_start, segments|:
                if module_name[cursor] == 58 and cursor + 1 < module_length and module_name[cursor + 1] == 58:
                    segments.push(string_view_prefix(string_view_suffix(module_name, segment_start.i64()), (cursor - segment_start).i64()))
                    segment_start <- cursor + 2
                    qualified <- true
            if segment_start < module_length:
                segments.push(string_view_suffix(module_name, segment_start.i64()))
            return segments if qualified
            normalized: mutable darray[sview] = []
            normalized.extend(current)
            normalized.extend(segments)
            return normalized

        def proof_replay_global_constant_scope_with_module_and_work(current: darray[sview]&, module_name: sview, work: mutable usize&) -> (complete: bool, scope: darray[sview]):
            return (false, []) if not proof_replay_global_constant_work_charge(current.count, work)
            module_bytes: usize = sview_len(module_name)
            # The splitter reads each byte once and peeks one byte ahead when it
            # encounters a colon. Reserve three reads per byte for the worst case.
            if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return (false, [])
            if module_bytes > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work) / 3:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return (false, [])
            return (false, []) if not proof_replay_global_constant_work_charge(module_bytes * 3, work)
            (true, proof_replay_global_constant_scope_with_module(current, module_name))

        # A literal constant replays only for a supported integer type whose source initializer is the
        # expected value: a u8 literal must fit the byte range, and a negated literal is accepted only
        # for i64 with a magnitude that is representable before negation.
        def proof_replay_global_constant_initializer_matches_with_work(candidate_type: Ast::Expr, candidate_initializer: Ast::Expr, expected_value: i64, work: mutable usize&) -> bool:
            type_name: sview = match candidate_type:
                Ast::Expr.Ident(name, _): name
                _: ""
            return false if not proof_replay_global_constant_work_charge(sview_len(type_name), work)
            # The legacy classifier compares this spelling against several builtin names, so
            # reserve the repeated identifier reads before those comparisons.
            return false if:
                not proof_replay_summary_expr_repeat_charge_with_work(candidate_type, 8, work)
                not proof_replay_summary_expr_repeat_charge_with_work(candidate_initializer, 0, work)
                type_name != "i64" and type_name != "usize" and type_name != "u8" and type_name != "u64" and type_name != "u32"
            match candidate_initializer:
                Ast::Expr.IntLit(candidate_value, _):
                    return false if type_name == "u64" and candidate_value < 0
                    # The producer keeps a negative usize payload as type-only evidence because
                    # the signed i64 AST pin cannot distinguish a negative value from a
                    # high-bit unsigned machine word. Replay must not turn it into a scalar fact.
                    return false if:
                        type_name == "usize" and candidate_value < 0
                        type_name == "u32" and (candidate_value < 0 or candidate_value > 4294967295)
                    return candidate_value == expected_value and (type_name != "u8" or (candidate_value >= 0 and candidate_value <= 255))
                Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(magnitude, _), _):
                    return type_name == "i64" and magnitude >= 0 and expected_value == 0 - magnitude
                _:
                    return false

        def proof_replay_global_constant_scope_path_matches_with_work(expression: Ast::Expr, expected_scope: darray[sview]&, last_index: usize, work: mutable usize&, depth: usize) -> (matches: bool, complete: bool):
            return (false, false) if not proof_replay_global_constant_work_charge(1, work)
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return (false, false)
            return (false, true) if last_index >= expected_scope.count
            if last_index == 0:
                match expression:
                    Ast::Expr.Ident(name, _):
                        comparison = proof_replay_global_constant_text_equal_with_work(name, expected_scope[0], work)
                        return (false, false) if not comparison.complete
                        return (comparison.equal, true)
                    _:
                        return (false, true)
            match expression:
                Ast::Expr.Scope(base, name, _):
                    comparison = proof_replay_global_constant_text_equal_with_work(name, expected_scope[last_index], work)
                    return (false, false) if not comparison.complete
                    return (false, true) if not comparison.equal
                    proof_replay_global_constant_scope_path_matches_with_work(base, expected_scope, last_index - 1, work, depth + 1)
                _:
                    return (false, true)

        def proof_replay_global_constant_qualified_reference_matches_with_work(expression: Ast::Expr, expected_scope: darray[sview]&, constant_name: sview, work: mutable usize&) -> (matches: bool, complete: bool):
            return (false, true) if expected_scope.count == 0
            match expression:
                Ast::Expr.Scope(base, name, _):
                    comparison = proof_replay_global_constant_text_equal_with_work(name, constant_name, work)
                    return (false, false) if not comparison.complete
                    return (false, true) if not comparison.equal
                    proof_replay_global_constant_scope_path_matches_with_work(base, expected_scope, expected_scope.count - 1, work, 0)
                _:
                    return (false, true)

        def proof_replay_global_constant_lookup_with_work(declarations: darray[Ast::Decl]&, wanted_scope: darray[sview]&, current_scope: darray[sview]&, constant_name: sview, constant_line: u32, expected_value: i64, visible: mutable bool&, valid: mutable bool&, matches: mutable usize&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return
            scope_comparison = proof_replay_global_constant_scope_equal_with_work(wanted_scope, current_scope, work)
            return if not scope_comparison.complete
            in_scope: bool = scope_comparison.equal
            for declaration in declarations |wanted_scope, current_scope, constant_name, constant_line, expected_value, visible, valid, matches, work, depth, in_scope|:
                return if not proof_replay_global_constant_work_charge(1, work)
                match declaration:
                    Ast::Decl.Const(candidate_name, candidate_type, candidate_initializer, candidate_mutable, candidate_position):
                        comparison = proof_replay_global_constant_text_equal_with_work(candidate_name, constant_name, work)
                        return if not comparison.complete
                        if in_scope and comparison.equal:
                            visible <- true
                            matches <- matches + 1
                            valid <- false
                            if not candidate_mutable and candidate_position.line == constant_line:
                                valid <- proof_replay_global_constant_initializer_matches_with_work(candidate_type, candidate_initializer, expected_value, work)
                    Ast::Decl.Module(module_name, body, _):
                        next_scope = proof_replay_global_constant_scope_with_module_and_work(current_scope, module_name, work)
                        return if not next_scope.complete
                        proof_replay_global_constant_lookup_with_work(body, wanted_scope, &next_scope.scope, constant_name, constant_line, expected_value, visible, valid, matches, work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_global_constant_lookup_with_work(body, wanted_scope, current_scope, constant_name, constant_line, expected_value, visible, valid, matches, work, depth + 1)
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return
                    _:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return

        # A parameter or any local of the owner function spelled like the constant (or like the
        # first segment of a qualified path) may shadow it at the use, so the fact is refused:
        # declarations, `=` definitions, loop variables, pattern binders and block bindings at
        # every nesting depth count, since replay does not reconstruct the scope at the use.
        def proof_replay_global_constant_resolves_with_work(declarations: darray[Ast::Decl]&, function_scope: darray[sview]&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, constant_name: sview, constant_reference: Ast::Expr, constant_line: u32, expected_value: i64, qualified: bool, work: mutable usize&) -> bool:
            return false if:
                not proof_replay_summary_expr_charge_with_work(constant_reference, work)
                not proof_replay_global_constant_work_charge(parameters.count, work)
            if not qualified:
                for parameter in parameters |parameter, constant_name, work|:
                    comparison = proof_replay_global_constant_text_equal_with_work(parameter.name, constant_name, work)
                    return false if not comparison.complete or comparison.equal
            reference_path: mutable darray[sview] = []
            return false if not proof_replay_qualified_path(constant_reference, &reference_path, 0) or reference_path.count == 0
            for parameter in parameters |parameter, reference_path, work|:
                comparison = proof_replay_global_constant_text_equal_with_work(parameter.name, reference_path[0], work)
                return false if not comparison.complete or comparison.equal
            return false if proof_replay_source_body_declares_with_work(declarations, body, reference_path[0], work)
            local_visible: mutable bool = false
            local_valid: mutable bool = false
            local_matches: mutable usize = 0
            empty_scope: mutable darray[sview] = []
            proof_replay_global_constant_lookup_with_work(declarations, function_scope, &empty_scope, constant_name, constant_line, expected_value, &local_visible, &local_valid, &local_matches, work, 0)
            return local_matches == 1 and local_valid if local_visible
            return false if qualified or function_scope.count == 0
            root_visible: mutable bool = false
            root_valid: mutable bool = false
            root_matches: mutable usize = 0
            proof_replay_global_constant_lookup_with_work(declarations, &empty_scope, &empty_scope, constant_name, constant_line, expected_value, &root_visible, &root_valid, &root_matches, work, 0)
            root_matches == 1 and root_valid

        def proof_replay_global_constant_find_candidates_with_work(declarations: darray[Ast::Decl]&, all_declarations: darray[Ast::Decl]&, function_name: sview, constant_name: sview, constant_reference: Ast::Expr, constant_line: u32, expected_value: i64, owner_line: u32, owner_offset: usize, current_scope: darray[sview]&, function_matches: mutable usize&, candidates: mutable usize&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return
            for declaration in declarations |declarations, all_declarations, function_name, constant_name, constant_reference, constant_line, expected_value, owner_line, owner_offset, current_scope, function_matches, candidates, work, depth|:
                return if not proof_replay_global_constant_work_charge(1, work)
                match declaration:
                    Ast::Decl.Func(candidate_name, parameters, _, body, _, _, candidate_position):
                        comparison = proof_replay_global_constant_text_equal_with_work(candidate_name, function_name, work)
                        return if not comparison.complete
                        if comparison.equal and (owner_line == 0 or (candidate_position.line == owner_line and candidate_position.offset.usize() == owner_offset)):
                            function_matches <- function_matches + 1
                            qualified: bool = match constant_reference:
                                Ast::Expr.Scope(_, _, _): true
                                _: false
                            qualified_match: mutable bool = true
                            if qualified:
                                path_match = proof_replay_global_constant_qualified_reference_matches_with_work(constant_reference, current_scope, constant_name, work)
                                return if not path_match.complete
                                qualified_match <- path_match.matches
                            if qualified_match and proof_replay_global_constant_resolves_with_work(all_declarations, current_scope, parameters, body, constant_name, constant_reference, constant_line, expected_value, qualified, work):
                                candidates <- candidates + 1
                    Ast::Decl.Module(module_name, body, _):
                        next_scope = proof_replay_global_constant_scope_with_module_and_work(current_scope, module_name, work)
                        return if not next_scope.complete
                        proof_replay_global_constant_find_candidates_with_work(body, all_declarations, function_name, constant_name, constant_reference, constant_line, expected_value, owner_line, owner_offset, &next_scope.scope, function_matches, candidates, work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_global_constant_find_candidates_with_work(body, all_declarations, function_name, constant_name, constant_reference, constant_line, expected_value, owner_line, owner_offset, current_scope, function_matches, candidates, work, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return
                    _:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return

        def proof_replay_qualified_path(expression: Ast::Expr, path: mutable darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    path.push(name)
                    return true
                Ast::Expr.Scope(base, leaf, _):
                    return false if not proof_replay_qualified_path(base, path, depth + 1)
                    path.push(leaf)
                    return true
                _:
                    return false

        # The parser may record a nested module under its qualified spelling (`Outer::{name}`),
        # so a declared name matches when it is `name` or ends in `::name`.
        def proof_replay_qualified_segment_matches_with_work(declared: sview, name: sview, work: mutable usize&) -> (matches: bool, complete: bool):
            comparison = proof_replay_global_constant_text_equal_with_work(declared, name, work)
            return (false, false) if not comparison.complete
            return (true, true) if comparison.equal
            declared_length: usize = sview_len(declared)
            name_length: usize = sview_len(name)
            return (false, true) if:
                name_length == 0 or declared_length < 2
                name_length > declared_length - 2
            return (false, false) if:
                not proof_replay_global_constant_work_charge(name_length, work)
                not proof_replay_global_constant_work_charge(name_length, work)
                not proof_replay_global_constant_work_charge(2, work)
            start: usize = declared_length - name_length
            return (false, true) if declared[start - 1] != 58 or declared[start - 2] != 58
            for offset in 0..<name_length |offset, declared, name, start|:
                return (false, true) if declared[start + offset] != name[offset]
            (true, true)

        # Independent of the producer: a module, enum or struct named `name` below the root.
        def proof_replay_nested_namespace_with_work(declarations: darray[Ast::Decl]&, name: sview, nested: bool, work: mutable usize&, depth: usize) -> (found: bool, complete: bool):
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return (false, false)
            for declaration in declarations |name, nested, work, depth|:
                return (false, false) if not proof_replay_global_constant_work_charge(1, work)
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        module_comparison = proof_replay_global_constant_text_equal_with_work(module_name, name, work)
                        return (false, false) if not module_comparison.complete
                        if nested or not module_comparison.equal:
                            segment = proof_replay_qualified_segment_matches_with_work(module_name, name, work)
                            return (false, false) if not segment.complete
                            return (true, true) if segment.matches
                        child = proof_replay_nested_namespace_with_work(body, name, true, work, depth + 1)
                        return child if child.found or not child.complete
                    Ast::Decl.Scoped(body, _):
                        child = proof_replay_nested_namespace_with_work(body, name, nested, work, depth + 1)
                        return child if child.found or not child.complete
                    Ast::Decl.Enum(enum_name, _, _, _, _):
                        enum_comparison = proof_replay_global_constant_text_equal_with_work(enum_name, name, work)
                        return (false, false) if not enum_comparison.complete
                        if nested or not enum_comparison.equal:
                            segment = proof_replay_qualified_segment_matches_with_work(enum_name, name, work)
                            return (false, false) if not segment.complete
                            return (true, true) if segment.matches
                    Ast::Decl.Struct(struct_name, _, _, _, _, _, _):
                        struct_comparison = proof_replay_global_constant_text_equal_with_work(struct_name, name, work)
                        return (false, false) if not struct_comparison.complete
                        if nested or not struct_comparison.equal:
                            segment = proof_replay_qualified_segment_matches_with_work(struct_name, name, work)
                            return (false, false) if not segment.complete
                            return (true, true) if segment.matches
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return (false, false)
                    _:
                        return (false, false)
            (false, true)

        # A qualified constant resolves from the root for the sole function of its name with no
        # parameter spelled like the path's first segment, when that function is at the root or
        # the segment names no nested namespace that could be nearer.
        # A function inside a module counts only when `first` names no nested namespace.
        def proof_replay_qualified_function_count_with_work(declarations: darray[Ast::Decl]&, function_name: sview, owner_line: u32, owner_offset: usize, first: sview, in_module: bool, shadowable: bool, total: mutable usize&, rooted: mutable usize&, work: mutable usize&, depth: usize) -> void:
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return
            for declaration in declarations |function_name, owner_line, owner_offset, first, in_module, shadowable, total, rooted, work, depth|:
                return if not proof_replay_global_constant_work_charge(1, work)
                match declaration:
                    Ast::Decl.Func(candidate_name, parameters, _, body, _, _, candidate_position):
                        comparison = proof_replay_global_constant_text_equal_with_work(candidate_name, function_name, work)
                        return if not comparison.complete
                        if comparison.equal and (owner_line == 0 or (candidate_position.line == owner_line and candidate_position.offset.usize() == owner_offset)):
                            total <- total + 1
                            if in_module == false or shadowable == false:
                                return if not proof_replay_global_constant_work_charge(parameters.count, work)
                                parameter_shadow: mutable bool = false
                                for parameter in parameters |first, parameter_shadow, work|:
                                    parameter_comparison = proof_replay_global_constant_text_equal_with_work(parameter.name, first, work)
                                    return if not parameter_comparison.complete
                                    parameter_shadow <- true if parameter_comparison.equal
                                if not parameter_shadow and not proof_replay_source_body_declares_with_work(declarations, body, first, work):
                                    rooted <- rooted + 1
                    Ast::Decl.Module(_, body, _):
                        proof_replay_qualified_function_count_with_work(body, function_name, owner_line, owner_offset, first, true, shadowable, total, rooted, work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_qualified_function_count_with_work(body, function_name, owner_line, owner_offset, first, in_module, shadowable, total, rooted, work, depth + 1)
                    Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return
                    _:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return

        def proof_replay_qualified_constant_fact_is_valid_with_work(report: ProofReport&, trace: ProofFactTrace, path: darray[sview]&, expected_value: i64, work: mutable usize&) -> bool:
            return false if:
                path.count < 2
                not proof_replay_global_constant_work_charge(path.count, work)
            total: mutable usize = 0
            rooted: mutable usize = 0
            nested = proof_replay_nested_namespace_with_work(report.source.source_declarations, path[0], false, work, 0)
            return false if not nested.complete
            proof_replay_qualified_function_count_with_work(report.source.source_declarations, trace.name, trace.owner_line, report.analysis_2.replay_owner_offset, path[0], false, nested.found, &total, &rooted, work, 0)
            return false if total != 1 or rooted != 1
            wanted_scope: mutable darray[sview] = []
            for index in 0..<path.count - 1 |index, path, wanted_scope|:
                wanted_scope.push(path[index])
            empty_scope: mutable darray[sview] = []
            visible: mutable bool = false
            valid: mutable bool = false
            matches: mutable usize = 0
            proof_replay_global_constant_lookup_with_work(report.source.source_declarations, &wanted_scope, &empty_scope, path[path.count - 1], trace.line, expected_value, &visible, &valid, &matches, work, 0)
            return work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT and matches == 1 and valid

        # A constant fact stamped with its owner's declaration line is valid only for that owner:
        # while a certificate is replayed, the active line and offset identify the exact function,
        # so a same-named declaration cannot borrow the fact.
        def proof_replay_global_constant_fact_is_valid_with_work(report: ProofReport&, trace: ProofFactTrace, work: mutable usize&) -> bool:
            return false if:
                trace.owner_line != 0 and report.analysis_2.replay_owner_line != 0 and trace.owner_line != report.analysis_2.replay_owner_line
                trace.owner_line != 0 and not report.analysis_2.replay_owner_offset_valid
                not proof_replay_summary_expr_charge_with_work(trace.expression, work)
            match trace.expression:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    return false if:
                        proof_replay_summary_has_unresolved_import(report.source.source_annotations, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        proof_replay_summary_has_unresolved_declaration_import(report.source.source_declarations, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                    qualified_path: mutable darray[sview] = []
                    qualified_left: bool = match left:
                        Ast::Expr.Scope(_, _, _): proof_replay_qualified_path(left, &qualified_path, 0)
                        _: false
                    if qualified_left:
                        kind_comparison = proof_replay_global_constant_text_equal_with_work(trace.kind, "global-constant-qualified", work)
                        return false if not kind_comparison.complete or not kind_comparison.equal
                        decoded = proof_replay_global_constant_fact_value(right)
                        return decoded.known and proof_replay_qualified_constant_fact_is_valid_with_work(report, trace, &qualified_path, decoded.value, work)
                    constant_name: sview = match left:
                        Ast::Expr.Ident(name, _) | Ast::Expr.Scope(_, name, _): name
                        _: ""
                    qualified: bool = match left:
                        Ast::Expr.Scope(_, _, _): true
                        _: false
                    decoded = proof_replay_global_constant_fact_value(right)
                    expected_value: i64 = decoded.value
                    return false if constant_name == ""
                    expected_kind: mutable sview = "global-constant"
                    expected_kind <- "global-constant-qualified" if qualified
                    kind_comparison = proof_replay_global_constant_text_equal_with_work(trace.kind, expected_kind, work)
                    return false if:
                        not kind_comparison.complete or not kind_comparison.equal
                        not decoded.known
                    function_matches: mutable usize = 0
                    candidates: mutable usize = 0
                    root_scope: mutable darray[sview] = []
                    proof_replay_global_constant_find_candidates_with_work(report.source.source_declarations, report.source.source_declarations, trace.name, constant_name, left, trace.line, expected_value, trace.owner_line, report.analysis_2.replay_owner_offset, &root_scope, &function_matches, &candidates, work, 0)
                    work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT and function_matches == 1 and candidates == 1
                _:
                    false
