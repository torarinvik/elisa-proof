# Reconstruct source frame paths without consulting producer ProofFramePlace
# values. The caller must obtain formal_names from the exact owning declaration.
module ElisaProofFrameSource:
    private:
        const FRAME_SOURCE_EXPRESSION_LIMIT: usize = 64
        const FRAME_SOURCE_PARAMETER_LIMIT: usize = 64

        def place_at(expression: Ast::Expr, formal_names: darray[sview]&, remaining: usize) -> (known: bool, place: ElisaProofKernelFramePolicy::Place):
            empty: ElisaProofKernelFramePolicy::Place = ElisaProofKernelFramePolicy::Place{parameter: 0, depth: 0, field: "", field2: "", field3: ""}
            return (false, empty) if remaining == 0
            match expression:
                Ast::Expr.Ident(name, _):
                    for index in 0..<formal_names.count |index, formal_names, name|:
                        if formal_names[index] == name:
                            return (true, ElisaProofKernelFramePolicy::Place{parameter: index, depth: 0, field: "", field2: "", field3: ""})
                    return (false, empty)
                Ast::Expr.Paren(inner, _):
                    return place_at(inner, formal_names, remaining - 1)
                Ast::Expr.Field(base, field, _):
                    return (false, empty) if field == ""
                    parent = place_at(base, formal_names, remaining - 1)
                    return (false, empty) if not parent.known or parent.place.depth >= 3
                    return (true, ElisaProofKernelFramePolicy::Place{parameter: parent.place.parameter, depth: parent.place.depth + 1, field: field if parent.place.depth == 0 else parent.place.field, field2: field if parent.place.depth == 1 else parent.place.field2, field3: field if parent.place.depth == 2 else parent.place.field3})
                _:
                    # Indexed, computed and qualified global roots need their own
                    # checked source mapping; they cannot stand in for a formal.
                    return (false, empty)

    public:
        def place(expression: Ast::Expr, formal_names: darray[sview]&) -> (known: bool, place: ElisaProofKernelFramePolicy::Place):
            empty: ElisaProofKernelFramePolicy::Place = ElisaProofKernelFramePolicy::Place{parameter: 0, depth: 0, field: "", field2: "", field3: ""}
            return (false, empty) if formal_names.count == 0 or formal_names.count > FRAME_SOURCE_PARAMETER_LIMIT
            for index in 0..<formal_names.count |index, formal_names|:
                return (false, empty) if formal_names[index] == ""
                for prior in 0..<index |prior, index, formal_names|:
                    return (false, empty) if formal_names[prior] == formal_names[index]
            return place_at(expression, formal_names, FRAME_SOURCE_EXPRESSION_LIMIT)
