extend ElisaProof:
    private:
        const PROOF_REPLAY_EQUALITY_WORK_LIMIT: usize = 1048576
        # Each node can trigger nine width probes plus typing/fallback scans over a nested
        # subtree. Sixteen passes leave room for those scans while adapting to measured depth.
        const PROOF_REPLAY_AMBIGUITY_SCAN_FACTOR: usize = 16

        def proof_replay_equality_work_charge(amount: usize, work: mutable usize&) -> bool:
            return false if:
                work > PROOF_REPLAY_EQUALITY_WORK_LIMIT
                amount > PROOF_REPLAY_EQUALITY_WORK_LIMIT - work
            work <- work + amount
            return true

        # Offset the linear reader's local meter so a chunk fits both remaining budgets.
        def proof_replay_equality_width_chunk_start(work: usize, width_used: usize) -> (complete: bool, start: usize):
            return (false, 0) if work > PROOF_REPLAY_EQUALITY_WORK_LIMIT or width_used > PROOF_LINEAR_SAFETY_WORK_LIMIT
            replay_remaining: usize = PROOF_REPLAY_EQUALITY_WORK_LIMIT - work
            width_remaining: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - width_used
            allowance: usize = width_remaining if width_remaining < replay_remaining else replay_remaining
            (true, PROOF_LINEAR_SAFETY_WORK_LIMIT - allowance)

        # Reserve work before calling legacy bounded AST predicates that do not accept the
        # replay counter. The shared structural cost walker counts payloads and child arrays;
        # repetitions reserves the worst-case repeated comparisons made by the caller.
        def proof_replay_expr_cost_charge_with_work(expression: Ast::Expr, work: mutable usize&) -> (complete: bool, cost: usize):
            return (false, 0) if work > PROOF_REPLAY_EQUALITY_WORK_LIMIT
            cost: mutable usize = 0
            return (false, 0) if:
                not proof_replay_summary_expr_cost(expression, &cost, work, 0)
                cost == 0 or not proof_replay_equality_work_charge(cost, work)
            return (true, cost)

        def proof_replay_charge_expr_repetitions_with_work(expression: Ast::Expr, repetitions: usize, work: mutable usize&) -> bool:
            measured: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(expression, work)
            return false if not measured.complete or repetitions == 0
            cost: usize = measured.cost
            return false if repetitions > (PROOF_REPLAY_EQUALITY_WORK_LIMIT - work) / cost
            proof_replay_equality_work_charge(cost * repetitions, work)

        def proof_replay_charge_expr_pair_repetitions_with_work(left: Ast::Expr, right: Ast::Expr, repetitions: usize, work: mutable usize&) -> bool:
            return false if not proof_replay_charge_expr_repetitions_with_work(left, repetitions, work)
            proof_replay_charge_expr_repetitions_with_work(right, repetitions, work)

        def proof_replay_charge_expr_product_with_work(left: Ast::Expr, right: Ast::Expr, work: mutable usize&) -> bool:
            left_size: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(left, work)
            return false if not left_size.complete
            right_size: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(right, work)
            return false if:
                not right_size.complete or left_size.cost == 0
                right_size.cost > (PROOF_REPLAY_EQUALITY_WORK_LIMIT - work) / left_size.cost
            proof_replay_equality_work_charge(left_size.cost * right_size.cost, work)

        # Simultaneous substitution scans the active name stack at identifier and binder
        # nodes. Reserve the quadratic worst case before traversing a block with many locals.
        def proof_replay_charge_expr_self_product_with_work(expression: Ast::Expr, work: mutable usize&) -> bool:
            measured: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(expression, work)
            return false if not measured.complete or measured.cost > (PROOF_REPLAY_EQUALITY_WORK_LIMIT - work) / measured.cost
            proof_replay_equality_work_charge(measured.cost * measured.cost, work)

        # Measure the deepest expression path the ambiguity predicates may revisit. The
        # structural cost pass bounds this walk's total nodes; unsupported control forms are
        # terminals for the ambiguity predicate and therefore do not add child depth here.
        def proof_replay_ambiguity_depth(expression: Ast::Expr, depth: usize) -> usize:
            return PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_replay_ambiguity_depth(inner, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _) | Ast::Expr.Refinement(left, right, _):
                    left_depth: usize = proof_replay_ambiguity_depth(left, depth + 1)
                    right_depth: usize = proof_replay_ambiguity_depth(right, depth + 1)
                    return left_depth if left_depth >= right_depth else right_depth
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    object_depth: usize = proof_replay_ambiguity_depth(object, depth + 1)
                    low_depth: usize = proof_replay_ambiguity_depth(low, depth + 1)
                    high_depth: usize = proof_replay_ambiguity_depth(high, depth + 1)
                    deepest: usize = object_depth if object_depth >= low_depth else low_depth
                    return deepest if deepest >= high_depth else high_depth
                Ast::Expr.Call(callee, arguments, _, _) | Ast::Expr.IndexN(callee, arguments, _):
                    deepest: mutable usize = proof_replay_ambiguity_depth(callee, depth + 1)
                    for argument in arguments |deepest, depth|:
                        argument_depth: usize = proof_replay_ambiguity_depth(argument, depth + 1)
                        deepest <- argument_depth if argument_depth > deepest
                    return deepest
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    deepest: mutable usize = depth + 1
                    for element in elements |deepest, depth|:
                        element_depth: usize = proof_replay_ambiguity_depth(element, depth + 1)
                        deepest <- element_depth if element_depth > deepest
                    return deepest
                Ast::Expr.DictLit(entries, _):
                    deepest: mutable usize = depth + 1
                    for entry in entries |deepest, depth|:
                        key_depth: usize = proof_replay_ambiguity_depth(entry.key, depth + 1)
                        value_depth: usize = proof_replay_ambiguity_depth(entry.value, depth + 1)
                        deepest <- key_depth if key_depth > deepest
                        deepest <- value_depth if value_depth > deepest
                    return deepest
                Ast::Expr.Construct(type_expression, fields, _) | Ast::Expr.RecordUpdate(type_expression, fields, _):
                    deepest: mutable usize = proof_replay_ambiguity_depth(type_expression, depth + 1)
                    for field in fields |deepest, depth|:
                        field_depth: usize = proof_replay_ambiguity_depth(field.value, depth + 1)
                        deepest <- field_depth if field_depth > deepest
                    return deepest
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    iterable_depth: usize = proof_replay_ambiguity_depth(iterable, depth + 1)
                    condition_depth: usize = proof_replay_ambiguity_depth(condition, depth + 1)
                    body_depth: usize = proof_replay_ambiguity_depth(body, depth + 1)
                    deepest: usize = iterable_depth if iterable_depth >= condition_depth else condition_depth
                    return deepest if deepest >= body_depth else body_depth
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _) | Ast::Expr.Match(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _):
                    return depth + 1
                _:
                    return depth + 1

        def proof_replay_charge_expr_depth_repetitions_with_work(expression: Ast::Expr, passes_per_level: usize, work: mutable usize&) -> bool:
            measured: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(expression, work)
            return false if not measured.complete or not proof_replay_equality_work_charge(measured.cost, work)
            depth: usize = proof_replay_ambiguity_depth(expression, 0)
            repetitions: usize = depth * passes_per_level
            return false if repetitions > (PROOF_REPLAY_EQUALITY_WORK_LIMIT - work) / measured.cost
            proof_replay_equality_work_charge(measured.cost * repetitions, work)

        def proof_replay_charge_ambiguity_scan_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            measured_expression: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(expression, work)
            return false if:
                not measured_expression.complete
                not proof_replay_equality_work_charge(measured_expression.cost, work)
            depth: usize = proof_replay_ambiguity_depth(expression, 0)
            expression_repetitions: usize = depth * PROOF_REPLAY_AMBIGUITY_SCAN_FACTOR
            return false if:
                expression_repetitions > (PROOF_REPLAY_EQUALITY_WORK_LIMIT - work) / measured_expression.cost
                not proof_replay_equality_work_charge(measured_expression.cost * expression_repetitions, work)
            fact_cost: mutable usize = 0
            for fact in facts |fact, fact_cost, work|:
                measured_fact: (complete: bool, cost: usize) = proof_replay_expr_cost_charge_with_work(fact, work)
                return false if not measured_fact.complete or measured_fact.cost > PROOF_REPLAY_EQUALITY_WORK_LIMIT - fact_cost
                fact_cost <- fact_cost + measured_fact.cost
            fact_repetitions: usize = measured_expression.cost * expression_repetitions
            return false if fact_cost > 0 and fact_repetitions > (PROOF_REPLAY_EQUALITY_WORK_LIMIT - work) / fact_cost
            proof_replay_equality_work_charge(fact_cost * fact_repetitions, work)

        def proof_replay_add_lower_with_work(bounds: mutable darray[ProofReplayBound]&, name: sview, value: i64, work: mutable usize&) -> bool:
            return true if name == ""
            for index in 0..<bounds.count |index, bounds, name, value, work|:
                return false if:
                    not proof_replay_equality_work_charge(1, work)
                    not proof_replay_equality_work_charge(sview_len(bounds[index].name), work)
                    not proof_replay_equality_work_charge(sview_len(name), work)
                if bounds[index].name == name:
                    old_has: bool = bounds[index].has_lower
                    old_value: i64 = bounds[index].lower
                    bounds[index].has_lower <- true
                    bounds[index].lower <- value if not old_has or value > old_value
                    return true
            return false if:
                not proof_replay_equality_work_charge(1, work)
                not proof_replay_equality_work_charge(sview_len(name), work)
            bounds <- bounds.push(ProofReplayBound{name: name, has_lower: true, lower: value, has_upper: false, upper: 0})
            return true

        def proof_replay_add_upper_with_work(bounds: mutable darray[ProofReplayBound]&, name: sview, value: i64, work: mutable usize&) -> bool:
            return true if name == ""
            for index in 0..<bounds.count |index, bounds, name, value, work|:
                return false if:
                    not proof_replay_equality_work_charge(1, work)
                    not proof_replay_equality_work_charge(sview_len(bounds[index].name), work)
                    not proof_replay_equality_work_charge(sview_len(name), work)
                if bounds[index].name == name:
                    old_has: bool = bounds[index].has_upper
                    old_value: i64 = bounds[index].upper
                    bounds[index].has_upper <- true
                    bounds[index].upper <- value if not old_has or value < old_value
                    return true
            return false if:
                not proof_replay_equality_work_charge(1, work)
                not proof_replay_equality_work_charge(sview_len(name), work)
            bounds <- bounds.push(ProofReplayBound{name: name, has_lower: false, lower: 0, has_upper: true, upper: value})
            return true

        def proof_replay_equality_ident_name(expression: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_equality_work_charge(1, work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, "") if not proof_replay_equality_work_charge(sview_len(name), work)
                    return (true, name)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_equality_ident_name(inner, work, depth + 1)
                _:
                    pass
            return (true, "")

        def proof_replay_equality_constant_nodes(expression: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, nodes: usize):
            return (false, 0) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_equality_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _):
                    inner_nodes: (complete: bool, nodes: usize) = proof_replay_equality_constant_nodes(inner, work, depth + 1)
                    return (false, 0) if not inner_nodes.complete or inner_nodes.nodes >= PROOF_REPLAY_EQUALITY_WORK_LIMIT
                    return (true, inner_nodes.nodes + 1)
                Ast::Expr.Unary(_, operand, _):
                    operand_nodes: (complete: bool, nodes: usize) = proof_replay_equality_constant_nodes(operand, work, depth + 1)
                    return (false, 0) if not operand_nodes.complete or operand_nodes.nodes >= PROOF_REPLAY_EQUALITY_WORK_LIMIT
                    return (true, operand_nodes.nodes + 1)
                Ast::Expr.Binary(left, _, right, _):
                    left_nodes: (complete: bool, nodes: usize) = proof_replay_equality_constant_nodes(left, work, depth + 1)
                    return (false, 0) if not left_nodes.complete
                    right_nodes: (complete: bool, nodes: usize) = proof_replay_equality_constant_nodes(right, work, depth + 1)
                    return (false, 0) if:
                        not right_nodes.complete
                        left_nodes.nodes >= PROOF_REPLAY_EQUALITY_WORK_LIMIT
                        right_nodes.nodes > PROOF_REPLAY_EQUALITY_WORK_LIMIT - left_nodes.nodes - 1
                    return (true, 1 + left_nodes.nodes + right_nodes.nodes)
                _:
                    pass
            return (true, 1)

        def proof_replay_constant_int_with_equality_work(expression: Ast::Expr, work: mutable usize&) -> (complete: bool, constant: ProofReplayInt):
            nodes: (complete: bool, nodes: usize) = proof_replay_equality_constant_nodes(expression, work, 0)
            return (false, ProofReplayInt{known: false, value: 0}) if not nodes.complete or not proof_replay_equality_work_charge(nodes.nodes, work)
            return (true, proof_replay_constant_int(expression))

        def proof_replay_equality_scalar_name_witnessed(name: sview, facts: darray[Ast::Expr]&, work: mutable usize&) -> (complete: bool, witnessed: bool):
            return (false, false) if name == ""
            for fact in facts |fact, name, facts, work|:
                return (false, false) if not proof_replay_equality_work_charge(1, work)
                match fact:
                    Ast::Expr.Call(callee, arguments, argument_names, _):
                        callee_name: (complete: bool, name: sview) = proof_replay_equality_ident_name(callee, work, 0)
                        return (false, false) if not callee_name.complete
                        if arguments.count == 1 and (argument_names.count == 0 or argument_names.count == arguments.count) and (callee_name.name in {"__elisa_primitive_scalar_type", "__elisa_primitive_integer_type"}):
                            target: (complete: bool, name: sview) = proof_replay_equality_ident_name(arguments[0], work, 0)
                            return (false, false) if not target.complete
                            return (true, true) if target.name == name
                        if arguments.count == 2 and (argument_names.count == 0 or argument_names.count == arguments.count) and callee_name.name == "__elisa_unsigned_type_bound":
                            target_name: (complete: bool, name: sview) = proof_replay_equality_ident_name(arguments[0], work, 0)
                            return (false, false) if not target_name.complete
                            width_shape: (complete: bool, nodes: usize) = proof_replay_equality_constant_nodes(arguments[1], work, 0)
                            return (false, false) if not width_shape.complete or not proof_replay_equality_work_charge(width_shape.nodes, work)
                            width: ProofReplayInt = proof_replay_constant_int(arguments[1])
                            return (true, true) if target_name.name == name and width.known and ElisaProofKernelCore::proof_kernel_unsigned_width_valid(width.value)
                    _:
                        pass
            return (true, false)

        # A complete marker name index answers both hits and misses. Keep the source scan only
        # when the bounded probe stopped before an empty slot and no sorted collision fallback
        # is available.
        def proof_replay_equality_scalar_name_witnessed_indexed(name: sview, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, work: mutable usize&) -> (complete: bool, witnessed: bool):
            return (true, false) if name == ""
            return (false, false) if:
                markers.name_hashes.count != markers.names.count
                (markers.names.count == 0) != (markers.name_slots.count == 0)
                markers.name_slots.count > 0 and markers.name_slots.count < markers.names.count
                markers.sorted_name_indices.count != 0 and markers.sorted_name_indices.count != markers.names.count
                not proof_replay_equality_work_charge(1, work)
                not proof_replay_equality_work_charge(sview_len(name), work)
            capacity: usize = markers.name_slots.count
            hash_complete: mutable bool = capacity == 0
            if capacity > 0:
                wanted_hash: u32 = proof_name_hash(name)
                slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes < PROOF_SCALAR_WITNESS_NAME_PROBE_LIMIT |probes, slot, wanted_hash, name, markers, capacity, work|:
                    return (false, false) if not proof_replay_equality_work_charge(1, work)
                    current: usize = markers.name_slots[slot]
                    return (false, false) if current > markers.names.count
                    if current == markers.names.count:
                        hash_complete <- true
                        break
                    if markers.name_hashes[current] == wanted_hash:
                        candidate: sview = markers.names[current]
                        return (false, false) if not proof_replay_equality_work_charge(sview_len(candidate), work) or not proof_replay_equality_work_charge(sview_len(name), work)
                        return (true, true) if candidate == name
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
            if markers.sorted_name_indices.count > 0:
                lower: mutable usize = 0
                upper: mutable usize = markers.sorted_name_indices.count
                while lower < upper |lower, upper, markers, name, work|:
                    return (false, false) if not proof_replay_equality_work_charge(1, work)
                    middle: usize = lower + (upper - lower) / 2
                    row: usize = markers.sorted_name_indices[middle]
                    return (false, false) if row >= markers.names.count
                    candidate: sview = markers.names[row]
                    return (false, false) if not proof_replay_equality_work_charge(sview_len(candidate), work) or not proof_replay_equality_work_charge(sview_len(name), work)
                    return (true, true) if candidate == name
                    if proof_scalar_witness_name_less(candidate, name):
                        lower <- middle + 1
                    else:
                        upper <- middle
                return (true, false)
            return (true, false) if hash_complete
            return proof_replay_equality_scalar_name_witnessed(name, facts, work)

        def proof_replay_scalar_term_witnessed_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, work: mutable usize&, depth: usize) -> (complete: bool, witnessed: bool):
            return (false, false) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_equality_work_charge(1, work)
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.CharLit(_, _):
                    return (true, true)
                Ast::Expr.ShorthandMember(parts, _):
                    return (false, false) if:
                        parts.count != 1 or parts[0] == ""
                        not proof_replay_equality_work_charge(sview_len(parts[0]), work)
                    return (true, true)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_scalar_term_witnessed_with_work(inner, facts, work, depth + 1)
                Ast::Expr.Ident(name, _):
                    return proof_replay_equality_scalar_name_witnessed(name, facts, work)
                Ast::Expr.Unary(operator, operand, _):
                    return (true, false) if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Not
                    return proof_replay_scalar_term_witnessed_with_work(operand, facts, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, false) if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent and operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq and operator != TokenKind.And and operator != TokenKind.Or and operator != TokenKind.Ampersand and operator != TokenKind.Pipe and operator != TokenKind.Caret and operator != TokenKind.LShift and operator != TokenKind.RShift
                    left_witnessed: (complete: bool, witnessed: bool) = proof_replay_scalar_term_witnessed_with_work(left, facts, work, depth + 1)
                    return (false, false) if not left_witnessed.complete
                    return (true, false) if not left_witnessed.witnessed
                    return proof_replay_scalar_term_witnessed_with_work(right, facts, work, depth + 1)
                _:
                    pass
            return (true, false)

        def proof_replay_primitive_comparison_with_work(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, work: mutable usize&) -> (complete: bool, matches: bool):
            left_witnessed: (complete: bool, witnessed: bool) = proof_replay_scalar_term_witnessed_with_work(left, facts, work, 0)
            return (false, false) if not left_witnessed.complete
            return (true, false) if not left_witnessed.witnessed
            return proof_replay_scalar_term_witnessed_with_work(right, facts, work, 0)

        def proof_replay_equality_sort_cache_grow(names: darray[sview]&, hashes: darray[u32]&, slots: mutable darray[usize]&, work: mutable usize&) -> bool:
            old_capacity: usize = slots.count
            return false if old_capacity == 0 or names.count != hashes.count or names.count > old_capacity or old_capacity > PROOF_REPLAY_EQUALITY_WORK_LIMIT / 2
            new_capacity: usize = old_capacity * 2
            return false if not proof_replay_equality_work_charge(new_capacity, work)
            grown_slots: mutable darray[usize] = []
            grown_slots.resize(new_capacity)
            for slot in 0..<new_capacity |slot, grown_slots, new_capacity, work|:
                return false if not proof_replay_equality_work_charge(1, work)
                grown_slots[slot] <- new_capacity
            for row in 0..<names.count |names, hashes, grown_slots, new_capacity, work|:
                slot: mutable usize = (hashes[row].i64() % new_capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < new_capacity and grown_slots[slot] != new_capacity |slot, probes, row, hashes, grown_slots, new_capacity, work|:
                    return false if not proof_replay_equality_work_charge(1, work)
                    slot <- (slot + 1) % new_capacity
                    probes <- probes + 1
                return false if probes >= new_capacity
                return false if not proof_replay_equality_work_charge(1, work)
                grown_slots[slot] <- row
            slots.clear()
            slots.extend(grown_slots)
            return true

        def proof_replay_equality_name_sort_cached(name: sview, sort_index: ProofNameEqualitySortIndex, names: mutable darray[sview]&, values: mutable darray[i64]&, hashes: mutable darray[u32]&, slots: mutable darray[usize]&, work: mutable usize&, width_work: mutable usize&, width_exhausted: mutable bool&) -> (complete: bool, sort: i64):
            capacity: mutable usize = slots.count
            return (false, 0) if capacity == 0 or names.count != values.count or names.count != hashes.count
            if names.count >= capacity:
                return (false, 0) if not proof_replay_equality_sort_cache_grow(names, hashes, &slots, work)
                capacity <- slots.count
            return (false, 0) if not proof_replay_equality_work_charge(sview_len(name), work)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity |probes, slot, wanted_hash, name, sort_index, names, values, hashes, slots, capacity, work, width_work, width_exhausted|:
                return (false, 0) if not proof_replay_equality_work_charge(1, work)
                current: usize = slots[slot]
                if current == capacity:
                    chunk: (complete: bool, start: usize) = proof_replay_equality_width_chunk_start(work, width_work)
                    return (false, 0) if not chunk.complete
                    width_budget: mutable usize = chunk.start
                    selected_sort: i64 = proof_name_equality_sort_index_lookup(sort_index, name, &width_budget, width_exhausted)
                    width_cost: usize = width_budget - chunk.start
                    return (false, 0) if not proof_replay_equality_work_charge(width_cost, work)
                    width_work <- width_work + width_cost
                    return (false, 0) if width_exhausted or not proof_replay_equality_work_charge(3, work) or not proof_replay_equality_work_charge(sview_len(name), work)
                    names.push(name)
                    values.push(selected_sort)
                    hashes.push(wanted_hash)
                    slots[slot] <- names.count - 1
                    return (true, selected_sort)
                return (false, 0) if current >= names.count
                if hashes[current] == wanted_hash:
                    return (false, 0) if not proof_replay_equality_work_charge(sview_len(names[current]), work) or not proof_replay_equality_work_charge(sview_len(name), work)
                    return (true, values[current]) if names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, 0)

        def proof_replay_collect_name_equalities(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, sort_index: ProofNameEqualitySortIndex, sort_names: mutable darray[sview]&, sort_values: mutable darray[i64]&, sort_hashes: mutable darray[u32]&, sort_slots: mutable darray[usize]&, left_names: mutable darray[sview]&, right_names: mutable darray[sview]&, work: mutable usize&, width_work: mutable usize&, width_exhausted: mutable bool&) -> bool:
            proof_replay_collect_name_equalities_depth(expression, facts, markers, sort_index, sort_names, sort_values, sort_hashes, sort_slots, left_names, right_names, work, width_work, width_exhausted, 0)

        def proof_replay_collect_name_equalities_depth(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, sort_index: ProofNameEqualitySortIndex, sort_names: mutable darray[sview]&, sort_values: mutable darray[i64]&, sort_hashes: mutable darray[u32]&, sort_slots: mutable darray[usize]&, left_names: mutable darray[sview]&, right_names: mutable darray[sview]&, work: mutable usize&, width_work: mutable usize&, width_exhausted: mutable bool&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_equality_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_collect_name_equalities_depth(inner, facts, markers, sort_index, sort_names, sort_values, sort_hashes, sort_slots, left_names, right_names, work, width_work, width_exhausted, depth + 1)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return false if not proof_replay_collect_name_equalities_depth(left, facts, markers, sort_index, sort_names, sort_values, sort_hashes, sort_slots, left_names, right_names, work, width_work, width_exhausted, depth + 1)
                    return proof_replay_collect_name_equalities_depth(right, facts, markers, sort_index, sort_names, sort_values, sort_hashes, sort_slots, left_names, right_names, work, width_work, width_exhausted, depth + 1)
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    left_name: (complete: bool, name: sview) = proof_replay_equality_ident_name(left, work, 0)
                    return false if not left_name.complete
                    right_name: (complete: bool, name: sview) = proof_replay_equality_ident_name(right, work, 0)
                    return false if not right_name.complete
                    if left_name.name != "" and right_name.name != "":
                        left_witness: (complete: bool, witnessed: bool) = proof_replay_equality_scalar_name_witnessed_indexed(left_name.name, facts, markers, work)
                        return false if not left_witness.complete
                        if left_witness.witnessed:
                            right_witness: (complete: bool, witnessed: bool) = proof_replay_equality_scalar_name_witnessed_indexed(right_name.name, facts, markers, work)
                            return false if not right_witness.complete
                            if right_witness.witnessed:
                                return false if:
                                    not proof_replay_equality_work_charge(2, work)
                                    not proof_replay_equality_work_charge(sview_len(left_name.name), work)
                                    not proof_replay_equality_work_charge(sview_len(right_name.name), work)
                                left_sort: (complete: bool, sort: i64) = proof_replay_equality_name_sort_cached(left_name.name, sort_index, sort_names, sort_values, sort_hashes, sort_slots, work, width_work, width_exhausted)
                                return false if not left_sort.complete
                                right_sort: (complete: bool, sort: i64) = proof_replay_equality_name_sort_cached(right_name.name, sort_index, sort_names, sort_values, sort_hashes, sort_slots, work, width_work, width_exhausted)
                                return false if not right_sort.complete
                                if left_sort.sort != 0 and left_sort.sort == right_sort.sort:
                                    left_names.push(left_name.name)
                                    right_names.push(right_name.name)
                _:
                    pass
            return true

        def proof_replay_alias_build_adjacency(names: darray[sview]&, edge_left: darray[usize]&, edge_right: darray[usize]&, adjacency_heads: mutable darray[usize]&, adjacency_names: mutable darray[usize]&, adjacency_next: mutable darray[usize]&, work: mutable usize&) -> bool:
            return false if:
                not proof_replay_equality_work_charge(names.count, work)
                edge_left.count > PROOF_REPLAY_EQUALITY_WORK_LIMIT / 2
                not proof_replay_equality_work_charge(edge_left.count * 2, work)
            for name in names |name, names, adjacency_heads|:
                adjacency_heads.push(0)
            for edge in 0..<edge_left.count |edge, edge_left, edge_right, adjacency_heads, adjacency_names, adjacency_next|:
                adjacency_names.push(edge_right[edge])
                adjacency_next.push(adjacency_heads[edge_left[edge]])
                adjacency_heads[edge_left[edge]] <- adjacency_names.count
                adjacency_names.push(edge_left[edge])
                adjacency_next.push(adjacency_heads[edge_right[edge]])
                adjacency_heads[edge_right[edge]] <- adjacency_names.count
            return true

        def proof_replay_name_equality_graph(facts: darray[Ast::Expr]&, left_names: mutable darray[sview]&, right_names: mutable darray[sview]&, names: mutable darray[sview]&, edge_left: mutable darray[usize]&, edge_right: mutable darray[usize]&, work: mutable usize&) -> bool:
            return false if not proof_replay_equality_work_charge(facts.count, work)
            width_work: mutable usize = 0
            width_exhausted: mutable bool = false
            chunk: (complete: bool, start: usize) = proof_replay_equality_width_chunk_start(work, width_work)
            return false if not chunk.complete
            width_budget: mutable usize = chunk.start
            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, &width_budget, &width_exhausted)
            width_cost: usize = width_budget - chunk.start
            return false if not proof_replay_equality_work_charge(width_cost, work)
            width_work <- width_work + width_cost
            return false if not marker_result.complete or width_exhausted
            sort_chunk: (complete: bool, start: usize) = proof_replay_equality_width_chunk_start(work, width_work)
            return false if not sort_chunk.complete
            sort_budget: mutable usize = sort_chunk.start
            sort_result: (complete: bool, index: ProofNameEqualitySortIndex) = proof_name_equality_sort_index_build(facts, &sort_budget, &width_exhausted)
            sort_cost: usize = sort_budget - sort_chunk.start
            return false if not proof_replay_equality_work_charge(sort_cost, work)
            width_work <- width_work + sort_cost
            return false if not sort_result.complete or width_exhausted
            return false if facts.count > PROOF_REPLAY_EQUALITY_WORK_LIMIT / 2
            sort_capacity: usize = proof_name_index_capacity(facts.count * 2)
            return false if facts.count > 0 and sort_capacity == 0
            return false if not proof_replay_equality_work_charge(sort_capacity, work)
            sort_names: mutable darray[sview] = []
            sort_values: mutable darray[i64] = []
            sort_hashes: mutable darray[u32] = []
            sort_slots: mutable darray[usize] = []
            sort_slots.resize(sort_capacity)
            for slot in 0..<sort_capacity |slot, sort_slots, sort_capacity, work|:
                return false if not proof_replay_equality_work_charge(1, work)
                sort_slots[slot] <- sort_capacity
            for fact in facts |left_names, right_names, marker_result, sort_result, width_work, width_exhausted, work|:
                return false if not proof_replay_collect_name_equalities(fact, facts, marker_result.witnesses, sort_result.index, sort_names, sort_values, sort_hashes, sort_slots, left_names, right_names, work, &width_work, &width_exhausted)
            return false if width_exhausted
            return false if not proof_replay_equality_work_charge(sort_names.count, work)
            sort_vertex_indices: mutable darray[usize] = []
            sort_vertex_indices.resize(sort_names.count)
            for row in 0..<sort_names.count |row, sort_vertex_indices, sort_names, names, work|:
                return false if not proof_replay_equality_work_charge(1, work)
                sort_vertex_indices[row] <- sort_names.count
            for edge in 0..<left_names.count |left_names, right_names, sort_names, sort_hashes, sort_slots, sort_vertex_indices, names, edge_left, edge_right, work|:
                left_lookup: (complete: bool, found: bool, index: usize) = proof_replay_equality_sort_cache_index(left_names[edge], sort_names, sort_hashes, sort_slots, work)
                return false if not left_lookup.complete or not left_lookup.found
                left_index: usize = sort_vertex_indices[left_lookup.index]
                if left_index == sort_names.count:
                    return false if not proof_replay_equality_work_charge(1, work) or not proof_replay_equality_work_charge(sview_len(sort_names[left_lookup.index]), work)
                    names.push(sort_names[left_lookup.index])
                    left_index <- names.count - 1
                    sort_vertex_indices[left_lookup.index] <- left_index
                right_lookup: (complete: bool, found: bool, index: usize) = proof_replay_equality_sort_cache_index(right_names[edge], sort_names, sort_hashes, sort_slots, work)
                return false if not right_lookup.complete or not right_lookup.found
                right_index: usize = sort_vertex_indices[right_lookup.index]
                if right_index == sort_names.count:
                    return false if not proof_replay_equality_work_charge(1, work) or not proof_replay_equality_work_charge(sview_len(sort_names[right_lookup.index]), work)
                    names.push(sort_names[right_lookup.index])
                    right_index <- names.count - 1
                    sort_vertex_indices[right_lookup.index] <- right_index
                return false if not proof_replay_equality_work_charge(2, work)
                edge_left.push(left_index)
                edge_right.push(right_index)
            return true

        def proof_replay_close_equalities_with_work(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofReplayBound]&, work: mutable usize&) -> bool:
            result: (complete: bool, equal: bool) = proof_replay_close_equalities_with_name_relation(facts, bounds, "", "", work)
            result.complete

        def proof_replay_close_equalities_with_name_relation(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofReplayBound]&, left_name: sview, right_name: sview, work: mutable usize&) -> (complete: bool, equal: bool):
            query_relation: bool = left_name != "" or right_name != ""
            return (false, false) if query_relation and (left_name == "" or right_name == "")
            equal: mutable bool = query_relation and left_name == right_name
            return (false, false) if not proof_replay_equality_work_charge(bounds.count, work)
            staged_bounds: mutable darray[ProofReplayBound] = []
            staged_bounds.extend(bounds)
            left_names: mutable darray[sview] = []
            right_names: mutable darray[sview] = []
            names: mutable darray[sview] = []
            edge_left: mutable darray[usize] = []
            edge_right: mutable darray[usize] = []
            return (false, false) if not proof_replay_name_equality_graph(facts, &left_names, &right_names, &names, &edge_left, &edge_right, work)

            adjacency_heads: mutable darray[usize] = []
            adjacency_names: mutable darray[usize] = []
            adjacency_next: mutable darray[usize] = []
            return (false, false) if not proof_replay_alias_build_adjacency(names, edge_left, edge_right, &adjacency_heads, &adjacency_names, &adjacency_next, work)

            left_index: usize = names.count
            right_index: usize = names.count
            if query_relation and not equal:
                left_lookup: (complete: bool, index: usize) = proof_replay_alias_name_index(names, left_name, work)
                return (false, false) if not left_lookup.complete
                right_lookup: (complete: bool, index: usize) = proof_replay_alias_name_index(names, right_name, work)
                return (false, false) if not right_lookup.complete
                left_index <- left_lookup.index
                right_index <- right_lookup.index

            # Alias bounds are component properties. Merge each component once instead of
            # stopping after a fact-count-dependent number of propagation rounds; integer
            # adjacency traversal visits each alias edge only a constant number of times.
            visited: mutable darray[bool] = []
            return (false, false) if not proof_replay_equality_work_charge(names.count, work)
            for name_index in 0..<names.count |name_index, names, visited|:
                visited.push(false)
            for start in 0..<names.count |start, names, adjacency_heads, adjacency_names, adjacency_next, visited, staged_bounds, query_relation, left_index, right_index, equal, work|:
                return (false, false) if not proof_replay_equality_work_charge(1, work)
                continue if visited[start]
                queue: mutable darray[usize] = [start]
                members: mutable darray[usize] = []
                contains_left: mutable bool = false
                contains_right: mutable bool = false
                visited[start] <- true
                cursor: mutable usize = 0
                while cursor < queue.count |cursor, queue, members, adjacency_heads, adjacency_names, adjacency_next, visited, query_relation, left_index, right_index, contains_left, contains_right, work|:
                    return (false, false) if not proof_replay_equality_work_charge(1, work)
                    current: usize = queue[cursor]
                    members.push(current)
                    contains_left <- true if query_relation and current == left_index
                    contains_right <- true if query_relation and current == right_index
                    arc: mutable usize = adjacency_heads[current]
                    while arc != 0 |arc, adjacency_names, adjacency_next, queue, visited, work|:
                        return (false, false) if not proof_replay_equality_work_charge(1, work)
                        arc_index: usize = arc - 1
                        neighbor: usize = adjacency_names[arc_index]
                        if not visited[neighbor]:
                            visited[neighbor] <- true
                            queue.push(neighbor)
                        arc <- adjacency_next[arc_index]
                    cursor <- cursor + 1

                equal <- true if contains_left and contains_right

                has_lower: mutable bool = false
                lower: mutable i64 = 0
                has_upper: mutable bool = false
                upper: mutable i64 = 0
                for member in members |member, members, names, staged_bounds, has_lower, lower, has_upper, upper, work|:
                    return (false, false) if not proof_replay_equality_work_charge(1, work)
                    bound_lookup: (complete: bool, index: usize) = proof_replay_bound_index_with_work(staged_bounds, names[member], work)
                    return (false, false) if not bound_lookup.complete
                    bound_index: usize = bound_lookup.index
                    continue if bound_index == staged_bounds.count
                    bound: ProofReplayBound = staged_bounds[bound_index]
                    if bound.has_lower and (not has_lower or bound.lower > lower):
                        has_lower <- true
                        lower <- bound.lower
                    if bound.has_upper and (not has_upper or bound.upper < upper):
                        has_upper <- true
                        upper <- bound.upper

                for member in members |member, members, names, staged_bounds, has_lower, lower, has_upper, upper, work|:
                    return (false, false) if not proof_replay_equality_work_charge(1, work)
                    return (false, false) if:
                        has_lower and not proof_replay_add_lower_with_work(staged_bounds, names[member], lower, work)
                        has_upper and not proof_replay_add_upper_with_work(staged_bounds, names[member], upper, work)
            return (false, false) if not proof_replay_equality_work_charge(staged_bounds.count, work)
            bounds.clear()
            bounds.extend(staged_bounds)
            (true, equal)
