extend ElisaProof:
    private:
        const PROOF_REPLAY_THREAD_DEPTH_LIMIT: usize = 96

        struct ProofReplayThreading:
            valid: mutable bool
            parameters: mutable darray[sview]
            slots: mutable darray[usize]
            symbols: mutable darray[sview]

        def proof_replay_threading_none(valid: bool) -> ProofReplayThreading:
            return ProofReplayThreading{valid: valid, parameters: [], slots: [], symbols: []}

        def proof_replay_thread_name_compare_work_charge(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work <- work + 1
            return false if sview_len(left) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + sview_len(left)
            return false if sview_len(right) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + sview_len(right)
            return true
