# Checked cost reservations for the legacy local-name/write visitors. A write query may inspect
# every source function signature once for each call argument that could lend the queried place.
extend ElisaProof:
    private:
        def proof_replay_source_touch_lookup_cost(declarations: darray[Ast::Decl]&, cost: mutable usize&, comparison_slots: mutable usize&, work: usize, depth: usize) -> bool:
            if depth >= ProofReplaySourceLocal::DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or cost >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                return false
            cost <- cost + 1
            return false if declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work - cost
            cost <- cost + declarations.count
            for declaration in declarations |cost, comparison_slots, work, depth|:
                match declaration:
                    Ast::Decl.Func(name, parameters, _, _, _, _, _):
                        return false if comparison_slots >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - comparison_slots - 1
                        comparison_slots <- comparison_slots + 1 + parameters.count
                        return false if not proof_replay_summary_expr_cost_add(cost, work, sview_len(name))
                        return false if parameters.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work - cost
                        cost <- cost + parameters.count
                        for parameter in parameters |parameter, cost, work, depth|:
                            return false if not proof_replay_summary_expr_cost_add(cost, work, sview_len(parameter.name))
                            return false if not proof_replay_summary_expr_cost(parameter.type_expression, cost, work, depth + 1)
                    Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if comparison_slots >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        comparison_slots <- comparison_slots + 1
                        return false if not proof_replay_summary_expr_cost_add(cost, work, sview_len(name))
                    Ast::Decl.Module(name, nested, _):
                        return false if not proof_replay_summary_expr_cost_add(cost, work, sview_len(name))
                        return false if not proof_replay_source_touch_lookup_cost(nested, cost, comparison_slots, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_source_touch_lookup_cost(nested, cost, comparison_slots, work, depth + 1)
                    _:
                        pass
            return true

        # The legacy visitor may walk place roots separately from its structural body walk.
        # This prepass counts root nodes, returned root-name bytes, zero-argument selector checks,
        # and call slots rooted at the queried local so flat bodies need no depth-cap multiplier.
        def proof_replay_source_touch_work_charge(amount: usize, work: mutable usize&) -> bool:
            if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            work <- work + amount
            return true

        def proof_replay_source_touch_place_root_with_work(expression: Ast::Expr, depth: usize, root_walk_cost: mutable usize&, root_extra_cost: mutable usize&, work: mutable usize&) -> (ok: bool, root: sview):
            return (true, "") if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            return (false, "") if not proof_replay_source_touch_work_charge(1, work)
            if root_walk_cost >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                return (false, "") if not proof_replay_source_touch_reservation_exhaust(work)
            root_walk_cost <- root_walk_cost + 1
            match expression:
                Ast::Expr.Ident(name, _):
                    root_bytes: usize = sview_len(name)
                    if root_extra_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or root_bytes > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - root_extra_cost:
                        return (false, "") if not proof_replay_source_touch_reservation_exhaust(work)
                    root_extra_cost <- root_extra_cost + root_bytes
                    return (false, "") if not proof_replay_source_touch_work_charge(root_bytes, work)
                    return (true, name)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Index(object, _, _) | Ast::Expr.Paren(object, _) | Ast::Expr.Move(object, _):
                    return proof_replay_source_touch_place_root_with_work(object, depth + 1, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Slice(object, _, _, _) | Ast::Expr.IndexN(object, _, _):
                    return proof_replay_source_touch_place_root_with_work(object, depth + 1, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Unary(_, inner, _):
                    return proof_replay_source_touch_place_root_with_work(inner, depth + 1, root_walk_cost, root_extra_cost, work)
                _:
                    return (true, "")

        def proof_replay_source_touch_candidate_count_expr_with_root_work(expression: Ast::Expr, name: sview, writes: bool, depth: usize, candidate_count: mutable usize&, query_bytes: mutable usize&, root_walk_cost: mutable usize&, root_extra_cost: mutable usize&, work: mutable usize&) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            return false if not proof_replay_source_touch_work_charge(1, work)
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    callee_name: sview = proof_replay_source_callee_name(callee)
                    receiver_touches: mutable bool = false
                    if writes:
                        match callee:
                            Ast::Expr.Field(receiver, method, _):
                                if arguments.count == 0:
                                    if root_extra_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or 64 > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - root_extra_cost:
                                        return false if not proof_replay_source_touch_reservation_exhaust(work)
                                    root_extra_cost <- root_extra_cost + 64
                                    return false if not proof_replay_source_touch_work_charge(64, work)
                                cast: bool = arguments.count == 0 and proof_replay_source_numeric_selector(method)
                                if not cast:
                                    receiver_root: (ok: bool, root: sview) = proof_replay_source_touch_place_root_with_work(receiver, depth + 2, root_walk_cost, root_extra_cost, work)
                                    return false if not receiver_root.ok
                                    return false if not proof_replay_source_touch_work_charge(sview_len(name), work)
                                    receiver_touches <- receiver_root.root == name
                            _:
                                pass
                    if receiver_touches:
                        return true
                    if writes:
                        for index in 0..<arguments.count |index, arguments, argument_names, name, callee_name, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work, depth, writes|:
                            argument: Ast::Expr = arguments[index]
                            return false if not proof_replay_source_touch_work_charge(1, work)
                            root: (ok: bool, root: sview) = proof_replay_source_touch_place_root_with_work(argument, depth + 2, root_walk_cost, root_extra_cost, work)
                            return false if not root.ok
                            return false if not proof_replay_source_touch_work_charge(sview_len(name), work)
                            if callee_name != "" and root.root == name:
                                return false if candidate_count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                candidate_count <- candidate_count + 1
                                argument_name: sview = argument_names[index] if index < argument_names.count else ""
                                callee_bytes: usize = sview_len(callee_name)
                                argument_name_bytes: usize = sview_len(argument_name)
                                return false if not proof_replay_source_touch_work_charge(callee_bytes, work)
                                query_bytes <- query_bytes + callee_bytes
                                return false if not proof_replay_source_touch_work_charge(argument_name_bytes, work)
                                query_bytes <- query_bytes + argument_name_bytes
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(callee, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    for argument in arguments |argument, name, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work, depth, writes|:
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(argument, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return true
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    return true if writes
                    for candidate in candidates |candidate, name, writes, depth, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work|:
                        return false if not proof_replay_source_touch_work_charge(1, work)
                        for capture in candidate.captures |capture, name, writes, depth, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work|:
                            return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(capture, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    for argument in arguments |argument, name, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work, depth, writes|:
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(argument, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return true
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Paren(object, _):
                    return proof_replay_source_touch_candidate_count_expr_with_root_work(object, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(object, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return proof_replay_source_touch_candidate_count_expr_with_root_work(index, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(object, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(low, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return proof_replay_source_touch_candidate_count_expr_with_root_work(high, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(object, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    for argument in arguments |argument, name, candidate_count, query_bytes, work, depth, writes, root_walk_cost, root_extra_cost|:
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(argument, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return true
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |element, name, candidate_count, query_bytes, work, depth, writes, root_walk_cost, root_extra_cost|:
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(element, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, name, candidate_count, query_bytes, work, depth, writes, root_walk_cost, root_extra_cost|:
                        return false if not proof_replay_source_touch_work_charge(1, work)
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(entry.key, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(entry.value, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return true
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(base, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    for field in fields |field, name, candidate_count, query_bytes, work, depth, writes, root_walk_cost, root_extra_cost|:
                        return false if not proof_replay_source_touch_work_charge(1, work)
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(field.value, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return true
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(subject, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    for arm in arms |arm, name, candidate_count, query_bytes, work, depth, writes, root_walk_cost, root_extra_cost|:
                        return false if not proof_replay_source_touch_work_charge(1, work)
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(arm.guard, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                        return false if not proof_replay_source_touch_candidate_count_body_with_root_work(arm.body, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return true
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(iterable, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(condition, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return proof_replay_source_touch_candidate_count_expr_with_root_work(body, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Unary(operator, inner, _):
                    lend: bool = operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    if writes and lend:
                        root: (ok: bool, root: sview) = proof_replay_source_touch_place_root_with_work(inner, depth + 1, root_walk_cost, root_extra_cost, work)
                        return false if not root.ok
                        return false if not proof_replay_source_touch_work_charge(sview_len(name), work)
                    return proof_replay_source_touch_candidate_count_expr_with_root_work(inner, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    if writes:
                        root: (ok: bool, root: sview) = proof_replay_source_touch_place_root_with_work(inner, depth + 1, root_walk_cost, root_extra_cost, work)
                        return false if not root.ok
                        return false if not proof_replay_source_touch_work_charge(sview_len(name), work)
                    return proof_replay_source_touch_candidate_count_expr_with_root_work(inner, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(guarded, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return proof_replay_source_touch_candidate_count_body_with_root_work(recovery, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Lambda(_, body, _):
                    return proof_replay_source_touch_candidate_count_body_with_root_work(body, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_source_touch_candidate_count_body_with_root_work(statements, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    return proof_replay_source_touch_candidate_count_expr_with_root_work(value, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                Ast::Expr.Absent | Ast::Expr.Invalid | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return true
                _:
                    return proof_replay_source_touch_reservation_exhaust(work)

        def proof_replay_source_touch_candidate_count_body_with_root_work(body: darray[Ast::Stmt]&, name: sview, writes: bool, depth: usize, candidate_count: mutable usize&, query_bytes: mutable usize&, root_walk_cost: mutable usize&, root_extra_cost: mutable usize&, work: mutable usize&) -> bool:
            return true if depth >= ProofReplaySourceLocal::DEPTH_LIMIT
            for statement in body |statement, name, depth, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work, writes|:
                return false if not proof_replay_source_touch_work_charge(1, work)
                match statement:
                    Ast::Stmt.Invalid | Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(expression, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    Ast::Stmt.VarDecl(_, _, value, _):
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(value, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    Ast::Stmt.Assign(target, _, value, _):
                        root: (ok: bool, root: sview) = proof_replay_source_touch_place_root_with_work(target, 0, root_walk_cost, root_extra_cost, work)
                        return false if not root.ok
                        return false if not proof_replay_source_touch_work_charge(sview_len(name), work)
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(target, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(value, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(returned, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    Ast::Stmt.If(condition, yes, no, _):
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(condition, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                        return false if not proof_replay_source_touch_candidate_count_body_with_root_work(yes, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                        return false if not proof_replay_source_touch_candidate_count_body_with_root_work(no, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    Ast::Stmt.While(condition, nested, _):
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(condition, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                        return false if not proof_replay_source_touch_candidate_count_body_with_root_work(nested, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(iterable, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                        return false if not proof_replay_source_touch_candidate_count_body_with_root_work(nested, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    Ast::Stmt.Match(subject, arms, _):
                        return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(subject, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                        for arm in arms |arm, name, depth, candidate_count, query_bytes, work, writes, root_walk_cost, root_extra_cost|:
                            return false if not proof_replay_source_touch_work_charge(1, work)
                            return false if not proof_replay_source_touch_candidate_count_expr_with_root_work(arm.guard, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                            return false if not proof_replay_source_touch_candidate_count_body_with_root_work(arm.body, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_source_touch_candidate_count_body_with_root_work(nested, name, writes, depth + 1, candidate_count, query_bytes, root_walk_cost, root_extra_cost, work)
                    _:
                        return proof_replay_source_touch_reservation_exhaust(work)
            return true

        def proof_replay_source_touch_reservation_exhaust(work: mutable usize&) -> bool:
            # The cost walks below are preflights, so a failed one must still consume the shared
            # allowance. Otherwise each later local query could repeat the same oversized walk.
            work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
            return false

        def proof_replay_source_touch_query_reserve(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, writes: bool, work: mutable usize&) -> bool:
            return proof_replay_source_touch_reservation_exhaust(work) if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            body_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_body(body, &body_cost, work, 0):
                return proof_replay_source_touch_reservation_exhaust(work)
            if body_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                return proof_replay_source_touch_reservation_exhaust(work)
            candidate_count: mutable usize = 0
            query_bytes: mutable usize = 0
            root_walk_cost: mutable usize = 0
            root_extra_cost: mutable usize = 0
            if body_cost != 0:
                if not proof_replay_source_touch_candidate_count_body_with_root_work(body, name, writes, 0, &candidate_count, &query_bytes, &root_walk_cost, &root_extra_cost, work):
                    return proof_replay_source_touch_reservation_exhaust(work)
                if candidate_count > body_cost:
                    return proof_replay_source_touch_reservation_exhaust(work)
            lookup_cost: mutable usize = 0
            lookup_comparison_slots: mutable usize = 0
            if candidate_count != 0:
                if not proof_replay_source_touch_lookup_cost(declarations, &lookup_cost, &lookup_comparison_slots, work + body_cost, 0):
                    return proof_replay_source_touch_reservation_exhaust(work)
                if lookup_comparison_slots > lookup_cost:
                    return proof_replay_source_touch_reservation_exhaust(work)
            remaining: mutable usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            name_bytes: usize = sview_len(name)
            if name_bytes >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                return proof_replay_source_touch_reservation_exhaust(work)
            name_scale: usize = name_bytes + 1
            if body_cost > remaining / name_scale:
                return proof_replay_source_touch_reservation_exhaust(work)
            body_work: mutable usize = body_cost * name_scale
            remaining <- remaining - body_work
            # The charged prepass measures repeated place-root paths, including assignment
            # targets, call receivers, call arguments, lends, and moves.
            if root_walk_cost > remaining / name_scale:
                return proof_replay_source_touch_reservation_exhaust(work)
            root_work: usize = root_walk_cost * name_scale
            remaining <- remaining - root_work
            body_work <- body_work + root_work
            # Root source-name bytes and numeric-selector checks have work beyond the node visits.
            # Reserve that measured auxiliary cost on every repeated runtime pass.
            if root_extra_cost > remaining:
                return proof_replay_source_touch_reservation_exhaust(work)
            remaining <- remaining - root_extra_cost
            body_work <- body_work + root_extra_cost
            # The bounded cost walk that sizes the reservation is itself a full body pass.
            if body_cost > remaining:
                return proof_replay_source_touch_reservation_exhaust(work)
            remaining <- remaining - body_cost
            lookup_work: mutable usize = 0
            if candidate_count != 0:
                if lookup_cost > remaining:
                    return proof_replay_source_touch_reservation_exhaust(work)
                remaining <- remaining - lookup_cost
                lookup_query_work: mutable usize = 0
                if lookup_comparison_slots != 0:
                    # The candidate census counts the callee name once per rooted argument,
                    # since the source lookup repeats that comparison for each such argument.
                    if query_bytes > remaining / lookup_comparison_slots:
                        return proof_replay_source_touch_reservation_exhaust(work)
                    lookup_query_work <- query_bytes * lookup_comparison_slots
                    remaining <- remaining - lookup_query_work
                if lookup_cost != 0 and candidate_count > remaining / lookup_cost:
                    return proof_replay_source_touch_reservation_exhaust(work)
                lookup_work <- lookup_query_work + candidate_count * lookup_cost
            work <- work + body_work
            work <- work + body_cost
            work <- work + lookup_cost if candidate_count != 0
            work <- work + lookup_work
            return true

        def proof_replay_source_body_declares_with_work(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, work: mutable usize&) -> bool:
            return true if not proof_replay_source_touch_query_reserve(declarations, body, name, false, work)
            proof_replay_source_body_declares(declarations, body, name)

        def proof_replay_source_body_touches_with_work(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, writes: bool, work: mutable usize&) -> bool:
            return true if not proof_replay_source_touch_query_reserve(declarations, body, name, writes, work)
            proof_replay_source_body_touches(declarations, body, name, writes, 0)

        def proof_replay_source_single_declaration_with_work(declarations: darray[Ast::Decl]&, body: darray[Ast::Stmt]&, name: sview, work: mutable usize&) -> bool:
            return false if not proof_replay_source_touch_query_reserve(declarations, body, name, false, work)
            proof_replay_source_single_declaration(declarations, body, name)
