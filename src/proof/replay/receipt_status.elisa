# Source-authority and low-trust replay receipt queries.
extend ElisaProof:
    public:
        def proof_replay_receipt_is_issued[@r](receipt: ProofReplayReceipt[r]) -> bool:
            receipt.issued

        # A source-bound receipt is complete only when kernel replay and all source/admission
        # snapshots completed for the whole report. `kernel_batch_complete` is the narrower
        # diagnostic for raw certificate replay.
        def proof_replay_receipt_is_complete[@r](receipt: ProofReplayReceipt[r]) -> bool:
            return false if:
                not receipt.issued or not receipt.source_bound or not receipt.source_validated or not receipt.complete
                not receipt.source_admission_snapshot_complete or not receipt.source_goal_statuses_complete or not receipt.source_attempt_fact_statuses_complete
                not receipt.source_claims_admissible or not receipt.source_report_complete or not receipt.source_report_admissible
                receipt.source_goal_statuses.count != receipt.attempt_proven_statuses.count
                receipt.source_attempt_fact_statuses.count != receipt.attempt_proven_statuses.count
            true

        # Explicitly low-trust diagnostic for the standalone compatibility API. This says only
        # that the kernel replay batch completed; it does not bind the results to source.
        def proof_replay_receipt_kernel_batch_complete[@r](receipt: ProofReplayReceipt[r]) -> bool:
            receipt.issued and receipt.complete

        def proof_replay_receipt_source_validated[@r](receipt: ProofReplayReceipt[r]) -> bool:
            receipt.issued and receipt.source_bound and receipt.source_validated

        def proof_replay_receipt_attempt_count[@r](receipt: ProofReplayReceipt[r]) -> usize:
            return 0 if not receipt.issued
            receipt.attempt_statuses.count

        def proof_replay_receipt_certificate_count[@r](receipt: ProofReplayReceipt[r]) -> usize:
            return 0 if not receipt.issued
            receipt.certificate_statuses.count

        def proof_replay_receipt_gap_count[@r](receipt: ProofReplayReceipt[r]) -> (available: bool, count: u32):
            return (false, 0) if not receipt.issued
            (true, receipt.replay_gap_count)

        # Kernel replay status only; source obligation and attached-fact admission are checked by
        # `proof_replay_receipt_attempt_is_proven`.
        def proof_replay_receipt_attempt_status[@r](receipt: ProofReplayReceipt[r], attempt_index: usize) -> bool:
            return false if not receipt.issued or not receipt.source_bound or not receipt.source_validated or attempt_index >= receipt.attempt_statuses.count
            receipt.attempt_statuses[attempt_index]

        # Low-trust standalone replay diagnostic. Callers must not use this as proof that a
        # source-level obligation was established; proof_checked_view_attempt_is_proven is the
        # source-authorized query.
        def proof_replay_receipt_kernel_attempt_status[@r](receipt: ProofReplayReceipt[r], attempt_index: usize) -> bool:
            return false if not receipt.issued or attempt_index >= receipt.attempt_statuses.count
            receipt.attempt_statuses[attempt_index]

        def proof_replay_receipt_attempt_is_proven[@r](receipt: ProofReplayReceipt[r], attempt_index: usize) -> bool:
            return false if:
                not receipt.issued or not receipt.source_bound or not receipt.source_validated
                not receipt.source_goal_statuses_complete or not receipt.source_attempt_fact_statuses_complete
                receipt.source_goal_statuses.count != receipt.attempt_proven_statuses.count
                receipt.source_attempt_fact_statuses.count != receipt.attempt_proven_statuses.count
                attempt_index >= receipt.attempt_proven_statuses.count
                attempt_index >= receipt.source_goal_statuses.count or attempt_index >= receipt.source_attempt_fact_statuses.count
                not receipt.source_goal_statuses[attempt_index] or not receipt.source_attempt_fact_statuses[attempt_index]
            receipt.attempt_proven_statuses[attempt_index]

        # Kernel certificate status only; it does not imply source premise admission.
        def proof_replay_receipt_certificate_status[@r](receipt: ProofReplayReceipt[r], certificate_index: usize) -> bool:
            return false if not receipt.issued or not receipt.source_bound or not receipt.source_validated or certificate_index >= receipt.certificate_statuses.count
            receipt.certificate_statuses[certificate_index]

        # Low-trust standalone replay diagnostic; use a checked view for source-authorized
        # certificate status.
        def proof_replay_receipt_kernel_certificate_status[@r](receipt: ProofReplayReceipt[r], certificate_index: usize) -> bool:
            return false if not receipt.issued or certificate_index >= receipt.certificate_statuses.count
            receipt.certificate_statuses[certificate_index]

        def proof_replay_receipt_attempt_statuses_with_work[@r](receipt: ProofReplayReceipt[r], replayed: mutable darray[bool]&, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            replayed.clear()
            return false if not receipt.issued or not receipt.source_bound or not receipt.source_validated or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or receipt.attempt_statuses.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + receipt.attempt_statuses.count
            for status in receipt.attempt_statuses |replayed|:
                replayed.push(status)
            return true

        def proof_replay_receipt_certificate_statuses_with_work[@r](receipt: ProofReplayReceipt[r], replayed: mutable darray[bool]&, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            replayed.clear()
            return false if not receipt.issued or not receipt.source_bound or not receipt.source_validated or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or receipt.certificate_statuses.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + receipt.certificate_statuses.count
            for status in receipt.certificate_statuses |replayed|:
                replayed.push(status)
            return true

        def proof_replay_receipt_certificate_statuses_and_count_with_work[@r](receipt: ProofReplayReceipt[r], replayed: mutable darray[bool]&, replayed_count: mutable u32&, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            replayed.clear()
            replayed_count <- 0
            return false if not receipt.issued or not receipt.source_bound or not receipt.source_validated or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or receipt.certificate_statuses.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + receipt.certificate_statuses.count
            for status in receipt.certificate_statuses |replayed, replayed_count|:
                replayed.push(status)
                replayed_count <- replayed_count + 1 if status
            return true
