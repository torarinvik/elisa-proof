# Recover one named tuple component from a callee's parser-origin return type.
extend ElisaProof:
    private:
        def proof_replay_type_bound_tuple_projection_type_with_work(return_type: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, requested: sview, work: mutable usize&) -> (complete: bool, element: Ast::Expr):
            return (false, Ast::Expr.Invalid) if requested == "" or not proof_replay_type_bound_local_work_charge(sview_len(requested), work)
            match return_type:
                Ast::Expr.Tuple(elements, tuple_position):
                    lower: mutable Ast::Pos = tuple_position
                    selected: mutable Ast::Expr = Ast::Expr.Invalid
                    selected_count: mutable usize = 0
                    labels: mutable darray[sview] = []
                    for element in elements |element, lower, annotations, requested, selected, selected_count, labels, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                        upper: Ast::Pos = Ast::expr_pos(element)
                        found: mutable sview = ""
                        candidates: mutable usize = 0
                        for annotation in annotations |annotation, lower, upper, found, candidates, work|:
                            return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(1, work)
                            return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_text_compare_charge(annotation.owner, "__tuple_label", work)
                            continue if annotation.owner != "__tuple_label" or annotation.line < lower.line or annotation.line > upper.line
                            continue if annotation.offset < lower.offset or annotation.offset >= upper.offset
                            return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                            found <- annotation.name
                            candidates <- candidates + 1
                        return (false, Ast::Expr.Invalid) if candidates != 1 or found == ""
                        for prior in labels |prior, found, work|:
                            return (false, Ast::Expr.Invalid) if not proof_replay_type_bound_local_text_compare_charge(prior, found, work)
                            return (false, Ast::Expr.Invalid) if prior == found
                        labels.push(found)
                        if found == requested:
                            selected <- element
                            selected_count <- selected_count + 1
                        lower <- upper
                    return (false, Ast::Expr.Invalid) if selected_count != 1
                    return (true, selected)
                _:
                    (false, Ast::Expr.Invalid)
