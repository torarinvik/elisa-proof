# Recover source-backed scalar type facts from exactly resolved function return types.
extend ElisaProof:
    private:
        # Import annotations are module scoped. A wildcard or same-named selective import
        # blocks a bare name only in its module and descendants, not in unrelated modules.
        def proof_replay_type_bound_import_name_shadowed_with_work(annotations: darray[Ast::EnumAnnotation]&, resolution_scope: darray[sview]&, wanted: sview, module_alias_only: bool, work: mutable usize&) -> (complete: bool, shadowed: bool):
            for index in 0..<annotations.count |index, annotations, resolution_scope, wanted, work|:
                annotation: Ast::EnumAnnotation = annotations[index]
                return (false, false) if:
                    not proof_replay_type_bound_local_work_charge(1, work)
                    not proof_replay_type_bound_local_text_compare_charge(annotation.name, "__binding_wildcard_import", work)
                wildcard: bool = annotation.name == "__binding_wildcard_import"
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.name, "__using_alias_target", work)
                if annotation.name == "__using_alias_target":
                    return (false, false) if index == 0
                    previous: Ast::EnumAnnotation = annotations[index - 1]
                    return (false, false) if:
                        not proof_replay_type_bound_local_work_charge(1, work)
                        not proof_replay_type_bound_local_text_compare_charge(previous.name, "__using_alias", work)
                        not proof_replay_type_bound_local_text_compare_charge(previous.module, annotation.module, work)
                        previous.name != "__using_alias" or previous.line != annotation.line or previous.offset != annotation.offset or previous.module != annotation.module or previous.owner == ""
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.owner, "__from_member", work)
                selective_owner: bool = annotation.owner == "__from_member"
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.name, "__using_alias", work)
                module_alias: bool = annotation.name == "__using_alias"
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.name, "__using_member", work)
                using_member: bool = annotation.name == "__using_member"
                if using_member:
                    continue if module_alias_only
                    return (false, false) if not proof_replay_type_bound_local_text_compare_charge(annotation.module, wanted, work)
                    if annotation.module == wanted:
                        return (false, false) if index < 2
                        pair: Ast::EnumAnnotation = annotations[index - 2]
                        source: Ast::EnumAnnotation = annotations[index - 1]
                        return (false, false) if:
                            not proof_replay_type_bound_local_work_charge(2, work)
                            not proof_replay_type_bound_local_text_compare_charge(pair.owner, "__from_member", work)
                            not proof_replay_type_bound_local_text_compare_charge(pair.name, wanted, work)
                            not proof_replay_type_bound_local_text_compare_charge(source.owner, "__from_src", work)
                            not proof_replay_type_bound_local_text_compare_charge(source.module, pair.module, work)
                            not proof_replay_type_bound_local_text_compare_charge(annotation.owner, source.name, work)
                            pair.owner != "__from_member" or pair.name != wanted or pair.line != annotation.line or pair.offset != annotation.offset
                            source.owner != "__from_src" or source.name == "" or source.module != pair.module or source.line != annotation.line or source.offset != annotation.offset
                            annotation.owner != source.name
                        empty_scope: darray[sview] = []
                        pair_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(empty_scope, pair.module, work)
                        return (false, false) if not pair_scope.complete or pair_scope.scope.count > resolution_scope.count
                        visible: mutable bool = true
                        for scope_index in 0..<pair_scope.scope.count |scope_index, pair_scope, resolution_scope, visible, work|:
                            return (false, false) if not proof_replay_type_bound_local_text_compare_charge(pair_scope.scope[scope_index], resolution_scope[scope_index], work)
                            visible <- false if pair_scope.scope[scope_index] != resolution_scope[scope_index]
                        # A valid selective `using` has a scoped __from_member partner.
                        # Missing pair metadata cannot be used to bypass the import guard.
                        return (true, true) if visible
                relevant: bool = module_alias if module_alias_only else wildcard or selective_owner
                continue if not relevant
                empty_scope: darray[sview] = []
                imported_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(empty_scope, annotation.module, work)
                return (false, false) if not imported_scope.complete or imported_scope.scope.count > resolution_scope.count
                visible: mutable bool = true
                for index in 0..<imported_scope.scope.count |index, imported_scope, resolution_scope, visible, work|:
                    return (false, false) if not proof_replay_type_bound_local_text_compare_charge(imported_scope.scope[index], resolution_scope[index], work)
                    visible <- false if imported_scope.scope[index] != resolution_scope[index]
                continue if not visible
                if module_alias:
                    return (false, false) if index == 0 or index + 1 >= annotations.count
                    using: Ast::EnumAnnotation = annotations[index - 1]
                    target: Ast::EnumAnnotation = annotations[index + 1]
                    return (false, false) if:
                        not proof_replay_type_bound_local_work_charge(2, work)
                        not proof_replay_type_bound_local_text_compare_charge(using.name, "__using", work)
                        not proof_replay_type_bound_local_text_compare_charge(target.name, "__using_alias_target", work)
                        not proof_replay_type_bound_local_text_compare_charge(target.module, annotation.module, work)
                        not proof_replay_type_bound_local_text_compare_charge(target.owner, using.owner, work)
                        using.name != "__using" or target.name != "__using_alias_target" or using.owner == "" or annotation.owner == "" or target.owner != using.owner
                        using.line != annotation.line or target.line != annotation.line or using.offset >= annotation.offset or target.offset != annotation.offset
                        target.module != annotation.module
                return (true, true) if wildcard
                imported_name: sview = annotation.owner if module_alias else annotation.name
                return (false, false) if not proof_replay_type_bound_local_text_compare_charge(imported_name, wanted, work)
                return (true, true) if imported_name == wanted
            return (true, false)

        def proof_replay_type_bound_declaration_scope_from_index_with_work(declarations: darray[Ast::Decl]&, index: ProofReplayDeterministicDeclarationIndex&, declaration_row: usize, work: mutable usize&) -> (complete: bool, scope: darray[sview], declaration: Ast::Decl):
            return (false, [], Ast::Decl.Invalid) if declaration_row >= index.entries.count
            entry: ProofReplayDeterministicDeclarationEntry = index.entries[declaration_row]
            return (false, [], Ast::Decl.Invalid) if:
                entry.declaration_path_count == 0 or entry.declaration_path_start > index.declaration_path.count
                entry.declaration_path_count > index.declaration_path.count - entry.declaration_path_start
                not proof_replay_type_bound_local_work_charge(entry.declaration_path_count, work)
            current_declarations: mutable darray[Ast::Decl] = declarations
            current_scope: mutable darray[sview] = []
            for path_depth in 0..<entry.declaration_path_count |path_depth, entry, index, current_declarations, current_scope, work|:
                path_offset: usize = entry.declaration_path_start + path_depth
                declaration_index: usize = index.declaration_path[path_offset]
                return (false, [], Ast::Decl.Invalid) if declaration_index >= current_declarations.count
                declaration: Ast::Decl = current_declarations[declaration_index]
                if path_depth + 1 == entry.declaration_path_count:
                    match declaration:
                        Ast::Decl.Func(name, _, _, _, _, _, position):
                            selected_position: mutable Ast::Pos = Ast::pos_at_line(0)
                            match entry.declaration:
                                Ast::Decl.Func(_, _, _, _, _, _, selected):
                                    selected_position <- selected
                                _:
                                    pass
                            return (false, [], Ast::Decl.Invalid) if:
                                selected_position.line == 0
                                not proof_replay_type_bound_local_text_compare_charge(name, entry.name, work)
                                name != entry.name
                                position.line != selected_position.line or position.offset != selected_position.offset
                            return (true, current_scope, declaration)
                        Ast::Decl.Const(name, _, _, _, position):
                            selected_position: mutable Ast::Pos = Ast::pos_at_line(0)
                            match entry.declaration:
                                Ast::Decl.Const(_, _, _, _, selected):
                                    selected_position <- selected
                                _:
                                    pass
                            return (false, [], Ast::Decl.Invalid) if:
                                selected_position.line == 0
                                not proof_replay_type_bound_local_text_compare_charge(name, entry.name, work)
                                name != entry.name
                                position.line != selected_position.line or position.offset != selected_position.offset
                            return (true, current_scope, declaration)
                        _:
                            return (false, [], Ast::Decl.Invalid)
                match declaration:
                    Ast::Decl.Module(module_name, nested, _):
                        nested_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(current_scope, module_name, work)
                        return (false, [], Ast::Decl.Invalid) if not nested_scope.complete
                        current_scope <- nested_scope.scope
                        current_declarations <- nested
                    Ast::Decl.Scoped(nested, _):
                        current_declarations <- nested
                    _:
                        return (false, [], Ast::Decl.Invalid)
            return (false, [], Ast::Decl.Invalid)
        def proof_replay_type_bound_call_builtin_shape_with_work(report: ProofReport&, name: sview, resolution_scope: darray[sview]&, signed_width: i64, unsigned_width: i64, work: mutable usize&) -> (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64):
            return (true, signed_width, unsigned_width, 1)
        # Primitive spellings are few and fixed. Charge each attempted comparison with its
        # dispatch and both string lengths, matching proof_replay_type_bound_local_text_compare_charge.
        def proof_replay_type_bound_call_primitive_shape_with_work(report: ProofReport&, name: sview, resolution_scope: darray[sview]&, work: mutable usize&) -> (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64):
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "i8", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, ElisaProofKernelCore::PROOF_KERNEL_I8_WIDTH, 0, work) if name == "i8"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "i16", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, ElisaProofKernelCore::PROOF_KERNEL_I16_WIDTH, 0, work) if name == "i16"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "i32", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, ElisaProofKernelCore::PROOF_KERNEL_I32_WIDTH, 0, work) if name == "i32"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "i64", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, ElisaProofKernelCore::PROOF_KERNEL_I64_WIDTH, 0, work) if name == "i64"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "isize", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, ElisaProofKernelCore::PROOF_KERNEL_I64_WIDTH, 0, work) if name == "isize"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "int", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, ElisaProofKernelCore::PROOF_KERNEL_I64_WIDTH, 0, work) if name == "int"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "u8", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, 0, ElisaProofKernelCore::PROOF_KERNEL_U8_WIDTH, work) if name == "u8"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "u16", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, 0, ElisaProofKernelCore::PROOF_KERNEL_U16_WIDTH, work) if name == "u16"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "u32", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, 0, ElisaProofKernelCore::PROOF_KERNEL_U32_WIDTH, work) if name == "u32"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "u64", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, 0, ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS, work) if name == "u64"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "usize", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, 0, ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS, work) if name == "usize"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "uintptr", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, 0, ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS, work) if name == "uintptr"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "bool", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, 0, 0, work) if name == "bool"
            return (false, -1, -1, -1) if not proof_replay_type_bound_local_text_compare_charge(name, "char", work)
            return proof_replay_type_bound_call_builtin_shape_with_work(report, name, resolution_scope, 0, 0, work) if name == "char"
            return (true, 0, 0, 0)

        def proof_replay_type_bound_call_width_primitive(name: sview) -> bool:
            return name in {"i8", "i16", "i32", "i64", "isize", "int", "u8", "u16", "u32", "u64", "usize", "uintptr", "bool", "char"}

        def proof_replay_type_bound_call_named_shape_with_work(report: ProofReport&, name: sview, resolution_scope: darray[sview]&, exact_scope: bool, active_alias_offsets: mutable darray[usize]&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&, depth: usize) -> (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64):
            return (false, -1, -1, -1) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_type_name_charge(name, work)
            if not exact_scope and proof_replay_call_conversion_builtin_type_name(name):
                return proof_replay_type_bound_call_primitive_shape_with_work(report, name, resolution_scope, work) if proof_replay_type_bound_call_width_primitive(name)
                return (true, 0, 0, 0)
            best_depth: mutable usize = 0
            matches: mutable usize = 0
            kind: mutable i64 = 0
            alias_target: mutable Ast::Expr = Ast::Expr.Absent
            is_const_enum: mutable bool = false
            alias_line: mutable u32 = 0
            alias_offset: mutable usize = 0
            alias_owner: mutable darray[sview] = []
            current_scope: mutable darray[sview] = []
            opaque_classified: mutable bool = false
            opaque_policy: mutable i64 = 0
            complete: bool = proof_replay_type_bound_call_type_lookup_with_work(report, report.source.source_declarations, &current_scope, resolution_scope, name, exact_scope, &best_depth, &matches, &kind, &alias_target, &is_const_enum, &alias_line, &alias_offset, &alias_owner, &opaque_classified, &opaque_policy, work, 0)
            return (false, -1, -1, -1) if not complete or matches > 1
            # Rank 4/3 is an exact module alias/concrete type; rank 2/1 is a root
            # concrete type/alias. Import metadata must still be checked after root fallback.
            if not exact_scope and (matches == 0 or best_depth <= 2):
                import_shadow: (complete: bool, shadowed: bool) = proof_replay_type_bound_import_name_shadowed_with_work(report.source.source_annotations, resolution_scope, name, false, work)
                return (false, -1, -1, -1) if not import_shadow.complete or import_shadow.shadowed
            if matches == 0:
                if exact_scope:
                    return proof_replay_type_bound_call_primitive_shape_with_work(report, name, resolution_scope, work) if proof_replay_call_conversion_builtin_type_name(name)
                    return (false, -1, -1, -1)
                global_alias_count: mutable usize = 0
                concrete_count: mutable usize = 0
                global_alias_target: mutable Ast::Expr = Ast::Expr.Absent
                global_alias_line: mutable u32 = 0
                global_alias_offset: mutable usize = 0
                global_alias_owner: mutable darray[sview] = []
                empty_scope: mutable darray[sview] = []
                global_opaque_classified: mutable bool = false
                global_opaque_policy: mutable i64 = 0
                global_alias_complete: bool = proof_replay_type_bound_global_alias_lookup_with_work(report, report.source.source_declarations, report.source.source_annotations, &empty_scope, name, &global_alias_count, &concrete_count, &global_alias_target, &global_alias_line, &global_alias_offset, &global_alias_owner, &global_opaque_classified, &global_opaque_policy, work, 0)
                return (false, -1, -1, -1) if not global_alias_complete or concrete_count > 0
                if global_alias_count == 1 and not proof_replay_call_conversion_builtin_type_name(name):
                    formals: (complete: bool, has_formals: bool) = proof_replay_type_bound_enum_alias_has_formals_with_work(report, name, global_alias_line, global_alias_offset, work, cache)
                    return (false, -1, -1, -1) if not formals.complete or formals.has_formals
                    kind <- 1
                    matches <- 1
                    alias_target <- global_alias_target
                    alias_line <- global_alias_line
                    alias_offset <- global_alias_offset
                    owner_scope <- global_alias_owner
                else:
                    return proof_replay_type_bound_call_primitive_shape_with_work(report, name, resolution_scope, work)
            return (true, 0, 0, 0) if kind == 2 or kind == 3 and not is_const_enum
            return (true, 0, 0, 1) if kind == 3 and is_const_enum
            return (false, -1, -1, -1) if kind != 1 or alias_line == 0
            formals: (complete: bool, has_formals: bool) = proof_replay_type_bound_enum_alias_has_formals_with_work(report, name, alias_line, alias_offset, work, cache)
            return (false, -1, -1, -1) if not formals.complete or formals.has_formals
            for offset in active_alias_offsets |offset, alias_offset, work|:
                return (false, -1, -1, -1) if not proof_replay_type_bound_local_work_charge(1, work) or offset == alias_offset
            mark: usize = active_alias_offsets.count
            active_alias_offsets.push(alias_offset)
            resolved: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_call_type_shape_with_work(report, alias_target, alias_owner, active_alias_offsets, work, cache, depth + 1)
            active_alias_offsets.resize(mark)
            return resolved

        def proof_replay_type_bound_call_type_shape_with_work(report: ProofReport&, expression: Ast::Expr, resolution_scope: darray[sview]&, active_alias_offsets: mutable darray[usize]&, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&, depth: usize) -> (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64):
            return (false, -1, -1, -1) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_type_bound_call_type_shape_with_work(report, inner, resolution_scope, active_alias_offsets, work, cache, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        inner_shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_call_type_shape_with_work(report, inner, resolution_scope, active_alias_offsets, work, cache, depth + 1)
                        return (false, -1, -1, -1) if not inner_shape.complete
                        return (true, 0, 0, 0) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                        return inner_shape
                    return (true, 0, 0, 0)
                Ast::Expr.Ident(name, _):
                    return proof_replay_type_bound_call_named_shape_with_work(report, name, resolution_scope, false, active_alias_offsets, work, cache, depth + 1)
                Ast::Expr.Scope(head, _, _):
                    simple_module_head: bool = proof_replay_type_bound_call_simple_module_head(head)
                    segments: mutable darray[sview] = []
                    # Account for both the full AST cost census and the subsequent
                    # qualified-path extraction walk.
                    return (false, -1, -1, -1) if:
                        not proof_replay_summary_expr_charge_with_work(expression, work)
                        not proof_replay_summary_expr_charge_with_work(expression, work)
                        not proof_qualified_path_segments(expression, &segments, 0) or segments.count < 2
                    wanted_scope: mutable darray[sview] = []
                    for index in 0..<segments.count - 1 |index, segments, wanted_scope, work|:
                        return (false, -1, -1, -1) if not proof_replay_type_bound_local_type_name_charge(segments[index], work)
                        wanted_scope.push(segments[index])
                    leaf_name: sview = segments[segments.count - 1]
                    resolved_scope: (complete: bool, found: bool, scope: darray[sview]) = proof_replay_type_bound_call_qualified_module_scope_with_work(report, wanted_scope, leaf_name, resolution_scope, work)
                    return (false, -1, -1, -1) if not resolved_scope.complete
                    if resolved_scope.found:
                        return proof_replay_type_bound_call_named_shape_with_work(report, leaf_name, resolved_scope.scope, true, active_alias_offsets, work, cache, depth + 1)
                    return proof_replay_type_bound_call_named_shape_with_work(report, leaf_name, resolved_scope.scope, false, active_alias_offsets, work, cache, depth + 1) if simple_module_head
                    return (false, -1, -1, -1)
                _:
                    pass
            return (true, 0, 0, 0)
        # Generic parameters have no call-site substitution in this bounded witness. Follow
        # every type form that the scalar shape resolver treats as transparent and reject a
        # matching binder before a builtin spelling or alias can supply a width.
        def proof_replay_type_bound_call_type_has_generic_with_work(report: ProofReport&, expression: Ast::Expr, declaration_line: u32, declaration_offset: usize, declaration_offset_valid: bool, work: mutable usize&, depth: usize) -> (complete: bool, present: bool):
            return (false, false) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_type_bound_call_type_has_generic_with_work(report, inner, declaration_line, declaration_offset, declaration_offset_valid, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail:
                        return proof_replay_type_bound_call_type_has_generic_with_work(report, inner, declaration_line, declaration_offset, declaration_offset_valid, work, depth + 1)
                    return (true, false)
                Ast::Expr.Ident(name, _):
                    lookup: (complete: bool, count: usize) = proof_replay_type_bound_local_generic_name_count_with_work(report, name, declaration_line, declaration_offset, declaration_offset_valid, work)
                    return (false, false) if not lookup.complete
                    return (true, lookup.count > 0)
                Ast::Expr.Scope(_, _, _):
                    segments: mutable darray[sview] = []
                    # The raw path collector traverses the AST after this helper has already
                    # charged the outer node. Charge both its size walk and raw collection walk.
                    return (false, false) if:
                        not proof_replay_summary_expr_charge_with_work(expression, work)
                        not proof_replay_summary_expr_charge_with_work(expression, work)
                        not proof_qualified_path_segments(expression, &segments, 0) or segments.count < 2
                    for segment in segments |segment, declaration_line, declaration_offset, declaration_offset_valid, report, work|:
                        lookup: (complete: bool, count: usize) = proof_replay_type_bound_local_generic_name_count_with_work(report, segment, declaration_line, declaration_offset, declaration_offset_valid, work)
                        return (false, false) if not lookup.complete
                        return (true, true) if lookup.count > 0
                    return (true, false)
                _:
                    return (true, false)

        def proof_replay_type_bound_call_type_shape(report: ProofReport&, expression: Ast::Expr, resolution_scope: darray[sview]&, work: mutable usize&) -> (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64):
            active_alias_offsets: mutable darray[usize] = []
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            proof_replay_type_bound_call_type_shape_with_work(report, expression, resolution_scope, &active_alias_offsets, work, &cache, 0)
        def proof_replay_type_bound_find_callee_with_work(declarations: darray[Ast::Decl]&, wanted: sview, wanted_line: u32, wanted_offset: usize, exact_owner: bool, wanted_module_path: darray[sview]&, current_module_path: mutable darray[sview]&, matches: mutable usize&, return_type: mutable Ast::Expr&, formal_names: mutable darray[sview]&, formal_defaults: mutable darray[bool]&, complete: mutable bool&, work: mutable usize&, depth: usize) -> void:
            complete_now: mutable bool = proof_replay_summary_bool_ref_value(complete)
            if depth >= PROOF_REPLAY_GLOBAL_CONSTANT_SCOPE_DEPTH_LIMIT or not complete_now:
                complete <- false
                return
            for declaration in declarations |wanted, wanted_line, wanted_offset, exact_owner, wanted_module_path, current_module_path, matches, return_type, formal_names, formal_defaults, complete, complete_now, work, depth|:
                complete_now <- proof_replay_summary_bool_ref_value(complete)
                return if not complete_now or matches > 1
                if not proof_replay_type_bound_local_work_charge(1, work):
                    complete <- false
                    return
                match declaration:
                    Ast::Decl.Func(name, candidate_parameters, candidate_return_type, _, _, _, position):
                        if not proof_replay_type_bound_local_text_compare_charge(name, wanted, work):
                            complete <- false
                            return
                        path_matches: mutable bool = current_module_path.count == wanted_module_path.count
                        if path_matches:
                            for path_index in 0..<current_module_path.count |path_index, current_module_path, wanted_module_path, work, path_matches, complete|:
                                if not proof_replay_type_bound_local_work_charge(1, work) or not proof_replay_type_bound_local_text_compare_charge(current_module_path[path_index], wanted_module_path[path_index], work):
                                    complete <- false
                                    return
                                path_matches <- false if current_module_path[path_index] != wanted_module_path[path_index]
                        if name == wanted and position.line == wanted_line and (not exact_owner or position.offset.usize() == wanted_offset) and path_matches:
                            matches <- matches + 1
                            return_type <- candidate_return_type
                            for parameter in candidate_parameters |parameter, formal_names, formal_defaults, work, complete|:
                                if not proof_replay_type_bound_local_work_charge(1, work) or not proof_replay_type_bound_local_work_charge(sview_len(parameter.name), work):
                                    complete <- false
                                    return
                                formal_names.push(parameter.name)
                                formal_defaults.push(parameter.has_default)
                    Ast::Decl.Extern(_, _, _, _, _, _, _, _):
                        pass
                    Ast::Decl.Module(module_name, nested, _):
                        nested_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(current_module_path, module_name, work)
                        if not nested_scope.complete:
                            complete <- false
                            return
                        proof_replay_type_bound_find_callee_with_work(nested, wanted, wanted_line, wanted_offset, exact_owner, wanted_module_path, nested_scope.scope, matches, return_type, formal_names, formal_defaults, complete, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        proof_replay_type_bound_find_callee_with_work(nested, wanted, wanted_line, wanted_offset, exact_owner, wanted_module_path, current_module_path, matches, return_type, formal_names, formal_defaults, complete, work, depth + 1)
                    Ast::Decl.Import(_, _):
                        # Relevant same-name imports are rejected by scoped call resolution;
                        # unrelated imports do not invalidate this declaration census.
                        pass
                    Ast::Decl.Invalid:
                        complete <- false
                        return
                    Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        complete <- false
                        return

        def proof_replay_type_bound_call_result_fact(report: ProofReport&, caller_name: sview, caller_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr) -> bool:
            work: mutable usize = 0
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_type_bound_call_result_fact_with_work(report, caller_name, caller_line, parameters, body, expression, &work, &cache)
        def proof_replay_type_bound_call_result_fact_with_work(report: ProofReport&, caller_name: sview, caller_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            marker: mutable sview = ""
            call: mutable Ast::Expr = Ast::Expr.Invalid
            projected_field: mutable sview = ""
            width: mutable i64 = 0
            match expression:
                Ast::Expr.Call(Ast::Expr.Ident(marker_name, _), arguments, argument_names, _):
                    marker <- marker_name
                    return false if not proof_replay_type_bound_local_type_name_charge(marker, work)
                    if marker == "__elisa_primitive_scalar_type":
                        return false if arguments.count != 1 or argument_names.count != 0
                        match arguments[0]:
                            Ast::Expr.Field(object_expression, field_name, _):
                                match object_expression:
                                    Ast::Expr.Call(_, _, _, _):
                                        call <- object_expression
                                        projected_field <- field_name
                                    _:
                                        call <- arguments[0]
                            _:
                                call <- arguments[0]
                    elif marker in {"__elisa_signed_type_bound", "__elisa_signed_place_type_bound", "__elisa_unsigned_type_bound"}:
                        return false if arguments.count != 2 or argument_names.count != 0
                        match arguments[0]:
                            Ast::Expr.Field(object_expression, field_name, _):
                                match object_expression:
                                    Ast::Expr.Call(_, _, _, _):
                                        call <- object_expression
                                        projected_field <- field_name
                                    _:
                                        call <- arguments[0]
                            _:
                                call <- arguments[0]
                        return false if not proof_replay_summary_expr_charge_with_work(arguments[1], work)
                        width_value: (known: bool, value: i64) = proof_constant_int(arguments[1])
                        return false if not width_value.known
                        width <- width_value.value
                    else:
                        return false
                _:
                    return false
            call_name: mutable sview = ""
            callee_expression: mutable Ast::Expr = Ast::Expr.Invalid
            qualified_callee: mutable bool = false
            call_arguments: mutable darray[Ast::Expr] = []
            call_argument_names: mutable darray[sview] = []
            match call:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    match callee:
                        Ast::Expr.Ident(name, _):
                            call_name <- name
                        Ast::Expr.Scope(_, name, _):
                            call_name <- name
                            qualified_callee <- true
                        _:
                            return false
                    callee_expression <- callee
                    call_arguments <- arguments
                    call_argument_names <- argument_names
                _:
                    return false
            return false if call_name == "" or call_argument_names.count != 0 and call_argument_names.count != call_arguments.count
            if not qualified_callee:
                intrinsic_call: (complete: bool, intrinsic: bool) = proof_replay_type_bound_bare_intrinsic_call_with_work(call_name, call_arguments.count, work)
                return false if not intrinsic_call.complete or intrinsic_call.intrinsic
            caller_root: mutable sview = call_name
            if qualified_callee:
                match callee_expression:
                    Ast::Expr.Scope(base, _, _):
                        segments: mutable darray[sview] = []
                        return false if:
                            not proof_replay_summary_expr_charge_with_work(base, work)
                            not proof_qualified_path_segments(base, &segments, 0) or segments.count == 0
                        caller_root <- segments[0]
                    _:
                        return false
            shadowed: mutable bool = false
            for parameter in parameters |parameter, caller_root, shadowed, work|:
                return false if not proof_replay_type_bound_local_text_compare_charge(parameter.name, caller_root, work)
                shadowed <- true if parameter.name == caller_root
            return false if:
                shadowed
                not proof_replay_source_call_locals_unshadowed_at_with_work(body, report.source.source_annotations, call, work)
                not proof_replay_deterministic_call_declaration_index_ensure(report, work, cache)
            if not qualified_callee:
                prefix_cast: (complete: bool, collision: bool) = proof_replay_type_bound_bare_prefix_cast_type_collision_with_work(cache.declaration_index, call_name, call_arguments.count, work)
                return false if not prefix_cast.complete or prefix_cast.collision
            caller: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.declaration_index, caller_name, caller_line, report.analysis_2.replay_owner_offset, work) if report.analysis_2.replay_owner_offset_valid and report.analysis_2.replay_owner_line == caller_line else proof_replay_summary_owner_function_at_line(cache.declaration_index, caller_name, caller_line, work)
            return false if not caller.complete or caller.matches != 1 or caller.row >= cache.declaration_index.entries.count
            caller_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            match cache.declaration_index.entries[caller.row].declaration:
                Ast::Decl.Func(_, _, _, _, _, _, position):
                    caller_position <- position
                _:
                    return false
            return false if caller_position.line != caller_line
            complete: mutable bool = true
            return false if work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            resolved_line: mutable (known: bool, line: u32, module_path: darray[sview]) = (false, 0, [])
            resolved_callee_offset: mutable usize = 0
            resolved_callee_exact: mutable bool = false
            if qualified_callee:
                return false if not proof_replay_deterministic_call_alias_index_ensure(report, work, cache)
                selected_declaration: mutable Ast::Decl = Ast::Decl.Invalid
                selected_owner: mutable sview = ""
                selected_row: mutable usize = cache.declaration_index.entries.count
                selected_matches: mutable usize = 0
                return false if:
                    not proof_replay_deterministic_qualified_declaration(cache.declaration_index, call_name, callee_expression, owner, cache.alias_index, selected_declaration, selected_owner, selected_row, selected_matches, work)
                    selected_matches != 1 or selected_row >= cache.declaration_index.entries.count
                selected_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                match selected_declaration:
                    Ast::Decl.Func(_, _, _, _, _, _, position):
                        selected_position <- position
                    _:
                        return false
                selected_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work([], selected_owner, work)
                return false if not selected_scope.complete or selected_position.line == 0
                resolved_line <- (true, selected_position.line, selected_scope.scope)
                resolved_callee_offset <- selected_position.offset.usize()
                resolved_callee_exact <- true
            else:
                # Match caller-module and parent lookup first. Only unresolved bare calls
                # continue through the exact selective or wildcard import witnesses below.
                caller_scope: (complete: bool, scope: darray[sview], declaration: Ast::Decl) = proof_replay_type_bound_declaration_scope_from_index_with_work(report.source.source_declarations, cache.declaration_index, caller.row, work)
                return false if not caller_scope.complete
                # The unique source-index row above remains authoritative when the report
                # replay-owner context is missing or belongs to a different trace owner.
                # Reuse its declaration offset instead of a name-and-line caller census.
                resolved_owner = resolve_callee_owner_at_offset_with_caller_policy_with_work(report.source.source_declarations, report.source.source_annotations, caller_name, caller_line, caller_position.offset, call_name, true, work)
                resolved_line <- (resolved_owner.known, resolved_owner.line, resolved_owner.module_path)
                resolved_callee_offset <- resolved_owner.offset.usize()
                resolved_callee_exact <- resolved_owner.known
                if not resolved_line.known:
                    imported_target = proof_replay_type_bound_imported_callee_with_work(report, caller_scope.scope, call_name, call_arguments.count, call_argument_names, work, cache)
                    resolved_line <- (imported_target.known, imported_target.line, imported_target.module_path)
                    resolved_callee_offset <- imported_target.offset.usize()
                    resolved_callee_exact <- imported_target.known
                return false if:
                    not resolved_line.known or not proof_replay_type_bound_no_callable_extern_name_with_work(cache.declaration_index, call_name, work)
                    not proof_replay_type_bound_bare_target_emitter_safe_with_work(cache.declaration_index, call_name, resolved_line.line, resolved_callee_offset, resolved_callee_exact, call_arguments.count, call_argument_names, report.source.source_annotations, caller_scope.scope, resolved_line.module_path, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, work)
            return false if not resolved_line.known
            # The producer emits primitive-scalar witnesses for calls only after its
            # purity walk. A declared scalar return type proves the result shape, but
            # does not make repeated evaluations of an effectful call interchangeable
            # in kernel equality. Rebuild the exact callee row and replay the bounded
            # source purity check before admitting this call as a scalar term.
            return false if not resolved_callee_exact
            selected_pure_callee: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.declaration_index, call_name, resolved_line.line, resolved_callee_offset, work)
            return false if not selected_pure_callee.complete or selected_pure_callee.matches != 1 or selected_pure_callee.row >= cache.declaration_index.entries.count
            pure_callee_entry: ProofReplayDeterministicDeclarationEntry = cache.declaration_index.entries[selected_pure_callee.row]
            return false if not pure_callee_entry.is_function or pure_callee_entry.is_lemma or not proof_replay_type_bound_scalar_call_source_pure(report, pure_callee_entry, selected_pure_callee.row, work, cache)
            callee_matches: mutable usize = 0
            return_type: mutable Ast::Expr = Ast::Expr.Invalid
            callee_formal_names: mutable darray[sview] = []
            callee_formal_defaults: mutable darray[bool] = []
            current_module_path: mutable darray[sview] = []
            proof_replay_type_bound_find_callee_with_work(report.source.source_declarations, call_name, resolved_line.line, resolved_callee_offset, resolved_callee_exact, resolved_line.module_path, &current_module_path, &callee_matches, &return_type, &callee_formal_names, &callee_formal_defaults, &complete, work, 0)
            # This witness establishes only the callee's declared result type. The purity
            # gate above is independent; totality and the call's value require other evidence.
            return false if not complete or callee_matches != 1 or callee_formal_names.count != callee_formal_defaults.count or call_arguments.count > callee_formal_names.count
            # Bare backend lookup chooses by call arity before owner fallback. This witness
            # does not infer argument types, so only use its scoped name winner when the
            # call supplies every formal; defaulted and partial shapes could select another
            # backend candidate.
            return false if not qualified_callee and call_arguments.count != callee_formal_names.count
            generic_type: (complete: bool, present: bool) = proof_replay_type_bound_call_type_has_generic_with_work(report, return_type, resolved_line.line, resolved_callee_offset, resolved_callee_exact, work, 0)
            return false if:
                not generic_type.complete or generic_type.present
                call_argument_names.count != 0 and call_argument_names.count != call_arguments.count
            used_formals: mutable darray[bool] = []
            for _ in 0..<callee_formal_names.count |used_formals, work|:
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                used_formals.push(false)
            saw_named: mutable bool = false
            next_positional: mutable usize = 0
            for argument_index in 0..<call_arguments.count |argument_index, call_arguments, call_argument_names, callee_formal_names, used_formals, saw_named, next_positional, work|:
                argument_name: sview = call_argument_names[argument_index] if call_argument_names.count > 0 else ""
                formal_index: mutable usize = callee_formal_names.count
                if argument_name == "":
                    return false if saw_named or not proof_replay_type_bound_local_work_charge(1, work)
                    while next_positional < used_formals.count and used_formals[next_positional] |next_positional, used_formals|:
                        next_positional <- next_positional + 1
                    return false if next_positional >= used_formals.count
                    formal_index <- next_positional
                    next_positional <- next_positional + 1
                else:
                    saw_named <- true
                    return false if not proof_replay_type_bound_local_work_charge(sview_len(argument_name), work)
                    for index in 0..<callee_formal_names.count |index, callee_formal_names, argument_name, formal_index, work|:
                        return false if not proof_replay_type_bound_local_text_compare_charge(callee_formal_names[index], argument_name, work)
                        formal_index <- index if callee_formal_names[index] == argument_name
                    return false if formal_index >= callee_formal_names.count
                return false if used_formals[formal_index]
                used_formals[formal_index] <- true
            for index in 0..<used_formals.count |index, used_formals, callee_formal_defaults, work|:
                return false if:
                    not proof_replay_type_bound_local_work_charge(1, work)
                    not used_formals[index] and not callee_formal_defaults[index]
            result_type: mutable Ast::Expr = return_type
            if projected_field != "":
                projection: (complete: bool, element: Ast::Expr) = proof_replay_type_bound_tuple_projection_type_with_work(return_type, report.source.source_annotations, projected_field, work)
                return false if not projection.complete
                result_type <- projection.element
            active_alias_offsets: mutable darray[usize] = []
            shape: (complete: bool, signed_width: i64, unsigned_width: i64, scalar_kind: i64) = proof_replay_type_bound_call_type_shape_with_work(report, result_type, resolved_line.module_path, &active_alias_offsets, work, cache, 0)
            return false if not shape.complete
            if marker == "__elisa_primitive_scalar_type":
                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, result_type, work)
                return shape.signed_width > 0 or shape.unsigned_width > 0 or shape.scalar_kind == 1
            if marker == "__elisa_unsigned_type_bound":
                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, result_type, work)
                return shape.unsigned_width > 0 and width == shape.unsigned_width
            if marker in {"__elisa_signed_type_bound", "__elisa_signed_place_type_bound"}:
                return false if not proof_replay_type_bound_scalar_element_operators_trusted_with_work(report, result_type, work)
                return shape.signed_width > 0 and width == shape.signed_width
            false
