extend ElisaProof:
    private:
        def proof_replay_resource_region_rebind_alloc_source_valid_with_work(report: ProofReport&, resource_root: usize, event: ElisaProofKernelCore::ProofKernelNode, owner: sview, owner_line: u32, owner_offset: usize, owner_module: sview, source_work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool can[Global{Read,Write}]:
            return false if not proof_replay_owner_work_charge(sview_len(event.kind), source_work)
            return false if resource_root >= report.analysis_1.kernel.nodes.count or event.kind != "resource-region-rebind-alloc" or event.value <= 0 or event.value > 4294967295 or event.name == "" or event.secondary_name == "" or event.left >= report.analysis_1.kernel.nodes.count or owner == "" or owner_line == 0 or owner_offset > 4294967295
            return false if not proof_replay_owner_work_charge(sview_len(event.name), source_work) or not proof_replay_owner_work_charge(sview_len(event.secondary_name), source_work) or not proof_replay_owner_work_charge(sview_len(owner), source_work) or not proof_replay_owner_work_charge(sview_len(owner_module), source_work)
            positioned: (complete: bool, count: usize) = proof_replay_resource_event_count_in_root_with_work(report, report.analysis_1.kernel.nodes[resource_root], event.kind, event.value.usize(), event.name, source_work)
            return false if not positioned.complete or positioned.count != 1
            return false if not proof_replay_deterministic_call_declaration_index_ensure(report, source_work, &cache.deterministic_calls)
            caller: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.deterministic_calls.declaration_index, owner, owner_line, owner_offset, source_work)
            return false if not caller.complete or caller.matches != 1 or caller.row >= cache.deterministic_calls.declaration_index.entries.count
            entry: ProofReplayDeterministicDeclarationEntry = cache.deterministic_calls.declaration_index.entries[caller.row]
            return false if not proof_replay_owner_work_charge(sview_len(entry.owner), source_work) or entry.owner != owner_module
            body: mutable darray[Ast::Stmt] = []
            match entry.declaration:
                Ast::Decl.Func(_, _, _, declared_body, _, _, _):
                    body <- declared_body
                _:
                    return false
            matches: mutable usize = 0
            source_value: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_statements_with_work(body, event.value.usize(), event.kind, event.name, matches, source_value, source_work, 0) or matches != 1
            match source_value:
                Ast::Expr.RegionNew(operand, region, _):
                    return false if not proof_replay_owner_work_charge(sview_len(region), source_work) or region != event.secondary_name
                    return proof_replay_ast_matches_kernel_with_work(report, operand, event.left, source_work, 0)
                _:
                    return false
