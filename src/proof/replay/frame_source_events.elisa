extend ElisaProofFrameSource:
    private:
        def inert_value(expression: Ast::Expr, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 64 or not replay_work_charge(1, work)
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return inert_value(inner, depth + 1, work)
                _:
                    return false

    public:
        struct Event:
            kind: sview
            call_effect: bool
            change_index: usize
            position: Ast::Pos
            statement_index: usize
            clause_index: usize
            place: ElisaProofKernelFramePolicy::Place

        # Complete only for the explicit direct-body subset. Unknown statement,
        # expression or write mappings invalidate the entire inventory.
        def source_events_impl(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, exact_owner: bool, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, calls: bool, work: mutable usize&) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic]:
            policy = source_policy_at_offset_with_work(declarations, name, line, owner_offset, tokens, source, source_length, work) if exact_owner else source_policy_with_work(declarations, name, line, tokens, source, source_length, work)
            context = owner_at_offset_with_work(declarations, name, line, owner_offset, work) if exact_owner else owner_with_work(declarations, name, line, work)
            return (false, []) if not policy.known or not context.known
            events: mutable darray[Event] = []
            has_changes: mutable bool = false
            local_names: mutable darray[sview] = []
            local_types: mutable darray[Ast::Expr] = []
            return (false, []) if not replay_work_charge(context.formals.count, work)
            local_names.extend(context.formals)
            local_types.extend(context.formal_types)
            scalar_environment: bool = contract_environment(declarations, 0, work)
            return (false, []) if not replay_work_charge(policy.clauses.count, work)
            for index in 0..<policy.clauses.count |index, policy, events, has_changes, declarations, name, line, work|:
                clause = policy.clauses[index]
                return (false, []) if:
                    not replay_work_charge(sview_len(clause.kind), work)
                    not (place_typed_at_offset_with_work(declarations, name, line, owner_offset, clause.place, work) if exact_owner else place_typed_with_work(declarations, name, line, clause.place, work))
                has_changes <- true if clause.kind == "changes"
                events.push(Event{call_effect: false, change_index: 0, kind: clause.kind, position: clause.position, statement_index: 0, clause_index: index, place: clause.place})
            return (false, []) if not replay_work_charge(context.body.count, work)
            for index in 0..<context.body.count |index, context, policy, events, has_changes, declarations, annotations, name, line, work, local_names, local_types, scalar_environment, calls, tokens, source, source_length|:
                match context.body[index]:
                    Ast::Stmt.Contract(kind, expression, _):
                        if kind != "changes" and kind != "preserves":
                            return (false, []) if:
                                kind != "requires" and kind != "require" and kind != "ensures" and kind != "ensure"
                                not scalar_environment or not scalar_contract(expression, &local_names, &local_types, context.return_type, kind in {"ensures", "ensure"}, 0, work)
                    Ast::Stmt.Assign(_, operator, value, position):
                        # Compound operators can invoke overloaded code. Their
                        # target is reconstructed elsewhere, but inventory needs
                        # an independent mapping of those additional effects.
                        return (false, []) if operator != TokenKind.LArrow
                        if not inert_value(value, 0, work):
                            return (false, []) if not scalar_environment or not scalar_read(value, &local_names, &local_types, 0, work)
                        actual = direct_write_at_offset_with_work(declarations, name, line, owner_offset, position, work) if exact_owner else direct_write_with_work(declarations, name, line, position, work)
                        return (false, []) if not actual.known or not (place_typed_at_offset_with_work(declarations, name, line, owner_offset, actual.place, work) if exact_owner else place_typed_with_work(declarations, name, line, actual.place, work))
                        if has_changes:
                            return (false, []) if events.count >= 4096
                            events.push(Event{call_effect: false, change_index: 0, kind: "allow", position: position, statement_index: index, clause_index: 0, place: actual.place})
                        return (false, []) if not replay_work_charge(policy.clauses.count, work)
                        for clause_index in 0..<policy.clauses.count |clause_index, policy, events, position, index, actual, work|:
                            return (false, []) if not replay_work_charge(sview_len(policy.clauses[clause_index].kind), work)
                            if policy.clauses[clause_index].kind == "preserves":
                                return (false, []) if events.count >= 4096
                                events.push(Event{call_effect: false, change_index: 0, kind: "preserve", position: position, statement_index: index, clause_index: clause_index, place: actual.place})
                    Ast::Stmt.Return(value, _):
                        if value is expression:
                            if not inert_value(expression, 0, work):
                                return (false, []) if not scalar_environment
                                if calls:
                                    mapped = (source_return_effects_with_work(&context.body, index, declarations, annotations, name, line, owner_offset, exact_owner, &local_names, &local_types, context.return_type, tokens, source, source_length, work) can Global{Read,Write})
                                    return (false, []) if:
                                        not mapped.known
                                        not replay_work_charge(mapped.effects.count, work)
                                    for effect in mapped.effects |effect, events, index, has_changes, policy, work|:
                                        if has_changes:
                                            return (false, []) if events.count >= 4096
                                            events.push(Event{call_effect: true, change_index: effect.change_index, kind: "allow", position: effect.position, statement_index: index, clause_index: 0, place: effect.place})
                                        return (false, []) if not replay_work_charge(policy.clauses.count, work)
                                        for clause_index in 0..<policy.clauses.count |clause_index, policy, events, effect, index, work|:
                                            return (false, []) if not replay_work_charge(sview_len(policy.clauses[clause_index].kind), work)
                                            if policy.clauses[clause_index].kind == "preserves":
                                                return (false, []) if events.count >= 4096
                                                events.push(Event{call_effect: true, change_index: effect.change_index, kind: "preserve", position: effect.position, statement_index: index, clause_index: clause_index, place: effect.place})
                                else:
                                    return (false, []) if not scalar_read(expression, &local_names, &local_types, 0, work)
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return (false, []) if not calls
                        for arm in [then_body, else_body] |context, work, scalar_environment, local_names, local_types|:
                            return (false, []) if not replay_work_charge(arm.count, work)
                            for statement in arm |context, work, scalar_environment, local_names, local_types|:
                                match statement:
                                    Ast::Stmt.Return(value, _):
                                        if value is expression:
                                            return (false, []) if not scalar_environment or not scalar_read(expression, &local_names, &local_types, 0, work)
                                    _:
                                        return (false, [])
                        mapped = (source_condition_effects_at_owner_with_work(declarations, annotations, name, line, owner_offset, index, tokens, source, source_length, work) can Global{Read,Write}) if exact_owner else (source_condition_effects_with_work(declarations, annotations, name, line, index, tokens, source, source_length, work) can Global{Read,Write})
                        return (false, []) if:
                            not mapped.known
                            not replay_work_charge(mapped.effects.count, work)
                        for effect in mapped.effects |effect, events, index, has_changes, policy, work|:
                            if has_changes:
                                return (false, []) if events.count >= 4096
                                events.push(Event{call_effect: true, change_index: effect.change_index, kind: "allow", position: effect.position, statement_index: index, clause_index: 0, place: effect.place})
                            return (false, []) if not replay_work_charge(policy.clauses.count, work)
                            for clause_index in 0..<policy.clauses.count |clause_index, policy, events, effect, index, work|:
                                return (false, []) if not replay_work_charge(sview_len(policy.clauses[clause_index].kind), work)
                                if policy.clauses[clause_index].kind == "preserves":
                                    return (false, []) if events.count >= 4096
                                    events.push(Event{call_effect: true, change_index: effect.change_index, kind: "preserve", position: effect.position, statement_index: index, clause_index: clause_index, place: effect.place})
                    Ast::Stmt.VarDecl(binding, declared_type, _, _):
                        return (false, []) if:
                            not calls or not contract_scalar_type_with_work(declared_type, work)
                            not replay_work_charge(local_names.count, work)
                        for existing in local_names |binding, work|:
                            return (false, []) if:
                                not replay_work_charge(sview_len(existing), work)
                                not replay_work_charge(sview_len(binding), work)
                                existing == binding
                        mapped = (source_condition_effects_at_owner_with_work(declarations, annotations, name, line, owner_offset, index, tokens, source, source_length, work) can Global{Read,Write}) if exact_owner else (source_condition_effects_with_work(declarations, annotations, name, line, index, tokens, source, source_length, work) can Global{Read,Write})
                        return (false, []) if:
                            not mapped.known
                            not replay_work_charge(mapped.effects.count, work)
                        for effect in mapped.effects |effect, events, index, has_changes, policy, work|:
                            if has_changes:
                                return (false, []) if events.count >= 4096
                                events.push(Event{call_effect: true, change_index: effect.change_index, kind: "allow", position: effect.position, statement_index: index, clause_index: 0, place: effect.place})
                            return (false, []) if not replay_work_charge(policy.clauses.count, work)
                            for clause_index in 0..<policy.clauses.count |clause_index, policy, events, effect, index, work|:
                                return (false, []) if not replay_work_charge(sview_len(policy.clauses[clause_index].kind), work)
                                if policy.clauses[clause_index].kind == "preserves":
                                    return (false, []) if events.count >= 4096
                                    events.push(Event{call_effect: true, change_index: effect.change_index, kind: "preserve", position: effect.position, statement_index: index, clause_index: clause_index, place: effect.place})
                        local_names.push(binding)
                        local_types.push(declared_type)
                    _:
                        return (false, [])
            return (true, events)

        def strict_direct_events(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (strict_direct_events_with_work(declarations, [], name, line, tokens, source, source_length, &work) can Global{Read,Write})

        def strict_direct_events_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic]:
            return (source_events_impl(declarations, annotations, name, line, 0, false, tokens, source, source_length, false, work) can Global{Read,Write})

        def strict_direct_events_at_offset_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic]:
            return (source_events_impl(declarations, annotations, name, line, owner_offset, true, tokens, source, source_length, false, work) can Global{Read,Write})

        def direct_events(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (direct_events_with_work(declarations, [], name, line, tokens, source, source_length, &work) can Global{Read,Write})

        def direct_events_with_annotations(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            work: mutable usize = 0
            return (direct_events_with_work(declarations, annotations, name, line, tokens, source, source_length, &work) can Global{Read,Write})

        def direct_events_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic]:
            return (source_events_impl(declarations, annotations, name, line, 0, false, tokens, source, source_length, true, work) can Global{Read,Write})

        def direct_events_at_offset_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, work: mutable usize&) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic]:
            return (source_events_impl(declarations, annotations, name, line, owner_offset, true, tokens, source, source_length, true, work) can Global{Read,Write})

        def direct_events_match(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, claimed: darray[Event]&) -> bool can[Memory.Allocate, Abort.Panic]:
            expected = (direct_events(declarations, name, line, tokens, source, source_length) can Global{Read,Write})
            return false if not expected.known or claimed.count != expected.events.count
            for index in 0..<claimed.count |index, claimed, expected|:
                actual = claimed[index]
                original = expected.events[index]
                return false if:
                    actual.call_effect != original.call_effect or actual.change_index != original.change_index or actual.kind != original.kind or actual.statement_index != original.statement_index or actual.clause_index != original.clause_index or not same_position(actual.position, original.position)
                    actual.place.parameter != original.place.parameter or actual.place.depth != original.place.depth or actual.place.field != original.place.field or actual.place.field2 != original.place.field2 or actual.place.field3 != original.place.field3
            return true
