extend ElisaProofFrameSource:
    private:
        def inert_value(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 64
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return inert_value(inner, depth + 1)
                _:
                    return false

    public:
        struct Event:
            kind: sview
            call_effect: bool
            change_index: usize
            position: Ast::Pos
            statement_index: usize
            clause_index: usize
            place: ElisaProofKernelFramePolicy::Place

        # Complete only for the explicit direct-body subset. Unknown statement,
        # expression or write mappings invalidate the entire inventory.
        def source_events_impl(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, calls: bool) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic]:
            policy = source_policy(declarations, name, line, tokens, source, source_length)
            context = owner(declarations, name, line)
            return (false, []) if not policy.known or not context.known
            events: mutable darray[Event] = []
            has_changes: mutable bool = false
            contract_work: mutable usize = 0
            value_work: mutable usize = 0
            environment_work: mutable usize = 0
            scalar_environment: bool = contract_environment(declarations, 0, &environment_work)
            for index in 0..<policy.clauses.count |index, policy, events, has_changes, declarations, name, line|:
                clause = policy.clauses[index]
                return (false, []) if not place_typed(declarations, name, line, clause.place)
                has_changes <- true if clause.kind == "changes"
                events.push(Event{call_effect: false, change_index: 0, kind: clause.kind, position: clause.position, statement_index: 0, clause_index: index, place: clause.place})
            for index in 0..<context.body.count |index, context, policy, events, has_changes, declarations, name, line, contract_work, value_work, scalar_environment, calls, tokens, source, source_length|:
                match context.body[index]:
                    Ast::Stmt.Contract(kind, expression, _):
                        if kind != "changes" and kind != "preserves":
                            return (false, []) if kind != "requires" and kind != "require" and kind != "ensures" and kind != "ensure"
                            return (false, []) if not scalar_environment or not scalar_contract(expression, &context.formals, &context.formal_types, context.return_type, kind == "ensures" or kind == "ensure", 0, &contract_work)
                    Ast::Stmt.Assign(_, operator, value, position):
                        # Compound operators can invoke overloaded code. Their
                        # target is reconstructed elsewhere, but inventory needs
                        # an independent mapping of those additional effects.
                        return (false, []) if operator != TokenKind.LArrow
                        if not inert_value(value, 0):
                            return (false, []) if not scalar_environment or not scalar_value(value, &context.formals, &context.formal_types, 0, &value_work)
                        actual = direct_write(declarations, name, line, position)
                        return (false, []) if not actual.known or not place_typed(declarations, name, line, actual.place)
                        if has_changes:
                            return (false, []) if events.count >= 4096
                            events.push(Event{call_effect: false, change_index: 0, kind: "allow", position: position, statement_index: index, clause_index: 0, place: actual.place})
                        for clause_index in 0..<policy.clauses.count |clause_index, policy, events, position, index, actual|:
                            if policy.clauses[clause_index].kind == "preserves":
                                return (false, []) if events.count >= 4096
                                events.push(Event{call_effect: false, change_index: 0, kind: "preserve", position: position, statement_index: index, clause_index: clause_index, place: actual.place})
                    Ast::Stmt.Return(value, _):
                        if value is expression:
                            if not inert_value(expression, 0):
                                return (false, []) if not scalar_environment or not scalar_value(expression, &context.formals, &context.formal_types, 0, &value_work)
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return (false, []) if not calls
                        for arm in [then_body, else_body] |context, value_work, scalar_environment|:
                            for statement in arm |context, value_work, scalar_environment|:
                                match statement:
                                    Ast::Stmt.Return(value, _):
                                        if value is expression:
                                            return (false, []) if not scalar_environment or not scalar_value(expression, &context.formals, &context.formal_types, 0, &value_work)
                                    _:
                                        return (false, [])
                        mapped = source_condition_effects(declarations, name, line, index, tokens, source, source_length)
                        return (false, []) if not mapped.known
                        for effect in mapped.effects |effect, events, index, has_changes, policy|:
                            if has_changes:
                                return (false, []) if events.count >= 4096
                                events.push(Event{call_effect: true, change_index: effect.change_index, kind: "allow", position: effect.position, statement_index: index, clause_index: 0, place: effect.place})
                            for clause_index in 0..<policy.clauses.count |clause_index, policy, events, effect, index|:
                                if policy.clauses[clause_index].kind == "preserves":
                                    return (false, []) if events.count >= 4096
                                    events.push(Event{call_effect: true, change_index: effect.change_index, kind: "preserve", position: effect.position, statement_index: index, clause_index: clause_index, place: effect.place})
                    _:
                        return (false, [])
            return (true, events)

        def strict_direct_events(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic]:
            return source_events_impl(declarations, name, line, tokens, source, source_length, false)

        def direct_events(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize) -> (known: bool, events: darray[Event]) can[Memory.Allocate, Abort.Panic]:
            return source_events_impl(declarations, name, line, tokens, source, source_length, true)

        def direct_events_match(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, claimed: darray[Event]&) -> bool can[Memory.Allocate, Abort.Panic]:
            expected = direct_events(declarations, name, line, tokens, source, source_length)
            return false if not expected.known or claimed.count != expected.events.count
            for index in 0..<claimed.count |index, claimed, expected|:
                actual = claimed[index]
                original = expected.events[index]
                return false if actual.call_effect != original.call_effect or actual.change_index != original.change_index or actual.kind != original.kind or actual.statement_index != original.statement_index or actual.clause_index != original.clause_index or not same_position(actual.position, original.position)
                return false if actual.place.parameter != original.place.parameter or actual.place.depth != original.place.depth or actual.place.field != original.place.field or actual.place.field2 != original.place.field2 or actual.place.field3 != original.place.field3
            return true
