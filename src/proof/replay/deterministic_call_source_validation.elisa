extend ElisaProof:
    private:
        const PROOF_REPLAY_DETERMINISTIC_IMPORT_NAME_MARKER_COMPARE_WORK: usize = 121
        const PROOF_REPLAY_DETERMINISTIC_IMPORT_ALIAS_MARKER_COMPARE_WORK: usize = 35

        def proof_replay_deterministic_parameter_type(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Unary(operator, inner, _):
                    return true if operator == TokenKind.Ampersand or operator == TokenKind.Mutable or operator == TokenKind.Lmut
                    return proof_replay_deterministic_parameter_type(inner, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_deterministic_parameter_type(left, depth + 1) or proof_replay_deterministic_parameter_type(right, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_replay_deterministic_parameter_type(inner, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_replay_deterministic_parameter_type(base, depth + 1)
                _:
                    return false

        def proof_replay_deterministic_body_shape(body: darray[Ast::Stmt]&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= 96 or work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
            for statement in body |depth, work|:
                return false if not proof_replay_deterministic_call_budget_charge(1, work)
                match statement:
                    Ast::Stmt.Return(_, _):
                        pass
                    Ast::Stmt.Expr(_, _):
                        pass
                    Ast::Stmt.VarDecl(_, _, _, _):
                        pass
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return false if not proof_replay_deterministic_body_shape(then_body, depth + 1, work) or not proof_replay_deterministic_body_shape(else_body, depth + 1, work)
                    Ast::Stmt.Contract(kind, expression, _):
                        return false if kind != "requires" and not proof_is_ensure_kind(kind) and kind != "decreases" and kind != "decreases*"
                        # The producer's direct-purity pass rejects executable calls from
                        # preconditions and decreases clauses. Postcondition calls are allowed
                        # only through the pure/deterministic call graph, so the replay walker
                        # below must retain those edges instead of silently dropping every
                        # non-assert contract expression.
                        return false if not proof_is_ensure_kind(kind) and proof_expr_has_executable_call_with_work(expression, work, PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |depth, work|:
                            return false if not proof_replay_deterministic_body_shape(arm.body, depth + 1, work)
                    _:
                        return false
            return true

        def proof_replay_deterministic_body_mentions(body: darray[Ast::Stmt]&, name: sview, depth: usize) -> bool:
            return true if depth >= 96
            for statement in body |name, depth|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return true if proof_expr_mentions_name(returned, name)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_expr_mentions_name(expression, name)
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_expr_mentions_name(initializer, name)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_expr_mentions_name(condition, name) or proof_replay_deterministic_body_mentions(then_body, name, depth + 1) or proof_replay_deterministic_body_mentions(else_body, name, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_expr_mentions_name(scrutinee, name)
                        for arm in arms |name, depth|:
                            return true if proof_expr_mentions_name(arm.guard, name) or proof_replay_deterministic_body_mentions(arm.body, name, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_expr_mentions_name(expression, name)
                    _:
                        pass
            return false

        def proof_replay_deterministic_scalar_type(expression: Ast::Expr, declarations: darray[Ast::Decl]&, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Ident(name, _):
                    return true if:
                        name in {"i8", "i16", "i32", "i64", "isize", "int"}
                        name in {"u8", "u16", "u32", "u64", "usize", "uintptr"}
                        name in {"bool", "char"}
                    source = proof_replay_effect_named_declaration(declarations, name, 0)
                    return false if source.matches != 1
                    match source.declaration:
                        Ast::Decl.Alias(_, target, _):
                            return proof_replay_deterministic_scalar_type(target, declarations, depth + 1)
                        Ast::Decl.Enum(_, _, is_const, _, _):
                            return is_const
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_replay_deterministic_scalar_type(inner, declarations, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_replay_deterministic_scalar_type(base, declarations, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_deterministic_scalar_type(inner, declarations, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    return false
            return false

        def proof_replay_deterministic_scalar_type_indexed(expression: Ast::Expr, declarations: ProofReplayDeterministicDeclarationIndex&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Ident(name, _):
                    return true if:
                        name in {"i8", "i16", "i32", "i64", "isize", "int"}
                        name in {"u8", "u16", "u32", "u64", "usize", "uintptr"}
                        name in {"bool", "char"}
                    source: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(declarations, name, work)
                    return false if not source.complete or source.count != 1 or source.head >= declarations.entries.count
                    match declarations.entries[source.head].declaration:
                        Ast::Decl.Alias(_, target, _):
                            return proof_replay_deterministic_scalar_type_indexed(target, declarations, work, depth + 1)
                        Ast::Decl.Enum(_, _, is_const, _, _):
                            return is_const
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_replay_deterministic_scalar_type_indexed(inner, declarations, work, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_replay_deterministic_scalar_type_indexed(base, declarations, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_deterministic_scalar_type_indexed(inner, declarations, work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    return false
            return false

        def proof_replay_deterministic_import_owner_supported(annotation: Ast::EnumAnnotation, work: mutable usize&) -> bool:
            # The parser stores from-import sentinels in `owner`. Charge both possible
            # comparisons, the stored spelling, and the fixed marker bytes before inspecting it.
            return false if:
                not proof_replay_deterministic_call_budget_charge(sview_len(annotation.owner), work)
                not proof_replay_deterministic_call_budget_charge(25, work)
            return annotation.owner != "__from_member" and annotation.owner != "__from_src"

        def proof_replay_deterministic_module_alias_imports_supported(annotations: darray[Ast::EnumAnnotation]&, alias_count: mutable usize&, work: mutable usize&) -> bool:
            cursor: mutable usize = 0
            while cursor < annotations.count |cursor, annotations, work|:
                annotation: Ast::EnumAnnotation = annotations[cursor]
                return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 1 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + 1
                return false if sview_len(annotation.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.owner)
                return false if sview_len(annotation.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.name)
                return false if sview_len(annotation.module) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + sview_len(annotation.module)
                return false if:
                    not proof_replay_deterministic_call_budget_product(7, sview_len(annotation.name), work)
                    not proof_replay_deterministic_call_budget_charge(PROOF_REPLAY_DETERMINISTIC_IMPORT_NAME_MARKER_COMPARE_WORK, work)
                    not proof_replay_deterministic_import_owner_supported(annotation, work)
                if annotation.name == "__using":
                    return false if cursor + 2 >= annotations.count
                    alias: Ast::EnumAnnotation = annotations[cursor + 1]
                    target: Ast::EnumAnnotation = annotations[cursor + 2]
                    for paired in [alias, target] |paired, work|:
                        return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 1 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + 1
                        return false if sview_len(paired.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(paired.owner)
                        return false if sview_len(paired.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(paired.name)
                        return false if:
                            not proof_replay_deterministic_call_budget_charge(sview_len(paired.name), work)
                            sview_len(paired.module) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(paired.module)
                        return false if not proof_replay_deterministic_import_owner_supported(paired, work)
                    return false if not proof_replay_deterministic_call_budget_charge(PROOF_REPLAY_DETERMINISTIC_IMPORT_ALIAS_MARKER_COMPARE_WORK, work)
                    # These pairwise equality checks scan source-owned strings again after the
                    # per-annotation scan and sentinel checks above. Charge both spellings before
                    # comparing them so equal long aliases cannot exceed the bounded work model.
                    return false if:
                        not proof_replay_deterministic_call_budget_charge(sview_len(annotation.owner), work)
                        not proof_replay_deterministic_call_budget_charge(sview_len(target.owner), work)
                        not proof_replay_deterministic_call_budget_charge(sview_len(alias.module), work)
                        not proof_replay_deterministic_call_budget_charge(sview_len(target.module), work)
                        alias.name != "__using_alias" or target.name != "__using_alias_target"
                        alias.owner == "" or target.owner != annotation.owner or alias.module != target.module or alias.line != annotation.line or target.line != annotation.line or alias.offset != target.offset or alias.offset <= annotation.offset
                    alias_count <- alias_count + 1
                    cursor <- cursor + 3
                    continue
                match annotation.name:
                    "__using_alias" | "__using_alias_target" | "__using_member" | "__binding_wildcard_import" | "__from_member" | "__from_src" | "__from_decl":
                        return false
                    _:
                        pass
                cursor <- cursor + 1
            return true

        # Import declarations are usable here only when the parser's source annotations carry
        # one exact, paired namespace-alias witness for each declaration. Other import forms
        # still lack the selected-callee evidence required by deterministic replay.
        def proof_replay_deterministic_alias_import_declarations_supported(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, import_count: mutable usize&, matched_count: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
                work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or declarations.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + declarations.count
            for declaration in declarations |annotations, import_count, matched_count, work, depth|:
                match declaration:
                    Ast::Decl.Import(module, position):
                        return false if import_count >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
                        import_count <- import_count + 1
                        return false if sview_len(module) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(module)
                        matches: mutable usize = 0
                        for index in 0..<annotations.count |index, annotations, module, position, matches, work|:
                            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 1 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                            work <- work + 1
                            candidate: Ast::EnumAnnotation = annotations[index]
                            return false if sview_len(candidate.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(candidate.owner)
                            return false if sview_len(candidate.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(candidate.name)
                            if candidate.name == "__using" and index + 2 < annotations.count:
                                target: Ast::EnumAnnotation = annotations[index + 2]
                                return false if sview_len(target.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                                work <- work + sview_len(target.owner)
                                return false if not proof_replay_deterministic_call_budget_charge(1 + sview_len(module), work)
                                candidate_owner_matches: bool = candidate.owner == module
                                if candidate_owner_matches and candidate.line == position.line:
                                    return false if not proof_replay_deterministic_call_budget_charge(1 + sview_len(module), work)
                                    target_owner_matches: bool = target.owner == module
                                    if target_owner_matches:
                                        matches <- matches + 1
                                        return false if matches > 1
                        return false if matches != 1
                        matched_count <- matched_count + 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_deterministic_alias_import_declarations_supported(nested, annotations, import_count, matched_count, work, depth + 1)
                    Ast::Decl.Invalid:
                        return false
                    Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            return true

        # Resolve a qualified deterministic call through the same source-derived module and
        # alias index as checker admission. A single candidate row keeps this exact-owner query
        # bounded while preserving every AST path segment.
        def proof_replay_deterministic_qualified_path_matches_owner(owner: sview, wanted: sview, callee: Ast::Expr, caller_owner: sview, aliases: ProofModuleAliasIndex&, work: mutable usize&) -> (complete: bool, matches: bool):
            return (false, false) if:
                not proof_replay_summary_expr_charge_with_work(callee, work)
                work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or 2 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + 2
            names: darray[sview] = [wanted]
            owners: darray[sview] = [owner]
            resolved: (complete: bool, row: usize) = proof_module_function_index_for_callee(names, owners, aliases, caller_owner, callee, work, PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT)
            return (false, false) if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or not resolved.complete
            return (true, resolved.row == 0)

        def proof_replay_deterministic_qualified_declaration(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, callee: Ast::Expr, caller_owner: sview, aliases: ProofModuleAliasIndex&, selected: mutable Ast::Decl&, selected_owner: mutable sview&, selected_row: mutable usize&, matches: mutable usize&, work: mutable usize&) -> bool:
            return false if wanted == ""
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(index, wanted, work)
            return false if not group.complete
            return true if group.count == 0
            row: mutable usize = group.head
            for offset in 0..<group.count |offset, group, index, row, wanted, callee, caller_owner, aliases, selected, matches, work|:
                return false if row >= index.entries.count or not proof_replay_deterministic_call_budget_charge(1 + sview_len(index.entries[row].name), work)
                entry: ProofReplayDeterministicDeclarationEntry = index.entries[row]
                return false if entry.name != wanted
                # The checker resolves qualified calls in the executable-function table. Type,
                # value, extern, import, law, and lemma rows share this replay name index, but
                # they are not candidates in that table.
                if entry.is_function and not entry.is_lemma:
                    path_match: (complete: bool, matches: bool) = proof_replay_deterministic_qualified_path_matches_owner(entry.owner, wanted, callee, caller_owner, aliases, work)
                    return false if not path_match.complete
                    if path_match.matches:
                        matches <- matches + 1
                        selected <- entry.declaration
                        selected_owner <- entry.owner
                        selected_row <- row
                row <- entry.next_index
                return false if row > index.entries.count
            return row == index.entries.count

        def proof_replay_deterministic_source_scan_charge(body: darray[Ast::Stmt]&, parameters: darray[Ast::ParamDecl]&, body_repetitions: usize, default_repetitions: usize, work: mutable usize&) -> bool:
            body_cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost_body(body, body_cost, work, 0)
            default_cost: mutable usize = 0
            for parameter in parameters |parameter, default_cost, work|:
                if parameter.has_default:
                    return false if not proof_replay_summary_expr_cost(parameter.default_value, default_cost, work, 0)
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
            remaining: usize = PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            return false if body_repetitions != 0 and body_cost > remaining / body_repetitions
            remaining <- remaining - body_cost * body_repetitions
            return false if default_repetitions != 0 and default_cost > remaining / default_repetitions
            work <- work + body_cost * body_repetitions + default_cost * default_repetitions
            return true

        # Deterministic-call replay must not trust the producer's cached operator/drop facts.
        # Rebuild those indexes from the source snapshot once, then share the scratch report
        # through the recursive call walk. All copied source rows and index construction consume
        # the deterministic-call meter; malformed or over-budget input fails closed.
        def proof_replay_deterministic_analysis_context_build(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, generic_lines: darray[u32]&, generic_names: darray[sview]&, generic_owner_offsets: darray[u32]&, generic_valid: bool, generic_owner_valid: bool, scratch: mutable ProofReport&, work: mutable usize&) -> bool:
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or declarations.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + declarations.count
            scratch.source.source_declarations.extend(declarations)
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or generic_lines.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + generic_lines.count
            scratch.source_types.source_generic_param_lines.extend(generic_lines)
            exact_owner_rows_aligned: bool = generic_lines.count == generic_names.count and generic_lines.count == generic_owner_offsets.count
            if generic_owner_valid and exact_owner_rows_aligned:
                return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or generic_owner_offsets.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                work <- work + generic_owner_offsets.count
                scratch.source_types.source_generic_param_owner_offsets.extend(generic_owner_offsets)
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or generic_names.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + generic_names.count
            for generic_name in generic_names |scratch, work|:
                return false if not proof_replay_deterministic_call_budget_charge(sview_len(generic_name), work)
                scratch.source_types.source_generic_param_names.push(generic_name)
            scratch.source_types.source_generic_params_valid <- generic_valid and generic_lines.count == generic_names.count
            scratch.source_types.source_generic_owner_params_valid <- generic_owner_valid and exact_owner_rows_aligned
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or annotations.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + annotations.count
            scratch.source.source_annotations.extend(annotations)
            proof_source_analysis_indexes_reset(scratch)
            return false if:
                not proof_source_effect_index_build(scratch, work)
                not proof_replay_source_generic_param_line_index_build(&scratch, work)
                work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
            operator_index_status: (complete: bool, reason: sview, observed: usize, limit: usize) = proof_build_operator_impl_index(&scratch, work)
            return false if not operator_index_status.complete or work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
            operator_mask_status: (complete: bool, primitive_mask: usize, protocol_mask: usize) = proof_source_operator_masks_from_index(scratch, work)
            return false if not operator_mask_status.complete or work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
            scratch.source.source_primitive_operator_mask <- operator_mask_status.primitive_mask
            scratch.source.source_operator_protocol_mask <- operator_mask_status.protocol_mask
            return true

        # Mirror the source purity gates for semantics that are not represented by explicit
        # named-call edges: operator implementations, runtime index dispatch, and generated
        # destructor calls. Source indexes are shared; each body check gets only the replay-wide
        # allowance still available, then adds its measured delta back to the replay counter.
        def proof_replay_deterministic_source_effects_supported(name: sview, declaration_line: u32, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, scratch: mutable ProofReport&, work: mutable usize&, caller_owner: sview) -> bool:
            return false if work >= PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
            remaining: usize = PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            effect_work_before: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - remaining
            scratch.source_types.source_effect_index.work.implicit_effect_work <- effect_work_before
            return false if:
                proof_source_function_has_drop_risk(name, declaration_line, parameters, body, scratch, caller_owner, true)
                proof_structural_typed_operator_defaults_have_overload(parameters, declaration_line, scratch, caller_owner, true)
                proof_structural_typed_operator_statements_have_overload(body, parameters, declaration_line, scratch, 0, caller_owner, true)
            for parameter in parameters |parameters, scratch, declaration_line, caller_owner|:
                if parameter.has_default:
                    return false if proof_source_expression_has_unsafe_runtime_index(parameter.default_value, parameters, scratch, 0, [], declaration_line, caller_owner, true)
            return false if:
                proof_source_statements_have_unsafe_runtime_index(body, parameters, scratch, 0, [], declaration_line, caller_owner, true)
                scratch.source_types.source_effect_index.work.implicit_effect_work < effect_work_before or scratch.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            effect_work_used: usize = scratch.source_types.source_effect_index.work.implicit_effect_work - effect_work_before
            return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or effect_work_used > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + effect_work_used
            return true

        def proof_replay_deterministic_signature_table_valid(signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            contract_count: usize = signature_lines.count
            return false if:
                contract_count != signature_kinds.count or contract_count != signature_contracts.count
                not proof_replay_deterministic_call_budget_charge(3, work)
            if contract_count > 1:
                return false if contract_count - 1 > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                for index in 1..<contract_count |index, signature_lines, work|:
                    return false if:
                        not proof_replay_deterministic_call_budget_charge(1, work)
                        signature_lines[index] < signature_lines[index - 1]
            return true

        # Validate source order once, then use two metered binary searches for each
        # declaration line reached by the recursive deterministic-call walk.
        def proof_replay_deterministic_signature_contract_range(signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, declaration_line: u32, work: mutable usize&) -> (complete: bool, start: usize, count: usize):
            contract_count: usize = signature_lines.count
            return (false, 0, 0) if contract_count != signature_kinds.count or contract_count != signature_contracts.count
            low: mutable usize = 0
            high: mutable usize = contract_count
            while low < high |low, high, signature_lines, declaration_line, work|:
                return (false, 0, 0) if not proof_replay_deterministic_call_budget_charge(1, work)
                middle: usize = low + (high - low) / 2
                if signature_lines[middle] < declaration_line:
                    low <- middle + 1
                else:
                    high <- middle
            start: usize = low
            high <- contract_count
            while low < high |low, high, signature_lines, declaration_line, work|:
                return (false, 0, 0) if not proof_replay_deterministic_call_budget_charge(1, work)
                middle: usize = low + (high - low) / 2
                if signature_lines[middle] <= declaration_line:
                    low <- middle + 1
                else:
                    high <- middle
            return (true, start, low - start)

        def proof_replay_deterministic_signature_calls(signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, declaration_line: u32, parameters: darray[Ast::ParamDecl]&, annotations: darray[Ast::EnumAnnotation]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            return false if declaration_line == 0 or signature_lines.count != signature_kinds.count or signature_lines.count != signature_contracts.count
            contract_range: (complete: bool, start: usize, count: usize) = proof_replay_deterministic_signature_contract_range(signature_lines, signature_kinds, signature_contracts, declaration_line, work)
            return false if not contract_range.complete or contract_range.start > signature_lines.count or contract_range.count > signature_lines.count - contract_range.start
            call_index: mutable ProofReplayCallNameIndex = ProofReplayCallNameIndex{}
            if contract_range.count > 0:
                return false if not proof_replay_call_name_index_build(calls, call_index, work)
            for offset in 0..<contract_range.count |offset, contract_range, signature_kinds, signature_contracts, parameters, annotations, calls, call_index, call_target, work|:
                index: usize = contract_range.start + offset
                return false if not proof_replay_deterministic_call_budget_charge(1, work)
                kind: sview = signature_kinds[index]
                return false if not proof_replay_deterministic_call_budget_charge(sview_len(kind), work)
                # These are the only function signature clauses included in the producer's
                # deterministic call graph. Unknown clause kinds fail closed instead of
                # letting the replay graph diverge from the producer's graph.
                return false if:
                    kind != "requires" and not proof_is_ensure_kind(kind)
                    not proof_replay_summary_expr_charge_with_work(signature_contracts[index], work)
                    not proof_replay_source_expression_calls_with_target_index_work(parameters, signature_contracts[index], annotations, &calls, call_index, call_target, work)
            return true

        def proof_replay_deterministic_function_declaration(declarations: darray[Ast::Decl]&, declaration_index: mutable ProofReplayDeterministicDeclarationIndex&, aliases: ProofModuleAliasIndex&, annotations: darray[Ast::EnumAnnotation]&, signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_contracts: darray[Ast::Expr]&, name: sview, owner: sview, declaration: Ast::Decl, declaration_row: usize, scratch: mutable ProofReport&, active: darray[usize]&, work: mutable usize&, depth: usize) -> bool:
            return false if:
                name == "" or declaration_row >= declaration_index.entries.count
                not proof_replay_deterministic_call_budget_charge(1, work)
            return true if declaration_index.entries[declaration_row].validated_deterministic_call
            return false if:
                depth >= 32
                work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT
                active.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
            work <- work + active.count
            for current_row in active |current_row, declaration_row, work|:
                # The declaration row is unique even when different nested modules share both
                # their final module segment and function name.
                return false if:
                    not proof_replay_deterministic_call_budget_charge(1, work)
                    current_row == declaration_row
            match declaration:
                Ast::Decl.Func(_, parameters, return_type, body, effects, _, position):
                    return false if parameters.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                    work <- work + parameters.count
                    return false if annotations.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                    work <- work + annotations.count
                    for annotation in annotations |work|:
                        return false if sview_len(annotation.name) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(annotation.name)
                        return false if sview_len(annotation.owner) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(annotation.owner)
                        return false if sview_len(annotation.module) > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(annotation.module)
                    global_mutable_markers: mutable usize = 0
                    for annotation in annotations |annotation, global_mutable_markers, work|:
                        return false if not proof_replay_deterministic_call_budget_charge(1, work)
                        global_mutable_markers <- global_mutable_markers + 1 if annotation.name == "__global_mutable"
                    return false if:
                        not proof_replay_deterministic_source_scan_charge(body, parameters, annotations.count + 3, global_mutable_markers, work)
                        effects.count != 0 or not proof_replay_deterministic_body_shape(body, 0, work)
                    if return_type is scalar_return:
                        return false if:
                            not proof_replay_summary_expr_charge_with_work(scalar_return, work)
                            not proof_replay_deterministic_scalar_type_indexed(scalar_return, declaration_index, work, 0)
                    else:
                        return false
                    for parameter in parameters:
                        return false if:
                            not proof_replay_summary_expr_charge_with_work(parameter.type_expression, work)
                            parameter.is_mutable or proof_replay_deterministic_parameter_type(parameter.type_expression, 0) or not proof_replay_deterministic_scalar_type_indexed(parameter.type_expression, declaration_index, work, 0)
                        if parameter.has_default:
                            return false if not proof_replay_summary_expr_charge_with_work(parameter.default_value, work)
                    for annotation in annotations |body, parameters|:
                        if annotation.name == "__global_mutable":
                            return false if proof_replay_deterministic_body_mentions(body, annotation.owner, 0)
                            for parameter in parameters:
                                return false if parameter.has_default and proof_expr_mentions_name(parameter.default_value, annotation.owner)
                    return false if not proof_replay_deterministic_call_budget_charge(sview_len(owner), work)
                    return false if not proof_replay_deterministic_source_effects_supported(name, position.line, parameters, body, scratch, work, owner)
                    return false if not proof_source_conversion_generic_owner_index_ensure(scratch)
                    calls: mutable darray[sview] = []
                    call_target: mutable ProofReplayCallSiteTarget = ProofReplayCallSiteTarget{selection: ProofReplayCallSiteTargetSelection{enabled: false, ignore_unmatched_scoped_edges: false, allow_scoped_target: false, include_nonassert_contract_calls: true, offset: 0, line: 0, name: "", calls_at_offset: 0, matched_calls: 0, track_unresolved_dispatch: true, unresolved_dispatch_found: false, source_annotations: annotations}, conversions: ProofReplayCallSiteTargetConversions{field_conversion_parameters: parameters, field_conversion_names: scratch.source_types.source_effect_index.conversions.field_conversion_names, field_conversion_index_valid: scratch.source_types.source_effect_index.conversions.field_conversion_index_valid, field_conversion_index_hashes: scratch.source_types.source_effect_index.conversions.field_conversion_index_hashes, field_conversion_index_values: scratch.source_types.source_effect_index.conversions.field_conversion_index_values, field_conversion_index_counts: scratch.source_types.source_effect_index.conversions.field_conversion_index_counts, field_conversion_custom_cast_present: scratch.source_types.source_effect_index.conversions.field_conversion_custom_cast_present}, aliases: ProofReplayCallSiteTargetAliases{field_conversion_alias_names: scratch.source_types.source_effect_index.aliases.alias_names, field_conversion_alias_targets: scratch.source_types.source_effect_index.aliases.alias_targets, field_conversion_alias_lines: scratch.source_types.source_effect_index.aliases.alias_lines, field_conversion_bare_alias_root_fallback_valid: scratch.source_types.source_effect_index.aliases.bare_alias_root_fallback_valid, field_conversion_alias_owners: scratch.source_types.source_effect_index.aliases.alias_owners, field_conversion_alias_has_formals: scratch.source_types.source_effect_index.aliases.alias_has_formals, field_conversion_alias_generic_formal_names: scratch.source_types.source_effect_index.aliases.alias_generic_formal_names, field_conversion_alias_generic_formal_starts: scratch.source_types.source_effect_index.aliases.alias_generic_formal_starts, field_conversion_alias_generic_formal_counts: scratch.source_types.source_effect_index.aliases.alias_generic_formal_counts, field_conversion_alias_generic_application_valid: scratch.source_types.source_effect_index.aliases.alias_generic_application_valid, field_conversion_alias_scope_index_valid: scratch.source_types.source_effect_index.aliases.alias_scope_index_valid, field_conversion_alias_scope_index_hashes: scratch.source_types.source_effect_index.aliases.alias_scope_index_hashes, field_conversion_alias_scope_index_values: scratch.source_types.source_effect_index.aliases.alias_scope_index_values, field_conversion_alias_scope_index_counts: scratch.source_types.source_effect_index.aliases.alias_scope_index_counts, field_conversion_alias_index_valid: scratch.source_types.source_effect_index.aliases.alias_index_valid, field_conversion_alias_index_hashes: scratch.source_types.source_effect_index.aliases.alias_index_hashes, field_conversion_alias_index_values: scratch.source_types.source_effect_index.aliases.alias_index_values, field_conversion_alias_index_counts: scratch.source_types.source_effect_index.aliases.alias_index_counts}, generics: ProofReplayCallSiteTargetGenerics{field_conversion_generic_params_valid: scratch.source_types.source_generic_params_valid and scratch.source_types.source_generic_param_lines.count == scratch.source_types.source_generic_param_names.count, field_conversion_generic_param_lines: scratch.source_types.source_generic_param_lines, field_conversion_generic_param_names: scratch.source_types.source_generic_param_names, field_conversion_generic_param_owner_offsets: scratch.source_types.source_generic_param_owner_offsets, field_conversion_generic_param_line: position.line, field_conversion_generic_param_owner: owner, field_conversion_generic_param_owner_known: true, field_conversion_generic_param_owner_offset: position.offset.usize(), field_conversion_generic_param_owner_offset_valid: true, field_conversion_generic_param_index_valid: scratch.source_types.source_effect_index.generics.generic_param_line_index_valid, field_conversion_generic_param_index_hashes: scratch.source_types.source_effect_index.generics.generic_param_line_index_hashes, field_conversion_generic_param_index_values: scratch.source_types.source_effect_index.generics.generic_param_line_index_values, field_conversion_generic_param_index_counts: scratch.source_types.source_effect_index.generics.generic_param_line_index_counts, field_conversion_generic_owner_index_valid: scratch.source_types.source_effect_index.generics.generic_owner_index_valid, field_conversion_generic_owner_index_hashes: scratch.source_types.source_effect_index.generics.generic_owner_index_hashes, field_conversion_generic_owner_index_values: scratch.source_types.source_effect_index.generics.generic_owner_index_values, field_conversion_generic_owner_index_counts: scratch.source_types.source_effect_index.generics.generic_owner_index_counts, field_conversion_generic_owner_index_entries: scratch.source_types.source_effect_index.generics.generic_owner_index_entries, field_conversion_generic_function_index_valid: scratch.source_types.source_effect_index.generics.generic_function_index_valid, field_conversion_generic_function_index_hashes: scratch.source_types.source_effect_index.generics.generic_function_index_hashes, field_conversion_generic_function_index_values: scratch.source_types.source_effect_index.generics.generic_function_index_values, field_conversion_generic_function_index_counts: scratch.source_types.source_effect_index.generics.generic_function_index_counts, field_conversion_generic_function_index_entries: scratch.source_types.source_effect_index.generics.generic_function_index_entries}, types: ProofReplayCallSiteTargetTypes{field_conversion_declared_types: scratch.source_types.source_effect_index.types.declared_types, field_conversion_declared_type_owners: scratch.source_types.source_effect_index.types.declared_type_owners, field_conversion_declared_type_scope_index_valid: scratch.source_types.source_effect_index.types.declared_type_scope_index_valid, field_conversion_declared_type_scope_index_hashes: scratch.source_types.source_effect_index.types.declared_type_scope_index_hashes, field_conversion_declared_type_scope_index_values: scratch.source_types.source_effect_index.types.declared_type_scope_index_values, field_conversion_declared_type_scope_index_counts: scratch.source_types.source_effect_index.types.declared_type_scope_index_counts, field_conversion_declared_type_index_valid: scratch.source_types.source_effect_index.types.declared_type_index_valid, field_conversion_declared_type_index_hashes: scratch.source_types.source_effect_index.types.declared_type_index_hashes, field_conversion_declared_type_index_values: scratch.source_types.source_effect_index.types.declared_type_index_values, field_conversion_declared_type_index_counts: scratch.source_types.source_effect_index.types.declared_type_index_counts}}
                    call_target.capture.capture_callee_paths <- true
                    return false if:
                        not proof_replay_source_calls_with_target_work(parameters, body, annotations, &calls, call_target, work)
                        not proof_replay_deterministic_signature_calls(signature_lines, signature_kinds, signature_contracts, position.line, parameters, annotations, &calls, call_target, work)
                        call_target.selection.unresolved_dispatch_found
                        work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or call_target.capture.captured_callee_paths.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                    work <- work + call_target.capture.captured_callee_paths.count
                    next_active: mutable darray[usize] = []
                    return false if work > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT or active.count > PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT - work
                    work <- work + active.count
                    next_active.extend(active)
                    return false if not proof_replay_deterministic_call_budget_charge(1, work)
                    next_active.push(declaration_row)
                    for called_callee in call_target.capture.captured_callee_paths |declarations, declaration_index, aliases, annotations, signature_lines, signature_kinds, signature_contracts, next_active, work, depth, owner, scratch, call_target|:
                        match called_callee:
                            Ast::Expr.Ident(called_name, _):
                                selected: (complete: bool, matches: usize, row: usize, declaration: Ast::Decl, owner: sview) = proof_replay_deterministic_bare_declaration(declaration_index, called_name, declaration_row, work)
                                return false if:
                                    not selected.complete or selected.matches != 1
                                    not proof_replay_deterministic_function_declaration(declarations, declaration_index, aliases, annotations, signature_lines, signature_kinds, signature_contracts, called_name, selected.owner, selected.declaration, selected.row, scratch, next_active, work, depth + 1)
                            Ast::Expr.Scope(_, called_name, _):
                                called_declaration: mutable Ast::Decl = Ast::Decl.Invalid
                                called_owner: mutable sview = ""
                                called_row: mutable usize = 0
                                called_matches: mutable usize = 0
                                return false if:
                                    not proof_replay_deterministic_qualified_declaration(declaration_index, called_name, called_callee, owner, aliases, called_declaration, called_owner, called_row, called_matches, work)
                                    called_matches != 1
                                    not proof_replay_deterministic_function_declaration(declarations, declaration_index, aliases, annotations, signature_lines, signature_kinds, signature_contracts, called_name, called_owner, called_declaration, called_row, scratch, next_active, work, depth + 1)
                            _:
                                return false
                    declaration_index.entries[declaration_row].validated_deterministic_call <- true
                    return true
                _:
                    return false

        def proof_replay_deterministic_call_valid(report: mutable ProofReport&, trace: ProofFactTrace) -> bool:
            work: mutable usize = 0
            return proof_replay_deterministic_call_valid_with_work(report, trace, &work)

        def proof_replay_deterministic_call_valid_with_work(report: mutable ProofReport&, trace: ProofFactTrace, work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_deterministic_call_valid_with_cache(report, trace, work, &cache)

        def proof_replay_deterministic_call_valid_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if:
                not proof_replay_deterministic_call_declaration_index_ensure(report, work, cache)
                not proof_replay_deterministic_call_alias_index_ensure(report, work, cache)
                not proof_replay_summary_expr_charge_with_work(trace.expression, work)
                not proof_replay_deterministic_call_alias_imports_ensure(report, work, cache)
            marker = trace.expression
            match marker:
                Ast::Expr.Call(Ast::Expr.Ident(marker_name, _), arguments, _, _):
                    return false if marker_name != "__elisa_primitive_scalar_type" or arguments.count != 1
                    match arguments[0]:
                        Ast::Expr.Call(callee_expression, call_arguments, _, _):
                            callee: mutable sview = ""
                            resolved_declaration: mutable Ast::Decl = Ast::Decl.Invalid
                            resolved_owner: mutable sview = ""
                            resolved_row: mutable usize = 0
                            resolved_call: mutable bool = false
                            caller_line: u32 = proof_replay_trace_owner_source_position_line_for_trace_with_work(report, trace, work)
                            caller: (complete: bool, matches: usize, row: usize) = proof_replay_deterministic_candidate_at_callsite(cache.declaration_index, trace.name, caller_line, work)
                            return false if caller_line == 0 or not caller.complete or caller.matches != 1 or caller.row >= cache.declaration_index.entries.count
                            match callee_expression:
                                Ast::Expr.Ident(name, _):
                                    selected: (complete: bool, matches: usize, row: usize, declaration: Ast::Decl, owner: sview) = proof_replay_deterministic_bare_declaration(cache.declaration_index, name, caller.row, work)
                                    return false if not selected.complete or selected.matches != 1
                                    callee <- name
                                    resolved_declaration <- selected.declaration
                                    resolved_owner <- selected.owner
                                    resolved_row <- selected.row
                                    resolved_call <- true
                                Ast::Expr.Scope(_, name, _):
                                    qualified_matches: mutable usize = 0
                                    # Normalized nested declarations retain the lexical owner path for alias visibility.
                                    caller_owner: sview = cache.declaration_index.entries[caller.row].owner
                                    return false if:
                                        not proof_replay_deterministic_qualified_declaration(cache.declaration_index, name, callee_expression, caller_owner, cache.alias_index, resolved_declaration, resolved_owner, resolved_row, qualified_matches, work)
                                        qualified_matches != 1
                                    callee <- name
                                    resolved_call <- true
                                _:
                                    return false
                            for argument in call_arguments:
                                # Reject reference actuals through wrappers; replay must match the producer's resolved-type check.
                                # Inspecting only the outer node could accept a forged scalar-call marker.
                                return false if proof_replay_deterministic_parameter_type(argument, 0)
                            return false if:
                                not proof_replay_deterministic_call_source_site_with_cache(report, trace, arguments[0], work, cache)
                                not proof_replay_deterministic_signature_table_valid(report.source_contracts.source_signature_contract_lines, report.source_contracts.source_signature_contract_kinds, report.source_contracts.source_signature_contracts, work)
                                not proof_replay_deterministic_analysis_context_ensure(report, work, cache)
                            active: mutable darray[usize] = []
                            return proof_replay_deterministic_function_declaration(report.source.source_declarations, cache.declaration_index, cache.alias_index, report.source.source_annotations, report.source_contracts.source_signature_contract_lines, report.source_contracts.source_signature_contract_kinds, report.source_contracts.source_signature_contracts, callee, resolved_owner, resolved_declaration, resolved_row, &cache.analysis_scratch, active, work, 0) if resolved_call
                            return false
                        _:
                            return false
                _:
                    return false
