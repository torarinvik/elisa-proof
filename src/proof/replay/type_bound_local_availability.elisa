# A local's declared scalar range becomes available only after its initializer has
# completed. The source checker records the witness at the declaration line, but replay
# certificates carry no source column; a certificate before the declaration on that line
# can still refer to an outer binding with the same spelling.
extend ElisaProof:
    private:
        struct ProofReplayTypeBoundSourceExtent:
            end_line: u32
            end_offset: u32
            offsets_complete: bool

        const PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT: usize = 96

        def proof_replay_type_bound_extent_empty() -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 0, end_offset: 0, offsets_complete: true}

        def proof_replay_type_bound_extent_from_position(position: Ast::Pos) -> ProofReplayTypeBoundSourceExtent:
            end_line: u32 = position.end_line if position.end_line > 0 else position.line
            complete: bool = position.end_offset != 0 or position.line == 0 and position.end_line == 0
            return ProofReplayTypeBoundSourceExtent{end_line: end_line, end_offset: position.end_offset, offsets_complete: complete}

        def proof_replay_type_bound_position_after_extent(position: Ast::Pos, extent: ProofReplayTypeBoundSourceExtent) -> bool:
            return false if position.line == 0
            if extent.offsets_complete and position.offset != 0:
                return position.offset > extent.end_offset
            return position.line > extent.end_line

        def proof_replay_type_bound_extent_merge(left: ProofReplayTypeBoundSourceExtent, right: ProofReplayTypeBoundSourceExtent) -> ProofReplayTypeBoundSourceExtent:
            end_line: u32 = right.end_line if right.end_line > left.end_line else left.end_line
            end_offset: u32 = right.end_offset if right.end_offset > left.end_offset else left.end_offset
            return ProofReplayTypeBoundSourceExtent{end_line: end_line, end_offset: end_offset, offsets_complete: left.offsets_complete and right.offsets_complete}

        def proof_replay_type_bound_exprs_extent(expressions: darray[Ast::Expr]&, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for expression in expressions |depth, last|:
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(expression, depth + 1))
            return last

        def proof_replay_type_bound_fields_extent(fields: darray[Ast::FieldInit]&, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for field in fields |depth, last|:
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(field.value, depth + 1))
            return last

        def proof_replay_type_bound_arms_extent(arms: darray[Ast::MatchArm]&, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for arm in arms |depth, last|:
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_extent_from_position(arm.pos))
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(arm.guard, depth + 1))
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(arm.body, depth + 1))
            return last

        def proof_replay_type_bound_stmt_extent(statement: Ast::Stmt, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            match statement:
                Ast::Stmt.Invalid:
                    return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false}
                Ast::Stmt.Expr(expression, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(expression, depth + 1))
                Ast::Stmt.Block(_, _, _, body, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                Ast::Stmt.VarDecl(_, type_expression, value, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(type_expression, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(value, depth + 1))
                Ast::Stmt.Assign(target, _, value, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(target, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(value, depth + 1))
                Ast::Stmt.If(condition, yes, no, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(condition, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(yes, depth))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(no, depth))
                Ast::Stmt.While(condition, body, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(condition, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                Ast::Stmt.For(_, _, iterable, body, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(iterable, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                Ast::Stmt.Return(value, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    if value is returned:
                        last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(returned, depth + 1))
                Ast::Stmt.Break(_, position) | Ast::Stmt.Continue(_, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                Ast::Stmt.Match(scrutinee, arms, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(scrutinee, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_arms_extent(arms, depth))
                Ast::Stmt.Contract(_, expression, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(expression, depth + 1))
                _:
                    return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false}
            return last

        def proof_replay_type_bound_stmts_extent(body: darray[Ast::Stmt]&, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for statement in body |depth, last|:
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmt_extent(statement, depth + 1))
            return last

        # The extent visitors below are deliberately simple tree folds. Preflight every body
        # and report expression through the bounded source-use walker first, so wide child arrays
        # cannot turn these folds into unbounded replay work. The impossible source-use query also
        # makes an unknown AST constructor fail closed during the preflight.
        def proof_replay_type_bound_extent_preflight(body: darray[Ast::Stmt]&, first: Ast::Expr, has_first: bool, second: Ast::Expr, has_second: bool) -> bool:
            work: mutable usize = 0
            dummy_use: Ast::Expr = Ast::Expr.Invalid
            dummy_position: Ast::Pos = Ast::pos_at_line(0)
            body_uses: usize = proof_replay_type_bound_index_use_body(body, "", dummy_use, 0, dummy_position, &work, 0)
            return false if body_uses != 0 or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            if has_first:
                first_uses: usize = proof_replay_type_bound_index_use(first, "", dummy_use, 0, dummy_position, &work, 0)
                return false if first_uses != 0 or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            if has_second:
                second_uses: usize = proof_replay_type_bound_index_use(second, "", dummy_use, 0, dummy_position, &work, 0)
                return false if second_uses != 0 or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            return true

        # Composite node positions are often anchored at the opening token. Include every
        # child token and nested recovery statement, so same-line certificates can be ordered
        # against the initializer instead of treating a declaration line as atomic.
        def proof_replay_type_bound_expr_extent(expression: Ast::Expr, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_from_position(Ast::expr_pos(expression))
            match expression:
                Ast::Expr.Invalid:
                    return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false}
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _) | Ast::Expr.StaticEffectCall(callee, _, _, arguments, _, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(callee, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_exprs_extent(arguments, depth))
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(object, depth + 1))
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(object, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(index, depth + 1))
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(object, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(low, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(high, depth + 1))
                Ast::Expr.IndexN(object, arguments, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(object, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_exprs_extent(arguments, depth))
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_exprs_extent(elements, depth))
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, last|:
                        last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(entry.key, depth + 1))
                        last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(entry.value, depth + 1))
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(base, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_fields_extent(fields, depth))
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(subject, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_arms_extent(arms, depth))
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(iterable, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(condition, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(body, depth + 1))
                Ast::Expr.GetElse(guarded, recovery, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(guarded, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(recovery, depth))
                Ast::Expr.Lambda(_, body, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                Ast::Expr.Block(body, value, _, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(value, depth + 1))
                _:
                    return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false}
            return last

        def proof_replay_type_bound_local_scalar_consumer_available(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&) -> bool:
            return true if report.trace_consumer_certificate_index == 0
            return false if report.trace_consumer_certificate_index > report.certificates.count or report.trace_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line
            return false if report.goal_attempts.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            return false if not proof_replay_type_bound_extent_preflight(body, trace.expression, true, certificate.goal, true)
            source_matches: mutable usize = 0
            proof_replay_type_bound_consumer_source_site_in_body(body, certificate, &source_matches, 0)
            return false if source_matches != 1
            attempt_matches: mutable usize = 0
            for attempt in report.goal_attempts |report, certificate, attempt_matches|:
                continue if not attempt.has_certificate or attempt.certificate_index != report.trace_consumer_certificate_index - 1
                return false if not proof_replay_attempt_matches_certificate(report, attempt, certificate, report.trace_consumer_certificate_index - 1)
                return false if not proof_replay_type_bound_goal_position_matches(attempt.goal, certificate.goal)
                attempt_matches <- attempt_matches + 1
            return false if attempt_matches != 1
            declarations: mutable usize = 0
            declaration_extent: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for statement in body |trace, declarations, declaration_extent|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, local_type, initializer, position):
                        continue if local_name == "" or position.line != trace.line
                        continue if not proof_expr_mentions_name(trace.expression, local_name)
                        declarations <- declarations + 1
                        declaration_extent <- proof_replay_type_bound_extent_from_position(position)
                        declaration_extent <- proof_replay_type_bound_extent_merge(declaration_extent, proof_replay_type_bound_expr_extent(local_type, 0))
                        declaration_extent <- proof_replay_type_bound_extent_merge(declaration_extent, proof_replay_type_bound_expr_extent(initializer, 0))
                    _:
                        pass
            return false if declarations != 1
            goal_position: Ast::Pos = Ast::expr_pos(certificate.goal)
            if declaration_extent.offsets_complete and goal_position.offset != 0:
                return goal_position.offset > declaration_extent.end_offset
            return goal_position.line > declaration_extent.end_line

        # Local arrays can supply a bound fact at a later index use, so locate the exact
        # declaration by name and source position instead of assuming it shares the fact line.
        # The local extent validator calls this only after resolving the fact's array root.
        def proof_replay_type_bound_local_array_consumer_available(report: ProofReport&, body: darray[Ast::Stmt]&, use_position: Ast::Pos, trace_name: sview, local_name: sview, local_position: Ast::Pos) -> bool:
            return false if use_position.line == 0 or trace_name == "" or local_name == ""
            has_consumer: bool = report.trace_consumer_certificate_index != 0
            return false if has_consumer and (report.trace_consumer_certificate_index > report.certificates.count or report.trace_owner_line == 0)
            certificate_index: usize = report.trace_consumer_certificate_index - 1 if has_consumer else 0
            consumer_goal: mutable Ast::Expr = Ast::Expr.Invalid
            if has_consumer:
                certificate: ProofGoalCertificate = report.certificates[certificate_index]
                return false if certificate.name != trace_name or certificate.line != report.trace_owner_line
                return false if report.goal_attempts.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                consumer_goal <- certificate.goal
                return false if not proof_replay_type_bound_extent_preflight(body, Ast::Expr.Absent, false, consumer_goal, true)
                source_matches: mutable usize = 0
                proof_replay_type_bound_consumer_source_site_in_body(body, certificate, &source_matches, 0)
                return false if source_matches != 1
                attempt_matches: mutable usize = 0
                for attempt in report.goal_attempts |report, certificate, certificate_index, attempt_matches|:
                    continue if not attempt.has_certificate or attempt.certificate_index != certificate_index
                    return false if not proof_replay_attempt_matches_certificate(report, attempt, certificate, certificate_index)
                    return false if attempt.source_phase != certificate.source_phase
                    return false if not proof_replay_type_bound_goal_position_matches(attempt.goal, certificate.goal)
                    attempt_matches <- attempt_matches + 1
                return false if attempt_matches != 1
            else:
                return false if not proof_replay_type_bound_extent_preflight(body, Ast::Expr.Absent, false, consumer_goal, false)
            return false if not proof_replay_source_single_declaration(report.source_declarations, body, local_name)
            declarations: mutable usize = 0
            declaration_extent: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for statement in body |local_name, local_position, declarations, declaration_extent|:
                match statement:
                    Ast::Stmt.VarDecl(name, local_type, initializer, position):
                        continue if name != local_name or not proof_replay_source_position_equal(position, local_position)
                        declarations <- declarations + 1
                        declaration_extent <- proof_replay_type_bound_extent_from_position(position)
                        declaration_extent <- proof_replay_type_bound_extent_merge(declaration_extent, proof_replay_type_bound_expr_extent(local_type, 0))
                        declaration_extent <- proof_replay_type_bound_extent_merge(declaration_extent, proof_replay_type_bound_expr_extent(initializer, 0))
                    _:
                        pass
            return false if declarations != 1
            # The fact must already describe this local at its source use. Checking only the
            # later consumer would let a same-name outer array used in this initializer borrow
            # the local's fixed extent.
            return false if not proof_replay_type_bound_position_after_extent(use_position, declaration_extent)
            if not has_consumer:
                return true
            goal_position: Ast::Pos = Ast::expr_pos(consumer_goal)
            return proof_replay_type_bound_position_after_extent(goal_position, declaration_extent)
