# A local's declared scalar range becomes available only after its initializer has
# completed. The source checker records the witness at the declaration line, but replay
# certificates carry no source column; a certificate earlier on that line can still refer
# to an outer binding with the same spelling. Keep the range usable after the declaration
# while refusing consumers before or inside the declaration's full source span.
extend ElisaProof:
    private:
        const PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT: usize = 96

        def proof_replay_type_bound_availability_exprs_last_line(expressions: darray[Ast::Expr]&, depth: usize) -> u32:
            return 4294967295 if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable u32 = 0
            for expression in expressions |depth, last|:
                child: u32 = proof_replay_type_bound_availability_expr_last_line(expression, depth + 1)
                last <- child if child > last
            return last

        def proof_replay_type_bound_availability_fields_last_line(fields: darray[Ast::FieldInit]&, depth: usize) -> u32:
            return 4294967295 if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable u32 = 0
            for field in fields |depth, last|:
                child: u32 = proof_replay_type_bound_availability_expr_last_line(field.value, depth + 1)
                last <- child if child > last
            return last

        def proof_replay_type_bound_availability_arms_last_line(arms: darray[Ast::MatchArm]&, depth: usize) -> u32:
            return 4294967295 if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable u32 = 0
            for arm in arms |depth, last|:
                last <- arm.pos.end_line if arm.pos.end_line > last
                guard_line: u32 = proof_replay_type_bound_availability_expr_last_line(arm.guard, depth + 1)
                body_line: u32 = proof_replay_type_bound_availability_stmts_last_line(arm.body, depth + 1)
                last <- guard_line if guard_line > last
                last <- body_line if body_line > last
            return last

        def proof_replay_type_bound_availability_stmt_last_line(statement: Ast::Stmt, depth: usize) -> u32:
            return 4294967295 if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable u32 = 0
            match statement:
                Ast::Stmt.Invalid:
                    return 0
                Ast::Stmt.Expr(expression, position):
                    last <- position.end_line
                    child: u32 = proof_replay_type_bound_availability_expr_last_line(expression, depth + 1)
                    last <- child if child > last
                Ast::Stmt.Block(_, _, _, body, position):
                    last <- position.end_line
                    child: u32 = proof_replay_type_bound_availability_stmts_last_line(body, depth + 1)
                    last <- child if child > last
                Ast::Stmt.VarDecl(_, type_expression, value, position):
                    last <- position.end_line
                    type_line: u32 = proof_replay_type_bound_availability_expr_last_line(type_expression, depth + 1)
                    value_line: u32 = proof_replay_type_bound_availability_expr_last_line(value, depth + 1)
                    last <- type_line if type_line > last
                    last <- value_line if value_line > last
                Ast::Stmt.Assign(target, _, value, position):
                    last <- position.end_line
                    target_line: u32 = proof_replay_type_bound_availability_expr_last_line(target, depth + 1)
                    value_line: u32 = proof_replay_type_bound_availability_expr_last_line(value, depth + 1)
                    last <- target_line if target_line > last
                    last <- value_line if value_line > last
                Ast::Stmt.If(condition, yes, no, position):
                    last <- position.end_line
                    condition_line: u32 = proof_replay_type_bound_availability_expr_last_line(condition, depth + 1)
                    yes_line: u32 = proof_replay_type_bound_availability_stmts_last_line(yes, depth + 1)
                    no_line: u32 = proof_replay_type_bound_availability_stmts_last_line(no, depth + 1)
                    last <- condition_line if condition_line > last
                    last <- yes_line if yes_line > last
                    last <- no_line if no_line > last
                Ast::Stmt.While(condition, body, position):
                    last <- position.end_line
                    condition_line: u32 = proof_replay_type_bound_availability_expr_last_line(condition, depth + 1)
                    body_line: u32 = proof_replay_type_bound_availability_stmts_last_line(body, depth + 1)
                    last <- condition_line if condition_line > last
                    last <- body_line if body_line > last
                Ast::Stmt.For(_, _, iterable, body, position):
                    last <- position.end_line
                    iterable_line: u32 = proof_replay_type_bound_availability_expr_last_line(iterable, depth + 1)
                    body_line: u32 = proof_replay_type_bound_availability_stmts_last_line(body, depth + 1)
                    last <- iterable_line if iterable_line > last
                    last <- body_line if body_line > last
                Ast::Stmt.Return(value, position):
                    last <- position.end_line
                    if value is returned:
                        value_line: u32 = proof_replay_type_bound_availability_expr_last_line(returned, depth + 1)
                        last <- value_line if value_line > last
                Ast::Stmt.Break(_, position) | Ast::Stmt.Continue(_, position):
                    last <- position.end_line
                Ast::Stmt.Match(scrutinee, arms, position):
                    last <- position.end_line
                    subject_line: u32 = proof_replay_type_bound_availability_expr_last_line(scrutinee, depth + 1)
                    arms_line: u32 = proof_replay_type_bound_availability_arms_last_line(arms, depth + 1)
                    last <- subject_line if subject_line > last
                    last <- arms_line if arms_line > last
                Ast::Stmt.Contract(_, expression, position):
                    last <- position.end_line
                    child: u32 = proof_replay_type_bound_availability_expr_last_line(expression, depth + 1)
                    last <- child if child > last
            return last

        def proof_replay_type_bound_availability_stmts_last_line(body: darray[Ast::Stmt]&, depth: usize) -> u32:
            return 4294967295 if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable u32 = 0
            for statement in body |depth, last|:
                child: u32 = proof_replay_type_bound_availability_stmt_last_line(statement, depth + 1)
                last <- child if child > last
            return last

        # Composite node positions are often anchored at the opening token. Recursively
        # inspect children, including control-flow recovery bodies, to find the true last
        # source line before treating a local's declared type as in scope.
        def proof_replay_type_bound_availability_expr_last_line(expression: Ast::Expr, depth: usize) -> u32:
            return 4294967295 if depth >= ProofReplayTypeBoundAvailability::DEPTH_LIMIT
            position: Ast::Pos = Ast::expr_pos(expression)
            last: mutable u32 = position.end_line
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _) | Ast::Expr.StaticEffectCall(callee, _, _, arguments, _, _):
                    callee_line: u32 = proof_replay_type_bound_availability_expr_last_line(callee, depth + 1)
                    args_line: u32 = proof_replay_type_bound_availability_exprs_last_line(arguments, depth + 1)
                    last <- callee_line if callee_line > last
                    last <- args_line if args_line > last
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    child: u32 = proof_replay_type_bound_availability_expr_last_line(object, depth + 1)
                    last <- child if child > last
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    object_line: u32 = proof_replay_type_bound_availability_expr_last_line(object, depth + 1)
                    index_line: u32 = proof_replay_type_bound_availability_expr_last_line(index, depth + 1)
                    last <- object_line if object_line > last
                    last <- index_line if index_line > last
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    object_line: u32 = proof_replay_type_bound_availability_expr_last_line(object, depth + 1)
                    low_line: u32 = proof_replay_type_bound_availability_expr_last_line(low, depth + 1)
                    high_line: u32 = proof_replay_type_bound_availability_expr_last_line(high, depth + 1)
                    last <- object_line if object_line > last
                    last <- low_line if low_line > last
                    last <- high_line if high_line > last
                Ast::Expr.IndexN(object, arguments, _):
                    object_line: u32 = proof_replay_type_bound_availability_expr_last_line(object, depth + 1)
                    args_line: u32 = proof_replay_type_bound_availability_exprs_last_line(arguments, depth + 1)
                    last <- object_line if object_line > last
                    last <- args_line if args_line > last
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    child: u32 = proof_replay_type_bound_availability_exprs_last_line(elements, depth + 1)
                    last <- child if child > last
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, last|:
                        key_line: u32 = proof_replay_type_bound_availability_expr_last_line(entry.key, depth + 1)
                        value_line: u32 = proof_replay_type_bound_availability_expr_last_line(entry.value, depth + 1)
                        last <- key_line if key_line > last
                        last <- value_line if value_line > last
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    base_line: u32 = proof_replay_type_bound_availability_expr_last_line(base, depth + 1)
                    fields_line: u32 = proof_replay_type_bound_availability_fields_last_line(fields, depth + 1)
                    last <- base_line if base_line > last
                    last <- fields_line if fields_line > last
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    subject_line: u32 = proof_replay_type_bound_availability_expr_last_line(subject, depth + 1)
                    arms_line: u32 = proof_replay_type_bound_availability_arms_last_line(arms, depth + 1)
                    last <- subject_line if subject_line > last
                    last <- arms_line if arms_line > last
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    iterable_line: u32 = proof_replay_type_bound_availability_expr_last_line(iterable, depth + 1)
                    condition_line: u32 = proof_replay_type_bound_availability_expr_last_line(condition, depth + 1)
                    body_line: u32 = proof_replay_type_bound_availability_expr_last_line(body, depth + 1)
                    last <- iterable_line if iterable_line > last
                    last <- condition_line if condition_line > last
                    last <- body_line if body_line > last
                Ast::Expr.GetElse(guarded, recovery, _):
                    guarded_line: u32 = proof_replay_type_bound_availability_expr_last_line(guarded, depth + 1)
                    recovery_line: u32 = proof_replay_type_bound_availability_stmts_last_line(recovery, depth + 1)
                    last <- guarded_line if guarded_line > last
                    last <- recovery_line if recovery_line > last
                Ast::Expr.Lambda(_, body, _):
                    child: u32 = proof_replay_type_bound_availability_stmts_last_line(body, depth + 1)
                    last <- child if child > last
                Ast::Expr.Block(body, value, _, _):
                    body_line: u32 = proof_replay_type_bound_availability_stmts_last_line(body, depth + 1)
                    value_line: u32 = proof_replay_type_bound_availability_expr_last_line(value, depth + 1)
                    last <- body_line if body_line > last
                    last <- value_line if value_line > last
            return last

        def proof_replay_type_bound_local_scalar_consumer_available(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&) -> bool:
            return true if report.trace_consumer_certificate_index == 0
            return false if report.trace_consumer_certificate_index > report.certificates.count or report.trace_owner_line == 0
            certificate: ProofGoalCertificate = report.certificates[report.trace_consumer_certificate_index - 1]
            return false if certificate.name != trace.name or certificate.line != report.trace_owner_line
            declarations: mutable usize = 0
            declaration_end_line: mutable u32 = 0
            for statement in body |trace, declarations, declaration_end_line|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, _, initializer, position):
                        continue if local_name == "" or position.line != trace.line
                        continue if not proof_expr_mentions_name(trace.expression, local_name)
                        declarations <- declarations + 1
                        end_line: u32 = proof_replay_type_bound_availability_expr_last_line(initializer, 0)
                        end_line <- position.end_line if position.end_line > end_line
                        end_line <- position.line if end_line < position.line
                        declaration_end_line <- end_line
                    _:
                        pass
            return false if declarations != 1
            return report.trace_owner_line > declaration_end_line
