# A local's declared scalar range becomes available only after its initializer has
# completed. The source checker records the witness at the declaration line, but replay
# certificates carry no source column; a certificate before the declaration on that line
# can still refer to an outer binding with the same spelling.
extend ElisaProof:
    private:
        struct ProofReplayTypeBoundSourceExtent:
            end_line: u32
            end_offset: u32
            offsets_complete: bool

        const PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT: usize = 96

        def proof_replay_type_bound_extent_empty() -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 0, end_offset: 0, offsets_complete: true}

        def proof_replay_type_bound_extent_from_position(position: Ast::Pos) -> ProofReplayTypeBoundSourceExtent:
            end_line: u32 = position.end_line if position.end_line > 0 else position.line
            complete: bool = position.end_offset != 0 or position.line == 0 and position.end_line == 0
            return ProofReplayTypeBoundSourceExtent{end_line: end_line, end_offset: position.end_offset, offsets_complete: complete}

        def proof_replay_type_bound_position_after_extent(position: Ast::Pos, extent: ProofReplayTypeBoundSourceExtent) -> bool:
            return false if position.line == 0
            if extent.offsets_complete and position.offset != 0:
                return position.offset > extent.end_offset
            return position.line > extent.end_line

        def proof_replay_type_bound_extent_merge(left: ProofReplayTypeBoundSourceExtent, right: ProofReplayTypeBoundSourceExtent) -> ProofReplayTypeBoundSourceExtent:
            end_line: u32 = right.end_line if right.end_line > left.end_line else left.end_line
            end_offset: u32 = right.end_offset if right.end_offset > left.end_offset else left.end_offset
            return ProofReplayTypeBoundSourceExtent{end_line: end_line, end_offset: end_offset, offsets_complete: left.offsets_complete and right.offsets_complete}

        def proof_replay_type_bound_exprs_extent(expressions: darray[Ast::Expr]&, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for expression in expressions |depth, last|:
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(expression, depth + 1))
            return last

        def proof_replay_type_bound_fields_extent(fields: darray[Ast::FieldInit]&, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for field in fields |depth, last|:
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(field.value, depth + 1))
            return last

        def proof_replay_type_bound_arms_extent(arms: darray[Ast::MatchArm]&, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for arm in arms |depth, last|:
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_extent_from_position(arm.pos))
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(arm.guard, depth + 1))
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(arm.body, depth + 1))
            return last

        def proof_replay_type_bound_stmt_extent(statement: Ast::Stmt, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            match statement:
                Ast::Stmt.Invalid:
                    return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false}
                Ast::Stmt.Expr(expression, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(expression, depth + 1))
                Ast::Stmt.Block(_, _, _, body, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                Ast::Stmt.VarDecl(_, type_expression, value, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(type_expression, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(value, depth + 1))
                Ast::Stmt.Assign(target, _, value, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(target, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(value, depth + 1))
                Ast::Stmt.If(condition, yes, no, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(condition, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(yes, depth))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(no, depth))
                Ast::Stmt.While(condition, body, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(condition, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                Ast::Stmt.For(_, _, iterable, body, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(iterable, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                Ast::Stmt.Return(value, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    if value is returned:
                        last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(returned, depth + 1))
                Ast::Stmt.Break(_, position) | Ast::Stmt.Continue(_, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                Ast::Stmt.Match(scrutinee, arms, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(scrutinee, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_arms_extent(arms, depth))
                Ast::Stmt.Contract(_, expression, position):
                    last <- proof_replay_type_bound_extent_from_position(position)
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(expression, depth + 1))
                _:
                    return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false}
            return last

        def proof_replay_type_bound_stmts_extent(body: darray[Ast::Stmt]&, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for statement in body |depth, last|:
                last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmt_extent(statement, depth + 1))
            return last

        # The extent visitors below are deliberately simple tree folds. Preflight every body
        # and report expression through the bounded source-use walker first, so wide child arrays
        # cannot turn these folds into unbounded replay work. The impossible source-use query also
        # makes an unknown AST constructor fail closed during the preflight.
        def proof_replay_type_bound_extent_preflight(body: darray[Ast::Stmt]&, first: Ast::Expr, has_first: bool, second: Ast::Expr, has_second: bool) -> bool:
            work: mutable usize = 0
            return proof_replay_type_bound_extent_preflight_with_work(body, first, has_first, second, has_second, &work)

        def proof_replay_type_bound_extent_preflight_with_work(body: darray[Ast::Stmt]&, first: Ast::Expr, has_first: bool, second: Ast::Expr, has_second: bool, work: mutable usize&) -> bool:
            dummy_use: Ast::Expr = Ast::Expr.Invalid
            dummy_position: Ast::Pos = Ast::pos_at_line(0)
            body_uses: usize = proof_replay_type_bound_index_use_body(body, "", dummy_use, 0, dummy_position, work, 0)
            return false if body_uses != 0 or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            if has_first:
                first_uses: usize = proof_replay_type_bound_index_use(first, "", dummy_use, 0, dummy_position, work, 0)
                return false if first_uses != 0 or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            if has_second:
                second_uses: usize = proof_replay_type_bound_index_use(second, "", dummy_use, 0, dummy_position, work, 0)
                return false if second_uses != 0 or work >= PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
            return true

        # Some source predicates below still use the shared legacy walkers. Charge a complete
        # bounded body walk before invoking each one, so repeated fact checks pay for those
        # passes in the same report-level budget.
        def proof_replay_type_bound_body_charge_with_work(body: darray[Ast::Stmt]&, work: mutable usize&) -> bool:
            cost: mutable usize = 0
            return false if:
                not proof_replay_summary_expr_cost_body(body, cost, work, 0)
                cost > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
            work <- work + cost
            return true

        # Composite node positions are often anchored at the opening token. Include every
        # child token and nested recovery statement, so same-line certificates can be ordered
        # against the initializer instead of treating a declaration line as atomic.
        def proof_replay_type_bound_expr_extent(expression: Ast::Expr, depth: usize) -> ProofReplayTypeBoundSourceExtent:
            return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false} if depth >= PROOF_REPLAY_TYPE_BOUND_AVAILABILITY_DEPTH_LIMIT
            last: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_from_position(Ast::expr_pos(expression))
            match expression:
                Ast::Expr.Invalid:
                    return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false}
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(callee, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_exprs_extent(arguments, depth))
                Ast::Expr.StaticEffectCall(_, _, _, arguments, _, _):
                    # The effect head is compile-time metadata. Only the explicit operands have
                    # source spans in this rewritten call; captured ABI identifiers use line 0.
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_exprs_extent(arguments, depth))
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(object, depth + 1))
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _) | Ast::Expr.Refinement(object, index, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(object, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(index, depth + 1))
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(object, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(low, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(high, depth + 1))
                Ast::Expr.IndexN(object, arguments, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(object, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_exprs_extent(arguments, depth))
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_exprs_extent(elements, depth))
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, last|:
                        last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(entry.key, depth + 1))
                        last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(entry.value, depth + 1))
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(base, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_fields_extent(fields, depth))
                Ast::Expr.Match(subject, arms, _) | Ast::Expr.Catch(subject, arms, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(subject, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_arms_extent(arms, depth))
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(iterable, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(condition, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(body, depth + 1))
                Ast::Expr.GetElse(guarded, recovery, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(guarded, depth + 1))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(recovery, depth))
                Ast::Expr.Lambda(_, body, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                Ast::Expr.Block(body, value, _, _):
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_stmts_extent(body, depth))
                    last <- proof_replay_type_bound_extent_merge(last, proof_replay_type_bound_expr_extent(value, depth + 1))
                _:
                    return ProofReplayTypeBoundSourceExtent{end_line: 4294967295, end_offset: 4294967295, offsets_complete: false}
            return last

        def proof_replay_type_bound_local_scalar_consumer_available(report: ProofReport&, trace: ProofFactTrace, body: darray[Ast::Stmt]&) -> bool:
            work: mutable usize = 0
            empty_parameters: darray[Ast::ParamDecl] = []
            return proof_replay_type_bound_local_scalar_consumer_available_with_work(report, trace, empty_parameters, body, false, &work)

        # A type-bound trace stores a spelling, while the kernel fact arena has no source
        # binding IDs. Reject it if a same-name declaration can shadow its source binding
        # before the consuming goal. Completed statements before the goal are scanned in full;
        # a statement whose span overlaps the goal is treated as ambiguous and scanned whole.
        def proof_replay_type_bound_binding_shadowed_before_consumer_with_work(report: ProofReport&, body: darray[Ast::Stmt]&, name: sview, source_position: Ast::Pos, after_source_statement: bool, work: mutable usize&) -> bool:
            return true if name == "" or not proof_replay_type_bound_body_charge_with_work(body, work)
            if report.analysis_2.trace_consumer_certificate_index == 0:
                # Without a pinned consumer site, keep the legacy path conservative: the
                # parameter spelling must remain unshadowed throughout the body.
                return not proof_replay_source_body_declares_with_work(report.source.source_declarations, body, name, work)
            return true if report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return true if:
                certificate.name != name or certificate.line != report.analysis_2.trace_owner_line
                certificate.goal == Ast::Expr.Invalid
            goal_position: Ast::Pos = Ast::expr_pos(certificate.goal)
            return true if goal_position.line == 0
            prefix: mutable darray[Ast::Stmt] = []
            source_matches: mutable usize = 0
            source_seen: mutable bool = not after_source_statement
            for statement in body |report, name, source_position, goal_position, prefix, source_matches, source_seen, work|:
                return true if not proof_replay_type_bound_local_work_charge(1, work)
                position: Ast::Pos = proof_replay_statement_position(statement)
                if after_source_statement and proof_replay_source_position_equal(position, source_position):
                    source_matches <- source_matches + 1
                    source_seen <- true
                    continue
                continue if not source_seen
                return true if position.line == 0
                extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(statement, 0)
                before_goal: mutable bool = false
                after_goal: mutable bool = false
                if position.offset != 0 and goal_position.offset != 0 and extent.offsets_complete and extent.end_offset != 0:
                    before_goal <- goal_position.offset > extent.end_offset
                    after_goal <- position.offset > goal_position.offset
                else:
                    before_goal <- extent.end_line < goal_position.line
                    after_goal <- position.line > goal_position.line
                break if after_goal
                return true if not proof_replay_type_bound_local_work_charge(1, work)
                prefix.push(statement)
                break if not before_goal
            return true if after_source_statement and source_matches != 1
            proof_replay_source_body_declares_with_work(report.source.source_declarations, prefix, name, work)

        def proof_replay_type_bound_local_scalar_consumer_available_with_work(report: ProofReport&, trace: ProofFactTrace, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, allow_result_substitution: bool, work: mutable usize&) -> bool:
            return true if report.analysis_2.trace_consumer_certificate_index == 0
            return false if report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count or report.analysis_2.trace_owner_line == 0
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                not proof_replay_type_bound_local_text_compare_charge(certificate.name, trace.name, work)
                certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
                report.results.goal_attempts.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                not proof_replay_summary_expr_charge_with_work(certificate.goal, work)
                not proof_replay_type_bound_extent_preflight_with_work(body, trace.expression, true, certificate.goal, true, work)
            source_matches: mutable usize = 0
            result_substitution_consumer: mutable bool = false
            proof_replay_type_bound_consumer_source_site_in_body_with_work(body, certificate, &source_matches, work, 0)
            if source_matches == 0 and allow_result_substitution:
                return false if not proof_replay_type_bound_body_charge_with_work(body, work)
                if proof_replay_type_bound_result_consumer_matches(report, trace, certificate, parameters, body, work):
                    source_matches <- 1
                    result_substitution_consumer <- true
            return false if:
                source_matches != 1
                report.results.goal_attempts.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
            work <- work + report.results.goal_attempts.count
            attempt_matches: mutable usize = 0
            for attempt in report.results.goal_attempts |report, certificate, attempt_matches, work|:
                continue if not attempt.has_certificate or attempt.certificate_index != report.analysis_2.trace_consumer_certificate_index - 1
                return false if:
                    not proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, report.analysis_2.trace_consumer_certificate_index - 1, work)
                    not proof_replay_type_bound_goal_position_matches(attempt.goal, certificate.goal)
                attempt_matches <- attempt_matches + 1
            return false if:
                attempt_matches != 1
                not proof_replay_type_bound_body_charge_with_work(body, work)
            declarations: mutable usize = 0
            binding_name: mutable sview = ""
            declaration_extent: mutable ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_empty()
            for statement in body |trace, declarations, declaration_extent, work|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, local_type, initializer, position):
                        continue if local_name == "" or position.line != trace.line
                        return false if not proof_replay_summary_expr_charge_with_work(trace.expression, work)
                        continue if not proof_expr_mentions_name(trace.expression, local_name)
                        declarations <- declarations + 1
                        binding_name <- local_name
                        declaration_extent <- proof_replay_type_bound_extent_from_position(position)
                        declaration_extent <- proof_replay_type_bound_extent_merge(declaration_extent, proof_replay_type_bound_expr_extent(local_type, 0))
                        declaration_extent <- proof_replay_type_bound_extent_merge(declaration_extent, proof_replay_type_bound_expr_extent(initializer, 0))
                    _:
                        pass
            return false if declarations != 1
            # A later declaration can shadow this spelling before the consumer goal. The
            # kernel sees names rather than source binding identities, so require the source
            # body to have exactly one declaration of this local name.
            return false if proof_replay_type_bound_binding_shadowed_before_consumer_with_work(report, body, binding_name, Ast::expr_pos(trace.expression), true, work)
            # The contract appears before the body that computes `result`; the exact tail
            # substitution above supplies the source-order link for this narrow case.
            return true if result_substitution_consumer
            goal_position: Ast::Pos = Ast::expr_pos(certificate.goal)
            if declaration_extent.offsets_complete and goal_position.offset != 0:
                return goal_position.offset > declaration_extent.end_offset
            return goal_position.line > declaration_extent.end_line

        # Parameter type facts are valid only while the parameter binding is the active
        # source binding. A report can retain an authentic entry marker after a local shadows
        # the parameter, so bind it to the certificate's exact consumer site before admitting
        # the fact into the kernel context.
        def proof_replay_type_bound_parameter_consumer_binding_available_with_work(report: ProofReport&, trace: ProofFactTrace, parameter_name: sview, body: darray[Ast::Stmt]&, work: mutable usize&) -> bool:
            return false if parameter_name == ""
            if report.analysis_2.trace_consumer_certificate_index == 0:
                # Without a pinned consumer site, keep this path conservative across the body.
                return not proof_replay_source_body_declares_with_work(report.source.source_declarations, body, parameter_name, work)
            return false if:
                report.analysis_2.trace_consumer_certificate_index > report.analysis_1.certificates.count
                report.analysis_2.trace_owner_line == 0
            certificate: ProofGoalCertificate = report.analysis_1.certificates[report.analysis_2.trace_consumer_certificate_index - 1]
            return false if:
                not proof_replay_type_bound_local_text_compare_charge(certificate.name, trace.name, work)
                certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
                not proof_replay_type_bound_local_text_repeat_charge(parameter_name, 1, work)
                report.results.goal_attempts.count > PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work
            work <- work + report.results.goal_attempts.count
            attempt_matches: mutable usize = 0
            for attempt in report.results.goal_attempts |attempt, report, certificate, attempt_matches, work|:
                continue if not attempt.has_certificate or attempt.certificate_index != report.analysis_2.trace_consumer_certificate_index - 1
                return false if:
                    not proof_replay_attempt_matches_certificate_with_work(report, attempt, certificate, report.analysis_2.trace_consumer_certificate_index - 1, work)
                    not proof_replay_type_bound_goal_position_matches(attempt.goal, certificate.goal)
                attempt_matches <- attempt_matches + 1
            return false if attempt_matches != 1
            source_matches: mutable usize = 0
            proof_replay_type_bound_consumer_source_site_in_body_with_work(body, certificate, &source_matches, work, 0)
            return false if source_matches != 1
            shadowed_at_consumer: mutable bool = false
            return false if not proof_replay_type_bound_parameter_consumer_scope_in_body_with_work(body, certificate, parameter_name, report, false, &shadowed_at_consumer, work, 0)
            not shadowed_at_consumer

        def proof_replay_type_bound_parameter_assert_consumer_matches(expression: Ast::Expr, certificate: ProofGoalCertificate, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT or not proof_replay_type_bound_local_work_charge(1, work)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_type_bound_parameter_assert_consumer_matches(inner, certificate, work, depth + 1)
                Ast::Expr.Call(Ast::Expr.Ident("assert", _), arguments, _, position):
                    return position.line == certificate.line and arguments.count == 1 and proof_replay_type_bound_goal_position_matches(arguments[0], certificate.goal, work)
                _:
                    return false

        def proof_replay_type_bound_parameter_consumer_scope_in_body_with_work(body: darray[Ast::Stmt]&, certificate: ProofGoalCertificate, parameter_name: sview, report: ProofReport&, shadowed: bool, consumer_shadowed: mutable bool&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            current_shadowed: mutable bool = shadowed
            for statement in body |statement, certificate, parameter_name, current_shadowed, consumer_shadowed, work, depth|:
                return false if not proof_replay_type_bound_local_work_charge(1, work)
                match statement:
                    Ast::Stmt.VarDecl(local_name, _, _, _):
                        return false if not proof_replay_type_bound_local_text_compare_charge(local_name, parameter_name, work)
                        current_shadowed <- true if local_name == parameter_name
                    Ast::Stmt.Assign(target, operator, _, _):
                        if operator == TokenKind.Assign:
                            local_name: sview = proof_ident_name(target)
                            if local_name != "":
                                return false if not proof_replay_type_bound_local_text_compare_charge(local_name, parameter_name, work)
                                current_shadowed <- true if local_name == parameter_name
                    Ast::Stmt.Block(_, _, binding, nested, _):
                        return false if not proof_replay_type_bound_local_text_compare_charge(binding, parameter_name, work)
                        nested_shadowed: bool = current_shadowed or binding == parameter_name
                        nested_source_matches: mutable usize = 0
                        proof_replay_type_bound_consumer_source_site_in_body_with_work(nested, certificate, &nested_source_matches, work, depth + 1)
                        return false if nested_source_matches > 1
                        if nested_source_matches == 1:
                            return false if not proof_replay_type_bound_parameter_consumer_scope_in_body_with_work(nested, certificate, parameter_name, report, nested_shadowed, consumer_shadowed, work, depth + 1)
                            return true
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        condition_paths: (complete: bool, true_shadowed: bool, false_shadowed: bool) = proof_replay_type_bound_condition_alias_paths_with_work(condition, parameter_name, current_shadowed, report, work, depth + 1)
                        return false if not condition_paths.complete
                        then_matches: mutable usize = 0
                        proof_replay_type_bound_consumer_source_site_in_body_with_work(then_body, certificate, &then_matches, work, depth + 1)
                        return false if then_matches > 1
                        if then_matches == 1:
                            return proof_replay_type_bound_parameter_consumer_scope_in_body_with_work(then_body, certificate, parameter_name, report, condition_paths.true_shadowed, consumer_shadowed, work, depth + 1)
                        else_matches: mutable usize = 0
                        proof_replay_type_bound_consumer_source_site_in_body_with_work(else_body, certificate, &else_matches, work, depth + 1)
                        return false if else_matches > 1
                        if else_matches == 1:
                            return proof_replay_type_bound_parameter_consumer_scope_in_body_with_work(else_body, certificate, parameter_name, report, condition_paths.false_shadowed, consumer_shadowed, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        condition_paths: (complete: bool, true_shadowed: bool, false_shadowed: bool) = proof_replay_type_bound_condition_alias_paths_with_work(condition, parameter_name, current_shadowed, report, work, depth + 1)
                        return false if not condition_paths.complete
                        nested_source_matches: mutable usize = 0
                        proof_replay_type_bound_consumer_source_site_in_body_with_work(nested, certificate, &nested_source_matches, work, depth + 1)
                        return false if nested_source_matches > 1
                        if nested_source_matches == 1:
                            return proof_replay_type_bound_parameter_consumer_scope_in_body_with_work(nested, certificate, parameter_name, report, condition_paths.true_shadowed, consumer_shadowed, work, depth + 1)
                    Ast::Stmt.For(_, variables, iterable, nested, _):
                        nested_source_matches: mutable usize = 0
                        proof_replay_type_bound_consumer_source_site_in_body_with_work(nested, certificate, &nested_source_matches, work, depth + 1)
                        return false if nested_source_matches > 1
                        if nested_source_matches == 1:
                            binder_shadowed: mutable bool = current_shadowed
                            for variable in variables |variable, parameter_name, binder_shadowed, work|:
                                return false if not proof_replay_type_bound_local_text_compare_charge(variable, parameter_name, work)
                                binder_shadowed <- true if variable == parameter_name
                            loop_filter: (complete: bool, shadowed: bool) = proof_replay_type_bound_loop_filter_shadow_with_work(iterable, parameter_name, binder_shadowed, report, work)
                            return false if not loop_filter.complete
                            return proof_replay_type_bound_parameter_consumer_scope_in_body_with_work(nested, certificate, parameter_name, report, loop_filter.shadowed, consumer_shadowed, work, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |arm, certificate, parameter_name, current_shadowed, consumer_shadowed, work, depth|:
                            arm_source_matches: mutable usize = 0
                            proof_replay_type_bound_consumer_source_site_in_body_with_work(arm.body, certificate, &arm_source_matches, work, depth + 1)
                            return false if arm_source_matches > 1
                            if arm_source_matches == 1:
                                pattern_names: mutable darray[sview] = []
                                return false if not proof_replay_call_pattern_bindings_with_work(arm.pattern, &pattern_names, work, depth + 1)
                                binder_shadowed: mutable bool = current_shadowed
                                for pattern_name in pattern_names |pattern_name, parameter_name, binder_shadowed, work|:
                                    return false if not proof_replay_type_bound_local_text_compare_charge(pattern_name, parameter_name, work)
                                    binder_shadowed <- true if pattern_name == parameter_name
                                return proof_replay_type_bound_parameter_consumer_scope_in_body_with_work(arm.body, certificate, parameter_name, report, binder_shadowed, consumer_shadowed, work, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        if proof_replay_type_bound_goal_position_matches(expression, certificate.goal, work):
                            consumer_shadowed <- current_shadowed
                            return true
                    Ast::Stmt.Expr(expression, _):
                        if proof_replay_type_bound_parameter_assert_consumer_matches(expression, certificate, work, depth + 1):
                            consumer_shadowed <- current_shadowed
                            return true
                    Ast::Stmt.Assign(_, _, _, _) | Ast::Stmt.Return(_, _) | Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        return false
                    _:
                        return false
            return false

        # A postcondition over `result` can consume a local scalar bound through the exact
        # final return expression, whether it is written as an implicit tail or `return expr`.
        # The source ensure, after replay-side result substitution, must equal the certificate
        # goal. Branches, result shadowing, unsupported expressions, and ambiguous ensures remain
        # outside this source witness.
        def proof_replay_type_bound_equal_span_return_valid(returned: Ast::Expr, return_position: Ast::Pos, work: mutable usize&) -> bool:
            match returned:
                Ast::Expr.If(condition, then_expression, else_expression, if_position):
                    return false if not proof_replay_type_bound_local_work_charge(4, work)
                    return false if:
                        else_expression == Ast::Expr.Absent
                        not proof_replay_source_position_equal(if_position, return_position)
                    return_extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_extent_from_position(return_position)
                    return false if:
                        not proof_replay_type_bound_position_after_extent(Ast::expr_pos(condition), return_extent)
                        not proof_replay_type_bound_position_after_extent(Ast::expr_pos(then_expression), return_extent)
                        not proof_replay_type_bound_position_after_extent(Ast::expr_pos(else_expression), return_extent)
                    return true
                _:
                    return true

        def proof_replay_type_bound_result_consumer_matches(report: ProofReport&, trace: ProofFactTrace, certificate: ProofGoalCertificate, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, work: mutable usize&) -> bool:
            return false if:
                body.count < 2 or body.count > 4096 or trace.kind != "type-bound"
                not proof_replay_type_bound_local_text_compare_charge(certificate.name, trace.name, work)
                certificate.rule != "goal" or certificate.name != trace.name or certificate.line != report.analysis_2.trace_owner_line
            for parameter in parameters |parameter, work|:
                return false if:
                    not proof_replay_type_bound_local_text_compare_charge(parameter.name, "result", work)
                    parameter.name == "result"

            returned: mutable Ast::Expr = Ast::Expr.Absent
            return_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            explicit_return: mutable bool = false
            match body[body.count - 1]:
                Ast::Stmt.Expr(expression, position):
                    returned <- expression
                    return_position <- position
                Ast::Stmt.Return(expression, position):
                    returned <- expression
                    return_position <- position
                    explicit_return <- true
                _:
                    return false
            returned_position: Ast::Pos = Ast::expr_pos(returned)
            return false if return_position.line == 0 or returned_position.line == 0 or return_position.offset > return_position.end_offset or returned_position.offset > returned_position.end_offset
            # The pinned parser rewrites a block-bodied implicit tail into `Stmt.Return` and
            # gives the statement the same full span as its expression. The parser also anchors
            # `return if ...` at the `return` token, so validate the condition and branch spans
            # before treating that equal-span value as source-position complete.
            if explicit_return and proof_replay_source_position_equal(returned_position, return_position):
                return false if not proof_replay_type_bound_equal_span_return_valid(returned, return_position, work)
                explicit_return <- false
            if explicit_return:
                # The parser owns both spans. Allow a multiline value only when the return token
                # precedes the expression in both source coordinates; reject missing or overlapping
                # token spans rather than inferring order from line numbers alone.
                if return_position.line != returned_position.line:
                    return false if return_position.line > returned_position.line
                return false if return_position.end_offset <= return_position.offset or return_position.offset >= returned_position.offset or return_position.end_offset > returned_position.offset
            else:
                return false if not proof_replay_source_position_equal(returned_position, return_position)
            returned_search_cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost_with_limit(returned, &returned_search_cost, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
            if returned_search_cost > (PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT - work) / 5:
                work <- PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT
                return false
            # Pay for the sizing walk and for the four recursive tail checks before running
            # them, including on paths that find no matching local.
            work <- work + returned_search_cost * 5
            return false if:
                proof_source_expression_has_overloaded_operator(returned, report.source.source_primitive_operator_mask, 0)
                proof_expr_has_call(returned) or proof_expr_has_move(returned)
                proof_replay_type_bound_expression_has_runtime_index(returned, 0)

            # `proof_expr_mentions_name` can scan an entire expression for each local. Measure
            # both expressions once, then charge a conservative per-candidate bound before the
            # repeated scans below.
            trace_search_cost: mutable usize = 0
            return false if:
                not proof_replay_summary_expr_cost_with_limit(trace.expression, &trace_search_cost, work, PROOF_REPLAY_TYPE_BOUND_SOURCE_USE_WORK_LIMIT)
                not proof_replay_type_bound_local_work_charge(trace_search_cost, work)

            local_matches: mutable usize = 0
            ensure_matches: mutable usize = 0
            candidate_seen: mutable bool = false
            candidate_name: mutable sview = ""
            for index in 0..<body.count - 1 |index, body, trace, returned, report, certificate, trace_search_cost, returned_search_cost, local_matches, ensure_matches, candidate_seen, candidate_name, work|:
                match body[index]:
                    Ast::Stmt.Contract(kind, expression, _):
                        return false if kind != "requires" and kind != "ensure" and kind != "ensures"
                        continue if kind == "requires"
                        result_mention: mutable (complete: bool, mentions: bool) = proof_replay_type_bound_local_expr_mentions_name_with_work(expression, "result", work)
                        return false if not result_mention.complete
                        continue if not result_mention.mentions
                        return false if:
                            not proof_replay_type_bound_result_substitution_reserve(expression, returned, work)
                            proof_source_expression_has_overloaded_operator(expression, report.source.source_primitive_operator_mask, 0)
                            proof_expr_has_call(expression) or proof_expr_has_move(expression)
                            proof_replay_type_bound_expression_has_runtime_index(expression, 0)
                        expected_result: (complete: bool, expression: Ast::Expr) = proof_replay_type_bound_substitute_with_work(expression, "result", returned, work)
                        return false if not expected_result.complete
                        expected: Ast::Expr = expected_result.expression
                        continue if proof_replay_expr_is_invalid(expected)
                        residual_result: mutable (complete: bool, mentions: bool) = proof_replay_type_bound_local_expr_mentions_name_with_work(expected, "result", work)
                        return false if not residual_result.complete
                        continue if residual_result.mentions
                        same_goal: bool = proof_replay_summary_expr_equal_with_work(expected, certificate.goal, work)
                        if same_goal and proof_replay_source_position_equal(Ast::expr_pos(expected), Ast::expr_pos(certificate.goal)):
                            ensure_matches <- ensure_matches + 1
                    Ast::Stmt.VarDecl(local_name, _, initializer, position):
                        return false if local_name == "result"
                        if candidate_seen:
                            return false if:
                                not proof_replay_type_bound_local_text_compare_charge(local_name, candidate_name, work)
                                local_name == candidate_name or not proof_replay_type_bound_local_initializer_effect_free(initializer, report.source.source_primitive_operator_mask, work)
                            continue
                        if position.line == trace.line and local_name != "":
                            return false if not proof_replay_type_bound_local_mention_pair_charge(local_name, trace_search_cost, returned_search_cost, work)
                            if proof_expr_mentions_name(trace.expression, local_name) and proof_expr_mentions_name(returned, local_name):
                                local_matches <- local_matches + 1
                                candidate_seen <- true
                                candidate_name <- local_name
                    _:
                        return false
            return local_matches == 1 and candidate_seen and ensure_matches == 1
