extend ElisaProofFrameSource:
    public:
        const FRAME_SOURCE_REPLAY_WORK_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET * 8

        # One counter covers report rows and nested source reconstructions for a
        # frame replay batch. A refused debit must stop the path before its scan.
        def replay_work_charge(amount: usize, work: mutable usize&) -> bool:
            return false if:
                work > FRAME_SOURCE_REPLAY_WORK_LIMIT
                amount > FRAME_SOURCE_REPLAY_WORK_LIMIT - work
            work <- work + amount
            return true

    private:
        def frame_policy_place_work_debit(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, repetitions: usize, work: mutable usize&) -> bool:
            return false if root >= nodes.count or not replay_work_charge(1, work)
            place = nodes[root]
            return false if:
                not replay_work_charge(sview_len(place.kind), work)
                not replay_work_charge(sview_len(place.operator), work)
                not replay_work_charge(sview_len(place.name), work)
                not replay_work_charge(sview_len(place.secondary_name), work)
                place.kind != "frame-place" or place.children_count > 3 or place.children_start > children.count or place.children_count > children.count - place.children_start
                not replay_work_charge(place.children_count, work)
            for index in 0..<place.children_count |index, place, children, nodes, root, repetitions, work|:
                field_root: usize = children[place.children_start + index]
                return false if field_root >= root or field_root >= nodes.count or not replay_work_charge(1, work)
                field = nodes[field_root]
                for repeat in 0..<repetitions |repeat, field, work|:
                    return false if:
                        not replay_work_charge(sview_len(field.kind), work)
                        not replay_work_charge(sview_len(field.operator), work)
                        not replay_work_charge(sview_len(field.name), work)
                        not replay_work_charge(sview_len(field.secondary_name), work)
            return true

        # Account for the bounded root-policy traversal after the caller admits
        # the whole arena once. Source places and policy clauses are capped at 64.
        def frame_policy_replays_after_arena_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if root >= nodes.count or not replay_work_charge(1, work)
            policy = nodes[root]
            return false if:
                not replay_work_charge(sview_len(policy.kind), work)
                policy.kind != "frame-policy"
                not replay_work_charge(sview_len(policy.name), work)
                not replay_work_charge(sview_len(policy.operator), work)
                not replay_work_charge(sview_len(policy.secondary_name), work)
                policy.children_start > children.count or policy.children_count > children.count - policy.children_start
            # policy_replays decodes the actual and each child place, then checks
            # several bounded membership/overlap passes over the clause arrays.
            return false if:
                not replay_work_charge(policy.children_count, work)
                not replay_work_charge(policy.children_count, work)
                not replay_work_charge(policy.children_count, work)
                not replay_work_charge(policy.children_count, work)
                not replay_work_charge(policy.children_count, work)
                not frame_policy_place_work_debit(nodes, children, policy.left, 1, work)
            for clause_index in 0..<policy.children_count |clause_index, policy, nodes, children, work|:
                # write_allowed may compare the actual path against each policy
                # clause twice for overlap's two prefix checks. Reserve that
                # repeated string work before policy replay.
                return false if:
                    not frame_policy_place_work_debit(nodes, children, policy.left, 1, work)
                    not frame_policy_place_work_debit(nodes, children, policy.left, 1, work)
            for index in 0..<policy.children_count |index, policy, nodes, children, work|:
                place_root: usize = children[policy.children_start + index]
                return false if not frame_policy_place_work_debit(nodes, children, place_root, 5, work)
            return (ElisaProofKernelFramePolicy::policy_replays(nodes, children, root) can Global{Read,Write})

        # Derive predicate kind and source occurrence from the original inventory;
        # certificate producers cannot select a weaker predicate by relabelling it.
        def replay_event_after_arena_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, exact_owner: bool, event: Event, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                facts.count != 0
                not (frame_policy_replays_after_arena_with_work(nodes, children, root, work) can Global{Read,Write})
                not replay_work_charge(sview_len(event.kind), work)
                not replay_work_charge(sview_len(name), work)
                not replay_work_charge(sview_len(event.place.field), work)
                not replay_work_charge(sview_len(event.place.field2), work)
                not replay_work_charge(sview_len(event.place.field3), work)
            if event.kind in {"changes", "preserves"}:
                return (spec_replays_after_arena_with_work(declarations, name, line, owner_offset, exact_owner, event.kind, event.position, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})
            if event.call_effect:
                if event.kind == "allow":
                    return (call_allowance_replays_after_arena_with_work(declarations, annotations, name, line, owner_offset, exact_owner, event.position, event.change_index, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})
                if event.kind == "preserve":
                    return (call_preserve_clause_replays_after_arena_with_work(declarations, annotations, name, line, owner_offset, exact_owner, event.position, event.change_index, event.clause_index, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})
                return false
            if event.kind == "allow":
                return (direct_operation_replays_after_arena_with_work(declarations, name, line, owner_offset, exact_owner, event.position, tokens, source, source_length, nodes, children, facts, root, "allow", work) can Global{Read,Write})
            if event.kind == "preserve":
                return (direct_preserve_clause_replays_after_arena_with_work(declarations, name, line, owner_offset, exact_owner, event.position, event.clause_index, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})
            return false

        # Standalone calls admit the complete arena themselves. The batch variant
        # below avoids repeating this whole-arena pass after its caller admits it.
        def replay_event_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, event: Event, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if:
                facts.count != 0
                not replay_work_charge(nodes.count, work)
                not replay_work_charge(children.count, work)
                not (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(nodes, children) can Global{Read,Write})
            return (replay_event_after_arena_with_work(declarations, [], name, line, 0, false, event, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})

    public:
        struct EventDecision:
            event: Event
            kernel_root: usize
            proven: bool

        # A complete source inventory can contain failed predicates. Retain one
        # decision per occurrence so report recording cannot silently omit failures
        # or combine independent preservation obligations into one verdict.
        # `known` means the inventory is complete, never that every event proved.
        def direct_event_decisions(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&) -> (known: bool, decisions: darray[EventDecision]) can[Memory.Allocate, Abort.Panic, Global{Read,Write}]:
            work: mutable usize = 0
            return (direct_event_decisions_with_work(declarations, [], name, line, tokens, source, source_length, nodes, children, roots, &work) can Global{Read,Write})

        def direct_event_decisions_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&, work: mutable usize&) -> (known: bool, decisions: darray[EventDecision]) can[Memory.Allocate, Abort.Panic]:
            inventory = (direct_events_with_work(declarations, annotations, name, line, tokens, source, source_length, work) can Global{Read,Write})
            return (false, []) if not inventory.known
            return (direct_event_decisions_from_inventory_at_owner_with_work(declarations, annotations, name, line, 0, false, inventory.events, tokens, source, source_length, nodes, children, roots, work) can[Global{Read,Write}])

        def direct_event_decisions_at_offset_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&, work: mutable usize&) -> (known: bool, decisions: darray[EventDecision]) can[Memory.Allocate, Abort.Panic]:
            inventory = (direct_events_at_offset_with_work(declarations, annotations, name, line, owner_offset, tokens, source, source_length, work) can Global{Read,Write})
            return (false, []) if not inventory.known
            return (direct_event_decisions_from_inventory_at_owner_with_work(declarations, annotations, name, line, owner_offset, true, inventory.events, tokens, source, source_length, nodes, children, roots, work) can[Global{Read,Write}])

        def direct_event_decisions_from_inventory_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, events: darray[Event]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&, work: mutable usize&) -> (known: bool, decisions: darray[EventDecision]) can[Memory.Allocate, Abort.Panic]:
            return (direct_event_decisions_from_inventory_at_owner_with_work(declarations, annotations, name, line, 0, false, events, tokens, source, source_length, nodes, children, roots, work) can[Global{Read,Write}])

        def direct_event_decisions_from_inventory_at_owner_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, exact_owner: bool, events: darray[Event]&, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&, work: mutable usize&) -> (known: bool, decisions: darray[EventDecision]) can[Memory.Allocate, Abort.Panic]:
            return (false, []) if roots.count != events.count
            decisions: mutable darray[EventDecision] = []
            return (true, decisions) if roots.count == 0
            return (false, []) if:
                not replay_work_charge(nodes.count, work)
                not replay_work_charge(children.count, work)
                not (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(nodes, children) can Global{Read,Write})
                not replay_work_charge(roots.count, work)
            for index in 0..<roots.count |index, roots, declarations, annotations, name, line, tokens, source, source_length, nodes, children, events, decisions, work|:
                event = events[index]
                proven: bool = (replay_event_after_arena_with_work(declarations, annotations, name, line, owner_offset, exact_owner, event, tokens, source, source_length, nodes, children, [], roots[index], work) can Global{Read,Write})
                decisions.push(EventDecision{event: event, kernel_root: roots[index], proven: proven})
            return (true, decisions)

        def direct_event_replays_for_event(declarations: darray[Ast::Decl]&, name: sview, line: u32, event: Event, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic, Global{Read,Write}]:
            work: mutable usize = 0
            return (direct_event_replays_for_event_with_work(declarations, name, line, event, tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def direct_event_replays_for_event_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, event: Event, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return (replay_event_with_work(declarations, name, line, event, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})

    private:
        def direct_event_replays_for_event_after_arena_with_work(declarations: darray[Ast::Decl]&, name: sview, line: u32, event: Event, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return (replay_event_after_arena_with_work(declarations, [], name, line, 0, false, event, tokens, source, source_length, nodes, children, facts, root, work) can Global{Read,Write})

    public:
        def direct_event_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, event_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            work: mutable usize = 0
            inventory = (direct_events_with_work(declarations, [], name, line, tokens, source, source_length, &work) can Global{Read,Write})
            return false if not inventory.known or event_index >= inventory.events.count
            return (direct_event_replays_for_event_with_work(declarations, name, line, inventory.events[event_index], tokens, source, source_length, nodes, children, facts, root, &work) can Global{Read,Write})

        def direct_event_roots_replay(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic, Global{Read,Write}]:
            work: mutable usize = 0
            return (direct_event_roots_replay_with_work(declarations, [], name, line, tokens, source, source_length, nodes, children, roots, &work) can Global{Read,Write})

        def direct_event_roots_replay_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            inventory = (direct_events_with_work(declarations, annotations, name, line, tokens, source, source_length, work) can Global{Read,Write})
            return false if not inventory.known or roots.count != inventory.events.count
            return true if roots.count == 0
            return false if:
                not replay_work_charge(nodes.count, work)
                not replay_work_charge(children.count, work)
                not (ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(nodes, children) can Global{Read,Write})
                not replay_work_charge(roots.count, work)
            for index in 0..<roots.count |index, roots, declarations, annotations, name, line, tokens, source, source_length, nodes, children, inventory, work|:
                return false if not (replay_event_after_arena_with_work(declarations, annotations, name, line, 0, false, inventory.events[index], tokens, source, source_length, nodes, children, [], roots[index], work) can Global{Read,Write})
            return true

        def direct_event_roots_replay_at_offset_with_work(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, name: sview, line: u32, owner_offset: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            outcomes = (direct_event_decisions_at_offset_with_work(declarations, annotations, name, line, owner_offset, tokens, source, source_length, nodes, children, roots, work) can[Global{Read,Write}])
            return false if not outcomes.known
            for decision in outcomes.decisions |outcomes|:
                return false if not decision.proven
            return true
