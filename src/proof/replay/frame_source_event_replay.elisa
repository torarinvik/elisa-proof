extend ElisaProofFrameSource:
    public:
        const FRAME_SOURCE_REPLAY_WORK_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET * 8

        # One counter covers report rows and nested source reconstructions for a
        # frame replay batch. A refused debit must stop the path before its scan.
        def replay_work_charge(amount: usize, work: mutable usize&) -> bool:
            return false if work > FRAME_SOURCE_REPLAY_WORK_LIMIT
            return false if amount > FRAME_SOURCE_REPLAY_WORK_LIMIT - work
            work <- work + amount
            return true

    private:
        # Derive predicate kind and source occurrence from the original inventory;
        # certificate producers cannot select a weaker predicate by relabelling it.
        def replay_event(declarations: darray[Ast::Decl]&, name: sview, line: u32, event: Event, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            if event.kind == "changes" or event.kind == "preserves":
                return (spec_replays(declarations, name, line, event.kind, event.position, tokens, source, source_length, nodes, children, facts, root) can Global{Read,Write})
            if event.call_effect:
                if event.kind == "allow":
                    return (call_allowance_replays(declarations, name, line, event.position, event.change_index, tokens, source, source_length, nodes, children, facts, root) can Global{Read,Write})
                if event.kind == "preserve":
                    return (call_preserve_clause_replays(declarations, name, line, event.position, event.change_index, event.clause_index, tokens, source, source_length, nodes, children, facts, root) can Global{Read,Write})
                return false
            if event.kind == "allow":
                return (direct_allowance_replays(declarations, name, line, event.position, tokens, source, source_length, nodes, children, facts, root) can Global{Read,Write})
            if event.kind == "preserve":
                return (direct_preserve_clause_replays(declarations, name, line, event.position, event.clause_index, tokens, source, source_length, nodes, children, facts, root) can Global{Read,Write})
            return false

    public:
        struct EventDecision:
            event: Event
            kernel_root: usize
            proven: bool

        # A complete source inventory can contain failed predicates. Retain one
        # decision per occurrence so report recording cannot silently omit failures
        # or combine independent preservation obligations into one verdict.
        # `known` means the inventory is complete, never that every event proved.
        def direct_event_decisions(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&) -> (known: bool, decisions: darray[EventDecision]) can[Memory.Allocate, Abort.Panic]:
            inventory = (direct_events(declarations, name, line, tokens, source, source_length) can Global{Read,Write})
            return (false, []) if not inventory.known or roots.count != inventory.events.count
            decisions: mutable darray[EventDecision] = []
            for index in 0..<roots.count |index, roots, declarations, name, line, tokens, source, source_length, nodes, children, inventory, decisions|:
                event = inventory.events[index]
                proven: bool = (replay_event(declarations, name, line, event, tokens, source, source_length, nodes, children, [], roots[index]) can Global{Read,Write})
                decisions.push(EventDecision{event: event, kernel_root: roots[index], proven: proven})
            return (true, decisions)

        def direct_event_replays_for_event(declarations: darray[Ast::Decl]&, name: sview, line: u32, event: Event, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            return (replay_event(declarations, name, line, event, tokens, source, source_length, nodes, children, facts, root) can Global{Read,Write})

        def direct_event_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, event_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            inventory = (direct_events(declarations, name, line, tokens, source, source_length) can Global{Read,Write})
            return false if not inventory.known or event_index >= inventory.events.count
            return (direct_event_replays_for_event(declarations, name, line, inventory.events[event_index], tokens, source, source_length, nodes, children, facts, root) can Global{Read,Write})

        def direct_event_roots_replay(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic]:
            inventory = (direct_events(declarations, name, line, tokens, source, source_length) can Global{Read,Write})
            return false if not inventory.known or roots.count != inventory.events.count
            for index in 0..<roots.count |index, roots, declarations, name, line, tokens, source, source_length, nodes, children, inventory|:
                return false if not (replay_event(declarations, name, line, inventory.events[index], tokens, source, source_length, nodes, children, [], roots[index]) can Global{Read,Write})
            return true
