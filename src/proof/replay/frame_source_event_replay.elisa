extend ElisaProofFrameSource:
    private:
        # Derive predicate kind and source occurrence from the original inventory;
        # certificate producers cannot select a weaker predicate by relabelling it.
        def replay_event(declarations: darray[Ast::Decl]&, name: sview, line: u32, event: Event, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            if event.kind == "changes" or event.kind == "preserves":
                return spec_replays(declarations, name, line, event.kind, event.position, tokens, source, source_length, nodes, children, facts, root)
            if event.kind == "allow":
                return direct_allowance_replays(declarations, name, line, event.position, tokens, source, source_length, nodes, children, facts, root)
            if event.kind == "preserve":
                return direct_preserve_clause_replays(declarations, name, line, event.position, event.clause_index, tokens, source, source_length, nodes, children, facts, root)
            return false

    public:
        def direct_event_replays(declarations: darray[Ast::Decl]&, name: sview, line: u32, event_index: usize, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if facts.count != 0
            inventory = direct_events(declarations, name, line, tokens, source, source_length)
            return false if not inventory.known or event_index >= inventory.events.count
            return replay_event(declarations, name, line, inventory.events[event_index], tokens, source, source_length, nodes, children, facts, root)

        def direct_event_roots_replay(declarations: darray[Ast::Decl]&, name: sview, line: u32, tokens: darray[Lexer::Token]&, source: u8&, source_length: usize, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: darray[usize]&) -> bool can[Memory.Allocate, Abort.Panic]:
            inventory = direct_events(declarations, name, line, tokens, source, source_length)
            return false if not inventory.known or roots.count != inventory.events.count
            for index in 0..<roots.count |index, roots, declarations, name, line, tokens, source, source_length, nodes, children, inventory|:
                return false if not replay_event(declarations, name, line, inventory.events[index], tokens, source, source_length, nodes, children, [], roots[index])
            return true
