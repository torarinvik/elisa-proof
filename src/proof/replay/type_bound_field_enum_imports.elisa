# Replay enum lookup across Stage1's file-wide imported module rows.
extend ElisaProof:
    private:
        # Stage1's enum-kind resolver checks every file-wide imported-module row
        # before root/global declarations. Preserve duplicate using rows because the
        # semantic import table preserves them too.
        def proof_replay_type_bound_enum_imported_census_with_work(report: ProofReport&, name: sview, work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> (complete: bool, count: usize, owner: sview):
            total: mutable usize = 0
            found_owner: mutable sview = ""
            for annotation in report.source.source_annotations |annotation, name, work, cache, total, found_owner|:
                return (false, 0, "") if:
                    not proof_replay_type_bound_local_work_charge(1, work)
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.owner), work)
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                continue if annotation.name != "__using" and annotation.name != "__using_alias_target"
                return (false, 0, "") if annotation.owner == ""
                empty_scope: darray[sview] = []
                imported_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work(empty_scope, annotation.owner, work)
                return (false, 0, "") if not imported_scope.complete
                candidate: (complete: bool, exact_count: usize, root_count: usize, all_count: usize, all_owner: sview) = proof_replay_type_bound_enum_named_enum_census_with_work(report, name, imported_scope.scope, work, cache)
                return (false, 0, "") if not candidate.complete
                if candidate.exact_count > 0:
                    found_owner <- annotation.owner if total == 0
                    total <- total + candidate.exact_count
            return (true, total, found_owner)

        def proof_replay_type_bound_enum_imported_alias_with_work(report: ProofReport&, name: sview, work: mutable usize&) -> (complete: bool, count: usize, target: Ast::Expr, line: u32, offset: usize, owner: sview):
            total: mutable usize = 0
            selected_target: mutable Ast::Expr = Ast::Expr.Absent
            selected_line: mutable u32 = 0
            selected_offset: mutable usize = 0
            selected_owner: mutable sview = ""
            for annotation in report.source.source_annotations |annotation, name, work, total, selected_target, selected_line, selected_offset, selected_owner|:
                return (false, 0, Ast::Expr.Invalid, 0, 0, "") if:
                    not proof_replay_type_bound_local_work_charge(1, work)
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.owner), work)
                    not proof_replay_type_bound_local_work_charge(sview_len(annotation.name), work)
                continue if annotation.name != "__using" and annotation.name != "__using_alias_target"
                return (false, 0, Ast::Expr.Invalid, 0, 0, "") if annotation.owner == ""
                imported_scope: (complete: bool, scope: darray[sview]) = proof_replay_type_bound_scope_with_module_with_work([], annotation.owner, work)
                return (false, 0, Ast::Expr.Invalid, 0, 0, "") if not imported_scope.complete
                aliases: mutable usize = 0
                nominals: mutable usize = 0
                alias_target: mutable Ast::Expr = Ast::Expr.Absent
                alias_line: mutable u32 = 0
                alias_offset: mutable usize = 0
                alias_owner: mutable sview = ""
                return (false, 0, Ast::Expr.Invalid, 0, 0, "") if not proof_replay_type_bound_enum_named_type_at_owner_with_work(report, report.source.source_declarations, "", imported_scope.scope, name, &aliases, &nominals, &alias_target, &alias_line, &alias_offset, &alias_owner, 0, work)
                return (false, 0, Ast::Expr.Invalid, 0, 0, "") if aliases > 1
                if aliases == 1:
                    selected_target <- alias_target if total == 0
                    selected_line <- alias_line if total == 0
                    selected_offset <- alias_offset if total == 0
                    selected_owner <- alias_owner if total == 0
                    total <- total + 1
            return (true, total, selected_target, selected_line, selected_offset, selected_owner)
