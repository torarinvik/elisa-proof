extend ElisaProof:
    private:
        # Match a module expression against a suffix of its declared qualified owner without
        # flattening or allocating. Returning the start offset lets callers distinguish an exact
        # path from a single-segment path resolved relative to an enclosing module.
        def proof_replay_module_path_start(owner: sview, expression: Ast::Expr, end: usize, depth: usize) -> (valid: bool, start: usize):
            return (false, 0) if depth >= PROOF_REPLAY_TRACE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    name_length: usize = sview_len(name)
                    return (false, 0) if name_length == 0 or name_length > end
                    start: usize = end - name_length
                    for offset in 0..<name_length |owner, name, start|:
                        return (false, 0) if owner[start + offset] != name[offset]
                    return (true, start)
                Ast::Expr.Scope(base, member, _):
                    member_length: usize = sview_len(member)
                    return (false, 0) if member_length == 0 or member_length + 2 > end
                    start: usize = end - member_length
                    for offset in 0..<member_length |owner, member, start|:
                        return (false, 0) if owner[start + offset] != member[offset]
                    return (false, 0) if owner[start - 1] != 58 or owner[start - 2] != 58
                    return proof_replay_module_path_start(owner, base, start - 2, depth + 1)
                _:
                    return (false, 0)

        # Fully qualified source spellings must match the complete declared module name.
        def proof_replay_exact_module_path_matches_owner(owner: sview, expression: Ast::Expr) -> bool:
            path: (valid: bool, start: usize) = proof_replay_module_path_start(owner, expression, sview_len(owner), 0)
            return path.valid and path.start == 0

        # A one-segment qualifier may name a nested module relative to the caller's module or
        # one of its ancestors. Requiring that lexical prefix prevents a same-leaf module under
        # an unrelated parent from being mistaken for the target summary's owner.
        def proof_replay_relative_module_path_matches_owner(owner: sview, module_name: sview, caller_owner: sview) -> bool:
            return true if owner == module_name
            return false if not proof_replay_module_leaf_matches(owner, module_name)
            owner_prefix_length: usize = sview_len(owner) - sview_len(module_name) - 2
            caller_length: usize = sview_len(caller_owner)
            return false if owner_prefix_length == 0 or caller_length < owner_prefix_length
            for index in 0..<owner_prefix_length |owner, caller_owner|:
                return false if owner[index] != caller_owner[index]
            return true if caller_length == owner_prefix_length
            return false if caller_length < owner_prefix_length + 2
            return caller_owner[owner_prefix_length] == 58 and caller_owner[owner_prefix_length + 1] == 58

        def proof_replay_owner_work_charge(amount: usize, source_work: mutable usize&) -> bool:
            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + amount
            return true

        # Resolve a declaration owner from the report-scoped source index. Unlike the call-site
        # selector, this includes lemma functions because owner identity is independent of which
        # call-resolution policy selected the declaration.
        def proof_replay_summary_owner_function_at_line(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, line: u32, source_work: mutable usize&) -> (complete: bool, matches: usize, row: usize):
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(index, wanted, source_work)
            return (false, 0, index.entries.count) if not group.complete
            row: mutable usize = group.head
            selected: mutable usize = index.entries.count
            matches: mutable usize = 0
            for _ in 0..<group.count |group, index, row, line, selected, matches, source_work|:
                return (false, 0, index.entries.count) if row >= index.entries.count
                entry: ProofReplayDeterministicDeclarationEntry = index.entries[row]
                return (false, 0, index.entries.count) if:
                    not proof_replay_owner_work_charge(1, source_work)
                    not proof_replay_owner_work_charge(sview_len(entry.name), source_work)
                    entry.name != wanted
                if entry.is_function:
                    match entry.declaration:
                        Ast::Decl.Func(_, _, _, _, _, _, position):
                            if position.line == line:
                                matches <- matches + 1
                                selected <- row
                        _:
                            return (false, 0, index.entries.count)
                row <- entry.next_index
                return (false, 0, index.entries.count) if row > index.entries.count
            return (false, 0, index.entries.count) if row != index.entries.count
            return (true, matches, selected)

        def proof_replay_summary_owner_function_at_offset(index: ProofReplayDeterministicDeclarationIndex&, wanted: sview, line: u32, offset: usize, source_work: mutable usize&) -> (complete: bool, matches: usize, row: usize):
            group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(index, wanted, source_work)
            return (false, 0, index.entries.count) if not group.complete
            row: mutable usize = group.head
            selected: mutable usize = index.entries.count
            matches: mutable usize = 0
            for _ in 0..<group.count |group, index, row, line, offset, selected, matches, source_work|:
                return (false, 0, index.entries.count) if row >= index.entries.count
                entry: ProofReplayDeterministicDeclarationEntry = index.entries[row]
                return (false, 0, index.entries.count) if not proof_replay_owner_work_charge(1, source_work) or not proof_replay_owner_work_charge(sview_len(entry.name), source_work) or entry.name != wanted
                if entry.is_function:
                    match entry.declaration:
                        Ast::Decl.Func(_, _, _, _, _, _, position):
                            if position.line == line and position.offset.usize() == offset:
                                matches <- matches + 1
                                selected <- row
                        _:
                            return (false, 0, index.entries.count)
                row <- entry.next_index
                return (false, 0, index.entries.count) if row > index.entries.count
            return (false, 0, index.entries.count) if row != index.entries.count
            return (true, matches, selected)

        # The recorded result must resolve to the module that declares the chosen summary. Use
        # the same source-derived alias index and exact path resolver as the checker. This keeps
        # replay independent of the producer's chosen owner string while preserving lexical alias
        # visibility, ambiguous aliases, relative nested paths, and a shared source-work cap.
        def proof_replay_summary_owner_matches_call_bounded_with_cache(report: ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, source_call: Ast::Expr, source_work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if:
                not proof_replay_owner_work_charge(sview_len(summary.name), source_work) or not proof_replay_owner_work_charge(sview_len(trace.dependency), source_work)
                summary.name != trace.dependency
                trace.owner_line == 0 or summary.line != trace.owner_line
            match source_call:
                Ast::Expr.Call(callee, _, _, call_position):
                    match callee:
                        Ast::Expr.Scope(base, member, _):
                            return false if:
                                not proof_replay_owner_work_charge(sview_len(member), source_work)
                                member != trace.dependency
                                not proof_replay_summary_expr_charge_with_work(base, source_work)
                                report.analysis_2.replay_owner_line == 0
                                not proof_replay_deterministic_call_declaration_index_ensure(report, source_work, cache)
                            caller: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.declaration_index, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, source_work) if report.analysis_2.replay_owner_offset_valid else proof_replay_summary_owner_function_at_line(cache.declaration_index, trace.name, report.analysis_2.replay_owner_line, source_work)
                            return false if not caller.complete or caller.matches != 1 or caller.row >= cache.declaration_index.entries.count
                            caller_owner: sview = cache.declaration_index.entries[caller.row].owner
                            return false if:
                                not proof_replay_deterministic_call_alias_imports_ensure(report, source_work, cache)
                                not proof_replay_deterministic_call_alias_index_ensure(report, source_work, cache)
                                not proof_replay_summary_expr_charge_with_work(callee, source_work)
                            target_group: (complete: bool, count: usize, head: usize) = proof_replay_deterministic_declaration_group(cache.declaration_index, trace.dependency, source_work)
                            return false if not target_group.complete
                            target_row: mutable usize = target_group.head
                            target_matches: mutable usize = 0
                            for _ in 0..<target_group.count |target_group, target_row, target_matches, cache, trace, callee, caller_owner, source_work|:
                                return false if target_row >= cache.declaration_index.entries.count
                                entry: ProofReplayDeterministicDeclarationEntry = cache.declaration_index.entries[target_row]
                                return false if:
                                    not proof_replay_owner_work_charge(1, source_work)
                                    not proof_replay_owner_work_charge(sview_len(entry.name), source_work)
                                    entry.name != trace.dependency
                                if entry.is_function and not entry.is_lemma:
                                    match entry.declaration:
                                        Ast::Decl.Func(_, _, _, _, _, _, position):
                                            if position.line == trace.owner_line and entry.owner != "":
                                                return false if not proof_replay_owner_work_charge(2, source_work)
                                                callee_names: darray[sview] = [trace.dependency]
                                                callee_owners: darray[sview] = [entry.owner]
                                                resolved: (complete: bool, row: usize) = proof_module_function_index_for_callee(callee_names, callee_owners, cache.alias_index, caller_owner, callee, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                                return false if not resolved.complete
                                                if resolved.row == 0:
                                                    target_matches <- target_matches + 1
                                        _:
                                            return false
                                target_row <- entry.next_index
                                return false if target_row > cache.declaration_index.entries.count
                            return false if target_row != cache.declaration_index.entries.count or target_matches != 1
                            return true
                        Ast::Expr.Ident(callee_name, _):
                            return false if:
                                not proof_replay_owner_work_charge(sview_len(callee_name), source_work)
                                callee_name != trace.dependency
                                report.analysis_2.replay_owner_line == 0 or report.analysis_2.replay_owner_line == 4294967295 or call_position.line == 0
                                proof_replay_local_binding_parameter_name_present_for_report_owner_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report, callee_name, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
                            caller_body: mutable darray[Ast::Stmt] = []
                            return false if:
                                not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &caller_body, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                                not proof_replay_source_call_locals_unshadowed_at_with_work(caller_body, report.source.source_annotations, source_call, source_work)
                                not proof_replay_deterministic_call_declaration_index_ensure(report, source_work, cache)
                                not proof_replay_deterministic_call_alias_imports_ensure(report, source_work, cache)
                            caller: (complete: bool, matches: usize, row: usize) = proof_replay_deterministic_candidate_at_callsite(cache.declaration_index, trace.name, report.analysis_2.replay_owner_line, source_work)
                            return false if not caller.complete or caller.matches != 1
                            selected: (complete: bool, matches: usize, row: usize, declaration: Ast::Decl, owner: sview) = proof_replay_deterministic_bare_declaration(cache.declaration_index, trace.dependency, caller.row, source_work)
                            return false if not selected.complete or selected.matches != 1
                            target: (complete: bool, matches: usize, row: usize) = proof_replay_deterministic_candidate_at_callsite(cache.declaration_index, trace.dependency, trace.owner_line, source_work)
                            return target.complete and target.matches == 1 and target.row == selected.row
                        _:
                            return false
                _:
                    return false

        def proof_replay_summary_owner_matches_call_bounded(report: ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, source_call: Ast::Expr, source_work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_summary_owner_matches_call_bounded_with_cache(report, trace, summary, source_call, source_work, &cache)

        def proof_replay_summary_owner_matches_call(report: ProofReport&, trace: ProofFactTrace, summary: ProofExecutableSummary, source_call: Ast::Expr) -> bool:
            source_work: mutable usize = 0
            return proof_replay_summary_owner_matches_call_bounded(report, trace, summary, source_call, source_work)

