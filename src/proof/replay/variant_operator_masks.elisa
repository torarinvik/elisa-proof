extend ElisaProof:
    private:
        const PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY: usize = 0
        const PROOF_REPLAY_VARIANT_OPERATOR_EQUALITY_FLAG: usize = 1
        const PROOF_REPLAY_VARIANT_OPERATOR_ORDERING_FLAG: usize = 2
        const PROOF_REPLAY_VARIANT_OPERATOR_ADDITION_FLAG: usize = 4
        const PROOF_REPLAY_VARIANT_OPERATOR_SUBTRACTION_FLAG: usize = 8
        const PROOF_REPLAY_VARIANT_OPERATOR_MULTIPLICATION_FLAG: usize = 16
        const PROOF_REPLAY_VARIANT_OPERATOR_DIVISION_FLAG: usize = 32
        const PROOF_REPLAY_VARIANT_OPERATOR_NEGATION_FLAG: usize = 64
        const PROOF_REPLAY_VARIANT_OPERATOR_ALL_FLAGS: usize = 127

        # Independent replay mapping from compiler-dispatched dunder names to affected
        # operations. Keep this separate from source-admission masks so producer bugs cannot
        # make replay certify an overloaded comparison as builtin.
        def proof_replay_variant_operator_dunder_mask(name: sview) -> usize:
            if name == "__eq__": return PROOF_REPLAY_VARIANT_OPERATOR_EQUALITY_FLAG
            if name == "__cmp__": return PROOF_REPLAY_VARIANT_OPERATOR_ORDERING_FLAG
            if name == "__add__": return PROOF_REPLAY_VARIANT_OPERATOR_ADDITION_FLAG
            if name == "__sub__": return PROOF_REPLAY_VARIANT_OPERATOR_SUBTRACTION_FLAG
            if name == "__mul__": return PROOF_REPLAY_VARIANT_OPERATOR_MULTIPLICATION_FLAG
            if name == "__div__": return PROOF_REPLAY_VARIANT_OPERATOR_DIVISION_FLAG
            if name == "__neg__": return PROOF_REPLAY_VARIANT_OPERATOR_NEGATION_FLAG
            PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY

        def proof_replay_variant_operator_mask_for_protocol(protocol: sview) -> usize:
            return when protocol:
                "Eq" -> PROOF_REPLAY_VARIANT_OPERATOR_EQUALITY_FLAG
                "Ord" | "Less" -> PROOF_REPLAY_VARIANT_OPERATOR_ORDERING_FLAG
                "Add" -> PROOF_REPLAY_VARIANT_OPERATOR_ADDITION_FLAG
                "Sub" -> PROOF_REPLAY_VARIANT_OPERATOR_SUBTRACTION_FLAG
                "Mul" -> PROOF_REPLAY_VARIANT_OPERATOR_MULTIPLICATION_FLAG
                "Div" -> PROOF_REPLAY_VARIANT_OPERATOR_DIVISION_FLAG
                "Neg" -> PROOF_REPLAY_VARIANT_OPERATOR_NEGATION_FLAG
                # A caller must never interpret an unrecognized protocol as proof that no
                # overloaded operation can apply. Checking all currently modeled operator
                # families is conservative until replay learns that protocol's dispatch rule.
                _ -> PROOF_REPLAY_VARIANT_OPERATOR_ALL_FLAGS
