# Independent replay check for a "variant-exclusion" fact: `not (x is E.A) or not (x is E.B)` holds
# only when `E` is a single enum declaration in the source with two distinct variants `A` and `B`.
extend ElisaProof:
    private:
        const PROOF_REPLAY_VARIANT_DEPTH_LIMIT: usize = 32
        const PROOF_REPLAY_ENUM_HIERARCHY_PARENT_TAG: u32 = 3900000008
        def proof_replay_variant_source_tree_charge(declarations: darray[Ast::Decl]&, work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                return false
            work <- work + declarations.count
            for declaration in declarations |work, depth|:
                match declaration:
                    Ast::Decl.Module(module_name, nested, _):
                        return false if sview_len(module_name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(module_name)
                        return false if not proof_replay_variant_source_tree_charge(nested, work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_variant_source_tree_charge(nested, work, depth + 1)
                    Ast::Decl.Enum(name, variants, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if variants.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + variants.count
                        for variant in variants |work|:
                            return false if sview_len(variant.name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                            work <- work + sview_len(variant.name)
                    Ast::Decl.Import(_, _):
                        # The imported target is absent from this source snapshot, so it can
                        # introduce a same-spelled enum that this local declaration scan cannot
                        # distinguish.
                        return false
                    Ast::Decl.Struct(name, _, _, _, _, _, _) | Ast::Decl.Func(name, _, _, _, _, _, _) | Ast::Decl.Const(name, _, _, _, _) | Ast::Decl.Law(name, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                    Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                    Ast::Decl.Alias(name, target, _):
                        return false if sview_len(name) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
                        work <- work + sview_len(name)
                        return false if not proof_replay_summary_expr_charge_with_work(target, work)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_variant_case_count_with_work(expression: Ast::Expr, depth: usize, source_work: mutable usize&) -> usize:
            return PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT + 1 if:
                depth >= PROOF_REPLAY_VARIANT_DEPTH_LIMIT
                not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match expression:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    left_count: usize = proof_replay_variant_case_count_with_work(left, depth + 1, source_work)
                    return PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT + 1 if left_count > PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT
                    right_count: usize = proof_replay_variant_case_count_with_work(right, depth + 1, source_work)
                    return PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT + 1 if:
                        right_count > PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT
                        left_count > PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT - right_count
                    return left_count + right_count
                Ast::Expr.Binary(_, TokenKind.Is, _, _):
                    return 1
                _:
                    return 0

        def proof_replay_variant_expr_equal_with_work(left: Ast::Expr, right: Ast::Expr, source_work: mutable usize&) -> bool:
            return false if:
                not proof_replay_summary_expr_repeat_charge_with_limit(left, 3, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                not proof_replay_summary_expr_repeat_charge_with_limit(right, 3, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
            return proof_expr_equal(left, right)

        def proof_replay_variant_text_compare_charge_with_work(left: sview, right: sview, source_work: mutable usize&) -> bool:
            if not proof_replay_attempt_text_compare_with_limit(left, right, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            return true

        def proof_replay_const_enum_hierarchy_with_work(report: ProofReport&, enum_name: sview, source_work: mutable usize&) -> (complete: bool, in_hierarchy: bool):
            for annotation in report.source.source_annotations |enum_name, source_work|:
                return (false, false) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                if annotation.line == PROOF_REPLAY_ENUM_HIERARCHY_PARENT_TAG:
                    owner_complete: bool = proof_replay_variant_text_compare_charge_with_work(annotation.owner, enum_name, source_work)
                    return (false, false) if not owner_complete
                    name_complete: bool = proof_replay_variant_text_compare_charge_with_work(annotation.name, enum_name, source_work)
                    return (false, false) if not name_complete
                    owner_matches: bool = annotation.owner == enum_name
                    name_matches: bool = annotation.name == enum_name
                    return (true, true) if owner_matches or name_matches
                common_field_complete: bool = proof_replay_variant_text_compare_charge_with_work(annotation.name, "__has_common", source_work)
                return (false, false) if not common_field_complete
                if annotation.name == "__has_common":
                    owner_complete: bool = proof_replay_variant_text_compare_charge_with_work(annotation.owner, enum_name, source_work)
                    return (false, false) if not owner_complete
                    return (true, true) if annotation.owner == enum_name
            return (true, false)

        def proof_replay_variant_scoped_operator_exists_with_index(report: ProofReport&, index: ProofReplayVariantScopePositionIndex&, concrete: sview, wanted_mask: usize, source_work: mutable usize&) -> (complete: bool, exists: bool):
            # Replay derives direct `Self` and same-receiver dunders from its AST-built index.
            # The free mask above already accounts for global and mismatched receiver masks.
            count: usize = index.rows.count
            return (false, false) if not index.valid or count != index.hashes.count or count != index.next_indices.count
            chain_count: usize = index.concrete_row_indices.count
            return (false, false) if chain_count != index.concrete_hashes.count or chain_count != index.concrete_next_indices.count
            return (true, false) if index.concrete_bucket_heads.count == 0 and chain_count == 0
            capacity: usize = index.concrete_bucket_heads.count
            return (false, false) if capacity == 0 or chain_count == 0
            return (false, false) if not proof_replay_source_work_charge_or_exhaust(sview_len(concrete), source_work)
            hash: u32 = proof_name_hash(concrete)
            entry: usize = index.concrete_bucket_heads[(hash.i64() % capacity.i64()).usize()]
            return (false, false) if entry > chain_count
            visits: mutable usize = 0
            while entry < chain_count and visits < PROOF_REPLAY_VARIANT_SCOPE_MAX_BUCKET |entry, index, count, chain_count, hash, concrete, wanted_mask, source_work, visits|:
                return (false, false) if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                row_index: usize = index.concrete_row_indices[entry]
                return (false, false) if row_index >= count
                path_scope: ProofReplayVariantScopePosition = index.rows[row_index]
                if index.concrete_hashes[entry] == hash and path_scope.annotation_marker_count == 1:
                    return (false, false) if not proof_replay_variant_text_compare_charge_with_work(path_scope.annotation_concrete, concrete, source_work)
                    if path_scope.annotation_concrete == concrete:
                        return (false, false) if not proof_replay_variant_text_compare_charge_with_work(path_scope.annotation_owner, "__ext_concrete", source_work)
                        if path_scope.annotation_owner != "__ext_concrete":
                            return (false, false) if not proof_replay_variant_text_compare_charge_with_work(path_scope.annotation_owner, "__impl_scope", source_work)
                            return (false, false) if path_scope.annotation_owner != "__impl_scope"
                        receiver_mask: usize = path_scope.self_operator_mask
                        receiver_mask <- receiver_mask | path_scope.explicit_receiver_mask if path_scope.explicit_receiver_type == concrete
                        return (true, true) if (receiver_mask & wanted_mask) != 0
                next_entry: usize = index.concrete_next_indices[entry]
                return (false, false) if next_entry != chain_count and next_entry >= entry
                entry <- next_entry
                visits <- visits + 1
            return (false, false) if entry < chain_count or visits > chain_count
            return (true, false)

        def proof_replay_variant_operator_protocol_mask_with_work(protocols: darray[sview], source_work: mutable usize&) -> (complete: bool, mask: usize):
            mask: mutable usize = PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY
            for protocol in protocols |protocol, source_work, mask|:
                return (false, mask) if not proof_replay_source_work_charge_or_exhaust(1 + sview_len(protocol), source_work)
                mask <- mask | proof_replay_variant_operator_mask_for_protocol(protocol)
            (true, mask)

        def proof_replay_variant_type_alias_with_work(declarations: darray[Ast::Decl]&, name: sview, target: mutable Ast::Expr&, matches: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT:
                matches <- 2
                return true
            for declaration in declarations |name, target, matches, source_work, depth|:
                if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    return false
                source_work <- source_work + 1
                match declaration:
                    Ast::Decl.Alias(alias_name, alias_target, _):
                        return false if not proof_replay_variant_text_compare_charge_with_work(alias_name, name, source_work)
                        if alias_name == name:
                            matches <- matches + 1
                            return true if matches > 1
                            target <- alias_target
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_variant_type_alias_with_work(nested, name, target, matches, source_work, depth + 1)
                        return true if matches > 1
                    Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_variant_type_head_name_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, source_work: mutable usize&, depth: usize) -> sview:
            return "" if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work <- source_work + 1
            match expression:
                Ast::Expr.Ident(name, _):
                    return "" if proof_scalar_primitive_type_name(name)
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_count: mutable usize = 0
                    return "" if:
                        not proof_replay_variant_type_alias_with_work(declarations, name, &alias_target, &alias_count, source_work, 0)
                        alias_count > 1
                    if alias_count == 1:
                        aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_replay_count_named_aggregates_with_work(declarations, name, 0, source_work)
                        return "" if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or aggregates.enums != 0 or aggregates.const_enums != 0 or aggregates.structs != 0
                        return proof_replay_variant_type_head_name_with_work(alias_target, declarations, source_work, depth + 1)
                    return name
                Ast::Expr.Scope(_, name, _):
                    return "" if proof_scalar_primitive_type_name(name)
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_count: mutable usize = 0
                    return "" if not proof_replay_variant_type_alias_with_work(declarations, name, &alias_target, &alias_count, source_work, 0)
                    # The producer refuses to resolve a scoped type through a bare-name
                    # alias lookup. Keep replay equally conservative instead of binding a
                    # qualified type to an unrelated same-named alias elsewhere.
                    return "" if alias_count != 0
                    return name
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_variant_type_head_name_with_work(inner, declarations, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_variant_type_head_name_with_work(inner, declarations, source_work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                _:
                    return ""

        # Preserve every alias spelling when checking whether equality is overloaded. The
        # resolved head alone is insufficient: Elisa permits `impl Eq for AliasOfEnum`.
        def proof_replay_variant_type_operator_names_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, names: mutable darray[sview]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work <- source_work + 1
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if not proof_replay_variant_text_compare_charge_with_work(name, name, source_work)
                    return false if not proof_replay_source_work_charge_or_exhaust(2, source_work)
                    names.push(name)
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_count: mutable usize = 0
                    return false if:
                        not proof_replay_variant_type_alias_with_work(declarations, name, &alias_target, &alias_count, source_work, 0)
                        alias_count > 1
                    return proof_replay_variant_type_operator_names_with_work(alias_target, declarations, names, source_work, depth + 1) if alias_count == 1
                Ast::Expr.Scope(_, name, _):
                    return false if not proof_replay_variant_text_compare_charge_with_work(name, name, source_work)
                    return false if not proof_replay_source_work_charge_or_exhaust(2, source_work)
                    names.push(name)
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_count: mutable usize = 0
                    return false if:
                        not proof_replay_variant_type_alias_with_work(declarations, name, &alias_target, &alias_count, source_work, 0)
                        alias_count > 1
                    return proof_replay_variant_type_operator_names_with_work(alias_target, declarations, names, source_work, depth + 1) if alias_count == 1
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_variant_type_operator_names_with_work(inner, declarations, names, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_variant_type_operator_names_with_work(inner, declarations, names, source_work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    pass
            return true

        def proof_replay_variant_type_operator_impl_exists_with_work(expression: Ast::Expr, protocol: sview, report: ProofReport&, source_work: mutable usize&) -> (complete: bool, exists: bool):
            names: mutable darray[sview] = []
            return (false, false) if not proof_replay_variant_type_operator_names_with_work(expression, report.source.source_declarations, &names, source_work, 0)
            return (false, false) if names.count == 0
            wanted_mask: usize = proof_replay_variant_operator_mask_for_protocol(protocol)
            return (true, false) if wanted_mask == PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY
            scope_index_status: (complete: bool, index: ProofReplayVariantScopePositionIndex) = proof_replay_variant_scope_positions_build(report, source_work)
            return (false, false) if not scope_index_status.complete
            free_mask: (complete: bool, mask: usize) = proof_replay_variant_free_operator_mask_with_work(report, scope_index_status.index, report.source.source_declarations, source_work, 0)
            return (false, false) if not free_mask.complete
            return (true, true) if (free_mask.mask & wanted_mask) != 0
            for name in names |report, protocol, source_work|:
                implementation: (complete: bool, exists: bool) = proof_replay_variant_scoped_operator_exists_with_index(report, scope_index_status.index, name, wanted_mask, source_work)
                return (false, false) if not implementation.complete
                return (true, true) if implementation.exists
            return (true, false)

        def proof_replay_variant_operator_scope_snapshot_with_work(report: ProofReport&, source_work: mutable usize&) -> (complete: bool, index: ProofReplayVariantScopePositionIndex, free_mask: usize):
            scope_index_status: (complete: bool, index: ProofReplayVariantScopePositionIndex) = proof_replay_variant_scope_positions_build(report, source_work)
            return (false, scope_index_status.index, PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY) if not scope_index_status.complete
            free_mask: (complete: bool, mask: usize) = proof_replay_variant_free_operator_mask_with_work(report, scope_index_status.index, report.source.source_declarations, source_work, 0)
            return (false, scope_index_status.index, PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY) if not free_mask.complete
            (true, scope_index_status.index, free_mask.mask)

        # Batch the common source-operator admission check: a typed scalar witness asks
        # about several protocols on the same expression. Union their masks and query each
        # candidate type once against the bounded source index.
        def proof_replay_variant_type_operator_protocols_absent_with_work(expression: Ast::Expr, protocols: darray[sview], report: ProofReport&, source_work: mutable usize&) -> (complete: bool, absent: bool):
            wanted: (complete: bool, mask: usize) = proof_replay_variant_operator_protocol_mask_with_work(protocols, source_work)
            return (false, false) if not wanted.complete
            return (true, true) if wanted.mask == PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY
            names: mutable darray[sview] = []
            return (false, false) if not proof_replay_variant_type_operator_names_with_work(expression, report.source.source_declarations, &names, source_work, 0)
            return (false, false) if names.count == 0
            snapshot: (complete: bool, index: ProofReplayVariantScopePositionIndex, free_mask: usize) = proof_replay_variant_operator_scope_snapshot_with_work(report, source_work)
            return (false, false) if not snapshot.complete
            return (true, false) if (snapshot.free_mask & wanted.mask) != 0
            for name in names |report, wanted, snapshot, source_work|:
                implementation: (complete: bool, exists: bool) = proof_replay_variant_scoped_operator_exists_with_index(report, snapshot.index, name, wanted.mask, source_work)
                return (false, false) if not implementation.complete
                return (true, false) if implementation.exists
            return (true, true)

        # A const-enum check needs both alias-resolved type names and its source-spelled
        # concrete owner. Share one declaration snapshot and free-operator scan between them.
        def proof_replay_variant_type_and_named_operator_protocols_absent_with_work(expression: Ast::Expr, concrete: sview, protocols: darray[sview], report: ProofReport&, source_work: mutable usize&) -> (complete: bool, absent: bool):
            wanted: (complete: bool, mask: usize) = proof_replay_variant_operator_protocol_mask_with_work(protocols, source_work)
            return (false, false) if not wanted.complete
            return (true, true) if wanted.mask == PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY
            names: mutable darray[sview] = []
            return (false, false) if not proof_replay_variant_type_operator_names_with_work(expression, report.source.source_declarations, &names, source_work, 0)
            return (false, false) if names.count == 0
            snapshot: (complete: bool, index: ProofReplayVariantScopePositionIndex, free_mask: usize) = proof_replay_variant_operator_scope_snapshot_with_work(report, source_work)
            return (false, false) if not snapshot.complete
            return (true, false) if (snapshot.free_mask & wanted.mask) != 0
            for name in names |report, wanted, snapshot, source_work|:
                implementation: (complete: bool, exists: bool) = proof_replay_variant_scoped_operator_exists_with_index(report, snapshot.index, name, wanted.mask, source_work)
                return (false, false) if not implementation.complete
                return (true, false) if implementation.exists
            if concrete != "":
                implementation: (complete: bool, exists: bool) = proof_replay_variant_scoped_operator_exists_with_index(report, snapshot.index, concrete, wanted.mask, source_work)
                return (false, false) if not implementation.complete
                return (true, false) if implementation.exists
            return (true, true)

        def proof_replay_variant_named_operator_protocols_absent_with_work(concrete: sview, protocols: darray[sview], report: ProofReport&, source_work: mutable usize&) -> (complete: bool, absent: bool):
            return (true, true) if concrete == ""
            wanted: (complete: bool, mask: usize) = proof_replay_variant_operator_protocol_mask_with_work(protocols, source_work)
            return (false, false) if not wanted.complete
            return (true, true) if wanted.mask == PROOF_REPLAY_VARIANT_OPERATOR_MASK_EMPTY
            snapshot: (complete: bool, index: ProofReplayVariantScopePositionIndex, free_mask: usize) = proof_replay_variant_operator_scope_snapshot_with_work(report, source_work)
            return (false, false) if not snapshot.complete
            return (true, false) if (snapshot.free_mask & wanted.mask) != 0
            implementation: (complete: bool, exists: bool) = proof_replay_variant_scoped_operator_exists_with_index(report, snapshot.index, concrete, wanted.mask, source_work)
            return (false, false) if not implementation.complete
            return (true, false) if implementation.exists
            return (true, true)

        def proof_replay_variant_source_work_charge(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&, extra_scans: usize, pairwise_cases: bool) -> bool:
            return false if not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
            source_start: usize = source_work
            return false if not proof_replay_variant_source_tree_charge(report.source.source_declarations, source_work, 0)
            for annotation in report.source.source_annotations |source_work|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                import_metadata: (complete: bool, unresolved: bool) = proof_replay_structural_import_annotation_unresolved(annotation, source_work)
                return false if not import_metadata.complete or import_metadata.unresolved
            if source_work < source_start:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return false
            source_cost: usize = source_work - source_start
            return false if extra_scans != 0 and source_cost > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / extra_scans
            source_work <- source_work + source_cost * extra_scans
            if pairwise_cases:
                cases: usize = proof_replay_variant_case_count_with_work(trace.expression, 0, source_work)
                return false if cases > PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT
                if cases != 0:
                    return false if cases > (PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work) / cases / 3
                    source_work <- source_work + cases * cases * 3
            return true

        # Count declarations of `enum_name`, and how many of them declare each of two variants.
        # The complete source-tree preflight validates constructors; this second traversal still
        # charges every visited row and every compared name to the active trace budget.
        def proof_replay_variant_scan_with_work(declarations: darray[Ast::Decl]&, enum_name: sview, first: sview, second: sview, enums: mutable usize&, firsts: mutable usize&, seconds: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            for declaration in declarations |enum_name, first, second, enums, firsts, seconds, source_work, depth|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Enum(name, variants, _, _, _):
                        return false if not proof_replay_variant_text_compare_charge_with_work(name, enum_name, source_work)
                        if name == enum_name:
                            enums <- enums + 1
                            for variant in variants |first, second, firsts, seconds, source_work|:
                                return false if:
                                    not proof_replay_source_work_charge_or_exhaust(1, source_work)
                                    not proof_replay_variant_text_compare_charge_with_work(variant.name, first, source_work)
                                    not proof_replay_variant_text_compare_charge_with_work(variant.name, second, source_work)
                                firsts <- firsts + 1 if variant.name == first
                                seconds <- seconds + 1 if variant.name == second
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_replay_variant_scan_with_work(body, enum_name, first, second, enums, firsts, seconds, source_work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_replay_variant_scan_with_work(body, enum_name, first, second, enums, firsts, seconds, source_work, depth + 1)
                    Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_collect_enum_variants_with_work(declarations: darray[Ast::Decl]&, enum_name: sview, variants_out: mutable darray[sview]&, enums: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT:
                source_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            for declaration in declarations |enum_name, variants_out, enums, source_work, depth|:
                return false if not proof_replay_source_work_charge_or_exhaust(1, source_work)
                match declaration:
                    Ast::Decl.Enum(name, variants, _, _, _):
                        return false if not proof_replay_variant_text_compare_charge_with_work(name, enum_name, source_work)
                        if name == enum_name:
                            enums <- enums + 1
                            for variant in variants |variants_out, source_work|:
                                return false if:
                                    variants_out.count >= PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT
                                    not proof_replay_source_work_charge_or_exhaust(1, source_work)
                                    not proof_replay_source_work_charge_or_exhaust(sview_len(variant.name), source_work)
                                variants_out.push(variant.name)
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_replay_collect_enum_variants_with_work(body, enum_name, variants_out, enums, source_work, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_replay_collect_enum_variants_with_work(body, enum_name, variants_out, enums, source_work, depth + 1)
                    Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    Ast::Decl.Invalid:
                        return false
                    _:
                        return false
            return true

        def proof_replay_match_case_collect_with_work(expression: Ast::Expr, subjects: mutable darray[Ast::Expr]&, enum_names: mutable darray[sview]&, variants: mutable darray[sview]&, depth: usize, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_VARIANT_DEPTH_LIMIT or not proof_replay_source_work_charge_or_exhaust(1, source_work)
            match expression:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return false if not proof_replay_match_case_collect_with_work(left, subjects, enum_names, variants, depth + 1, source_work)
                    return proof_replay_match_case_collect_with_work(right, subjects, enum_names, variants, depth + 1, source_work)
                Ast::Expr.Binary(subject, TokenKind.Is, target, _):
                    return false if variants.count >= PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT
                    match target:
                        Ast::Expr.Field(Ast::Expr.Ident(enum_name, _), variant_name, _):
                            return false if enum_name == "" or variant_name == ""
                            subjects.push(subject)
                            enum_names.push(enum_name)
                            variants.push(variant_name)
                            return true
                        _:
                            return false
                _:
                    return false

        # This boundary fact is accepted only for the complete constructor set of one unique
        # source enum. Proposition replay separately verifies that every tag test has the same
        # subject type as that enum; malformed, omitted, duplicated, or foreign tags fail here.
        def proof_replay_match_exhaustiveness_valid(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            subjects: mutable darray[Ast::Expr] = []
            enum_names: mutable darray[sview] = []
            variants: mutable darray[sview] = []
            return false if:
                not proof_replay_match_case_collect_with_work(trace.expression, &subjects, &enum_names, &variants, 0, source_work)
                variants.count == 0 or variants.count > PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT
            first_subject: Ast::Expr = subjects[0]
            enum_name: sview = enum_names[0]
            for index in 0..<variants.count |index, subjects, enum_names, variants, source_work|:
                return false if:
                    not proof_replay_variant_expr_equal_with_work(subjects[index], first_subject, source_work)
                    not proof_replay_variant_text_compare_charge_with_work(enum_names[index], enum_name, source_work)
                    enum_names[index] != enum_name
                for prior in 0..<index |prior, variants, index, source_work|:
                    return false if:
                        not proof_replay_variant_text_compare_charge_with_work(variants[prior], variants[index], source_work)
                        variants[prior] == variants[index]
            declared: mutable darray[sview] = []
            enums: mutable usize = 0
            return false if:
                not proof_replay_collect_enum_variants_with_work(report.source.source_declarations, enum_name, &declared, &enums, source_work, 0)
                enums != 1 or declared.count != variants.count
            declared_seen: mutable darray[sview] = []
            for expected in declared |declared_seen, variants, source_work|:
                for earlier in declared_seen |expected, source_work|:
                    return false if:
                        not proof_replay_variant_text_compare_charge_with_work(earlier, expected, source_work)
                        earlier == expected
                declared_seen.push(expected)
                occurrences: mutable usize = 0
                for actual in variants |expected, occurrences, source_work|:
                    return false if not proof_replay_variant_text_compare_charge_with_work(actual, expected, source_work)
                    occurrences <- occurrences + 1 if actual == expected
                return false if occurrences != 1
            for actual in variants |variants, declared, source_work|:
                occurrences: mutable usize = 0
                for expected in declared |actual, occurrences, source_work|:
                    return false if not proof_replay_variant_text_compare_charge_with_work(expected, actual, source_work)
                    occurrences <- occurrences + 1 if expected == actual
                return false if occurrences != 1
            return true

        # One `not (subject is Enum.Variant)` disjunct: its subject, enum and variant.
        def proof_replay_variant_negated_test(expression: Ast::Expr) -> (known: bool, subject: Ast::Expr, enum_name: sview, variant: sview):
            no_subject: Ast::Expr = Ast::Expr.Invalid
            match expression:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Binary(subject, TokenKind.Is, target, _):
                            match target:
                                Ast::Expr.Field(base, variant_name, _):
                                    match base:
                                        Ast::Expr.Ident(enum_name, _):
                                            return (true, subject, enum_name, variant_name)
                                        _:
                                            return (false, no_subject, "", "")
                                _:
                                    return (false, no_subject, "", "")
                        _:
                            return (false, no_subject, "", "")
                _:
                    return (false, no_subject, "", "")

        def proof_replay_variant_exclusion_valid(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            match trace.expression:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    first: (known: bool, subject: Ast::Expr, enum_name: sview, variant: sview) = proof_replay_variant_negated_test(left)
                    second: (known: bool, subject: Ast::Expr, enum_name: sview, variant: sview) = proof_replay_variant_negated_test(right)
                    return false if:
                        not first.known or not second.known
                        not proof_replay_variant_text_compare_charge_with_work(first.enum_name, second.enum_name, source_work)
                        first.enum_name != second.enum_name
                        not proof_replay_variant_text_compare_charge_with_work(first.variant, second.variant, source_work)
                        first.variant == second.variant
                        not proof_replay_variant_expr_equal_with_work(first.subject, second.subject, source_work)
                    enums: mutable usize = 0
                    firsts: mutable usize = 0
                    seconds: mutable usize = 0
                    scan_complete: bool = proof_replay_variant_scan_with_work(report.source.source_declarations, first.enum_name, first.variant, second.variant, &enums, &firsts, &seconds, source_work, 0)
                    return false if not scan_complete or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return enums == 1 and firsts == 1 and seconds == 1
                _:
                    return false

        # Pairwise exclusion for const-enum value comparisons is admitted only when both
        # members have explicit, distinct integer tags in the one uniquely owned enum. Variant
        # names alone are insufficient because const enums may intentionally alias a value.
        def proof_replay_const_enum_member_value_valid(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Field(left_type, left_member, _), operator, Ast::Expr.Field(right_type, right_member, _), _):
                    return false if (operator != TokenKind.EqEq and operator != TokenKind.BangEq) or left_member == "" or right_member == "" or not proof_replay_variant_expr_equal_with_work(left_type, right_type, source_work)
                    enum_name: sview = proof_replay_variant_type_head_name_with_work(left_type, report.source.source_declarations, source_work, 0)
                    return false if enum_name == ""
                    path: mutable darray[sview] = []
                    return false if not proof_replay_resolve_enum_type_path_with_work(left_type, report.source.source_declarations, &path, source_work, 0) or path.count == 0
                    builtin_operator: (complete: bool, exists: bool) = proof_replay_variant_type_operator_impl_exists_with_work(left_type, "Eq", report, source_work)
                    return false if not builtin_operator.complete or builtin_operator.exists
                    hierarchy: (complete: bool, in_hierarchy: bool) = proof_replay_const_enum_hierarchy_with_work(report, enum_name, source_work)
                    return false if not hierarchy.complete or hierarchy.in_hierarchy or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_replay_count_named_aggregates_with_work(report.source.source_declarations, enum_name, 0, source_work)
                    return false if:
                        source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        aggregates.enums != 0 or aggregates.const_enums != 1 or aggregates.structs != 0
                    current_scope: darray[sview] = []
                    left: (enums: usize, const_enums: usize, members: usize, known: bool, value: i64) = proof_replay_const_enum_member_value_at_path(report.source.source_declarations, path, current_scope, left_member, 0, source_work)
                    return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    right: (enums: usize, const_enums: usize, members: usize, known: bool, value: i64) = proof_replay_const_enum_member_value_at_path(report.source.source_declarations, path, current_scope, right_member, 0, source_work)
                    return false if:
                        source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        left.enums != 1 or left.const_enums != 1 or left.members != 1 or not left.known
                        right.enums != 1 or right.const_enums != 1 or right.members != 1 or not right.known
                    return (left.value == right.value) if operator == TokenKind.EqEq else (left.value != right.value)
                _:
                    return false

        def proof_replay_const_enum_exclusion_valid(report: ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            match trace.expression:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    first: (known: bool, subject: Ast::Expr, enum_type: Ast::Expr, variant: sview) = proof_replay_const_enum_negated_equality(left)
                    second: (known: bool, subject: Ast::Expr, enum_type: Ast::Expr, variant: sview) = proof_replay_const_enum_negated_equality(right)
                    return false if:
                        not first.known or not second.known
                        not proof_replay_variant_text_compare_charge_with_work(first.variant, second.variant, source_work)
                        first.variant == second.variant
                        not proof_replay_variant_expr_equal_with_work(first.subject, second.subject, source_work) or not proof_replay_variant_expr_equal_with_work(first.enum_type, second.enum_type, source_work)
                    enum_name: sview = proof_replay_variant_type_head_name_with_work(first.enum_type, report.source.source_declarations, source_work, 0)
                    return false if enum_name == ""
                    builtin_operator: (complete: bool, exists: bool) = proof_replay_variant_type_operator_impl_exists_with_work(first.enum_type, "Eq", report, source_work)
                    return false if not builtin_operator.complete or builtin_operator.exists
                    hierarchy: (complete: bool, in_hierarchy: bool) = proof_replay_const_enum_hierarchy_with_work(report, enum_name, source_work)
                    return false if not hierarchy.complete or hierarchy.in_hierarchy or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_replay_count_named_aggregates_with_work(report.source.source_declarations, enum_name, 0, source_work)
                    return false if:
                        source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        aggregates.enums != 0 or aggregates.const_enums != 1 or aggregates.structs != 0
                    path: mutable darray[sview] = []
                    return false if not proof_replay_resolve_enum_type_path_with_work(first.enum_type, report.source.source_declarations, &path, source_work, 0) or path.count == 0
                    current_scope: darray[sview] = []
                    first_value: (enums: usize, const_enums: usize, members: usize, known: bool, value: i64) = proof_replay_const_enum_member_value_at_path(report.source.source_declarations, path, current_scope, first.variant, 0, source_work)
                    return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    second_value: (enums: usize, const_enums: usize, members: usize, known: bool, value: i64) = proof_replay_const_enum_member_value_at_path(report.source.source_declarations, path, current_scope, second.variant, 0, source_work)
                    return false if:
                        source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        first_value.enums != 1 or first_value.const_enums != 1 or first_value.members != 1 or not first_value.known
                        second_value.enums != 1 or second_value.const_enums != 1 or second_value.members != 1 or not second_value.known
                    return first_value.value != second_value.value
                _:
                    return false
