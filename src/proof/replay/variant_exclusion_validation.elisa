# Independent replay check for a "variant-exclusion" fact: `not (x is E.A) or not (x is E.B)` holds
# only when `E` is a single enum declaration in the source with two distinct variants `A` and `B`.
extend ElisaProof:
    private:
        const PROOF_REPLAY_VARIANT_DEPTH_LIMIT: usize = 32

        # Count declarations of `enum_name`, and how many of them declare each of two variants.
        def proof_replay_variant_scan(declarations: darray[Ast::Decl]&, enum_name: sview, first: sview, second: sview, enums: mutable usize&, firsts: mutable usize&, seconds: mutable usize&, depth: usize):
            return if depth >= PROOF_REPLAY_VARIANT_DEPTH_LIMIT
            for declaration in declarations |enum_name, first, second, enums, firsts, seconds, depth|:
                match declaration:
                    Ast::Decl.Enum(name, variants, _, _, _):
                        if name == enum_name:
                            enums <- enums + 1
                            for variant in variants |first, second, firsts, seconds|:
                                firsts <- firsts + 1 if variant.name == first
                                seconds <- seconds + 1 if variant.name == second
                    Ast::Decl.Module(_, body, _):
                        proof_replay_variant_scan(body, enum_name, first, second, enums, firsts, seconds, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        proof_replay_variant_scan(body, enum_name, first, second, enums, firsts, seconds, depth + 1)
                    _:
                        pass

        def proof_replay_collect_enum_variants(declarations: darray[Ast::Decl]&, enum_name: sview, variants_out: mutable darray[sview]&, enums: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_VARIANT_DEPTH_LIMIT
            for declaration in declarations |enum_name, variants_out, enums, depth|:
                match declaration:
                    Ast::Decl.Enum(name, variants, _, _, _):
                        if name == enum_name:
                            enums <- enums + 1
                            for variant in variants |variants_out|:
                                variants_out.push(variant.name)
                    Ast::Decl.Module(_, body, _):
                        return false if not proof_replay_collect_enum_variants(body, enum_name, variants_out, enums, depth + 1)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_replay_collect_enum_variants(body, enum_name, variants_out, enums, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_match_case_collect(expression: Ast::Expr, subjects: mutable darray[Ast::Expr]&, enum_names: mutable darray[sview]&, variants: mutable darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_VARIANT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return false if not proof_replay_match_case_collect(left, subjects, enum_names, variants, depth + 1)
                    return proof_replay_match_case_collect(right, subjects, enum_names, variants, depth + 1)
                Ast::Expr.Binary(subject, TokenKind.Is, target, _):
                    match target:
                        Ast::Expr.Field(Ast::Expr.Ident(enum_name, _), variant_name, _):
                            return false if enum_name == "" or variant_name == ""
                            subjects.push(subject)
                            enum_names.push(enum_name)
                            variants.push(variant_name)
                            return true
                        _:
                            return false
                _:
                    return false

        # This boundary fact is accepted only for the complete constructor set of one unique
        # source enum. Proposition replay separately verifies that every tag test has the same
        # subject type as that enum; malformed, omitted, duplicated, or foreign tags fail here.
        def proof_replay_match_exhaustiveness_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            subjects: mutable darray[Ast::Expr] = []
            enum_names: mutable darray[sview] = []
            variants: mutable darray[sview] = []
            return false if not proof_replay_match_case_collect(trace.expression, &subjects, &enum_names, &variants, 0)
            return false if variants.count == 0 or variants.count > PROOF_VARIANT_EXCLUSION_VARIANT_LIMIT
            first_subject: Ast::Expr = subjects[0]
            enum_name: sview = enum_names[0]
            for index in 0..<variants.count |index, subjects, enum_names, variants|:
                return false if not proof_expr_equal(subjects[index], first_subject) or enum_names[index] != enum_name
                for prior in 0..<index |prior, variants, index|:
                    return false if variants[prior] == variants[index]
            declared: mutable darray[sview] = []
            enums: mutable usize = 0
            return false if not proof_replay_collect_enum_variants(report.source_declarations, enum_name, &declared, &enums, 0)
            return false if enums != 1 or declared.count != variants.count
            declared_seen: mutable darray[sview] = []
            for expected in declared |declared_seen, variants|:
                return false if any earlier in declared_seen where earlier == expected
                declared_seen.push(expected)
                occurrences: mutable usize = 0
                for actual in variants |expected, occurrences|:
                    occurrences <- occurrences + 1 if actual == expected
                return false if occurrences != 1
            for actual in variants |variants, declared|:
                occurrences: mutable usize = 0
                for expected in declared |actual, occurrences|:
                    occurrences <- occurrences + 1 if expected == actual
                return false if occurrences != 1
            return true

        # One `not (subject is Enum.Variant)` disjunct: its subject, enum and variant.
        def proof_replay_variant_negated_test(expression: Ast::Expr) -> (known: bool, subject: Ast::Expr, enum_name: sview, variant: sview):
            no_subject: Ast::Expr = Ast::Expr.Invalid
            match expression:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Binary(subject, TokenKind.Is, target, _):
                            match target:
                                Ast::Expr.Field(base, variant_name, _):
                                    match base:
                                        Ast::Expr.Ident(enum_name, _):
                                            return (true, subject, enum_name, variant_name)
                                        _:
                                            return (false, no_subject, "", "")
                                _:
                                    return (false, no_subject, "", "")
                        _:
                            return (false, no_subject, "", "")
                _:
                    return (false, no_subject, "", "")

        def proof_replay_variant_exclusion_valid(report: ProofReport&, trace: ProofFactTrace) -> bool:
            match trace.expression:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    first: (known: bool, subject: Ast::Expr, enum_name: sview, variant: sview) = proof_replay_variant_negated_test(left)
                    second: (known: bool, subject: Ast::Expr, enum_name: sview, variant: sview) = proof_replay_variant_negated_test(right)
                    return false if not first.known or not second.known
                    return false if first.enum_name != second.enum_name or first.variant == second.variant
                    return false if not proof_expr_equal(first.subject, second.subject)
                    enums: mutable usize = 0
                    firsts: mutable usize = 0
                    seconds: mutable usize = 0
                    proof_replay_variant_scan(report.source_declarations, first.enum_name, first.variant, second.variant, &enums, &firsts, &seconds, 0)
                    return enums == 1 and firsts == 1 and seconds == 1
                _:
                    return false
