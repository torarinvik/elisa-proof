# Bounded binding reconstruction shared by source call coverage.
extend ElisaProof:
    private:
        struct ProofReplayCallSiteTarget:
            enabled: bool
            ignore_unmatched_scoped_edges: bool
            allow_scoped_target: bool
            include_nonassert_contract_calls: bool
            offset: usize
            line: u32
            name: sview
            calls_at_offset: mutable usize
            matched_calls: mutable usize
            source_annotations: darray[Ast::EnumAnnotation]

        def proof_replay_call_work_add(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + amount
            return true

        def proof_replay_call_string_compare_charge(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if not proof_replay_call_work_add(work, 1)
            return false if not proof_replay_call_work_add(work, sview_len(left))
            return proof_replay_call_work_add(work, sview_len(right))

        def proof_replay_call_bindings_extend(values: darray[sview], bindings: mutable darray[sview]&, work: mutable usize&) -> bool:
            for value in values |bindings, work|:
                return false if not proof_replay_call_work_add(work, 1 + sview_len(value))
                bindings.push(value)
            return true

        def proof_replay_call_effect_children_charge(candidates: darray[Ast::StaticEffectCandidate], arguments: darray[Ast::Expr], work: mutable usize&) -> bool:
            for candidate in candidates |work|:
                return false if not proof_replay_call_work_add(work, 1 + candidate.captures.count)
            return proof_replay_call_work_add(work, arguments.count)

        def proof_replay_call_site_match(name: sview, position: Ast::Pos, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            return true if not call_target.enabled or position.offset.usize() != call_target.offset
            return false if not proof_replay_call_work_add(work, 1)
            call_target.calls_at_offset <- call_target.calls_at_offset + 1
            return false if not proof_replay_call_string_compare_charge(name, call_target.name, work)
            call_target.matched_calls <- call_target.matched_calls + 1 if name == call_target.name and position.line == call_target.line
            return true

        def proof_replay_call_pattern_bindings(pattern: Ast::Pattern, bindings: mutable darray[sview]&, depth: usize) -> bool:
            work: mutable usize = 0
            return proof_replay_call_pattern_bindings_with_work(pattern, bindings, &work, depth)

        def proof_replay_call_pattern_bindings_with_work(pattern: Ast::Pattern, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match pattern:
                Ast::Pattern.Binding(name):
                    return false if not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name)
                Ast::Pattern.Rest(name):
                    return false if not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name) if name != ""
                Ast::Pattern.TypeBind(_, name):
                    return false if not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name)
                Ast::Pattern.As(name, children):
                    return false if not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name)
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Variant(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Struct(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Field(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Tuple(children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Or(children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Wildcard:
                    pass
                Ast::Pattern.Literal(_):
                    pass
                Ast::Pattern.Pin(_):
                    pass
                Ast::Pattern.Range(_, _, _):
                    pass
                _:
                    return false
            return true

        # Match-arm scope follows gather_arm_pattern: a top-level or-pattern with
        # any named binder contributes no names, while nested or-patterns expose
        # only the intersection of names across their alternatives.
        def proof_replay_call_arm_pattern_bindings_with_work(pattern: Ast::Pattern, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return proof_replay_call_arm_pattern_bindings_inner(pattern, bindings, work, depth, true)

        def proof_replay_call_arm_pattern_bindings_inner(pattern: Ast::Pattern, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize, arm_root: bool) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match pattern:
                Ast::Pattern.Binding(name) | Ast::Pattern.TypeBind(_, name):
                    return false if not proof_replay_call_work_add(work, 1 + sview_len(name))
                    bindings.push(name)
                Ast::Pattern.As(name, children):
                    return false if not proof_replay_call_work_add(work, 1 + sview_len(name))
                    bindings.push(name)
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_arm_pattern_bindings_inner(child, bindings, work, depth + 1, false)
                Ast::Pattern.Variant(_, children) | Ast::Pattern.Struct(_, children) | Ast::Pattern.Field(_, children) | Ast::Pattern.Tuple(children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_arm_pattern_bindings_inner(child, bindings, work, depth + 1, false)
                Ast::Pattern.Or(options):
                    if options.count == 0:
                        return true
                    if arm_root:
                        arm_names: mutable darray[sview] = []
                        for option in options |arm_names, work, depth|:
                            return false if not proof_replay_call_arm_pattern_bindings_inner(option, &arm_names, work, depth + 1, false)
                        for candidate in arm_names |work|:
                            return false if not proof_replay_call_work_add(work, 1 + sview_len(candidate))
                            return true if candidate != "" and candidate != "_"
                    first_names: mutable darray[sview] = []
                    return false if not proof_replay_call_arm_pattern_bindings_inner(options[0], &first_names, work, depth + 1, false)
                    for candidate in first_names |bindings, work, depth, options|:
                        in_every: mutable bool = true
                        for option_index in 1..<options.count |candidate, in_every, option_index, options, work, depth|:
                            option_names: mutable darray[sview] = []
                            return false if not proof_replay_call_arm_pattern_bindings_inner(options[option_index], &option_names, work, depth + 1, false)
                            found: mutable bool = false
                            for other in option_names |candidate, other, found, work|:
                                return false if not proof_replay_call_string_compare_charge(candidate, other, work)
                                found <- true if candidate == other
                            in_every <- false if not found
                        if in_every:
                            return false if not proof_replay_call_work_add(work, 1 + sview_len(candidate))
                            bindings.push(candidate)
                Ast::Pattern.Rest(_) | Ast::Pattern.Wildcard | Ast::Pattern.Literal(_) | Ast::Pattern.Pin(_) | Ast::Pattern.Range(_, _, _):
                    pass
                _:
                    return false
            return true

        # Recover binders from type/pattern targets without scanning them as runtime calls.
        def proof_replay_call_target_bindings(target: Ast::Expr, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match target:
                Ast::Expr.Ident(name, _):
                    return false if name == "" or not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name)
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments |bindings, work, depth|:
                        return false if not proof_replay_call_target_bindings(argument, bindings, work, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |bindings, work, depth|:
                        return false if not proof_replay_call_target_bindings(element, bindings, work, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |bindings, work, depth|:
                        return false if not proof_replay_call_target_bindings(field.value, bindings, work, depth + 1)
                Ast::Expr.Field(_, _, _) | Ast::Expr.Scope(_, _, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Absent:
                    pass
                _:
                    return false
            return true

        # Mirror resolve_scope.gather_expression_bindings. These names escape the
        # expression into the enclosing statement scope; branch-only bindings are
        # handled separately by proof_replay_call_condition_bindings.
        def proof_replay_call_expression_bindings(expression: Ast::Expr, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match expression:
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    return false if not proof_replay_call_effect_children_charge(candidates, arguments, work)
                    for child in Ast::effect_runtime_children(candidates, arguments) |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(child, bindings, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_replay_call_expression_bindings(left, bindings, work, depth + 1)
                    if operator == TokenKind.Is or operator == TokenKind.As:
                        return proof_replay_call_target_bindings(right, bindings, work, depth + 1)
                    return proof_replay_call_expression_bindings(right, bindings, work, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_call_expression_bindings(callee, bindings, work, depth + 1)
                    for argument in arguments |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(argument, bindings, work, depth + 1)
                Ast::Expr.Field(receiver, _, _) | Ast::Expr.Scope(receiver, _, _) | Ast::Expr.Unary(_, receiver, _) | Ast::Expr.Move(receiver, _) | Ast::Expr.RegionNew(receiver, _, _) | Ast::Expr.Paren(receiver, _):
                    return proof_replay_call_expression_bindings(receiver, bindings, work, depth + 1)
                Ast::Expr.Index(receiver, index, _) | Ast::Expr.Refinement(receiver, index, _):
                    return false if not proof_replay_call_expression_bindings(receiver, bindings, work, depth + 1)
                    return proof_replay_call_expression_bindings(index, bindings, work, depth + 1)
                Ast::Expr.GetElse(guarded, _, _):
                    return proof_replay_call_expression_bindings(guarded, bindings, work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(element, bindings, work, depth + 1)
                Ast::Expr.Slice(receiver, low, high, _):
                    return false if not proof_replay_call_expression_bindings(receiver, bindings, work, depth + 1)
                    return false if not proof_replay_call_expression_bindings(low, bindings, work, depth + 1)
                    return proof_replay_call_expression_bindings(high, bindings, work, depth + 1)
                Ast::Expr.IndexN(receiver, arguments, _):
                    return false if not proof_replay_call_expression_bindings(receiver, bindings, work, depth + 1)
                    for argument in arguments |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(argument, bindings, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(entry.key, bindings, work, depth + 1)
                        return false if not proof_replay_call_expression_bindings(entry.value, bindings, work, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(field.value, bindings, work, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_call_expression_bindings(base, bindings, work, depth + 1)
                    for field in fields |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(field.value, bindings, work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return false if not proof_replay_call_expression_bindings(condition, bindings, work, depth + 1)
                    return false if not proof_replay_call_expression_bindings(yes, bindings, work, depth + 1)
                    return proof_replay_call_expression_bindings(no, bindings, work, depth + 1)
                Ast::Expr.Comprehension(_, iterable, _, _, _) | Ast::Expr.Match(iterable, _, _) | Ast::Expr.Catch(iterable, _, _):
                    return proof_replay_call_expression_bindings(iterable, bindings, work, depth + 1)
                Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _) | Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                _:
                    return false
            return true

        def proof_replay_call_condition_bindings(condition: Ast::Expr, bindings: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match condition:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_call_condition_bindings(inner, bindings, call_target, work, depth + 1)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return false if not proof_replay_call_condition_bindings(left, bindings, call_target, work, depth + 1)
                    return proof_replay_call_condition_bindings(right, bindings, call_target, work, depth + 1)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    left_bindings: mutable darray[sview] = []
                    right_bindings: mutable darray[sview] = []
                    return false if not proof_replay_call_condition_bindings(left, &left_bindings, call_target, work, depth + 1)
                    return false if not proof_replay_call_condition_bindings(right, &right_bindings, call_target, work, depth + 1)
                    for candidate in left_bindings |candidate, right_bindings, bindings, work|:
                        present: mutable bool = false
                        for other in right_bindings |candidate, other, present, work|:
                            return false if not proof_replay_call_string_compare_charge(candidate, other, work)
                            present <- true if candidate == other
                        if present:
                            duplicate: mutable bool = false
                            for existing in bindings |candidate, existing, duplicate, work|:
                                return false if not proof_replay_call_string_compare_charge(candidate, existing, work)
                                duplicate <- true if candidate == existing
                            bindings.push(candidate) if not duplicate
                Ast::Expr.Binary(_, TokenKind.Is, target, position):
                    return false if not proof_replay_call_target_bindings(target, bindings, work, depth + 1)
                    match target:
                        Ast::Expr.Field(_, _, target_position):
                            for annotation in call_target.source_annotations |annotation, bindings, work, position, target_position|:
                                return false if not proof_replay_call_work_add(work, 1)
                                return false if not proof_replay_call_work_add(work, sview_len(annotation.name))
                                return false if not proof_replay_call_work_add(work, sview_len(annotation.owner))
                                if annotation.name == "__is_variant_alias" and (annotation.line == position.line or annotation.line == target_position.line):
                                    return false if annotation.owner == ""
                                    bindings.push(annotation.owner)
                        _:
                            pass
                Ast::Expr.Binary(_, TokenKind.As, target, _):
                    return proof_replay_call_target_bindings(target, bindings, work, depth + 1)
                _:
                    pass
            return true

        # Mirror condition-aware visitation only at If/While/Expr.If sites.
        def proof_replay_call_condition_expression(expression: Ast::Expr, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96
            match expression:
                Ast::Expr.Paren(inner, _):
                    return false if not proof_replay_call_work_add(work, 1)
                    return proof_replay_call_condition_expression(inner, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return false if not proof_replay_call_work_add(work, 1)
                    return proof_replay_call_condition_expression(inner, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return false if not proof_replay_call_work_add(work, 1)
                    return false if not proof_replay_call_condition_expression(left, bindings, calls, call_target, work, depth + 1)
                    mark: usize = bindings.count
                    return false if not proof_replay_call_condition_bindings(left, bindings, call_target, work, depth + 1)
                    valid: bool = proof_replay_call_condition_expression(right, bindings, calls, call_target, work, depth + 1)
                    bindings.resize(mark)
                    return valid
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return false if not proof_replay_call_work_add(work, 1)
                    return false if not proof_replay_call_condition_expression(left, bindings, calls, call_target, work, depth + 1)
                    return proof_replay_call_condition_expression(right, bindings, calls, call_target, work, depth + 1)
                Ast::Expr.Binary(left, TokenKind.Is, _, _) | Ast::Expr.Binary(left, TokenKind.As, _, _):
                    return false if not proof_replay_call_work_add(work, 1)
                    return proof_replay_call_expression(left, bindings, calls, call_target, work, depth + 1)
                _:
                    return proof_replay_call_expression(expression, bindings, calls, call_target, work, depth + 1)

        # For-loop filters use expression-binding scope, including aliases from earlier filters.
        def proof_replay_call_filter_bindings(filter: Ast::Expr, bindings: mutable darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match filter:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_call_filter_bindings(inner, bindings, call_target, work, depth + 1)
                Ast::Expr.Binary(left, TokenKind.Is, target, position):
                    return false if not proof_replay_call_filter_bindings(left, bindings, call_target, work, depth + 1)
                    return false if not proof_replay_call_target_bindings(target, bindings, work, depth + 1)
                    match target:
                        Ast::Expr.Field(_, _, target_position):
                            for annotation in call_target.source_annotations |annotation, bindings, work, position, target_position|:
                                return false if not proof_replay_call_work_add(work, 1)
                                return false if not proof_replay_call_work_add(work, sview_len(annotation.name))
                                return false if not proof_replay_call_work_add(work, sview_len(annotation.owner))
                                if annotation.name == "__is_variant_alias" and (annotation.line == position.line or annotation.line == target_position.line):
                                    return false if annotation.owner == ""
                                    bindings.push(annotation.owner)
                        _:
                            pass
                Ast::Expr.Binary(left, TokenKind.As, target, _):
                    return false if not proof_replay_call_filter_bindings(left, bindings, call_target, work, depth + 1)
                    return proof_replay_call_target_bindings(target, bindings, work, depth + 1)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Refinement(left, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not proof_replay_call_filter_bindings(left, bindings, call_target, work, depth + 1)
                    return proof_replay_call_filter_bindings(right, bindings, call_target, work, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    match callee:
                        Ast::Expr.Field(Ast::Expr.Ident(_, _), _, _):
                            if arguments.count > 0:
                                bare_arguments: mutable bool = true
                                for argument in arguments |bare_arguments, work|:
                                    return false if not proof_replay_call_work_add(work, 1)
                                    match argument:
                                        Ast::Expr.Ident(_, _):
                                            pass
                                        _:
                                            bare_arguments <- false
                                if bare_arguments:
                                    for argument in arguments |bindings, work, depth|:
                                        return false if not proof_replay_call_target_bindings(argument, bindings, work, depth + 1)
                                    return true
                        _:
                            pass
                    return false if not proof_replay_call_filter_bindings(callee, bindings, call_target, work, depth + 1)
                    for argument in arguments |bindings, call_target, work, depth|:
                        return false if not proof_replay_call_filter_bindings(argument, bindings, call_target, work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    return false if not proof_replay_call_effect_children_charge(candidates, arguments, work)
                    for child in Ast::effect_runtime_children(candidates, arguments) |bindings, call_target, work, depth|:
                        return false if not proof_replay_call_filter_bindings(child, bindings, call_target, work, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _):
                    return proof_replay_call_filter_bindings(object, bindings, call_target, work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_call_filter_bindings(object, bindings, call_target, work, depth + 1)
                    for argument in arguments |bindings, call_target, work, depth|:
                        return false if not proof_replay_call_filter_bindings(argument, bindings, call_target, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_replay_call_filter_bindings(object, bindings, call_target, work, depth + 1)
                    return false if not proof_replay_call_filter_bindings(low, bindings, call_target, work, depth + 1)
                    return proof_replay_call_filter_bindings(high, bindings, call_target, work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |bindings, call_target, work, depth|:
                        return false if not proof_replay_call_filter_bindings(element, bindings, call_target, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |bindings, call_target, work, depth|:
                        return false if not proof_replay_call_filter_bindings(entry.key, bindings, call_target, work, depth + 1)
                        return false if not proof_replay_call_filter_bindings(entry.value, bindings, call_target, work, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |bindings, call_target, work, depth|:
                        return false if not proof_replay_call_filter_bindings(field.value, bindings, call_target, work, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_call_filter_bindings(base, bindings, call_target, work, depth + 1)
                    for field in fields |bindings, call_target, work, depth|:
                        return false if not proof_replay_call_filter_bindings(field.value, bindings, call_target, work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return false if not proof_replay_call_filter_bindings(condition, bindings, call_target, work, depth + 1)
                    return false if not proof_replay_call_filter_bindings(yes, bindings, call_target, work, depth + 1)
                    return proof_replay_call_filter_bindings(no, bindings, call_target, work, depth + 1)
                Ast::Expr.GetElse(guarded, _, _) | Ast::Expr.Comprehension(_, guarded, _, _, _) | Ast::Expr.Match(guarded, _, _) | Ast::Expr.Catch(guarded, _, _):
                    return proof_replay_call_filter_bindings(guarded, bindings, call_target, work, depth + 1)
                Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _):
                    pass
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                _:
                    return false
            return true

        def proof_replay_call_comprehension_filter_splits(condition: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, splits: bool):
            return (complete: false, splits: false) if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match condition:
                Ast::Expr.Binary(left, TokenKind.And, _, _):
                    return (complete: false, splits: false) if not proof_replay_call_work_add(work, 1)
                    match left:
                        Ast::Expr.Binary(_, TokenKind.Is, _, _):
                            return (complete: true, splits: true)
                        Ast::Expr.Call(Ast::Expr.Field(Ast::Expr.Ident(_, _), _, _), arguments, _, _):
                            return (complete: false, splits: false) if not proof_replay_call_work_add(work, 3)
                            return (complete: false, splits: false) if arguments.count == 0
                            bare_arguments: mutable bool = true
                            for argument in arguments |bare_arguments, work|:
                                return (complete: false, splits: false) if not proof_replay_call_work_add(work, 1)
                                match argument:
                                    Ast::Expr.Ident(_, _):
                                        pass
                                    _:
                                        bare_arguments <- false
                            return (complete: true, splits: bare_arguments)
                        _:
                            return (complete: true, splits: false)
                _:
                    return (complete: true, splits: false)
