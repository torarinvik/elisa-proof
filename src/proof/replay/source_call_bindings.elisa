# Bounded binding reconstruction shared by source call coverage.
extend ElisaProof:
    private:
        struct ProofReplayCallNameIndex:
            hashes: mutable darray[u32] = []
            slots: mutable darray[usize] = []

        struct ProofReplayCallConditionPaths:
            when_true: darray[sview] = []
            when_false: darray[sview] = []

        def proof_replay_call_work_add(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            work <- work + amount
            return true

        def proof_replay_call_field_conversion_name_present(name: sview, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> (complete: bool, present: bool):
            names_count: usize = call_target.conversions.field_conversion_names.count
            hashes_count: usize = call_target.conversions.field_conversion_index_hashes.count
            return (false, false) if:
                not call_target.conversions.field_conversion_index_valid
                hashes_count != call_target.conversions.field_conversion_index_values.count or hashes_count != call_target.conversions.field_conversion_index_counts.count
                names_count == 0 and hashes_count != 0
                not proof_replay_call_work_add(work, sview_len(name))
            return (true, false) if names_count == 0 and hashes_count == 0
            return (false, false) if names_count == 0 or hashes_count == 0 or hashes_count != proof_name_index_capacity(names_count)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % hashes_count.i64()).usize()
            probes: mutable usize = 0
            while probes < hashes_count and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, call_target, names_count, hashes_count, work|:
                return (false, false) if not proof_replay_call_work_add(work, 1)
                current: usize = call_target.conversions.field_conversion_index_values[slot]
                return (true, false) if current == names_count
                return (false, false) if current > names_count
                if call_target.conversions.field_conversion_index_hashes[slot] == wanted_hash:
                    current_name: sview = call_target.conversions.field_conversion_names[current]
                    return (false, false) if not proof_replay_call_work_add(work, sview_len(current_name))
                    if current_name == name:
                        return (false, false) if call_target.conversions.field_conversion_index_counts[slot] == 0
                        return (true, true)
                slot <- (slot + 1) % hashes_count
                probes <- probes + 1
            return (false, false)

        def proof_replay_call_type_is_byte_darray(expression: Ast::Expr, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 64 or not proof_replay_call_work_add(work, 1)
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_call_type_is_byte_darray(inner, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_call_type_is_byte_darray(inner, work, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return false
                Ast::Expr.Index(head, element, _):
                    return false if not proof_replay_call_work_add(work, sview_len(proof_ident_name(head)) + sview_len(proof_ident_name(element)))
                    return proof_ident_name(head) == "darray" and proof_ident_name(element) == "u8"
                Ast::Expr.IndexN(head, elements, _):
                    return false if elements.count != 1 or not proof_replay_call_work_add(work, sview_len(proof_ident_name(head)) + sview_len(proof_ident_name(elements[0])))
                    return proof_ident_name(head) == "darray" and proof_ident_name(elements[0]) == "u8"
                _:
                    return false

        def proof_replay_call_container_element_type(type_expression: Ast::Expr, work: mutable usize&, depth: usize) -> (known: bool, element: Ast::Expr):
            return (false, Ast::Expr.Invalid) if depth >= 64 or not proof_replay_call_work_add(work, 1)
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_call_container_element_type(inner, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_call_container_element_type(inner, work, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return (false, Ast::Expr.Invalid)
                Ast::Expr.Ident(name, position):
                    return (false, Ast::Expr.Invalid) if not proof_replay_call_work_add(work, sview_len(name))
                    if name in {"sview", "cstr", "dstr", "str"}:
                        return (true, Ast::Expr.Ident("char", position))
                    return (false, Ast::Expr.Invalid)
                Ast::Expr.Index(head, argument, _):
                    head_name: sview = proof_ident_name(head)
                    argument_name: sview = proof_ident_name(argument)
                    return (false, Ast::Expr.Invalid) if not proof_replay_call_work_add(work, sview_len(head_name) + sview_len(argument_name))
                    return (true, argument) if head_name in {"darray", "view"}
                    return (true, head) if proof_source_expression_is_int_literal(argument)
                    return (false, Ast::Expr.Invalid)
                Ast::Expr.IndexN(head, arguments, _):
                    head_name: sview = proof_ident_name(head)
                    return (false, Ast::Expr.Invalid) if not proof_replay_call_work_add(work, sview_len(head_name))
                    for argument in arguments |work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_call_work_add(work, sview_len(proof_ident_name(argument)))
                    if head_name in {"darray", "view"}:
                        return (true, arguments[0]) if arguments.count == 1
                        return (false, Ast::Expr.Invalid)
                    if head_name == "array":
                        return (true, arguments[0]) if arguments.count == 2 and proof_source_expression_is_int_literal(arguments[1])
                    return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        def proof_replay_call_receiver_type(receiver: Ast::Expr, bindings: darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> (known: bool, type_expression: Ast::Expr):
            return (false, Ast::Expr.Invalid) if depth >= 64 or not proof_replay_call_work_add(work, 1)
            match receiver:
                Ast::Expr.Ident(name, _):
                    selected: mutable Ast::Expr = Ast::Expr.Invalid
                    matches: mutable usize = 0
                    active_matches: mutable usize = 0
                    for bound in bindings |name, active_matches, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_call_work_add(work, 1 + sview_len(bound) + sview_len(name))
                        active_matches <- active_matches + 1 if bound == name
                    # A formal's spelling is not enough to establish its type once a
                    # lexical declaration can shadow it. Bindings are kept in scope order,
                    # so a repeated active name makes the receiver opaque.
                    return (false, Ast::Expr.Invalid) if active_matches != 1
                    for parameter in call_target.conversions.field_conversion_parameters |name, selected, matches, work|:
                        return (false, Ast::Expr.Invalid) if not proof_replay_call_work_add(work, 1 + sview_len(name) + sview_len(parameter.name))
                        if parameter.name == name:
                            selected <- parameter.type_expression
                            matches <- matches + 1
                    return (matches == 1, selected)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_call_receiver_type(inner, bindings, call_target, work, depth + 1)
                Ast::Expr.Index(object, _, _):
                    parent: (known: bool, type_expression: Ast::Expr) = proof_replay_call_receiver_type(object, bindings, call_target, work, depth + 1)
                    return (false, Ast::Expr.Invalid) if not parent.known
                    element: (known: bool, element: Ast::Expr) = proof_replay_call_container_element_type(parent.type_expression, work, depth + 1)
                    return (element.known, element.element)
                Ast::Expr.IndexN(object, arguments, _):
                    parent: (known: bool, type_expression: Ast::Expr) = proof_replay_call_receiver_type(object, bindings, call_target, work, depth + 1)
                    return (false, Ast::Expr.Invalid) if not parent.known or arguments.count == 0
                    selected: mutable Ast::Expr = parent.type_expression
                    for _argument in arguments |work, selected|:
                        element: (known: bool, element: Ast::Expr) = proof_replay_call_container_element_type(selected, work, depth + 1)
                        return (false, Ast::Expr.Invalid) if not element.known
                        selected <- element.element
                    return (true, selected)
                _:
                    return (false, Ast::Expr.Invalid)

        def proof_replay_call_type_head_name(type_expression: Ast::Expr, work: mutable usize&, depth: usize) -> sview:
            return "" if depth >= 32 or not proof_replay_call_work_add(work, 1)
            match type_expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_call_type_head_name(inner, work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_call_type_head_name(inner, work, depth + 1) if operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Mutable or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return ""
                _:
                    type_name: sview = proof_head_name(type_expression)
                    return "" if not proof_replay_call_work_add(work, sview_len(type_name))
                    return type_name

        def proof_replay_call_field_conversion_is_intrinsic(callee: Ast::Expr, arguments: darray[Ast::Expr], argument_names: darray[sview], bindings: darray[sview]&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            return false if arguments.count != 0 or argument_names.count != 0
            match proof_strip_parens(callee):
                Ast::Expr.Field(receiver, method, _):
                    return false if:
                        not proof_resource_pure_conversion(method)
                        not proof_replay_call_work_add(work, 1)
                    receiver_type: (known: bool, type_expression: Ast::Expr) = proof_replay_call_receiver_type(receiver, bindings, call_target, work, 0)
                    return false if not receiver_type.known
                    active_aliases: mutable darray[usize] = []
                    unwrapped_type: (complete: bool, type_expression: Ast::Expr) = proof_replay_call_conversion_type_alias_unwrap(receiver_type.type_expression, call_target.generics.field_conversion_generic_param_line, true, "", call_target, &active_aliases, work, 0)
                    return false if not unwrapped_type.complete
                    return proof_replay_call_type_is_byte_darray(unwrapped_type.type_expression, work, 0) if method == "as_sview"
                    return false if call_target.conversions.field_conversion_custom_cast_present
                    method_declared: (complete: bool, present: bool) = proof_replay_call_field_conversion_name_present(method, call_target, work)
                    return false if not method_declared.complete or method_declared.present
                    receiver_type_name: sview = proof_replay_call_type_head_name(unwrapped_type.type_expression, work, 0)
                    return receiver_type_name in {"sview", "dstr", "cstr"} if method == "sview"
                    return proof_builtin_scalar_type_name(receiver_type_name)
                _:
                    return false

        def proof_replay_call_string_compare_charge(left: sview, right: sview, work: mutable usize&) -> bool:
            return false if:
                not proof_replay_call_work_add(work, 1)
                not proof_replay_call_work_add(work, sview_len(left))
            return proof_replay_call_work_add(work, sview_len(right))

        def proof_replay_call_name_index_contains(names: darray[sview]&, index: ProofReplayCallNameIndex&, wanted: sview, work: mutable usize&) -> (complete: bool, present: bool):
            capacity: usize = index.slots.count
            return (true, false) if names.count == 0 and index.hashes.count == 0 and capacity == 0
            expected_capacity: usize = proof_name_index_capacity(names.count)
            return (false, false) if:
                names.count == 0 or expected_capacity == 0 or capacity != expected_capacity or index.hashes.count != names.count
                not proof_replay_call_work_add(work, sview_len(wanted))
            wanted_hash: u32 = proof_name_hash(wanted)
            slot: usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, wanted, names, index, capacity, work|:
                return (false, false) if not proof_replay_call_work_add(work, 1)
                current: usize = index.slots[slot]
                return (true, false) if current == 0
                existing: usize = current - 1
                return (false, false) if existing >= names.count
                if index.hashes[existing] == wanted_hash:
                    return (false, false) if not proof_replay_call_string_compare_charge(names[existing], wanted, work)
                    return (true, true) if names[existing] == wanted
                slot <- slot + 1 if slot + 1 < capacity else 0
                probes <- probes + 1
            return (false, false)

        def proof_replay_call_bindings_extend(values: darray[sview], bindings: mutable darray[sview]&, work: mutable usize&) -> bool:
            for value in values |bindings, work|:
                return false if not proof_replay_call_work_add(work, 1 + sview_len(value))
                bindings.push(value)
            return true

        # Captures name values already present in the surrounding lexical environment;
        # they are not fresh shadowing declarations. Preserve actual duplicate binders from
        # VarDecl/pattern/loop walks while avoiding a second copy for capture metadata.
        def proof_replay_call_captures_extend(values: darray[sview], bindings: mutable darray[sview]&, work: mutable usize&) -> bool:
            for value in values |bindings, work|:
                return false if not proof_replay_call_work_add(work, 1 + sview_len(value))
                found: mutable bool = false
                for bound in bindings |bound, value, found, work|:
                    return false if not proof_replay_call_string_compare_charge(bound, value, work)
                    found <- true if bound == value
                bindings.push(value) if not found
            return true

        def proof_replay_call_effect_children_charge(candidates: darray[Ast::StaticEffectCandidate], arguments: darray[Ast::Expr], work: mutable usize&) -> bool:
            for candidate in candidates |work|:
                return false if not proof_replay_call_work_add(work, 1 + candidate.captures.count)
            return proof_replay_call_work_add(work, arguments.count)

        def proof_replay_call_site_match(name: sview, position: Ast::Pos, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            if call_target.capture.capture_all_call_sites:
                if call_target.selection.enabled:
                    return false if not proof_replay_call_work_add(work, 1 + sview_len(name))
                    call_target.capture.captured_call_offsets.push(position.offset.usize())
                    call_target.capture.captured_call_lines.push(position.line)
                    call_target.capture.captured_call_names.push(name)
                return true
            return true if not call_target.selection.enabled or position.offset.usize() != call_target.selection.offset
            return false if not proof_replay_call_work_add(work, 1)
            call_target.selection.calls_at_offset <- call_target.selection.calls_at_offset + 1
            return false if not proof_replay_call_string_compare_charge(name, call_target.selection.name, work)
            call_target.selection.matched_calls <- call_target.selection.matched_calls + 1 if name == call_target.selection.name and position.line == call_target.selection.line
            return true

        def proof_replay_call_site_scoped(position: Ast::Pos, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            return true if not call_target.capture.capture_all_call_sites or not call_target.selection.enabled
            return false if not proof_replay_call_work_add(work, 1)
            call_target.capture.captured_scope_offsets.push(position.offset.usize())
            return true

        # Deterministic replay keeps the source callee AST alongside the older leaf-name set.
        # The AST preserves a module path so later recursive edges can be resolved in the
        # caller's namespace instead of forcing global leaf-name uniqueness.
        def proof_replay_call_callee_path_equal(left: Ast::Expr, right: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, equal: bool):
            return (false, false) if:
                depth >= 96
                not proof_replay_call_work_add(work, 1)
            match left:
                Ast::Expr.Ident(left_name, _):
                    match right:
                        Ast::Expr.Ident(right_name, _):
                            return (false, false) if not proof_replay_call_string_compare_charge(left_name, right_name, work)
                            return (true, left_name == right_name)
                        _:
                            return (true, false)
                Ast::Expr.Scope(left_base, left_name, _):
                    match right:
                        Ast::Expr.Scope(right_base, right_name, _):
                            return (false, false) if not proof_replay_call_string_compare_charge(left_name, right_name, work)
                            return (true, false) if left_name != right_name
                            return proof_replay_call_callee_path_equal(left_base, right_base, work, depth + 1)
                        _:
                            return (true, false)
                _:
                    return (true, false)

        def proof_replay_call_callee_path_hash(expression: Ast::Expr, work: mutable usize&, depth: usize) -> (complete: bool, hash: u32):
            return (false, 0) if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, 0) if not proof_replay_call_work_add(work, sview_len(name))
                    return (true, proof_expr_shape_mix(proof_name_hash(name), 1))
                Ast::Expr.Scope(base, name, _):
                    child: (complete: bool, hash: u32) = proof_replay_call_callee_path_hash(base, work, depth + 1)
                    return (false, 0) if not child.complete or not proof_replay_call_work_add(work, sview_len(name))
                    return (true, proof_expr_shape_mix(proof_expr_shape_mix(child.hash, proof_name_hash(name).i64()), 2))
                _:
                    return (false, 0)

        def proof_replay_call_callee_path_index_place(call_target: mutable ProofReplayCallSiteTarget&, wanted: Ast::Expr, wanted_hash: u32, work: mutable usize&) -> (complete: bool, inserted: bool):
            capacity: usize = call_target.capture.captured_callee_path_slots.count
            return (false, false) if capacity == 0 or call_target.capture.captured_callee_paths.count != call_target.capture.captured_callee_path_hashes.count
            slot: usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted, wanted_hash, call_target, capacity, work|:
                return (false, false) if not proof_replay_call_work_add(work, 1)
                current: usize = call_target.capture.captured_callee_path_slots[slot]
                if current == 0:
                    call_target.capture.captured_callee_path_slots[slot] <- call_target.capture.captured_callee_paths.count + 1
                    return (true, true)
                existing: usize = current - 1
                return (false, false) if existing >= call_target.capture.captured_callee_paths.count or existing >= call_target.capture.captured_callee_path_hashes.count
                if call_target.capture.captured_callee_path_hashes[existing] == wanted_hash:
                    comparison: (complete: bool, equal: bool) = proof_replay_call_callee_path_equal(call_target.capture.captured_callee_paths[existing], wanted, work, 0)
                    return (false, false) if not comparison.complete
                    return (true, false) if comparison.equal
                slot <- slot + 1 if slot + 1 < capacity else 0
                probes <- probes + 1
            return (false, false)

        def proof_replay_call_callee_path_index_rebuild(call_target: mutable ProofReplayCallSiteTarget&, capacity: usize, work: mutable usize&) -> bool:
            count: usize = call_target.capture.captured_callee_paths.count
            return false if:
                capacity == 0 or count > capacity / 2 or count != call_target.capture.captured_callee_path_hashes.count
                not proof_replay_call_work_add(work, capacity)
            call_target.capture.captured_callee_path_slots.clear()
            call_target.capture.captured_callee_path_slots.resize(capacity)
            for slot in 0..<capacity |slot, call_target|:
                call_target.capture.captured_callee_path_slots[slot] <- 0
            for index in 0..<count |index, call_target, capacity, work|:
                placed: (complete: bool, inserted: bool) = proof_replay_call_callee_path_index_place(call_target, call_target.capture.captured_callee_paths[index], call_target.capture.captured_callee_path_hashes[index], work)
                return false if not placed.complete or not placed.inserted
            return true

        def proof_replay_call_capture_callee_path(callee: Ast::Expr, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&) -> bool:
            return true if not call_target.capture.capture_callee_paths
            return false if call_target.capture.captured_callee_paths.count != call_target.capture.captured_callee_path_hashes.count
            hashed: (complete: bool, hash: u32) = proof_replay_call_callee_path_hash(callee, work, 0)
            return false if not hashed.complete
            next_count: usize = call_target.capture.captured_callee_paths.count + 1
            if call_target.capture.captured_callee_path_slots.count == 0 or next_count > call_target.capture.captured_callee_path_slots.count / 2:
                capacity: usize = proof_name_index_capacity(next_count)
                return false if capacity == 0 or not proof_replay_call_callee_path_index_rebuild(call_target, capacity, work)
            return false if not proof_replay_call_work_add(work, 2)
            placed: (complete: bool, inserted: bool) = proof_replay_call_callee_path_index_place(call_target, callee, hashed.hash, work)
            return false if not placed.complete
            if placed.inserted:
                call_target.capture.captured_callee_paths.push(callee)
                call_target.capture.captured_callee_path_hashes.push(hashed.hash)
            return true

        def proof_replay_call_pattern_bindings(pattern: Ast::Pattern, bindings: mutable darray[sview]&, depth: usize) -> bool:
            work: mutable usize = 0
            return proof_replay_call_pattern_bindings_with_work(pattern, bindings, &work, depth)

        def proof_replay_call_pattern_bindings_with_work(pattern: Ast::Pattern, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match pattern:
                Ast::Pattern.Binding(name):
                    return false if not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name)
                Ast::Pattern.Rest(name):
                    return false if not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name) if name != ""
                Ast::Pattern.TypeBind(_, name):
                    return false if not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name)
                Ast::Pattern.As(name, children):
                    return false if not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name)
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Variant(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Struct(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Field(_, children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Tuple(children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Or(children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_pattern_bindings_with_work(child, bindings, work, depth + 1)
                Ast::Pattern.Wildcard:
                    pass
                Ast::Pattern.Literal(_):
                    pass
                Ast::Pattern.Pin(_):
                    pass
                Ast::Pattern.Range(_, _, _):
                    pass
                _:
                    return false
            return true

        def proof_replay_call_scoped_target_site(callee: Ast::Expr, base: Ast::Expr, name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, position: Ast::Pos, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_index: mutable ProofReplayCallNameIndex&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if name == ""
            exact_complete: mutable bool = true
            exact: bool = proof_replay_deterministic_call_expression_equal_with_work(Ast::Expr.Call(callee, arguments, argument_names, position), call_target.capture.expected_call, work, &exact_complete, 0) if call_target.capture.require_exact_call
            return false if call_target.capture.require_exact_call and (not exact_complete or not exact)
            shadowed: mutable bool = false
            for bound in bindings |bound, name, shadowed, work|:
                return false if not proof_replay_call_string_compare_charge(bound, name, work)
                shadowed <- true if bound == name
            return false if:
                shadowed
                not proof_replay_call_site_match(name, position, call_target, work)
                not proof_replay_call_name_index_add(calls, call_index, name, work)
                not proof_replay_call_capture_callee_path(callee, call_target, work)
            return proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)

        # Match-arm scope follows gather_arm_pattern: a top-level or-pattern with
        # any named binder contributes no names, while nested or-patterns expose
        # only the intersection of names across their alternatives.
        def proof_replay_call_arm_pattern_bindings_with_work(pattern: Ast::Pattern, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return proof_replay_call_arm_pattern_bindings_inner(pattern, bindings, work, depth, true)

        def proof_replay_call_arm_pattern_bindings_inner(pattern: Ast::Pattern, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize, arm_root: bool) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match pattern:
                Ast::Pattern.Binding(name) | Ast::Pattern.TypeBind(_, name):
                    return false if not proof_replay_call_work_add(work, 1 + sview_len(name))
                    bindings.push(name)
                Ast::Pattern.As(name, children):
                    return false if not proof_replay_call_work_add(work, 1 + sview_len(name))
                    bindings.push(name)
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_arm_pattern_bindings_inner(child, bindings, work, depth + 1, false)
                Ast::Pattern.Variant(_, children) | Ast::Pattern.Struct(_, children) | Ast::Pattern.Field(_, children) | Ast::Pattern.Tuple(children):
                    for child in children |bindings, work, depth|:
                        return false if not proof_replay_call_arm_pattern_bindings_inner(child, bindings, work, depth + 1, false)
                Ast::Pattern.Or(options):
                    if options.count == 0:
                        return true
                    if arm_root:
                        arm_names: mutable darray[sview] = []
                        for option in options |arm_names, work, depth|:
                            return false if not proof_replay_call_arm_pattern_bindings_inner(option, &arm_names, work, depth + 1, false)
                        for candidate in arm_names |work|:
                            return false if not proof_replay_call_work_add(work, 1 + sview_len(candidate))
                            return true if candidate != "" and candidate != "_"
                    first_names: mutable darray[sview] = []
                    return false if not proof_replay_call_arm_pattern_bindings_inner(options[0], &first_names, work, depth + 1, false)
                    for candidate in first_names |bindings, work, depth, options|:
                        in_every: mutable bool = true
                        for option_index in 1..<options.count |candidate, in_every, option_index, options, work, depth|:
                            option_names: mutable darray[sview] = []
                            return false if not proof_replay_call_arm_pattern_bindings_inner(options[option_index], &option_names, work, depth + 1, false)
                            found: mutable bool = false
                            for other in option_names |candidate, other, found, work|:
                                return false if not proof_replay_call_string_compare_charge(candidate, other, work)
                                found <- true if candidate == other
                            in_every <- false if not found
                        if in_every:
                            return false if not proof_replay_call_work_add(work, 1 + sview_len(candidate))
                            bindings.push(candidate)
                Ast::Pattern.Rest(_) | Ast::Pattern.Wildcard | Ast::Pattern.Literal(_) | Ast::Pattern.Pin(_) | Ast::Pattern.Range(_, _, _):
                    pass
                _:
                    return false
            return true

        # Recover binders from type/pattern targets without scanning them as runtime calls.
        def proof_replay_call_target_bindings(target: Ast::Expr, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match target:
                Ast::Expr.Ident(name, _):
                    return false if name == "" or not proof_replay_call_work_add(work, sview_len(name))
                    bindings.push(name)
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments |bindings, work, depth|:
                        return false if not proof_replay_call_target_bindings(argument, bindings, work, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |bindings, work, depth|:
                        return false if not proof_replay_call_target_bindings(element, bindings, work, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |bindings, work, depth|:
                        return false if not proof_replay_call_target_bindings(field.value, bindings, work, depth + 1)
                Ast::Expr.Field(_, _, _) | Ast::Expr.Scope(_, _, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Absent:
                    pass
                _:
                    return false
            return true

        # Mirror resolve_scope.gather_expression_bindings. These names escape the
        # expression into the enclosing statement scope; branch-only bindings are
        # handled separately by proof_replay_call_condition_bindings.
        def proof_replay_call_expression_bindings(expression: Ast::Expr, bindings: mutable darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match expression:
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    return false if not proof_replay_call_effect_children_charge(candidates, arguments, work)
                    for child in Ast::effect_runtime_children(candidates, arguments) |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(child, bindings, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_replay_call_expression_bindings(left, bindings, work, depth + 1)
                    if operator == TokenKind.Is or operator == TokenKind.As:
                        return proof_replay_call_target_bindings(right, bindings, work, depth + 1)
                    return proof_replay_call_expression_bindings(right, bindings, work, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_call_expression_bindings(callee, bindings, work, depth + 1)
                    for argument in arguments |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(argument, bindings, work, depth + 1)
                Ast::Expr.Field(receiver, _, _) | Ast::Expr.Scope(receiver, _, _) | Ast::Expr.Unary(_, receiver, _) | Ast::Expr.Move(receiver, _) | Ast::Expr.RegionNew(receiver, _, _) | Ast::Expr.Paren(receiver, _):
                    return proof_replay_call_expression_bindings(receiver, bindings, work, depth + 1)
                Ast::Expr.Index(receiver, index, _) | Ast::Expr.Refinement(receiver, index, _):
                    return false if not proof_replay_call_expression_bindings(receiver, bindings, work, depth + 1)
                    return proof_replay_call_expression_bindings(index, bindings, work, depth + 1)
                Ast::Expr.GetElse(guarded, _, _):
                    return proof_replay_call_expression_bindings(guarded, bindings, work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(element, bindings, work, depth + 1)
                Ast::Expr.Slice(receiver, low, high, _):
                    return false if:
                        not proof_replay_call_expression_bindings(receiver, bindings, work, depth + 1)
                        not proof_replay_call_expression_bindings(low, bindings, work, depth + 1)
                    return proof_replay_call_expression_bindings(high, bindings, work, depth + 1)
                Ast::Expr.IndexN(receiver, arguments, _):
                    return false if not proof_replay_call_expression_bindings(receiver, bindings, work, depth + 1)
                    for argument in arguments |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(argument, bindings, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |bindings, work, depth|:
                        return false if:
                            not proof_replay_call_expression_bindings(entry.key, bindings, work, depth + 1)
                            not proof_replay_call_expression_bindings(entry.value, bindings, work, depth + 1)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(field.value, bindings, work, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_call_expression_bindings(base, bindings, work, depth + 1)
                    for field in fields |bindings, work, depth|:
                        return false if not proof_replay_call_expression_bindings(field.value, bindings, work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return false if:
                        not proof_replay_call_expression_bindings(condition, bindings, work, depth + 1)
                        not proof_replay_call_expression_bindings(yes, bindings, work, depth + 1)
                    return proof_replay_call_expression_bindings(no, bindings, work, depth + 1)
                Ast::Expr.Comprehension(_, iterable, _, _, _) | Ast::Expr.Match(iterable, _, _) | Ast::Expr.Catch(iterable, _, _):
                    return proof_replay_call_expression_bindings(iterable, bindings, work, depth + 1)
                Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _) | Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                _:
                    return false
            return true
