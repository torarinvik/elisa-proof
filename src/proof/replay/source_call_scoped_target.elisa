# Scoped source-call target checks, split from the general binding visitor.
extend ElisaProof:
    private:
        # Reject module-path roots shadowed by caller-local bindings.
        def proof_replay_call_scope_base_has_bound_root(base: Ast::Expr, bindings: darray[sview]&, work: mutable usize&, depth: usize) -> bool:
            return true if depth >= 96 or not proof_replay_call_work_add(work, 1)
            match base:
                Ast::Expr.Ident(root_name, _):
                    return true if root_name == ""
                    for bound in bindings |bound, root_name, work|:
                        return true if not proof_replay_call_string_compare_charge(bound, root_name, work)
                        return true if bound == root_name
                    return false
                Ast::Expr.Scope(inner_base, _, _):
                    return proof_replay_call_scope_base_has_bound_root(inner_base, bindings, work, depth + 1)
                # A global selector has no module-head identifier.
                Ast::Expr.Absent:
                    return false
                _:
                    return true

        def proof_replay_call_scoped_target_site(callee: Ast::Expr, base: Ast::Expr, name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, position: Ast::Pos, bindings: mutable darray[sview]&, calls: mutable darray[sview]&, call_index: mutable ProofReplayCallNameIndex&, call_target: mutable ProofReplayCallSiteTarget&, work: mutable usize&, depth: usize) -> bool:
            return false if name == ""
            return false if proof_replay_call_scope_base_has_bound_root(base, bindings, work, 0)
            exact_complete: mutable bool = true
            exact: mutable bool = false
            if call_target.capture.require_exact_call:
                exact <- proof_replay_deterministic_call_expression_equal_with_work(Ast::Expr.Call(callee, arguments, argument_names, position), call_target.capture.expected_call, work, &exact_complete, 0)
            return false if call_target.capture.require_exact_call and (not exact_complete or not exact)
            shadowed: mutable bool = false
            for bound in bindings |bound, name, shadowed, work|:
                return false if not proof_replay_call_string_compare_charge(bound, name, work)
                shadowed <- true if bound == name
            return false if:
                shadowed
                not proof_replay_call_site_match(name, position, call_target, work)
                not proof_replay_call_name_index_add(calls, call_index, name, work, call_target.capture.preserve_call_occurrences)
                not proof_replay_call_capture_callee_path(callee, call_target, work)
            return proof_replay_call_expression_with_index(base, bindings, calls, call_index, call_target, work, depth + 1)
