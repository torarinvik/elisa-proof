extend ElisaProof:
    private:
        def proof_replay_type_bound_dynamic_array_value_type(type_expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match type_expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_type_bound_dynamic_array_value_type(inner, depth + 1)
                Ast::Expr.Index(Ast::Expr.Ident("darray", _), _, _):
                    return true
                Ast::Expr.IndexN(Ast::Expr.Ident("darray", _), arguments, _):
                    return arguments.count == 1
                _:
                    return false

        def proof_replay_type_bound_readonly_dynamic_array_type(type_expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_LOCAL_BINDING_DEPTH_LIMIT
            match type_expression:
                Ast::Expr.Paren(inner, _):
                    return proof_replay_type_bound_readonly_dynamic_array_type(inner, depth + 1)
                Ast::Expr.Unary(TokenKind.Ampersand, inner, _):
                    return proof_replay_type_bound_dynamic_array_value_type(inner, depth + 1)
                _:
                    return false

        def proof_replay_type_bound_single_return_body(statements: darray[Ast::Stmt]&) -> bool:
            return false if statements.count != 1
            return match statements[0]:
                Ast::Stmt.Return(_, _):
                    true
                _:
                    false

        def proof_replay_type_bound_is_dynamic_array_guard(statement: Ast::Stmt, array_name: sview, bound_symbol: sview, line: u32) -> bool:
            return match statement:
                Ast::Stmt.If(Ast::Expr.Binary(Ast::Expr.Ident(guard_index, _), TokenKind.GtEq, Ast::Expr.Field(Ast::Expr.Ident(guard_array, _), "count", _), _), then_body, else_body, guard_position):
                    guard_index == bound_symbol and guard_array == array_name and guard_position.line < line and else_body.count == 0 and proof_replay_type_bound_single_return_body(then_body)
                _:
                    false

        def proof_replay_type_bound_is_dynamic_array_access_return(statement: Ast::Stmt, array_name: sview, bound_symbol: sview, line: u32) -> bool:
            return match statement:
                Ast::Stmt.Return(Ast::Expr.Index(Ast::Expr.Ident(access_array, _), Ast::Expr.Ident(access_index, _), access_position), statement_position):
                    access_array == array_name and access_index == bound_symbol and access_position.line == line and statement_position.line == line
                _:
                    false

        def proof_replay_type_bound_dynamic_array_source_body_shape(statements: darray[Ast::Stmt]&, array_name: sview, bound_symbol: sview, line: u32) -> bool:
            guard_index: mutable usize = 0
            while guard_index < statements.count |guard_index, statements|:
                is_requires: bool = match statements[guard_index]:
                    Ast::Stmt.Contract("requires", _, _):
                        true
                    _:
                        false
                break if not is_requires
                guard_index <- guard_index + 1
            return false if statements.count != guard_index + 2
            proof_replay_type_bound_is_dynamic_array_guard(statements[guard_index], array_name, bound_symbol, line) and proof_replay_type_bound_is_dynamic_array_access_return(statements[guard_index + 1], array_name, bound_symbol, line)

        # A dynamic-array count bound is admitted only when, after leading `requires` contracts,
        # the body is the guard followed by its direct indexed return. This excludes earlier
        # local declarations that could shadow a formal parameter while preserving contracts.
        def proof_replay_type_bound_dynamic_array_guard_fact(report: ProofReport&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, expression: Ast::Expr, line: u32) -> bool:
            match expression:
                Ast::Expr.Binary(Ast::Expr.Ident(bound_symbol, _), TokenKind.Lt, Ast::Expr.Field(Ast::Expr.Ident(array_name, _), "count", _), _):
                    return false if bound_symbol == "" or array_name == "" or bound_symbol == array_name or line == 0
                    array_matches: mutable usize = 0
                    array_valid: mutable bool = false
                    index_matches: mutable usize = 0
                    index_valid: mutable bool = false
                    for parameter in parameters |array_name, bound_symbol, report, array_matches, array_valid, index_matches, index_valid|:
                        if parameter.name == array_name:
                            array_matches <- array_matches + 1
                            array_valid <- not parameter.is_mutable and proof_replay_type_bound_readonly_dynamic_array_type(parameter.type_expression, 0)
                        if parameter.name == bound_symbol:
                            index_matches <- index_matches + 1
                            index_valid <- not parameter.is_mutable and proof_unsigned_type_width(parameter.type_expression, report.source_declarations, 0) > 0
                    return false if array_matches != 1 or not array_valid or index_matches != 1 or not index_valid
                    return proof_replay_type_bound_dynamic_array_source_body_shape(body, array_name, bound_symbol, line)
                _:
                    return false
