# Authenticate a local-result equality against one immutable scalar declaration and its exact call.
extend ElisaProof:
    private:
        def proof_replay_call_result_binding_expr_borrows(expression: Ast::Expr, name: sview, source_work: mutable usize&, depth: usize) -> bool:
            return true if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(operator, inner, _):
                    if operator == TokenKind.Ampersand:
                        return true if:
                            not proof_replay_summary_expr_charge_with_work(inner, source_work)
                            proof_expr_mentions_name(inner, name)
                    return proof_replay_call_result_binding_expr_borrows(inner, name, source_work, depth + 1)
                Ast::Expr.Move(inner, _):
                    return true if:
                        not proof_replay_summary_expr_charge_with_work(inner, source_work)
                        proof_expr_mentions_name(inner, name)
                Ast::Expr.Call(callee, arguments, _, _):
                    match callee:
                        Ast::Expr.Field(receiver, _, _):
                            return true if:
                                not proof_replay_summary_expr_charge_with_work(receiver, source_work)
                                proof_expr_mentions_name(receiver, name)
                        _:
                            pass
                    return true if proof_replay_call_result_binding_expr_borrows(callee, name, source_work, depth + 1)
                    for argument in arguments |name, source_work, depth|:
                        return true if proof_replay_call_result_binding_expr_borrows(argument, name, source_work, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, _, _):
                    for candidate in candidates |name, source_work, depth|:
                        for capture in candidate.captures |name, source_work, depth|:
                            return true if proof_replay_call_result_binding_expr_borrows(capture, name, source_work, depth + 1)
                    for argument in arguments |name, source_work, depth|:
                        return true if proof_replay_call_result_binding_expr_borrows(argument, name, source_work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_replay_call_result_binding_expr_borrows(inner, name, source_work, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_replay_call_result_binding_expr_borrows(left, name, source_work, depth + 1) or proof_replay_call_result_binding_expr_borrows(right, name, source_work, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                    return proof_replay_call_result_binding_expr_borrows(object, name, source_work, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_replay_call_result_binding_expr_borrows(object, name, source_work, depth + 1) or proof_replay_call_result_binding_expr_borrows(index, name, source_work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_replay_call_result_binding_expr_borrows(object, name, source_work, depth + 1) or proof_replay_call_result_binding_expr_borrows(low, name, source_work, depth + 1) or proof_replay_call_result_binding_expr_borrows(high, name, source_work, depth + 1)
                Ast::Expr.IndexN(object, elements, _):
                    return true if proof_replay_call_result_binding_expr_borrows(object, name, source_work, depth + 1)
                    for element in elements |name, source_work, depth|:
                        return true if proof_replay_call_result_binding_expr_borrows(element, name, source_work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |name, source_work, depth|:
                        return true if proof_replay_call_result_binding_expr_borrows(element, name, source_work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |name, source_work, depth|:
                        return true if proof_replay_call_result_binding_expr_borrows(entry.key, name, source_work, depth + 1) or proof_replay_call_result_binding_expr_borrows(entry.value, name, source_work, depth + 1)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_replay_call_result_binding_expr_borrows(base, name, source_work, depth + 1)
                    for field in fields |name, source_work, depth|:
                        return true if proof_replay_call_result_binding_expr_borrows(field.value, name, source_work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return proof_replay_call_result_binding_expr_borrows(condition, name, source_work, depth + 1) or proof_replay_call_result_binding_expr_borrows(yes, name, source_work, depth + 1) or proof_replay_call_result_binding_expr_borrows(no, name, source_work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_replay_call_result_binding_expr_borrows(base, name, source_work, depth + 1) or proof_replay_call_result_binding_expr_borrows(predicate, name, source_work, depth + 1)
                Ast::Expr.Match(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _):
                    return true if:
                        not proof_replay_summary_expr_charge_with_work(expression, source_work)
                        proof_expr_mentions_name(expression, name)
                _:
                    pass
            return false

        def proof_replay_call_result_binding_scan_statements(body: darray[Ast::Stmt]&, name: sview, binding_position: Ast::Pos, binding_count: mutable usize&, binding_end_offset: mutable u32&, source_type: mutable Ast::Expr&, source_initializer: mutable Ast::Expr&, invalid: mutable bool&, source_work: mutable usize&, lexical_depth: usize, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for statement in body |name, binding_position, binding_count, binding_end_offset, source_type, source_initializer, invalid, source_work, lexical_depth, depth|:
                match statement:
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                        if local_name == name:
                            binding_count <- binding_count + 1
                            if lexical_depth == 0 and proof_replay_source_position_equal(position, binding_position):
                                extent: ProofReplayTypeBoundSourceExtent = proof_replay_type_bound_stmt_extent(statement, 0)
                                return false if not extent.offsets_complete or extent.end_offset <= position.offset
                                binding_end_offset <- extent.end_offset
                                source_type <- type_expression
                                source_initializer <- initializer
                            else:
                                invalid <- true
                        invalid <- true if proof_replay_call_result_binding_expr_borrows(initializer, name, source_work, 0)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if not proof_replay_summary_expr_charge_with_work(target, source_work)
                        invalid <- true if proof_expr_mentions_name(target, name)
                        invalid <- true if proof_replay_call_result_binding_expr_borrows(target, name, source_work, 0) or proof_replay_call_result_binding_expr_borrows(value, name, source_work, 0)
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        invalid <- true if proof_replay_call_result_binding_expr_borrows(expression, name, source_work, 0)
                    Ast::Stmt.If(condition, yes, no, _):
                        invalid <- true if proof_replay_call_result_binding_expr_borrows(condition, name, source_work, 0)
                        return false if:
                            not proof_replay_call_result_binding_scan_statements(yes, name, binding_position, binding_count, binding_end_offset, source_type, source_initializer, invalid, source_work, lexical_depth + 1, depth + 1)
                            not proof_replay_call_result_binding_scan_statements(no, name, binding_position, binding_count, binding_end_offset, source_type, source_initializer, invalid, source_work, lexical_depth + 1, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        invalid <- true if proof_replay_call_result_binding_expr_borrows(condition, name, source_work, 0)
                        return false if not proof_replay_call_result_binding_scan_statements(nested, name, binding_position, binding_count, binding_end_offset, source_type, source_initializer, invalid, source_work, lexical_depth + 1, depth + 1)
                    Ast::Stmt.For(bind, variables, iterable, nested, _):
                        invalid <- true if bind == name or any variable in variables where variable == name
                        invalid <- true if proof_replay_call_result_binding_expr_borrows(iterable, name, source_work, 0)
                        return false if not proof_replay_call_result_binding_scan_statements(nested, name, binding_position, binding_count, binding_end_offset, source_type, source_initializer, invalid, source_work, lexical_depth + 1, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        invalid <- true if proof_replay_call_result_binding_expr_borrows(scrutinee, name, source_work, 0)
                        for arm in arms |arm, name, binding_position, binding_count, source_type, source_initializer, invalid, lexical_depth, depth|:
                            pattern_names: mutable darray[sview] = []
                            return false if not proof_replay_call_pattern_bindings(arm.pattern, &pattern_names, depth + 1)
                            invalid <- true if any pattern_name in pattern_names where pattern_name == name
                            invalid <- true if proof_replay_call_result_binding_expr_borrows(arm.guard, name, source_work, 0)
                            return false if not proof_replay_call_result_binding_scan_statements(arm.body, name, binding_position, binding_count, binding_end_offset, source_type, source_initializer, invalid, source_work, lexical_depth + 1, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_call_result_binding_scan_statements(nested, name, binding_position, binding_count, binding_end_offset, source_type, source_initializer, invalid, source_work, lexical_depth + 1, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            return true

        def proof_replay_call_result_binding_owner(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, local_name: sview, binding_position: Ast::Pos, binding_end_offset: mutable u32&, source_type: mutable Ast::Expr&, source_initializer: mutable Ast::Expr&, binding_count: mutable usize&, owner_count: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for declaration in declarations |owner, owner_line, local_name, binding_position, binding_end_offset, source_type, source_initializer, binding_count, owner_count, source_work, depth|:
                match declaration:
                    Ast::Decl.Func(candidate, _, _, body, _, _, position):
                        if candidate == owner and position.line == owner_line:
                            owner_count <- owner_count + 1
                            invalid: mutable bool = false
                            # Reserve one full-tree pass for the structural cost walk and a
                            # second for the borrow/shadow scan, including deferred captures.
                            return false if:
                                not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
                                not proof_replay_mutable_local_body_work_charge(body, source_work, 0)
                                not proof_replay_call_result_binding_scan_statements(body, local_name, binding_position, binding_count, binding_end_offset, source_type, source_initializer, invalid, source_work, 0, 0)
                                invalid
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_call_result_binding_owner(nested, owner, owner_line, local_name, binding_position, binding_end_offset, source_type, source_initializer, binding_count, owner_count, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_call_result_binding_signature(declarations: darray[Ast::Decl]&, declaration_index: ProofReplayDeterministicDeclarationIndex&, name: sview, owner_scope: darray[sview]&, current_scope: darray[sview]&, argument_count: usize, result_type: Ast::Expr, matches: mutable usize&, source_work: mutable usize&, depth: usize) -> bool:
            return false if:
                depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                declarations.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + declarations.count
            for declaration in declarations |name, owner_scope, current_scope, argument_count, result_type, matches, source_work, depth|:
                match declaration:
                    Ast::Decl.Func(candidate, parameters, return_type, _, _, _, _):
                        return false if sview_len(candidate) > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                        source_work <- source_work + sview_len(candidate)
                        same_name: (equal: bool, complete: bool) = proof_replay_global_constant_text_equal_with_work(candidate, name, source_work)
                        return false if not same_name.complete
                        if same_name.equal:
                            same_scope: (equal: bool, complete: bool) = proof_replay_global_constant_scope_equal_with_work(current_scope, owner_scope, source_work)
                            return false if not same_scope.complete
                            continue if not same_scope.equal
                            matches <- matches + 1
                            return false if parameters.count != argument_count or not proof_replay_summary_expr_charge_with_work(return_type, source_work) or not proof_replay_summary_expr_equal_with_work(return_type, result_type, source_work)
                            for parameter in parameters:
                                return false if:
                                    not proof_replay_summary_expr_charge_with_work(parameter.type_expression, source_work)
                                    parameter.is_mutable or parameter.has_default or proof_replay_deterministic_parameter_type(parameter.type_expression, 0) or not proof_replay_deterministic_scalar_type_indexed(parameter.type_expression, declaration_index, source_work, 0)
                    Ast::Decl.Module(module_name, nested, _):
                        next_scope: (complete: bool, scope: darray[sview]) = proof_replay_global_constant_scope_with_module_and_work(current_scope, module_name, source_work)
                        return false if not next_scope.complete
                        return false if not proof_replay_call_result_binding_signature(nested, declaration_index, name, owner_scope, next_scope.scope, argument_count, result_type, matches, source_work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_replay_call_result_binding_signature(nested, declaration_index, name, owner_scope, current_scope, argument_count, result_type, matches, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_replay_call_result_binding_valid(report: mutable ProofReport&, trace: ProofFactTrace) -> bool:
            source_work: mutable usize = 0
            owner_line: mutable u32 = report.analysis_2.replay_owner_line
            owner_line <- 0 if owner_line == 4294967295
            return false if not proof_replay_summary_owner_source_preflight(report, trace.name, owner_line, source_work)
            return proof_replay_call_result_binding_valid_with_work(report, trace, source_work)

        def proof_replay_call_result_binding_valid_with_work(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&) -> bool:
            cache: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            return proof_replay_call_result_binding_valid_with_cache(report, trace, source_work, &cache)

        def proof_replay_call_result_binding_valid_with_cache(report: mutable ProofReport&, trace: ProofFactTrace, source_work: mutable usize&, cache: mutable ProofReplayDeterministicCallReplayCache&) -> bool:
            return false if:
                not proof_replay_summary_expr_charge_with_work(trace.expression, source_work)
                report.analysis_2.trace_owner_line <= trace.line or report.analysis_2.replay_owner_line == 0 or report.analysis_2.replay_owner_line == 4294967295
                trace.line == 0 or proof_replay_summary_has_unresolved_import(report.source.source_annotations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                proof_replay_summary_has_unresolved_declaration_import(report.source.source_declarations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, 0)
            match trace.expression:
                Ast::Expr.Binary(Ast::Expr.Ident(local_name, local_position), TokenKind.EqEq, source_call, binding_position):
                    return false if:
                        local_name == "" or not proof_replay_source_position_equal(local_position, binding_position)
                        binding_position.line != trace.line or not proof_replay_is_call(source_call)
                    match source_call:
                        Ast::Expr.Call(Ast::Expr.Ident(callee_name, _), arguments, _, _):
                            return false if callee_name == "" or proof_name_is_reserved_internal(callee_name)
                            for argument in arguments |argument, source_work|:
                                return false if:
                                    not proof_replay_summary_expr_repeat_charge_with_work(argument, 1, source_work)
                                    proof_replay_expression_contains_call_node(argument, 0)
                            owner_scope: mutable darray[sview] = []
                            owner_module_count: mutable usize = 0
                            root_scope: darray[sview] = []
                            exact_owner: bool = report.analysis_2.replay_owner_offset_valid
                            proof_replay_summary_call_owner_scope(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, exact_owner, root_scope, &owner_scope, &owner_module_count, source_work, 0)
                            return false if owner_module_count != 1 or not proof_replay_summary_scope_work_charge(owner_scope, source_work)
                            binding_count: mutable usize = 0
                            owner_count: mutable usize = 0
                            binding_end_offset: mutable u32 = 0
                            source_type: mutable Ast::Expr = Ast::Expr.Invalid
                            source_initializer: mutable Ast::Expr = Ast::Expr.Invalid
                            return false if:
                                not proof_replay_call_result_binding_owner(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, local_name, binding_position, &binding_end_offset, &source_type, &source_initializer, &binding_count, &owner_count, source_work, 0)
                                owner_count != 1 or binding_count != 1
                                binding_end_offset == 0
                            owner_body: mutable darray[Ast::Stmt] = []
                            parameter_shadowed: bool = proof_replay_local_binding_parameter_name_present_at_offset_with_work(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, report.analysis_2.replay_owner_offset, true, callee_name, source_work, PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT, 0) if exact_owner else proof_replay_local_binding_parameter_name_present_with_default_limit(report.source.source_declarations, trace.name, report.analysis_2.replay_owner_line, callee_name, source_work, 0)
                            return false if:
                                not proof_replay_source_owner_body_with_work(report, trace.name, report.analysis_2.replay_owner_line, &owner_body, source_work, PROOF_REPLAY_DETERMINISTIC_CALL_SOURCE_WORK_LIMIT)
                                parameter_shadowed
                                not proof_replay_source_call_locals_unshadowed_at_with_work(owner_body, report.source.source_annotations, source_call, source_work)
                            consumer_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
                            return false if:
                                not proof_replay_mutable_local_consumer_position_with_work(report, trace, owner_body, &consumer_position, source_work)
                                consumer_position.offset == 0 or consumer_position.end_offset <= consumer_position.offset or binding_end_offset > consumer_position.offset
                                not proof_replay_deterministic_call_declaration_index_ensure(report.source.source_declarations, report.source.source_annotations, source_work, cache)
                                not proof_replay_deterministic_scalar_type_indexed(source_type, cache.declaration_index, source_work, 0) or proof_replay_deterministic_parameter_type(source_type, 0)
                            match source_initializer:
                                Ast::Expr.Call(Ast::Expr.Ident(source_callee, _), source_arguments, source_names, _):
                                    return false if:
                                        not proof_replay_mutable_local_text_compare_work_charge(source_callee, callee_name, source_work)
                                        source_callee != callee_name or source_arguments.count != arguments.count
                                        source_names.count != 0 and source_names.count != source_arguments.count
                                    for argument_name in source_names |argument_name, source_work|:
                                        return false if:
                                            not proof_replay_mutable_local_text_compare_work_charge(argument_name, "", source_work)
                                            argument_name != ""
                                    complete: mutable bool = true
                                    return false if:
                                        not proof_replay_deterministic_call_expression_equal_with_work(source_initializer, source_call, source_work, &complete, 0) or not complete
                                        not proof_replay_deterministic_call_source_site_with_cache(report, trace, source_initializer, source_work, cache)
                                        not proof_replay_deterministic_call_declaration_index_ensure(report.source.source_declarations, report.source.source_annotations, source_work, cache)
                                    same_module_count: mutable usize = 0
                                    return false if not proof_replay_same_module_name_count_at_scope(report.source.source_declarations, callee_name, owner_scope, root_scope, &same_module_count, source_work, 0) or same_module_count != 1
                                    signature_count: mutable usize = 0
                                    return false if not proof_replay_call_result_binding_signature(report.source.source_declarations, cache.declaration_index, callee_name, owner_scope, root_scope, source_arguments.count, source_type, &signature_count, source_work, 0) or signature_count != 1
                                    return true
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false
