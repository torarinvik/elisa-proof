extend ElisaProof:
    private:
        # Independently classify the resource-root scalar subset instead of reusing the
        # producer helper. Exhaustion and excessive depth are unknown, never borrowable proof.
        def proof_replay_resource_scalar_type_with_work(expression: Ast::Expr, report: ProofReport&, source_work: mutable usize&, depth: usize) -> (complete: bool, scalar: bool):
            return (false, false) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            return (false, false) if not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, false) if not proof_replay_owner_work_charge(sview_len(name), source_work)
                    primitive: bool = name in {"i8", "i16", "i32", "i64", "isize", "int", "u8", "u16", "u32", "u64", "usize", "uintptr", "bool", "char", "f32", "f64"}
                    return (true, false) if not primitive
                    return (false, false) if:
                        not proof_replay_scalar_copy_type_unshadowed(report.source.source_declarations, name, 0, source_work)
                        proof_replay_summary_has_unresolved_import(report.source.source_annotations, source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                    return (true, true)
                Ast::Expr.Paren(inner, _):
                    proof_replay_resource_scalar_type_with_work(inner, report, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return (true, false) if operator != TokenKind.Mutable
                    proof_replay_resource_scalar_type_with_work(inner, report, source_work, depth + 1)
                _:
                    (true, false)

        def proof_replay_resource_owner_module_path_with_work(report: ProofReport&, owner: sview, owner_line: u32, owner_offset: usize, source_work: mutable usize&) -> (complete: bool, path: darray[sview]):
            root_path: darray[sview] = []
            path: mutable darray[sview] = []
            matches: mutable usize = 0
            return (false, []) if not proof_replay_thread_function_module_path_find(report.source.source_declarations, owner, owner_line, owner_offset, root_path, &path, &matches, source_work, 0)
            return (false, []) if matches != 1
            (true, path)

        def proof_replay_resource_owner_module_path_at_offset_with_work(report: ProofReport&, owner_line: u32, owner_offset: usize, source_work: mutable usize&) -> (complete: bool, path: darray[sview]):
            root_path: darray[sview] = []
            path: mutable darray[sview] = []
            matches: mutable usize = 0
            return (false, []) if not proof_replay_thread_function_module_path_find(report.source.source_declarations, "", owner_line, owner_offset, root_path, &path, &matches, source_work, 0)
            return (false, []) if matches != 1
            (true, path)

        def proof_replay_resource_sview_type_with_work(expression: Ast::Expr, report: ProofReport&, owner_path: darray[sview]&, source_work: mutable usize&, depth: usize) -> (complete: bool, sview_type: bool):
            return (false, false) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            return (false, false) if not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, false) if not proof_replay_owner_work_charge(sview_len(name), source_work)
                    return (false, false) if not proof_replay_thread_import_shadow_check(report, name, owner_path, source_work)
                    declaration: (complete: bool, count: usize, kind: sview, target: Ast::Expr, nested_scope: bool, has_formals: bool) = proof_replay_thread_marker_type_declaration(report, name, source_work, 0)
                    return (false, false) if not declaration.complete or declaration.nested_scope or declaration.count > 1
                    if name == "sview":
                        return (false, false) if declaration.count != 0
                        return (true, true)
                    return (false, false) if declaration.count == 0 and name in {"view", "darray", "array", "set"}
                    if declaration.count == 0:
                        return (true, false)
                    return (false, false) if declaration.kind != "alias" or declaration.has_formals
                    proof_replay_resource_sview_type_with_work(declaration.target, report, owner_path, source_work, depth + 1)
                Ast::Expr.Scope(_, _, _):
                    (false, false)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    proof_replay_resource_sview_type_with_work(inner, report, owner_path, source_work, depth + 1)
                _:
                    (true, false)

        def proof_replay_resource_exact_sview_syntax_with_work(expression: Ast::Expr, source_work: mutable usize&, depth: usize) -> (complete: bool, exact: bool):
            return (false, false) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, source_work)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, false) if not proof_replay_owner_work_charge(sview_len(name), source_work)
                    (true, name == "sview")
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    proof_replay_resource_exact_sview_syntax_with_work(inner, source_work, depth + 1)
                _:
                    (true, false)

        def proof_replay_resource_call_return_view_is_confined_with_work(report: ProofReport&, return_type: Ast::Expr?, callee_line: u32, callee_offset: u32, source_work: mutable usize&) -> bool:
            if return_type is declared_return_type:
                markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(declared_return_type, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, callee_line, callee_offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, source_work)
                return false if not markers.complete
                return true if markers.reference
                owner_path: (complete: bool, path: darray[sview]) = proof_replay_resource_owner_module_path_at_offset_with_work(report, callee_line, callee_offset.usize(), source_work)
                return false if not owner_path.complete
                exact_sview: (complete: bool, exact: bool) = proof_replay_resource_exact_sview_syntax_with_work(declared_return_type, source_work, 0)
                return false if not exact_sview.complete
                sview_return: (complete: bool, sview_type: bool) = proof_replay_resource_sview_type_with_work(declared_return_type, report, owner_path.path, source_work, 0)
                return false if not sview_return.complete
                return false if exact_sview.exact and not sview_return.sview_type
                return true if exact_sview.exact and sview_return.sview_type
                borrowed: (complete: bool, borrowed: bool) = proof_replay_thread_type_contains_borrowed_storage(declared_return_type, report, owner_path.path, source_work, 0)
                return false if not borrowed.complete or source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return not borrowed.borrowed
            true
