# Const-enum type-path and member-value reconstruction for independent replay.
extend ElisaProof:
    private:
        def proof_replay_const_enum_negated_equality(expression: Ast::Expr) -> (known: bool, subject: Ast::Expr, enum_type: Ast::Expr, variant: sview):
            no_expression: Ast::Expr = Ast::Expr.Invalid
            match expression:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Binary(subject, TokenKind.EqEq, Ast::Expr.Field(enum_type, variant, _), _):
                            return (true, subject, enum_type, variant)
                        _:
                            pass
                _:
                    pass
            return (false, no_expression, no_expression, "")

        def proof_replay_count_named_aggregates_with_work(declarations: darray[Ast::Decl]&, name: sview, depth: usize, source_work: mutable usize&) -> (enums: usize, const_enums: usize, structs: usize):
            return (2, 2, 2) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            enums: mutable usize = 0
            const_enums: mutable usize = 0
            structs: mutable usize = 0
            for declaration in declarations |name, depth, enums, const_enums, structs, source_work|:
                return (2, 2, 2) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match declaration:
                    Ast::Decl.Enum(enum_name, _, is_const, _, _):
                        return (2, 2, 2) if not proof_replay_variant_text_compare_charge_with_work(name, enum_name, source_work)
                        if enum_name == name:
                            if is_const:
                                const_enums <- const_enums + 1
                            else:
                                enums <- enums + 1
                    Ast::Decl.Struct(struct_name, _, _, _, _, _, _):
                        return (2, 2, 2) if not proof_replay_variant_text_compare_charge_with_work(name, struct_name, source_work)
                        structs <- structs + 1 if struct_name == name
                    Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                        nested: (enums: usize, const_enums: usize, structs: usize) = proof_replay_count_named_aggregates_with_work(body, name, depth + 1, source_work)
                        return (2, 2, 2) if nested.enums > 1 or nested.const_enums > 1 or nested.structs > 1
                        enums <- enums + nested.enums
                        const_enums <- const_enums + nested.const_enums
                        structs <- structs + nested.structs
                    Ast::Decl.Invalid:
                        return (2, 2, 2)
                    _:
                        pass
            return (enums, const_enums, structs)

        def proof_replay_enum_type_path_with_work(expression: Ast::Expr, path: mutable darray[sview]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if name == "" or not proof_replay_variant_text_compare_charge_with_work(name, name, source_work)
                    path.push(name)
                    return true
                Ast::Expr.Scope(base, name, _):
                    return false if name == "" or not proof_replay_variant_text_compare_charge_with_work(name, name, source_work) or not proof_replay_enum_type_path_with_work(base, path, source_work, depth + 1)
                    path.push(name)
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_enum_type_path_with_work(inner, path, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_enum_type_path_with_work(inner, path, source_work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                _:
                    return false
            return false

        def proof_replay_enum_module_scope_with_work(current: darray[sview]&, module_name: sview, source_work: mutable usize&) -> (complete: bool, scope: darray[sview]):
            module_length: usize = sview_len(module_name)
            return (false, []) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or module_length > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + module_length
            return (false, []) if current.count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
            source_work <- source_work + current.count + 1
            return (true, proof_replay_global_constant_scope_with_module(current, module_name))

        def proof_replay_unique_enum_path_with_work(declarations: darray[Ast::Decl]&, name: sview, current: darray[sview]&, path: mutable darray[sview]&, matches: mutable usize&, depth: usize, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            for declaration in declarations |name, current, path, matches, depth, source_work|:
                return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match declaration:
                    Ast::Decl.Enum(enum_name, _, _, _, _):
                        return false if not proof_replay_variant_text_compare_charge_with_work(name, enum_name, source_work)
                        if enum_name == name:
                            matches <- matches + 1
                            if matches == 1:
                                return false if current.count + 1 > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - source_work
                                source_work <- source_work + current.count + 1
                                path.extend(current)
                                path.push(enum_name)
                    Ast::Decl.Module(module_name, body, _):
                        nested_scope: (complete: bool, scope: darray[sview]) = proof_replay_enum_module_scope_with_work(current, module_name, source_work)
                        return false if not nested_scope.complete
                        return false if not proof_replay_unique_enum_path_with_work(body, name, nested_scope.scope, path, matches, depth + 1, source_work)
                    Ast::Decl.Scoped(body, _):
                        return false if not proof_replay_unique_enum_path_with_work(body, name, current, path, matches, depth + 1, source_work)
                    Ast::Decl.Invalid:
                        return false
                    _:
                        pass
            return true

        # Resolve the spelling used by an enum fact to the unique declaration path. The
        # producer follows a unique unqualified alias before emitting `Alias.Member`; replay
        # follows the same alias chain, then validates the concrete enum's lexical path.
        def proof_replay_resolve_enum_type_path_with_work(expression: Ast::Expr, declarations: darray[Ast::Decl]&, path: mutable darray[sview]&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            source_work <- source_work + 1
            match expression:
                Ast::Expr.Ident(name, _):
                    return false if name == "" or proof_scalar_primitive_type_name(name)
                    alias_target: mutable Ast::Expr = Ast::Expr.Absent
                    alias_count: mutable usize = 0
                    return false if not proof_replay_variant_type_alias_with_work(declarations, name, &alias_target, &alias_count, source_work, 0)
                    return false if alias_count > 1
                    if alias_count == 1:
                        aggregates: (enums: usize, const_enums: usize, structs: usize) = proof_replay_count_named_aggregates_with_work(declarations, name, 0, source_work)
                        return false if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or aggregates.enums != 0 or aggregates.const_enums != 0 or aggregates.structs != 0
                        return proof_replay_resolve_enum_type_path_with_work(alias_target, declarations, path, source_work, depth + 1)
                    matches: mutable usize = 0
                    current: darray[sview] = []
                    return false if not proof_replay_unique_enum_path_with_work(declarations, name, current, path, &matches, 0, source_work)
                    return matches == 1
                Ast::Expr.Scope(_, name, _):
                    return false if name == "" or proof_scalar_primitive_type_name(name)
                    # A qualified type is resolved by its complete declaration path below.
                    # A same-leaf alias in another module must not capture `A::E`.
                    return proof_replay_enum_type_path_with_work(expression, &path, source_work, 0)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Refinement(inner, _, _):
                    return proof_replay_resolve_enum_type_path_with_work(inner, declarations, path, source_work, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_replay_resolve_enum_type_path_with_work(inner, declarations, path, source_work, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut or operator == TokenKind.Static or operator == TokenKind.Heap or operator == TokenKind.Stack or operator == TokenKind.Tail
                    return false
                _:
                    return false

        def proof_replay_enum_scope_matches(current: darray[sview]&, target: darray[sview]&, source_work: mutable usize&) -> bool:
            return false if current.count + 1 != target.count or target.count == 0
            for index in 0..<current.count |index, current, target, source_work|:
                return false if not proof_replay_variant_text_compare_charge_with_work(current[index], target[index], source_work)
                return false if current[index] != target[index]
            return true

        def proof_replay_const_enum_member_value_at_path(declarations: darray[Ast::Decl]&, target: darray[sview]&, current: darray[sview]&, member_name: sview, depth: usize, source_work: mutable usize&) -> (enums: usize, const_enums: usize, members: usize, known: bool, value: i64):
            return (2, 2, 2, false, 0) if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT
            return (2, 2, 2, false, 0) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            enums: mutable usize = 0
            const_enums: mutable usize = 0
            members: mutable usize = 0
            known: mutable bool = false
            value: mutable i64 = 0
            for declaration in declarations |target, current, member_name, depth, enums, const_enums, members, known, value, source_work|:
                return (2, 2, 2, false, 0) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                source_work <- source_work + 1
                match declaration:
                    Ast::Decl.Module(module_name, body, _):
                        nested_scope: (complete: bool, scope: darray[sview]) = proof_replay_enum_module_scope_with_work(current, module_name, source_work)
                        return (2, 2, 2, false, 0) if not nested_scope.complete
                        nested: (enums: usize, const_enums: usize, members: usize, known: bool, value: i64) = proof_replay_const_enum_member_value_at_path(body, target, nested_scope.scope, member_name, depth + 1, source_work)
                        enums <- enums + nested.enums
                        const_enums <- const_enums + nested.const_enums
                        members <- members + nested.members
                        if nested.known:
                            known <- true
                            value <- nested.value
                    Ast::Decl.Scoped(body, _):
                        nested: (enums: usize, const_enums: usize, members: usize, known: bool, value: i64) = proof_replay_const_enum_member_value_at_path(body, target, current, member_name, depth + 1, source_work)
                        enums <- enums + nested.enums
                        const_enums <- const_enums + nested.const_enums
                        members <- members + nested.members
                        if nested.known:
                            known <- true
                            value <- nested.value
                    Ast::Decl.Enum(enum_name, variants, is_const, _, _):
                        scope_matches: bool = proof_replay_enum_scope_matches(current, target, source_work)
                        return (2, 2, 2, false, 0) if source_work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        if scope_matches:
                            return (2, 2, 2, false, 0) if not proof_replay_variant_text_compare_charge_with_work(target[target.count - 1], enum_name, source_work)
                        if scope_matches and target[target.count - 1] == enum_name:
                            enums <- enums + 1
                            const_enums <- const_enums + 1 if is_const
                            for variant in variants |member_name, is_const, members, known, value, source_work|:
                                return (2, 2, 2, false, 0) if not proof_replay_variant_text_compare_charge_with_work(variant.name, member_name, source_work)
                                if variant.name == member_name and variant.fields.count == 0:
                                    members <- members + 1
                                    if is_const:
                                        match variant.value_expr:
                                            Ast::Expr.IntLit(tag, _):
                                                known <- true
                                                value <- tag
                                            _:
                                                pass
                    _:
                        pass
            return (enums, const_enums, members, known, value)
