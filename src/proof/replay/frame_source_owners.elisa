# Exact declaration lookup for frame replay. Exhausting either traversal budget
# invalidates the whole lookup, including a match found before exhaustion.
extend ElisaProofFrameSource:
    private:
        def owner_at(declarations: darray[Ast::Decl]&, owner: sview, owner_line: u32, depth: usize, remaining: mutable usize&, matches: mutable usize&, formals: mutable darray[sview]&, body: mutable darray[Ast::Stmt]&, owner_position: mutable Ast::Pos&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= 64
            for declaration in declarations |owner, owner_line, depth, remaining, matches, formals, body, owner_position|:
                return false if remaining == 0
                remaining <- remaining - 1
                match declaration:
                    Ast::Decl.Func(name, parameters, _, statements, _, _, position):
                        if name == owner and position.line == owner_line:
                            return false if matches != 0 or parameters.count > 64
                            matches <- matches + 1
                            owner_position <- position
                            for parameter in parameters |formals|:
                                return false if parameter.name == ""
                                for prior in formals |parameter|:
                                    return false if prior == parameter.name
                                formals.push(parameter.name)
                            body.extend(statements)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not owner_at(nested, owner, owner_line, depth + 1, remaining, matches, formals, body, owner_position)
                    _:
                        pass
            return true

    public:
        # The source AST must belong to the certificate's independently checked
        # source identity. This lookup does not authenticate a source file itself.
        def owner(declarations: darray[Ast::Decl]&, name: sview, line: u32) -> (known: bool, formals: darray[sview], body: darray[Ast::Stmt], position: Ast::Pos) can[Memory.Allocate, Abort.Panic]:
            formals: mutable darray[sview] = []
            body: mutable darray[Ast::Stmt] = []
            owner_position: mutable Ast::Pos = Ast::pos_at_line(0)
            remaining: mutable usize = 4096
            matches: mutable usize = 0
            complete = name != "" and line != 0 and owner_at(declarations, name, line, 0, &remaining, &matches, &formals, &body, &owner_position)
            if not complete or matches != 1:
                return (false, [], [], Ast::pos_at_line(0))
            return (true, formals, body, owner_position)
