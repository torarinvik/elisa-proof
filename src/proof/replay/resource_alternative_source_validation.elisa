extend ElisaProof:
    private:
        const PROOF_REPLAY_RESOURCE_ALTERNATIVE_DEPTH_LIMIT: usize = 127

        def proof_replay_resource_alt_expr_has_offset(expression: Ast::Expr, wanted: usize, work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            return false if not proof_replay_owner_work_charge(1, work)
            expression_position: Ast::Pos = Ast::expr_pos(expression)
            return true if expression_position.line > 0 and expression_position.offset == wanted.u32()
            match expression:
                Ast::Expr.Invalid:
                    work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                    return false
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_replay_resource_alt_expr_has_offset(callee, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    for argument in arguments |argument, wanted, work, depth|:
                        return true if proof_replay_resource_alt_expr_has_offset(argument, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                Ast::Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                    return true if proof_replay_resource_alt_expr_has_offset(effect_type, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    for candidate in candidates |candidate, wanted, work, depth|:
                        return false if not proof_replay_owner_work_charge(1, work)
                        for capture in candidate.captures |capture, wanted, work, depth|:
                            return true if proof_replay_resource_alt_expr_has_offset(capture, wanted, work, depth + 1)
                            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    for argument in arguments |argument, wanted, work, depth|:
                        return true if proof_replay_resource_alt_expr_has_offset(argument, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Paren(object, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _):
                    return proof_replay_resource_alt_expr_has_offset(object, wanted, work, depth + 1)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _):
                    return true if proof_replay_resource_alt_expr_has_offset(object, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_replay_resource_alt_expr_has_offset(index, wanted, work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_replay_resource_alt_expr_has_offset(object, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    for argument in arguments |argument, wanted, work, depth|:
                        return true if proof_replay_resource_alt_expr_has_offset(argument, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                Ast::Expr.Slice(object, low, high, _):
                    return true if proof_replay_resource_alt_expr_has_offset(object, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return true if proof_replay_resource_alt_expr_has_offset(low, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_replay_resource_alt_expr_has_offset(high, wanted, work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |element, wanted, work, depth|:
                        return true if proof_replay_resource_alt_expr_has_offset(element, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, wanted, work, depth|:
                        return true if proof_replay_resource_alt_expr_has_offset(entry.key, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return true if proof_replay_resource_alt_expr_has_offset(entry.value, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_replay_resource_alt_expr_has_offset(base, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    for field in fields |field, wanted, work, depth|:
                        return true if proof_replay_resource_alt_expr_has_offset(field.value, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                Ast::Expr.Refinement(base, predicate, _):
                    return true if proof_replay_resource_alt_expr_has_offset(base, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_replay_resource_alt_expr_has_offset(predicate, wanted, work, depth + 1)
                Ast::Expr.If(condition, yes, no, _):
                    return true if proof_replay_resource_alt_expr_has_offset(condition, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return true if proof_replay_resource_alt_expr_has_offset(yes, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_replay_resource_alt_expr_has_offset(no, wanted, work, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return true if proof_replay_resource_alt_expr_has_offset(iterable, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return true if proof_replay_resource_alt_expr_has_offset(condition, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_replay_resource_alt_expr_has_offset(body, wanted, work, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _) | Ast::Expr.Catch(scrutinee, arms, _):
                    return true if proof_replay_resource_alt_expr_has_offset(scrutinee, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    for arm in arms |arm, wanted, work, depth|:
                        return true if proof_replay_resource_alt_expr_has_offset(arm.guard, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return true if proof_replay_resource_alt_statements_has_offset(arm.body, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                Ast::Expr.GetElse(guarded, recovery, _):
                    return true if proof_replay_resource_alt_expr_has_offset(guarded, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_replay_resource_alt_statements_has_offset(recovery, wanted, work, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    return proof_replay_resource_alt_statements_has_offset(body, wanted, work, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return true if proof_replay_resource_alt_statements_has_offset(statements, wanted, work, depth + 1)
                    return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    return proof_replay_resource_alt_expr_has_offset(value, wanted, work, depth + 1)
            false

        def proof_replay_resource_alt_statements_has_offset(body: darray[Ast::Stmt]&, wanted: usize, work: mutable usize&, depth: usize) -> bool:
            if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            for statement in body |statement, wanted, work, depth|:
                return false if not proof_replay_owner_work_charge(1, work)
                statement_position: Ast::Pos = Ast::stmt_pos(statement)
                return true if statement_position.line > 0 and statement_position.offset == wanted.u32()
                match statement:
                    Ast::Stmt.Invalid:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return false
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return true if proof_replay_resource_alt_expr_has_offset(expression, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    Ast::Stmt.VarDecl(_, type_expression, initializer, _):
                        return true if proof_replay_resource_alt_expr_has_offset(type_expression, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return true if proof_replay_resource_alt_expr_has_offset(initializer, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    Ast::Stmt.Assign(target, _, value, _):
                        return true if proof_replay_resource_alt_expr_has_offset(target, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return true if proof_replay_resource_alt_expr_has_offset(value, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    Ast::Stmt.If(condition, yes, no, _):
                        return true if proof_replay_resource_alt_expr_has_offset(condition, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return true if proof_replay_resource_alt_statements_has_offset(yes, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return true if proof_replay_resource_alt_statements_has_offset(no, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    Ast::Stmt.While(condition, nested, _):
                        return true if proof_replay_resource_alt_expr_has_offset(condition, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return proof_replay_resource_alt_statements_has_offset(nested, wanted, work, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        return true if proof_replay_resource_alt_expr_has_offset(iterable, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        return proof_replay_resource_alt_statements_has_offset(nested, wanted, work, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_replay_resource_alt_expr_has_offset(scrutinee, wanted, work, depth + 1)
                        return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        for arm in arms |arm, wanted, work, depth|:
                            return true if proof_replay_resource_alt_expr_has_offset(arm.guard, wanted, work, depth + 1)
                            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            return true if proof_replay_resource_alt_statements_has_offset(arm.body, wanted, work, depth + 1)
                            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return proof_replay_resource_alt_statements_has_offset(nested, wanted, work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                        return false
            false

        def proof_replay_resource_alt_arm_has_offset(expression: Ast::Expr, body: darray[Ast::Stmt]&, wanted: usize, work: mutable usize&) -> bool:
            proof_replay_resource_alt_expr_has_offset(expression, wanted, work, 0) or proof_replay_resource_alt_statements_has_offset(body, wanted, work, 0)

        def proof_replay_resource_alt_bind_matches(expression: Ast::Expr, body: darray[Ast::Stmt]&, node: ElisaProofKernelCore::ProofKernelNode, work: mutable usize&) -> bool:
            return false if node.value <= 0 or node.value > 4294967295 or node.name == "" or node.operator != "value" or node.secondary_name != ""
            matches: mutable usize = 0
            source_type: mutable Ast::Expr = Ast::Expr.Invalid
            return false if not proof_replay_resource_event_find_expression_with_work(expression, node.value.usize(), "resource-bind-inventory", node.name, matches, source_type, work, 0)
            return false if not proof_replay_resource_event_find_statements_with_work(body, node.value.usize(), "resource-bind-inventory", node.name, matches, source_type, work, 0)
            if matches == 0:
                loop_matches: mutable usize = 0
                loop_iterable: mutable Ast::Expr = Ast::Expr.Invalid
                return false if not proof_replay_resource_event_find_expression_with_work(expression, node.value.usize(), "resource-bind-loop-inventory", node.name, loop_matches, loop_iterable, work, 0)
                return false if not proof_replay_resource_event_find_statements_with_work(body, node.value.usize(), "resource-bind-loop-inventory", node.name, loop_matches, loop_iterable, work, 0)
                return false if loop_matches != 1 or loop_iterable is Ast::Expr.Invalid
                return proof_replay_resource_binding_iterable_is_range_with_work(loop_iterable, work, 0)
            matches == 1 and source_type is not Ast::Expr.Invalid

        def proof_replay_resource_alt_scope_has_source(report: ProofReport&, root: usize, expression: Ast::Expr, body: darray[Ast::Stmt]&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_RESOURCE_ALTERNATIVE_DEPTH_LIMIT or root >= report.analysis_1.kernel.nodes.count or not proof_replay_owner_work_charge(1, work)
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[root]
            return false if node.children_start > report.analysis_1.kernel.children.count or node.children_count > report.analysis_1.kernel.children.count - node.children_start
            # Charge for the bounded chain of kind comparisons below, including the
            # membership check for positioned event kinds.
            for _ in 0..<24 |node, work|:
                return false if not proof_replay_owner_work_charge(sview_len(node.kind), work)
            if node.kind == "resource-scope":
                for index in 0..<node.children_count |index, report, node, expression, body, work, depth|:
                    return false if not proof_replay_owner_work_charge(1, work)
                    child: usize = report.analysis_1.kernel.children[node.children_start + index]
                    return false if not proof_replay_resource_alt_scope_has_source(report, child, expression, body, work, depth + 1)
                return true
            if node.kind == "resource-alternatives":
                return false if node.value < 0 or node.value > 4294967295
                return false if not proof_replay_resource_alt_arm_has_offset(expression, body, node.value.usize(), work)
                # The enclosing owner walk validates this nested alternatives node at its
                # own AST arm. Here we only prove that its control offset belongs to this arm.
                return true
            if node.kind == "resource-safety" or node.kind == "resource-disjoint":
                # Disjointness carries branch-sensitive logical premises; owner-global fact
                # tracing does not prove those premises in this particular arm.
                return false
            if node.kind == "resource-call" or node.kind == "resource-call-lend":
                return false if node.value <= 0 or node.value > 4294967295
                return proof_replay_resource_alt_arm_has_offset(expression, body, node.value.usize(), work)
            if node.kind == "resource-join-move":
                # Join moves are emitted after the alternatives container, never inside an arm.
                return false
            if node.kind == "resource-bind":
                return proof_replay_resource_alt_bind_matches(expression, body, node, work)
            if node.kind == "resource-region-bind" or node.kind == "resource-call-result":
                return false
            positioned: bool = node.kind in {"resource-region-open", "resource-region-close", "resource-region-alloc", "resource-region-alloc-discard", "resource-region-call-alloc", "resource-region-return-alloc", "resource-region-rebind-alloc", "resource-region-assign", "resource-use", "resource-write", "resource-move", "resource-region-return"}
            return false if not positioned or node.value <= 0 or node.value > 4294967295
            proof_replay_resource_alt_arm_has_offset(expression, body, node.value.usize(), work)

        def proof_replay_resource_alt_scope_children_match(report: ProofReport&, alternatives: ElisaProofKernelCore::ProofKernelNode, index: usize, expression: Ast::Expr, body: darray[Ast::Stmt]&, work: mutable usize&) -> bool:
            return false if index >= alternatives.children_count or alternatives.children_start > report.analysis_1.kernel.children.count or alternatives.children_count > report.analysis_1.kernel.children.count - alternatives.children_start
            scope_root: usize = report.analysis_1.kernel.children[alternatives.children_start + index]
            return false if scope_root >= report.analysis_1.kernel.nodes.count or report.analysis_1.kernel.nodes[scope_root].kind != "resource-scope"
            proof_replay_resource_alt_scope_has_source(report, scope_root, expression, body, work, 0)

        def proof_replay_resource_alt_if_candidate(report: ProofReport&, alternatives: ElisaProofKernelCore::ProofKernelNode, yes_expression: Ast::Expr, no_expression: Ast::Expr, yes_body: darray[Ast::Stmt]&, no_body: darray[Ast::Stmt]&, work: mutable usize&) -> bool:
            return false if alternatives.children_count != 2
            return false if not proof_replay_resource_alt_scope_children_match(report, alternatives, 0, yes_expression, yes_body, work)
            proof_replay_resource_alt_scope_children_match(report, alternatives, 1, no_expression, no_body, work)

        # The producer records the evaluated RHS first and the skipped RHS second for both
        # short-circuit operators. The second scope must therefore contain no source-backed
        # transitions; otherwise a forged trace could make conditional effects unconditional.
        def proof_replay_resource_alt_short_circuit_candidate(report: ProofReport&, alternatives: ElisaProofKernelCore::ProofKernelNode, right_expression: Ast::Expr, work: mutable usize&) -> bool:
            return false if alternatives.children_count != 2
            return false if not proof_replay_resource_alt_scope_children_match(report, alternatives, 0, right_expression, [], work)
            proof_replay_resource_alt_scope_children_match(report, alternatives, 1, Ast::Expr.Absent, [], work)

        def proof_replay_resource_alt_match_candidate(report: ProofReport&, alternatives: ElisaProofKernelCore::ProofKernelNode, arms: darray[Ast::MatchArm]&, work: mutable usize&) -> bool:
            return false if alternatives.children_count != arms.count
            for index in 0..<arms.count |index, report, alternatives, arms, work|:
                return false if not proof_replay_owner_work_charge(1, work)
                arm: Ast::MatchArm = arms[index]
                return false if not proof_replay_resource_alt_scope_children_match(report, alternatives, index, arm.guard, arm.body, work)
            true

        def proof_replay_resource_alt_find_expression(expression: Ast::Expr, report: ProofReport&, alternatives: ElisaProofKernelCore::ProofKernelNode, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_replay_owner_work_charge(1, work)
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_replay_resource_alt_find_expression(callee, report, alternatives, matches, work, depth + 1)
                    for argument in arguments |argument, report, alternatives, matches, work, depth|:
                        return false if not proof_replay_resource_alt_find_expression(argument, report, alternatives, matches, work, depth + 1)
                Ast::Expr.StaticEffectCall(effect_type, _, candidates, arguments, _, _):
                    return false if not proof_replay_resource_alt_find_expression(effect_type, report, alternatives, matches, work, depth + 1)
                    for candidate in candidates |candidate, report, alternatives, matches, work, depth|:
                        return false if not proof_replay_owner_work_charge(1, work)
                        for capture in candidate.captures |capture, report, alternatives, matches, work, depth|:
                            return false if not proof_replay_resource_alt_find_expression(capture, report, alternatives, matches, work, depth + 1)
                    for argument in arguments |argument, report, alternatives, matches, work, depth|:
                        return false if not proof_replay_resource_alt_find_expression(argument, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Paren(object, _) | Ast::Expr.Unary(_, object, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _):
                    return false if not proof_replay_resource_alt_find_expression(object, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return false if not proof_replay_resource_alt_find_expression(object, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(index, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Binary(left, operator, right, position):
                    if proof_replay_resource_is_source_short_circuit(left, operator, right, position) and position.offset == alternatives.value.u32():
                        return false if matches != 0 or not proof_replay_resource_alt_short_circuit_candidate(report, alternatives, right, work)
                        matches <- matches + 1
                    return false if not proof_replay_resource_alt_find_expression(left, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(right, report, alternatives, matches, work, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_replay_resource_alt_find_expression(object, report, alternatives, matches, work, depth + 1)
                    for argument in arguments |argument, report, alternatives, matches, work, depth|:
                        return false if not proof_replay_resource_alt_find_expression(argument, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_replay_resource_alt_find_expression(object, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(low, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(high, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |element, report, alternatives, matches, work, depth|:
                        return false if not proof_replay_resource_alt_find_expression(element, report, alternatives, matches, work, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, report, alternatives, matches, work, depth|:
                        return false if not proof_replay_resource_alt_find_expression(entry.key, report, alternatives, matches, work, depth + 1)
                        return false if not proof_replay_resource_alt_find_expression(entry.value, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Construct(base, fields, _) | Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_replay_resource_alt_find_expression(base, report, alternatives, matches, work, depth + 1)
                    for field in fields |field, report, alternatives, matches, work, depth|:
                        return false if not proof_replay_resource_alt_find_expression(field.value, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_replay_resource_alt_find_expression(base, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(predicate, report, alternatives, matches, work, depth + 1)
                Ast::Expr.If(condition, yes, no, position):
                    if position.line > 0 and position.offset == alternatives.value.u32():
                        return false if matches != 0 or not proof_replay_resource_alt_if_candidate(report, alternatives, yes, no, [], [], work)
                        matches <- matches + 1
                    return false if not proof_replay_resource_alt_find_expression(condition, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(yes, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(no, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return false if not proof_replay_resource_alt_find_expression(iterable, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(condition, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(body, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Match(scrutinee, arms, position) | Ast::Expr.Catch(scrutinee, arms, position):
                    if position.line > 0 and position.offset == alternatives.value.u32():
                        return false if matches != 0 or not proof_replay_resource_alt_match_candidate(report, alternatives, arms, work)
                        matches <- matches + 1
                    return false if not proof_replay_resource_alt_find_expression(scrutinee, report, alternatives, matches, work, depth + 1)
                    for arm in arms |arm, report, alternatives, matches, work, depth|:
                        return false if not proof_replay_resource_alt_find_expression(arm.guard, report, alternatives, matches, work, depth + 1)
                        return false if not proof_replay_resource_alt_find_statements(arm.body, report, alternatives, matches, work, depth + 1)
                Ast::Expr.GetElse(guarded, recovery, _):
                    return false if not proof_replay_resource_alt_find_expression(guarded, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_statements(recovery, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    return proof_replay_resource_alt_find_statements(body, report, alternatives, matches, work, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return false if not proof_replay_resource_alt_find_statements(statements, report, alternatives, matches, work, depth + 1)
                    return false if not proof_replay_resource_alt_find_expression(value, report, alternatives, matches, work, depth + 1)
            true

        def proof_replay_resource_alt_find_statements(body: darray[Ast::Stmt]&, report: ProofReport&, alternatives: ElisaProofKernelCore::ProofKernelNode, matches: mutable usize&, work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            for statement in body |statement, report, alternatives, matches, work, depth|:
                return false if not proof_replay_owner_work_charge(1, work)
                match statement:
                    Ast::Stmt.Invalid:
                        return false
                    Ast::Stmt.Expr(expression, _) | Ast::Stmt.Return(expression, _) | Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_replay_resource_alt_find_expression(expression, report, alternatives, matches, work, depth + 1)
                    Ast::Stmt.VarDecl(_, type_expression, initializer, _):
                        return false if not proof_replay_resource_alt_find_expression(type_expression, report, alternatives, matches, work, depth + 1)
                        return false if not proof_replay_resource_alt_find_expression(initializer, report, alternatives, matches, work, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if not proof_replay_resource_alt_find_expression(target, report, alternatives, matches, work, depth + 1)
                        return false if not proof_replay_resource_alt_find_expression(value, report, alternatives, matches, work, depth + 1)
                    Ast::Stmt.If(condition, yes, no, position):
                        if position.line > 0 and position.offset == alternatives.value.u32():
                            return false if matches != 0 or not proof_replay_resource_alt_if_candidate(report, alternatives, Ast::Expr.Absent, Ast::Expr.Absent, yes, no, work)
                            matches <- matches + 1
                        return false if not proof_replay_resource_alt_find_expression(condition, report, alternatives, matches, work, depth + 1)
                        return false if not proof_replay_resource_alt_find_statements(yes, report, alternatives, matches, work, depth + 1)
                        return false if not proof_replay_resource_alt_find_statements(no, report, alternatives, matches, work, depth + 1)
                    Ast::Stmt.While(condition, nested, _):
                        return false if not proof_replay_resource_alt_find_expression(condition, report, alternatives, matches, work, depth + 1)
                        return false if not proof_replay_resource_alt_find_statements(nested, report, alternatives, matches, work, depth + 1)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        return false if not proof_replay_resource_alt_find_expression(iterable, report, alternatives, matches, work, depth + 1)
                        return false if not proof_replay_resource_alt_find_statements(nested, report, alternatives, matches, work, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, position):
                        if position.line > 0 and position.offset == alternatives.value.u32():
                            return false if matches != 0 or not proof_replay_resource_alt_match_candidate(report, alternatives, arms, work)
                            matches <- matches + 1
                        return false if not proof_replay_resource_alt_find_expression(scrutinee, report, alternatives, matches, work, depth + 1)
                        for arm in arms |arm, report, alternatives, matches, work, depth|:
                            return false if not proof_replay_resource_alt_find_expression(arm.guard, report, alternatives, matches, work, depth + 1)
                            return false if not proof_replay_resource_alt_find_statements(arm.body, report, alternatives, matches, work, depth + 1)
                    Ast::Stmt.Block(_, _, _, nested, _):
                        return false if not proof_replay_resource_alt_find_statements(nested, report, alternatives, matches, work, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        return false
            true

        # Each alternatives node scans its authenticated owner's AST to find one exact control
        # offset and validate its ordered arms. Every AST node and child edge is charged to the
        # report-wide source-work meter, so many nested alternatives consume the shared ceiling
        # and fail closed instead of escaping the bounded replay budget.
        def proof_replay_resource_alternatives_source_valid_with_work(report: ProofReport&, root: usize, alternatives: ElisaProofKernelCore::ProofKernelNode, owner: sview, owner_line: u32, owner_offset: usize, owner_module: sview, work: mutable usize&, cache: mutable ProofReplayStructuralValidationCache&) -> bool:
            return false if root >= report.analysis_1.kernel.nodes.count or alternatives.kind != "resource-alternatives" or alternatives.value < 0 or alternatives.value > 4294967295 or owner == "" or owner_line == 0 or owner_offset > 4294967295
            alternatives_count: (complete: bool, count: usize) = proof_replay_resource_event_count_in_root_with_work(report, report.analysis_1.kernel.nodes[root], "resource-alternatives", alternatives.value.usize(), "", work)
            return false if not alternatives_count.complete or alternatives_count.count != 1
            return false if not proof_replay_deterministic_call_declaration_index_ensure(report, work, &cache.deterministic_calls)
            caller: (complete: bool, matches: usize, row: usize) = proof_replay_summary_owner_function_at_offset(cache.deterministic_calls.declaration_index, owner, owner_line, owner_offset, work)
            return false if not caller.complete or caller.matches != 1 or caller.row >= cache.deterministic_calls.declaration_index.entries.count
            entry: ProofReplayDeterministicDeclarationEntry = cache.deterministic_calls.declaration_index.entries[caller.row]
            return false if entry.owner != owner_module
            body: mutable darray[Ast::Stmt] = []
            match entry.declaration:
                Ast::Decl.Func(_, _, _, declared_body, _, _, _):
                    body <- declared_body
                _:
                    return false
            matches: mutable usize = 0
            return false if not proof_replay_resource_alt_find_statements(body, report, alternatives, matches, work, 0)
            matches == 1

