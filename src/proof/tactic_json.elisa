# Portable proof-state script import for AI/editor clients.
#
# The wire format intentionally contains ordinary JSON and the same expression shape already
# emitted by `--json`.  This module turns that data back into compiler AST values inside a fresh
# Node.Store, applies the typed Elisa-native actions, and leaves final admission to the normal
# tactic trace and independent source-neutral kernel checks.  Unknown fields are ignored, but
# unknown expression kinds, malformed values, and branch actions without child certificates fail
# closed.
extend ElisaProof:
    public:
        # Keep JSON integers inside the exact binary64 range, and bound imported tactic work.
        const PROOF_JSON_MAX_SAFE_INTEGER: f64 = 9007199254740991.0
        const PROOF_JSON_MAX_TREE_NODES: usize = 65536
        const PROOF_JSON_BRANCH_DEPTH_LIMIT: usize = 32
        const PROOF_JSON_MAX_TOTAL_ACTIONS: usize = 65536
        const PROOF_JSON_MAX_TRACE_FACT_SNAPSHOTS: usize = 1048576
        const PROOF_JSON_ACTION_AST_WORK_LIMIT: usize = 16777216
        const PROOF_TACTIC_WORKSPACE_ARENA_BYTES: usize = 1048576
        struct ProofTacticJsonResult:
            valid: mutable bool = false
            solved: bool = false
            trace_replayed: bool = false
            kernel_trace_replayed: bool = false
            kernel_replayed: bool = false
            certificate_replayed: bool = false
            branch_present: bool = false
            branch_certificate_replayed: bool = false
            action_count: usize = 0
            accepted_count: usize = 0
            reason: mutable sview = ""
            tree_node: usize = 0
        # Branches are stored as a flat postorder tree. A parent is appended after both children,
        # so the independent verifier can validate arbitrary nesting with a bounded iterative
        # pass instead of trusting recursive host-language calls or mutable AST-store references.
        struct ProofTacticJsonTree:
            states: mutable darray[ProofTacticState]
            left: mutable darray[usize]
            right: mutable darray[usize]
            has_branch: mutable darray[bool]
            total_actions: mutable usize
            total_trace_fact_snapshots: mutable usize
            total_expression_work: mutable usize
            total_kernel_replay_work: mutable usize
            total_solver_work: mutable usize
            total_solver_preflight_work: mutable usize
            total_action_ast_work: mutable usize
            primitive_operator_mask: mutable usize
            primitive_operator_mask_initialized: mutable bool

        # One slot owns both branch states as distinct fields, making their non-aliasing
        # structural instead of relying on arithmetic analysis of adjacent array indices.
        struct ProofTacticJsonBranchScratch:
            left: mutable ProofTacticState
            right: mutable ProofTacticState

        def proof_tactic_state_in_arena[@r](arena: mutable Arena& @r) -> mutable ProofTacticState& @r:
            in arena:
                empty: mutable darray[Ast::Expr] = []
                return new[r] proof_tactic_state(&empty, Ast::Expr.Invalid)

        def proof_tactic_tree_in_arena[@r](arena: mutable Arena& @r) -> mutable ProofTacticJsonTree& @r:
            in arena:
                return new[r] ProofTacticJsonTree{states: [], left: [], right: [], has_branch: [], total_actions: 0, total_trace_fact_snapshots: 0, total_expression_work: 0, total_kernel_replay_work: 0, total_solver_work: 0, total_solver_preflight_work: 0, total_action_ast_work: 0, primitive_operator_mask: 0, primitive_operator_mask_initialized: false}

        def proof_tactic_json_field[@r](value: JsonValueHandle[r], key: sview) -> (known: bool, value: JsonValueHandle[r]):
            return ElisaProofJson::field(value, key)

        def proof_tactic_json_text[@r](value: JsonValueHandle[r]) -> (known: bool, value: sview) @r:
            return (false, "") if ElisaProofJson::kind(value) != JsonKind.STRING
            empty: sview = ""
            text: sview @r = try ElisaProofJson::as_string(value) else empty
            return (true, text)

        def proof_tactic_json_bool[@r](value: JsonValueHandle[r]) -> (known: bool, value: bool):
            return (false, false) if ElisaProofJson::kind(value) != JsonKind.BOOL
            flag: bool = try ElisaProofJson::as_bool(value) else false
            return (true, flag)

        def proof_tactic_json_integer[@r](value: JsonValueHandle[r]) -> (known: bool, value: i64):
            return (false, 0) if ElisaProofJson::kind(value) != JsonKind.NUMBER
            number: f64 = try ElisaProofJson::as_number(value) else 0.0
            # JSON numbers have already been rounded to f64. An integer round trip
            # cannot detect that 9007199254740993 was rounded to 9007199254740992.
            # Reject the entire ambiguous range, including its boundary, before a
            # source obligation can be reconstructed as a different proposition.
            return (false, 0) if not (number >= -PROOF_JSON_MAX_SAFE_INTEGER and number <= PROOF_JSON_MAX_SAFE_INTEGER)
            integer: i64 = number.i64()
            return (true, integer) if integer.f64() == number
            return (false, 0)

        def proof_tactic_json_line[@r](value: JsonValueHandle[r]) -> (known: bool, value: u32):
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(value)
            return (false, 0) if not parsed.known or parsed.value < 0 or parsed.value > ElisaProofKernelCore::PROOF_KERNEL_U32_MAX
            return (true, parsed.value.u32())

        def proof_tactic_json_operator[@r](value: JsonValueHandle[r], work_used: mutable usize&) -> (known: bool, value: TokenKind):
            parsed: (known: bool, text: sview) @r = proof_tactic_json_text(value)
            return (false, TokenKind.Eof) if not parsed.known
            return (false, TokenKind.Eof) if not proof_tactic_json_expression_charge(work_used, sview_len(parsed.text))
            operator: mutable TokenKind = TokenKind.Eof
            operator <- TokenKind.Plus if parsed.text == "+"
            operator <- TokenKind.Minus if parsed.text == "-"
            operator <- TokenKind.Star if parsed.text == "*"
            operator <- TokenKind.Slash if parsed.text == "/"
            operator <- TokenKind.Percent if parsed.text == "%"
            operator <- TokenKind.EqEq if parsed.text == "=="
            operator <- TokenKind.BangEq if parsed.text == "!="
            operator <- TokenKind.Lt if parsed.text == "<"
            operator <- TokenKind.Gt if parsed.text == ">"
            operator <- TokenKind.LtEq if parsed.text == "<="
            operator <- TokenKind.GtEq if parsed.text == ">="
            operator <- TokenKind.And if parsed.text == "and"
            operator <- TokenKind.Or if parsed.text == "or"
            operator <- TokenKind.FatArrow if parsed.text == "=>"
            operator <- TokenKind.Not if parsed.text == "not"
            operator <- TokenKind.In if parsed.text == "in"
            operator <- TokenKind.Is if parsed.text == "is"
            operator <- TokenKind.As if parsed.text == "as"
            operator <- TokenKind.Pipe if parsed.text == "|"
            operator <- TokenKind.Caret if parsed.text == "^"
            operator <- TokenKind.Ampersand if parsed.text == "&"
            operator <- TokenKind.LShift if parsed.text == "<<"
            operator <- TokenKind.RShift if parsed.text == ">>"
            operator <- TokenKind.RangeLt if parsed.text == "range_lt"
            operator <- TokenKind.RangeLe if parsed.text == "range_le"
            return (operator != TokenKind.Eof, operator)


        def proof_tactic_json_parse_annotations[@r](root: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r) -> bool:
            work_used: mutable usize = 0
            return proof_tactic_json_parse_annotations_with_work(root, annotations, &work_used)

        def proof_tactic_json_parse_annotations_with_work[@r](root: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r, work_used: mutable usize&) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "annotations", work_used)
            return work_used <= PROOF_JSON_EXPRESSION_WORK_LIMIT if not field.known
            return false if not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, annotations, work_used|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                return false if not proof_tactic_json_expression_charge(work_used, 1)
                name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "name", work_used)
                line_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "line", work_used)
                name: (known: bool, value: sview) @r = proof_tactic_json_text(name_field.value)
                return false if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT or not name_field.known or not name.known
                return false if not proof_tactic_json_expression_charge(work_used, sview_len(name.value))
                line: mutable u32 = 0
                if line_field.known:
                    parsed_line: (known: bool, value: u32) = proof_tactic_json_line(line_field.value)
                    return false if not parsed_line.known
                    line <- parsed_line.value
                annotations.push(Ast::EnumAnnotation{owner: "__contract_quantifier", name: name.value, line: line})
            return work_used <= PROOF_JSON_EXPRESSION_WORK_LIMIT

        def proof_tactic_json_action_fields_valid(action: sview, has_argument: bool, has_secondary: bool, has_argument_index: bool) -> bool:
            if action == "have":
                return has_argument and not has_secondary and not has_argument_index
            if action == "instantiate":
                return has_argument and not has_secondary and has_argument_index
            if action == "rewrite":
                return not has_argument and not has_secondary if has_argument_index
                return has_argument and has_secondary
            if action == "rewriteback":
                return has_argument_index and not has_argument and not has_secondary
            if action == "apply":
                return not has_argument and not has_secondary
            return false if has_argument or has_secondary or has_argument_index
            return action in {"assumption", "exact", "decide", "intro", "simp", "split", "cases", "left", "right"}

        def proof_tactic_json_action(state: mutable ProofTacticState&, action: sview, argument: Ast::Expr, has_argument: bool, secondary: Ast::Expr, has_secondary: bool, argument_index: usize, has_argument_index: bool, annotations: mutable darray[Ast::EnumAnnotation]&, source_bound: bool, operator_mask: usize, solver_work: mutable usize&, preflight_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if:
                action in {"split", "cases"}
                (proof_float_mode can Global.Read) and action != "assumption" and action != "exact"
                (action in {"rewrite", "rewriteback"}) and has_argument_index and (has_argument or has_secondary)
            return proof_tactic_assumption(state, annotations) if action == "assumption"
            return (proof_tactic_decision_with_shared_work(state, annotations, "exact", operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if action == "exact"
            return (proof_tactic_decision_with_shared_work(state, annotations, "decide", operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if action == "decide"
            return proof_tactic_intro(state) if action == "intro"
            return false if action == "apply" and (has_argument or has_secondary)
            return proof_tactic_apply_from_fact(state, argument_index, annotations) if action == "apply" and has_argument_index
            return proof_tactic_apply(state, annotations) if action == "apply"
            return (proof_tactic_simplify_source_bound_with_shared_work(state, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if source_bound and action == "simp"
            return (proof_tactic_simplify_with_shared_work(state, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if action == "simp"
            return (proof_tactic_have_with_shared_work(state, argument, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if action == "have" and has_argument
            return proof_tactic_instantiate(state, argument_index, argument, annotations) if action == "instantiate" and has_argument and has_argument_index
            return (proof_tactic_rewrite_from_fact(state, argument_index, false, annotations) can Global.Read) if source_bound and action == "rewrite" and has_argument_index and not has_argument and not has_secondary
            return (proof_tactic_rewrite_from_fact(state, argument_index, true, annotations) can Global.Read) if source_bound and action == "rewriteback" and has_argument_index and not has_argument and not has_secondary
            return (proof_tactic_rewrite_source_bound(state, argument, secondary, annotations) can Global.Read) if source_bound and action == "rewrite" and has_argument and has_secondary and not has_argument_index
            return (proof_tactic_rewrite(state, argument, secondary) can Global.Read) if action == "rewrite" and has_argument and has_secondary and not has_argument_index
            return proof_tactic_left(state) if action == "left"
            return proof_tactic_right(state) if action == "right"
            return false

        def proof_tactic_json_action_ast_exhaust(total_work: mutable usize&) -> bool:
            total_work <- PROOF_JSON_ACTION_AST_WORK_LIMIT
            return false

        # The census is itself a bounded recursive AST walk. Charge it along with AST-pair work
        # for action execution and deterministic replay, and latch exhaustion after any failed
        # post-census admission so repeated rejected actions cannot repeat a large scan for free.
        def proof_tactic_json_charge_action_ast_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, argument: Ast::Expr, has_argument: bool, secondary: Ast::Expr, has_secondary: bool, annotations: darray[Ast::EnumAnnotation]&, total_work: mutable usize&) -> bool:
            return false if total_work >= PROOF_JSON_ACTION_AST_WORK_LIMIT
            remaining: usize = PROOF_JSON_ACTION_AST_WORK_LIMIT - total_work
            ast_cost: mutable usize = 0
            for fact in facts |fact, ast_cost, remaining|:
                cost: mutable usize = 0
                return proof_tactic_json_action_ast_exhaust(&total_work) if not proof_tactic_kernel_trace_ast_expr_cost_with_limit(fact, &cost, remaining - ast_cost)
                return proof_tactic_json_action_ast_exhaust(&total_work) if cost > remaining - ast_cost
                ast_cost <- ast_cost + cost
            goal_cost: mutable usize = 0
            return proof_tactic_json_action_ast_exhaust(&total_work) if not proof_tactic_kernel_trace_ast_expr_cost_with_limit(goal, &goal_cost, remaining - ast_cost)
            return proof_tactic_json_action_ast_exhaust(&total_work) if goal_cost > remaining - ast_cost
            ast_cost <- ast_cost + goal_cost
            if has_argument:
                argument_cost: mutable usize = 0
                return proof_tactic_json_action_ast_exhaust(&total_work) if not proof_tactic_kernel_trace_ast_expr_cost_with_limit(argument, &argument_cost, remaining - ast_cost)
                return proof_tactic_json_action_ast_exhaust(&total_work) if argument_cost > remaining - ast_cost
                ast_cost <- ast_cost + argument_cost
            if has_secondary:
                secondary_cost: mutable usize = 0
                return proof_tactic_json_action_ast_exhaust(&total_work) if not proof_tactic_kernel_trace_ast_expr_cost_with_limit(secondary, &secondary_cost, remaining - ast_cost)
                return proof_tactic_json_action_ast_exhaust(&total_work) if secondary_cost > remaining - ast_cost
                ast_cost <- ast_cost + secondary_cost
            annotation_cost: mutable usize = 0
            census_remaining: usize = remaining - ast_cost
            for annotation in annotations |annotation, annotation_cost, census_remaining|:
                owner_cost: usize = sview_len(annotation.owner)
                name_cost: usize = sview_len(annotation.name)
                return proof_tactic_json_action_ast_exhaust(&total_work) if annotation_cost >= census_remaining or owner_cost >= census_remaining - annotation_cost
                return proof_tactic_json_action_ast_exhaust(&total_work) if name_cost > census_remaining - annotation_cost - owner_cost - 1
                annotation_row_cost: usize = owner_cost + name_cost + 1
                annotation_cost <- annotation_cost + annotation_row_cost
            if ast_cost == 0:
                total_work <- total_work + annotation_cost
                return true
            return proof_tactic_json_action_ast_exhaust(&total_work) if annotation_cost > remaining - ast_cost
            census_cost: usize = ast_cost + annotation_cost
            execution_remaining: usize = remaining - census_cost
            return proof_tactic_json_action_ast_exhaust(&total_work) if ast_cost > execution_remaining / ast_cost
            quadratic_cost: usize = ast_cost * ast_cost
            return proof_tactic_json_action_ast_exhaust(&total_work) if quadratic_cost > execution_remaining
            remaining_cross_cost: usize = execution_remaining - quadratic_cost
            return proof_tactic_json_action_ast_exhaust(&total_work) if annotation_cost > remaining_cross_cost / ast_cost
            action_cost: usize = quadratic_cost + ast_cost * annotation_cost
            return proof_tactic_json_action_ast_exhaust(&total_work) if action_cost > execution_remaining / 2
            total_work <- total_work + census_cost + action_cost * 2
            return true

        def proof_tactic_json_prepare_operator_mask(tree: mutable ProofTacticJsonTree&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return true if tree.primitive_operator_mask_initialized
            mask: (complete: bool, value: usize) = proof_source_primitive_operator_mask_with_work(annotations, &tree.total_solver_preflight_work)
            return false if not mask.complete
            tree.primitive_operator_mask <- mask.value
            tree.primitive_operator_mask_initialized <- true
            return true

        def proof_tactic_json_branch_scripts[@r](item: JsonValueHandle[r]) -> (known: bool, left: JsonValueHandle[r], right: JsonValueHandle[r]):
            work_used: mutable usize = 0
            return proof_tactic_json_branch_scripts_with_work(item, &work_used)

        def proof_tactic_json_branch_scripts_with_work[@r](item: JsonValueHandle[r], work_used: mutable usize&) -> (known: bool, left: JsonValueHandle[r], right: JsonValueHandle[r]):
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "branches", work_used)
            return (false, ElisaProofJson::null_value(item), ElisaProofJson::null_value(item)) if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return (false, ElisaProofJson::null_value(field.value), ElisaProofJson::null_value(field.value)) if count != 2
            left: JsonValueHandle[r] = try ElisaProofJson::at(field.value, 0) else ElisaProofJson::null_value(field.value)
            right: JsonValueHandle[r] = try ElisaProofJson::at(field.value, 1) else ElisaProofJson::null_value(field.value)
            return (ElisaProofJson::is_object(left) and ElisaProofJson::is_object(right), left, right)

        # Verify a complete imported proof tree using only source-neutral replay. The tree is
        # deliberately required to be postorder and rooted at its final node; this makes the
        # ordering and every child edge part of the certificate rather than an interpreter detail.
        def proof_tactic_json_tree_certificate_replay(tree: ProofTacticJsonTree&, root: usize, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            return false if:
                tree.states.count == 0
                tree.left.count != tree.states.count or tree.right.count != tree.states.count or tree.has_branch.count != tree.states.count
                root != tree.states.count - 1
            validity: mutable darray[bool] = []
            validity.resize(tree.states.count)
            cursor: mutable usize = 0
            while cursor < tree.states.count |cursor, tree, validity|:
                if not tree.has_branch[cursor]:
                    leaf: mutable ProofTacticState = tree.states[cursor]
                    trace_valid: bool = (proof_tactic_kernel_trace_replay_with_work(leaf, annotations, &tree.total_kernel_replay_work) can Global{Read,Write})
                    kernel_valid: bool = (proof_tactic_kernel_replay_with_trace_work(leaf, annotations, &tree.total_kernel_replay_work) can Global{Read,Write}) if trace_valid else false
                    validity[cursor] <- trace_valid and kernel_valid
                else:
                    left_index: usize = tree.left[cursor]
                    right_index: usize = tree.right[cursor]
                    return false if:
                        left_index >= cursor or right_index >= cursor
                        not validity[left_index] or not validity[right_index]
                    parent: mutable ProofTacticState = tree.states[cursor]
                    left: mutable ProofTacticState = tree.states[left_index]
                    right: mutable ProofTacticState = tree.states[right_index]
                    validity[cursor] <- (proof_tactic_kernel_branch_transition_replay_with_work(&parent, &left, &right, annotations, &tree.total_kernel_replay_work) can Global{Read,Write})
                cursor <- cursor + 1
            return validity[root]

        def proof_tactic_json_source_fingerprint[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, value: u32):
            work_used: mutable usize = 0
            return proof_tactic_json_source_fingerprint_with_work(root, &work_used)

        def proof_tactic_json_source_fingerprint_with_work[@r](root: JsonValueHandle[r], work_used: mutable usize&) -> (present: bool, valid: bool, value: u32):
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "source_fingerprint", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return (false, true, 0) if not field.known
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(field.value)
            return (true, parsed.known and parsed.value >= 0 and parsed.value <= ElisaProofKernelCore::PROOF_KERNEL_U32_MAX, parsed.value.u32())

        def proof_tactic_json_target[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, goal_id: usize):
            work_used: mutable usize = 0
            return proof_tactic_json_target_with_work(root, &work_used)

        def proof_tactic_json_target_with_work[@r](root: JsonValueHandle[r], work_used: mutable usize&) -> (present: bool, valid: bool, goal_id: usize):
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "target", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return (false, true, 0) if not field.known
            goal_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(field.value, "goal_id", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(goal_field.value)
            return (true, parsed.known and parsed.value >= 0, parsed.value.usize())

        def proof_tactic_json_target_fingerprint[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, value: u32):
            work_used: mutable usize = 0
            return proof_tactic_json_target_fingerprint_with_work(root, &work_used)

        def proof_tactic_json_target_fingerprint_with_work[@r](root: JsonValueHandle[r], work_used: mutable usize&) -> (present: bool, valid: bool, value: u32):
            target_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "target", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return (false, true, 0) if not target_field.known
            fingerprint_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(target_field.value, "goal_fingerprint", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return (false, true, 0) if not fingerprint_field.known
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(fingerprint_field.value)
            return (true, parsed.known and parsed.value >= 0 and parsed.value <= ElisaProofKernelCore::PROOF_KERNEL_U32_MAX, parsed.value.u32())

        def proof_tactic_json_run_actions[@r](root: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r, state: mutable ProofTacticState& @r, tree: mutable ProofTacticJsonTree& @r, scratch: mutable darray[ProofTacticJsonBranchScratch]& @r, depth: usize, allow_branch: bool, source_bound: bool) -> ProofTacticJsonResult can[Global.Read, Global.Write]:
            invalid: ProofTacticJsonResult = ProofTacticJsonResult{reason: "invalid proof script"}
            # Budget exhaustion is its own non-proof outcome, distinct from a malformed document.
            exhausted: ProofTacticJsonResult = ProofTacticJsonResult{..invalid, reason: "tactic script exhausted an aggregate JSON, solver, replay, or tree work budget"}
            return exhausted if tree.states.count >= PROOF_JSON_MAX_TREE_NODES
            return exhausted if depth == 0 and not proof_tactic_json_prepare_operator_mask(tree, annotations)
            actions_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "actions", &tree.total_expression_work)
            return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if not actions_field.known or not ElisaProofJson::is_array(actions_field.value)
            count: i64 = ElisaProofJson::array_len(actions_field.value)
            return invalid if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            accepted_count: mutable usize = 0
            branch_certificate_ok: mutable bool = false
            branch_present: mutable bool = false
            branch_trace_ok: mutable bool = true
            branch_kernel_trace_ok: mutable bool = true
            branch_kernel_ok: mutable bool = false
            branch_left_node: mutable usize = 0
            branch_right_node: mutable usize = 0
            for index in 0..<count |index, actions_field, state, annotations, accepted_count, source_bound|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(actions_field.value, index) else ElisaProofJson::null_value(actions_field.value)
                action_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "action", &tree.total_expression_work)
                return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
                action: (known: bool, value: sview) @r = proof_tactic_json_text(action_field.value)
                return invalid if not action_field.known or not action.known
                return exhausted if not proof_tactic_json_expression_charge(&tree.total_expression_work, sview_len(action.value))
                argument_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "argument", &tree.total_expression_work)
                secondary_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "secondary", &tree.total_expression_work)
                argument: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(argument_field.value, &tree.total_expression_work, 0) if argument_field.known else (false, Ast::Expr.Absent)
                secondary: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(secondary_field.value, &tree.total_expression_work, 0) if secondary_field.known else (false, Ast::Expr.Absent)
                index_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "argument_index", &tree.total_expression_work)
                parsed_index: (known: bool, value: i64) = proof_tactic_json_integer(index_field.value) if index_field.known else (false, 0)
                expected_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "accepted", &tree.total_expression_work)
                expected: (known: bool, value: bool) = proof_tactic_json_bool(expected_field.value) if expected_field.known else (true, true)
                return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
                return invalid if:
                    (argument_field.known and not argument.known) or (secondary_field.known and not secondary.known) or (index_field.known and (not parsed_index.known or parsed_index.value < 0 or parsed_index.value > ElisaProofKernelCore::PROOF_KERNEL_U32_MAX)) or (expected_field.known and not expected.known)
                    not proof_tactic_json_action_fields_valid(action.value, argument_field.known, secondary_field.known, index_field.known)
                # These counters span recursive branches. Per-node limits alone allowed a
                # document with many small scripts to multiply both replay work and copied fact
                # snapshots by the full tree size.
                return exhausted if tree.total_actions >= PROOF_JSON_MAX_TOTAL_ACTIONS
                return exhausted if tree.total_trace_fact_snapshots > PROOF_JSON_MAX_TRACE_FACT_SNAPSHOTS
                snapshot_charge: usize = state.facts.count + 1
                return exhausted if snapshot_charge > PROOF_JSON_MAX_TRACE_FACT_SNAPSHOTS - tree.total_trace_fact_snapshots
                tree.total_actions <- tree.total_actions + 1
                tree.total_trace_fact_snapshots <- tree.total_trace_fact_snapshots + snapshot_charge
                return exhausted if not proof_tactic_json_charge_action_ast_work(state.facts, state.goal, argument.value, argument_field.known, secondary.value, secondary_field.known, annotations, &tree.total_action_ast_work)
                before_action_count: usize = state.action_count
                actual: mutable bool = false
                if action.value in {"split", "cases"}:
                    return invalid if:
                        not allow_branch
                        index + 1 != count
                    return exhausted if depth >= PROOF_JSON_BRANCH_DEPTH_LIMIT
                    branches: (known: bool, left: JsonValueHandle[r], right: JsonValueHandle[r]) = proof_tactic_json_branch_scripts_with_work(item, &tree.total_expression_work)
                    return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
                    return invalid if not branches.known
                    # Borrow distinct fields from one preallocated region-owned slot. Stack
                    # child values cannot satisfy the shared @r lifetime of recursive calls.
                    return exhausted if depth >= scratch.count
                    left_branch_state: mutable ProofTacticState& = &scratch[depth].left
                    right_branch_state: mutable ProofTacticState& = &scratch[depth].right
                    actual <- proof_tactic_split(state, left_branch_state, right_branch_state) if action.value == "split" and branches.known
                    actual <- proof_tactic_cases(state, left_branch_state, right_branch_state) if action.value == "cases" and branches.known
                    if actual:
                        branch_present <- true
                        left_initial_present: bool = proof_tactic_json_has_with_work(branches.left, "initial", &tree.total_expression_work)
                        left_target_present: bool = proof_tactic_json_has_with_work(branches.left, "target", &tree.total_expression_work)
                        right_initial_present: bool = proof_tactic_json_has_with_work(branches.right, "initial", &tree.total_expression_work)
                        right_target_present: bool = proof_tactic_json_has_with_work(branches.right, "target", &tree.total_expression_work)
                        return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
                        return invalid if left_initial_present or left_target_present or right_initial_present or right_target_present
                        left_result: ProofTacticJsonResult = (proof_tactic_json_run_actions(branches.left, annotations, left_branch_state, tree, scratch, depth + 1, true, source_bound) can Global{Read,Write})
                        # An invalid child invalidates the whole script and keeps its own reason; a
                        # malformed or exhausted branch must not be reported as a merely open goal.
                        return left_result if not left_result.valid
                        right_result: ProofTacticJsonResult = (proof_tactic_json_run_actions(branches.right, annotations, right_branch_state, tree, scratch, depth + 1, true, source_bound) can Global{Read,Write})
                        return right_result if not right_result.valid
                        branch_trace_ok <- left_result.trace_replayed and right_result.trace_replayed
                        branch_kernel_trace_ok <- left_result.kernel_trace_replayed and right_result.kernel_trace_replayed
                        branch_kernel_ok <- left_result.kernel_replayed and right_result.kernel_replayed
                        branch_left_node <- left_result.tree_node
                        branch_right_node <- right_result.tree_node
                        branch_certificate_ok <- left_result.valid and right_result.valid and left_result.certificate_replayed and right_result.certificate_replayed and (proof_tactic_kernel_branch_transition_replay_with_work(state, left_branch_state, right_branch_state, annotations, &tree.total_kernel_replay_work) can Global{Read,Write})
                else:
                    actual <- (proof_tactic_json_action(state, action.value, argument.value, argument_field.known, secondary.value, secondary_field.known, parsed_index.value.usize(), index_field.known, annotations, source_bound, tree.primitive_operator_mask, &tree.total_solver_work, &tree.total_solver_preflight_work) can Global{Read,Write})
                # Every well-formed action, including a rejected one, must leave a replayable
                # trace entry. Otherwise an unknown action paired with `accepted: false` could
                # be silently treated as a no-op and disappear from both replay passes.
                if state.action_count != before_action_count + 1:
                    # A per-state branch quota may stop an action before it can be recorded.
                    # Preserve the quota outcome as structured exhaustion; missing traces with
                    # remaining state capacity still indicate an invalid action dispatch.
                    return exhausted if state.budget_exhausted or not proof_tactic_state_action_base_available(state, 0)
                    return invalid
                # A refused action is a well-formed script whose claimed outcome is false; report it
                # separately from malformed input so a client can tell which part to repair.
                contradicted: ProofTacticJsonResult = ProofTacticJsonResult{..invalid, action_count: state.action_count, accepted_count: accepted_count, reason: "tactic action outcome contradicted the script's expected acceptance"}
                return contradicted if actual != expected.value
                accepted_count <- accepted_count + 1 if actual
            trace_ok: mutable bool = (proof_tactic_replay_with_shared_work(state, annotations, tree.primitive_operator_mask, source_bound, &tree.total_solver_work, &tree.total_solver_preflight_work) can Global{Read,Write})
            kernel_trace_ok: mutable bool = (proof_tactic_kernel_trace_replay_with_work(state, annotations, &tree.total_kernel_replay_work) can Global{Read,Write})
            kernel_ok: mutable bool = (proof_tactic_kernel_replay_with_trace_work(state, annotations, &tree.total_kernel_replay_work) can Global{Read,Write})
            # The combined certificate predicate is exactly these two independent kernel
            # results. Replaying both through the convenience wrapper would duplicate the work.
            certificate_ok: mutable bool = kernel_trace_ok and kernel_ok
            if branch_present:
                trace_ok <- trace_ok and branch_trace_ok
                kernel_trace_ok <- kernel_trace_ok and branch_kernel_trace_ok
                kernel_ok <- branch_kernel_ok
                certificate_ok <- branch_certificate_ok
            tree_node: usize = tree.states.count
            state_snapshot_charge: usize = state.facts.count + state.initial_facts.count + state.trace_facts.count + state.trace.count
            return exhausted if:
                tree.total_trace_fact_snapshots > PROOF_JSON_MAX_TRACE_FACT_SNAPSHOTS
                state_snapshot_charge > PROOF_JSON_MAX_TRACE_FACT_SNAPSHOTS - tree.total_trace_fact_snapshots
            tree.total_trace_fact_snapshots <- tree.total_trace_fact_snapshots + state_snapshot_charge
            snapshot_facts: mutable darray[Ast::Expr] @r = []
            snapshot_facts.extend(state.facts)
            snapshot_initial_facts: mutable darray[Ast::Expr] @r = []
            snapshot_initial_facts.extend(state.initial_facts)
            snapshot_trace: mutable darray[ProofTacticStep] @r = []
            snapshot_trace.extend(state.trace)
            snapshot_trace_facts: mutable darray[Ast::Expr] @r = []
            snapshot_trace_facts.extend(state.trace_facts)
            tree.states.push(ProofTacticState{facts: snapshot_facts, goal: state.goal, solved: state.solved, action_count: state.action_count, last_action: state.last_action, last_reason: state.last_reason, initial_facts: snapshot_initial_facts, initial_goal: state.initial_goal, trace: snapshot_trace, trace_facts: snapshot_trace_facts, pending_argument: state.pending_argument, pending_secondary: state.pending_secondary, pending_has_argument: state.pending_has_argument, pending_has_secondary: state.pending_has_secondary, pending_argument_index: state.pending_argument_index, pending_has_argument_index: state.pending_has_argument_index, pending_detail: state.pending_detail, budget_exhausted: state.budget_exhausted, branch_terminal: state.branch_terminal, action_quota: state.action_quota, snapshot_quota: state.snapshot_quota, solver_quota: state.solver_quota, preflight_quota: state.preflight_quota, source_quota: state.source_quota, solver_work_used: state.solver_work_used, preflight_work_used: state.preflight_work_used, source_work_used: state.source_work_used, action_ast_quota: state.action_ast_quota, action_ast_work_used: state.action_ast_work_used})
            tree.left.push(branch_left_node)
            tree.right.push(branch_right_node)
            tree.has_branch.push(branch_present)
            # Recursive returns carry the already replayed certificate for this node. Run the
            # independent whole-tree pass once, after the root has been appended; repeating it
            # for every child return rescans the growing postorder prefix quadratically.
            if depth == 0:
                tree_certificate_ok: bool = (proof_tactic_json_tree_certificate_replay(tree, tree_node, annotations) can Global{Read,Write})
                certificate_ok <- tree_certificate_ok
                branch_certificate_ok <- tree_certificate_ok if branch_present
            work_exhausted: bool = state.budget_exhausted or tree.total_actions >= PROOF_JSON_MAX_TOTAL_ACTIONS or tree.total_trace_fact_snapshots >= PROOF_JSON_MAX_TRACE_FACT_SNAPSHOTS or tree.total_expression_work >= PROOF_JSON_EXPRESSION_WORK_LIMIT or tree.total_kernel_replay_work >= ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT or tree.total_solver_work >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS or tree.total_solver_preflight_work >= PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT or tree.total_action_ast_work >= PROOF_JSON_ACTION_AST_WORK_LIMIT
            result_reason: sview = "portable tactic script admitted" if certificate_ok else "portable tactic script exhausted an aggregate work budget" if work_exhausted else "portable tactic script did not close an independently replayable goal"
            return ProofTacticJsonResult{valid: true, solved: state.solved or branch_certificate_ok, trace_replayed: trace_ok, kernel_trace_replayed: kernel_trace_ok, kernel_replayed: kernel_ok, certificate_replayed: certificate_ok, branch_present: branch_present, branch_certificate_replayed: branch_certificate_ok, action_count: state.action_count, accepted_count: accepted_count, reason: result_reason, tree_node: tree_node}

    private:
        # Candidate engine for the checked-view wrapper below. Keep the report-taking form
        # private: a caller-assembled or subsequently modified ProofReport is not source
        # authority, even when its kernel roots happen to match the imported JSON state.
        def proof_tactic_json_run_source_candidate[@r](root: JsonValueHandle[r], source_state: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r, state: mutable ProofTacticState& @r, tree: mutable ProofTacticJsonTree& @r, scratch: mutable darray[ProofTacticJsonBranchScratch]& @r, report: ProofReport&, goal_id: usize) -> ProofTacticJsonResult can[Global.Read, Global.Write]:
            invalid: ProofTacticJsonResult = ProofTacticJsonResult{reason: "invalid source-bound proof script"}
            kernel_exhausted: ProofTacticJsonResult = ProofTacticJsonResult{reason: "source-bound tactic import exhausted the aggregate kernel work budget"}
            json_exhausted: ProofTacticJsonResult = ProofTacticJsonResult{..invalid, reason: "source-bound script exhausted its JSON decode-work budget"}
            action_exhausted: ProofTacticJsonResult = ProofTacticJsonResult{..invalid, reason: "source-bound tactic import exhausted its aggregate action work budget"}
            return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if tree.states.count != 0 or tree.left.count != 0 or tree.right.count != 0 or tree.has_branch.count != 0 or tree.total_actions != 0 or tree.total_trace_fact_snapshots != 0 or tree.total_kernel_replay_work != 0 or tree.total_solver_work != 0 or tree.total_solver_preflight_work != 0 or tree.total_action_ast_work != 0 or tree.primitive_operator_mask != 0 or tree.primitive_operator_mask_initialized
            format_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "format", &tree.total_expression_work)
            return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            format: (known: bool, value: sview) @r = proof_tactic_json_text(format_field.value)
            initial_present: bool = proof_tactic_json_has_with_work(root, "initial", &tree.total_expression_work)
            return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if not format_field.known or not format.known or format.value != "elisa-proof-tactics-v1"
            return json_exhausted if not proof_tactic_json_expression_charge(&tree.total_expression_work, sview_len(format.value))
            return invalid if initial_present or goal_id >= report.results.goal_attempts.count
            if not proof_tactic_json_parse_annotations_with_work(root, annotations, &tree.total_expression_work):
                return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
                return invalid
            return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            # The JSON annotations are syntax-validated input only. In source-bound mode the
            # imported compiler annotations are authoritative; otherwise a script could relabel
            # an erased `exists` block as `forall` and unlock universal-only instantiation.
            annotations.clear()
            for annotation in report.source.source_annotations |annotations|:
                annotations.push(annotation)
            attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
            # Resource safety is represented by an arena transition certificate. Its source AST
            # mirror is intentionally the inert proposition `true`, so proposition tactics must
            # never be allowed to stand in for replay of that resource trace.
            return invalid if attempt.rule == "resource-safety"
            facts: mutable darray[Ast::Expr] = []
            return invalid if attempt.facts_start > report.analysis_1.certificate_facts.count or attempt.facts_count > report.analysis_1.certificate_facts.count - attempt.facts_start
            facts_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(source_state, "facts", &tree.total_expression_work)
            goal_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(source_state, "goal", &tree.total_expression_work)
            return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if not facts_field.known or not goal_field.known
            if not proof_tactic_json_expr_list_with_work(source_state, "facts", 0, &facts, &tree.total_expression_work, 0):
                return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
                return invalid
            goal: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(goal_field.value, &tree.total_expression_work, 0)
            return json_exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if not goal.known or facts.count != attempt.facts_count
            # Source-bound tactics share the contract checker’s operator boundary: an imported
            # source overload must never be reinterpreted by the source-neutral tactic kernel.
            return action_exhausted if not proof_tactic_json_charge_action_ast_work(facts, goal.value, Ast::Expr.Absent, false, Ast::Expr.Absent, false, report.source.source_annotations, &tree.total_action_ast_work)
            return invalid if proof_source_expression_has_overloaded_operator(goal.value, report.source.source_primitive_operator_mask, 0)
            for fact in facts |fact, report|:
                return invalid if proof_source_expression_has_overloaded_operator(fact, report.source.source_primitive_operator_mask, 0)
            source_state_matches: bool = proof_tactic_source_state_kernel_matches_with_trace_work(report, goal_id, facts, goal.value, report.source.source_annotations, &tree.total_kernel_replay_work)
            return kernel_exhausted if not source_state_matches and tree.total_kernel_replay_work >= ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
            return invalid if not source_state_matches
            proof_tactic_json_initialize_state(state, facts, goal.value, "state initialized from imported source goal")
            return (proof_tactic_json_run_actions(root, annotations, state, tree, scratch, 0, true, true) can Global{Read,Write})

    public:
        # Source-bound tactic admission begins from an opaque checked view, never a bare report.
        # The view authenticates the report against parser-origin source and this goal's source
        # admission snapshot before the source-neutral candidate replay can be exposed.
        def proof_tactic_json_run_source[@r, @view](root: JsonValueHandle[r], source_state: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r, state: mutable ProofTacticState& @r, tree: mutable ProofTacticJsonTree& @r, scratch: mutable darray[ProofTacticJsonBranchScratch]& @r, checked_view: ProofCheckedView[view]& @view, goal_id: usize) -> ProofTacticJsonResult can[Global.Read, Global.Write]:
            invalid: ProofTacticJsonResult = ProofTacticJsonResult{reason: "source-bound proof script requires an admitted checked-view goal"}
            return invalid if:
                not proof_checked_view_source_validated(checked_view)
                not proof_checked_view_goal_source_admissible(checked_view, goal_id)
                not proof_checked_view_goal_facts_source_admissible(checked_view, goal_id)
            report: ProofReport& = proof_checked_view_report(checked_view)
            return (proof_tactic_json_run_source_candidate(root, source_state, annotations, state, tree, scratch, report, goal_id) can Global{Read,Write})

    public:
        def proof_tactic_json_run[@r](root: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r, state: mutable ProofTacticState& @r, tree: mutable ProofTacticJsonTree& @r, scratch: mutable darray[ProofTacticJsonBranchScratch]& @r) -> ProofTacticJsonResult can[Global.Read, Global.Write]:
            invalid: ProofTacticJsonResult = ProofTacticJsonResult{reason: "invalid proof script"}
            exhausted: ProofTacticJsonResult = ProofTacticJsonResult{..invalid, reason: "tactic script exhausted its JSON decode-work budget"}
            return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if tree.states.count != 0 or tree.left.count != 0 or tree.right.count != 0 or tree.has_branch.count != 0 or tree.total_actions != 0 or tree.total_trace_fact_snapshots != 0 or tree.total_kernel_replay_work != 0 or tree.total_solver_work != 0 or tree.total_solver_preflight_work != 0 or tree.total_action_ast_work != 0 or tree.primitive_operator_mask != 0 or tree.primitive_operator_mask_initialized
            format_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "format", &tree.total_expression_work)
            return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            format: (known: bool, value: sview) @r = proof_tactic_json_text(format_field.value)
            return invalid if not format_field.known or not format.known or format.value != "elisa-proof-tactics-v1"
            return exhausted if not proof_tactic_json_expression_charge(&tree.total_expression_work, sview_len(format.value))
            initial_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "initial", &tree.total_expression_work)
            return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if not initial_field.known
            facts_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(initial_field.value, "facts", &tree.total_expression_work)
            goal_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(initial_field.value, "goal", &tree.total_expression_work)
            return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if not facts_field.known or not goal_field.known
            facts: mutable darray[Ast::Expr] = []
            if not proof_tactic_json_expr_list_with_work(initial_field.value, "facts", 0, &facts, &tree.total_expression_work, 0):
                return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
                return invalid
            goal: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(goal_field.value, &tree.total_expression_work, 0)
            return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return invalid if not goal.known
            if not proof_tactic_json_parse_annotations_with_work(root, annotations, &tree.total_expression_work):
                return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
                return invalid
            return exhausted if tree.total_expression_work > PROOF_JSON_EXPRESSION_WORK_LIMIT
            proof_tactic_json_initialize_state(state, facts, goal.value, "state initialized from portable proof script")
            return (proof_tactic_json_run_actions(root, annotations, state, tree, scratch, 0, true, false) can Global{Read,Write})
