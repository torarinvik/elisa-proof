# Portable proof-state script import for AI/editor clients.
#
# The wire format intentionally contains ordinary JSON and the same expression shape already
# emitted by `--json`.  This module turns that data back into compiler AST values inside a fresh
# Node.Store, applies the typed Elisa-native actions, and leaves final admission to the normal
# tactic trace and independent source-neutral kernel checks.  Unknown fields are ignored, but
# unknown expression kinds, malformed values, and branch actions without child certificates fail
# closed.
extend ElisaProof:
    public:
        # Keep JSON integers inside the exact binary64 range, and bound imported tactic work.
        const PROOF_JSON_MAX_SAFE_INTEGER: f64 = 9007199254740991.0
        const PROOF_JSON_MAX_TREE_NODES: usize = 65536
        const PROOF_JSON_BRANCH_DEPTH_LIMIT: usize = 32
        const PROOF_TACTIC_WORKSPACE_ARENA_BYTES: usize = 1048576
        struct ProofTacticJsonResult:
            valid: mutable bool = false
            solved: bool = false
            trace_replayed: bool = false
            kernel_trace_replayed: bool = false
            kernel_replayed: bool = false
            certificate_replayed: bool = false
            branch_present: bool = false
            branch_certificate_replayed: bool = false
            action_count: usize = 0
            accepted_count: usize = 0
            reason: mutable sview = ""
            tree_node: usize = 0
        # Branches are stored as a flat postorder tree. A parent is appended after both children,
        # so the independent verifier can validate arbitrary nesting with a bounded iterative
        # pass instead of trusting recursive host-language calls or mutable AST-store references.
        struct ProofTacticJsonTree:
            states: mutable darray[ProofTacticState]
            left: mutable darray[usize]
            right: mutable darray[usize]
            has_branch: mutable darray[bool]

        # One slot owns both branch states as distinct fields, making their non-aliasing
        # structural instead of relying on arithmetic analysis of adjacent array indices.
        struct ProofTacticJsonBranchScratch:
            left: mutable ProofTacticState
            right: mutable ProofTacticState

        def proof_tactic_state_in_arena[@r](arena: mutable Arena& @r) -> mutable ProofTacticState& @r:
            in arena:
                empty: mutable darray[Ast::Expr] = []
                return new[r] proof_tactic_state(&empty, Ast::Expr.Invalid)

        def proof_tactic_tree_in_arena[@r](arena: mutable Arena& @r) -> mutable ProofTacticJsonTree& @r:
            in arena:
                return new[r] ProofTacticJsonTree{states: [], left: [], right: [], has_branch: []}

        def proof_tactic_json_field[@r](value: JsonValueHandle[r], key: sview) -> (known: bool, value: JsonValueHandle[r]):
            return ElisaProofJson::field(value, key)

        def proof_tactic_json_text[@r](value: JsonValueHandle[r]) -> (known: bool, value: sview) @r:
            return (false, "") if ElisaProofJson::kind(value) != JsonKind.STRING
            empty: sview = ""
            text: sview @r = try ElisaProofJson::as_string(value) else empty
            return (true, text)

        def proof_tactic_json_bool[@r](value: JsonValueHandle[r]) -> (known: bool, value: bool):
            return (false, false) if ElisaProofJson::kind(value) != JsonKind.BOOL
            flag: bool = try ElisaProofJson::as_bool(value) else false
            return (true, flag)

        def proof_tactic_json_integer[@r](value: JsonValueHandle[r]) -> (known: bool, value: i64):
            return (false, 0) if ElisaProofJson::kind(value) != JsonKind.NUMBER
            number: f64 = try ElisaProofJson::as_number(value) else 0.0
            # JSON numbers have already been rounded to f64. An integer round trip
            # cannot detect that 9007199254740993 was rounded to 9007199254740992.
            # Reject the entire ambiguous range, including its boundary, before a
            # source obligation can be reconstructed as a different proposition.
            return (false, 0) if not (number >= -PROOF_JSON_MAX_SAFE_INTEGER and number <= PROOF_JSON_MAX_SAFE_INTEGER)
            integer: i64 = number.i64()
            return (true, integer) if integer.f64() == number
            return (false, 0)

        def proof_tactic_json_line[@r](value: JsonValueHandle[r]) -> (known: bool, value: u32):
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(value)
            return (false, 0) if not parsed.known or parsed.value < 0 or parsed.value > ElisaProofKernelCore::PROOF_KERNEL_U32_MAX
            return (true, parsed.value.u32())

        def proof_tactic_json_operator[@r](value: JsonValueHandle[r]) -> (known: bool, value: TokenKind):
            parsed: (known: bool, text: sview) @r = proof_tactic_json_text(value)
            return (false, TokenKind.Eof) if not parsed.known
            operator: mutable TokenKind = TokenKind.Eof
            operator <- TokenKind.Plus if parsed.text == "+"
            operator <- TokenKind.Minus if parsed.text == "-"
            operator <- TokenKind.Star if parsed.text == "*"
            operator <- TokenKind.Slash if parsed.text == "/"
            operator <- TokenKind.Percent if parsed.text == "%"
            operator <- TokenKind.EqEq if parsed.text == "=="
            operator <- TokenKind.BangEq if parsed.text == "!="
            operator <- TokenKind.Lt if parsed.text == "<"
            operator <- TokenKind.Gt if parsed.text == ">"
            operator <- TokenKind.LtEq if parsed.text == "<="
            operator <- TokenKind.GtEq if parsed.text == ">="
            operator <- TokenKind.And if parsed.text == "and"
            operator <- TokenKind.Or if parsed.text == "or"
            operator <- TokenKind.FatArrow if parsed.text == "=>"
            operator <- TokenKind.Not if parsed.text == "not"
            operator <- TokenKind.In if parsed.text == "in"
            operator <- TokenKind.Is if parsed.text == "is"
            operator <- TokenKind.As if parsed.text == "as"
            operator <- TokenKind.Pipe if parsed.text == "|"
            operator <- TokenKind.Caret if parsed.text == "^"
            operator <- TokenKind.Ampersand if parsed.text == "&"
            operator <- TokenKind.LShift if parsed.text == "<<"
            operator <- TokenKind.RShift if parsed.text == ">>"
            operator <- TokenKind.RangeLt if parsed.text == "range_lt"
            operator <- TokenKind.RangeLe if parsed.text == "range_le"
            return (operator != TokenKind.Eof, operator)


        def proof_tactic_json_parse_annotations[@r](root: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(root, "annotations")
            return true if not field.known
            return false if not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, annotations|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "name")
                line_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "line")
                name: (known: bool, value: sview) @r = proof_tactic_json_text(name_field.value)
                return false if not name_field.known or not name.known
                line: mutable u32 = 0
                if line_field.known:
                    parsed_line: (known: bool, value: u32) = proof_tactic_json_line(line_field.value)
                    return false if not parsed_line.known
                    line <- parsed_line.value
                annotations.push(Ast::EnumAnnotation{owner: "__contract_quantifier", name: name.value, line: line})
            return true

        def proof_tactic_json_action(state: mutable ProofTacticState&, action: sview, argument: Ast::Expr, has_argument: bool, secondary: Ast::Expr, has_secondary: bool, argument_index: usize, has_argument_index: bool, annotations: mutable darray[Ast::EnumAnnotation]&, source_bound: bool) -> bool can[Global.Read, Global.Write]:
            return false if action == "split" or action == "cases"
            return false if proof_float_mode and action != "assumption" and action != "exact"
            return proof_tactic_assumption(state, annotations) if action == "assumption"
            return proof_tactic_exact(state, annotations) if action == "exact"
            return proof_tactic_decide(state, annotations) if action == "decide"
            return proof_tactic_intro(state) if action == "intro"
            return proof_tactic_apply(state, annotations) if action == "apply"
            return proof_tactic_simplify_source_bound(state, annotations) if source_bound and action == "simp"
            return proof_tactic_simplify(state, annotations) if action == "simp"
            return proof_tactic_have(state, argument, annotations) if action == "have" and has_argument
            return proof_tactic_instantiate(state, argument_index, argument, annotations) if action == "instantiate" and has_argument and has_argument_index
            return proof_tactic_rewrite_source_bound(state, argument, secondary, annotations) if source_bound and action == "rewrite" and has_argument and has_secondary
            return proof_tactic_rewrite(state, argument, secondary) if action == "rewrite" and has_argument and has_secondary
            return proof_tactic_left(state) if action == "left"
            return proof_tactic_right(state) if action == "right"
            return false

        def proof_tactic_json_branch_scripts[@r](item: JsonValueHandle[r]) -> (known: bool, left: JsonValueHandle[r], right: JsonValueHandle[r]):
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "branches")
            return (false, ElisaProofJson::null_value(item), ElisaProofJson::null_value(item)) if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return (false, ElisaProofJson::null_value(field.value), ElisaProofJson::null_value(field.value)) if count != 2
            left: JsonValueHandle[r] = try ElisaProofJson::at(field.value, 0) else ElisaProofJson::null_value(field.value)
            right: JsonValueHandle[r] = try ElisaProofJson::at(field.value, 1) else ElisaProofJson::null_value(field.value)
            return (ElisaProofJson::is_object(left) and ElisaProofJson::is_object(right), left, right)

        # Verify a complete imported proof tree using only source-neutral replay. The tree is
        # deliberately required to be postorder and rooted at its final node; this makes the
        # ordering and every child edge part of the certificate rather than an interpreter detail.
        def proof_tactic_json_tree_certificate_replay(tree: ProofTacticJsonTree&, root: usize, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            return false if tree.states.count == 0
            return false if tree.left.count != tree.states.count or tree.right.count != tree.states.count or tree.has_branch.count != tree.states.count
            return false if root != tree.states.count - 1
            validity: mutable darray[bool] = []
            validity.resize(tree.states.count)
            cursor: mutable usize = 0
            while cursor < tree.states.count |cursor, tree, validity|:
                if not tree.has_branch[cursor]:
                    leaf: mutable ProofTacticState = tree.states[cursor]
                    validity[cursor] <- proof_tactic_kernel_certificate_replay(&leaf, annotations)
                else:
                    left_index: usize = tree.left[cursor]
                    right_index: usize = tree.right[cursor]
                    return false if left_index >= cursor or right_index >= cursor
                    return false if not validity[left_index] or not validity[right_index]
                    parent: mutable ProofTacticState = tree.states[cursor]
                    left: mutable ProofTacticState = tree.states[left_index]
                    right: mutable ProofTacticState = tree.states[right_index]
                    validity[cursor] <- proof_tactic_kernel_branch_transition_replay(&parent, &left, &right, annotations)
                cursor <- cursor + 1
            return validity[root]

        def proof_tactic_json_source_fingerprint[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, value: u32):
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(root, "source_fingerprint")
            return (false, true, 0) if not field.known
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(field.value)
            return (true, parsed.known and parsed.value >= 0 and parsed.value <= ElisaProofKernelCore::PROOF_KERNEL_U32_MAX, parsed.value.u32())

        def proof_tactic_json_target[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, goal_id: usize):
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(root, "target")
            return (false, true, 0) if not field.known
            goal_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(field.value, "goal_id")
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(goal_field.value)
            return (true, parsed.known and parsed.value >= 0, parsed.value.usize())

        def proof_tactic_json_target_fingerprint[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, value: u32):
            target_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(root, "target")
            return (false, true, 0) if not target_field.known
            fingerprint_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(target_field.value, "goal_fingerprint")
            return (false, true, 0) if not fingerprint_field.known
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(fingerprint_field.value)
            return (true, parsed.known and parsed.value >= 0 and parsed.value <= ElisaProofKernelCore::PROOF_KERNEL_U32_MAX, parsed.value.u32())

        def proof_tactic_json_initialize_state[@r](state: mutable ProofTacticState& @r, facts: darray[Ast::Expr]&, goal: Ast::Expr, reason: sview) -> void:
            state.facts <- []
            state.facts.extend(facts)
            state.initial_facts <- []
            state.initial_facts.extend(facts)
            state.goal <- goal
            state.initial_goal <- goal
            state.solved <- false
            state.action_count <- 0
            state.last_action <- "start"
            state.last_reason <- reason
            state.trace <- []
            state.trace_facts <- []
            state.pending_argument <- Ast::Expr.Absent
            state.pending_secondary <- Ast::Expr.Absent
            state.pending_has_argument <- false
            state.pending_has_secondary <- false
            state.pending_argument_index <- 0
            state.pending_has_argument_index <- false
            state.pending_detail <- ""

        def proof_tactic_json_run_actions[@r](root: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r, state: mutable ProofTacticState& @r, tree: mutable ProofTacticJsonTree& @r, scratch: mutable darray[ProofTacticJsonBranchScratch]& @r, depth: usize, allow_branch: bool, source_bound: bool) -> ProofTacticJsonResult can[Global.Read, Global.Write]:
            invalid: ProofTacticJsonResult = ProofTacticJsonResult{reason: "invalid proof script"}
            # Budget exhaustion is its own non-proof outcome, distinct from a malformed document.
            exhausted: ProofTacticJsonResult = ProofTacticJsonResult{..invalid, reason: "tactic script exhausted its branch depth or tree node budget"}
            return exhausted if tree.states.count >= PROOF_JSON_MAX_TREE_NODES
            actions_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(root, "actions")
            return invalid if not actions_field.known or not ElisaProofJson::is_array(actions_field.value)
            count: i64 = ElisaProofJson::array_len(actions_field.value)
            return invalid if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            accepted_count: mutable usize = 0
            branch_certificate_ok: mutable bool = false
            branch_present: mutable bool = false
            branch_trace_ok: mutable bool = true
            branch_kernel_trace_ok: mutable bool = true
            branch_kernel_ok: mutable bool = false
            branch_left_node: mutable usize = 0
            branch_right_node: mutable usize = 0
            for index in 0..<count |index, actions_field, state, annotations, accepted_count, source_bound|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(actions_field.value, index) else ElisaProofJson::null_value(actions_field.value)
                action_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "action")
                action: (known: bool, value: sview) @r = proof_tactic_json_text(action_field.value)
                return invalid if not action_field.known or not action.known
                argument_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "argument")
                secondary_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "secondary")
                argument: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(argument_field.value) if argument_field.known else (false, Ast::Expr.Absent)
                secondary: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(secondary_field.value) if secondary_field.known else (false, Ast::Expr.Absent)
                index_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "argument_index")
                parsed_index: (known: bool, value: i64) = proof_tactic_json_integer(index_field.value) if index_field.known else (false, 0)
                expected_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "accepted")
                expected: (known: bool, value: bool) = proof_tactic_json_bool(expected_field.value) if expected_field.known else (true, true)
                return invalid if (argument_field.known and not argument.known) or (secondary_field.known and not secondary.known) or (index_field.known and (not parsed_index.known or parsed_index.value < 0)) or (expected_field.known and not expected.known)
                actual: mutable bool = false
                if action.value == "split" or action.value == "cases":
                    return invalid if not allow_branch
                    return invalid if index + 1 != count
                    return exhausted if depth >= PROOF_JSON_BRANCH_DEPTH_LIMIT
                    branches: (known: bool, left: JsonValueHandle[r], right: JsonValueHandle[r]) = proof_tactic_json_branch_scripts(item)
                    return invalid if not branches.known
                    # Borrow distinct fields from one preallocated region-owned slot. Stack
                    # child values cannot satisfy the shared @r lifetime of recursive calls.
                    return exhausted if depth >= scratch.count
                    left_branch_state: mutable ProofTacticState& = &scratch[depth].left
                    right_branch_state: mutable ProofTacticState& = &scratch[depth].right
                    actual <- proof_tactic_split(state, left_branch_state, right_branch_state) if action.value == "split" and branches.known
                    actual <- proof_tactic_cases(state, left_branch_state, right_branch_state) if action.value == "cases" and branches.known
                    if actual:
                        branch_present <- true
                        return invalid if ElisaProofJson::has(branches.left, "initial") or ElisaProofJson::has(branches.left, "target") or ElisaProofJson::has(branches.right, "initial") or ElisaProofJson::has(branches.right, "target")
                        left_result: ProofTacticJsonResult = proof_tactic_json_run_actions(branches.left, annotations, left_branch_state, tree, scratch, depth + 1, true, source_bound)
                        # An invalid child invalidates the whole script and keeps its own reason; a
                        # malformed or exhausted branch must not be reported as a merely open goal.
                        return left_result if not left_result.valid
                        right_result: ProofTacticJsonResult = proof_tactic_json_run_actions(branches.right, annotations, right_branch_state, tree, scratch, depth + 1, true, source_bound)
                        return right_result if not right_result.valid
                        branch_trace_ok <- left_result.trace_replayed and right_result.trace_replayed
                        branch_kernel_trace_ok <- left_result.kernel_trace_replayed and right_result.kernel_trace_replayed
                        branch_kernel_ok <- left_result.kernel_replayed and right_result.kernel_replayed
                        branch_left_node <- left_result.tree_node
                        branch_right_node <- right_result.tree_node
                        branch_certificate_ok <- left_result.valid and right_result.valid and left_result.certificate_replayed and right_result.certificate_replayed and proof_tactic_kernel_branch_transition_replay(state, left_branch_state, right_branch_state, annotations)
                else:
                    actual <- proof_tactic_json_action(state, action.value, argument.value, argument_field.known, secondary.value, secondary_field.known, parsed_index.value.usize(), index_field.known, annotations, source_bound)
                # A refused action is a well-formed script whose claimed outcome is false; report it
                # separately from malformed input so a client can tell which part to repair.
                contradicted: ProofTacticJsonResult = ProofTacticJsonResult{..invalid, action_count: state.action_count, accepted_count: accepted_count, reason: "tactic action outcome contradicted the script's expected acceptance"}
                return contradicted if actual != expected.value
                accepted_count <- accepted_count + 1 if actual
            trace_ok: mutable bool = proof_tactic_replay(state, annotations)
            kernel_trace_ok: mutable bool = proof_tactic_kernel_trace_replay(state, annotations)
            kernel_ok: mutable bool = proof_tactic_kernel_replay(state, annotations)
            certificate_ok: mutable bool = proof_tactic_kernel_certificate_replay(state, annotations)
            if branch_present:
                trace_ok <- trace_ok and branch_trace_ok
                kernel_trace_ok <- kernel_trace_ok and branch_kernel_trace_ok
                kernel_ok <- branch_kernel_ok
                certificate_ok <- branch_certificate_ok
            tree_node: usize = tree.states.count
            snapshot_facts: mutable darray[Ast::Expr] @r = []
            snapshot_facts.extend(state.facts)
            snapshot_initial_facts: mutable darray[Ast::Expr] @r = []
            snapshot_initial_facts.extend(state.initial_facts)
            snapshot_trace: mutable darray[ProofTacticStep] @r = []
            snapshot_trace.extend(state.trace)
            snapshot_trace_facts: mutable darray[Ast::Expr] @r = []
            snapshot_trace_facts.extend(state.trace_facts)
            tree.states.push(ProofTacticState{facts: snapshot_facts, goal: state.goal, solved: state.solved, action_count: state.action_count, last_action: state.last_action, last_reason: state.last_reason, initial_facts: snapshot_initial_facts, initial_goal: state.initial_goal, trace: snapshot_trace, trace_facts: snapshot_trace_facts, pending_argument: state.pending_argument, pending_secondary: state.pending_secondary, pending_has_argument: state.pending_has_argument, pending_has_secondary: state.pending_has_secondary, pending_argument_index: state.pending_argument_index, pending_has_argument_index: state.pending_has_argument_index, pending_detail: state.pending_detail})
            tree.left.push(branch_left_node)
            tree.right.push(branch_right_node)
            tree.has_branch.push(branch_present)
            tree_certificate_ok: bool = proof_tactic_json_tree_certificate_replay(tree, tree_node, annotations)
            certificate_ok <- tree_certificate_ok
            branch_certificate_ok <- tree_certificate_ok if branch_present
            return ProofTacticJsonResult{valid: true, solved: state.solved or branch_certificate_ok, trace_replayed: trace_ok, kernel_trace_replayed: kernel_trace_ok, kernel_replayed: kernel_ok, certificate_replayed: certificate_ok, branch_present: branch_present, branch_certificate_replayed: branch_certificate_ok, action_count: state.action_count, accepted_count: accepted_count, reason: "portable tactic script admitted" if certificate_ok else "portable tactic script did not close an independently replayable goal", tree_node: tree_node}

        # Source-bound scripts start from the exact facts and goal captured by the imported
        # checker. The JSON document cannot replace that state, which prevents a valid proof of a
        # different proposition from being relabeled as a proof of a source obligation.
        def proof_tactic_json_run_source[@r](root: JsonValueHandle[r], source_state: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r, state: mutable ProofTacticState& @r, tree: mutable ProofTacticJsonTree& @r, scratch: mutable darray[ProofTacticJsonBranchScratch]& @r, report: ProofReport&, goal_id: usize) -> ProofTacticJsonResult can[Global.Read, Global.Write]:
            invalid: ProofTacticJsonResult = ProofTacticJsonResult{reason: "invalid source-bound proof script"}
            format_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(root, "format")
            format: (known: bool, value: sview) @r = proof_tactic_json_text(format_field.value)
            return invalid if not format_field.known or not format.known or format.value != "elisa-proof-tactics-v1"
            return invalid if ElisaProofJson::has(root, "initial")
            return invalid if goal_id >= report.goal_attempts.count
            return invalid if not proof_tactic_json_parse_annotations(root, annotations)
            # The JSON annotations are syntax-validated input only. In source-bound mode the
            # imported compiler annotations are authoritative; otherwise a script could relabel
            # an erased `exists` block as `forall` and unlock universal-only instantiation.
            annotations.clear()
            for annotation in report.source_annotations |annotations|:
                annotations.push(annotation)
            attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
            # Resource safety is represented by an arena transition certificate. Its source AST
            # mirror is intentionally the inert proposition `true`, so proposition tactics must
            # never be allowed to stand in for replay of that resource trace.
            return invalid if attempt.rule == "resource-safety"
            facts: mutable darray[Ast::Expr] = []
            return invalid if attempt.facts_start > report.certificate_facts.count or attempt.facts_count > report.certificate_facts.count - attempt.facts_start
            facts_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(source_state, "facts")
            goal_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(source_state, "goal")
            return invalid if not facts_field.known or not goal_field.known
            return invalid if not proof_tactic_json_expr_list(source_state, "facts", 0, &facts)
            goal: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(goal_field.value)
            return invalid if not goal.known or facts.count != attempt.facts_count
            # Source-bound tactics share the contract checker’s operator boundary: an imported
            # source overload must never be reinterpreted by the source-neutral tactic kernel.
            return invalid if proof_source_expression_has_overloaded_operator(goal.value, report.source_primitive_operator_mask, 0)
            for fact in facts |fact, report|:
                return invalid if proof_source_expression_has_overloaded_operator(fact, report.source_primitive_operator_mask, 0)
            return invalid if not proof_tactic_source_state_kernel_matches(report, goal_id, facts, goal.value)
            proof_tactic_json_initialize_state(state, facts, goal.value, "state initialized from imported source goal")
            return proof_tactic_json_run_actions(root, annotations, state, tree, scratch, 0, true, true)

        def proof_tactic_json_run[@r](root: JsonValueHandle[r], annotations: mutable darray[Ast::EnumAnnotation]& @r, state: mutable ProofTacticState& @r, tree: mutable ProofTacticJsonTree& @r, scratch: mutable darray[ProofTacticJsonBranchScratch]& @r) -> ProofTacticJsonResult can[Global.Read, Global.Write]:
            invalid: ProofTacticJsonResult = ProofTacticJsonResult{reason: "invalid proof script"}
            format_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(root, "format")
            format: (known: bool, value: sview) @r = proof_tactic_json_text(format_field.value)
            return invalid if not format_field.known or not format.known or format.value != "elisa-proof-tactics-v1"
            initial_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(root, "initial")
            facts_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(initial_field.value, "facts")
            goal_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(initial_field.value, "goal")
            return invalid if not initial_field.known or not facts_field.known or not goal_field.known
            facts: mutable darray[Ast::Expr] = []
            return invalid if not proof_tactic_json_expr_list(initial_field.value, "facts", 0, &facts)
            goal: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(goal_field.value)
            return invalid if not goal.known
            return invalid if not proof_tactic_json_parse_annotations(root, annotations)
            proof_tactic_json_initialize_state(state, facts, goal.value, "state initialized from portable proof script")
            return proof_tactic_json_run_actions(root, annotations, state, tree, scratch, 0, true, false)
