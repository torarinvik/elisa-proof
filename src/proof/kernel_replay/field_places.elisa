const PROOF_KERNEL_REPLAY_FIELD_PLACE_LIMIT: usize = 4

extend ElisaProofKernelReplay:
    private:
        # Replacement work inside one goal attempt consumes the report-level meter. Preserve the
        # unsupported sentinel so every caller fails closed if a shared replacement walk exhausts it.
        def proof_kernel_replay_replace_exact_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, from_root: usize, replacement_root: usize, work_used: mutable usize&, depth: usize) -> (changed: bool, value: usize):
            exhausted: mutable bool = false
            result: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_with_work(nodes, children, root, from_root, replacement_root, work_used, &exhausted, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT, depth)
            if exhausted:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return (true, ElisaProofKernelCore::add_node(nodes, "unsupported", "replacement-work", 0, 0, 0, 0, 0, 0, "", ""))
            result

        # Mirror of `proof_field_place_goal`: generalize each witnessed primitive scalar field
        # place over a plain name, and each witnessed pure call result, to a fresh reserved name in the goal and every fact, then
        # decide the generalized goal. Instantiating the names back gives the original goal, so
        # this is sound for any fixed values; the witness keeps protocol dispatch out.
        def proof_kernel_replay_field_place_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            for marker_index in 0..<PROOF_KERNEL_REPLAY_FIELD_PLACE_LIMIT |marker_index, nodes, children, facts, goal_root, work_used|:
                probe_name: sview = proof_kernel_replay_field_place_name(marker_index)
                return false if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(probe_name))
                probe: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, probe_name, "")
                return false if not proof_kernel_replay_valid(nodes, probe)
                return false if proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, probe, probe, work_used, 0).changed
                for fact in facts |nodes, children, probe, work_used|:
                    return false if proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, probe, probe, work_used, 0).changed
            places: mutable darray[usize] = []
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            proof_kernel_replay_collect_field_places(nodes, children, facts, goal_root, &places, &markers, &markers_ready, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts |fact, nodes, children, facts, places, markers, markers_ready, work_used|:
                proof_kernel_replay_collect_field_places(nodes, children, facts, fact, &places, &markers, &markers_ready, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if places.count == 0
            rewritten_goal: mutable usize = goal_root
            rewritten_facts: mutable darray[usize] = []
            for fact in facts |fact, rewritten_facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                rewritten_facts.push(fact)
            for index in 0..<places.count |index, nodes, children, places, rewritten_goal, rewritten_facts, work_used|:
                fresh_name: sview = proof_kernel_replay_field_place_name(index)
                return false if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(fresh_name))
                fresh: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, fresh_name, "")
                rewritten_goal <- proof_kernel_replay_replace_exact_with_goal_work(nodes, children, rewritten_goal, places[index], fresh, work_used, 0).value
                next_facts: mutable darray[usize] = []
                for fact in rewritten_facts |fact, nodes, children, places, index, fresh, next_facts, work_used|:
                    next_facts.push(proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, places[index], fresh, work_used, 0).value)
                rewritten_facts <- next_facts
                # A later place containing this one now reads with the fresh name.
                next_places: mutable darray[usize] = []
                for later in places |later, nodes, children, places, index, fresh, next_places, work_used|:
                    next_places.push(proof_kernel_replay_replace_exact_with_goal_work(nodes, children, later, places[index], fresh, work_used, 0).value)
                places <- next_places
            return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, rewritten_facts, rewritten_goal, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_field_place_name(index: usize) -> sview:
            return "__elisa_field_place_0" if index == 0
            return "__elisa_field_place_1" if index == 1
            return "__elisa_field_place_2" if index == 2
            "__elisa_field_place_3"

        # `name.field` or `name.outer.field` (field nodes down to a named identifier), or a
        # renamed loop binder.
        def proof_kernel_replay_field_place_shape_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return false if not proof_kernel_replay_valid(nodes, root)
            if nodes[root].kind == "tuple":
                # A renamed loop binder, `(index, 518)`.
                return false if nodes[root].children_count != 2 or not proof_kernel_replay_child_range_valid(nodes[root].children_start, 2, children.count)
                first: usize = children[nodes[root].children_start]
                second: usize = children[nodes[root].children_start + 1]
                return false if not proof_kernel_replay_valid(nodes, first) or not proof_kernel_replay_valid(nodes, second)
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, first, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, second, work_used)
                return nodes[first].kind == "ident" and nodes[first].name != "" and nodes[second].kind == "int"
            return false if nodes[root].kind != "field" or nodes[root].name == ""
            cursor: mutable usize = nodes[root].left
            for step in 0..<ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT |cursor, nodes, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, cursor, work_used)
                return false if not proof_kernel_replay_valid(nodes, cursor)
                return nodes[cursor].name != "" if nodes[cursor].kind == "ident"
                if nodes[cursor].kind == "call":
                    return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, nodes[cursor].left, work_used)
                    return proof_kernel_replay_named_call_term(nodes, cursor)
                return false if nodes[cursor].kind != "field" or nodes[cursor].name == ""
                cursor <- nodes[cursor].left
            return false

        def proof_kernel_replay_collect_field_places(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, places: mutable darray[usize]&, markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, work_used: mutable usize&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not proof_kernel_replay_goal_search_charge(work_used)
            return if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return if places.count >= PROOF_KERNEL_REPLAY_FIELD_PLACE_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary":
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.left, places, markers, markers_ready, work_used, depth + 1)
            elif node.kind == "binary" or node.kind == "index":
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.left, places, markers, markers_ready, work_used, depth + 1)
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.right, places, markers, markers_ready, work_used, depth + 1)
            elif node.kind == "if":
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.left, places, markers, markers_ready, work_used, depth + 1)
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.right, places, markers, markers_ready, work_used, depth + 1)
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.auxiliary, places, markers, markers_ready, work_used, depth + 1)
            elif node.kind == "call":
                return if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                # A witnessed pure call, or an integer conversion of a witnessed receiver,
                # denotes one value for fixed arguments.
                cast_call: bool = proof_kernel_replay_valid(nodes, node.left) and nodes[node.left].kind == "field"
                return if not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                if proof_kernel_replay_named_call_term(nodes, root) or cast_call:
                    if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                        markers <- proof_kernel_replay_witness_marker_cache_with_work(nodes, children, facts, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        markers_ready <- true
                        return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    scalar_witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    proof_kernel_replay_push_field_place(nodes, children, places, root, work_used) if scalar_witnessed
                for index in 0..<node.children_count |index, node, nodes, children, facts, places, markers, markers_ready, work_used, depth|:
                    proof_kernel_replay_collect_field_places(nodes, children, facts, children[node.children_start + index], places, markers, markers_ready, work_used, depth + 1)
                    return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            elif node.kind == "field" or node.kind == "tuple":
                if proof_kernel_replay_field_place_shape_with_work(nodes, children, root, work_used):
                    if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                        markers <- proof_kernel_replay_witness_marker_cache_with_work(nodes, children, facts, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        markers_ready <- true
                        return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    scalar_witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    proof_kernel_replay_push_field_place(nodes, children, places, root, work_used) if scalar_witnessed

        def proof_kernel_replay_push_field_place(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, places: mutable darray[usize]&, root: usize, work_used: mutable usize&) -> void:
            return if places.count >= PROOF_KERNEL_REPLAY_FIELD_PLACE_LIMIT
            for place in places |place, nodes, children, root, work_used|:
                return if proof_kernel_replay_goal_search_expr_equal(nodes, children, place, root, work_used)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            places.push(root)

        # A shared conditional is substituted across multiple occurrences, so its guard must be
        # free of calls. The proof source imposes the same conservative condition; the kernel
        # accepts only a small call-free term fragment rather than trusting a producer flag.
        def proof_kernel_replay_nested_condition_stable(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_nested_condition_stable_with_work(nodes, root, depth, &work_used)

        def proof_kernel_replay_nested_condition_stable_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "int" or node.kind == "typed-int" or node.kind == "ident" or node.kind == "bool"
            return proof_kernel_replay_nested_condition_stable_with_work(nodes, node.left, depth + 1, work_used) if node.kind == "unary"
            return proof_kernel_replay_nested_condition_stable_with_work(nodes, node.left, depth + 1, work_used) if node.kind == "field"
            return proof_kernel_replay_nested_condition_stable_with_work(nodes, node.left, depth + 1, work_used) and proof_kernel_replay_nested_condition_stable_with_work(nodes, node.right, depth + 1, work_used) if node.kind == "binary"
            return false

        # A disjunction may state two bounds on the same conditional result. Split that
        # result once, with the exact guard (and its negation), before generic arithmetic
        # search spends the remaining replay budget. Matching is structural and exact: both
        # disjuncts must contain the same conditional, and both substituted goals must replay.
        def proof_kernel_replay_conditional_result_guard(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_conditional_result_guard_with_work(nodes, children, facts, root, depth, &work_used)

        def proof_kernel_replay_conditional_result_guard_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary" and node.operator == "not":
                return proof_kernel_replay_conditional_result_guard_with_work(nodes, children, facts, node.left, depth + 1, work_used)
            if node.kind == "binary" and (node.operator == "and" or node.operator == "or"):
                return proof_kernel_replay_conditional_result_guard_with_work(nodes, children, facts, node.left, depth + 1, work_used) and proof_kernel_replay_conditional_result_guard_with_work(nodes, children, facts, node.right, depth + 1, work_used)
            if node.kind == "binary" and (node.operator == "==" or node.operator == "!=" or node.operator == "<" or node.operator == "<=" or node.operator == ">" or node.operator == ">="):
                return proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, depth, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)

        def proof_kernel_replay_conditional_result_disjunction(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if remaining <= 1 or split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or goal.operator != "or"
            conditional: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional_with_work(nodes, goal_root, 0, work_used)
            return false if not conditional.found or not proof_kernel_replay_valid(nodes, conditional.root)
            branch: ElisaProofKernelCore::ProofKernelNode = nodes[conditional.root]
            return false if branch.kind != "if" or not proof_kernel_replay_conditional_result_guard_with_work(nodes, children, facts, branch.left, 0, work_used)
            return false if not proof_kernel_replay_scalar_term_pair_witnessed_with_work(nodes, children, facts, branch.right, branch.auxiliary, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            # Establish exact occurrence in each side separately. A matching guard alone or a
            # merely similar conditional in one arm is insufficient for this shared-result rule.
            left_occurrence: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal.left, conditional.root, branch.right, work_used, 0)
            right_occurrence: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal.right, conditional.root, branch.right, work_used, 0)
            return false if not left_occurrence.changed or not right_occurrence.changed
            then_rewrite: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, conditional.root, branch.right, work_used, 0)
            else_rewrite: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, conditional.root, branch.auxiliary, work_used, 0)
            return false if not then_rewrite.changed or not else_rewrite.changed
            then_facts: mutable darray[usize] = []
            else_facts: mutable darray[usize] = []
            for fact in facts |fact, nodes, children, conditional, branch, then_facts, else_facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                then_facts.push(proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, conditional.root, branch.right, work_used, 0).value)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                else_facts.push(proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, conditional.root, branch.auxiliary, work_used, 0).value)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            then_facts.push(branch.left)
            negated_condition: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "unary", "not", branch.left, 0, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or negated_condition >= nodes.count
            else_facts.push(negated_condition)
            return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, then_facts, then_rewrite.value, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, else_facts, else_rewrite.value, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_conditional_equality_other(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, comparison_root: usize, conditional_root: usize) -> (known: bool, other: usize):
            work_used: mutable usize = 0
            proof_kernel_replay_conditional_equality_other_with_work(nodes, children, comparison_root, conditional_root, &work_used)

        def proof_kernel_replay_conditional_equality_other_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, comparison_root: usize, conditional_root: usize, work_used: mutable usize&) -> (known: bool, other: usize):
            return (false, 0) if not proof_kernel_replay_goal_search_charge(work_used)
            return (false, 0) if not proof_kernel_replay_valid(nodes, comparison_root)
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[comparison_root]
            return (false, 0) if comparison.kind != "binary" or comparison.operator != "=="
            return (true, comparison.right) if proof_kernel_replay_goal_search_expr_equal(nodes, children, comparison.left, conditional_root, work_used)
            return (true, comparison.left) if proof_kernel_replay_goal_search_expr_equal(nodes, children, comparison.right, conditional_root, work_used)
            return (false, 0)

        # A true conjunction implies each of its positive conjuncts. Keep this
        # structural and bounded: disjunctions and negated conditions do not
        # provide this implication.
        def proof_kernel_replay_condition_has_positive_conjunct(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, condition_root: usize, candidate_root: usize, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_condition_has_positive_conjunct_with_work(nodes, children, condition_root, candidate_root, depth, &work_used)

        def proof_kernel_replay_condition_has_positive_conjunct_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, condition_root: usize, candidate_root: usize, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, condition_root) or not proof_kernel_replay_valid(nodes, candidate_root)
            return true if proof_kernel_replay_goal_search_expr_equal(nodes, children, condition_root, candidate_root, work_used)
            condition: ElisaProofKernelCore::ProofKernelNode = nodes[condition_root]
            return proof_kernel_replay_condition_has_positive_conjunct_with_work(nodes, children, condition.left, candidate_root, depth + 1, work_used) if condition.kind == "paren"
            return false if condition.kind != "binary" or condition.operator != "and" or not proof_kernel_replay_arena_shape_valid(condition)
            return proof_kernel_replay_condition_has_positive_conjunct_with_work(nodes, children, condition.left, candidate_root, depth + 1, work_used) or proof_kernel_replay_condition_has_positive_conjunct_with_work(nodes, children, condition.right, candidate_root, depth + 1, work_used)

        # The only arithmetic implication admitted here is the exact signed-unit shift
        # `(x + 1) < y  ==>  x < (y - 1)`. It is replayed by the checked linear
        # arithmetic kernel, and only after that kernel independently establishes that both
        # fixed-width operations are in range under the source facts and the positive guard.
        # This deliberately does not normalize arbitrary expressions or infer general guard
        # implications.
        def proof_kernel_replay_signed_unit_shift_order_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], antecedent_root: usize, consequent_root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if not proof_kernel_replay_valid(nodes, antecedent_root) or not proof_kernel_replay_valid(nodes, consequent_root)
            antecedent: ElisaProofKernelCore::ProofKernelNode = nodes[antecedent_root]
            consequent: ElisaProofKernelCore::ProofKernelNode = nodes[consequent_root]
            return false if antecedent.kind != "binary" or antecedent.operator != "<" or consequent.kind != "binary" or consequent.operator != "<"
            return false if not proof_kernel_replay_valid(nodes, antecedent.left) or not proof_kernel_replay_valid(nodes, antecedent.right) or not proof_kernel_replay_valid(nodes, consequent.left) or not proof_kernel_replay_valid(nodes, consequent.right)
            successor: ElisaProofKernelCore::ProofKernelNode = nodes[antecedent.left]
            predecessor: ElisaProofKernelCore::ProofKernelNode = nodes[consequent.right]
            return false if successor.kind != "binary" or successor.operator != "+" or predecessor.kind != "binary" or predecessor.operator != "-"
            one: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, successor.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            decrement: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, predecessor.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if not one.known or one.value != 1 or not decrement.known or decrement.value != 1
            return false if not proof_kernel_replay_goal_search_expr_equal(nodes, children, successor.left, consequent.left, work_used)
            return false if not proof_kernel_replay_goal_search_expr_equal(nodes, children, antecedent.right, predecessor.left, work_used)
            width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, antecedent.left, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if width <= 0 or proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, antecedent.right, work_used, 0) != width
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, consequent.left, work_used, 0) != width or proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, consequent.right, work_used, 0) != width
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, antecedent.left, antecedent.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, consequent.left, consequent.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            # Establish wrap safety from source facts only; never let the guard whose truth is
            # being used discharge its own operation-range obligation.
            unsigned_bounds: mutable darray[ProofKernelReplayBound] = []
            signed_bounds: darray[ProofKernelReplayBound] = proof_kernel_replay_signed_safety_bounds_with_goal_work(nodes, children, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts |fact, nodes, children, facts, unsigned_bounds, signed_bounds, work_used|:
                return false if not proof_kernel_replay_unsigned_safe_closing_with_goal_work(nodes, children, fact, facts, &unsigned_bounds, work_used)
                return false if not proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, fact, facts, signed_bounds, work_used, 0)
            return false if not proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, antecedent_root, facts, signed_bounds, work_used, 0)
            return false if not proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, consequent_root, facts, signed_bounds, work_used, 0)
            arithmetic_facts: mutable darray[usize] = []
            return false if not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &arithmetic_facts, work_used)
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            arithmetic_facts.push(antecedent_root)
            proof_kernel_replay_linear_arithmetic_goal_with_work(nodes, children, consequent.left, consequent.operator, consequent.right, arithmetic_facts, work_used)

        # Search only the positive conjunction spine: no disjunction, negation, or arbitrary
        # implication is allowed to supply the shifted comparison premise.
        def proof_kernel_replay_condition_has_signed_unit_shift_order_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], condition_root: usize, consequent_root: usize, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, condition_root)
            condition: ElisaProofKernelCore::ProofKernelNode = nodes[condition_root]
            if condition.kind == "paren":
                return proof_kernel_replay_condition_has_signed_unit_shift_order_with_work(nodes, children, facts, condition.left, consequent_root, depth + 1, work_used)
            if condition.kind == "binary" and condition.operator == "and" and proof_kernel_replay_arena_shape_valid(condition):
                left_proves: bool = proof_kernel_replay_condition_has_signed_unit_shift_order_with_work(nodes, children, facts, condition.left, consequent_root, depth + 1, work_used)
                return true if left_proves
                proof_kernel_replay_condition_has_signed_unit_shift_order_with_work(nodes, children, facts, condition.right, consequent_root, depth + 1, work_used)
            proof_kernel_replay_signed_unit_shift_order_with_work(nodes, children, facts, condition_root, consequent_root, work_used)

        # Exact branch proof for `(if c then x else y) == y or g` (in either
        # disjunct/equality orientation), where c is g or a positive conjunction
        # containing g. Under c the disjunction follows from g; under not c the
        # conditional selects y and the equality is reflexive.
        # The guard and all compared values are independently checked as primitive
        # terms; no producer-supplied purity or type marker is trusted.
        def proof_kernel_replay_conditional_fallback_or_guard(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or goal.operator != "or"
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            for orientation in 0..<2 |orientation, nodes, children, facts, goal, goal_root, markers, markers_ready, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                equality_root: usize = goal.left if orientation == 0 else goal.right
                guard_root: usize = goal.right if orientation == 0 else goal.left
                continue if not proof_kernel_replay_valid(nodes, equality_root) or not proof_kernel_replay_valid(nodes, guard_root)
                equality: ElisaProofKernelCore::ProofKernelNode = nodes[equality_root]
                continue if equality.kind != "binary" or equality.operator != "=="
                conditional: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional_with_work(nodes, goal_root, 0, work_used)
                continue if not conditional.found or not proof_kernel_replay_valid(nodes, conditional.root)
                branch: ElisaProofKernelCore::ProofKernelNode = nodes[conditional.root]
                continue if branch.kind != "if"
                continue if not proof_kernel_replay_nested_condition_stable_with_work(nodes, branch.left, 0, work_used)
                continue if not proof_kernel_replay_valid(nodes, guard_root)
                guard: ElisaProofKernelCore::ProofKernelNode = nodes[guard_root]
                continue if guard.kind != "binary" or not proof_kernel_replay_arena_shape_valid(guard)
                continue if guard.operator != "==" and guard.operator != "!=" and guard.operator != "<" and guard.operator != "<=" and guard.operator != ">" and guard.operator != ">="
                if not markers_ready:
                    markers <- proof_kernel_replay_witness_marker_cache_with_work(nodes, children, facts, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    markers_ready <- true
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, guard.left, guard.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                continue if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
                direct_guard: bool = proof_kernel_replay_condition_has_positive_conjunct_with_work(nodes, children, branch.left, guard_root, 0, work_used)
                continue if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                shifted_guard: bool = proof_kernel_replay_condition_has_signed_unit_shift_order_with_work(nodes, children, facts, branch.left, guard_root, 0, work_used)
                continue if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not direct_guard and not shifted_guard
                fallback: (known: bool, other: usize) = proof_kernel_replay_conditional_equality_other_with_work(nodes, children, equality_root, conditional.root, work_used)
                continue if not fallback.known or not proof_kernel_replay_goal_search_expr_equal(nodes, children, fallback.other, branch.auxiliary, work_used)
                continue if not proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, branch.right, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                continue if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, branch.auxiliary, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                continue if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, fallback.other, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                continue if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true
            return false

        # Kernel rule for the exact conditional-choice tautology. Unlike arithmetic splitting,
        # this conclusion needs no interval model: the same pure conditional value equals one of
        # its two branch values. Branches must independently be primitive scalars, and the source
        # proposition validator checks the conditional and equality types.
        def proof_kernel_replay_conditional_choice_or_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or goal.operator != "or"
            conditional: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional_with_work(nodes, goal_root, 0, work_used)
            return false if not conditional.found or not proof_kernel_replay_valid(nodes, conditional.root)
            branch: ElisaProofKernelCore::ProofKernelNode = nodes[conditional.root]
            return false if branch.kind != "if" or not proof_kernel_replay_nested_condition_stable_with_work(nodes, branch.left, 0, work_used)
            return false if not proof_kernel_replay_scalar_term_pair_witnessed_with_work(nodes, children, facts, branch.right, branch.auxiliary, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            first: (known: bool, other: usize) = proof_kernel_replay_conditional_equality_other_with_work(nodes, children, goal.left, conditional.root, work_used)
            second: (known: bool, other: usize) = proof_kernel_replay_conditional_equality_other_with_work(nodes, children, goal.right, conditional.root, work_used)
            return false if not first.known or not second.known
            then_then: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, first.other, branch.right, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, second.other, branch.right, work_used)
            covers_both: bool = (proof_kernel_replay_goal_search_expr_equal(nodes, children, first.other, branch.right, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, second.other, branch.auxiliary, work_used)) or (proof_kernel_replay_goal_search_expr_equal(nodes, children, first.other, branch.auxiliary, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, second.other, branch.right, work_used))
            return covers_both or (proof_kernel_replay_goal_search_expr_equal(nodes, children, branch.right, branch.auxiliary, work_used) and then_then)

        # Mirror of `proof_nested_conditional_goal`: split on the first conditional nested
        # inside a comparison's operands, rewriting every occurrence of it in the goal and in
        # every fact to the branch value that its condition (or the negation) selects. Both
        # branches must replay.
        def proof_kernel_replay_nested_conditional_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or not (goal.operator == ">" or goal.operator == ">=" or goal.operator == "<" or goal.operator == "<=" or goal.operator == "==" or goal.operator == "!=" or goal.operator == "or" or goal.operator == "and")
            conditional: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional_with_work(nodes, goal_root, 0, work_used)
            return false if not conditional.found or not proof_kernel_replay_valid(nodes, conditional.root)
            branch: ElisaProofKernelCore::ProofKernelNode = nodes[conditional.root]
            return false if not proof_kernel_replay_valid(nodes, branch.left) or not proof_kernel_replay_valid(nodes, branch.right) or not proof_kernel_replay_valid(nodes, branch.auxiliary)
            return false if not proof_kernel_replay_nested_condition_stable_with_work(nodes, branch.left, 0, work_used)
            then_facts: mutable darray[usize] = []
            else_facts: mutable darray[usize] = []
            for fact in facts |fact, nodes, children, conditional, branch, then_facts, else_facts, work_used|:
                then_facts.push(proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, conditional.root, branch.right, work_used, 0).value)
                else_facts.push(proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, conditional.root, branch.auxiliary, work_used, 0).value)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            then_facts.push(branch.left)
            negated_condition: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "unary", "not", branch.left, 0, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or negated_condition >= nodes.count
            else_facts.push(negated_condition)
            then_goal: usize = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, conditional.root, branch.right, work_used, 0).value
            else_goal: usize = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, conditional.root, branch.auxiliary, work_used, 0).value
            # A conditional-choice disjunction often closes by reflexivity in each arm. Check
            # that narrow logical case directly before routing it through arithmetic safety
            # analysis for the unexpanded comparison. The direct-branch checker independently
            # requires primitive comparison witnesses for any equality/order it closes.
            if goal.operator == "or":
                return true if proof_kernel_replay_disjunction_direct_branch_with_work(nodes, children, then_goal, then_facts, work_used, 0) and proof_kernel_replay_disjunction_direct_branch_with_work(nodes, children, else_goal, else_facts, work_used, 0)
            return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, then_facts, then_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, else_facts, else_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        # The first "if" node in pre-order below the goal's operands, reached only through
        # "unary" and "binary" nodes; an operand that is itself an "if" is the operand split's.
        def proof_kernel_replay_first_nested_conditional(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> (found: bool, root: usize):
            work_used: mutable usize = 0
            proof_kernel_replay_first_nested_conditional_with_work(nodes, root, depth, &work_used)

        def proof_kernel_replay_first_nested_conditional_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize, work_used: mutable usize&) -> (found: bool, root: usize):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (false, root) if not proof_kernel_replay_goal_search_charge(work_used)
            return (false, root) if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (depth > 1, root) if node.kind == "if"
            return proof_kernel_replay_first_nested_conditional_with_work(nodes, node.left, depth + 1, work_used) if node.kind == "unary"
            return (false, root) if node.kind != "binary"
            left: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional_with_work(nodes, node.left, depth + 1, work_used)
            return left if left.found
            return proof_kernel_replay_first_nested_conditional_with_work(nodes, node.right, depth + 1, work_used)
