const PROOF_KERNEL_REPLAY_FIELD_PLACE_LIMIT: usize = 4

extend ElisaProofKernelReplay:
    private:
        # Mirror of `proof_field_place_goal`: generalize each witnessed primitive scalar field
        # place over a plain name, and each witnessed pure call result, to a fresh reserved name in the goal and every fact, then
        # decide the generalized goal. Instantiating the names back gives the original goal, so
        # this is sound for any fixed values; the witness keeps protocol dispatch out.
        def proof_kernel_replay_field_place_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            for marker_index in 0..<PROOF_KERNEL_REPLAY_FIELD_PLACE_LIMIT |marker_index, nodes, children, facts, goal_root|:
                probe: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, proof_kernel_replay_field_place_name(marker_index), "")
                return false if not proof_kernel_replay_valid(nodes, probe)
                return false if proof_kernel_replay_replace_exact(nodes, children, goal_root, probe, probe, 0).changed
                for fact in facts |nodes, children, probe|:
                    return false if proof_kernel_replay_replace_exact(nodes, children, fact, probe, probe, 0).changed
            places: mutable darray[usize] = []
            proof_kernel_replay_collect_field_places(nodes, children, facts, goal_root, &places, 0)
            for fact in facts |fact, nodes, children, facts, places|:
                proof_kernel_replay_collect_field_places(nodes, children, facts, fact, &places, 0)
            return false if places.count == 0
            rewritten_goal: mutable usize = goal_root
            rewritten_facts: mutable darray[usize] = []
            for fact in facts |fact, rewritten_facts|:
                rewritten_facts.push(fact)
            for index in 0..<places.count |index, nodes, children, places, rewritten_goal, rewritten_facts|:
                fresh: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, proof_kernel_replay_field_place_name(index), "")
                rewritten_goal <- proof_kernel_replay_replace_exact(nodes, children, rewritten_goal, places[index], fresh, 0).value
                next_facts: mutable darray[usize] = []
                for fact in rewritten_facts |fact, nodes, children, places, index, fresh, next_facts|:
                    next_facts.push(proof_kernel_replay_replace_exact(nodes, children, fact, places[index], fresh, 0).value)
                rewritten_facts <- next_facts
                # A later place containing this one now reads with the fresh name.
                next_places: mutable darray[usize] = []
                for later in places |later, nodes, children, places, index, fresh, next_places|:
                    next_places.push(proof_kernel_replay_replace_exact(nodes, children, later, places[index], fresh, 0).value)
                places <- next_places
            return proof_kernel_replay_goal_depth_remaining(nodes, children, rewritten_facts, rewritten_goal, split_depth, depth + 1, remaining: remaining - 1)

        def proof_kernel_replay_field_place_name(index: usize) -> sview:
            return "__elisa_field_place_0" if index == 0
            return "__elisa_field_place_1" if index == 1
            return "__elisa_field_place_2" if index == 2
            "__elisa_field_place_3"

        # `name.field` or `name.outer.field` (field nodes down to a named identifier), or a
        # renamed loop binder.
        def proof_kernel_replay_field_place_shape(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            if nodes[root].kind == "tuple":
                # A renamed loop binder, `(index, 518)`.
                return false if nodes[root].children_count != 2 or not proof_kernel_replay_child_range_valid(nodes[root].children_start, 2, children.count)
                first: usize = children[nodes[root].children_start]
                second: usize = children[nodes[root].children_start + 1]
                return false if not proof_kernel_replay_valid(nodes, first) or not proof_kernel_replay_valid(nodes, second)
                return nodes[first].kind == "ident" and nodes[first].name != "" and nodes[second].kind == "int"
            return false if nodes[root].kind != "field" or nodes[root].name == ""
            cursor: mutable usize = nodes[root].left
            for step in 0..<ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT |cursor, nodes|:
                return false if not proof_kernel_replay_valid(nodes, cursor)
                return nodes[cursor].name != "" if nodes[cursor].kind == "ident"
                return proof_kernel_replay_named_call_term(nodes, cursor) if nodes[cursor].kind == "call"
                return false if nodes[cursor].kind != "field" or nodes[cursor].name == ""
                cursor <- nodes[cursor].left
            return false

        def proof_kernel_replay_collect_field_places(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, places: mutable darray[usize]&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return if places.count >= PROOF_KERNEL_REPLAY_FIELD_PLACE_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary":
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.left, places, depth + 1)
            elif node.kind == "binary" or node.kind == "index":
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.left, places, depth + 1)
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.right, places, depth + 1)
            elif node.kind == "if":
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.left, places, depth + 1)
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.right, places, depth + 1)
                proof_kernel_replay_collect_field_places(nodes, children, facts, node.auxiliary, places, depth + 1)
            elif node.kind == "call":
                return if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                # A witnessed pure call, or an integer conversion of a witnessed receiver,
                # denotes one value for fixed arguments.
                cast_call: bool = proof_kernel_replay_valid(nodes, node.left) and nodes[node.left].kind == "field"
                if (proof_kernel_replay_named_call_term(nodes, root) or cast_call) and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0):
                    proof_kernel_replay_push_field_place(nodes, children, places, root)
                for index in 0..<node.children_count |index, node, nodes, children, facts, places, depth|:
                    proof_kernel_replay_collect_field_places(nodes, children, facts, children[node.children_start + index], places, depth + 1)
            elif node.kind == "field" or node.kind == "tuple":
                if proof_kernel_replay_field_place_shape(nodes, children, root) and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0):
                    proof_kernel_replay_push_field_place(nodes, children, places, root)

        def proof_kernel_replay_push_field_place(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, places: mutable darray[usize]&, root: usize) -> void:
            return if places.count >= PROOF_KERNEL_REPLAY_FIELD_PLACE_LIMIT
            for place in places |place, nodes, children, root|:
                return if proof_kernel_replay_expr_equal(nodes, children, place, root, 0)
            places.push(root)

        # A shared conditional is substituted across multiple occurrences, so its guard must be
        # free of calls. The proof source imposes the same conservative condition; the kernel
        # accepts only a small call-free term fragment rather than trusting a producer flag.
        def proof_kernel_replay_nested_condition_stable(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "int" or node.kind == "typed-int" or node.kind == "ident" or node.kind == "bool"
            return proof_kernel_replay_nested_condition_stable(nodes, node.left, depth + 1) if node.kind == "unary"
            return proof_kernel_replay_nested_condition_stable(nodes, node.left, depth + 1) if node.kind == "field"
            return proof_kernel_replay_nested_condition_stable(nodes, node.left, depth + 1) and proof_kernel_replay_nested_condition_stable(nodes, node.right, depth + 1) if node.kind == "binary"
            return false

        def proof_kernel_replay_conditional_equality_other(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, comparison_root: usize, conditional_root: usize) -> (known: bool, other: usize):
            return (false, 0) if not proof_kernel_replay_valid(nodes, comparison_root)
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[comparison_root]
            return (false, 0) if comparison.kind != "binary" or comparison.operator != "=="
            return (true, comparison.right) if proof_kernel_replay_expr_equal(nodes, children, comparison.left, conditional_root, 0)
            return (true, comparison.left) if proof_kernel_replay_expr_equal(nodes, children, comparison.right, conditional_root, 0)
            return (false, 0)

        # Exact branch proof for `(if c then x else y) == y or c` (in either
        # disjunct/equality orientation). Under c the disjunction follows from c;
        # under not c the conditional selects y and the equality is reflexive.
        # The guard and all compared values are independently checked as primitive
        # terms; no producer-supplied purity or type marker is trusted.
        def proof_kernel_replay_conditional_fallback_or_guard(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or goal.operator != "or"
            for orientation in 0..<2 |orientation, nodes, children, facts, goal, goal_root|:
                equality_root: usize = goal.left if orientation == 0 else goal.right
                guard_root: usize = goal.right if orientation == 0 else goal.left
                continue if not proof_kernel_replay_valid(nodes, equality_root) or not proof_kernel_replay_valid(nodes, guard_root)
                equality: ElisaProofKernelCore::ProofKernelNode = nodes[equality_root]
                continue if equality.kind != "binary" or equality.operator != "=="
                conditional: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional(nodes, goal_root, 0)
                continue if not conditional.found or not proof_kernel_replay_valid(nodes, conditional.root)
                branch: ElisaProofKernelCore::ProofKernelNode = nodes[conditional.root]
                continue if branch.kind != "if" or not proof_kernel_replay_expr_equal(nodes, children, branch.left, guard_root, 0)
                continue if not proof_kernel_replay_nested_condition_stable(nodes, branch.left, 0)
                continue if not proof_kernel_replay_valid(nodes, branch.left) or nodes[branch.left].kind != "binary"
                guard: ElisaProofKernelCore::ProofKernelNode = nodes[branch.left]
                continue if guard.operator != "==" and guard.operator != "!=" and guard.operator != "<" and guard.operator != "<=" and guard.operator != ">" and guard.operator != ">="
                continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, guard.left, guard.right)
                fallback: (known: bool, other: usize) = proof_kernel_replay_conditional_equality_other(nodes, children, equality_root, conditional.root)
                continue if not fallback.known or not proof_kernel_replay_expr_equal(nodes, children, fallback.other, branch.auxiliary, 0)
                continue if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, branch.right, 0)
                continue if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, branch.auxiliary, 0)
                continue if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, fallback.other, 0)
                return true
            return false

        # Kernel rule for the exact conditional-choice tautology. Unlike arithmetic splitting,
        # this conclusion needs no interval model: the same pure conditional value equals one of
        # its two branch values. Branches must independently be primitive scalars, and the source
        # proposition validator checks the conditional and equality types.
        def proof_kernel_replay_conditional_choice_or_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or goal.operator != "or"
            conditional: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional(nodes, goal_root, 0)
            return false if not conditional.found or not proof_kernel_replay_valid(nodes, conditional.root)
            branch: ElisaProofKernelCore::ProofKernelNode = nodes[conditional.root]
            return false if branch.kind != "if" or not proof_kernel_replay_nested_condition_stable(nodes, branch.left, 0)
            return false if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, branch.right, 0) or not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, branch.auxiliary, 0)
            first: (known: bool, other: usize) = proof_kernel_replay_conditional_equality_other(nodes, children, goal.left, conditional.root)
            second: (known: bool, other: usize) = proof_kernel_replay_conditional_equality_other(nodes, children, goal.right, conditional.root)
            return false if not first.known or not second.known
            then_then: bool = proof_kernel_replay_expr_equal(nodes, children, first.other, branch.right, 0) and proof_kernel_replay_expr_equal(nodes, children, second.other, branch.right, 0)
            covers_both: bool = (proof_kernel_replay_expr_equal(nodes, children, first.other, branch.right, 0) and proof_kernel_replay_expr_equal(nodes, children, second.other, branch.auxiliary, 0)) or (proof_kernel_replay_expr_equal(nodes, children, first.other, branch.auxiliary, 0) and proof_kernel_replay_expr_equal(nodes, children, second.other, branch.right, 0))
            return covers_both or (proof_kernel_replay_expr_equal(nodes, children, branch.right, branch.auxiliary, 0) and then_then)

        # Mirror of `proof_nested_conditional_goal`: split on the first conditional nested
        # inside a comparison's operands, rewriting every occurrence of it in the goal and in
        # every fact to the branch value that its condition (or the negation) selects. Both
        # branches must replay.
        def proof_kernel_replay_nested_conditional_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or not (goal.operator == ">" or goal.operator == ">=" or goal.operator == "<" or goal.operator == "<=" or goal.operator == "==" or goal.operator == "!=" or goal.operator == "or" or goal.operator == "and")
            conditional: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional(nodes, goal_root, 0)
            return false if not conditional.found or not proof_kernel_replay_valid(nodes, conditional.root)
            branch: ElisaProofKernelCore::ProofKernelNode = nodes[conditional.root]
            return false if not proof_kernel_replay_valid(nodes, branch.left) or not proof_kernel_replay_valid(nodes, branch.right) or not proof_kernel_replay_valid(nodes, branch.auxiliary)
            return false if not proof_kernel_replay_nested_condition_stable(nodes, branch.left, 0)
            then_facts: mutable darray[usize] = []
            else_facts: mutable darray[usize] = []
            for fact in facts |fact, nodes, children, conditional, branch, then_facts, else_facts|:
                then_facts.push(proof_kernel_replay_replace_exact(nodes, children, fact, conditional.root, branch.right, 0).value)
                else_facts.push(proof_kernel_replay_replace_exact(nodes, children, fact, conditional.root, branch.auxiliary, 0).value)
            then_facts.push(branch.left)
            else_facts.push(ElisaProofKernelCore::add_node_reused(nodes, "unary", "not", branch.left, 0, 0))
            then_goal: usize = proof_kernel_replay_replace_exact(nodes, children, goal_root, conditional.root, branch.right, 0).value
            else_goal: usize = proof_kernel_replay_replace_exact(nodes, children, goal_root, conditional.root, branch.auxiliary, 0).value
            # A conditional-choice disjunction often closes by reflexivity in each arm. Check
            # that narrow logical case directly before routing it through arithmetic safety
            # analysis for the unexpanded comparison. The direct-branch checker independently
            # requires primitive comparison witnesses for any equality/order it closes.
            if goal.operator == "or":
                return true if proof_kernel_replay_disjunction_direct_branch(nodes, children, then_goal, then_facts, 0) and proof_kernel_replay_disjunction_direct_branch(nodes, children, else_goal, else_facts, 0)
            return proof_kernel_replay_goal_depth_remaining(nodes, children, then_facts, then_goal, split_depth + 1, depth + 1, remaining: remaining - 1) and proof_kernel_replay_goal_depth_remaining(nodes, children, else_facts, else_goal, split_depth + 1, depth + 1, remaining: remaining - 1)

        # The first "if" node in pre-order below the goal's operands, reached only through
        # "unary" and "binary" nodes; an operand that is itself an "if" is the operand split's.
        def proof_kernel_replay_first_nested_conditional(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> (found: bool, root: usize):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (false, root) if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (depth > 1, root) if node.kind == "if"
            return proof_kernel_replay_first_nested_conditional(nodes, node.left, depth + 1) if node.kind == "unary"
            return (false, root) if node.kind != "binary"
            left: (found: bool, root: usize) = proof_kernel_replay_first_nested_conditional(nodes, node.left, depth + 1)
            return left if left.found
            return proof_kernel_replay_first_nested_conditional(nodes, node.right, depth + 1)
