# Deterministic, observational work counters for the replay arena admission pass.
# These values never participate in proof decisions or any replay budget.
global mutable proof_kernel_replay_arena_records_scanned: usize
global mutable proof_kernel_replay_child_table_edges_scanned: usize

extend ElisaProofKernelReplay:
    public:
        def proof_kernel_replay_arena_scan_measurements() -> (records_scanned: usize, child_edges_scanned: usize):
            can Global.Read:
                return (proof_kernel_replay_arena_records_scanned, proof_kernel_replay_child_table_edges_scanned)

        def proof_kernel_replay_reset_arena_scan_measurements() -> void:
            can Global.Write:
                proof_kernel_replay_arena_records_scanned <- 0
                proof_kernel_replay_child_table_edges_scanned <- 0
