# Work-bounded arena substitution with a last-result memo for adjacent shared DAG nodes.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_substitution_effective_limit(work_limit: usize) -> usize:
            work_limit if work_limit < PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT else PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT

        def proof_kernel_replay_substitution_charge(work_used: mutable usize&, work_limit: usize, amount: usize) -> bool:
            effective_limit: usize = proof_kernel_replay_substitution_effective_limit(work_limit)
            # A nested caller may already share more work than this helper's local ceiling.
            # Refuse without lowering its cumulative counter; only a crossing charge advances
            # the counter past the effective limit.
            return false if work_used > effective_limit
            if amount > effective_limit - work_used:
                work_used <- effective_limit + 1
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_replay_substitution_node_charge(node: ElisaProofKernelCore::ProofKernelNode, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if:
                not proof_kernel_replay_substitution_charge(work_used, work_limit, 1)
                not proof_kernel_replay_substitution_charge(work_used, work_limit, sview_len(node.kind))
                not proof_kernel_replay_substitution_charge(work_used, work_limit, sview_len(node.operator))
                not proof_kernel_replay_substitution_charge(work_used, work_limit, sview_len(node.name))
            proof_kernel_replay_substitution_charge(work_used, work_limit, sview_len(node.secondary_name))

        # Substitution under a distinct quantifier binder is safe when that binder's name is
        # absent from the replacement's free variables. This bounded recognizer deliberately
        # supports the expression forms understood by arena substitution; an unknown replacement
        # shape still fails closed. A nested quantifier masks its binder in the body, but not in
        # its range.
        def proof_kernel_replay_substitution_capture_safe(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, binder: sview, depth: usize, shadowed: bool, work_used: mutable usize&, work_limit: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                root >= nodes.count
                not proof_kernel_replay_substitution_charge(work_used, work_limit, 1)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_substitution_node_charge(node, work_used, work_limit)
            if node.kind == "ident":
                return true if shadowed
                return node.name != binder
            if node.kind in {"int", "bool", "char", "float", "opaque-float-literal", "string", "shorthand", "absent"}:
                return true
            if node.kind == "typed-int":
                return ElisaProofKernelCore::typed_literal_value(node).known
            if node.kind in {"unary", "move", "field", "scope", "call_arg", "field-init", "checked-get"}:
                return proof_kernel_replay_substitution_capture_safe(nodes, children, node.left, binder, depth + 1, shadowed, work_used, work_limit)
            if node.kind in {"binary", "index", "dict_entry", "checked-index"}:
                return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, node.left, binder, depth + 1, shadowed, work_used, work_limit)
                return proof_kernel_replay_substitution_capture_safe(nodes, children, node.right, binder, depth + 1, shadowed, work_used, work_limit)
            if node.kind == "slice":
                return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, node.left, binder, depth + 1, shadowed, work_used, work_limit)
                return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, node.right, binder, depth + 1, shadowed, work_used, work_limit)
                return proof_kernel_replay_substitution_capture_safe(nodes, children, node.auxiliary, binder, depth + 1, shadowed, work_used, work_limit)
            if node.kind == "if":
                return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, node.left, binder, depth + 1, shadowed, work_used, work_limit)
                return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, node.right, binder, depth + 1, shadowed, work_used, work_limit)
                return proof_kernel_replay_substitution_capture_safe(nodes, children, node.auxiliary, binder, depth + 1, shadowed, work_used, work_limit)
            if node.kind in {"call", "index-n"}:
                return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, node.left, binder, depth + 1, shadowed, work_used, work_limit)
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, nodes, binder, depth, shadowed, work_used, work_limit|:
                    return false if not proof_kernel_replay_substitution_charge(work_used, work_limit, 1)
                    return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, children[node.children_start + index], binder, depth + 1, shadowed, work_used, work_limit)
                return true
            if node.kind in {"array", "tuple", "set", "dict"}:
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, nodes, binder, depth, shadowed, work_used, work_limit|:
                    return false if not proof_kernel_replay_substitution_charge(work_used, work_limit, 1)
                    return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, children[node.children_start + index], binder, depth + 1, shadowed, work_used, work_limit)
                return true
            if node.kind in {"construct", "record-update"}:
                return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, node.left, binder, depth + 1, shadowed, work_used, work_limit)
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, nodes, binder, depth, shadowed, work_used, work_limit|:
                    return false if not proof_kernel_replay_substitution_charge(work_used, work_limit, 1)
                    return false if not proof_kernel_replay_substitution_capture_safe(nodes, children, children[node.children_start + index], binder, depth + 1, shadowed, work_used, work_limit)
                return true
            if node.kind == "quantifier":
                range_safe: bool = proof_kernel_replay_substitution_capture_safe(nodes, children, node.left, binder, depth + 1, shadowed, work_used, work_limit)
                return false if not range_safe
                body_shadowed: bool = shadowed or node.name == binder or node.secondary_name == binder
                return proof_kernel_replay_substitution_capture_safe(nodes, children, node.right, binder, depth + 1, body_shadowed, work_used, work_limit)
            return false

        def proof_kernel_replay_substitution_memo_store(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, original_node_count: usize, memo_root: mutable usize&, memo_value: mutable usize&, memo_depth: mutable usize&, root: usize, depth: usize, result: usize) -> usize:
            # Check against the post-rewrite arena count: add_node returns its pre-append
            # count as a new root, while failure returns the current count sentinel.
            if root < original_node_count and result < nodes.count:
                memo_root <- root
                memo_value <- result
                memo_depth <- depth
            return result

        def proof_kernel_replay_substitute_with_work_limit(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, name: sview, value_root: usize, depth: usize, work_used: mutable usize&, work_limit: usize) -> usize:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            return nodes.count if not proof_kernel_replay_substitution_charge(work_used, work_limit, 0)
            original_node_count: usize = nodes.count
            # A single-entry cache captures repeated sibling references without a 512-slot
            # allocation and clearing cost on every finite-candidate substitution.
            memo_root: mutable usize = original_node_count
            memo_value: mutable usize = 0
            memo_depth: mutable usize = 0
            return nodes.count if not proof_kernel_replay_substitution_charge(work_used, work_limit, 3)
            result: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, root, name, value_root, depth, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
            if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or result >= nodes.count:
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
                return nodes.count
            return result

        def proof_kernel_replay_substitute_recursive_with_work_limit(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, name: sview, value_root: usize, depth: usize, original_node_count: usize, memo_root: mutable usize&, memo_value: mutable usize&, memo_depth: mutable usize&, work_used: mutable usize&, work_limit: usize) -> usize:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return nodes.count if not proof_kernel_replay_substitution_charge(work_used, work_limit, 1)
            return ElisaProofKernelCore::add_node(nodes, "unsupported", "substitution-depth", 0, 0, 0, 0, 0, 0, "", "") if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return nodes.count if root >= original_node_count
            return memo_value if memo_root == root and memo_depth == depth
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if not proof_kernel_replay_substitution_node_charge(node, work_used, work_limit)
            if node.kind == "ident":
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if:
                    not proof_kernel_replay_substitution_charge(work_used, work_limit, sview_len(name))
                    not proof_kernel_replay_substitution_charge(work_used, work_limit, 1)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if node.name == name and not proof_kernel_replay_valid(nodes, value_root)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, value_root) if node.name == name
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, root)
            if node.kind == "typed-int":
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, root) if ElisaProofKernelCore::typed_literal_value(node).known
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "unsupported", "typed-literal-shape", 0, 0, 0, 0, 0, 0, "", ""))
            return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, root) if node.kind in {"int", "bool", "float", "opaque-float-literal", "string", "char", "shorthand", "absent", "unsupported"}
            if node.kind in {"unary", "move"}:
                child: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or child >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, child, 0, 0, 0, 0, node.value, node.name, node.secondary_name))
            if node.kind in {"binary", "index", "dict_entry"}:
                left: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or left >= nodes.count
                right: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.right, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or right >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, left, right, node.auxiliary, 0, 0, node.value, node.name, node.secondary_name))
            if node.kind == "slice":
                object: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or object >= nodes.count
                low: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.right, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or low >= nodes.count
                high: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.auxiliary, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or high >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "slice", "", object, low, high, 0, 0, 0, "", ""))
            if node.kind == "index-n":
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "unsupported", "index-n-children", 0, 0, 0, 0, 0, 0, "", "")) if:
                    node.children_count == 0
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                argument_roots: mutable darray[usize] = []
                for index in 0..<node.children_count |index, node, children, nodes, name, value_root, depth, argument_roots, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit|:
                    argument: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, children[node.children_start + index], name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                    return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or argument >= nodes.count
                    argument_roots.push(argument)
                object: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or object >= nodes.count
                start: usize = children.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if:
                    not proof_kernel_replay_substitution_charge(work_used, work_limit, node.children_count)
                    not proof_kernel_replay_extend_children(children, argument_roots, start)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "index-n", "", object, 0, 0, start, node.children_count, 0, "", ""))
            if node.kind == "checked-index":
                guarded: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or guarded >= nodes.count
                fallback: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.right, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or fallback >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "checked-index", "", guarded, fallback, 0, 0, 0, 0, "", ""))
            if node.kind == "checked-get":
                guarded: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or guarded >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "checked-get", "", guarded, 0, 0, 0, 0, 0, "", ""))
            if node.kind == "if":
                condition: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or condition >= nodes.count
                then_value: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.right, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or then_value >= nodes.count
                else_value: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.auxiliary, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or else_value >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "if", "", condition, then_value, else_value, 0, 0, 0, "", ""))
            if node.kind in {"field", "scope"}:
                object: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or object >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, object, 0, 0, 0, 0, node.value, node.name, node.secondary_name))
            if node.kind == "call_arg":
                argument: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or argument >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "call_arg", "", argument, 0, 0, 0, 0, 0, node.name, node.secondary_name))
            if node.kind == "field-init":
                field_value: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or field_value >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "field-init", "", field_value, 0, 0, 0, 0, 0, node.name, node.secondary_name))
            if node.kind == "call":
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "unsupported", "call-children", 0, 0, 0, 0, 0, 0, "", "")) if:
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                callee: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or callee >= nodes.count
                argument_roots: mutable darray[usize] = []
                for index in 0..<node.children_count |index, node, children, nodes, name, value_root, depth, argument_roots, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit|:
                    argument: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, children[node.children_start + index], name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                    return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or argument >= nodes.count
                    argument_roots.push(argument)
                start: usize = children.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if:
                    not proof_kernel_replay_substitution_charge(work_used, work_limit, node.children_count)
                    not proof_kernel_replay_extend_children(children, argument_roots, start)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "call", node.operator, callee, 0, node.auxiliary, start, node.children_count, node.value, node.name, node.secondary_name))
            if node.kind == "quantifier":
                range: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or range >= nodes.count
                body: mutable usize = node.right
                if node.name != name and node.secondary_name != name:
                    capture_safe: bool = proof_kernel_replay_substitution_capture_safe(nodes, children, value_root, node.name, 0, false, work_used, work_limit)
                    return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "unsupported", "substitution-under-quantifier", 0, 0, 0, 0, 0, 0, "", "")) if not capture_safe
                    if node.secondary_name != "":
                        capture_safe <- proof_kernel_replay_substitution_capture_safe(nodes, children, value_root, node.secondary_name, 0, false, work_used, work_limit)
                        return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "unsupported", "substitution-under-quantifier", 0, 0, 0, 0, 0, 0, "", "")) if not capture_safe
                    body <- proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.right, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                    return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or body >= nodes.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "quantifier", node.operator, range, body, node.auxiliary, 0, 0, node.value, node.name, node.secondary_name))
            if node.kind in {"array", "tuple", "set", "dict"}:
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "unsupported", "collection-substitution", 0, 0, 0, 0, 0, 0, "", "")) if:
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                element_roots: mutable darray[usize] = []
                for index in 0..<node.children_count |index, node, children, nodes, name, value_root, depth, element_roots, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit|:
                    element: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, children[node.children_start + index], name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                    return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or element >= nodes.count
                    element_roots.push(element)
                start: usize = children.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if:
                    not proof_kernel_replay_substitution_charge(work_used, work_limit, node.children_count)
                    not proof_kernel_replay_extend_children(children, element_roots, start)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, node.kind, "", 0, 0, 0, start, node.children_count, 0, "", ""))
            if node.kind in {"construct", "record-update"}:
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "unsupported", "construction-substitution", 0, 0, 0, 0, 0, 0, "", "")) if:
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                base: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, node.left, name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or base >= nodes.count
                field_roots: mutable darray[usize] = []
                for index in 0..<node.children_count |index, node, children, nodes, name, value_root, depth, field_roots, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit|:
                    field: usize = proof_kernel_replay_substitute_recursive_with_work_limit(nodes, children, children[node.children_start + index], name, value_root, depth + 1, original_node_count, memo_root, memo_value, memo_depth, work_used, work_limit)
                    return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if work_used > proof_kernel_replay_substitution_effective_limit(work_limit) or field >= nodes.count
                    field_roots.push(field)
                start: usize = children.count
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, nodes.count) if:
                    not proof_kernel_replay_substitution_charge(work_used, work_limit, node.children_count)
                    not proof_kernel_replay_extend_children(children, field_roots, start)
                return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, node.kind, "", base, 0, 0, start, node.children_count, 0, "", ""))
            return proof_kernel_replay_substitution_memo_store(nodes, original_node_count, memo_root, memo_value, memo_depth, root, depth, ElisaProofKernelCore::add_node(nodes, "unsupported", "substitution", 0, 0, 0, 0, 0, 0, "", ""))
