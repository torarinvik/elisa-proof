extend ElisaProofKernelReplay:
    private:
        # A shared DAG can be revisited at progressively deeper paths. Bound total work as well
        # as serialized arena size so adversarial sharing cannot turn the depth-aware validation
        # into an unbounded CPU or worklist allocation problem.
        const PROOF_KERNEL_REPLAY_WORK_BUDGET: usize = ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET + ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET * 8
        const PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET: usize = ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET * 2 + ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET * 8

        def proof_kernel_replay_arena_shape_text_work_charge(amount: usize, work_used: mutable usize&, work_used_before: usize, work_limit: usize) -> bool:
            requires work_used_before == work_used
            requires work_limit <= PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET
            ensure result implies work_used <= work_limit
            ensure not result implies work_used >= work_limit
            ensure result implies work_used == work_used_before + amount
            ensure result implies work_used_before <= work_limit and amount <= work_limit - work_used_before
            ensure not result and work_used_before <= work_limit implies (
                amount > work_limit - work_used_before
                and work_used == work_limit
            )
            ensure not result and work_used_before > work_limit implies work_used == work_used_before
            if work_used > work_limit:
                return false
            if amount > work_limit - work_used:
                work_used <- work_limit
                return false
            work_used <- work_used + amount
            return true
        def proof_kernel_replay_arena_shape_text_work(node: ElisaProofKernelCore::ProofKernelNode, work_used: mutable usize&, work_used_before: usize, work_limit: usize) -> bool:
            requires work_used_before == work_used
            requires work_limit <= PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET
            requires work_used <= work_limit
            ensure result implies work_used <= work_limit
            ensure not result implies work_used == work_limit
            ensure result and node.kind == "quantifier" and node.auxiliary != 1 and node.name != "" and node.secondary_name != "" implies work_used == work_used_before + sview_len(node.kind) + sview_len(node.operator) + sview_len(node.name) + sview_len(node.secondary_name)
            ensure result and node.kind == "structural-argument" and node.operator == "same" implies work_used == work_used_before + sview_len(node.kind) + sview_len(node.operator) + sview_len(node.name) + sview_len(node.secondary_name)
            ensure result and not (node.kind == "quantifier" and node.auxiliary != 1 and node.name != "" and node.secondary_name != "") and not (node.kind == "structural-argument" and node.operator == "same") implies work_used == work_used_before + sview_len(node.kind) + sview_len(node.operator)
            kind_charge_before: usize = work_used
            return false if not proof_kernel_replay_arena_shape_text_work_charge(sview_len(node.kind), work_used, kind_charge_before, work_limit)
            operator_charge_before: usize = work_used
            return false if not proof_kernel_replay_arena_shape_text_work_charge(sview_len(node.operator), work_used, operator_charge_before, work_limit)
            # Other name checks compare only against empty or a fixed literal. Charge full
            # variable text only when shape admission compares two source-controlled names.
            if node.kind == "quantifier" and node.auxiliary != 1 and node.name != "" and node.secondary_name != "":
                first_charge_before: usize = work_used
                return false if not proof_kernel_replay_arena_shape_text_work_charge(sview_len(node.name), work_used, first_charge_before, work_limit)
                second_charge_before: usize = work_used
                return proof_kernel_replay_arena_shape_text_work_charge(sview_len(node.secondary_name), work_used, second_charge_before, work_limit)
            if node.kind == "structural-argument" and node.operator == "same":
                first_charge_before: usize = work_used
                return false if not proof_kernel_replay_arena_shape_text_work_charge(sview_len(node.name), work_used, first_charge_before, work_limit)
                second_charge_before: usize = work_used
                return proof_kernel_replay_arena_shape_text_work_charge(sview_len(node.secondary_name), work_used, second_charge_before, work_limit)
            return true
        def proof_kernel_replay_arena_push_work(work: mutable darray[ProofKernelReplayArenaWork]&, work_used: mutable usize&, root: usize, depth: usize, exiting: bool, work_limit: usize) -> bool:
            requires work_limit <= PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET
            ensure result implies work_used <= work_limit
            ensure not result implies work_used >= work_limit
            ensure result implies (
                work.count > 0
                and work[work.count - 1].root == root
                and work[work.count - 1].depth == depth
                and work[work.count - 1].exiting == exiting
            )
            return false if work_used >= work_limit
            work.push(ProofKernelReplayArenaWork{root: root, depth: depth, exiting: exiting})
            work_used <- work_used + 1
            return true

        def proof_kernel_replay_arena_push_child_range(children: darray[usize]&, start: usize, count: usize, depth: usize, work: mutable darray[ProofKernelReplayArenaWork]&, work_used: mutable usize&, work_limit: usize) -> bool:
            requires work_limit <= PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET
            requires work_used <= work_limit
            ensure result implies work_used <= work_limit
            ensure result implies proof_kernel_replay_child_range_valid(start, count, children.count)
            ensure result implies (forall child_index in 0..<count:
                proof_kernel_replay_child_at(children, start + child_index).known
            )
            return false if not proof_kernel_replay_child_range_valid(start, count, children.count)
            for index in 0..<count |index, children, start, depth, work, work_used|:
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, start + index)
                return false if:
                    not child.known
                    not proof_kernel_replay_arena_push_work(work, work_used, child.value, depth, false, work_limit)
            return true

        def proof_kernel_replay_arena_push_children(node: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, depth: usize, work: mutable darray[ProofKernelReplayArenaWork]&, work_used: mutable usize&, work_limit: usize) -> bool:
            requires work_limit <= PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET
            requires work_used <= work_limit
            ensure result implies work_used <= work_limit
            next_depth: usize = depth + 1
            if node.kind in {"resource-region-return", "resource-call-result"}:
                return false if not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                carries_type_witness: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) != 0 or node.kind == "resource-region-return" and node.operator == "value-param" or node.kind == "resource-call-result" and node.operator == "value"
                return proof_kernel_replay_arena_push_work(work, work_used, node.right, next_depth, false, work_limit) if carries_type_witness
                return true
            if node.kind in {"unary", "move", "field", "scope", "call_arg", "field-init", "effect-call", "checked-get", "resource-call-arg", "resource-region-alloc", "resource-region-alloc-discard", "resource-region-return-alloc", "resource-region-call-alloc", "resource-region-rebind-alloc", "resource-region-assign", "resource-sview-param"}:
                return proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
            if node.kind == "resource-region-bind":
                return false if not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                return proof_kernel_replay_arena_push_work(work, work_used, node.right, next_depth, false, work_limit) if (node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) != 0
                return true
            if node.kind in {"binary", "index", "dict_entry", "checked-index"}:
                return false if not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                return proof_kernel_replay_arena_push_work(work, work_used, node.right, next_depth, false, work_limit)
            if node.kind == "slice":
                return false if:
                    not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                    not proof_kernel_replay_arena_push_work(work, work_used, node.right, next_depth, false, work_limit)
                return proof_kernel_replay_arena_push_work(work, work_used, node.auxiliary, next_depth, false, work_limit)
            if node.kind in {"if", "quantifier"}:
                return false if:
                    not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                    not proof_kernel_replay_arena_push_work(work, work_used, node.right, next_depth, false, work_limit)
                if node.kind == "if":
                    return proof_kernel_replay_arena_push_work(work, work_used, node.auxiliary, next_depth, false, work_limit)
                return true
            if node.kind in {"frame-place", "frame-policy"}:
                if node.kind == "frame-policy":
                    return false if not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                return proof_kernel_replay_arena_push_child_range(children, node.children_start, node.children_count, next_depth, work, work_used, work_limit)
            if node.kind == "effect-containment":
                return false if not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                return proof_kernel_replay_arena_push_child_range(children, node.children_start, node.children_count, next_depth, work, work_used, work_limit)
            if node.kind in {"index-n", "construct", "record-update", "call", "effect-row", "array", "tuple", "set", "dict", "resource-call", "resource-call-lend"}:
                if node.kind in {"index-n", "construct", "record-update", "call", "resource-call"}:
                    return false if not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                return proof_kernel_replay_arena_push_child_range(children, node.children_start, node.children_count, next_depth, work, work_used, work_limit)
            if node.kind in {"resource-scope", "resource-alternatives", "resource-safety", "structural-safety", "structural-edge"}:
                return proof_kernel_replay_arena_push_child_range(children, node.children_start, node.children_count, next_depth, work, work_used, work_limit)
            if node.kind == "resource-disjoint":
                return false if:
                    not proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
                    not proof_kernel_replay_arena_push_work(work, work_used, node.right, next_depth, false, work_limit)
                    not proof_kernel_replay_arena_push_work(work, work_used, node.auxiliary, next_depth, false, work_limit)
                return proof_kernel_replay_arena_push_child_range(children, node.children_start, node.children_count, next_depth, work, work_used, work_limit)
            if node.kind == "resource-bind":
                return true if node.operator in {"value", "external-shared", "external-mutable"}
                return proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
            if node.kind in {"resource-write", "resource-move"}:
                return proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
            if node.kind == "resource-use":
                return proof_kernel_replay_arena_push_work(work, work_used, node.left, next_depth, false, work_limit)
            return true

        # Iterative fail-closed arena admission. `visiting` is the active DFS color, `visited`
        # memoizes completed nodes, and `validity` prevents a malformed shared child from being
        # accepted on a later path. Work insertion is bounded independently of the serialized
        # graph, while the explicit depth field retains the certificate-level term bound.
        def proof_kernel_replay_arena_valid_with_workspace_limit(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&, work_limit: usize, reuse_arena_cache: bool) -> bool:
            requires work_limit <= PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET
            ensure result implies nodes.count <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            ensure result implies children.count <= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
            ensure result implies facts.count <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            ensure result implies goal_root < nodes.count
            ensure result implies (forall fact in facts: fact < nodes.count)
            ensure result implies workspace.work_used <= work_limit
            ensure result implies workspace.visiting.count == nodes.count and workspace.visited.count == nodes.count and workspace.validity.count == nodes.count and workspace.visited_depth.count == nodes.count
            ensure result implies workspace.work.count == 0
            return false if:
                nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
                children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
                facts.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            # A DAG node can be reached at multiple depths. Memoizing only a boolean would let
            # a shallow first path hide a later path that exceeds the certificate depth bound.
            # Revisit the node whenever the new path is deeper than the deepest path validated.
            workspace.work_used <- 0
            initialize_cache: bool = not reuse_arena_cache or not workspace.arena_cache_initialized or workspace.arena_cache_node_count != nodes.count
            if initialize_cache:
                return false if nodes.count > work_limit / 8 or not proof_kernel_replay_arena_shape_text_work_charge(nodes.count * 8, &workspace.work_used, workspace.work_used, work_limit)
                workspace.visiting.resize(nodes.count)
                workspace.visited.resize(nodes.count)
                workspace.validity.resize(nodes.count)
                workspace.visited_depth.resize(nodes.count)
                for index in 0..<nodes.count |workspace|:
                    workspace.visiting[index] <- false
                    workspace.visited[index] <- false
                    workspace.validity[index] <- false
                    workspace.visited_depth[index] <- 0
                workspace.arena_cache_initialized <- true
                workspace.arena_cache_node_count <- nodes.count
            workspace.work.clear()
            # Visit the goal even when `facts` is empty, then validate each fact as its own root.
            root_count: usize = facts.count + 1
            for root_index in 0..<root_count |root_index, facts, goal_root, workspace|:
                root: usize = goal_root if root_index == 0 else facts[root_index - 1]
                return false if not proof_kernel_replay_arena_push_work(&workspace.work, &workspace.work_used, root, 0, false, work_limit)
                while workspace.work.count > 0 |workspace, nodes, children|:
                    current: ProofKernelReplayArenaWork = workspace.work.pop()
                    return false if:
                        current.root >= nodes.count
                        current.depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(current.depth)
                    if current.exiting:
                        located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, current.root)
                        return false if not located.known
                        # Exit validation rereads serialized child ranges after the DFS
                        # already charged their pushes. Charge each child as it is inspected.
                        valid: bool = proof_kernel_replay_arena_children_valid_with_work(nodes, located.node, children, workspace.validity, current.root, false, &workspace.work_used, work_limit)
                        return false if:
                            not proof_kernel_replay_bool_set(workspace.visiting, current.root, false)
                            not proof_kernel_replay_bool_set(workspace.visited, current.root, true)
                        workspace.visited_depth[current.root] <- current.depth
                        return false if:
                            not proof_kernel_replay_bool_set(workspace.validity, current.root, valid)
                            not valid
                        continue
                    visited_value: (known: bool, value: bool) = proof_kernel_replay_bool_at(workspace.visited, current.root)
                    visiting_value: (known: bool, value: bool) = proof_kernel_replay_bool_at(workspace.visiting, current.root)
                    validity_value: (known: bool, value: bool) = proof_kernel_replay_bool_at(workspace.validity, current.root)
                    return false if:
                        not visited_value.known or not visiting_value.known or not validity_value.known
                        visiting_value.value
                    if visited_value.value:
                        return false if not validity_value.value
                        continue if current.depth <= workspace.visited_depth[current.root]
                        # This is a valid node, but its children have not yet been checked at this
                        # deeper path. Clear the memoized completion and perform a fresh DFS below.
                        return false if not proof_kernel_replay_bool_set(workspace.visited, current.root, false)
                    located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, current.root)
                    return false if not located.known
                    shape_text_work_before: usize = workspace.work_used
                    return false if:
                        not proof_kernel_replay_arena_shape_text_work(located.node, &workspace.work_used, shape_text_work_before, work_limit)
                        not proof_kernel_replay_arena_shape_valid(located.node)
                        not proof_kernel_replay_bool_set(workspace.visiting, current.root, true)
                        not proof_kernel_replay_arena_push_work(&workspace.work, &workspace.work_used, current.root, current.depth, true, work_limit)
                        not proof_kernel_replay_arena_push_children(located.node, children, current.depth, &workspace.work, &workspace.work_used, work_limit)
            return true

        def proof_kernel_replay_arena_valid_with_workspace(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
            return proof_kernel_replay_arena_valid_with_workspace_limit(nodes, children, facts, goal_root, workspace, PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET, false)

        def proof_kernel_replay_arena_valid_iterative(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> bool:
            ensure result implies nodes.count <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            ensure result implies children.count <= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
            ensure result implies facts.count <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            ensure result implies goal_root < nodes.count
            ensure result implies (forall fact in facts: fact < nodes.count)
            workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
            return proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, &workspace)

        # Tactic traces share one meter across each state and auxiliary-root admission. Keep the
        # validator's local cap as a per-call safety bound, then debit its measured scratch setup,
        # graph traversal, and inspected text into the trace counter even when admission fails.
        def proof_kernel_replay_arena_valid_with_trace_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, trace_work: mutable usize&) -> bool:
            workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
            return proof_kernel_replay_arena_valid_with_trace_workspace(nodes, children, facts, goal_root, &workspace, trace_work)

        def proof_kernel_replay_arena_valid_with_trace_workspace(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&, trace_work: mutable usize&) -> bool:
            return false if trace_work >= PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
            remaining: usize = PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT - trace_work
            work_limit: usize = remaining if remaining < PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET else PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET
            # This private batch helper is called only while the owning tactic operation holds
            # one unchanged arena reference across its root checks. General workspace APIs use
            # the non-reusing path so a caller may safely pass another same-sized arena later.
            valid: bool = proof_kernel_replay_arena_valid_with_workspace_limit(nodes, children, facts, goal_root, workspace, work_limit, true)
            within_trace_budget: bool = proof_kernel_replay_tactic_trace_charge(trace_work, workspace.work_used)
            return valid and within_trace_budget

        def proof_kernel_replay_arena_valid[@r](nodes: darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
            ensure result implies nodes.count <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            ensure result implies children.count <= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
            ensure result implies facts.count <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            ensure result implies goal_root < nodes.count
            ensure result implies (forall fact in facts: fact < nodes.count)
            return proof_kernel_replay_arena_valid_iterative(nodes, children, facts, goal_root)

        def proof_kernel_replay_arena_all_valid[@r](nodes: darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r) -> bool can[Global.Read, Global.Write]:
            ensure result implies nodes.count <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and children.count <= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
            ensure result implies (forall node_index in 0..<nodes.count: proof_kernel_replay_arena_shape_valid(nodes[node_index]))
            ensure result implies (forall node_index in 0..<nodes.count:
                (
                    (nodes[node_index].kind == "index-n" or nodes[node_index].kind == "construct" or nodes[node_index].kind == "record-update" or nodes[node_index].kind == "call" or nodes[node_index].kind == "effect-row" or nodes[node_index].kind == "effect-containment" or nodes[node_index].kind == "array" or nodes[node_index].kind == "tuple" or nodes[node_index].kind == "set" or nodes[node_index].kind == "dict" or nodes[node_index].kind == "resource-call" or nodes[node_index].kind == "resource-call-lend" or nodes[node_index].kind == "resource-scope" or nodes[node_index].kind == "resource-alternatives" or nodes[node_index].kind == "resource-safety" or nodes[node_index].kind == "resource-disjoint" or nodes[node_index].kind == "structural-safety" or nodes[node_index].kind == "structural-edge")
                    implies (
                        proof_kernel_replay_child_range_valid(nodes[node_index].children_start, nodes[node_index].children_count, children.count)
                        and (forall child_index in 0..<nodes[node_index].children_count:
                            proof_kernel_replay_child_at(children, nodes[node_index].children_start + child_index).known
                            and proof_kernel_replay_child_at(children, nodes[node_index].children_start + child_index).value < node_index
                        )
                    )
                )
            )
            ensure result implies (forall parent in 0..<nodes.count:
                (
                    ((nodes[parent].kind == "unary" or nodes[parent].kind == "move" or nodes[parent].kind == "field" or nodes[parent].kind == "scope" or nodes[parent].kind == "call_arg" or nodes[parent].kind == "field-init" or nodes[parent].kind == "effect-call" or nodes[parent].kind == "checked-get" or nodes[parent].kind == "resource-call-arg" or nodes[parent].kind == "resource-region-alloc" or nodes[parent].kind == "resource-region-alloc-discard" or nodes[parent].kind == "resource-region-return-alloc" or nodes[parent].kind == "resource-region-call-alloc" or nodes[parent].kind == "resource-region-rebind-alloc" or nodes[parent].kind == "resource-region-bind" or nodes[parent].kind == "resource-sview-param" or nodes[parent].kind == "resource-region-assign" or nodes[parent].kind == "resource-region-return" or nodes[parent].kind == "resource-write" or nodes[parent].kind == "resource-move" or nodes[parent].kind == "resource-use" or nodes[parent].kind == "resource-call-result") implies nodes[parent].left < parent)
                    and ((nodes[parent].kind == "binary" or nodes[parent].kind == "index" or nodes[parent].kind == "dict_entry" or nodes[parent].kind == "checked-index") implies nodes[parent].left < parent and nodes[parent].right < parent)
                    and ((nodes[parent].kind == "slice" or nodes[parent].kind == "resource-disjoint") implies nodes[parent].left < parent and nodes[parent].right < parent and nodes[parent].auxiliary < parent)
                    and ((nodes[parent].kind == "if" or nodes[parent].kind == "quantifier") implies nodes[parent].left < parent and nodes[parent].right < parent)
                    and ((nodes[parent].kind == "if") implies nodes[parent].auxiliary < parent)
                    and ((nodes[parent].kind == "index-n" or nodes[parent].kind == "construct" or nodes[parent].kind == "record-update" or nodes[parent].kind == "call" or nodes[parent].kind == "resource-call") implies nodes[parent].left < parent)
                    and ((nodes[parent].kind == "resource-bind" and (nodes[parent].operator == "shared" or nodes[parent].operator == "mutable")) implies nodes[parent].left < parent)
                )
            )
            # The serialized arena is canonical postorder: every edge points to a node emitted
            # earlier. This is already how the producer's append-only `add_node` protocol works.
            # Enforcing that order here rejects every cycle (including a cycle in an otherwise
            # disconnected component) during the single local pass, without retaining a second
            # graph-sized worklist for a large report. Keep the semantic child-validity bitset as
            # part of this same pass: after this result is cached, the report replay fast path must
            # not be able to bypass the per-root validator's child-kind checks.
            return false if:
                nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
                children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
            validity: mutable darray[bool] = []
            arena_validation_work: mutable usize = 0
            allocation_work_before: usize = arena_validation_work
            return false if not proof_kernel_replay_arena_shape_text_work_charge(nodes.count, &arena_validation_work, allocation_work_before, PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET)
            validity.resize(nodes.count)
            for index in 0..<nodes.count |index, nodes, children, arena_validation_work|:
                node_work_before: usize = arena_validation_work
                return false if not proof_kernel_replay_arena_shape_text_work_charge(1, &arena_validation_work, node_work_before, PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET)
                can Global{Read,Write}:
                    proof_kernel_replay_arena_records_scanned <- proof_kernel_replay_arena_records_scanned + 1
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, index)
                return false if not located.known
                shape_work_before: usize = arena_validation_work
                return false if not proof_kernel_replay_arena_shape_text_work(located.node, &arena_validation_work, shape_work_before, PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET)
                return false if not proof_kernel_replay_arena_shape_valid(located.node)
                node: ElisaProofKernelCore::ProofKernelNode = located.node
                if node.kind in {"unary", "move", "field", "scope", "call_arg", "field-init", "effect-call", "checked-get", "resource-call-arg", "resource-region-alloc", "resource-region-alloc-discard", "resource-region-return-alloc", "resource-region-call-alloc", "resource-region-rebind-alloc", "resource-region-bind", "resource-sview-param", "resource-region-assign", "resource-region-return", "resource-write", "resource-move", "resource-use", "resource-call-result"}:
                    return false if node.left >= index
                if node.kind in {"binary", "index", "dict_entry", "checked-index"}:
                    return false if node.left >= index or node.right >= index
                if node.kind in {"slice", "resource-disjoint"}:
                    return false if node.left >= index or node.right >= index or node.auxiliary >= index
                if node.kind in {"if", "quantifier"}:
                    return false if:
                        node.left >= index or node.right >= index
                        node.kind == "if" and node.auxiliary >= index
                if node.kind in {"index-n", "construct", "record-update", "call", "resource-call"}:
                    return false if node.left >= index
                if node.kind == "resource-bind" and (node.operator in {"shared", "mutable"}):
                    return false if node.left >= index
                return false if not proof_kernel_replay_arena_children_valid_with_work(nodes, node, children, validity, index, true, &arena_validation_work, PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET)
                validity[index] <- true
            return true
