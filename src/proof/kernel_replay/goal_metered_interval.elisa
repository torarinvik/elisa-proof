extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_loop_range_atom_key_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&) -> (known: bool, name: sview, offset: i64):
            empty: (known: bool, name: sview, offset: i64) = (false, "", 0)
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            return empty if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return empty if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if node.kind != "tuple" or node.children_count != 2 or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start)
            return empty if not first.known or first.value >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, first.value, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + 1)
            return empty if not second.known or second.value >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, second.value, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return empty if nodes[first.value].kind != "ident" or nodes[first.value].name == "" or nodes[second.value].kind != "int"
            (true, nodes[first.value].name, nodes[second.value].value)

        def proof_kernel_replay_interval_bound_for_term_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, bounds: darray[ProofKernelReplayBound]&, root: usize, work_used: mutable usize&) -> ProofKernelReplayBound:
            for bound in bounds |bound, nodes, children, root, work_used|:
                return ProofKernelReplayBound{name: "", term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0} if not proof_kernel_replay_goal_search_charge(work_used)
                continue if not bound.term_expression_key or bound.term_root >= nodes.count
                return bound if proof_kernel_replay_goal_search_expr_equal(nodes, children, bound.term_root, root, work_used)
                return ProofKernelReplayBound{name: "", term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0} if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            key: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key_with_goal_work(nodes, children, root, work_used)
            return ProofKernelReplayBound{name: "", term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0} if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for bound in bounds |bound, key, work_used|:
                return ProofKernelReplayBound{name: "", term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0} if not proof_kernel_replay_goal_search_charge(work_used)
                continue if not key.known or not bound.term_key
                same_name: bool = proof_kernel_replay_goal_search_text_equal(bound.term_name, key.name, work_used)
                return ProofKernelReplayBound{name: "", term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0} if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return bound if same_name and bound.term_offset == key.offset
            ProofKernelReplayBound{name: "", term_name: key.name, term_offset: key.offset, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_kernel_replay_safe_comparison_constant_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if root >= nodes.count
            proof_kernel_replay_small_constant_with_goal_work(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)

        def proof_kernel_replay_goal_search_text_equal(left: sview, right: sview, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(left))
            return false if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(right))
            left == right

        # The generic scalar-witness marker decoder charges the width evaluator but not the
        # marker's arena nodes or labels. Goal reports use this byte-aware decoder instead.
        def proof_kernel_replay_unsigned_marker_info_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize, work_used: mutable usize&) -> (known: bool, name_root: usize, width: i64):
            empty: (known: bool, name_root: usize, width: i64) = (false, 0, 0)
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            return empty if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return empty if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            marker: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if marker.kind != "call" or marker.operator != "" or marker.auxiliary != 0 or marker.children_count != 2 or not proof_kernel_replay_child_range_valid(marker.children_start, marker.children_count, children.count)
            return empty if marker.left >= nodes.count or not proof_kernel_replay_valid(nodes, marker.left) or not proof_kernel_replay_goal_search_charge_node_text(nodes, marker.left, work_used)
            callee_matches: bool = proof_kernel_replay_goal_search_ident_matches(nodes, marker.left, "__elisa_unsigned_type_bound", work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not callee_matches
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start)
            return empty if not first.known or first.value >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, first.value, work_used)
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start + 1)
            return empty if not second.known or second.value >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, second.value, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, first.value) or not proof_kernel_replay_valid(nodes, second.value)
            name_argument: ElisaProofKernelCore::ProofKernelNode = nodes[first.value]
            width_argument: ElisaProofKernelCore::ProofKernelNode = nodes[second.value]
            first_positional: bool = proof_kernel_replay_goal_search_text_equal(name_argument.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(name_argument.secondary_name, "", work_used)
            second_positional: bool = proof_kernel_replay_goal_search_text_equal(width_argument.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(width_argument.secondary_name, "", work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or name_argument.kind != "call_arg" or width_argument.kind != "call_arg" or not first_positional or not second_positional
            name_root: usize = name_argument.left
            return empty if name_root >= nodes.count or not proof_kernel_replay_valid(nodes, name_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, name_root, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[name_root].kind != "ident" or nodes[name_root].name == ""
            width: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, width_argument.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not width.known or width.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or width.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
            (true, name_root, width.value)

        def proof_kernel_replay_signed_marker_info_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize, work_used: mutable usize&) -> (known: bool, name_root: usize, width: i64):
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
            return (false, 0, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            marker: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, 0) if marker.kind != "call" or marker.operator != "" or marker.auxiliary != 0 or marker.children_count != 2
            return (false, 0, 0) if not proof_kernel_replay_child_range_valid(marker.children_start, marker.children_count, children.count)
            return (false, 0, 0) if marker.left >= nodes.count or not proof_kernel_replay_valid(nodes, marker.left) or not proof_kernel_replay_goal_search_charge_node_text(nodes, marker.left, work_used)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_ident_matches(nodes, marker.left, "__elisa_signed_type_bound", work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start + 1)
            return (false, 0, 0) if not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
            return (false, 0, 0) if not proof_kernel_replay_valid(nodes, first.value) or not proof_kernel_replay_valid(nodes, second.value)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, first.value, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, second.value, work_used)
            first_argument: ElisaProofKernelCore::ProofKernelNode = nodes[first.value]
            second_argument: ElisaProofKernelCore::ProofKernelNode = nodes[second.value]
            first_positional: bool = proof_kernel_replay_goal_search_text_equal(first_argument.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(first_argument.secondary_name, "", work_used)
            second_positional: bool = proof_kernel_replay_goal_search_text_equal(second_argument.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(second_argument.secondary_name, "", work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or first_argument.kind != "call_arg" or second_argument.kind != "call_arg" or not first_positional or not second_positional
            width: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, second_argument.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not width.known or not ElisaProofKernelCore::proof_kernel_signed_width_valid(width.value)
            name_root: usize = first_argument.left
            return (false, 0, 0) if name_root >= nodes.count or not proof_kernel_replay_valid(nodes, name_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, name_root, work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[name_root].kind != "ident" or nodes[name_root].name == ""
            (true, name_root, width.value)

        def proof_kernel_replay_signed_place_marker_info_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize, work_used: mutable usize&) -> (known: bool, term: usize, width: i64):
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
            return (false, 0, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            marker: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, 0) if marker.kind != "call" or marker.operator != "" or marker.auxiliary != 0 or marker.children_count != 2
            return (false, 0, 0) if not proof_kernel_replay_child_range_valid(marker.children_start, marker.children_count, children.count)
            return (false, 0, 0) if marker.left >= nodes.count or not proof_kernel_replay_valid(nodes, marker.left) or not proof_kernel_replay_goal_search_charge_node_text(nodes, marker.left, work_used)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_ident_matches(nodes, marker.left, "__elisa_signed_place_type_bound", work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start + 1)
            return (false, 0, 0) if not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
            return (false, 0, 0) if not proof_kernel_replay_valid(nodes, first.value) or not proof_kernel_replay_valid(nodes, second.value)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, first.value, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, second.value, work_used)
            first_argument: ElisaProofKernelCore::ProofKernelNode = nodes[first.value]
            second_argument: ElisaProofKernelCore::ProofKernelNode = nodes[second.value]
            first_name_empty: bool = proof_kernel_replay_goal_search_text_equal(first_argument.name, "", work_used)
            second_name_empty: bool = proof_kernel_replay_goal_search_text_equal(second_argument.name, "", work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or first_argument.kind != "call_arg" or second_argument.kind != "call_arg" or not first_name_empty or not second_name_empty
            term: usize = first_argument.left
            return (false, 0, 0) if term >= nodes.count or not proof_kernel_replay_valid(nodes, term)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, term, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if nodes[term].kind == "tuple":
                return (false, 0, 0) if nodes[term].children_count != 2 or not proof_kernel_replay_child_range_valid(nodes[term].children_start, 2, children.count)
                return (false, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
                tag_name: usize = children[nodes[term].children_start]
                return (false, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
                tag_offset: usize = children[nodes[term].children_start + 1]
                return (false, 0, 0) if tag_name >= nodes.count or tag_offset >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, tag_name, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, tag_offset, work_used)
                return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[tag_name].kind != "ident" or nodes[tag_name].name == "" or nodes[tag_offset].kind != "int"
            elif nodes[term].kind == "index":
                return (false, 0, 0) if nodes[term].operator != "" or nodes[term].children_count != 0 or nodes[term].auxiliary != 0
                index: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, nodes[term].right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used)
                return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not index.known or index.value != 0
            else:
                return (false, 0, 0) if nodes[term].kind != "field" and not (nodes[term].kind == "ident" and nodes[term].name != "") and nodes[term].kind != "call"
                if nodes[term].kind == "call":
                    callee_root: usize = nodes[term].left
                    return (false, 0, 0) if callee_root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, callee_root, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_named_call_term(nodes, term)
            width: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, second_argument.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not width.known or not ElisaProofKernelCore::proof_kernel_signed_width_valid(width.value)
            (true, term, width.value)

        def proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> i64:
            for fact in facts |fact, nodes, children, root, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info_with_goal_work(nodes, children, fact, 0, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not marker.known
                first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[fact].children_start)
                continue if not first.known or first.value >= nodes.count or nodes[first.value].kind != "call_arg"
                term_root: usize = nodes[first.value].left
                same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, term_root, root, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return marker.width if same_term
            for fact in facts |fact, nodes, children, root, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                place: (known: bool, term: usize, width: i64) = proof_kernel_replay_signed_place_marker_info_with_goal_work(nodes, children, fact, 0, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not place.known
                same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, place.term, root, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return place.width if same_term
            return 0

        def proof_kernel_replay_unsigned_marker_width_for_name_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], name: sview, work_used: mutable usize&) -> i64:
            width: mutable i64 = 0
            for fact in facts |fact, nodes, children, name, width, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info_with_goal_work(nodes, children, fact, 0, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not marker.known or marker.name_root >= nodes.count or nodes[marker.name_root].kind != "ident"
                matches: bool = proof_kernel_replay_goal_search_text_equal(nodes[marker.name_root].name, name, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not matches
                width <- marker.width if width == 0 or marker.width < width
            return width

        def proof_kernel_replay_goal_search_ident_matches(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, expected: sview, work_used: mutable usize&) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return false if nodes[root].kind != "ident"
            proof_kernel_replay_goal_search_text_equal(nodes[root].name, expected, work_used)

        def proof_kernel_replay_strict_signed_width_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize, work_used: mutable usize&) -> i64:
            return 0 if not proof_kernel_replay_goal_search_charge(work_used)
            return 0 if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident" or node.kind == "field" or node.kind == "index" or node.kind == "index-n":
                unsigned_width: mutable i64 = 0
                unsigned_width <- proof_kernel_replay_unsigned_marker_width_for_name_with_goal_work(nodes, children, facts, node.name, work_used) if node.kind == "ident"
                signed_width: i64 = proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes, children, facts, root, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return 0 - unsigned_width if unsigned_width > 0 and signed_width == 0
                return 0 if not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return signed_width
            if node.kind == "paren":
                return proof_kernel_replay_strict_signed_width_with_goal_work(nodes, children, facts, node.left, depth + 1, work_used)
            if node.kind == "unary":
                return 0 if node.operator != "-" and node.operator != "+"
                return proof_kernel_replay_strict_signed_width_with_goal_work(nodes, children, facts, node.left, depth + 1, work_used)
            if node.kind == "binary":
                return 0 if node.operator != "+" and node.operator != "-" and node.operator != "*" and node.operator != "/" and node.operator != "%"
                left_closed: bool = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, node.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT).known
                right_closed: bool = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, node.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT).known
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (left_closed and right_closed)
                left_width: i64 = 0 if left_closed else proof_kernel_replay_strict_signed_width_with_goal_work(nodes, children, facts, node.left, depth + 1, work_used)
                right_width: i64 = 0 if right_closed else proof_kernel_replay_strict_signed_width_with_goal_work(nodes, children, facts, node.right, depth + 1, work_used)
                return 0 if (not left_closed and left_width == 0) or (not right_closed and right_width == 0)
                return 0 if left_width != 0 and right_width != 0 and left_width != right_width
                return left_width if left_width != 0
                return right_width
            return 0

        def proof_kernel_replay_signed_width_in_expression_for_interval_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&, depth: usize) -> i64:
            return 0 if not proof_kernel_replay_goal_search_charge(work_used)
            return 0 if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "typed-int":
                literal = ElisaProofKernelCore::typed_literal_value(node)
                return literal.width if literal.known and not literal.unsigned
            if node.kind == "tuple":
                return 0 if not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, depth + 1, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes, children, facts, root, work_used)
            if node.kind == "ident" or node.kind == "field":
                return proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes, children, facts, root, work_used)
            if node.kind == "index":
                return 0 if not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, depth + 1, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes, children, facts, root, work_used)
            if node.kind == "paren" or node.kind == "unary":
                return proof_kernel_replay_signed_width_in_expression_for_interval_with_goal_work(nodes, children, facts, node.left, work_used, depth + 1)
            if node.kind == "binary":
                left_width: i64 = proof_kernel_replay_signed_width_in_expression_for_interval_with_goal_work(nodes, children, facts, node.left, work_used, depth + 1)
                right_width: i64 = proof_kernel_replay_signed_width_in_expression_for_interval_with_goal_work(nodes, children, facts, node.right, work_used, depth + 1)
                return 0 if left_width != 0 and right_width != 0 and left_width != right_width
                return left_width if left_width != 0
                return right_width
            0

        def proof_kernel_replay_add_signed_type_bounds_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info_with_goal_work(nodes, children, fact, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not marker.known
                marker_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, marker.name_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return false if not proof_kernel_replay_add_lower_with_work(bounds, marker_name, ElisaProofKernelCore::proof_kernel_signed_width_min(marker.width), work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if not proof_kernel_replay_add_upper_with_work(bounds, marker_name, ElisaProofKernelCore::proof_kernel_signed_width_max(marker.width), work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            true

        def proof_kernel_replay_close_term_equalities_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                root: mutable usize = fact
                steps: mutable usize = 0
                while steps < 8 and root < nodes.count and nodes[root].kind == "paren" |steps, root, nodes, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    root <- nodes[root].left
                    steps <- steps + 1
                continue if not proof_kernel_replay_valid(nodes, root)
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                continue if node.kind != "binary" or node.operator != "=="
                for side in 0..<2 |side, node, nodes, children, facts, bounds, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    name_root: usize = node.left if side == 0 else node.right
                    term_root: usize = node.right if side == 0 else node.left
                    continue if not proof_kernel_replay_valid(nodes, name_root) or not proof_kernel_replay_valid(nodes, term_root)
                    name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, name_root, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if name == ""
                    term_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, term_root, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if term_name != ""
                    width: i64 = proof_kernel_replay_signed_width_in_expression_for_interval_with_goal_work(nodes, children, facts, name_root, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if width <= 0
                    term_width: i64 = proof_kernel_replay_signed_width_in_expression_for_interval_with_goal_work(nodes, children, facts, term_root, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if term_width != width
                    safe_term: bool = proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, term_root, facts, bounds, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not safe_term
                    interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, term_root, bounds, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not interval.has_lower or not interval.has_upper
                    continue if interval.lower < ElisaProofKernelCore::proof_kernel_signed_width_min(width) or interval.upper > ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                    return false if not proof_kernel_replay_add_lower_with_work(bounds, name, interval.lower, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if not proof_kernel_replay_add_upper_with_work(bounds, name, interval.upper, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            true

        def proof_kernel_replay_signed_constant_at_width_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, width: i64, depth: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            return empty if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
            return empty if width == 0 or width < 0 - ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
            unsigned: bool = width < 0
            minimum: i64 = 0 if unsigned else ElisaProofKernelCore::proof_kernel_signed_width_min(width)
            maximum: i64 = proof_kernel_replay_unsigned_width_max(0 - width) if unsigned else ElisaProofKernelCore::proof_kernel_signed_width_max(width)
            return empty if maximum <= 0
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            result: mutable ProofKernelReplayInt = empty
            if node.kind == "int":
                return empty if node.value < 0 or node.value > maximum
                return ProofKernelReplayInt{known: true, value: node.value}
            if node.kind == "paren":
                return proof_kernel_replay_signed_constant_at_width_with_goal_work(nodes, node.left, width, depth + 1, work_used)
            if node.kind == "unary" and node.operator == "-" and not unsigned and node.left < nodes.count and nodes[node.left].kind == "int" and nodes[node.left].value > maximum:
                return empty if nodes[node.left].value - 1 != maximum
                return ProofKernelReplayInt{known: true, value: minimum}
            if node.kind == "unary":
                inner: ProofKernelReplayInt = proof_kernel_replay_signed_constant_at_width_with_goal_work(nodes, node.left, width, depth + 1, work_used)
                return empty if not inner.known
                return inner if node.operator == "+"
                return empty if node.operator != "-"
                result <- proof_kernel_replay_sub_safe(0, inner.value)
            if node.kind == "binary":
                left: ProofKernelReplayInt = proof_kernel_replay_signed_constant_at_width_with_goal_work(nodes, node.left, width, depth + 1, work_used)
                right: ProofKernelReplayInt = proof_kernel_replay_signed_constant_at_width_with_goal_work(nodes, node.right, width, depth + 1, work_used)
                return empty if not left.known or not right.known
                result <- proof_kernel_replay_add_safe(left.value, right.value) if node.operator == "+"
                result <- proof_kernel_replay_sub_safe(left.value, right.value) if node.operator == "-"
                result <- proof_kernel_replay_mul_safe(left.value, right.value) if node.operator == "*"
                result <- proof_kernel_replay_div_safe(left.value, right.value) if node.operator == "/"
                result <- proof_kernel_replay_mod_safe(left.value, right.value) if node.operator == "%"
            return empty if not result.known or result.value < minimum or result.value > maximum
            result

        def proof_kernel_replay_typed_comparison_constant_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], constant_root: usize, peer_root: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, constant_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not constant.known
            return empty if proof_kernel_replay_safe_comparison_constant_with_work(nodes, constant_root, work_used).known
            peer_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, peer_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or peer_constant.known
            width: i64 = proof_kernel_replay_strict_signed_width_with_goal_work(nodes, children, facts, peer_root, 0, work_used)
            return empty if width == 0 or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proof_kernel_replay_signed_constant_at_width_with_goal_work(nodes, constant_root, width, 0, work_used)

        def proof_kernel_replay_interval_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            return (false, 0, 0, false, false) if not proof_kernel_replay_goal_search_charge(work_used)
            return (false, 0, 0, false, false) if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if constant.known:
                safe_constant: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant_with_work(nodes, root, work_used)
                return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, safe_constant.value, safe_constant.value, true, true) if safe_constant.known
            return (false, 0, 0, false, false) if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            term_bound: ProofKernelReplayBound = proof_kernel_replay_interval_bound_for_term_with_work(nodes, children, bounds, root, work_used)
            return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (term_bound.has_lower and term_bound.has_upper, term_bound.lower, term_bound.upper, term_bound.has_lower, term_bound.has_upper) if term_bound.term_key or term_bound.term_expression_key
            if node.kind == "ident":
                named_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for_with_work(bounds, node.name, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (named_bound.has_lower and named_bound.has_upper, named_bound.lower, named_bound.upper, named_bound.has_lower, named_bound.has_upper)
            if node.kind == "unary" and node.operator == "-":
                inner: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.left, bounds, work_used, depth + 1)
                return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                negated_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, inner.upper)
                negated_upper: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, inner.lower)
                return (false, 0, 0, false, false) if not negated_lower.known or not negated_upper.known
                return (inner.has_lower and inner.has_upper, negated_lower.value, negated_upper.value, inner.has_upper, inner.has_lower)
            if node.kind == "binary" and node.operator == "+":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.left, bounds, work_used, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.right, bounds, work_used, depth + 1)
                return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                lower_sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(a.lower, b.lower)
                upper_sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(a.upper, b.upper)
                has_lower: bool = a.has_lower and b.has_lower and lower_sum.known
                has_upper: bool = a.has_upper and b.has_upper and upper_sum.known
                return (has_lower and has_upper, lower_sum.value, upper_sum.value, has_lower, has_upper)
            if node.kind == "binary" and node.operator == "-":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.left, bounds, work_used, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.right, bounds, work_used, depth + 1)
                return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                lower_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(a.lower, b.upper)
                upper_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(a.upper, b.lower)
                has_lower: bool = a.has_lower and b.has_upper and lower_difference.known
                has_upper: bool = a.has_upper and b.has_lower and upper_difference.known
                return (has_lower and has_upper, lower_difference.value, upper_difference.value, has_lower, has_upper)
            if node.kind == "binary" and node.operator == "*":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.left, bounds, work_used, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.right, bounds, work_used, depth + 1)
                return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not a.has_lower or not a.has_upper or not b.has_lower or not b.has_upper
                p1: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.lower, b.lower)
                p2: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.lower, b.upper)
                p3: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.upper, b.lower)
                p4: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.upper, b.upper)
                return (false, 0, 0, false, false) if not p1.known or not p2.known or not p3.known or not p4.known
                lower: mutable i64 = p1.value
                lower <- p2.value if p2.value < lower
                lower <- p3.value if p3.value < lower
                lower <- p4.value if p4.value < lower
                upper: mutable i64 = p1.value
                upper <- p2.value if p2.value > upper
                upper <- p3.value if p3.value > upper
                upper <- p4.value if p4.value > upper
                return (true, lower, upper, true, true)
            if node.kind == "binary" and node.operator == "/":
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, node.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                dividend: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.left, bounds, work_used, depth + 1)
                return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if not divisor.known:
                    range: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.right, bounds, work_used, depth + 1)
                    return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not range.has_lower or range.lower < 1 or not dividend.has_lower or not dividend.has_upper
                    return (true, 0, dividend.upper / range.lower, true, true) if not range.has_upper and dividend.lower >= 0
                    return (false, 0, 0, false, false) if not range.has_upper
                    return (true, dividend.lower / range.upper, dividend.upper / range.lower, true, true) if dividend.lower >= 0
                    return (true, dividend.lower / range.lower, dividend.upper / range.upper, true, true) if dividend.upper <= 0
                    return (true, dividend.lower / range.lower, dividend.upper / range.lower, true, true)
                return (false, 0, 0, false, false) if divisor.value == 0 or not dividend.has_lower or not dividend.has_upper
                lower_quotient: ProofKernelReplayInt = proof_kernel_replay_div_safe(dividend.lower, divisor.value)
                upper_quotient: ProofKernelReplayInt = proof_kernel_replay_div_safe(dividend.upper, divisor.value)
                return (false, 0, 0, false, false) if not lower_quotient.known or not upper_quotient.known
                return (true, lower_quotient.value, upper_quotient.value, true, true) if divisor.value > 0
                return (true, upper_quotient.value, lower_quotient.value, true, true)
            if node.kind == "binary" and node.operator == "%":
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, node.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return (false, 0, 0, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not divisor.known or divisor.value == 0 or divisor.value == -1
                magnitude: mutable i64 = divisor.value
                if magnitude < 0:
                    absolute: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, magnitude)
                    return (false, 0, 0, false, false) if not absolute.known
                    magnitude <- absolute.value
                limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(magnitude, 1)
                return (false, 0, 0, false, false) if not limit.known
                negative_limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, limit.value)
                return (false, 0, 0, false, false) if not negative_limit.known
                return (true, negative_limit.value, limit.value, true, true)
            return (false, 0, 0, false, false)

        def proof_kernel_replay_transport_defining_equality_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> void:
            return if not proof_kernel_replay_goal_search_charge(work_used)
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "and":
                proof_kernel_replay_transport_defining_equality_with_work(nodes, children, facts, node.left, bounds, work_used, depth + 1)
                proof_kernel_replay_transport_defining_equality_with_work(nodes, children, facts, node.right, bounds, work_used, depth + 1)
                return
            return if node.kind != "binary" or node.operator != "=="
            return if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            left_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, node.left, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, node.right, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if left_name != "":
                interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.right, bounds, work_used, 0)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return if interval.has_lower and not proof_kernel_replay_add_lower_with_work(bounds, left_name, interval.lower, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return if interval.has_upper and not proof_kernel_replay_add_upper_with_work(bounds, left_name, interval.upper, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if right_name != "":
                interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, node.left, bounds, work_used, 0)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return if interval.has_lower and not proof_kernel_replay_add_lower_with_work(bounds, right_name, interval.lower, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return if interval.has_upper and not proof_kernel_replay_add_upper_with_work(bounds, right_name, interval.upper, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)

        def proof_kernel_replay_close_defining_equalities_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                proof_kernel_replay_transport_defining_equality_with_work(nodes, children, facts, fact, bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                proof_kernel_replay_transport_defining_equality_with_work(nodes, children, facts, fact, bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            true

        def proof_kernel_replay_interval_goal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> bool:
            return false if operator != "==" and operator != "!=" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
            return false if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, left_root, right_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if not proof_kernel_replay_close_defining_equalities_with_work(nodes, children, facts, bounds, work_used)
            a: mutable (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, left_root, bounds, work_used, 0)
            b: mutable (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, right_root, bounds, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left_typed: ProofKernelReplayInt = proof_kernel_replay_typed_comparison_constant_with_work(nodes, children, facts, left_root, right_root, work_used)
            right_typed: ProofKernelReplayInt = proof_kernel_replay_typed_comparison_constant_with_work(nodes, children, facts, right_root, left_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            a <- (true, left_typed.value, left_typed.value, true, true) if left_typed.known
            b <- (true, right_typed.value, right_typed.value, true, true) if right_typed.known
            return a.has_lower and b.has_upper and a.lower > b.upper if operator == ">"
            return a.has_lower and b.has_upper and a.lower >= b.upper if operator == ">="
            return a.has_upper and b.has_lower and a.upper < b.lower if operator == "<"
            return a.has_upper and b.has_lower and a.upper <= b.lower if operator == "<="
            return a.known and b.known and a.lower == a.upper and b.lower == b.upper and a.lower == b.lower if operator == "=="
            return (a.has_upper and b.has_lower and a.upper < b.lower) or (a.has_lower and b.has_upper and a.lower > b.upper) if operator == "!="
            false
