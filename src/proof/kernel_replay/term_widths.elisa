extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_marker_info(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> (known: bool, name_root: usize, width: i64):
            return (false, 0, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth)
            return (false, 0, 0) if root >= nodes.count
            marker_call_valid: bool = nodes[root].kind == "call" and nodes[root].operator == "" and nodes[root].auxiliary == 0 and nodes[root].children_count == 2 and proof_kernel_replay_child_range_valid(nodes[root].children_start, nodes[root].children_count, children.count) and proof_kernel_replay_ident_matches(nodes, nodes[root].left, "__elisa_unsigned_type_bound")
            return (false, 0, 0) if not marker_call_valid
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[root].children_start)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[root].children_start + 1)
            # The child slice is validated against the actual children arena by callers before
            # this helper is used. The extra root checks here keep the helper fail-closed when it
            # is used from a standalone replay entry point.
            argument_indexes_valid: bool = first.known and second.known and first.value < nodes.count and second.value < nodes.count
            return (false, 0, 0) if not argument_indexes_valid
            first_index: usize = first.value
            second_index: usize = second.value
            return (false, 0, 0) if first_index >= nodes.count or second_index >= nodes.count
            argument_nodes_valid: bool = nodes[first_index].kind == "call_arg" and nodes[second_index].kind == "call_arg" and nodes[first_index].name == "" and nodes[first_index].secondary_name == "" and nodes[second_index].name == "" and nodes[second_index].secondary_name == ""
            return (false, 0, 0) if not argument_nodes_valid
            second_value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, nodes[second_index].left, depth + 1)
            return (false, 0, 0) if not second_value.known
            name_root: usize = nodes[first_index].left
            return (false, 0, 0) if name_root >= nodes.count
            return (false, 0, 0) if not proof_kernel_replay_valid(nodes, name_root)
            name_valid: bool = nodes[name_root].kind == "ident" and nodes[name_root].name != ""
            return (second_value.value >= ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN and second_value.value <= ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS and name_valid, name_root, second_value.value)

        def proof_kernel_replay_signed_marker_info(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> (known: bool, name_root: usize, width: i64):
            return (false, 0, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count
            marker_call_valid: bool = nodes[root].kind == "call" and nodes[root].operator == "" and nodes[root].auxiliary == 0 and nodes[root].children_count == 2 and proof_kernel_replay_child_range_valid(nodes[root].children_start, nodes[root].children_count, children.count) and proof_kernel_replay_ident_matches(nodes, nodes[root].left, "__elisa_signed_type_bound")
            return (false, 0, 0) if not marker_call_valid
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[root].children_start)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[root].children_start + 1)
            return (false, 0, 0) if not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
            return (false, 0, 0) if nodes[first.value].kind != "call_arg" or nodes[second.value].kind != "call_arg" or nodes[first.value].name != "" or nodes[first.value].secondary_name != "" or nodes[second.value].name != "" or nodes[second.value].secondary_name != ""
            width: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, nodes[second.value].left, depth + 1)
            name_root: usize = nodes[first.value].left
            return (false, 0, 0) if name_root >= nodes.count
            return (false, 0, 0) if not proof_kernel_replay_valid(nodes, name_root)
            name_valid: bool = nodes[name_root].kind == "ident" and nodes[name_root].name != ""
            valid_width: bool = ElisaProofKernelCore::proof_kernel_signed_width_valid(width.value)
            return (width.known and valid_width and name_valid, name_root, width.value)

        def proof_kernel_replay_signed_marker_width_for_term(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> i64:
            for fact in facts |fact, nodes, children, root|:
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info(nodes, children, fact, 0)
                continue if not marker.known
                term_root: mutable usize = 0
                first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[fact].children_start)
                if first.known and first.value < nodes.count and nodes[first.value].kind == "call_arg":
                    term_root <- nodes[first.value].left
                return marker.width if term_root < nodes.count and proof_kernel_replay_expr_equal(nodes, children, term_root, root, 0)
            for fact in facts |fact, nodes, children, root|:
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                place: (known: bool, term: usize, width: i64) = proof_kernel_replay_signed_place_marker_info(nodes, children, fact, 0)
                return place.width if place.known and proof_kernel_replay_expr_equal(nodes, children, place.term, root, 0)
            return 0

        def proof_kernel_replay_signed_place_marker_info(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> (known: bool, term: usize, width: i64):
            return (false, 0, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count
            return (false, 0, 0) if nodes[root].kind != "call" or nodes[root].operator != "" or nodes[root].auxiliary != 0 or nodes[root].children_count != 2
            return (false, 0, 0) if not proof_kernel_replay_child_range_valid(nodes[root].children_start, nodes[root].children_count, children.count)
            return (false, 0, 0) if proof_kernel_replay_ident_name(nodes, nodes[root].left) != "__elisa_signed_place_type_bound"
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[root].children_start)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[root].children_start + 1)
            return (false, 0, 0) if not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
            return (false, 0, 0) if nodes[first.value].kind != "call_arg" or nodes[second.value].kind != "call_arg" or nodes[first.value].name != "" or nodes[second.value].name != ""
            term: usize = nodes[first.value].left
            return (false, 0, 0) if term >= nodes.count or not proof_kernel_replay_valid(nodes, term)
            if nodes[term].kind == "tuple":
                # Match the tagged loop atom, never an arbitrary tuple or bare name.
                return (false, 0, 0) if nodes[term].children_count != 2
                return (false, 0, 0) if not proof_kernel_replay_child_range_valid(nodes[term].children_start, 2, children.count)
                tag_name: usize = children[nodes[term].children_start]
                tag_offset: usize = children[nodes[term].children_start + 1]
                return (false, 0, 0) if tag_name >= nodes.count or tag_offset >= nodes.count
                return (false, 0, 0) if nodes[tag_name].kind != "ident" or nodes[tag_name].name == "" or nodes[tag_offset].kind != "int"
            elif nodes[term].kind == "index":
                # The producer emits signed place widths for explicit scalar-reference reads
                # only at index zero. The expression-level width reader additionally requires
                # the matching scalar-element witness for this exact indexed container.
                return (false, 0, 0) if nodes[term].operator != "" or nodes[term].children_count != 0 or nodes[term].auxiliary != 0
                index: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, nodes[term].right, depth + 1)
                return (false, 0, 0) if not index.known or index.value != 0
            else:
                # Generalized places preserve the source-bound width under a fresh name.
                return (false, 0, 0) if nodes[term].kind != "field" and not (nodes[term].kind == "ident" and nodes[term].name != "") and not proof_kernel_replay_named_call_term(nodes, term)
            value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, nodes[second.value].left, depth + 1)
            valid_width: bool = ElisaProofKernelCore::proof_kernel_signed_width_valid(value.value)
            return (value.known and valid_width, term, value.value)

        def proof_kernel_replay_unsigned_marker_width_for_name(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], name: sview) -> i64:
            width: mutable i64 = 0
            for fact in facts |fact, nodes, name, width|:
                marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info(nodes, children, fact, 0)
                continue if not marker.known or not proof_kernel_replay_ident_matches(nodes, marker.name_root, name)
                width <- marker.width if width == 0 or marker.width < width
            return width

        def proof_kernel_replay_unsigned_indexed_element_path(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> (known: bool, container: usize, subscripts: i64):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (false, 0, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, 0) if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "index":
                path: (known: bool, container: usize, subscripts: i64) = proof_kernel_replay_unsigned_indexed_element_path(nodes, children, node.left, depth + 1)
                return (false, 0, 0) if not path.known or path.subscripts >= PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT
                return (true, path.container, path.subscripts + 1)
            if node.kind == "index-n":
                return (false, 0, 0) if node.children_count == 0 or node.children_count > PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT.usize() or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                path: (known: bool, container: usize, subscripts: i64) = proof_kernel_replay_unsigned_indexed_element_path(nodes, children, node.left, depth + 1)
                count: i64 = node.children_count.i64()
                return (false, 0, 0) if not path.known or path.subscripts > PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT - count
                return (true, path.container, path.subscripts + count)
            return (true, root, 0)

        def proof_kernel_replay_unsigned_element_width_for_expression(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> i64:
            path: (known: bool, container: usize, subscripts: i64) = proof_kernel_replay_unsigned_indexed_element_path(nodes, children, root, 0)
            return 0 if not path.known or path.subscripts == 0
            width: mutable i64 = 0
            for fact in facts |fact, nodes, children, path, width|:
                marker: (known: bool, root: usize, depth: i64, width: i64) = proof_kernel_replay_element_marker(nodes, children, fact)
                continue if not marker.known or marker.width == 0 or marker.depth != path.subscripts or not proof_kernel_replay_expr_equal(nodes, children, marker.root, path.container, 0)
                width <- marker.width if width == 0 or marker.width < width
            return width

        def proof_kernel_replay_unsigned_width_in_expression(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], depth: usize) -> i64:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return 0 if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth)
            return 0 if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "typed-int":
                literal = ElisaProofKernelCore::typed_literal_value(node)
                return literal.width if literal.known and literal.unsigned else 0
            if node.kind == "ident":
                return proof_kernel_replay_unsigned_marker_width_for_name(nodes, children, facts, node.name)
            if node.kind == "field":
                return proof_kernel_replay_place_marker_width(nodes, children, facts, root)
            if node.kind == "index" or node.kind == "index-n":
                return proof_kernel_replay_unsigned_element_width_for_expression(nodes, children, facts, root)
            if node.kind == "unary":
                return proof_kernel_replay_unsigned_width_in_expression(nodes, children, node.left, facts, depth + 1)
            if node.kind == "binary":
                left_width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, node.left, facts, depth + 1)
                right_width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, node.right, facts, depth + 1)
                return right_width if left_width == 0
                return left_width if right_width == 0 or left_width < right_width
                return right_width
            if node.kind == "if":
                then_width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, node.right, facts, depth + 1)
                else_width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, node.auxiliary, facts, depth + 1)
                return 0 if then_width == 0 or else_width == 0
                return then_width if then_width < else_width
                return else_width
            # In particular, a call's argument and callee types do not establish its return
            # width. The replay kernel refuses that inference just as the source producer does.
            return 0
