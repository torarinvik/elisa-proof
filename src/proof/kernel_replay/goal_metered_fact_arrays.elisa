extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_goal_search_extend_indices_with_work(source: darray[usize], destination: mutable darray[usize]&, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge_amount(work_used, source.count)
            destination.extend(source)
            true

        def proof_kernel_replay_goal_search_push_index_with_work(value: usize, destination: mutable darray[usize]&, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            destination.push(value)
            true
