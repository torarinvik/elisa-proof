# Validated segmented environments share declarations; local bindings are scoped per expression.
extend ElisaProofKernelReplay:
    private:
        # Type-index hashes only accelerate lookup; exact owner/signature checks decide identity.
        def proof_kernel_replay_type_hash_mix(hash: u32, value: i64) -> u32:
            low: i64 = value & 4294967295
            return (((hash.i64() ^ low) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS).u32()

        struct ProofKernelReplayFunctionGroupIndex:
            source_binding_count: usize
            function_count: usize
            capacity: usize
            hashes: darray[u32]
            slots: darray[usize]
            heads: darray[usize]
            tails: darray[usize]
            counts: darray[usize]
            next_rows: darray[usize]

        def proof_kernel_replay_empty_function_group_index() -> ProofKernelReplayFunctionGroupIndex:
            return ProofKernelReplayFunctionGroupIndex{source_binding_count: 0, function_count: 0, capacity: 0, hashes: [], slots: [], heads: [], tails: [], counts: [], next_rows: []}

        # Charge the longer string before equality so hostile names cannot bypass the work limit.
        def proof_kernel_replay_type_text_equal(left: sview, right: sview, work: mutable usize&) -> bool:
            ensure result == (work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET and left == right)
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            comparison_length: usize = left_length if left_length > right_length else right_length
            if work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET:
                work <- ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET + 1
                return false
            if comparison_length > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET - work:
                work <- ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET + 1
                return false
            work <- work + comparison_length
            return left == right

        # Private cache of the immutable, validated declaration environment.
        struct ProofKernelReplayTypingCache:
            ready: mutable bool
            bindings: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding]
            value_binding_indices: mutable darray[usize]
            function_parameter_indices: mutable darray[usize]
            function_parameter_bucket_heads: mutable darray[usize]
            function_parameter_next_indices: mutable darray[usize]
            combined_value_binding_indices: mutable darray[usize]
            combined_function_parameter_indices: mutable darray[usize]
            combined_function_parameter_bucket_heads: mutable darray[usize]
            combined_function_parameter_next_indices: mutable darray[usize]
            function_group_index: mutable ProofKernelReplayFunctionGroupIndex
            reuse_global_function_parameter_index: mutable bool

    public:
        # Public indexes are rebuilt scratch; cached globals are copied only from validated input.
        struct ProofKernelReplayTypingWorkspace:
            value_binding_indices: mutable darray[usize]
            function_parameter_indices: mutable darray[usize]
            function_parameter_bucket_heads: mutable darray[usize]
            function_parameter_next_indices: mutable darray[usize]
            call_owner_name_capacity: mutable usize
            call_owner_name_hashes: mutable darray[u32]
            call_owner_name_slots: mutable darray[usize]
            call_owner_name_ids: mutable darray[usize]
            call_owner_marker_counts: mutable darray[usize]
            call_owner_shadowed: mutable darray[bool]
            declaration_binding_capacity: mutable usize
            declaration_binding_heads: mutable darray[usize]
            declaration_binding_next: mutable darray[usize]
            type_identity_binding_capacity: mutable usize
            type_identity_binding_heads: mutable darray[usize]
            type_identity_binding_rows: mutable darray[usize]
            type_identity_binding_next: mutable darray[usize]
            enum_member_binding_capacity: mutable usize
            enum_member_binding_heads: mutable darray[usize]
            enum_member_binding_next: mutable darray[usize]
            global_function_group_index: mutable ProofKernelReplayFunctionGroupIndex
            local_function_group_index: mutable ProofKernelReplayFunctionGroupIndex
            owner_path_index: mutable ProofKernelReplayOwnerPathIndex
            private:
                cache: ProofKernelReplayTypingCache

        def proof_kernel_replay_typing_workspace_new() -> ProofKernelReplayTypingWorkspace:
            empty_group_index: ProofKernelReplayFunctionGroupIndex = proof_kernel_replay_empty_function_group_index()
            empty_owner_path_index: ProofKernelReplayOwnerPathIndex = proof_kernel_replay_empty_owner_path_index()
            return ProofKernelReplayTypingWorkspace{value_binding_indices: [], function_parameter_indices: [], function_parameter_bucket_heads: [], function_parameter_next_indices: [], call_owner_name_capacity: 0, call_owner_name_hashes: [], call_owner_name_slots: [], call_owner_name_ids: [], call_owner_marker_counts: [], call_owner_shadowed: [], declaration_binding_capacity: 0, declaration_binding_heads: [], declaration_binding_next: [], type_identity_binding_capacity: 0, type_identity_binding_heads: [], type_identity_binding_rows: [], type_identity_binding_next: [], enum_member_binding_capacity: 0, enum_member_binding_heads: [], enum_member_binding_next: [], global_function_group_index: empty_group_index, local_function_group_index: empty_group_index, owner_path_index: empty_owner_path_index, cache: ProofKernelReplayTypingCache{ready: false, bindings: [], value_binding_indices: [], function_parameter_indices: [], function_parameter_bucket_heads: [], function_parameter_next_indices: [], combined_value_binding_indices: [], combined_function_parameter_indices: [], combined_function_parameter_bucket_heads: [], combined_function_parameter_next_indices: [], function_group_index: empty_group_index, reuse_global_function_parameter_index: false}}

    private:
        const PROOF_KERNEL_MAX_TYPED_FUNCTION_PARAMETERS: usize = 1024

        # Compact positions of bindings used by hot typing lookups.
        struct ProofKernelReplayTypingIndex:
            value_binding_count: usize
            value_overlay_start: usize
            value_overlay_count: usize
            function_parameter_count: usize
            source_binding_count: usize
            value_binding_indices: darray[usize]
            function_parameter_indices: darray[usize]
            function_parameter_bucket_heads: darray[usize]
            function_parameter_next_indices: darray[usize]
            call_binding_count: usize
            scoped_local_binding_count: usize
            call_owner_name_capacity: usize
            call_owner_name_hashes: darray[u32]
            call_owner_name_slots: darray[usize]
            call_owner_name_ids: darray[usize]
            call_owner_marker_counts: darray[usize]
            call_owner_shadowed: darray[bool]
            declaration_binding_capacity: usize
            declaration_binding_heads: darray[usize]
            declaration_binding_next: darray[usize]
            type_identity_binding_capacity: usize
            type_identity_binding_heads: darray[usize]
            type_identity_binding_rows: darray[usize]
            type_identity_binding_next: darray[usize]
            enum_member_binding_capacity: usize
            enum_member_binding_heads: darray[usize]
            enum_member_binding_next: darray[usize]
            global_function_group_index: ProofKernelReplayFunctionGroupIndex
            local_function_group_index: ProofKernelReplayFunctionGroupIndex
            owner_path_index: ProofKernelReplayOwnerPathIndex

        def proof_kernel_replay_build_typing_index_internal(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&, reuse_global_function_group_index: bool, inherited_global_function_group_index: ProofKernelReplayFunctionGroupIndex) -> (known: bool, index: ProofKernelReplayTypingIndex):
            ensure result.known implies (
                work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                and result.index.source_binding_count == proof_kernel_replay_type_environment_binding_count(environment)
                and result.index.value_binding_count == result.index.value_binding_indices.count
                and result.index.function_parameter_count == result.index.function_parameter_indices.count
                and result.index.function_parameter_bucket_heads.count == result.index.function_parameter_count
                and result.index.function_parameter_next_indices.count == result.index.function_parameter_count
                and result.index.declaration_binding_capacity == result.index.declaration_binding_heads.count
                and result.index.declaration_binding_next.count <= result.index.source_binding_count
                and result.index.type_identity_binding_capacity == result.index.type_identity_binding_heads.count
                and result.index.type_identity_binding_rows.count == result.index.type_identity_binding_next.count
                and ((result.index.type_identity_binding_capacity == 0 and result.index.type_identity_binding_next.count == 0) or (result.index.type_identity_binding_capacity > 0 and result.index.type_identity_binding_next.count <= result.index.source_binding_count))
                and result.index.enum_member_binding_capacity == result.index.enum_member_binding_heads.count
                and ((result.index.enum_member_binding_capacity == 0 and result.index.enum_member_binding_next.count == 0) or (result.index.enum_member_binding_capacity > 0 and result.index.enum_member_binding_next.count == result.index.source_binding_count))
                and result.index.value_overlay_start == environment.bindings.count and result.index.value_overlay_count == 0
                and result.index.call_binding_count == environment.bindings.count
                and result.index.scoped_local_binding_count == environment.bindings.count
            )
            ensure result.known implies (forall value_offset in 0..<result.index.value_binding_indices.count:
                result.index.value_binding_indices[value_offset] < result.index.source_binding_count
                and proof_kernel_replay_type_environment_binding_at(environment, result.index.value_binding_indices[value_offset]).kind in {"value", "reference-value", "raw-reference-value", "proposition"}
            )
            ensure result.known implies (forall value_offset in 1..<result.index.value_binding_indices.count: result.index.value_binding_indices[value_offset - 1] < result.index.value_binding_indices[value_offset])
            ensure result.known implies (forall parameter_offset in 0..<result.index.function_parameter_indices.count:
                result.index.function_parameter_indices[parameter_offset] < result.index.source_binding_count
                and proof_kernel_replay_type_environment_binding_at(environment, result.index.function_parameter_indices[parameter_offset]).kind == "function-parameter"
            )
            ensure result.known implies (forall parameter_offset in 1..<result.index.function_parameter_indices.count: result.index.function_parameter_indices[parameter_offset - 1] < result.index.function_parameter_indices[parameter_offset])
            ensure result.known implies (forall slot in 0..<result.index.function_parameter_bucket_heads.count: result.index.function_parameter_bucket_heads[slot] <= result.index.function_parameter_count)
            ensure result.known implies (forall parameter_offset in 0..<result.index.function_parameter_next_indices.count:
                result.index.function_parameter_next_indices[parameter_offset] <= result.index.function_parameter_count
                and (result.index.function_parameter_next_indices[parameter_offset] == result.index.function_parameter_count or result.index.function_parameter_next_indices[parameter_offset] < parameter_offset)
            )
            ensure result.known implies (forall slot in 0..<result.index.declaration_binding_heads.count: result.index.declaration_binding_heads[slot] <= result.index.declaration_binding_next.count)
            ensure result.known implies (forall row in 0..<result.index.declaration_binding_next.count:
                result.index.declaration_binding_next[row] <= result.index.declaration_binding_next.count
                and (result.index.declaration_binding_next[row] == result.index.declaration_binding_next.count or result.index.declaration_binding_next[row] < row)
            )
            ensure result.known implies (forall slot in 0..<result.index.type_identity_binding_heads.count: result.index.type_identity_binding_heads[slot] <= result.index.type_identity_binding_next.count)
            ensure result.known implies (forall row in 0..<result.index.type_identity_binding_rows.count: result.index.type_identity_binding_rows[row] < result.index.source_binding_count and proof_kernel_replay_type_environment_binding_at(environment, result.index.type_identity_binding_rows[row]).kind == "type")
            ensure result.known implies (forall row in 0..<result.index.type_identity_binding_next.count:
                result.index.type_identity_binding_next[row] <= result.index.type_identity_binding_next.count
                and (result.index.type_identity_binding_next[row] == result.index.type_identity_binding_next.count or result.index.type_identity_binding_next[row] < row)
            )
            ensure result.known implies (forall slot in 0..<result.index.enum_member_binding_heads.count: result.index.enum_member_binding_heads[slot] <= result.index.enum_member_binding_next.count)
            ensure result.known implies (forall row in 0..<result.index.enum_member_binding_next.count: result.index.enum_member_binding_next[row] <= result.index.enum_member_binding_next.count and (result.index.enum_member_binding_next[row] == result.index.enum_member_binding_next.count or result.index.enum_member_binding_next[row] < row))
            ensure not result.known implies (
                result.index.source_binding_count == 0 and result.index.value_binding_count == 0 and result.index.value_binding_indices.count == 0
                and result.index.function_parameter_count == 0 and result.index.function_parameter_indices.count == 0
                and result.index.function_parameter_bucket_heads.count == 0 and result.index.function_parameter_next_indices.count == 0
                and result.index.declaration_binding_capacity == 0 and result.index.declaration_binding_heads.count == 0 and result.index.declaration_binding_next.count == 0
                and result.index.type_identity_binding_capacity == 0 and result.index.type_identity_binding_heads.count == 0 and result.index.type_identity_binding_rows.count == 0 and result.index.type_identity_binding_next.count == 0
                and result.index.enum_member_binding_capacity == 0 and result.index.enum_member_binding_heads.count == 0 and result.index.enum_member_binding_next.count == 0
            )
            empty: ProofKernelReplayTypingIndex = proof_kernel_replay_empty_typing_index()
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return (false, empty) if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            value_indices: mutable darray[usize] = []
            parameter_indices: mutable darray[usize] = []
            value_binding_count: mutable usize = 0
            parameter_binding_count: mutable usize = 0
            for binding_index in 0..<total_bindings |binding_index, environment, value_indices, parameter_indices, value_binding_count, parameter_binding_count, work|:
                invariant value_indices.count == value_binding_count and parameter_indices.count == parameter_binding_count
                invariant forall value_offset in 0..<value_indices.count: value_indices[value_offset] < binding_index and proof_kernel_replay_type_environment_binding_at(environment, value_indices[value_offset]).kind in {"value", "reference-value", "raw-reference-value", "proposition"}
                invariant forall value_offset in 1..<value_indices.count: value_indices[value_offset - 1] < value_indices[value_offset]
                invariant forall parameter_offset in 0..<parameter_indices.count: parameter_indices[parameter_offset] < binding_index and proof_kernel_replay_type_environment_binding_at(environment, parameter_indices[parameter_offset]).kind == "function-parameter"
                invariant forall parameter_offset in 1..<parameter_indices.count: parameter_indices[parameter_offset - 1] < parameter_indices[parameter_offset]
                return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                return (false, empty) if not proof_kernel_replay_typing_binding_valid(binding, work)
                is_value_binding: bool = match binding.kind:
                    "value": true
                    "reference-value": true
                    "raw-reference-value": true
                    "proposition": true
                    _: false
                if is_value_binding:
                    return (false, empty) if not proof_kernel_replay_type_work_consume_amount(2, work)
                    value_indices.push(binding_index)
                    value_binding_count <- value_binding_count + 1
                if binding.kind == "function-parameter":
                    return (false, empty) if not proof_kernel_replay_type_work_consume_amount(2, work)
                    parameter_indices.push(binding_index)
                    parameter_binding_count <- parameter_binding_count + 1
            return (false, empty) if:
                not proof_kernel_replay_enum_underlying_bindings_valid(environment, work)
                not proof_kernel_replay_type_scope_bindings_valid(environment, work)
                not proof_kernel_replay_bare_call_owners_valid(environment, work)
            owner_paths: (known: bool, index: ProofKernelReplayOwnerPathIndex) = proof_kernel_replay_owner_path_index_build(environment, work)
            return (false, empty) if not owner_paths.known
            global_group_index: mutable ProofKernelReplayFunctionGroupIndex = inherited_global_function_group_index
            if reuse_global_function_group_index:
                return (false, empty) if inherited_global_function_group_index.source_binding_count != environment.global_bindings.count
            else:
                global_groups: (known: bool, index: ProofKernelReplayFunctionGroupIndex) = proof_kernel_replay_function_group_index_build(environment.global_bindings, work)
                return (false, empty) if not global_groups.known
                global_group_index <- global_groups.index
            local_groups: (known: bool, index: ProofKernelReplayFunctionGroupIndex) = proof_kernel_replay_function_group_index_build(environment.bindings, work)
            return (false, empty) if not local_groups.known
            parameter_bucket_heads: mutable darray[usize] = []
            parameter_next_indices: mutable darray[usize] = []
            if parameter_binding_count > 0:
                return (false, empty) if parameter_binding_count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET / 2 or not proof_kernel_replay_type_work_consume_amount(parameter_binding_count * 2, work)
                parameter_bucket_heads.resize(parameter_binding_count)
                parameter_next_indices.resize(parameter_binding_count)
                for slot in 0..<parameter_binding_count |slot, parameter_binding_count, parameter_bucket_heads, work|:
                    invariant parameter_bucket_heads.count == parameter_binding_count
                    invariant forall prior_slot in 0..<slot: parameter_bucket_heads[prior_slot] == parameter_binding_count
                    return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                    parameter_bucket_heads[slot] <- parameter_binding_count
                for parameter_offset in 0..<parameter_binding_count |parameter_offset, environment, parameter_indices, parameter_binding_count, parameter_bucket_heads, parameter_next_indices, work|:
                    invariant parameter_bucket_heads.count == parameter_binding_count and parameter_next_indices.count == parameter_binding_count
                    invariant forall slot in 0..<parameter_binding_count: parameter_bucket_heads[slot] == parameter_binding_count or parameter_bucket_heads[slot] < parameter_offset
                    invariant forall prior_offset in 0..<parameter_offset: parameter_next_indices[prior_offset] == parameter_binding_count or parameter_next_indices[prior_offset] < prior_offset
                    return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                    binding_index: usize = parameter_indices[parameter_offset]
                    return (false, empty) if binding_index >= total_bindings
                    binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                    return (false, empty) if:
                        binding.kind != "function-parameter" or binding.signature_identity == 0
                        not proof_kernel_replay_type_work_consume_amount(sview_len(binding.owner), work)
                    owner_name_hash: u32 = proof_kernel_replay_name_owner_hash(binding.owner, binding.owner_type_identity)
                    parameter_hash: u32 = proof_kernel_replay_identity_hash_mix(owner_name_hash, binding.signature_identity)
                    slot: usize = (parameter_hash.i64() % parameter_binding_count.i64()).usize()
                    return (false, empty) if not proof_kernel_replay_type_work_consume_amount(2, work)
                    parameter_next_indices[parameter_offset] <- parameter_bucket_heads[slot]
                    parameter_bucket_heads[slot] <- parameter_offset
            call_capacity: mutable usize = 0
            call_hashes: mutable darray[u32] = []
            call_slots: mutable darray[usize] = []
            call_owner_ids: mutable darray[usize] = []
            call_marker_counts: mutable darray[usize] = []
            call_shadowed: mutable darray[bool] = []
            return (false, empty) if not proof_kernel_replay_build_call_owner_lookup_index(environment, work, &call_capacity, &call_hashes, &call_slots, &call_owner_ids, &call_marker_counts, &call_shadowed)
            declaration_capacity: mutable usize = 0
            declaration_heads: mutable darray[usize] = []
            declaration_next: mutable darray[usize] = []
            type_identity_capacity: mutable usize = 0
            type_identity_heads: mutable darray[usize] = []
            type_identity_rows: mutable darray[usize] = []
            type_identity_next: mutable darray[usize] = []
            enum_member_capacity: mutable usize = 0
            enum_member_heads: mutable darray[usize] = []
            enum_member_next: mutable darray[usize] = []
            return (false, empty) if not proof_kernel_replay_build_declaration_binding_index(environment, work, &declaration_capacity, &declaration_heads, &declaration_next, &type_identity_capacity, &type_identity_heads, &type_identity_rows, &type_identity_next, &enum_member_capacity, &enum_member_heads, &enum_member_next)
            return (true, ProofKernelReplayTypingIndex{value_binding_count: value_binding_count, value_overlay_start: environment.bindings.count, value_overlay_count: 0, function_parameter_count: parameter_binding_count, source_binding_count: total_bindings, value_binding_indices: value_indices, function_parameter_indices: parameter_indices, function_parameter_bucket_heads: parameter_bucket_heads, function_parameter_next_indices: parameter_next_indices, call_binding_count: environment.bindings.count, scoped_local_binding_count: environment.bindings.count, call_owner_name_capacity: call_capacity, call_owner_name_hashes: call_hashes, call_owner_name_slots: call_slots, call_owner_name_ids: call_owner_ids, call_owner_marker_counts: call_marker_counts, call_owner_shadowed: call_shadowed, declaration_binding_capacity: declaration_capacity, declaration_binding_heads: declaration_heads, declaration_binding_next: declaration_next, type_identity_binding_capacity: type_identity_capacity, type_identity_binding_heads: type_identity_heads, type_identity_binding_rows: type_identity_rows, type_identity_binding_next: type_identity_next, enum_member_binding_capacity: enum_member_capacity, enum_member_binding_heads: enum_member_heads, enum_member_binding_next: enum_member_next, global_function_group_index: global_group_index, local_function_group_index: local_groups.index, owner_path_index: owner_paths.index})

        # Fill caller-owned scratch; return the index only after complete validation.
        def proof_kernel_replay_collect_typing_indices(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&, scratch: mutable ProofKernelReplayTypingWorkspace&, build_declaration_index: bool) -> (known: bool, value_binding_count: usize, function_parameter_count: usize):
            scratch.value_binding_indices.clear()
            scratch.function_parameter_indices.clear()
            scratch.call_owner_name_capacity <- 0
            scratch.call_owner_name_hashes.clear()
            scratch.call_owner_name_slots.clear()
            scratch.call_owner_name_ids.clear()
            scratch.call_owner_marker_counts.clear()
            scratch.call_owner_shadowed.clear()
            scratch.declaration_binding_capacity <- 0
            scratch.declaration_binding_heads.clear()
            scratch.declaration_binding_next.clear()
            scratch.type_identity_binding_capacity <- 0
            scratch.type_identity_binding_heads.clear()
            scratch.type_identity_binding_rows.clear()
            scratch.type_identity_binding_next.clear()
            scratch.enum_member_binding_capacity <- 0
            scratch.enum_member_binding_heads.clear()
            scratch.enum_member_binding_next.clear()
            scratch.local_function_group_index <- proof_kernel_replay_empty_function_group_index()
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return (false, 0, 0) if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            value_binding_count: mutable usize = 0
            parameter_binding_count: mutable usize = 0
            for binding_index in 0..<total_bindings |binding_index, environment, scratch, value_binding_count, parameter_binding_count, work|:
                return (false, 0, 0) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                return (false, 0, 0) if not proof_kernel_replay_typing_binding_valid(binding, work)
                is_value_binding: bool = match binding.kind:
                    "value": true
                    "reference-value": true
                    "raw-reference-value": true
                    "proposition": true
                    _: false
                if is_value_binding:
                    return (false, 0, 0) if not proof_kernel_replay_type_work_consume_amount(2, work)
                    scratch.value_binding_indices.push(binding_index)
                    value_binding_count <- value_binding_count + 1
                if binding.kind == "function-parameter":
                    return (false, 0, 0) if not proof_kernel_replay_type_work_consume_amount(2, work)
                    scratch.function_parameter_indices.push(binding_index)
                    parameter_binding_count <- parameter_binding_count + 1
            return (false, 0, 0) if not proof_kernel_replay_build_call_owner_lookup_index(environment, work, &scratch.call_owner_name_capacity, &scratch.call_owner_name_hashes, &scratch.call_owner_name_slots, &scratch.call_owner_name_ids, &scratch.call_owner_marker_counts, &scratch.call_owner_shadowed)
            return (false, 0, 0) if build_declaration_index and not proof_kernel_replay_build_declaration_binding_index(environment, work, &scratch.declaration_binding_capacity, &scratch.declaration_binding_heads, &scratch.declaration_binding_next, &scratch.type_identity_binding_capacity, &scratch.type_identity_binding_heads, &scratch.type_identity_binding_rows, &scratch.type_identity_binding_next, &scratch.enum_member_binding_capacity, &scratch.enum_member_binding_heads, &scratch.enum_member_binding_next)
            local_groups: (known: bool, index: ProofKernelReplayFunctionGroupIndex) = proof_kernel_replay_function_group_index_build(environment.bindings, work)
            return (false, 0, 0) if not local_groups.known
            scratch.local_function_group_index <- local_groups.index
            return (true, value_binding_count, parameter_binding_count)

        def proof_kernel_replay_build_typing_workspace_internal(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&, scratch: mutable ProofKernelReplayTypingWorkspace&, validate_bare_call_owners: bool) -> bool:
            scratch.global_function_group_index <- proof_kernel_replay_empty_function_group_index()
            scratch.owner_path_index <- proof_kernel_replay_empty_owner_path_index()
            scratch.function_parameter_bucket_heads.clear()
            scratch.function_parameter_next_indices.clear()
            collected: (known: bool, value_binding_count: usize, function_parameter_count: usize) = proof_kernel_replay_collect_typing_indices(environment, work, scratch, true)
            return false if not collected.known
            global_groups: (known: bool, index: ProofKernelReplayFunctionGroupIndex) = proof_kernel_replay_function_group_index_build(environment.global_bindings, work)
            return false if not global_groups.known
            scratch.global_function_group_index <- global_groups.index
            return false if:
                not proof_kernel_replay_enum_underlying_bindings_valid(environment, work)
                not proof_kernel_replay_type_scope_bindings_valid(environment, work)
            return false if validate_bare_call_owners and not proof_kernel_replay_bare_call_owners_valid(environment, work)
            owner_paths: (known: bool, index: ProofKernelReplayOwnerPathIndex) = proof_kernel_replay_owner_path_index_build(environment, work)
            return false if not owner_paths.known
            scratch.owner_path_index <- owner_paths.index
            parameter_binding_count: usize = collected.function_parameter_count
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            if parameter_binding_count > 0:
                return false if parameter_binding_count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET / 2 or not proof_kernel_replay_type_work_consume_amount(parameter_binding_count * 2, work)
                scratch.function_parameter_bucket_heads.resize(parameter_binding_count)
                scratch.function_parameter_next_indices.resize(parameter_binding_count)
                for slot in 0..<parameter_binding_count |slot, parameter_binding_count, scratch, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    scratch.function_parameter_bucket_heads[slot] <- parameter_binding_count
                for parameter_offset in 0..<parameter_binding_count |parameter_offset, environment, scratch, parameter_binding_count, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    binding_index: usize = scratch.function_parameter_indices[parameter_offset]
                    return false if binding_index >= total_bindings
                    binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                    return false if:
                        binding.kind != "function-parameter" or binding.signature_identity == 0
                        not proof_kernel_replay_type_work_consume_amount(sview_len(binding.owner), work)
                    owner_name_hash: u32 = proof_kernel_replay_name_owner_hash(binding.owner, binding.owner_type_identity)
                    parameter_hash: u32 = proof_kernel_replay_identity_hash_mix(owner_name_hash, binding.signature_identity)
                    slot: usize = (parameter_hash.i64() % parameter_binding_count.i64()).usize()
                    return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                    scratch.function_parameter_next_indices[parameter_offset] <- scratch.function_parameter_bucket_heads[slot]
                    scratch.function_parameter_bucket_heads[slot] <- parameter_offset
            return true

        def proof_kernel_replay_build_typing_workspace(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&, scratch: mutable ProofKernelReplayTypingWorkspace&) -> bool:
            return proof_kernel_replay_build_typing_workspace_internal(environment, work, scratch, true)

        # Cache a private copy of the immutable declaration environment before validation.
        def proof_kernel_replay_typing_workspace_prepare_globals_internal(global_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], scratch: mutable ProofKernelReplayTypingWorkspace&, work: mutable usize&) -> bool:
            scratch.cache.ready <- false
            scratch.cache.bindings.clear()
            scratch.cache.value_binding_indices.clear()
            scratch.cache.function_parameter_indices.clear()
            scratch.cache.function_parameter_bucket_heads.clear()
            scratch.cache.function_parameter_next_indices.clear()
            scratch.cache.reuse_global_function_parameter_index <- false
            return false if global_bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            for binding in global_bindings |scratch, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                # Global snapshots lack a local selector; reject markers deferred to row validation.
                return false if binding.kind in {"bare-call-owner", "local-call-shadow"}
                return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                scratch.cache.bindings.push(binding)
            environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: scratch.cache.bindings, bindings: []}
            # Validate cross-row markers only after source-local rows have been combined.
            return false if not proof_kernel_replay_build_typing_workspace_internal(environment, work, scratch, false)
            for binding_index in scratch.value_binding_indices |binding_index, scratch, work|:
                return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                scratch.cache.value_binding_indices.push(binding_index)
            for binding_index in scratch.function_parameter_indices |binding_index, scratch, work|:
                return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                scratch.cache.function_parameter_indices.push(binding_index)
            for slot in scratch.function_parameter_bucket_heads |slot, scratch, work|:
                return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                scratch.cache.function_parameter_bucket_heads.push(slot)
            for parameter_offset in scratch.function_parameter_next_indices |parameter_offset, scratch, work|:
                return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                scratch.cache.function_parameter_next_indices.push(parameter_offset)
            scratch.cache.function_group_index <- scratch.global_function_group_index
            scratch.cache.ready <- true
            return true

        # Revalidate locals against the private immutable global prefix; the combined index stays scratch.
        def proof_kernel_replay_build_typing_workspace_with_globals(local_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], work: mutable usize&, scratch: mutable ProofKernelReplayTypingWorkspace&) -> bool:
            return false if not scratch.cache.ready
            local_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: [], bindings: local_bindings}
            # Skip the soon-replaced local declaration index but retain the local-scope owner index.
            collected: (known: bool, value_binding_count: usize, function_parameter_count: usize) = proof_kernel_replay_collect_typing_indices(local_environment, work, scratch, false)
            return false if not collected.known
            scratch.global_function_group_index <- scratch.cache.function_group_index
            return false if:
                scratch.cache.bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
                local_bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET - scratch.cache.bindings.count
            combined_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: scratch.cache.bindings, bindings: local_bindings}
            return false if not proof_kernel_replay_build_declaration_binding_index(combined_environment, work, &scratch.declaration_binding_capacity, &scratch.declaration_binding_heads, &scratch.declaration_binding_next, &scratch.type_identity_binding_capacity, &scratch.type_identity_binding_heads, &scratch.type_identity_binding_rows, &scratch.type_identity_binding_next, &scratch.enum_member_binding_capacity, &scratch.enum_member_binding_heads, &scratch.enum_member_binding_next)
            return false if:
                not proof_kernel_replay_enum_underlying_bindings_valid(combined_environment, work)
                not proof_kernel_replay_type_scope_bindings_valid(combined_environment, work)
                not proof_kernel_replay_bare_call_owners_valid(combined_environment, work)
            combined_owner_paths: (known: bool, index: ProofKernelReplayOwnerPathIndex) = proof_kernel_replay_owner_path_index_build(combined_environment, work)
            return false if not combined_owner_paths.known
            scratch.owner_path_index <- combined_owner_paths.index
            scratch.cache.reuse_global_function_parameter_index <- collected.function_parameter_count == 0
            scratch.cache.combined_value_binding_indices.clear()
            for binding_index in scratch.cache.value_binding_indices |binding_index, scratch, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                scratch.cache.combined_value_binding_indices.push(binding_index)
            for binding_index in scratch.value_binding_indices |binding_index, scratch, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                scratch.cache.combined_value_binding_indices.push(scratch.cache.bindings.count + binding_index)
            if not scratch.cache.reuse_global_function_parameter_index:
                scratch.cache.combined_function_parameter_indices.clear()
                scratch.cache.combined_function_parameter_bucket_heads.clear()
                scratch.cache.combined_function_parameter_next_indices.clear()
                for binding_index in scratch.cache.function_parameter_indices |binding_index, scratch, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                    scratch.cache.combined_function_parameter_indices.push(binding_index)
                for binding_index in scratch.function_parameter_indices |binding_index, scratch, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                    scratch.cache.combined_function_parameter_indices.push(scratch.cache.bindings.count + binding_index)
                parameter_count: usize = scratch.cache.combined_function_parameter_indices.count
                if parameter_count > 0:
                    return false if parameter_count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET / 2 or not proof_kernel_replay_type_work_consume_amount(parameter_count * 2, work)
                    scratch.cache.combined_function_parameter_bucket_heads.resize(parameter_count)
                    scratch.cache.combined_function_parameter_next_indices.resize(parameter_count)
                    for slot in 0..<parameter_count |slot, parameter_count, scratch, work|:
                        return false if not proof_kernel_replay_type_work_consume(work)
                        scratch.cache.combined_function_parameter_bucket_heads[slot] <- parameter_count
                    combined_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: scratch.cache.bindings, bindings: local_bindings}
                    for parameter_offset in 0..<parameter_count |parameter_offset, parameter_count, scratch, combined_environment, work|:
                        return false if not proof_kernel_replay_type_work_consume(work)
                        binding_index: usize = scratch.cache.combined_function_parameter_indices[parameter_offset]
                        return false if binding_index >= total_bindings
                        binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(combined_environment, binding_index)
                        return false if:
                            binding.kind != "function-parameter" or binding.signature_identity == 0
                            not proof_kernel_replay_type_work_consume_amount(sview_len(binding.owner), work)
                        owner_name_hash: u32 = proof_kernel_replay_name_owner_hash(binding.owner, binding.owner_type_identity)
                        parameter_hash: u32 = proof_kernel_replay_identity_hash_mix(owner_name_hash, binding.signature_identity)
                        slot: usize = (parameter_hash.i64() % parameter_count.i64()).usize()
                        return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                        scratch.cache.combined_function_parameter_next_indices[parameter_offset] <- scratch.cache.combined_function_parameter_bucket_heads[slot]
                        scratch.cache.combined_function_parameter_bucket_heads[slot] <- parameter_offset
            return true
