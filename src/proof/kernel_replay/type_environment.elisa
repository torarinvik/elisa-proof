# Validation and indexed access for the segmented typing environment. Global declaration
# signatures are shared across obligations; local context bindings are scoped per expression.
extend ElisaProofKernelReplay:
    private:
        # Opaque validated cache: callers may hold a workspace but cannot forge or mutate this
        # source-wide typing authority through its public API.
        struct ProofKernelReplayTypingCache:
            ready: mutable bool
            bindings: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding]
            value_binding_indices: mutable darray[usize]
            function_parameter_indices: mutable darray[usize]
            function_parameter_bucket_heads: mutable darray[usize]
            function_parameter_next_indices: mutable darray[usize]
            combined_value_binding_indices: mutable darray[usize]
            combined_function_parameter_indices: mutable darray[usize]
            combined_function_parameter_bucket_heads: mutable darray[usize]
            combined_function_parameter_next_indices: mutable darray[usize]
            reuse_global_function_parameter_index: mutable bool

    public:
        # Reusable allocation scratch only; every index row is rebuilt from validated input.
        struct ProofKernelReplayTypingWorkspace:
            value_binding_indices: mutable darray[usize]
            function_parameter_indices: mutable darray[usize]
            function_parameter_bucket_heads: mutable darray[usize]
            function_parameter_next_indices: mutable darray[usize]
            public:
                cache: ProofKernelReplayTypingCache

        def proof_kernel_replay_typing_workspace_new() -> ProofKernelReplayTypingWorkspace:
            return ProofKernelReplayTypingWorkspace{value_binding_indices: [], function_parameter_indices: [], function_parameter_bucket_heads: [], function_parameter_next_indices: [], cache: ProofKernelReplayTypingCache{ready: false, bindings: [], value_binding_indices: [], function_parameter_indices: [], function_parameter_bucket_heads: [], function_parameter_next_indices: [], combined_value_binding_indices: [], combined_function_parameter_indices: [], combined_function_parameter_bucket_heads: [], combined_function_parameter_next_indices: [], reuse_global_function_parameter_index: false}}

    private:
        const PROOF_KERNEL_MAX_TYPED_FUNCTION_PARAMETERS: usize = 1024

        # Compact positions of bindings used by hot typing lookups. Unrelated type, field, and
        # declaration rows need not be revisited; lookup routines still compare exact evidence.
        struct ProofKernelReplayTypingIndex:
            value_binding_count: usize
            function_parameter_count: usize
            source_binding_count: usize
            value_binding_indices: darray[usize]
            function_parameter_indices: darray[usize]
            function_parameter_bucket_heads: darray[usize]
            function_parameter_next_indices: darray[usize]

        def proof_kernel_replay_empty_typing_index() -> ProofKernelReplayTypingIndex:
            return ProofKernelReplayTypingIndex{value_binding_count: 0, function_parameter_count: 0, source_binding_count: 0, value_binding_indices: [], function_parameter_indices: [], function_parameter_bucket_heads: [], function_parameter_next_indices: []}

        def proof_kernel_replay_build_typing_index(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&) -> (known: bool, index: ProofKernelReplayTypingIndex):
            empty: ProofKernelReplayTypingIndex = proof_kernel_replay_empty_typing_index()
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return (false, empty) if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            value_indices: mutable darray[usize] = []
            parameter_indices: mutable darray[usize] = []
            value_binding_count: mutable usize = 0
            parameter_binding_count: mutable usize = 0
            for binding_index in 0..<total_bindings |binding_index, environment, value_indices, parameter_indices, value_binding_count, parameter_binding_count, work|:
                return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                return (false, empty) if not proof_kernel_replay_typing_binding_valid(binding)
                is_value_binding: bool = match binding.kind:
                    "value": true
                    "reference-value": true
                    "proposition": true
                    _: false
                if is_value_binding:
                    value_indices.push(binding_index)
                    value_binding_count <- value_binding_count + 1
                if binding.kind == "function-parameter":
                    parameter_indices.push(binding_index)
                    parameter_binding_count <- parameter_binding_count + 1
            return (false, empty) if not proof_kernel_replay_enum_underlying_bindings_valid(environment, work)
            parameter_bucket_heads: mutable darray[usize] = []
            parameter_next_indices: mutable darray[usize] = []
            if parameter_binding_count > 0:
                parameter_bucket_heads.resize(parameter_binding_count)
                parameter_next_indices.resize(parameter_binding_count)
                for slot in 0..<parameter_binding_count |slot, parameter_binding_count, parameter_bucket_heads, work|:
                    return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                    parameter_bucket_heads[slot] <- parameter_binding_count
                for parameter_offset in 0..<parameter_binding_count |parameter_offset, environment, parameter_indices, parameter_binding_count, parameter_bucket_heads, parameter_next_indices, work|:
                    return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                    binding_index: usize = parameter_indices[parameter_offset]
                    return (false, empty) if binding_index >= total_bindings
                    binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                    return (false, empty) if binding.kind != "function-parameter" or binding.signature_identity == 0
                    slot: usize = (binding.signature_identity % parameter_binding_count).usize()
                    parameter_next_indices[parameter_offset] <- parameter_bucket_heads[slot]
                    parameter_bucket_heads[slot] <- parameter_offset
            return (true, ProofKernelReplayTypingIndex{value_binding_count: value_binding_count, function_parameter_count: parameter_binding_count, source_binding_count: total_bindings, value_binding_indices: value_indices, function_parameter_indices: parameter_indices, function_parameter_bucket_heads: parameter_bucket_heads, function_parameter_next_indices: parameter_next_indices})

        # Fills caller-owned scratch, but returns no view of it. Callers form the temporary index
        # locally only after this complete validation-and-build pass succeeds.
        def proof_kernel_replay_collect_typing_indices(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&, scratch: mutable ProofKernelReplayTypingWorkspace&) -> (known: bool, value_binding_count: usize, function_parameter_count: usize):
            scratch.value_binding_indices.clear()
            scratch.function_parameter_indices.clear()
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return (false, 0, 0) if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            value_binding_count: mutable usize = 0
            parameter_binding_count: mutable usize = 0
            for binding_index in 0..<total_bindings |binding_index, environment, scratch, value_binding_count, parameter_binding_count, work|:
                return (false, 0, 0) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                return (false, 0, 0) if not proof_kernel_replay_typing_binding_valid(binding)
                is_value_binding: bool = match binding.kind:
                    "value": true
                    "reference-value": true
                    "proposition": true
                    _: false
                if is_value_binding:
                    scratch.value_binding_indices.push(binding_index)
                    value_binding_count <- value_binding_count + 1
                if binding.kind == "function-parameter":
                    scratch.function_parameter_indices.push(binding_index)
                    parameter_binding_count <- parameter_binding_count + 1
            return (false, 0, 0) if not proof_kernel_replay_enum_underlying_bindings_valid(environment, work)
            return (true, value_binding_count, parameter_binding_count)

        def proof_kernel_replay_build_typing_workspace(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&, scratch: mutable ProofKernelReplayTypingWorkspace&) -> bool:
            scratch.function_parameter_bucket_heads.clear()
            scratch.function_parameter_next_indices.clear()
            collected: (known: bool, value_binding_count: usize, function_parameter_count: usize) = proof_kernel_replay_collect_typing_indices(environment, work, scratch)
            return false if not collected.known
            parameter_binding_count: usize = collected.function_parameter_count
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            if parameter_binding_count > 0:
                scratch.function_parameter_bucket_heads.resize(parameter_binding_count)
                scratch.function_parameter_next_indices.resize(parameter_binding_count)
                for slot in 0..<parameter_binding_count |slot, parameter_binding_count, scratch, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    scratch.function_parameter_bucket_heads[slot] <- parameter_binding_count
                for parameter_offset in 0..<parameter_binding_count |parameter_offset, environment, scratch, parameter_binding_count, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    binding_index: usize = scratch.function_parameter_indices[parameter_offset]
                    return false if binding_index >= total_bindings
                    binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                    return false if binding.kind != "function-parameter" or binding.signature_identity == 0
                    slot: usize = (binding.signature_identity % parameter_binding_count).usize()
                    scratch.function_parameter_next_indices[parameter_offset] <- scratch.function_parameter_bucket_heads[slot]
                    scratch.function_parameter_bucket_heads[slot] <- parameter_offset
            return true

        # Cache only the immutable, source-wide declaration environment. The API takes a private
        # copy before validation so later mutation through the caller's darray cannot invalidate
        # the index. Generic replay APIs continue to validate their complete environment per call.
        def proof_kernel_replay_typing_workspace_prepare_globals_internal(global_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], scratch: mutable ProofKernelReplayTypingWorkspace&) -> bool:
            scratch.cache.ready <- false
            scratch.cache.bindings.clear()
            scratch.cache.value_binding_indices.clear()
            scratch.cache.function_parameter_indices.clear()
            scratch.cache.function_parameter_bucket_heads.clear()
            scratch.cache.function_parameter_next_indices.clear()
            scratch.cache.reuse_global_function_parameter_index <- false
            return false if global_bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            for binding in global_bindings |scratch|:
                scratch.cache.bindings.push(binding)
            environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: scratch.cache.bindings, bindings: []}
            work: mutable usize = 0
            return false if not proof_kernel_replay_build_typing_workspace(environment, &work, scratch)
            for binding_index in scratch.value_binding_indices |binding_index, scratch|:
                scratch.cache.value_binding_indices.push(binding_index)
            for binding_index in scratch.function_parameter_indices |binding_index, scratch|:
                scratch.cache.function_parameter_indices.push(binding_index)
            for slot in scratch.function_parameter_bucket_heads |slot, scratch|:
                scratch.cache.function_parameter_bucket_heads.push(slot)
            for parameter_offset in scratch.function_parameter_next_indices |parameter_offset, scratch|:
                scratch.cache.function_parameter_next_indices.push(parameter_offset)
            scratch.cache.ready <- true
            return true

        # Revalidates every local binding but reuses the independently validated immutable global
        # prefix. The resulting combined index is scratch-only and never escapes replay.
        def proof_kernel_replay_build_typing_workspace_with_globals(local_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], work: mutable usize&, scratch: mutable ProofKernelReplayTypingWorkspace&) -> bool:
            return false if not scratch.cache.ready
            local_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: [], bindings: local_bindings}
            collected: (known: bool, value_binding_count: usize, function_parameter_count: usize) = proof_kernel_replay_collect_typing_indices(local_environment, work, scratch)
            return false if not collected.known
            total_bindings: usize = scratch.cache.bindings.count + local_bindings.count
            return false if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            scratch.cache.reuse_global_function_parameter_index <- collected.function_parameter_count == 0
            scratch.cache.combined_value_binding_indices.clear()
            for binding_index in scratch.cache.value_binding_indices |binding_index, scratch, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                scratch.cache.combined_value_binding_indices.push(binding_index)
            for binding_index in scratch.value_binding_indices |binding_index, scratch, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                scratch.cache.combined_value_binding_indices.push(scratch.cache.bindings.count + binding_index)
            if not scratch.cache.reuse_global_function_parameter_index:
                scratch.cache.combined_function_parameter_indices.clear()
                scratch.cache.combined_function_parameter_bucket_heads.clear()
                scratch.cache.combined_function_parameter_next_indices.clear()
                for binding_index in scratch.cache.function_parameter_indices |binding_index, scratch, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    scratch.cache.combined_function_parameter_indices.push(binding_index)
                for binding_index in scratch.function_parameter_indices |binding_index, scratch, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    scratch.cache.combined_function_parameter_indices.push(scratch.cache.bindings.count + binding_index)
                parameter_count: usize = scratch.cache.combined_function_parameter_indices.count
                if parameter_count > 0:
                    scratch.cache.combined_function_parameter_bucket_heads.resize(parameter_count)
                    scratch.cache.combined_function_parameter_next_indices.resize(parameter_count)
                    for slot in 0..<parameter_count |slot, parameter_count, scratch, work|:
                        return false if not proof_kernel_replay_type_work_consume(work)
                        scratch.cache.combined_function_parameter_bucket_heads[slot] <- parameter_count
                    combined_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: scratch.cache.bindings, bindings: local_bindings}
                    for parameter_offset in 0..<parameter_count |parameter_offset, parameter_count, scratch, combined_environment, work|:
                        return false if not proof_kernel_replay_type_work_consume(work)
                        binding_index: usize = scratch.cache.combined_function_parameter_indices[parameter_offset]
                        return false if binding_index >= total_bindings
                        binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(combined_environment, binding_index)
                        return false if binding.kind != "function-parameter" or binding.signature_identity == 0
                        slot: usize = (binding.signature_identity % parameter_count).usize()
                        scratch.cache.combined_function_parameter_next_indices[parameter_offset] <- scratch.cache.combined_function_parameter_bucket_heads[slot]
                        scratch.cache.combined_function_parameter_bucket_heads[slot] <- parameter_offset
            return true

        def proof_kernel_replay_typing_binding_valid(binding: ElisaProofKernelCore::ProofKernelTypingBinding) -> bool:
            if binding.kind == "module-context":
                return binding.name == "" and binding.owner == "" and binding.sort == "" and binding.type_name == "" and binding.element_sort == "" and binding.element_type_name == "" and binding.type_identity == 0 and binding.owner_type_identity != 0 and binding.element_type_identity == 0 and binding.signature_identity == 0 and binding.parameter_index == 0 and binding.parameter_count == 0 and not binding.parameter_has_default and not binding.parameter_by_reference
            if binding.kind == "module-owner-segment":
                return binding.name != "" and binding.owner == "" and binding.sort == "" and binding.type_name == "" and binding.element_sort == "" and binding.element_type_name == "" and binding.type_identity == 0 and binding.owner_type_identity != 0 and binding.element_type_identity == 0 and binding.signature_identity == 0 and binding.parameter_count > 0 and binding.parameter_index < binding.parameter_count and not binding.parameter_has_default and not binding.parameter_by_reference
            return false if binding.name == "" or binding.type_name == ""
            return false if binding.sort != "boolean" and binding.sort != "integer" and binding.sort != "floating" and binding.sort != "character" and binding.sort != "string" and binding.sort != "aggregate" and binding.sort != "named" and binding.sort != "nullable-reference" and binding.sort != "nullable-opaque-reference" and binding.sort != "container" and binding.sort != "void" and binding.sort != "proposition"
            if binding.kind == "value":
                # A non-empty owner names the module that owns a constant (G68); lookup admits it
                # only through a matching qualifier.
                return false if (binding.owner == "") != (binding.owner_type_identity == 0) or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "reference-value":
                return false if binding.owner != "" or not binding.parameter_by_reference
                return false if binding.owner_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default
            elif binding.kind == "function":
                return false if binding.owner != "" or binding.parameter_index != 0 or binding.parameter_has_default or binding.parameter_by_reference
                return false if binding.parameter_count > PROOF_KERNEL_MAX_TYPED_FUNCTION_PARAMETERS
                return false if binding.signature_identity == 0 and binding.parameter_count != 0
            elif binding.kind == "proposition":
                return false if binding.owner != "" or binding.sort != "proposition" or binding.owner_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "type":
                return false if binding.owner != "" or binding.type_name != binding.name
                return false if binding.sort != "named" and binding.sort != "container"
                return false if binding.type_identity == 0
                return false if binding.owner_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
                return false if binding.sort == "named" and (binding.element_sort != "" or binding.element_type_name != "" or binding.element_type_identity != 0)
            elif binding.kind == "field":
                return false if binding.owner == ""
                return false if binding.owner_type_identity == 0
                return false if binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "function-parameter":
                return false if binding.owner == "" or binding.signature_identity == 0 or binding.parameter_count != 0 or binding.owner_type_identity != 0
            elif binding.kind == "enum-member":
                return false if binding.owner == "" or binding.sort != "named" or binding.type_name != binding.owner
                return false if binding.element_sort != "" or binding.element_type_name != "" or binding.type_identity == 0 or binding.owner_type_identity != binding.type_identity or binding.element_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "enum-scope-segment":
                return false if binding.owner == "" or binding.sort != "named" or binding.type_name != binding.owner
                return false if binding.element_sort != "" or binding.element_type_name != "" or binding.type_identity == 0 or binding.owner_type_identity != binding.type_identity or binding.element_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_count == 0 or binding.parameter_index >= binding.parameter_count or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "enum-tag":
                return false if binding.owner == "" or binding.sort != "named" or binding.type_name != binding.owner
                return false if binding.element_sort != "" or binding.element_type_name != "" or binding.type_identity == 0 or binding.owner_type_identity != binding.type_identity or binding.element_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "enum-underlying":
                return false if binding.owner == "" or binding.name != binding.owner or binding.sort != "integer"
                return false if binding.type_name != "i8" and binding.type_name != "i16" and binding.type_name != "i32" and binding.type_name != "i64" and binding.type_name != "u8" and binding.type_name != "u16" and binding.type_name != "u32" and binding.type_name != "u64"
                return false if binding.element_sort != "" or binding.element_type_name != "" or binding.type_identity != 0 or binding.owner_type_identity == 0 or binding.element_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            else:
                return false
            tuple_type: bool = binding.sort == "aggregate" and binding.type_name == "tuple"
            return false if tuple_type and binding.type_identity == 0
            named_type_binding: bool = binding.sort == "named"
            return false if named_type_binding and binding.type_identity == 0
            nullable_reference_binding: bool = binding.sort == "nullable-reference"
            return false if nullable_reference_binding and binding.type_identity == 0
            nullable_opaque_reference_binding: bool = binding.sort == "nullable-opaque-reference"
            return false if nullable_opaque_reference_binding and (binding.type_name != "void" or binding.type_identity != 0)
            return false if not tuple_type and not named_type_binding and not nullable_reference_binding and not nullable_opaque_reference_binding and binding.sort != "container" and binding.type_identity != 0
            if binding.sort == "container":
                return false if binding.element_type_name == ""
                return false if binding.element_sort != "boolean" and binding.element_sort != "integer" and binding.element_sort != "floating" and binding.element_sort != "character" and binding.element_sort != "string" and binding.element_sort != "aggregate" and binding.element_sort != "named" and binding.element_sort != "container"
                element_has_identity: bool = binding.element_sort == "named" or (binding.element_sort == "aggregate" and binding.element_type_name == "tuple") or binding.element_sort == "container"
                return false if element_has_identity != (binding.element_type_identity != 0)
                return true
            return binding.element_sort == "" and binding.element_type_name == "" and binding.element_type_identity == 0 and (tuple_type or named_type_binding or nullable_reference_binding or nullable_opaque_reference_binding or binding.type_identity == 0)

        # An underlying-type row is meaningful only beside one exact declared const enum. Validate
        # the whole relation under the existing work budget. Count every same-identity type row
        # and backing row, regardless of owner spelling, so a forged alias or conflicting owner
        # cannot hide beside the selected name. Duplicate backing rows refuse even when no cast
        # queries the enum.
        def proof_kernel_replay_enum_underlying_bindings_valid(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&) -> bool:
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                expected: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if expected.kind != "enum-underlying"
                type_identity_rows: mutable usize = 0
                matching_type_rows: mutable usize = 0
                tag_rows: mutable usize = 0
                member_rows: mutable usize = 0
                underlying_rows: mutable usize = 0
                scope_rows: mutable usize = 0
                scope_expected_count: mutable usize = 0
                scope_final_rows: mutable usize = 0
                conflicting_owner: mutable bool = false
                for candidate_index in 0..<total_bindings |candidate_index, environment, expected, type_identity_rows, matching_type_rows, tag_rows, member_rows, underlying_rows, scope_rows, scope_expected_count, scope_final_rows, conflicting_owner, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    candidate: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, candidate_index)
                    if candidate.kind == "type" and candidate.type_identity == expected.owner_type_identity:
                        type_identity_rows <- type_identity_rows + 1
                        matching_type_rows <- matching_type_rows + 1 if candidate.name == expected.owner and candidate.type_name == expected.owner and candidate.sort == "named"
                    if candidate.kind == "enum-tag" and candidate.type_identity == expected.owner_type_identity:
                        tag_rows <- tag_rows + 1
                        conflicting_owner <- true if candidate.owner != expected.owner
                    if candidate.kind == "enum-member" and candidate.type_identity == expected.owner_type_identity:
                        member_rows <- member_rows + 1
                        conflicting_owner <- true if candidate.owner != expected.owner
                    if candidate.kind == "enum-scope-segment" and candidate.type_identity == expected.owner_type_identity:
                        scope_rows <- scope_rows + 1
                        conflicting_owner <- true if candidate.owner != expected.owner
                        scope_expected_count <- candidate.parameter_count if scope_expected_count == 0
                        conflicting_owner <- true if candidate.parameter_count != scope_expected_count
                        scope_final_rows <- scope_final_rows + 1 if candidate.parameter_index + 1 == candidate.parameter_count and candidate.name == expected.owner
                        conflicting_owner <- true if candidate.parameter_index + 1 == candidate.parameter_count and candidate.name != expected.owner
                    if candidate.kind == "enum-underlying" and candidate.owner_type_identity == expected.owner_type_identity:
                        underlying_rows <- underlying_rows + 1
                        conflicting_owner <- true if candidate.owner != expected.owner or candidate.name != expected.owner
                return false if type_identity_rows != 1 or matching_type_rows != 1 or tag_rows == 0 or member_rows == 0 or underlying_rows != 1 or scope_rows == 0 or scope_rows != scope_expected_count or scope_final_rows != 1 or conflicting_owner
            return true

        def proof_kernel_replay_type_environment_binding_count(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> usize:
            return ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET + 1 if environment.global_bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            return ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET + 1 if environment.bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET - environment.global_bindings.count
            return environment.global_bindings.count + environment.bindings.count

        def proof_kernel_replay_type_environment_binding_at(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: usize) -> ElisaProofKernelCore::ProofKernelTypingBinding:
            return environment.global_bindings[index] if index < environment.global_bindings.count
            local_index: usize = index - environment.global_bindings.count
            return environment.bindings[local_index] if local_index < environment.bindings.count
            return ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}

        def proof_kernel_replay_type_environment_valid(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> bool:
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return false if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            for index in 0..<total_bindings |index, environment|:
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                return false if not proof_kernel_replay_typing_binding_valid(binding)
            work: mutable usize = 0
            return proof_kernel_replay_enum_underlying_bindings_valid(environment, &work)

        def proof_kernel_replay_type_environment_invalid_binding_name(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> sview:
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return "__kernel_type_budget__" if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            for index in 0..<total_bindings |index, environment|:
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                return binding.name if not proof_kernel_replay_typing_binding_valid(binding)
            work: mutable usize = 0
            return "__kernel_enum_underlying__" if not proof_kernel_replay_enum_underlying_bindings_valid(environment, &work)
            return ""

        def proof_kernel_replay_type_scan_budget_admitted(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, node_count: usize) -> bool:
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return false if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            return true if total_bindings == 0 or node_count == 0
            per_binding_limit: usize = ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_BUDGET / ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_FACTOR / node_count
            return total_bindings <= per_binding_limit

        def proof_kernel_replay_find_value_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, name: sview, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            return proof_kernel_replay_find_owned_value_binding(environment, index, name, 0, work)

        # Bindings are selected by the exact validated module-path identity (zero: root scope).
        # Lexical (local) bindings shadow the global environment, as in the source language;
        # remaining disagreement among same-level candidates is still ambiguous and unknown.
        def proof_kernel_replay_find_owned_value_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, name: sview, owner_identity: usize, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            empty: ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = empty
            local_found: mutable bool = false
            local_ambiguous: mutable bool = false
            local_selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = empty
            global_count: usize = environment.global_bindings.count
            return (false, selected) if index.source_binding_count != proof_kernel_replay_type_environment_binding_count(environment) or index.value_binding_count > index.value_binding_indices.count
            for value_offset in 0..<index.value_binding_count |value_offset, environment, index, name, owner_identity, global_count, found, ambiguous, selected, local_found, local_ambiguous, local_selected, work|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding_index: usize = index.value_binding_indices[value_offset]
                return (false, selected) if binding_index >= index.source_binding_count
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                kind_valid: bool = match binding.kind:
                    "value": true
                    "reference-value": true
                    "proposition": true
                    _: false
                return (false, selected) if not kind_valid
                if binding.name == name and binding.owner_type_identity == owner_identity:
                    if binding_index >= global_count:
                        if not local_found:
                            local_selected <- binding
                            local_found <- true
                        elif not proof_kernel_replay_typing_evidence_equal(local_selected, binding):
                            local_ambiguous <- true
                    elif not found:
                        selected <- binding
                        found <- true
                    elif not proof_kernel_replay_typing_evidence_equal(selected, binding):
                        ambiguous <- true
            return (not local_ambiguous, local_selected) if local_found
            return (found and not ambiguous, selected)

        # Legacy leaf accessor for readers that only need a display name. Owner-sensitive lookup
        # uses `proof_kernel_replay_scope_owner_identity` and exact segment records below.
        def proof_kernel_replay_scope_qualifier(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> sview:
            return "" if root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return "" if node.kind != "scope" or node.left >= nodes.count
            base: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            return base.name if base.kind == "ident" or base.kind == "scope"
            return ""

        def proof_kernel_replay_scope_path_count(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> usize:
            return 0 if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return 1 if node.kind == "ident"
            return 1 + proof_kernel_replay_scope_path_count(nodes, node.left, depth + 1) if node.kind == "scope"
            return 0

        def proof_kernel_replay_scope_path_segment(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, index: usize, depth: usize) -> sview:
            return "" if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return node.name if node.kind == "ident" and index == 0
            return "" if node.kind != "scope"
            prefix_count: usize = proof_kernel_replay_scope_path_count(nodes, node.left, depth + 1)
            return node.name if index == prefix_count
            return proof_kernel_replay_scope_path_segment(nodes, node.left, index, depth + 1) if index < prefix_count
            return ""

        def proof_kernel_replay_owner_path_count(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, owner_identity: usize, work: mutable usize&) -> usize:
            count: mutable usize = 0
            found: mutable bool = false
            for binding_index in 0..<proof_kernel_replay_type_environment_binding_count(environment) |binding_index, environment, owner_identity, count, found, work|:
                return 0 if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                continue if binding.kind != "module-owner-segment" or binding.owner_type_identity != owner_identity or binding.parameter_index != 0
                return 0 if found
                count <- binding.parameter_count
                found <- true
            return count if found
            return 0

        def proof_kernel_replay_owner_path_segment(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, owner_identity: usize, index: usize, count: usize, work: mutable usize&) -> sview:
            found: mutable bool = false
            selected: mutable sview = ""
            for binding_index in 0..<proof_kernel_replay_type_environment_binding_count(environment) |binding_index, environment, owner_identity, index, count, found, selected, work|:
                return "" if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                continue if binding.kind != "module-owner-segment" or binding.owner_type_identity != owner_identity or binding.parameter_index != index or binding.parameter_count != count
                return "" if found
                selected <- binding.name
                found <- true
            return selected if found
            return ""

        def proof_kernel_replay_owner_path_shape_valid(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, owner_identity: usize, work: mutable usize&) -> bool:
            count: usize = proof_kernel_replay_owner_path_count(environment, owner_identity, work)
            return false if count == 0
            rows: mutable usize = 0
            for binding_index in 0..<proof_kernel_replay_type_environment_binding_count(environment) |binding_index, environment, owner_identity, count, rows, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                continue if binding.kind != "module-owner-segment" or binding.owner_type_identity != owner_identity
                return false if binding.parameter_count != count or binding.parameter_index >= count or binding.name == ""
                selected: sview = proof_kernel_replay_owner_path_segment(environment, owner_identity, binding.parameter_index, count, work)
                return false if selected == "" or selected != binding.name
                rows <- rows + 1
            return rows == count

        def proof_kernel_replay_owner_identity_recorded(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, owner_identity: usize, work: mutable usize&) -> bool:
            return proof_kernel_replay_owner_path_shape_valid(environment, owner_identity, work)

        def proof_kernel_replay_owner_path_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, owner_identity: usize, path_root: usize, path_count: usize, work: mutable usize&) -> bool:
            return false if owner_identity == 0 or path_count == 0
            return false if not proof_kernel_replay_owner_identity_recorded(environment, owner_identity, work)
            owner_count: usize = proof_kernel_replay_owner_path_count(environment, owner_identity, work)
            return false if owner_count != path_count
            for segment_index in 0..<path_count |segment_index, nodes, environment, owner_identity, path_root, path_count, owner_count, work|:
                expected: sview = proof_kernel_replay_scope_path_segment(nodes, path_root, segment_index, 0)
                actual: sview = proof_kernel_replay_owner_path_segment(environment, owner_identity, segment_index, owner_count, work)
                return false if expected == "" or actual == "" or actual != expected
            return true

        def proof_kernel_replay_owner_path_prefix_suffix_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, candidate_identity: usize, context_identity: usize, qualifier_root: usize, qualifier_count: usize, work: mutable usize&) -> bool:
            return false if not proof_kernel_replay_owner_identity_recorded(environment, candidate_identity, work) or not proof_kernel_replay_owner_identity_recorded(environment, context_identity, work)
            context_count: usize = proof_kernel_replay_owner_path_count(environment, context_identity, work)
            candidate_count: usize = proof_kernel_replay_owner_path_count(environment, candidate_identity, work)
            return false if context_count == 0 or candidate_count != context_count + qualifier_count
            for index in 0..<context_count |index, environment, candidate_identity, context_identity, context_count, work|:
                context_segment: sview = proof_kernel_replay_owner_path_segment(environment, context_identity, index, context_count, work)
                candidate_segment: sview = proof_kernel_replay_owner_path_segment(environment, candidate_identity, index, candidate_count, work)
                return false if context_segment == "" or candidate_segment == "" or context_segment != candidate_segment
            for index in 0..<qualifier_count |index, nodes, environment, candidate_identity, qualifier_root, qualifier_count, context_count, candidate_count, work|:
                expected: sview = proof_kernel_replay_scope_path_segment(nodes, qualifier_root, index, 0)
                actual: sview = proof_kernel_replay_owner_path_segment(environment, candidate_identity, context_count + index, candidate_count, work)
                return false if expected == "" or actual == "" or actual != expected
            return true

        def proof_kernel_replay_scope_owner_identity(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, path_root: usize, work: mutable usize&) -> usize:
            path_count: usize = proof_kernel_replay_scope_path_count(nodes, path_root, 0)
            return 0 if path_count == 0
            context_identity: mutable usize = 0
            context_seen: mutable bool = false
            for binding_index in 0..<proof_kernel_replay_type_environment_binding_count(environment) |binding_index, environment, context_identity, context_seen, work|:
                return 0 if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                continue if binding.kind != "module-context"
                return 0 if context_seen
                return 0 if not proof_kernel_replay_owner_identity_recorded(environment, binding.owner_type_identity, work)
                context_identity <- binding.owner_type_identity
                context_seen <- true
            found_identity: mutable usize = 0
            found: mutable bool = false
            for binding_index in 0..<proof_kernel_replay_type_environment_binding_count(environment) |binding_index, nodes, environment, path_root, path_count, context_identity, context_seen, found_identity, found, work|:
                return 0 if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                continue if binding.kind != "module-owner-segment" or binding.parameter_index != 0
                candidate_count: usize = binding.parameter_count
                continue if candidate_count == 0
                candidate_id: usize = binding.owner_type_identity
                direct_match: bool = proof_kernel_replay_owner_path_valid(nodes, environment, candidate_id, path_root, path_count, work)
                relative_match: bool = context_seen and proof_kernel_replay_owner_path_prefix_suffix_valid(nodes, environment, candidate_id, context_identity, path_root, path_count, work)
                continue if not direct_match and not relative_match
                return 0 if found and found_identity != candidate_id
                found_identity <- candidate_id
                found <- true
            return found_identity if found
            return 0
