# Validation and indexed access for the segmented typing environment. Global declaration
# signatures are shared across obligations; local context bindings are scoped per expression.
extend ElisaProofKernelReplay:
    public:
        # Reusable allocation scratch only; every index row is rebuilt from validated input.
        struct ProofKernelReplayTypingWorkspace:
            value_binding_indices: mutable darray[usize]
            function_parameter_indices: mutable darray[usize]
            function_parameter_bucket_heads: mutable darray[usize]
            function_parameter_next_indices: mutable darray[usize]

        def proof_kernel_replay_typing_workspace_new() -> ProofKernelReplayTypingWorkspace:
            return ProofKernelReplayTypingWorkspace{value_binding_indices: [], function_parameter_indices: [], function_parameter_bucket_heads: [], function_parameter_next_indices: []}

    private:
        const PROOF_KERNEL_MAX_TYPED_FUNCTION_PARAMETERS: usize = 1024

        # Compact positions of bindings used by hot typing lookups. Unrelated type, field, and
        # declaration rows need not be revisited; lookup routines still compare exact evidence.
        struct ProofKernelReplayTypingIndex:
            value_binding_count: usize
            function_parameter_count: usize
            source_binding_count: usize
            value_binding_indices: darray[usize]
            function_parameter_indices: darray[usize]
            function_parameter_bucket_heads: darray[usize]
            function_parameter_next_indices: darray[usize]

        def proof_kernel_replay_empty_typing_index() -> ProofKernelReplayTypingIndex:
            return ProofKernelReplayTypingIndex{value_binding_count: 0, function_parameter_count: 0, source_binding_count: 0, value_binding_indices: [], function_parameter_indices: [], function_parameter_bucket_heads: [], function_parameter_next_indices: []}

        def proof_kernel_replay_build_typing_index(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&) -> (known: bool, index: ProofKernelReplayTypingIndex):
            empty: ProofKernelReplayTypingIndex = proof_kernel_replay_empty_typing_index()
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return (false, empty) if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            value_indices: mutable darray[usize] = []
            parameter_indices: mutable darray[usize] = []
            value_binding_count: mutable usize = 0
            parameter_binding_count: mutable usize = 0
            for binding_index in 0..<total_bindings |binding_index, environment, value_indices, parameter_indices, value_binding_count, parameter_binding_count, work|:
                return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                return (false, empty) if not proof_kernel_replay_typing_binding_valid(binding)
                is_value_binding: bool = match binding.kind:
                    "value": true
                    "proposition": true
                    _: false
                if is_value_binding:
                    value_indices.push(binding_index)
                    value_binding_count <- value_binding_count + 1
                if binding.kind == "function-parameter":
                    parameter_indices.push(binding_index)
                    parameter_binding_count <- parameter_binding_count + 1
            parameter_bucket_heads: mutable darray[usize] = []
            parameter_next_indices: mutable darray[usize] = []
            if parameter_binding_count > 0:
                parameter_bucket_heads.resize(parameter_binding_count)
                parameter_next_indices.resize(parameter_binding_count)
                for slot in 0..<parameter_binding_count |slot, parameter_binding_count, parameter_bucket_heads, work|:
                    return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                    parameter_bucket_heads[slot] <- parameter_binding_count
                for parameter_offset in 0..<parameter_binding_count |parameter_offset, environment, parameter_indices, parameter_binding_count, parameter_bucket_heads, parameter_next_indices, work|:
                    return (false, empty) if not proof_kernel_replay_type_work_consume(work)
                    binding_index: usize = parameter_indices[parameter_offset]
                    return (false, empty) if binding_index >= total_bindings
                    binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                    return (false, empty) if binding.kind != "function-parameter" or binding.signature_identity == 0
                    slot: usize = (binding.signature_identity % parameter_binding_count).usize()
                    parameter_next_indices[parameter_offset] <- parameter_bucket_heads[slot]
                    parameter_bucket_heads[slot] <- parameter_offset
            return (true, ProofKernelReplayTypingIndex{value_binding_count: value_binding_count, function_parameter_count: parameter_binding_count, source_binding_count: total_bindings, value_binding_indices: value_indices, function_parameter_indices: parameter_indices, function_parameter_bucket_heads: parameter_bucket_heads, function_parameter_next_indices: parameter_next_indices})

        # Fills caller-owned scratch, but returns no view of it. Callers form the temporary index
        # locally only after this complete validation-and-build pass succeeds.
        def proof_kernel_replay_build_typing_workspace(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&, scratch: mutable ProofKernelReplayTypingWorkspace&) -> bool:
            scratch.value_binding_indices.clear()
            scratch.function_parameter_indices.clear()
            scratch.function_parameter_bucket_heads.clear()
            scratch.function_parameter_next_indices.clear()
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return false if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            value_binding_count: mutable usize = 0
            parameter_binding_count: mutable usize = 0
            for binding_index in 0..<total_bindings |binding_index, environment, scratch, value_binding_count, parameter_binding_count, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                return false if not proof_kernel_replay_typing_binding_valid(binding)
                is_value_binding: bool = match binding.kind:
                    "value": true
                    "proposition": true
                    _: false
                if is_value_binding:
                    scratch.value_binding_indices.push(binding_index)
                    value_binding_count <- value_binding_count + 1
                if binding.kind == "function-parameter":
                    scratch.function_parameter_indices.push(binding_index)
                    parameter_binding_count <- parameter_binding_count + 1
            if parameter_binding_count > 0:
                scratch.function_parameter_bucket_heads.resize(parameter_binding_count)
                scratch.function_parameter_next_indices.resize(parameter_binding_count)
                for slot in 0..<parameter_binding_count |slot, parameter_binding_count, scratch, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    scratch.function_parameter_bucket_heads[slot] <- parameter_binding_count
                for parameter_offset in 0..<parameter_binding_count |parameter_offset, environment, scratch, parameter_binding_count, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    binding_index: usize = scratch.function_parameter_indices[parameter_offset]
                    return false if binding_index >= total_bindings
                    binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                    return false if binding.kind != "function-parameter" or binding.signature_identity == 0
                    slot: usize = (binding.signature_identity % parameter_binding_count).usize()
                    scratch.function_parameter_next_indices[parameter_offset] <- scratch.function_parameter_bucket_heads[slot]
                    scratch.function_parameter_bucket_heads[slot] <- parameter_offset
            return true

        def proof_kernel_replay_typing_binding_valid(binding: ElisaProofKernelCore::ProofKernelTypingBinding) -> bool:
            return false if binding.name == "" or binding.type_name == ""
            return false if binding.sort != "boolean" and binding.sort != "integer" and binding.sort != "floating" and binding.sort != "character" and binding.sort != "string" and binding.sort != "aggregate" and binding.sort != "named" and binding.sort != "container" and binding.sort != "void" and binding.sort != "proposition"
            if binding.kind == "value":
                return false if binding.owner != ""
                return false if binding.owner_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "function":
                return false if binding.owner != "" or binding.owner_type_identity != 0 or binding.parameter_index != 0 or binding.parameter_has_default or binding.parameter_by_reference
                return false if binding.parameter_count > PROOF_KERNEL_MAX_TYPED_FUNCTION_PARAMETERS
                return false if binding.signature_identity == 0 and binding.parameter_count != 0
            elif binding.kind == "proposition":
                return false if binding.owner != "" or binding.sort != "proposition" or binding.owner_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "type":
                return false if binding.owner != "" or binding.type_name != binding.name
                return false if binding.sort != "named" and binding.sort != "container"
                return false if binding.type_identity == 0
                return false if binding.owner_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
                return false if binding.sort == "named" and (binding.element_sort != "" or binding.element_type_name != "" or binding.element_type_identity != 0)
            elif binding.kind == "field":
                return false if binding.owner == ""
                return false if binding.owner_type_identity == 0
                return false if binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "function-parameter":
                return false if binding.owner == "" or binding.signature_identity == 0 or binding.parameter_count != 0 or binding.owner_type_identity != 0
            elif binding.kind == "enum-member":
                return false if binding.owner == "" or binding.sort != "named" or binding.type_name != binding.owner
                return false if binding.element_sort != "" or binding.element_type_name != "" or binding.type_identity == 0 or binding.owner_type_identity != binding.type_identity or binding.element_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            elif binding.kind == "enum-tag":
                return false if binding.owner == "" or binding.sort != "named" or binding.type_name != binding.owner
                return false if binding.element_sort != "" or binding.element_type_name != "" or binding.type_identity == 0 or binding.owner_type_identity != binding.type_identity or binding.element_type_identity != 0 or binding.signature_identity != 0 or binding.parameter_index != 0 or binding.parameter_count != 0 or binding.parameter_has_default or binding.parameter_by_reference
            else:
                return false
            tuple_type: bool = binding.sort == "aggregate" and binding.type_name == "tuple"
            return false if tuple_type and binding.type_identity == 0
            named_type_binding: bool = binding.sort == "named"
            return false if named_type_binding and binding.type_identity == 0
            return false if not tuple_type and not named_type_binding and binding.sort != "container" and binding.type_identity != 0
            if binding.sort == "container":
                return false if binding.element_type_name == ""
                return false if binding.element_sort != "boolean" and binding.element_sort != "integer" and binding.element_sort != "floating" and binding.element_sort != "character" and binding.element_sort != "string" and binding.element_sort != "aggregate" and binding.element_sort != "named" and binding.element_sort != "container"
                element_has_identity: bool = binding.element_sort == "named" or (binding.element_sort == "aggregate" and binding.element_type_name == "tuple") or binding.element_sort == "container"
                return false if element_has_identity != (binding.element_type_identity != 0)
                return true
            return binding.element_sort == "" and binding.element_type_name == "" and binding.element_type_identity == 0 and (tuple_type or named_type_binding or binding.type_identity == 0)

        def proof_kernel_replay_type_environment_binding_count(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> usize:
            return ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET + 1 if environment.global_bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            return ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET + 1 if environment.bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET - environment.global_bindings.count
            return environment.global_bindings.count + environment.bindings.count

        def proof_kernel_replay_type_environment_binding_at(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: usize) -> ElisaProofKernelCore::ProofKernelTypingBinding:
            return environment.global_bindings[index] if index < environment.global_bindings.count
            local_index: usize = index - environment.global_bindings.count
            return environment.bindings[local_index] if local_index < environment.bindings.count
            return ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}

        def proof_kernel_replay_type_environment_valid(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> bool:
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return false if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            for index in 0..<total_bindings |index, environment|:
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                return false if not proof_kernel_replay_typing_binding_valid(binding)
            return true

        def proof_kernel_replay_type_environment_invalid_binding_name(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> sview:
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return "__kernel_type_budget__" if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            for index in 0..<total_bindings |index, environment|:
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                return binding.name if not proof_kernel_replay_typing_binding_valid(binding)
            return ""

        def proof_kernel_replay_type_scan_budget_admitted(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, node_count: usize) -> bool:
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return false if total_bindings > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            return true if total_bindings == 0 or node_count == 0
            per_binding_limit: usize = ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_BUDGET / ElisaProofKernelCore::PROOF_KERNEL_TYPE_SCAN_FACTOR / node_count
            return total_bindings <= per_binding_limit
