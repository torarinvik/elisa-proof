extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_logical_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, fuel: mutable usize&, depth: usize = 0) -> (valid: bool, known: bool, value: bool):
            return (false, false, false) if fuel == 0 or depth >= 64 or not proof_kernel_replay_valid(nodes, root)
            fuel <- fuel - 1
            node = nodes[root]
            return (false, false, false) if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren":
                return proof_kernel_replay_logical_constant(nodes, children, facts, node.left, fuel, depth + 1)
            if node.kind == "bool":
                return (false, false, false) if node.value != 0 and node.value != 1
                return (true, true, node.value == 1)
            if node.kind == "ident" or node.kind == "scope":
                return (proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0), false, false)
            if node.kind == "unary" and node.operator == "not":
                inner = proof_kernel_replay_logical_constant(nodes, children, facts, node.left, fuel, depth + 1)
                return (inner.valid, inner.known, not inner.value)
            if node.kind == "binary" and (node.operator == "and" or node.operator == "or"):
                a = proof_kernel_replay_logical_constant(nodes, children, facts, node.left, fuel, depth + 1)
                b = proof_kernel_replay_logical_constant(nodes, children, facts, node.right, fuel, depth + 1)
                return (false, false, false) if not a.valid or not b.valid
                if node.operator == "and":
                    return (true, true, false) if (a.known and not a.value) or (b.known and not b.value)
                    return (true, a.known and b.known, a.value and b.value)
                return (true, true, true) if (a.known and a.value) or (b.known and b.value)
                return (true, a.known and b.known, a.value or b.value)
            return (false, false, false)

        def proof_kernel_replay_logical_join_operator(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize = 0) -> sview:
            return "" if depth >= 64 or not proof_kernel_replay_valid(nodes, root)
            node = nodes[root]
            return "" if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren":
                return proof_kernel_replay_logical_join_operator(nodes, node.left, depth + 1)
            return node.operator if node.kind == "binary" and (node.operator == "and" or node.operator == "or") else ""

        def proof_kernel_replay_logical_join_atoms(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, operator: sview, atoms: mutable darray[usize]&, fuel: mutable usize&, depth: usize = 0) -> bool:
            return false if fuel == 0 or depth >= 64 or atoms.count >= 64 or not proof_kernel_replay_valid(nodes, root)
            fuel <- fuel - 1
            node = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            constant = proof_kernel_replay_logical_constant(nodes, children, facts, root, fuel, depth)
            return false if not constant.valid
            if constant.known:
                return true if (operator == "and" and constant.value) or (operator == "or" and not constant.value)
                atoms.push(root)
                return true
            if node.kind == "paren":
                return proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.left, operator, atoms, fuel, depth + 1)
            if node.kind == "binary":
                if node.operator != operator:
                    a = proof_kernel_replay_logical_constant(nodes, children, facts, node.left, fuel, depth + 1)
                    b = proof_kernel_replay_logical_constant(nodes, children, facts, node.right, fuel, depth + 1)
                    return false if not a.valid or not b.valid
                    if a.known and ((node.operator == "and" and a.value) or (node.operator == "or" and not a.value)):
                        return proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.right, operator, atoms, fuel, depth + 1)
                    if b.known and ((node.operator == "and" and b.value) or (node.operator == "or" and not b.value)):
                        return proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.left, operator, atoms, fuel, depth + 1)
                    return false
                return proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.left, operator, atoms, fuel, depth + 1) and proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.right, operator, atoms, fuel, depth + 1)
            if node.kind == "bool":
                return false if node.value != 0 and node.value != 1
                return true if (operator == "and" and node.value == 1) or (operator == "or" and node.value == 0)
            elif node.kind == "ident" or node.kind == "scope":
                return false if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0)
            elif node.kind == "unary" and node.operator == "not":
                pass
            else:
                return false
            atoms.push(root)
            return true

        def proof_kernel_replay_logical_join_identity(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            goal = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "==" or not proof_kernel_replay_arena_shape_valid(goal)
            return false if not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            left_operator: sview = proof_kernel_replay_logical_join_operator(nodes, goal.left)
            operator: sview = left_operator if left_operator != "" else proof_kernel_replay_logical_join_operator(nodes, goal.right)
            return false if operator != "and" and operator != "or"
            a: mutable darray[usize] = []
            b: mutable darray[usize] = []
            fuel: mutable usize = 1024
            return false if not proof_kernel_replay_logical_join_atoms(nodes, children, facts, goal.left, operator, a, fuel) or not proof_kernel_replay_logical_join_atoms(nodes, children, facts, goal.right, operator, b, fuel)
            for atom in a:
                matched: mutable bool = false
                atom_constant = proof_kernel_replay_logical_constant(nodes, children, facts, atom, fuel)
                for peer in b |matched, fuel|:
                    peer_constant = proof_kernel_replay_logical_constant(nodes, children, facts, peer, fuel)
                    matched <- true if proof_kernel_replay_expr_equal(nodes, children, atom, peer, 0) or (atom_constant.valid and atom_constant.known and peer_constant.valid and peer_constant.known and atom_constant.value == peer_constant.value)
                return false if not matched
            for atom in b:
                matched: mutable bool = false
                atom_constant = proof_kernel_replay_logical_constant(nodes, children, facts, atom, fuel)
                for peer in a |matched, fuel|:
                    peer_constant = proof_kernel_replay_logical_constant(nodes, children, facts, peer, fuel)
                    matched <- true if proof_kernel_replay_expr_equal(nodes, children, atom, peer, 0) or (atom_constant.valid and atom_constant.known and peer_constant.valid and peer_constant.known and atom_constant.value == peer_constant.value)
                return false if not matched
            return true
