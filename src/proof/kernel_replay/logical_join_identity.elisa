extend ElisaProofKernelReplay:
    private:
        def proof_kernel_logical_comparison_operand(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&, depth: usize = 0) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= 64 or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren":
                return proof_kernel_logical_comparison_operand(nodes, children, facts, node.left, work_used, depth + 1)
            return true if node.kind == "opaque-float-literal"
            return false if:
                node.kind != "ident" and node.kind != "scope" and node.kind != "int" and node.kind != "bool" and node.kind != "char"
                node.kind == "bool" and node.value != 0 and node.value != 1
            witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and witnessed

        # Preserve the comparison's original arena identity and polarity.
        def proof_kernel_logical_comparison_atom(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node = nodes[root]
            return false if:
                not proof_kernel_replay_arena_shape_valid(node) or node.kind != "binary"
                node.operator != "==" and node.operator != "!=" and node.operator != "<" and node.operator != "<=" and node.operator != ">" and node.operator != ">="
            for fact_root in facts |fact_root, nodes, children, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                if fact.kind == "call" and fact.left < nodes.count:
                    return false if:
                        not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.left, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if fact.kind == "call" and fact.children_count == 2 and proof_kernel_replay_child_range_valid(fact.children_start, fact.children_count, children.count):
                    for offset in 0..<fact.children_count |offset, nodes, children, fact, work_used|:
                        argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, fact.children_start + offset)
                        continue if not argument.known or argument.value >= nodes.count
                        return false if:
                            not proof_kernel_replay_goal_search_charge_node_text(nodes, argument.value, work_used)
                            work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        argument_node: ElisaProofKernelCore::ProofKernelNode = nodes[argument.value]
                        if argument_node.kind == "call_arg" and argument_node.name == "" and argument_node.secondary_name == "" and argument_node.left < nodes.count:
                            return false if:
                                not proof_kernel_replay_goal_search_charge_node_text(nodes, argument_node.left, work_used)
                                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                marker: (known: bool, term: usize, protocol: sview) = proof_kernel_replay_untrusted_operator_marker_with_work(nodes, children, fact_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if marker.known:
                    return false if:
                        not proof_kernel_replay_goal_search_charge_node_text(nodes, marker.term, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    applies: bool = proof_kernel_replay_untrusted_scalar_reference_operator_applies_with_work(nodes, children, marker.term, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) if marker.protocol == "Element.Ref" else proof_kernel_replay_untrusted_element_operator_applies_with_work(nodes, children, marker.term, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) if marker.protocol == "Element.All" or marker.protocol == "Index.All" else proof_kernel_replay_untrusted_operator_applies_with_work(nodes, children, marker.term, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or applies
            return false if:
                not proof_kernel_logical_comparison_operand(nodes, children, facts, node.left, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proof_kernel_logical_comparison_operand(nodes, children, facts, node.right, work_used)

        struct ProofKernelLogicalSignedAtom:
            root: usize
            negated: bool
            constant: bool
            value: bool

        def proof_kernel_logical_signed_operator(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, negated: bool = false, depth: usize = 0) -> sview:
            return "" if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= 64 or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node = nodes[root]
            return "" if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren":
                return proof_kernel_logical_signed_operator(nodes, node.left, work_used, negated, depth + 1)
            if node.kind == "unary" and node.operator == "not":
                return proof_kernel_logical_signed_operator(nodes, node.left, work_used, not negated, depth + 1)
            return "" if node.kind != "binary" or (node.operator != "and" and node.operator != "or")
            dual: sview = "or" if node.operator == "and" else "and"
            return dual if negated else node.operator

        def proof_kernel_logical_signed_atoms(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, operator: sview, negated: bool, atoms: mutable darray[ProofKernelLogicalSignedAtom]&, fuel: mutable usize&, work_used: mutable usize&, depth: usize = 0) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                fuel == 0 or depth >= 64 or atoms.count >= 64 or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            fuel <- fuel - 1
            node = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            folded = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, root, fuel, work_used, depth)
            return false if not folded.valid or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if folded.known:
                value = not folded.value if negated else folded.value
                return true if (operator == "and" and value) or (operator == "or" and not value)
                atoms.push(ProofKernelLogicalSignedAtom{root: root, negated: false, constant: true, value: value})
                return true
            if node.kind == "paren":
                return proof_kernel_logical_signed_atoms(nodes, children, facts, node.left, operator, negated, atoms, fuel, work_used, depth + 1)
            if node.kind == "unary" and node.operator == "not":
                return proof_kernel_logical_signed_atoms(nodes, children, facts, node.left, operator, not negated, atoms, fuel, work_used, depth + 1)
            if node.kind == "binary":
                if node.operator != "and" and node.operator != "or":
                    return false if not proof_kernel_logical_comparison_atom(nodes, children, facts, root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    atoms.push(ProofKernelLogicalSignedAtom{root: root, negated: negated, constant: false, value: false})
                    return true
                dual: sview = "or" if node.operator == "and" else "and"
                effective: sview = dual if negated else node.operator
                if effective != operator:
                    a = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, node.left, fuel, work_used, depth + 1)
                    return false if not a.valid or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    b = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, node.right, fuel, work_used, depth + 1)
                    return false if not b.valid or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if a.known and ((node.operator == "and" and a.value) or (node.operator == "or" and not a.value)):
                        return proof_kernel_logical_signed_atoms(nodes, children, facts, node.right, operator, negated, atoms, fuel, work_used, depth + 1)
                    if b.known and ((node.operator == "and" and b.value) or (node.operator == "or" and not b.value)):
                        return proof_kernel_logical_signed_atoms(nodes, children, facts, node.left, operator, negated, atoms, fuel, work_used, depth + 1)
                    # Preserve the original arena island and signed polarity.
                    atoms.push(ProofKernelLogicalSignedAtom{root: root, negated: negated, constant: false, value: false})
                    return true
                return proof_kernel_logical_signed_atoms(nodes, children, facts, node.left, operator, negated, atoms, fuel, work_used, depth + 1) and proof_kernel_logical_signed_atoms(nodes, children, facts, node.right, operator, negated, atoms, fuel, work_used, depth + 1)
            if node.kind in {"ident", "scope"}:
                atoms.push(ProofKernelLogicalSignedAtom{root: root, negated: negated, constant: false, value: false})
                return true
            return false

        def proof_kernel_logical_signed_identity(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(goal) or goal.kind != "binary" or goal.operator != "=="
            first = proof_kernel_logical_signed_operator(nodes, goal.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            second = proof_kernel_logical_signed_operator(nodes, goal.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            fallback: sview = "and"
            operator: sview = first if first != "" else second if second != "" else fallback
            a: mutable darray[ProofKernelLogicalSignedAtom] = []
            b: mutable darray[ProofKernelLogicalSignedAtom] = []
            fuel: mutable usize = 1024
            return false if:
                not proof_kernel_logical_signed_atoms(nodes, children, facts, goal.left, operator, false, a, fuel, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_logical_signed_atoms(nodes, children, facts, goal.right, operator, false, b, fuel, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for atom in a:
                matched: mutable bool = false
            for peer in b |matched, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    if not atom.constant and not peer.constant and atom.negated == peer.negated:
                        same_atom: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, atom.root, peer.root, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        matched <- true if same_atom
                    matched <- true if atom.constant and peer.constant and atom.value == peer.value
                return false if not matched
            for atom in b:
                matched: mutable bool = false
            for peer in a |matched, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    if not atom.constant and not peer.constant and atom.negated == peer.negated:
                        same_atom: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, atom.root, peer.root, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        matched <- true if same_atom
                    matched <- true if atom.constant and peer.constant and atom.value == peer.value
                return false if not matched
            return true

        def proof_kernel_replay_logical_constant_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, fuel: mutable usize&, work_used: mutable usize&, depth: usize = 0) -> (valid: bool, known: bool, value: bool):
            return (false, false, false) if:
                not proof_kernel_replay_goal_search_charge(work_used)
                fuel == 0 or depth >= 64 or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            fuel <- fuel - 1
            node = nodes[root]
            return (false, false, false) if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren":
                return proof_kernel_replay_logical_constant_with_work(nodes, children, facts, node.left, fuel, work_used, depth + 1)
            if node.kind == "bool":
                return (false, false, false) if node.value != 0 and node.value != 1
                return (true, true, node.value == 1)
            if node.kind in {"ident", "scope"}:
                witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return (false, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (witnessed, false, false)
            if node.kind == "unary" and node.operator == "not":
                inner = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, node.left, fuel, work_used, depth + 1)
                return (false, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (inner.valid, inner.known, not inner.value)
            if node.kind == "binary" and (node.operator in {"and", "or"}):
                a = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, node.left, fuel, work_used, depth + 1)
                return (false, false, false) if not a.valid or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                b = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, node.right, fuel, work_used, depth + 1)
                return (false, false, false) if not b.valid or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if node.operator == "and":
                    return (true, true, false) if (a.known and not a.value) or (b.known and not b.value)
                    return (true, a.known and b.known, a.value and b.value)
                return (true, true, true) if (a.known and a.value) or (b.known and b.value)
                return (true, a.known and b.known, a.value or b.value)
            if node.kind == "binary":
                comparison: bool = proof_kernel_logical_comparison_atom(nodes, children, facts, root, work_used)
                return (false, false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (comparison, false, false)
            return (false, false, false)

        def proof_kernel_replay_logical_join_operator(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, depth: usize = 0) -> sview:
            return "" if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= 64 or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node = nodes[root]
            return "" if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren":
                return proof_kernel_replay_logical_join_operator(nodes, node.left, work_used, depth + 1)
            return node.operator if node.kind == "binary" and (node.operator in {"and", "or"}) else ""

        def proof_kernel_replay_logical_join_atoms(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, operator: sview, atoms: mutable darray[usize]&, fuel: mutable usize&, work_used: mutable usize&, depth: usize = 0) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                fuel == 0 or depth >= 64 or atoms.count >= 64 or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            fuel <- fuel - 1
            node = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            constant = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, root, fuel, work_used, depth)
            return false if not constant.valid or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if constant.known:
                return true if (operator == "and" and constant.value) or (operator == "or" and not constant.value)
                atoms.push(root)
                return true
            if node.kind == "paren":
                return proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.left, operator, atoms, fuel, work_used, depth + 1)
            if node.kind == "binary":
                if node.operator != operator:
                    a = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, node.left, fuel, work_used, depth + 1)
                    return false if not a.valid or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    b = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, node.right, fuel, work_used, depth + 1)
                    return false if not b.valid or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if a.known and ((node.operator == "and" and a.value) or (node.operator == "or" and not a.value)):
                        return proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.right, operator, atoms, fuel, work_used, depth + 1)
                    if b.known and ((node.operator == "and" and b.value) or (node.operator == "or" and not b.value)):
                        return proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.left, operator, atoms, fuel, work_used, depth + 1)
                    return false
                return proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.left, operator, atoms, fuel, work_used, depth + 1) and proof_kernel_replay_logical_join_atoms(nodes, children, facts, node.right, operator, atoms, fuel, work_used, depth + 1)
            if node.kind == "bool":
                return false if node.value != 0 and node.value != 1
                return true if (operator == "and" and node.value == 1) or (operator == "or" and node.value == 0)
            elif node.kind in {"ident", "scope"}:
                scalar: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not scalar
            elif node.kind == "unary" and node.operator == "not":
                pass
            else:
                return false
            atoms.push(root)
            return true

        def proof_kernel_replay_logical_join_identity_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            is_binary: bool = proof_kernel_replay_goal_search_text_equal(nodes[root].kind, "binary", work_used)
            is_equality: bool = proof_kernel_replay_goal_search_text_equal(nodes[root].operator, "==", work_used) if is_binary
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not is_binary or not is_equality
            relation_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if not relation_admission.complete or relation_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            signed_identity: bool = proof_kernel_logical_signed_identity(nodes, children, facts, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if signed_identity
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal = nodes[root]
            return false if:
                goal.kind != "binary" or goal.operator != "==" or not proof_kernel_replay_arena_shape_valid(goal)
                not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            left_operator: sview = proof_kernel_replay_logical_join_operator(nodes, goal.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            operator: mutable sview = left_operator
            if operator == "":
                operator <- proof_kernel_replay_logical_join_operator(nodes, goal.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if operator != "and" and operator != "or"
            a: mutable darray[usize] = []
            b: mutable darray[usize] = []
            fuel: mutable usize = 1024
            return false if:
                not proof_kernel_replay_logical_join_atoms(nodes, children, facts, goal.left, operator, a, fuel, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_logical_join_atoms(nodes, children, facts, goal.right, operator, b, fuel, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for atom in a:
                matched: mutable bool = false
                atom_constant = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, atom, fuel, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                for peer in b |matched, fuel, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    peer_constant = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, peer, fuel, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, atom, peer, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    matched <- true if same_term or (atom_constant.valid and atom_constant.known and peer_constant.valid and peer_constant.known and atom_constant.value == peer_constant.value)
                return false if not matched
            for atom in b:
                matched: mutable bool = false
                atom_constant = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, atom, fuel, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                for peer in a |matched, fuel, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    peer_constant = proof_kernel_replay_logical_constant_with_work(nodes, children, facts, peer, fuel, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, atom, peer, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    matched <- true if same_term or (atom_constant.valid and atom_constant.known and peer_constant.valid and peer_constant.known and atom_constant.value == peer_constant.value)
                return false if not matched
            return true
