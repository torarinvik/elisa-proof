extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_difference_push_with_goal_work(left: ProofKernelReplayAffine, right: ProofKernelReplayAffine, reverse: bool, strict: bool, constraints: mutable darray[ProofKernelReplayDifference]&, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            proof_kernel_replay_difference_push(left, right, reverse, strict, constraints)
            return true

        def proof_kernel_replay_guarded_difference_push_with_goal_work(left: ProofKernelReplayAffine, operator: sview, right: ProofKernelReplayAffine, constraints: mutable darray[ProofKernelReplayDifference]&, work_used: mutable usize&) -> bool:
            if operator in {"<=", "=="}:
                return false if not proof_kernel_replay_difference_push_with_goal_work(left, right, false, false, constraints, work_used)
            if operator == "<":
                return false if not proof_kernel_replay_difference_push_with_goal_work(left, right, false, true, constraints, work_used)
            if operator in {">=", "=="}:
                return false if not proof_kernel_replay_difference_push_with_goal_work(left, right, true, false, constraints, work_used)
            if operator == ">":
                return false if not proof_kernel_replay_difference_push_with_goal_work(left, right, true, true, constraints, work_used)
            return true

        def proof_kernel_replay_facts_state_disequality_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, facts, left, right, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                pair: mutable usize = fact
                if nodes[fact].kind == "unary" and nodes[fact].operator == "not" and nodes[fact].left < nodes.count and proof_kernel_replay_valid(nodes, nodes[fact].left):
                    inner_root: usize = nodes[fact].left
                    return false if:
                        not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, inner_root, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    pair <- inner_root if nodes[inner_root].kind == "binary" and nodes[inner_root].operator == "=="
                disequality: bool = pair != fact or nodes[fact].kind == "binary" and nodes[fact].operator == "!="
                if disequality and pair < nodes.count:
                    a: usize = nodes[pair].left
                    b: usize = nodes[pair].right
                    return true if:
                        proof_kernel_replay_goal_search_expr_equal(nodes, children, a, left, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, b, right, work_used)
                        proof_kernel_replay_goal_search_expr_equal(nodes, children, a, right, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, b, left, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            false

        def proof_kernel_replay_difference_names_ordered_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, low: sview, high: sview, work_used: mutable usize&, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "and":
                return proof_kernel_replay_difference_names_ordered_with_work(nodes, node.left, low, high, work_used, depth + 1) or proof_kernel_replay_difference_names_ordered_with_work(nodes, node.right, low, high, work_used, depth + 1)
            return false if:
                node.kind != "binary"
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(node.operator))
            left_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, node.left, work_used)
            right_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, node.right, work_used)
            forward: bool = proof_kernel_replay_goal_search_text_equal(left_name, low, work_used) and proof_kernel_replay_goal_search_text_equal(right_name, high, work_used)
            backward: bool = proof_kernel_replay_goal_search_text_equal(left_name, high, work_used) and proof_kernel_replay_goal_search_text_equal(right_name, low, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            ((node.operator in {"<=", "<"}) and forward) or ((node.operator in {">=", ">"}) and backward)

        def proof_kernel_replay_guarded_difference_names_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&) -> (known: bool, high: sview, low: sview):
            return (false, "", "") if:
                not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, "", "") if node.kind != "binary" or node.operator != "-"
            high: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, node.left, work_used)
            low: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, node.right, work_used)
            return (false, "", "") if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or high == "" or low == ""
            same: bool = proof_kernel_replay_goal_search_text_equal(high, low, work_used)
            return (false, "", "") if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or same
            high_width: i64 = proof_kernel_replay_unsigned_marker_width_for_name_with_goal_work(nodes, children, facts, high, work_used)
            low_width: i64 = proof_kernel_replay_unsigned_marker_width_for_name_with_goal_work(nodes, children, facts, low, work_used)
            return (false, "", "") if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or high_width == 0 or low_width != high_width
            for fact in facts |fact, nodes, facts, low, high, work_used|:
                return (false, "", "") if not proof_kernel_replay_goal_search_charge(work_used)
                return (true, high, low) if proof_kernel_replay_difference_names_ordered_with_work(nodes, fact, low, high, work_used, 0)
                return (false, "", "") if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            (false, "", "")

        def proof_kernel_replay_guarded_difference_import_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize], constraints: mutable darray[ProofKernelReplayDifference]&, work_used: mutable usize&) -> bool:
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if right_constant.known:
                split: (known: bool, high: sview, low: sview) = proof_kernel_replay_guarded_difference_names_with_work(nodes, children, left_root, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not split.known
                high: ProofKernelReplayAffine = ProofKernelReplayAffine{base: split.high, offset: 0, known: true, negative: false}
                low: ProofKernelReplayAffine = ProofKernelReplayAffine{base: split.low, offset: right_constant.value, known: true, negative: false}
                return proof_kernel_replay_guarded_difference_push_with_goal_work(high, operator, low, constraints, work_used)
            left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_constant.known
            split: (known: bool, high: sview, low: sview) = proof_kernel_replay_guarded_difference_names_with_work(nodes, children, right_root, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not split.known
            low: ProofKernelReplayAffine = ProofKernelReplayAffine{base: split.low, offset: left_constant.value, known: true, negative: false}
            high: ProofKernelReplayAffine = ProofKernelReplayAffine{base: split.high, offset: 0, known: true, negative: false}
            proof_kernel_replay_guarded_difference_push_with_goal_work(low, operator, high, constraints, work_used)

        def proof_kernel_replay_unsigned_unit_increment_base_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left: usize, right: usize, work_used: mutable usize&) -> (known: bool, base: usize):
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, left) if right_constant.known and right_constant.value == 1
            left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, right) if left_constant.known and left_constant.value == 1
            (false, 0)

        def proof_kernel_replay_peer_is_nameable_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return node.name != "" if node.kind == "ident"
            return false if:
                node.kind != "field" or node.name == "" or node.left >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            base: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            base.kind == "ident" and base.name != ""

        def proof_kernel_replay_peer_unsigned_width_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&) -> i64:
            proof_kernel_replay_sum_peer_unsigned_width_with_goal_work(nodes, children, root, facts, work_used)

        def proof_kernel_replay_unsigned_increment_has_direct_peer_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, base: usize, width: i64, facts: darray[usize], work_used: mutable usize&) -> bool:
            return false if width == 0
            for fact in facts |fact, nodes, children, base, width, facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
                continue if not located.known
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                node: mutable ElisaProofKernelCore::ProofKernelNode = located.node
                complemented: mutable bool = false
                if node.kind == "unary" and node.operator == "not":
                    inner: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                    continue if not inner.known
                    return false if:
                        not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if inner.node.kind != "binary"
                    continue if inner.node.operator != ">=" and inner.node.operator != "<="
                    node <- inner.node
                    complemented <- true
                continue if node.kind != "binary"
                operator: sview = proof_kernel_replay_negation(node.operator) if complemented else node.operator
                if operator == "<" and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, base, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if proof_kernel_replay_peer_is_nameable_with_goal_work(nodes, node.right, work_used):
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, node.right, facts, work_used) == width
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if operator == ">" and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.right, base, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if proof_kernel_replay_peer_is_nameable_with_goal_work(nodes, node.left, work_used):
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, node.left, facts, work_used) == width
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            false

        def proof_kernel_replay_unsigned_increment_has_strict_peer_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, base: usize, width: i64, facts: darray[usize], work_used: mutable usize&) -> bool:
            return false if width == 0
            return true if proof_kernel_replay_unsigned_increment_has_direct_peer_with_work(nodes, children, base, width, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts |fact, nodes, children, base, width, facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
                continue if not located.known
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if located.node.kind != "binary"
                node: ElisaProofKernelCore::ProofKernelNode = located.node
                if node.operator == "<=" and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, base, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if proof_kernel_replay_peer_is_nameable_with_goal_work(nodes, node.right, work_used) and not proof_kernel_replay_goal_search_expr_equal(nodes, children, node.right, base, work_used):
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if proof_kernel_replay_unsigned_increment_has_direct_peer_with_work(nodes, children, node.right, width, facts, work_used)
                if node.operator == ">=" and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.right, base, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if proof_kernel_replay_peer_is_nameable_with_goal_work(nodes, node.left, work_used) and not proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, base, work_used):
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if proof_kernel_replay_unsigned_increment_has_direct_peer_with_work(nodes, children, node.left, width, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            false

        def proof_kernel_replay_affine_peer_safe_from_facts_with_work(affine: ProofKernelReplayAffine, root: usize, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], work_used: mutable usize&) -> bool:
            return false if not affine.known or affine.negative or affine.offset != 1 or affine.base == ""
            width: i64 = proof_kernel_replay_unsigned_marker_width_for_name_with_goal_work(nodes, children, facts, affine.base, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.operator != "+"
            unit: (known: bool, base: usize) = proof_kernel_replay_unsigned_unit_increment_base_with_work(nodes, node.left, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not unit.known
            proof_kernel_replay_unsigned_increment_has_strict_peer_with_work(nodes, children, unit.base, width, facts, work_used)

        def proof_kernel_replay_affine_unsigned_peer_safe_with_work(affine: ProofKernelReplayAffine, constraints: darray[ProofKernelReplayDifference]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], work_used: mutable usize&) -> bool:
            return false if not affine.known or affine.negative or affine.offset != 1 or affine.base == ""
            width: i64 = proof_kernel_replay_unsigned_marker_width_for_name_with_goal_work(nodes, children, facts, affine.base, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            for constraint in constraints |constraint, affine, width, nodes, children, facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if constraint.left != affine.base or constraint.right == "" or constraint.bound > -1
                return true if proof_kernel_replay_unsigned_marker_width_for_name_with_goal_work(nodes, children, facts, constraint.right, work_used) == width
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            false

        def proof_kernel_replay_collect_differences_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, bounds: darray[ProofKernelReplayBound]&, children: darray[usize]&, facts: darray[usize], constraints: mutable darray[ProofKernelReplayDifference]&, work_used: mutable usize&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not proof_kernel_replay_goal_search_charge(work_used)
            return if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth)
            return if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary" and node.operator == "not":
                return if node.left >= nodes.count
                inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                if inner.kind == "binary" and proof_kernel_replay_negation_supported(inner.operator):
                    comparison_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, node.left, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return if not comparison_admission.complete or comparison_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, inner.left, inner.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT):
                        return if proof_kernel_replay_is_order_operator(inner.operator) and (not proof_kernel_replay_denial_integer_term_with_work(nodes, children, inner.left, facts, work_used, 0) or not proof_kernel_replay_denial_integer_term_with_work(nodes, children, inner.right, facts, work_used, 0))
                        left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, inner.left, depth + 1, work_used)
                        right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, inner.right, depth + 1, work_used)
                        left_admissible: bool = proof_kernel_replay_affine_safe_with_work(left, bounds, work_used) or proof_kernel_replay_affine_peer_safe_from_facts_with_work(left, inner.left, nodes, children, facts, work_used)
                        right_admissible: bool = proof_kernel_replay_affine_safe_with_work(right, bounds, work_used) or proof_kernel_replay_affine_peer_safe_from_facts_with_work(right, inner.right, nodes, children, facts, work_used)
                        if left.known and right.known and left_admissible and right_admissible:
                            negated_distinct: bool = (inner.operator in {">", "<"}) and proof_kernel_replay_facts_state_disequality_with_work(nodes, children, facts, inner.left, inner.right, work_used)
                            return if inner.operator == ">" and not proof_kernel_replay_difference_push_with_goal_work(left, right, false, negated_distinct, constraints, work_used)
                            return if inner.operator == ">=" and not proof_kernel_replay_difference_push_with_goal_work(left, right, false, true, constraints, work_used)
                            return if inner.operator == "<" and not proof_kernel_replay_difference_push_with_goal_work(left, right, true, negated_distinct, constraints, work_used)
                            return if inner.operator == "<=" and not proof_kernel_replay_difference_push_with_goal_work(left, right, true, true, constraints, work_used)
                            if inner.operator == "!=":
                                return if not proof_kernel_replay_difference_push_with_goal_work(left, right, false, false, constraints, work_used)
                                return if not proof_kernel_replay_difference_push_with_goal_work(left, right, true, false, constraints, work_used)
                return
            if node.kind == "binary" and node.operator == "and":
                proof_kernel_replay_collect_differences_with_goal_work(nodes, node.left, bounds, children, facts, constraints, work_used, depth + 1)
                proof_kernel_replay_collect_differences_with_goal_work(nodes, node.right, bounds, children, facts, constraints, work_used, depth + 1)
                return
            return if node.kind != "binary" or node.operator != "==" and node.operator != "<" and node.operator != "<=" and node.operator != ">" and node.operator != ">="
            comparison_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return if not comparison_admission.complete or comparison_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return if proof_kernel_replay_guarded_difference_import_with_work(nodes, children, node.left, node.operator, node.right, facts, constraints, work_used)
            left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, node.left, depth + 1, work_used)
            right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, node.right, depth + 1, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left.known or not right.known
            left_admissible: bool = proof_kernel_replay_affine_safe_with_work(left, bounds, work_used) or proof_kernel_replay_affine_peer_safe_from_facts_with_work(left, node.left, nodes, children, facts, work_used)
            right_admissible: bool = proof_kernel_replay_affine_safe_with_work(right, bounds, work_used) or proof_kernel_replay_affine_peer_safe_from_facts_with_work(right, node.right, nodes, children, facts, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_admissible or not right_admissible
            distinct: bool = (node.operator in {"<=", ">="}) and proof_kernel_replay_facts_state_disequality_with_work(nodes, children, facts, node.left, node.right, work_used)
            return if node.operator == "<=" and not proof_kernel_replay_difference_push_with_goal_work(left, right, false, distinct, constraints, work_used)
            return if node.operator == "<" and not proof_kernel_replay_difference_push_with_goal_work(left, right, false, true, constraints, work_used)
            return if node.operator == ">=" and not proof_kernel_replay_difference_push_with_goal_work(left, right, true, distinct, constraints, work_used)
            return if node.operator == ">" and not proof_kernel_replay_difference_push_with_goal_work(left, right, true, true, constraints, work_used)
            if node.operator == "==":
                return if not proof_kernel_replay_difference_push_with_goal_work(left, right, false, false, constraints, work_used)
                return if not proof_kernel_replay_difference_push_with_goal_work(left, right, true, false, constraints, work_used)

        def proof_kernel_replay_difference_bound_at_vertex_with_work(bounds: darray[ProofKernelReplayBound]&, rows: darray[usize]&, found: darray[bool]&, vertex: usize, name: sview, work_used: mutable usize&) -> ProofKernelReplayBound:
            empty: ProofKernelReplayBound = ProofKernelReplayBound{name: name, term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0}
            if vertex >= rows.count or vertex >= found.count:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return empty
            return empty if not found[vertex]
            row: usize = rows[vertex]
            if row >= bounds.count or bounds[row].term_key or not proof_kernel_replay_equality_closure_charge_text_pair(work_used, bounds[row].name, name, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT):
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1 if work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return empty
            if bounds[row].name != name:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return empty
            bounds[row]

        def proof_kernel_replay_difference_add_lower_at_vertex_with_work(bounds: mutable darray[ProofKernelReplayBound]&, rows: mutable darray[usize]&, found: mutable darray[bool]&, vertex: usize, name: sview, value: i64, work_used: mutable usize&) -> bool:
            return false if vertex >= rows.count or vertex >= found.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if not found[vertex]:
                return false if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, name, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                row: usize = bounds.count
                bounds.push(ProofKernelReplayBound{name: name, term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: true, lower: value, has_upper: false, upper: 0})
                rows[vertex] <- row
                found[vertex] <- true
                return true
            row: usize = rows[vertex]
            return false if row >= bounds.count or bounds[row].term_key or not proof_kernel_replay_equality_closure_charge_text_pair(work_used, bounds[row].name, name, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if bounds[row].name != name:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            return true if bounds[row].has_lower and value <= bounds[row].lower
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            bounds[row].has_lower <- true
            bounds[row].lower <- value
            return true

        def proof_kernel_replay_difference_add_upper_at_vertex_with_work(bounds: mutable darray[ProofKernelReplayBound]&, rows: mutable darray[usize]&, found: mutable darray[bool]&, vertex: usize, name: sview, value: i64, work_used: mutable usize&) -> bool:
            return false if vertex >= rows.count or vertex >= found.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if not found[vertex]:
                return false if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, name, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                row: usize = bounds.count
                bounds.push(ProofKernelReplayBound{name: name, term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: true, upper: value})
                rows[vertex] <- row
                found[vertex] <- true
                return true
            row: usize = rows[vertex]
            return false if row >= bounds.count or bounds[row].term_key or not proof_kernel_replay_equality_closure_charge_text_pair(work_used, bounds[row].name, name, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if bounds[row].name != name:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            return true if bounds[row].has_upper and value >= bounds[row].upper
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            bounds[row].has_upper <- true
            bounds[row].upper <- value
            return true

        def proof_kernel_replay_difference_bound_closure_with_work(constraints: darray[ProofKernelReplayDifference]&, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if constraints.count == 0
            vertex_index_result: (complete: bool, index: ProofKernelReplayEqualityVertexIndex) = proof_kernel_replay_equality_vertex_index_build(constraints.count, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if not vertex_index_result.complete
            vertex_index: mutable ProofKernelReplayEqualityVertexIndex = vertex_index_result.index
            names: mutable darray[sview] = []
            left_vertices: mutable darray[usize] = []
            right_vertices: mutable darray[usize] = []
            for constraint in constraints |constraint, vertex_index, names, left_vertices, right_vertices, work_used|:
                if constraint.left == "" or constraint.right == "":
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    left_vertices.push(names.count)
                    right_vertices.push(names.count)
                else:
                    left_vertex: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, constraint.left, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if not left_vertex.complete
                    right_vertex: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, constraint.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if not right_vertex.complete or not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                    left_vertices.push(left_vertex.row)
                    right_vertices.push(right_vertex.row)
            bound_rows: mutable darray[usize] = []
            bound_found: mutable darray[bool] = []
            for vertex in 0..<names.count |vertex, names, bound_rows, bound_found, work_used|:
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                bound_rows.push(0)
                bound_found.push(false)
            for row in 0..<bounds.count |row, bounds, names, vertex_index, bound_rows, bound_found, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if bounds[row].term_key or bounds[row].name == ""
                vertex: (complete: bool, found: bool, row: usize) = proof_kernel_replay_equality_vertex_index_find(vertex_index, names, bounds[row].name, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if not vertex.complete
                if vertex.found and not bound_found[vertex.row]:
                    bound_rows[vertex.row] <- row
                    bound_found[vertex.row] <- true
            for round in 0..<PROOF_KERNEL_REPLAY_BOUND_PROPAGATION_ROUND_LIMIT |round, constraints, bounds, left_vertices, right_vertices, names, bound_rows, bound_found, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                changed: mutable bool = false
                for constraint_index in 0..<constraints.count |constraint_index, constraints, bounds, left_vertices, right_vertices, names, bound_rows, bound_found, changed, work_used|:
                    return false if constraint_index >= left_vertices.count or constraint_index >= right_vertices.count or not proof_kernel_replay_goal_search_charge(work_used)
                    constraint: ProofKernelReplayDifference = constraints[constraint_index]
                    continue if constraint.left == "" or constraint.right == ""
                    left_vertex: usize = left_vertices[constraint_index]
                    right_vertex: usize = right_vertices[constraint_index]
                    right_bound: ProofKernelReplayBound = proof_kernel_replay_difference_bound_at_vertex_with_work(bounds, bound_rows, bound_found, right_vertex, constraint.right, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_vertex >= names.count
                    if right_bound.has_upper:
                        derived_upper: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_bound.upper, constraint.bound)
                        if derived_upper.known:
                            prior: ProofKernelReplayBound = proof_kernel_replay_difference_bound_at_vertex_with_work(bounds, bound_rows, bound_found, left_vertex, constraint.left, work_used)
                            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_vertex >= names.count
                            changed <- true if not prior.has_upper or derived_upper.value < prior.upper
                            return false if not proof_kernel_replay_difference_add_upper_at_vertex_with_work(bounds, &bound_rows, &bound_found, left_vertex, constraint.left, derived_upper.value, work_used)
                    left_bound: ProofKernelReplayBound = proof_kernel_replay_difference_bound_at_vertex_with_work(bounds, bound_rows, bound_found, left_vertex, constraint.left, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_vertex >= names.count
                    if left_bound.has_lower:
                        derived_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_bound.lower, constraint.bound)
                        if derived_lower.known:
                            prior: ProofKernelReplayBound = proof_kernel_replay_difference_bound_at_vertex_with_work(bounds, bound_rows, bound_found, right_vertex, constraint.right, work_used)
                            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_vertex >= names.count
                            changed <- true if not prior.has_lower or derived_lower.value > prior.lower
                            return false if not proof_kernel_replay_difference_add_lower_at_vertex_with_work(bounds, &bound_rows, &bound_found, right_vertex, constraint.right, derived_lower.value, work_used)
                break if not changed
            true

        def proof_kernel_replay_difference_node_index_with_work(names: darray[sview]&, name: sview, work_used: mutable usize&) -> usize:
            for index in 0..<names.count |index, names, name, work_used|:
                return names.count if not proof_kernel_replay_goal_search_charge(work_used)
                matches: bool = proof_kernel_replay_goal_search_text_equal(names[index], name, work_used)
                return names.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return index if matches
            names.count

        def proof_kernel_replay_difference_query_with_work(names: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, left: sview, right: sview, bound: i64, work_used: mutable usize&) -> bool:
            left_index: usize = proof_kernel_replay_difference_node_index_with_work(names, left, work_used)
            right_index: usize = proof_kernel_replay_difference_node_index_with_work(names, right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_index >= names.count or right_index >= names.count
            slot: usize = left_index * names.count + right_index
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            known[slot] and matrix[slot] <= bound

        def proof_kernel_replay_difference_affine_query_with_work(names: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, left: ProofKernelReplayAffine, right: ProofKernelReplayAffine, bound: i64, work_used: mutable usize&) -> bool:
            if left.base == "" and right.base == "":
                return proof_kernel_replay_difference_query_with_work(names, matrix, known, "", "", bound, work_used)
            if left.base == "":
                return proof_kernel_replay_difference_query_with_work(names, matrix, known, right.base, "", bound, work_used) if right.negative
                return proof_kernel_replay_difference_query_with_work(names, matrix, known, "", right.base, bound, work_used)
            if right.base == "":
                return proof_kernel_replay_difference_query_with_work(names, matrix, known, "", left.base, bound, work_used) if left.negative
                return proof_kernel_replay_difference_query_with_work(names, matrix, known, left.base, "", bound, work_used)
            return false if left.negative != right.negative
            return proof_kernel_replay_difference_query_with_work(names, matrix, known, right.base, left.base, bound, work_used) if left.negative
            proof_kernel_replay_difference_query_with_work(names, matrix, known, left.base, right.base, bound, work_used)

        def proof_kernel_replay_difference_comparison_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize], work_used: mutable usize&) -> bool:
            left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, left_root, 0, work_used)
            right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, right_root, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proof_kernel_replay_difference_affine_comparison_with_work(nodes, children, left, operator, right, facts, false, work_used)

        def proof_kernel_replay_difference_affine_comparison_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: ProofKernelReplayAffine, operator: sview, right: ProofKernelReplayAffine, facts: darray[usize], certified: bool, work_used: mutable usize&) -> bool:
            return false if:
                operator != "==" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
                not left.known or not right.known or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, &bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if:
                not proof_kernel_replay_close_equalities_with_work(nodes, children, facts, &bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                not certified and left.base == "" and right.base == ""
            constraints: mutable darray[ProofKernelReplayDifference] = []
            for fact in facts |fact, nodes, children, facts, bounds, constraints, work_used|:
                proof_kernel_replay_collect_differences_with_goal_work(nodes, fact, bounds, children, facts, &constraints, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                break if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
            return false if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS or not proof_kernel_replay_difference_bound_closure_with_work(constraints, &bounds, work_used)
            proof_kernel_replay_difference_prepared_affine_comparison_with_work(nodes, children, left, operator, right, facts, certified, &bounds, &constraints, work_used)


        # Entry point for callers that already paid to build and close bounds and constraints.
        # This keeps arithmetic refutation from repeating the same scans for every candidate.
        def proof_kernel_replay_difference_comparison_from_prepared_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, constraints: mutable darray[ProofKernelReplayDifference]&, work_used: mutable usize&) -> bool:
            left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, left_root, 0, work_used)
            right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, right_root, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proof_kernel_replay_difference_prepared_affine_comparison_with_work(nodes, children, left, operator, right, facts, false, bounds, constraints, work_used)

        def proof_kernel_replay_difference_prepared_affine_comparison_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: ProofKernelReplayAffine, operator: sview, right: ProofKernelReplayAffine, facts: darray[usize], certified: bool, bounds: mutable darray[ProofKernelReplayBound]&, constraints: mutable darray[ProofKernelReplayDifference]&, work_used: mutable usize&) -> bool:
            return false if:
                operator != "==" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
                not left.known or not right.known or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not certified and left.base == "" and right.base == ""
                constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
            left_safe: bool = certified or proof_kernel_replay_affine_safe_with_work(left, bounds, work_used) or proof_kernel_replay_affine_unsigned_peer_safe_with_work(left, constraints, nodes, children, facts, work_used)
            right_safe: bool = certified or proof_kernel_replay_affine_safe_with_work(right, bounds, work_used) or proof_kernel_replay_affine_unsigned_peer_safe_with_work(right, constraints, nodes, children, facts, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_safe or not right_safe
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if left.base != "":
                bound: ProofKernelReplayBound = proof_kernel_replay_bound_for_with_work(bounds, left.base, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if bound.has_upper:
                    return false if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS or not proof_kernel_replay_goal_search_charge(work_used)
                    constraints.push(ProofKernelReplayDifference{left: left.base, right: "", bound: bound.upper})
                if bound.has_lower:
                    negated: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, bound.lower)
                    if negated.known:
                        return false if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS or not proof_kernel_replay_goal_search_charge(work_used)
                        constraints.push(ProofKernelReplayDifference{left: "", right: left.base, bound: negated.value})
            if right.base != "":
                bound: ProofKernelReplayBound = proof_kernel_replay_bound_for_with_work(bounds, right.base, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if bound.has_upper:
                    return false if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS or not proof_kernel_replay_goal_search_charge(work_used)
                    constraints.push(ProofKernelReplayDifference{left: right.base, right: "", bound: bound.upper})
                if bound.has_lower:
                    negated: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, bound.lower)
                    if negated.known:
                        return false if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS or not proof_kernel_replay_goal_search_charge(work_used)
                        constraints.push(ProofKernelReplayDifference{left: "", right: right.base, bound: negated.value})
            names: mutable darray[sview] = [""]
            for constraint in constraints |constraint, names, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                if constraint.left != "":
                    left_index: usize = proof_kernel_replay_difference_node_index_with_work(names, constraint.left, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if left_index == names.count:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        names.push(constraint.left)
                if constraint.right != "":
                    right_index: usize = proof_kernel_replay_difference_node_index_with_work(names, constraint.right, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if right_index == names.count:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        names.push(constraint.right)
            return false if names.count > ElisaProofKernelCore::PROOF_DIFFERENCE_NODE_LIMIT
            matrix: mutable darray[i64] = []
            known: mutable darray[bool] = []
            matrix_count: usize = names.count * names.count
            for index in 0..<matrix_count |index, matrix, known, work_used|:
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                matrix.push(0)
                known.push(false)
            for index in 0..<names.count |index, names, matrix, known, work_used|:
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                slot: usize = index * names.count + index
                matrix[slot] <- 0
                known[slot] <- true
            for constraint in constraints |constraint, names, matrix, known, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                left_index: usize = proof_kernel_replay_difference_node_index_with_work(names, constraint.left, work_used)
                right_index: usize = proof_kernel_replay_difference_node_index_with_work(names, constraint.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_index >= names.count or right_index >= names.count
                slot: usize = left_index * names.count + right_index
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                matrix[slot] <- constraint.bound if not known[slot] or constraint.bound < matrix[slot]
                known[slot] <- true
            for pivot in 0..<names.count |pivot, names, matrix, known, work_used|:
                for source in 0..<names.count |source, pivot, names, matrix, known, work_used|:
                    first_slot: usize = source * names.count + pivot
                    continue if not known[first_slot]
                    for target in 0..<names.count |target, source, pivot, names, matrix, known, work_used|:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        second_slot: usize = pivot * names.count + target
                        continue if not known[second_slot]
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(matrix[first_slot], matrix[second_slot])
                        continue if not combined.known
                        result_slot: usize = source * names.count + target
                        return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                        matrix[result_slot] <- combined.value if not known[result_slot] or combined.value < matrix[result_slot]
                        known[result_slot] <- true
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if operator == "==":
                forward: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right.offset, left.offset)
                reverse: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left.offset, right.offset)
                return false if not forward.known or not reverse.known
                return proof_kernel_replay_difference_affine_query_with_work(names, matrix, known, left, right, forward.value, work_used) and proof_kernel_replay_difference_affine_query_with_work(names, matrix, known, right, left, reverse.value, work_used)
            if operator in {"<=", "<"}:
                target: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(right.offset, left.offset)
                return false if not target.known
                if operator == "<":
                    decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(target.value, 1)
                    return false if not decremented.known
                    target <- decremented
                return proof_kernel_replay_difference_affine_query_with_work(names, matrix, known, left, right, target.value, work_used)
            target: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(left.offset, right.offset)
            return false if not target.known
            if operator == ">":
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(target.value, 1)
                return false if not decremented.known
                target <- decremented
            proof_kernel_replay_difference_affine_query_with_work(names, matrix, known, right, left, target.value, work_used)
