extend ElisaProofKernelReplay:
    private:
        # A public checked fast path may skip repeated per-root graph walks only after it
        # independently admits the complete immutable arena and every supplied root in the
        # same call. No caller-supplied `already_validated` flag is accepted at this boundary.
        def proof_kernel_replay_checked_arena_inputs_valid[@r](nodes: darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
            return false if goal_root >= nodes.count or facts.count > PROOF_KERNEL_REPLAY_WORK_BUDGET
            for fact in facts:
                return false if fact >= nodes.count
            return proof_kernel_replay_arena_all_valid(nodes, children)

    public:
            def proof_kernel_replay_resource_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                # Full resource summaries are function-boundary certificates. They must not
                # leave a lexical region open; only explicit external region parameters may
                # survive the boundary.
                return proof_kernel_replay_resource_report_impl(nodes, children, facts, goal_root, true, false)

            # Prefix replay is intentionally separate from report admission. It is used only by
            # callers that incrementally assemble a resource trace before its final close/result
            # transitions exist. Such a prefix may have local regions open, but it is never a
            # successful proof certificate on its own.
            def proof_kernel_replay_resource_prefix[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_resource_report_impl(nodes, children, facts, goal_root, false, false)

            def proof_kernel_replay_structural_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_structural_report_impl(nodes, children, facts, goal_root, false)

            # Complete-arena-checked entry points preserve the report adapter's bounded fast
            # replay for large resource traces. Unlike the former `_after_arena` API, each one
            # validates the whole externally supplied arena and all fact/goal roots atomically
            # before it asks a private implementation to skip its repeated per-root walk.
            def proof_kernel_replay_resource_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_resource_report_impl(nodes, children, facts, goal_root, true, true)

            def proof_kernel_replay_structural_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if not proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_structural_report_impl(nodes, children, facts, goal_root, true)

            def proof_kernel_replay_effect_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_effect_goal(nodes, children, goal_root)

            def proof_kernel_replay_goal_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if not proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_goal_report_impl(nodes, children, facts, goal_root, true)

            # This is the source-neutral logical API for callers that possess a checked type
            # environment. Formation is checked independently of hypotheses before logical
            # replay. The environment carries declaration signatures, never proof facts.
            def proof_kernel_replay_proposition_formation_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize) -> bool:
                validation_workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
                return proof_kernel_replay_proposition_formation_report_with_workspace(nodes, children, environment, facts, goal_root, &validation_workspace)

            # Reuse caller-owned validation capacity across a batch of source propositions. The
            # supplied workspace is scratch only and is fully reset by the arena validator before
            # every use, so it cannot carry an admission result or trusted bit across calls.
            def proof_kernel_replay_proposition_formation_report_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize, validation_workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
                ensure result => goal_root < nodes.count
                return false if goal_root >= nodes.count
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, validation_workspace)
                return proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, facts, goal_root)

            # Typing scratch retains capacity only: complete binding validation and index
            # reconstruction still occur for every proposition admitted through this path.
            def proof_kernel_replay_proposition_formation_report_with_workspaces[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize, validation_workspace: mutable ProofKernelReplayValidationWorkspace&, typing_workspace: mutable ProofKernelReplayTypingWorkspace&) -> bool:
                ensure result => goal_root < nodes.count
                return false if goal_root >= nodes.count
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, validation_workspace)
                return proof_kernel_replay_typed_proposition_state_valid_with_workspace(nodes, children, environment, facts, goal_root, typing_workspace)

            def proof_kernel_replay_goal_report_typed[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize) -> bool:
                formation_admitted: bool = proof_kernel_replay_proposition_formation_report(nodes, children, environment, facts, goal_root)
                return false if not formation_admitted
                replay_admitted: bool = proof_kernel_replay_goal_report_impl(nodes, children, facts, goal_root, true)
                return replay_admitted

            # Public serialization boundary for callers that receive a source-neutral arena
            # from another process. Admission is deliberately separate from logical replay:
            # malformed roots, child slices, out-of-range edges, and cycles must be rejected
            # before any rule can inspect a term.
            def proof_kernel_replay_arena_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)

            # Batch admission for a report-owned arena. This validates every node once, including
            # nodes not reachable from the first certificate root, so later certificate replay may
            # reuse the admission without allocating a whole-arena validator per fact trace.
            def proof_kernel_replay_arena_all_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r) -> bool:
                return proof_kernel_replay_arena_all_valid(nodes, children)

            # Validate declaration signatures independently from any proposition or arena. This
            # lets source adapters fail closed at the exact environment boundary and gives
            # callers a small, explicit preflight before building a typed proof request.
            def proof_kernel_replay_type_environment_report(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> bool:
                return proof_kernel_replay_type_environment_valid(environment)

            def proof_kernel_replay_type_environment_invalid_binding_name_report(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> sview:
                return proof_kernel_replay_type_environment_invalid_binding_name(environment)

            # This is the only structural comparison operation exposed to the report adapter.
            # Keeping the implementation private makes the module boundary explicit: callers
            # can ask the kernel to compare terms, but cannot depend on its internal state types.
            # Equality is itself a serialization boundary: the recursive helper intentionally
            # validates every visited node while walking, so malformed payloads, child slices,
            # and cycles fail closed without repeatedly allocating a complete-arena worklist.
            def proof_kernel_replay_expr_equal_public(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize) -> bool:
                requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                return proof_kernel_replay_expr_equal(nodes, children, left_root, right_root, depth)

            # Ground congruence closure over the source-neutral term language, exposed on its
            # own. The AST-level producer consults exactly the rule replay will re-derive rather
            # than maintaining a second equality engine that could drift away from this one, and
            # adversarial harnesses can target the rule without the surrounding tiers.
            def proof_kernel_replay_congruence_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                exhausted: mutable bool = false
                return proof_kernel_replay_congruence_report_status(nodes, children, facts, goal_root, &exhausted)

            # The same rule with its budget status. `exhausted` is advisory: it is set when the
            # term or round budget cut the closure short, so a refusal may be "undecided" rather
            # than "no rule applies". It never changes the verdict.
            def proof_kernel_replay_congruence_report_status[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, exhausted: mutable bool&) -> bool:
                return false if not proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)
                return false if not proof_kernel_replay_proposition_state_valid(nodes, facts, goal_root)
                for fact in facts |nodes, children, facts|:
                    return false if not proof_kernel_replay_unsigned_goal_safe(nodes, children, facts, fact)
                return false if not proof_kernel_replay_unsigned_goal_safe(nodes, children, facts, goal_root)
                return proof_kernel_replay_congruence_goal(nodes, children, facts, goal_root, exhausted)

            # Declared effect containment. The claim is about declared rows: every resolved
            # callee's `can[...]` row is contained in the caller's. It says nothing about effects
            # a body performs without a call.
            def proof_kernel_replay_effect_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if not proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)
                return false if facts.count != 0
                return proof_kernel_replay_effect_goal(nodes, children, goal_root)

            # Abstract propositional-calculus entry point. Opaque node forms (including calls and
            # projections) are atoms of this source-neutral logic; this API makes no Elisa source
            # typing claim. A source adapter must validate its declarations through the typed
            # entry point above before binding a result to an Elisa obligation.
            def proof_kernel_replay_goal_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_goal_report_impl(nodes, children, facts, goal_root, false)

            def proof_kernel_replay_tactic_step[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview) -> bool:
                return proof_kernel_replay_tactic_step_impl(nodes, children, action, accepted, before_solved, after_solved, before_facts, before_goal, after_facts, after_goal, argument, has_argument, secondary, has_secondary, argument_index, has_argument_index, detail)

            def proof_kernel_replay_tactic_step_typed[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview) -> bool:
                return false if not proof_kernel_replay_arena_valid(nodes, children, before_facts, before_goal)
                return false if not proof_kernel_replay_arena_valid(nodes, children, after_facts, after_goal)
                return false if has_argument and not proof_kernel_replay_arena_valid(nodes, children, [], argument)
                return false if has_secondary and not proof_kernel_replay_arena_valid(nodes, children, [], secondary)
                return false if not proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, before_facts, before_goal)
                return false if not proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, after_facts, after_goal)
                typing_work_used: mutable usize = 0
                typing_index: (known: bool, index: ProofKernelReplayTypingIndex) = proof_kernel_replay_build_typing_index(environment, &typing_work_used)
                return false if not typing_index.known
                if has_argument:
                    argument_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index.index, argument, 0, &typing_work_used)
                    return false if action == "have" and not argument_sort.known
                    return false if action != "have" and not argument_sort.known
                    return false if action == "have" and argument_sort.family != "boolean" and argument_sort.family != "proposition"
                if has_secondary:
                    secondary_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index.index, secondary, 0, &typing_work_used)
                    return false if not secondary_sort.known
                    if action == "rewrite":
                        argument_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index.index, argument, 0, &typing_work_used)
                        return false if not proof_kernel_replay_sort_equal(argument_sort, secondary_sort)
                        # Rewriting is a Leibniz rule. Named/aggregate values may use Elisa
                        # protocol equality, which has no substitutivity law, so the typed kernel
                        # admits only language-owned primitive equality sorts here.
                        return false if argument_sort.family != "integer" and argument_sort.family != "floating" and argument_sort.family != "character" and argument_sort.family != "boolean" and argument_sort.family != "string"
                return false if typing_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                return proof_kernel_replay_tactic_step_impl(nodes, children, action, accepted, before_solved, after_solved, before_facts, before_goal, after_facts, after_goal, argument, has_argument, secondary, has_secondary, argument_index, has_argument_index, detail)

            def proof_kernel_replay_tactic_branch[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, parent_facts: darray[usize], parent_goal: usize, left_facts: darray[usize], left_goal: usize, right_facts: darray[usize], right_goal: usize) -> bool:
                return proof_kernel_replay_tactic_branch_report(nodes, children, action, parent_facts, parent_goal, left_facts, left_goal, right_facts, right_goal)

            def proof_kernel_replay_tactic_branch_typed[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, action: sview, parent_facts: darray[usize], parent_goal: usize, left_facts: darray[usize], left_goal: usize, right_facts: darray[usize], right_goal: usize) -> bool:
                return false if not proof_kernel_replay_arena_valid(nodes, children, parent_facts, parent_goal)
                return false if not proof_kernel_replay_arena_valid(nodes, children, left_facts, left_goal)
                return false if not proof_kernel_replay_arena_valid(nodes, children, right_facts, right_goal)
                return false if not proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, parent_facts, parent_goal)
                return false if not proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, left_facts, left_goal)
                return false if not proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, right_facts, right_goal)
                return proof_kernel_replay_tactic_branch_report(nodes, children, action, parent_facts, parent_goal, left_facts, left_goal, right_facts, right_goal)

            # A checked-index certificate proves the memory-safety boundary supplied by Elisa's
            # `get collection[index] else fallback` operator. It is separate from arithmetic
            # goal replay: the selected element remains opaque, while replay validates only the
            # guarded load/fallback shape.
            def proof_kernel_replay_checked_index_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_checked_index_report_impl(nodes, children, facts, goal_root, false)

            def proof_kernel_replay_checked_index_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_checked_index_report_impl(nodes, children, facts, goal_root, true)

            # A checked-get certificate proves the memory-safety boundary of
            # `get collection[index] else <control recovery>`. The recovery's termination and
            # state isolation are checked separately by the source-level control-flow pass.
            def proof_kernel_replay_checked_get_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_checked_get_report_impl(nodes, children, facts, goal_root, false)

            def proof_kernel_replay_checked_get_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_checked_get_report_impl(nodes, children, facts, goal_root, true)

            def proof_kernel_replay_quantifier_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, kind: sview, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_quantifier_report_impl(nodes, children, kind, facts, goal_root, false)

            def proof_kernel_replay_quantifier_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, kind: sview, facts: darray[usize], goal_root: usize) -> bool:
                return false if not proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_quantifier_report_impl(nodes, children, kind, facts, goal_root, true)
