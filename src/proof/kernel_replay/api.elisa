extend ElisaProofKernelReplay:
    private:
        # Arena admission has its own conservative ceiling for general replay. When a report
        # adapter already carries a goal meter, debit the arena validator's measured work to that
        # same counter so repeated congruence queries cannot restart a second graph-scan budget.
        def proof_kernel_replay_arena_valid_with_goal_work_and_workspace(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&, exhausted: mutable bool&, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            remaining: usize = PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - work_used
            arena_limit: usize = remaining if remaining < PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET else PROOF_KERNEL_REPLAY_ARENA_WORK_BUDGET
            valid: bool = proof_kernel_replay_arena_valid_with_workspace_limit(nodes, children, facts, goal_root, workspace, arena_limit, false)
            arena_work: usize = workspace.work_used
            if not proof_kernel_replay_goal_search_charge_amount(work_used, arena_work):
                exhausted <- true
                return false
            if not valid and arena_work >= arena_limit:
                exhausted <- true
                return false
            return valid

        # A public checked fast path may skip repeated per-root graph walks only after it
        # independently admits the complete immutable arena and every supplied root in the
        # same call. No caller-supplied `already_validated` flag is accepted at this boundary.
        def proof_kernel_replay_checked_arena_inputs_valid[@r](nodes: darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool can[Global.Read, Global.Write]:
            return false if goal_root >= nodes.count or facts.count > PROOF_KERNEL_REPLAY_WORK_BUDGET
            for fact in facts:
                return false if fact >= nodes.count
            return (proof_kernel_replay_arena_all_valid(nodes, children) can Global{Read,Write})

    public:
            # Validates and snapshots the declaration-wide typing context used by the source fast
            # path. The resulting snapshot and index remain private inside the workspace.
            def proof_kernel_replay_typing_workspace_prepare_globals(global_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], typing_workspace: mutable ProofKernelReplayTypingWorkspace&) -> bool:
                return proof_kernel_replay_typing_workspace_prepare_globals_internal(global_bindings, typing_workspace)

            def proof_kernel_replay_resource_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool can[Global.Read, Global.Write]:
                # Full resource summaries are function-boundary certificates. They must not
                # leave a lexical region open; only explicit external region parameters may
                # survive the boundary.
                return (proof_kernel_replay_resource_report_impl(nodes, children, facts, goal_root, true, false) can Global{Read,Write})

            # Prefix replay is intentionally separate from report admission. It is used only by
            # callers that incrementally assemble a resource trace before its final close/result
            # transitions exist. Such a prefix may have local regions open, but it is never a
            # successful proof certificate on its own.
            def proof_kernel_replay_resource_prefix[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return (proof_kernel_replay_resource_report_impl(nodes, children, facts, goal_root, false, false) can Global{Read,Write})

            # Source-neutral structural witness validation checks only that the serialized rank
            # relations are well-shaped. It is not termination proof admission: callers must
            # bind the owner and recursive call sites to authenticated source before relying on
            # this result.
            def proof_kernel_validate_structural_witness_shape[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_structural_report_impl(nodes, children, facts, goal_root, false)

            # Complete-arena-checked entry points preserve the report adapter's bounded fast
            # replay for large resource traces. Unlike the former `_after_arena` API, each one
            # validates the whole externally supplied arena and all fact/goal roots atomically
            # before it asks a private implementation to skip its repeated per-root walk.
            def proof_kernel_replay_resource_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
                return (proof_kernel_replay_resource_report_impl(nodes, children, facts, goal_root, true, true) can Global{Read,Write})

            def proof_kernel_validate_structural_witness_shape_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
                return proof_kernel_replay_structural_report_impl(nodes, children, facts, goal_root, true)

            def proof_kernel_replay_effect_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
                return proof_kernel_replay_effect_goal(nodes, children, goal_root)

            # Frame policies are source-neutral structural certificates, never
            # logical assumptions. Revalidate the complete arena and refuse facts.
            def proof_kernel_replay_frame_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
                return ElisaProofKernelFramePolicy::policy_replays(nodes, children, goal_root)

            def proof_kernel_replay_goal_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
                return (proof_kernel_replay_goal_report_impl(nodes, children, facts, goal_root, true) can Global{Read,Write})

            # Reusable-workspace variants revalidate every supplied root on every call. Arena
            # arrays retain scratch capacity; source-scan and logical-goal counters accumulate
            # for one certificate batch. Construct a fresh workspace for each independent batch.
            def proof_kernel_replay_arena_report_with_workspace[@r](nodes: darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
                return proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, workspace)

            def proof_kernel_replay_resource_report_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool can[Global.Read, Global.Write]:
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, workspace)
                return (proof_kernel_replay_resource_report_impl(nodes, children, facts, goal_root, true, true) can Global{Read,Write})

            def proof_kernel_validate_structural_witness_shape_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, workspace)
                return proof_kernel_replay_structural_report_impl(nodes, children, facts, goal_root, true)

            def proof_kernel_replay_effect_report_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, workspace)
                return proof_kernel_replay_effect_report_impl(nodes, children, facts, goal_root, true)

            def proof_kernel_replay_goal_report_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool can[Global.Read, Global.Write]:
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, workspace)
                return (proof_kernel_replay_goal_report_impl_with_work(nodes, children, facts, goal_root, true, &workspace.kernel_goal_work_used) can Global{Read,Write})

            def proof_kernel_replay_checked_index_report_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, workspace)
                return proof_kernel_replay_checked_index_report_impl(nodes, children, facts, goal_root, true)

            def proof_kernel_replay_checked_get_report_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, workspace)
                return proof_kernel_replay_checked_get_report_impl(nodes, children, facts, goal_root, true)

            def proof_kernel_replay_quantifier_report_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, kind: sview, facts: darray[usize], goal_root: usize, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool can[Global.Read, Global.Write]:
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, workspace)
                return (proof_kernel_replay_quantifier_report_impl_with_work(nodes, children, kind, facts, goal_root, true, &workspace.kernel_goal_work_used) can Global{Read,Write})

            # This is the source-neutral logical API for callers that possess an authenticated
            # typing context. Formation is checked independently of hypotheses before logical
            # replay. The kernel checks context structure, not its provenance: a caller using a
            # result as a source-level claim must separately bind these rows to checked source.
            # The environment carries declaration signatures, never proof facts.
            def proof_kernel_replay_proposition_formation_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize) -> bool:
                validation_workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
                return proof_kernel_replay_proposition_formation_report_with_workspace(nodes, children, environment, facts, goal_root, &validation_workspace)

            # Reuse caller-owned validation capacity across a batch of source propositions. The
            # supplied workspace is scratch only and is fully reset by the arena validator before
            # every use, so it cannot carry an admission result or trusted bit across calls.
            def proof_kernel_replay_proposition_formation_report_with_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize, validation_workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
                ensure result => goal_root < nodes.count
                return false if:
                    goal_root >= nodes.count
                    not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, validation_workspace)
                return proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, facts, goal_root)

            # Typing scratch retains capacity only: complete binding validation and index
            # reconstruction still occur for every proposition admitted through this path.
            def proof_kernel_replay_proposition_formation_report_with_workspaces[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize, validation_workspace: mutable ProofKernelReplayValidationWorkspace&, typing_workspace: mutable ProofKernelReplayTypingWorkspace&) -> bool:
                ensure result => goal_root < nodes.count
                return false if:
                    goal_root >= nodes.count
                    not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, validation_workspace)
                return proof_kernel_replay_typed_proposition_state_valid_with_workspace(nodes, children, environment, facts, goal_root, typing_workspace)

            # Source checking prepares this workspace once from a private copy of declaration
            # globals. Each proposition still validates all expression-local bindings, applies
            # its own environment-by-term admission bound, and uses the already validated snapshot.
            # Generic replay entry points above continue to validate globals afresh.
            def proof_kernel_replay_proposition_formation_report_with_cached_globals[@r](nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, local_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], facts: darray[usize], goal_root: usize, validation_workspace: mutable ProofKernelReplayValidationWorkspace&, typing_workspace: mutable ProofKernelReplayTypingWorkspace& @r) -> bool:
                typing_work_used: mutable usize = 0
                return proof_kernel_replay_proposition_formation_report_with_cached_globals_and_work(nodes, children, local_bindings, facts, goal_root, validation_workspace, typing_workspace, &typing_work_used)

            # Batch/source adapter variant: the caller owns a cumulative counter across related
            # propositions. Work is measured by replay itself; this parameter affects only a
            # conservative refusal budget, never the proposition's logical validity.
            def proof_kernel_replay_proposition_formation_report_with_cached_globals_and_work[@r](nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, local_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], facts: darray[usize], goal_root: usize, validation_workspace: mutable ProofKernelReplayValidationWorkspace&, typing_workspace: mutable ProofKernelReplayTypingWorkspace& @r, work_used: mutable usize&) -> bool:
                ensure result => goal_root < nodes.count
                return false if:
                    goal_root >= nodes.count
                    not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, validation_workspace)
                return proof_kernel_replay_typed_proposition_state_valid_with_cached_globals(nodes, children, local_bindings, facts, goal_root, typing_workspace, work_used)

            def proof_kernel_replay_goal_report_typed[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize) -> bool can[Global.Read, Global.Write]:
                return false if goal_root >= nodes.count
                validation_workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
                return false if not proof_kernel_replay_arena_valid_with_workspace(nodes, children, facts, goal_root, &validation_workspace)
                type_work_used: mutable usize = 0
                typing_index: (known: bool, index: ProofKernelReplayTypingIndex) = proof_kernel_replay_build_typing_index(environment, &type_work_used)
                return false if not typing_index.known or type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                return false if not proof_kernel_replay_typed_proposition_state_valid_with_index(nodes, children, environment, typing_index.index, facts, goal_root, &type_work_used)
                # Only this typed entry point can establish the built-in receiver selector
                # required for indexed-read congruence. The source-neutral goal API below keeps
                # Index nodes opaque. The environment's provenance is the caller's responsibility;
                # source-level callers must bind it to checked source before using this result.
                goal_work_used: mutable usize = 0
                indexed_read_proven: bool = proof_kernel_replay_typed_index_read_equality_with_work(nodes, children, environment, typing_index.index, facts, goal_root, &type_work_used, &goal_work_used)
                return true if indexed_read_proven and type_work_used <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET and goal_work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (proof_kernel_replay_goal_report_impl(nodes, children, facts, goal_root, true) can Global{Read,Write})

            # Batch adapter for the typed indexed-read rule. Callers share both work meters and
            # validation scratch across goals; no caller-supplied arena-valid bit crosses this
            # boundary. The source-level caller remains responsible for authenticating the
            # environment and premise roots before using a successful result as proof evidence.
            def proof_kernel_replay_typed_index_read_report_with_workspaces[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize, validation_workspace: mutable ProofKernelReplayValidationWorkspace&, type_work_used: mutable usize&, goal_work_used: mutable usize&) -> bool can[Global.Read, Global.Write]:
                ensure result => goal_root < nodes.count
                return false if:
                    goal_root >= nodes.count
                    type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                    goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                exhausted: mutable bool = false
                return false if not proof_kernel_replay_arena_valid_with_goal_work_and_workspace(nodes, children, facts, goal_root, &goal_work_used, &exhausted, &validation_workspace)
                typing_index: (known: bool, index: ProofKernelReplayTypingIndex) = proof_kernel_replay_build_typing_index(environment, &type_work_used)
                return false if not typing_index.known or type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                return false if not proof_kernel_replay_typed_proposition_state_valid_with_index(nodes, children, environment, typing_index.index, facts, goal_root, &type_work_used)
                return false if type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                proof_kernel_replay_typed_index_read_equality_with_work(nodes, children, environment, typing_index.index, facts, goal_root, &type_work_used, &goal_work_used)

            # Public serialization boundary for callers that receive a source-neutral arena
            # from another process. Admission is deliberately separate from logical replay:
            # malformed roots, child slices, out-of-range edges, and cycles must be rejected
            # before any rule can inspect a term.
            def proof_kernel_replay_arena_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)

            # Batch admission for a report-owned arena. This validates every node once, including
            # nodes not reachable from the first certificate root, so later certificate replay may
            # reuse the admission without allocating a whole-arena validator per fact trace.
            def proof_kernel_replay_arena_all_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r) -> bool:
                return (proof_kernel_replay_arena_all_valid(nodes, children) can Global{Read,Write})

            # Validate declaration signature structure independently from any proposition or
            # arena. This is not a source-provenance check: callers must authenticate the context
            # separately before relying on typed replay as evidence about a source program.
            def proof_kernel_replay_type_environment_report(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> bool:
                return proof_kernel_replay_type_environment_valid(environment)

            def proof_kernel_replay_type_environment_invalid_binding_name_report(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> sview:
                return proof_kernel_replay_type_environment_invalid_binding_name(environment)

            # This is the only structural comparison operation exposed to the report adapter.
            # Keeping the implementation private makes the module boundary explicit: callers
            # can ask the kernel to compare terms, but cannot depend on its internal state types.
            # Equality is itself a serialization boundary: it validates each visited node,
            # reserves text bytes before comparison, and fails closed after 4,000,000 work
            # units or 65,536 pending node pairs. Malformed payloads, child slices, and cycles
            # fail closed without allocating a worklist proportional to the complete arena.
            def proof_kernel_replay_expr_equal_public(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize) -> bool:
                requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                return proof_kernel_replay_expr_equal(nodes, children, left_root, right_root, depth)

            # Metered form for report adapters that compare the same owner chain against many
            # premises. `work_limit` lets the adapter reserve its remaining report budget before
            # the comparison starts; the kernel still caps each call at 4,000,000 units and
            # 65,536 pending pairs.
            def proof_kernel_replay_expr_equal_public_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize, work_limit: usize, work_used: mutable usize&) -> bool:
                requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                return proof_kernel_replay_expr_equal_with_work(nodes, children, left_root, right_root, depth, work_limit, work_used)

            # Ground congruence closure over the source-neutral term language, exposed on its
            # own. The AST-level producer consults exactly the rule replay will re-derive rather
            # than maintaining a second equality engine that could drift away from this one, and
            # adversarial harnesses can target the rule without the surrounding tiers.
            def proof_kernel_replay_congruence_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                exhausted: mutable bool = false
                return proof_kernel_replay_congruence_report_status(nodes, children, facts, goal_root, &exhausted)

            # The same one-goal query with its budget status. `exhausted` is an advisory accumulator:
            # initialize it once per proof search; this entry sets it when the report work budget
            # or closure term/round budget cuts this tier short, but preserves earlier exhaustion.
            # A refusal may be undecided rather than "no rule applies"; this flag never changes the verdict.
            def proof_kernel_replay_congruence_report_status[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, exhausted: mutable bool&) -> bool:
                work_used: mutable usize = 0
                return proof_kernel_replay_congruence_report_status_with_work(nodes, children, facts, goal_root, exhausted, &work_used)

            # Bounded variant for adapters that share one report budget across several searches.
            # `work_used` is cumulative for the caller and the kernel's hard ceiling remains in
            # force. Callers may seed it near that ceiling to reserve only their remaining budget.
            def proof_kernel_replay_congruence_report_status_with_work[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r, facts: darray[usize], goal_root: usize, exhausted: mutable bool&, work_used: mutable usize&) -> bool:
                workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
                return proof_kernel_replay_congruence_report_status_with_work_and_workspace(nodes, children, facts, goal_root, exhausted, work_used, &workspace)

            # Reuse validation scratch across a batch while rechecking every supplied root each
            # time. The workspace retains capacity only; its cached graph verdict is not reused.
            def proof_kernel_replay_congruence_report_status_with_work_and_workspace[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r, facts: darray[usize], goal_root: usize, exhausted: mutable bool&, work_used: mutable usize&, workspace: mutable ProofKernelReplayValidationWorkspace&) -> bool:
                # Congruence only handles equality. Read and meter the root first so an
                # unrelated goal can be rejected before validating its entire premise graph.
                if not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                    exhausted <- true if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return false
                goal: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
                return false if:
                    not goal.known or goal.node.kind != "binary" or goal.node.operator != "=="
                    not proof_kernel_replay_arena_valid_with_goal_work_and_workspace(nodes, children, facts, goal_root, work_used, exhausted, workspace)
                # Proposition shape and literal safety also walk attacker supplied DAGs. Keep
                # them on the same report budget as the later width checks and closure search.
                proposition_valid: bool = proof_kernel_replay_proposition_state_valid_with_goal_work(nodes, children, facts, goal_root, work_used)
                if not proposition_valid:
                    exhausted <- true if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return false
                # Equality congruence preserves deterministic fixed-width operations under wrap.
                # A status call checks one goal; its premises and goal share this report budget.
                if goal.known and goal.node.kind == "binary" and goal.node.operator == "==":
                    goal_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, goal_root, facts, work_used, 0)
                    if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                        exhausted <- true
                        return false
                    unsigned_free: mutable bool = goal_width == 0
                    for fact in facts |fact, nodes, children, unsigned_free, work_used|:
                        if not proof_kernel_replay_goal_search_charge(work_used):
                            exhausted <- true
                            return false
                        fact_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, fact, facts, work_used, 0)
                        if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                            exhausted <- true
                            return false
                        unsigned_free <- false if fact_width != 0
                    if unsigned_free:
                        # Safety bounds cannot change a congruence closure. Return its result
                        # directly instead of rebuilding them and running the same closure again.
                        return proof_kernel_replay_congruence_goal_with_goal_work(nodes, children, facts, goal_root, work_used, exhausted)
                # The following fact and goal checks build unsigned and signed safety contexts,
                # then validate every premise and the goal against them. Running the older
                # arithmetic_state_safe precheck here repeated those graph walks with fresh local
                # meters and left this report boundary's work unbounded across the precheck.
                unsigned_safe: bool = proof_kernel_replay_unsigned_report_safe_with_goal_work(nodes, children, facts, goal_root, work_used)
                if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                    exhausted <- true
                    return false
                return false if not unsigned_safe
                return proof_kernel_replay_congruence_goal_with_goal_work(nodes, children, facts, goal_root, work_used, exhausted)

            # Reserve a caller-selected amount of the kernel's report work for this query and
            # return the units consumed. The offset keeps every internal helper on its existing
            # hard ceiling while making the ceiling cumulative with the caller's own report meter.
            def proof_kernel_replay_congruence_report_status_with_budget[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r, facts: darray[usize], goal_root: usize, work_budget: usize, exhausted: mutable bool&) -> (proven: bool, work_used: usize):
                allowance: usize = work_budget if work_budget < PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT else PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                work_base: usize = PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - allowance
                cumulative_work: mutable usize = work_base
                proven: bool = proof_kernel_replay_congruence_report_status_with_work(nodes, children, facts, goal_root, exhausted, &cumulative_work)
                consumed: usize = cumulative_work - work_base if cumulative_work <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT else allowance + 1
                return (proven, consumed)

            # Declared effect containment. The claim is about declared rows: every resolved
            # callee's `can[...]` row is contained in the caller's. It says nothing about effects
            # a body performs without a call.
            def proof_kernel_replay_effect_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if:
                    not proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)
                    facts.count != 0
                return proof_kernel_replay_effect_goal(nodes, children, goal_root)

            # Abstract propositional-calculus entry point. Opaque node forms (including calls and
            # projections) are atoms of this source-neutral logic; this API makes no Elisa source
            # typing claim. A source adapter must validate its declarations through the typed
            # entry point above before binding a result to an Elisa obligation.
            def proof_kernel_replay_goal_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return (proof_kernel_replay_goal_report_impl(nodes, children, facts, goal_root, false) can Global{Read,Write})

            def proof_kernel_replay_goal_report_with_trace_work[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize, trace_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
                return false if not proof_kernel_replay_arena_valid_with_trace_work(nodes, children, facts, goal_root, trace_work)
                return false if trace_work > PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
                remaining: usize = PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT - trace_work
                goal_budget: usize = remaining if remaining < PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT else PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                goal_work_seed: usize = PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - goal_budget
                goal_work: mutable usize = goal_work_seed
                valid: bool = (proof_kernel_replay_goal_report_impl_with_work(nodes, children, facts, goal_root, true, &goal_work) can Global{Read,Write})
                goal_work_used: usize = goal_work - goal_work_seed if goal_work >= goal_work_seed else PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false if goal_work_used > goal_budget
                return false if not proof_kernel_replay_tactic_trace_charge(trace_work, goal_work_used)
                return valid

            def proof_kernel_replay_tactic_step[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview) -> bool:
                return (proof_kernel_replay_tactic_step_impl(nodes, children, action, accepted, before_solved, after_solved, before_facts, before_goal, after_facts, after_goal, argument, has_argument, secondary, has_secondary, argument_index, has_argument_index, detail, false) can Global{Read,Write})

            def proof_kernel_replay_tactic_step_with_trace_work[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview, trace_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
                return (proof_kernel_replay_tactic_step_impl_with_trace_work(nodes, children, action, accepted, before_solved, after_solved, before_facts, before_goal, after_facts, after_goal, argument, has_argument, secondary, has_secondary, argument_index, has_argument_index, detail, false, trace_work) can Global{Read,Write})

            def proof_kernel_replay_tactic_trace_charge_work(trace_work: mutable usize&, amount: usize) -> bool:
                return proof_kernel_replay_tactic_trace_charge(trace_work, amount)

            def proof_kernel_replay_tactic_trace_remaining_work(trace_work: usize) -> usize:
                return 0 if trace_work >= PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
                PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT - trace_work

            def proof_kernel_replay_tactic_trace_expr_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize, trace_work: mutable usize&) -> bool:
                return false if trace_work > PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
                remaining: usize = PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT - trace_work
                comparison_work: mutable usize = 0
                equal: bool = proof_kernel_replay_expr_equal_public_with_work(nodes, children, left_root, right_root, depth, remaining, &comparison_work)
                return false if not equal or not proof_kernel_replay_tactic_trace_charge(trace_work, comparison_work)
                return true

            # Typed transition replay is conditional on the supplied typing context. The
            # environment validator checks structure, not source provenance; source adapters
            # must authenticate the rows before treating this result as a source-level proof.
            def proof_kernel_replay_tactic_step_typed[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview) -> bool can[Global.Read, Global.Write]:
                return false if:
                    not proof_kernel_replay_arena_valid(nodes, children, before_facts, before_goal)
                    not proof_kernel_replay_arena_valid(nodes, children, after_facts, after_goal)
                    has_argument and not proof_kernel_replay_arena_valid(nodes, children, [], argument)
                    has_secondary and not proof_kernel_replay_arena_valid(nodes, children, [], secondary)
                    not proof_kernel_replay_type_scan_budget_admitted(environment, nodes.count)
                typing_work_used: mutable usize = 0
                typing_index: (known: bool, index: ProofKernelReplayTypingIndex) = proof_kernel_replay_build_typing_index(environment, &typing_work_used)
                return false if not typing_index.known
                typing_index_work: usize = typing_work_used
                before_typing_work: mutable usize = typing_index_work
                return false if not proof_kernel_replay_typed_proposition_state_valid_with_index(nodes, children, environment, typing_index.index, before_facts, before_goal, before_typing_work)
                after_typing_work: mutable usize = typing_index_work
                return false if not proof_kernel_replay_typed_proposition_state_valid_with_index(nodes, children, environment, typing_index.index, after_facts, after_goal, after_typing_work)
                if has_argument:
                    argument_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index.index, argument, 0, &typing_work_used)
                    return false if:
                        action == "have" and not argument_sort.known
                        action != "have" and not argument_sort.known
                        action == "have" and argument_sort.family != "boolean" and argument_sort.family != "proposition"
                if has_secondary:
                    secondary_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index.index, secondary, 0, &typing_work_used)
                    return false if not secondary_sort.known
                    if action == "rewrite":
                        argument_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index.index, argument, 0, &typing_work_used)
                        return false if not proof_kernel_replay_sort_equal(argument_sort, secondary_sort, &typing_work_used)
                        # Rewriting is a Leibniz rule. Named/aggregate values may use Elisa
                        # protocol equality, which has no substitutivity law, so the typed kernel
                        # admits only language-owned primitive equality sorts here.
                        return false if argument_sort.family != "integer" and argument_sort.family != "floating" and argument_sort.family != "character" and argument_sort.family != "boolean" and argument_sort.family != "string"
                return false if typing_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                return (proof_kernel_replay_tactic_step_impl(nodes, children, action, accepted, before_solved, after_solved, before_facts, before_goal, after_facts, after_goal, argument, has_argument, secondary, has_secondary, argument_index, has_argument_index, detail, true) can Global{Read,Write})

            def proof_kernel_replay_tactic_branch[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, parent_facts: darray[usize], parent_goal: usize, left_facts: darray[usize], left_goal: usize, right_facts: darray[usize], right_goal: usize) -> bool:
                return proof_kernel_replay_tactic_branch_report(nodes, children, action, parent_facts, parent_goal, left_facts, left_goal, right_facts, right_goal)

            def proof_kernel_replay_tactic_branch_with_trace_work[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, parent_facts: darray[usize], parent_goal: usize, left_facts: darray[usize], left_goal: usize, right_facts: darray[usize], right_goal: usize, trace_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
                return false if trace_work > PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
                arena_workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
                return false if:
                    not proof_kernel_replay_arena_valid_with_trace_workspace(nodes, children, parent_facts, parent_goal, &arena_workspace, trace_work)
                    not proof_kernel_replay_arena_valid_with_trace_workspace(nodes, children, left_facts, left_goal, &arena_workspace, trace_work)
                    not proof_kernel_replay_arena_valid_with_trace_workspace(nodes, children, right_facts, right_goal, &arena_workspace, trace_work)
                return false if trace_work > PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
                remaining: usize = PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT - trace_work
                step_budget: usize = remaining if remaining < PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT else PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                step_work_seed: usize = PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - step_budget
                step_work: mutable usize = step_work_seed
                valid: bool = proof_kernel_replay_tactic_branch_report_with_work(nodes, children, action, parent_facts, parent_goal, left_facts, left_goal, right_facts, right_goal, &step_work)
                step_work_used: usize = step_work - step_work_seed if step_work >= step_work_seed else PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false if step_work_used > step_budget
                return false if not proof_kernel_replay_tactic_trace_charge(trace_work, step_work_used)
                return valid

            # Branch replay uses the same caller-authenticated typing-context contract as typed
            # step replay; successful structural validation alone does not bind context to source.
            def proof_kernel_replay_tactic_branch_typed[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, action: sview, parent_facts: darray[usize], parent_goal: usize, left_facts: darray[usize], left_goal: usize, right_facts: darray[usize], right_goal: usize) -> bool:
                return false if:
                    not proof_kernel_replay_arena_valid(nodes, children, parent_facts, parent_goal)
                    not proof_kernel_replay_arena_valid(nodes, children, left_facts, left_goal)
                    not proof_kernel_replay_arena_valid(nodes, children, right_facts, right_goal)
                    not proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, parent_facts, parent_goal)
                    not proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, left_facts, left_goal)
                    not proof_kernel_replay_typed_proposition_state_valid(nodes, children, environment, right_facts, right_goal)
                return proof_kernel_replay_tactic_branch_report(nodes, children, action, parent_facts, parent_goal, left_facts, left_goal, right_facts, right_goal)

            # A checked-index certificate proves the memory-safety boundary supplied by Elisa's
            # `get collection[index] else fallback` operator. It is separate from arithmetic
            # goal replay: the selected element remains opaque, while replay validates only the
            # guarded load/fallback shape.
            def proof_kernel_replay_checked_index_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_checked_index_report_impl(nodes, children, facts, goal_root, false)

            def proof_kernel_replay_checked_index_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
                return proof_kernel_replay_checked_index_report_impl(nodes, children, facts, goal_root, true)

            # A checked-get certificate proves the memory-safety boundary of
            # `get collection[index] else <control recovery>`. The recovery's termination and
            # state isolation are checked separately by the source-level control-flow pass.
            def proof_kernel_replay_checked_get_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_checked_get_report_impl(nodes, children, facts, goal_root, false)

            def proof_kernel_replay_checked_get_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0 or not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
                return proof_kernel_replay_checked_get_report_impl(nodes, children, facts, goal_root, true)

            def proof_kernel_replay_quantifier_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, kind: sview, facts: darray[usize], goal_root: usize) -> bool:
                return (proof_kernel_replay_quantifier_report_impl(nodes, children, kind, facts, goal_root, false) can Global{Read,Write})

            def proof_kernel_replay_quantifier_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, kind: sview, facts: darray[usize], goal_root: usize) -> bool:
                return false if not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
                return (proof_kernel_replay_quantifier_report_impl(nodes, children, kind, facts, goal_root, true) can Global{Read,Write})
