extend ElisaProofKernelReplay:
    private:
        # Mirror of `proof_kernel_replay_or_leaf_matches`, carrying the caller's single goal
        # budget through the disjunction scan and the terminal structural comparison.
        def proof_kernel_replay_or_leaf_matches_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, goal_root: usize, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren":
                matched: bool = proof_kernel_replay_or_leaf_matches_with_goal_work(nodes, children, node.left, goal_root, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return matched
            if node.kind == "binary" and node.operator == "or":
                left_matches: bool = proof_kernel_replay_or_leaf_matches_with_goal_work(nodes, children, node.left, goal_root, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if left_matches
                right_matches: bool = proof_kernel_replay_or_leaf_matches_with_goal_work(nodes, children, node.right, goal_root, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return right_matches
            matched: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, root, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            matched

        # Mirror of `proof_kernel_replay_split_prefers`. This only chooses the first branch to
        # try; branch proofs still determine acceptance in the resource-model search.
        def proof_kernel_replay_split_prefers_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, goal_root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            stripped: usize = nodes[root].left if nodes[root].kind == "paren" else root
            return false if:
                stripped >= nodes.count or not proof_kernel_replay_valid(nodes, stripped) or not proof_kernel_replay_goal_search_charge(work_used)
                stripped != root and not proof_kernel_replay_goal_search_charge_node_text(nodes, stripped, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                nodes[stripped].kind != "binary" or nodes[stripped].operator != "or"
            proof_kernel_replay_or_leaf_matches_with_goal_work(nodes, children, root, goal_root, 0, work_used)
