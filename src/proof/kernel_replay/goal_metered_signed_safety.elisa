extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_signed_safety_bounds_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], work_used: mutable usize&) -> darray[ProofKernelReplayBound]:
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                return [] if not proof_kernel_replay_goal_search_charge(work_used)
                proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, &bounds, work_used, 0)
                return [] if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return [] if not proof_kernel_replay_close_equalities_with_work(nodes, children, facts, &bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return [] if not proof_kernel_replay_add_signed_type_bounds_with_goal_work(nodes, children, facts, &bounds, work_used)
            return [] if not proof_kernel_replay_close_term_equalities_with_goal_work(nodes, children, facts, &bounds, work_used)
            constraints: mutable darray[ProofKernelReplayDifference] = []
            for fact in facts |fact, nodes, children, facts, bounds, constraints, work_used|:
                proof_kernel_replay_collect_differences_with_goal_work(nodes, fact, bounds, children, facts, &constraints, work_used, 0)
                return [] if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return [] if not proof_kernel_replay_difference_bound_closure_with_work(constraints, &bounds, work_used)
            bounds
