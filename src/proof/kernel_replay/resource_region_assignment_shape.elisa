extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_arena_resource_region_assignment_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.operator == "" and node.right > 0 and node.right <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and node.auxiliary > 0 and node.auxiliary <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and node.name != "" and node.secondary_name != "")
            return node.operator == "" and node.right > 0 and node.right <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and node.auxiliary > 0 and node.auxiliary <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and node.name != "" and node.secondary_name != ""

        def proof_kernel_replay_arena_resource_region_alloc_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return node.operator == "" and node.right == 0 and proof_kernel_replay_arena_resource_region_flags_valid(node.auxiliary) and (node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) == 0 and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and node.name != "" and node.secondary_name != ""
