module ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT: i64 = 64

        struct ProofKernelReplayInt:
            known: bool
            value: i64

        struct ProofKernelReplayBool:
            known: bool
            value: bool

        # Result of the independent `simp` normalizer. `changed` records whether the source
        # tactic's bottom-up pass performed one of its closed rewrites; `root` is the canonical
        # arena term that pass produces. Keeping this separate from goal entailment is important:
        # a stronger proposition such as `p and true` is not a simplification of `p` merely because
        # it contains the old goal as a conjunct.
        struct ProofKernelReplaySimplified:
            known: bool
            changed: bool
            root: usize

        struct ProofKernelReplayBound:
            name: sview
            term_name: sview
            term_offset: i64
            term_key: bool
            term_root: usize
            term_expression_key: bool
            lower: mutable i64
            upper: mutable i64
            has_lower: mutable bool
            has_upper: mutable bool

        struct ProofKernelReplayAffine:
            base: sview
            offset: i64
            known: bool
            negative: bool

        struct ProofKernelReplayDifference:
            left: sview
            right: sview
            bound: i64

    public:
        # Arena admission uses an explicit DFS work item rather than the host call stack. The
        # depth is still part of the certificate invariant, so iterative traversal does not turn
        # an unbounded serialized graph into an accepted term merely because it avoids recursion.
        struct ProofKernelReplayArenaWork:
            root: usize
            depth: usize
            exiting: bool

        # Reusable scratch for kernel arena admission. Each check clears and reinitializes every
        # logical slot before use; caller-provided contents are never trusted across calls.
        struct ProofKernelReplayValidationWorkspace:
            visiting: mutable darray[bool]
            visited: mutable darray[bool]
            validity: mutable darray[bool]
            visited_depth: mutable darray[usize]
            work: mutable darray[ProofKernelReplayArenaWork]
            work_used: mutable usize
            # Fact-trace verdicts within one validation pass, by trace index: the deepest start
            # (plus one) at which the trace validated, 0 for none, and for the kernel validator
            # whether that ran with full arena revalidation. Only traces whose check consulted no
            # dependency stack are recorded (`trace_stack_touched`), so a verdict never depends
            # on the summary chain it was reached through.
            trace_memo_depth: mutable darray[usize]
            kernel_trace_memo_depth: mutable darray[usize]
            kernel_trace_memo_strict: mutable darray[bool]
            trace_stack_touched: mutable bool

        def proof_kernel_replay_validation_workspace_new() -> ProofKernelReplayValidationWorkspace:
            return ProofKernelReplayValidationWorkspace{visiting: [], visited: [], validity: [], visited_depth: [], work: [], work_used: 0, trace_memo_depth: [], kernel_trace_memo_depth: [], kernel_trace_memo_strict: [], trace_stack_touched: false}

    private:

        def proof_kernel_replay_i64_max() -> i64:
            return ElisaProofKernelCore::PROOF_KERNEL_I64_MAX

        def proof_kernel_replay_i64_min() -> i64:
            return ElisaProofKernelCore::PROOF_KERNEL_I64_MIN

        def proof_kernel_replay_add_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if right > 0 and left > proof_kernel_replay_i64_max() - right
            return ProofKernelReplayInt{known: false, value: 0} if right < 0 and left < proof_kernel_replay_i64_min() - right
            return ProofKernelReplayInt{known: true, value: left + right}

        def proof_kernel_replay_sub_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if right > 0 and left < proof_kernel_replay_i64_min() + right
            return ProofKernelReplayInt{known: false, value: 0} if right < 0 and left > proof_kernel_replay_i64_max() + right
            return ProofKernelReplayInt{known: true, value: left - right}

        def proof_kernel_replay_mul_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: true, value: 0} if left == 0 or right == 0
            return ProofKernelReplayInt{known: true, value: right} if left == 1
            return ProofKernelReplayInt{known: true, value: left} if right == 1
            if left == -1:
                return ProofKernelReplayInt{known: false, value: 0} if right == proof_kernel_replay_i64_min()
                return ProofKernelReplayInt{known: true, value: 0 - right}
            if right == -1:
                return ProofKernelReplayInt{known: false, value: 0} if left == proof_kernel_replay_i64_min()
                return ProofKernelReplayInt{known: true, value: 0 - left}
            if left > 0:
                return ProofKernelReplayInt{known: false, value: 0} if right > 0 and left > proof_kernel_replay_i64_max() / right
                return ProofKernelReplayInt{known: false, value: 0} if right < 0 and right < proof_kernel_replay_i64_min() / left
            else:
                return ProofKernelReplayInt{known: false, value: 0} if right > 0 and left < proof_kernel_replay_i64_min() / right
                return ProofKernelReplayInt{known: false, value: 0} if right < 0 and left < proof_kernel_replay_i64_max() / right
            return ProofKernelReplayInt{known: true, value: left * right}

        def proof_kernel_replay_div_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if right == 0 or (left == proof_kernel_replay_i64_min() and right == -1)
            return ProofKernelReplayInt{known: true, value: left / right}

        def proof_kernel_replay_mod_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if right == 0 or (left == proof_kernel_replay_i64_min() and right == -1)
            return ProofKernelReplayInt{known: true, value: left % right}

        def proof_kernel_replay_shift_safe(value: i64, amount: i64, left: bool) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if amount < 0 or amount > ElisaProofKernelCore::PROOF_KERNEL_MAX_SHIFT_AMOUNT
            return ProofKernelReplayInt{known: true, value: value << amount} if left
            return ProofKernelReplayInt{known: true, value: value >> amount}

        def proof_kernel_replay_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            ensure result == (root < nodes.count)
            return ElisaProofKernelCore::root_valid(nodes.count, root)

        # A bounded lookup keeps the replay implementation honest about serialized arena
        # indices. The loop index is intrinsically in range, while the requested index may be
        # hostile input. Callers must check `known` before consuming the returned node.
        def proof_kernel_replay_node_at(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, node: ElisaProofKernelCore::ProofKernelNode):
            empty: ElisaProofKernelCore::ProofKernelNode = ElisaProofKernelCore::ProofKernelNode{kind: "", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""}
            return (false, empty) if root >= nodes.count
            assert root < nodes.count
            return (true, nodes[root])

        def proof_kernel_replay_bool_at(values: darray[bool]&, requested: usize) -> (known: bool, value: bool):
            return (false, false) if requested >= values.count
            assert requested < values.count
            return (true, values[requested])

        def proof_kernel_replay_bool_set(values: mutable darray[bool]&, requested: usize, value: bool) -> bool:
            return false if requested >= values.count
            assert requested < values.count
            values[requested] <- value
            return true

        def proof_kernel_replay_child_at(children: darray[usize]&, requested: usize) -> (known: bool, value: usize):
            return (false, 0) if requested >= children.count
            assert requested < children.count
            return (true, children[requested])

        # Keep the hostile serialized-slice check free of a precondition. The compiler core's
        # range_valid predicate is intentionally specified with a precondition for ordinary
        # callers; replay admission instead needs a total predicate that can inspect malformed
        # starts and counts before invoking any indexed operation.
        def proof_kernel_replay_child_range_valid(start: usize, count: usize, total: usize) -> bool:
            # Both conjuncts are needed by a caller indexing `children[start + index]`: the sum
            # rule bounds `start + index` by `total` only when the guard on the subtraction is
            # stated beside the bound it guards.
            ensure not result or start <= total and count <= total - start
            return false if start > total
            return false if count > total - start
            return true

        def proof_kernel_replay_constant_unary(operator: sview, inner: ProofKernelReplayInt) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if not inner.known
            return inner if operator == "+"
            if operator == "-":
                return ProofKernelReplayInt{known: false, value: 0} if inner.value == proof_kernel_replay_i64_min()
                return ProofKernelReplayInt{known: true, value: 0 - inner.value}
            return ProofKernelReplayInt{known: false, value: 0}

        def proof_kernel_replay_constant_binary(operator: sview, left: ProofKernelReplayInt, right: ProofKernelReplayInt) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if not left.known or not right.known
            return proof_kernel_replay_add_safe(left.value, right.value) if operator == "+"
            return proof_kernel_replay_sub_safe(left.value, right.value) if operator == "-"
            return proof_kernel_replay_mul_safe(left.value, right.value) if operator == "*"
            return proof_kernel_replay_div_safe(left.value, right.value) if operator == "/"
            return proof_kernel_replay_mod_safe(left.value, right.value) if operator == "%"
            return ProofKernelReplayInt{known: true, value: left.value & right.value} if operator == "&"
            return ProofKernelReplayInt{known: true, value: left.value | right.value} if operator == "|"
            return ProofKernelReplayInt{known: true, value: left.value ^ right.value} if operator == "^"
            return proof_kernel_replay_shift_safe(left.value, right.value, true) if operator == "<<"
            return proof_kernel_replay_shift_safe(left.value, right.value, false) if operator == ">>"
            return ProofKernelReplayInt{known: false, value: 0}

        # Mirror of `proof_small_literal_count`.
        def proof_kernel_replay_small_count(count: usize) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: true, value: 0} if count == 0
            return ProofKernelReplayInt{known: true, value: 1} if count == 1
            return ProofKernelReplayInt{known: true, value: 2} if count == 2
            return ProofKernelReplayInt{known: true, value: 3} if count == 3
            return ProofKernelReplayInt{known: true, value: 4} if count == 4
            return ProofKernelReplayInt{known: true, value: 5} if count == 5
            return ProofKernelReplayInt{known: true, value: 6} if count == 6
            return ProofKernelReplayInt{known: true, value: 7} if count == 7
            return ProofKernelReplayInt{known: true, value: 8} if count == 8
            return ProofKernelReplayInt{known: false, value: 0}

        def proof_kernel_replay_constant_leaf(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, kind: sview, name: sview, left: usize, value: i64) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            match kind:
                "int":
                    return ProofKernelReplayInt{known: true, value: value}
                "field":
                    return empty if name != "count"
                    # Mirror: a short literal's length, read by comparison rather than by a `usize`
                    # to `i64` conversion, which is outside the fragment this module is verified in.
                    return empty if left >= nodes.count
                    object: ElisaProofKernelCore::ProofKernelNode = nodes[left]
                    return empty if object.kind != "array"
                    return proof_kernel_replay_small_count(object.children_count)
                _:
                    return empty

        def proof_kernel_replay_constant_int(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return proof_kernel_replay_constant_int_remaining(nodes, root, remaining)

        def proof_kernel_replay_constant_int_remaining(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize) -> ProofKernelReplayInt:
            decreases remaining
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if root >= nodes.count
            # Keep the indexed node as a place rather than copying the whole record into a local:
            # local struct copies eagerly acquire scalar-operator witnesses for every field,
            # including fields this evaluator never operates on.
            match nodes[root].kind:
                "unary":
                    return empty if remaining < 1
                    inner: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining(nodes, nodes[root].left, remaining - 1)
                    return proof_kernel_replay_constant_unary(nodes[root].operator, inner)
                "binary":
                    return empty if remaining < 1
                    left: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining(nodes, nodes[root].left, remaining - 1)
                    right: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining(nodes, nodes[root].right, remaining - 1)
                    return proof_kernel_replay_constant_binary(nodes[root].operator, left, right)
                _:
                    # A tagged literal's payload is not its value; only the typed comparison
                    # rule in safe_comparison_constants interprets it.
                    return empty if proof_kernel_replay_int_tagged(nodes[root])
                    return proof_kernel_replay_constant_leaf(nodes, nodes[root].kind, nodes[root].name, nodes[root].left, nodes[root].value)

        # Keep the fast path explicit at its call site too: only direct, nonnegative literals
        # can be compared without the erased integer-width/type metadata.
        def proof_kernel_replay_direct_literal_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> bool:
            return false if left_root >= nodes.count or right_root >= nodes.count
            typed_comparison = ElisaProofKernelCore::typed_constant_expression_comparison(nodes, left_root, operator, right_root)
            return typed_comparison.value if typed_comparison.known
            contextual_comparison = ElisaProofKernelCore::contextual_unsigned_constant_comparison(nodes, left_root, operator, right_root)
            return contextual_comparison.value if contextual_comparison.known
            if nodes[left_root].kind == "typed-int" or nodes[right_root].kind == "typed-int":
                comparison = ElisaProofKernelCore::typed_literal_comparison(nodes[left_root], operator, nodes[right_root])
                return comparison.known and comparison.value
            return false if nodes[left_root].kind != "int" or nodes[right_root].kind != "int"
            return false if nodes[left_root].value < 0 or nodes[right_root].value < 0
            return proof_kernel_replay_constant_comparison(nodes, left_root, operator, right_root)

        # Mirror the exact closed rewrites performed by `proof_tactic_simplify_expression`.
        # Integer arithmetic is intentionally not folded: this arena has no width/signedness
        # metadata, so checked i64 arithmetic is not enough to model fixed-width Elisa values.
        # Non-binary formers are opaque to the source tactic too, so their children are not
        # traversed here. The caller validates the complete input state before this bounded walk.
        def proof_kernel_replay_simplify(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, depth: usize) -> ProofKernelReplaySimplified:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            empty: ProofKernelReplaySimplified = ProofKernelReplaySimplified{known: false, changed: false, root: 0}
            return empty if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "unary":
                operand: ProofKernelReplaySimplified = proof_kernel_replay_simplify(nodes, children, node.left, depth + 1)
                return empty if not operand.known
                operand_root: usize = operand.root if operand.changed else node.left
                operand_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, operand_root)
                return empty if not operand_node.known
                if node.operator == "not":
                    if operand_node.node.kind == "bool":
                        result: usize = ElisaProofKernelCore::add_node(nodes, "bool", "", 0, 0, 0, 0, 0, 0 if operand_node.node.value != 0 else 1, "", "")
                        return ProofKernelReplaySimplified{known: true, changed: true, root: result}
                    if operand_node.node.kind == "unary" and operand_node.node.operator == "not":
                        return ProofKernelReplaySimplified{known: true, changed: true, root: operand_node.node.left}
                if node.operator == "+" or node.operator == "-":
                    constant: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
                    if constant.known:
                        result: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, constant.value, "", "")
                        return ProofKernelReplaySimplified{known: true, changed: true, root: result}
                if not operand.changed:
                    return ProofKernelReplaySimplified{known: true, changed: false, root: root}
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, "unary", node.operator, operand_root, 0, 0, 0, 0, 0, "", "")
                return ProofKernelReplaySimplified{known: true, changed: true, root: rewritten}
            if node.kind == "binary":
                left: ProofKernelReplaySimplified = proof_kernel_replay_simplify(nodes, children, node.left, depth + 1)
                right: ProofKernelReplaySimplified = proof_kernel_replay_simplify(nodes, children, node.right, depth + 1)
                return empty if not left.known or not right.known
                left_root: usize = left.root if left.changed else node.left
                right_root: usize = right.root if right.changed else node.right
                left_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, left_root)
                right_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, right_root)
                return empty if not left_node.known or not right_node.known
                if node.operator == "==" or node.operator == "!=" or node.operator == "<" or node.operator == ">" or node.operator == "<=" or node.operator == ">=":
                    left_constant: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, left_root)
                    right_constant: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, right_root)
                    if left_constant.known and right_constant.known:
                        comparison: mutable bool = false
                        comparison <- left_constant.value == right_constant.value if node.operator == "=="
                        comparison <- left_constant.value != right_constant.value if node.operator == "!="
                        comparison <- left_constant.value < right_constant.value if node.operator == "<"
                        comparison <- left_constant.value <= right_constant.value if node.operator == "<="
                        comparison <- left_constant.value > right_constant.value if node.operator == ">"
                        comparison <- left_constant.value >= right_constant.value if node.operator == ">="
                        result: usize = ElisaProofKernelCore::add_node(nodes, "bool", "", 0, 0, 0, 0, 0, 1 if comparison else 0, "", "")
                        return ProofKernelReplaySimplified{known: true, changed: true, root: result}
                if (node.operator == "==" or node.operator == "!=") and left_node.node.kind == "bool" and right_node.node.kind == "bool":
                    comparison: mutable bool = left_node.node.value == right_node.node.value
                    comparison <- not comparison if node.operator == "!="
                    result: usize = ElisaProofKernelCore::add_node(nodes, "bool", "", 0, 0, 0, 0, 0, 1 if comparison else 0, "", "")
                    return ProofKernelReplaySimplified{known: true, changed: true, root: result}
                if (node.operator == "and" or node.operator == "or" or node.operator == "=>") and left_node.node.kind == "bool" and right_node.node.kind == "bool":
                    result_value: mutable bool = false
                    result_value <- left_node.node.value != 0 and right_node.node.value != 0 if node.operator == "and"
                    result_value <- left_node.node.value != 0 or right_node.node.value != 0 if node.operator == "or"
                    result_value <- (left_node.node.value == 0) or (right_node.node.value != 0) if node.operator == "=>"
                    result: usize = ElisaProofKernelCore::add_node(nodes, "bool", "", 0, 0, 0, 0, 0, 1 if result_value else 0, "", "")
                    return ProofKernelReplaySimplified{known: true, changed: true, root: result}
                if proof_kernel_replay_integer_arithmetic_operator(node.operator):
                    constant: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
                    if constant.known:
                        result: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, constant.value, "", "")
                        return ProofKernelReplaySimplified{known: true, changed: true, root: result}
                if not left.changed and not right.changed:
                    return ProofKernelReplaySimplified{known: true, changed: false, root: root}
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, left_root, right_root, 0, 0, 0, 0, "", "")
                return ProofKernelReplaySimplified{known: true, changed: true, root: rewritten}
            return ProofKernelReplaySimplified{known: true, changed: false, root: root}

        def proof_kernel_replay_ident_name(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> sview:
            return "" if root >= nodes.count
            return "" if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return node.name if node.kind == "ident" else ""

        def proof_kernel_replay_ident_matches(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, expected: sview) -> bool:
            return false if root >= nodes.count
            return false if not proof_kernel_replay_valid(nodes, root)
            return nodes[root].kind == "ident" and nodes[root].name == expected

        def proof_kernel_replay_bound_index(bounds: darray[ProofKernelReplayBound]&, name: sview) -> usize:
            for index in 0..<bounds.count:
                if not bounds[index].term_key and bounds[index].name == name:
                    return index
            return bounds.count

        def proof_kernel_replay_bound_for(bounds: darray[ProofKernelReplayBound]&, name: sview) -> ProofKernelReplayBound:
            for index in 0..<bounds.count:
                if not bounds[index].term_key and bounds[index].name == name:
                    return bounds[index]
            return ProofKernelReplayBound{name: name, term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_kernel_replay_add_lower(bounds: mutable darray[ProofKernelReplayBound]&, name: sview, value: i64) -> void:
            return if name == ""
            for mutable bound in bounds:
                if not bound.term_key and bound.name == name:
                    old_has: bool = bound.has_lower
                    old_value: i64 = bound.lower
                    bound.has_lower <- true
                    bound.lower <- value if not old_has or value > old_value
                    return
            bounds <- bounds.push(ProofKernelReplayBound{name: name, term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: true, lower: value, has_upper: false, upper: 0})

        def proof_kernel_replay_add_upper(bounds: mutable darray[ProofKernelReplayBound]&, name: sview, value: i64) -> void:
            return if name == ""
            for mutable bound in bounds:
                if not bound.term_key and bound.name == name:
                    old_has: bool = bound.has_upper
                    old_value: i64 = bound.upper
                    bound.has_upper <- true
                    bound.upper <- value if not old_has or value < old_value
                    return
            bounds <- bounds.push(ProofKernelReplayBound{name: name, term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: true, upper: value})

        # Loop binders are encoded as `(source-name, source-offset)` tuple atoms so shadowed
        # binders remain distinct. Only the producer's exact shape with an independent scalar
        # type marker may contribute structural bounds.
        def proof_kernel_replay_loop_range_atom_key(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> (known: bool, name: sview, offset: i64):
            return (false, "", 0) if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, "", 0) if node.kind != "tuple" or node.children_count != 2 or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + 1)
            return (false, "", 0) if not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
            return (false, "", 0) if nodes[first.value].kind != "ident" or nodes[first.value].name == "" or nodes[second.value].kind != "int"
            return (true, nodes[first.value].name, nodes[second.value].value)

        def proof_kernel_replay_loop_range_bound_atom(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            key: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key(nodes, children, root)
            return key.known and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0)

        def proof_kernel_replay_scoped_scalar_bound_atom(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return (nodes[root].kind == "call" or (nodes[root].kind == "scope" and nodes[root].name != "")) and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0)

        def proof_kernel_replay_bound_for_term(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, bounds: darray[ProofKernelReplayBound]&, root: usize) -> ProofKernelReplayBound:
            for bound in bounds:
                if bound.term_expression_key and bound.term_root < nodes.count and proof_kernel_replay_expr_equal(nodes, children, bound.term_root, root, 0):
                    return bound
            key: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key(nodes, children, root)
            for bound in bounds:
                if key.known and bound.term_key and bound.term_name == key.name and bound.term_offset == key.offset:
                    return bound
            return ProofKernelReplayBound{name: "", term_name: key.name, term_offset: key.offset, term_key: false, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_kernel_replay_add_term_lower(bounds: mutable darray[ProofKernelReplayBound]&, name: sview, offset: i64, value: i64) -> void:
            for mutable bound in bounds:
                if bound.term_key and bound.term_name == name and bound.term_offset == offset:
                    old_has: bool = bound.has_lower
                    old_value: i64 = bound.lower
                    bound.has_lower <- true
                    bound.lower <- value if not old_has or value > old_value
                    return
            bounds <- bounds.push(ProofKernelReplayBound{name: "", term_name: name, term_offset: offset, term_key: true, term_root: 0, term_expression_key: false, has_lower: true, lower: value, has_upper: false, upper: 0})

        def proof_kernel_replay_add_term_upper(bounds: mutable darray[ProofKernelReplayBound]&, name: sview, offset: i64, value: i64) -> void:
            for mutable bound in bounds:
                if bound.term_key and bound.term_name == name and bound.term_offset == offset:
                    old_has: bool = bound.has_upper
                    old_value: i64 = bound.upper
                    bound.has_upper <- true
                    bound.upper <- value if not old_has or value < old_value
                    return
            bounds <- bounds.push(ProofKernelReplayBound{name: "", term_name: name, term_offset: offset, term_key: true, term_root: 0, term_expression_key: false, has_lower: false, lower: 0, has_upper: true, upper: value})

        def proof_kernel_replay_add_term_expression_lower(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, bounds: mutable darray[ProofKernelReplayBound]&, root: usize, value: i64) -> void:
            for mutable bound in bounds:
                if bound.term_expression_key and bound.term_root < nodes.count and proof_kernel_replay_expr_equal(nodes, children, bound.term_root, root, 0):
                    old_has: bool = bound.has_lower
                    old_value: i64 = bound.lower
                    bound.has_lower <- true
                    bound.lower <- value if not old_has or value > old_value
                    return
            bounds <- bounds.push(ProofKernelReplayBound{name: "", term_name: "", term_offset: 0, term_key: false, term_root: root, term_expression_key: true, has_lower: true, lower: value, has_upper: false, upper: 0})

        def proof_kernel_replay_add_term_expression_upper(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, bounds: mutable darray[ProofKernelReplayBound]&, root: usize, value: i64) -> void:
            for mutable bound in bounds:
                if bound.term_expression_key and bound.term_root < nodes.count and proof_kernel_replay_expr_equal(nodes, children, bound.term_root, root, 0):
                    old_has: bool = bound.has_upper
                    old_value: i64 = bound.upper
                    bound.has_upper <- true
                    bound.upper <- value if not old_has or value < old_value
                    return
            bounds <- bounds.push(ProofKernelReplayBound{name: "", term_name: "", term_offset: 0, term_key: false, term_root: root, term_expression_key: true, has_lower: false, lower: 0, has_upper: true, upper: value})

        def proof_kernel_replay_collect_bound_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left_root: usize, operator: sview, right_root: usize, bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            return if not proof_kernel_replay_primitive_comparison(nodes, children, facts, left_root, right_root)
            left_name_root: mutable usize = nodes.count
            right_name_root: mutable usize = nodes.count
            if left_root < nodes.count:
                left_name_root <- left_root if nodes[left_root].kind == "ident" and nodes[left_root].name != ""
            if right_root < nodes.count:
                right_name_root <- right_root if nodes[right_root].kind == "ident" and nodes[right_root].name != ""
            left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_pins(nodes, children, facts, left_root)
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_pins(nodes, children, facts, right_root)
            if left_name_root < nodes.count and right_constant.known:
                incremented: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_constant.value, 1)
                proof_kernel_replay_add_lower(bounds, nodes[left_name_root].name, incremented.value) if operator == ">" and incremented.known
                proof_kernel_replay_add_lower(bounds, nodes[left_name_root].name, right_constant.value) if operator == ">=" or operator == "=="
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right_constant.value, 1)
                proof_kernel_replay_add_upper(bounds, nodes[left_name_root].name, decremented.value) if operator == "<" and decremented.known
                proof_kernel_replay_add_upper(bounds, nodes[left_name_root].name, right_constant.value) if operator == "<=" or operator == "=="
            if right_name_root < nodes.count and left_constant.known:
                decremented_left: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, 1)
                proof_kernel_replay_add_upper(bounds, nodes[right_name_root].name, decremented_left.value) if operator == ">" and decremented_left.known
                proof_kernel_replay_add_upper(bounds, nodes[right_name_root].name, left_constant.value) if operator == ">=" or operator == "=="
                incremented_left: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, 1)
                proof_kernel_replay_add_lower(bounds, nodes[right_name_root].name, incremented_left.value) if operator == "<" and incremented_left.known
                proof_kernel_replay_add_lower(bounds, nodes[right_name_root].name, left_constant.value) if operator == "<=" or operator == "=="
            left_term: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key(nodes, children, left_root)
            if left_name_root == nodes.count and left_term.known and proof_kernel_replay_loop_range_bound_atom(nodes, children, facts, left_root) and right_constant.known:
                incremented: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_constant.value, 1)
                proof_kernel_replay_add_term_lower(bounds, left_term.name, left_term.offset, incremented.value) if operator == ">" and incremented.known
                proof_kernel_replay_add_term_lower(bounds, left_term.name, left_term.offset, right_constant.value) if operator == ">=" or operator == "=="
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right_constant.value, 1)
                proof_kernel_replay_add_term_upper(bounds, left_term.name, left_term.offset, decremented.value) if operator == "<" and decremented.known
                proof_kernel_replay_add_term_upper(bounds, left_term.name, left_term.offset, right_constant.value) if operator == "<=" or operator == "=="
            right_term: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key(nodes, children, right_root)
            if right_name_root == nodes.count and right_term.known and proof_kernel_replay_loop_range_bound_atom(nodes, children, facts, right_root) and left_constant.known:
                decremented_left: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, 1)
                proof_kernel_replay_add_term_upper(bounds, right_term.name, right_term.offset, decremented_left.value) if operator == ">" and decremented_left.known
                proof_kernel_replay_add_term_upper(bounds, right_term.name, right_term.offset, left_constant.value) if operator == ">=" or operator == "=="
                incremented_left: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, 1)
                proof_kernel_replay_add_term_lower(bounds, right_term.name, right_term.offset, incremented_left.value) if operator == "<" and incremented_left.known
                proof_kernel_replay_add_term_lower(bounds, right_term.name, right_term.offset, left_constant.value) if operator == "<=" or operator == "=="
            if left_name_root == nodes.count and proof_kernel_replay_scoped_scalar_bound_atom(nodes, children, facts, left_root) and right_constant.known:
                incremented: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_constant.value, 1)
                proof_kernel_replay_add_term_expression_lower(nodes, children, bounds, left_root, incremented.value) if operator == ">" and incremented.known
                proof_kernel_replay_add_term_expression_lower(nodes, children, bounds, left_root, right_constant.value) if operator == ">=" or operator == "=="
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right_constant.value, 1)
                proof_kernel_replay_add_term_expression_upper(nodes, children, bounds, left_root, decremented.value) if operator == "<" and decremented.known
                proof_kernel_replay_add_term_expression_upper(nodes, children, bounds, left_root, right_constant.value) if operator == "<=" or operator == "=="
            if right_name_root == nodes.count and proof_kernel_replay_scoped_scalar_bound_atom(nodes, children, facts, right_root) and left_constant.known:
                decremented_left: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, 1)
                proof_kernel_replay_add_term_expression_upper(nodes, children, bounds, right_root, decremented_left.value) if operator == ">" and decremented_left.known
                proof_kernel_replay_add_term_expression_upper(nodes, children, bounds, right_root, left_constant.value) if operator == ">=" or operator == "=="
                incremented_left: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, 1)
                proof_kernel_replay_add_term_expression_lower(nodes, children, bounds, right_root, incremented_left.value) if operator == "<" and incremented_left.known
                proof_kernel_replay_add_term_expression_lower(nodes, children, bounds, right_root, left_constant.value) if operator == "<=" or operator == "=="

        def proof_kernel_replay_collect_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, bounds: mutable darray[ProofKernelReplayBound]&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not ElisaProofKernelCore::depth_valid(depth)
            return if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return if root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary" and node.operator == "not" and proof_kernel_replay_valid(nodes, node.left):
                proof_kernel_replay_collect_negated_bounds(nodes, children, facts, node.left, bounds)
                return
            if node.kind != "binary":
                return
            if node.operator == "and":
                proof_kernel_replay_collect_bounds(nodes, children, facts, node.left, bounds, depth + 1)
                proof_kernel_replay_collect_bounds(nodes, children, facts, node.right, bounds, depth + 1)
                return
            proof_kernel_replay_collect_bound_comparison(nodes, children, facts, node.left, node.operator, node.right, bounds)

        # The bounds of `not root`, splitting one disjunction by De Morgan as the producer does.
        def proof_kernel_replay_collect_negated_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            return if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if inner.kind == "binary" and inner.operator == "or":
                proof_kernel_replay_collect_negated_comparison(nodes, children, facts, inner.left, bounds)
                proof_kernel_replay_collect_negated_comparison(nodes, children, facts, inner.right, bounds)
                return
            proof_kernel_replay_collect_negated_comparison(nodes, children, facts, root, bounds)

        # The bounds of `not root` for a comparison `root`, read off its complemented operator.
        def proof_kernel_replay_collect_negated_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            return if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return if inner.kind != "binary"
            proof_kernel_replay_collect_bound_comparison(nodes, children, facts, inner.left, "!=", inner.right, bounds) if inner.operator == "=="
            proof_kernel_replay_collect_bound_comparison(nodes, children, facts, inner.left, "==", inner.right, bounds) if inner.operator == "!="
            proof_kernel_replay_collect_bound_comparison(nodes, children, facts, inner.left, ">=", inner.right, bounds) if inner.operator == "<"
            proof_kernel_replay_collect_bound_comparison(nodes, children, facts, inner.left, ">", inner.right, bounds) if inner.operator == "<="
            proof_kernel_replay_collect_bound_comparison(nodes, children, facts, inner.left, "<=", inner.right, bounds) if inner.operator == ">"
            proof_kernel_replay_collect_bound_comparison(nodes, children, facts, inner.left, "<", inner.right, bounds) if inner.operator == ">="

        # A call of a named function, never of a type marker, which the field-place rule may
        # generalize when a pure-call witness says it denotes one value.
        def proof_kernel_replay_named_call_term(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            # `auxiliary` counts the argument names the source wrote, none or one per argument.
            return false if nodes[root].kind != "call" or nodes[root].operator != ""
            return false if nodes[root].auxiliary != 0 and nodes[root].auxiliary != nodes[root].children_count
            callee: mutable sview = proof_kernel_replay_ident_name(nodes, nodes[root].left)
            # A module-qualified callee is a source function; markers are always bare names.
            callee <- nodes[nodes[root].left].name if callee == "" and proof_kernel_replay_valid(nodes, nodes[root].left) and nodes[nodes[root].left].kind == "scope"
            return false if callee == "" or callee == "__elisa_unsigned_type_bound" or callee == "__elisa_signed_type_bound" or callee == "__elisa_signed_place_type_bound"
            return callee != "__elisa_primitive_scalar_type" and callee != "__elisa_primitive_scalar_element" and callee != "__elisa_builtin_operator_type" and callee != "__elisa_untrusted_operator_type" and callee != "__elisa_builtin_index_type"
