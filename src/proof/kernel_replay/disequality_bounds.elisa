extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_DISEQUALITY_TIGHTEN_WORK_LIMIT: usize = 65536

        # Kernel mirror of `proof_tighten_disequality_bounds`: `x != c` at an interval endpoint
        # moves that endpoint one step inward. Only `ident != int` shapes (either order, or the
        # negated equality) are read, and only after the comparison is typed primitive.
        def proof_kernel_replay_tighten_disequality_bounds_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if work_used > work_limit
            disequalities: mutable darray[usize] = []
            for fact in facts |fact, nodes, disequalities, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                if fact < nodes.count and proof_kernel_replay_valid(nodes, fact):
                    if nodes[fact].kind == "binary":
                        return false if not proof_kernel_replay_equality_closure_charge_text_pair(work_used, nodes[fact].operator, "!=", work_limit)
                    elif nodes[fact].kind == "unary":
                        return false if not proof_kernel_replay_equality_closure_charge_text_pair(work_used, nodes[fact].operator, "not", work_limit)
                        if nodes[fact].left < nodes.count and proof_kernel_replay_valid(nodes, nodes[fact].left) and nodes[nodes[fact].left].kind == "binary":
                            return false if not proof_kernel_replay_equality_closure_charge_text_pair(work_used, nodes[nodes[fact].left].operator, "==", work_limit)
                is_disequality: bool = proof_kernel_replay_fact_is_disequality_with_work(nodes, fact, work_used, work_limit)
                return false if work_used > work_limit
                disequalities.push(fact) if is_disequality
            rounds: mutable usize = 0
            local_work_used: mutable usize = 0
            changed: mutable bool = true
            # Endpoint exclusions can cascade in an adversarial fact order: if each round scans
            # every disequality, D constraints can cause D full passes. Each successful step only
            # narrows a previously valid interval, so a work cap may stop with sound partial
            # bounds; it can lose a proof but cannot manufacture one.
            while changed and rounds < disequalities.count and local_work_used < PROOF_KERNEL_REPLAY_DISEQUALITY_TIGHTEN_WORK_LIMIT |rounds, changed, disequalities, facts, nodes, bounds, local_work_used, work_used, work_limit|:
                changed <- false
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                for fact in disequalities |fact, changed, facts, nodes, bounds, local_work_used, work_used, work_limit|:
                    break if local_work_used >= PROOF_KERNEL_REPLAY_DISEQUALITY_TIGHTEN_WORK_LIMIT
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    local_work_used <- local_work_used + 1
                    changed <- true if proof_kernel_replay_tighten_by_disequality_with_work(nodes, children, facts, fact, bounds, work_used, work_limit)
                    return false if work_used > work_limit
                rounds <- rounds + 1
            return true

        def proof_kernel_replay_fact_is_disequality_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "binary" and node.operator == "!="
            return false if node.kind != "unary" or node.operator != "not" or node.left >= nodes.count or not proof_kernel_replay_valid(nodes, node.left)
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            inner.kind == "binary" and inner.operator == "=="

        def proof_kernel_replay_tighten_by_disequality_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary":
                return false if not proof_kernel_replay_equality_closure_charge_text_pair(work_used, node.operator, "!=", work_limit)
            if node.kind == "binary" and node.operator == "!=":
                return proof_kernel_replay_tighten_named_disequality_with_work(nodes, children, facts, node.left, node.right, bounds, work_used, work_limit)
            return false if:
                not proof_kernel_replay_equality_closure_charge_text_pair(work_used, node.operator, "not", work_limit)
                node.kind != "unary" or node.operator != "not" or not proof_kernel_replay_valid(nodes, node.left)
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            return false if:
                not proof_kernel_replay_equality_closure_charge_text_pair(work_used, inner.operator, "==", work_limit)
                inner.kind != "binary" or inner.operator != "=="
            proof_kernel_replay_tighten_named_disequality_with_work(nodes, children, facts, inner.left, inner.right, bounds, work_used, work_limit)

        def proof_kernel_replay_tighten_named_disequality_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if:
                left >= nodes.count or right >= nodes.count
                not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, left, right, work_used, work_limit)
                work_used > work_limit
            name_root: mutable usize = left
            constant: mutable ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, work_limit)
            return false if work_used >= work_limit and not constant.known
            if nodes[left].kind != "ident" or nodes[left].name == "" or not constant.known:
                name_root <- right
                constant <- proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, work_limit)
            return false if work_used > work_limit or nodes[name_root].kind != "ident" or nodes[name_root].name == "" or not constant.known
            name: sview = nodes[name_root].name
            bound: ProofKernelReplayBound = proof_kernel_replay_bound_for_with_work(bounds, name, work_used, work_limit)
            return false if work_used > work_limit
            changed: mutable bool = false
            if bound.has_lower and bound.lower == constant.value:
                raised: ProofKernelReplayInt = proof_kernel_replay_add_safe(constant.value, 1)
                if raised.known:
                    return false if not proof_kernel_replay_add_lower_with_work(bounds, name, raised.value, work_used, work_limit)
                    changed <- true
            if bound.has_upper and bound.upper == constant.value:
                lowered: ProofKernelReplayInt = proof_kernel_replay_sub_safe(constant.value, 1)
                if lowered.known:
                    return false if not proof_kernel_replay_add_upper_with_work(bounds, name, lowered.value, work_used, work_limit)
                    changed <- true
            return changed
