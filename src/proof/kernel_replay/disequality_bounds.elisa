extend ElisaProofKernelReplay:
    private:
        # Kernel mirror of `proof_tighten_disequality_bounds`: `x != c` at an interval endpoint
        # moves that endpoint one step inward. Only `ident != int` shapes (either order, or the
        # negated equality) are read, and only after the comparison is typed primitive.
        def proof_kernel_replay_tighten_disequality_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            disequalities: mutable darray[usize] = []
            for fact in facts |fact, nodes, disequalities|:
                disequalities.push(fact) if proof_kernel_replay_fact_is_disequality(nodes, fact)
            rounds: mutable usize = 0
            changed: mutable bool = true
            while changed and rounds < disequalities.count |rounds, changed, disequalities, facts, nodes, bounds|:
                changed <- false
                for fact in disequalities |fact, changed, facts, nodes, bounds|:
                    changed <- true if proof_kernel_replay_tighten_by_disequality(nodes, children, facts, fact, bounds)
                rounds <- rounds + 1

        def proof_kernel_replay_fact_is_disequality(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "binary" and node.operator == "!="
            return false if node.kind != "unary" or node.operator != "not" or not proof_kernel_replay_valid(nodes, node.left)
            return nodes[node.left].kind == "binary" and nodes[node.left].operator == "=="

        def proof_kernel_replay_tighten_by_disequality(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, bounds: mutable darray[ProofKernelReplayBound]&) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "!=":
                return proof_kernel_replay_tighten_named_disequality(nodes, children, facts, node.left, node.right, bounds)
            return false if node.kind != "unary" or node.operator != "not" or not proof_kernel_replay_valid(nodes, node.left)
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            return false if inner.kind != "binary" or inner.operator != "=="
            return proof_kernel_replay_tighten_named_disequality(nodes, children, facts, inner.left, inner.right, bounds)

        def proof_kernel_replay_tighten_named_disequality(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, bounds: mutable darray[ProofKernelReplayBound]&) -> bool:
            return false if left >= nodes.count or right >= nodes.count
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, left, right)
            name_root: mutable usize = left
            constant: mutable ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right, 0)
            if nodes[left].kind != "ident" or nodes[left].name == "" or not constant.known:
                name_root <- right
                constant <- proof_kernel_replay_constant_int(nodes, left, 0)
            return false if nodes[name_root].kind != "ident" or nodes[name_root].name == "" or not constant.known
            name: sview = nodes[name_root].name
            bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, name)
            changed: mutable bool = false
            if bound.has_lower and bound.lower == constant.value:
                raised: ProofKernelReplayInt = proof_kernel_replay_add_safe(constant.value, 1)
                if raised.known:
                    proof_kernel_replay_add_lower(bounds, name, raised.value)
                    changed <- true
            if bound.has_upper and bound.upper == constant.value:
                lowered: ProofKernelReplayInt = proof_kernel_replay_sub_safe(constant.value, 1)
                if lowered.known:
                    proof_kernel_replay_add_upper(bounds, name, lowered.value)
                    changed <- true
            return changed

        # Mirror of `proof_facts_state_disequality`: a top-level `l != r`, `r != l` or `not (l == r)`.
        def proof_kernel_replay_facts_state_disequality(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize) -> bool:
            for fact in facts |fact, nodes, children, left, right|:
                if fact < nodes.count and proof_kernel_replay_valid(nodes, fact):
                    pair: mutable usize = fact
                    if nodes[fact].kind == "unary" and nodes[fact].operator == "not" and nodes[fact].left < nodes.count and proof_kernel_replay_valid(nodes, nodes[fact].left):
                        pair <- nodes[fact].left if nodes[nodes[fact].left].kind == "binary" and nodes[nodes[fact].left].operator == "=="
                    diseq: bool = pair != fact or nodes[fact].kind == "binary" and nodes[fact].operator == "!="
                    # `pair` is in range on both paths; the explicit test keeps that local to the
                    # read, so replay need not carry it across the conditional rebind.
                    if diseq and pair < nodes.count:
                        a: usize = nodes[pair].left
                        b: usize = nodes[pair].right
                        return true if proof_kernel_replay_expr_equal(nodes, children, a, left, 0) and proof_kernel_replay_expr_equal(nodes, children, b, right, 0)
                        return true if proof_kernel_replay_expr_equal(nodes, children, a, right, 0) and proof_kernel_replay_expr_equal(nodes, children, b, left, 0)
            return false
