extend ElisaProofKernelReplay:
    private:
        struct ProofKernelReplayResourcePlace:
            # Root names stay owned by the replay arena. Store a stable node index instead of
            # copying an untracked string view into resource state.
            has_root: bool
            root_node: usize
            # The path is an index into the source-neutral arena's field chain. Keeping an
            # arena index rather than a heap-backed darray makes resource places safe to store
            # in replay state while retaining exact structural identity.
            path_root: usize
            depth: usize
            whole: bool

        struct ProofKernelReplayResourceEffect:
            kind: sview
            place: ProofKernelReplayResourcePlace

        # One lent argument of a lend call. The three facts about it -- the place, whether that
        # place was resolved, and whether the formal is exclusive -- were three arrays pushed in
        # lockstep, so every read of one owed an index obligation against a length nothing related
        # to the others'. One array of records owes one.
        struct ProofKernelReplayLentArgument:
            place: ProofKernelReplayResourcePlace
            known: bool
            exclusive: bool

        # A call-site region substitution stays inside the validated kernel arena. Keeping node
        # indices instead of copying their `sview` fields preserves the arena's existing
        # provenance and avoids creating a second, untracked lifetime for the same region names.
        struct ProofKernelReplayLentRegion:
            mapping_node: usize

        def proof_kernel_replay_resource_empty_place() -> ProofKernelReplayResourcePlace:
            return ProofKernelReplayResourcePlace{has_root: false, root_node: 0, path_root: 0, depth: 0, whole: false}

        def proof_kernel_replay_resource_place_root_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, place: ProofKernelReplayResourcePlace) -> bool:
            return false if not place.has_root
            return false if place.root_node >= nodes.count
            return nodes[place.root_node].name != ""

        def proof_kernel_replay_resource_place_root_matches(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, place: ProofKernelReplayResourcePlace, name: sview) -> bool:
            return false if not proof_kernel_replay_resource_place_root_valid(nodes, place)
            return nodes[place.root_node].name == name

        def proof_kernel_replay_resource_place_add_field(parent: ProofKernelReplayResourcePlace, field: sview, field_root: usize) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if not parent.has_root or field == "" or parent.depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return (true, ProofKernelReplayResourcePlace{has_root: parent.has_root, root_node: parent.root_node, path_root: field_root, depth: parent.depth + 1, whole: false})

        def proof_kernel_replay_resource_place_add_index(parent: ProofKernelReplayResourcePlace, path_root: usize) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if not parent.has_root or parent.depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return (true, ProofKernelReplayResourcePlace{has_root: parent.has_root, root_node: parent.root_node, path_root: path_root, depth: parent.depth + 1, whole: false})

        # Field chains are stored outermost-first in the arena (`a.b.c` points at `c`, whose
        # left edge points at `a.b`). Recovering a component by ordinal keeps prefix checking
        # exact without hashing or putting an owned container in every place value.
        def proof_kernel_replay_resource_index_expression_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "int" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""
            return true if node.kind == "ident" and node.name != "" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.secondary_name == ""
            if node.kind == "unary" and (node.operator == "+" or node.operator == "-"):
                return node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "" and proof_kernel_replay_resource_index_expression_valid(nodes, node.left, depth + 1)
            if node.kind == "binary" and (node.operator == "+" or node.operator == "-" or node.operator == "*"):
                return node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "" and proof_kernel_replay_resource_index_expression_valid(nodes, node.left, depth + 1) and proof_kernel_replay_resource_index_expression_valid(nodes, node.right, depth + 1)
            return false

        def proof_kernel_replay_resource_path_component(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, path_root: usize, position: usize, depth: usize) -> (known: bool, kind: sview, field: sview, value: i64, expression_root: usize):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases depth
            return (false, "", "", 0, 0) if depth == 0 or path_root >= nodes.count or not proof_kernel_replay_valid(nodes, path_root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[path_root]
            if position + 1 == depth:
                return (true, "field", node.name, 0, 0) if node.kind == "field" and node.name != ""
                if node.kind == "index" and node.right < nodes.count:
                    index_value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                    return (true, "index", "", index_value.value, node.right) if index_value.known
                    return (true, "index", "", 0, node.right) if proof_kernel_replay_resource_index_expression_valid(nodes, node.right, 0)
                return (false, "", "", 0, 0)
            return (false, "", "", 0, 0) if position >= depth - 1
            return proof_kernel_replay_resource_path_component(nodes, node.left, position, depth - 1) if node.kind == "field" or node.kind == "index"
            return (false, "", "", 0, 0)

        # Compose a source place relative to an origin place. This is the small piece that lets
        # a callee's `parameter.field` effect become the caller's `argument.field` effect while
        # retaining the same bounded, fail-closed path representation.
        def proof_kernel_replay_resource_place_append[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, parent: ProofKernelReplayResourcePlace, relative: ProofKernelReplayResourcePlace) -> (known: bool, place: ProofKernelReplayResourcePlace):
            return (false, proof_kernel_replay_resource_empty_place()) if not proof_kernel_replay_resource_place_root_valid(nodes, parent) or not proof_kernel_replay_resource_place_root_valid(nodes, relative) or relative.depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND
            assert(relative.depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
            return (false, proof_kernel_replay_resource_empty_place()) if parent.depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return (false, proof_kernel_replay_resource_empty_place()) if relative.depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - parent.depth
            result_path_root: mutable usize = parent.path_root
            result_depth: mutable usize = parent.depth
            result_whole: mutable bool = parent.whole
            for index in 0..<relative.depth |index, nodes, result_path_root, result_depth, result_whole, relative|:
                component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_kernel_replay_resource_path_component(nodes, relative.path_root, index, relative.depth)
                return (false, proof_kernel_replay_resource_empty_place()) if not component.known
                if component.kind == "field":
                    result_path_root <- ElisaProofKernelCore::add_node(nodes, "field", "", result_path_root if result_depth > 0 else 0, 0, 0, 0, 0, 0, component.field, "")
                elif component.kind == "index":
                    result_path_root <- ElisaProofKernelCore::add_node(nodes, "index", "", result_path_root if result_depth > 0 else 0, component.expression_root, 0, 0, 0, 0, "", "")
                else:
                    return (false, proof_kernel_replay_resource_empty_place())
                result_depth <- result_depth + 1
                result_whole <- false
            return (true, ProofKernelReplayResourcePlace{has_root: parent.has_root, root_node: parent.root_node, path_root: result_path_root, depth: result_depth, whole: result_whole})

        def proof_kernel_replay_resource_place(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> (known: bool, place: ProofKernelReplayResourcePlace):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND - depth
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident":
                return (node.name != "", ProofKernelReplayResourcePlace{has_root: node.name != "", root_node: root, path_root: 0, depth: 0, whole: true})
            if node.kind == "field":
                parent: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, depth + 1)
                return proof_kernel_replay_resource_place_add_field(parent.place, node.name, root) if parent.known
            if node.kind == "index":
                parent: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, depth + 1)
                return (false, empty) if not parent.known
                return (false, empty) if not proof_kernel_replay_resource_index_expression_valid(nodes, node.right, 0)
                return proof_kernel_replay_resource_place_add_index(parent.place, root)
            if node.kind == "index-n":
                return (false, empty) if node.children_start > children.count or node.children_count == 0 or node.children_count > children.count - node.children_start
                parent: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, depth + 1)
                return (false, empty) if not parent.known
                result: mutable ProofKernelReplayResourcePlace = parent.place
                for offset in 0..<node.children_count |offset, node, children, nodes, result|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + offset)
                    return (false, empty) if not child.known
                    index_root: usize = ElisaProofKernelCore::add_node(nodes, "index", "", result.path_root if result.depth > 0 else 0, child.value, 0, 0, 0, 0, "", "")
                    next: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place_add_index(result, index_root)
                    return (false, empty) if not next.known
                    result <- next.place
                return (true, result)
            return (false, empty)
