extend ElisaProofKernelReplay:
    public:
    # A checked-index certificate proves the memory-safety boundary supplied by Elisa's
    # `get collection[index] else fallback` operator. It is separate from arithmetic
    # goal replay: the selected element remains opaque, while replay validates only the
    # guarded load/fallback shape.
    def proof_kernel_replay_checked_index_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
        return (proof_kernel_replay_checked_index_report_impl(nodes, children, facts, goal_root, false) can Global{Read,Write})

    def proof_kernel_replay_checked_index_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
        return false if facts.count != 0 or not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
        return (proof_kernel_replay_checked_index_report_impl(nodes, children, facts, goal_root, true) can Global{Read,Write})

    # A checked-get certificate proves the memory-safety boundary of
    # `get collection[index] else <control recovery>`. The recovery's termination and
    # state isolation are checked separately by the source-level control-flow pass.
    def proof_kernel_replay_checked_get_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
        return (proof_kernel_replay_checked_get_report_impl(nodes, children, facts, goal_root, false) can Global{Read,Write})

    def proof_kernel_replay_checked_get_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
        return false if facts.count != 0 or not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
        return (proof_kernel_replay_checked_get_report_impl(nodes, children, facts, goal_root, true) can Global{Read,Write})

    def proof_kernel_replay_quantifier_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, kind: sview, facts: darray[usize], goal_root: usize) -> bool:
        return (proof_kernel_replay_quantifier_report_impl(nodes, children, kind, facts, goal_root, false) can Global{Read,Write})

    def proof_kernel_replay_quantifier_report_checked_arena[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, kind: sview, facts: darray[usize], goal_root: usize) -> bool:
        return false if not (proof_kernel_replay_checked_arena_inputs_valid(nodes, children, facts, goal_root) can Global{Read,Write})
        return (proof_kernel_replay_quantifier_report_impl(nodes, children, kind, facts, goal_root, true) can Global{Read,Write})
