# Value resolution uses a compact base index and a reverse-scanned lexical overlay.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_find_value_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, name: sview, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            return proof_kernel_replay_find_owned_value_binding(environment, index, name, 0, work)

        # Bindings are selected by exact module owner. Local lexical rows shadow globals.
        def proof_kernel_replay_find_owned_value_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, name: sview, owner_identity: usize, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            ensure result.known implies work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            ensure result.known implies (
                result.binding.name == name
                and result.binding.owner_type_identity == owner_identity
                and (result.binding.kind in {"value", "reference-value", "raw-reference-value", "proposition"})
            )
            empty: ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = empty
            local_found: mutable bool = false
            local_ambiguous: mutable bool = false
            local_selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = empty
            global_count: usize = environment.global_bindings.count
            found: mutable bool = false
            ambiguous: mutable bool = false
            return (false, selected) if index.source_binding_count != proof_kernel_replay_type_environment_binding_count(environment) or index.value_binding_count > index.value_binding_indices.count or index.value_overlay_start > environment.bindings.count or index.value_overlay_count > environment.bindings.count - index.value_overlay_start
            for offset in 0..<index.value_overlay_count |offset, environment, index, name, owner_identity, selected, work|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                local_index: usize = index.value_overlay_start + index.value_overlay_count - offset - 1
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = environment.bindings[local_index]
                kind_valid: bool = binding.kind in {"value", "reference-value", "raw-reference-value", "proposition"}
                return (false, selected) if not kind_valid
                if binding.owner_type_identity == owner_identity and proof_kernel_replay_type_text_equal(binding.name, name, work):
                    # Reverse order gives lexical shadowing. A paired frame's duplicate names
                    # are rejected before the overlay is extended.
                    return (true, binding)
            for value_offset in 0..<index.value_binding_count |value_offset, environment, index, name, owner_identity, global_count, found, ambiguous, selected, local_found, local_ambiguous, local_selected, work|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding_index: usize = index.value_binding_indices[value_offset]
                return (false, selected) if binding_index >= index.source_binding_count
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                kind_valid: bool = binding.kind in {"value", "reference-value", "raw-reference-value", "proposition"}
                return (false, selected) if not kind_valid
                if proof_kernel_replay_type_text_equal(binding.name, name, work) and binding.owner_type_identity == owner_identity:
                    if binding_index >= global_count:
                        if not local_found:
                            local_selected <- binding
                            local_found <- true
                        elif not proof_kernel_replay_typing_evidence_equal(local_selected, binding, work):
                            local_ambiguous <- true
                    elif not found:
                        selected <- binding
                        found <- true
                    elif not proof_kernel_replay_typing_evidence_equal(selected, binding, work):
                        ambiguous <- true
            return (false, selected) if work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return (not local_ambiguous, local_selected) if local_found
            return (found and not ambiguous, selected)
