extend ElisaProofKernelReplay:
    private:
        # A call that lends only references the caller already holds. Every permission is derived
        # from the recorded parameter modes and the lent places, so no callee trace is needed --
        # which is the only way a recursive component can be checked, since it can never consume a
        # summary it is still computing. A shared formal exports nothing. An exclusive formal
        # exports a write to the whole lent place: the summary composer refuses any callee effect
        # that is not a write rooted at a mutable formal, so the whole-place write subsumes every
        # effect a summary for this callee could ever have produced.
        def proof_kernel_replay_resource_lend[@r, @e, @s](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, state: mutable ProofKernelReplayResourceState& @s, effects: mutable darray[ProofKernelReplayResourceEffect]& @e, lend_root: usize) -> bool:
            return false if:
                lend_root >= nodes.count
                nodes[lend_root].kind != "resource-call-lend"
                nodes[lend_root].children_count != nodes[lend_root].auxiliary * 2 + nodes[lend_root].right
                not proof_kernel_replay_child_range_valid(nodes[lend_root].children_start, nodes[lend_root].children_count, children.count)
            # A region-polymorphic callee may allocate into a mapped caller region, which the
            # caller cannot observe, and cannot close it: the region is external in the callee's
            # own frame and no trace may close an external region. Every mapped lifetime must name
            # a distinct formal region and resolve to a region active right here.
            lend_regions: mutable darray[ProofKernelReplayLentRegion] = []
            for region_index in 0..<nodes[lend_root].right |region_index, lend_root, children, nodes, state, lend_regions|:
                region_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[lend_root].children_start + nodes[lend_root].auxiliary * 2 + region_index)
                return false if:
                    not region_child.known
                    region_child.value >= nodes.count
                    not proof_kernel_replay_resource_charge_node_text(state, nodes[region_child.value])
                    nodes[region_child.value].kind != "resource-call-region" or nodes[region_child.value].operator != "param"
                    nodes[region_child.value].name == "" or nodes[region_child.value].secondary_name == ""
                for prior in lend_regions |prior, nodes, region_child|:
                    return false if:
                        prior.mapping_node >= nodes.count
                        not proof_kernel_replay_resource_charge_text_pair(state, nodes[prior.mapping_node].name, nodes[region_child.value].name)
                        nodes[prior.mapping_node].name == nodes[region_child.value].name
                return false if not proof_kernel_replay_resource_region_active(state, nodes[region_child.value].secondary_name)
                lend_regions.push(ProofKernelReplayLentRegion{mapping_node: region_child.value})
            lent: mutable darray[ProofKernelReplayLentArgument] = []
            for index in 0..<nodes[lend_root].auxiliary |index, lend_root, children, nodes, state, lent|:
                actual_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[lend_root].children_start + index)
                formal_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, nodes[lend_root].children_start + nodes[lend_root].auxiliary + index)
                return false if:
                    not actual_child.known or not formal_child.known
                    actual_child.value >= nodes.count or formal_child.value >= nodes.count
                    not proof_kernel_replay_resource_charge_node_text(state, nodes[actual_child.value])
                    not proof_kernel_replay_resource_charge_node_text(state, nodes[formal_child.value])
                    nodes[actual_child.value].kind != "resource-call-arg" or nodes[formal_child.value].kind != "resource-call-formal"
                # The actual and the mode must describe the same formal, or the modes could be
                # permuted until every exclusive one lands on a scalar.
                return false if nodes[formal_child.value].name == "" or nodes[formal_child.value].name != nodes[actual_child.value].name
                exclusive: bool = nodes[formal_child.value].operator == "external-mutable"
                # A fresh region allocation is not a lend: its lifetime is the callee's, which is
                # exactly what needs the callee's own trace.
                return false if nodes[actual_child.value].operator == "region-new"
                actual: (known: bool, place: ProofKernelReplayResourcePlace, slot: usize, has_slot: bool, mutable_reference: bool) = proof_kernel_replay_resource_call_actual(state, nodes, children, actual_child.value, false)
                return false if not actual.known
                # A region-annotated formal must be pinned to the caller region its actual already
                # carries, or the callee is handed a lifetime the caller never established.
                if nodes[formal_child.value].secondary_name != "":
                    mapped_region_node: mutable usize = nodes.count
                    for mapping in lend_regions |mapping, nodes, formal_child, mapped_region_node|:
                        return false if:
                            mapping.mapping_node >= nodes.count
                            not proof_kernel_replay_resource_charge_text_pair(state, nodes[mapping.mapping_node].name, nodes[formal_child.value].secondary_name)
                        if nodes[mapping.mapping_node].name == nodes[formal_child.value].secondary_name:
                            return false if mapped_region_node != nodes.count
                            mapped_region_node <- mapping.mapping_node
                    return false if mapped_region_node >= nodes.count
                    # `has_slot` marks a reference actual specifically; a borrow actual resolves a
                    # binding slot too, and its region is just as much the caller's claim.
                    return false if actual.slot >= state.bindings.binding_names.count
                    actual_region: sview = proof_kernel_replay_resource_binding_region(state, actual.slot)
                    mapped_region: sview = nodes[mapped_region_node].secondary_name
                    return false if:
                        not proof_kernel_replay_resource_charge_text_pair(state, actual_region, mapped_region)
                        actual_region != mapped_region
                lent.push(ProofKernelReplayLentArgument{place: proof_kernel_replay_resource_empty_place(), known: false, exclusive: exclusive})
                # A by-value formal receives no capability, so the actual must not be one either:
                # otherwise the call would be a move and the caller state would change.
                if nodes[formal_child.value].operator != "external-shared" and not exclusive:
                    return false if nodes[actual_child.value].operator != "value"
                    continue
                # A shared formal may use Elisa's implicit-borrow spelling, recorded as
                # `value`; unlike the old fast-path, it must still resolve below to a tracked
                # caller place. Exclusive formals require explicit borrow/reference syntax.
                return false if:
                    exclusive and nodes[actual_child.value].operator != "borrow" and nodes[actual_child.value].operator != "reference"
                    not exclusive and nodes[actual_child.value].operator != "value" and nodes[actual_child.value].operator != "borrow" and nodes[actual_child.value].operator != "reference"
                if nodes[actual_child.value].operator == "value":
                    return false if exclusive or not actual.has_slot or not proof_kernel_replay_resource_binding_allows_implicit_shared_borrow(state, actual.slot, actual.place)
                return false if not proof_kernel_replay_resource_place_root_valid(nodes, actual.place)
                lent[lent.count - 1] <- ProofKernelReplayLentArgument{place: actual.place, known: true, exclusive: exclusive}
                if exclusive:
                    # The callee may write through this one, so the caller must hold the
                    # permission to write the whole place, and no other borrow may be live on it.
                    if nodes[actual_child.value].operator == "reference":
                        return false if not actual.mutable_reference
                    else:
                        if actual.slot < state.bindings.binding_reference.count and state.bindings.binding_reference[actual.slot]:
                            return false if not actual.mutable_reference
                        else:
                            return false if actual.slot >= state.bindings.binding_writable.count or not state.bindings.binding_writable[actual.slot]
                    return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, actual.place, state.bindings.binding_names.count)
                else:
                    # No borrow is excluded here, unlike the summary path: without a callee
                    # summary there is nothing that says the callee reads only through the very
                    # reference being reborrowed, so any live exclusive borrow of the lent place
                    # refuses the event.
                    return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, actual.place, state.bindings.binding_names.count)
            # Every lent capability is live at once while the callee runs, so two of them may
            # overlap only when neither is exclusive.
            for left_index in 0..<lent.count |left_index, lent, state, nodes|:
                return false if not proof_kernel_replay_resource_charge_work(state, 1)
                left_argument: ProofKernelReplayLentArgument = lent[left_index]
                continue if not left_argument.known
                for right_index in 0..<lent.count |right_index, left_index, left_argument, lent, state, nodes|:
                    return false if not proof_kernel_replay_resource_charge_work(state, 1)
                    continue if right_index <= left_index
                    right_argument: ProofKernelReplayLentArgument = lent[right_index]
                    continue if not right_argument.known
                    continue if not left_argument.exclusive and not right_argument.exclusive
                    return false if proof_kernel_replay_resource_places_overlap(state, nodes, left_argument.place, right_argument.place)
            for index in 0..<lent.count |index, lent, state, nodes, effects|:
                return false if not proof_kernel_replay_resource_charge_work(state, 1)
                argument_lent: ProofKernelReplayLentArgument = lent[index]
                continue if not argument_lent.known or not argument_lent.exclusive
                owner_slot: usize = proof_kernel_replay_resource_lookup_place(state, nodes, argument_lent.place)
                return false if owner_slot >= state.bindings.binding_names.count
                owner_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_resolve_origin(nodes, state, argument_lent.place, nodes[argument_lent.place.root_node].name)
                effects.push(ProofKernelReplayResourceEffect{kind: "write", place: owner_origin.place}) if owner_origin.known
            return true
