# Goal-search work-bounded replay for `x != a or x != b` when `a` and `b`
# are distinct literals representable in the exact primitive type of `x`.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_signed_disequality_constant_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> (known: bool, term: usize, value: i64):
            empty: (known: bool, term: usize, value: i64) = (false, 0, 0)
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary: bool = proof_kernel_replay_goal_search_text_equal(comparison.kind, "binary", work_used)
            disequality: bool = proof_kernel_replay_goal_search_text_equal(comparison.operator, "!=", work_used)
            return empty if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary or not disequality
                comparison.left >= nodes.count or comparison.right >= nodes.count
            relation_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return empty if not relation_admission.complete or relation_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            width: i64 = proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes, children, facts, comparison.left, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            constant: ProofKernelReplayInt = proof_kernel_replay_signed_literal_with_goal_work(nodes, comparison.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_signed_value_fits_goal_work(width, constant)
            primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, comparison.left, comparison.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            (true, comparison.left, constant.value)

        def proof_kernel_replay_unsigned_disequality_constant_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> (known: bool, term: usize, value: i64):
            empty: (known: bool, term: usize, value: i64) = (false, 0, 0)
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary: bool = proof_kernel_replay_goal_search_text_equal(comparison.kind, "binary", work_used)
            disequality: bool = proof_kernel_replay_goal_search_text_equal(comparison.operator, "!=", work_used)
            return empty if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary or not disequality
                comparison.left >= nodes.count or comparison.right >= nodes.count
            relation_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return empty if not relation_admission.complete or relation_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, comparison.left, facts, work_used, 0)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, comparison.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_unsigned_literal_fits_with_goal_work(nodes, comparison.right, width, constant)
            primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, comparison.left, comparison.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            (true, comparison.left, constant.value)

        def proof_kernel_replay_distinct_disequality_disjunction_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            disjunction: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "or", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary or not disjunction
                goal.left >= nodes.count or goal.right >= nodes.count
            first: (known: bool, term: usize, value: i64) = proof_kernel_replay_signed_disequality_constant_with_goal_work(nodes, children, facts, goal.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            second: (known: bool, term: usize, value: i64) = proof_kernel_replay_signed_disequality_constant_with_goal_work(nodes, children, facts, goal.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            same_signed_term: bool = first.known and second.known and first.value != second.value and proof_kernel_replay_goal_search_expr_equal(nodes, children, first.term, second.term, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if same_signed_term
            first_unsigned: (known: bool, term: usize, value: i64) = proof_kernel_replay_unsigned_disequality_constant_with_goal_work(nodes, children, facts, goal.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            second_unsigned: (known: bool, term: usize, value: i64) = proof_kernel_replay_unsigned_disequality_constant_with_goal_work(nodes, children, facts, goal.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            same_unsigned_term: bool = first_unsigned.known and second_unsigned.known and first_unsigned.value != second_unsigned.value and proof_kernel_replay_goal_search_expr_equal(nodes, children, first_unsigned.term, second_unsigned.term, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            same_unsigned_term
