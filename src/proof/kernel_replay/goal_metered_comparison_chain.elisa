extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_chain_step_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, fact: usize, anchor: usize, from_lower: bool, facts: darray[usize], work_used: mutable usize&) -> (known: bool, middle: usize, operator: sview):
            unknown: (known: bool, middle: usize, operator: sview) = (false, 0, "")
            return unknown if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
            return unknown if not located.known
            binary: bool = proof_kernel_replay_goal_search_text_equal(located.node.kind, "binary", work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if binary:
                equality: bool = proof_kernel_replay_goal_search_text_equal(located.node.operator, "==", work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if equality:
                    if from_lower:
                        left_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, located.node.left, anchor, work_used)
                        return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return (true, located.node.right, "<=") if left_matches
                        right_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, located.node.right, anchor, work_used)
                        return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return (true, located.node.left, "<=") if right_matches
                    else:
                        right_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, located.node.right, anchor, work_used)
                        return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return (true, located.node.left, "<=") if right_matches
                        left_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, located.node.left, anchor, work_used)
                        return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return (true, located.node.right, "<=") if left_matches
                    return unknown
            elif located.node.kind == "unary" and located.node.operator == "not":
                return unknown if not proof_kernel_replay_goal_search_charge_node_text(nodes, located.node.left, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_work(nodes, children, facts, fact, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not order.known
            less: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<", work_used)
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<=", work_used)
            greater: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">", work_used)
            greater_equal: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">=", work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (not less and not less_equal and not greater and not greater_equal)
            low: usize = order.left if less or less_equal else order.right
            high: usize = order.right if less or less_equal else order.left
            strict: bool = less or greater
            if from_lower:
                matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, low, anchor, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, high, "<") if matches and strict
                return (true, high, "<=") if matches
            else:
                matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, high, anchor, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, low, "<") if matches and strict
                return (true, low, "<=") if matches
            unknown

        def proof_kernel_replay_chain_equal_other_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, fact: usize, anchor: usize, work_used: mutable usize&) -> (known: bool, value: usize):
            unknown: (known: bool, value: usize) = (false, 0)
            return unknown if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            equality: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, fact, "==", work_used)
            return unknown if not equality.known
            left_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, equality.left, anchor, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, equality.right, anchor, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, equality.right) if left_matches and not right_matches
            return (true, equality.left) if right_matches and not left_matches
            unknown

        def proof_kernel_replay_chain_equal_hops_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], anchor: usize, from_lower: bool, middles: mutable darray[usize]&, operators: mutable darray[sview]&, markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, work_used: mutable usize&) -> void:
            for equality in facts |equality, nodes, children, facts, anchor, from_lower, middles, operators, markers, markers_ready, work_used|:
                return if middles.count >= PROOF_KERNEL_REPLAY_CHAIN_CANDIDATE_BUDGET or not proof_kernel_replay_goal_search_charge(work_used)
                other: (known: bool, value: usize) = proof_kernel_replay_chain_equal_other_with_work(nodes, children, equality, anchor, work_used)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not other.known
                if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                    chain_marker_cache_complete: bool = proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not chain_marker_cache_complete
                    markers_ready <- true
                scalar: bool = proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, other.value, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not scalar
                for fact in facts |fact, nodes, children, facts, other, from_lower, middles, operators, work_used|:
                    return if middles.count >= PROOF_KERNEL_REPLAY_CHAIN_CANDIDATE_BUDGET or not proof_kernel_replay_goal_search_charge(work_used)
                    step: (known: bool, middle: usize, operator: sview) = proof_kernel_replay_chain_step_with_work(nodes, children, fact, other.value, from_lower, facts, work_used)
                    return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if step.known:
                        middles.push(step.middle)
                        operators.push(step.operator)

        def proof_kernel_replay_chain_discharges_with_work(first: sview, second: sview, goal_strict: bool, work_used: mutable usize&) -> bool:
            first_strict: bool = proof_kernel_replay_goal_search_text_equal(first, "<", work_used)
            second_strict: bool = proof_kernel_replay_goal_search_text_equal(second, "<", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            first_strict or second_strict or not goal_strict

        def proof_kernel_replay_comparison_chain_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, operator: sview, right: usize, work_used: mutable usize&) -> bool:
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            goal_less: bool = proof_kernel_replay_goal_search_text_equal(operator, "<", work_used)
            goal_less_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, "<=", work_used)
            goal_greater: bool = proof_kernel_replay_goal_search_text_equal(operator, ">", work_used)
            goal_greater_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, ">=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (not goal_less and not goal_less_equal and not goal_greater and not goal_greater_equal)
            goal_strict: bool = goal_less or goal_greater
            lower: usize = right if goal_greater or goal_greater_equal else left
            upper: usize = left if goal_greater or goal_greater_equal else right
            return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, lower, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, upper, work_used)
            lower_affine: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, lower, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            upper_affine: ProofKernelReplayAffine = proof_kernel_replay_affine_expression_with_work(nodes, upper, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            lower_named: bool = lower_affine.known and not proof_kernel_replay_goal_search_text_equal(lower_affine.base, "", work_used)
            upper_named: bool = upper_affine.known and not proof_kernel_replay_goal_search_text_equal(upper_affine.base, "", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (lower_named and upper_named)
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            markers_ready <- true
            primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, lower, upper, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            lower_middles: mutable darray[usize] = []
            lower_operators: mutable darray[sview] = []
            for fact in facts |fact, nodes, children, facts, lower, lower_middles, lower_operators, work_used|:
                break if lower_middles.count >= PROOF_KERNEL_REPLAY_CHAIN_CANDIDATE_BUDGET
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                step: (known: bool, middle: usize, operator: sview) = proof_kernel_replay_chain_step_with_work(nodes, children, fact, lower, true, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if step.known:
                    lower_middles.push(step.middle)
                    lower_operators.push(step.operator)
            proof_kernel_replay_chain_equal_hops_with_work(nodes, children, facts, lower, true, &lower_middles, &lower_operators, &markers, &markers_ready, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or lower_middles.count == 0
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            upper_middles: mutable darray[usize] = [upper]
            upper_operators: mutable darray[sview] = ["<="]
            for fact in facts |fact, nodes, children, facts, upper, upper_middles, upper_operators, work_used|:
                break if upper_middles.count >= PROOF_KERNEL_REPLAY_CHAIN_CANDIDATE_BUDGET
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                step: (known: bool, middle: usize, operator: sview) = proof_kernel_replay_chain_step_with_work(nodes, children, fact, upper, false, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if step.known:
                    upper_middles.push(step.middle)
                    upper_operators.push(step.operator)
            proof_kernel_replay_chain_equal_hops_with_work(nodes, children, facts, upper, false, &upper_middles, &upper_operators, &markers, &markers_ready, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for first_index in 0..<lower_middles.count |first_index, nodes, children, facts, goal_strict, lower_middles, lower_operators, upper_middles, upper_operators, markers, markers_ready, work_used|:
                for second_index in 0..<upper_middles.count |second_index, first_index, nodes, children, facts, goal_strict, lower_middles, lower_operators, upper_middles, upper_operators, markers, markers_ready, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    compatible: bool = proof_kernel_replay_chain_discharges_with_work(lower_operators[first_index], upper_operators[second_index], goal_strict, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not compatible
                    same_middle: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, lower_middles[first_index], upper_middles[second_index], work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_middle
                    if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                        return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        markers_ready <- true
                    scalar: bool = proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, lower_middles[first_index], 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if scalar
            false
