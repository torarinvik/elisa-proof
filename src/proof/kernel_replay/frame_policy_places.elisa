# Canonical frame place decoding. These nodes are not yet admitted by the
# general arena dispatcher; this boundary prepares the frame certificate rule.
extend ElisaProofKernelFramePolicy:
    public:
        def decode_place(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, parameter_count: usize) -> (known: bool, place: Place):
            empty: Place = Place{parameter: 0, depth: 0, field: "", field2: "", field3: ""}
            return (false, empty) if root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, empty) if node.kind != "frame-place" or node.operator != "frame-place-v1"
            return (false, empty) if node.left != 0 or node.right != 0 or node.value != 0 or node.name != "" or node.secondary_name != ""
            return (false, empty) if node.children_count > 3 or node.children_start > children.count or node.children_count > children.count - node.children_start
            return (false, empty) if node.children_count == 0 and node.children_start != 0
            field: mutable sview = ""
            field2: mutable sview = ""
            field3: mutable sview = ""
            for index in 0..<node.children_count |index, node, children, nodes, root, field, field2, field3|:
                selector_root: usize = children[node.children_start + index]
                # Strict backward edges prevent cycles and references to a future place.
                return (false, empty) if selector_root >= root
                selector: ElisaProofKernelCore::ProofKernelNode = nodes[selector_root]
                return (false, empty) if selector.kind != "frame-field" or selector.operator != "" or selector.left != 0 or selector.right != 0 or selector.auxiliary != 0 or selector.value != 0
                return (false, empty) if selector.children_start != 0 or selector.children_count != 0 or selector.name == "" or selector.secondary_name != ""
                field <- selector.name if index == 0
                field2 <- selector.name if index == 1
                field3 <- selector.name if index == 2
            decoded: Place = Place{parameter: node.auxiliary, depth: node.children_count, field: field, field2: field2, field3: field3}
            return (false, empty) if not place_valid(decoded, parameter_count)
            return (true, decoded)

        # Field-only canonical shape checks for the general arena walker. Child
        # kinds and backward edges are validated by that walk, not by flags here.
        def arena_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            if node.kind == "frame-field":
                return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "frame-place":
                return node.operator == "frame-place-v1" and node.left == 0 and node.right == 0 and node.auxiliary < FRAME_POLICY_PLACE_LIMIT and node.children_count <= 3 and (node.children_count > 0 or node.children_start == 0) and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "frame-policy":
                return false if node.secondary_name != "frame-policy-v1" or node.name == "" or node.value != 0 or node.auxiliary == 0 or node.auxiliary > FRAME_POLICY_PLACE_LIMIT
                return false if node.children_count > 2 * FRAME_POLICY_PLACE_LIMIT or node.right > node.children_count or node.right > FRAME_POLICY_PLACE_LIMIT
                return false if node.children_count - node.right > FRAME_POLICY_PLACE_LIMIT or (node.children_count == 0 and node.children_start != 0)
                return node.right == 0 and node.children_count == 0 if node.operator == "spec"
                return node.right == 0 and node.children_count > 0 if node.operator == "preserve"
                return node.operator == "write" or node.operator == "allow"
            return false
