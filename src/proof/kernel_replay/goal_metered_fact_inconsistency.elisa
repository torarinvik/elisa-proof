extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_fact_constant_value_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> (known: bool, tag: sview, value: i64):
            return (false, "", 0) if root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            return (false, "", 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return (false, "", 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if proof_kernel_replay_int_tagged(nodes[root]):
                return (false, "", 0) if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(nodes[root].operator))
                return (false, "", 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (false, "", 0) if not proof_kernel_replay_int_tag_valid(nodes[root].operator)
                return (true, nodes[root].operator, nodes[root].value)
            safe: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant_with_work(nodes, root, work_used)
            return (false, "", 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (safe.known, "", safe.value)

        def proof_kernel_replay_unsigned_typed_constant_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize, work_used: mutable usize&) -> (known: bool, bits: u64, width: i64):
            return (false, 0, 0) if depth > 2 or root >= nodes.count
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
            return (false, 0, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            if nodes[root].kind == "typed-int":
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[root])
                return (literal.known and literal.unsigned, literal.bits, literal.width)
            return (false, 0, 0) if depth >= 2 or not proof_kernel_replay_unsigned_binary_node_valid(nodes[root])
            left: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_constant_with_goal_work(nodes, nodes[root].left, depth + 1, work_used)
            right: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_constant_with_goal_work(nodes, nodes[root].right, depth + 1, work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left.known or not right.known
            result: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_binary(nodes[root], left.bits, left.width, right.bits, right.width)
            (result.known, result.bits, result.width)

        def proof_kernel_replay_shallow_signed_literal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            return empty if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            if nodes[root].kind == "int":
                return empty if nodes[root].value < 0 or proof_kernel_replay_int_tagged(nodes[root])
                return ProofKernelReplayInt{known: true, value: nodes[root].value}
            return empty if nodes[root].kind != "unary" or (nodes[root].operator != "+" and nodes[root].operator != "-") or nodes[root].left >= nodes.count
            operand: usize = nodes[root].left
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            return empty if not proof_kernel_replay_goal_search_charge_node_text(nodes, operand, work_used)
            return empty if nodes[operand].kind != "int" or nodes[operand].value < 0 or proof_kernel_replay_int_tagged(nodes[operand])
            return ProofKernelReplayInt{known: true, value: nodes[operand].value} if nodes[root].operator == "+"
            return empty if nodes[operand].value == ElisaProofKernelCore::PROOF_KERNEL_I64_MIN
            ProofKernelReplayInt{known: true, value: 0 - nodes[operand].value}

        def proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize, work_used: mutable usize&) -> bool:
            return false if left_root >= nodes.count or right_root >= nodes.count
            return false if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(operator))
            left_text: bool = proof_kernel_replay_goal_search_charge_node_text(nodes, left_root, work_used)
            return false if not left_text
            right_text: bool = proof_kernel_replay_goal_search_charge_node_text(nodes, right_root, work_used)
            return false if not right_text
            if nodes[left_root].kind == "string" and nodes[right_root].kind == "string":
                return nodes[left_root].name == nodes[right_root].name if operator == "=="
                return nodes[left_root].name != nodes[right_root].name if operator == "!="
                return false
            left: mutable (known: bool, tag: sview, value: i64) = proof_kernel_replay_fact_constant_value_with_goal_work(nodes, left_root, work_used)
            right: mutable (known: bool, tag: sview, value: i64) = proof_kernel_replay_fact_constant_value_with_goal_work(nodes, right_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if left.known and right.known and (left.tag != "" or right.tag != ""):
                return false if left.tag != "" and right.tag != "" and left.tag != right.tag
                order: i64 = proof_kernel_replay_tagged_order(left.tag, left.value, right.tag, right.value)
                return proof_kernel_replay_i64_comparison(order, operator, 0)
            if nodes[left_root].kind == "typed-int" or nodes[right_root].kind == "typed-int":
                if nodes[left_root].kind == "typed-int" and nodes[right_root].kind == "typed-int":
                    return false if nodes[left_root].name != nodes[right_root].name
                    left_typed: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[left_root])
                    right_typed: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[right_root])
                    return false if not left_typed.known or not right_typed.known or left_typed.unsigned != right_typed.unsigned or left_typed.width != right_typed.width
                    return proof_kernel_replay_u64_comparison(left_typed.bits, operator, right_typed.bits).value
                left_unsigned: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_constant_with_goal_work(nodes, left_root, 0, work_used)
                right_unsigned: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_constant_with_goal_work(nodes, right_root, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_unsigned.known or not right_unsigned.known or left_unsigned.width != right_unsigned.width
                return proof_kernel_replay_u64_comparison(left_unsigned.bits, operator, right_unsigned.bits).value
            if not left.known:
                left_safe: ProofKernelReplayInt = proof_kernel_replay_shallow_signed_literal_with_goal_work(nodes, left_root, work_used)
                left <- (left_safe.known, "", left_safe.value)
            if not right.known:
                right_safe: ProofKernelReplayInt = proof_kernel_replay_shallow_signed_literal_with_goal_work(nodes, right_root, work_used)
                right <- (right_safe.known, "", right_safe.value)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left.known or not right.known
            proof_kernel_replay_i64_comparison(left.value, operator, right.value)

        def proof_kernel_replay_fact_negated_constant_comparison_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize, work_used: mutable usize&) -> bool:
            equality: bool = proof_kernel_replay_goal_search_text_equal(operator, "==", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, "!=", right_root, work_used) if equality
            disequality: bool = proof_kernel_replay_goal_search_text_equal(operator, "!=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, "==", right_root, work_used) if disequality
            less: bool = proof_kernel_replay_goal_search_text_equal(operator, "<", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, ">=", right_root, work_used) if less
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, "<=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, ">", right_root, work_used) if less_equal
            greater: bool = proof_kernel_replay_goal_search_text_equal(operator, ">", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, "<=", right_root, work_used) if greater
            greater_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, ">=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, "<", right_root, work_used) if greater_equal
            false

        def proof_kernel_replay_false_boolean_literal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            return false if not proof_kernel_replay_valid(nodes, root)
            boolean: bool = proof_kernel_replay_goal_search_text_equal(nodes[root].kind, "bool", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not boolean
            nodes[root].value == 0

        def proof_kernel_replay_negated_true_boolean_literal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            return false if not proof_kernel_replay_valid(nodes, root)
            unary: bool = proof_kernel_replay_goal_search_text_equal(nodes[root].kind, "unary", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not unary
            not_operator: bool = proof_kernel_replay_goal_search_text_equal(nodes[root].operator, "not", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not not_operator
            inner: usize = nodes[root].left
            return false if inner >= nodes.count or not proof_kernel_replay_valid(nodes, inner) or not proof_kernel_replay_goal_search_charge(work_used)
            boolean: bool = proof_kernel_replay_goal_search_text_equal(nodes[inner].kind, "bool", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not boolean
            nodes[inner].value != 0

        def proof_kernel_replay_fact_inconsistent_node_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize, work_used: mutable usize&) -> (valid: bool, inconsistent: bool):
            requires remaining > 0
            decreases remaining
            return (false, false) if not proof_kernel_replay_goal_search_charge(work_used)
            return (false, false) if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return (false, false) if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, true) if proof_kernel_replay_false_boolean_literal_with_goal_work(nodes, root, work_used)
            return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, true) if proof_kernel_replay_negated_true_boolean_literal_with_goal_work(nodes, root, work_used)
            return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            binary: bool = proof_kernel_replay_goal_search_text_equal(nodes[root].kind, "binary", work_used)
            return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if binary:
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                complement_holds: bool = proof_kernel_replay_fact_negated_constant_comparison_with_goal_work(nodes, fact.left, fact.operator, fact.right, work_used)
                return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, true) if complement_holds
            conjunction: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_for_operator_with_work(nodes, root, "and", work_used)
            return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if conjunction.known and remaining > 1:
                left: (valid: bool, inconsistent: bool) = proof_kernel_replay_fact_inconsistent_node_with_goal_work(nodes, conjunction.left, remaining - 1, work_used)
                return (false, false) if not left.valid
                return (true, true) if left.inconsistent
                assert remaining - 1 > 0
                assert remaining - 1 < remaining
                right: (valid: bool, inconsistent: bool) = proof_kernel_replay_fact_inconsistent_node_with_goal_work(nodes, conjunction.right, remaining - 1, work_used)
                return (false, false) if not right.valid
                return (true, right.inconsistent)
            return (true, false)

        def proof_kernel_replay_facts_inconsistent_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, roots: darray[usize], depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            for root in roots |root, nodes, remaining, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                result: (valid: bool, inconsistent: bool) = proof_kernel_replay_fact_inconsistent_node_with_goal_work(nodes, root, remaining, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if result.valid and result.inconsistent
            false

        def proof_kernel_replay_facts_propositionally_inconsistent_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, roots: darray[usize], depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return true if proof_kernel_replay_facts_inconsistent_with_goal_work(nodes, roots, depth + 1, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for root in roots |root, nodes, children, roots, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                denied: bool = proof_kernel_replay_fact_denies_with_work(nodes, children, root, roots, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if denied
            false
