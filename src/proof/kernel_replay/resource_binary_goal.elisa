extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_goal_binary_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], signed_bounds: mutable darray[ProofKernelReplayBound]&, node: ElisaProofKernelCore::ProofKernelNode, goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize, congruence_attempted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            readable: darray[usize] = facts
            if proof_kernel_replay_negation_supported(node.operator) and proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, node.right, work_used):
                return node.operator in {"==", "<=", ">="}
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_negation_supported(node.operator) and proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, node.left, node.operator, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if:
                proof_kernel_replay_interval_goal_with_work(nodes, children, node.left, node.operator, node.right, readable, signed_bounds, work_used)
                proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_affine_comparison_with_work(nodes, children, node.left, node.operator, node.right, readable, signed_bounds, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_difference_comparison_with_work(nodes, children, node.left, node.operator, node.right, readable, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            # Mirror: cancellation reads each side as a sum over the integers, which the wrap
            # guards above have licensed for every operation it admits.
            return true if proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_normalized_difference_comparison_with_work(nodes, children, node.left, node.operator, node.right, readable, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            # Mirror: the general linear tier, accepted through its Farkas certificate.
            return true if proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_linear_arithmetic_goal_with_work(nodes, children, node.left, node.operator, node.right, readable, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_product_sign_with_work(nodes, children, readable, node.left, node.operator, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_comparison_chain_with_work(nodes, children, readable, node.left, node.operator, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_strict_shift_with_work(nodes, children, readable, node.left, node.operator, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_sum_bound_with_goal_work(nodes, children, readable, node.left, node.operator, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if:
                remaining > 1 and (proof_kernel_replay_place_alias_goal(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                remaining > 1 and (proof_kernel_replay_field_place_goal(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            # Mirror: antisymmetry, `a == b` from `a <= b` and `a >= b` over primitive scalars.
            if node.operator == "==" and remaining > 1 and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT and proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT):
                lower_goal: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "binary", "<=", node.left, node.right, 0, work_used)
                return false if lower_goal >= nodes.count
                upper_goal: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "binary", ">=", node.left, node.right, 0, work_used)
                return false if upper_goal >= nodes.count
                return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, lower_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, upper_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            # Match producer order: arithmetic/place rules close bounds before transport,
            # which otherwise repeats failed antisymmetry searches.
            return true if remaining > 1 and (proof_kernel_replay_comparison_transport(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            # Ground congruence closure follows fixed-width safety guards, preserving operand widths.
            return true if proof_kernel_replay_congruence_goal_once_with_goal_work(nodes, children, facts, goal_root, work_used, &congruence_attempted)
            return false
