extend ElisaProofKernelReplay:
    private:
        # Signed equality-to-disequality replay must include literal parsing, width lookup,
        # witness scans, and structural term equality in the caller's goal-search budget.
        def proof_kernel_replay_nonnegative_literal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            decreases remaining
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if nodes[root].kind == "int":
                return empty if nodes[root].value < 0
                return ProofKernelReplayInt{known: true, value: nodes[root].value}
            return empty if:
                remaining <= 1 or nodes[root].kind != "unary"
                nodes[root].operator != "+"
            proof_kernel_replay_nonnegative_literal_with_goal_work(nodes, nodes[root].left, remaining - 1, work_used)

        def proof_kernel_replay_signed_literal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            decreases remaining
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if nodes[root].kind == "int":
                return empty if nodes[root].value < 0
                return ProofKernelReplayInt{known: true, value: nodes[root].value}
            return empty if remaining <= 1 or nodes[root].kind != "unary"
            plus: bool = nodes[root].operator == "+"
            if plus:
                return proof_kernel_replay_signed_literal_with_goal_work(nodes, nodes[root].left, remaining - 1, work_used)
            return empty if nodes[root].operator != "-"
            magnitude: ProofKernelReplayInt = proof_kernel_replay_nonnegative_literal_with_goal_work(nodes, nodes[root].left, remaining - 1, work_used)
            return empty if not magnitude.known or magnitude.value == ElisaProofKernelCore::PROOF_KERNEL_I64_MIN
            ProofKernelReplayInt{known: true, value: 0 - magnitude.value}

        def proof_kernel_replay_signed_value_fits_goal_work(width: i64, constant: ProofKernelReplayInt) -> bool:
            return constant.known and ElisaProofKernelCore::proof_kernel_signed_width_valid(width) and constant.value >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and constant.value <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)

        def proof_kernel_replay_signed_disequality_from_equality_fact_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            disequality_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "!=", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_goal or not disequality_goal
                goal.right >= nodes.count
            width: i64 = proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes, children, facts, goal.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            target: ProofKernelReplayInt = proof_kernel_replay_signed_literal_with_goal_work(nodes, goal.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if:
                width == 0 or not proof_kernel_replay_signed_value_fits_goal_work(width, target)
                not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, goal.left, goal.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact_root in facts |fact_root, nodes, children, facts, goal, width, target, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                binary_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.kind, "binary", work_used)
                equality_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, "==", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not binary_fact or not equality_fact or fact.left >= nodes.count or fact.right >= nodes.count
                same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.left, fact.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if same_left:
                    primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if primitive:
                        known_value: ProofKernelReplayInt = proof_kernel_replay_signed_literal_with_goal_work(nodes, fact.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                        value_fits: bool = proof_kernel_replay_signed_value_fits_goal_work(width, known_value)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if known_value.known and value_fits and known_value.value != target.value
                same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.left, fact.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if same_right:
                    primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if primitive:
                        known_value: ProofKernelReplayInt = proof_kernel_replay_signed_literal_with_goal_work(nodes, fact.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                        value_fits: bool = proof_kernel_replay_signed_value_fits_goal_work(width, known_value)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if known_value.known and value_fits and known_value.value != target.value
            return false

        def proof_kernel_replay_unsigned_literal_fits_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, width: i64, constant: ProofKernelReplayInt) -> bool:
            return false if width <= 0 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not constant.known
            return constant.value <= proof_kernel_replay_unsigned_width_max(width) if constant.value >= 0
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return width == 64 and node.kind == "int" and node.value == constant.value

        def proof_kernel_replay_unsigned_disequality_from_equality_fact_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            disequality_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "!=", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_goal or not disequality_goal
                goal.right >= nodes.count
            width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, goal.left, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            target: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, goal.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if:
                not proof_kernel_replay_unsigned_literal_fits_with_goal_work(nodes, goal.right, width, target)
                not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, goal.left, goal.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact_root in facts |fact_root, nodes, children, facts, goal, width, target, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                binary_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.kind, "binary", work_used)
                equality_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, "==", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not binary_fact or not equality_fact or fact.left >= nodes.count or fact.right >= nodes.count
                same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.left, fact.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if same_left:
                    primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if primitive:
                        known_value: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, fact.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                        value_fits: bool = proof_kernel_replay_unsigned_literal_fits_with_goal_work(nodes, fact.right, width, known_value)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if value_fits and known_value.value != target.value
                same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.left, fact.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if same_right:
                    primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if primitive:
                        known_value: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, fact.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                        value_fits: bool = proof_kernel_replay_unsigned_literal_fits_with_goal_work(nodes, fact.left, width, known_value)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if value_fits and known_value.value != target.value
            return false

        def proof_kernel_replay_equality_disequality_from_fact_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return true if proof_kernel_replay_signed_disequality_from_equality_fact_with_goal_work(nodes, children, facts, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proof_kernel_replay_unsigned_disequality_from_equality_fact_with_goal_work(nodes, children, facts, root, work_used)
