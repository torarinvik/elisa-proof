extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_signed_width_in_expression(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize) -> i64:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return 0 if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident":
                return proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, root)
            if node.kind == "field":
                return proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, root)
            if node.kind == "paren" or node.kind == "unary":
                return proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.left, depth + 1)
            if node.kind == "binary":
                left_width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.left, depth + 1)
                right_width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.right, depth + 1)
                return 0 if left_width != 0 and right_width != 0 and left_width != right_width
                return left_width if left_width != 0
                return right_width
            return 0

        def proof_kernel_replay_add_signed_type_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            for fact in facts |fact, nodes, children, bounds|:
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info(nodes, children, fact, 0)
                continue if not marker.known
                marker_name: sview = proof_kernel_replay_ident_name(nodes, marker.name_root)
                proof_kernel_replay_add_lower(bounds, marker_name, ElisaProofKernelCore::proof_kernel_signed_width_min(marker.width))
                proof_kernel_replay_add_upper(bounds, marker_name, ElisaProofKernelCore::proof_kernel_signed_width_max(marker.width))

        def proof_kernel_replay_signed_increment_has_strict_peer(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, width: i64, facts: darray[usize]) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.operator != "+"
            unit: (known: bool, base: usize) = proof_kernel_replay_unsigned_unit_increment_base(nodes, node.left, node.right)
            return false if not unit.known or proof_kernel_replay_signed_width_in_expression(nodes, children, facts, unit.base, 0) != width
            for fact in facts |unit, width, nodes, children, facts|:
                fact_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
                continue if not fact_located.known or fact_located.node.kind != "binary"
                relation: ElisaProofKernelCore::ProofKernelNode = fact_located.node
                continue if relation.operator != "<" and relation.operator != ">"
                continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, relation.left, relation.right)
                peer: mutable usize = relation.right
                matches: mutable bool = relation.operator == "<" and proof_kernel_replay_expr_equal(nodes, children, relation.left, unit.base, 0)
                if relation.operator == ">":
                    matches <- proof_kernel_replay_expr_equal(nodes, children, relation.right, unit.base, 0)
                    peer <- relation.left
                continue if not matches
                peer_width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, peer, 0)
                return true if peer_width > 0 and peer_width <= width
            return false

        def proof_kernel_replay_signed_guarded_subtraction_safe(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.operator != "-"
            width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, root, 0)
            return false if width == 0 or proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.left, 0) != width or proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.right, 0) != width
            right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.right, bounds, 0)
            return right_interval.has_lower and right_interval.lower >= 0 and proof_kernel_replay_has_order_fact(nodes, children, node.right, node.left, false, facts)

        def proof_kernel_replay_signed_nonnegative_sum_safe(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.operator != "+"
            width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, root, 0)
            return false if width == 0 or proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.left, 0) != width or proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.right, 0) != width
            left_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, 0)
            right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.right, bounds, 0)
            return false if not left_interval.has_lower or left_interval.lower < 0 or not right_interval.has_lower or right_interval.lower < 0
            witness: (known: bool, bound: usize, strict: bool) = proof_kernel_replay_sum_upper_witness(nodes, children, node.left, node.right, facts)
            return false if not witness.known
            bound_width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, witness.bound, 0)
            return bound_width > 0 and bound_width <= width

        def proof_kernel_replay_signed_expression_safe_with_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary":
                return false if not proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, node.left, facts, bounds, depth + 1)
                if node.operator == "-":
                    width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.left, depth + 1)
                    if width != 0:
                        interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, root, bounds, depth + 1)
                        return interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                return true
            if node.kind == "binary":
                return false if not proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, node.left, facts, bounds, depth + 1)
                return false if not proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, node.right, facts, bounds, depth + 1)
                arithmetic: bool = node.operator == "+" or node.operator == "-" or node.operator == "*" or node.operator == "/" or node.operator == "%" or node.operator == "<<" or node.operator == ">>" or node.operator == "&" or node.operator == "|" or node.operator == "^"
                return true if not arithmetic
                width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, root, depth + 1)
                if width == 0:
                    return true if proof_kernel_replay_unsigned_width_in_expression(nodes, children, root, facts, depth + 1) != 0
                    constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, depth + 1)
                    return constant.known and constant.value >= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN and constant.value <= ElisaProofKernelCore::PROOF_KERNEL_I64_MAX if constant.known
                    # Range binders may have scalar evidence without a width marker. The
                    # smallest supported primitive integer is i8/u8; a nonnegative interval
                    # inside its shared range is safe without knowing the signedness.
                    interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, root, bounds, depth + 1)
                    return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= ElisaProofKernelCore::PROOF_KERNEL_I8_MAX if proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, depth + 1)
                    return not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, depth + 1)
                interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, root, bounds, depth + 1)
                return true if interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                return true if proof_kernel_replay_signed_guarded_subtraction_safe(nodes, children, root, facts, bounds)
                return true if proof_kernel_replay_signed_nonnegative_sum_safe(nodes, children, root, facts, bounds)
                return proof_kernel_replay_signed_increment_has_strict_peer(nodes, children, root, width, facts) if width > 0
                return false
            if node.kind == "if":
                return proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, node.left, facts, bounds, depth + 1) and proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, node.right, facts, bounds, depth + 1) and proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, node.auxiliary, facts, bounds, depth + 1)
            return true

        # Mirror of the producer's `proof_close_term_equalities`: a signed name equal to a
        # range-safe signed term of the same width takes the term's interval.
        def proof_kernel_replay_close_term_equalities(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            for fact in facts |fact, nodes, children, facts, bounds|:
                root: mutable usize = fact
                steps: mutable usize = 0
                while steps < 8 and root < nodes.count and nodes[root].kind == "paren" |steps, root, nodes|:
                    root <- nodes[root].left
                    steps <- steps + 1
                continue if not proof_kernel_replay_valid(nodes, root)
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                continue if node.kind != "binary" or node.operator != "=="
                for side in 0..<2 |side, node, nodes, children, facts, bounds|:
                    name_root: usize = node.left if side == 0 else node.right
                    term_root: usize = node.right if side == 0 else node.left
                    continue if not proof_kernel_replay_valid(nodes, name_root) or not proof_kernel_replay_valid(nodes, term_root)
                    name: sview = proof_kernel_replay_ident_name(nodes, name_root)
                    continue if name == "" or proof_kernel_replay_ident_name(nodes, term_root) != ""
                    width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, name_root, 0)
                    continue if width <= 0 or proof_kernel_replay_signed_width_in_expression(nodes, children, facts, term_root, 0) != width
                    continue if not proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, term_root, facts, bounds, 0)
                    interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, term_root, bounds, 0)
                    continue if not interval.has_lower or not interval.has_upper
                    continue if interval.lower < ElisaProofKernelCore::proof_kernel_signed_width_min(width) or interval.upper > ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                    proof_kernel_replay_add_lower(bounds, name, interval.lower)
                    proof_kernel_replay_add_upper(bounds, name, interval.upper)

        def proof_kernel_replay_signed_expression_safe(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize]) -> bool:
            bounds: darray[ProofKernelReplayBound] = proof_kernel_replay_signed_safety_bounds(nodes, children, facts)
            return proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, root, facts, bounds, 0)

        # The intervals the signed guard reads; they depend on the facts alone.
        def proof_kernel_replay_signed_safety_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]) -> darray[ProofKernelReplayBound]:
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            proof_kernel_replay_add_signed_type_bounds(nodes, children, facts, &bounds)
            proof_kernel_replay_close_term_equalities(nodes, children, facts, &bounds)
            constraints: mutable darray[ProofKernelReplayDifference] = []
            for fact in facts |fact, nodes, children, bounds, constraints|:
                proof_kernel_replay_collect_differences(nodes, fact, bounds, children, facts, &constraints, 0)
            if constraints.count <= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS:
                proof_kernel_replay_close_bounds_through_differences(constraints, &bounds)
            return bounds

        # Mirror of the producer's `proof_strict_signed_width`: a width is reported only when
        # every leaf is a witnessed scalar carrying a signed marker, so an unwitnessed operand
        # never lends its declared width to a constant on the other side of a comparison.
        def proof_kernel_replay_strict_signed_width(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize) -> i64:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return 0 if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident" or node.kind == "field" or node.kind == "index" or node.kind == "index-n":
                # An unsigned name reports its width negated, as in the producer.
                unsigned_width: i64 = proof_kernel_replay_unsigned_marker_width_for_name(nodes, children, facts, node.name) if node.kind == "ident" else 0
                return 0 - unsigned_width if unsigned_width > 0 and proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, root) == 0
                return 0 if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0)
                return proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, root)
            if node.kind == "paren":
                return proof_kernel_replay_strict_signed_width(nodes, children, facts, node.left, depth + 1)
            if node.kind == "unary":
                return 0 if node.operator != "-" and node.operator != "+"
                return proof_kernel_replay_strict_signed_width(nodes, children, facts, node.left, depth + 1)
            if node.kind == "binary":
                return 0 if node.operator != "+" and node.operator != "-" and node.operator != "*" and node.operator != "/" and node.operator != "%"
                left_closed: bool = proof_kernel_replay_constant_int(nodes, node.left, depth + 1).known
                right_closed: bool = proof_kernel_replay_constant_int(nodes, node.right, depth + 1).known
                return 0 if left_closed and right_closed
                left_width: mutable i64 = 0
                right_width: mutable i64 = 0
                left_width <- proof_kernel_replay_strict_signed_width(nodes, children, facts, node.left, depth + 1) if not left_closed
                right_width <- proof_kernel_replay_strict_signed_width(nodes, children, facts, node.right, depth + 1) if not right_closed
                return 0 if (not left_closed and left_width == 0) or (not right_closed and right_width == 0)
                return 0 if left_width != 0 and right_width != 0 and left_width != right_width
                return left_width if left_width != 0
                return right_width
            return 0

        # The exact value of a closed expression evaluated at a signed width, refusing any leaf or
        # intermediate result outside that width. A literal with a negative payload is a wrapped
        # large literal and is refused; negative values are only reached through unary minus.
        def proof_kernel_replay_signed_constant_at_width(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, width: i64, depth: usize) -> ProofKernelReplayInt:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
            return empty if width == 0 or width < 0 - ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
            # A negative width is unsigned: floor zero, ceiling the representable type maximum.
            unsigned: bool = width < 0
            minimum: i64 = 0 if unsigned else ElisaProofKernelCore::proof_kernel_signed_width_min(width)
            maximum: i64 = proof_kernel_replay_unsigned_width_max(0 - width) if unsigned else ElisaProofKernelCore::proof_kernel_signed_width_max(width)
            return empty if maximum <= 0
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            result: mutable ProofKernelReplayInt = empty
            if node.kind == "int":
                return empty if node.value < 0 or node.value > maximum
                return ProofKernelReplayInt{known: true, value: node.value}
            if node.kind == "paren":
                return proof_kernel_replay_signed_constant_at_width(nodes, node.left, width, depth + 1)
            if node.kind == "unary" and node.operator == "-" and not unsigned and nodes[node.left].kind == "int" and nodes[node.left].value > maximum:
                # Mirrors the checker: only `-(MAX+1)` names the signed minimum.
                return empty if nodes[node.left].value - 1 != maximum
                return ProofKernelReplayInt{known: true, value: minimum}
            if node.kind == "unary":
                inner: ProofKernelReplayInt = proof_kernel_replay_signed_constant_at_width(nodes, node.left, width, depth + 1)
                return empty if not inner.known
                return inner if node.operator == "+"
                return empty if node.operator != "-"
                result <- proof_kernel_replay_sub_safe(0, inner.value)
            if node.kind == "binary":
                left: ProofKernelReplayInt = proof_kernel_replay_signed_constant_at_width(nodes, node.left, width, depth + 1)
                right: ProofKernelReplayInt = proof_kernel_replay_signed_constant_at_width(nodes, node.right, width, depth + 1)
                return empty if not left.known or not right.known
                result <- proof_kernel_replay_add_safe(left.value, right.value) if node.operator == "+"
                result <- proof_kernel_replay_sub_safe(left.value, right.value) if node.operator == "-"
                result <- proof_kernel_replay_mul_safe(left.value, right.value) if node.operator == "*"
                result <- proof_kernel_replay_div_safe(left.value, right.value) if node.operator == "/"
                result <- proof_kernel_replay_mod_safe(left.value, right.value) if node.operator == "%"
            return empty if not result.known or result.value < minimum or result.value > maximum
            return result

        # The value of `constant_root` when it is a closed expression that the width-free interval
        # refuses and `peer_root` is strictly typed at a signed width. A safe constant keeps its
        # width-free interval, so this only ever widens what the interval already decided.
        def proof_kernel_replay_typed_comparison_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], constant_root: usize, peer_root: usize) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if not proof_kernel_replay_constant_int(nodes, constant_root, 0).known
            return empty if proof_kernel_replay_safe_comparison_constant(nodes, constant_root).known
            return empty if proof_kernel_replay_constant_int(nodes, peer_root, 0).known
            width: i64 = proof_kernel_replay_strict_signed_width(nodes, children, facts, peer_root, 0)
            return empty if width == 0
            return proof_kernel_replay_signed_constant_at_width(nodes, constant_root, width, 0)
