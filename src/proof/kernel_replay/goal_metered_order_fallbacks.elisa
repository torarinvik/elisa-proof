extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_kind_matches_with_work(kind: sview, expected: sview, work_used: mutable usize&) -> bool:
            proof_kernel_replay_goal_search_text_equal(kind, expected, work_used)

        def proof_kernel_replay_zero_literal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            integer: bool = proof_kernel_replay_kind_matches_with_work(nodes[root].kind, "int", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            integer and nodes[root].value == 0

        def proof_kernel_replay_binary_operands_for_operator_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, operator: sview, work_used: mutable usize&) -> (known: bool, left: usize, right: usize):
            return (false, 0, 0) if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return (false, 0, 0) if not located.known
            binary: bool = proof_kernel_replay_kind_matches_with_work(located.node.kind, "binary", work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary
            operator_matches: bool = proof_kernel_replay_goal_search_text_equal(located.node.operator, operator, work_used)
            return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not operator_matches
            (true, located.node.left, located.node.right)

        def proof_kernel_replay_product_operands_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> (known: bool, left: usize, right: usize):
            proof_kernel_replay_binary_operands_for_operator_with_work(nodes, root, "*", work_used)

        def proof_kernel_replay_sign_relation_matches_with_work(relation: sview, expected: sview, mirrored: bool, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(relation))
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(expected))
            proof_kernel_replay_sign_relation_matches(relation, expected, mirrored)

        def proof_kernel_replay_sign_fact_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], term: usize, relation: sview, work_used: mutable usize&) -> bool:
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, term, relation, work_used)

        def proof_kernel_replay_sign_fact_with_markers_and_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: darray[ProofKernelReplayWitnessMarker], term: usize, relation: sview, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, facts, markers, term, relation, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
                continue if not located.known
                binary: bool = proof_kernel_replay_kind_matches_with_work(located.node.kind, "binary", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not binary
                admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, fact, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if not admission.complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if admission.untrusted
                same_relation: bool = proof_kernel_replay_goal_search_text_equal(located.node.operator, relation, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if same_relation and proof_kernel_replay_zero_literal_with_work(nodes, located.node.right, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, located.node.left, term, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                mirrored_relation: bool = proof_kernel_replay_sign_relation_matches_with_work(relation, located.node.operator, true, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if mirrored_relation and proof_kernel_replay_zero_literal_with_work(nodes, located.node.left, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, located.node.right, term, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            false

        def proof_kernel_replay_unsigned_scaled_product_witness_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, product_root: usize, facts: darray[usize], strict_required: bool, work_used: mutable usize&) -> (known: bool, base: usize, bound: usize, factor: i64):
            unknown: (known: bool, base: usize, bound: usize, factor: i64) = (false, 0, 0, 0)
            product: (known: bool, left: usize, right: usize) = proof_kernel_replay_product_operands_with_work(nodes, product_root, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not product.known
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, product.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            base: mutable usize = product.left
            factor_expression: mutable usize = product.right
            factor: mutable i64 = right_constant.value
            if not right_constant.known or right_constant.value <= 0:
                left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, product.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_constant.known or left_constant.value <= 0
                base <- product.right
                factor_expression <- product.left
                factor <- left_constant.value
            unsigned_width_markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            unsigned_width_markers_ready: mutable bool = false
            unsigned_width_index: mutable ProofKernelReplayLinearUnsignedWidthIndex = ProofKernelReplayLinearUnsignedWidthIndex{}
            unsigned_width_index_ready: mutable bool = false
            width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, product_root, facts, &unsigned_width_markers, &unsigned_width_markers_ready, &unsigned_width_index, &unsigned_width_index_ready, work_used, 0)
            return unknown if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
                proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, base, facts, &unsigned_width_markers, &unsigned_width_markers_ready, &unsigned_width_index, &unsigned_width_index_ready, work_used, 0) != width
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or factor > proof_kernel_replay_unsigned_width_max(width)
            conjuncts: mutable darray[usize] = []
            proof_kernel_replay_conjunct_facts_with_goal_work(nodes, facts, &conjuncts, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            for fact in conjuncts |fact, nodes, children, facts, base, factor_expression, factor, width, strict_required, markers, markers_ready, work_used|:
                return unknown if not proof_kernel_replay_goal_search_charge(work_used)
                order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_markers_and_work(nodes, children, facts, &markers, &markers_ready, fact, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not order.known
                less: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<", work_used)
                less_equal: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<=", work_used)
                greater: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">", work_used)
                greater_equal: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">=", work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                quotient: mutable usize = 0
                if (less or (not strict_required and less_equal)) and proof_kernel_replay_goal_search_expr_equal(nodes, children, order.left, base, work_used):
                    quotient <- order.right
                elif (greater or (not strict_required and greater_equal)) and proof_kernel_replay_goal_search_expr_equal(nodes, children, order.right, base, work_used):
                    quotient <- order.left
                else:
                    continue
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                division: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_for_operator_with_work(nodes, quotient, "/", work_used)
                continue if not division.known
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, division.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not divisor.known or divisor.value != factor
                same_factor: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, division.right, factor_expression, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_factor
                numerator_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, division.left, facts, &unsigned_width_markers, &unsigned_width_markers_ready, &unsigned_width_index, &unsigned_width_index_ready, work_used, 0)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or numerator_width != width
                return (true, base, division.left, factor)
            unknown

        def proof_kernel_replay_product_sign_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, operator: sview, right: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            product: mutable (known: bool, left: usize, right: usize) = proof_kernel_replay_product_operands_with_work(nodes, left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            mirror_operator: mutable bool = false
            if not product.known:
                product <- proof_kernel_replay_product_operands_with_work(nodes, right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                mirror_operator <- true
                return false if not product.known or not proof_kernel_replay_zero_literal_with_work(nodes, left, work_used)
            else:
                return false if not proof_kernel_replay_zero_literal_with_work(nodes, right, work_used)
            scalar_pair: bool = proof_kernel_replay_scalar_term_pair_witnessed_with_work(nodes, children, facts, product.left, product.right, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not scalar_pair
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if proof_kernel_replay_sign_relation_matches_with_work(operator, ">=", mirror_operator, work_used):
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.left, ">=", work_used) and proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.right, ">=", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.left, "<=", work_used) and proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.right, "<=", work_used)
            if proof_kernel_replay_sign_relation_matches_with_work(operator, "<=", mirror_operator, work_used):
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.left, ">=", work_used) and proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.right, "<=", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.left, "<=", work_used) and proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.right, ">=", work_used)
            if proof_kernel_replay_sign_relation_matches_with_work(operator, ">", mirror_operator, work_used):
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.left, ">", work_used) and proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.right, ">", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.left, "<", work_used) and proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.right, "<", work_used)
            if proof_kernel_replay_sign_relation_matches_with_work(operator, "<", mirror_operator, work_used):
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.left, ">", work_used) and proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.right, "<", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.left, "<", work_used) and proof_kernel_replay_sign_fact_with_markers_and_work(nodes, children, facts, markers, product.right, ">", work_used)
            false

        def proof_kernel_replay_term_is_unsigned_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize, work_used: mutable usize&) -> bool:
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            width_index: mutable ProofKernelReplayLinearUnsignedWidthIndex = ProofKernelReplayLinearUnsignedWidthIndex{}
            index_ready: mutable bool = false
            proof_kernel_replay_term_is_unsigned_with_cached_markers_and_work(nodes, children, facts, root, markers, markers_ready, width_index, index_ready, depth, work_used)

        def proof_kernel_replay_term_is_unsigned_with_cached_markers_and_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, width_index: mutable ProofKernelReplayLinearUnsignedWidthIndex&, index_ready: mutable bool&, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            unsigned_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, root, facts, markers, markers_ready, width_index, index_ready, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if unsigned_width != 0
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary: bool = proof_kernel_replay_kind_matches_with_work(node.kind, "binary", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if binary:
                arithmetic: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "+", work_used) or proof_kernel_replay_goal_search_text_equal(node.operator, "-", work_used) or proof_kernel_replay_goal_search_text_equal(node.operator, "*", work_used) or proof_kernel_replay_goal_search_text_equal(node.operator, "/", work_used) or proof_kernel_replay_goal_search_text_equal(node.operator, "%", work_used) or proof_kernel_replay_goal_search_text_equal(node.operator, "<<", work_used) or proof_kernel_replay_goal_search_text_equal(node.operator, ">>", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not arithmetic
                return proof_kernel_replay_term_is_unsigned_with_cached_markers_and_work(nodes, children, facts, node.left, markers, markers_ready, width_index, index_ready, depth + 1, work_used) or proof_kernel_replay_term_is_unsigned_with_cached_markers_and_work(nodes, children, facts, node.right, markers, markers_ready, width_index, index_ready, depth + 1, work_used)
            proof_kernel_replay_linear_place_marker_width_with_work(nodes, children, facts, root, work_used) != 0

        def proof_kernel_replay_unsigned_nonnegative_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, operator: sview, right: usize, work_used: mutable usize&) -> bool:
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, "<=", work_used)
            greater_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, ">=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (not less_equal and not greater_equal)
            zero_left: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            zero_right: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            term: mutable usize = 0
            if zero_left.known and zero_left.value == 0 and less_equal:
                term <- right
            elif zero_right.known and zero_right.value == 0 and greater_equal:
                term <- left
            else:
                return false
            return false if not proof_kernel_replay_term_is_unsigned_with_work(nodes, children, facts, term, 0, work_used)
            work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT

        def proof_kernel_replay_shifted_unit_base_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> (known: bool, base: usize):
            return (false, 0) if:
                not proof_kernel_replay_goal_search_charge(work_used) or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary: bool = proof_kernel_replay_kind_matches_with_work(node.kind, "binary", work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary
            plus: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "+", work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not plus
            proof_kernel_replay_unsigned_unit_increment_base_with_work(nodes, node.left, node.right, work_used)

        def proof_kernel_replay_strict_shift_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, operator: sview, right: usize, work_used: mutable usize&) -> bool:
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, "<=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not less_equal
            shifted: (known: bool, base: usize) = proof_kernel_replay_shifted_unit_base_with_work(nodes, left, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not shifted.known
                not proof_kernel_replay_unsigned_goal_safe_with_goal_work(nodes, children, facts, left, work_used)
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            for fact in facts |fact, nodes, children, facts, shifted, right, markers, markers_ready, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                readable: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_markers_and_work(nodes, children, facts, &markers, &markers_ready, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not readable.known
                is_less: bool = proof_kernel_replay_goal_search_text_equal(readable.operator, "<", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if is_less and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.left, shifted.base, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.right, right, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                is_greater: bool = proof_kernel_replay_goal_search_text_equal(readable.operator, ">", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if is_greater and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.right, shifted.base, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.left, right, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            false
