extend ElisaProofKernelReplay:
    private:
        # Linear membership checks over event histories share the same cumulative resource
        # budget as the transitions that build those histories. Return completion separately
        # from presence so callers can fail closed when the meter is exhausted.
        def proof_kernel_replay_resource_usize_membership(values: darray[usize], target: usize, work_used: mutable usize&) -> (complete: bool, found: bool):
            for value in values |target, work_used|:
                return (false, false) if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                return (true, true) if value == target
            return (true, false)

        def proof_kernel_replay_resource_sview_membership(values: darray[sview], target: sview, work_used: mutable usize&) -> (complete: bool, found: bool):
            for value in values |target, work_used|:
                return (false, false) if not proof_kernel_replay_resource_charge_text_pair_used(work_used, value, target)
                return (true, true) if value == target
            return (true, false)

        def proof_kernel_replay_resource_expr_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, work_used: mutable usize&) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT
            remaining: usize = PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT - work_used
            comparison_work: mutable usize = 0
            equal: bool = proof_kernel_replay_expr_equal_with_work(nodes, children, left_root, right_root, 0, remaining, &comparison_work)
            return false if not proof_kernel_replay_resource_charge_work_used(work_used, comparison_work)
            equal

        # A lexical resource scope may introduce and discharge its own region, but it cannot
        # destroy or otherwise invalidate a region inherited from its parent. The child state is
        # intentionally discarded after replay, so compare inherited liveness before accepting
        # the scope; otherwise `destroy r` inside a plain nested block could disappear with the
        # snapshot and make a later use of an r-owned binding look live again.
        def proof_kernel_replay_resource_scope_preserves_parent(parent: ProofKernelReplayResourceState&, child: ProofKernelReplayResourceState&) -> bool:
            # A scope join discards the child resource state. Therefore the active region stack
            # must be exactly the inherited stack at the join: membership alone would allow a
            # forged child to leak a fresh local region, or to reorder lifetimes before its state
            # disappears. Nested region blocks must close their own regions before returning.
            return false if child.regions.active_regions.count != parent.regions.active_regions.count
            for index in 0..<parent.regions.active_regions.count |index, parent, child|:
                return false if:
                    not proof_kernel_replay_resource_charge_text_pair_used(&parent.scope.resource_work_used, child.regions.active_regions[index], parent.regions.active_regions[index])
                    child.regions.active_regions[index] != parent.regions.active_regions[index]
            # The child is a snapshot whose non-move state is discarded at scope exit. An
            # inherited binding therefore cannot be redirected to a different region in the
            # child: otherwise the parent would retain the old metadata while the executed
            # child had made the binding point at storage with a different lifetime.
            for index in 0..<parent.provenance.binding_region.count |index, parent, child|:
                return false if:
                    index >= child.provenance.binding_region.count
                    not proof_kernel_replay_resource_charge_text_pair_used(&parent.scope.resource_work_used, child.provenance.binding_region[index], parent.provenance.binding_region[index])
                    child.provenance.binding_region[index] != parent.provenance.binding_region[index]
            for index in 0..<parent.provenance.binding_region_owner.count |index, parent, child|:
                return false if:
                    not proof_kernel_replay_resource_charge_work_used(&parent.scope.resource_work_used, 1)
                    index >= child.provenance.binding_region_owner.count or child.provenance.binding_region_owner[index] != parent.provenance.binding_region_owner[index]
            for index in 0..<parent.provenance.binding_region_live.count |index, parent, child|:
                return false if not proof_kernel_replay_resource_charge_work_used(&parent.scope.resource_work_used, 1)
                if parent.provenance.binding_region_live[index]:
                    return false if index >= child.provenance.binding_region_live.count or not child.provenance.binding_region_live[index]
            return true

        def proof_kernel_replay_resource_lookup(state: ProofKernelReplayResourceState&, name: sview) -> usize:
            # A forward scan that keeps the last match returns the same slot the downward scan
            # returned -- the highest index whose name matches, which is the innermost binding
            # under shadowing -- and its index is bounded by the loop range rather than by an
            # invariant. `elisac-stage1` declines any body carrying a loop `invariant`, so the
            # fact this loop needed could not be written; the loop is written not to need it.
            found: mutable usize = state.bindings.binding_names.count
            for index in 0..<state.bindings.binding_names.count |index, state, name, found|:
                return state.bindings.binding_names.count if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, state.bindings.binding_names[index], name)
                found <- index if state.bindings.binding_names[index] == name
            return found

        def proof_kernel_replay_resource_lookup_place(state: ProofKernelReplayResourceState&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, place: ProofKernelReplayResourcePlace) -> usize:
            return state.bindings.binding_names.count if not proof_kernel_replay_resource_place_root_valid(nodes, place)
            return proof_kernel_replay_resource_lookup(state, nodes[place.root_node].name)

        def proof_kernel_replay_resource_binding_name_available(state: ProofKernelReplayResourceState&, name: sview) -> bool:
            return false if name == ""
            for index in 0..<state.bindings.binding_names.count |index, state, name|:
                return false if:
                    not proof_kernel_replay_resource_charge_work_used(&state.scope.resource_work_used, 1)
                    index >= state.bindings.binding_scope_depth.count
                if state.bindings.binding_scope_depth[index] == state.scope.scope_depth:
                    return false if:
                        not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, state.bindings.binding_names[index], name)
                        state.bindings.binding_names[index] == name
            return true

        def proof_kernel_replay_resource_has_pending_join(state: ProofKernelReplayResourceState&) -> bool:
            for index in 0..<state.scope.pending_join_moves.count |index, state|:
                return true if not proof_kernel_replay_resource_charge_work_used(&state.scope.resource_work_used, 1)
                pending: bool = state.scope.pending_join_moves[index]
                return true if pending
            return false

        # A whole binding may be written only when its serialized resource capability is
        # writable. Mutable references are intrinsically writable; ordinary bindings require
        # the explicit writable bit. Field/index writes remain governed by their path-level
        # model, which is where struct-field mutability is represented.
        def proof_kernel_replay_resource_binding_is_writable(state: ProofKernelReplayResourceState&, slot: usize) -> bool:
            is_reference: bool = slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]
            if is_reference:
                return slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]
            return slot < state.bindings.binding_writable.count and state.bindings.binding_writable[slot]

        def proof_kernel_replay_resource_region_active(state: ProofKernelReplayResourceState&, region: sview) -> bool:
            return false if region == ""
            # An existence check does not depend on scan order, and a forward scan's index is
            # bounded by the loop range rather than by an invariant the compiler will not accept.
            found: mutable bool = false
            for index in 0..<state.regions.active_regions.count |index, state, region, found|:
                return false if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, state.regions.active_regions[index], region)
                found <- true if state.regions.active_regions[index] == region
            return found

        # Allocation operands are source expressions, not resource-transition roots. A region
        # value copied into a fresh allocation would otherwise smuggle a shorter lifetime into the
        # destination region. Keep this check independent of the AST producer: every identifier
        # operand must have an explicit resource binding. An untracked name may be a scalar, but it
        # may also be a region-owned value omitted from a forged trace, so replay rejects it.
        # The constructed type of a `construct` node. A type expression denotes no runtime value
        # and therefore carries no lifetime of its own; the constructed value's lifetime comes
        # from the allocation that holds it. Only a plain or qualified type name is accepted, so
        # anything richer — a region-parameterized or otherwise unrecognized form — is refused
        # rather than assumed lifetime-free.
        def proof_kernel_replay_resource_type_term(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: mutable ProofKernelReplayResourceState&, root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_resource_charge_work(state, 1)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            return true if nodes[root].kind == "ident" and nodes[root].name != ""
            return false if nodes[root].kind != "field" or nodes[root].name == ""
            return proof_kernel_replay_resource_type_term(nodes, state, nodes[root].left, depth + 1)

        # The qualifier of `Module::NAME`. Elisa spells only module, type and enum paths with `::`
        # (a value's member is `.`), so an unbound qualifier chain names a static declaration,
        # and a static value has no region lifetime. A qualifier that is a live binding keeps the
        # ordinary binding rule, and any other qualifier form is refused. An absent qualifier is
        # the root namespace (`::NAME`), which holds declarations only.
        def proof_kernel_replay_resource_scope_qualifier_is_static(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: mutable ProofKernelReplayResourceState&, root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_resource_charge_work(state, 1)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            return true if nodes[root].kind == "absent"
            if nodes[root].kind == "ident":
                return false if nodes[root].name == ""
                slot: usize = proof_kernel_replay_resource_lookup(state, nodes[root].name)
                return true if slot >= state.bindings.binding_names.count
                return proof_kernel_replay_resource_binding_region(state, slot) == ""
            return false if nodes[root].kind != "scope" or nodes[root].name == ""
            return proof_kernel_replay_resource_scope_qualifier_is_static(nodes, state, nodes[root].left, depth + 1)

        def proof_kernel_replay_resource_value_term_has_no_region(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, state: mutable ProofKernelReplayResourceState&, root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_resource_charge_work(state, 1)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind in {"int", "bool", "float", "opaque-float-literal", "string", "char", "shorthand", "absent"}:
                return true
            if node.kind == "ident":
                slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                return false if slot >= state.bindings.binding_names.count
                return proof_kernel_replay_resource_binding_region(state, slot) == ""
            # The neutral `checked-get` node does not retain its recovery expression. Treating it
            # as a unary expression here could hide a region value in that recovery branch.
            return false if node.kind == "checked-get"
            if node.kind == "scope":
                return false if node.name == ""
                return proof_kernel_replay_resource_scope_qualifier_is_static(nodes, state, node.left, depth + 1)
            if node.kind in {"unary", "move", "field", "call_arg", "field-init"}:
                return proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, depth + 1)
            if node.kind in {"binary", "index", "dict_entry", "checked-index"}:
                return proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, depth + 1) and proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.right, depth + 1)
            if node.kind in {"slice", "if"}:
                return proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, depth + 1) and proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.right, depth + 1) and proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.auxiliary, depth + 1)
            if node.kind == "quantifier":
                return proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, depth + 1) and proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.right, depth + 1)
            if node.kind == "call":
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, nodes, state, depth|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if:
                        not child.known
                        not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, child.value, depth + 1)
                return true
            if node.kind in {"index-n", "array", "tuple", "set", "dict", "construct", "record-update"}:
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                # A construction's left edge is the constructed *type*, not a value: it is the
                # encoded type expression, unlike a record update's left edge, which is the base
                # record being copied. Reading it as a value term looks the type name up as a
                # binding, finds none, and refuses every struct literal allocated into a region.
                return false if node.kind == "construct" and not proof_kernel_replay_resource_type_term(nodes, state, node.left, 0)
                if node.kind in {"index-n", "record-update"}:
                    return false if not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, depth + 1)
                for index in 0..<node.children_count |index, node, children, nodes, state, depth|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if:
                        not child.known
                        not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, child.value, depth + 1)
                return true
            # Resource transitions are never valid as expression operands. This also makes a
            # malformed certificate fail closed instead of treating an ignored node kind as a
            # scalar value.
            return false

        # A direct reference identifier cannot be reclassified as a scalar at a call boundary.
        # Derived scalar projections such as `nodes.count` remain valid value terms; their shape
        # is intentionally handled by the recursive no-region check above.
        def proof_kernel_replay_resource_value_term_is_direct_reference(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: ProofKernelReplayResourceState&, root: usize) -> bool:
            return false if root >= nodes.count or nodes[root].kind != "ident"
            slot: usize = proof_kernel_replay_resource_lookup(state, nodes[root].name)
            return slot < state.bindings.binding_names.count and slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]

        def proof_kernel_replay_resource_region_external(state: ProofKernelReplayResourceState&, region: sview) -> bool:
            for external in state.regions.external_regions |external, state|:
                return false if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, external, region)
                return true if external == region
            return false

        def proof_kernel_replay_resource_region_protected(state: ProofKernelReplayResourceState&, region: sview) -> bool:
            for protected in state.regions.protected_regions |protected, state|:
                return false if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, protected, region)
                return true if protected == region
            return false

        def proof_kernel_replay_resource_binding_region[@r](state: ProofKernelReplayResourceState& @r, slot: usize) -> sview @r:
            return state.provenance.binding_region[slot] if slot < state.provenance.binding_region.count
            return ""

        def proof_kernel_replay_resource_binding_region_is_live(state: ProofKernelReplayResourceState&, slot: usize) -> bool:
            return slot < state.provenance.binding_region_live.count and state.provenance.binding_region_live[slot]

        # Keep the region view in its owning state arrays while validating it. Extracting an
        # `sview` into a temporary loses the direct provenance needed to show its backing name is
        # still active. A missing parallel region entry is malformed state, not an unregioned
        # binding, so fail closed instead of letting the accessor's empty fallback erase it.
        def proof_kernel_replay_resource_binding_region_lifetime_valid(state: ProofKernelReplayResourceState&, slot: usize) -> bool:
            return false if slot >= state.provenance.binding_region.count
            return true if state.provenance.binding_region[slot] == ""
            return false if slot >= state.provenance.binding_region_live.count or not state.provenance.binding_region_live[slot]
            active: mutable bool = false
            for index in 0..<state.regions.active_regions.count |index, state, slot, active|:
                return false if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, state.regions.active_regions[index], state.provenance.binding_region[slot])
                active <- true if state.regions.active_regions[index] == state.provenance.binding_region[slot]
            return active

        # An implicit shared-borrow actual is valid for an owned aggregate explicitly
        # marked borrowable, or for a field reached through an existing shared reference.
        # Mutable reference capabilities stay excluded from this spelling; they require
        # an explicit borrow event so replay can check the alias transition directly.
        def proof_kernel_replay_resource_binding_allows_implicit_shared_borrow(state: ProofKernelReplayResourceState&, slot: usize, place: ProofKernelReplayResourcePlace) -> bool:
            return false if slot >= state.bindings.binding_names.count or slot >= state.bindings.binding_moved.count or slot >= state.bindings.binding_borrowable.count or slot >= state.bindings.binding_reference.count or slot >= state.bindings.binding_mutable_reference.count or state.bindings.binding_moved[slot]
            if state.bindings.binding_reference[slot]:
                return not state.bindings.binding_mutable_reference[slot] and place.depth > 0
            state.bindings.binding_borrowable[slot]

        def proof_kernel_replay_resource_invalidate_region_bindings(state: mutable ProofKernelReplayResourceState&, region: sview) -> bool:
            for index in 0..<state.provenance.binding_region.count |index, state, region|:
                return false if not proof_kernel_replay_resource_charge_text_pair(state, state.provenance.binding_region[index], region)
                if index < state.provenance.binding_region_live.count and state.provenance.binding_region[index] == region:
                    state.provenance.binding_region_live[index] <- false
            true

        def proof_kernel_replay_resource_region_has_live_borrow(state: ProofKernelReplayResourceState&, region: sview) -> bool:
            for borrowed in state.regions.region_wide_borrows |borrowed, state|:
                return false if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, borrowed, region)
                return true if borrowed == region
            for slot in 0..<state.borrows.borrow_present.count |slot, state, region|:
                return false if not proof_kernel_replay_resource_charge_work_used(&state.scope.resource_work_used, 1)
                if state.borrows.borrow_present[slot]:
                    return true if slot >= state.provenance.binding_region.count or slot >= state.bindings.binding_moved.count or slot >= state.borrows.borrow_target_slots.count
                    if not state.bindings.binding_moved[slot]:
                        return false if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, state.provenance.binding_region[slot], region)
                    if not state.bindings.binding_moved[slot] and state.provenance.binding_region[slot] == region:
                        target_slot: usize = state.borrows.borrow_target_slots[slot]
                        return true if target_slot >= state.provenance.binding_region.count or target_slot >= state.provenance.binding_region_live.count
                        return false if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, state.provenance.binding_region[target_slot], region)
                        return true if state.provenance.binding_region[target_slot] == region and state.provenance.binding_region_live[target_slot]
            return false

        def proof_kernel_replay_resource_has_borrow(state: ProofKernelReplayResourceState&, target_slot: usize, except_slot: usize) -> bool:
            for index in 0..<state.borrows.borrow_target_slots.count |index, state, target_slot, except_slot|:
                return true if:
                    not proof_kernel_replay_resource_charge_work_used(&state.scope.resource_work_used, 1)
                    index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and state.borrows.borrow_target_slots[index] == target_slot
            return false

        def proof_kernel_replay_resource_has_mutable_borrow(state: ProofKernelReplayResourceState&, target_slot: usize, except_slot: usize) -> bool:
            for index in 0..<state.borrows.borrow_target_slots.count |index, state, target_slot, except_slot|:
                return true if:
                    not proof_kernel_replay_resource_charge_work_used(&state.scope.resource_work_used, 1)
                    index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and state.borrows.borrow_target_slots[index] == target_slot and index < state.borrows.borrow_mutable.count and state.borrows.borrow_mutable[index]
            return false

        def proof_kernel_replay_resource_has_borrow_overlap(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: ProofKernelReplayResourceState&, target: ProofKernelReplayResourcePlace, except_slot: usize) -> bool:
            return false if not proof_kernel_replay_resource_place_root_valid(nodes, target)
            for index in 0..<state.borrows.borrow_target_places.count |index, state, target, except_slot|:
                return false if not proof_kernel_replay_resource_charge_work_used(&state.scope.resource_work_used, 1)
                return true if index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and proof_kernel_replay_resource_places_overlap(state, nodes, state.borrows.borrow_target_places[index], target)
            target_slot: usize = proof_kernel_replay_resource_lookup_place(state, nodes, target)
            target_region: sview = proof_kernel_replay_resource_binding_region(state, target_slot)
            for borrowed in state.regions.region_wide_borrows |borrowed, state, target_region|:
                return false if not proof_kernel_replay_resource_charge_text_pair_used(&state.scope.resource_work_used, borrowed, target_region)
                return true if target_region != "" and borrowed == target_region
            return false

        def proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: ProofKernelReplayResourceState&, target: ProofKernelReplayResourcePlace, except_slot: usize) -> bool:
            return false if not proof_kernel_replay_resource_place_root_valid(nodes, target)
            for index in 0..<state.borrows.borrow_target_places.count |index, state, target, except_slot|:
                return false if not proof_kernel_replay_resource_charge_work_used(&state.scope.resource_work_used, 1)
                return true if index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and index < state.borrows.borrow_mutable.count and state.borrows.borrow_mutable[index] and proof_kernel_replay_resource_places_overlap(state, nodes, state.borrows.borrow_target_places[index], target)
            return false

        def proof_kernel_replay_resource_origin_for(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: ProofKernelReplayResourceState&, slot: usize) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if slot >= state.bindings.binding_origin_places.count
            origin: ProofKernelReplayResourcePlace = state.bindings.binding_origin_places[slot]
            return (proof_kernel_replay_resource_place_root_valid(nodes, origin), origin)

        def proof_kernel_replay_resource_resolve_origin(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, state: mutable ProofKernelReplayResourceState&, decoded: ProofKernelReplayResourcePlace, binding_name: sview) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if not proof_kernel_replay_resource_place_root_matches(state, nodes, decoded, binding_name)
            slot: usize = proof_kernel_replay_resource_lookup(state, binding_name)
            return (false, empty) if slot >= state.bindings.binding_names.count
            origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(nodes, state, slot)
            return (false, empty) if not origin.known
            return proof_kernel_replay_resource_place_append(state, nodes, origin.place, decoded)

        # Replay the ownership transition language without consulting the AST checker. A scope
        # node receives a copy of its parent's resource state. Ordinary lexical scopes discard
        # child transitions on return. Moves of inherited bindings are represented by explicit
        # resource-join-move transitions emitted after the scope, keeping the parent-state update
        # flat and replayable without aliasing the nested state object.
        def proof_kernel_replay_resource_parameters(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, state: mutable ProofKernelReplayResourceState&, names: mutable darray[sview]&, references: mutable darray[bool]&, mutable_references: mutable darray[bool]&, regions: mutable darray[sview]&) -> bool:
            return false if root >= nodes.count or nodes[root].kind != "resource-safety"
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if:
                node.auxiliary > node.children_count
                not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            # The decoder owns the output contract: every result array describes only this
            # resource-safety root. Clear all arrays, not just region metadata, so a future
            # caller reusing scratch storage cannot accidentally retain a prior formal name,
            # reference mode, or mutability bit and authorize a mismatched call argument.
            names.clear()
            references.clear()
            mutable_references.clear()
            regions.clear()
            scan: mutable usize = 0
            region_prefix: mutable bool = true
            while scan < node.children_count |scan, node, children, names, references, mutable_references, regions, region_prefix|:
                return false if not proof_kernel_replay_resource_charge_work(state, 1)
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + scan)
                return false if:
                    not child.known
                    child.value >= nodes.count
                child_node: ElisaProofKernelCore::ProofKernelNode = nodes[child.value]
                return false if not proof_kernel_replay_resource_charge_node_text(state, child_node)
                if child_node.kind == "resource-region-param":
                    return false if not region_prefix
                    scan <- scan + 1
                    continue
                region_prefix <- false
                if names.count < node.auxiliary:
                    return false if child_node.kind != "resource-bind"
                    bind: ElisaProofKernelCore::ProofKernelNode = child_node
                    return false if:
                        bind.operator != "value" and bind.operator != "external-shared" and bind.operator != "external-mutable"
                        bind.name == ""
                    for prior in names |prior, names, bind, state|:
                        return false if:
                            not proof_kernel_replay_resource_charge_text_pair(state, prior, bind.name)
                            prior == bind.name
                    names.push(bind.name)
                    references.push(bind.operator in {"external-shared", "external-mutable"})
                    mutable_references.push(bind.operator == "external-mutable")
                    regions.push(bind.secondary_name if bind.operator in {"external-shared", "external-mutable"} else "")
                    scan <- scan + 1
                    # A view lifetime decorates exactly the immediately preceding value formal.
                    # Consume it before looking for the next formal, including after the last one.
                    if scan < node.children_count:
                        next_root: usize = children[node.children_start + scan]
                        return false if next_root >= nodes.count
                        marker: ElisaProofKernelCore::ProofKernelNode = nodes[next_root]
                        return false if:
                            not proof_kernel_replay_resource_charge_node_text(state, marker)
                            marker.kind == "resource-sview-param" and not proof_kernel_replay_resource_charge_text_pair(state, marker.name, bind.name)
                        if marker.kind == "resource-sview-param":
                            return false if bind.operator != "value" or marker.name != bind.name or marker.secondary_name == ""
                            regions[regions.count - 1] <- marker.secondary_name
                            scan <- scan + 1
                    continue
                break
            # Once the formal prefix ends, a region parameter is body data and therefore
            # malformed. Do not let the call composer invent a lifetime parameter from it.
            while scan < node.children_count |scan, node, children, nodes, state|:
                return false if not proof_kernel_replay_resource_charge_work(state, 1)
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + scan)
                return false if:
                    not child.known
                    child.value >= nodes.count
                    not proof_kernel_replay_resource_charge_node_text(state, nodes[child.value])
                    nodes[child.value].kind == "resource-region-param" or nodes[child.value].kind == "resource-sview-param"
                scan <- scan + 1
            return false if names.count != node.auxiliary
            return true

        def proof_kernel_replay_resource_call_actual(state: mutable ProofKernelReplayResourceState&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, argument_root: usize, arena_admitted: bool) -> (known: bool, place: ProofKernelReplayResourcePlace, slot: usize, has_slot: bool, mutable_reference: bool):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty, state.bindings.binding_names.count, false, false) if:
                argument_root >= nodes.count
                nodes[argument_root].kind != "resource-call-arg"
            if nodes[argument_root].operator == "region-new":
                allocation_root: usize = nodes[argument_root].left
                return (false, empty, state.bindings.binding_names.count, false, false) if:
                    allocation_root >= nodes.count
                    not proof_kernel_replay_resource_charge_text_pair(state, nodes[allocation_root].secondary_name, nodes[argument_root].secondary_name)
                    nodes[allocation_root].kind != "resource-region-call-alloc" or nodes[allocation_root].secondary_name != nodes[argument_root].secondary_name
                allocation_recorded: mutable bool = false
                for prior_allocation in state.scope.resource_call_allocations |prior_allocation, allocation_recorded, state|:
                    return (false, empty, state.bindings.binding_names.count, false, false) if not proof_kernel_replay_resource_charge_work(state, 1)
                    allocation_recorded <- true if prior_allocation == allocation_root
                return (false, empty, state.bindings.binding_names.count, false, false) if:
                    not allocation_recorded
                    not proof_kernel_replay_resource_region_active(state, nodes[argument_root].secondary_name)
                    not arena_admitted and not proof_kernel_replay_arena_valid(nodes, children, [], nodes[allocation_root].left)
                # A fresh allocation has no pre-existing caller place and is writable for the
                # duration of this call. Its callee effects are checked as temporary effects and
                # are not exported to the caller state.
                return (true, empty, state.bindings.binding_names.count, false, true)
            if nodes[argument_root].operator == "value":
                # A non-scalar by-value actual may be Elisa's implicit shared-borrow spelling.
                # Owned aggregates need the producer's borrowable marker; fields reached through
                # a shared reference may be lent only while that reference binding stays live.
                decoded_value: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(state, nodes, children, nodes[argument_root].left, 0)
                if decoded_value.known and proof_kernel_replay_resource_place_root_valid(nodes, decoded_value.place):
                    value_slot: usize = proof_kernel_replay_resource_lookup_place(state, nodes, decoded_value.place)
                    if proof_kernel_replay_resource_binding_allows_implicit_shared_borrow(state, value_slot, decoded_value.place):
                        return (false, empty, state.bindings.binding_names.count, false, false) if:
                            value_slot >= state.bindings.binding_moved.count or state.bindings.binding_moved[value_slot]
                            not proof_kernel_replay_resource_binding_region_lifetime_valid(state, value_slot)
                        return (true, decoded_value.place, value_slot, true, false)
                # A value formal is scalar/resource-neutral at this boundary. The source checker
                # rejects a region-owned actual here; replay must inspect the actual term too,
                # otherwise a forged value argument can erase its lifetime label.
                return (false, empty, state.bindings.binding_names.count, false, false) if:
                    proof_kernel_replay_resource_value_term_is_direct_reference(nodes, state, nodes[argument_root].left)
                    not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, nodes[argument_root].left, 0)
                return (true, empty, state.bindings.binding_names.count, false, false)
            decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(state, nodes, children, nodes[argument_root].left, 0)
            return (false, empty, state.bindings.binding_names.count, false, false) if:
                not decoded.known
                not proof_kernel_replay_resource_place_root_valid(nodes, decoded.place)
            slot: usize = proof_kernel_replay_resource_lookup_place(state, nodes, decoded.place)
            if nodes[argument_root].operator == "reference":
                return (false, empty, state.bindings.binding_names.count, false, false) if:
                    slot >= state.bindings.binding_names.count or slot >= state.bindings.binding_reference.count or not state.bindings.binding_reference[slot]
                    slot >= state.bindings.binding_moved.count or state.bindings.binding_moved[slot]
                    not proof_kernel_replay_resource_binding_region_lifetime_valid(state, slot)
                if slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot] and slot < state.borrows.borrow_target_places.count and proof_kernel_replay_resource_place_root_valid(nodes, state.borrows.borrow_target_places[slot]):
                    return (true, state.borrows.borrow_target_places[slot], slot, true, slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot])
                origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(nodes, state, slot)
                # A direct region allocation has no older origin; the binding itself is still a
                # valid resource place. Borrow aliases do carry an origin and retain that exact
                # provenance for effect composition.
                return (true, decoded.place, slot, true, slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]) if not origin.known
                return (true, origin.place, slot, true, slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot])
            return (false, empty, state.bindings.binding_names.count, false, false) if:
                nodes[argument_root].operator != "borrow"
                slot >= state.bindings.binding_names.count
                slot >= state.bindings.binding_moved.count or state.bindings.binding_moved[slot]
                not proof_kernel_replay_resource_binding_region_lifetime_valid(state, slot)
            if slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]:
                origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(nodes, state, slot)
                return (false, empty, state.bindings.binding_names.count, false, false) if not origin.known
                composed: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place_append(state, nodes, origin.place, decoded.place)
                return (false, empty, state.bindings.binding_names.count, false, false) if not composed.known
                return (true, composed.place, slot, false, slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot])
            return (true, decoded.place, slot, false, false)

        # Compose a verified callee trace at a call site. The callee is replayed from an empty
        # state first; only writes whose origin is one of its formal reference capabilities are
        # exported. A move cannot yet be summarized, so the kernel rejects it instead of
        # silently treating ownership transfer as an ordinary write.

        # A lifetime pinned to the caller's own frame rather than to a region. The caller's frame
        # outlives any call it makes, so an actual the caller holds outright — a live, unmoved
        # binding with no region of its own — satisfies it. The name is outside the identifier
        # grammar, so no source region can be spelled this way.
