extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT: usize = 65536

        def proof_kernel_replay_scalar_witness_charge(work_used: mutable usize&, amount: usize, work_limit: usize) -> bool:
            return false if work_used > work_limit
            if amount > work_limit - work_used:
                work_used <- work_limit + 1
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_replay_scalar_witness_charge_text_pair(work_used: mutable usize&, left: sview, right: sview, work_limit: usize) -> bool:
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(left), work_limit)
            proof_kernel_replay_scalar_witness_charge(work_used, sview_len(right), work_limit)

        def proof_kernel_replay_scalar_witness_charge_node_text(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[root].kind), work_limit)
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[root].operator), work_limit)
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[root].name), work_limit)
            proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[root].secondary_name), work_limit)

        def proof_kernel_replay_scalar_witness_charge_node_kind(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[root].kind), work_limit)

        def proof_kernel_replay_scalar_witness_ident_matches_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, expected: sview, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if root >= nodes.count
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[root].kind), work_limit)
            return false if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, nodes[root].name, expected, work_limit)
            nodes[root].kind == "ident" and nodes[root].name == expected

        def proof_kernel_replay_scalar_witness_ident_name_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, work_limit: usize) -> sview:
            return "" if root >= nodes.count or not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            return "" if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[root].kind), work_limit)
            return "" if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[root].name), work_limit)
            return nodes[root].name if nodes[root].kind == "ident"
            ""

        def proof_kernel_replay_scalar_witness_expr_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: usize, right: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            remaining: usize = work_limit - work_used
            equality_limit: usize = remaining if remaining < PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK else PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
            equality_work: mutable usize = 0
            equal: bool = proof_kernel_replay_expr_equal_with_work(nodes, children, left, right, 0, equality_limit, &equality_work)
            proof_kernel_replay_scalar_witness_charge(work_used, equality_work, work_limit)
            return false if work_used > work_limit
            if not equal and equality_work >= equality_limit:
                work_used <- work_limit + 1
                return false
            equal

        def proof_kernel_replay_scalar_witnessed(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, markers: darray[ProofKernelReplayWitnessMarker], name: sview) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_scalar_witnessed_with_work(nodes, markers, name, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)

        def proof_kernel_replay_scalar_witnessed_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, markers: darray[ProofKernelReplayWitnessMarker], name: sview, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(name), work_limit)
            return false if name == ""
            for marker in markers |marker, nodes, name, work_used, work_limit|:
                marker_name: sview = proof_kernel_replay_scalar_witness_ident_name_with_work(nodes, marker.root, work_used, work_limit)
                return false if work_used > work_limit
                return false if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, marker_name, name, work_limit)
                return true if marker.kind == PROOF_KERNEL_REPLAY_WITNESS_PRIMITIVE_SCALAR and marker_name == name
                return true if marker.kind == PROOF_KERNEL_REPLAY_WITNESS_UNSIGNED_TYPE and marker_name == name
            return false

        def proof_kernel_replay_witness_marker_cache_fill_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, work_used: mutable usize&, work_limit: usize) -> bool:
            markers.clear()
            for fact in facts |fact, nodes, children, markers, work_used, work_limit|:
                return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                continue if fact >= nodes.count
                return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[fact].kind), work_limit)
                if nodes[fact].kind == "call" and nodes[fact].left < nodes.count:
                    return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                    return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[nodes[fact].left].kind), work_limit)
                    return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(nodes[nodes[fact].left].name), work_limit)
                continue if not proof_kernel_replay_witness_marker_candidate(nodes, fact)
                marker_name: sview = nodes[nodes[fact].left].name
                if marker_name == "__elisa_untrusted_operator_type":
                    marker: (known: bool, term: usize) = proof_kernel_replay_untrusted_operator_marker_with_work(nodes, children, fact, work_used, work_limit)
                    markers.push(ProofKernelReplayWitnessMarker{kind: PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_OPERATOR, root: marker.term, depth: 0}) if marker.known
                elif marker_name == "__elisa_primitive_scalar_type" or marker_name == "__elisa_primitive_integer_type":
                    marker: (known: bool, root: usize) = proof_kernel_replay_marker_argument_with_work(nodes, children, fact, "__elisa_primitive_scalar_type", work_used, work_limit)
                    markers.push(ProofKernelReplayWitnessMarker{kind: PROOF_KERNEL_REPLAY_WITNESS_PRIMITIVE_SCALAR, root: marker.root, depth: 0}) if marker.known
                elif marker_name == "__elisa_unsigned_type_bound":
                    marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info_with_work(nodes, children, fact, 0, work_used, work_limit)
                    markers.push(ProofKernelReplayWitnessMarker{kind: PROOF_KERNEL_REPLAY_WITNESS_UNSIGNED_TYPE, root: marker.name_root, depth: 0}) if marker.known
                    return false if work_used > work_limit
                    return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                    first = proof_kernel_replay_child_at(children, nodes[fact].children_start)
                    if first.known and first.value < nodes.count:
                        return false if not proof_kernel_replay_scalar_witness_charge_node_kind(nodes, first.value, work_used, work_limit)
                        if nodes[first.value].kind == "call_arg":
                            term: usize = nodes[first.value].left
                            key = proof_kernel_replay_loop_range_atom_key_with_work(nodes, children, term, work_used, work_limit)
                            return false if work_used > work_limit
                            if key.known and marker.known:
                                markers.push(ProofKernelReplayWitnessMarker{kind: PROOF_KERNEL_REPLAY_WITNESS_PRIMITIVE_SCALAR, root: term, depth: 0})
                elif marker_name == "__elisa_primitive_scalar_element":
                    marker: (known: bool, root: usize, depth: i64, width: i64) = proof_kernel_replay_element_marker_with_work(nodes, children, fact, work_used, work_limit)
                    markers.push(ProofKernelReplayWitnessMarker{kind: PROOF_KERNEL_REPLAY_WITNESS_SCALAR_ELEMENT, root: marker.root, depth: marker.depth}) if marker.known
            return work_used <= work_limit

        def proof_kernel_replay_loop_range_atom_key_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&, work_limit: usize) -> (known: bool, name: sview, offset: i64):
            empty: (known: bool, name: sview, offset: i64) = (false, "", 0)
            return empty if not proof_kernel_replay_scalar_witness_charge_node_text(nodes, root, work_used, work_limit)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if node.kind != "tuple" or node.children_count != 2 or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            return empty if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start)
            return empty if not first.known or not proof_kernel_replay_scalar_witness_charge_node_text(nodes, first.value, work_used, work_limit)
            return empty if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + 1)
            return empty if not second.known or not proof_kernel_replay_scalar_witness_charge_node_text(nodes, second.value, work_used, work_limit)
            return empty if nodes[first.value].kind != "ident" or nodes[first.value].name == "" or nodes[second.value].kind != "int"
            (true, nodes[first.value].name, nodes[second.value].value)

        def proof_kernel_replay_marker_argument_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, callee: sview, work_used: mutable usize&, work_limit: usize) -> (known: bool, root: usize):
            empty: (known: bool, root: usize) = (false, 0)
            return empty if not proof_kernel_replay_scalar_witness_charge_node_text(nodes, root, work_used, work_limit)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if node.kind != "call" or node.operator != "" or node.auxiliary != 0 or node.children_count != 1
            return empty if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            callee_matches: bool = proof_kernel_replay_scalar_witness_ident_matches_with_work(nodes, node.left, callee, work_used, work_limit)
            scalar_integer: mutable bool = false
            if not callee_matches and callee == "__elisa_primitive_scalar_type":
                scalar_integer <- proof_kernel_replay_scalar_witness_ident_matches_with_work(nodes, node.left, "__elisa_primitive_integer_type", work_used, work_limit)
            return empty if work_used > work_limit or (not callee_matches and not scalar_integer)
            return empty if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start)
            return empty if not argument.known or not proof_kernel_replay_scalar_witness_charge_node_text(nodes, argument.value, work_used, work_limit)
            argument_node: ElisaProofKernelCore::ProofKernelNode = nodes[argument.value]
            return empty if argument_node.kind != "call_arg" or argument_node.name != "" or argument_node.secondary_name != "" or not proof_kernel_replay_valid(nodes, argument_node.left)
            (true, argument_node.left)

        def proof_kernel_replay_untrusted_operator_marker_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&, work_limit: usize) -> (known: bool, term: usize):
            empty: (known: bool, term: usize) = (false, 0)
            return empty if not proof_kernel_replay_scalar_witness_charge_node_text(nodes, root, work_used, work_limit)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if node.kind != "call" or node.operator != "" or node.auxiliary != 0 or node.children_count != 2
            return empty if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            return empty if not proof_kernel_replay_scalar_witness_ident_matches_with_work(nodes, node.left, "__elisa_untrusted_operator_type", work_used, work_limit)
            return empty if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            term_argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start)
            return empty if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            protocol_argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + 1)
            return empty if not term_argument.known or not protocol_argument.known
            return empty if not proof_kernel_replay_scalar_witness_charge_node_text(nodes, term_argument.value, work_used, work_limit)
            term_node: ElisaProofKernelCore::ProofKernelNode = nodes[term_argument.value]
            term_positional: bool = proof_kernel_replay_scalar_witness_positional_argument_with_work(term_node, work_used, work_limit)
            return empty if work_used > work_limit or not term_positional
            return empty if not proof_kernel_replay_scalar_witness_charge_node_text(nodes, protocol_argument.value, work_used, work_limit)
            protocol_node: ElisaProofKernelCore::ProofKernelNode = nodes[protocol_argument.value]
            protocol_positional: bool = proof_kernel_replay_scalar_witness_positional_argument_with_work(protocol_node, work_used, work_limit)
            return empty if work_used > work_limit or not protocol_positional
            return empty if not proof_kernel_replay_valid(nodes, term_node.left) or not proof_kernel_replay_valid(nodes, protocol_node.left)
            return empty if not proof_kernel_replay_scalar_witness_charge_node_text(nodes, protocol_node.left, work_used, work_limit)
            protocol: ElisaProofKernelCore::ProofKernelNode = nodes[protocol_node.left]
            return empty if protocol.kind != "string" or protocol.name == ""
            (true, term_node.left)

        def proof_kernel_replay_unsigned_marker_info_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize, work_used: mutable usize&, work_limit: usize) -> (known: bool, name_root: usize, width: i64):
            return (false, 0, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count
            return (false, 0, 0) if not proof_kernel_replay_scalar_witness_charge_node_text(nodes, root, work_used, work_limit)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, 0) if node.kind != "call" or node.operator != "" or node.auxiliary != 0 or node.children_count != 2
            return (false, 0, 0) if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            return (false, 0, 0) if not proof_kernel_replay_scalar_witness_ident_matches_with_work(nodes, node.left, "__elisa_unsigned_type_bound", work_used, work_limit)
            return (false, 0, 0) if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start)
            return (false, 0, 0) if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + 1)
            return (false, 0, 0) if not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
            name_arg: ElisaProofKernelCore::ProofKernelNode = nodes[first.value]
            name_positional: bool = proof_kernel_replay_scalar_witness_positional_argument_with_work(name_arg, work_used, work_limit)
            return (false, 0, 0) if work_used > work_limit or not name_positional
            width_arg: ElisaProofKernelCore::ProofKernelNode = nodes[second.value]
            width_positional: bool = proof_kernel_replay_scalar_witness_positional_argument_with_work(width_arg, work_used, work_limit)
            return (false, 0, 0) if work_used > work_limit or not width_positional
            name_root: usize = name_arg.left
            return (false, 0, 0) if not proof_kernel_replay_scalar_witness_charge_node_text(nodes, name_root, work_used, work_limit)
            return (false, 0, 0) if not proof_kernel_replay_valid(nodes, name_root) or nodes[name_root].kind != "ident" or nodes[name_root].name == ""
            width_depth: usize = depth + 1
            return (false, 0, 0) if width_depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            width_work: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, width_arg.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - width_depth, work_used, work_limit)
            return (false, 0, 0) if not width_work.known or width_work.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or width_work.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
            return (true, name_root, width_work.value)

        def proof_kernel_replay_scalar_witness_positional_argument_with_work(argument: ElisaProofKernelCore::ProofKernelNode, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, sview_len(argument.kind), work_limit)
            return false if argument.kind != "call_arg"
            return false if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, argument.name, argument.secondary_name, work_limit)
            argument.name == "" and argument.secondary_name == ""

        def proof_kernel_replay_element_marker_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&, work_limit: usize) -> (known: bool, root: usize, depth: i64, width: i64):
            return (false, 0, 0, 0) if root >= nodes.count or not proof_kernel_replay_scalar_witness_charge_node_text(nodes, root, work_used, work_limit)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, 0, 0) if node.kind != "call" or node.operator != "" or node.auxiliary != 0 or (node.children_count != 2 and node.children_count != 3)
            return (false, 0, 0, 0) if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count) or not proof_kernel_replay_scalar_witness_ident_matches_with_work(nodes, node.left, "__elisa_primitive_scalar_element", work_used, work_limit)
            return (false, 0, 0, 0) if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            term_argument: (known: bool, value: usize) = proof_kernel_replay_index_at(children, node.children_start)
            return (false, 0, 0, 0) if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            depth_argument: (known: bool, value: usize) = proof_kernel_replay_index_at(children, node.children_start + 1)
            return (false, 0, 0, 0) if not term_argument.known or not depth_argument.known
            term_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, term_argument.value)
            depth_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, depth_argument.value)
            return (false, 0, 0, 0) if not term_node.known or not depth_node.known
            term_is_positional: bool = proof_kernel_replay_scalar_witness_positional_argument_with_work(term_node.node, work_used, work_limit)
            return (false, 0, 0, 0) if work_used > work_limit or not term_is_positional
            depth_is_positional: bool = proof_kernel_replay_scalar_witness_positional_argument_with_work(depth_node.node, work_used, work_limit)
            return (false, 0, 0, 0) if work_used > work_limit or not depth_is_positional or not proof_kernel_replay_valid(nodes, term_node.node.left)
            constant_depth: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            depth_work: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, depth_node.node.left, constant_depth, work_used, work_limit)
            return (false, 0, 0, 0) if not depth_work.known or depth_work.value < 1 or depth_work.value > PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT
            width: mutable i64 = 0
            if node.children_count == 3:
                return (false, 0, 0, 0) if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                width_argument: (known: bool, value: usize) = proof_kernel_replay_index_at(children, node.children_start + 2)
                return (false, 0, 0, 0) if not width_argument.known
                width_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, width_argument.value)
                return (false, 0, 0, 0) if not width_node.known
                width_is_positional: bool = proof_kernel_replay_scalar_witness_positional_argument_with_work(width_node.node, work_used, work_limit)
                return (false, 0, 0, 0) if work_used > work_limit or not width_is_positional or not proof_kernel_replay_valid(nodes, width_node.node.left)
                marked_width: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, width_node.node.left, constant_depth, work_used, work_limit)
                return (false, 0, 0, 0) if not marked_width.known or marked_width.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or marked_width.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
                width <- marked_width.value
            return (true, term_node.node.left, depth_work.value, width)

        def proof_kernel_replay_indexed_container_path(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, expression: usize, container: mutable usize&, subscripts: mutable darray[usize]&, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_indexed_container_path_with_work(nodes, children, expression, container, subscripts, depth, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)

        def proof_kernel_replay_indexed_container_path_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, expression: usize, container: mutable usize&, subscripts: mutable darray[usize]&, depth: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            decreases PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            return false if not proof_kernel_replay_valid(nodes, expression)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[expression]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren":
                return proof_kernel_replay_indexed_container_path_with_work(nodes, children, node.left, container, subscripts, depth + 1, work_used, work_limit)
            if node.kind == "index":
                return false if not proof_kernel_replay_indexed_container_path_with_work(nodes, children, node.left, container, subscripts, depth + 1, work_used, work_limit)
                return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                subscripts.push(node.right)
                return true
            if node.kind == "index-n":
                return false if node.children_count == 0 or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                return false if not proof_kernel_replay_indexed_container_path_with_work(nodes, children, node.left, container, subscripts, depth + 1, work_used, work_limit)
                for offset in 0..<node.children_count |offset, children, node, subscripts, work_used, work_limit|:
                    return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                    argument: (known: bool, value: usize) = proof_kernel_replay_index_at(children, node.children_start + offset)
                    return false if not argument.known
                    subscripts.push(argument.value)
                return true
            container <- expression
            return true

        def proof_kernel_replay_untrusted_operator_applies(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, marked_term: usize, term: usize, depth: usize) -> bool:
            work_used: mutable usize = 0
            applies: bool = proof_kernel_replay_untrusted_operator_applies_with_work(nodes, children, marked_term, term, depth, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)
            return true if work_used > PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT
            applies

        def proof_kernel_replay_untrusted_operator_applies_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, marked_term: usize, term: usize, depth: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            return false if depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            return true if proof_kernel_replay_scalar_witness_expr_equal(nodes, children, marked_term, term, work_used, work_limit)
            return false if work_used > work_limit
            term_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, term)
            return false if not term_node.known or term_node.node.kind != "field"
            container: mutable usize = 0
            subscripts: mutable darray[usize] = []
            return false if not proof_kernel_replay_indexed_container_path_with_work(nodes, children, term_node.node.left, &container, &subscripts, depth + 1, work_used, work_limit) or subscripts.count == 0
            marked_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, marked_term)
            return false if not marked_node.known or marked_node.node.kind != "field"
            return false if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, marked_node.node.name, term_node.node.name, work_limit)
            return false if marked_node.node.name != term_node.node.name
            return proof_kernel_replay_scalar_witness_expr_equal(nodes, children, marked_node.node.left, container, work_used, work_limit)

        def proof_kernel_replay_scalar_element_remaining(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, subscripts: mutable darray[usize]&, depth: usize) -> i64:
            work_used: mutable usize = 0
            proof_kernel_replay_scalar_element_remaining_with_work(nodes, children, facts, root, subscripts, depth, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)

        def proof_kernel_replay_scalar_element_remaining_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, subscripts: mutable darray[usize]&, depth: usize, work_used: mutable usize&, work_limit: usize) -> i64:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            return -1 if not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return -1 if budget == 0
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return -1 if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, work_limit)
            proof_kernel_replay_scalar_element_remaining_budget_with_work(nodes, children, markers, root, subscripts, depth, budget, work_used, work_limit)

        def proof_kernel_replay_scalar_element_remaining_budget(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, subscripts: mutable darray[usize]&, depth: usize, budget: usize) -> i64:
            work_used: mutable usize = 0
            proof_kernel_replay_scalar_element_remaining_budget_with_work(nodes, children, markers, root, subscripts, depth, budget, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)

        def proof_kernel_replay_scalar_element_remaining_budget_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, subscripts: mutable darray[usize]&, depth: usize, budget: usize, work_used: mutable usize&, work_limit: usize) -> i64:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            requires budget > 0
            decreases budget
            return -1 if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            return -1 if not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH or not proof_kernel_replay_valid(nodes, root)
            for marker in markers |marker, nodes, children, root, work_used, work_limit|:
                return -1 if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                continue if marker.kind != PROOF_KERNEL_REPLAY_WITNESS_SCALAR_ELEMENT
                return marker.depth if proof_kernel_replay_scalar_witness_expr_equal(nodes, children, marker.root, root, work_used, work_limit)
                return -1 if work_used > work_limit
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return -1 if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return -1 if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "field":
                container: mutable usize = 0
                path_subscripts: mutable darray[usize] = []
                return -1 if not proof_kernel_replay_indexed_container_path_with_work(nodes, children, node.left, &container, &path_subscripts, depth + 1, work_used, work_limit) or path_subscripts.count == 0
                for marker in markers |nodes, children, node, container, path_subscripts, root, work_used, work_limit|:
                    return -1 if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                    continue if marker.kind != PROOF_KERNEL_REPLAY_WITNESS_SCALAR_ELEMENT
                    field: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, marker.root)
                    continue if not field.known or field.node.kind != "field"
                    return -1 if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, field.node.name, node.name, work_limit)
                    continue if field.node.name != node.name
                    continue if not proof_kernel_replay_scalar_witness_expr_equal(nodes, children, field.node.left, container, work_used, work_limit)
                    return -1 if work_used > work_limit
                    return -1 if marker.depth < path_subscripts.count.i64() or budget <= 1
                    for subscript in path_subscripts |nodes, children, markers, depth, budget, work_used, work_limit|:
                        return -1 if not proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, subscript, depth + 1, budget - 1, work_used, work_limit)
                    return marker.depth - path_subscripts.count.i64()
                return -1
            if node.kind == "index":
                return -1 if budget <= 1
                remaining: i64 = proof_kernel_replay_scalar_element_remaining_budget_with_work(nodes, children, markers, node.left, subscripts, depth + 1, budget - 1, work_used, work_limit)
                return -1 if remaining < 1 or work_used > work_limit
                return -1 if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                subscripts.push(node.right)
                return remaining - 1
            if node.kind == "index-n":
                return -1 if node.children_count == 0 or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count) or budget <= 1
                remaining: i64 = proof_kernel_replay_scalar_element_remaining_budget_with_work(nodes, children, markers, node.left, subscripts, depth + 1, budget - 1, work_used, work_limit)
                return -1 if remaining < node.children_count.i64() or work_used > work_limit
                for offset in 0..<node.children_count |offset, children, node, subscripts, work_used, work_limit|:
                    return -1 if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                    argument: (known: bool, value: usize) = proof_kernel_replay_index_at(children, node.children_start + offset)
                    return -1 if not argument.known
                    subscripts.push(argument.value)
                return remaining - node.children_count.i64()
            return -1

        def proof_kernel_replay_integer_cast_target(target: sview) -> bool:
            return target == "i8" or target == "i16" or target == "i32" or target == "i64" or target == "isize" or target == "int" or target == "u8" or target == "u16" or target == "u32" or target == "u64" or target == "usize" or target == "uint"

        def proof_kernel_replay_scalar_term_witnessed(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, depth, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)

        # Paired report checks share immutable marker inputs. Parse them once so the common fact
        # scan is charged once, then carry that same marker set through both term traversals.
        def proof_kernel_replay_scalar_term_pair_witnessed_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, depth: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return false if budget == 0
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, work_limit)
            first: bool = proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, left, depth, budget, work_used, work_limit)
            return false if work_used > work_limit or not first
            proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, right, depth, budget, work_used, work_limit)

        def proof_kernel_replay_scalar_term_witnessed_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return false if budget == 0
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, work_limit)
            proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, root, depth, work_used, work_limit)

        # Reuse a fact-marker cache across related scalar queries that share immutable facts.
        # Keep the same depth-derived recursion budget as the cache-building wrapper above.
        def proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, depth: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return false if budget == 0
            proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, root, depth, budget, work_used, work_limit)

        def proof_kernel_replay_scalar_term_witnessed_budget(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, depth: usize, budget: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, root, depth, budget, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)

        def proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, depth: usize, budget: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            requires budget > 0
            decreases budget
            return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            for marker in markers |marker, nodes, children, root, depth, work_used, work_limit|:
                return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                if marker.kind == PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_OPERATOR:
                    return false if proof_kernel_replay_untrusted_operator_applies_with_work(nodes, children, marker.root, root, depth + 1, work_used, work_limit)
            return false if work_used > work_limit
            return true if proof_kernel_replay_congruent_scalar_literal(node)
            if node.kind == "ident":
                witnessed: bool = proof_kernel_replay_scalar_witnessed_with_work(nodes, markers, node.name, work_used, work_limit)
                return false if work_used > work_limit
                return witnessed
            for marker in markers |marker, nodes, children, root, work_used, work_limit|:
                return false if not proof_kernel_replay_scalar_witness_charge(work_used, 1, work_limit)
                if marker.kind == PROOF_KERNEL_REPLAY_WITNESS_PRIMITIVE_SCALAR:
                    equal: bool = proof_kernel_replay_scalar_witness_expr_equal(nodes, children, marker.root, root, work_used, work_limit)
                    return false if work_used > work_limit
                    return true if equal
            return true if node.kind == "field" and node.name == "count" and node.left < nodes.count and nodes[node.left].kind == "array"
            if node.kind == "call":
                return false if node.operator != "" or node.auxiliary != 0 or node.children_count != 0 or node.value != 0 or node.name != "" or node.secondary_name != ""
                return false if node.children_start > children.count or node.left >= nodes.count or not proof_kernel_replay_valid(nodes, node.left)
                callee: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                return false if not proof_kernel_replay_arena_shape_valid(callee) or callee.kind != "field" or not proof_kernel_replay_integer_cast_target(callee.name) or budget <= 1
                return proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, callee.left, depth + 1, budget - 1, work_used, work_limit)
            if node.kind == "index" or node.kind == "index-n" or node.kind == "field":
                subscripts: mutable darray[usize] = []
                return false if budget <= 1
                remaining: i64 = proof_kernel_replay_scalar_element_remaining_budget_with_work(nodes, children, markers, root, &subscripts, depth + 1, budget - 1, work_used, work_limit)
                return false if remaining != 0 or work_used > work_limit
                for subscript in subscripts |subscript, nodes, children, markers, depth, budget, work_used, work_limit|:
                    return false if not proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, subscript, depth + 1, budget - 1, work_used, work_limit)
                return true
            return false if not proof_kernel_replay_congruent_former(node)
            operands: mutable darray[usize] = []
            return false if not proof_kernel_replay_congruence_operands(nodes, children, root, &operands)
            for operand in operands |operand, nodes, children, markers, depth, budget, work_used, work_limit|:
                return false if not proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, operand, depth + 1, budget - 1, work_used, work_limit)
            return true
