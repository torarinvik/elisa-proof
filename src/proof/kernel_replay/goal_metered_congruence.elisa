# Ground congruence closure under the caller's shared replay budget.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_congruence_charge_operand_read_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT

        def proof_kernel_replay_congruence_lookup_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, terms: darray[usize]&, root: usize, work_used: mutable usize&) -> (known: bool, index: usize):
            for index in 0..<terms.count |index, terms, nodes, children, root, work_used|:
                return (false, 0) if not proof_kernel_replay_goal_search_charge(work_used)
                term: (known: bool, value: usize) = proof_kernel_replay_index_at(terms, index)
                continue if not term.known
                same: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, term.value, root, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, index) if same
            return (false, 0)

        def proof_kernel_replay_congruence_push_with_goal_work(terms: mutable darray[usize]&, root: usize, exhausted: mutable bool&, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            if terms.count >= proof_kernel_replay_congruence_term_limit():
                exhausted <- true
                return false
            terms.push(root)
            return true

        def proof_kernel_replay_congruence_collect_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, root: usize, terms: mutable darray[usize]&, exhausted: mutable bool&, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            decreases PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
                not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "binary" and node.operator in {"==", "!=", "<", "<=", ">", ">="}:
                primitive_relation: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                    exhausted <- true
                    return false
                # A marker on either operand means the comparison may depend on an
                # untrusted implementation, not the kernel's primitive relation. Do not
                # admit it as a term or let it become an equality seed.
                return false if not primitive_relation
            existing: (known: bool, index: usize) = proof_kernel_replay_congruence_lookup_with_goal_work(nodes, children, terms, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if existing.known
            return proof_kernel_replay_congruence_push_with_goal_work(terms, root, exhausted, work_used) if proof_kernel_replay_congruent_scalar_literal(node)
            if not proof_kernel_replay_congruent_former(node):
                witness_depth: usize = depth + 1
                return false if:
                    not ElisaProofKernelCore::depth_valid(witness_depth) or witness_depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
                    not proof_kernel_replay_goal_bool_ref_value(markers_ready) and not proof_kernel_replay_goal_search_charge(work_used)
                if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                    marker_cache: mutable darray[ProofKernelReplayWitnessMarker] = []
                    cache_complete: bool = proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &marker_cache, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if:
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not cache_complete
                        not proof_kernel_replay_goal_search_charge_amount(work_used, marker_cache.count)
                    markers.clear()
                    markers.extend(marker_cache)
                    markers_ready <- true
                witness_budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - witness_depth
                witnessed: bool = proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, root, witness_depth, witness_budget, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not witnessed
                # Index reads remain opaque atoms. A scalar result witness does not establish
                # that the receiver uses primitive array selection, so equal subscripts cannot
                # justify equal reads through a potentially user-defined selector.
                return proof_kernel_replay_congruence_push_with_goal_work(terms, root, exhausted, work_used)
            operands: mutable darray[usize] = []
            return false if:
                not proof_kernel_replay_congruence_charge_operand_read_with_goal_work(nodes, root, work_used)
                not proof_kernel_replay_congruence_operands(nodes, children, root, &operands)
            for operand in operands |operand, nodes, children, facts, markers, markers_ready, terms, exhausted, work_used, depth|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_congruence_collect_with_goal_work(nodes, children, facts, markers, markers_ready, operand, terms, exhausted, work_used, depth + 1)
            proof_kernel_replay_congruence_push_with_goal_work(terms, root, exhausted, work_used)

        def proof_kernel_replay_congruence_has_seed_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            decreases PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_arena_shape_valid(nodes[root])
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "and":
                return proof_kernel_replay_congruence_has_seed_with_goal_work(nodes, node.left, work_used, depth + 1) or proof_kernel_replay_congruence_has_seed_with_goal_work(nodes, node.right, work_used, depth + 1)
            return true if node.kind == "binary" and node.operator == "=="
            if node.kind == "unary" and node.operator == "not":
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                inner: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                return inner.known and inner.node.kind == "binary" and inner.node.operator == "!="
            return false

        def proof_kernel_replay_congruence_has_seed_in_facts_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, facts: darray[usize], work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                seeded: bool = proof_kernel_replay_congruence_has_seed_with_goal_work(nodes, fact, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if seeded
            return false

        def proof_kernel_replay_congruence_find_with_goal_work(parent: mutable darray[usize]&, start: usize, work_used: mutable usize&) -> usize:
            current: mutable usize = start
            steps: mutable usize = 0
            limit: usize = proof_kernel_replay_congruence_term_limit()
            while steps <= limit |current, steps, parent, limit, work_used|:
                return current if not proof_kernel_replay_goal_search_charge(work_used)
                located: (known: bool, value: usize) = proof_kernel_replay_index_at(parent, current)
                return current if not located.known or located.value == current
                current <- located.value
                steps <- steps + 1
            return current

        def proof_kernel_replay_congruence_union_with_goal_work(parent: mutable darray[usize]&, left: usize, right: usize, work_used: mutable usize&) -> bool:
            left_root: usize = proof_kernel_replay_congruence_find_with_goal_work(parent, left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_root: usize = proof_kernel_replay_congruence_find_with_goal_work(parent, right, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                left_root == right_root or not proof_kernel_replay_goal_search_charge(work_used)
            return proof_kernel_replay_index_set(parent, right_root, left_root) if left_root < right_root
            return proof_kernel_replay_index_set(parent, left_root, right_root)

        def proof_kernel_replay_congruence_class_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, terms: darray[usize]&, parent: mutable darray[usize]&, root: usize, work_used: mutable usize&) -> (known: bool, index: usize):
            located: (known: bool, index: usize) = proof_kernel_replay_congruence_lookup_with_goal_work(nodes, children, terms, root, work_used)
            return (false, 0) if not located.known or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            representative: usize = proof_kernel_replay_congruence_find_with_goal_work(parent, located.index, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, representative)

        def proof_kernel_replay_congruence_seed_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], terms: darray[usize]&, parent: mutable darray[usize]&, root: usize, work_used: mutable usize&, depth: usize, seeded: mutable bool&) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            decreases PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return true if not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH or not proof_kernel_replay_valid(nodes, root)
            return false if:
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_arena_shape_valid(nodes[root])
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "and":
                return false if not proof_kernel_replay_congruence_seed_with_goal_work(nodes, children, markers, terms, parent, node.left, work_used, depth + 1, seeded)
                return proof_kernel_replay_congruence_seed_with_goal_work(nodes, children, markers, terms, parent, node.right, work_used, depth + 1, seeded)
            equality_left: mutable usize = 0
            equality_right: mutable usize = 0
            equality_found: mutable bool = false
            if node.kind == "binary" and node.operator == "==":
                equality_left <- node.left
                equality_right <- node.right
                equality_found <- true
            if node.kind == "unary" and node.operator == "not":
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                inner: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                if inner.known and inner.node.kind == "binary" and inner.node.operator == "!=":
                    return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                    equality_left <- inner.node.left
                    equality_right <- inner.node.right
                    equality_found <- true
            return true if not equality_found
            primitive_relation: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, equality_left, equality_right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if not primitive_relation
            left_index: (known: bool, index: usize) = proof_kernel_replay_congruence_lookup_with_goal_work(nodes, children, terms, equality_left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_index: (known: bool, index: usize) = proof_kernel_replay_congruence_lookup_with_goal_work(nodes, children, terms, equality_right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if not left_index.known or not right_index.known
            merged: bool = proof_kernel_replay_congruence_union_with_goal_work(parent, left_index.index, right_index.index, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            seeded <- true if merged
            return true

        def proof_kernel_replay_congruence_operand_slot_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, terms: darray[usize]&, root: usize, count: usize, offset: usize, work_used: mutable usize&) -> usize:
            if offset < count:
                return terms.count if not proof_kernel_replay_congruence_charge_operand_read_with_goal_work(nodes, root, work_used)
                operand: (known: bool, value: usize) = proof_kernel_replay_congruence_operand_at(nodes, root, offset)
                return terms.count if not operand.known
                located: (known: bool, index: usize) = proof_kernel_replay_congruence_lookup_with_goal_work(nodes, children, terms, operand.value, work_used)
                return terms.count if not located.known or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return located.index
            terms.count

        def proof_kernel_replay_congruence_operand_index_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, terms: darray[usize]&, work_used: mutable usize&) -> ProofKernelReplayCongruenceOperands:
            slots: mutable darray[usize] = []
            counts: mutable darray[usize] = []
            unknown: usize = terms.count
            for index in 0..<terms.count |index, nodes, children, terms, slots, counts, unknown, work_used|:
                return ProofKernelReplayCongruenceOperands{slots: slots, counts: counts, unknown: unknown} if not proof_kernel_replay_goal_search_charge(work_used)
                term: (known: bool, value: usize) = proof_kernel_replay_index_at(terms, index)
                root: usize = term.value if term.known else nodes.count
                count: mutable usize = 0
                if term.known:
                    return ProofKernelReplayCongruenceOperands{slots: slots, counts: counts, unknown: unknown} if not proof_kernel_replay_congruence_charge_operand_read_with_goal_work(nodes, root, work_used)
                    count <- proof_kernel_replay_congruence_operand_count(nodes, root)
                counts.push(count)
                for offset in 0..<3 |offset, nodes, children, terms, slots, root, count, work_used|:
                    return ProofKernelReplayCongruenceOperands{slots: slots, counts: counts, unknown: unknown} if not proof_kernel_replay_goal_search_charge(work_used)
                    slot: usize = proof_kernel_replay_congruence_operand_slot_with_goal_work(nodes, children, terms, root, count, offset, work_used)
                    return ProofKernelReplayCongruenceOperands{slots: slots, counts: counts, unknown: unknown} if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    slots.push(slot)
            ProofKernelReplayCongruenceOperands{slots: slots, counts: counts, unknown: unknown}

        def proof_kernel_replay_congruence_slot_class_with_goal_work(operands: ProofKernelReplayCongruenceOperands&, parent: mutable darray[usize]&, term_index: usize, offset: usize, work_used: mutable usize&) -> (known: bool, index: usize):
            slot: usize = proof_kernel_replay_congruence_slot(operands, term_index, offset)
            return (false, 0) if slot >= operands.unknown or not proof_kernel_replay_goal_search_charge(work_used)
            representative: usize = proof_kernel_replay_congruence_find_with_goal_work(parent, slot, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, representative)

        def proof_kernel_replay_congruence_operands_match_with_goal_work(operands: ProofKernelReplayCongruenceOperands&, parent: mutable darray[usize]&, left_index: usize, right_index: usize, work_used: mutable usize&) -> bool:
            return false if left_index >= operands.counts.count or right_index >= operands.counts.count
            operand_count: usize = operands.counts[left_index]
            return false if operand_count == 0 or operand_count != operands.counts[right_index]
            for offset in 0..<operand_count |offset, operands, parent, left_index, right_index, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                left_class: (known: bool, index: usize) = proof_kernel_replay_congruence_slot_class_with_goal_work(operands, parent, left_index, offset, work_used)
                return false if not left_class.known
                right_class: (known: bool, index: usize) = proof_kernel_replay_congruence_slot_class_with_goal_work(operands, parent, right_index, offset, work_used)
                return false if not right_class.known or left_class.index != right_class.index
            return true

        def proof_kernel_replay_congruence_pair_indexed_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, operands: ProofKernelReplayCongruenceOperands&, parent: mutable darray[usize]&, left_index: usize, right_index: usize, left_root: usize, right_root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge_node_text(nodes, left_root, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, right_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, left_root)
            right_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, right_root)
            return false if not left_located.known or not right_located.known
            left: ElisaProofKernelCore::ProofKernelNode = left_located.node
            right: ElisaProofKernelCore::ProofKernelNode = right_located.node
            return false if:
                not proof_kernel_replay_congruent_former(left) or left.kind != right.kind or left.operator != right.operator
                left.name != right.name or left.secondary_name != right.secondary_name or left.value != right.value
            proof_kernel_replay_congruence_operands_match_with_goal_work(operands, parent, left_index, right_index, work_used)

        def proof_kernel_replay_congruence_round_indexed_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, terms: darray[usize]&, parent: mutable darray[usize]&, operands: ProofKernelReplayCongruenceOperands&, work_used: mutable usize&) -> (changed: bool, complete: bool):
            changed: mutable bool = false
            for left_index in 0..<terms.count |left_index, terms, nodes, children, parent, changed, operands, work_used|:
                for right_index in 0..<terms.count |right_index, left_index, terms, nodes, children, parent, changed, operands, work_used|:
                    return (changed, false) if not proof_kernel_replay_goal_search_charge(work_used)
                    continue if right_index <= left_index
                    left_rep: usize = proof_kernel_replay_congruence_find_with_goal_work(parent, left_index, work_used)
                    return (changed, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    right_rep: usize = proof_kernel_replay_congruence_find_with_goal_work(parent, right_index, work_used)
                    return (changed, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if left_rep == right_rep
                    left_term: (known: bool, value: usize) = proof_kernel_replay_index_at(terms, left_index)
                    right_term: (known: bool, value: usize) = proof_kernel_replay_index_at(terms, right_index)
                    continue if not left_term.known or not right_term.known
                    same: bool = proof_kernel_replay_congruence_pair_indexed_with_goal_work(nodes, children, operands, parent, left_index, right_index, left_term.value, right_term.value, work_used)
                    return (changed, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same
                    merged: bool = proof_kernel_replay_congruence_union_with_goal_work(parent, left_index, right_index, work_used)
                    return (changed, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    changed <- true if merged
            return (changed, true)

        def proof_kernel_replay_congruence_saturate_indexed_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, terms: darray[usize]&, parent: mutable darray[usize]&, exhausted: mutable bool&, work_used: mutable usize&) -> bool:
            operands: ProofKernelReplayCongruenceOperands = proof_kernel_replay_congruence_operand_index_with_goal_work(nodes, children, terms, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            round: mutable usize = 0
            changed: mutable bool = true
            while round < proof_kernel_replay_congruence_round_limit() and changed |round, changed, nodes, children, terms, parent, operands, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                result: (changed: bool, complete: bool) = proof_kernel_replay_congruence_round_indexed_with_goal_work(nodes, children, terms, parent, operands, work_used)
                return false if not result.complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                changed <- result.changed
                round <- round + 1
            exhausted <- true if changed
            return true
