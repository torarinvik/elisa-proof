extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_maximum_equality(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            goal = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "==" or not proof_kernel_replay_arena_shape_valid(goal)
            return false if not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            base: usize = goal.left if nodes[goal.left].kind == "ident" else goal.right
            cap: usize = goal.right if nodes[goal.left].kind == "ident" else goal.left
            return false if nodes[base].kind != "ident" or not proof_kernel_replay_arena_shape_valid(nodes[base])
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, goal.left, goal.right)
            width: i64 = proof_kernel_replay_peer_unsigned_width(nodes, children, base, facts)
            return false if width != 8 and width != 16 and width != 32 and width != 64
            literal = ElisaProofKernelCore::typed_literal_value(nodes[cap])
            maximum: u64 = 255 if width == 8 else 65535 if width == 16 else 4294967295 if width == 32 else 18446744073709551615u64
            return false if not literal.known or not literal.unsigned or literal.width != width or literal.bits != maximum
            for fact in facts |fact, nodes, children, facts, base, cap|:
                order = proof_kernel_replay_readable_order(nodes, children, facts, fact)
                continue if not order.known
                return true if order.operator == ">=" and proof_kernel_replay_expr_equal(nodes, children, order.left, base, 0) and proof_kernel_replay_expr_equal(nodes, children, order.right, cap, 0)
                return true if order.operator == "<=" and proof_kernel_replay_expr_equal(nodes, children, order.right, base, 0) and proof_kernel_replay_expr_equal(nodes, children, order.left, cap, 0)
            return false
