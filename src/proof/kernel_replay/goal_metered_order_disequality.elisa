extend ElisaProofKernelReplay:
    private:
        # Metered mirror of the primitive strict-order premise rule. Candidate facts,
        # structural comparisons, and scalar witnesses all consume the caller's goal budget.
        def proof_kernel_replay_strict_order_fact_implies_disequality_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            return false if not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            disequality_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "!=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_goal or not disequality_goal
            return false if goal.left >= nodes.count or goal.right >= nodes.count
            return false if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, goal.left, goal.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact_root in facts |fact_root, nodes, children, facts, goal, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                binary_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.kind, "binary", work_used)
                less_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, "<", work_used)
                greater_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, ">", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not binary_fact or (not less_fact and not greater_fact)
                continue if fact.left >= nodes.count or fact.right >= nodes.count
                forward_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.left, fact.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                forward_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.right, fact.right, work_used) if forward_left
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                reverse_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.left, fact.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                reverse_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.right, fact.left, work_used) if reverse_left
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if (forward_left and forward_right) or (reverse_left and reverse_right):
                    primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if primitive
            return false
