extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_scalar_alias_occurs(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, name: sview, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            return node.name == name if node.kind == "ident"
            return proof_kernel_replay_scalar_alias_occurs(nodes, node.left, name, depth + 1) if node.kind == "paren" or node.kind == "unary"
            if node.kind == "binary":
                return proof_kernel_replay_scalar_alias_occurs(nodes, node.left, name, depth + 1) or proof_kernel_replay_scalar_alias_occurs(nodes, node.right, name, depth + 1)
            if node.kind == "if":
                return proof_kernel_replay_scalar_alias_occurs(nodes, node.left, name, depth + 1) or proof_kernel_replay_scalar_alias_occurs(nodes, node.right, name, depth + 1) or proof_kernel_replay_scalar_alias_occurs(nodes, node.auxiliary, name, depth + 1)
            return false
        def proof_kernel_replay_conditional_alias_plan(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> (known: bool, index: usize, condition: usize, then_fact: usize, else_fact: usize, then_refuted: bool, else_refuted: bool):
            unknown: (known: bool, index: usize, condition: usize, then_fact: usize, else_fact: usize, then_refuted: bool, else_refuted: bool) = (false, 0, 0, 0, 0, false, false)
            return unknown if not proof_kernel_replay_valid(nodes, goal_root)
            goal = nodes[goal_root]
            return unknown if goal.kind != "binary" or not proof_kernel_replay_arena_shape_valid(goal) or not proof_kernel_replay_negation_supported(goal.operator)
            return unknown if not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            for index in 0..<facts.count |index, facts, nodes, children, goal|:
                root: usize = facts[index]
                continue if not proof_kernel_replay_valid(nodes, root)
                fact = nodes[root]
                continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                continue if not proof_kernel_replay_valid(nodes, fact.left) or not proof_kernel_replay_valid(nodes, fact.right)
                alias: usize = fact.left if nodes[fact.left].kind == "ident" else fact.right
                conditional_root: usize = fact.right if nodes[fact.left].kind == "ident" else fact.left
                continue if nodes[alias].kind != "ident" or not proof_kernel_replay_arena_shape_valid(nodes[alias])
                continue if not proof_kernel_replay_scalar_alias_occurs(nodes, goal_root, nodes[alias].name, 0)
                continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, alias, conditional_root)
                continue if not proof_kernel_replay_unsigned_conditional_difference_safe(nodes, children, facts, conditional_root)
                conditional = nodes[conditional_root]
                width: i64 = proof_kernel_replay_peer_unsigned_width(nodes, children, alias, facts)
                continue if width != proof_kernel_replay_unsigned_width_in_expression(nodes, children, conditional.right, facts, 0)
                condition = nodes[conditional.left]
                then_refuted: mutable bool = false
                else_refuted: mutable bool = false
                for fact_root in facts |fact_root, nodes, children, facts, condition, then_refuted, else_refuted|:
                    order = proof_kernel_replay_readable_order(nodes, children, facts, fact_root)
                    continue if not order.known or not proof_kernel_replay_expr_equal(nodes, children, order.left, condition.left, 0) or not proof_kernel_replay_expr_equal(nodes, children, order.right, condition.right, 0)
                    complement: sview = "<=" if condition.operator == ">" else "<" if condition.operator == ">=" else ">=" if condition.operator == "<" else ">"
                    then_refuted <- true if order.operator == complement
                    else_refuted <- true if order.operator == condition.operator
                then_fact: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", alias, conditional.right, 0, 0, 0, 0, "", "")
                else_fact: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", alias, conditional.auxiliary, 0, 0, 0, 0, "", "")
                return (true, index, conditional.left, then_fact, else_fact, then_refuted, else_refuted)
            return unknown
