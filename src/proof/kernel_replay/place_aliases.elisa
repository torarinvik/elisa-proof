extend ElisaProofKernelReplay:
    private:
        # Mirror of `proof_place_alias_goal`: a fact `name == place[index]` between witnessed
        # primitive scalars rewrites the element to its alias in the goal and every fact.
        # `proof_kernel_replay_replace_exact` does not enter quantifier bodies, so no binder
        # can capture the alias. A rewrite must change the goal, or the goal must name the alias and a fact change;
        # it spends a split level.
        def proof_kernel_replay_place_alias_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            for fact in facts |fact, facts, nodes, children, goal_root, split_depth, depth, remaining|:
                if proof_kernel_replay_place_alias_shape(nodes, children, facts, fact):
                    alias: usize = nodes[fact].left
                    place: usize = nodes[fact].right
                    rewritten_goal: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, goal_root, place, alias, 0)
                    goal_names_alias: bool = proof_kernel_replay_replace_exact(nodes, children, goal_root, alias, alias, 0).changed
                    rewritten_facts: mutable darray[usize] = []
                    facts_changed: mutable bool = false
                    for other in facts |other, fact, nodes, children, place, alias, rewritten_facts, facts_changed|:
                        replaced: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, other, place, alias, 0)
                        facts_changed <- true if replaced.changed and other != fact
                        rewritten_facts.push(replaced.value)
                    if rewritten_goal.changed or (goal_names_alias and facts_changed):
                        return true if proof_kernel_replay_goal_depth_remaining(nodes, children, rewritten_facts, rewritten_goal.value, split_depth + 1, depth + 1, remaining: remaining - 1)
            return false

        def proof_kernel_replay_place_alias_shape(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], fact: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, fact)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
            return false if node.kind != "binary" or node.operator != "=="
            return false if not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
            return false if nodes[node.left].kind != "ident" or nodes[node.left].name == "" or nodes[node.right].kind != "index"
            proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right)
