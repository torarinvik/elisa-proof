extend ElisaProofKernelReplay:
    private:
        # Keep constant replay's operator dispatch explicit: unknown values, unsupported
        # operators, and rejected arithmetic all use the same zero sentinel.
        def proof_kernel_replay_constant_unary(operator: sview, inner: ProofKernelReplayInt) -> ProofKernelReplayInt:
            ensure not result.known implies result.value == 0
            ensure result.known == (inner.known and (operator == "+" or (operator == "-" and inner.value != proof_kernel_replay_i64_min())))
            ensure result.known and operator == "+" implies result.value == inner.value
            ensure result.known and operator == "-" implies result.value == 0 - inner.value
            return ProofKernelReplayInt{known: false, value: 0} if not inner.known
            return inner if operator == "+"
            if operator == "-":
                return ProofKernelReplayInt{known: false, value: 0} if inner.value == proof_kernel_replay_i64_min()
                return ProofKernelReplayInt{known: true, value: 0 - inner.value}
            return ProofKernelReplayInt{known: false, value: 0}

        def proof_kernel_replay_constant_binary(operator: sview, left: ProofKernelReplayInt, right: ProofKernelReplayInt) -> ProofKernelReplayInt:
            ensure not result.known implies result.value == 0
            ensure result.known == (
                left.known and right.known and (
                    (operator == "+" and proof_kernel_replay_add_safe(left.value, right.value).known)
                    or (operator == "-" and proof_kernel_replay_sub_safe(left.value, right.value).known)
                    or (operator == "*" and proof_kernel_replay_mul_safe(left.value, right.value).known)
                    or (operator == "/" and proof_kernel_replay_div_safe(left.value, right.value).known)
                    or (operator == "%" and proof_kernel_replay_mod_safe(left.value, right.value).known)
                    or operator == "&" or operator == "|" or operator == "^"
                    or (operator == "<<" and proof_kernel_replay_shift_safe(left.value, right.value, true).known)
                    or (operator == ">>" and proof_kernel_replay_shift_safe(left.value, right.value, false).known)
                )
            )
            ensure result.known implies left.known and right.known
            ensure result.known implies (operator == "+" or operator == "-" or operator == "*" or operator == "/" or operator == "%" or operator == "&" or operator == "|" or operator == "^" or operator == "<<" or operator == ">>")
            ensure left.known and right.known and operator == "+" implies result.known == proof_kernel_replay_add_safe(left.value, right.value).known
            ensure left.known and right.known and operator == "+" implies result.value == proof_kernel_replay_add_safe(left.value, right.value).value
            ensure left.known and right.known and operator == "-" implies result.known == proof_kernel_replay_sub_safe(left.value, right.value).known
            ensure left.known and right.known and operator == "-" implies result.value == proof_kernel_replay_sub_safe(left.value, right.value).value
            ensure left.known and right.known and operator == "*" implies result.known == proof_kernel_replay_mul_safe(left.value, right.value).known
            ensure left.known and right.known and operator == "*" implies result.value == proof_kernel_replay_mul_safe(left.value, right.value).value
            ensure left.known and right.known and operator == "/" implies result.known == proof_kernel_replay_div_safe(left.value, right.value).known
            ensure left.known and right.known and operator == "/" implies result.value == proof_kernel_replay_div_safe(left.value, right.value).value
            ensure left.known and right.known and operator == "%" implies result.known == proof_kernel_replay_mod_safe(left.value, right.value).known
            ensure left.known and right.known and operator == "%" implies result.value == proof_kernel_replay_mod_safe(left.value, right.value).value
            ensure left.known and right.known and operator == "&" implies result.known and result.value == (left.value & right.value)
            ensure left.known and right.known and operator == "|" implies result.known and result.value == (left.value | right.value)
            ensure left.known and right.known and operator == "^" implies result.known and result.value == (left.value ^ right.value)
            ensure left.known and right.known and operator == "<<" implies result.known == proof_kernel_replay_shift_safe(left.value, right.value, true).known
            ensure left.known and right.known and operator == "<<" implies result.value == proof_kernel_replay_shift_safe(left.value, right.value, true).value
            ensure left.known and right.known and operator == ">>" implies result.known == proof_kernel_replay_shift_safe(left.value, right.value, false).known
            ensure left.known and right.known and operator == ">>" implies result.value == proof_kernel_replay_shift_safe(left.value, right.value, false).value
            return ProofKernelReplayInt{known: false, value: 0} if not left.known or not right.known
            return proof_kernel_replay_add_safe(left.value, right.value) if operator == "+"
            return proof_kernel_replay_sub_safe(left.value, right.value) if operator == "-"
            return proof_kernel_replay_mul_safe(left.value, right.value) if operator == "*"
            return proof_kernel_replay_div_safe(left.value, right.value) if operator == "/"
            return proof_kernel_replay_mod_safe(left.value, right.value) if operator == "%"
            return ProofKernelReplayInt{known: true, value: left.value & right.value} if operator == "&"
            return ProofKernelReplayInt{known: true, value: left.value | right.value} if operator == "|"
            return ProofKernelReplayInt{known: true, value: left.value ^ right.value} if operator == "^"
            return proof_kernel_replay_shift_safe(left.value, right.value, true) if operator == "<<"
            return proof_kernel_replay_shift_safe(left.value, right.value, false) if operator == ">>"
            return ProofKernelReplayInt{known: false, value: 0}
