extend ElisaProofKernelReplay:
    private:
        # The source-neutral arena is intentionally untyped, but its logical entry points still
        # need a proposition boundary. Without this check, an ill-typed direct caller could use
        # exact fact containment to "prove" a scalar term such as `7` from the identical scalar
        # fact. Source type checking normally prevents that shape; the independent kernel must
        # not rely on that frontend invariant when it is called on serialized data.
        # Identifiers, calls, and projections are opaque propositional atoms in this untyped,
        # source-neutral calculus; exact containment proves one only from the same supplied
        # assumption. This does not establish Boolean source sort. Adapters binding replay to
        # Elisa obligations must use typed replay or an admitted, source-checked view.
        # A serialized arena is a DAG, so recursive edge traversal can revisit one shared
        # proposition exponentially many times. Charge every visit to the caller's meter.
        def proof_kernel_replay_proposition_shape_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            # Enum shorthand is a value atom, not a proposition. It may occur as an operand of
            # a witnessed comparison, but a bare shorthand goal must not be proved by exact
            # containment merely because its fact has the same serialized spelling.
            return true if node.kind in {"bool", "ident", "call", "field", "scope", "index", "index-n", "slice", "checked-index", "checked-get"}
            if node.kind == "unary" and node.operator == "not":
                return proof_kernel_replay_proposition_shape_with_goal_work(nodes, node.left, depth + 1, work_used)
            if node.kind == "binary":
                if node.operator in {"and", "or", "=>"}:
                    return proof_kernel_replay_proposition_shape_with_goal_work(nodes, node.left, depth + 1, work_used) and proof_kernel_replay_proposition_shape_with_goal_work(nodes, node.right, depth + 1, work_used)
                return true if node.operator in {"==", "!=", "<", ">", "<=", ">=", "in", "is"}
            if node.kind == "if":
                return proof_kernel_replay_proposition_shape_with_goal_work(nodes, node.left, depth + 1, work_used) and proof_kernel_replay_proposition_shape_with_goal_work(nodes, node.right, depth + 1, work_used) and proof_kernel_replay_proposition_shape_with_goal_work(nodes, node.auxiliary, depth + 1, work_used)
            if node.kind == "quantifier":
                # A quantifier's block shape is not enough to determine its proposition. The
                # parser erases forall/exists, so logical replay requires the producer to bind
                # that semantic kind into the node before the term can enter a fact or goal.
                return false if node.operator != "forall" and node.operator != "exists"
                return proof_kernel_replay_proposition_shape_with_goal_work(nodes, node.right, depth + 1, work_used)
            return false

        # Callers pass their existing counter so proposition checks and later replay share one
        # bound across the full operation.
        def proof_kernel_replay_proposition_state_valid_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_proposition_shape_with_goal_work(nodes, goal_root, 0, work_used)
            for fact in facts:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_proposition_shape_with_goal_work(nodes, fact, 0, work_used)
            proof_kernel_replay_state_literals_fit_with_goal_work(nodes, children, facts, goal_root, work_used)

        def proof_kernel_replay_tactic_step_impl[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview, arena_prevalidated: bool) -> bool can[Global.Read, Global.Write]:
            trace_work: mutable usize = 0
            proof_kernel_replay_tactic_step_impl_with_trace_work(nodes, children, action, accepted, before_solved, after_solved, before_facts, before_goal, after_facts, after_goal, argument, has_argument, secondary, has_secondary, argument_index, has_argument_index, detail, arena_prevalidated, &trace_work)

        # The trace caller shares this counter across every transition. Each transition still
        # starts with its own tighter goal-search allowance, then debits the observed work to the
        # trace ceiling so a long trace cannot multiply that allowance without bound.
        def proof_kernel_replay_tactic_step_impl_with_trace_work[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview, arena_prevalidated: bool, trace_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            return false if trace_work > PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
            step_work: mutable usize = 0
            step_work_seed: mutable usize = 0
            valid: bool = (proof_kernel_replay_tactic_step_body(nodes, children, action, accepted, before_solved, after_solved, before_facts, before_goal, after_facts, after_goal, argument, has_argument, secondary, has_secondary, argument_index, has_argument_index, detail, arena_prevalidated, &step_work, &step_work_seed, trace_work) can Global{Read,Write})
            step_work_used: usize = step_work - step_work_seed if step_work >= step_work_seed else PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
            within_trace_budget: bool = proof_kernel_replay_tactic_trace_charge(trace_work, step_work_used)
            if not valid or not within_trace_budget:
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
            valid and within_trace_budget

        def proof_kernel_replay_tactic_step_body[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview, arena_prevalidated: bool, step_work: mutable usize&, step_work_seed: mutable usize&, trace_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            # Only the typed API sets this flag, after admitting both states and each present
            # auxiliary root. Reuse that admission instead of rescanning the serialized DAG.
            if not arena_prevalidated:
                arena_workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
                return false if:
                    not proof_kernel_replay_arena_valid_with_trace_workspace(nodes, children, before_facts, before_goal, &arena_workspace, trace_work)
                    not proof_kernel_replay_arena_valid_with_trace_workspace(nodes, children, after_facts, after_goal, &arena_workspace, trace_work)
                    has_argument and not proof_kernel_replay_arena_valid_with_trace_workspace(nodes, children, [], argument, &arena_workspace, trace_work)
                    has_secondary and not proof_kernel_replay_arena_valid_with_trace_workspace(nodes, children, [], secondary, &arena_workspace, trace_work)
            return false if trace_work > PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
            trace_remaining: usize = PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT - trace_work
            step_budget: usize = trace_remaining if trace_remaining < PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT else PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            step_work_seed <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - step_budget
            step_work <- step_work_seed
            return false if:
                not proof_kernel_replay_goal_search_charge_product(step_work, sview_len(action), 64)
                not proof_kernel_replay_goal_search_charge_product(step_work, sview_len(detail), 4)
                not proof_kernel_replay_proposition_state_valid_with_goal_work(nodes, children, before_facts, before_goal, step_work)
                not proof_kernel_replay_proposition_state_valid_with_goal_work(nodes, children, after_facts, after_goal, step_work)
            # Auxiliary tactic terms are independent roots: they are not necessarily reachable
            # from either state snapshot. Admit them through the same canonical arena validator,
            # rather than checking only the numeric index and letting malformed scalar payloads
            # participate in instantiate/rewrite/have replay.
            return false if:
                not has_argument_index and argument_index != 0
                action != "assumption" and action != "exact" and action != "decide" and action != "intro" and action != "apply" and action != "simp" and action != "have" and action != "instantiate" and action != "rewrite" and action != "split" and action != "left" and action != "right" and action != "cases"
                accepted and before_solved
            if action in {"assumption", "exact", "decide", "intro", "simp", "split", "left", "right", "cases"}:
                return false if has_argument or has_secondary or has_argument_index or detail != ""
            if action == "apply":
                return false if has_argument or has_secondary or detail != ""
            if action == "have":
                return false if not has_argument or has_secondary or has_argument_index or detail != ""
            if action == "instantiate":
                return false if not has_argument or has_secondary or not has_argument_index or detail != "forall"
            if action == "rewrite":
                return false if not has_argument or not has_secondary or detail != ""
            return before_solved == after_solved and proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal, step_work) if not accepted
            if action == "assumption":
                return false if:
                    not after_solved
                    not proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal, step_work)
                for fact in before_facts |fact, nodes, children, before_goal, step_work|:
                    return false if step_work >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    step_work <- step_work + 1
                    return true if proof_kernel_replay_fact_contains_with_work(nodes, children, fact, before_goal, &step_work, 0)
                return false
            if action in {"exact", "decide"}:
                return false if:
                    not after_solved
                    not proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal, step_work)
                saved_nodes: usize = nodes.count
                saved_children: usize = children.count
                closes: bool = (proof_kernel_replay_tactic_goal_depth_with_work(nodes, children, before_facts, before_goal, step_work) can Global{Read,Write})
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
                return closes
            if action == "intro":
                return false if after_solved
                shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, before_goal, "=>")
                return false if not shape.known or not proof_kernel_replay_tactic_appended(nodes, children, before_facts, after_facts, shape.node.left, step_work)
                return proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, after_goal, shape.node.right, step_work)
            if action == "apply":
                return false if:
                    after_solved
                    not proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts, step_work)
                if has_argument_index:
                    return false if argument_index >= before_facts.count
                    selected_fact: usize = before_facts[argument_index]
                    shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, selected_fact, "=>")
                    return shape.known and proof_kernel_replay_tactic_effect_free_with_work(nodes, children, selected_fact, before_facts, 0, step_work, false) and proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.right, before_goal, step_work) and proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.left, after_goal, step_work)
                for fact in before_facts |fact, nodes, children, before_goal, after_goal, step_work|:
                    return false if step_work >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    step_work <- step_work + 1
                    shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, fact, "=>")
                    return true if shape.known and proof_kernel_replay_tactic_effect_free_with_work(nodes, children, fact, before_facts, 0, step_work, false) and proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.right, before_goal, step_work) and proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.left, after_goal, step_work)
                return false
            if action == "have":
                return false if:
                    after_solved
                    not has_argument or not proof_kernel_replay_tactic_appended(nodes, children, before_facts, after_facts, argument, step_work)
                    not proof_kernel_replay_proposition_shape_with_goal_work(nodes, argument, 0, step_work)
                # `have` adds a proved fact but does not change the target. Comparing the
                # pre-state with itself would let a forged trace replace an arbitrary goal with
                # a convenient one and then close that replacement.
                return false if:
                    not proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, before_goal, after_goal, step_work)
                    not proof_kernel_replay_tactic_effect_free_with_work(nodes, children, argument, before_facts, 0, step_work, false)
                saved_nodes: usize = nodes.count
                saved_children: usize = children.count
                proves: bool = (proof_kernel_replay_tactic_goal_depth_with_work(nodes, children, before_facts, argument, step_work) can Global{Read,Write})
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
                return proves
            if action == "instantiate":
                return false if:
                    after_solved or not has_argument or not has_argument_index or detail != "forall"
                    argument_index >= before_facts.count
                    not proof_kernel_replay_tactic_effect_free_with_work(nodes, children, argument, before_facts, 0, step_work, false)
                    not proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, before_goal, after_goal, step_work)
                    after_facts.count != before_facts.count + 1
                for index in 0..<before_facts.count |index, before_facts, after_facts, nodes, children, step_work|:
                    return false if not proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, before_facts[index], after_facts[index], step_work)
                selected_fact: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, before_facts[argument_index])
                return false if not selected_fact.known or selected_fact.node.kind != "quantifier"
                quantifier: ElisaProofKernelCore::ProofKernelNode = selected_fact.node
                # The trace detail is an action claim, not evidence about the proposition. The
                # encoded node must independently carry the universal kind before instantiation
                # can add an instance to the context.
                return false if:
                    quantifier.operator != "forall"
                    not proof_kernel_replay_tactic_effect_free_with_work(nodes, children, before_facts[argument_index], before_facts, 0, step_work, false)
                member: mutable bool = false
                range_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, quantifier.left)
                return false if not range_located.known
                range_node: ElisaProofKernelCore::ProofKernelNode = range_located.node
                if range_node.kind == "binary" and (range_node.operator in {"range_lt", "range_le"}):
                    selected: ProofKernelReplayInt = proof_kernel_replay_quantifier_constant_int_with_work(nodes, argument, step_work)
                    lower_constant: ProofKernelReplayInt = proof_kernel_replay_quantifier_constant_int_with_work(nodes, range_node.left, step_work)
                    upper_constant: ProofKernelReplayInt = proof_kernel_replay_quantifier_constant_int_with_work(nodes, range_node.right, step_work)
                    return false if step_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    bounds: mutable darray[ProofKernelReplayBound] = []
                    if not lower_constant.known or not upper_constant.known:
                        for fact in before_facts |fact, nodes, children, before_facts, bounds, step_work|:
                            proof_kernel_replay_collect_bounds_with_work(nodes, children, before_facts, fact, &bounds, step_work, 0)
                            return false if step_work >= PROOF_KERNEL_REPLAY_COLLECT_BOUNDS_WORK_LIMIT
                        return false if not proof_kernel_replay_close_equalities_with_work(nodes, children, before_facts, &bounds, step_work, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        for fact in before_facts |fact, nodes, children, before_facts, bounds, step_work|:
                            return false if:
                                not proof_kernel_replay_unsigned_expression_safe_with_goal_work(nodes, children, fact, before_facts, &bounds, step_work, 0) or not proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, fact, before_facts, &bounds, step_work, 0)
                                step_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    lower: ProofKernelReplayInt = proof_kernel_replay_quantifier_exact_int_from_bounds(nodes, range_node.left, lower_constant, bounds, step_work)
                    upper: ProofKernelReplayInt = proof_kernel_replay_quantifier_exact_int_from_bounds(nodes, range_node.right, upper_constant, bounds, step_work)
                    return false if step_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    member <- selected.known and lower.known and upper.known and selected.value >= lower.value and (selected.value < upper.value if range_node.operator == "range_lt" else selected.value <= upper.value)
                if range_node.kind in {"array", "tuple", "set"}:
                    return false if:
                        range_node.children_start > children.count or range_node.children_count > children.count - range_node.children_start
                        not proof_kernel_replay_child_range_valid(range_node.children_start, range_node.children_count, children.count)
                    for index in 0..<range_node.children_count |index, range_node, children, nodes, argument, member, step_work|:
                        return false if step_work >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        step_work <- step_work + 1
                        member <- true if proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, children[range_node.children_start + index], argument, step_work)
                return false if not member
                saved_nodes: usize = nodes.count
                saved_children: usize = children.count
                instance: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, quantifier.right, quantifier.name, argument, 0, step_work, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                if step_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or instance >= nodes.count:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false
                matches_instance: bool = proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, instance, after_facts[after_facts.count - 1], step_work)
                if not matches_instance:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
                return true
            if action == "rewrite":
                return false if:
                    after_solved or not has_argument or not has_secondary
                return false if:
                    not proof_kernel_replay_tactic_effect_free_with_work(nodes, children, before_goal, before_facts, 0, step_work, false)
                    not proof_kernel_replay_tactic_effect_free_with_work(nodes, children, argument, before_facts, 0, step_work, true) or not proof_kernel_replay_tactic_effect_free_with_work(nodes, children, secondary, before_facts, 0, step_work, true)
                    not proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts, step_work)
                if not arena_prevalidated:
                    # Source-neutral replay has no type context. Restrict it to integer terms
                    # with identical signedness and width so substitution cannot change overload
                    # resolution. Typed replay has already checked exact sort equality at entry.
                    argument_integer_type: i64 = proof_kernel_replay_strict_signed_width_with_goal_work(nodes, children, before_facts, argument, 0, step_work)
                    secondary_integer_type: i64 = proof_kernel_replay_strict_signed_width_with_goal_work(nodes, children, before_facts, secondary, 0, step_work)
                    return false if:
                        not proof_kernel_replay_denial_integer_term_with_work(nodes, children, argument, before_facts, step_work, 0)
                        not proof_kernel_replay_denial_integer_term_with_work(nodes, children, secondary, before_facts, step_work, 0)
                        step_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or argument_integer_type == 0 or argument_integer_type != secondary_integer_type
                equality_found: mutable bool = false
                if has_argument_index:
                    return false if argument_index >= before_facts.count
                    selected_fact: usize = before_facts[argument_index]
                    shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, selected_fact, "==")
                    equality_found <- shape.known and proof_kernel_replay_tactic_effect_free_with_work(nodes, children, selected_fact, before_facts, 0, step_work, true) and ((proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.left, argument, step_work) and proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.right, secondary, step_work)) or (proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.left, secondary, step_work) and proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.right, argument, step_work)))
                else:
                    for fact in before_facts |fact, nodes, children, argument, secondary, equality_found, step_work|:
                        return false if step_work >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        step_work <- step_work + 1
                        shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, fact, "==")
                        if shape.known:
                            equality_found <- true if proof_kernel_replay_tactic_effect_free_with_work(nodes, children, fact, before_facts, 0, step_work, true) and ((proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.left, argument, step_work) and proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.right, secondary, step_work)) or (proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.left, secondary, step_work) and proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, shape.node.right, argument, step_work)))
                return false if not equality_found
                saved_nodes: usize = nodes.count
                saved_children: usize = children.count
                replace_exhausted: mutable bool = false
                rewritten: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_with_work(nodes, children, before_goal, argument, secondary, step_work, &replace_exhausted, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT, 0)
                if replace_exhausted or step_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false
                return false if not rewritten.changed
                matches_rewrite: bool = proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, rewritten.value, after_goal, step_work)
                if not matches_rewrite:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
                return true
            if action in {"left", "right"}:
                return false if after_solved
                shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, before_goal, "or")
                return false if not shape.known or not proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts, step_work)
                return proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, after_goal, shape.node.left if action == "left" else shape.node.right, step_work)
            if action == "split":
                return false if after_solved
                shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, before_goal, "and")
                return shape.known and proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal, step_work)
            if action == "cases":
                return false if:
                    after_solved
                    not proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal, step_work)
                for fact in before_facts |fact, nodes, step_work|:
                    return false if step_work >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    step_work <- step_work + 1
                    shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, fact, "or")
                    return true if shape.known
                return false
            if action == "simp":
                return false if not proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts, step_work)
                saved_nodes: usize = nodes.count
                saved_children: usize = children.count
                simplified: ProofKernelReplaySimplified = proof_kernel_replay_simplify_with_work(nodes, children, before_goal, 0, step_work)
                if not simplified.known or not simplified.changed:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false
                matches_simplification: bool = proof_kernel_replay_tactic_expr_equal_with_work(nodes, children, simplified.root, after_goal, step_work)
                if not matches_simplification:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false
                if after_solved:
                    closes: bool = (proof_kernel_replay_tactic_goal_depth_with_work(nodes, children, after_facts, after_goal, step_work) can Global{Read,Write})
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return closes
                # The validated after-state already owns its equivalent goal root. Simplifier
                # output is only scratch for the structural comparison and is never returned.
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
                return true
            return false
