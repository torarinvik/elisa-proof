extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_comparison_from_equality_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left_root: usize, operator: sview, right_root: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_comparison_from_equality_literal_with_work(nodes, children, facts, left_root, operator, right_root, &work_used)

        def proof_kernel_replay_comparison_from_equality_literal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left_root: usize, operator: sview, right_root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(operator))
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_negation_supported(operator)
            left_constant: ProofKernelReplayInt = proof_kernel_replay_small_constant_with_goal_work(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_constant: ProofKernelReplayInt = proof_kernel_replay_small_constant_with_goal_work(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, operator, right_root, work_used) if left_constant.known and right_constant.known
            return false if left_constant.known == right_constant.known
            term_root: usize = right_root if left_constant.known else left_root
            goal_constant: i64 = left_constant.value if left_constant.known else right_constant.value
            term_is_left: bool = not left_constant.known
            for fact_root in facts |fact_root, nodes, children, facts, term_root, operator, goal_constant, term_is_left, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                binary_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.kind, "binary", work_used)
                equality_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, "==", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not binary_fact or not equality_fact
                right_literal: ProofKernelReplayInt = proof_kernel_replay_small_constant_with_goal_work(nodes, fact.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                same_term: bool = right_literal.known and proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.left, term_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if right_literal.known and same_term:
                    goal_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, left_root, right_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not goal_primitive
                    fact_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if fact_primitive:
                        compared: mutable bool = false
                        if term_is_left:
                            compared <- proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, fact.right, operator, right_root, work_used)
                        else:
                            compared <- proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, operator, fact.right, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return compared
                left_literal: ProofKernelReplayInt = proof_kernel_replay_small_constant_with_goal_work(nodes, fact.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                same_right_term: bool = left_literal.known and proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.right, term_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if left_literal.known and same_right_term:
                    goal_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, left_root, right_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not goal_primitive
                    fact_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if fact_primitive:
                        compared: mutable bool = false
                        if term_is_left:
                            compared <- proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, fact.left, operator, right_root, work_used)
                        else:
                            compared <- proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, left_root, operator, fact.left, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return compared
            return false
