extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_literal_progress_plain_one(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return node.kind == "int" and node.value == 1 and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""

        def proof_kernel_replay_unsigned_literal_progress(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            goal = nodes[root]
            return false if goal.kind != "binary" or goal.operator != ">="
            return false if not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            relative_to_base: bool = nodes[goal.right].kind == "ident"
            return false if not relative_to_base and not proof_kernel_replay_literal_progress_plain_one(nodes[goal.right])
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, goal.left, goal.right)
            term: mutable usize = goal.left
            increment: mutable bool = false
            node = nodes[term]
            if node.kind == "binary" and node.operator == "+":
                return false if not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
                return false if not proof_kernel_replay_literal_progress_plain_one(nodes[node.right])
                term <- node.left
                increment <- true
            return false if nodes[term].kind != "ident"
            return false if relative_to_base and (not increment or not proof_kernel_replay_expr_equal(nodes, children, goal.right, term, 0))
            width: i64 = proof_kernel_replay_peer_unsigned_width(nodes, children, term, facts)
            return false if width != 8 and width != 16 and width != 32 and width != 64
            for fact in facts |fact, nodes, children, facts, term, width, increment|:
                order = proof_kernel_replay_readable_order(nodes, children, facts, fact)
                continue if not order.known
                base: mutable usize = order.right if order.operator == ">" or order.operator == ">=" else order.left
                cap: mutable usize = order.left if order.operator == ">" or order.operator == ">=" else order.right
                if increment:
                    continue if order.operator != "<" and order.operator != ">"
                else:
                    base <- order.left if order.operator == ">=" else order.right
                    cap <- order.right if order.operator == ">=" else order.left
                    continue if order.operator != ">=" and order.operator != "<="
                continue if not proof_kernel_replay_expr_equal(nodes, children, base, term, 0)
                continue if not proof_kernel_replay_valid(nodes, cap)
                literal = ElisaProofKernelCore::typed_literal_value(nodes[cap])
                return true if literal.known and literal.unsigned and literal.width == width and literal.bits > 0
            return false
