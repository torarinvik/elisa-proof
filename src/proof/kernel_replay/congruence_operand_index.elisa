extend ElisaProofKernelReplay:
    private:
        # Saturation compares every pair of terms each round, and the plain pair rule located
        # each operand's class by a linear structural-equality scan of the whole universe
        # (`proof_kernel_replay_congruence_class`), so one round cost O(terms^3) term
        # comparisons. The universe is fixed once collection ends, and `lookup` is a pure
        # function of the universe and the operand root, so each operand's term index is computed
        # once here. Only `find` reads the union-find state, and it still runs at use time, so
        # every pair verdict is the one the per-pair lookups gave.
        #
        # `slots` holds three entries per term for congruence operands. `unknown` (terms.count)
        # stands for every case where the plain rule returns false for want of a class: an
        # operand it could not read or one outside the universe. Index reads are opaque atoms,
        # not congruent formers, until replay has a receiver-selector witness.
        struct ProofKernelReplayCongruenceOperands:
            slots: darray[usize]
            counts: darray[usize]
            unknown: usize

        def proof_kernel_replay_congruence_slot(operands: ProofKernelReplayCongruenceOperands&, term_index: usize, offset: usize) -> usize:
            return operands.unknown if term_index >= operands.counts.count or offset >= 3
            position: usize = term_index * 3 + offset
            return operands.unknown if position >= operands.slots.count
            return operands.slots[position]
