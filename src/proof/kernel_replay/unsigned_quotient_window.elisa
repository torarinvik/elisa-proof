# Independent kernel replay for a source-shaped half-open unsigned window. With
# size > 0 and index < total / size, floor division guarantees the window end is
# at most total; matching widths ensure the checked product and sum do not wrap.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_quotient_window_goal_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            can Memory.Allocate, Abort.Panic:
                return false if:
                    remaining <= 1 or split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, goal_root)
                root: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, goal_root, work_used, 0)
                return false if:
                    root >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    nodes[root].kind != "binary" or nodes[root].operator != "<="
                terms: (known: bool, index: usize, size: usize, product: usize, sum: usize) = proof_kernel_replay_unsigned_quotient_window_terms(nodes, children, nodes[root].left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not terms.known
                total: usize = nodes[root].right
                width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, terms.index, facts, work_used, depth + 1)
                return false if:
                    width == 0 or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, terms.size, facts, work_used, depth + 1) != width
                    proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, total, facts, work_used, depth + 1) != width
                    proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, terms.product, facts, work_used, depth + 1) != width
                    proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, terms.sum, facts, work_used, depth + 1) != width
                    not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, terms.index, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, terms.size, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, total, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    not proof_kernel_replay_unsigned_division_divisor_width_matches_with_goal_work(nodes, children, facts, terms.size, width, 0, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                quotient_root: usize = nodes.count
                zero_root: usize = nodes.count
                positive_root: usize = nodes.count
                return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 3)
                quotient_root <- ElisaProofKernelCore::add_node(nodes, "binary", "/", total, terms.size, 0, 0, 0, 0, "", "")
                zero_root <- ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                positive_root <- ElisaProofKernelCore::add_node(nodes, "binary", ">", terms.size, zero_root, 0, 0, 0, 0, "", "")
                return false if:
                    quotient_root >= nodes.count or zero_root >= nodes.count or positive_root >= nodes.count
                    proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, quotient_root, facts, work_used, depth + 1) != width
                    not proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, positive_root, split_depth + 1, depth + 1, work_used, remaining: remaining - 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_unsigned_quotient_window_index_fact(nodes, children, facts, terms.index, quotient_root, width, work_used, 0)

        def proof_kernel_replay_unsigned_quotient_window_terms(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, sum_root: usize, work_used: mutable usize&) -> (known: bool, index: usize, size: usize, product: usize, sum: usize):
            can Memory.Allocate, Abort.Panic:
                empty: (known: bool, index: usize, size: usize, product: usize, sum: usize) = (false, 0, 0, 0, 0)
                sum: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, sum_root, work_used, 0)
                return empty if sum >= nodes.count or nodes[sum].kind != "binary" or nodes[sum].operator != "+"
                first: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, nodes[sum].left, work_used, 0)
                second: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, nodes[sum].right, work_used, 0)
                return empty if first >= nodes.count or second >= nodes.count
                if nodes[first].kind == "binary" and nodes[first].operator == "*":
                    return (true, nodes[first].right, second, first, sum) if proof_kernel_replay_goal_search_expr_equal(nodes, children, nodes[first].left, second, work_used)
                    return (true, nodes[first].left, second, first, sum) if proof_kernel_replay_goal_search_expr_equal(nodes, children, nodes[first].right, second, work_used)
                if nodes[second].kind == "binary" and nodes[second].operator == "*":
                    return (true, nodes[second].right, first, second, sum) if proof_kernel_replay_goal_search_expr_equal(nodes, children, nodes[second].left, first, work_used)
                    return (true, nodes[second].left, first, second, sum) if proof_kernel_replay_goal_search_expr_equal(nodes, children, nodes[second].right, first, work_used)
                empty

        def proof_kernel_replay_unsigned_quotient_window_index_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], index: usize, quotient: usize, width: i64, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            can Memory.Allocate, Abort.Panic:
                return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                for fact in facts |fact, nodes, children, facts, index, quotient, work_used, depth|:
                    if work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                        work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1 if work_used == PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return false
                    return true if proof_kernel_replay_unsigned_quotient_window_index_in_fact(nodes, children, facts, fact, index, quotient, width, work_used, depth)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return false

        def proof_kernel_replay_unsigned_quotient_window_index_in_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], fact: usize, index: usize, quotient: usize, width: i64, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            can Memory.Allocate, Abort.Panic:
                return false if:
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                root: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, fact, work_used, depth)
                return false if root >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                if node.kind == "binary" and node.operator == "and":
                    return true if proof_kernel_replay_unsigned_quotient_window_index_in_fact(nodes, children, facts, node.left, index, quotient, width, work_used, depth + 1)
                    return proof_kernel_replay_unsigned_quotient_window_index_in_fact(nodes, children, facts, node.right, index, quotient, width, work_used, depth + 1)
                return false if node.kind != "binary"
                if node.operator == "<":
                    return proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, index, work_used) and proof_kernel_replay_unsigned_quotient_window_bound_matches(nodes, children, facts, node.right, quotient, width, work_used, depth + 1)
                if node.operator == ">":
                    return proof_kernel_replay_goal_search_expr_equal(nodes, children, node.right, index, work_used) and proof_kernel_replay_unsigned_quotient_window_bound_matches(nodes, children, facts, node.left, quotient, width, work_used, depth + 1)
                return false

        def proof_kernel_replay_unsigned_quotient_window_bound_matches(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bound: usize, quotient: usize, width: i64, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            can Memory.Allocate, Abort.Panic:
                return false if:
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                    proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, bound, facts, work_used, depth + 1) != width
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_goal_search_expr_equal(nodes, children, bound, quotient, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                for fact in facts |fact, nodes, children, bound, quotient, work_used, depth|:
                    if work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                        work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1 if work_used == PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return false
                    return true if proof_kernel_replay_unsigned_quotient_window_equality_in_fact(nodes, children, fact, bound, quotient, work_used, depth)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return false

        def proof_kernel_replay_unsigned_quotient_window_equality_in_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, fact: usize, bound: usize, quotient: usize, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            can Memory.Allocate, Abort.Panic:
                return false if:
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                root: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, fact, work_used, depth)
                return false if root >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                if node.kind == "binary" and node.operator == "and":
                    return true if proof_kernel_replay_unsigned_quotient_window_equality_in_fact(nodes, children, node.left, bound, quotient, work_used, depth + 1)
                    return proof_kernel_replay_unsigned_quotient_window_equality_in_fact(nodes, children, node.right, bound, quotient, work_used, depth + 1)
                return false if node.kind != "binary" or node.operator != "=="
                return proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, bound, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.right, quotient, work_used) or proof_kernel_replay_goal_search_expr_equal(nodes, children, node.right, bound, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, quotient, work_used)
