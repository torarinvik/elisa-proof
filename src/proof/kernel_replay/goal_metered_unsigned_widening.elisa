extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_signed_increment_has_strict_peer_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, width: i64, facts: darray[usize], work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.operator != "+"
            unit: (known: bool, base: usize) = proof_kernel_replay_unsigned_unit_increment_base_with_work(nodes, node.left, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not unit.known
            base_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, unit.base, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or base_width != width
            for fact in facts |fact, nodes, children, facts, unit, width, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                relation: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                continue if relation.kind != "binary" or (relation.operator != "<" and relation.operator != ">")
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, relation.left, relation.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not primitive
                peer: mutable usize = relation.right
                matches: mutable bool = false
                if relation.operator == "<":
                    matches <- proof_kernel_replay_goal_search_expr_equal(nodes, children, relation.left, unit.base, work_used)
                else:
                    matches <- proof_kernel_replay_goal_search_expr_equal(nodes, children, relation.right, unit.base, work_used)
                    peer <- relation.left
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not matches
                peer_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, peer, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if peer_width > 0 and peer_width <= width
            return false

        def proof_kernel_replay_signed_guarded_subtraction_safe_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&, interval_index: mutable ProofKernelReplayIntervalExprIndex&, interval_index_ready: mutable bool&, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.operator != "-"
            width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, root, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            left_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, node.left, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_width != width
            right_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, node.right, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_width != width
            right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_context_work(nodes, children, node.right, bounds, interval_index, interval_index_ready, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not right_interval.has_lower or right_interval.lower < 0
            proof_kernel_replay_has_order_fact_with_work(nodes, children, node.right, node.left, false, facts, work_used)

        def proof_kernel_replay_signed_nonnegative_sum_safe_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&, interval_index: mutable ProofKernelReplayIntervalExprIndex&, interval_index_ready: mutable bool&, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.operator != "+"
            width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, root, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            left_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, node.left, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_width != width
            right_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, node.right, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_width != width
            left_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_context_work(nodes, children, node.left, bounds, interval_index, interval_index_ready, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_interval.has_lower or left_interval.lower < 0
            right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_context_work(nodes, children, node.right, bounds, interval_index, interval_index_ready, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not right_interval.has_lower or right_interval.lower < 0
            witness: (known: bool, bound: usize, strict: bool) = proof_kernel_replay_sum_upper_witness_with_goal_work(nodes, children, node.left, node.right, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not witness.known
            bound_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, witness.bound, work_used, 0)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and bound_width > 0 and bound_width <= width

        def proof_kernel_replay_signed_expression_safe_with_bounds_goal_shared_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            interval_index: mutable ProofKernelReplayIntervalExprIndex = proof_kernel_replay_empty_interval_expr_index()
            interval_index_ready: mutable bool = false
            proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, &markers, &markers_ready, &interval_index, &interval_index_ready, root, bounds, work_used, depth)

        # The marker facts are immutable for the whole signed-safety traversal. Parse them on
        # the first scalar witness query and reuse them across every arithmetic descendant.
        def proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, interval_index: mutable ProofKernelReplayIntervalExprIndex&, interval_index_ready: mutable bool&, root: usize, bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind in {"paren", "unary"}:
                return false if:
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.left, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if node.operator == "-":
                    width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, node.left, work_used, depth + 1)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if width != 0:
                        interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_context_work(nodes, children, root, bounds, interval_index, interval_index_ready, work_used, depth + 1)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                return true
            if node.kind == "binary":
                return false if:
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.left, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.right, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                arithmetic: bool = node.operator in {"+", "-", "*", "/", "%", "<<", ">>", "&", "|", "^"}
                return true if not arithmetic
                width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, root, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if width == 0:
                    unsigned_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, root, facts, work_used, depth + 1)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if unsigned_width != 0
                    constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return constant.value >= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN and constant.value <= ElisaProofKernelCore::PROOF_KERNEL_I64_MAX if constant.known
                    interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_context_work(nodes, children, root, bounds, interval_index, interval_index_ready, work_used, depth + 1)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                        marker_cache: mutable darray[ProofKernelReplayWitnessMarker] = []
                        cache_complete: bool = proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &marker_cache, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        return false if:
                            work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not cache_complete
                            not proof_kernel_replay_goal_search_charge_amount(work_used, marker_cache.count)
                        markers.clear()
                        markers.extend(marker_cache)
                        markers_ready <- true
                    scalar: bool = proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, root, depth + 1, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= ElisaProofKernelCore::PROOF_KERNEL_I8_MAX if scalar
                    return not scalar
                interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_context_work(nodes, children, root, bounds, interval_index, interval_index_ready, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if:
                    interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                    proof_kernel_replay_signed_guarded_subtraction_safe_with_goal_work(nodes, children, root, facts, bounds, interval_index, interval_index_ready, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_signed_nonnegative_sum_safe_with_goal_work(nodes, children, root, facts, bounds, interval_index, interval_index_ready, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return proof_kernel_replay_signed_increment_has_strict_peer_with_goal_work(nodes, children, root, width, facts, work_used) if width > 0
                return false
            if node.kind == "if":
                return false if:
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.left, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.right, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.auxiliary, bounds, work_used, depth + 1)
            # Quantifiers carry their range and body in scalar fields rather than child
            # edges. This walk lacks the checked binder type and range refinement needed to
            # admit their fixed-width arithmetic safely.
            return false if node.kind == "quantifier"
            if node.kind in {"field", "scope", "move", "checked-get", "field-init", "resource-call-arg"}:
                return proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.left, bounds, work_used, depth + 1)
            if node.kind in {"index", "dict_entry", "checked-index"}:
                return false if:
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.left, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.right, bounds, work_used, depth + 1)
            if node.kind == "slice":
                return false if:
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.left, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.right, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.auxiliary, bounds, work_used, depth + 1)
            if node.kind == "call":
                return false if:
                    node.children_start > children.count or node.children_count > children.count - node.children_start
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.left, bounds, work_used, depth + 1)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                for index in 0..<node.children_count |index, node, children, nodes, facts, markers, markers_ready, interval_index, interval_index_ready, bounds, work_used, depth|:
                    argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not argument.known
                    argument_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, argument.value)
                    return false if:
                        not argument_node.known or argument_node.node.kind != "call_arg"
                        not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, argument_node.node.left, bounds, work_used, depth + 1)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true
            if node.kind in {"index-n", "construct", "record-update", "array", "tuple", "set", "dict"}:
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                if node.kind in {"index-n", "construct", "record-update"}:
                    return false if not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, node.left, bounds, work_used, depth + 1)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                for index in 0..<node.children_count |index, node, children, nodes, facts, markers, markers_ready, interval_index, interval_index_ready, bounds, work_used, depth|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    return false if not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, child.value, bounds, work_used, depth + 1)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true
            if node.kind == "resource-call":
                return false if:
                    node.auxiliary > node.children_count or node.right != node.children_count - node.auxiliary
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.auxiliary |index, node, children, nodes, facts, markers, markers_ready, interval_index, interval_index_ready, bounds, work_used, depth|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known or child.value >= nodes.count or nodes[child.value].kind != "resource-call-arg"
                    return false if not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, markers, markers_ready, interval_index, interval_index_ready, nodes[child.value].left, bounds, work_used, depth + 1)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true
            # Fail closed for child-bearing forms without an explicit evaluation policy.
            return false if node.children_count != 0
            return true

        def proof_kernel_replay_bounded_u8_receiver_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            expression: usize = nodes[root].left if nodes[root].kind == "paren" else root
            return false if:
                expression >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, expression, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, expression)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[expression]
            return false if:
                node.kind != "binary" or node.operator != "+" or not proof_kernel_replay_arena_shape_valid(node)
                node.left >= nodes.count or node.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            base: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            literal: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
            return false if:
                base.kind != "ident" and base.kind != "field" and base.kind != "tuple"
                literal.kind != "int" or literal.value < 0 or literal.value > 255
            width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, node.left, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            markers_ready: mutable bool = true
            witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_markers_work(nodes, children, markers, node.left, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not witnessed
            safety_bounds: mutable darray[ProofKernelReplayBound] = proof_kernel_replay_signed_safety_bounds_with_goal_work(nodes, children, facts, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or work_used > PROOF_KERNEL_REPLAY_COLLECT_BOUNDS_WORK_LIMIT
            interval_index: mutable ProofKernelReplayIntervalExprIndex = proof_kernel_replay_empty_interval_expr_index()
            interval_index_ready: mutable bool = false
            return false if not proof_kernel_replay_signed_expression_safe_with_bounds_goal_cached_work(nodes, children, facts, &markers, &markers_ready, &interval_index, &interval_index_ready, expression, safety_bounds, work_used, 0)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, &bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_COLLECT_BOUNDS_WORK_LIMIT
            return false if not proof_kernel_replay_close_equalities_with_work(nodes, children, facts, &bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, expression, bounds, work_used, 0)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= 255

        def proof_kernel_replay_unsigned_widening_receiver_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&) -> usize:
            return nodes.count if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind != "call" or not proof_kernel_replay_arena_shape_valid(node) or node.children_count != 0 or node.operator != "" or node.auxiliary != 0 or node.value != 0 or node.name != "" or node.secondary_name != "":
                return root
            return root if node.left >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, node.left)
            callee: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            return root if callee.kind != "field" or not proof_kernel_replay_arena_shape_valid(callee)
            target_unsigned: i64 = 8 if callee.name == "u8" else 16 if callee.name == "u16" else 32 if callee.name == "u32" else ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS if callee.name in {"u64", "usize", "uintptr"} else 0
            target_signed: i64 = 8 if callee.name == "i8" else 16 if callee.name == "i16" else 32 if callee.name == "i32" else ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS if callee.name in {"i64", "isize", "int"} else 0
            # The source neutral replay arena does not prove whether this selector invokes a
            # user cast hook. Never erase a method-shaped cast into its receiver here.
            return root if:
                target_unsigned > 0 or target_signed > 0
                callee.left >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, callee.left, work_used)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, callee.left)
            receiver: ElisaProofKernelCore::ProofKernelNode = nodes[callee.left]
            if callee.name == "u8" and proof_kernel_replay_bounded_u8_receiver_with_goal_work(nodes, children, callee.left, facts, work_used):
                return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return receiver.left if receiver.kind == "paren" else callee.left
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return root if:
                receiver.kind != "ident" and receiver.kind != "field" and receiver.kind != "index" and receiver.kind != "index-n"
                target_unsigned == 0 and target_signed == 0
            witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, callee.left, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return root if not witnessed
            source_unsigned: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, callee.left, facts, work_used, 0)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            source_signed: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, callee.left, work_used, 0)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            type_safe: mutable bool = (source_unsigned > 0 and ((target_unsigned > 0 and target_unsigned >= source_unsigned) or (target_signed > 0 and target_signed > source_unsigned))) or (source_signed > 0 and target_signed > 0 and target_signed >= source_signed)
            if not type_safe:
                bounds: mutable darray[ProofKernelReplayBound] = []
                for fact in facts |fact, nodes, children, bounds, work_used|:
                    return nodes.count if not proof_kernel_replay_goal_search_charge(work_used)
                    proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, &bounds, work_used, 0)
                    return nodes.count if work_used > PROOF_KERNEL_REPLAY_COLLECT_BOUNDS_WORK_LIMIT
                closed: bool = proof_kernel_replay_close_equalities_with_work(nodes, children, facts, &bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not closed
                interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, callee.left, bounds, work_used, 0)
                return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if interval.has_lower and interval.has_upper and interval.lower <= interval.upper:
                    if target_signed > 0:
                        type_safe <- interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(target_signed) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(target_signed)
                        type_safe <- false if source_unsigned > 0 and interval.lower < 0
                    elif target_unsigned > 0:
                        type_safe <- interval.lower >= 0 and interval.upper <= proof_kernel_replay_unsigned_width_max(target_unsigned)
            return root if not type_safe
            receiver_root: usize = receiver.left if receiver.kind == "paren" else callee.left
            receiver_root

        def proof_kernel_replay_unsigned_widening_comparison_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> usize:
            return nodes.count if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            comparison: bool = node.operator in {"==", "!=", "<", "<=", ">", ">="}
            return root if node.kind != "binary" or not comparison or not proof_kernel_replay_arena_shape_valid(node)
            witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return root if not witnessed
            first: usize = proof_kernel_replay_unsigned_widening_receiver_with_goal_work(nodes, children, node.left, facts, work_used)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or first >= nodes.count
            second: usize = proof_kernel_replay_unsigned_widening_receiver_with_goal_work(nodes, children, node.right, facts, work_used)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or second >= nodes.count
            return root if first == node.left and second == node.right
            return nodes.count if:
                not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", node.operator)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            ElisaProofKernelCore::add_node(nodes, "binary", node.operator, first, second, 0, 0, 0, 0, "", "")
