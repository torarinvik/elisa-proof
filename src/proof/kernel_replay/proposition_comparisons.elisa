extend ElisaProofKernelReplay:
    private:
        # Enum tags have no payload value in the source-neutral term language. They are admitted
        # only as the right operand of `is`, and only when the declaration environment ties that
        # exact variant name to the receiver's declared enum type.
        def proof_kernel_replay_enum_tag_test_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, node: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if not left.known or left.family != "named" or node.right >= nodes.count
            variant: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
            return false if (variant.kind != "scope" and variant.kind != "field") or variant.name == ""
            return false if left.name == "" or not proof_kernel_replay_symbol_matches_name(nodes, variant.left, left.name, 0, work)
            enum_type: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "type", left.name, "", 0, work)
            return false if not enum_type.known or enum_type.binding.type_identity == 0 or left.type_identity != enum_type.binding.type_identity
            binding_count: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<binding_count |index, environment, variant, left, enum_type, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                return true if binding.kind == "enum-tag" and binding.name == variant.name and binding.owner == left.name and binding.owner_type_identity == enum_type.binding.type_identity
            return false

        def proof_kernel_replay_named_type_test_valid(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, right: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if not left.known or left.family != "named" or right.kind != "ident" or right.name != left.name
            type_binding: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "type", right.name, "", 0, work)
            return type_binding.known and type_binding.binding.sort == "named" and type_binding.binding.type_identity == left.type_identity

        def proof_kernel_replay_comparison_sorts_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, node: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort, right: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if not proof_kernel_replay_type_work_consume(work)
            return false if node.right >= nodes.count
            if node.operator == "is":
                right_node: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                return proof_kernel_replay_enum_tag_test_valid(nodes, environment, node, left, work) if (right_node.kind == "scope" or right_node.kind == "field")
                return proof_kernel_replay_named_type_test_valid(environment, right_node, left, work)
            left_sort: mutable ProofKernelInferredSort = left
            right_sort: mutable ProofKernelInferredSort = right
            equality: bool = node.operator == "==" or node.operator == "!="
            if equality and node.left < nodes.count and node.right < nodes.count:
                # Shorthand variants are context-sensitive in Elisa. Resolve an ambiguous bare
                # variant only from the opposite operand's declared enum identity, then require
                # the matching member binding. This never makes a bare name globally trusted.
                if not right_sort.known and nodes[node.right].kind == "shorthand" and left_sort.known and left_sort.family == "named":
                    right_sort <- proof_kernel_replay_enum_member_sort_for_type(environment, nodes[node.right].name, left_sort, work)
                if not left_sort.known and nodes[node.left].kind == "shorthand" and right_sort.known and right_sort.family == "named":
                    left_sort <- proof_kernel_replay_enum_member_sort_for_type(environment, nodes[node.left].name, right_sort, work)
            return false if not left_sort.known or not right_sort.known
            if node.operator == "in":
                return (proof_kernel_replay_numeric_sort(left_sort) and (right_sort.element_family == "integer" or right_sort.element_family == "floating" or right_sort.element_family == "character")) or (left_sort.family == right_sort.element_family and left_sort.name == right_sort.element_name) if right_sort.family == "container"
                return false
            ordering: bool = node.operator == "<" or node.operator == ">" or node.operator == "<=" or node.operator == ">="
            return false if not equality and not ordering
            return true if proof_kernel_replay_numeric_sort(left_sort) and proof_kernel_replay_numeric_sort(right_sort)
            return true if equality and left_sort.family == "boolean" and right_sort.family == "boolean"
            return true if equality and left_sort.family == "string" and right_sort.family == "string"
            return true if equality and left_sort.family == "aggregate" and right_sort.family == "aggregate" and proof_kernel_replay_sort_equal(left_sort, right_sort)
            return true if equality and left_sort.family == "named" and right_sort.family == "named" and proof_kernel_replay_sort_equal(left_sort, right_sort)
            return false
