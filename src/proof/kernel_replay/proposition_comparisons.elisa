extend ElisaProofKernelReplay:
    private:
        # Enum tags have no payload value in the source-neutral term language. They are admitted
        # only as the right operand of `is`, and only when the declaration environment ties that
        # exact variant name to the receiver's declared enum type.
        def proof_kernel_replay_enum_tag_test_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, node: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort) -> bool:
            return false if not left.known or left.family != "named" or node.right >= nodes.count
            variant: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
            return false if (variant.kind != "scope" and variant.kind != "field") or variant.name == ""
            owner: sview = proof_kernel_replay_symbol_name(nodes, variant.left, 0)
            return false if owner == "" or owner != left.name
            enum_type: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "type", owner, "", 0)
            return false if not enum_type.known or enum_type.binding.type_identity == 0 or left.type_identity != enum_type.binding.type_identity
            binding_count: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<binding_count |index, environment, variant, owner, enum_type|:
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                return true if binding.kind == "enum-tag" and binding.name == variant.name and binding.owner == owner and binding.owner_type_identity == enum_type.binding.type_identity
            return false

        def proof_kernel_replay_named_type_test_valid(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, right: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort) -> bool:
            return false if not left.known or left.family != "named" or right.kind != "ident" or right.name != left.name
            type_binding: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "type", right.name, "", 0)
            return type_binding.known and type_binding.binding.sort == "named" and type_binding.binding.type_identity == left.type_identity

        def proof_kernel_replay_comparison_sorts_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, node: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort, right: ProofKernelInferredSort) -> bool:
            return false if node.right >= nodes.count
            if node.operator == "is":
                right_node: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                return proof_kernel_replay_enum_tag_test_valid(nodes, environment, node, left) if (right_node.kind == "scope" or right_node.kind == "field")
                return proof_kernel_replay_named_type_test_valid(environment, right_node, left)
            return false if not left.known or not right.known
            if node.operator == "in":
                return (proof_kernel_replay_numeric_sort(left) and (right.element_family == "integer" or right.element_family == "floating" or right.element_family == "character")) or (left.family == right.element_family and left.name == right.element_name) if right.family == "container"
                return false
            equality: bool = node.operator == "==" or node.operator == "!="
            ordering: bool = node.operator == "<" or node.operator == ">" or node.operator == "<=" or node.operator == ">="
            return false if not equality and not ordering
            return true if proof_kernel_replay_numeric_sort(left) and proof_kernel_replay_numeric_sort(right)
            return true if equality and left.family == "boolean" and right.family == "boolean"
            return true if equality and left.family == "string" and right.family == "string"
            return true if equality and left.family == "aggregate" and right.family == "aggregate" and proof_kernel_replay_sort_equal(left, right)
            return true if equality and left.family == "named" and right.family == "named" and proof_kernel_replay_sort_equal(left, right)
            return false
