extend ElisaProofKernelReplay:
    private:
        # A tag test names a variant without constructing its value, so payload variants are
        # valid here even though they have no `enum-member` value binding. Require a unique tag
        # row owned by the exact named declaration identity.
        def proof_kernel_replay_type_identity_rows_valid(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, expected: ProofKernelInferredSort, work: mutable usize&) -> (known: bool, count: usize):
            total: usize = proof_kernel_replay_type_environment_binding_count(environment)
            indexed_count: usize = total - typing_index.value_overlay_count if typing_index.value_overlay_count <= total else 0
            return (false, 0) if:
                expected.type_identity == 0 or expected.name == ""
                typing_index.value_overlay_count > total
                typing_index.source_binding_count != total
                typing_index.type_identity_binding_capacity != typing_index.type_identity_binding_heads.count
                typing_index.type_identity_binding_rows.count != typing_index.type_identity_binding_next.count
                typing_index.type_identity_binding_next.count > indexed_count
            return (true, 0) if typing_index.type_identity_binding_capacity == 0 and typing_index.type_identity_binding_next.count == 0
            return (false, 0) if typing_index.type_identity_binding_capacity == 0
            identity_hash: u32 = proof_kernel_replay_identity_hash_mix(ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS.u32(), expected.type_identity)
            slot: usize = (identity_hash.i64() % typing_index.type_identity_binding_capacity.i64()).usize()
            row: mutable usize = typing_index.type_identity_binding_heads[slot]
            count: mutable usize = 0
            probes: mutable usize = 0
            identity_count: usize = typing_index.type_identity_binding_rows.count
            return (false, 0) if row > identity_count
            while row != identity_count and probes < identity_count |row, probes, environment, typing_index, expected, count, work, identity_count, indexed_count|:
                return (false, 0) if row >= identity_count or row >= typing_index.type_identity_binding_next.count or not proof_kernel_replay_type_work_consume(work)
                binding_row: usize = typing_index.type_identity_binding_rows[row]
                return (false, 0) if binding_row >= indexed_count
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_row)
                if binding.kind == "type" and binding.type_identity == expected.type_identity:
                    count <- count + 1
                    return (false, 0) if not proof_kernel_replay_type_text_equal(binding.name, expected.name, work) or not proof_kernel_replay_type_text_equal(binding.type_name, expected.name, work) or binding.sort != "named"
                row <- typing_index.type_identity_binding_next[row]
                return (false, 0) if row > identity_count
                probes <- probes + 1
            return (false, 0) if row != identity_count or work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return (true, count)

        def proof_kernel_replay_enum_tag_rows_for_type(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, name: sview, expected: ProofKernelInferredSort, work: mutable usize&) -> (known: bool, count: usize):
            total: usize = proof_kernel_replay_type_environment_binding_count(environment)
            indexed_count: usize = total - typing_index.value_overlay_count if typing_index.value_overlay_count <= total else 0
            return (false, 0) if:
                name == "" or expected.type_identity == 0 or expected.name == ""
                typing_index.value_overlay_count > total
                typing_index.source_binding_count != total or typing_index.enum_member_binding_capacity != typing_index.enum_member_binding_heads.count
                (typing_index.enum_member_binding_capacity == 0 and typing_index.enum_member_binding_next.count != 0)
                (typing_index.enum_member_binding_capacity > 0 and typing_index.enum_member_binding_next.count != indexed_count)
                not proof_kernel_replay_type_work_consume_amount(sview_len("enum-member-typed"), work)
                not proof_kernel_replay_type_work_consume_amount(sview_len(name), work)
                not proof_kernel_replay_type_work_consume_amount(sview_len(expected.name), work)
            return (true, 0) if typing_index.enum_member_binding_capacity == 0 and indexed_count == 0
            return (false, 0) if typing_index.enum_member_binding_capacity == 0
            hash: u32 = proof_kernel_replay_typed_enum_member_hash(name, expected.name, expected.type_identity)
            slot: usize = (hash.i64() % typing_index.enum_member_binding_capacity.i64()).usize()
            row: mutable usize = typing_index.enum_member_binding_heads[slot]
            count: mutable usize = 0
            probes: mutable usize = 0
            return (false, 0) if row > indexed_count
            while row != indexed_count and probes < indexed_count |row, probes, environment, typing_index, name, expected, count, work, indexed_count|:
                return (false, 0) if row >= indexed_count or row >= typing_index.enum_member_binding_next.count or not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, row)
                if binding.kind == "enum-tag" and binding.type_identity == expected.type_identity and binding.owner_type_identity == expected.type_identity and proof_kernel_replay_type_text_equal(binding.name, name, work) and proof_kernel_replay_type_text_equal(binding.owner, expected.name, work):
                    count <- count + 1
                row <- typing_index.enum_member_binding_next[row]
                return (false, 0) if row > indexed_count
                probes <- probes + 1
            return (false, 0) if row != indexed_count or work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return (true, count)

        def proof_kernel_replay_enum_tag_belongs_to_type(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, name: sview, expected: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if name == "" or not expected.known or expected.family != "named" or expected.name == "" or expected.type_identity == 0
            type_rows: (known: bool, count: usize) = proof_kernel_replay_type_identity_rows_valid(environment, typing_index, expected, work)
            return false if not type_rows.known
            tag_rows: (known: bool, count: usize) = proof_kernel_replay_enum_tag_rows_for_type(environment, typing_index, name, expected, work)
            return false if not tag_rows.known
            return false if work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            type_rows.count == 1 and tag_rows.count == 1

        # Enum tags have no payload value in the source-neutral term language. They are admitted
        # only as the right operand of `is`, and only when the declaration environment ties that
        # exact variant name to the receiver's declared enum type.
        def proof_kernel_replay_enum_tag_test_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, node: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if not left.known or left.family != "named" or node.right >= nodes.count
            variant: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
            return false if (variant.kind != "scope" and variant.kind != "field") or variant.name == ""
            owner_path: mutable darray[sview] = []
            return false if not proof_kernel_replay_enum_type_path(nodes, variant.left, &owner_path, 0, work)
            qualified_owner: ProofKernelInferredSort = proof_kernel_replay_enum_type_sort_for_path(environment, typing_index, owner_path, work)
            return false if not qualified_owner.known or not proof_kernel_replay_sort_equal(left, qualified_owner, work)
            proof_kernel_replay_enum_tag_belongs_to_type(environment, typing_index, variant.name, qualified_owner, work)

        def proof_kernel_replay_named_type_test_valid(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, right: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if not left.known or left.family != "named" or right.kind != "ident" or not proof_kernel_replay_type_text_equal(right.name, left.name, work)
            type_binding: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, typing_index, "type", right.name, "", 0, true, 0, "", work)
            return type_binding.known and type_binding.binding.sort == "named" and type_binding.binding.type_identity == left.type_identity

        def proof_kernel_replay_comparison_sorts_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, node: ElisaProofKernelCore::ProofKernelNode, left: ProofKernelInferredSort, right: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_type_work_consume(work)
                node.right >= nodes.count
            if node.operator == "is":
                right_node: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                return proof_kernel_replay_enum_tag_test_valid(nodes, environment, typing_index, node, left, work) if (right_node.kind in {"scope", "field"})
                if right_node.kind == "shorthand":
                    # Tags do not need a value constructor. Resolve shorthand against the exact
                    # scrutinee enum identity, including variants that carry payloads.
                    return proof_kernel_replay_enum_tag_belongs_to_type(environment, typing_index, right_node.name, left, work)
                return proof_kernel_replay_named_type_test_valid(environment, typing_index, right_node, left, work)
            left_sort: mutable ProofKernelInferredSort = left
            right_sort: mutable ProofKernelInferredSort = right
            equality: bool = node.operator in {"==", "!="}
            if equality and node.left < nodes.count and node.right < nodes.count:
                # Shorthand variants are context-sensitive in Elisa. Resolve an ambiguous bare
                # variant only from the opposite operand's declared enum identity, then require
                # the matching member binding. This never makes a bare name globally trusted.
                if node.left < nodes.count:
                    if node.right < nodes.count:
                        if not right_sort.known and nodes[node.right].kind == "shorthand" and left_sort.known and left_sort.family == "named":
                            right_sort <- proof_kernel_replay_enum_member_sort_for_type(environment, typing_index, nodes[node.right].name, left_sort, work)
                        if not left_sort.known and nodes[node.left].kind == "shorthand" and right_sort.known and right_sort.family == "named":
                            left_sort <- proof_kernel_replay_enum_member_sort_for_type(environment, typing_index, nodes[node.left].name, right_sort, work)
            return false if not left_sort.known or not right_sort.known
            if node.operator == "in":
                if right_sort.family == "container":
                    numeric_element: bool = right_sort.element_family in {"integer", "floating", "character"}
                    return true if numeric_element and proof_kernel_replay_numeric_sort(left_sort)
                    same_element_sort: bool = proof_kernel_replay_type_text_equal(left_sort.family, right_sort.element_family, work) and proof_kernel_replay_type_text_equal(left_sort.name, right_sort.element_name, work)
                    return same_element_sort and left_sort.type_identity == right_sort.element_type_identity
                return false
            ordering: bool = node.operator in {"<", ">", "<=", ">="}
            return false if not equality and not ordering
            left_opaque_float: mutable bool = false
            right_opaque_float: mutable bool = false
            if node.left < nodes.count:
                left_opaque_float <- nodes[node.left].kind == "opaque-float-literal"
            if node.right < nodes.count:
                right_opaque_float <- nodes[node.right].kind == "opaque-float-literal"
            # The spelling token has no numeric value or scalar witness. Permit it only
            # directly in a comparison with a floating operand (or another such literal).
            if left_opaque_float or right_opaque_float:
                return right_sort.family == "opaque-floating-literal" if left_opaque_float and right_opaque_float
                return right_sort.family == "floating" if left_opaque_float
                return left_sort.family == "floating" if right_opaque_float
            left_nullable_pointer: bool = left_sort.family in {"nullable-reference", "nullable-opaque-reference"}
            right_nullable_pointer: bool = right_sort.family in {"nullable-reference", "nullable-opaque-reference"}
            return true if equality and left_nullable_pointer and right_nullable_pointer and proof_kernel_replay_sort_equal(left_sort, right_sort, work)
            return equality if:
                equality and left_nullable_pointer and right_sort.family == "null"
                equality and left_sort.family == "null" and right_nullable_pointer
            special_sort: bool = left_nullable_pointer or right_nullable_pointer or left_sort.family == "null" or right_sort.family == "null"
            return false if special_sort
            return true if:
                proof_kernel_replay_numeric_sort(left_sort) and proof_kernel_replay_numeric_sort(right_sort)
                equality and left_sort.family == "boolean" and right_sort.family == "boolean"
                equality and left_sort.family == "string" and right_sort.family == "string"
                equality and left_sort.family == "aggregate" and right_sort.family == "aggregate" and proof_kernel_replay_sort_equal(left_sort, right_sort, work)
                equality and left_sort.family == "named" and right_sort.family == "named" and proof_kernel_replay_sort_equal(left_sort, right_sort, work)
            return false
