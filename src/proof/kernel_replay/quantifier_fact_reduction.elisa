extend ElisaProofKernelReplay:
    private:
        # This retry is a soundness-preserving search reduction: it drops top-level quantified
        # assumptions and never instantiates them. Every accepted recursive proof therefore uses
        # a subset of the caller's assumptions. Keep this operation deletion-only; adding a
        # derived instance here would need an independently checked quantifier-elimination rule.
        # Its sole caller is goal-depth replay, reached only after arena admission has validated
        # every node and child edge in the shared arena (including every node rooted by `facts`).
        # Keep this helper private to that admitted path; a new direct caller must validate its
        # arena and fact roots before invoking it.
        def proof_kernel_replay_reduce_quantifier_facts_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, facts: darray[usize], reduced: mutable darray[usize]&, removed: mutable bool&, work_used: mutable usize&) -> bool:
            saw_quantifier: mutable bool = false
            for fact_index in 0..<facts.count |fact_index, facts, nodes, reduced, removed, saw_quantifier, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                fact: usize = facts[fact_index]
                return false if:
                    fact >= nodes.count
                    not proof_kernel_replay_valid(nodes, fact)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if nodes[fact].kind == "quantifier":
                    removed <- true
                    if not saw_quantifier:
                        # Delay allocating/copying the retained context until there is actually
                        # a quantified fact to remove. On the common no-quantifier path, this
                        # scan now costs only the charged validation needed to decide that fact.
                        for prefix_index in 0..<fact_index |prefix_index, facts, reduced, work_used|:
                            return false if not proof_kernel_replay_goal_search_push_index_with_work(facts[prefix_index], &reduced, work_used)
                        saw_quantifier <- true
                else:
                    return false if saw_quantifier and not proof_kernel_replay_goal_search_push_index_with_work(fact, &reduced, work_used)
            return true
