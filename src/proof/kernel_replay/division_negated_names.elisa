extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_negated_name_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, depth: usize) -> usize:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return nodes.count if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary" and node.operator == "-" and proof_kernel_replay_valid(nodes, node.left):
                return nodes.count if not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                if nodes[node.left].kind == "ident" and nodes[node.left].name != "":
                    return root
            return proof_kernel_replay_negated_name_with_goal_work(nodes, node.left, work_used, depth + 1) if node.kind in {"paren", "unary"}
            return nodes.count if node.kind != "binary"
            found: usize = proof_kernel_replay_negated_name_with_goal_work(nodes, node.left, work_used, depth + 1)
            return found if found < nodes.count
            proof_kernel_replay_negated_name_with_goal_work(nodes, node.right, work_used, depth + 1)
