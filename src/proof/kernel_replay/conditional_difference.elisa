extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_conditional_difference_safe(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            node = nodes[root]
            return false if node.kind != "if" or not proof_kernel_replay_arena_shape_valid(node)
            return false if not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right) or not proof_kernel_replay_valid(nodes, node.auxiliary)
            zero = nodes[node.auxiliary]
            return false if zero.kind != "int" or zero.value != 0 or zero.operator != "" or zero.left != 0 or zero.right != 0 or zero.auxiliary != 0 or zero.children_start != 0 or zero.children_count != 0 or zero.name != "" or zero.secondary_name != ""
            delta = nodes[node.right]
            return false if delta.kind != "binary" or delta.operator != "-" or not proof_kernel_replay_arena_shape_valid(delta)
            return false if not proof_kernel_replay_valid(nodes, delta.left) or not proof_kernel_replay_valid(nodes, delta.right)
            return false if nodes[delta.left].kind != "ident" or nodes[delta.right].kind != "ident"
            return false if not proof_kernel_replay_arena_shape_valid(nodes[delta.left]) or not proof_kernel_replay_arena_shape_valid(nodes[delta.right])
            width: i64 = proof_kernel_replay_peer_unsigned_width(nodes, children, delta.left, facts)
            return false if width != 8 and width != 16 and width != 32 and width != 64
            return false if proof_kernel_replay_peer_unsigned_width(nodes, children, delta.right, facts) != width
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, delta.left, delta.right)
            condition = nodes[node.left]
            return false if condition.kind != "binary" or not proof_kernel_replay_arena_shape_valid(condition)
            return false if not proof_kernel_replay_valid(nodes, condition.left) or not proof_kernel_replay_valid(nodes, condition.right)
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, condition.left, condition.right)
            if condition.operator == ">" or condition.operator == ">=":
                return proof_kernel_replay_expr_equal(nodes, children, condition.left, delta.left, 0) and proof_kernel_replay_expr_equal(nodes, children, condition.right, delta.right, 0)
            if condition.operator == "<" or condition.operator == "<=":
                return proof_kernel_replay_expr_equal(nodes, children, condition.left, delta.right, 0) and proof_kernel_replay_expr_equal(nodes, children, condition.right, delta.left, 0)
            return false
