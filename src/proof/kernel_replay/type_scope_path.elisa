extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_find_value_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, name: sview, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            return proof_kernel_replay_find_owned_value_binding(environment, index, name, 0, work)

        # Scope ASTs are left-associated, so walking from the outer node collects the
        # path in reverse order. Keep that compact representation and charge each node
        # once; callers index from the end when comparing canonical left-to-right paths.
        def proof_kernel_replay_scope_path_segments(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work: mutable usize&) -> (known: bool, segments: darray[sview]):
            segments: mutable darray[sview] = []
            cursor: mutable usize = root
            depth: mutable usize = 0
            while true |nodes, cursor, depth, segments, work|:
                return (false, segments) if:
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or cursor >= nodes.count
                    not proof_kernel_replay_type_work_consume(work)
                node: ElisaProofKernelCore::ProofKernelNode = nodes[cursor]
                return (false, segments) if not proof_kernel_replay_arena_shape_valid(node) or node.name == ""
                if node.kind == "ident":
                    segments.push(node.name)
                    return (segments.count <= 128, segments)
                return (false, segments) if node.kind != "scope"
                segments.push(node.name)
                cursor <- node.left
                depth <- depth + 1
