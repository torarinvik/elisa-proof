# Typed proposition formation traverses the admitted term arena under declaration-only bindings.
# The shared work counter bounds repeated DAG paths and environment scans across the goal and facts.
extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_PROPOSITION_DEPTH_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT

        # Contract quantifier binders are parser-authentic i64 locals. Collection domains
        # provide the values for those binders, so their element/key/value sorts must agree
        # before the binder type is erased from the neutral quantifier node.
        def proof_kernel_replay_quantifier_i64_sort(sort: ProofKernelInferredSort) -> bool:
            sort.known and sort.family == "integer" and sort.name == "i64"

        def proof_kernel_replay_quantifier_range_sorts(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, range_root: usize, depth: usize, work: mutable usize&) -> (known: bool, first: ProofKernelInferredSort, second: ProofKernelInferredSort):
            return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if:
                depth >= PROOF_KERNEL_PROPOSITION_DEPTH_LIMIT or range_root >= nodes.count
                not proof_kernel_replay_type_work_consume(work)
            range: ElisaProofKernelCore::ProofKernelNode = nodes[range_root]
            if range.kind == "binary" and (range.operator in {"range_lt", "range_le"}):
                lower: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, range.left, depth + 1, work)
                upper: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, range.right, depth + 1, work)
                return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if not lower.known or not upper.known or not proof_kernel_replay_integral_sort(lower) or not proof_kernel_replay_integral_sort(upper)
                element: ProofKernelInferredSort = proof_kernel_replay_known_sort("integer", "i64")
                return (true, element, proof_kernel_replay_unknown_sort())
            if range.kind == "dict" and range.children_count > 0:
                entry_root: usize = proof_kernel_replay_child_root(children, range, 0)
                return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if entry_root >= nodes.count or nodes[entry_root].kind != "dict_entry"
                first: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, nodes[entry_root].left, depth + 1, work)
                second: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, nodes[entry_root].right, depth + 1, work)
                return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if not proof_kernel_replay_quantifier_i64_sort(first) or not proof_kernel_replay_quantifier_i64_sort(second)
                for offset in 1..<range.children_count |offset, nodes, children, environment, range, depth, first, second, work|:
                    return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if not proof_kernel_replay_type_work_consume(work)
                    next_entry_root: usize = proof_kernel_replay_child_root(children, range, offset)
                    return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if next_entry_root >= nodes.count or nodes[next_entry_root].kind != "dict_entry"
                    next_key: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, nodes[next_entry_root].left, depth + 1, work)
                    next_value: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, nodes[next_entry_root].right, depth + 1, work)
                    return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if not proof_kernel_replay_quantifier_i64_sort(next_key) or not proof_kernel_replay_quantifier_i64_sort(next_value) or not proof_kernel_replay_sort_equal(first, next_key, work) or not proof_kernel_replay_sort_equal(second, next_value, work)
                return (true, first, second)
            if range.kind in {"array", "tuple", "set"}:
                return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if range.children_count == 0
                first_root: usize = proof_kernel_replay_child_root(children, range, 0)
                first: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, first_root, depth + 1, work)
                return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if not proof_kernel_replay_quantifier_i64_sort(first)
                for offset in 1..<range.children_count |offset, nodes, children, environment, range, depth, first, work|:
                    return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if not proof_kernel_replay_type_work_consume(work)
                    child_root: usize = proof_kernel_replay_child_root(children, range, offset)
                    child_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, child_root, depth + 1, work)
                    # A quantified binder has one type. Tuple literals may be heterogeneous as
                    # values, but treating their first element as the type of every later value
                    # would let a proposition replay under a false typing premise.
                    return (false, proof_kernel_replay_unknown_sort(), proof_kernel_replay_unknown_sort()) if not proof_kernel_replay_quantifier_i64_sort(child_sort) or not proof_kernel_replay_sort_equal(first, child_sort, work)
                return (first.known, first, proof_kernel_replay_unknown_sort())
            range_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, range_root, depth + 1, work)
            element_known: bool = range_sort.known and range_sort.family == "container" and range_sort.element_family == "integer" and range_sort.element_name == "i64"
            element: ProofKernelInferredSort = ProofKernelInferredSort{known: element_known, family: range_sort.element_family if element_known else "", name: range_sort.element_name if element_known else "", element_family: "", element_name: "", type_identity: range_sort.element_type_identity if element_known else 0, element_type_identity: 0}
            unknown: ProofKernelInferredSort = ProofKernelInferredSort{known: false, family: "", name: "", element_family: "", element_name: "", type_identity: 0, element_type_identity: 0}
            return (element.known, element, unknown)

        def proof_kernel_replay_typed_proposition_at(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, root: usize, depth: usize, work: mutable usize&) -> bool:
            requires depth <= PROOF_KERNEL_PROPOSITION_DEPTH_LIMIT
            decreases PROOF_KERNEL_PROPOSITION_DEPTH_LIMIT - depth
            return false if:
                depth >= PROOF_KERNEL_PROPOSITION_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_type_work_consume(work)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "quantifier":
                return false if node.operator != "forall" and node.operator != "exists"
                range_sorts: (known: bool, first: ProofKernelInferredSort, second: ProofKernelInferredSort) = proof_kernel_replay_quantifier_range_sorts(nodes, children, environment, typing_index, node.left, depth + 1, work)
                return false if not range_sorts.known
                scoped_bindings: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding] = environment.bindings
                if node.auxiliary == 1:
                    added: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding_with_identity(&scoped_bindings, "value", node.name, "", range_sorts.first.family, range_sorts.first.name, range_sorts.first.element_family, range_sorts.first.element_name, range_sorts.first.type_identity, 0, range_sorts.first.element_type_identity)
                    return false if not added
                elif node.auxiliary == 2:
                    return false if not range_sorts.second.known or node.name == node.secondary_name
                    first_added: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding_with_identity(&scoped_bindings, "value", node.name, "", range_sorts.first.family, range_sorts.first.name, range_sorts.first.element_family, range_sorts.first.element_name, range_sorts.first.type_identity, 0, range_sorts.first.element_type_identity)
                    second_added: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding_with_identity(&scoped_bindings, "value", node.secondary_name, "", range_sorts.second.family, range_sorts.second.name, range_sorts.second.element_family, range_sorts.second.element_name, range_sorts.second.type_identity, 0, range_sorts.second.element_type_identity)
                    return false if not first_added or not second_added
                else:
                    return false
                scoped: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: environment.global_bindings, bindings: scoped_bindings}
                scoped_index: (known: bool, index: ProofKernelReplayTypingIndex) = proof_kernel_replay_build_scoped_typing_index(scoped, work, typing_index)
                return false if not scoped_index.known
                return proof_kernel_replay_typed_proposition_at(nodes, children, scoped, scoped_index.index, node.right, depth + 1, work)
            if node.kind == "unary" and node.operator == "not":
                return proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, node.left, depth + 1, work)
            if node.kind == "binary" and (node.operator in {"and", "or", "=>"}):
                return false if not proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, node.left, depth + 1, work)
                return proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, node.right, depth + 1, work)
            if node.kind == "if":
                return false if:
                    not proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, node.left, depth + 1, work)
                    not proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, node.right, depth + 1, work)
                return proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, node.auxiliary, depth + 1, work)
            if node.kind == "call" and proof_kernel_replay_symbol_name(nodes, node.left, 0, work) == "old" and node.children_count == 1:
                argument_wrapper: usize = proof_kernel_replay_child_root(children, node, 0)
                return false if argument_wrapper >= nodes.count or nodes[argument_wrapper].kind != "call_arg"
                return proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, nodes[argument_wrapper].left, depth + 1, work)
            inferred: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, root, depth + 1, work)
            return inferred.known and (inferred.family in {"boolean", "proposition"})

        def proof_kernel_replay_typed_proposition_state_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize) -> bool:
            return false if not proof_kernel_replay_type_scan_budget_admitted(environment, nodes.count)
            work_used: mutable usize = 0
            initial_index: (known: bool, index: ProofKernelReplayTypingIndex) = proof_kernel_replay_build_typing_index(environment, &work_used)
            return false if:
                not initial_index.known
                not proof_kernel_replay_typed_proposition_at(nodes, children, environment, initial_index.index, goal_root, 0, &work_used)
                work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            for fact in facts |fact, work_used|:
                return false if:
                    not proof_kernel_replay_type_work_consume(&work_used)
                    not proof_kernel_replay_typed_proposition_at(nodes, children, environment, initial_index.index, fact, 0, &work_used)
                    work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return true

        # Reuse an already admitted environment index when checking multiple tactic states.
        # Each state keeps its own proposition work budget; only the declaration scan is shared.
        def proof_kernel_replay_typed_proposition_state_valid_with_index(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_type_scan_budget_admitted(environment, nodes.count)
                not proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, goal_root, 0, work_used)
                work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            for fact in facts |fact, work_used|:
                return false if:
                    not proof_kernel_replay_type_work_consume(&work_used)
                    not proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, fact, 0, work_used)
                    work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return true

        def proof_kernel_replay_typed_proposition_state_valid_with_workspace(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, facts: darray[usize], goal_root: usize, typing_workspace: mutable ProofKernelReplayTypingWorkspace&) -> bool:
            return false if not proof_kernel_replay_type_scan_budget_admitted(environment, nodes.count)
            work_used: mutable usize = 0
            index_built: bool = proof_kernel_replay_build_typing_workspace(environment, &work_used, typing_workspace)
            return false if not index_built
            initial_index: ProofKernelReplayTypingIndex = ProofKernelReplayTypingIndex{value_binding_count: typing_workspace.value_binding_indices.count, value_overlay_start: environment.bindings.count, value_overlay_count: 0, function_parameter_count: typing_workspace.function_parameter_indices.count, source_binding_count: proof_kernel_replay_type_environment_binding_count(environment), value_binding_indices: typing_workspace.value_binding_indices, function_parameter_indices: typing_workspace.function_parameter_indices, function_parameter_bucket_heads: typing_workspace.function_parameter_bucket_heads, function_parameter_next_indices: typing_workspace.function_parameter_next_indices, call_binding_count: environment.bindings.count, scoped_local_binding_count: environment.bindings.count, call_owner_name_capacity: typing_workspace.call_owner_name_capacity, call_owner_name_hashes: typing_workspace.call_owner_name_hashes, call_owner_name_slots: typing_workspace.call_owner_name_slots, call_owner_name_ids: typing_workspace.call_owner_name_ids, call_owner_marker_counts: typing_workspace.call_owner_marker_counts, call_owner_shadowed: typing_workspace.call_owner_shadowed, declaration_binding_capacity: typing_workspace.declaration_binding_capacity, declaration_binding_heads: typing_workspace.declaration_binding_heads, declaration_binding_next: typing_workspace.declaration_binding_next, enum_member_binding_capacity: typing_workspace.enum_member_binding_capacity, enum_member_binding_heads: typing_workspace.enum_member_binding_heads, enum_member_binding_next: typing_workspace.enum_member_binding_next, global_function_group_index: typing_workspace.global_function_group_index, local_function_group_index: typing_workspace.local_function_group_index, owner_path_index: typing_workspace.owner_path_index}
            return false if:
                not proof_kernel_replay_typed_proposition_at(nodes, children, environment, initial_index, goal_root, 0, &work_used)
                work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            for fact in facts |fact, work_used|:
                return false if:
                    not proof_kernel_replay_type_work_consume(&work_used)
                    not proof_kernel_replay_typed_proposition_at(nodes, children, environment, initial_index, fact, 0, &work_used)
                    work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return true

        def proof_kernel_replay_typed_proposition_state_valid_with_cached_globals(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, local_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], facts: darray[usize], goal_root: usize, typing_workspace: mutable ProofKernelReplayTypingWorkspace&, work_used: mutable usize&) -> bool:
            return false if not typing_workspace.cache.ready
            environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: typing_workspace.cache.bindings, bindings: local_bindings}
            return false if not proof_kernel_replay_type_scan_budget_admitted(environment, nodes.count)
            index_built: bool = proof_kernel_replay_build_typing_workspace_with_globals(local_bindings, work_used, typing_workspace)
            return false if not index_built
            function_parameter_indices: mutable darray[usize] = typing_workspace.cache.combined_function_parameter_indices
            function_parameter_bucket_heads: mutable darray[usize] = typing_workspace.cache.combined_function_parameter_bucket_heads
            function_parameter_next_indices: mutable darray[usize] = typing_workspace.cache.combined_function_parameter_next_indices
            function_parameter_count: mutable usize = function_parameter_indices.count
            if typing_workspace.cache.reuse_global_function_parameter_index:
                function_parameter_indices <- typing_workspace.cache.function_parameter_indices
                function_parameter_bucket_heads <- typing_workspace.cache.function_parameter_bucket_heads
                function_parameter_next_indices <- typing_workspace.cache.function_parameter_next_indices
                function_parameter_count <- typing_workspace.cache.function_parameter_indices.count
            initial_index: ProofKernelReplayTypingIndex = ProofKernelReplayTypingIndex{value_binding_count: typing_workspace.cache.combined_value_binding_indices.count, value_overlay_start: environment.bindings.count, value_overlay_count: 0, function_parameter_count: function_parameter_count, source_binding_count: proof_kernel_replay_type_environment_binding_count(environment), value_binding_indices: typing_workspace.cache.combined_value_binding_indices, function_parameter_indices: function_parameter_indices, function_parameter_bucket_heads: function_parameter_bucket_heads, function_parameter_next_indices: function_parameter_next_indices, call_binding_count: environment.bindings.count, scoped_local_binding_count: environment.bindings.count, call_owner_name_capacity: typing_workspace.call_owner_name_capacity, call_owner_name_hashes: typing_workspace.call_owner_name_hashes, call_owner_name_slots: typing_workspace.call_owner_name_slots, call_owner_name_ids: typing_workspace.call_owner_name_ids, call_owner_marker_counts: typing_workspace.call_owner_marker_counts, call_owner_shadowed: typing_workspace.call_owner_shadowed, declaration_binding_capacity: typing_workspace.declaration_binding_capacity, declaration_binding_heads: typing_workspace.declaration_binding_heads, declaration_binding_next: typing_workspace.declaration_binding_next, enum_member_binding_capacity: typing_workspace.enum_member_binding_capacity, enum_member_binding_heads: typing_workspace.enum_member_binding_heads, enum_member_binding_next: typing_workspace.enum_member_binding_next, global_function_group_index: typing_workspace.global_function_group_index, local_function_group_index: typing_workspace.local_function_group_index, owner_path_index: typing_workspace.owner_path_index}
            return false if:
                not proof_kernel_replay_typed_proposition_at(nodes, children, environment, initial_index, goal_root, 0, work_used)
                work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            for fact in facts |fact, work_used|:
                return false if:
                    not proof_kernel_replay_type_work_consume(work_used)
                    not proof_kernel_replay_typed_proposition_at(nodes, children, environment, initial_index, fact, 0, work_used)
                    work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return true

        # Typed indexed-read replay uses the same kernel-owned global snapshot as proposition
        # formation. Rebuild and validate only owner-local indexes for each attempt, then use
        # that exact index for both proposition formation and the equality rule.
        def proof_kernel_replay_typed_index_read_with_cached_globals(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, local_bindings: darray[ElisaProofKernelCore::ProofKernelTypingBinding], facts: darray[usize], goal_root: usize, typing_workspace: mutable ProofKernelReplayTypingWorkspace&, type_work_used: mutable usize&, goal_work_used: mutable usize&) -> bool:
            return false if not typing_workspace.cache.ready or type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET or goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{global_bindings: typing_workspace.cache.bindings, bindings: local_bindings}
            return false if not proof_kernel_replay_type_scan_budget_admitted(environment, nodes.count)
            return false if not proof_kernel_replay_build_typing_workspace_with_globals(local_bindings, type_work_used, typing_workspace)
            function_parameter_indices: mutable darray[usize] = typing_workspace.cache.combined_function_parameter_indices
            function_parameter_bucket_heads: mutable darray[usize] = typing_workspace.cache.combined_function_parameter_bucket_heads
            function_parameter_next_indices: mutable darray[usize] = typing_workspace.cache.combined_function_parameter_next_indices
            function_parameter_count: mutable usize = function_parameter_indices.count
            if typing_workspace.cache.reuse_global_function_parameter_index:
                function_parameter_indices <- typing_workspace.cache.function_parameter_indices
                function_parameter_bucket_heads <- typing_workspace.cache.function_parameter_bucket_heads
                function_parameter_next_indices <- typing_workspace.cache.function_parameter_next_indices
                function_parameter_count <- typing_workspace.cache.function_parameter_indices.count
            typing_index: ProofKernelReplayTypingIndex = ProofKernelReplayTypingIndex{value_binding_count: typing_workspace.cache.combined_value_binding_indices.count, value_overlay_start: environment.bindings.count, value_overlay_count: 0, function_parameter_count: function_parameter_count, source_binding_count: proof_kernel_replay_type_environment_binding_count(environment), value_binding_indices: typing_workspace.cache.combined_value_binding_indices, function_parameter_indices: function_parameter_indices, function_parameter_bucket_heads: function_parameter_bucket_heads, function_parameter_next_indices: function_parameter_next_indices, call_binding_count: environment.bindings.count, scoped_local_binding_count: environment.bindings.count, call_owner_name_capacity: typing_workspace.call_owner_name_capacity, call_owner_name_hashes: typing_workspace.call_owner_name_hashes, call_owner_name_slots: typing_workspace.call_owner_name_slots, call_owner_name_ids: typing_workspace.call_owner_name_ids, call_owner_marker_counts: typing_workspace.call_owner_marker_counts, call_owner_shadowed: typing_workspace.call_owner_shadowed, declaration_binding_capacity: typing_workspace.declaration_binding_capacity, declaration_binding_heads: typing_workspace.declaration_binding_heads, declaration_binding_next: typing_workspace.declaration_binding_next, enum_member_binding_capacity: typing_workspace.enum_member_binding_capacity, enum_member_binding_heads: typing_workspace.enum_member_binding_heads, enum_member_binding_next: typing_workspace.enum_member_binding_next, global_function_group_index: typing_workspace.global_function_group_index, local_function_group_index: typing_workspace.local_function_group_index, owner_path_index: typing_workspace.owner_path_index}
            return false if:
                not proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, goal_root, 0, &type_work_used)
                type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            for fact in facts |fact, type_work_used|:
                return false if not proof_kernel_replay_type_work_consume(type_work_used) or not proof_kernel_replay_typed_proposition_at(nodes, children, environment, typing_index, fact, 0, &type_work_used) or type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return proof_kernel_replay_typed_index_read_equality_with_work(nodes, children, environment, typing_index, facts, goal_root, &type_work_used, &goal_work_used)
