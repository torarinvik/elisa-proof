extend ElisaProofKernelReplay:
    private:
        # Metered mirror of the span-cursor shape rule. The three width lookups and the nested
        # order-fact search all share the caller's goal work, as do the structural comparisons.
        def proof_kernel_replay_unsigned_span_cursor_bound_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used) or root >= nodes.count
            return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "<=", work_used)
            greater_equal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, ">=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_goal or (not less_equal and not greater_equal)
            low: usize = goal.right if greater_equal else goal.left
            high: usize = goal.left if greater_equal else goal.right
            return false if low >= nodes.count or high >= nodes.count
            return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, low, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, high, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, low) or not proof_kernel_replay_valid(nodes, high)
            for fact_root in facts |fact_root, nodes, children, facts, low, high, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                binary_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.kind, "binary", work_used)
                less_equal_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, "<=", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not binary_fact or not less_equal_fact
                continue if fact.left >= nodes.count or fact.right >= nodes.count
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_valid(nodes, fact.left) or not proof_kernel_replay_valid(nodes, fact.right)
                span: ElisaProofKernelCore::ProofKernelNode = nodes[fact.right]
                span_binary: bool = proof_kernel_replay_goal_search_text_equal(span.kind, "binary", work_used)
                subtraction: bool = proof_kernel_replay_goal_search_text_equal(span.operator, "-", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not span_binary or not subtraction
                start: usize = span.right
                end: usize = span.left
                step: usize = fact.left
                continue if start >= nodes.count or end >= nodes.count or step >= nodes.count
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, start, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, end, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, step, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_valid(nodes, start) or not proof_kernel_replay_valid(nodes, end) or not proof_kernel_replay_valid(nodes, step)
                start_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[start].kind, "ident", work_used)
                end_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[end].kind, "ident", work_used)
                step_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[step].kind, "ident", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not start_ident or not end_ident or not step_ident
                width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, start, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if width == 0
                end_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, end, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if end_width != width
                step_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, step, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if step_width != width
                has_order: bool = proof_kernel_replay_has_order_fact_with_work(nodes, children, start, end, false, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not has_order
                lower: ElisaProofKernelCore::ProofKernelNode = nodes[low]
                upper: ElisaProofKernelCore::ProofKernelNode = nodes[high]
                lower_binary: bool = proof_kernel_replay_goal_search_text_equal(lower.kind, "binary", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if lower_binary:
                    lower_add: bool = proof_kernel_replay_goal_search_text_equal(lower.operator, "+", work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if lower_add:
                        same_start: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, lower.left, start, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        if same_start:
                            same_step: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, lower.right, step, work_used)
                            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                            if same_step:
                                same_end: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, high, end, work_used)
                                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                                return true if same_end
                    lower_subtract: bool = proof_kernel_replay_goal_search_text_equal(lower.operator, "-", work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if lower_subtract:
                        same_end: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, lower.left, end, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        if same_end:
                            same_step: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, lower.right, step, work_used)
                            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                            if same_step:
                                same_start: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, low, start, work_used)
                                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                                return true if same_start
                upper_binary: bool = proof_kernel_replay_goal_search_text_equal(upper.kind, "binary", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if upper_binary:
                    upper_add: bool = proof_kernel_replay_goal_search_text_equal(upper.operator, "+", work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if upper_add:
                        same_start: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, upper.left, start, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        if same_start:
                            same_step: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, upper.right, step, work_used)
                            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                            if same_step:
                                same_end: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, low, start, work_used)
                                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                                return true if same_end
                    upper_subtract: bool = proof_kernel_replay_goal_search_text_equal(upper.operator, "-", work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if upper_subtract:
                        same_end: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, upper.left, end, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        if same_end:
                            same_step: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, upper.right, step, work_used)
                            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                            if same_step:
                                same_start: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, low, start, work_used)
                                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                                return true if same_start
            false
