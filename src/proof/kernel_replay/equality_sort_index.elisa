# Bounded owner-independent sort summaries for name-equality closure.
extend ElisaProofKernelReplay:
    private:
        struct ProofKernelReplayEqualityVertexIndex:
            hashes: mutable darray[u32]
            values: mutable darray[usize]
            capacity: usize

        struct ProofKernelReplayEqualitySortIndex:
            names: mutable darray[sview]
            hashes: mutable darray[u32]
            slots: mutable darray[usize]
            signed_widths: mutable darray[i64]
            unsigned_widths: mutable darray[i64]
            signed_conflicts: mutable darray[bool]
            unsigned_conflicts: mutable darray[bool]
            capacity: usize

        def proof_kernel_replay_equality_vertex_index_build(edge_count: usize, work_used: mutable usize&, work_limit: usize) -> (complete: bool, index: ProofKernelReplayEqualityVertexIndex):
            index: mutable ProofKernelReplayEqualityVertexIndex = ProofKernelReplayEqualityVertexIndex{hashes: [], values: [], capacity: 0}
            return (false, index) if work_used > work_limit
            return (true, index) if edge_count == 0
            return (false, index) if edge_count > (work_limit - work_used) / 2
            capacity: mutable usize = 1
            target: usize = edge_count * 2
            while capacity < target |capacity, target, work_used, work_limit|:
                return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                capacity <- capacity * 2
            return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, capacity * 2, work_limit)
            index.capacity <- capacity
            index.hashes.resize(capacity)
            index.values.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity, work_used, work_limit|:
                return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                index.values[slot] <- capacity
            return (true, index)

        def proof_kernel_replay_equality_vertex_index_insert(index: mutable ProofKernelReplayEqualityVertexIndex&, names: mutable darray[sview]&, name: sview, work_used: mutable usize&, work_limit: usize) -> (complete: bool, row: usize):
            return (false, names.count) if work_used > work_limit or name == "" or index.capacity == 0 or index.hashes.count != index.capacity or index.values.count != index.capacity
            return (false, names.count) if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, name, work_limit)
            hash: u32 = proof_kernel_replay_name_hash(name)
            slot: mutable usize = (hash.i64() % index.capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < index.capacity |probes, slot, hash, index, names, name, work_used, work_limit|:
                return (false, names.count) if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                current: usize = index.values[slot]
                if current == index.capacity:
                    return (false, names.count) if names.count >= index.capacity or not proof_kernel_replay_equality_closure_charge_text_entry(work_used, name, work_limit)
                    index.hashes[slot] <- hash
                    index.values[slot] <- names.count
                    names.push(name)
                    return (true, names.count - 1)
                return (false, names.count) if current >= names.count
                if index.hashes[slot] == hash:
                    return (false, names.count) if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, names[current], work_limit)
                    return (true, current) if names[current] == name
                slot <- (slot + 1) % index.capacity
                probes <- probes + 1
            work_used <- work_limit + 1
            return (false, names.count)

        def proof_kernel_replay_equality_vertex_index_find(index: ProofKernelReplayEqualityVertexIndex, names: darray[sview]&, name: sview, work_used: mutable usize&, work_limit: usize) -> (complete: bool, found: bool, row: usize):
            return (false, false, names.count) if work_used > work_limit or name == "" or index.capacity == 0 or index.hashes.count != index.capacity or index.values.count != index.capacity
            return (false, false, names.count) if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, name, work_limit)
            hash: u32 = proof_kernel_replay_name_hash(name)
            slot: mutable usize = (hash.i64() % index.capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < index.capacity |probes, slot, hash, index, names, name, work_used, work_limit|:
                return (false, false, names.count) if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                current: usize = index.values[slot]
                return (true, false, names.count) if current == index.capacity
                return (false, false, names.count) if current >= names.count
                if index.hashes[slot] == hash:
                    return (false, false, names.count) if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, names[current], work_limit)
                    return (true, true, current) if names[current] == name
                slot <- (slot + 1) % index.capacity
                probes <- probes + 1
            return (true, false, names.count)

        def proof_kernel_replay_equality_sort_index_add(index: mutable ProofKernelReplayEqualitySortIndex&, name: sview, signed: bool, width: i64, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if name == "" or width <= 0 or index.capacity == 0
            return false if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, name, work_limit)
            hash: u32 = proof_kernel_replay_name_hash(name)
            slot: mutable usize = (hash.i64() % index.capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < index.capacity |slot, probes, index, hash, name, signed, width, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                row: mutable usize = index.slots[slot]
                if row == index.capacity:
                    row <- index.names.count
                    return false if row >= index.capacity or not proof_kernel_replay_equality_closure_charge(work_used, 5, work_limit)
                    index.names.push(name)
                    index.hashes.push(hash)
                    index.signed_widths.push(0)
                    index.unsigned_widths.push(0)
                    index.signed_conflicts.push(false)
                    index.unsigned_conflicts.push(false)
                    index.slots[slot] <- row
                return false if row >= index.names.count or row >= index.hashes.count or row >= index.signed_widths.count or row >= index.unsigned_widths.count or row >= index.signed_conflicts.count or row >= index.unsigned_conflicts.count
                if index.hashes[row] == hash:
                    return false if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, index.names[row], work_limit)
                    if index.names[row] == name:
                        if signed:
                            index.signed_conflicts[row] <- index.signed_conflicts[row] or (index.signed_widths[row] != 0 and index.signed_widths[row] != width)
                            index.signed_widths[row] <- width if index.signed_widths[row] == 0
                        else:
                            index.unsigned_conflicts[row] <- index.unsigned_conflicts[row] or (index.unsigned_widths[row] != 0 and index.unsigned_widths[row] != width)
                            index.unsigned_widths[row] <- width if index.unsigned_widths[row] == 0
                        return true
                slot <- (slot + 1) % index.capacity
                probes <- probes + 1
            work_used <- work_limit + 1
            return false

        def proof_kernel_replay_equality_sort_index_build(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], work_used: mutable usize&, work_limit: usize) -> (complete: bool, index: ProofKernelReplayEqualitySortIndex):
            index: mutable ProofKernelReplayEqualitySortIndex = ProofKernelReplayEqualitySortIndex{names: [], hashes: [], slots: [], signed_widths: [], unsigned_widths: [], signed_conflicts: [], unsigned_conflicts: [], capacity: 0}
            return (false, index) if work_used > work_limit
            relevant: mutable usize = 0
            for fact in facts |fact, nodes, relevant, work_used, work_limit|:
                return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                root: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                continue if root.kind != "call" or root.left >= nodes.count or not proof_kernel_replay_valid(nodes, root.left)
                callee: ElisaProofKernelCore::ProofKernelNode = nodes[root.left]
                continue if callee.kind != "ident"
                return (false, index) if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, callee.name, work_limit)
                relevant <- relevant + 1 if callee.name == "__elisa_signed_type_bound" or callee.name == "__elisa_signed_place_type_bound" or callee.name == "__elisa_unsigned_type_bound"
            return (true, index) if relevant == 0
            return (false, index) if relevant > (work_limit - work_used) / 2
            capacity: mutable usize = 1
            target: usize = relevant * 2
            while capacity < target |capacity, target, work_used, work_limit|:
                return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                capacity <- capacity * 2
            return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, capacity, work_limit)
            index.capacity <- capacity
            index.slots.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity, work_used, work_limit|:
                return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                index.slots[slot] <- capacity
            for fact in facts |fact, nodes, children, index, work_used, work_limit|:
                return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                root: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, sview_len(root.kind), work_limit)
                continue if root.kind != "call" or root.left >= nodes.count
                callee: ElisaProofKernelCore::ProofKernelNode = nodes[root.left]
                continue if not proof_kernel_replay_valid(nodes, root.left)
                return (false, index) if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, callee.name, work_limit)
                continue if callee.kind != "ident"
                if callee.name == "__elisa_signed_type_bound":
                    goal_work: mutable usize = 0
                    marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info_with_goal_work(nodes, children, fact, 0, &goal_work)
                    return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, goal_work, work_limit)
                    if marker.known and marker.name_root < nodes.count:
                        if nodes[marker.name_root].kind == "ident":
                            return (false, index) if not proof_kernel_replay_equality_sort_index_add(&index, nodes[marker.name_root].name, true, marker.width, work_used, work_limit)
                elif callee.name == "__elisa_signed_place_type_bound":
                    goal_work: mutable usize = 0
                    marker: (known: bool, term: usize, width: i64) = proof_kernel_replay_signed_place_marker_info_with_goal_work(nodes, children, fact, 0, &goal_work)
                    return (false, index) if not proof_kernel_replay_equality_closure_charge(work_used, goal_work, work_limit)
                    if marker.known and marker.term < nodes.count:
                        if nodes[marker.term].kind == "ident":
                            return (false, index) if not proof_kernel_replay_equality_sort_index_add(&index, nodes[marker.term].name, true, marker.width, work_used, work_limit)
                elif callee.name == "__elisa_unsigned_type_bound":
                    marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info_with_work(nodes, children, fact, 0, work_used, work_limit)
                    return (false, index) if work_used > work_limit
                    if marker.known and marker.name_root < nodes.count:
                        if nodes[marker.name_root].kind == "ident":
                            return (false, index) if not proof_kernel_replay_equality_sort_index_add(&index, nodes[marker.name_root].name, false, marker.width, work_used, work_limit)
            return (true, index)

        def proof_kernel_replay_equality_sort_index_lookup(index: ProofKernelReplayEqualitySortIndex&, name: sview, work_used: mutable usize&, work_limit: usize) -> i64:
            return 0 if name == "" or index.capacity == 0
            return 0 if index.slots.count != index.capacity or index.names.count != index.hashes.count or index.names.count != index.signed_widths.count or index.names.count != index.unsigned_widths.count or index.names.count != index.signed_conflicts.count or index.names.count != index.unsigned_conflicts.count
            return 0 if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, name, work_limit)
            hash: u32 = proof_kernel_replay_name_hash(name)
            slot: mutable usize = (hash.i64() % index.capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < index.capacity |slot, probes, index, hash, name, work_used, work_limit|:
                return 0 if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                row: usize = index.slots[slot]
                return 0 if row == index.capacity or row >= index.names.count
                if index.hashes[row] == hash:
                    return 0 if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, index.names[row], work_limit)
                    if index.names[row] == name:
                        return index.signed_widths[row] if index.signed_widths[row] > 0 and index.unsigned_widths[row] == 0 and not index.signed_conflicts[row]
                        return 0 - index.unsigned_widths[row] if index.unsigned_widths[row] > 0 and index.signed_widths[row] == 0 and not index.unsigned_conflicts[row]
                        return 0
                slot <- (slot + 1) % index.capacity
                probes <- probes + 1
            work_used <- work_limit + 1
            return 0
