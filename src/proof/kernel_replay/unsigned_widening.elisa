extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_bounded_u8_receiver(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize]) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            expression: mutable usize = root
            expression <- nodes[root].left if nodes[root].kind == "paren"
            return false if not proof_kernel_replay_valid(nodes, expression)
            node = nodes[expression]
            return false if node.kind != "binary" or node.operator != "+" or not proof_kernel_replay_arena_shape_valid(node)
            return false if not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
            base = nodes[node.left]
            literal = nodes[node.right]
            return false if base.kind != "ident" and base.kind != "field" and base.kind != "tuple"
            return false if literal.kind != "int" or literal.value < 0 or literal.value > 255
            return false if proof_kernel_replay_signed_width_in_expression(nodes, children, facts, node.left, 0) == 0
            return false if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, node.left, 0)
            return false if not proof_kernel_replay_signed_expression_safe(nodes, children, expression, facts)
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |nodes, children, facts, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            interval = proof_kernel_replay_interval(nodes, children, expression, bounds, 0)
            return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= 255

        def proof_kernel_replay_unsigned_widening_receiver(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize]) -> usize:
            return root if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return root if node.kind != "call" or not proof_kernel_replay_arena_shape_valid(node) or node.children_count != 0 or node.operator != "" or node.auxiliary != 0 or node.value != 0 or node.name != "" or node.secondary_name != ""
            return root if not proof_kernel_replay_valid(nodes, node.left)
            callee: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            return root if callee.kind != "field" or not proof_kernel_replay_arena_shape_valid(callee)
            target: i64 = 8 if callee.name == "u8" else 16 if callee.name == "u16" else 32 if callee.name == "u32" else 64 if callee.name == "u64" else 0
            return root if not proof_kernel_replay_valid(nodes, callee.left)
            receiver: ElisaProofKernelCore::ProofKernelNode = nodes[callee.left]
            if callee.name == "u8" and proof_kernel_replay_bounded_u8_receiver(nodes, children, callee.left, facts):
                return receiver.left if receiver.kind == "paren" else callee.left
            return root if receiver.kind != "ident" and receiver.kind != "field" and receiver.kind != "index" and receiver.kind != "index-n"
            source: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, callee.left, facts, 0)
            return root if target == 0 or source == 0 or source > target
            return root if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, callee.left, 0)
            return callee.left

        def proof_kernel_replay_unsigned_widening_comparison(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> usize:
            return root if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            comparison: bool = node.operator == "==" or node.operator == "!=" or node.operator == "<" or node.operator == "<=" or node.operator == ">" or node.operator == ">="
            return root if node.kind != "binary" or not comparison or not proof_kernel_replay_arena_shape_valid(node)
            return root if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0)
            first: usize = proof_kernel_replay_unsigned_widening_receiver(nodes, children, node.left, facts)
            second: usize = proof_kernel_replay_unsigned_widening_receiver(nodes, children, node.right, facts)
            return root if first == node.left and second == node.right
            return ElisaProofKernelCore::add_node(nodes, "binary", node.operator, first, second, 0, 0, 0, 0, "", "")
