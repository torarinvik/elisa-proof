extend ElisaProofKernelReplay:
    private:
        # Linear arithmetic shares one lazy width index across all recursive term queries.
        # Literal and place queries avoid constructing it when no identifier width is needed.
        def proof_kernel_replay_linear_unsigned_width_query_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], markers: darray[ProofKernelReplayWitnessMarker], width_index: mutable ProofKernelReplayLinearUnsignedWidthIndex&, index_ready: mutable bool&, work_used: mutable usize&, depth: usize) -> i64:
            can Abort.Panic:
                requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
                return 0 if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                if node.kind == "typed-int":
                    literal = ElisaProofKernelCore::typed_literal_value(node)
                    return literal.width if literal.known and literal.unsigned
                if node.kind == "ident":
                    if not proof_kernel_replay_goal_bool_ref_value(index_ready):
                        indexed: (complete: bool, index: ProofKernelReplayLinearUnsignedWidthIndex) = proof_kernel_replay_linear_unsigned_width_index_build(markers, work_used)
                        if not indexed.complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                            work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                            return 0
                        width_index <- indexed.index
                        index_ready <- true
                    return proof_kernel_replay_linear_unsigned_width_index_lookup(width_index, node.name, work_used)
                if node.kind == "field":
                    return proof_kernel_replay_linear_place_marker_width_with_work(nodes, children, facts, root, work_used)
                if node.kind in {"index", "index-n"}:
                    return proof_kernel_replay_linear_element_width_with_work(nodes, children, facts, root, work_used)
                if node.kind == "unary":
                    return 0 if node.operator != "+" and node.operator != "-"
                    return proof_kernel_replay_linear_unsigned_width_query_with_work(nodes, children, node.left, facts, markers, width_index, index_ready, work_used, depth + 1)
                if node.kind == "binary":
                    return 0 if not proof_kernel_replay_integer_arithmetic_operator(node.operator)
                    left_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_work(nodes, children, node.left, facts, markers, width_index, index_ready, work_used, depth + 1)
                    right_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_work(nodes, children, node.right, facts, markers, width_index, index_ready, work_used, depth + 1)
                    return right_width if left_width == 0
                    return left_width if right_width == 0 or left_width < right_width
                    return right_width
                if node.kind == "if":
                    then_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_work(nodes, children, node.right, facts, markers, width_index, index_ready, work_used, depth + 1)
                    else_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_work(nodes, children, node.auxiliary, facts, markers, width_index, index_ready, work_used, depth + 1)
                    return 0 if then_width == 0 or else_width == 0
                    return then_width if then_width < else_width
                    return else_width
                0

        # Fixed-width safety callers share both the marker snapshot and its lazy width index
        # across recursive expressions and premise roots.
        def proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, width_index: mutable ProofKernelReplayLinearUnsignedWidthIndex&, index_ready: mutable bool&, work_used: mutable usize&, depth: usize) -> i64:
            can Abort.Panic:
                requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
                return 0 if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                if node.kind == "typed-int":
                    literal = ElisaProofKernelCore::typed_literal_value(node)
                    return literal.width if literal.known and literal.unsigned
                if node.kind == "ident":
                    if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                        cache_complete: bool = proof_kernel_replay_unsigned_width_marker_snapshot_with_goal_work(nodes, children, facts, markers, work_used)
                        if not cache_complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                            work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                            return 0
                        markers_ready <- true
                    if not proof_kernel_replay_goal_bool_ref_value(index_ready):
                        indexed: (complete: bool, index: ProofKernelReplayLinearUnsignedWidthIndex) = proof_kernel_replay_linear_unsigned_width_index_build(markers, work_used)
                        if not indexed.complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                            work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                            return 0
                        width_index <- indexed.index
                        index_ready <- true
                    return proof_kernel_replay_linear_unsigned_width_index_lookup(width_index, node.name, work_used)
                if node.kind == "field":
                    return proof_kernel_replay_linear_place_marker_width_with_work(nodes, children, facts, root, work_used)
                if node.kind in {"index", "index-n"}:
                    return proof_kernel_replay_linear_element_width_with_work(nodes, children, facts, root, work_used)
                if node.kind == "unary":
                    return 0 if node.operator != "+" and node.operator != "-"
                    return proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, node.left, facts, markers, markers_ready, width_index, index_ready, work_used, depth + 1)
                if node.kind == "binary":
                    return 0 if not proof_kernel_replay_integer_arithmetic_operator(node.operator)
                    left_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, node.left, facts, markers, markers_ready, width_index, index_ready, work_used, depth + 1)
                    right_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, node.right, facts, markers, markers_ready, width_index, index_ready, work_used, depth + 1)
                    return right_width if left_width == 0
                    return left_width if right_width == 0 or left_width < right_width
                    return right_width
                if node.kind == "if":
                    then_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, node.right, facts, markers, markers_ready, width_index, index_ready, work_used, depth + 1)
                    else_width: i64 = proof_kernel_replay_linear_unsigned_width_query_with_cached_markers_and_work(nodes, children, node.auxiliary, facts, markers, markers_ready, width_index, index_ready, work_used, depth + 1)
                    return 0 if then_width == 0 or else_width == 0
                    return then_width if then_width < else_width
                    return else_width
                0
