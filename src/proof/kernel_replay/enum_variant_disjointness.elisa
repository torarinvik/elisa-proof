# A qualified `is` test is an enum-tag atom in the source-neutral kernel language. Tags with the
# same scrutinee and exact owner path are disjoint when their terminal variant names differ.
# Proposition formation separately rejects invalid owner/member paths; this logical rule itself
# depends only on the canonical tag-atom shape and is therefore available to every replay entry.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_enum_variant_tag_pair_disjoint(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, fact_root: usize, target_root: usize) -> bool:
            return false if fact_root >= nodes.count or target_root >= nodes.count
            fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
            target: ElisaProofKernelCore::ProofKernelNode = nodes[target_root]
            return false if fact.kind != "binary" or fact.operator != "is" or target.kind != "binary" or target.operator != "is"
            return false if not proof_kernel_replay_expr_equal(nodes, children, fact.left, target.left, 0)
            return false if fact.right >= nodes.count or target.right >= nodes.count
            fact_variant: ElisaProofKernelCore::ProofKernelNode = nodes[fact.right]
            target_variant: ElisaProofKernelCore::ProofKernelNode = nodes[target.right]
            return false if (fact_variant.kind != "field" and fact_variant.kind != "scope") or (target_variant.kind != "field" and target_variant.kind != "scope")
            return false if fact_variant.name == target_variant.name or fact_variant.left >= nodes.count or target_variant.left >= nodes.count
            return proof_kernel_replay_expr_equal(nodes, children, fact_variant.left, target_variant.left, 0)

        def proof_kernel_replay_enum_variant_disjoint_in_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, fact_root: usize, target_root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or fact_root >= nodes.count
            fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
            if fact.kind == "paren":
                return proof_kernel_replay_enum_variant_disjoint_in_fact(nodes, children, fact.left, target_root, depth + 1)
            if fact.kind == "binary" and fact.operator == "and":
                return proof_kernel_replay_enum_variant_disjoint_in_fact(nodes, children, fact.left, target_root, depth + 1) or proof_kernel_replay_enum_variant_disjoint_in_fact(nodes, children, fact.right, target_root, depth + 1)
            return proof_kernel_replay_enum_variant_tag_pair_disjoint(nodes, children, fact_root, target_root)

    private:
        def proof_kernel_replay_enum_variant_disjoint_from_facts(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> bool:
            return false if goal_root >= nodes.count or facts.count > PROOF_KERNEL_REPLAY_WORK_BUDGET
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "unary" or goal.operator != "not" or goal.left >= nodes.count
            target: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            return false if target.kind != "binary" or target.operator != "is"
            for fact_root in facts |nodes, children, fact_root, target|:
                return true if proof_kernel_replay_enum_variant_disjoint_in_fact(nodes, children, fact_root, goal.left, 0)
            return false
