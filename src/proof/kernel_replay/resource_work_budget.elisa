extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET + ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET * 4

        def proof_kernel_replay_resource_charge_work_used(work_used: mutable usize&, amount: usize) -> bool:
            if work_used > PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT:
                return false
            if amount > PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT - work_used:
                # Keep exhaustion distinguishable from a successful charge that exactly
                # reaches the limit. Predicates may interpret a failed comparison as
                # "disjoint"; the sticky sentinel lets the report boundary still reject it.
                work_used <- PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT + 1
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_replay_resource_charge_work(state: mutable ProofKernelReplayResourceState&, amount: usize) -> bool:
            proof_kernel_replay_resource_charge_work_used(&state.resource_work_used, amount)

        def proof_kernel_replay_resource_charge_text_pair_used(work_used: mutable usize&, left: sview, right: sview) -> bool:
            return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
            return false if not proof_kernel_replay_resource_charge_work_used(work_used, sview_len(left))
            proof_kernel_replay_resource_charge_work_used(work_used, sview_len(right))

        def proof_kernel_replay_resource_charge_text_pair(state: mutable ProofKernelReplayResourceState&, left: sview, right: sview) -> bool:
            proof_kernel_replay_resource_charge_text_pair_used(&state.resource_work_used, left, right)

        def proof_kernel_replay_resource_charge_node_text_used(work_used: mutable usize&, node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
            return false if not proof_kernel_replay_resource_charge_work_used(work_used, sview_len(node.kind))
            return false if not proof_kernel_replay_resource_charge_work_used(work_used, sview_len(node.name))
            return false if not proof_kernel_replay_resource_charge_work_used(work_used, sview_len(node.secondary_name))
            proof_kernel_replay_resource_charge_work_used(work_used, sview_len(node.operator))

        def proof_kernel_replay_resource_charge_node_text(state: mutable ProofKernelReplayResourceState&, node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            proof_kernel_replay_resource_charge_node_text_used(&state.resource_work_used, node)

        def proof_kernel_replay_resource_empty() -> ProofKernelReplayResourceState:
            return ProofKernelReplayResourceState{binding_names: [], formal_names: [], binding_scope_depth: [], scope_depth: 0, binding_reference: [], binding_mutable_reference: [], binding_writable: [], binding_borrowable: [], binding_moved: [], binding_region: [], binding_region_live: [], binding_region_owner: [], active_regions: [], protected_regions: [], external_regions: [], region_wide_borrows: [], borrow_target_slots: [], borrow_target_places: [], borrow_mutable: [], borrow_present: [], disjoint_left: [], disjoint_right: [], resource_call_events: [], resource_call_allocations: [], resource_call_allocations_used: [], resource_call_results: [], resource_return_alloc_regions: [], resource_return_witnesses: [], resource_return_witnesses_used: [], pending_join_moves: [], binding_origin_places: [], resource_work_used: 0, goal_work_used: 0}
