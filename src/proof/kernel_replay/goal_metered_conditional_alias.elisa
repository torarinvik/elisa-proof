extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_conditional_alias_goal_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires remaining > 1
            decreases remaining
            alias: (known: bool, index: usize, condition: usize, then_fact: usize, else_fact: usize, then_refuted: bool, else_refuted: bool) = proof_kernel_replay_conditional_alias_plan_with_goal_work(nodes, children, facts, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not alias.known or alias.index >= facts.count
            return false if not proof_kernel_replay_goal_search_charge_product(work_used, facts.count, 2)
            return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 4)
            then_facts: mutable darray[usize] = []
            else_facts: mutable darray[usize] = []
            then_facts.extend(facts)
            else_facts.extend(facts)
            then_facts[alias.index] <- alias.then_fact
            else_facts[alias.index] <- alias.else_fact
            then_facts.push(alias.condition)
            return false if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "unary", "not")
            negated: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", alias.condition, 0, 0, 0, 0, 0, "", "")
            return false if negated >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            else_facts.push(negated)
            return true if (alias.then_refuted or (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, then_facts, goal_root, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})) and (alias.else_refuted or (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, else_facts, goal_root, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}))
            false

        def proof_kernel_replay_conditional_comparison_goal_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires remaining > 1
            decreases remaining
            conditional: (known: bool, condition: usize, then_goal: usize, else_goal: usize, then_refuted: bool, else_refuted: bool) = proof_kernel_replay_conditional_comparison_plan_with_goal_work(nodes, children, facts, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not conditional.known
            return false if not proof_kernel_replay_goal_search_charge_product(work_used, facts.count, 2)
            return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
            then_facts: mutable darray[usize] = []
            else_facts: mutable darray[usize] = []
            then_facts.extend(facts)
            else_facts.extend(facts)
            then_facts.push(conditional.condition)
            return false if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "unary", "not")
            negated: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", conditional.condition, 0, 0, 0, 0, 0, "", "")
            return false if negated >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            else_facts.push(negated)
            return true if (conditional.then_refuted or (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, then_facts, conditional.then_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})) and (conditional.else_refuted or (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, else_facts, conditional.else_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}))
            false
