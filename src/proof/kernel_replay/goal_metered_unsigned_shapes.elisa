extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_span_descent_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            strict_less: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "<", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_goal or not strict_less
                goal.left >= nodes.count or goal.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            low: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            high: ElisaProofKernelCore::ProofKernelNode = nodes[goal.right]
            low_binary: bool = proof_kernel_replay_goal_search_text_equal(low.kind, "binary", work_used)
            high_binary: bool = proof_kernel_replay_goal_search_text_equal(high.kind, "binary", work_used)
            low_subtract: bool = proof_kernel_replay_goal_search_text_equal(low.operator, "-", work_used)
            high_subtract: bool = proof_kernel_replay_goal_search_text_equal(high.operator, "-", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not low_binary or not high_binary or not low_subtract or not high_subtract
            end: usize = low.left
            next: usize = low.right
            start: usize = high.right
            return false if:
                end >= nodes.count or next >= nodes.count or start >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, end, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, next, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, start, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, end) or not proof_kernel_replay_valid(nodes, next) or not proof_kernel_replay_valid(nodes, start)
            next_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[next].kind, "ident", work_used)
            start_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[start].kind, "ident", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not next_ident or not start_ident
            same_end: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, end, high.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_end
            width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, start, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            next_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, next, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or next_width != width
            end_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[end].kind, "ident", work_used)
            end_int: bool = proof_kernel_replay_goal_search_text_equal(nodes[end].kind, "int", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if end_ident:
                end_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, end, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or end_width != width
            else:
                return false if not end_int
                value: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, end, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not value.known or value.value < 0 or value.value > 255
            has_order: bool = proof_kernel_replay_has_order_fact_with_work(nodes, children, start, end, true, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not has_order
            for fact in facts |fact, nodes, children, next, start, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_valid(nodes, fact)
                fact_node: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                equality_kind: bool = proof_kernel_replay_goal_search_text_equal(fact_node.kind, "binary", work_used)
                equality_operator: bool = proof_kernel_replay_goal_search_text_equal(fact_node.operator, "==", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not equality_kind or not equality_operator or fact_node.left >= nodes.count or fact_node.right >= nodes.count
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_node.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_node.right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                left_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact_node.left, next, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact_node.right, next, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                term: mutable usize = fact_node.right if left_matches else nodes.count
                term <- fact_node.left if right_matches
                continue if term >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, term, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, term)
                sum_binary: bool = proof_kernel_replay_goal_search_text_equal(nodes[term].kind, "binary", work_used)
                sum_add: bool = proof_kernel_replay_goal_search_text_equal(nodes[term].operator, "+", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not sum_binary or not sum_add
                shifted: (known: bool, base: usize) = proof_kernel_replay_unsigned_unit_increment_base_with_work(nodes, nodes[term].left, nodes[term].right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not shifted.known
                same_start: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, shifted.base, start, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if same_start
            false

        def proof_kernel_replay_unsigned_subtraction_upper_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "<=", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_goal or not less_equal or goal.left >= nodes.count or goal.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            difference: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            difference_binary: bool = proof_kernel_replay_goal_search_text_equal(difference.kind, "binary", work_used)
            difference_subtract: bool = proof_kernel_replay_goal_search_text_equal(difference.operator, "-", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not difference_binary or not difference_subtract or difference.left >= nodes.count or difference.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, difference.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, difference.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, difference.left) or not proof_kernel_replay_valid(nodes, difference.right)
            left_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[difference.left].kind, "ident", work_used)
            right_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[difference.right].kind, "ident", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_ident or not right_ident
            same_upper: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, difference.left, goal.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_upper
            left_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, difference.left, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_width == 0
            right_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, difference.right, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_width != left_width
            proof_kernel_replay_has_order_fact_with_work(nodes, children, difference.right, difference.left, false, facts, work_used)

        def proof_kernel_replay_unsigned_remainder_upper_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, operator: sview, right: usize, work_used: mutable usize&) -> bool:
            is_less: bool = proof_kernel_replay_goal_search_text_equal(operator, "<", work_used)
            is_less_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, "<=", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not is_less and not is_less_equal
                left >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, left, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, left)
            remainder: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, left)
            return false if not remainder.known
            binary_remainder: bool = proof_kernel_replay_goal_search_text_equal(remainder.node.kind, "binary", work_used)
            modulo: bool = proof_kernel_replay_goal_search_text_equal(remainder.node.operator, "%", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_remainder or not modulo
            divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, remainder.node.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not divisor.known or divisor.value <= 0
            width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, left, facts, work_used, 0)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width <= 0
                not proof_kernel_replay_constant_fits_unsigned_with_goal_work(nodes, remainder.node.right, width, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or divisor.value > proof_kernel_replay_unsigned_width_max(width)
            if is_less:
                same_divisor: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, remainder.node.right, right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_divisor
            else:
                bound: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                predecessor: ProofKernelReplayInt = proof_kernel_replay_sub_safe(divisor.value, 1)
                return false if not bound.known or not predecessor.known or bound.value != predecessor.value
            safe: bool = proof_kernel_replay_unsigned_goal_safe_with_goal_work(nodes, children, facts, left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            safe

        def proof_kernel_replay_unsigned_unit_increment_order_shape_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "<=", work_used)
            greater_equal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, ">=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_goal or (not less_equal and not greater_equal)
            increment: usize = goal.left if greater_equal else goal.right
            base: usize = goal.right if greater_equal else goal.left
            shifted: (known: bool, base: usize) = proof_kernel_replay_shifted_unit_base_with_work(nodes, increment, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not shifted.known
                not proof_kernel_replay_goal_search_charge_node_text(nodes, shifted.base, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, base, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            same_base: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, shifted.base, base, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_base
            increment_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, increment, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or increment_width == 0
            base_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, base, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or base_width != increment_width
            safe: bool = proof_kernel_replay_unsigned_goal_safe_with_goal_work(nodes, children, facts, increment, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            safe

        def proof_kernel_replay_false_integer_disequality_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            binary: bool = proof_kernel_replay_goal_search_text_equal(nodes[root].kind, "binary", work_used)
            disequality: bool = proof_kernel_replay_goal_search_text_equal(nodes[root].operator, "!=", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary or not disequality
                nodes[root].left >= nodes.count or nodes[root].right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, nodes[root].left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, nodes[root].right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, nodes[root].left) or not proof_kernel_replay_valid(nodes, nodes[root].right)
            left_int: bool = proof_kernel_replay_goal_search_text_equal(nodes[nodes[root].left].kind, "int", work_used)
            right_int: bool = proof_kernel_replay_goal_search_text_equal(nodes[nodes[root].right].kind, "int", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left_int and right_int and nodes[nodes[root].left].value == nodes[nodes[root].right].value

        def proof_kernel_replay_unsigned_simple_shapes_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return true if proof_kernel_replay_unsigned_span_descent_with_work(nodes, children, facts, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proof_kernel_replay_unsigned_subtraction_upper_with_work(nodes, children, facts, root, work_used)
