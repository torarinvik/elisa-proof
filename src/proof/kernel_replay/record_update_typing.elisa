# Record-update typing is kept separate from general term-sort inference because each updated
# field must be checked against the exact named receiver type before the update retains that type.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_record_update_field_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, update: ElisaProofKernelCore::ProofKernelNode, base: ProofKernelInferredSort, offset: usize, depth: usize, work: mutable usize&) -> bool:
            requires depth <= 127
            decreases 128 - depth
            return false if depth >= 127
            return false if not proof_kernel_replay_type_work_consume(work)
            field_root: usize = proof_kernel_replay_child_root(children, update, offset)
            return false if field_root >= nodes.count or nodes[field_root].kind != "field-init"
            field: ElisaProofKernelCore::ProofKernelNode = nodes[field_root]
            declared: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "field", field.name, base.name, base.type_identity, work)
            return false if not declared.known
            actual: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, field.left, depth + 1, work)
            return false if not proof_kernel_replay_sort_equal(actual, proof_kernel_replay_binding_sort(declared.binding))
            for prior_offset in 0..<offset |prior_offset, children, nodes, update, field, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                prior_root: usize = proof_kernel_replay_child_root(children, update, prior_offset)
                return false if prior_root >= nodes.count or nodes[prior_root].kind != "field-init"
                return false if nodes[prior_root].name == field.name
            return true
