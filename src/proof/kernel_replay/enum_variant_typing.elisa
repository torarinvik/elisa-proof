# Enum values are typed by declaration identity, not just their repeated variant spelling.
extend ElisaProofKernelReplay:
    private:
        # The source adapter records an underlying scalar only for a const enum and ties it to
        # the enum's exact declaration identity. Reject duplicate rows, even identical ones, so a
        # replay package cannot add or shadow an enum representation claim.
        def proof_kernel_replay_const_enum_underlying_sort(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, expected: ProofKernelInferredSort, work: mutable usize&) -> ProofKernelInferredSort:
            return proof_kernel_replay_unknown_sort() if not expected.known or expected.family != "named" or expected.name == "" or expected.type_identity == 0
            found: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            for index in 0..<proof_kernel_replay_type_environment_binding_count(environment) |index, environment, expected, found, selected, work|:
                return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if binding.kind != "enum-underlying" or not proof_kernel_replay_type_text_equal(binding.owner, expected.name, work) or not proof_kernel_replay_type_text_equal(binding.name, expected.name, work) or binding.owner_type_identity != expected.type_identity
                return proof_kernel_replay_unknown_sort() if found
                selected <- binding
                found <- true
            return proof_kernel_replay_known_sort(selected.sort, selected.type_name) if found
            return proof_kernel_replay_unknown_sort()

        # The compiler cast-hook table includes nested-module functions and checks exact
        # source/return types without owner filtering. Any exact hook may therefore win.
        # Incomplete __cast__ metadata also refuses admission rather than assuming a builtin.
        def proof_kernel_replay_builtin_cast_dispatch_absent(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, source: ProofKernelInferredSort, target: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if not source.known or not target.known
            for index in 0..<proof_kernel_replay_type_environment_binding_count(environment) |index, environment, source, target, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                hook: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                if hook.kind == "function-incomplete":
                    return false if:
                        not proof_kernel_replay_type_work_consume_amount(sview_len(hook.name), work)
                        hook.name == "__cast__"
                    continue
                continue if hook.kind != "function"
                return false if not proof_kernel_replay_type_work_consume_amount(sview_len(hook.name), work)
                continue if hook.name != "__cast__" or hook.parameter_count != 1 or not proof_kernel_replay_type_text_equal(hook.sort, target.family, work) or not proof_kernel_replay_type_text_equal(hook.type_name, target.name, work) or hook.type_identity != target.type_identity
                parameter: (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_function_parameter_by_index(environment, typing_index, hook, 0, work)
                return false if not parameter.known
                matched_source: bool = proof_kernel_replay_type_text_equal(parameter.parameter.sort, source.family, work) and proof_kernel_replay_type_text_equal(parameter.parameter.type_name, source.name, work) and parameter.parameter.type_identity == source.type_identity
                return false if matched_source
            return true

        def proof_kernel_replay_enum_member_sort(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, name: sview, work: mutable usize&) -> ProofKernelInferredSort:
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, name, found, ambiguous, selected, work|:
                return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if binding.kind != "enum-member" or not proof_kernel_replay_type_text_equal(binding.name, name, work)
                if not found:
                    selected <- binding
                    found <- true
                elif not proof_kernel_replay_type_text_equal(selected.owner, binding.owner, work) or selected.owner_type_identity != binding.owner_type_identity or selected.type_identity != binding.type_identity:
                    ambiguous <- true
            return proof_kernel_replay_binding_sort(selected) if found and not ambiguous
            return proof_kernel_replay_unknown_sort()

        # A bare `.Variant` can occur in several enums. Its owner must be supplied by a typed
        # counterpart, then checked against the environment's exact enum declaration identity.
        def proof_kernel_replay_enum_member_sort_for_type(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, name: sview, expected: ProofKernelInferredSort, work: mutable usize&) -> ProofKernelInferredSort:
            return proof_kernel_replay_unknown_sort() if not expected.known or expected.family != "named" or expected.name == "" or expected.type_identity == 0
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, name, expected, found, ambiguous, selected, work|:
                return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if binding.kind != "enum-member" or not proof_kernel_replay_type_text_equal(binding.name, name, work)
                continue if not proof_kernel_replay_type_text_equal(binding.owner, expected.name, work) or binding.type_identity != expected.type_identity or binding.owner_type_identity != expected.type_identity
                if found:
                    ambiguous <- true if not proof_kernel_replay_typing_evidence_equal(selected, binding, work)
                else:
                    selected <- binding
                    found <- true
            return proof_kernel_replay_binding_sort(selected) if found and not ambiguous
            return proof_kernel_replay_unknown_sort()

        def proof_kernel_replay_enum_type_path(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, path: mutable darray[sview]&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_type_work_consume(work)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident":
                return false if node.name == ""
                path.push(node.name)
                return true
            if node.kind == "scope":
                return false if node.name == "" or not proof_kernel_replay_enum_type_path(nodes, node.left, path, depth + 1, work)
                path.push(node.name)
                return true
            if node.kind == "paren":
                return proof_kernel_replay_enum_type_path(nodes, node.left, path, depth + 1, work)
            return false

        def proof_kernel_replay_enum_scope_binding_matches(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, start_index: usize, type_identity: usize, owner: sview, path: darray[sview]&, context_start: usize, context_count: usize, context_seen: bool, work: mutable usize&) -> bool:
            return false if type_identity == 0 or sview_len(owner) == 0 or path.count == 0 or path.count > 128
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return false if start_index == 0 or start_index >= total_bindings
            first: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, start_index)
            candidate_count: usize = first.parameter_count
            return false if candidate_count == 0 or candidate_count > 128 or candidate_count > total_bindings - start_index
            for segment in 0..<candidate_count |segment, environment, start_index, type_identity, owner, candidate_count, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, start_index + segment)
                return false if:
                    binding.kind != "enum-scope-segment" or binding.type_identity != type_identity or not proof_kernel_replay_type_text_equal(binding.owner, owner, work) or binding.parameter_count != candidate_count or binding.parameter_index != segment
                    segment + 1 == candidate_count and not proof_kernel_replay_type_text_equal(binding.name, owner, work)
            if candidate_count == path.count:
                for segment in 0..<path.count |segment, environment, start_index, candidate_count, path, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, start_index + segment)
                    return false if not proof_kernel_replay_type_text_equal(binding.name, path[segment], work)
                return true
            return false if candidate_count < path.count or not context_seen
            ancestor_depth: usize = candidate_count - path.count
            return false if ancestor_depth == 0 or ancestor_depth > context_count
            for segment in 0..<ancestor_depth |segment, environment, start_index, candidate_count, context_start, context_count, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                actual_binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, start_index + segment)
                actual: sview = actual_binding.name
                expected: sview = proof_kernel_replay_type_scope_owner_path_segment(environment, context_start, segment, context_count, work)
                return false if sview_len(actual) == 0 or sview_len(expected) == 0 or not proof_kernel_replay_type_text_equal(actual, expected, work)
            for segment in 0..<path.count |segment, environment, start_index, ancestor_depth, candidate_count, path, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, start_index + ancestor_depth + segment)
                return false if not proof_kernel_replay_type_text_equal(binding.name, path[segment], work)
            return true

        def proof_kernel_replay_enum_type_sort_for_path(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, path: darray[sview]&, work: mutable usize&) -> ProofKernelInferredSort:
            return proof_kernel_replay_unknown_sort() if path.count == 0 or path.count > 128
            context_identity: mutable usize = 0
            context_seen: mutable bool = false
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, context_identity, context_seen, work|:
                return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                context: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if context.kind != "module-context"
                return proof_kernel_replay_unknown_sort() if context_seen or not proof_kernel_replay_owner_identity_recorded(environment, context.owner_type_identity, work)
                context_identity <- context.owner_type_identity
                context_seen <- true
            context_start: mutable usize = 0
            context_count: mutable usize = 0
            if context_seen:
                context_path: (known: bool, start_index: usize, path_count: usize) = proof_kernel_replay_type_scope_owner_path_start(environment, context_identity, work)
                return proof_kernel_replay_unknown_sort() if not context_path.known
                context_start <- context_path.start_index
                context_count <- context_path.path_count
            found_identity: mutable usize = 0
            found_name: mutable sview = ""
            selected_depth: mutable usize = 0
            ambiguous: mutable bool = false
            for binding_index in 0..<total_bindings |binding_index, environment, path, context_start, context_count, context_seen, work, found_identity, found_name, selected_depth, ambiguous|:
                return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                continue if binding.kind != "enum-scope-segment" or binding.parameter_index != 0
                continue if not proof_kernel_replay_enum_scope_binding_matches(environment, binding_index, binding.type_identity, binding.owner, path, context_start, context_count, context_seen, work)
                if found_identity == 0 or binding.parameter_count > selected_depth:
                    found_identity <- binding.type_identity
                    found_name <- binding.owner
                    selected_depth <- binding.parameter_count
                    ambiguous <- false
                elif binding.parameter_count == selected_depth and (found_identity != binding.type_identity or not proof_kernel_replay_type_text_equal(found_name, binding.owner, work)):
                    ambiguous <- true
            return proof_kernel_replay_identity_sort("named", found_name, found_identity) if found_identity != 0 and not ambiguous
            return proof_kernel_replay_unknown_sort()

        # Preserve an enum type's full qualified path in the term, resolve it in the current
        # module context, and require the terminal member and owner identities to agree. A
        # recognized but missing member remains an unknown term.
        def proof_kernel_replay_qualified_enum_member_sort(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, root: usize, work: mutable usize&) -> (is_enum_path: bool, sort: ProofKernelInferredSort):
            unknown: ProofKernelInferredSort = proof_kernel_replay_unknown_sort()
            return (false, unknown) if root >= nodes.count
            member: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, unknown) if:
                member.kind != "scope" and member.kind != "field"
                member.name == "" or member.left >= nodes.count
            owner_path: mutable darray[sview] = []
            if proof_kernel_replay_enum_type_path(nodes, member.left, &owner_path, 0, work):
                if member.kind == "field" and owner_path.count == 1:
                    shadowing_value: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_value_binding(environment, typing_index, owner_path[0], work)
                    # `E.V` is a field expression when a visible local E shadows enum E.
                    # Check before both enum-resolution paths so fallback cannot bypass it.
                    # An ambiguous lookup can also carry a candidate with known=false.
                    return (false, unknown) if shadowing_value.known or shadowing_value.binding.name != ""
                resolved_owner: ProofKernelInferredSort = proof_kernel_replay_enum_type_sort_for_path(environment, owner_path, work)
                if resolved_owner.known:
                    return (true, proof_kernel_replay_enum_member_sort_for_type(environment, member.name, resolved_owner, work))
                # A qualified declaration path must never fall back to its leaf type name.
                # Otherwise Wrong::Option.Some could borrow the identity of a unique Option
                # declaration when the exact Wrong::Option owner is absent or inconsistent.
                return (true, unknown) if owner_path.count > 1
            owner_name: sview = proof_kernel_replay_symbol_name(nodes, member.left, 0, work)
            return (false, unknown) if owner_name == ""
            owner: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "type", owner_name, "", 0, work)
            return (false, unknown) if not owner.known or owner.binding.sort != "named" or owner.binding.type_identity == 0
            expected: ProofKernelInferredSort = proof_kernel_replay_binding_sort(owner.binding)
            return (true, proof_kernel_replay_enum_member_sort_for_type(environment, member.name, expected, work))
