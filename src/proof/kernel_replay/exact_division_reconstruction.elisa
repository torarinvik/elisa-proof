# Independent replay for the exact quotient identity. The rule accepts only a matching
# multiplication/division shape, a source fact that the matching remainder is zero, and a
# positively proved same-width divisor. In particular it does not identify quotient bounds with
# quotient reconstruction, or silently treat zero/negative divisors as safe.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_exact_division_reconstruction_goal_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            return false if:
                remaining <= 1 or split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, goal_root)
            root: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, goal_root, work_used, 0)
            return false if:
                root >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                nodes[root].kind != "binary" or nodes[root].operator != "=="
            return true if (proof_kernel_replay_exact_division_match_product(nodes, children, facts, nodes[root].left, nodes[root].right, split_depth, depth, work_used, remaining - 1) can Global{Read,Write})
            (proof_kernel_replay_exact_division_match_product(nodes, children, facts, nodes[root].right, nodes[root].left, split_depth, depth, work_used, remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_exact_division_match_product(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], product_root: usize, dividend_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            product: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, product_root, work_used, 0)
            dividend: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, dividend_root, work_used, 0)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or product >= nodes.count or dividend >= nodes.count
                nodes[product].kind != "binary" or nodes[product].operator != "*"
            return true if (proof_kernel_replay_exact_division_candidate(nodes, children, facts, nodes[product].left, nodes[product].right, dividend, split_depth, depth, work_used, remaining - 1) can Global{Read,Write})
            (proof_kernel_replay_exact_division_candidate(nodes, children, facts, nodes[product].right, nodes[product].left, dividend, split_depth, depth, work_used, remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_exact_division_candidate(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], quotient_root: usize, multiplier_root: usize, dividend_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            proven: bool = (proof_kernel_replay_exact_division_candidate_body(nodes, children, facts, quotient_root, multiplier_root, dividend_root, split_depth, depth, work_used, remaining) can Global{Read,Write})
            nodes.truncate(saved_nodes)
            children.truncate(saved_children)
            proven

        def proof_kernel_replay_exact_division_candidate_body(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], quotient_root: usize, multiplier_root: usize, dividend_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            return false if remaining <= 1 or not proof_kernel_replay_goal_search_charge(work_used)
            quotient: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, quotient_root, work_used, 0)
            multiplier: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, multiplier_root, work_used, 0)
            dividend: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, dividend_root, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or quotient >= nodes.count or multiplier >= nodes.count or dividend >= nodes.count
            parts: (known: bool, dividend: usize, percent: bool, divisor: usize) = proof_kernel_replay_division_parts_with_goal_work(nodes, quotient, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not parts.known or parts.percent
            expected_dividend: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, parts.dividend, work_used, 0)
            expected_divisor: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, parts.divisor, work_used, 0)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_goal_search_expr_equal(nodes, children, dividend, expected_dividend, work_used)
                not proof_kernel_replay_goal_search_expr_equal(nodes, children, multiplier, expected_divisor, work_used)
                not proof_kernel_replay_exact_division_zero_remainder_in_facts(nodes, children, facts, expected_dividend, expected_divisor, work_used, 0)
                not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, expected_dividend, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, quotient, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            unsigned_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, quotient, facts, work_used, depth + 1)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            product_root: mutable usize = nodes.count
            return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
            product_root <- ElisaProofKernelCore::add_node(nodes, "binary", "*", quotient, expected_divisor, 0, 0, 0, 0, "", "")
            return false if product_root >= nodes.count
            if unsigned_width != 0:
                return false if:
                    proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, expected_dividend, facts, work_used, depth + 1) != unsigned_width
                    proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, product_root, facts, work_used, depth + 1) != unsigned_width
                remainder_root: mutable usize = nodes.count
                return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
                remainder_root <- ElisaProofKernelCore::add_node(nodes, "binary", "%", expected_dividend, expected_divisor, 0, 0, 0, 0, "", "")
                return false if:
                    remainder_root >= nodes.count or proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, remainder_root, facts, work_used, depth + 1) != unsigned_width
                    not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, expected_dividend, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    not proof_kernel_replay_unsigned_division_divisor_width_matches_with_goal_work(nodes, children, facts, expected_divisor, unsigned_width, 0, work_used)
            else:
                signed_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, quotient, work_used, depth + 1)
                return false if:
                    signed_width == 0 or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, expected_dividend, work_used, depth + 1) != signed_width
                    proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, product_root, work_used, depth + 1) != signed_width
                remainder_root: mutable usize = nodes.count
                return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
                remainder_root <- ElisaProofKernelCore::add_node(nodes, "binary", "%", expected_dividend, expected_divisor, 0, 0, 0, 0, "", "")
                return false if:
                    remainder_root >= nodes.count or proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, remainder_root, work_used, depth + 1) != signed_width
                    not proof_kernel_replay_exact_division_signed_divisor_width_matches(nodes, children, facts, expected_divisor, signed_width, work_used, 0)
            zero_root: mutable usize = nodes.count
            positive_root: mutable usize = nodes.count
            return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 2)
            zero_root <- ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
            positive_root <- ElisaProofKernelCore::add_node(nodes, "binary", ">", expected_divisor, zero_root, 0, 0, 0, 0, "", "")
            return false if zero_root >= nodes.count or positive_root >= nodes.count
            (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, positive_root, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_exact_division_signed_divisor_width_matches(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], divisor: usize, width: i64, work_used: mutable usize&, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or divisor >= nodes.count
            root: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, divisor, work_used, depth)
            return false if root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "typed-int":
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(node)
                return literal.known and not literal.unsigned and literal.width == width and literal.bits > 0
            if node.kind == "int":
                literal: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return literal.known and literal.value > 0 and literal.value <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
            return proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, root, work_used, depth + 1) == width and proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)

        def proof_kernel_replay_exact_division_zero_remainder_in_facts(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], dividend: usize, divisor: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            for fact in facts |fact, nodes, children, dividend, divisor, work_used, depth|:
                if work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                    work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1 if work_used == PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return false
                return true if proof_kernel_replay_exact_division_zero_remainder_in_fact(nodes, children, fact, dividend, divisor, work_used, depth)
            false

        def proof_kernel_replay_exact_division_zero_remainder_in_fact(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, fact: usize, dividend: usize, divisor: usize, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
            root: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, fact, work_used, depth)
            return false if root >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "and":
                return true if proof_kernel_replay_exact_division_zero_remainder_in_fact(nodes, children, node.left, dividend, divisor, work_used, depth + 1)
                return proof_kernel_replay_exact_division_zero_remainder_in_fact(nodes, children, node.right, dividend, divisor, work_used, depth + 1)
            return false if node.kind != "binary" or node.operator != "=="
            return true if proof_kernel_replay_exact_division_zero_literal(nodes, node.left, work_used) and proof_kernel_replay_exact_division_remainder_matches(nodes, children, node.right, dividend, divisor, work_used)
            proof_kernel_replay_exact_division_zero_literal(nodes, node.right, work_used) and proof_kernel_replay_exact_division_remainder_matches(nodes, children, node.left, dividend, divisor, work_used)

        def proof_kernel_replay_exact_division_zero_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            zero_root: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, root, work_used, 0)
            return false if:
                zero_root >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, zero_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if nodes[zero_root].kind == "int" and nodes[zero_root].value == 0
            if nodes[zero_root].kind == "typed-int":
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[zero_root])
                return literal.known and literal.bits == 0
            false

        def proof_kernel_replay_exact_division_remainder_matches(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, dividend: usize, divisor: usize, work_used: mutable usize&) -> bool:
            remainder: usize = proof_kernel_replay_exact_division_unwrap_parens(nodes, root, work_used, 0)
            return false if remainder >= nodes.count
            parts: (known: bool, dividend: usize, percent: bool, divisor: usize) = proof_kernel_replay_division_parts_with_goal_work(nodes, remainder, work_used)
            return parts.known and parts.percent and proof_kernel_replay_goal_search_expr_equal(nodes, children, parts.dividend, dividend, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, parts.divisor, divisor, work_used)

        def proof_kernel_replay_exact_division_unwrap_parens(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, depth: usize) -> usize:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return nodes.count if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return proof_kernel_replay_exact_division_unwrap_parens(nodes, nodes[root].left, work_used, depth + 1) if nodes[root].kind == "paren"
            root
