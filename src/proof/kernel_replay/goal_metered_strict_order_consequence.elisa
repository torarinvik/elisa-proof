extend ElisaProofKernelReplay:
    private:
        # Metered mirror of the strict-order consequence rule. The premise scan, constant
        # recognition, synthesized inequality, and recursive goal search share one work budget.
        def proof_kernel_replay_strict_order_consequence_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1 or root >= nodes.count
                not proof_kernel_replay_goal_search_charge(work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            disequality_goal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "!=", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary_goal or not disequality_goal
                goal.left >= nodes.count or goal.right >= nodes.count
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            for fact_root in facts |fact_root, nodes, children, facts, root, split_depth, depth, remaining, markers, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                binary_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.kind, "binary", work_used)
                less_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, "<", work_used)
                greater_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, ">", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not binary_fact or (not less_fact and not greater_fact)
                continue if fact.left >= nodes.count or fact.right >= nodes.count
                fact_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, fact_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if not fact_admission.complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if fact_admission.untrusted
                primitive_fact: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not primitive_fact
                left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, fact.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                zero_left: bool = left_constant.known and left_constant.value == 0
                consequence_left: usize = fact.right if zero_left else fact.left
                consequence_right: usize = fact.left if zero_left else fact.right
                present: mutable bool = false
                for premise_root in facts |premise_root, nodes, children, consequence_left, consequence_right, present, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    continue if premise_root >= nodes.count or not proof_kernel_replay_valid(nodes, premise_root)
                    return false if:
                        not proof_kernel_replay_goal_search_charge_node_text(nodes, premise_root, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    premise: ElisaProofKernelCore::ProofKernelNode = nodes[premise_root]
                    binary_premise: bool = proof_kernel_replay_goal_search_text_equal(premise.kind, "binary", work_used)
                    disequality_premise: bool = proof_kernel_replay_goal_search_text_equal(premise.operator, "!=", work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not binary_premise or not disequality_premise
                    same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, premise.left, consequence_left, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, premise.right, consequence_right, work_used) if same_left else false
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    present <- true if same_left and same_right
                continue if present
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                consequence_text_bytes: usize = sview_len("binary") + sview_len("!=")
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, consequence_text_bytes)
                consequence: usize = ElisaProofKernelCore::add_node(nodes, "binary", "!=", consequence_left, consequence_right, 0, 0, 0, 0, "", "")
                justified: bool = proof_kernel_replay_strict_order_fact_implies_disequality_with_markers_and_work(nodes, children, facts, markers, consequence, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not justified
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, facts.count)
                enriched: mutable darray[usize] = []
                enriched.extend(facts)
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                enriched.push(consequence)
                closed: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, enriched, root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if closed
            false
