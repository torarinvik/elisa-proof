# Exact type/field declaration rows are chained by a composite-key hash. Hash
# collisions remain candidates only; lookup compares every key component.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_empty_typing_index() -> ProofKernelReplayTypingIndex:
            empty_group_index: ProofKernelReplayFunctionGroupIndex = proof_kernel_replay_empty_function_group_index()
            empty_owner_path_index: ProofKernelReplayOwnerPathIndex = proof_kernel_replay_empty_owner_path_index()
            return ProofKernelReplayTypingIndex{value_binding_count: 0, value_overlay_start: 0, value_overlay_count: 0, function_parameter_count: 0, source_binding_count: 0, value_binding_indices: [], function_parameter_indices: [], function_parameter_bucket_heads: [], function_parameter_next_indices: [], call_binding_count: 0, scoped_local_binding_count: 0, call_owner_name_capacity: 0, call_owner_name_hashes: [], call_owner_name_slots: [], call_owner_name_ids: [], call_owner_marker_counts: [], call_owner_shadowed: [], declaration_binding_capacity: 0, declaration_binding_heads: [], declaration_binding_next: [], enum_member_binding_capacity: 0, enum_member_binding_heads: [], enum_member_binding_next: [], global_function_group_index: empty_group_index, local_function_group_index: empty_group_index, owner_path_index: empty_owner_path_index}

        def proof_kernel_replay_type_environment_binding_count(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment) -> usize:
            ensure environment.global_bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET implies result == ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET + 1
            ensure environment.global_bindings.count <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET and environment.bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET - environment.global_bindings.count implies result == ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET + 1
            ensure environment.global_bindings.count <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET and environment.bindings.count <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET - environment.global_bindings.count implies result == environment.global_bindings.count + environment.bindings.count
            return ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET + 1 if environment.global_bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET
            return ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET + 1 if environment.bindings.count > ElisaProofKernelCore::PROOF_KERNEL_TYPE_BINDING_BUDGET - environment.global_bindings.count
            return environment.global_bindings.count + environment.bindings.count

        def proof_kernel_replay_type_environment_binding_at(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: usize) -> ElisaProofKernelCore::ProofKernelTypingBinding:
            ensure index < environment.global_bindings.count implies proof_kernel_replay_typing_binding_equal(result, environment.global_bindings[index])
            ensure index >= environment.global_bindings.count and index - environment.global_bindings.count < environment.bindings.count implies proof_kernel_replay_typing_binding_equal(result, environment.bindings[index - environment.global_bindings.count])
            ensure index >= environment.global_bindings.count and index - environment.global_bindings.count >= environment.bindings.count implies proof_kernel_replay_typing_binding_equal(result, ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false})
            return environment.global_bindings[index] if index < environment.global_bindings.count
            local_index: usize = index - environment.global_bindings.count
            return environment.bindings[local_index] if local_index < environment.bindings.count
            return ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}

        def proof_kernel_replay_declaration_key_hash(kind: sview, name: sview, owner: sview, owner_type_identity: usize) -> u32:
            hash: mutable u32 = proof_kernel_replay_type_hash_mix(ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS.u32(), proof_kernel_replay_name_hash(kind).i64())
            if kind == "enum-tag" or kind == "enum-underlying":
                hash <- proof_kernel_replay_type_hash_mix(hash, proof_kernel_replay_name_hash(owner).i64())
                return proof_kernel_replay_type_hash_mix(hash, owner_type_identity.i64())
            if kind == "enum-scope-segment" or kind == "type-scope-segment":
                return proof_kernel_replay_type_hash_mix(hash, proof_kernel_replay_name_hash(owner).i64())
            hash <- proof_kernel_replay_type_hash_mix(hash, proof_kernel_replay_name_hash(name).i64())
            return hash if kind == "enum-member"
            hash <- proof_kernel_replay_type_hash_mix(hash, proof_kernel_replay_name_hash(owner).i64())
            return proof_kernel_replay_type_hash_mix(hash, owner_type_identity.i64())

        def proof_kernel_replay_typed_enum_member_hash(name: sview, owner: sview, owner_type_identity: usize) -> u32:
            hash: mutable u32 = proof_kernel_replay_type_hash_mix(ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS.u32(), proof_kernel_replay_name_hash("enum-member-typed").i64())
            hash <- proof_kernel_replay_type_hash_mix(hash, proof_kernel_replay_name_hash(name).i64())
            hash <- proof_kernel_replay_type_hash_mix(hash, proof_kernel_replay_name_hash(owner).i64())
            return proof_kernel_replay_type_hash_mix(hash, owner_type_identity.i64())

        def proof_kernel_replay_build_declaration_binding_index(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&, capacity: mutable usize&, heads: mutable darray[usize]&, next_rows: mutable darray[usize]&, enum_member_capacity: mutable usize&, enum_member_heads: mutable darray[usize]&, enum_member_next: mutable darray[usize]&) -> bool:
            total: usize = proof_kernel_replay_type_environment_binding_count(environment)
            relevant: mutable usize = 0
            enum_member_relevant: mutable usize = 0
            for row in 0..<total |row, environment, relevant, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, row)
                relevant <- relevant + 1 if binding.kind in {"type", "field", "enum-member", "enum-tag", "enum-underlying"} or ((binding.kind == "enum-scope-segment" or binding.kind == "type-scope-segment") and binding.parameter_index == 0)
                enum_member_relevant <- enum_member_relevant + 1 if binding.kind == "enum-member"
            capacity <- proof_kernel_replay_name_index_capacity(relevant)
            return false if relevant > 0 and capacity == 0
            enum_member_capacity <- proof_kernel_replay_name_index_capacity(enum_member_relevant)
            return false if enum_member_relevant > 0 and enum_member_capacity == 0
            heads.clear()
            next_rows.clear()
            enum_member_heads.clear()
            enum_member_next.clear()
            return true if capacity == 0
            return false if not proof_kernel_replay_type_work_consume_amount(capacity, work) or not proof_kernel_replay_type_work_consume_amount(total, work) or not proof_kernel_replay_type_work_consume_amount(enum_member_capacity, work) or (enum_member_capacity > 0 and not proof_kernel_replay_type_work_consume_amount(total, work))
            heads.resize(capacity)
            next_rows.resize(total)
            enum_member_heads.resize(enum_member_capacity)
            enum_member_next.resize(total) if enum_member_capacity > 0
            for slot in 0..<capacity |slot, heads, total, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                heads[slot] <- total
            for slot in 0..<enum_member_capacity |slot, enum_member_heads, total, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                enum_member_heads[slot] <- total
            for row in 0..<total |row, next_rows, total, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                next_rows[row] <- total
            if enum_member_capacity > 0:
                for row in 0..<total |row, enum_member_next, total, work|:
                    return false if not proof_kernel_replay_type_work_consume(work)
                    enum_member_next[row] <- total
            for row in 0..<total |row, environment, heads, next_rows, capacity, enum_member_heads, enum_member_next, enum_member_capacity, total, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, row)
                continue if binding.kind != "type" and binding.kind != "field" and binding.kind != "enum-member" and binding.kind != "enum-tag" and binding.kind != "enum-underlying" and ((binding.kind != "enum-scope-segment" and binding.kind != "type-scope-segment") or binding.parameter_index != 0)
                return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                return false if:
                    not proof_kernel_replay_type_work_consume_amount(sview_len(binding.kind), work)
                    not proof_kernel_replay_type_work_consume_amount(sview_len(binding.name), work)
                    not proof_kernel_replay_type_work_consume_amount(sview_len(binding.owner), work)
                hash: u32 = proof_kernel_replay_declaration_key_hash(binding.kind, binding.name, binding.owner, binding.owner_type_identity)
                slot: usize = (hash.i64() % capacity.i64()).usize()
                next_rows[row] <- heads[slot]
                heads[slot] <- row
                if binding.kind == "enum-member":
                    return false if not proof_kernel_replay_type_work_consume_amount(sview_len("enum-member-typed"), work) or not proof_kernel_replay_type_work_consume_amount(sview_len(binding.name), work) or not proof_kernel_replay_type_work_consume_amount(sview_len(binding.owner), work)
                    member_hash: u32 = proof_kernel_replay_typed_enum_member_hash(binding.name, binding.owner, binding.owner_type_identity)
                    member_slot: usize = (member_hash.i64() % enum_member_capacity.i64()).usize()
                    return false if not proof_kernel_replay_type_work_consume_amount(2, work)
                    enum_member_next[row] <- enum_member_heads[member_slot]
                    enum_member_heads[member_slot] <- row
            return true

        def proof_kernel_replay_find_typed_enum_member_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, name: sview, owner: sview, owner_identity: usize, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            ensure result.known implies result.binding.kind == "enum-member" and result.binding.name == name and result.binding.owner == owner and result.binding.owner_type_identity == owner_identity and result.binding.type_identity == owner_identity
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return (false, selected) if name == "" or owner == "" or owner_identity == 0 or index.source_binding_count != total or index.value_overlay_count > total
            indexed_count: usize = total - index.value_overlay_count
            return (false, selected) if index.enum_member_binding_capacity != index.enum_member_binding_heads.count or (index.enum_member_binding_capacity == 0 and index.enum_member_binding_next.count != 0) or (index.enum_member_binding_capacity > 0 and index.enum_member_binding_next.count != indexed_count)
            return (false, selected) if not proof_kernel_replay_type_work_consume_amount(sview_len("enum-member-typed"), work) or not proof_kernel_replay_type_work_consume_amount(sview_len(name), work) or not proof_kernel_replay_type_work_consume_amount(sview_len(owner), work)
            return (false, selected) if index.enum_member_binding_capacity == 0
            hash: u32 = proof_kernel_replay_typed_enum_member_hash(name, owner, owner_identity)
            slot: usize = (hash.i64() % index.enum_member_binding_capacity.i64()).usize()
            row: mutable usize = index.enum_member_binding_heads[slot]
            probes: mutable usize = 0
            return (false, selected) if row > indexed_count
            while row != indexed_count and probes < indexed_count |row, probes, environment, index, indexed_count, name, owner, owner_identity, selected, work|:
                return (false, selected) if row >= indexed_count or row >= index.enum_member_binding_next.count or not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, row)
                if binding.kind == "enum-member" and proof_kernel_replay_type_text_equal(binding.name, name, work) and proof_kernel_replay_type_text_equal(binding.owner, owner, work) and binding.owner_type_identity == owner_identity and binding.type_identity == owner_identity:
                    if selected.kind == "":
                        selected <- binding
                    elif not proof_kernel_replay_typing_evidence_equal(selected, binding, work):
                        return (false, selected)
                row <- index.enum_member_binding_next[row]
                probes <- probes + 1
            return (false, selected) if row != indexed_count or work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return (selected.kind == "enum-member", selected)

        def proof_kernel_replay_typing_binding_equal(left: ElisaProofKernelCore::ProofKernelTypingBinding, right: ElisaProofKernelCore::ProofKernelTypingBinding) -> bool:
            ensure result == (
                left.kind == right.kind
                and left.name == right.name
                and left.owner == right.owner
                and left.sort == right.sort
                and left.type_name == right.type_name
                and left.element_sort == right.element_sort
                and left.element_type_name == right.element_type_name
                and left.type_identity == right.type_identity
                and left.owner_type_identity == right.owner_type_identity
                and left.element_type_identity == right.element_type_identity
                and left.signature_identity == right.signature_identity
                and left.parameter_index == right.parameter_index
                and left.parameter_count == right.parameter_count
                and left.parameter_has_default == right.parameter_has_default
                and left.parameter_by_reference == right.parameter_by_reference
            )
            return left.kind == right.kind and left.name == right.name and left.owner == right.owner and left.sort == right.sort and left.type_name == right.type_name and left.element_sort == right.element_sort and left.element_type_name == right.element_type_name and left.type_identity == right.type_identity and left.owner_type_identity == right.owner_type_identity and left.element_type_identity == right.element_type_identity and left.signature_identity == right.signature_identity and left.parameter_index == right.parameter_index and left.parameter_count == right.parameter_count and left.parameter_has_default == right.parameter_has_default and left.parameter_by_reference == right.parameter_by_reference
