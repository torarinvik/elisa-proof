extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_resource_call_result(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, state: mutable ProofKernelReplayResourceState&, node: ElisaProofKernelCore::ProofKernelNode, prior_event: usize, arena_admitted: bool) -> bool:
            return false if node.left != prior_event
            if node.operator == "sview":
                return false if not proof_kernel_replay_resource_sview_call_result(nodes, children, state, node, prior_event, arena_admitted)
                return true
            if node.operator == "value":
                value_prior_call: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_events, state.scope.resource_call_events_are_sorted, node.left, &state.scope.resource_work_used)
                return false if not value_prior_call.complete or not value_prior_call.found
                value_prior_result: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_results, state.scope.resource_call_results_are_sorted, node.left, &state.scope.resource_work_used)
                return false if not value_prior_result.complete or value_prior_result.found
                call_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                return false if not call_located.known or call_located.node.kind != "resource-call" or call_located.node.name == ""
                call: ElisaProofKernelCore::ProofKernelNode = call_located.node
                return false if not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count)
                callee_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call.left)
                return false if not callee_located.known or callee_located.node.kind != "resource-safety"
                summary_return: (known: bool, region: sview, type_root: usize) = proof_kernel_replay_resource_collection_summary_return(nodes, children, call.left, &state.scope.resource_work_used)
                return false if:
                    not summary_return.known or summary_return.region == ""
                    not proof_kernel_replay_resource_region_collection_type(nodes, children, node.right, &state.scope.resource_work_used) or not proof_kernel_replay_resource_expr_equal(nodes, children, summary_return.type_root, node.right, &state.scope.resource_work_used)
                mapped_region: mutable sview = ""
                for call_child_index in call.auxiliary..<call.children_count |call_child_index, call, children, nodes, summary_return, mapped_region, state|:
                    return false if not proof_kernel_replay_resource_charge_work(state, 1)
                    call_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + call_child_index)
                    return false if not call_child.known
                    call_child_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call_child.value)
                    return false if:
                        not call_child_node.known
                        not proof_kernel_replay_resource_charge_node_text(state, call_child_node.node)
                        not proof_kernel_replay_resource_charge_text_pair(state, call_child_node.node.name, summary_return.region)
                    if call_child_node.node.kind == "resource-call-region" and call_child_node.node.name == summary_return.region:
                        return false if mapped_region != ""
                        mapped_region <- call_child_node.node.secondary_name
                return false if:
                    not proof_kernel_replay_resource_charge_text_pair(state, mapped_region, node.secondary_name)
                    mapped_region == "" or mapped_region != node.secondary_name or not proof_kernel_replay_resource_region_active(state, mapped_region)
                    not proof_kernel_replay_resource_binding_name_available(state, node.name)
                state.bindings.binding_names.push(node.name)
                state.bindings.binding_scope_depth.push(state.scope.scope_depth)
                state.bindings.binding_reference.push(false)
                state.bindings.binding_mutable_reference.push(false)
                state.bindings.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
                state.bindings.binding_borrowable.push(false)
                state.bindings.binding_moved.push(false)
                state.provenance.binding_region.push(mapped_region)
                state.provenance.binding_region_live.push(true)
                state.provenance.binding_region_owner.push(false)
                empty_place: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                state.borrows.borrow_target_slots.push(state.bindings.binding_names.count - 1)
                state.borrows.borrow_target_places.push(empty_place)
                state.borrows.borrow_mutable.push(false)
                state.borrows.borrow_present.push(false)
                state.scope.pending_join_moves.push(false)
                state.bindings.binding_origin_places.push(empty_place)
                return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_call_results, &state.scope.resource_call_results_are_sorted, node.left, &state.scope.resource_work_used)
                return true
            reference_prior_call: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_events, state.scope.resource_call_events_are_sorted, node.left, &state.scope.resource_work_used)
            return false if not reference_prior_call.complete or not reference_prior_call.found
            reference_prior_result: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_results, state.scope.resource_call_results_are_sorted, node.left, &state.scope.resource_work_used)
            return false if not reference_prior_result.complete or reference_prior_result.found
            call_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
            return false if not call_located.known or call_located.node.kind != "resource-call" or call_located.node.name == ""
            call: ElisaProofKernelCore::ProofKernelNode = call_located.node
            return false if not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count)
            callee_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call.left)
            return false if:
                not callee_located.known or callee_located.node.kind != "resource-safety"
                not proof_kernel_replay_child_range_valid(callee_located.node.children_start, callee_located.node.children_count, children.count)
            # The callee summary names the returned formal (directly or through its own
            # replayed call-return marker) or a fresh allocation; see resource_call_returns.
            summary_return: (known: bool, region: sview, formal: sview, mutable_reference: bool, allocation: bool) = proof_kernel_replay_resource_reference_summary_return(nodes, children, call.left, &state.scope.resource_work_used)
            return false if not summary_return.known
            returned_region: sview = summary_return.region
            returned_mutable: bool = summary_return.mutable_reference
            returned_formal: sview = summary_return.formal
            returned_allocation: bool = summary_return.allocation
            return false if returned_region == ""
            mapped_region: mutable sview = ""
            for call_child_index in call.auxiliary..<call.children_count |call_child_index, call, children, nodes, returned_region, mapped_region, state|:
                return false if not proof_kernel_replay_resource_charge_work(state, 1)
                call_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + call_child_index)
                return false if not call_child.known
                call_child_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call_child.value)
                return false if:
                    not call_child_node.known
                    not proof_kernel_replay_resource_charge_node_text(state, call_child_node.node)
                    not proof_kernel_replay_resource_charge_text_pair(state, call_child_node.node.name, returned_region)
                if call_child_node.node.kind == "resource-call-region" and call_child_node.node.name == returned_region:
                    return false if mapped_region != ""
                    mapped_region <- call_child_node.node.secondary_name
            return false if:
                not proof_kernel_replay_resource_charge_text_pair(state, mapped_region, node.secondary_name)
                mapped_region == "" or mapped_region != node.secondary_name or not proof_kernel_replay_resource_region_active(state, mapped_region)
                (node.auxiliary & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) == 0
                ((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0) != returned_mutable
                not proof_kernel_replay_resource_binding_name_available(state, node.name)
            result_alias: mutable bool = false
            result_source_slot: mutable usize = state.bindings.binding_names.count
            result_source_place: mutable ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            result_owner: mutable bool = returned_allocation
            if returned_formal != "":
                returned_argument: mutable (known: bool, root: usize) = (false, nodes.count)
                for call_child_index in 0..<call.auxiliary |call_child_index, call, children, nodes, returned_formal, returned_argument, arena_admitted, state|:
                    return false if not proof_kernel_replay_resource_charge_work(state, 1)
                    call_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + call_child_index)
                    return false if:
                        not call_child.known
                        call_child.value >= nodes.count
                        not proof_kernel_replay_resource_charge_node_text(state, nodes[call_child.value])
                        nodes[call_child.value].kind != "resource-call-arg"
                        not proof_kernel_replay_resource_charge_text_pair(state, nodes[call_child.value].name, returned_formal)
                    if nodes[call_child.value].name == returned_formal:
                        return false if returned_argument.known
                        returned_argument <- (true, call_child.value)
                return false if:
                    not returned_argument.known
                    returned_argument.root >= nodes.count
                    nodes[returned_argument.root].operator != "borrow" and nodes[returned_argument.root].operator != "reference" and nodes[returned_argument.root].operator != "region-new"
                actual: (known: bool, place: ProofKernelReplayResourcePlace, slot: usize, has_slot: bool, mutable_reference: bool) = proof_kernel_replay_resource_call_actual(state, nodes, children, returned_argument.root, arena_admitted)
                return false if not actual.known
                if nodes[returned_argument.root].operator != "region-new":
                    return false if not proof_kernel_replay_resource_place_root_valid(nodes, actual.place)
                    result_alias <- true
                    result_source_slot <- actual.slot
                    result_source_place <- actual.place
                    if (node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0:
                        return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, actual.place, actual.slot if nodes[returned_argument.root].operator == "reference" else state.bindings.binding_names.count)
                    else:
                        return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, actual.place, actual.slot if nodes[returned_argument.root].operator == "reference" else state.bindings.binding_names.count)
                    if nodes[returned_argument.root].operator == "reference":
                        return false if not actual.has_slot or actual.slot >= state.bindings.binding_moved.count or state.bindings.binding_moved[actual.slot]
                        result_owner <- actual.slot < state.provenance.binding_region_owner.count and state.provenance.binding_region_owner[actual.slot]
                        state.bindings.binding_moved[actual.slot] <- true
                else:
                    # A returned reference backed by a call-local `new[r]` temporary
                    # transfers that fresh allocation's owner to the caller result.
                    result_owner <- true
            state.bindings.binding_names.push(node.name)
            state.bindings.binding_scope_depth.push(state.scope.scope_depth)
            state.bindings.binding_reference.push(true)
            state.bindings.binding_mutable_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0)
            state.bindings.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
            state.bindings.binding_borrowable.push(false)
            state.bindings.binding_moved.push(false)
            state.provenance.binding_region.push(node.secondary_name)
            state.provenance.binding_region_live.push(true)
            state.provenance.binding_region_owner.push(result_owner)
            # Bound first, for the same reason: a call inside a conditional expression has
            # no statement boundary either. `proof_kernel_replay_resource_empty_place` is a
            # constructor over no state, so evaluating it once and unconditionally is the
            # same value both arms would have produced.
            result_empty_place: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            state.borrows.borrow_target_slots.push(result_source_slot if result_alias else state.bindings.binding_names.count - 1)
            state.borrows.borrow_target_places.push(result_source_place if result_alias else result_empty_place)
            state.borrows.borrow_mutable.push((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0 if result_alias else false)
            state.borrows.borrow_present.push(result_alias)
            state.scope.pending_join_moves.push(false)
            state.bindings.binding_origin_places.push(result_source_place if result_alias else result_empty_place)
            return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_call_results, &state.scope.resource_call_results_are_sorted, node.left, &state.scope.resource_work_used)
            return true
