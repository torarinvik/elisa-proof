# Factored helpers retained by the branch integration.
extend ElisaProofKernelReplay:
    private:

        def proof_kernel_replay_sign_relation_matches(relation: sview, expected: sview, mirrored: bool) -> bool:
            return relation == expected if not mirrored
            match relation:
                ">=":
                    return expected == "<="
                "<=":
                    return expected == ">="
                ">":
                    return expected == "<"
                "<":
                    return expected == ">"
                _:
                    return relation == expected

        def proof_kernel_replay_primitive_comparison_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not ElisaProofKernelCore::depth_valid(0) or PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH == 0
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, work_limit)
            proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, left, right, work_used, work_limit)

        def proof_kernel_replay_untrusted_relation_matches_operands_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, marked_root: usize, left: usize, right: usize, work_used: mutable usize&, work_limit: usize) -> (complete: bool, matches: bool):
            return (false, false) if marked_root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, marked_root, work_used)
            return (false, false) if work_used > work_limit
            relation: ElisaProofKernelCore::ProofKernelNode = nodes[marked_root]
            return (true, false) if relation.kind != "binary" or relation.operator not in {"==", "!=", "<", "<=", ">", ">="}
            left_matches: bool = proof_kernel_replay_scalar_witness_expr_equal(nodes, children, relation.left, left, work_used, work_limit)
            return (false, false) if work_used > work_limit
            right_matches: bool = proof_kernel_replay_scalar_witness_expr_equal(nodes, children, relation.right, right, work_used, work_limit)
            return (false, false) if work_used > work_limit
            return (true, true) if left_matches and right_matches
            reverse_left: bool = proof_kernel_replay_scalar_witness_expr_equal(nodes, children, relation.left, right, work_used, work_limit)
            return (false, false) if work_used > work_limit
            reverse_right: bool = proof_kernel_replay_scalar_witness_expr_equal(nodes, children, relation.right, left, work_used, work_limit)
            return (false, false) if work_used > work_limit
            (true, reverse_left and reverse_right)

        def proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], left: usize, right: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not ElisaProofKernelCore::depth_valid(0) or PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH == 0
            for marker in markers |marker, nodes, children, left, right, work_used, work_limit|:
                return false if not proof_kernel_replay_goal_search_charge(work_used) or work_used > work_limit
                continue if marker.kind != PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_OPERATOR
                relation_matches: (complete: bool, matches: bool) = proof_kernel_replay_untrusted_relation_matches_operands_with_work(nodes, children, marker.root, left, right, work_used, work_limit)
                return false if not relation_matches.complete or relation_matches.matches or work_used > work_limit
            budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            return false if not proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, left, 0, budget, work_used, work_limit)
            proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, right, 0, budget, work_used, work_limit)

        # Operand scalar witnesses do not authenticate the comparison operator itself.
        # Check the whole relation root before any arithmetic/order rule interprets it.
        def proof_kernel_replay_comparison_root_untrusted_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&, work_limit: usize) -> (complete: bool, untrusted: bool):
            return (false, false) if root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return (false, false) if work_used > work_limit
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (true, false) if node.kind != "binary" or node.operator not in {"==", "!=", "<", "<=", ">", ">="}
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return (false, false) if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, work_limit)
            proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, root, work_used, work_limit)

        def proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, work_used: mutable usize&, work_limit: usize) -> (complete: bool, untrusted: bool):
            return (false, false) if root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return (false, false) if work_used > work_limit
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (true, false) if node.kind != "binary" or node.operator not in {"==", "!=", "<", "<=", ">", ">="}
            for marker in markers |marker, nodes, children, root, work_used, work_limit|:
                return (false, false) if not proof_kernel_replay_goal_search_charge(work_used) or work_used > work_limit
                continue if marker.kind != PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_OPERATOR
                applies: bool = proof_kernel_replay_untrusted_operator_applies_with_work(nodes, children, marker.root, root, 0, work_used, work_limit)
                return (true, true) if applies
                return (false, false) if work_used > work_limit
            return (true, false)
