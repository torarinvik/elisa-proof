# Factored helpers retained by the branch integration.
extend ElisaProofKernelReplay:
    private:

        def proof_kernel_replay_sign_relation_matches(relation: sview, expected: sview, mirrored: bool) -> bool:
            return relation == expected if not mirrored
            match relation:
                ">=":
                    return expected == "<="
                "<=":
                    return expected == ">="
                ">":
                    return expected == "<"
                "<":
                    return expected == ">"
                _:
                    return relation == expected

        def proof_kernel_replay_primitive_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize) -> bool:
            return false if not ElisaProofKernelCore::depth_valid(0) or PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH == 0
            work_used: mutable usize = 0
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)
            budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            first: bool = proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, left, 0, budget, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT or not first
            proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, right, 0, budget, &work_used, PROOF_KERNEL_REPLAY_SCALAR_WITNESS_WORK_LIMIT)

        def proof_kernel_replay_primitive_comparison_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not ElisaProofKernelCore::depth_valid(0) or PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH == 0
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, work_limit)
            proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, left, right, work_used, work_limit)

        def proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], left: usize, right: usize, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if not ElisaProofKernelCore::depth_valid(0) or PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH == 0
            budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            return false if not proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, left, 0, budget, work_used, work_limit)
            proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, right, 0, budget, work_used, work_limit)
