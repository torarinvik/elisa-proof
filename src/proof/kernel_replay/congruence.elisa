extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH: usize = ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT - 1

        def proof_kernel_replay_find_disjunction_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&, depth: usize) -> (known: bool, left: usize, right: usize):
            requires depth <= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            decreases PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - depth
            return (false, 0, 0) if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (true, node.left, node.right) if node.kind == "binary" and node.operator == "or"
            # Mirror of the producer: `x == (a if c else b)` is `(c and x == a) or (not c and x == b)`.
            if node.kind == "binary" and node.operator == "==" and proof_kernel_replay_valid(nodes, node.right):
                return (false, 0, 0) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, node.right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if nodes[node.right].kind == "if":
                    conditional: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                    negated: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "unary", "not", conditional.left, 0, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or negated >= nodes.count
                    then_equal: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "==", node.left, conditional.right, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or then_equal >= nodes.count
                    else_equal: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "==", node.left, conditional.auxiliary, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or else_equal >= nodes.count
                    then_case: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "and", conditional.left, then_equal, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or then_case >= nodes.count
                    else_case: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "and", negated, else_equal, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or else_case >= nodes.count
                    return (true, then_case, else_case) if then_case < nodes.count and else_case < nodes.count
                    return (false, 0, 0)
            if node.kind == "binary" and node.operator == "and":
                left_split: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction_with_work(nodes, node.left, work_used, depth + 1)
                if left_split.known:
                    left_join: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "and", left_split.left, node.right, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_join >= nodes.count
                    right_join: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "and", left_split.right, node.right, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_join >= nodes.count
                    return (true, left_join, right_join)
                right_split: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction_with_work(nodes, node.right, work_used, depth + 1)
                if right_split.known:
                    left_join: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "and", node.left, right_split.left, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_join >= nodes.count
                    right_join: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "and", node.left, right_split.right, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_join >= nodes.count
                    return (true, left_join, right_join)
            if node.kind == "unary" and node.operator == "not" and node.left < nodes.count:
                return (false, 0, 0) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                if inner.kind == "binary" and inner.operator == "and":
                    left_not: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "unary", "not", inner.left, 0, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_not >= nodes.count
                    right_not: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "unary", "not", inner.right, 0, 0, work_used)
                    return (false, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_not >= nodes.count
                    return (true, left_not, right_not)
            return (false, 0, 0)

        # --- Ground congruence closure ------------------------------------------------------
        #
        # Equality is a congruence: two terms built by the same deterministic former from
        # pairwise equal operands denote the same value. This is the cheapest complete decision
        # procedure for ground equality, so the kernel recomputes it here instead of accepting
        # the producer's equality reasoning.
        #
        # Elisa's operators are not unconditionally primitive. `==`, `!=`, `+`, `-`, `*`, `/` and
        # the four ordering operators dispatch to a user `__eq__`/`__add__`/`__cmp__` whenever an
        # operand's type is a struct, and a user `__eq__` need not be Leibniz equality: it may
        # compare a subset of the fields, so `p == q` would not entail `p.x == q.x`. Indexing and
        # the other aggregate formers are user-implementable in the same way. The rule is
        # therefore admitted only over the primitive scalar fragment: the universe is closed
        # under integer, Boolean and character literals, identifiers witnessed by the producer
        # as having a declared primitive scalar type, and enum shorthands only when an exact
        # source declaration witness establishes a unique zero-payload const-enum member. The
        # arithmetic, comparison, bitwise, logical and conditional formers are admitted over those
        # terms. A goal outside that fragment declines, and a premise outside it contributes
        # nothing.
        #
        # Field selection, indexing, slicing and the aggregate constructors are consequently not
        # congruent formers here. Admitting them needs a witness that the receiver's selector is
        # the language's own and that the selected type's equality is primitive; that witness
        # does not exist in the term language yet.
        #
        # Fixed-width safety is a separate concern handled by the caller, which rejects any goal
        # or premise whose arithmetic can wrap before the signed tiers run. That is what keeps
        # `x: u8 == y: u16 |- x + 1 == y + 1` out of reach of this closure.

        def proof_kernel_replay_congruence_term_limit() -> usize:
            return 64

        def proof_kernel_replay_congruence_round_limit() -> usize:
            return 8

        # A seed scan is bounded independently of arena size. This is the same maximum proof
        # expression depth used by the kernel's other recursive readers.
        # Bounded accessors for the derived term and union-find tables. Replay never indexes a
        # table it built from serialized input without a total range check.
        def proof_kernel_replay_index_at(values: darray[usize]&, requested: usize) -> (known: bool, value: usize):
            return (false, 0) if requested >= values.count
            assert requested < values.count
            return (true, values[requested])

        def proof_kernel_replay_index_set(values: mutable darray[usize]&, requested: usize, value: usize) -> bool:
            return false if requested >= values.count
            assert requested < values.count
            values[requested] <- value
            return true

        def proof_kernel_replay_congruent_binary_operator(operator: sview) -> bool:
            return true if:
                operator in {"+", "-", "*", "/", "%"}
                operator in {"==", "!=", "<", ">", "<=", ">="}
                operator in {"and", "or", "=>"}
                operator in {"&", "|", "^", "<<", ">>"}
            return false

        def proof_kernel_replay_congruent_unary_operator(operator: sview) -> bool:
            # Unary `&` denotes an address. Two equal values may live at different addresses,
            # so it is not a function of the operand's value.
            return operator in {"+", "-", "not"}

        def proof_kernel_replay_congruent_former(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return proof_kernel_replay_congruent_binary_operator(node.operator) if node.kind == "binary"
            return proof_kernel_replay_congruent_unary_operator(node.operator) if node.kind == "unary"
            return node.kind == "if"

        # A leaf that is primitive by construction. Enum shorthands stay out of this fast path:
        # their owner is absent from the encoded node, so only the exact declaration witness can
        # establish that a shorthand denotes an admissible scalar constant. Strings are excluded
        # with the aggregates because their equality is not known to be the language's own.
        def proof_kernel_replay_congruent_scalar_literal(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return ElisaProofKernelCore::typed_literal_value(node).known if node.kind == "typed-int"
            return node.kind in {"int", "bool", "char"}

        # A compiler type marker is a one-argument call whose callee names the marker. The
        # argument is an arbitrary term, not necessarily a bare name: the producer resolves the
        # declared type of a field selection or of a container element and records the witness
        # against that exact term. Read the argument root so the witness relation below can match
        # it structurally.
        def proof_kernel_replay_marker_argument(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, callee: sview) -> (known: bool, root: usize):
            return (false, 0) if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0) if node.kind != "call"
            # Marker calls are compiler-generated facts, not arbitrary user calls. Require the
            # canonical all-positional call shape before treating one as a type witness; a
            # name-only match would let a malformed marker enter the logical model as `true`.
            return (false, 0) if:
                node.operator != "" or node.auxiliary != 0 or node.children_count != 1
                not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            actual: sview = proof_kernel_replay_ident_name(nodes, node.left)
            scalar_integer: bool = callee == "__elisa_primitive_scalar_type" and actual == "__elisa_primitive_integer_type"
            return (false, 0) if actual != callee and not scalar_integer
            argument: (known: bool, value: usize) = proof_kernel_replay_index_at(children, node.children_start)
            return (false, 0) if not argument.known
            argument_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, argument.value)
            return (false, 0) if:
                not argument_node.known or argument_node.node.kind != "call_arg"
                argument_node.node.name != "" or argument_node.node.secondary_name != ""
                not proof_kernel_replay_valid(nodes, argument_node.node.left)
            return (true, argument_node.node.left)

        # Operand roots of a participating former, in a fixed order. A malformed or
        # non-participating node yields no operands and is therefore treated as an atom.
        def proof_kernel_replay_congruence_operands(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, operands: mutable darray[usize]&) -> bool:
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return false if:
                not proof_kernel_replay_arena_shape_valid(node)
                not proof_kernel_replay_congruent_former(node)
            if node.kind == "unary":
                operands.push(node.left)
                return true
            if node.kind == "binary":
                operands.push(node.left)
                operands.push(node.right)
                return true
            if node.kind == "if":
                operands.push(node.left)
                operands.push(node.right)
                operands.push(node.auxiliary)
                return true
            return false

        # Congruence comparison visits many candidate pairs, but each admitted former has a
        # fixed, small operand list stored directly in its node. Read an operand in place instead
        # of allocating two scratch arrays for every pair in the saturation loop.
        def proof_kernel_replay_congruence_operand_at(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, requested: usize) -> (known: bool, value: usize):
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return (false, 0) if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return (false, 0) if not proof_kernel_replay_arena_shape_valid(node) or not proof_kernel_replay_congruent_former(node)
            if node.kind == "unary":
                return (false, 0) if requested != 0
                return (true, node.left)
            if node.kind == "binary":
                return (true, node.left) if requested == 0
                return (true, node.right) if requested == 1
                return (false, 0)
            if node.kind == "if":
                return (true, node.left) if requested == 0
                return (true, node.right) if requested == 1
                return (true, node.auxiliary) if requested == 2
            return (false, 0)

        def proof_kernel_replay_congruence_operand_count(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> usize:
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return 0 if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return 0 if not proof_kernel_replay_arena_shape_valid(node) or not proof_kernel_replay_congruent_former(node)
            return 1 if node.kind == "unary"
            return 2 if node.kind == "binary"
            return 3 if node.kind == "if"
            return 0
