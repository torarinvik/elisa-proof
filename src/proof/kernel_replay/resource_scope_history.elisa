extend ElisaProofKernelReplay:
    private:
        # Call roots may be shared in a replay DAG. Their result markers independently require
        # the immediate prior event, so retain the existing append/intersection semantics.
        def proof_kernel_replay_resource_scope_history_validate_prefix_ids(parent: darray[usize]&, child: darray[usize]&, work_used: mutable usize&) -> bool:
            return false if child.count < parent.count
            for index in 0..<parent.count |index, parent, child, work_used|:
                return false if not proof_kernel_replay_resource_charge_work_used(work_used, 2)
                return false if parent[index] != child[index]
            return true

        def proof_kernel_replay_resource_scope_history_intersect_ids_tracked(target: mutable darray[usize]&, baseline: darray[usize]&, child: darray[usize]&, target_sorted: bool, child_sorted: bool, work_used: mutable usize&) -> bool:
            baseline_count: usize = baseline.count
            return false if target.count < baseline_count or child.count < baseline_count
            for index in 0..<baseline_count |index, target, baseline, child, work_used|:
                return false if not proof_kernel_replay_resource_charge_work_used(work_used, 2)
                return false if target[index] != baseline[index] or child[index] != baseline[index]
            common: mutable darray[usize] = []
            if target_sorted and child_sorted:
                target_index: mutable usize = baseline_count
                child_index: mutable usize = baseline_count
                while target_index < target.count and child_index < child.count |target_index, child_index, target, child, common, work_used|:
                    return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                    if target[target_index] < child[child_index]:
                        target_index <- target_index + 1
                    else if child[child_index] < target[target_index]:
                        child_index <- child_index + 1
                    else:
                        return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                        common.push(target[target_index])
                        target_index <- target_index + 1
                        child_index <- child_index + 1
            else:
                for index in baseline_count..<target.count |index, target, child, baseline_count, common, work_used|:
                    candidate: usize = target[index]
                    present: mutable bool = false
                    for child_index in baseline_count..<child.count |child_index, child, candidate, present, work_used|:
                        return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                        if child[child_index] == candidate:
                            present <- true
                            break
                    if present:
                        return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                        common.push(candidate)
            target <- target.truncate(baseline_count)
            for candidate in common |candidate, target, work_used|:
                return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                target.push(candidate)
            return true

        # Merging event histories uses binary membership while IDs remain ordered; if a replay
        # DAG contributes an older root, switch to the complete linear path for the suffix.
        def proof_kernel_replay_resource_scope_history_append_ids_tracked(target: mutable darray[usize]&, child: darray[usize]&, sorted: mutable bool&, work_used: mutable usize&) -> bool:
            baseline_count: usize = target.count
            return false if child.count < baseline_count
            for index in 0..<baseline_count |index, target, child, work_used|:
                return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                return false if target[index] != child[index]
            for index in baseline_count..<child.count |index, target, child, sorted, work_used|:
                candidate: usize = child[index]
                present: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(target, sorted, candidate, work_used)
                return false if not present.complete
                if not present.found:
                    if sorted and target.count > 0:
                        return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                        sorted <- false if candidate < target[target.count - 1]
                    return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                    target.push(candidate)
            true

        def proof_kernel_replay_resource_scope_history_union_ids_tracked(target: mutable darray[usize]&, baseline: darray[usize]&, child: darray[usize]&, sorted: mutable bool&, work_used: mutable usize&) -> bool:
            baseline_count: usize = baseline.count
            return false if target.count < baseline_count or child.count < baseline_count
            for index in 0..<baseline_count |index, target, baseline, child, work_used|:
                return false if not proof_kernel_replay_resource_charge_work_used(work_used, 2)
                return false if target[index] != baseline[index] or child[index] != baseline[index]
            for index in baseline_count..<child.count |index, target, child, sorted, work_used|:
                candidate: usize = child[index]
                present: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(target, sorted, candidate, work_used)
                return false if not present.complete
                if not present.found:
                    if sorted and target.count > 0:
                        return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                        sorted <- false if candidate < target[target.count - 1]
                    return false if not proof_kernel_replay_resource_charge_work_used(work_used, 1)
                    target.push(candidate)
            true

        def proof_kernel_replay_resource_scope_event_history_merge_alternative(target: mutable ProofKernelReplayResourceState&, baseline: ProofKernelReplayResourceState&, child: ProofKernelReplayResourceState&, work_used: mutable usize&, first_arm: bool) -> bool:
            if first_arm:
                # A call root executed in an arm is only available in that arm. Carrying it
                # through the join would let a later result marker re-resolve the shared call
                # against the joined (possibly shadowed) bindings rather than the bindings used
                # when the call was replayed. Preserve only the inherited availability prefix.
                return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(target.scope.resource_call_events, child.scope.resource_call_events, work_used)
                return false if not proof_kernel_replay_resource_scope_history_append_ids_tracked(&target.scope.resource_call_events_seen, &child.scope.resource_call_events_seen, &target.scope.resource_call_events_seen_are_sorted, work_used)
                # Allocation and return witness roots authorize later operations that resolve
                # names in the current scope. Child-local names may shadow parent bindings, so
                # only inherited availability survives the join; consumed roots merge below.
                return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(target.scope.resource_call_allocations, child.scope.resource_call_allocations, work_used)
                return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(target.scope.resource_return_witnesses, child.scope.resource_return_witnesses, work_used)
            else:
                # Do not intersect arm-local call roots into post-join availability. Even a
                # root present in every arm can resolve its arguments to different bindings in
                # each arm, while a post-join marker sees only the outer binding environment.
                return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(baseline.scope.resource_call_events, child.scope.resource_call_events, work_used)
                return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(target.scope.resource_call_events, baseline.scope.resource_call_events, work_used)
                return false if not proof_kernel_replay_resource_scope_history_union_ids_tracked(&target.scope.resource_call_events_seen, &baseline.scope.resource_call_events_seen, &child.scope.resource_call_events_seen, &target.scope.resource_call_events_seen_are_sorted, work_used)
                return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(baseline.scope.resource_call_allocations, child.scope.resource_call_allocations, work_used)
                return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(baseline.scope.resource_return_witnesses, child.scope.resource_return_witnesses, work_used)
            return false if not proof_kernel_replay_resource_scope_history_union_ids_tracked(&target.scope.resource_call_allocations_used, &baseline.scope.resource_call_allocations_used, &child.scope.resource_call_allocations_used, &target.scope.resource_call_allocations_used_are_sorted, work_used)
            return false if not proof_kernel_replay_resource_scope_history_union_ids_tracked(&target.scope.resource_call_results, &baseline.scope.resource_call_results, &child.scope.resource_call_results, &target.scope.resource_call_results_are_sorted, work_used)
            proof_kernel_replay_resource_scope_history_union_ids_tracked(&target.scope.resource_return_witnesses_used, &baseline.scope.resource_return_witnesses_used, &child.scope.resource_return_witnesses_used, &target.scope.resource_return_witnesses_used_are_sorted, work_used)

        def proof_kernel_replay_resource_scope_event_history_adopt(parent: mutable ProofKernelReplayResourceState&, child: ProofKernelReplayResourceState&) -> bool:
            work: mutable usize& = &parent.scope.resource_work_used
            # Scope-local call roots are not replayable after the scope exits: result markers
            # would resolve their call arguments using the outer scope's bindings. Keep only
            # calls that were already available on entry, while retaining `seen` below so a
            # serialized call root cannot be executed again after leaving the child scope.
            return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(parent.scope.resource_call_events, child.scope.resource_call_events, work)
            # Membership cannot revalidate an allocation or return witness against the original
            # child binding after scope exit, so keep their availability local to this scope.
            return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(parent.scope.resource_call_allocations, child.scope.resource_call_allocations, work)
            return false if not proof_kernel_replay_resource_scope_history_validate_prefix_ids(parent.scope.resource_return_witnesses, child.scope.resource_return_witnesses, work)
            return false if not proof_kernel_replay_resource_scope_history_append_ids_tracked(&parent.scope.resource_call_events_seen, &child.scope.resource_call_events_seen, &parent.scope.resource_call_events_seen_are_sorted, work)
            return false if not proof_kernel_replay_resource_scope_history_append_ids_tracked(&parent.scope.resource_call_allocations_used, &child.scope.resource_call_allocations_used, &parent.scope.resource_call_allocations_used_are_sorted, work)
            return false if not proof_kernel_replay_resource_scope_history_append_ids_tracked(&parent.scope.resource_call_results, &child.scope.resource_call_results, &parent.scope.resource_call_results_are_sorted, work)
            return false if not proof_kernel_replay_resource_scope_history_append_ids_tracked(&parent.scope.resource_return_witnesses_used, &child.scope.resource_return_witnesses_used, &parent.scope.resource_return_witnesses_used_are_sorted, work)
            true
