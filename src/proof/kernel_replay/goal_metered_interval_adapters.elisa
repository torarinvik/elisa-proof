extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_interval_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            index: mutable ProofKernelReplayIntervalExprIndex = proof_kernel_replay_empty_interval_expr_index()
            proof_kernel_replay_interval_with_goal_indexed_work(nodes, children, root, bounds, index, work_used, depth)

        def proof_kernel_replay_interval_with_goal_context_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, bounds: darray[ProofKernelReplayBound]&, index: mutable ProofKernelReplayIntervalExprIndex&, index_ready: mutable bool&, work_used: mutable usize&, depth: usize) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            can Abort.Panic:
                index_ready <- true if not proof_kernel_replay_goal_bool_ref_value(index_ready)
                proof_kernel_replay_interval_with_goal_indexed_work(nodes, children, root, bounds, index, work_used, depth)

        # Several witness checks query two roots against the same immutable bounds. Build once
        # and retain the index for both recursive interval traversals.
        def proof_kernel_replay_interval_pair_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> (left: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool), right: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool)):
            empty: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = (false, 0, 0, false, false)
            index: mutable ProofKernelReplayIntervalExprIndex = proof_kernel_replay_empty_interval_expr_index()
            left: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_indexed_work(nodes, children, left_root, bounds, index, work_used, depth)
            return (empty, empty) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_indexed_work(nodes, children, right_root, bounds, index, work_used, depth)
            return (empty, empty) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            (left, right)

        # Defining-equality transport calls this while adding named bounds. Do not repeatedly
        # build an expression index over a collection that is still changing.
        def proof_kernel_replay_interval_with_goal_scan_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            index: mutable ProofKernelReplayIntervalExprIndex = proof_kernel_replay_empty_interval_expr_index()
            index.build_attempted <- true
            proof_kernel_replay_interval_with_goal_indexed_work(nodes, children, root, bounds, index, work_used, depth)
