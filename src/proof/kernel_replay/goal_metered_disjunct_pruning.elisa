extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_disjunct_prune_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: darray[ProofKernelReplayWitnessMarker], root: usize, depth: usize, work_used: mutable usize&) -> (truth: i64, changed: bool, root: usize):
            unknown: (truth: i64, changed: bool, root: usize) = (0, false, root)
            return unknown if:
                depth >= 32 or not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren":
                return proof_kernel_replay_disjunct_prune_with_goal_work(nodes, children, facts, markers, node.left, depth + 1, work_used)
            if node.kind == "binary" and node.operator == "or":
                left_result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_disjunct_prune_with_goal_work(nodes, children, facts, markers, node.left, depth + 1, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_disjunct_prune_with_goal_work(nodes, children, facts, markers, node.right, depth + 1, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (1, true, root) if left_result.truth == 1 or right_result.truth == 1
                return (right_result.truth, true, right_result.root) if left_result.truth == 2
                return (left_result.truth, true, left_result.root) if right_result.truth == 2
                return unknown if:
                    not left_result.changed and not right_result.changed
                    not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", "or")
                joined: usize = ElisaProofKernelCore::add_node(nodes, "binary", "or", left_result.root, right_result.root, 0, 0, 0, 0, "", "")
                return unknown if joined >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (0, true, joined)
            if node.kind == "bool":
                return (1 if node.value != 0 else 2, false, root)
            if node.kind == "unary" and node.operator == "not":
                return unknown if:
                    node.left >= nodes.count or not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (2 if nodes[node.left].value != 0 else 1, false, root) if nodes[node.left].kind == "bool"
            return unknown if node.kind != "binary"
            reflexive_true: bool = node.operator in {"==", "<=", ">="}
            reflexive_false: bool = node.operator in {"!=", "<", ">"}
            return unknown if not reflexive_true and not reflexive_false
            admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return unknown if not admission.complete or admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            equal: bool = proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, node.left, node.right, 0, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not equal
            primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            (1 if reflexive_true else 2, false, root)

        def proof_kernel_replay_disjunct_prune_facts_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], pruned: mutable darray[usize]&, work_used: mutable usize&) -> bool:
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            changed: mutable bool = false
            for fact in facts |fact, nodes, children, facts, markers, pruned, changed, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_disjunct_prune_with_goal_work(nodes, children, facts, markers, fact, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if result.changed:
                    changed <- true
                    if result.truth != 1:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        pruned.push(result.root)
                else:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    pruned.push(fact)
            changed

        def proof_kernel_replay_disjunct_negation_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> (known: bool, root: usize):
            return (false, 0) if root >= nodes.count
            stripped: mutable usize = root
            for step in 0..<8 |step, stripped, nodes, work_used|:
                return (false, 0) if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    stripped >= nodes.count or not proof_kernel_replay_valid(nodes, stripped) or not proof_kernel_replay_goal_search_charge_node_text(nodes, stripped, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                break if nodes[stripped].kind != "paren" or nodes[stripped].left >= nodes.count
                stripped <- nodes[stripped].left
            return (false, 0) if:
                stripped >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, stripped, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[stripped]
            if node.kind == "unary" and node.operator == "not" and node.left < nodes.count:
                return (false, 0) if:
                    not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, node.left)
                return (true, node.left)
            created: mutable usize = nodes.count
            if node.kind == "binary" and proof_kernel_replay_negation_supported(node.operator):
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                complement_safe: mutable bool = node.operator in {"==", "!="}
                if primitive and not complement_safe:
                    left_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, node.left, facts, work_used, 0)
                    return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    right_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, node.right, facts, work_used, 0)
                    return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    complement_safe <- left_integer and right_integer
                # Negating an IEEE ordering cannot be replaced by its converse when NaN is
                # possible. Keep the explicit negation unless both operands are proven integers.
                if primitive and complement_safe:
                    complement: sview = proof_kernel_replay_negation(node.operator)
                    return (false, 0) if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", complement)
                    created <- ElisaProofKernelCore::add_node(nodes, "binary", complement, node.left, node.right, 0, 0, 0, 0, "", "")
            if created == nodes.count:
                return (false, 0) if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "unary", "not")
                created <- ElisaProofKernelCore::add_node(nodes, "unary", "not", root, 0, 0, 0, 0, 0, "", "")
            return (false, 0) if created >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            (true, created)
