extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_SMALL_CONSTANT_MAX: i64 = ElisaProofKernelCore::PROOF_KERNEL_I8_MAX

        def proof_kernel_replay_integer_arithmetic_operator(operator: sview) -> bool:
            return true if operator == "+" or operator == "-" or operator == "*" or operator == "/" or operator == "%"
            return true if operator == "&" or operator == "|" or operator == "^"
            return false

        enum ProofKernelReplaySafeBinaryOperator:
            Unsupported
            UnaryPlus
            Add
            Subtract
            Multiply
            Divide
            Remainder
            BitAnd
            BitOr
            BitXor

        struct ProofKernelReplaySmallConstantNode:
            known: bool
            is_integer: bool
            left: usize
            right: usize
            value: i64
            operator: ProofKernelReplaySafeBinaryOperator

        def proof_kernel_replay_safe_binary_operator(operator: sview) -> ProofKernelReplaySafeBinaryOperator:
            return ProofKernelReplaySafeBinaryOperator.Add if operator == "+"
            return ProofKernelReplaySafeBinaryOperator.Subtract if operator == "-"
            return ProofKernelReplaySafeBinaryOperator.Multiply if operator == "*"
            return ProofKernelReplaySafeBinaryOperator.Divide if operator == "/"
            return ProofKernelReplaySafeBinaryOperator.Remainder if operator == "%"
            return ProofKernelReplaySafeBinaryOperator.BitAnd if operator == "&"
            return ProofKernelReplaySafeBinaryOperator.BitOr if operator == "|"
            return ProofKernelReplaySafeBinaryOperator.BitXor if operator == "^"
            return ProofKernelReplaySafeBinaryOperator.Unsupported

        def proof_kernel_replay_small_constant_node_at(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> ProofKernelReplaySmallConstantNode:
            empty: ProofKernelReplaySmallConstantNode = ProofKernelReplaySmallConstantNode{known: false, is_integer: false, left: 0, right: 0, value: 0, operator: ProofKernelReplaySafeBinaryOperator.Unsupported}
            return empty if root >= nodes.count
            assert root < nodes.count
            match nodes[root].kind:
                "int":
                    return ProofKernelReplaySmallConstantNode{known: true, is_integer: true, left: 0, right: 0, value: nodes[root].value, operator: ProofKernelReplaySafeBinaryOperator.Unsupported}
                "unary":
                    return ProofKernelReplaySmallConstantNode{known: true, is_integer: false, left: nodes[root].left, right: 0, value: 0, operator: ProofKernelReplaySafeBinaryOperator.UnaryPlus} if nodes[root].operator == "+"
                    return empty
                "binary":
                    return ProofKernelReplaySmallConstantNode{known: true, is_integer: false, left: nodes[root].left, right: nodes[root].right, value: 0, operator: proof_kernel_replay_safe_binary_operator(nodes[root].operator)}
                _:
                    return empty

        def proof_kernel_replay_safe_binary_value(operator: ProofKernelReplaySafeBinaryOperator, left: ProofKernelReplayInt, right: ProofKernelReplayInt) -> ProofKernelReplayInt:
            return proof_kernel_replay_constant_binary("+", left, right) if operator == ProofKernelReplaySafeBinaryOperator.Add
            return proof_kernel_replay_constant_binary("-", left, right) if operator == ProofKernelReplaySafeBinaryOperator.Subtract
            return proof_kernel_replay_constant_binary("*", left, right) if operator == ProofKernelReplaySafeBinaryOperator.Multiply
            return proof_kernel_replay_constant_binary("/", left, right) if operator == ProofKernelReplaySafeBinaryOperator.Divide
            return proof_kernel_replay_constant_binary("%", left, right) if operator == ProofKernelReplaySafeBinaryOperator.Remainder
            return proof_kernel_replay_constant_binary("&", left, right) if operator == ProofKernelReplaySafeBinaryOperator.BitAnd
            return proof_kernel_replay_constant_binary("|", left, right) if operator == ProofKernelReplaySafeBinaryOperator.BitOr
            return proof_kernel_replay_constant_binary("^", left, right) if operator == ProofKernelReplaySafeBinaryOperator.BitXor
            return ProofKernelReplayInt{known: false, value: 0}

        def proof_kernel_replay_small_nonnegative_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize) -> ProofKernelReplayInt:
            requires remaining > 0
            decreases remaining
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            current: ProofKernelReplaySmallConstantNode = proof_kernel_replay_small_constant_node_at(nodes, root)
            return empty if not current.known
            if current.is_integer:
                return empty if current.value < 0 or current.value > PROOF_KERNEL_REPLAY_SMALL_CONSTANT_MAX
                return ProofKernelReplayInt{known: true, value: current.value}
            return empty if current.operator == ProofKernelReplaySafeBinaryOperator.Unsupported
            return empty if remaining <= 1
            assert remaining > 1
            if current.operator == ProofKernelReplaySafeBinaryOperator.UnaryPlus:
                inner: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, current.left, remaining - 1)
                return inner if inner.known
                return empty
            left: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, current.left, remaining - 1)
            return empty if not left.known
            right: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, current.right, remaining - 1)
            return empty if not right.known
            result: ProofKernelReplayInt = proof_kernel_replay_safe_binary_value(current.operator, left, right)
            return empty if not result.known or result.value < 0 or result.value > PROOF_KERNEL_REPLAY_SMALL_CONSTANT_MAX
            return result

        def proof_kernel_replay_safe_comparison_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: true, value: nodes[root].value} if root < nodes.count and nodes[root].kind == "int" and nodes[root].value >= 0
            return proof_kernel_replay_small_nonnegative_constant(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)

        def proof_kernel_replay_constant_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> bool:
            return false if left_root >= nodes.count or right_root >= nodes.count
            if nodes[left_root].kind == "string" and nodes[right_root].kind == "string":
                return nodes[left_root].name == nodes[right_root].name if operator == "=="
                return nodes[left_root].name != nodes[right_root].name if operator == "!="
                return false
            # Direct nonnegative literals retain their exact values. Compound arithmetic is
            # admitted only when every intermediate is in the nonnegative i8 range, making its
            # value identical under every wider signed/unsigned machine-integer interpretation.
            left: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, left_root)
            right: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, right_root)
            return false if not left.known or not right.known
            return left.value == right.value if operator == "=="
            return left.value != right.value if operator == "!="
            return left.value < right.value if operator == "<"
            return left.value > right.value if operator == ">"
            return left.value <= right.value if operator == "<="
            return left.value >= right.value if operator == ">="
            return false

        def proof_kernel_replay_negated_constant_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> bool:
            return proof_kernel_replay_constant_comparison(nodes, left_root, "!=", right_root) if operator == "=="
            return proof_kernel_replay_constant_comparison(nodes, left_root, "==", right_root) if operator == "!="
            return proof_kernel_replay_constant_comparison(nodes, left_root, ">=", right_root) if operator == "<"
            return proof_kernel_replay_constant_comparison(nodes, left_root, ">", right_root) if operator == "<="
            return proof_kernel_replay_constant_comparison(nodes, left_root, "<=", right_root) if operator == ">"
            return proof_kernel_replay_constant_comparison(nodes, left_root, "<", right_root) if operator == ">="
            return false
