extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_SMALL_CONSTANT_MAX: i64 = ElisaProofKernelCore::PROOF_KERNEL_I8_MAX

        def proof_kernel_replay_integer_arithmetic_operator(operator: sview) -> bool:
            return true if operator == "+" or operator == "-" or operator == "*" or operator == "/" or operator == "%"
            return true if operator == "&" or operator == "|" or operator == "^" or operator == "<<" or operator == ">>"
            return false

        def proof_kernel_replay_small_range(value: ProofKernelReplayInt) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if not value.known
            return empty if value.value < 0 or value.value > PROOF_KERNEL_REPLAY_SMALL_CONSTANT_MAX
            return value

        # Evaluate integer literals, unary plus and the arithmetic operators, refusing as soon as
        # any leaf or intermediate leaves [0, 127]. Inside that range every admitted signed and
        # unsigned machine-integer width computes the same value, so the missing width/signedness
        # metadata in the arena cannot change the result. A shift is admitted only by an amount
        # below 7; unary minus and non-literal leaves stay outside this fragment.
        def proof_kernel_replay_small_constant_remaining(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize) -> ProofKernelReplayInt:
            decreases remaining
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if root >= nodes.count
            match nodes[root].kind:
                "int":
                    return proof_kernel_replay_small_range(ProofKernelReplayInt{known: true, value: nodes[root].value})
                "field":
                    # The empty literal's count is 0 under every width, as in the constant leaf.
                    return proof_kernel_replay_constant_leaf(nodes, nodes[root].kind, nodes[root].name, nodes[root].left, nodes[root].value)
                "unary":
                    return empty if remaining < 1
                    return empty if nodes[root].operator != "+"
                    inner: ProofKernelReplayInt = proof_kernel_replay_small_constant_remaining(nodes, nodes[root].left, remaining - 1)
                    return proof_kernel_replay_small_range(inner)
                "binary":
                    return empty if remaining < 1
                    return empty if not proof_kernel_replay_integer_arithmetic_operator(nodes[root].operator)
                    left: ProofKernelReplayInt = proof_kernel_replay_small_constant_remaining(nodes, nodes[root].left, remaining - 1)
                    right: ProofKernelReplayInt = proof_kernel_replay_small_constant_remaining(nodes, nodes[root].right, remaining - 1)
                    # Every admitted machine-integer width has at least 8 bits, so a shift by fewer
                    # than 7 keeps a small operand inside the width and off the i8 sign bit. The
                    # limit is a literal: an i64 global becomes a fact in every audited function.
                    shift: bool = nodes[root].operator == "<<" or nodes[root].operator == ">>"
                    return empty if shift and (not right.known or right.value >= 7)
                    combined: ProofKernelReplayInt = proof_kernel_replay_constant_binary(nodes[root].operator, left, right)
                    return proof_kernel_replay_small_range(combined)
                _:
                    return empty

        def proof_kernel_replay_small_nonnegative_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize) -> ProofKernelReplayInt:
            return proof_kernel_replay_small_constant_remaining(nodes, root, remaining)

        def proof_kernel_replay_safe_comparison_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: true, value: nodes[root].value} if root < nodes.count and nodes[root].kind == "int" and nodes[root].value >= 0
            return proof_kernel_replay_small_nonnegative_constant(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)

        # A comparison operand with its typed-literal tag. A tagged operand is a direct
        # full-width unsigned literal whose value is its negative payload plus 2^64; an untyped
        # operand is a width-independent nonnegative constant.
        def proof_kernel_replay_tagged_comparison_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, tag: sview, value: i64):
            return (false, "", 0) if root >= nodes.count
            if proof_kernel_replay_int_tagged(nodes[root]):
                return (false, "", 0) if not proof_kernel_replay_int_tag_valid(nodes[root].operator) or nodes[root].value >= 0
                return (true, nodes[root].operator, nodes[root].value)
            safe: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, root)
            return (safe.known, "", safe.value)

        # Order two known operands: -1, 0 or 1. Every tagged value is at least 2^63 and every
        # untyped one is below it; among tagged values of one type, the signed order of the
        # negative payloads is the unsigned order of the values.
        def proof_kernel_replay_tagged_order(left_tag: sview, left_value: i64, right_tag: sview, right_value: i64) -> i64:
            return 1 if left_tag != "" and right_tag == ""
            return -1 if left_tag == "" and right_tag != ""
            return -1 if left_value < right_value
            return 1 if left_value > right_value
            return 0

        # Independently admit only integer tokens with optional unary plus/minus. Unlike the
        # general safe-constant evaluator below, this cannot contain arithmetic whose result may
        # vary with the source integer width. The source encoder erases parentheses, so the arena
        # form is a literal or a chain of unary pluses, with at most one unary minus over such a
        # nonnegative literal.
        def proof_kernel_replay_nonnegative_literal_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize) -> ProofKernelReplayInt:
            requires remaining > 0
            decreases remaining
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "int":
                return empty if node.value < 0
                return ProofKernelReplayInt{known: true, value: node.value}
            return empty if remaining <= 1 or node.kind != "unary" or node.operator != "+"
            return proof_kernel_replay_nonnegative_literal_constant(nodes, node.left, remaining - 1)

        def proof_kernel_replay_signed_literal_comparison_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize) -> ProofKernelReplayInt:
            requires remaining > 0
            decreases remaining
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "int":
                return empty if node.value < 0
                return ProofKernelReplayInt{known: true, value: node.value}
            return empty if remaining <= 1 or node.kind != "unary"
            if node.operator == "+":
                return proof_kernel_replay_signed_literal_comparison_constant(nodes, node.left, remaining - 1)
            return empty if node.operator != "-"
            magnitude: ProofKernelReplayInt = proof_kernel_replay_nonnegative_literal_constant(nodes, node.left, remaining - 1)
            return empty if not magnitude.known or magnitude.value == ElisaProofKernelCore::PROOF_KERNEL_I64_MIN
            return ProofKernelReplayInt{known: true, value: 0 - magnitude.value}

        def proof_kernel_replay_string_comparison(left: ElisaProofKernelCore::ProofKernelNode, operator: sview, right: ElisaProofKernelCore::ProofKernelNode) -> (handled: bool, value: bool):
            return (false, false) if left.kind != "string" or right.kind != "string"
            match operator:
                "==":
                    return (true, left.name == right.name)
                "!=":
                    return (true, left.name != right.name)
                _:
                    return (true, false)

        def proof_kernel_replay_direct_typed_literal_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> bool:
            return false if left_root >= nodes.count or right_root >= nodes.count
            return false if nodes[left_root].kind != "typed-int" or nodes[right_root].kind != "typed-int"
            return false if nodes[left_root].name != nodes[right_root].name
            left: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[left_root])
            right: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[right_root])
            return false if not left.known or not right.known or left.unsigned != right.unsigned or left.width != right.width
            return left.bits == right.bits if operator == "=="
            return left.bits != right.bits if operator == "!="
            return left.bits < right.bits if operator == "<"
            return left.bits <= right.bits if operator == "<="
            return left.bits > right.bits if operator == ">"
            return left.bits >= right.bits if operator == ">="
            return false

        def proof_kernel_replay_unsigned_integer_maximum(width: i64) -> (known: bool, value: u64):
            return (true, ElisaProofKernelCore::PROOF_KERNEL_U8_MAX.u64()) if width == ElisaProofKernelCore::PROOF_KERNEL_U8_WIDTH
            return (true, ElisaProofKernelCore::PROOF_KERNEL_U16_MAX.u64()) if width == ElisaProofKernelCore::PROOF_KERNEL_U16_WIDTH
            return (true, ElisaProofKernelCore::PROOF_KERNEL_U32_MAX.u64()) if width == ElisaProofKernelCore::PROOF_KERNEL_U32_WIDTH
            return (true, ElisaProofKernelCore::PROOF_KERNEL_U64_MAX) if width == ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
            return (false, 0)

        def proof_kernel_replay_unsigned_typed_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, bits: u64, width: i64):
            return (false, 0, 0) if root >= nodes.count
            literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[root])
            return (false, 0, 0) if not literal.known or not literal.unsigned
            return (true, literal.bits, literal.width)

        def proof_kernel_replay_unsigned_typed_binary(node: ElisaProofKernelCore::ProofKernelNode, left: (known: bool, bits: u64, width: i64), right: (known: bool, bits: u64, width: i64)) -> (known: bool, bits: u64, width: i64):
            return (false, 0, 0) if node.kind != "binary" or (node.operator != "+" and node.operator != "-")
            return (false, 0, 0) if node.auxiliary != 0 or node.children_start != 0 or node.children_count != 0 or node.value != 0 or node.name != "" or node.secondary_name != ""
            return (false, 0, 0) if not left.known or not right.known or left.width != right.width
            maximum: (known: bool, value: u64) = proof_kernel_replay_unsigned_integer_maximum(left.width)
            return (false, 0, 0) if not maximum.known or left.bits > maximum.value or right.bits > maximum.value
            if node.operator == "+":
                room: u64 = maximum.value - right.bits
                wrapped: u64 = left.bits - room - 1 if left.bits > room else left.bits + right.bits
                return (true, wrapped, left.width)
            return (true, left.bits - right.bits, left.width) if left.bits >= right.bits
            difference: u64 = right.bits - left.bits
            return (true, maximum.value - difference + 1, left.width)

        # Each operand is either a typed literal or a single unsigned add/sub expression over
        # typed literals. The outer comparison may add one more layer; deeper trees are unknown.
        def proof_kernel_replay_unsigned_typed_operand(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, bits: u64, width: i64):
            return (false, 0, 0) if root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_unsigned_typed_literal(nodes, root) if node.kind == "typed-int"
            return (false, 0, 0) if node.kind != "binary" or node.left >= nodes.count or node.right >= nodes.count
            left: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_literal(nodes, node.left)
            right: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_literal(nodes, node.right)
            return proof_kernel_replay_unsigned_typed_binary(node, left, right)

        def proof_kernel_replay_unsigned_typed_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, bits: u64, width: i64):
            return (false, 0, 0) if root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_unsigned_typed_literal(nodes, root) if node.kind == "typed-int"
            return (false, 0, 0) if node.kind != "binary" or node.left >= nodes.count or node.right >= nodes.count
            left: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_operand(nodes, node.left)
            right: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_operand(nodes, node.right)
            return proof_kernel_replay_unsigned_typed_binary(node, left, right)

        def proof_kernel_replay_u64_comparison(left: u64, operator: sview, right: u64) -> (known: bool, value: bool):
            return (true, left == right) if operator == "=="
            return (true, left != right) if operator == "!="
            return (true, left < right) if operator == "<"
            return (true, left <= right) if operator == "<="
            return (true, left > right) if operator == ">"
            return (true, left >= right) if operator == ">="
            return (false, false)

        def proof_kernel_replay_unsigned_typed_expression_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> (known: bool, value: bool):
            left: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_constant(nodes, left_root)
            right: (known: bool, bits: u64, width: i64) = proof_kernel_replay_unsigned_typed_constant(nodes, right_root)
            return (false, false) if not left.known or not right.known or left.width != right.width
            return proof_kernel_replay_u64_comparison(left.bits, operator, right.bits)

        def proof_kernel_replay_direct_signed_literal(node: ElisaProofKernelCore::ProofKernelNode) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if node.kind != "int" or node.value < 0
            return ProofKernelReplayInt{known: true, value: node.value}

        def proof_kernel_replay_unary_signed_literal(node: ElisaProofKernelCore::ProofKernelNode, operand: ElisaProofKernelCore::ProofKernelNode) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if node.kind != "unary" or (node.operator != "+" and node.operator != "-")
            return empty if operand.kind != "int" or operand.value < 0
            return ProofKernelReplayInt{known: true, value: operand.value} if node.operator == "+"
            return ProofKernelReplayInt{known: true, value: 0 - operand.value}

        def proof_kernel_replay_shallow_signed_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return empty if not located.known
            return proof_kernel_replay_direct_signed_literal(located.node) if located.node.kind == "int"
            return empty if located.node.kind != "unary" or (located.node.operator != "+" and located.node.operator != "-")
            operand: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, located.node.left)
            return empty if not operand.known
            return proof_kernel_replay_unary_signed_literal(located.node, operand.node)

        def proof_kernel_replay_i64_comparison(left: i64, operator: sview, right: i64) -> bool:
            return left == right if operator == "=="
            return left != right if operator == "!="
            return left < right if operator == "<"
            return left <= right if operator == "<="
            return left > right if operator == ">"
            return left >= right if operator == ">="
            return false

        def proof_kernel_replay_literal_constant_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> bool:
            return false if left_root >= nodes.count or right_root >= nodes.count
            if nodes[left_root].kind == "typed-int" or nodes[right_root].kind == "typed-int":
                if nodes[left_root].kind == "typed-int" and nodes[right_root].kind == "typed-int":
                    return proof_kernel_replay_direct_typed_literal_comparison(nodes, left_root, operator, right_root)
                typed: (known: bool, value: bool) = proof_kernel_replay_unsigned_typed_expression_comparison(nodes, left_root, operator, right_root)
                return typed.value if typed.known
                return false
            # Direct nonnegative literals retain their exact values. Compound arithmetic is
            # admitted only when every intermediate is in the nonnegative i8 range, making its
            # value identical under every wider signed/unsigned machine-integer interpretation.
            left: mutable ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, left_root)
            right: mutable ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, right_root)
            left <- proof_kernel_replay_shallow_signed_literal(nodes, left_root) if not left.known
            right <- proof_kernel_replay_shallow_signed_literal(nodes, right_root) if not right.known
            return false if not left.known or not right.known
            return proof_kernel_replay_i64_comparison(left.value, operator, right.value)

        def proof_kernel_replay_constant_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> bool:
            return false if left_root >= nodes.count or right_root >= nodes.count
            strings: (handled: bool, value: bool) = proof_kernel_replay_string_comparison(nodes[left_root], operator, nodes[right_root])
            return strings.value if strings.handled
            left_tagged: (known: bool, tag: sview, value: i64) = proof_kernel_replay_tagged_comparison_constant(nodes, left_root)
            right_tagged: (known: bool, tag: sview, value: i64) = proof_kernel_replay_tagged_comparison_constant(nodes, right_root)
            if left_tagged.known and right_tagged.known and (left_tagged.tag != "" or right_tagged.tag != ""):
                # Mixed tagged spellings have distinct source sorts even when their payloads
                # coincide; do not turn them into a cross-width equality or disequality claim.
                return false if left_tagged.tag != "" and right_tagged.tag != "" and left_tagged.tag != right_tagged.tag
                order: i64 = proof_kernel_replay_tagged_order(left_tagged.tag, left_tagged.value, right_tagged.tag, right_tagged.value)
                return order == 0 if operator == "=="
                return order != 0 if operator == "!="
                return order < 0 if operator == "<"
                return order <= 0 if operator == "<="
                return order > 0 if operator == ">"
                return order >= 0 if operator == ">="
                return false
            return proof_kernel_replay_literal_constant_comparison(nodes, left_root, operator, right_root)

        def proof_kernel_replay_negated_constant_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> bool:
            return proof_kernel_replay_constant_comparison(nodes, left_root, "!=", right_root) if operator == "=="
            return proof_kernel_replay_constant_comparison(nodes, left_root, "==", right_root) if operator == "!="
            return proof_kernel_replay_constant_comparison(nodes, left_root, ">=", right_root) if operator == "<"
            return proof_kernel_replay_constant_comparison(nodes, left_root, ">", right_root) if operator == "<="
            return proof_kernel_replay_constant_comparison(nodes, left_root, "<=", right_root) if operator == ">"
            return proof_kernel_replay_constant_comparison(nodes, left_root, "<", right_root) if operator == ">="
            return false
