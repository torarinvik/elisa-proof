# Per-invocation scratch shared by kernel replay and source-backed certificate validation.
extend ElisaProofKernelReplay:
    public:
        # Arena admission uses an explicit DFS work item rather than the host call stack. The
        # depth is still part of the certificate invariant, so iterative traversal does not turn
        # an unbounded serialized graph into an accepted term merely because it avoids recursion.
        struct ProofKernelReplayArenaWork:
            root: usize
            depth: usize
            exiting: bool

        # Reusable scratch for one replay batch. Callers construct a fresh workspace between
        # independent batches; memoized verdicts are never accepted from caller-retained state.
        struct ProofKernelReplayValidationWorkspace:
            visiting: mutable darray[bool]
            visited: mutable darray[bool]
            validity: mutable darray[bool]
            visited_depth: mutable darray[usize]
            work: mutable darray[ProofKernelReplayArenaWork]
            work_used: mutable usize
            # Arena admission roots in one tactic trace share the same immutable arena. Keep
            # the node verdict arrays warm between those roots and resize only if the arena
            # shape changes.
            arena_cache_initialized: mutable bool
            arena_cache_node_count: mutable usize
            # Batch work ceiling for source-backed replay checks.
            source_scan_work_used: mutable usize
            # One cumulative logical replay budget across all goal traces in the batch.
            kernel_goal_work_used: mutable usize
            # Arena validation has a separate cumulative ceiling; its linear cache setup must
            # not consume logical search work, while repeated root walks remain bounded.
            kernel_goal_arena_work_used: mutable usize
            # One cumulative source-expression replay budget across all proof-step traces.
            source_goal_work_used: mutable usize
            # Fact-trace verdicts within one validation pass, by trace index: the deepest start
            # (plus one) at which the trace validated, 0 for none, and for the kernel validator
            # whether that ran with full arena revalidation. Only traces whose check consulted no
            # dependency stack are recorded (`trace_stack_touched`), so a verdict never depends
            # on the summary chain it was reached through. Source validity also depends on the
            # consuming certificate (local-binding liveness, owner-stamped constants), so each
            # verdict records the certificate it was reached from and is reused only there.
            trace_memo_depth: mutable darray[usize]
            trace_memo_context: mutable darray[usize]
            kernel_trace_memo_depth: mutable darray[usize]
            kernel_trace_memo_context: mutable darray[usize]
            kernel_trace_memo_strict: mutable darray[bool]
            trace_stack_touched: mutable bool
            allow_replayed_dependency_memo: mutable bool = false

        def proof_kernel_replay_validation_workspace_new() -> ProofKernelReplayValidationWorkspace:
            ensure result.visiting.count == 0 and result.visited.count == 0 and result.validity.count == 0 and result.visited_depth.count == 0 and result.work.count == 0
            ensure result.work_used == 0 and result.source_scan_work_used == 0 and result.kernel_goal_work_used == 0 and result.kernel_goal_arena_work_used == 0 and result.source_goal_work_used == 0
            ensure not result.arena_cache_initialized and result.arena_cache_node_count == 0
            ensure result.trace_memo_depth.count == 0 and result.trace_memo_context.count == 0 and result.kernel_trace_memo_depth.count == 0 and result.kernel_trace_memo_context.count == 0 and result.kernel_trace_memo_strict.count == 0
            ensure not result.trace_stack_touched and not result.allow_replayed_dependency_memo
            return ProofKernelReplayValidationWorkspace{visiting: [], visited: [], validity: [], visited_depth: [], work: [], work_used: 0, arena_cache_initialized: false, arena_cache_node_count: 0, source_scan_work_used: 0, kernel_goal_work_used: 0, kernel_goal_arena_work_used: 0, source_goal_work_used: 0, trace_memo_depth: [], trace_memo_context: [], kernel_trace_memo_depth: [], kernel_trace_memo_context: [], kernel_trace_memo_strict: [], trace_stack_touched: false, allow_replayed_dependency_memo: false}
