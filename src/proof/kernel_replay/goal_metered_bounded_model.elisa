extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_BOUNDED_MODEL_PREFLIGHT_WORK_LIMIT: usize = 65536

        def proof_kernel_replay_type_marker_callee_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&) -> bool:
            unsigned: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info_with_goal_work(nodes, children, root, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if unsigned.known
            signed: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info_with_goal_work(nodes, children, root, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if signed.known
            signed_place: (known: bool, term: usize, width: i64) = proof_kernel_replay_signed_place_marker_info_with_goal_work(nodes, children, root, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if signed_place.known
            scalar: (known: bool, root: usize) = proof_kernel_replay_marker_argument_with_goal_work(nodes, children, root, "__elisa_primitive_scalar_type", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if scalar.known
            element: (known: bool, root: usize, depth: i64, width: i64) = proof_kernel_replay_element_marker_with_goal_work(nodes, children, root, work_used)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and element.known

        def proof_kernel_replay_bounded_model_fragment_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, root: usize, preflight_work: mutable usize&, work_used: mutable usize&, depth: usize) -> bool:
            can Abort.Panic:
                return false if preflight_work >= PROOF_KERNEL_REPLAY_BOUNDED_MODEL_PREFLIGHT_WORK_LIMIT
                preflight_work <- preflight_work + 1
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth)
                    root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                return false if not proof_kernel_replay_arena_shape_valid(node)
                if proof_kernel_replay_type_marker_callee_with_goal_work(nodes, children, root, work_used):
                    return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if node.kind == "bool"
                if node.kind == "unary" and node.operator == "not":
                    return proof_kernel_replay_bounded_model_fragment_with_goal_work(nodes, children, facts, markers, markers_ready, node.left, preflight_work, work_used, depth + 1)
                if node.kind == "binary":
                    if node.operator in {"and", "or", "=>"}:
                        return proof_kernel_replay_bounded_model_fragment_with_goal_work(nodes, children, facts, markers, markers_ready, node.left, preflight_work, work_used, depth + 1) and proof_kernel_replay_bounded_model_fragment_with_goal_work(nodes, children, facts, markers, markers_ready, node.right, preflight_work, work_used, depth + 1)
                    if node.operator in {"==", "!=", "<", ">", "<=", ">="}:
                        witness_depth: usize = depth + 1
                        return false if not ElisaProofKernelCore::depth_valid(witness_depth) or witness_depth >= PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
                        # The fact frame is fixed for this preflight; parse its witness markers once.
                        if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                            marker_cache: mutable darray[ProofKernelReplayWitnessMarker] = []
                            cache_complete: bool = proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &marker_cache, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                            return false if:
                                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not cache_complete
                                not proof_kernel_replay_goal_search_charge_amount(work_used, marker_cache.count)
                            markers.clear()
                            markers.extend(marker_cache)
                            markers_ready <- true
                        # Operand witnesses do not establish which comparison implementation
                        # the root selected; the model evaluator only has built-in semantics.
                        for marker in markers |marker, nodes, children, root, work_used|:
                            return false if not proof_kernel_replay_goal_search_charge(work_used)
                            if marker.kind == PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_OPERATOR:
                                return false if proof_kernel_replay_untrusted_operator_applies_with_work(nodes, children, marker.root, root, witness_depth, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                            elif marker.kind == PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_ELEMENT_OPERATOR:
                                return false if:
                                    proof_kernel_replay_untrusted_element_operator_applies_with_work(nodes, children, marker.root, node.left, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                                return false if proof_kernel_replay_untrusted_element_operator_applies_with_work(nodes, children, marker.root, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                            elif marker.kind == PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_SCALAR_REFERENCE_OPERATOR:
                                return false if:
                                    proof_kernel_replay_untrusted_scalar_reference_operator_applies_with_work(nodes, children, marker.root, node.left, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                                return false if proof_kernel_replay_untrusted_scalar_reference_operator_applies_with_work(nodes, children, marker.root, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        witness_budget: usize = PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH - witness_depth
                        left_witnessed: bool = proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, node.left, witness_depth, witness_budget, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_witnessed
                        right_witnessed: bool = proof_kernel_replay_scalar_term_witnessed_budget_with_work(nodes, children, markers, node.right, witness_depth, witness_budget, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and right_witnessed
                false

        # Type markers constrain the finite domain when present as premises. They are
        # metadata, not logical propositions, so never let a marker in the goal evaluate
        # to true merely because its spelling and argument shape are recognized.
        def proof_kernel_replay_goal_contains_type_marker_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return true if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "call":
                return true if proof_kernel_replay_type_marker_callee_with_goal_work(nodes, children, root, work_used)
            return true if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if node.kind == "unary":
                return proof_kernel_replay_goal_contains_type_marker_with_work(nodes, children, node.left, work_used, depth + 1)
            if node.kind == "binary":
                return true if proof_kernel_replay_goal_contains_type_marker_with_work(nodes, children, node.left, work_used, depth + 1)
                return proof_kernel_replay_goal_contains_type_marker_with_work(nodes, children, node.right, work_used, depth + 1)
            false

        def proof_kernel_replay_model_charge_node_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, remaining: mutable usize&, identifiers: mutable usize&, scopes: mutable usize&, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining == 0
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            remaining <- remaining - 1
            marker: bool = proof_kernel_replay_type_marker_callee_with_goal_work(nodes, children, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if marker
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind in {"int", "bool"}
            if node.kind == "ident":
                identifiers <- identifiers + 1
                return true
            if node.kind == "scope":
                scopes <- scopes + 1
                return proof_kernel_replay_model_charge_node_with_goal_work(nodes, children, node.left, remaining, identifiers, scopes, depth + 1, work_used)
            if node.kind == "unary":
                return proof_kernel_replay_model_charge_node_with_goal_work(nodes, children, node.left, remaining, identifiers, scopes, depth + 1, work_used)
            if node.kind == "binary":
                return proof_kernel_replay_model_charge_node_with_goal_work(nodes, children, node.left, remaining, identifiers, scopes, depth + 1, work_used) and proof_kernel_replay_model_charge_node_with_goal_work(nodes, children, node.right, remaining, identifiers, scopes, depth + 1, work_used)
            false

        def proof_kernel_replay_model_frame_nodes_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> (known: bool, count: usize, identifiers: usize, scopes: usize):
            return (false, 0, 0, 0) if facts.count > PROOF_KERNEL_REPLAY_MAX_MODEL_FACTS
            remaining: mutable usize = PROOF_KERNEL_REPLAY_MAX_MODEL_FRAME_NODES
            identifiers: mutable usize = 0
            scopes: mutable usize = 0
            for fact in facts |fact, nodes, children, remaining, identifiers, scopes, work_used|:
                return (false, 0, 0, 0) if not proof_kernel_replay_model_charge_node_with_goal_work(nodes, children, fact, &remaining, &identifiers, &scopes, 0, work_used)
            return (false, 0, 0, 0) if:
                not proof_kernel_replay_model_charge_node_with_goal_work(nodes, children, goal_root, &remaining, &identifiers, &scopes, 0, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, PROOF_KERNEL_REPLAY_MAX_MODEL_FRAME_NODES - remaining, identifiers, scopes)

        def proof_kernel_replay_model_collect_names_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, names: mutable darray[sview]&, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident":
                if node.name != "":
                    found: mutable bool = false
                    for existing in names |existing, node, names, found, work_used|:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        return false if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(existing)) or not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(node.name))
                        found <- true if existing == node.name
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if not found:
                        # The finite model backend cannot admit a seventh symbol; stop collecting
                        # immediately instead of retaining an unhelpful source-sized name table.
                        return false if names.count >= ElisaProofKernelCore::PROOF_KERNEL_FINITE_MODEL_SYMBOL_LIMIT
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        names.push(node.name)
                return true
            if node.kind == "unary":
                return proof_kernel_replay_model_collect_names_with_goal_work(nodes, node.left, names, depth + 1, work_used)
            if node.kind == "binary":
                return false if not proof_kernel_replay_model_collect_names_with_goal_work(nodes, node.left, names, depth + 1, work_used)
                return proof_kernel_replay_model_collect_names_with_goal_work(nodes, node.right, names, depth + 1, work_used)
            return true

        def proof_kernel_replay_term_pin_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, term_root: usize, work_used: mutable usize&) -> (known: bool, value: i64):
            return (false, 0) if:
                not proof_kernel_replay_goal_search_charge(work_used) or root >= nodes.count or term_root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_valid(nodes, term_root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, term_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (nodes[term_root].kind != "ident" and nodes[term_root].kind != "scope") or nodes[root].kind != "binary" or nodes[root].operator != "=="
            pin_left: usize = nodes[root].left
            return (false, 0) if:
                pin_left >= nodes.count or not proof_kernel_replay_valid(nodes, pin_left) or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, pin_left, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (nodes[pin_left].kind != "ident" and nodes[pin_left].kind != "scope")
            same: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, pin_left, term_root, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same
            pin_right: usize = nodes[root].right
            return (false, 0) if:
                pin_right >= nodes.count or not proof_kernel_replay_valid(nodes, pin_right) or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, pin_right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[pin_right].kind != "int" or proof_kernel_replay_int_tagged(nodes[pin_right])
            (true, nodes[pin_right].value)

        def proof_kernel_replay_collect_constant_pins_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], roots: mutable darray[usize]&, values: mutable darray[i64]&, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, roots, values, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if nodes[fact].kind != "binary" or nodes[fact].operator != "=="
                term: usize = nodes[fact].left
                continue if term >= nodes.count or not proof_kernel_replay_valid(nodes, term) or not proof_kernel_replay_goal_search_charge(work_used)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, term, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[term].kind != "scope"
                pin: (known: bool, value: i64) = proof_kernel_replay_term_pin_with_goal_work(nodes, children, fact, term, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not pin.known
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                roots.push(term)
                values.push(pin.value)
            work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT

        def proof_kernel_replay_model_name_index_with_goal_work(names: darray[sview]&, name: sview, work_used: mutable usize&) -> usize:
            for index in 0..<names.count |index, names, name, work_used|:
                return names.count if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(names[index])) or not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(name))
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return index if names[index] == name
            names.count

        def proof_kernel_replay_cached_pinned_constant_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, roots: darray[usize], values: darray[i64]&, root: usize, work_used: mutable usize&) -> (known: bool, value: i64):
            return (false, 0) if:
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[root].kind != "scope"
            for index in 0..<roots.count |index, nodes, children, roots, values, root, work_used|:
                return (false, 0) if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    index >= values.count or roots[index] >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                same: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, roots[index], root, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, values[index]) if same
            (false, 0)

        # Boolean equality may retry a subtree after integer evaluation leaves it unknown.
        # Charge each actual evaluator visit so that retry cost shares the report meter too.
        def proof_kernel_replay_model_int_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, pinned_roots: darray[usize], pinned_values: darray[i64]&, root: usize, names: darray[sview]&, values: darray[i64]&, depth: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if not proof_kernel_replay_arena_shape_valid(node)
            return ProofKernelReplayInt{known: not proof_kernel_replay_int_tagged(node), value: node.value} if node.kind == "int"
            if node.kind == "scope":
                pinned: (known: bool, value: i64) = proof_kernel_replay_cached_pinned_constant_with_goal_work(nodes, children, pinned_roots, pinned_values, root, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return ProofKernelReplayInt{known: pinned.known, value: pinned.value}
            if node.kind == "ident":
                index: usize = proof_kernel_replay_model_name_index_with_goal_work(names, node.name, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
                value: (known: bool, value: i64) = proof_kernel_replay_model_value_at(values, index)
                return ProofKernelReplayInt{known: true, value: value.value} if value.known
                return empty
            if node.kind == "unary":
                inner: ProofKernelReplayInt = proof_kernel_replay_model_int_with_goal_work(nodes, children, pinned_roots, pinned_values, node.left, names, values, depth + 1, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not inner.known
                return inner if node.operator == "+"
                if node.operator == "-":
                    return empty if inner.value == proof_kernel_replay_i64_min()
                    return ProofKernelReplayInt{known: true, value: 0 - inner.value}
            if node.kind == "binary":
                # The finite model stores integer assignments as i64 and has no reliable
                # result-width information for shifts or bitwise operations. Narrow signed
                # operations can change sign and unsigned operations can truncate, so do not
                # assign them i64 semantics here.
                return empty if node.operator in {"<<", ">>", "&", "|", "^"}
                left: ProofKernelReplayInt = proof_kernel_replay_model_int_with_goal_work(nodes, children, pinned_roots, pinned_values, node.left, names, values, depth + 1, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right: ProofKernelReplayInt = proof_kernel_replay_model_int_with_goal_work(nodes, children, pinned_roots, pinned_values, node.right, names, values, depth + 1, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left.known or not right.known
                return proof_kernel_replay_add_safe(left.value, right.value) if node.operator == "+"
                return proof_kernel_replay_sub_safe(left.value, right.value) if node.operator == "-"
                return proof_kernel_replay_mul_safe(left.value, right.value) if node.operator == "*"
                return proof_kernel_replay_div_safe(left.value, right.value) if node.operator == "/"
                return proof_kernel_replay_mod_safe(left.value, right.value) if node.operator == "%"
            empty

        def proof_kernel_replay_model_bool_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, pinned_roots: darray[usize], pinned_values: darray[i64]&, root: usize, names: darray[sview]&, values: darray[i64]&, depth: usize, work_used: mutable usize&) -> ProofKernelReplayBool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            empty: ProofKernelReplayBool = ProofKernelReplayBool{known: false, value: false}
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if not proof_kernel_replay_arena_shape_valid(node)
            return ProofKernelReplayBool{known: true, value: node.value != 0} if node.kind == "bool"
            marker: bool = proof_kernel_replay_type_marker_callee_with_goal_work(nodes, children, root, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return ProofKernelReplayBool{known: true, value: true} if marker
            if node.kind == "unary" and node.operator == "not":
                inner: ProofKernelReplayBool = proof_kernel_replay_model_bool_with_goal_work(nodes, children, pinned_roots, pinned_values, node.left, names, values, depth + 1, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return ProofKernelReplayBool{known: true, value: not inner.value} if inner.known
                return empty
            if node.kind == "binary" and (node.operator in {"and", "or", "=>"}):
                left_bool: ProofKernelReplayBool = proof_kernel_replay_model_bool_with_goal_work(nodes, children, pinned_roots, pinned_values, node.left, names, values, depth + 1, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_bool: ProofKernelReplayBool = proof_kernel_replay_model_bool_with_goal_work(nodes, children, pinned_roots, pinned_values, node.right, names, values, depth + 1, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if node.operator == "and":
                    return ProofKernelReplayBool{known: true, value: false} if left_bool.known and not left_bool.value or right_bool.known and not right_bool.value
                    return empty if not left_bool.known or not right_bool.known
                    return ProofKernelReplayBool{known: true, value: true}
                if node.operator == "or":
                    return ProofKernelReplayBool{known: true, value: true} if left_bool.known and left_bool.value or right_bool.known and right_bool.value
                    return empty if not left_bool.known or not right_bool.known
                    return ProofKernelReplayBool{known: true, value: false}
                return ProofKernelReplayBool{known: true, value: true} if left_bool.known and not left_bool.value or right_bool.known and right_bool.value
                return empty if not left_bool.known or not right_bool.known
                return ProofKernelReplayBool{known: true, value: not left_bool.value or right_bool.value}
            if node.kind == "binary":
                left: ProofKernelReplayInt = proof_kernel_replay_model_int_with_goal_work(nodes, children, pinned_roots, pinned_values, node.left, names, values, depth + 1, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right: ProofKernelReplayInt = proof_kernel_replay_model_int_with_goal_work(nodes, children, pinned_roots, pinned_values, node.right, names, values, depth + 1, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if left.known and right.known:
                    return ProofKernelReplayBool{known: true, value: left.value == right.value} if node.operator == "=="
                    return ProofKernelReplayBool{known: true, value: left.value != right.value} if node.operator == "!="
                    return ProofKernelReplayBool{known: true, value: left.value < right.value} if node.operator == "<"
                    return ProofKernelReplayBool{known: true, value: left.value > right.value} if node.operator == ">"
                    return ProofKernelReplayBool{known: true, value: left.value <= right.value} if node.operator == "<="
                    return ProofKernelReplayBool{known: true, value: left.value >= right.value} if node.operator == ">="
                if node.operator in {"==", "!="}:
                    left_bool: ProofKernelReplayBool = proof_kernel_replay_model_bool_with_goal_work(nodes, children, pinned_roots, pinned_values, node.left, names, values, depth + 1, work_used)
                    return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    right_bool: ProofKernelReplayBool = proof_kernel_replay_model_bool_with_goal_work(nodes, children, pinned_roots, pinned_values, node.right, names, values, depth + 1, work_used)
                    return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if left_bool.known and right_bool.known:
                        equal: bool = left_bool.value == right_bool.value
                        return ProofKernelReplayBool{known: true, value: equal} if node.operator == "=="
                        return ProofKernelReplayBool{known: true, value: not equal}
            empty

        def proof_kernel_replay_bounded_model_visit_with_goal_work(index: usize, names: darray[sview]&, values: mutable darray[i64]&, lowers: darray[i64]&, widths: darray[i64]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], pinned_roots: darray[usize], pinned_values: darray[i64]&, goal_root: usize, budget: mutable usize&, all_known: mutable bool&, holds: mutable bool&, work_used: mutable usize&) -> void:
            known_now: bool = all_known
            holds_now: bool = holds
            return if not known_now or not holds_now or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if index == names.count:
                if budget == 0:
                    all_known <- false
                    return
                return if not proof_kernel_replay_goal_search_charge(work_used)
                budget <- budget - 1
                facts_hold: mutable bool = true
                for fact in facts |fact, names, values, nodes, facts_hold, all_known, pinned_roots, pinned_values, work_used|:
                    return if not proof_kernel_replay_goal_search_charge(work_used)
                    fact_value: ProofKernelReplayBool = proof_kernel_replay_model_bool_with_goal_work(nodes, children, pinned_roots, pinned_values, fact, names, values, 0, work_used)
                    if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not fact_value.known:
                        all_known <- false
                        return
                    facts_hold <- false if not fact_value.value
                return if not facts_hold
                goal_value: ProofKernelReplayBool = proof_kernel_replay_model_bool_with_goal_work(nodes, children, pinned_roots, pinned_values, goal_root, names, values, 0, work_used)
                if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not goal_value.known:
                    all_known <- false
                    return
                holds <- false if not goal_value.value
                return
            return if index > names.count
            lower_entry: (known: bool, value: i64) = proof_kernel_replay_model_value_at(lowers, index)
            width_entry: (known: bool, value: i64) = proof_kernel_replay_model_value_at(widths, index)
            return if not lower_entry.known or not width_entry.known
            candidate: mutable i64 = lower_entry.value
            offset: mutable i64 = 0
            while offset < width_entry.value |offset, candidate, index, widths, values, nodes, facts, pinned_roots, pinned_values, goal_root, budget, all_known, holds, names, lowers, width_entry, work_used, children|:
                if not proof_kernel_replay_goal_search_charge(work_used):
                    all_known <- false
                    return
                proof_kernel_replay_i64_set(values, index, candidate)
                proof_kernel_replay_bounded_model_visit_with_goal_work(index + 1, names, values, lowers, widths, nodes, children, facts, pinned_roots, pinned_values, goal_root, budget, all_known, holds, work_used)
                known_after: bool = all_known
                holds_after: bool = holds
                return if not known_after or not holds_after or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                offset <- offset + 1
                if offset < width_entry.value:
                    next_candidate: ProofKernelReplayInt = proof_kernel_replay_add_safe(candidate, 1)
                    if not next_candidate.known:
                        all_known <- false
                        return
                    candidate <- next_candidate.value

        def proof_kernel_replay_add_model_type_bounds_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "and":
                return false if not proof_kernel_replay_add_model_type_bounds_with_goal_work(nodes, children, node.left, bounds, work_used, depth + 1)
                return proof_kernel_replay_add_model_type_bounds_with_goal_work(nodes, children, node.right, bounds, work_used, depth + 1)
            unsigned: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info_with_goal_work(nodes, children, root, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if unsigned.known:
                name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, unsigned.name_root, work_used)
                maximum: i64 = proof_kernel_replay_unsigned_width_max(unsigned.width)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or name == "" or maximum == 0
                return false if not proof_kernel_replay_add_lower_with_work(bounds, name, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                if unsigned.width != ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS:
                    return false if not proof_kernel_replay_add_upper_with_work(bounds, name, maximum, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return true
            signed: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info_with_goal_work(nodes, children, root, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if signed.known:
                name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, signed.name_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or name == ""
                return false if not proof_kernel_replay_add_lower_with_work(bounds, name, ElisaProofKernelCore::proof_kernel_signed_width_min(signed.width), work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return proof_kernel_replay_add_upper_with_work(bounds, name, ElisaProofKernelCore::proof_kernel_signed_width_max(signed.width), work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT

        def proof_kernel_replay_bounded_model_goal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool:
            preflight_work: mutable usize = 0
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            return false if:
                proof_kernel_replay_goal_contains_type_marker_with_work(nodes, children, goal_root, work_used, 0)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_bounded_model_fragment_with_goal_work(nodes, children, facts, &markers, &markers_ready, goal_root, &preflight_work, work_used, 0)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts |preflight_work, markers, markers_ready, work_used|:
                return false if:
                    not proof_kernel_replay_bounded_model_fragment_with_goal_work(nodes, children, facts, &markers, &markers_ready, fact, &preflight_work, work_used, 0)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            names: mutable darray[sview] = []
            for fact in facts |fact, nodes, names, work_used|:
                return false if not proof_kernel_replay_model_collect_names_with_goal_work(nodes, fact, &names, 0, work_used)
            return false if not proof_kernel_replay_model_collect_names_with_goal_work(nodes, goal_root, &names, 0, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                names.count == 0 or names.count > ElisaProofKernelCore::PROOF_KERNEL_FINITE_MODEL_SYMBOL_LIMIT
            # Reject models outside the small finite domain before building arithmetic safety
            # bounds. The model evaluator uses i64 arithmetic, so every admitted source
            # arithmetic expression still receives signed and unsigned width checks first.
            return false if:
                not proof_kernel_replay_unsigned_report_safe_with_goal_work(nodes, children, facts, goal_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            frame_nodes: (known: bool, count: usize, identifiers: usize, scopes: usize) = proof_kernel_replay_model_frame_nodes_with_goal_work(nodes, children, facts, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not frame_nodes.known
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, &bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts |fact, nodes, facts, bounds, work_used|:
                return false if not proof_kernel_replay_add_model_type_bounds_with_goal_work(nodes, children, fact, &bounds, work_used, 0)
            return false if not proof_kernel_replay_close_equalities_with_work(nodes, children, facts, &bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            lowers: mutable darray[i64] = []
            widths: mutable darray[i64] = []
            total: mutable i64 = 1
            for name in names |name, bounds, lowers, widths, total, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                bound: mutable ProofKernelReplayBound = proof_kernel_replay_bound_for_with_work(bounds, name, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (bound.has_lower and bound.has_upper and bound.lower > bound.upper)
                return false if not bound.has_lower or not bound.has_upper
                width_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(bound.upper, bound.lower)
                return false if not width_difference.known
                width_with_end: ProofKernelReplayInt = proof_kernel_replay_add_safe(width_difference.value, 1)
                return false if not width_with_end.known or width_with_end.value <= 0 or width_with_end.value > PROOF_KERNEL_REPLAY_MAX_FACT_BIT_WIDTH
                total_width: ProofKernelReplayInt = proof_kernel_replay_mul_safe(total, width_with_end.value)
                return false if not total_width.known or total_width.value > PROOF_KERNEL_REPLAY_MAX_FACT_ENUMERATION
                total <- total_width.value
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                lowers.push(bound.lower)
                widths.push(width_with_end.value)
            values: mutable darray[i64] = []
            return false if not proof_kernel_replay_goal_search_charge_amount(work_used, names.count)
            values.resize(names.count)
            pinned_roots: mutable darray[usize] = []
            pinned_values: mutable darray[i64] = []
            return false if not proof_kernel_replay_collect_constant_pins_with_goal_work(nodes, children, facts, &pinned_roots, &pinned_values, work_used)
            budget: mutable usize = PROOF_KERNEL_REPLAY_MAX_FACT_ENUMERATION
            all_known: mutable bool = true
            holds: mutable bool = true
            proof_kernel_replay_bounded_model_visit_with_goal_work(0, names, &values, lowers, widths, nodes, children, facts, pinned_roots, pinned_values, goal_root, &budget, &all_known, &holds, work_used)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and all_known and holds
