extend ElisaProofKernelReplay:
    private:
        # Reconstruct signed product order from admitted kernel nodes and fact bounds.
        def proof_kernel_replay_signed_product_growth(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or (goal.operator != ">=" and goal.operator != "<=")
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, goal.left, goal.right)
            left_factor: (known: bool, factor: usize) = proof_kernel_replay_product_factor(nodes, children, goal.left, goal.right)
            if left_factor.known:
                return true if proof_kernel_replay_signed_product_comparison_supported(nodes, children, facts, goal.left, goal.right, left_factor.factor, goal.operator == ">=")
            right_factor: (known: bool, factor: usize) = proof_kernel_replay_product_factor(nodes, children, goal.right, goal.left)
            if right_factor.known:
                return true if proof_kernel_replay_signed_product_comparison_supported(nodes, children, facts, goal.right, goal.left, right_factor.factor, goal.operator == "<=")
            return false

        def proof_kernel_replay_product_factor(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, product: usize, base: usize) -> (known: bool, factor: usize):
            parts = proof_kernel_replay_binary_operands(nodes, product, "*")
            return (false, nodes.count) if not parts.known
            return (true, parts.right) if proof_kernel_replay_expr_equal(nodes, children, parts.left, base, 0)
            return (true, parts.left) if proof_kernel_replay_expr_equal(nodes, children, parts.right, base, 0)
            (false, nodes.count)

        def proof_kernel_replay_signed_product_comparison_supported(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], product: usize, base: usize, factor: usize, product_ge_base: bool) -> bool:
            width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, base, 0)
            return false if width <= 0 or proof_kernel_replay_signed_width_in_expression(nodes, children, facts, factor, 0) != width
            return false if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, base, 0) or not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, factor, 0)
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |nodes, children, facts, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0) if proof_kernel_product_direct_bound(nodes, fact, 0)
            base_range = proof_kernel_replay_interval(nodes, children, base, &bounds, 0)
            factor_range = proof_kernel_replay_interval(nodes, children, factor, &bounds, 0)
            grows: bool = (base_range.has_lower and base_range.lower >= 0 and factor_range.has_lower and factor_range.lower >= 1) or (base_range.has_upper and base_range.upper <= 0 and factor_range.has_upper and factor_range.upper <= 1)
            shrinks: bool = (base_range.has_lower and base_range.lower >= 0 and factor_range.has_upper and factor_range.upper <= 1) or (base_range.has_upper and base_range.upper <= 0 and factor_range.has_lower and factor_range.lower >= 1)
            return (grows if product_ge_base else shrinks) and proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, product, facts, &bounds, 0)

        def proof_kernel_product_direct_bound(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> bool:
            return false if depth >= 64 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.left >= nodes.count or node.right >= nodes.count
            # The replay collector descends only through conjunctions and validates each
            # comparison itself, so an unrelated conjunct need not be a direct bound.
            return proof_kernel_product_direct_bound(nodes, node.left, depth + 1) or proof_kernel_product_direct_bound(nodes, node.right, depth + 1) if node.operator == "and"
            return false if node.operator != "<" and node.operator != "<=" and node.operator != ">" and node.operator != ">="
            return (nodes[node.left].kind == "ident" and proof_kernel_product_bound_literal(nodes, node.right)) or (nodes[node.right].kind == "ident" and proof_kernel_product_bound_literal(nodes, node.left))

        def proof_kernel_product_bound_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "int"
            return node.kind == "unary" and node.operator == "-" and node.left < nodes.count and nodes[node.left].kind == "int"
