extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_literal_progress_plain_one_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            node.kind == "int" and node.value == 1 and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""

        # Shared-meter mirror of `proof_kernel_replay_unsigned_literal_progress`. Width and order
        # facts, including any conditional `not` comparison, consume the caller's goal budget.
        def proof_kernel_replay_unsigned_literal_progress_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            is_binary: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            is_greater_equal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, ">=", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not is_binary or not is_greater_equal
                goal.left >= nodes.count or goal.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            relative_to_base: bool = nodes[goal.right].kind == "ident"
            return false if:
                not relative_to_base and not proof_kernel_replay_literal_progress_plain_one_with_work(nodes, goal.right, work_used)
                not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, goal.left, goal.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            term: mutable usize = goal.left
            increment: mutable bool = false
            node: ElisaProofKernelCore::ProofKernelNode = nodes[term]
            is_binary_term: bool = proof_kernel_replay_goal_search_text_equal(node.kind, "binary", work_used)
            is_plus: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "+", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if is_binary_term and is_plus:
                return false if:
                    node.left >= nodes.count or node.right >= nodes.count
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
                    not proof_kernel_replay_literal_progress_plain_one_with_work(nodes, node.right, work_used)
                term <- node.left
                increment <- true
            term_is_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[term].kind, "ident", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not term_is_ident
            if relative_to_base:
                return false if not increment
                same_base: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, goal.right, term, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_base
            width: i64 = proof_kernel_replay_sum_peer_unsigned_width_with_goal_work(nodes, children, term, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (width != 8 and width != 16 and width != 32 and width != 64)
            for fact in facts |fact, nodes, children, facts, term, width, increment, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    fact >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, fact)
                if nodes[fact].kind == "unary":
                    return false if:
                        nodes[fact].left >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, nodes[fact].left, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_work(nodes, children, facts, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not order.known
                op_gt: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">", work_used)
                op_ge: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">=", work_used)
                op_lt: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<", work_used)
                op_le: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<=", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                base: mutable usize = order.right if op_gt or op_ge else order.left
                cap: mutable usize = order.left if op_gt or op_ge else order.right
                if increment:
                    continue if not op_lt and not op_gt
                else:
                    base <- order.left if op_ge else order.right
                    cap <- order.right if op_ge else order.left
                    continue if not op_ge and not op_le
                same_base: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, base, term, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not same_base or cap >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, cap, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, cap)
                literal = ElisaProofKernelCore::typed_literal_value(nodes[cap])
                return true if literal.known and literal.unsigned and literal.width == width and literal.bits > 0
            false

        def proof_kernel_replay_unsigned_maximum_equality_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            is_binary: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            is_equality: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "==", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not is_binary or not is_equality or not proof_kernel_replay_arena_shape_valid(goal)
                goal.left >= nodes.count or goal.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            left_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[goal.left].kind, "ident", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            base: usize = goal.left if left_ident else goal.right
            cap: usize = goal.right if left_ident else goal.left
            return false if:
                not proof_kernel_replay_goal_search_text_equal(nodes[base].kind, "ident", work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_arena_shape_valid(nodes[base])
                not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, goal.left, goal.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            width: i64 = proof_kernel_replay_sum_peer_unsigned_width_with_goal_work(nodes, children, base, facts, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (width != 8 and width != 16 and width != 32 and width != 64)
                cap >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, cap, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            literal = ElisaProofKernelCore::typed_literal_value(nodes[cap])
            maximum: u64 = 255 if width == 8 else 65535 if width == 16 else 4294967295 if width == 32 else 18446744073709551615u64
            return false if not literal.known or not literal.unsigned or literal.width != width or literal.bits != maximum
            for fact in facts |fact, nodes, children, facts, base, cap, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    fact >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, fact)
                if nodes[fact].kind == "unary":
                    return false if:
                        nodes[fact].left >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, nodes[fact].left, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_work(nodes, children, facts, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not order.known
                op_ge: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">=", work_used)
                op_le: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<=", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if op_ge:
                    same_base: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.left, base, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    same_cap: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.right, cap, work_used) if same_base
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if same_base and same_cap
                if op_le:
                    same_base: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.right, base, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    same_cap: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.left, cap, work_used) if same_base
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if same_base and same_cap
            false
