extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used: mutable usize&, kind: sview, operator: sview) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(kind))
            proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(operator))

        def proof_kernel_replay_disjunction_refutes_comparison_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]&, denied_root: usize, target_root: usize, work_used: mutable usize&) -> bool:
            return false if:
                denied_root >= nodes.count or target_root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, denied_root, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, target_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            denied: ElisaProofKernelCore::ProofKernelNode = nodes[denied_root]
            target: ElisaProofKernelCore::ProofKernelNode = nodes[target_root]
            return false if:
                denied.kind != "binary" or target.kind != "binary" or not proof_kernel_replay_negation_supported(target.operator)
                denied.operator != proof_kernel_replay_negation(target.operator)
            denied_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, denied.left, denied.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not denied_primitive
            target_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, target.left, target.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not target_primitive
            ordering: bool = target.operator in {"<", "<=", ">", ">="}
            if ordering:
                left_integer: bool = proof_kernel_replay_denial_integer_term_with_work(nodes, children, denied.left, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_integer
                right_integer: bool = proof_kernel_replay_denial_integer_term_with_work(nodes, children, denied.right, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not right_integer
                target_left_integer: bool = proof_kernel_replay_denial_integer_term_with_work(nodes, children, target.left, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not target_left_integer
                target_right_integer: bool = proof_kernel_replay_denial_integer_term_with_work(nodes, children, target.right, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not target_right_integer
            same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, denied.left, target.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_left
            proof_kernel_replay_goal_search_expr_equal(nodes, children, denied.right, target.right, work_used)

        def proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]&, denied_root: usize, target_root: usize, depth: usize, work_used: mutable usize&) -> bool:
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or target_root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_goal_search_charge_node_text(nodes, target_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            target: ElisaProofKernelCore::ProofKernelNode = nodes[target_root]
            if target.kind == "binary" and target.operator == "and":
                return true if proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, denied_root, target.left, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, denied_root, target.right, depth + 1, work_used)
            proof_kernel_replay_disjunction_refutes_comparison_with_goal_work(nodes, children, facts, denied_root, target_root, work_used)

        def proof_kernel_replay_disjunction_refutes_conjunction_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]&, left: usize, right: usize, work_used: mutable usize&) -> bool:
            return false if left >= nodes.count or right >= nodes.count
            for fact_root in facts |fact_root, nodes, children, facts, left, right, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "or"
                both_left: mutable bool = proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, fact.left, left, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                both_left <- proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, fact.right, left, 0, work_used) if both_left
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if both_left
                both_right: mutable bool = proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, fact.left, right, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                both_right <- proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, fact.right, right, 0, work_used) if both_right
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if both_right
                left_on_left: bool = proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, fact.left, left, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                left_on_right: bool = proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, fact.left, right, 0, work_used) if not left_on_left else false
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_on_left: bool = proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, fact.right, left, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_on_right: bool = proof_kernel_replay_conjunction_contains_refuted_comparison_with_goal_work(nodes, children, facts, fact.right, right, 0, work_used) if not right_on_left else false
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if (left_on_left or left_on_right) and (right_on_left or right_on_right):
                    return true
            return false

        def proof_kernel_replay_logical_context_value_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, fuel: mutable usize&, depth: usize, work_used: mutable usize&) -> (known: bool, value: bool):
            return (false, false) if:
                depth >= 64 or fuel == 0 or root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            fuel <- fuel - 1
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, false) if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "bool":
                return (node.value == 0 or node.value == 1, node.value == 1)
            if node.kind == "unary" and node.operator == "not":
                result: (known: bool, value: bool) = proof_kernel_replay_logical_context_value_with_goal_work(nodes, children, facts, node.left, fuel, depth + 1, work_used)
                return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (result.known, not result.value)
            if node.kind == "binary":
                if node.operator in {"and", "or"}:
                    a: (known: bool, value: bool) = proof_kernel_replay_logical_context_value_with_goal_work(nodes, children, facts, node.left, fuel, depth + 1, work_used)
                    return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    b: (known: bool, value: bool) = proof_kernel_replay_logical_context_value_with_goal_work(nodes, children, facts, node.right, fuel, depth + 1, work_used)
                    return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if node.operator == "and":
                        return (true, false) if:
                            (a.known and not a.value) or (b.known and not b.value)
                            proof_kernel_replay_disjunction_refutes_conjunction_with_goal_work(nodes, children, facts, node.left, node.right, work_used)
                        return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return (a.known and b.known, a.value and b.value)
                    return (true, true) if (a.known and a.value) or (b.known and b.value)
                    return (a.known and b.known, a.value or b.value)
                primitive: bool = proof_kernel_replay_negation_supported(node.operator) and proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
                for fact_root in facts |fact_root, nodes, children, facts, node, work_used|:
                    return (false, false) if not proof_kernel_replay_goal_search_charge(work_used)
                    continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                    return (false, false) if:
                        not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                    continue if fact.kind != "binary" or not proof_kernel_replay_arena_shape_valid(fact) or not proof_kernel_replay_negation_supported(fact.operator)
                    fact_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not fact_primitive
                    same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.left, node.left, work_used)
                    return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_left
                    same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.right, node.right, work_used)
                    return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_right
                    return (true, true) if fact.operator == node.operator
                    return (true, false) if fact.operator == proof_kernel_replay_negation(node.operator)
            return (false, false)

        def proof_kernel_replay_logical_equation_form_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, depth: usize, work_used: mutable usize&) -> bool:
            return false if:
                depth >= 64 or root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "bool":
                return node.value == 0 or node.value == 1
            if node.kind in {"ident", "scope", "call"}:
                witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and witnessed
            if node.kind == "unary" and node.operator == "not":
                return proof_kernel_replay_logical_equation_form_with_goal_work(nodes, children, facts, node.left, depth + 1, work_used)
            if node.kind == "binary":
                if node.operator in {"and", "or"}:
                    left_form: bool = proof_kernel_replay_logical_equation_form_with_goal_work(nodes, children, facts, node.left, depth + 1, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_form
                    right_form: bool = proof_kernel_replay_logical_equation_form_with_goal_work(nodes, children, facts, node.right, depth + 1, work_used)
                    return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and right_form
                return false if not proof_kernel_replay_negation_supported(node.operator)
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and primitive
            return false

        def proof_kernel_replay_comparison_boolean_equation_plan_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> (known: bool, goal: usize):
            return (false, root) if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, root) if:
                goal.kind != "binary" or not proof_kernel_replay_arena_shape_valid(goal) or (goal.operator != "==" and goal.operator != "!=")
                goal.left >= nodes.count or goal.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            mirrored: bool = nodes[goal.left].kind == "bool"
            comparison_root: usize = goal.right if mirrored else goal.left
            literal_root: usize = goal.left if mirrored else goal.right
            return (false, root) if:
                comparison_root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, comparison_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            literal: ElisaProofKernelCore::ProofKernelNode = nodes[literal_root]
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[comparison_root]
            return (false, root) if literal.kind != "bool" or not proof_kernel_replay_arena_shape_valid(literal) or (literal.value != 0 and literal.value != 1)
            positive: bool = literal.value == 1 if goal.operator == "==" else literal.value == 0
            logical: bool = (comparison.kind == "binary" and (comparison.operator in {"and", "or"})) or (comparison.kind == "unary" and comparison.operator == "not")
            if logical:
                logical_form: bool = proof_kernel_replay_logical_equation_form_with_goal_work(nodes, children, facts, comparison_root, 0, work_used)
                return (false, root) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not logical_form
                fuel: mutable usize = 128
                constant: (known: bool, value: bool) = proof_kernel_replay_logical_context_value_with_goal_work(nodes, children, facts, comparison_root, fuel, 0, work_used)
                return (false, root) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if constant.known:
                    truth: i64 = 1 if constant.value == positive else 0
                    return (false, root) if:
                        not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "bool", "")
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    reduced: usize = ElisaProofKernelCore::add_node(nodes, "bool", "", 0, 0, 0, 0, 0, truth, "", "")
                    return (true, reduced)
                return (true, comparison_root) if positive
                return (false, root) if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "unary", "not")
                negated: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", comparison_root, 0, 0, 0, 0, 0, "", "")
                return (false, root) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, negated)
            return (false, root) if comparison.kind != "binary" or not proof_kernel_replay_arena_shape_valid(comparison) or not proof_kernel_replay_negation_supported(comparison.operator)
            primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, comparison.left, comparison.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return (false, root) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            return (true, comparison_root) if positive
            complement_operator: sview = proof_kernel_replay_negation(comparison.operator)
            return (false, root) if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", complement_operator)
            complemented: usize = ElisaProofKernelCore::add_node(nodes, "binary", complement_operator, comparison.left, comparison.right, 0, 0, 0, 0, "", "")
            return (false, root) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            (true, complemented)

        def proof_kernel_replay_unsigned_pinned_comparison_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if:
                goal.kind != "binary" or not proof_kernel_replay_arena_shape_valid(goal) or not proof_kernel_replay_negation_supported(goal.operator)
                goal.left >= nodes.count or goal.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left_node: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            right_node: ElisaProofKernelCore::ProofKernelNode = nodes[goal.right]
            on_left: bool = left_node.kind == "ident"
            alias: usize = goal.left if on_left else goal.right
            return false if:
                left_node.kind != "ident" and right_node.kind != "ident"
                not proof_kernel_replay_arena_shape_valid(left_node if on_left else right_node)
            cap_root: usize = goal.right if on_left else goal.left
            cap_node: ElisaProofKernelCore::ProofKernelNode = nodes[cap_root]
            width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, alias, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (width != 8 and width != 16 and width != 32 and width != 64)
            if cap_node.kind == "ident" and (goal.operator in {"<=", ">="}):
                zero: usize = goal.left if goal.operator == "<=" else goal.right
                peer: usize = goal.right if goal.operator == "<=" else goal.left
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, zero, peer, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
                zero_width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, zero, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or zero_width != width
                peer_width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, peer, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or peer_width != width
                for fact_root in facts |fact_root, nodes, children, facts, zero, width, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                    return false if:
                        not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                    continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                    continue if fact.left >= nodes.count or fact.right >= nodes.count
                    return false if:
                        not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.right, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    fact_left_node: ElisaProofKernelCore::ProofKernelNode = nodes[fact.left]
                    fact_right_node: ElisaProofKernelCore::ProofKernelNode = nodes[fact.right]
                    left_is_zero: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.left, zero, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    right_is_zero: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.right, zero, work_used) if not left_is_zero else false
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not left_is_zero and not right_is_zero
                    fact_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not fact_primitive
                    literal: ElisaProofKernelCore::ProofKernelNode = fact_right_node if left_is_zero else fact_left_node
                    continue if not proof_kernel_replay_arena_shape_valid(literal)
                    return true if literal.kind == "int" and literal.value == 0
                    if literal.kind == "typed-int":
                        typed: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(literal)
                        return true if typed.known and typed.unsigned and typed.width == width and typed.bits == 0
                return false
            target: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(cap_node)
            return false if not target.known or not target.unsigned or target.width != width
            primitive_goal: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, goal.left, goal.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive_goal
            for fact_root in facts |fact_root, nodes, children, facts, alias, target, width, on_left, goal, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                continue if fact.left >= nodes.count or fact.right >= nodes.count
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact_left_node: ElisaProofKernelCore::ProofKernelNode = nodes[fact.left]
                fact_right_node: ElisaProofKernelCore::ProofKernelNode = nodes[fact.right]
                left_is_alias: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.left, alias, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_is_alias: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.right, alias, work_used) if not left_is_alias else false
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not left_is_alias and not right_is_alias
                fact_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not fact_primitive
                literal: ElisaProofKernelCore::ProofKernelNode = fact_right_node if left_is_alias else fact_left_node
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.left if right_is_alias else fact.right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                bits: mutable u64 = 0
                if literal.kind == "typed-int":
                    typed: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(literal)
                    continue if not typed.known or not typed.unsigned or typed.width != width
                    bits <- typed.bits
                elif literal.kind == "int":
                    continue if not proof_kernel_replay_arena_shape_valid(literal) or literal.value < 0
                    continue if width != 64 and literal.value > proof_kernel_replay_unsigned_width_max(width)
                    bits <- literal.value.u64()
                else:
                    continue
                a: u64 = bits if on_left else target.bits
                b: u64 = target.bits if on_left else bits
                return a == b if goal.operator == "=="
                return a != b if goal.operator == "!="
                return a < b if goal.operator == "<"
                return a <= b if goal.operator == "<="
                return a > b if goal.operator == ">"
                return a >= b if goal.operator == ">="
            return false

        def proof_kernel_replay_pinned_premise_plan_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], work_used: mutable usize&) -> (known: bool, contradiction: bool, facts: darray[usize]):
            for index in 0..<facts.count |index, nodes, children, facts, work_used|:
                return (false, false, facts) if not proof_kernel_replay_goal_search_charge(work_used)
                root: usize = facts[index]
                continue if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                return (false, false, facts) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                premise: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                continue if not proof_kernel_replay_arena_shape_valid(premise)
                negated: bool = premise.kind == "unary" and premise.operator == "not"
                comparison_root: usize = premise.left if negated else root
                continue if comparison_root >= nodes.count or not proof_kernel_replay_valid(nodes, comparison_root)
                return (false, false, facts) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, comparison_root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                comparison: ElisaProofKernelCore::ProofKernelNode = nodes[comparison_root]
                continue if comparison.kind != "binary" or not proof_kernel_replay_arena_shape_valid(comparison) or not proof_kernel_replay_negation_supported(comparison.operator)
                continue if comparison.operator == "=="
                complement_operator: sview = proof_kernel_replay_negation(comparison.operator)
                return (false, false, facts) if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", complement_operator)
                complement: usize = ElisaProofKernelCore::add_node(nodes, "binary", complement_operator, comparison.left, comparison.right, 0, 0, 0, 0, "", "")
                positive: bool = proof_kernel_replay_unsigned_pinned_comparison_with_goal_work(nodes, children, facts, comparison_root, work_used)
                return (false, false, facts) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                negative: bool = proof_kernel_replay_unsigned_pinned_comparison_with_goal_work(nodes, children, facts, complement, work_used)
                return (false, false, facts) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not positive and not negative
                return (true, true, facts) if (positive and negated) or (negative and not negated)
                reduced: mutable darray[usize] = []
                for other in 0..<facts.count |other, index, facts, reduced, work_used|:
                    return (false, false, facts) if not proof_kernel_replay_goal_search_charge(work_used)
                    reduced.push(facts[other]) if other != index
                return (false, false, facts) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, false, reduced)
            (false, false, facts)
