extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_fact_denies_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, candidate: usize, facts: darray[usize], work_used: mutable usize&) -> bool:
            return false if:
                candidate >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, candidate, work_used)
            negated: (known: bool, operand: usize) = proof_kernel_replay_negated_operand(nodes, candidate)
            for fact in facts |fact, nodes, children, candidate, negated, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    fact >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                return true if negated.known and proof_kernel_replay_fact_contains_with_work(nodes, children, fact, negated.operand, work_used, 0)
                fact_negated: (known: bool, operand: usize) = proof_kernel_replay_negated_operand(nodes, fact)
                return true if fact_negated.known and proof_kernel_replay_fact_contains_with_work(nodes, children, candidate, fact_negated.operand, work_used, 0)
            return false
        def proof_kernel_replay_conjunct_facts_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, facts: darray[usize], conjuncts: mutable darray[usize]&, work_used: mutable usize&) -> void:
            for fact in facts |fact, nodes, conjuncts, work_used|:
                return if not proof_kernel_replay_goal_search_charge(work_used)
                proof_kernel_replay_push_conjuncts_with_goal_work(nodes, fact, conjuncts, work_used, 0)

        def proof_kernel_replay_push_conjuncts_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, conjuncts: mutable darray[usize]&, work_used: mutable usize&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT - depth
            return if conjuncts.count >= PROOF_KERNEL_REPLAY_CONJUNCT_SCAN_WORK_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
            if depth < ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT:
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
                if located.known:
                    return if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                    binary: bool = proof_kernel_replay_goal_search_text_equal(located.node.kind, "binary", work_used)
                    conjunction: bool = binary and proof_kernel_replay_goal_search_text_equal(located.node.operator, "and", work_used)
                    return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if conjunction:
                        proof_kernel_replay_push_conjuncts_with_goal_work(nodes, located.node.left, conjuncts, work_used, depth + 1)
                        proof_kernel_replay_push_conjuncts_with_goal_work(nodes, located.node.right, conjuncts, work_used, depth + 1)
                        return
            conjuncts.push(root)
        def proof_kernel_replay_has_order_fact_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, term: usize, bound: usize, strict_only: bool, facts: darray[usize], work_used: mutable usize&) -> bool:
            conjuncts: mutable darray[usize] = []
            proof_kernel_replay_conjunct_facts_with_goal_work(nodes, facts, &conjuncts, work_used)
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            proof_kernel_replay_has_order_fact_in_conjuncts_with_work(nodes, children, term, bound, strict_only, facts, conjuncts, &markers, &markers_ready, work_used)

        def proof_kernel_replay_has_order_fact_in_conjuncts_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, term: usize, bound: usize, strict_only: bool, facts: darray[usize], conjuncts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, work_used: mutable usize&) -> bool:
            for fact in conjuncts |fact, nodes, children, term, bound, strict_only, facts, markers, markers_ready, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                is_unary: bool = fact < nodes.count and proof_kernel_replay_goal_search_text_equal(nodes[fact].kind, "unary", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                negated_unary: mutable bool = false
                if is_unary:
                    negated_unary <- proof_kernel_replay_goal_search_text_equal(nodes[fact].operator, "not", work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if negated_unary:
                    return false if:
                        nodes[fact].left < nodes.count and not proof_kernel_replay_goal_search_charge_node_text(nodes, nodes[fact].left, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                readable: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_markers_and_work(nodes, children, facts, &markers, &markers_ready, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not readable.known
                is_less: bool = proof_kernel_replay_goal_search_text_equal(readable.operator, "<", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if is_less and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.left, term, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.right, bound, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true
                is_greater: bool = proof_kernel_replay_goal_search_text_equal(readable.operator, ">", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if is_greater and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.right, term, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.left, bound, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true
                continue if strict_only
                is_less_equal: bool = proof_kernel_replay_goal_search_text_equal(readable.operator, "<=", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if is_less_equal and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.left, term, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.right, bound, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true
                is_greater_equal: bool = proof_kernel_replay_goal_search_text_equal(readable.operator, ">=", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if is_greater_equal and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.right, term, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, readable.left, bound, work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true
            return false
        def proof_kernel_replay_order_goal_from_facts_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal: usize, work_used: mutable usize&) -> bool:
            return false if:
                goal >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_valid(nodes, goal)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[goal]
            binary: bool = proof_kernel_replay_goal_search_text_equal(node.kind, "binary", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary
            less: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "<", work_used)
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "<=", work_used)
            greater: bool = proof_kernel_replay_goal_search_text_equal(node.operator, ">", work_used)
            greater_equal: bool = proof_kernel_replay_goal_search_text_equal(node.operator, ">=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, goal, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if not goal_admission.complete or goal_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_has_order_fact_with_work(nodes, children, node.left, node.right, true, facts, work_used) if less
            return proof_kernel_replay_has_order_fact_with_work(nodes, children, node.left, node.right, false, facts, work_used) if less_equal
            return proof_kernel_replay_has_order_fact_with_work(nodes, children, node.right, node.left, true, facts, work_used) if greater
            return proof_kernel_replay_has_order_fact_with_work(nodes, children, node.right, node.left, false, facts, work_used) if greater_equal
            false

        def proof_kernel_replay_unsigned_nonzero_lower_bound_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            binary: bool = proof_kernel_replay_goal_search_text_equal(goal.kind, "binary", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "<=", work_used)
            less: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, "<", work_used)
            greater_equal: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, ">=", work_used)
            greater: bool = proof_kernel_replay_goal_search_text_equal(goal.operator, ">", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (not less_equal and not less and not greater_equal and not greater)
            a: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, goal.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            b: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, goal.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            term: mutable usize = goal.right
            if a.known and (((less_equal and a.value == 1) or (less and a.value == 0))):
                term <- goal.right
            elif b.known and (((greater_equal and b.value == 1) or (greater and b.value == 0))):
                term <- goal.left
            else:
                return false
            width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, term, facts, work_used, 0)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                width == 0 or not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, goal.left, goal.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact_root in facts |fact_root, nodes, children, facts, term, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: mutable ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                negated: mutable bool = false
                unary: bool = proof_kernel_replay_goal_search_text_equal(fact.kind, "unary", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                is_not: mutable bool = false
                is_not <- proof_kernel_replay_goal_search_text_equal(fact.operator, "not", work_used) if unary
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if unary and is_not:
                    continue if not proof_kernel_replay_valid(nodes, fact.left)
                    return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.left, work_used)
                    fact <- nodes[fact.left]
                    negated <- true
                binary_fact: bool = proof_kernel_replay_goal_search_text_equal(fact.kind, "binary", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                disequality: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, "!=", work_used) if not negated else false
                equality: bool = proof_kernel_replay_goal_search_text_equal(fact.operator, "==", work_used) if negated else false
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not binary_fact or (not negated and not disequality) or (negated and not equality)
                continue if not proof_kernel_replay_valid(nodes, fact.left) or not proof_kernel_replay_valid(nodes, fact.right)
                continue if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                x: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, fact.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                y: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, fact.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if:
                    x.known and x.value == 0 and proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.right, term, work_used)
                    y.known and y.value == 0 and proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.left, term, work_used)
            return false
