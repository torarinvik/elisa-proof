extend ElisaProofKernelReplay:
    private:
        # A scalar reference is a one-element place. Admit only the literal zero subscript;
        # dynamic/raw-pointer offsets need a separate extent proof and stay unknown here.
        def proof_kernel_replay_scalar_reference_index_sort(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, object_root: usize, index_root: usize, depth: usize, work: mutable usize&) -> ProofKernelInferredSort:
            return proof_kernel_replay_unknown_sort() if object_root >= nodes.count or index_root >= nodes.count
            object_name: sview = proof_kernel_replay_symbol_name(nodes, object_root, depth + 1, work)
            return proof_kernel_replay_unknown_sort() if object_name == ""
            offset: ElisaProofKernelCore::ProofKernelNode = nodes[index_root]
            return proof_kernel_replay_unknown_sort() if offset.kind != "int" or offset.value != 0
            binding: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_value_binding(environment, typing_index, object_name, work)
            return proof_kernel_replay_unknown_sort() if not binding.known or not binding.binding.parameter_by_reference
            result: ProofKernelInferredSort = proof_kernel_replay_binding_sort(binding.binding)
            return result if proof_kernel_replay_numeric_sort(result)
            return proof_kernel_replay_unknown_sort()

        # A container's element sort, or else a scalar reference read at its only offset.
        def proof_kernel_replay_index_or_scalar_reference_sort(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, receiver: ProofKernelInferredSort, object_root: usize, index_root: usize, depth: usize, work: mutable usize&) -> ProofKernelInferredSort:
            container_element: ProofKernelInferredSort = proof_kernel_replay_index_element_sort(receiver, environment, work)
            return container_element if container_element.known
            return proof_kernel_replay_scalar_reference_index_sort(nodes, environment, typing_index, object_root, index_root, depth, work)
