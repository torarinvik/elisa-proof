extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_TYPING_DEPTH_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
        # These entry points consume different amounts of recursive headroom before they
        # descend into a callee or argument. Derive every threshold from the one replay limit;
        # independent literals here could silently widen one typing path past the kernel bound.
        const PROOF_KERNEL_ARGUMENT_DEPTH_PRECONDITION: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 2
        const PROOF_KERNEL_ARGUMENT_DEPTH_GUARD: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 1
        const PROOF_KERNEL_FUNCTION_DEPTH_PRECONDITION: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 3
        const PROOF_KERNEL_CALL_DEPTH_PRECONDITION: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 5
        const PROOF_KERNEL_CALL_DEPTH_GUARD: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 4

        struct ProofKernelInferredSort:
            known: bool
            family: sview
            name: sview
            element_family: sview
            element_name: sview
            type_identity: usize
            element_type_identity: usize

        def proof_kernel_replay_type_work_consume(work: mutable usize&) -> bool:
            ensure result == (work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET)
            if work >= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET:
                work <- ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET + 1
                return false
            work <- work + 1
            return true

        # A fresh proposition always visits at least its goal root. Refuse at the boundary
        # before an adapter performs unrelated arena admission, and preserve the usual
        # budget-exhausted sentinel in the caller's cumulative counter.
        def proof_kernel_replay_type_work_refuse_at_limit(work: mutable usize&) -> bool:
            return true if work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            if work == ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET:
                work <- ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET + 1
                return true
            return false

        def proof_kernel_replay_unknown_sort() -> ProofKernelInferredSort:
            return ProofKernelInferredSort{known: false, family: "", name: "", element_family: "", element_name: "", type_identity: 0, element_type_identity: 0}

        def proof_kernel_replay_known_sort(family: sview, name: sview) -> ProofKernelInferredSort:
            return ProofKernelInferredSort{known: family != "", family: family, name: name, element_family: "", element_name: "", type_identity: 0, element_type_identity: 0}

        def proof_kernel_replay_identity_sort(family: sview, name: sview, identity: usize) -> ProofKernelInferredSort:
            return ProofKernelInferredSort{known: family != "" and identity != 0, family: family, name: name, element_family: "", element_name: "", type_identity: identity, element_type_identity: 0}

        def proof_kernel_replay_required_identity_present(identity_required: bool, identity: usize) -> bool:
            ensure not result or not identity_required or identity != 0
            if identity_required:
                if identity != 0:
                    return true
                return false
            return identity == 0

        def proof_kernel_replay_container_element_identity_valid(element_family: sview, element_name: sview, element_identity: usize) -> bool:
            identity_required: bool = element_family in {"named", "container"} or (element_family == "aggregate" and element_name == "tuple")
            return element_family != "" and proof_kernel_replay_required_identity_present(identity_required, element_identity)

        def proof_kernel_replay_container_sort(name: sview, element_family: sview, element_name: sview) -> ProofKernelInferredSort:
            valid_element: bool = proof_kernel_replay_container_element_identity_valid(element_family, element_name, 0)
            return ProofKernelInferredSort{known: name != "" and valid_element, family: "container", name: name, element_family: element_family, element_name: element_name, type_identity: 0, element_type_identity: 0}

        def proof_kernel_replay_container_identity_sort(name: sview, element_family: sview, element_name: sview, element_identity: usize) -> ProofKernelInferredSort:
            valid_element: bool = proof_kernel_replay_container_element_identity_valid(element_family, element_name, element_identity)
            return ProofKernelInferredSort{known: name != "" and valid_element, family: "container", name: name, element_family: element_family, element_name: element_name, type_identity: 0, element_type_identity: element_identity}

        def proof_kernel_replay_numeric_sort(sort: ProofKernelInferredSort) -> bool:
            return sort.family in {"integer", "floating", "character"}

        def proof_kernel_replay_integral_sort(sort: ProofKernelInferredSort) -> bool:
            return sort.family == "integer"

        def proof_kernel_replay_sort_equal(left: ProofKernelInferredSort, right: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if:
                not left.known or not right.known
                not proof_kernel_replay_type_text_equal(left.family, right.family, work)
            # This fixed tag comparison is length-bounded by the literal; dynamic name fields
            # below use the shared byte meter.
            is_container: bool = left.family == "container"
            return proof_kernel_replay_type_text_equal(left.name, right.name, work) and proof_kernel_replay_type_text_equal(left.element_family, right.element_family, work) and proof_kernel_replay_type_text_equal(left.element_name, right.element_name, work) and left.element_type_identity == right.element_type_identity if is_container
            return proof_kernel_replay_type_text_equal(left.name, right.name, work) and proof_kernel_replay_type_text_equal(left.element_family, right.element_family, work) and proof_kernel_replay_type_text_equal(left.element_name, right.element_name, work) and left.type_identity == right.type_identity and left.element_type_identity == right.element_type_identity

        def proof_kernel_replay_binding_sort(binding: ElisaProofKernelCore::ProofKernelTypingBinding) -> ProofKernelInferredSort:
            return ProofKernelInferredSort{known: binding.type_name != "" and binding.element_sort != "", family: "container", name: binding.type_name, element_family: binding.element_sort, element_name: binding.element_type_name, type_identity: binding.type_identity, element_type_identity: binding.element_type_identity} if binding.sort == "container"
            return proof_kernel_replay_identity_sort(binding.sort, binding.type_name, binding.type_identity) if binding.type_identity != 0
            return proof_kernel_replay_known_sort(binding.sort, binding.type_name)

        def proof_kernel_replay_typing_evidence_equal(left: ElisaProofKernelCore::ProofKernelTypingBinding, right: ElisaProofKernelCore::ProofKernelTypingBinding, work: mutable usize&) -> bool:
            return proof_kernel_replay_type_text_equal(left.kind, right.kind, work) and proof_kernel_replay_type_text_equal(left.name, right.name, work) and proof_kernel_replay_type_text_equal(left.owner, right.owner, work) and proof_kernel_replay_type_text_equal(left.sort, right.sort, work) and proof_kernel_replay_type_text_equal(left.type_name, right.type_name, work) and proof_kernel_replay_type_text_equal(left.element_sort, right.element_sort, work) and proof_kernel_replay_type_text_equal(left.element_type_name, right.element_type_name, work) and left.type_identity == right.type_identity and left.owner_type_identity == right.owner_type_identity and left.element_type_identity == right.element_type_identity and left.signature_identity == right.signature_identity and left.parameter_index == right.parameter_index and left.parameter_count == right.parameter_count and left.parameter_has_default == right.parameter_has_default and left.parameter_by_reference == right.parameter_by_reference

        def proof_kernel_replay_find_typing_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, kind: sview, name: sview, owner: sview, owner_type_identity: usize, match_owner: bool, filter_type_identity: usize, filter_sort: sview, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            ensure result.known implies work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            ensure result.known implies (
                result.binding.kind == kind
                and result.binding.name == name
                and (not match_owner or result.binding.owner == owner)
                and (not match_owner or result.binding.owner_type_identity == owner_type_identity)
            )
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return (false, selected) if index.value_overlay_count > total_bindings
            return (false, selected) if:
                (kind != "type" and kind != "field" and kind != "enum-member")
                index.source_binding_count != total_bindings or index.declaration_binding_capacity != index.declaration_binding_heads.count
                index.declaration_binding_next.count != total_bindings - index.value_overlay_count
                not proof_kernel_replay_type_work_consume_amount(sview_len(kind), work)
                not proof_kernel_replay_type_work_consume_amount(sview_len(name), work)
                not proof_kernel_replay_type_work_consume_amount(sview_len(owner), work)
                not proof_kernel_replay_type_work_consume_amount(sview_len(filter_sort), work)
            return (false, selected) if index.declaration_binding_capacity == 0 and index.declaration_binding_next.count != 0
            return (false, selected) if index.declaration_binding_capacity == 0
            hash: u32 = proof_kernel_replay_declaration_key_hash(kind, name, owner, owner_type_identity)
            slot: usize = (hash.i64() % index.declaration_binding_capacity.i64()).usize()
            row: mutable usize = index.declaration_binding_heads[slot]
            probes: mutable usize = 0
            return (false, selected) if row > index.declaration_binding_next.count
            while row != index.declaration_binding_next.count and probes < index.declaration_binding_next.count |row, probes, environment, index, total_bindings, kind, name, owner, owner_type_identity, found, ambiguous, selected, work|:
                return (false, selected) if row >= total_bindings or row >= index.declaration_binding_next.count or not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, row)
                if proof_kernel_replay_type_text_equal(binding.kind, kind, work) and proof_kernel_replay_type_text_equal(binding.name, name, work) and (not match_owner or (proof_kernel_replay_type_text_equal(binding.owner, owner, work) and binding.owner_type_identity == owner_type_identity)) and (filter_type_identity == 0 or binding.type_identity == filter_type_identity) and (filter_sort == "" or proof_kernel_replay_type_text_equal(binding.sort, filter_sort, work)):
                    if not found:
                        selected <- binding
                        found <- true
                    elif not proof_kernel_replay_typing_evidence_equal(selected, binding, work):
                        ambiguous <- true
                row <- index.declaration_binding_next[row]
                return (false, selected) if row > index.declaration_binding_next.count
                probes <- probes + 1
            return (false, selected) if row != index.declaration_binding_next.count
            return (false, selected) if work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return (found and not ambiguous, selected)

        # The call-place check only needs to know whether an enum tag exists for this exact
        # owner. Enum-tag buckets are keyed by owner identity, so avoid scanning unrelated rows.
        def proof_kernel_replay_enum_tag_owner_present(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, owner: sview, owner_identity: usize, work: mutable usize&) -> (known: bool, present: bool):
            ensure result.known implies work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            total: usize = proof_kernel_replay_type_environment_binding_count(environment)
            return (false, false) if index.value_overlay_count > total
            return (false, false) if:
                owner == "" or owner_identity == 0
                index.source_binding_count != total or index.declaration_binding_capacity != index.declaration_binding_heads.count
                index.declaration_binding_next.count != total - index.value_overlay_count
                not proof_kernel_replay_type_work_consume_amount(sview_len(owner), work)
            return (true, false) if index.declaration_binding_capacity == 0 and index.declaration_binding_next.count == 0
            return (false, false) if index.declaration_binding_capacity == 0
            hash: u32 = proof_kernel_replay_declaration_key_hash("enum-tag", "", owner, owner_identity)
            slot: usize = (hash.i64() % index.declaration_binding_capacity.i64()).usize()
            row: mutable usize = index.declaration_binding_heads[slot]
            probes: mutable usize = 0
            return (false, false) if row > index.declaration_binding_next.count
            while row != index.declaration_binding_next.count and probes < index.declaration_binding_next.count |row, probes, environment, index, total, owner, owner_identity, work|:
                return (false, false) if row >= total or row >= index.declaration_binding_next.count or not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, row)
                if binding.kind == "enum-tag" and binding.type_identity == owner_identity and binding.owner_type_identity == owner_identity and proof_kernel_replay_type_text_equal(binding.owner, owner, work):
                    return (true, true) if work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                    return (false, false)
                row <- index.declaration_binding_next[row]
                return (false, false) if row > index.declaration_binding_next.count
                probes <- probes + 1
            return (false, false) if row != index.declaration_binding_next.count or work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return (true, false)


        def proof_kernel_replay_symbol_name_root(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize, work: mutable usize&) -> usize:
            return nodes.count if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or root >= nodes.count
                not proof_kernel_replay_type_work_consume(work)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return nodes.count if (node.kind in {"ident", "scope"}) and node.name == ""
            return root if node.kind in {"ident", "scope"}
            return proof_kernel_replay_symbol_name_root(nodes, node.left, depth + 1, work) if node.kind == "paren"
            return nodes.count

        def proof_kernel_replay_symbol_matches_name(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, expected: sview, depth: usize, work: mutable usize&) -> bool:
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or root >= nodes.count
                not proof_kernel_replay_type_work_consume(work)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_type_text_equal(node.name, expected, work) if node.kind in {"ident", "scope"}
            return proof_kernel_replay_symbol_matches_name(nodes, node.left, expected, depth + 1, work) if node.kind == "paren"
            return false

        def proof_kernel_replay_child_root(node_count: usize, children: darray[usize]&, node: ElisaProofKernelCore::ProofKernelNode, offset: usize) -> usize:
            # A failed lookup must not borrow a valid node index from either arena.
            invalid_root: usize = node_count
            return invalid_root if offset >= node.children_count or node.children_start > children.count
            return invalid_root if offset >= children.count - node.children_start
            return children[node.children_start + offset]

        def proof_kernel_replay_container_descriptor_matches(binding: ElisaProofKernelCore::ProofKernelTypingBinding, name: sview, identity: usize, work: mutable usize&) -> bool:
            ensure result == (binding.kind == "type" and binding.sort == "container" and binding.name == name and binding.type_identity == identity and work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET)
            return false if:
                binding.kind != "type"
                binding.sort != "container"
                not proof_kernel_replay_type_text_equal(binding.name, name, work)
                binding.type_identity != identity
            assert binding.kind == "type"
            assert binding.sort == "container"
            assert binding.type_identity == identity
            return true

        def proof_kernel_replay_container_descriptor(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, name: sview, identity: usize, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            ensure result.known implies result.binding.kind == "type" and result.binding.sort == "container" and result.binding.name == name and result.binding.type_identity == identity
            selected: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, index, "type", name, "", 0, true, identity, "container", work)
            selected_matches_query: bool = proof_kernel_replay_container_descriptor_matches(selected.binding, name, identity, work) if selected.known else false
            return (selected.known and selected_matches_query, selected.binding)

        def proof_kernel_replay_index_element_sort(receiver: ProofKernelInferredSort, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, work: mutable usize&) -> ProofKernelInferredSort:
            # Source typing infers string indexing (`cstr`, `dstr`, or `sview`) as
            # `char`; the backend's i64 representation is not the source-level sort.
            return proof_kernel_replay_known_sort("character", "char") if receiver.known and receiver.family == "string"
            return proof_kernel_replay_unknown_sort() if not receiver.known or receiver.family != "container"
            if receiver.type_identity != 0:
                descriptor: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_container_descriptor(environment, typing_index, receiver.name, receiver.type_identity, work)
                return proof_kernel_replay_unknown_sort() if not descriptor.known or descriptor.binding.sort != "container"
                return proof_kernel_replay_identity_sort(descriptor.binding.element_sort, descriptor.binding.element_type_name, descriptor.binding.element_type_identity) if descriptor.binding.element_type_identity != 0
                return proof_kernel_replay_known_sort(descriptor.binding.element_sort, descriptor.binding.element_type_name)
            return proof_kernel_replay_identity_sort(receiver.element_family, receiver.element_name, receiver.element_type_identity) if receiver.element_type_identity != 0
            return proof_kernel_replay_known_sort(receiver.element_family, receiver.element_name)

        def proof_kernel_replay_element_sort(binding: ElisaProofKernelCore::ProofKernelTypingBinding) -> ProofKernelInferredSort:
            return proof_kernel_replay_identity_sort(binding.element_sort, binding.element_type_name, binding.element_type_identity) if binding.element_type_identity != 0
            return proof_kernel_replay_known_sort(binding.element_sort, binding.element_type_name)

        def proof_kernel_replay_find_function_parameter_by_index(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, function: ElisaProofKernelCore::ProofKernelTypingBinding, requested_index: usize, work: mutable usize&) -> (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding):
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            parameter_count: usize = index.function_parameter_count
            return (false, selected) if:
                index.source_binding_count != proof_kernel_replay_type_environment_binding_count(environment) or parameter_count != index.function_parameter_indices.count or parameter_count != index.function_parameter_next_indices.count or parameter_count != index.function_parameter_bucket_heads.count or parameter_count == 0
                not proof_kernel_replay_type_work_consume_amount(sview_len(function.name), work)
            owner_name_hash: u32 = proof_kernel_replay_name_owner_hash(function.name, function.owner_type_identity)
            parameter_hash: u32 = proof_kernel_replay_identity_hash_mix(owner_name_hash, function.signature_identity)
            slot: usize = (parameter_hash.i64() % parameter_count.i64()).usize()
            parameter_offset: mutable usize = index.function_parameter_bucket_heads[slot]
            while parameter_offset < parameter_count |parameter_offset, environment, index, function, requested_index, found, ambiguous, selected, work, parameter_count|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding_index: usize = index.function_parameter_indices[parameter_offset]
                return (false, selected) if binding_index >= index.source_binding_count
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                return (false, selected) if binding.kind != "function-parameter"
                if proof_kernel_replay_type_text_equal(binding.owner, function.name, work) and binding.owner_type_identity == function.owner_type_identity and binding.signature_identity == function.signature_identity and binding.parameter_index == requested_index:
                    if found:
                        ambiguous <- true
                    else:
                        selected <- binding
                        found <- true
                parameter_offset <- index.function_parameter_next_indices[parameter_offset]
            return (found and not ambiguous, selected)

        def proof_kernel_replay_find_function_parameter_by_name(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayTypingIndex, function: ElisaProofKernelCore::ProofKernelTypingBinding, requested_name: sview, work: mutable usize&) -> (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding):
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            parameter_count: usize = index.function_parameter_count
            return (false, selected) if:
                index.source_binding_count != proof_kernel_replay_type_environment_binding_count(environment) or parameter_count != index.function_parameter_indices.count or parameter_count != index.function_parameter_next_indices.count or parameter_count != index.function_parameter_bucket_heads.count or parameter_count == 0
                not proof_kernel_replay_type_work_consume_amount(sview_len(function.name), work)
            owner_name_hash: u32 = proof_kernel_replay_name_owner_hash(function.name, function.owner_type_identity)
            parameter_hash: u32 = proof_kernel_replay_identity_hash_mix(owner_name_hash, function.signature_identity)
            slot: usize = (parameter_hash.i64() % parameter_count.i64()).usize()
            parameter_offset: mutable usize = index.function_parameter_bucket_heads[slot]
            while parameter_offset < parameter_count |parameter_offset, environment, index, function, requested_name, found, ambiguous, selected, work, parameter_count|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding_index: usize = index.function_parameter_indices[parameter_offset]
                return (false, selected) if binding_index >= index.source_binding_count
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                return (false, selected) if binding.kind != "function-parameter"
                if proof_kernel_replay_type_text_equal(binding.owner, function.name, work) and binding.owner_type_identity == function.owner_type_identity and binding.signature_identity == function.signature_identity and proof_kernel_replay_type_text_equal(binding.name, requested_name, work):
                    if found:
                        ambiguous <- true
                    else:
                        selected <- binding
                        found <- true
                parameter_offset <- index.function_parameter_next_indices[parameter_offset]
            return (found and not ambiguous, selected)

        def proof_kernel_replay_typing_binding_valid(binding: ElisaProofKernelCore::ProofKernelTypingBinding, work: mutable usize&) -> bool:
            ensure result implies work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            ensure result implies (
                binding.kind == "module-context" or binding.kind == "bare-call-owner" or binding.kind == "local-call-shadow"
                or binding.kind == "function-incomplete" or binding.kind == "module-owner-segment" or binding.kind == "value"
                or binding.kind == "reference-value" or binding.kind == "raw-reference-value" or binding.kind == "function"
                or binding.kind == "proposition" or binding.kind == "type" or binding.kind == "type-scope-segment"
                or binding.kind == "field" or binding.kind == "function-parameter" or binding.kind == "enum-member"
                or binding.kind == "enum-scope-segment" or binding.kind == "enum-tag" or binding.kind == "enum-underlying"
            )
            ensure binding.kind == "module-context" implies result == (
                work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                and binding.name == "" and binding.owner == "" and binding.sort == "" and binding.type_name == ""
                and binding.element_sort == "" and binding.element_type_name == "" and binding.type_identity == 0
                and binding.owner_type_identity != 0 and binding.element_type_identity == 0 and binding.signature_identity == 0
                and binding.parameter_index == 0 and binding.parameter_count == 0
                and not binding.parameter_has_default and not binding.parameter_by_reference
            )
            ensure binding.kind == "bare-call-owner" implies result == (
                work <= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                and binding.name != "" and binding.owner == "" and binding.sort == "" and binding.type_name == ""
                and binding.element_sort == "" and binding.element_type_name == "" and binding.type_identity == 0
                and binding.element_type_identity == 0 and binding.signature_identity == 0 and binding.parameter_index == 0
