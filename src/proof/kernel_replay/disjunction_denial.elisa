# Source-neutral replay of the denial hypotheses used for disjunction introduction.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_negated_boolean_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1 or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(goal)
            return false if goal.kind != "unary" or goal.operator != "not" or not proof_kernel_replay_valid(nodes, goal.left)
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            return false if not proof_kernel_replay_arena_shape_valid(inner)
            if inner.kind == "unary" and inner.operator == "not" and proof_kernel_replay_valid(nodes, inner.left):
                return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, inner.left, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return false if:
                inner.kind != "binary" or (inner.operator != "and" and inner.operator != "or")
                not proof_kernel_replay_denial_fragment_with_work(nodes, children, goal.left, facts, work_used, 0)
            left: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", inner.left, 0, 0, 0, 0, 0, "", "")
            right: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", inner.right, 0, 0, 0, 0, 0, "", "")
            transformed: usize = ElisaProofKernelCore::add_node(nodes, "binary", "or" if inner.operator == "and" else "and", left, right, 0, 0, 0, 0, "", "")
            return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, transformed, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        const PROOF_KERNEL_DISJUNCTION_DENIAL_FACT_LIMIT: usize = 64

        # Standalone callers own one lazy marker snapshot for the whole integer walk; denial
        # fragments pass their already-shared snapshot through nested numeric terms.
        def proof_kernel_replay_denial_integer_term_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&, depth: usize) -> bool:
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, root, facts, markers, markers_ready, work_used, depth)

        def proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, work_used: mutable usize&, depth: usize) -> bool:
            can Abort.Panic:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                return false if not proof_kernel_replay_arena_shape_valid(node)
                return true if node.kind == "int"
                return ElisaProofKernelCore::typed_literal_value(node).known if node.kind == "typed-int"
                if node.kind == "paren":
                    return proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, node.left, facts, markers, markers_ready, work_used, depth + 1)
                if node.kind == "binary" and node.operator == "/":
                    return false if:
                        node.left >= nodes.count or node.right >= nodes.count
                        not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                        not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.right, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
                    numerator: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                    denominator: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                    return false if numerator.kind != "int" or denominator.kind != "int" or numerator.value < 0 or denominator.value <= 0
                    scalar: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and scalar
                if node.kind == "binary" and node.operator == "*":
                    return false if not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    left_literal: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, node.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    right_literal: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, node.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, node.right, facts, markers, markers_ready, work_used, depth + 1) if left_literal.known and left_literal.value >= 0
                    return proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, node.left, facts, markers, markers_ready, work_used, depth + 1) if right_literal.known and right_literal.value >= 0
                    return false
                if node.kind == "binary" and (node.operator in {"+", "-"}):
                    return false if not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, node.left, facts, markers, markers_ready, work_used, depth + 1) and proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, node.right, facts, markers, markers_ready, work_used, depth + 1)
                if node.kind == "ident":
                    for fact in facts |fact, nodes, children, root, work_used|:
                        integer: (known: bool, root: usize) = proof_kernel_replay_marker_argument_with_goal_work(nodes, children, fact, "__elisa_primitive_integer_type", work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        if integer.known:
                            same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, integer.root, root, work_used)
                            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                            return true if same_term
                    if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                        return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        markers_ready <- true
                    return proof_kernel_replay_denial_name_width_with_markers_work(nodes, children, facts, markers, root, node.name, work_used)
                if node.kind == "tuple":
                    key: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key_with_goal_work(nodes, children, root, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return key.known and proof_kernel_replay_denial_term_width_with_work(nodes, children, facts, root, work_used)
                if node.kind == "call":
                    return false if not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return proof_kernel_replay_denial_term_width_with_work(nodes, children, facts, root, work_used)
                if node.kind == "field":
                    literal_count: ProofKernelReplayInt = proof_kernel_replay_constant_leaf_with_goal_work(nodes, node.kind, node.name, node.left, node.value, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if literal_count.known
                    return proof_kernel_replay_denial_term_width_with_work(nodes, children, facts, root, work_used)
                return false

        def proof_kernel_replay_marker_argument_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, callee: sview, work_used: mutable usize&) -> (known: bool, root: usize):
            return (false, 0) if:
                not proof_kernel_replay_goal_search_charge(work_used) or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[root].kind != "call"
            marker: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0) if:
                marker.operator != "" or marker.auxiliary != 0 or marker.children_count != 1 or not proof_kernel_replay_child_range_valid(marker.children_start, marker.children_count, children.count)
                marker.left >= nodes.count or not proof_kernel_replay_valid(nodes, marker.left) or not proof_kernel_replay_goal_search_charge_node_text(nodes, marker.left, work_used)
            matches: bool = proof_kernel_replay_goal_search_ident_matches(nodes, marker.left, callee, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not matches
            argument: (known: bool, value: usize) = proof_kernel_replay_index_at(children, marker.children_start)
            return (false, 0) if:
                not argument.known or argument.value >= nodes.count
            return (false, 0) if not proof_kernel_replay_valid(nodes, argument.value)
            return (false, 0) if:
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, argument.value, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[argument.value].kind != "call_arg"
            positional: bool = proof_kernel_replay_goal_search_text_equal(nodes[argument.value].name, "", work_used) and proof_kernel_replay_goal_search_text_equal(nodes[argument.value].secondary_name, "", work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not positional or not proof_kernel_replay_valid(nodes, nodes[argument.value].left)
            (true, nodes[argument.value].left)

        def proof_kernel_replay_ident_matches_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, expected: sview, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used) or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            matches: bool = proof_kernel_replay_goal_search_ident_matches(nodes, root, expected, work_used)
            work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and matches

        def proof_kernel_replay_denial_name_width_with_markers_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: darray[ProofKernelReplayWitnessMarker], root: usize, name: sview, work_used: mutable usize&) -> bool:
            unsigned_width: i64 = proof_kernel_replay_unsigned_width_from_markers_with_goal_work(markers, name, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if unsigned_width != 0
            signed_width: i64 = proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes, children, facts, root, work_used)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and signed_width != 0

        def proof_kernel_replay_denial_term_width_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            unsigned_width: i64 = proof_kernel_replay_linear_place_marker_width_with_work(nodes, children, facts, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if unsigned_width != 0
            signed_width: i64 = proof_kernel_replay_signed_marker_width_for_term_with_goal_work(nodes, children, facts, root, work_used)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and signed_width != 0

        # Integer result classification for order totality, independent of the
        # narrower arithmetic fragment admitted by disjunction-denial search.
        def proof_kernel_replay_order_integer_term_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            narrowed_integer: bool = proof_kernel_replay_denial_integer_term_with_work(nodes, children, root, facts, work_used, depth)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if narrowed_integer
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "typed-int":
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(node)
                return literal.known
            if node.kind == "scope":
                pinned: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_pins_goal_work(nodes, children, facts, root, work_used)
                return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and pinned.known
            if node.kind == "paren":
                return proof_kernel_replay_order_integer_term_with_work(nodes, children, node.left, facts, work_used, depth + 1)
            if node.kind == "if":
                then_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, node.right, facts, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not then_integer
                else_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, node.auxiliary, facts, work_used, depth + 1)
                return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and else_integer
            if node.kind == "unary" and node.operator == "-":
                scalar: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not scalar
                return proof_kernel_replay_order_integer_term_with_work(nodes, children, node.left, facts, work_used, depth + 1)
            if node.kind == "binary":
                integer_operator: bool = node.operator in {"+", "-", "*", "/", "%"}
                return false if not integer_operator
                scalar: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not scalar
                left_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, node.left, facts, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_integer
                right_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, node.right, facts, work_used, depth + 1)
                return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and right_integer
            if node.kind in {"index", "index-n"}:
                width: i64 = proof_kernel_replay_linear_element_width_with_work(nodes, children, facts, root, work_used)
                return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and width != 0
            false

        def proof_kernel_replay_denial_fragment_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&, depth: usize) -> bool:
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            proof_kernel_replay_denial_fragment_with_cached_markers_work(nodes, children, facts, markers, markers_ready, root, work_used, depth)

        def proof_kernel_replay_denial_fragment_with_cached_markers_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, root: usize, work_used: mutable usize&, depth: usize) -> bool:
            can Abort.Panic:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                return false if not proof_kernel_replay_arena_shape_valid(node)
                if node.kind in {"ident", "bool", "field", "scope", "index", "index-n"}:
                    return proof_kernel_replay_denial_value_closed_with_cached_markers_work(nodes, children, facts, markers, markers_ready, root, work_used, depth + 1)
                if node.kind == "call":
                    return proof_kernel_replay_denial_boolean_atom_witnessed_with_work(nodes, children, root, facts, work_used)
                if node.kind == "paren" or (node.kind == "unary" and node.operator == "not"):
                    return proof_kernel_replay_denial_fragment_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.left, work_used, depth + 1)
                if node.kind == "binary":
                    if node.operator in {"or", "and"}:
                        return proof_kernel_replay_denial_fragment_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.left, work_used, depth + 1) and proof_kernel_replay_denial_fragment_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.right, work_used, depth + 1)
                    equality: bool = node.operator in {"==", "!="}
                    ordering: bool = node.operator in {"<", "<=", ">", ">="}
                    if equality or ordering:
                        if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                            markers_ready <- true
                        relation_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        return false if not relation_admission.complete or relation_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    primitive: bool = (equality or ordering) and proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    integer_order: mutable bool = false
                    if ordering and primitive:
                        left_integer: bool = proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, node.left, facts, markers, markers_ready, work_used, depth + 1)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_integer
                        integer_order <- proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, node.right, facts, markers, markers_ready, work_used, depth + 1)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    null_equality: mutable bool = false
                    if equality:
                        left_null: bool = proof_kernel_replay_ident_matches_with_goal_work(nodes, node.left, "null", work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        right_null: bool = proof_kernel_replay_ident_matches_with_goal_work(nodes, node.right, "null", work_used) if not left_null else false
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        null_equality <- left_null or right_null
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    accepted: bool = (integer_order or (equality and (primitive or null_equality))) and proof_kernel_replay_denial_value_closed_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.left, work_used, depth + 1) and proof_kernel_replay_denial_value_closed_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.right, work_used, depth + 1)
                    return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and accepted
                return false

        def proof_kernel_replay_denial_value_closed_with_cached_markers_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, root: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            return true if node.kind in {"ident", "int", "float", "bool"}
            return proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, root, facts, markers, markers_ready, work_used, depth + 1) if node.kind == "tuple"
            return proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) if node.kind in {"call", "index", "index-n"}
            if node.kind == "binary" and (node.operator in {"+", "-", "/"}):
                return proof_kernel_replay_denial_integer_term_with_cached_markers_work(nodes, children, root, facts, markers, markers_ready, work_used, depth + 1)
            if node.kind in {"field", "scope", "paren"}:
                return proof_kernel_replay_denial_value_closed_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.left, work_used, depth + 1)
            if node.kind == "if":
                return proof_kernel_replay_denial_fragment_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.left, work_used, depth + 1) and proof_kernel_replay_denial_value_closed_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.right, work_used, depth + 1) and proof_kernel_replay_denial_value_closed_with_cached_markers_work(nodes, children, facts, markers, markers_ready, node.auxiliary, work_used, depth + 1)
            return false

        def proof_kernel_replay_denial_boolean_atom_witnessed_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, root, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                marker: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                continue if not proof_kernel_replay_arena_shape_valid(marker)
                continue if marker.kind != "call" or marker.operator != "" or marker.auxiliary != 0 or marker.children_count != 2
                marker_name_matches: bool = proof_kernel_replay_ident_matches_with_goal_work(nodes, marker.left, "__elisa_verified_total_bool_atom", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not marker_name_matches
                continue if not proof_kernel_replay_child_range_valid(marker.children_start, marker.children_count, children.count)
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                first: (known: bool, value: usize) = proof_kernel_replay_index_at(children, marker.children_start)
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                second: (known: bool, value: usize) = proof_kernel_replay_index_at(children, marker.children_start + 1)
                continue if not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, first.value, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, second.value, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                first_argument: ElisaProofKernelCore::ProofKernelNode = nodes[first.value]
                second_argument: ElisaProofKernelCore::ProofKernelNode = nodes[second.value]
                continue if not proof_kernel_replay_arena_shape_valid(first_argument) or not proof_kernel_replay_arena_shape_valid(second_argument)
                first_labels_empty: bool = proof_kernel_replay_goal_search_text_equal(first_argument.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(first_argument.secondary_name, "", work_used)
                second_labels_empty: bool = proof_kernel_replay_goal_search_text_equal(second_argument.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(second_argument.secondary_name, "", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if first_argument.kind != "call_arg" or not first_labels_empty or not proof_kernel_replay_valid(nodes, first_argument.left)
                continue if second_argument.kind != "call_arg" or not second_labels_empty or second_argument.left >= nodes.count
                return false if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, second_argument.left, work_used)
                string_argument: ElisaProofKernelCore::ProofKernelNode = nodes[second_argument.left]
                continue if not proof_kernel_replay_arena_shape_valid(string_argument) or string_argument.kind != "string"
                same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, first_argument.left, root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if same_term
            return false

        def proof_kernel_replay_push_disjunction_denial_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: mutable darray[usize]&, typing_facts: darray[usize], limit: usize, depth: usize, work_used: mutable usize&) -> bool:
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            proof_kernel_replay_push_disjunction_denial_with_cached_markers_work(nodes, children, root, facts, typing_facts, markers, markers_ready, limit, depth, work_used)

        def proof_kernel_replay_push_disjunction_denial_with_cached_markers_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: mutable darray[usize]&, typing_facts: darray[usize], markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, limit: usize, depth: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or facts.count >= limit or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_denial_fragment_with_cached_markers_work(nodes, children, typing_facts, markers, markers_ready, root, work_used, 0)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren":
                return proof_kernel_replay_push_disjunction_denial_with_cached_markers_work(nodes, children, node.left, facts, typing_facts, markers, markers_ready, limit, depth + 1, work_used)
            if node.kind == "unary" and node.operator == "not":
                return false if node.left >= nodes.count
                facts.push(node.left)
                return true
            if node.kind == "binary" and node.operator == "or":
                left_pushed: bool = proof_kernel_replay_push_disjunction_denial_with_cached_markers_work(nodes, children, node.left, facts, typing_facts, markers, markers_ready, limit, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_pushed
                return proof_kernel_replay_push_disjunction_denial_with_cached_markers_work(nodes, children, node.right, facts, typing_facts, markers, markers_ready, limit, depth + 1, work_used)
            denied_root: mutable usize = nodes.count
            if node.kind == "bool":
                denied_root <- ElisaProofKernelCore::add_node(nodes, "bool", "", 0, 0, 0, 0, 0, 1 if node.value == 0 else 0, "", "")
            elif node.kind == "binary":
                complement: sview = proof_kernel_replay_negation(node.operator)
                negatable: bool = proof_kernel_replay_negation_supported(node.operator)
                primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) if negatable else false
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                equality: bool = node.operator in {"==", "!="}
                left_null: bool = proof_kernel_replay_ident_matches_with_goal_work(nodes, node.left, "null", work_used) if equality else false
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_null: bool = proof_kernel_replay_ident_matches_with_goal_work(nodes, node.right, "null", work_used) if equality and not left_null else false
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                null_equality: bool = left_null or right_null
                complement_safe: mutable bool = equality
                if primitive and not equality:
                    left_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, node.left, typing_facts, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    right_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, node.right, typing_facts, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    complement_safe <- left_integer and right_integer
                # IEEE ordered comparisons are not Boolean complements when NaN is possible.
                # Only integer orderings (and equality/inequality) may be rewritten here;
                # otherwise retain an explicit `not` node as the denied proposition.
                if negatable and complement_safe and (primitive or null_equality):
                    denied_root <- ElisaProofKernelCore::add_node(nodes, "binary", complement, node.left, node.right, 0, 0, 0, 0, "", "")
                else:
                    denied_root <- ElisaProofKernelCore::add_node(nodes, "unary", "not", root, 0, 0, 0, 0, 0, "", "")
            else:
                denied_root <- ElisaProofKernelCore::add_node(nodes, "unary", "not", root, 0, 0, 0, 0, 0, "", "")
            return false if denied_root >= nodes.count
            facts.push(denied_root)
            return true
