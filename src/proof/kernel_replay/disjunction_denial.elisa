# Source-neutral replay of the denial hypotheses used for disjunction introduction.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_negated_boolean_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1 or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "unary" or goal.operator != "not" or not proof_kernel_replay_valid(nodes, goal.left)
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            if inner.kind == "unary" and inner.operator == "not" and proof_kernel_replay_valid(nodes, inner.left):
                return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, inner.left, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return false if inner.kind != "binary" or (inner.operator != "and" and inner.operator != "or")
            return false if not proof_kernel_replay_denial_fragment(nodes, children, goal.left, facts, 0)
            left: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", inner.left, 0, 0, 0, 0, 0, "", "")
            right: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", inner.right, 0, 0, 0, 0, 0, "", "")
            transformed: usize = ElisaProofKernelCore::add_node(nodes, "binary", "or" if inner.operator == "and" else "and", left, right, 0, 0, 0, 0, "", "")
            return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, transformed, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})

        const PROOF_KERNEL_DISJUNCTION_DENIAL_FACT_LIMIT: usize = 64

        def proof_kernel_replay_denial_integer_term(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "int"
            if node.kind == "paren":
                return proof_kernel_replay_denial_integer_term(nodes, children, node.left, facts, depth + 1)
            # Independently inspect both literal operands before admitting the quotient.
            if node.kind == "binary" and node.operator == "/":
                return false if node.left >= nodes.count or node.right >= nodes.count
                numerator: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                denominator: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                return numerator.kind == "int" and denominator.kind == "int" and numerator.value >= 0 and denominator.value > 0 and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0)
            if node.kind == "binary" and node.operator == "*" and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0):
                left_literal: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.left, 0)
                right_literal: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                return proof_kernel_replay_denial_integer_term(nodes, children, node.right, facts, depth + 1) if left_literal.known and left_literal.value >= 0
                return proof_kernel_replay_denial_integer_term(nodes, children, node.left, facts, depth + 1) if right_literal.known and right_literal.value >= 0
                return false
            if node.kind == "binary" and (node.operator == "+" or node.operator == "-"):
                return proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0) and proof_kernel_replay_denial_integer_term(nodes, children, node.left, facts, depth + 1) and proof_kernel_replay_denial_integer_term(nodes, children, node.right, facts, depth + 1)
            if node.kind == "ident":
                for fact in facts |nodes, children, root|:
                    integer = proof_kernel_replay_marker_argument(nodes, children, fact, "__elisa_primitive_integer_type")
                    return true if integer.known and proof_kernel_replay_expr_equal(nodes, children, integer.root, root, 0)
                return proof_kernel_replay_unsigned_marker_width_for_name(nodes, children, facts, node.name) != 0 or proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, root) != 0
            if node.kind == "call":
                return proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0) and (proof_kernel_replay_place_marker_width(nodes, children, facts, root) != 0 or proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, root) != 0)
            if node.kind == "tuple":
                key = proof_kernel_replay_loop_range_atom_key(nodes, children, root)
                return key.known and (proof_kernel_replay_place_marker_width(nodes, children, facts, root) != 0 or proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, root) != 0)
            if node.kind == "field":
                # Substitution replaces a literal-backed collection name with its
                # array value. Its count is still an integer even though the
                # original name's width marker no longer names this expression.
                # The constant leaf independently accepts only bounded array
                # lengths; arbitrary fields still require authenticated markers.
                literal_count: ProofKernelReplayInt = proof_kernel_replay_constant_leaf(nodes, node.kind, node.name, node.left, node.value)
                return true if literal_count.known
                return proof_kernel_replay_place_marker_width(nodes, children, facts, root) != 0 or proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, root) != 0
            return false

        # Integer result classification for order totality, independent of the
        # narrower arithmetic fragment admitted by disjunction-denial search.
        def proof_kernel_replay_order_integer_term(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            return true if proof_kernel_replay_denial_integer_term(nodes, children, root, facts, depth)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return ElisaProofKernelCore::typed_literal_value(node).known if node.kind == "typed-int"
            return proof_kernel_replay_constant_int_with_pins(nodes, children, facts, root).known if node.kind == "scope"
            if node.kind == "paren":
                return proof_kernel_replay_order_integer_term(nodes, children, node.left, facts, depth + 1)
            if node.kind == "if":
                return proof_kernel_replay_order_integer_term(nodes, children, node.right, facts, depth + 1) and proof_kernel_replay_order_integer_term(nodes, children, node.auxiliary, facts, depth + 1)
            if node.kind == "unary" and node.operator == "-":
                return proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0) and proof_kernel_replay_order_integer_term(nodes, children, node.left, facts, depth + 1)
            if node.kind == "binary":
                integer_operator: bool = node.operator == "+" or node.operator == "-" or node.operator == "*" or node.operator == "/" or node.operator == "%"
                return integer_operator and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0) and proof_kernel_replay_order_integer_term(nodes, children, node.left, facts, depth + 1) and proof_kernel_replay_order_integer_term(nodes, children, node.right, facts, depth + 1)
            return proof_kernel_replay_unsigned_element_width_for_expression(nodes, children, facts, root) != 0 if node.kind == "index" or node.kind == "index-n"
            return false

        def proof_kernel_replay_denial_value_closed(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "ident" or node.kind == "int" or node.kind == "float" or node.kind == "bool"
            return proof_kernel_replay_denial_integer_term(nodes, children, root, facts, depth + 1) if node.kind == "tuple"
            return proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0) if node.kind == "call"
            return proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, root, 0) if node.kind == "index" or node.kind == "index-n"
            if node.kind == "binary" and (node.operator == "+" or node.operator == "-" or node.operator == "/"):
                return proof_kernel_replay_denial_integer_term(nodes, children, root, facts, depth + 1)
            if node.kind == "field" or node.kind == "scope" or node.kind == "paren":
                return proof_kernel_replay_denial_value_closed(nodes, children, node.left, facts, depth + 1)
            if node.kind == "if":
                return proof_kernel_replay_denial_fragment(nodes, children, node.left, facts, depth + 1) and proof_kernel_replay_denial_value_closed(nodes, children, node.right, facts, depth + 1) and proof_kernel_replay_denial_value_closed(nodes, children, node.auxiliary, facts, depth + 1)
            return false

        def proof_kernel_replay_denial_boolean_atom_witnessed(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize]) -> bool:
            for fact in facts |fact, nodes, children, root|:
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                marker: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                continue if marker.kind != "call" or marker.operator != "" or marker.auxiliary != 0 or marker.children_count != 2
                continue if proof_kernel_replay_ident_name(nodes, marker.left) != "__elisa_verified_total_bool_atom"
                continue if not proof_kernel_replay_child_range_valid(marker.children_start, marker.children_count, children.count)
                first: (known: bool, value: usize) = proof_kernel_replay_index_at(children, marker.children_start)
                second: (known: bool, value: usize) = proof_kernel_replay_index_at(children, marker.children_start + 1)
                continue if not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
                first_argument: ElisaProofKernelCore::ProofKernelNode = nodes[first.value]
                second_argument: ElisaProofKernelCore::ProofKernelNode = nodes[second.value]
                continue if first_argument.kind != "call_arg" or first_argument.name != "" or first_argument.secondary_name != "" or not proof_kernel_replay_valid(nodes, first_argument.left)
                continue if second_argument.kind != "call_arg" or second_argument.name != "" or second_argument.secondary_name != "" or second_argument.left >= nodes.count or nodes[second_argument.left].kind != "string"
                return true if proof_kernel_replay_expr_equal(nodes, children, first_argument.left, root, 0)
            return false

        def proof_kernel_replay_denial_fragment(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident" or node.kind == "bool" or node.kind == "field" or node.kind == "scope" or node.kind == "index" or node.kind == "index-n":
                return proof_kernel_replay_denial_value_closed(nodes, children, root, facts, depth + 1)
            if node.kind == "call":
                return proof_kernel_replay_denial_boolean_atom_witnessed(nodes, children, root, facts)
            if node.kind == "paren" or (node.kind == "unary" and node.operator == "not"):
                return proof_kernel_replay_denial_fragment(nodes, children, node.left, facts, depth + 1)
            if node.kind == "binary":
                if node.operator == "or" or node.operator == "and":
                    return proof_kernel_replay_denial_fragment(nodes, children, node.left, facts, depth + 1) and proof_kernel_replay_denial_fragment(nodes, children, node.right, facts, depth + 1)
                equality: bool = node.operator == "==" or node.operator == "!="
                ordering: bool = node.operator == "<" or node.operator == "<=" or node.operator == ">" or node.operator == ">="
                integer_order: bool = ordering and proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right) and proof_kernel_replay_denial_integer_term(nodes, children, node.left, facts, depth + 1) and proof_kernel_replay_denial_integer_term(nodes, children, node.right, facts, depth + 1)
                null_equality: bool = equality and (proof_kernel_replay_ident_name(nodes, node.left) == "null" or proof_kernel_replay_ident_name(nodes, node.right) == "null")
                return (integer_order or (equality and (proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right) or null_equality))) and proof_kernel_replay_denial_value_closed(nodes, children, node.left, facts, depth + 1) and proof_kernel_replay_denial_value_closed(nodes, children, node.right, facts, depth + 1)
            return false

        def proof_kernel_replay_push_disjunction_denial(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: mutable darray[usize]&, typing_facts: darray[usize], limit: usize, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or facts.count >= limit
            return false if not proof_kernel_replay_denial_fragment(nodes, children, root, typing_facts, 0)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren":
                return proof_kernel_replay_push_disjunction_denial(nodes, children, node.left, facts, typing_facts, limit, depth + 1)
            if node.kind == "unary" and node.operator == "not":
                return false if node.left >= nodes.count
                facts.push(node.left)
                return true
            if node.kind == "binary" and node.operator == "or":
                return proof_kernel_replay_push_disjunction_denial(nodes, children, node.left, facts, typing_facts, limit, depth + 1) and proof_kernel_replay_push_disjunction_denial(nodes, children, node.right, facts, typing_facts, limit, depth + 1)
            denied_root: mutable usize = nodes.count
            if node.kind == "bool":
                denied_root <- ElisaProofKernelCore::add_node(nodes, "bool", "", 0, 0, 0, 0, 0, 1 if node.value == 0 else 0, "", "")
            elif node.kind == "binary":
                complement: sview = proof_kernel_replay_negation(node.operator)
                null_equality: bool = (node.operator == "==" or node.operator == "!=") and (proof_kernel_replay_ident_name(nodes, node.left) == "null" or proof_kernel_replay_ident_name(nodes, node.right) == "null")
                if proof_kernel_replay_negation_supported(node.operator) and (proof_kernel_replay_primitive_comparison(nodes, children, typing_facts, node.left, node.right) or null_equality):
                    denied_root <- ElisaProofKernelCore::add_node(nodes, "binary", complement, node.left, node.right, 0, 0, 0, 0, "", "")
                else:
                    denied_root <- ElisaProofKernelCore::add_node(nodes, "unary", "not", root, 0, 0, 0, 0, 0, "", "")
            else:
                denied_root <- ElisaProofKernelCore::add_node(nodes, "unary", "not", root, 0, 0, 0, 0, 0, "", "")
            return false if denied_root >= nodes.count
            facts.push(denied_root)
            return true
