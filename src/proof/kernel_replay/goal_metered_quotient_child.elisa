extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, width: i64, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count
            return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width <= 0 or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "int":
                return node.value >= 0 and node.value <= proof_kernel_replay_unsigned_width_max(width)
            if node.kind == "typed-int":
                literal = ElisaProofKernelCore::typed_literal_value(node)
                return literal.known and literal.unsigned and literal.width == width
            if node.kind == "ident" or node.kind == "field" or node.kind == "index" or node.kind == "index-n":
                return proof_kernel_replay_sum_peer_unsigned_width_with_goal_work(nodes, children, root, facts, work_used) == width
            if node.kind == "paren":
                return proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, node.left, width, work_used, depth + 1)
            if node.kind == "binary":
                plus: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "+", work_used)
                minus: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "-", work_used)
                multiply: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "*", work_used)
                divide: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "/", work_used)
                remainder: bool = proof_kernel_replay_goal_search_text_equal(node.operator, "%", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (not plus and not minus and not multiply and not divide and not remainder)
                left_safe: bool = proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, node.left, width, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_safe
                return proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, node.right, width, work_used, depth + 1)
            false

        def proof_kernel_replay_unsigned_quotient_child_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], child_root: usize, work_used: mutable usize&) -> (known: bool, base: usize, limit: usize, factor: i64, width: i64):
            unknown: (known: bool, base: usize, limit: usize, factor: i64, width: i64) = (false, 0, 0, 0, 0)
            increment: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, child_root, "+", work_used)
            return unknown if not increment.known
            one_left: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, increment.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            one_right: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, increment.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            product_root: mutable usize = increment.left
            one_root: mutable usize = increment.right
            if one_right.known and one_right.value == 1:
                product_root <- increment.left
            elif one_left.known and one_left.value == 1:
                product_root <- increment.right
                one_root <- increment.left
            else:
                return unknown
            product: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, product_root, "*", work_used)
            return unknown if not product.known
            factor_left: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, product.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            factor_right: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, product.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            base: mutable usize = product.left
            factor_expression: mutable usize = product.right
            factor: mutable i64 = factor_right.value
            if factor_right.known and factor_right.value >= 2:
                base <- product.left
                factor_expression <- product.right
            elif factor_left.known and factor_left.value >= 2:
                base <- product.right
                factor_expression <- product.left
                factor <- factor_left.value
            else:
                return unknown
            width: i64 = proof_kernel_replay_sum_peer_unsigned_width_with_goal_work(nodes, children, base, facts, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width <= 0 or factor > proof_kernel_replay_unsigned_width_max(width)
            return unknown if not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, child_root, width, work_used, 0)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, product_root, width, work_used, 0)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, factor_expression, width, work_used, 0)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, one_root, width, work_used, 0)
            quotient_facts: mutable darray[usize] = []
            proof_kernel_replay_conjunct_facts_with_goal_work(nodes, facts, &quotient_facts, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in quotient_facts |fact, nodes, children, facts, base, factor_expression, factor, width, work_used|:
                return unknown if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
                if fact_node.known and fact_node.node.kind == "unary" and fact_node.node.operator == "not":
                    return unknown if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_node.node.left, work_used)
                order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_work(nodes, children, facts, fact, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not order.known
                less: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<", work_used)
                greater: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">", work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (not less and not greater)
                quotient: mutable usize = 0
                if less:
                    same_base: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.left, base, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_base
                    quotient <- order.right
                else:
                    same_base: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.right, base, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_base
                    quotient <- order.left
                division: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, quotient, "/", work_used)
                continue if not division.known
                same_factor: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, division.right, factor_expression, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not same_factor
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, division.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not divisor.known or divisor.value != factor
                continue if not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, quotient, width, work_used, 0)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, division.left, width, work_used, 0)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, division.right, width, work_used, 0)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, order.left, width, work_used, 0)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_unsigned_contextual_term_width_with_goal_work(nodes, children, facts, order.right, width, work_used, 0)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, base, division.left, factor, width)
            unknown

        def proof_kernel_replay_unsigned_quotient_child_shape_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            binary: bool = proof_kernel_replay_goal_search_text_equal(nodes[goal_root].kind, "binary", work_used)
            greater: bool = proof_kernel_replay_goal_search_text_equal(nodes[goal_root].operator, ">", work_used)
            less: bool = proof_kernel_replay_goal_search_text_equal(nodes[goal_root].operator, "<", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary or (not greater and not less)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            witness: (known: bool, base: usize, limit: usize, factor: i64, width: i64) = proof_kernel_replay_unsigned_quotient_child_with_work(nodes, children, facts, goal.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not witness.known
            compared: usize = witness.base if greater else witness.limit
            proof_kernel_replay_goal_search_expr_equal(nodes, children, compared, goal.right, work_used) and work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
