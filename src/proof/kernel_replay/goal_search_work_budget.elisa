extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT: usize = 262144
        # A tactic trace can contain many individually bounded steps. Keep their combined
        # transition work bounded as well, while leaving headroom for ordinary multi-step proofs.
        const PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT: usize = 16777216

        def proof_kernel_replay_goal_search_charge(work_used: mutable usize&) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if work_used == PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            work_used <- work_used + 1
            true

        # Some bounded loops refuse before performing their next operation rather than charging
        # it. Preserve that refusal for status adapters while allowing a completed search to use
        # exactly the full budget without being reported as exhausted.
        def proof_kernel_replay_goal_search_refuse_at_limit(work_used: mutable usize&) -> bool:
            return true if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if work_used == PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return true
            false

        # Read a mutable-reference flag through an ordinary value context. This is useful for
        # lazy per-search caches whose readiness bit is shared by recursive helpers.
        def proof_kernel_replay_goal_bool_ref_value(value: mutable bool&) -> bool:
            can Abort.Panic:
                return value

        def proof_kernel_replay_goal_search_charge_amount(work_used: mutable usize&, amount: usize) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if amount > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - work_used:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            work_used <- work_used + amount
            true

        def proof_kernel_replay_goal_search_charge_product(work_used: mutable usize&, count: usize, factor: usize) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if count == 0 or factor == 0
            remaining: usize = PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - work_used
            if count > remaining / factor:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            amount: usize = count * factor
            proof_kernel_replay_goal_search_charge_amount(work_used, amount)

        def proof_kernel_replay_tactic_trace_charge(work_used: mutable usize&, amount: usize) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT
            if amount > PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT - work_used:
                work_used <- PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT + 1
                return false
            work_used <- work_used + amount
            true
