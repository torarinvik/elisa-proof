# Name equalities, affine terms and interval closure for kernel bound replay.
const PROOF_KERNEL_REPLAY_EQUALITY_CLOSURE_VISIT_LIMIT: usize = 65536
const PROOF_KERNEL_REPLAY_EQUALITY_REACHABILITY_FACT_LIMIT: usize = 256

extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_equality_closure_charge(work_used: mutable usize&, amount: usize, work_limit: usize) -> bool:
            ensure result implies work_used <= work_limit
            return false if work_used > work_limit
            if amount > work_limit - work_used:
                work_used <- work_limit + 1
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_replay_equality_closure_charge_text_entry(work_used: mutable usize&, text: sview, work_limit: usize) -> bool:
            ensure result implies work_used <= work_limit
            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
            proof_kernel_replay_equality_closure_charge(work_used, sview_len(text), work_limit)

        def proof_kernel_replay_equality_closure_charge_text_pair(work_used: mutable usize&, left: sview, right: sview, work_limit: usize) -> bool:
            ensure result implies work_used <= work_limit
            return false if:
                not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                not proof_kernel_replay_equality_closure_charge(work_used, sview_len(left), work_limit)
            proof_kernel_replay_equality_closure_charge(work_used, sview_len(right), work_limit)

        def proof_kernel_replay_name_equality_sort_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, sort_index: ProofKernelReplayEqualitySortIndex, work_used: mutable usize&, work_limit: usize) -> i64:
            return 0 if root >= nodes.count or nodes[root].kind != "ident"
            proof_kernel_replay_equality_sort_index_lookup(sort_index, nodes[root].name, work_used, work_limit)

        def proof_kernel_replay_collect_name_equalities_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, sort_index: ProofKernelReplayEqualitySortIndex, left_roots: mutable darray[usize]&, right_roots: mutable darray[usize]&, local_work_used: mutable usize&, work_used: mutable usize&, work_limit: usize, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            if local_work_used >= PROOF_KERNEL_REPLAY_EQUALITY_CLOSURE_VISIT_LIMIT:
                work_used <- work_limit + 1
                return
            return if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
            local_work_used <- local_work_used + 1
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return if not proof_kernel_replay_equality_closure_charge(work_used, sview_len(node.operator), work_limit)
            if node.kind == "binary" and node.operator == "and":
                proof_kernel_replay_collect_name_equalities_with_work(nodes, children, markers, node.left, sort_index, left_roots, right_roots, local_work_used, work_used, work_limit, depth + 1)
                return if work_used > work_limit
                proof_kernel_replay_collect_name_equalities_with_work(nodes, children, markers, node.right, sort_index, left_roots, right_roots, local_work_used, work_used, work_limit, depth + 1)
                return
            if node.kind == "binary" and node.operator == "==":
                return if node.left >= nodes.count or node.right >= nodes.count or nodes[node.left].kind != "ident" or nodes[node.right].kind != "ident"
                return if nodes[node.left].name == "" or nodes[node.right].name == ""
                if proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, work_limit):
                    left_sort: i64 = proof_kernel_replay_name_equality_sort_with_work(nodes, node.left, sort_index, work_used, work_limit)
                    return if work_used > work_limit
                    right_sort: i64 = proof_kernel_replay_name_equality_sort_with_work(nodes, node.right, sort_index, work_used, work_limit)
                    return if work_used > work_limit
                    if left_sort != 0 and left_sort == right_sort:
                        left_roots.push(node.left)
                        right_roots.push(node.right)

        def proof_kernel_replay_close_equalities(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            work_used: mutable usize = 0
            proof_kernel_replay_close_equalities_with_work(nodes, children, facts, bounds, &work_used, PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT)

        def proof_kernel_replay_close_equalities_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if work_used > work_limit
            left_roots: mutable darray[usize] = []
            right_roots: mutable darray[usize] = []
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            # Bound closure mirrors the producer and must consider every premise. The shared
            # kernel work limit below is the cap; a fixed prefix here would silently lose aliases
            # that the producer used to derive interval bounds.
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, work_limit)
            sort_index_result: (complete: bool, index: ProofKernelReplayEqualitySortIndex) = proof_kernel_replay_equality_sort_index_build(nodes, children, facts, work_used, work_limit)
            return false if not sort_index_result.complete
            local_work_used: mutable usize = 0
            for fact in facts |fact, nodes, children, markers, sort_index_result, left_roots, right_roots, local_work_used, work_used, work_limit|:
                proof_kernel_replay_collect_name_equalities_with_work(nodes, children, markers, fact, sort_index_result.index, &left_roots, &right_roots, &local_work_used, work_used, work_limit, 0)
                return false if work_used > work_limit
            names: mutable darray[sview] = []
            edge_left: mutable darray[usize] = []
            edge_right: mutable darray[usize] = []
            return false if left_roots.count != right_roots.count
            vertex_index_result: (complete: bool, index: ProofKernelReplayEqualityVertexIndex) = proof_kernel_replay_equality_vertex_index_build(left_roots.count, work_used, work_limit)
            return false if not vertex_index_result.complete
            vertex_index: mutable ProofKernelReplayEqualityVertexIndex = vertex_index_result.index
            for edge in 0..<left_roots.count |edge, left_roots, right_roots, nodes, names, edge_left, edge_right, vertex_index, work_used, work_limit|:
                return false if edge >= right_roots.count or left_roots[edge] >= nodes.count or right_roots[edge] >= nodes.count
                left_name: sview = nodes[left_roots[edge]].name
                right_name: sview = nodes[right_roots[edge]].name
                left_index: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, left_name, work_used, work_limit)
                return false if not left_index.complete
                left_value: usize = left_index.row
                right_index: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, right_name, work_used, work_limit)
                return false if not right_index.complete
                right_value: usize = right_index.row
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                edge_left.push(left_value)
                edge_right.push(right_value)

            adjacency_heads: mutable darray[usize] = []
            adjacency_names: mutable darray[usize] = []
            adjacency_next: mutable darray[usize] = []
            for name in names |name, adjacency_heads, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                adjacency_heads.push(0)
            for edge in 0..<edge_left.count |edge, edge_left, edge_right, adjacency_heads, adjacency_names, adjacency_next, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                adjacency_names.push(edge_right[edge])
                adjacency_next.push(adjacency_heads[edge_left[edge]])
                adjacency_heads[edge_left[edge]] <- adjacency_names.count
                adjacency_names.push(edge_left[edge])
                adjacency_next.push(adjacency_heads[edge_right[edge]])
                adjacency_heads[edge_right[edge]] <- adjacency_names.count

            visited: mutable darray[bool] = []
            for name_index in 0..<names.count |name_index, names, visited, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                visited.push(false)
            bound_rows: mutable darray[usize] = []
            bound_found: mutable darray[bool] = []
            for name_index in 0..<names.count |name_index, names, bound_rows, bound_found, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                bound_rows.push(0)
                bound_found.push(false)
            for bound_row in 0..<bounds.count |bound_row, bounds, names, vertex_index, bound_rows, bound_found, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                continue if bounds[bound_row].term_key or bounds[bound_row].name == ""
                vertex: (complete: bool, found: bool, row: usize) = proof_kernel_replay_equality_vertex_index_find(vertex_index, names, bounds[bound_row].name, work_used, work_limit)
                return false if not vertex.complete
                if vertex.found and not bound_found[vertex.row]:
                    bound_rows[vertex.row] <- bound_row
                    bound_found[vertex.row] <- true
            for start in 0..<names.count |start, names, adjacency_heads, adjacency_names, adjacency_next, visited, bounds, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                continue if visited[start]
                queue: mutable darray[usize] = [start]
                members: mutable darray[usize] = []
                visited[start] <- true
                cursor: mutable usize = 0
                while cursor < queue.count |cursor, queue, members, adjacency_heads, adjacency_names, adjacency_next, visited, work_used, work_limit|:
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    current: usize = queue[cursor]
                    members.push(current)
                    arc: mutable usize = adjacency_heads[current]
                    while arc != 0 |arc, adjacency_names, adjacency_next, queue, visited, work_used, work_limit|:
                        return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                        arc_index: usize = arc - 1
                        neighbor: usize = adjacency_names[arc_index]
                        if not visited[neighbor]:
                            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                            visited[neighbor] <- true
                            queue.push(neighbor)
                        arc <- adjacency_next[arc_index]
                    cursor <- cursor + 1

                has_lower: mutable bool = false
                lower: mutable i64 = 0
                has_upper: mutable bool = false
                upper: mutable i64 = 0
                for member in members |member, members, names, bounds, bound_rows, bound_found, has_lower, lower, has_upper, upper, work_used, work_limit|:
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    continue if not bound_found[member]
                    return false if bound_rows[member] >= bounds.count or bounds[bound_rows[member]].term_key or bounds[bound_rows[member]].name != names[member]
                    bound: ProofKernelReplayBound = bounds[bound_rows[member]]
                    if bound.has_lower and (not has_lower or bound.lower > lower):
                        has_lower <- true
                        lower <- bound.lower
                    if bound.has_upper and (not has_upper or bound.upper < upper):
                        has_upper <- true
                        upper <- bound.upper
                for member in members |member, members, names, bounds, bound_rows, bound_found, has_lower, lower, has_upper, upper, work_used, work_limit|:
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    if not bound_found[member] and (has_lower or has_upper):
                        return false if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, names[member], work_limit)
                        new_row: usize = bounds.count
                        bounds.push(ProofKernelReplayBound{name: names[member], term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: has_lower, lower: lower, has_upper: has_upper, upper: upper})
                        bound_rows[member] <- new_row
                        bound_found[member] <- true
                    elif bound_found[member]:
                        row: usize = bound_rows[member]
                        return false if row >= bounds.count or bounds[row].term_key or bounds[row].name != names[member]
                        if has_lower and (not bounds[row].has_lower or lower > bounds[row].lower):
                            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                            bounds[row].has_lower <- true
                            bounds[row].lower <- lower
                        if has_upper and (not bounds[row].has_upper or upper < bounds[row].upper):
                            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                            bounds[row].has_upper <- true
                            bounds[row].upper <- upper
            proof_kernel_replay_tighten_disequality_bounds_with_work(nodes, children, facts, bounds, work_used, work_limit)

        def proof_kernel_replay_names_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_name: sview, right_name: sview, facts: darray[usize]) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_names_equal_with_work(nodes, children, left_name, right_name, facts, &work_used, PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT)

        def proof_kernel_replay_names_equal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_name: sview, right_name: sview, facts: darray[usize], work_used: mutable usize&, work_limit: usize) -> bool:
            return false if:
                left_name == "" or right_name == ""
                not proof_kernel_replay_equality_closure_charge_text_pair(work_used, left_name, right_name, work_limit)
            return true if left_name == right_name
            left_roots: mutable darray[usize] = []
            right_roots: mutable darray[usize] = []
            bounded_facts: mutable darray[usize] = []
            fact_count: usize = facts.count if facts.count < PROOF_KERNEL_REPLAY_EQUALITY_REACHABILITY_FACT_LIMIT else PROOF_KERNEL_REPLAY_EQUALITY_REACHABILITY_FACT_LIMIT
            for index in 0..<fact_count |facts, bounded_facts, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                bounded_facts.push(facts[index])
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, bounded_facts, &markers, work_used, work_limit)
            sort_index_result: (complete: bool, index: ProofKernelReplayEqualitySortIndex) = proof_kernel_replay_equality_sort_index_build(nodes, children, bounded_facts, work_used, work_limit)
            return false if not sort_index_result.complete
            local_work_used: mutable usize = 0
            for fact in bounded_facts |fact, nodes, children, markers, sort_index_result, left_roots, right_roots, local_work_used, work_used, work_limit|:
                proof_kernel_replay_collect_name_equalities_with_work(nodes, children, markers, fact, sort_index_result.index, &left_roots, &right_roots, &local_work_used, work_used, work_limit, 0)
                return false if work_used > work_limit
            return false if left_roots.count != right_roots.count
            vertex_index_result: (complete: bool, index: ProofKernelReplayEqualityVertexIndex) = proof_kernel_replay_equality_vertex_index_build(left_roots.count, work_used, work_limit)
            return false if not vertex_index_result.complete
            vertex_index: mutable ProofKernelReplayEqualityVertexIndex = vertex_index_result.index
            names: mutable darray[sview] = []
            edge_left: mutable darray[usize] = []
            edge_right: mutable darray[usize] = []
            for edge in 0..<left_roots.count |edge, left_roots, right_roots, nodes, names, edge_left, edge_right, vertex_index, work_used, work_limit|:
                return false if left_roots[edge] >= nodes.count or right_roots[edge] >= nodes.count
                left_index: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, nodes[left_roots[edge]].name, work_used, work_limit)
                return false if not left_index.complete
                right_index: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, nodes[right_roots[edge]].name, work_used, work_limit)
                return false if not right_index.complete
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                edge_left.push(left_index.row)
                edge_right.push(right_index.row)
            start: (complete: bool, found: bool, row: usize) = proof_kernel_replay_equality_vertex_index_find(vertex_index, names, left_name, work_used, work_limit)
            return false if not start.complete or not start.found
            target: (complete: bool, found: bool, row: usize) = proof_kernel_replay_equality_vertex_index_find(vertex_index, names, right_name, work_used, work_limit)
            return false if not target.complete or not target.found
            adjacency_heads: mutable darray[usize] = []
            for vertex in 0..<names.count |vertex, names, adjacency_heads, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                adjacency_heads.push(0)
            adjacency_names: mutable darray[usize] = []
            adjacency_next: mutable darray[usize] = []
            for edge in 0..<edge_left.count |edge, edge_left, edge_right, adjacency_heads, adjacency_names, adjacency_next, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                adjacency_names.push(edge_right[edge])
                adjacency_next.push(adjacency_heads[edge_left[edge]])
                adjacency_heads[edge_left[edge]] <- adjacency_names.count
                adjacency_names.push(edge_left[edge])
                adjacency_next.push(adjacency_heads[edge_right[edge]])
                adjacency_heads[edge_right[edge]] <- adjacency_names.count
            visited: mutable darray[bool] = []
            for vertex in 0..<names.count |vertex, names, visited, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                visited.push(false)
            queue: mutable darray[usize] = [start.row]
            visited[start.row] <- true
            cursor: mutable usize = 0
            while cursor < queue.count |cursor, queue, adjacency_heads, adjacency_names, adjacency_next, visited, target, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                current: usize = queue[cursor]
                return true if current == target.row
                arc: mutable usize = adjacency_heads[current]
                while arc != 0 |arc, adjacency_names, adjacency_next, queue, visited, work_used, work_limit|:
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    neighbor: usize = adjacency_names[arc - 1]
                    if not visited[neighbor]:
                        return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                        visited[neighbor] <- true
                        queue.push(neighbor)
                    arc <- adjacency_next[arc - 1]
                cursor <- cursor + 1
            return false

        def proof_kernel_replay_affine_expression(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> ProofKernelReplayAffine:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            empty: ProofKernelReplayAffine = ProofKernelReplayAffine{known: false, base: "", offset: 0, negative: false}
            return empty if:
                not ElisaProofKernelCore::depth_valid(depth)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                root >= nodes.count
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, depth + 1)
            return ProofKernelReplayAffine{known: true, base: "", offset: constant.value, negative: false} if constant.known
            return empty if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return ProofKernelReplayAffine{known: true, base: node.name, offset: 0, negative: false} if node.kind == "ident" and node.name != ""
            return proof_kernel_replay_affine_expression(nodes, node.left, depth + 1) if node.kind == "unary" and node.operator == "+"
            if node.kind == "binary":
                left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.left, depth + 1)
                right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, depth + 1)
                if left.known and left.base != "" and right_constant.known:
                    if node.operator == "+":
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left.offset, right_constant.value)
                        return ProofKernelReplayAffine{known: true, base: left.base, offset: combined.value, negative: left.negative} if combined.known
                    if node.operator == "-":
                        negated: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, right_constant.value)
                        return empty if not negated.known
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left.offset, negated.value)
                        return ProofKernelReplayAffine{known: true, base: left.base, offset: combined.value, negative: left.negative} if combined.known
                left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.left, depth + 1)
                right_affine: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.right, depth + 1)
                if left_constant.known and right_affine.known and right_affine.base != "" and node.operator == "+":
                    combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, right_affine.offset)
                    return ProofKernelReplayAffine{known: true, base: right_affine.base, offset: combined.value, negative: right_affine.negative} if combined.known
                if left_constant.known and right_affine.known and right_affine.base != "" and node.operator == "-":
                    # Both affine forms are `sign * base + offset`. Subtracting either form
                    # always subtracts its offset; the sign only flips the base. Using addition
                    # for a negative right-hand form made `c - (-x + k)` look like `x + c + k`
                    # instead of the correct `x + c - k`, which could certify a false equality.
                    combined: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, right_affine.offset)
                    return ProofKernelReplayAffine{known: true, base: right_affine.base, offset: combined.value, negative: not right_affine.negative} if combined.known
            return empty

        # Mirror of the producer's bound propagation: `x - y <= c` with `y <= U` gives `x <= U + c`,
        # and with `x >= L` gives `y >= L - c`. Each step is an ordinary interval inference and can
        # only narrow an interval that already held. It runs to the same fixed point with the same
        # limit, so the kernel derives exactly the producer's intervals (BACKLOG C-01).
        const PROOF_KERNEL_REPLAY_BOUND_PROPAGATION_ROUND_LIMIT: usize = 33

        # Mirror of the producer's affine peer rule: `base + 1` is in range when a constraint says
        # `base < peer` and both carry the same unsigned width. Relational, so it needs no
        # representable interval.
        def proof_kernel_replay_affine_unsigned_peer_safe(affine: ProofKernelReplayAffine, constraints: darray[ProofKernelReplayDifference]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]) -> bool:
            return false if not affine.known or affine.negative or affine.offset != 1 or affine.base == ""
            width: i64 = proof_kernel_replay_unsigned_marker_width_for_name(nodes, children, facts, affine.base)
            return false if width == 0
            for constraint in constraints |constraint, affine, width, nodes, children, facts|:
                continue if constraint.left != affine.base or constraint.right == ""
                continue if constraint.bound > -1
                return true if proof_kernel_replay_unsigned_marker_width_for_name(nodes, children, facts, constraint.right) == width
            return false

        def proof_kernel_replay_close_bounds_through_differences(constraints: darray[ProofKernelReplayDifference]&, bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            return if constraints.count == 0
            for round in 0..<PROOF_KERNEL_REPLAY_BOUND_PROPAGATION_ROUND_LIMIT |round, constraints, bounds|:
                changed: mutable bool = false
                for constraint in constraints |constraint, bounds, changed|:
                    continue if constraint.left == "" or constraint.right == ""
                    right_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, constraint.right)
                    if right_bound.has_upper:
                        derived_upper: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_bound.upper, constraint.bound)
                        if derived_upper.known:
                            prior: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, constraint.left)
                            changed <- true if not prior.has_upper or derived_upper.value < prior.upper
                            proof_kernel_replay_add_upper(bounds, constraint.left, derived_upper.value)
                    left_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, constraint.left)
                    if left_bound.has_lower:
                        derived_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_bound.lower, constraint.bound)
                        if derived_lower.known:
                            prior: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, constraint.right)
                            changed <- true if not prior.has_lower or derived_lower.value > prior.lower
                            proof_kernel_replay_add_lower(bounds, constraint.right, derived_lower.value)
                break if not changed

        def proof_kernel_replay_affine_safe(affine: ProofKernelReplayAffine, bounds: darray[ProofKernelReplayBound]&) -> bool:
            return false if not affine.known
            return true if:
                affine.base == ""
                not affine.negative and affine.offset == 0
            bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, affine.base)
            if affine.negative:
                return false if not bound.has_lower or not bound.has_upper
                negated_upper: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, bound.upper)
                negated_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, bound.lower)
                return false if not negated_upper.known or not negated_lower.known
                lower: ProofKernelReplayInt = proof_kernel_replay_add_safe(negated_upper.value, affine.offset)
                upper: ProofKernelReplayInt = proof_kernel_replay_add_safe(negated_lower.value, affine.offset)
                return lower.known and upper.known
            if affine.offset > 0:
                limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(proof_kernel_replay_i64_max(), affine.offset)
                return limit.known and bound.has_upper and bound.upper <= limit.value
            limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(proof_kernel_replay_i64_min(), affine.offset)
            return limit.known and bound.has_lower and bound.lower >= limit.value

        def proof_kernel_replay_interval(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, bounds: darray[ProofKernelReplayBound]&, depth: usize) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (false, 0, 0, false, false) if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                root >= nodes.count
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, depth + 1)
            if constant.known:
                # A negative leaf can encode a large unsigned bit pattern, and an arithmetic
                # expression may wrap at a narrow width. Reuse the simplifier's cross-width-safe
                # subset, while retaining arbitrary direct nonnegative literal bounds.
                # A constant outside that subset, `-3` or `0 - 3`, is not refused outright: it
                # falls through to the structural rules below, which read it operation by
                # operation exactly as they read a non-constant term, under the same wrap
                # guards. Refusing it here left `y + -3` without an interval, so the signed
                # guard rejected a goal the producer (which reads every constant) had proved.
                # A typed full-width literal is a negative `int` leaf and still has no interval.
                safe_constant: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, root)
                return (true, safe_constant.value, safe_constant.value, true, true) if safe_constant.known
            return (false, 0, 0, false, false) if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            term_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for_term(nodes, children, bounds, root)
            return (term_bound.has_lower and term_bound.has_upper, term_bound.lower, term_bound.upper, term_bound.has_lower, term_bound.has_upper) if term_bound.term_key or term_bound.term_expression_key
            if node.kind == "ident":
                bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, node.name)
                return (bound.has_lower and bound.has_upper, bound.lower, bound.upper, bound.has_lower, bound.has_upper)
            if node.kind == "unary" and node.operator == "-":
                inner: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.left, bounds, depth + 1)
                negated_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, inner.upper)
                negated_upper: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, inner.lower)
                return (false, 0, 0, false, false) if not negated_lower.known or not negated_upper.known
                return (inner.has_lower and inner.has_upper, negated_lower.value, negated_upper.value, inner.has_upper, inner.has_lower)
            if node.kind == "binary" and node.operator == "+":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.left, bounds, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.right, bounds, depth + 1)
                lower_sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(a.lower, b.lower)
                upper_sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(a.upper, b.upper)
                has_lower: bool = a.has_lower and b.has_lower and lower_sum.known
                has_upper: bool = a.has_upper and b.has_upper and upper_sum.known
                return (has_lower and has_upper, lower_sum.value, upper_sum.value, has_lower, has_upper)
            if node.kind == "binary" and node.operator == "-":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.left, bounds, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.right, bounds, depth + 1)
                lower_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(a.lower, b.upper)
                upper_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(a.upper, b.lower)
                has_lower: bool = a.has_lower and b.has_upper and lower_difference.known
                has_upper: bool = a.has_upper and b.has_lower and upper_difference.known
                return (has_lower and has_upper, lower_difference.value, upper_difference.value, has_lower, has_upper)
            if node.kind == "binary" and node.operator == "*":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.left, bounds, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.right, bounds, depth + 1)
                return (false, 0, 0, false, false) if not a.has_lower or not a.has_upper or not b.has_lower or not b.has_upper
                p1: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.lower, b.lower)
                p2: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.lower, b.upper)
                p3: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.upper, b.lower)
                p4: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.upper, b.upper)
                return (false, 0, 0, false, false) if not p1.known or not p2.known or not p3.known or not p4.known
                lower: mutable i64 = p1.value
                lower <- p2.value if p2.value < lower
                lower <- p3.value if p3.value < lower
                lower <- p4.value if p4.value < lower
                upper: mutable i64 = p1.value
                upper <- p2.value if p2.value > upper
                upper <- p3.value if p3.value > upper
                upper <- p4.value if p4.value > upper
                return (true, lower, upper, true, true)
            if node.kind == "binary" and node.operator == "/":
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                dividend: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.left, bounds, depth + 1)
                if not divisor.known:
                    # A divisor bounded to a positive range: truncating division is monotone in
                    # each operand there, so the corners bound the quotient. No `MIN / -1` edge.
                    range: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, node.right, bounds, depth + 1)
                    return (false, 0, 0, false, false) if not range.has_lower or range.lower < 1 or not dividend.has_lower or not dividend.has_upper
                    # Mirror: with no upper divisor bound a non-negative dividend still floors at 0.
                    return (true, 0, dividend.upper / range.lower, true, true) if not range.has_upper and dividend.lower >= 0
                    return (false, 0, 0, false, false) if not range.has_upper
                    return (true, dividend.lower / range.upper, dividend.upper / range.lower, true, true) if dividend.lower >= 0
                    return (true, dividend.lower / range.lower, dividend.upper / range.upper, true, true) if dividend.upper <= 0
                    return (true, dividend.lower / range.lower, dividend.upper / range.lower, true, true)
                return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or not dividend.has_lower or not dividend.has_upper
                lower_quotient: ProofKernelReplayInt = proof_kernel_replay_div_safe(dividend.lower, divisor.value)
                upper_quotient: ProofKernelReplayInt = proof_kernel_replay_div_safe(dividend.upper, divisor.value)
                return (false, 0, 0, false, false) if not lower_quotient.known or not upper_quotient.known
                return (true, lower_quotient.value, upper_quotient.value, true, true) if divisor.value > 0
                return (true, upper_quotient.value, lower_quotient.value, true, true)
            if node.kind == "binary" and node.operator == "%":
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                # A bounded interval does not prove that the dividend excludes MIN_I64.
                # Reject divisor -1 because MIN_I64 % -1 is a fixed-width overflow edge.
                return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or divisor.value == -1
                magnitude: mutable i64 = divisor.value
                if magnitude < 0:
                    absolute: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, magnitude)
                    return (false, 0, 0, false, false) if not absolute.known
                    magnitude <- absolute.value
                limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(magnitude, 1)
                return (false, 0, 0, false, false) if not limit.known
                negative_limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, limit.value)
                return (false, 0, 0, false, false) if not negative_limit.known
                return (true, negative_limit.value, limit.value, true, true)
            return (false, 0, 0, false, false)
