# Name equalities, affine terms and interval closure for kernel bound replay.
const PROOF_KERNEL_REPLAY_EQUALITY_CLOSURE_VISIT_LIMIT: usize = 65536
const PROOF_KERNEL_REPLAY_EQUALITY_REACHABILITY_FACT_LIMIT: usize = 256

extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_equality_closure_charge(work_used: mutable usize&, amount: usize, work_limit: usize) -> bool:
            ensure result implies work_used <= work_limit
            return false if work_used > work_limit
            if amount > work_limit - work_used:
                work_used <- work_limit + 1
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_replay_equality_closure_charge_text_entry(work_used: mutable usize&, text: sview, work_limit: usize) -> bool:
            ensure result implies work_used <= work_limit
            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
            proof_kernel_replay_equality_closure_charge(work_used, sview_len(text), work_limit)

        def proof_kernel_replay_equality_closure_charge_text_pair(work_used: mutable usize&, left: sview, right: sview, work_limit: usize) -> bool:
            ensure result implies work_used <= work_limit
            return false if:
                not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                not proof_kernel_replay_equality_closure_charge(work_used, sview_len(left), work_limit)
            proof_kernel_replay_equality_closure_charge(work_used, sview_len(right), work_limit)

        def proof_kernel_replay_name_equality_sort_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, sort_index: ProofKernelReplayEqualitySortIndex, work_used: mutable usize&, work_limit: usize) -> i64:
            return 0 if root >= nodes.count
            return 0 if nodes[root].kind != "ident"
            proof_kernel_replay_equality_sort_index_lookup(sort_index, nodes[root].name, work_used, work_limit)

        def proof_kernel_replay_collect_name_equalities_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, sort_index: ProofKernelReplayEqualitySortIndex, left_roots: mutable darray[usize]&, right_roots: mutable darray[usize]&, local_work_used: mutable usize&, work_used: mutable usize&, work_limit: usize, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            if local_work_used >= PROOF_KERNEL_REPLAY_EQUALITY_CLOSURE_VISIT_LIMIT:
                work_used <- work_limit + 1
                return
            return if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
            local_work_used <- local_work_used + 1
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return if not proof_kernel_replay_equality_closure_charge(work_used, sview_len(node.operator), work_limit)
            if node.kind == "binary" and node.operator == "and":
                proof_kernel_replay_collect_name_equalities_with_work(nodes, children, markers, node.left, sort_index, left_roots, right_roots, local_work_used, work_used, work_limit, depth + 1)
                return if work_used > work_limit
                proof_kernel_replay_collect_name_equalities_with_work(nodes, children, markers, node.right, sort_index, left_roots, right_roots, local_work_used, work_used, work_limit, depth + 1)
                return
            if node.kind == "binary" and node.operator == "==":
                return if node.left >= nodes.count or node.right >= nodes.count
                return if nodes[node.left].kind != "ident" or nodes[node.right].kind != "ident"
                return if nodes[node.left].name == "" or nodes[node.right].name == ""
                admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, root, work_used, work_limit)
                if not admission.complete:
                    work_used <- work_limit + 1 if work_used <= work_limit
                    return
                return if admission.untrusted or work_used > work_limit
                if proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, work_limit):
                    left_sort: i64 = proof_kernel_replay_name_equality_sort_with_work(nodes, node.left, sort_index, work_used, work_limit)
                    return if work_used > work_limit
                    right_sort: i64 = proof_kernel_replay_name_equality_sort_with_work(nodes, node.right, sort_index, work_used, work_limit)
                    return if work_used > work_limit
                    if left_sort != 0 and left_sort == right_sort:
                        left_roots.push(node.left)
                        right_roots.push(node.right)

        def proof_kernel_replay_close_equalities_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if work_used > work_limit
            left_roots: mutable darray[usize] = []
            right_roots: mutable darray[usize] = []
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            # Bound closure mirrors the producer and must consider every premise. The shared
            # kernel work limit below is the cap; a fixed prefix here would silently lose aliases
            # that the producer used to derive interval bounds.
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, work_limit)
            sort_index_result: (complete: bool, index: ProofKernelReplayEqualitySortIndex) = proof_kernel_replay_equality_sort_index_build(nodes, children, facts, work_used, work_limit)
            return false if not sort_index_result.complete
            local_work_used: mutable usize = 0
            for fact in facts |fact, nodes, children, markers, sort_index_result, left_roots, right_roots, local_work_used, work_used, work_limit|:
                proof_kernel_replay_collect_name_equalities_with_work(nodes, children, markers, fact, sort_index_result.index, &left_roots, &right_roots, &local_work_used, work_used, work_limit, 0)
                return false if work_used > work_limit
            names: mutable darray[sview] = []
            edge_left: mutable darray[usize] = []
            edge_right: mutable darray[usize] = []
            return false if left_roots.count != right_roots.count
            vertex_index_result: (complete: bool, index: ProofKernelReplayEqualityVertexIndex) = proof_kernel_replay_equality_vertex_index_build(left_roots.count, work_used, work_limit)
            return false if not vertex_index_result.complete
            vertex_index: mutable ProofKernelReplayEqualityVertexIndex = vertex_index_result.index
            for edge in 0..<left_roots.count |edge, left_roots, right_roots, nodes, names, edge_left, edge_right, vertex_index, work_used, work_limit|:
                return false if edge >= right_roots.count or left_roots[edge] >= nodes.count or right_roots[edge] >= nodes.count
                left_name: sview = nodes[left_roots[edge]].name
                right_name: sview = nodes[right_roots[edge]].name
                left_index: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, left_name, work_used, work_limit)
                return false if not left_index.complete
                left_value: usize = left_index.row
                right_index: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, right_name, work_used, work_limit)
                return false if not right_index.complete
                right_value: usize = right_index.row
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                edge_left.push(left_value)
                edge_right.push(right_value)

            adjacency_heads: mutable darray[usize] = []
            adjacency_names: mutable darray[usize] = []
            adjacency_next: mutable darray[usize] = []
            for name in names |name, adjacency_heads, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                adjacency_heads.push(0)
            for edge in 0..<edge_left.count |edge, edge_left, edge_right, adjacency_heads, adjacency_names, adjacency_next, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                adjacency_names.push(edge_right[edge])
                adjacency_next.push(adjacency_heads[edge_left[edge]])
                adjacency_heads[edge_left[edge]] <- adjacency_names.count
                adjacency_names.push(edge_left[edge])
                adjacency_next.push(adjacency_heads[edge_right[edge]])
                adjacency_heads[edge_right[edge]] <- adjacency_names.count

            visited: mutable darray[bool] = []
            for name_index in 0..<names.count |name_index, names, visited, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                visited.push(false)
            bound_rows: mutable darray[usize] = []
            bound_found: mutable darray[bool] = []
            for name_index in 0..<names.count |name_index, names, bound_rows, bound_found, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                bound_rows.push(0)
                bound_found.push(false)
            for bound_row in 0..<bounds.count |bound_row, bounds, names, vertex_index, bound_rows, bound_found, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                continue if bounds[bound_row].term_key or bounds[bound_row].name == ""
                vertex: (complete: bool, found: bool, row: usize) = proof_kernel_replay_equality_vertex_index_find(vertex_index, names, bounds[bound_row].name, work_used, work_limit)
                return false if not vertex.complete
                if vertex.found and not bound_found[vertex.row]:
                    bound_rows[vertex.row] <- bound_row
                    bound_found[vertex.row] <- true
            for start in 0..<names.count |start, names, adjacency_heads, adjacency_names, adjacency_next, visited, bounds, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                continue if visited[start]
                queue: mutable darray[usize] = [start]
                members: mutable darray[usize] = []
                visited[start] <- true
                cursor: mutable usize = 0
                while cursor < queue.count |cursor, queue, members, adjacency_heads, adjacency_names, adjacency_next, visited, work_used, work_limit|:
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    current: usize = queue[cursor]
                    members.push(current)
                    arc: mutable usize = adjacency_heads[current]
                    while arc != 0 |arc, adjacency_names, adjacency_next, queue, visited, work_used, work_limit|:
                        return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                        arc_index: usize = arc - 1
                        neighbor: usize = adjacency_names[arc_index]
                        if not visited[neighbor]:
                            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                            visited[neighbor] <- true
                            queue.push(neighbor)
                        arc <- adjacency_next[arc_index]
                    cursor <- cursor + 1

                has_lower: mutable bool = false
                lower: mutable i64 = 0
                has_upper: mutable bool = false
                upper: mutable i64 = 0
                for member in members |member, members, names, bounds, bound_rows, bound_found, has_lower, lower, has_upper, upper, work_used, work_limit|:
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    continue if not bound_found[member]
                    return false if bound_rows[member] >= bounds.count or bounds[bound_rows[member]].term_key or bounds[bound_rows[member]].name != names[member]
                    bound: ProofKernelReplayBound = bounds[bound_rows[member]]
                    if bound.has_lower and (not has_lower or bound.lower > lower):
                        has_lower <- true
                        lower <- bound.lower
                    if bound.has_upper and (not has_upper or bound.upper < upper):
                        has_upper <- true
                        upper <- bound.upper
                for member in members |member, members, names, bounds, bound_rows, bound_found, has_lower, lower, has_upper, upper, work_used, work_limit|:
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    if not bound_found[member] and (has_lower or has_upper):
                        return false if not proof_kernel_replay_equality_closure_charge_text_entry(work_used, names[member], work_limit)
                        new_row: usize = bounds.count
                        bounds.push(ProofKernelReplayBound{name: names[member], term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: has_lower, lower: lower, has_upper: has_upper, upper: upper})
                        bound_rows[member] <- new_row
                        bound_found[member] <- true
                    elif bound_found[member]:
                        row: usize = bound_rows[member]
                        return false if row >= bounds.count or bounds[row].term_key or bounds[row].name != names[member]
                        if has_lower and (not bounds[row].has_lower or lower > bounds[row].lower):
                            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                            bounds[row].has_lower <- true
                            bounds[row].lower <- lower
                        if has_upper and (not bounds[row].has_upper or upper < bounds[row].upper):
                            return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                            bounds[row].has_upper <- true
                            bounds[row].upper <- upper
            proof_kernel_replay_tighten_disequality_bounds_with_work(nodes, children, facts, bounds, work_used, work_limit)

        def proof_kernel_replay_names_equal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_name: sview, right_name: sview, facts: darray[usize], work_used: mutable usize&, work_limit: usize) -> bool:
            return false if:
                left_name == "" or right_name == ""
                not proof_kernel_replay_equality_closure_charge_text_pair(work_used, left_name, right_name, work_limit)
            return true if left_name == right_name
            left_roots: mutable darray[usize] = []
            right_roots: mutable darray[usize] = []
            bounded_facts: mutable darray[usize] = []
            fact_count: usize = facts.count if facts.count < PROOF_KERNEL_REPLAY_EQUALITY_REACHABILITY_FACT_LIMIT else PROOF_KERNEL_REPLAY_EQUALITY_REACHABILITY_FACT_LIMIT
            for index in 0..<fact_count |facts, bounded_facts, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                bounded_facts.push(facts[index])
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, bounded_facts, &markers, work_used, work_limit)
            sort_index_result: (complete: bool, index: ProofKernelReplayEqualitySortIndex) = proof_kernel_replay_equality_sort_index_build(nodes, children, bounded_facts, work_used, work_limit)
            return false if not sort_index_result.complete
            local_work_used: mutable usize = 0
            for fact in bounded_facts |fact, nodes, children, markers, sort_index_result, left_roots, right_roots, local_work_used, work_used, work_limit|:
                proof_kernel_replay_collect_name_equalities_with_work(nodes, children, markers, fact, sort_index_result.index, &left_roots, &right_roots, &local_work_used, work_used, work_limit, 0)
                return false if work_used > work_limit
            return false if left_roots.count != right_roots.count
            vertex_index_result: (complete: bool, index: ProofKernelReplayEqualityVertexIndex) = proof_kernel_replay_equality_vertex_index_build(left_roots.count, work_used, work_limit)
            return false if not vertex_index_result.complete
            vertex_index: mutable ProofKernelReplayEqualityVertexIndex = vertex_index_result.index
            names: mutable darray[sview] = []
            edge_left: mutable darray[usize] = []
            edge_right: mutable darray[usize] = []
            for edge in 0..<left_roots.count |edge, left_roots, right_roots, nodes, names, edge_left, edge_right, vertex_index, work_used, work_limit|:
                return false if left_roots[edge] >= nodes.count or right_roots[edge] >= nodes.count
                left_index: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, nodes[left_roots[edge]].name, work_used, work_limit)
                return false if not left_index.complete
                right_index: (complete: bool, row: usize) = proof_kernel_replay_equality_vertex_index_insert(&vertex_index, &names, nodes[right_roots[edge]].name, work_used, work_limit)
                return false if not right_index.complete
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                edge_left.push(left_index.row)
                edge_right.push(right_index.row)
            start: (complete: bool, found: bool, row: usize) = proof_kernel_replay_equality_vertex_index_find(vertex_index, names, left_name, work_used, work_limit)
            return false if not start.complete or not start.found
            target: (complete: bool, found: bool, row: usize) = proof_kernel_replay_equality_vertex_index_find(vertex_index, names, right_name, work_used, work_limit)
            return false if not target.complete or not target.found
            adjacency_heads: mutable darray[usize] = []
            for vertex in 0..<names.count |vertex, names, adjacency_heads, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                adjacency_heads.push(0)
            adjacency_names: mutable darray[usize] = []
            adjacency_next: mutable darray[usize] = []
            for edge in 0..<edge_left.count |edge, edge_left, edge_right, adjacency_heads, adjacency_names, adjacency_next, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 2, work_limit)
                adjacency_names.push(edge_right[edge])
                adjacency_next.push(adjacency_heads[edge_left[edge]])
                adjacency_heads[edge_left[edge]] <- adjacency_names.count
                adjacency_names.push(edge_left[edge])
                adjacency_next.push(adjacency_heads[edge_right[edge]])
                adjacency_heads[edge_right[edge]] <- adjacency_names.count
            visited: mutable darray[bool] = []
            for vertex in 0..<names.count |vertex, names, visited, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                visited.push(false)
            queue: mutable darray[usize] = [start.row]
            visited[start.row] <- true
            cursor: mutable usize = 0
            while cursor < queue.count |cursor, queue, adjacency_heads, adjacency_names, adjacency_next, visited, target, work_used, work_limit|:
                return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                current: usize = queue[cursor]
                return true if current == target.row
                arc: mutable usize = adjacency_heads[current]
                while arc != 0 |arc, adjacency_names, adjacency_next, queue, visited, work_used, work_limit|:
                    return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                    neighbor: usize = adjacency_names[arc - 1]
                    if not visited[neighbor]:
                        return false if not proof_kernel_replay_equality_closure_charge(work_used, 1, work_limit)
                        visited[neighbor] <- true
                        queue.push(neighbor)
                    arc <- adjacency_next[arc - 1]
                cursor <- cursor + 1
            return false

        # Mirror of the producer's bound propagation: `x - y <= c` with `y <= U` gives `x <= U + c`,
        # and with `x >= L` gives `y >= L - c`. Each step is an ordinary interval inference and can
        # only narrow an interval that already held. It runs to the same fixed point with the same
        # limit, so the kernel derives exactly the producer's intervals (BACKLOG C-01).
        const PROOF_KERNEL_REPLAY_BOUND_PROPAGATION_ROUND_LIMIT: usize = 33

        # Mirror of the producer's affine peer rule: `base + 1` is in range when a constraint says
        # `base < peer` and both carry the same unsigned width. Relational, so it needs no
        # representable interval.
