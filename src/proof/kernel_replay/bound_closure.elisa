# Name equalities, affine terms and interval closure for kernel bound replay.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_collect_name_equalities(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, left_roots: mutable darray[usize]&, right_roots: mutable darray[usize]&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not ElisaProofKernelCore::depth_valid(depth)
            return if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return if root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "and":
                proof_kernel_replay_collect_name_equalities(nodes, children, facts, node.left, left_roots, right_roots, depth + 1)
                proof_kernel_replay_collect_name_equalities(nodes, children, facts, node.right, left_roots, right_roots, depth + 1)
                return
            if node.kind == "binary" and node.operator == "==":
                return if node.left >= nodes.count or node.right >= nodes.count
                return if nodes[node.left].kind != "ident" or nodes[node.right].kind != "ident"
                return if nodes[node.left].name == "" or nodes[node.right].name == ""
                if proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right):
                    left_roots.push(node.left)
                    right_roots.push(node.right)

        def proof_kernel_replay_close_equalities(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            left_roots: mutable darray[usize] = []
            right_roots: mutable darray[usize] = []
            for fact in facts |fact, nodes, left_roots, right_roots|:
                proof_kernel_replay_collect_name_equalities(nodes, children, facts, fact, &left_roots, &right_roots, 0)
            rounds: mutable usize = 0
            max_rounds: usize = facts.count * 2 + 2
            while rounds < max_rounds |rounds, left_roots, right_roots, nodes, bounds|:
                for index in 0..<left_roots.count |index, left_roots, right_roots, nodes, bounds|:
                    continue if index >= right_roots.count or left_roots[index] >= nodes.count or right_roots[index] >= nodes.count
                    left_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, nodes[left_roots[index]].name)
                    right_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, nodes[right_roots[index]].name)
                    proof_kernel_replay_add_lower(bounds, nodes[right_roots[index]].name, left_bound.lower) if left_bound.has_lower
                    proof_kernel_replay_add_upper(bounds, nodes[right_roots[index]].name, left_bound.upper) if left_bound.has_upper
                    proof_kernel_replay_add_lower(bounds, nodes[left_roots[index]].name, right_bound.lower) if right_bound.has_lower
                    proof_kernel_replay_add_upper(bounds, nodes[left_roots[index]].name, right_bound.upper) if right_bound.has_upper
                rounds <- rounds + 1
            proof_kernel_replay_tighten_disequality_bounds(nodes, children, facts, bounds)

        def proof_kernel_replay_names_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_name: sview, right_name: sview, facts: darray[usize]) -> bool:
            return false if left_name == "" or right_name == ""
            return true if left_name == right_name
            left_roots: mutable darray[usize] = []
            right_roots: mutable darray[usize] = []
            for fact in facts |fact, nodes, left_roots, right_roots|:
                proof_kernel_replay_collect_name_equalities(nodes, children, facts, fact, &left_roots, &right_roots, 0)
            reachable: mutable darray[usize] = []
            for index in 0..<left_roots.count |index, left_roots, right_roots, nodes, reachable, left_name, right_name|:
                continue if index >= right_roots.count or left_roots[index] >= nodes.count or right_roots[index] >= nodes.count
                if nodes[left_roots[index]].name == left_name:
                    return true if nodes[right_roots[index]].name == right_name
                    reachable.push(right_roots[index]) if not any existing in reachable where existing < nodes.count and nodes[existing].name == nodes[right_roots[index]].name
                if nodes[right_roots[index]].name == left_name:
                    return true if nodes[left_roots[index]].name == right_name
                    reachable.push(left_roots[index]) if not any existing in reachable where existing < nodes.count and nodes[existing].name == nodes[left_roots[index]].name
            cursor: mutable usize = 0
            while cursor < reachable.count |cursor, reachable, left_roots, right_roots, nodes, right_name|:
                current_root: usize = reachable[cursor]
                return false if current_root >= nodes.count
                for index in 0..<left_roots.count |index, left_roots, right_roots, reachable, current_root, nodes, right_name|:
                    continue if index >= right_roots.count or left_roots[index] >= nodes.count or right_roots[index] >= nodes.count
                    next_root: mutable usize = nodes.count
                    next_root <- right_roots[index] if nodes[left_roots[index]].name == nodes[current_root].name
                    next_root <- left_roots[index] if nodes[right_roots[index]].name == nodes[current_root].name
                    if next_root < nodes.count:
                        return true if nodes[next_root].name == right_name
                        reachable.push(next_root) if not any existing in reachable where existing < nodes.count and nodes[existing].name == nodes[next_root].name
                cursor <- cursor + 1
            return false

        def proof_kernel_replay_affine_expression(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> ProofKernelReplayAffine:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            empty: ProofKernelReplayAffine = ProofKernelReplayAffine{known: false, base: "", offset: 0, negative: false}
            return empty if not ElisaProofKernelCore::depth_valid(depth)
            return empty if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return empty if root >= nodes.count
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, depth + 1)
            return ProofKernelReplayAffine{known: true, base: "", offset: constant.value, negative: false} if constant.known
            return empty if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return ProofKernelReplayAffine{known: true, base: node.name, offset: 0, negative: false} if node.kind == "ident" and node.name != ""
            return proof_kernel_replay_affine_expression(nodes, node.left, depth + 1) if node.kind == "unary" and node.operator == "+"
            if node.kind == "binary":
                left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.left, depth + 1)
                right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, depth + 1)
                if left.known and left.base != "" and right_constant.known:
                    if node.operator == "+":
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left.offset, right_constant.value)
                        return ProofKernelReplayAffine{known: true, base: left.base, offset: combined.value, negative: left.negative} if combined.known
                    if node.operator == "-":
                        negated: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, right_constant.value)
                        return empty if not negated.known
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left.offset, negated.value)
                        return ProofKernelReplayAffine{known: true, base: left.base, offset: combined.value, negative: left.negative} if combined.known
                left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.left, depth + 1)
                right_affine: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.right, depth + 1)
                if left_constant.known and right_affine.known and right_affine.base != "" and node.operator == "+":
                    combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, right_affine.offset)
                    return ProofKernelReplayAffine{known: true, base: right_affine.base, offset: combined.value, negative: right_affine.negative} if combined.known
                if left_constant.known and right_affine.known and right_affine.base != "" and node.operator == "-":
                    # Both affine forms are `sign * base + offset`. Subtracting either form
                    # always subtracts its offset; the sign only flips the base. Using addition
                    # for a negative right-hand form made `c - (-x + k)` look like `x + c + k`
                    # instead of the correct `x + c - k`, which could certify a false equality.
                    combined: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, right_affine.offset)
                    return ProofKernelReplayAffine{known: true, base: right_affine.base, offset: combined.value, negative: not right_affine.negative} if combined.known
            return empty

        # Mirror of the producer's bound propagation: `x - y <= c` with `y <= U` gives `x <= U + c`,
        # and with `x >= L` gives `y >= L - c`. Each step is an ordinary interval inference and can
        # only narrow an interval that already held. It runs to the same fixed point with the same
        # limit, so the kernel derives exactly the producer's intervals (BACKLOG C-01).
        const PROOF_KERNEL_REPLAY_BOUND_PROPAGATION_ROUND_LIMIT: usize = 33

        # Mirror of the producer's affine peer rule: `base + 1` is in range when a constraint says
        # `base < peer` and both carry the same unsigned width. Relational, so it needs no
        # representable interval.
        def proof_kernel_replay_affine_unsigned_peer_safe(affine: ProofKernelReplayAffine, constraints: darray[ProofKernelReplayDifference]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]) -> bool:
            return false if not affine.known or affine.negative or affine.offset != 1 or affine.base == ""
            width: i64 = proof_kernel_replay_unsigned_marker_width_for_name(nodes, children, facts, affine.base)
            return false if width == 0
            for constraint in constraints |constraint, affine, width, nodes, children, facts|:
                continue if constraint.left != affine.base or constraint.right == ""
                continue if constraint.bound > -1
                return true if proof_kernel_replay_unsigned_marker_width_for_name(nodes, children, facts, constraint.right) == width
            return false

        def proof_kernel_replay_close_bounds_through_differences(constraints: darray[ProofKernelReplayDifference]&, bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            return if constraints.count == 0
            for round in 0..<PROOF_KERNEL_REPLAY_BOUND_PROPAGATION_ROUND_LIMIT |round, constraints, bounds|:
                changed: mutable bool = false
                for constraint in constraints |constraint, bounds, changed|:
                    continue if constraint.left == "" or constraint.right == ""
                    right_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, constraint.right)
                    if right_bound.has_upper:
                        derived_upper: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_bound.upper, constraint.bound)
                        if derived_upper.known:
                            prior: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, constraint.left)
                            changed <- true if not prior.has_upper or derived_upper.value < prior.upper
                            proof_kernel_replay_add_upper(bounds, constraint.left, derived_upper.value)
                    left_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, constraint.left)
                    if left_bound.has_lower:
                        derived_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_bound.lower, constraint.bound)
                        if derived_lower.known:
                            prior: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, constraint.right)
                            changed <- true if not prior.has_lower or derived_lower.value > prior.lower
                            proof_kernel_replay_add_lower(bounds, constraint.right, derived_lower.value)
                break if not changed

        def proof_kernel_replay_affine_safe(affine: ProofKernelReplayAffine, bounds: darray[ProofKernelReplayBound]&) -> bool:
            return false if not affine.known
            return true if affine.base == ""
            return true if not affine.negative and affine.offset == 0
            bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, affine.base)
            if affine.negative:
                return false if not bound.has_lower or not bound.has_upper
                negated_upper: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, bound.upper)
                negated_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, bound.lower)
                return false if not negated_upper.known or not negated_lower.known
                lower: ProofKernelReplayInt = proof_kernel_replay_add_safe(negated_upper.value, affine.offset)
                upper: ProofKernelReplayInt = proof_kernel_replay_add_safe(negated_lower.value, affine.offset)
                return lower.known and upper.known
            if affine.offset > 0:
                limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(proof_kernel_replay_i64_max(), affine.offset)
                return limit.known and bound.has_upper and bound.upper <= limit.value
            limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(proof_kernel_replay_i64_min(), affine.offset)
            return limit.known and bound.has_lower and bound.lower >= limit.value

        def proof_kernel_replay_affine_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize]) -> bool:
            left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, left_root, 0)
            right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, right_root, 0)
            return false if not left.known or not right.known
            return false if left.base == "" or right.base == ""
            return false if left.base != right.base and not proof_kernel_replay_names_equal(nodes, children, left.base, right.base, facts)
            return false if left.negative != right.negative
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            return false if not proof_kernel_replay_affine_safe(left, bounds) or not proof_kernel_replay_affine_safe(right, bounds)
            difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left.offset, right.offset)
            return false if not difference.known
            return difference.value > 0 if operator == ">"
            return difference.value >= 0 if operator == ">="
            return difference.value < 0 if operator == "<"
            return difference.value <= 0 if operator == "<="
            return difference.value != 0 if operator == "!="
            return difference.value == 0 if operator == "=="
            return false

        def proof_kernel_replay_interval(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, bounds: darray[ProofKernelReplayBound]&, depth: usize) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (false, 0, 0, false, false) if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return (false, 0, 0, false, false) if root >= nodes.count
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, depth + 1)
            if constant.known:
                # A negative leaf can encode a large unsigned bit pattern, and an arithmetic
                # expression may wrap at a narrow width. Reuse the simplifier's cross-width-safe
                # subset, while retaining arbitrary direct nonnegative literal bounds.
                # A constant outside that subset, `-3` or `0 - 3`, is not refused outright: it
                # falls through to the structural rules below, which read it operation by
                # operation exactly as they read a non-constant term, under the same wrap
                # guards. Refusing it here left `y + -3` without an interval, so the signed
                # guard rejected a goal the producer (which reads every constant) had proved.
                # A typed full-width literal is a negative `int` leaf and still has no interval.
                safe_constant: ProofKernelReplayInt = proof_kernel_replay_safe_comparison_constant(nodes, root)
                return (true, safe_constant.value, safe_constant.value, true, true) if safe_constant.known
            return (false, 0, 0, false, false) if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident":
                bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, node.name)
                return (bound.has_lower and bound.has_upper, bound.lower, bound.upper, bound.has_lower, bound.has_upper)
            if node.kind == "unary" and node.operator == "-":
                inner: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                negated_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, inner.upper)
                negated_upper: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, inner.lower)
                return (false, 0, 0, false, false) if not negated_lower.known or not negated_upper.known
                return (inner.has_lower and inner.has_upper, negated_lower.value, negated_upper.value, inner.has_upper, inner.has_lower)
            if node.kind == "binary" and node.operator == "+":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.right, bounds, depth + 1)
                lower_sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(a.lower, b.lower)
                upper_sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(a.upper, b.upper)
                has_lower: bool = a.has_lower and b.has_lower and lower_sum.known
                has_upper: bool = a.has_upper and b.has_upper and upper_sum.known
                return (has_lower and has_upper, lower_sum.value, upper_sum.value, has_lower, has_upper)
            if node.kind == "binary" and node.operator == "-":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.right, bounds, depth + 1)
                lower_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(a.lower, b.upper)
                upper_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(a.upper, b.lower)
                has_lower: bool = a.has_lower and b.has_upper and lower_difference.known
                has_upper: bool = a.has_upper and b.has_lower and upper_difference.known
                return (has_lower and has_upper, lower_difference.value, upper_difference.value, has_lower, has_upper)
            if node.kind == "binary" and node.operator == "*":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.right, bounds, depth + 1)
                return (false, 0, 0, false, false) if not a.has_lower or not a.has_upper or not b.has_lower or not b.has_upper
                p1: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.lower, b.lower)
                p2: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.lower, b.upper)
                p3: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.upper, b.lower)
                p4: ProofKernelReplayInt = proof_kernel_replay_mul_safe(a.upper, b.upper)
                return (false, 0, 0, false, false) if not p1.known or not p2.known or not p3.known or not p4.known
                lower: mutable i64 = p1.value
                lower <- p2.value if p2.value < lower
                lower <- p3.value if p3.value < lower
                lower <- p4.value if p4.value < lower
                upper: mutable i64 = p1.value
                upper <- p2.value if p2.value > upper
                upper <- p3.value if p3.value > upper
                upper <- p4.value if p4.value > upper
                return (true, lower, upper, true, true)
            if node.kind == "binary" and node.operator == "/":
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                dividend: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                if not divisor.known:
                    # A divisor bounded to a positive range: truncating division is monotone in
                    # each operand there, so the corners bound the quotient. No `MIN / -1` edge.
                    range: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.right, bounds, depth + 1)
                    return (false, 0, 0, false, false) if not range.has_lower or not range.has_upper or range.lower < 1 or not dividend.has_lower or not dividend.has_upper
                    return (true, dividend.lower / range.upper, dividend.upper / range.lower, true, true) if dividend.lower >= 0
                    return (true, dividend.lower / range.lower, dividend.upper / range.upper, true, true) if dividend.upper <= 0
                    return (true, dividend.lower / range.lower, dividend.upper / range.lower, true, true)
                return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or not dividend.has_lower or not dividend.has_upper
                lower_quotient: ProofKernelReplayInt = proof_kernel_replay_div_safe(dividend.lower, divisor.value)
                upper_quotient: ProofKernelReplayInt = proof_kernel_replay_div_safe(dividend.upper, divisor.value)
                return (false, 0, 0, false, false) if not lower_quotient.known or not upper_quotient.known
                return (true, lower_quotient.value, upper_quotient.value, true, true) if divisor.value > 0
                return (true, upper_quotient.value, lower_quotient.value, true, true)
            if node.kind == "binary" and node.operator == "%":
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                # A bounded interval does not prove that the dividend excludes MIN_I64.
                # Reject divisor -1 because MIN_I64 % -1 is a fixed-width overflow edge.
                return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or divisor.value == -1
                magnitude: mutable i64 = divisor.value
                if magnitude < 0:
                    absolute: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, magnitude)
                    return (false, 0, 0, false, false) if not absolute.known
                    magnitude <- absolute.value
                limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(magnitude, 1)
                return (false, 0, 0, false, false) if not limit.known
                negative_limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, limit.value)
                return (false, 0, 0, false, false) if not negative_limit.known
                return (true, negative_limit.value, limit.value, true, true)
            return (false, 0, 0, false, false)
