extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_zero_subtraction_plan_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> (known: bool, goal: usize):
            return (false, 0) if:
                root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0) if goal.kind != "binary" or goal.operator != "==" or not proof_kernel_replay_arena_shape_valid(goal)
            for orientation in 0..<2 |orientation, goal, nodes, children, facts, work_used|:
                return (false, 0) if not proof_kernel_replay_goal_search_charge(work_used)
                term: usize = goal.right if orientation == 0 else goal.left
                peer: usize = goal.left if orientation == 0 else goal.right
                continue if term >= nodes.count or peer >= nodes.count or not proof_kernel_replay_valid(nodes, term) or not proof_kernel_replay_valid(nodes, peer)
                return (false, 0) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, term, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, peer, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                delta: ElisaProofKernelCore::ProofKernelNode = nodes[term]
                continue if delta.kind != "binary" or delta.operator != "-" or not proof_kernel_replay_arena_shape_valid(delta)
                delta_left: usize = delta.left
                delta_right: usize = delta.right
                continue if delta_left >= nodes.count or delta_right >= nodes.count or not proof_kernel_replay_valid(nodes, delta_left) or not proof_kernel_replay_valid(nodes, delta_right)
                return (false, 0) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, delta_left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, delta_right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if nodes[delta_left].kind != "ident" or nodes[delta_right].kind != "ident"
                width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, delta_left, facts, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if width != 8 and width != 16 and width != 32 and width != 64
                right_width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, delta_right, facts, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if right_width != width
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, peer, term, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not primitive
                for fact_root in facts |fact_root, delta, peer, nodes, children, facts, work_used|:
                    return (false, 0) if not proof_kernel_replay_goal_search_charge(work_used)
                    continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                    return (false, 0) if:
                        not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                    continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                    fact_left: usize = fact.left
                    fact_right: usize = fact.right
                    continue if fact_left >= nodes.count or fact_right >= nodes.count or not proof_kernel_replay_valid(nodes, fact_left) or not proof_kernel_replay_valid(nodes, fact_right)
                    return (false, 0) if:
                        not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_right, work_used)
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    same_delta_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact_left, delta_right, work_used)
                    return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_delta_right
                    literal: ElisaProofKernelCore::ProofKernelNode = nodes[fact_right]
                    continue if literal.kind != "int" or literal.value != 0 or not proof_kernel_replay_arena_shape_valid(literal)
                    primitive_zero: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, fact_left, fact_right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not primitive_zero
                    return (false, 0) if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", "==")
                    rewritten: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", peer, delta_left, 0, 0, 0, 0, "", "")
                    return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return (true, rewritten)
            (false, 0)

        def proof_kernel_replay_subtraction_alias_rewrite_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, term: usize, alias: usize, depth: usize, rewrite_work: mutable usize&, work_used: mutable usize&) -> usize:
            return nodes.count if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or rewrite_work == 0 or root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            rewrite_work <- rewrite_work - 1
            same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, root, term, work_used)
            return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return alias if same_term
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return nodes.count if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind in {"paren", "unary"}:
                a: usize = proof_kernel_replay_subtraction_alias_rewrite_with_goal_work(nodes, children, node.left, term, alias, depth + 1, rewrite_work, work_used)
                return nodes.count if a >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return root if a == node.left
                return nodes.count if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, node.kind, node.operator)
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, a, 0, 0, 0, 0, 0, "", "")
                return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return rewritten
            if node.kind in {"binary", "if"}:
                a: usize = proof_kernel_replay_subtraction_alias_rewrite_with_goal_work(nodes, children, node.left, term, alias, depth + 1, rewrite_work, work_used)
                return nodes.count if a >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                b: usize = proof_kernel_replay_subtraction_alias_rewrite_with_goal_work(nodes, children, node.right, term, alias, depth + 1, rewrite_work, work_used)
                return nodes.count if b >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                c: mutable usize = 0
                if node.kind == "if":
                    c <- proof_kernel_replay_subtraction_alias_rewrite_with_goal_work(nodes, children, node.auxiliary, term, alias, depth + 1, rewrite_work, work_used)
                    return nodes.count if c >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return root if a == node.left and b == node.right and c == node.auxiliary
                return nodes.count if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, node.kind, node.operator)
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, a, b, c, 0, 0, 0, "", "")
                return nodes.count if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return rewritten
            root

        def proof_kernel_replay_subtraction_alias_plan_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> (known: bool, goal: usize):
            return (false, 0) if goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root)
            zero: (known: bool, goal: usize) = proof_kernel_replay_zero_subtraction_plan_with_goal_work(nodes, children, facts, goal_root, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return zero if zero.known
            rewrite_work: mutable usize = PROOF_KERNEL_REPLAY_WORK_BUDGET
            for fact_root in facts |fact_root, nodes, children, facts, goal_root, rewrite_work, work_used|:
                return (false, 0) if rewrite_work == 0 or not proof_kernel_replay_goal_search_charge(work_used)
                rewrite_work <- rewrite_work - 1
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                return (false, 0) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                fact_left: usize = fact.left
                fact_right: usize = fact.right
                continue if fact_left >= nodes.count or fact_right >= nodes.count or not proof_kernel_replay_valid(nodes, fact_left) or not proof_kernel_replay_valid(nodes, fact_right)
                return (false, 0) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                left_is_ident: bool = nodes[fact_left].kind == "ident"
                alias: usize = fact_left if left_is_ident else fact_right
                term: usize = fact_right if left_is_ident else fact_left
                continue if nodes[alias].kind != "ident" or not proof_kernel_replay_arena_shape_valid(nodes[alias])
                delta: ElisaProofKernelCore::ProofKernelNode = nodes[term]
                continue if delta.kind != "binary" or delta.operator != "-" or not proof_kernel_replay_arena_shape_valid(delta)
                delta_left: usize = delta.left
                delta_right: usize = delta.right
                continue if delta_left >= nodes.count or delta_right >= nodes.count or not proof_kernel_replay_valid(nodes, delta_left) or not proof_kernel_replay_valid(nodes, delta_right)
                return (false, 0) if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, delta_left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, delta_right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if nodes[delta_left].kind != "ident" or nodes[delta_right].kind != "ident"
                continue if not proof_kernel_replay_arena_shape_valid(nodes[delta_left]) or not proof_kernel_replay_arena_shape_valid(nodes[delta_right])
                continue if nodes[delta_left].name == nodes[alias].name or nodes[delta_right].name == nodes[alias].name
                width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, alias, facts, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if width != 8 and width != 16 and width != 32 and width != 64
                left_width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, delta_left, facts, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if left_width != width
                right_width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, delta_right, facts, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if right_width != width
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, alias, term, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not primitive
                rewritten: usize = proof_kernel_replay_subtraction_alias_rewrite_with_goal_work(nodes, children, goal_root, term, alias, 0, &rewrite_work, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or rewritten >= nodes.count
                return (true, rewritten) if rewritten != goal_root
            (false, 0)
