extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_CONDITION_REFUTATION_WORK_LIMIT: usize = 4096

        # The local marker snapshot retains validated unsigned widths so repeated identifier
        # queries in condition branches do not rescan every source fact.
        def proof_kernel_replay_unsigned_width_from_markers_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, markers: darray<ProofKernelReplayWitnessMarker>, name: sview, work_used: mutable usize&) -> i64:
            return 0 if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(name)) or name == ""
            width: mutable i64 = 0
            for marker in markers |marker, nodes, name, width, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                continue if marker.kind != PROOF_KERNEL_REPLAY_WITNESS_UNSIGNED_TYPE
                marker_name: sview = proof_kernel_replay_scalar_witness_ident_name_with_work(nodes, marker.root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                matches: bool = proof_kernel_replay_goal_search_text_equal(marker_name, name, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                width <- marker.depth if matches and (width == 0 or marker.depth < width)
            width

        def proof_kernel_replay_unsigned_expression_width_from_markers_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: darray[ProofKernelReplayWitnessMarker], root: usize, work_used: mutable usize&, depth: usize) -> i64:
            return 0 if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "typed-int":
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(node)
                return literal.width if literal.known and literal.unsigned
                return 0
            if node.kind == "ident":
                return proof_kernel_replay_unsigned_width_from_markers_with_goal_work(nodes, markers, node.name, work_used)
            if node.kind == "field" or node.kind == "index" or node.kind == "index-n":
                return proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, root, facts, work_used)
            if node.kind == "unary":
                return proof_kernel_replay_unsigned_expression_width_from_markers_with_goal_work(nodes, children, facts, markers, node.left, work_used, depth + 1)
            if node.kind == "binary":
                left_width: i64 = proof_kernel_replay_unsigned_expression_width_from_markers_with_goal_work(nodes, children, facts, markers, node.left, work_used, depth + 1)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_width: i64 = proof_kernel_replay_unsigned_expression_width_from_markers_with_goal_work(nodes, children, facts, markers, node.right, work_used, depth + 1)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return right_width if left_width == 0
                return left_width if right_width == 0 or left_width < right_width
                return right_width
            if node.kind == "if":
                then_width: i64 = proof_kernel_replay_unsigned_expression_width_from_markers_with_goal_work(nodes, children, facts, markers, node.right, work_used, depth + 1)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                else_width: i64 = proof_kernel_replay_unsigned_expression_width_from_markers_with_goal_work(nodes, children, facts, markers, node.auxiliary, work_used, depth + 1)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or then_width == 0 or else_width == 0
                return then_width if then_width < else_width
                return else_width
            0

        def proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, name: sview, depth: usize, work_used: mutable usize&) -> bool:
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            return node.name == name if node.kind == "ident"
            if node.kind in {"paren", "unary"}:
                found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.left, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return found
            if node.kind == "binary":
                left_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.left, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if left_found
                right_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.right, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return right_found
            if node.kind == "if":
                left_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.left, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if left_found
                right_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.right, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if right_found
                auxiliary_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.auxiliary, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return auxiliary_found
            return false

        def proof_kernel_replay_conditional_alias_plan_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> (known: bool, index: usize, condition: usize, then_fact: usize, else_fact: usize, then_refuted: bool, else_refuted: bool):
            unknown: (known: bool, index: usize, condition: usize, then_fact: usize, else_fact: usize, then_refuted: bool, else_refuted: bool) = (false, 0, 0, 0, 0, false, false)
            return unknown if:
                not proof_kernel_replay_goal_search_charge(work_used)
                goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return unknown if:
                goal.kind != "binary" or not proof_kernel_replay_arena_shape_valid(goal) or not proof_kernel_replay_negation_supported(goal.operator)
                goal.left >= nodes.count or goal.right >= nodes.count or not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            for index in 0..<facts.count |index, facts, nodes, children, goal, markers, markers_ready, work_used|:
                return unknown if not proof_kernel_replay_goal_search_charge(work_used)
                root: usize = facts[index]
                continue if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                return unknown if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                continue if fact.left >= nodes.count or fact.right >= nodes.count or not proof_kernel_replay_valid(nodes, fact.left) or not proof_kernel_replay_valid(nodes, fact.right)
                return unknown if:
                    not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.right, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                alias: usize = fact.left if nodes[fact.left].kind == "ident" else fact.right
                conditional_root: usize = fact.right if nodes[fact.left].kind == "ident" else fact.left
                continue if nodes[alias].kind != "ident" or not proof_kernel_replay_arena_shape_valid(nodes[alias])
                occurs: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, goal_root, nodes[alias].name, 0, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not occurs
                if not markers_ready:
                    return unknown if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    markers_ready <- true
                equality_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return unknown if not equality_admission.complete or equality_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, alias, conditional_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not primitive
                safe_difference: bool = proof_kernel_replay_unsigned_conditional_difference_safe_with_cached_markers_goal_work(nodes, children, facts, markers, conditional_root, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not safe_difference
                conditional: ElisaProofKernelCore::ProofKernelNode = nodes[conditional_root]
                width: i64 = proof_kernel_replay_unsigned_width_from_markers_with_goal_work(nodes, markers, nodes[alias].name, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                conditional_width: i64 = proof_kernel_replay_unsigned_expression_width_from_markers_with_goal_work(nodes, children, facts, markers, conditional.right, work_used, 0)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if width != conditional_width
                condition_root: usize = conditional.left
                continue if condition_root >= nodes.count or not proof_kernel_replay_valid(nodes, condition_root) or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, condition_root, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                condition: ElisaProofKernelCore::ProofKernelNode = nodes[condition_root]
                then_refuted: mutable bool = false
                else_refuted: mutable bool = false
                for fact_root in facts |fact_root, nodes, children, facts, condition, then_refuted, else_refuted, work_used|:
                    return unknown if not proof_kernel_replay_goal_search_charge(work_used)
                    order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_markers_and_work(nodes, children, facts, &markers, &markers_ready, fact_root, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not order.known
                    same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.left, condition.left, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_left
                    same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.right, condition.right, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_right
                    complement: sview = "<=" if condition.operator == ">" else "<" if condition.operator == ">=" else ">=" if condition.operator == "<" else ">"
                    then_refuted <- true if order.operator == complement
                    else_refuted <- true if order.operator == condition.operator
                return unknown if:
                    not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", "==")
                    not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", "==")
                then_fact: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", alias, conditional.right, 0, 0, 0, 0, "", "")
                else_fact: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", alias, conditional.auxiliary, 0, 0, 0, 0, "", "")
                return unknown if then_fact >= nodes.count or else_fact >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, index, conditional.left, then_fact, else_fact, then_refuted, else_refuted)
            unknown

        def proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, truth: bool, depth: usize, local_work: mutable usize&, markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, work_used: mutable usize&) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or local_work == 0 or not proof_kernel_replay_goal_search_charge(work_used)
            local_work <- local_work - 1
            return false if:
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            condition: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if:
                condition.kind != "binary" or not proof_kernel_replay_arena_shape_valid(condition)
                condition.left >= nodes.count or condition.right >= nodes.count or not proof_kernel_replay_valid(nodes, condition.left) or not proof_kernel_replay_valid(nodes, condition.right)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, condition.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, condition.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if condition.operator in {"and", "or"}:
                left: bool = proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes, children, facts, condition.left, truth, depth + 1, local_work, markers, markers_ready, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right: bool = proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes, children, facts, condition.right, truth, depth + 1, local_work, markers, markers_ready, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return ((left or right) if truth else (left and right)) if condition.operator == "and" else ((left and right) if truth else (left or right))
            if condition.operator in {"==", "!="}:
                if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                    equality_marker_cache_complete: bool = proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not equality_marker_cache_complete
                    markers_ready <- true
                relation_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if not relation_admission.complete or relation_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, condition.left, condition.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if primitive:
                    desired: sview = ("!=" if condition.operator == "==" else "==") if truth else condition.operator
                    for fact in facts |fact, nodes, children, facts, condition, desired, markers, markers_ready, work_used|:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                        return false if:
                            not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                            work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        f: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                        continue if f.kind != "binary" or f.operator != desired or not proof_kernel_replay_arena_shape_valid(f)
                        fact_primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, f.left, f.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        continue if not fact_primitive
                        same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, f.left, condition.left, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        continue if not same_left
                        same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, f.right, condition.right, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if same_right
            return false if:
                not proof_kernel_replay_is_order_operator(condition.operator)
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                nodes[condition.left].kind != "ident" or nodes[condition.right].kind != "ident"
            if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                order_marker_cache_complete: bool = proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not order_marker_cache_complete
                markers_ready <- true
            relation_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if not relation_admission.complete or relation_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            width: i64 = proof_kernel_replay_unsigned_width_from_markers_with_goal_work(nodes, markers, nodes[condition.left].name, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (width != 8 and width != 16 and width != 32 and width != 64)
            right_width: i64 = proof_kernel_replay_unsigned_width_from_markers_with_goal_work(nodes, markers, nodes[condition.right].name, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_width != width
            primitive_order: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, condition.left, condition.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive_order
            complement: sview = "<=" if condition.operator == ">" else "<" if condition.operator == ">=" else ">=" if condition.operator == "<" else ">"
            desired: sview = complement if truth else condition.operator
            for fact in facts |fact, nodes, children, facts, condition, desired, markers, markers_ready, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_markers_and_work(nodes, children, facts, &markers, &markers_ready, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not order.known or order.operator != desired
                same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.left, condition.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not same_left
                same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.right, condition.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if same_right
            return false

        def proof_kernel_replay_ident_name_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> sview:
            return "" if:
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[root].kind != "ident"
            nodes[root].name

        def proof_kernel_replay_strip_goal_parens_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> (complete: bool, stripped: usize):
            current: mutable usize = root
            depth: mutable usize = 0
            while true |nodes, current, depth, work_used|:
                return (false, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                return (false, 0) if current >= nodes.count or not proof_kernel_replay_valid(nodes, current) or not proof_kernel_replay_goal_search_charge(work_used)
                return (false, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, current, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                node: ElisaProofKernelCore::ProofKernelNode = nodes[current]
                return (true, current) if node.kind != "paren"
                return (false, 0) if not proof_kernel_replay_arena_shape_valid(node) or node.left >= nodes.count or not proof_kernel_replay_valid(nodes, node.left)
                current <- node.left
                depth <- depth + 1
            return (false, 0)

        def proof_kernel_replay_conditional_comparison_plan_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> (known: bool, condition: usize, then_goal: usize, else_goal: usize, then_refuted: bool, else_refuted: bool):
            unknown: (known: bool, condition: usize, then_goal: usize, else_goal: usize, then_refuted: bool, else_refuted: bool) = (false, 0, 0, 0, false, false)
            return unknown if:
                not proof_kernel_replay_goal_search_charge(work_used)
                goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return unknown if:
                node.kind != "binary" or not proof_kernel_replay_negation_supported(node.operator)
                node.left >= nodes.count or node.right >= nodes.count or not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left_view: (complete: bool, stripped: usize) = proof_kernel_replay_strip_goal_parens_with_work(nodes, node.left, work_used)
            return unknown if not left_view.complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_view: (complete: bool, stripped: usize) = proof_kernel_replay_strip_goal_parens_with_work(nodes, node.right, work_used)
            return unknown if not right_view.complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left_conditional: bool = nodes[left_view.stripped].kind == "if"
            right_conditional: bool = nodes[right_view.stripped].kind == "if"
            null_test: mutable bool = false
            left_name: mutable sview = ""
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            if node.operator in {"==", "!="}:
                left_name <- proof_kernel_replay_ident_name_with_goal_work(nodes, left_view.stripped, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                null_test <- left_name == "null"
                if not null_test:
                    right_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, right_view.stripped, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    null_test <- right_name == "null"
            return unknown if not left_conditional and not right_conditional
            return unknown if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            markers_ready <- true
            relation_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, goal_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return unknown if not relation_admission.complete or relation_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if not null_test:
                primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            conditional_root: usize = left_view.stripped if left_conditional else right_view.stripped
            conditional: ElisaProofKernelCore::ProofKernelNode = nodes[conditional_root]
            return unknown if:
                not proof_kernel_replay_arena_shape_valid(conditional)
                conditional.left >= nodes.count or conditional.right >= nodes.count or conditional.auxiliary >= nodes.count
                not proof_kernel_replay_valid(nodes, conditional.left) or not proof_kernel_replay_valid(nodes, conditional.right) or not proof_kernel_replay_valid(nodes, conditional.auxiliary)
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, conditional.left, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            on_left: bool = left_conditional
            arm_on_left: bool = on_left or (null_test and left_name == "null")
            other: usize = node.right if on_left else node.left
            return unknown if:
                not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", node.operator)
                not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", node.operator)
            then_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.right if arm_on_left else other, other if arm_on_left else conditional.right, 0, 0, 0, 0, "", "")
            else_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.auxiliary if arm_on_left else other, other if arm_on_left else conditional.auxiliary, 0, 0, 0, 0, "", "")
            return unknown if then_goal >= nodes.count or else_goal >= nodes.count
            then_local_work: mutable usize = PROOF_KERNEL_REPLAY_CONDITION_REFUTATION_WORK_LIMIT
            then_refuted: bool = proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes, children, facts, conditional.left, true, 0, &then_local_work, &markers, &markers_ready, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            else_local_work: mutable usize = PROOF_KERNEL_REPLAY_CONDITION_REFUTATION_WORK_LIMIT
            else_refuted: bool = proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes, children, facts, conditional.left, false, 0, &else_local_work, &markers, &markers_ready, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, conditional.left, then_goal, else_goal, then_refuted, else_refuted)
