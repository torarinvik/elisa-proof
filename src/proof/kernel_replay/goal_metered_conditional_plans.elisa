extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_CONDITION_REFUTATION_WORK_LIMIT: usize = 4096

        def proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, name: sview, depth: usize, work_used: mutable usize&) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            return node.name == name if node.kind == "ident"
            if node.kind == "paren" or node.kind == "unary":
                found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.left, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return found
            if node.kind == "binary":
                left_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.left, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if left_found
                right_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.right, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return right_found
            if node.kind == "if":
                left_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.left, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if left_found
                right_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.right, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if right_found
                auxiliary_found: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, node.auxiliary, name, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return auxiliary_found
            return false

        def proof_kernel_replay_conditional_alias_plan_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> (known: bool, index: usize, condition: usize, then_fact: usize, else_fact: usize, then_refuted: bool, else_refuted: bool):
            unknown: (known: bool, index: usize, condition: usize, then_fact: usize, else_fact: usize, then_refuted: bool, else_refuted: bool) = (false, 0, 0, 0, 0, false, false)
            return unknown if not proof_kernel_replay_goal_search_charge(work_used)
            return unknown if goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return unknown if goal.kind != "binary" or not proof_kernel_replay_arena_shape_valid(goal) or not proof_kernel_replay_negation_supported(goal.operator)
            return unknown if goal.left >= nodes.count or goal.right >= nodes.count or not proof_kernel_replay_valid(nodes, goal.left) or not proof_kernel_replay_valid(nodes, goal.right)
            return unknown if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
            return unknown if not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            for index in 0..<facts.count |index, facts, nodes, children, goal, markers, markers_ready, work_used|:
                return unknown if not proof_kernel_replay_goal_search_charge(work_used)
                root: usize = facts[index]
                continue if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                return unknown if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                continue if fact.left >= nodes.count or fact.right >= nodes.count or not proof_kernel_replay_valid(nodes, fact.left) or not proof_kernel_replay_valid(nodes, fact.right)
                return unknown if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
                return unknown if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, fact.right, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                alias: usize = fact.left if nodes[fact.left].kind == "ident" else fact.right
                conditional_root: usize = fact.right if nodes[fact.left].kind == "ident" else fact.left
                continue if nodes[alias].kind != "ident" or not proof_kernel_replay_arena_shape_valid(nodes[alias])
                occurs: bool = proof_kernel_replay_scalar_alias_occurs_with_goal_work(nodes, goal_root, nodes[alias].name, 0, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not occurs
                if not markers_ready:
                    markers <- proof_kernel_replay_witness_marker_cache_with_work(nodes, children, facts, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    markers_ready <- true
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, alias, conditional_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not primitive
                safe_difference: bool = proof_kernel_replay_unsigned_conditional_difference_safe_with_goal_work(nodes, children, facts, conditional_root, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not safe_difference
                conditional: ElisaProofKernelCore::ProofKernelNode = nodes[conditional_root]
                width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, alias, facts, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                conditional_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, conditional.right, facts, work_used, 0)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if width != conditional_width
                condition_root: usize = conditional.left
                continue if condition_root >= nodes.count or not proof_kernel_replay_valid(nodes, condition_root) or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, condition_root, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                condition: ElisaProofKernelCore::ProofKernelNode = nodes[condition_root]
                then_refuted: mutable bool = false
                else_refuted: mutable bool = false
                for fact_root in facts |fact_root, nodes, children, facts, condition, then_refuted, else_refuted, work_used|:
                    return unknown if not proof_kernel_replay_goal_search_charge(work_used)
                    order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_work(nodes, children, facts, fact_root, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not order.known
                    same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.left, condition.left, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_left
                    same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.right, condition.right, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not same_right
                    complement: sview = "<=" if condition.operator == ">" else "<" if condition.operator == ">=" else ">=" if condition.operator == "<" else ">"
                    then_refuted <- true if order.operator == complement
                    else_refuted <- true if order.operator == condition.operator
                return unknown if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", "==")
                return unknown if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", "==")
                then_fact: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", alias, conditional.right, 0, 0, 0, 0, "", "")
                else_fact: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", alias, conditional.auxiliary, 0, 0, 0, 0, "", "")
                return unknown if then_fact >= nodes.count or else_fact >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, index, conditional.left, then_fact, else_fact, then_refuted, else_refuted)
            unknown

        def proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, truth: bool, depth: usize, local_work: mutable usize&, markers: mutable darray[ProofKernelReplayWitnessMarker]&, markers_ready: mutable bool&, work_used: mutable usize&) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or local_work == 0 or not proof_kernel_replay_goal_search_charge(work_used)
            local_work <- local_work - 1
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            condition: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if condition.kind != "binary" or not proof_kernel_replay_arena_shape_valid(condition)
            return false if condition.left >= nodes.count or condition.right >= nodes.count or not proof_kernel_replay_valid(nodes, condition.left) or not proof_kernel_replay_valid(nodes, condition.right)
            return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, condition.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, condition.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if condition.operator == "and" or condition.operator == "or":
                left: bool = proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes, children, facts, condition.left, truth, depth + 1, local_work, markers, markers_ready, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right: bool = proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes, children, facts, condition.right, truth, depth + 1, local_work, markers, markers_ready, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return ((left or right) if truth else (left and right)) if condition.operator == "and" else ((left and right) if truth else (left or right))
            if condition.operator == "==" or condition.operator == "!=":
                if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                    markers <- proof_kernel_replay_witness_marker_cache_with_work(nodes, children, facts, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    markers_ready <- true
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, condition.left, condition.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if primitive:
                    desired: sview = ("!=" if condition.operator == "==" else "==") if truth else condition.operator
                    for fact in facts |fact, nodes, children, facts, condition, desired, markers, markers_ready, work_used|:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                        return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        f: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                        continue if f.kind != "binary" or f.operator != desired or not proof_kernel_replay_arena_shape_valid(f)
                        fact_primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, f.left, f.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        continue if not fact_primitive
                        same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, f.left, condition.left, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        continue if not same_left
                        same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, f.right, condition.right, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if same_right
            return false if not proof_kernel_replay_is_order_operator(condition.operator)
            return false if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if nodes[condition.left].kind != "ident" or nodes[condition.right].kind != "ident"
            width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, condition.left, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (width != 8 and width != 16 and width != 32 and width != 64)
            right_width: i64 = proof_kernel_replay_peer_unsigned_width_with_work(nodes, children, condition.right, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_width != width
            if not proof_kernel_replay_goal_bool_ref_value(markers_ready):
                markers <- proof_kernel_replay_witness_marker_cache_with_work(nodes, children, facts, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                markers_ready <- true
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            primitive_order: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, condition.left, condition.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive_order
            complement: sview = "<=" if condition.operator == ">" else "<" if condition.operator == ">=" else ">=" if condition.operator == "<" else ">"
            desired: sview = complement if truth else condition.operator
            for fact in facts |fact, nodes, children, facts, condition, desired, markers, markers_ready, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_work(nodes, children, facts, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not order.known or order.operator != desired
                same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.left, condition.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not same_left
                same_right: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, order.right, condition.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if same_right
            return false

        def proof_kernel_replay_ident_name_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> sview:
            return "" if root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return "" if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[root].kind != "ident"
            nodes[root].name

        def proof_kernel_replay_conditional_comparison_plan_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> (known: bool, condition: usize, then_goal: usize, else_goal: usize, then_refuted: bool, else_refuted: bool):
            unknown: (known: bool, condition: usize, then_goal: usize, else_goal: usize, then_refuted: bool, else_refuted: bool) = (false, 0, 0, 0, false, false)
            return unknown if not proof_kernel_replay_goal_search_charge(work_used)
            return unknown if goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return unknown if node.kind != "binary" or not proof_kernel_replay_negation_supported(node.operator)
            return unknown if node.left >= nodes.count or node.right >= nodes.count or not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
            return unknown if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
            return unknown if not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.right, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            null_test: mutable bool = false
            left_name: mutable sview = ""
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            markers_ready: mutable bool = false
            if node.operator == "==" or node.operator == "!=":
                left_name <- proof_kernel_replay_ident_name_with_goal_work(nodes, node.left, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                null_test <- left_name == "null"
                if not null_test:
                    right_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, node.right, work_used)
                    return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    null_test <- right_name == "null"
            return unknown if nodes[node.left].kind != "if" and nodes[node.right].kind != "if"
            if not null_test:
                markers <- proof_kernel_replay_witness_marker_cache_with_work(nodes, children, facts, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                markers_ready <- true
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            conditional_root: usize = node.left if nodes[node.left].kind == "if" else node.right
            conditional: ElisaProofKernelCore::ProofKernelNode = nodes[conditional_root]
            return unknown if not proof_kernel_replay_arena_shape_valid(conditional)
            return unknown if conditional.left >= nodes.count or conditional.right >= nodes.count or conditional.auxiliary >= nodes.count
            return unknown if not proof_kernel_replay_valid(nodes, conditional.left) or not proof_kernel_replay_valid(nodes, conditional.right) or not proof_kernel_replay_valid(nodes, conditional.auxiliary)
            return unknown if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
            return unknown if not proof_kernel_replay_goal_search_charge_node_text(nodes, conditional.left, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            on_left: bool = conditional_root == node.left
            arm_on_left: bool = on_left or (null_test and left_name == "null")
            other: usize = node.right if on_left else node.left
            return unknown if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", node.operator)
            return unknown if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", node.operator)
            then_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.right if arm_on_left else other, other if arm_on_left else conditional.right, 0, 0, 0, 0, "", "")
            else_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.auxiliary if arm_on_left else other, other if arm_on_left else conditional.auxiliary, 0, 0, 0, 0, "", "")
            return unknown if then_goal >= nodes.count or else_goal >= nodes.count
            then_local_work: mutable usize = PROOF_KERNEL_REPLAY_CONDITION_REFUTATION_WORK_LIMIT
            then_refuted: bool = proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes, children, facts, conditional.left, true, 0, &then_local_work, &markers, &markers_ready, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            else_local_work: mutable usize = PROOF_KERNEL_REPLAY_CONDITION_REFUTATION_WORK_LIMIT
            else_refuted: bool = proof_kernel_replay_unsigned_named_condition_refuted_with_goal_work(nodes, children, facts, conditional.left, false, 0, &else_local_work, &markers, &markers_ready, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, conditional.left, then_goal, else_goal, then_refuted, else_refuted)
