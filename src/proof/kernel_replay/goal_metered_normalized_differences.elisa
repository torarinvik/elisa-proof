extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_normalized_name_equal_with_work(left: sview, right: sview, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(left))
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(right))
            left == right

        def proof_kernel_replay_normal_comparison_signed_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: usize, right: usize, facts: darray[usize], work_used: mutable usize&) -> bool:
            left_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, left, work_used, 0)
            right_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, right, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left_width != 0 or right_width != 0

        def proof_kernel_replay_normal_term_has_width_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&) -> bool:
            signed_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, root, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if signed_width != 0
            unsigned_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, root, facts, work_used, 0)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and unsigned_width != 0

        # Metered counterpart of the normal-form reader. It keeps the same accepted syntax and
        # width evidence while charging each tree visit, marker lookup, term append, and name scan.
        def proof_kernel_replay_collect_normal_terms_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, sign: i64, signed: bool, facts: darray[usize], terms: mutable darray[ProofKernelReplayNormalTerm]&, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                terms.count >= PROOF_KERNEL_REPLAY_NORMAL_TERM_LIMIT
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "int":
                return false if node.value < 0
                scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(node.value, sign)
                return false if not scaled.known or not proof_kernel_replay_goal_search_charge(work_used)
                terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: scaled.value})
                return true
            if node.kind == "ident":
                return false if:
                    proof_kernel_replay_normalized_name_equal_with_work(node.name, "", work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_normal_term_has_width_with_work(nodes, children, root, facts, work_used)
                    not proof_kernel_replay_goal_search_charge(work_used)
                terms.push(ProofKernelReplayNormalTerm{name: node.name, coefficient: sign})
                return true
            if node.kind == "unary":
                return false if node.operator != "+" and node.operator != "-"
                negated: ProofKernelReplayInt = proof_kernel_replay_signed_negated_literal_with_goal_work(nodes, root, signed, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if negated.known:
                    scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(negated.value, sign)
                    return false if not scaled.known or not proof_kernel_replay_goal_search_charge(work_used)
                    terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: scaled.value})
                    return true
                return false if not proof_kernel_replay_normal_term_has_width_with_work(nodes, children, root, facts, work_used)
                flipped: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, sign)
                return false if not flipped.known or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_collect_normal_terms_with_work(nodes, children, node.left, sign if node.operator == "+" else flipped.value, signed, facts, terms, work_used, depth + 1)
            if node.kind == "binary":
                return false if:
                    node.operator != "+" and node.operator != "-"
                    not proof_kernel_replay_normal_term_has_width_with_work(nodes, children, root, facts, work_used)
                    not proof_kernel_replay_collect_normal_terms_with_work(nodes, children, node.left, sign, signed, facts, terms, work_used, depth + 1)
                flipped: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, sign)
                return false if not flipped.known
                return proof_kernel_replay_collect_normal_terms_with_work(nodes, children, node.right, sign if node.operator == "+" else flipped.value, signed, facts, terms, work_used, depth + 1)
            false

        def proof_kernel_replay_normal_difference_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, facts: darray[usize], work_used: mutable usize&) -> (known: bool, first: ProofKernelReplayAffine, second: ProofKernelReplayAffine):
            empty: ProofKernelReplayAffine = ProofKernelReplayAffine{known: false, base: "", offset: 0, negative: false}
            terms: mutable darray[ProofKernelReplayNormalTerm] = []
            signed: bool = proof_kernel_replay_normal_comparison_signed_with_work(nodes, children, left_root, right_root, facts, work_used)
            return (false, empty, empty) if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_collect_normal_terms_with_work(nodes, children, left_root, 1, signed, facts, &terms, work_used, 0)
                not proof_kernel_replay_collect_normal_terms_with_work(nodes, children, right_root, -1, signed, facts, &terms, work_used, 0)
            constant: mutable i64 = 0
            positive: mutable sview = ""
            negative: mutable sview = ""
            for index in 0..<terms.count |index, terms, constant, positive, negative, work_used|:
                return (false, empty, empty) if not proof_kernel_replay_goal_search_charge(work_used)
                term: ProofKernelReplayNormalTerm = terms[index]
                if proof_kernel_replay_normalized_name_equal_with_work(term.name, "", work_used):
                    folded: ProofKernelReplayInt = proof_kernel_replay_add_safe(constant, term.coefficient)
                    return (false, empty, empty) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not folded.known
                    constant <- folded.value
                    continue
                seen: mutable bool = false
                for earlier in 0..<index |earlier, index, terms, term, seen, work_used|:
                    return (false, empty, empty) if not proof_kernel_replay_goal_search_charge(work_used)
                    seen <- true if proof_kernel_replay_normalized_name_equal_with_work(terms[earlier].name, term.name, work_used)
                    return (false, empty, empty) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if seen
                total: mutable i64 = 0
                for later in index..<terms.count |later, terms, term, total, work_used|:
                    return (false, empty, empty) if not proof_kernel_replay_goal_search_charge(work_used)
                    matches: bool = proof_kernel_replay_normalized_name_equal_with_work(terms[later].name, term.name, work_used)
                    return (false, empty, empty) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    total <- total + terms[later].coefficient if matches
                continue if total == 0
                return (false, empty, empty) if total != 1 and total != -1
                if total == 1:
                    return (false, empty, empty) if not proof_kernel_replay_normalized_name_equal_with_work(positive, "", work_used)
                    positive <- term.name
                else:
                    return (false, empty, empty) if not proof_kernel_replay_normalized_name_equal_with_work(negative, "", work_used)
                    negative <- term.name
                return (false, empty, empty) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            (true, ProofKernelReplayAffine{known: true, base: positive, offset: constant, negative: false}, ProofKernelReplayAffine{known: true, base: negative, offset: 0, negative: false})

        def proof_kernel_replay_floor_quotient_with_work(numerator: i64, divisor: i64, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if not proof_kernel_replay_goal_search_charge(work_used) or divisor <= 0
            quotient: i64 = numerator / divisor
            product: ProofKernelReplayInt = proof_kernel_replay_mul_safe(quotient, divisor)
            return empty if not product.known or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return ProofKernelReplayInt{known: true, value: quotient - 1} if product.value > numerator
            ProofKernelReplayInt{known: true, value: quotient}

        def proof_kernel_replay_scaled_single_difference_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize], work_used: mutable usize&) -> (known: bool, first: ProofKernelReplayAffine, second: ProofKernelReplayAffine, operator: sview):
            empty: ProofKernelReplayAffine = ProofKernelReplayAffine{known: false, base: "", offset: 0, negative: false}
            terms: mutable darray[ProofKernelReplayNormalTerm] = []
            signed: bool = proof_kernel_replay_normal_comparison_signed_with_work(nodes, children, left_root, right_root, facts, work_used)
            return (false, empty, empty, operator) if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_collect_normal_terms_with_work(nodes, children, left_root, 1, signed, facts, &terms, work_used, 0)
                not proof_kernel_replay_collect_normal_terms_with_work(nodes, children, right_root, -1, signed, facts, &terms, work_used, 0)
            constant: mutable i64 = 0
            name: mutable sview = ""
            scale: mutable i64 = 0
            for index in 0..<terms.count |index, terms, constant, name, scale, work_used|:
                return (false, empty, empty, operator) if not proof_kernel_replay_goal_search_charge(work_used)
                term: ProofKernelReplayNormalTerm = terms[index]
                if proof_kernel_replay_normalized_name_equal_with_work(term.name, "", work_used):
                    folded: ProofKernelReplayInt = proof_kernel_replay_add_safe(constant, term.coefficient)
                    return (false, empty, empty, operator) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not folded.known
                    constant <- folded.value
                    continue
                seen: mutable bool = false
                for earlier in 0..<index |earlier, index, terms, term, seen, work_used|:
                    return (false, empty, empty, operator) if not proof_kernel_replay_goal_search_charge(work_used)
                    seen <- true if proof_kernel_replay_normalized_name_equal_with_work(terms[earlier].name, term.name, work_used)
                    return (false, empty, empty, operator) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if seen
                total: mutable i64 = 0
                for later in index..<terms.count |later, terms, term, total, work_used|:
                    return (false, empty, empty, operator) if not proof_kernel_replay_goal_search_charge(work_used)
                    matches: bool = proof_kernel_replay_normalized_name_equal_with_work(terms[later].name, term.name, work_used)
                    return (false, empty, empty, operator) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    total <- total + terms[later].coefficient if matches
                continue if total == 0
                return (false, empty, empty, operator) if not proof_kernel_replay_normalized_name_equal_with_work(name, "", work_used)
                name <- term.name
                scale <- total
            return (false, empty, empty, operator) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            name_empty: bool = proof_kernel_replay_normalized_name_equal_with_work(name, "", work_used)
            return (false, empty, empty, operator) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or name_empty or scale == 1 or scale == -1 or scale == 0
            if operator == "==":
                quotient: i64 = constant / scale
                product: ProofKernelReplayInt = proof_kernel_replay_mul_safe(quotient, scale)
                return (false, empty, empty, operator) if not product.known or product.value != constant
                return (true, ProofKernelReplayAffine{known: true, base: name, offset: quotient, negative: false}, ProofKernelReplayAffine{known: true, base: "", offset: 0, negative: false}, "==")
            coefficient: mutable i64 = scale
            offset: mutable i64 = constant
            if operator in {"<", ">", ">="}:
                if operator in {">", ">="}:
                    coefficient <- 0 - scale
                    flipped: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, constant)
                    return (false, empty, empty, operator) if not flipped.known
                    offset <- flipped.value
                if operator in {"<", ">"}:
                    stepped: ProofKernelReplayInt = proof_kernel_replay_add_safe(offset, 1)
                    return (false, empty, empty, operator) if not stepped.known
                    offset <- stepped.value
            elif operator != "<=":
                return (false, empty, empty, operator)
            negated: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, offset)
            return (false, empty, empty, operator) if not negated.known
            if coefficient > 0:
                upper: ProofKernelReplayInt = proof_kernel_replay_floor_quotient_with_work(negated.value, coefficient, work_used)
                return (false, empty, empty, operator) if not upper.known
                shifted: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, upper.value)
                return (false, empty, empty, operator) if not shifted.known
                return (true, ProofKernelReplayAffine{known: true, base: name, offset: shifted.value, negative: false}, ProofKernelReplayAffine{known: true, base: "", offset: 0, negative: false}, "<=")
            floor: ProofKernelReplayInt = proof_kernel_replay_floor_quotient_with_work(negated.value, 0 - coefficient, work_used)
            return (false, empty, empty, operator) if not floor.known
            lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, floor.value)
            return (false, empty, empty, operator) if not lower.known
            (true, ProofKernelReplayAffine{known: true, base: "", offset: lower.value, negative: false}, ProofKernelReplayAffine{known: true, base: name, offset: 0, negative: false}, "<=")

        def proof_kernel_replay_normalized_difference_comparison_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize], work_used: mutable usize&) -> bool:
            return false if operator != "==" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
            normal: (known: bool, first: ProofKernelReplayAffine, second: ProofKernelReplayAffine) = proof_kernel_replay_normal_difference_with_work(nodes, children, left_root, right_root, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if not normal.known:
                scaled: (known: bool, first: ProofKernelReplayAffine, second: ProofKernelReplayAffine, operator: sview) = proof_kernel_replay_scaled_single_difference_with_work(nodes, children, left_root, operator, right_root, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not scaled.known
                return proof_kernel_replay_difference_affine_comparison_with_work(nodes, children, scaled.first, scaled.operator, scaled.second, facts, true, work_used)
            proof_kernel_replay_difference_affine_comparison_with_work(nodes, children, normal.first, operator, normal.second, facts, true, work_used)
