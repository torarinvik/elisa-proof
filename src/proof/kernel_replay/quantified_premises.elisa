extend ElisaProofKernelReplay:
    private:
        # Independently recover a candidate; no producer hint is trusted.
        def proof_kernel_replay_finite_predicate_goal_candidate(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, remaining: usize) -> ProofKernelReplayInt:
            requires remaining > 0
            decreases remaining
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if remaining <= 1 or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "unary":
                return proof_kernel_replay_finite_predicate_goal_candidate(nodes, children, node.left, remaining - 1)
            if node.kind == "binary" and node.operator == "or":
                candidate = proof_kernel_replay_finite_predicate_goal_candidate(nodes, children, node.right, remaining - 1)
                return candidate if candidate.known
                return proof_kernel_replay_finite_predicate_goal_candidate(nodes, children, node.left, remaining - 1)
            if node.kind == "call":
                return empty if node.children_start > children.count or node.children_count > children.count - node.children_start
                for offset in 0..<node.children_count |nodes, children, node, remaining|:
                    argument_root: usize = children[node.children_start + offset]
                    continue if not proof_kernel_replay_valid(nodes, argument_root)
                    argument: ElisaProofKernelCore::ProofKernelNode = nodes[argument_root]
                    continue if argument.kind != "call_arg"
                    candidate = proof_kernel_replay_finite_predicate_goal_candidate(nodes, children, argument.left, remaining - 1)
                    return candidate if candidate.known
            if node.kind == "index":
                candidate = proof_kernel_replay_constant_int(nodes, node.right, 0)
                return candidate if candidate.known
                if proof_kernel_replay_valid(nodes, node.right):
                    index: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                    return proof_kernel_replay_constant_int(nodes, index.right, 0) if index.kind == "binary" and index.operator == "+"
            return empty

        # Independently expand only constant, finite universal range premises.
        def proof_kernel_replay_finite_universal_premise(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            for fact_index in 0..<facts.count |facts, nodes, children, root, split_depth, depth, remaining|:
                continue if not proof_kernel_replay_valid(nodes, facts[fact_index])
                quantifier: ElisaProofKernelCore::ProofKernelNode = nodes[facts[fact_index]]
                continue if quantifier.kind != "quantifier" or quantifier.operator != "forall" or quantifier.name == ""
                continue if not proof_kernel_replay_valid(nodes, quantifier.left) or not proof_kernel_replay_valid(nodes, quantifier.right)
                range: ElisaProofKernelCore::ProofKernelNode = nodes[quantifier.left]
                continue if range.kind != "binary" or (range.operator != "range_lt" and range.operator != "range_le")
                lower: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, range.left, 0)
                upper: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, range.right, 0)
                continue if not lower.known or not upper.known
                width: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(upper.value, lower.value)
                continue if not width.known
                width <- proof_kernel_replay_add_safe(width.value, 1) if range.operator == "range_le"
                continue if not width.known or width.value <= 0 or width.value > 64
                reduced: mutable darray[usize] = []
                for index in 0..<facts.count |facts, fact_index, reduced|:
                    reduced.push(facts[index]) if index != fact_index
                hint: ProofKernelReplayInt = proof_kernel_replay_finite_predicate_goal_candidate(nodes, children, root, remaining)
                hint_offset: ProofKernelReplayInt = proof_kernel_replay_sub_safe(hint.value, lower.value)
                if hint.known and hint.value >= 0 and hint_offset.known and hint_offset.value >= 0 and hint_offset.value < width.value:
                    hint_root: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, hint.value, "", "")
                    selected: usize = proof_kernel_replay_substitute(nodes, children, quantifier.right, quantifier.name, hint_root, 0)
                    if proof_kernel_replay_valid(nodes, selected):
                        reduced.push(selected)
                        return true if proof_kernel_replay_goal_depth_remaining(nodes, children, reduced, root, split_depth, depth + 1, remaining: remaining - 1)
                        reduced.pop()
                candidate: mutable i64 = lower.value
                offset: mutable i64 = 0
                while offset < width.value |offset, candidate, nodes, children, quantifier, reduced|:
                    candidate_root: mutable usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, candidate, "", "")
                    if candidate < 0:
                        magnitude: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, candidate)
                        return false if not magnitude.known
                        positive: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, magnitude.value, "", "")
                        candidate_root <- ElisaProofKernelCore::add_node(nodes, "unary", "-", positive, 0, 0, 0, 0, 0, "", "")
                    instance: usize = proof_kernel_replay_substitute(nodes, children, quantifier.right, quantifier.name, candidate_root, 0)
                    return false if not proof_kernel_replay_valid(nodes, instance)
                    reduced.push(instance)
                    offset <- offset + 1
                    if offset < width.value:
                        next: ProofKernelReplayInt = proof_kernel_replay_add_safe(candidate, 1)
                        return false if not next.known
                        candidate <- next.value
                return true if proof_kernel_replay_goal_depth_remaining(nodes, children, reduced, root, split_depth, depth + 1, remaining: remaining - 1)
            return false
