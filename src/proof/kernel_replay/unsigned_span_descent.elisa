extend ElisaProofKernelReplay:
    public:
        def proof_kernel_replay_unsigned_span_descent(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "<" or goal.left >= nodes.count or goal.right >= nodes.count
            low: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            high: ElisaProofKernelCore::ProofKernelNode = nodes[goal.right]
            return false if low.kind != "binary" or high.kind != "binary" or low.operator != "-" or high.operator != "-"
            end: usize = low.left
            next: usize = low.right
            start: usize = high.right
            return false if end >= nodes.count or next >= nodes.count or start >= nodes.count
            return false if nodes[next].kind != "ident" or nodes[start].kind != "ident"
            return false if not proof_kernel_replay_expr_equal(nodes, children, end, high.left, 0)
            width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, start, facts, 0)
            return false if width == 0 or proof_kernel_replay_unsigned_width_in_expression(nodes, children, next, facts, 0) != width
            if nodes[end].kind == "ident":
                return false if proof_kernel_replay_unsigned_width_in_expression(nodes, children, end, facts, 0) != width
            else:
                return false if nodes[end].kind != "int"
                value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, end, 0)
                return false if not value.known or value.value < 0 or value.value > 255
            return false if not proof_kernel_replay_has_order_fact(nodes, children, start, end, true, facts)
            for fact in facts |fact, nodes, children, next, start|:
                continue if fact >= nodes.count
                node: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                continue if node.kind != "binary" or node.operator != "=="
                term: mutable usize = nodes.count
                term <- node.right if proof_kernel_replay_expr_equal(nodes, children, node.left, next, 0)
                term <- node.left if proof_kernel_replay_expr_equal(nodes, children, node.right, next, 0)
                continue if term >= nodes.count
                sum: ElisaProofKernelCore::ProofKernelNode = nodes[term]
                continue if sum.kind != "binary" or sum.operator != "+"
                shifted: (known: bool, base: usize) = proof_kernel_replay_unsigned_unit_increment_base(nodes, sum.left, sum.right)
                return true if shifted.known and proof_kernel_replay_expr_equal(nodes, children, shifted.base, start, 0)
            return false
