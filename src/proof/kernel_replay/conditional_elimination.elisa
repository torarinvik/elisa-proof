extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_named_condition_refuted(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, truth: bool) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            condition = nodes[root]
            return false if condition.kind != "binary" or not proof_kernel_replay_arena_shape_valid(condition) or not proof_kernel_replay_is_order_operator(condition.operator)
            return false if not proof_kernel_replay_valid(nodes, condition.left) or not proof_kernel_replay_valid(nodes, condition.right)
            return false if nodes[condition.left].kind != "ident" or nodes[condition.right].kind != "ident"
            width: i64 = proof_kernel_replay_peer_unsigned_width(nodes, children, condition.left, facts)
            return false if width != 8 and width != 16 and width != 32 and width != 64
            return false if proof_kernel_replay_peer_unsigned_width(nodes, children, condition.right, facts) != width or not proof_kernel_replay_primitive_comparison(nodes, children, facts, condition.left, condition.right)
            complement: sview = "<=" if condition.operator == ">" else "<" if condition.operator == ">=" else ">=" if condition.operator == "<" else ">"
            desired: sview = complement if truth else condition.operator
            for fact in facts |fact, nodes, children, facts, condition, desired|:
                order = proof_kernel_replay_readable_order(nodes, children, facts, fact)
                return true if order.known and order.operator == desired and proof_kernel_replay_expr_equal(nodes, children, order.left, condition.left, 0) and proof_kernel_replay_expr_equal(nodes, children, order.right, condition.right, 0)
            return false
        # Build two goals without recursing. The original checker owns the
        # depth/split checks and both remaining-1 recursive calls.
        def proof_kernel_replay_conditional_comparison_plan(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> (known: bool, condition: usize, then_goal: usize, else_goal: usize, then_refuted: bool, else_refuted: bool):
            unknown: (known: bool, condition: usize, then_goal: usize, else_goal: usize, then_refuted: bool, else_refuted: bool) = (false, 0, 0, 0, false, false)
            return unknown if not proof_kernel_replay_valid(nodes, goal_root)
            node = nodes[goal_root]
            return unknown if node.kind != "binary" or not proof_kernel_replay_negation_supported(node.operator)
            return unknown if not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
            return unknown if nodes[node.left].kind != "if" and nodes[node.right].kind != "if"
            return unknown if not proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right)
            conditional_root: usize = node.left if nodes[node.left].kind == "if" else node.right
            conditional = nodes[conditional_root]
            return unknown if not proof_kernel_replay_arena_shape_valid(conditional)
            return unknown if not proof_kernel_replay_valid(nodes, conditional.left) or not proof_kernel_replay_valid(nodes, conditional.right) or not proof_kernel_replay_valid(nodes, conditional.auxiliary)
            on_left: bool = conditional_root == node.left
            then_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.right if on_left else node.left, node.right if on_left else conditional.right, 0, 0, 0, 0, "", "")
            else_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.auxiliary if on_left else node.left, node.right if on_left else conditional.auxiliary, 0, 0, 0, 0, "", "")
            return (true, conditional.left, then_goal, else_goal, proof_kernel_replay_unsigned_named_condition_refuted(nodes, children, facts, conditional.left, true), proof_kernel_replay_unsigned_named_condition_refuted(nodes, children, facts, conditional.left, false))
