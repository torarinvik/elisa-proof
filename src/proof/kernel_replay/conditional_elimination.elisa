extend ElisaProofKernelReplay:
    private:
        # Build two goals without recursing. The original checker owns the
        # depth/split checks and both remaining-1 recursive calls.
        def proof_kernel_replay_conditional_comparison_plan(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> (known: bool, condition: usize, then_goal: usize, else_goal: usize):
            unknown: (known: bool, condition: usize, then_goal: usize, else_goal: usize) = (false, 0, 0, 0)
            return unknown if not proof_kernel_replay_valid(nodes, goal_root)
            node = nodes[goal_root]
            return unknown if node.kind != "binary" or not proof_kernel_replay_negation_supported(node.operator)
            return unknown if not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
            return unknown if nodes[node.left].kind != "if" and nodes[node.right].kind != "if"
            return unknown if not proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right)
            conditional_root: usize = node.left if nodes[node.left].kind == "if" else node.right
            conditional = nodes[conditional_root]
            return unknown if not proof_kernel_replay_arena_shape_valid(conditional)
            return unknown if not proof_kernel_replay_valid(nodes, conditional.left) or not proof_kernel_replay_valid(nodes, conditional.right) or not proof_kernel_replay_valid(nodes, conditional.auxiliary)
            on_left: bool = conditional_root == node.left
            then_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.right if on_left else node.left, node.right if on_left else conditional.right, 0, 0, 0, 0, "", "")
            else_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.auxiliary if on_left else node.left, node.right if on_left else conditional.auxiliary, 0, 0, 0, 0, "", "")
            return (true, conditional.left, then_goal, else_goal)
