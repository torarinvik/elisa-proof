extend ElisaProofKernelReplay:
    private:
        # Mirror of `proof_push_base_bounds`.
        def proof_kernel_replay_close_plain_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&) -> bool:
            goal_work: mutable usize = 0
            return proof_kernel_replay_close_plain_bounds_with_goal_work(nodes, children, facts, bounds, &goal_work)

        # Mirror of `proof_close_bounds_from_facts`.
        def proof_kernel_replay_close_plain_bounds_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, goal_work: mutable usize&) -> bool:
            return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            constraints: mutable darray[ProofKernelReplayDifference] = []
            collection_work: mutable usize = 0
            for fact in facts |fact, nodes, children, facts, bounds, constraints, collection_work, goal_work|:
                return false if not proof_kernel_replay_goal_search_charge(goal_work)
                break if collection_work >= PROOF_KERNEL_REPLAY_DIFFERENCE_COLLECT_WORK_LIMIT or constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
                proof_kernel_replay_collect_plain_differences(nodes, children, fact, bounds, facts, &constraints, &collection_work, goal_work, 0)
            return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if constraints.count == 0
            return false if constraints.count > PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
            # Collection is goal-metered, so fixed-point propagation must be too. The legacy
            # helper repeatedly scans the constraint and bound arrays without a work counter;
            # use the indexed closure shared with the other goal-search paths. A failed closure
            # is never interpreted as a partial interval proof by callers.
            if not proof_kernel_replay_difference_bound_closure_with_work(constraints, bounds, goal_work):
                goal_work <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            return true

        def proof_kernel_replay_collect_plain_differences(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, bounds: darray[ProofKernelReplayBound]&, facts: darray[usize], constraints: mutable darray[ProofKernelReplayDifference]&, work_used: mutable usize&, goal_work: mutable usize&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not proof_kernel_replay_goal_search_charge(goal_work)
            return if work_used >= PROOF_KERNEL_REPLAY_DIFFERENCE_COLLECT_WORK_LIMIT or constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
            work_used <- work_used + 1
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary" and node.operator == "not":
                # Mirror of the producer's negated order: `not (a >= b)` is read as `a < b`.
                return if not proof_kernel_replay_valid(nodes, node.left)
                inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                return if inner.kind != "binary" or (inner.operator != "<" and inner.operator != "<=" and inner.operator != ">" and inner.operator != ">=")
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, inner.left, inner.right, goal_work, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
                return if not proof_kernel_replay_denial_integer_term_with_work(nodes, children, inner.left, facts, goal_work, 0) or not proof_kernel_replay_denial_integer_term_with_work(nodes, children, inner.right, facts, goal_work, 0)
                left_plain: bool = proof_kernel_replay_plain_order_side_with_goal_work(nodes, inner.left, goal_work)
                right_plain: bool = proof_kernel_replay_plain_order_side_with_goal_work(nodes, inner.right, goal_work)
                return if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_plain or not right_plain
                proof_kernel_replay_collect_differences_with_goal_work(nodes, root, bounds, children, facts, constraints, goal_work, depth + 1)
                return
            return if node.kind != "binary"
            if node.operator == "and":
                proof_kernel_replay_collect_plain_differences(nodes, children, node.left, bounds, facts, constraints, work_used, goal_work, depth + 1)
                proof_kernel_replay_collect_plain_differences(nodes, children, node.right, bounds, facts, constraints, work_used, goal_work, depth + 1)
                return
            return if node.operator != "==" and node.operator != "<" and node.operator != "<=" and node.operator != ">" and node.operator != ">="
            primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, goal_work, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            imported: bool = proof_kernel_replay_guarded_difference_import_with_work(nodes, children, node.left, node.operator, node.right, facts, constraints, goal_work)
            return if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or imported
            left_plain: bool = proof_kernel_replay_plain_order_side_with_goal_work(nodes, node.left, goal_work)
            right_plain: bool = proof_kernel_replay_plain_order_side_with_goal_work(nodes, node.right, goal_work)
            return if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_plain or not right_plain
            proof_kernel_replay_collect_differences_with_goal_work(nodes, root, bounds, children, facts, constraints, goal_work, depth + 1)

        def proof_kernel_replay_plain_order_side_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, goal_work: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(goal_work) or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return nodes[root].name != "" if nodes[root].kind == "ident"
            nodes[root].kind == "int" and nodes[root].value >= 0

        # Mirror of the producer's lazy closure: the plain-order closure only narrows intervals,
        # so it runs only when the collected bounds leave a root undecided.
        def proof_kernel_replay_unsigned_safe_closing_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, goal_work: mutable usize&) -> bool:
            safety_work: mutable usize = 0
            return true if proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, root, facts, bounds, &safety_work, goal_work, 0)
            return false if not proof_kernel_replay_close_plain_bounds_with_goal_work(nodes, children, facts, bounds, goal_work)
            proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, root, facts, bounds, &safety_work, goal_work, 0)

        # Mirror of `proof_close_defining_equalities`: two passes passing the interval of `expr`
        # to `name` over each `name == expr` fact or conjunct, in the goal tier only.
