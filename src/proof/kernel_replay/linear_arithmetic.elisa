const PROOF_KERNEL_REPLAY_LINEAR_TERM_LIMIT: usize = 512
const PROOF_KERNEL_REPLAY_LINEAR_ATOM_LIMIT: usize = 8
const PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT: usize = 24
const PROOF_KERNEL_REPLAY_LINEAR_ROW_LIMIT: usize = 256

extend ElisaProofKernelReplay:
    private:
        # Mirror of the producer's constraint span over the shared term buffer.
        struct ProofKernelReplayLinearSpan:
            start: usize
            stop: usize

        # Mirror of `proof_linear_collect`: an integer affine form under `+`, `-`, their unary
        # forms and `*` by a non-negative literal, every operator node carrying a width (a
        # signed one in `signed_only` mode).
        def proof_kernel_replay_linear_collect(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, sign: i64, signed: bool, signed_only: bool, facts: darray[usize], terms: mutable darray[ProofKernelReplayNormalTerm]&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if terms.count >= PROOF_KERNEL_REPLAY_LINEAR_TERM_LIMIT
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            match node.kind:
                "int":
                    return false if node.value < 0
                    scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(node.value, sign)
                    return false if not scaled.known
                    terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: scaled.value})
                    return true
                "ident":
                    return false if node.name == "" or not proof_kernel_replay_linear_term_has_width(nodes, children, root, signed_only, facts)
                    terms.push(ProofKernelReplayNormalTerm{name: node.name, coefficient: sign})
                    return true
                "unary":
                    return false if node.operator != "+" and node.operator != "-"
                    negated: ProofKernelReplayInt = proof_kernel_replay_signed_negated_literal(nodes, root, signed)
                    if negated.known:
                        scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(negated.value, sign)
                        return false if not scaled.known
                        terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: scaled.value})
                        return true
                    return false if not proof_kernel_replay_linear_term_has_width(nodes, children, root, signed_only, facts)
                    flipped: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, sign)
                    return false if not flipped.known
                    return proof_kernel_replay_linear_collect(nodes, children, node.left, sign if node.operator == "+" else flipped.value, signed, signed_only, facts, terms, depth + 1)
                "binary":
                    return false if not proof_kernel_replay_linear_term_has_width(nodes, children, root, signed_only, facts)
                    if node.operator == "*":
                        left_scale: ProofKernelReplayInt = proof_kernel_replay_linear_literal(nodes, node.left)
                        right_scale: ProofKernelReplayInt = proof_kernel_replay_linear_literal(nodes, node.right)
                        if left_scale.known:
                            scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(left_scale.value, sign)
                            return false if not scaled.known
                            return proof_kernel_replay_linear_collect(nodes, children, node.right, scaled.value, signed, signed_only, facts, terms, depth + 1)
                        if right_scale.known:
                            scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(right_scale.value, sign)
                            return false if not scaled.known
                            return proof_kernel_replay_linear_collect(nodes, children, node.left, scaled.value, signed, signed_only, facts, terms, depth + 1)
                        return false
                    return false if node.operator != "+" and node.operator != "-"
                    return false if not proof_kernel_replay_linear_collect(nodes, children, node.left, sign, signed, signed_only, facts, terms, depth + 1)
                    flipped: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, sign)
                    return false if not flipped.known
                    return proof_kernel_replay_linear_collect(nodes, children, node.right, sign if node.operator == "+" else flipped.value, signed, signed_only, facts, terms, depth + 1)
                _:
                    return false

        def proof_kernel_replay_linear_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return ProofKernelReplayInt{known: false, value: 0} if nodes[root].kind != "int" or nodes[root].value < 0
            return ProofKernelReplayInt{known: true, value: nodes[root].value}

        def proof_kernel_replay_linear_term_has_width(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, signed_only: bool, facts: darray[usize]) -> bool:
            return proof_kernel_replay_signed_width_in_expression(nodes, children, facts, root, 0) != 0 if signed_only
            return proof_kernel_replay_normal_term_has_width(nodes, children, root, facts)

        def proof_kernel_replay_linear_push_order(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, lower: usize, upper: usize, strict: bool, signed: bool, signed_only: bool, facts: darray[usize], terms: mutable darray[ProofKernelReplayNormalTerm]&, spans: mutable darray[ProofKernelReplayLinearSpan]&) -> bool:
            return false if spans.count >= PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT
            start: usize = terms.count
            return false if not proof_kernel_replay_linear_collect(nodes, children, lower, 1, signed, signed_only, facts, terms, 0)
            return false if not proof_kernel_replay_linear_collect(nodes, children, upper, -1, signed, signed_only, facts, terms, 0)
            terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: 1}) if strict
            spans.push(ProofKernelReplayLinearSpan{start: start, stop: terms.count})
            return true

        # Mirror of `proof_linear_push_comparison`; a failed `==` may leave one half.
        def proof_kernel_replay_linear_push_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: usize, operator: sview, right: usize, signed_only: bool, facts: darray[usize], terms: mutable darray[ProofKernelReplayNormalTerm]&, spans: mutable darray[ProofKernelReplayLinearSpan]&) -> bool:
            signed: bool = proof_kernel_replay_normal_comparison_signed(nodes, children, left, right, facts)
            read: mutable bool = false
            if operator == "<":
                read <- proof_kernel_replay_linear_push_order(nodes, children, left, right, true, signed, signed_only, facts, terms, spans)
            elif operator == "<=":
                read <- proof_kernel_replay_linear_push_order(nodes, children, left, right, false, signed, signed_only, facts, terms, spans)
            elif operator == ">":
                read <- proof_kernel_replay_linear_push_order(nodes, children, right, left, true, signed, signed_only, facts, terms, spans)
            elif operator == ">=":
                read <- proof_kernel_replay_linear_push_order(nodes, children, right, left, false, signed, signed_only, facts, terms, spans)
            elif operator == "==":
                read <- proof_kernel_replay_linear_push_order(nodes, children, left, right, false, signed, signed_only, facts, terms, spans) and proof_kernel_replay_linear_push_order(nodes, children, right, left, false, signed, signed_only, facts, terms, spans)
            return read
            return true

        def proof_kernel_replay_linear_comparison_operator(operator: sview) -> bool:
            return operator == "<" or operator == "<=" or operator == ">" or operator == ">=" or operator == "=="

        # Mirror of `proof_linear_fact_constraints`.
        def proof_kernel_replay_linear_fact_constraints(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], signed_only: bool, reserve: usize, terms: mutable darray[ProofKernelReplayNormalTerm]&, spans: mutable darray[ProofKernelReplayLinearSpan]&) -> void:
            for fact in facts |fact, nodes, children, facts, signed_only, reserve, terms, spans|:
                break if spans.count + reserve >= PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT
                proof_kernel_replay_linear_fact_parts(nodes, children, fact, false, facts, signed_only, reserve, terms, spans, 0)

        # Mirror of `proof_linear_fact_parts`.
        def proof_kernel_replay_linear_fact_parts(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, fact: usize, negated: bool, facts: darray[usize], signed_only: bool, reserve: usize, terms: mutable darray[ProofKernelReplayNormalTerm]&, spans: mutable darray[ProofKernelReplayLinearSpan]&, depth: usize) -> void:
            return if depth >= 16 or spans.count + reserve >= PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT
            return if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
            if node.kind == "paren":
                proof_kernel_replay_linear_fact_parts(nodes, children, node.left, negated, facts, signed_only, reserve, terms, spans, depth + 1)
                return
            if node.kind == "unary" and node.operator == "not":
                proof_kernel_replay_linear_fact_parts(nodes, children, node.left, not negated, facts, signed_only, reserve, terms, spans, depth + 1)
                return
            return if node.kind != "binary"
            if (node.operator == "and" and not negated) or (node.operator == "or" and negated):
                proof_kernel_replay_linear_fact_parts(nodes, children, node.left, negated, facts, signed_only, reserve, terms, spans, depth + 1)
                proof_kernel_replay_linear_fact_parts(nodes, children, node.right, negated, facts, signed_only, reserve, terms, spans, depth + 1)
                return
            negated_equality: bool = negated and node.operator == "!="
            return if not negated_equality and not proof_kernel_replay_linear_comparison_operator(node.operator)
            effective: sview = "==" if negated_equality else (proof_kernel_replay_linear_negation(node.operator) if negated else node.operator)
            return if effective == ""
            return if not proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right)
            return if signed_only and not proof_kernel_replay_signed_expression_safe(nodes, children, fact, facts)
            if spans.count + reserve + 2 <= PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT or effective != "==":
                proof_kernel_replay_linear_push_comparison(nodes, children, node.left, effective, node.right, signed_only, facts, terms, spans)

        def proof_kernel_replay_linear_gcd(left: i64, right: i64) -> i64:
            a: mutable i64 = left if left >= 0 else 0 - left
            b: mutable i64 = right if right >= 0 else 0 - right
            for step in 0..<128 |step, a, b|:
                break if b == 0
                remainder: i64 = a % b
                a <- b
                b <- remainder
            return a if a > 0 else 1

        # Mirror of `proof_linear_refutes`: Fourier-Motzkin with multiplier tracking, and every
        # derived contradiction accepted only through `proof_kernel_replay_linear_farkas_valid`.
        def proof_kernel_replay_linear_refutes(terms: darray[ProofKernelReplayNormalTerm]&, spans: darray[ProofKernelReplayLinearSpan]&) -> bool:
            count: usize = spans.count
            return false if count == 0 or count > PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT
            atoms: mutable darray[sview] = []
            # Only the spans' ranges are read: a comparison that failed to read may have left
            # terms behind it in the buffer.
            for span in spans |span, terms, atoms|:
                for position in span.start..<span.stop |position, terms, atoms|:
                    term: ProofKernelReplayNormalTerm = terms[position]
                    continue if term.name == ""
                    seen: mutable bool = false
                    for atom in atoms |atom, term, seen|:
                        seen <- true if atom == term.name
                    atoms.push(term.name) if not seen
            return false if atoms.count > PROOF_KERNEL_REPLAY_LINEAR_ATOM_LIMIT
            width: usize = atoms.count + 1 + count
            original: mutable darray[i64] = []
            for index in 0..<count |index, spans, terms, atoms, width, count, original|:
                row_start: usize = original.count
                for column in 0..<width |column, original|:
                    original.push(0)
                span: ProofKernelReplayLinearSpan = spans[index]
                for position in span.start..<span.stop |position, terms, atoms, row_start, original|:
                    term: ProofKernelReplayNormalTerm = terms[position]
                    column: mutable usize = atoms.count
                    for atom_index in 0..<atoms.count |atom_index, atoms, term, column|:
                        column <- atom_index if atoms[atom_index] == term.name
                    summed: ProofKernelReplayInt = proof_kernel_replay_add_safe(original[row_start + column], term.coefficient)
                    return false if not summed.known
                    original[row_start + column] <- summed.value
                original[row_start + atoms.count + 1 + index] <- 1
            rows: mutable darray[i64] = []
            rows.extend(original)
            row_count: mutable usize = count
            for atom_index in 0..<atoms.count |atom_index, width, rows, row_count|:
                next: mutable darray[i64] = []
                next_count: mutable usize = 0
                for row in 0..<row_count |row, width, atom_index, rows, next, next_count|:
                    if rows[row * width + atom_index] == 0:
                        for column in 0..<width |column, row, width, rows, next|:
                            next.push(rows[row * width + column])
                        next_count <- next_count + 1
                for positive in 0..<row_count |positive, width, atom_index, rows, next, next_count|:
                    upper: i64 = rows[positive * width + atom_index]
                    continue if upper <= 0
                    for negative in 0..<row_count |negative, positive, upper, width, atom_index, rows, next, next_count|:
                        lower: i64 = rows[negative * width + atom_index]
                        continue if lower >= 0
                        return false if next_count >= PROOF_KERNEL_REPLAY_LINEAR_ROW_LIMIT
                        divisor: i64 = proof_kernel_replay_linear_gcd(upper, lower)
                        positive_scale: i64 = (0 - lower) / divisor
                        negative_scale: i64 = upper / divisor
                        for column in 0..<width |column, positive, negative, positive_scale, negative_scale, width, rows, next|:
                            first: ProofKernelReplayInt = proof_kernel_replay_mul_safe(positive_scale, rows[positive * width + column])
                            second: ProofKernelReplayInt = proof_kernel_replay_mul_safe(negative_scale, rows[negative * width + column])
                            return false if not first.known or not second.known
                            combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(first.value, second.value)
                            return false if not combined.known
                            next.push(combined.value)
                        next_count <- next_count + 1
                rows <- next
                row_count <- next_count
            for row in 0..<row_count |row, width, atoms, rows, original, count|:
                continue if rows[row * width + atoms.count] <= 0
                multipliers: mutable darray[i64] = []
                for index in 0..<count |index, row, width, atoms, rows, multipliers|:
                    multipliers.push(rows[row * width + atoms.count + 1 + index])
                return true if proof_kernel_replay_linear_farkas_valid(original, atoms.count, width, multipliers)
            return false

        # The `linear-farkas` rule: non-negative multipliers, not all zero, cancelling every
        # atom of the original rows and leaving a positive constant.
        def proof_kernel_replay_linear_farkas_valid(original: darray[i64]&, atom_count: usize, width: usize, multipliers: darray[i64]&) -> bool:
            any_positive: mutable bool = false
            for multiplier in multipliers |multiplier, any_positive|:
                return false if multiplier < 0
                any_positive <- true if multiplier > 0
            return false if not any_positive
            for column in 0..<(atom_count + 1) |column, original, atom_count, width, multipliers|:
                total: mutable i64 = 0
                for index in 0..<multipliers.count |index, column, original, width, multipliers, total|:
                    product: ProofKernelReplayInt = proof_kernel_replay_mul_safe(multipliers[index], original[index * width + column])
                    return false if not product.known
                    summed: ProofKernelReplayInt = proof_kernel_replay_add_safe(total, product.value)
                    return false if not summed.known
                    total <- summed.value
                return false if column < atom_count and total != 0
                return false if column == atom_count and total <= 0
            return true

        def proof_kernel_replay_linear_negation(operator: sview) -> sview:
            return ">=" if operator == "<"
            return ">" if operator == "<="
            return "<=" if operator == ">"
            return "<" if operator == ">="
            return ""

        # Mirror of `proof_linear_arithmetic_goal`, reached after every wrap guard.
        def proof_kernel_replay_linear_arithmetic_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: usize, operator: sview, right: usize, facts: darray[usize]) -> bool:
            if operator == "==":
                return proof_kernel_replay_linear_arithmetic_goal(nodes, children, left, "<=", right, facts) and proof_kernel_replay_linear_arithmetic_goal(nodes, children, left, ">=", right, facts)
            # A goal carrying a linear certificate is decided by that certificate alone, so a
            # forged one is refused rather than bypassed (mirror of the producer).
            for fact in facts |fact, nodes|:
                return false if proof_kernel_replay_linear_marker(nodes, fact)
            negated: sview = proof_kernel_replay_linear_negation(operator)
            return false if negated == ""
            terms: mutable darray[ProofKernelReplayNormalTerm] = []
            spans: mutable darray[ProofKernelReplayLinearSpan] = []
            proof_kernel_replay_linear_fact_constraints(nodes, children, facts, false, 1, &terms, &spans)
            return false if not proof_kernel_replay_linear_push_comparison(nodes, children, left, negated, right, false, facts, &terms, &spans)
            return proof_kernel_replay_linear_refutes(terms, spans)

        # Mirror of `proof_linear_disequality_refuted`.
        def proof_kernel_replay_linear_disequality_refuted(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]) -> bool:
            for fact in facts |fact, nodes, children, facts|:
                pair: (known: bool, left: usize, right: usize) = proof_kernel_replay_linear_disequality(nodes, fact, 0)
                continue if not pair.known
                return true if proof_kernel_replay_primitive_comparison(nodes, children, facts, pair.left, pair.right) and proof_kernel_replay_linear_arithmetic_goal(nodes, children, pair.left, "==", pair.right, facts)
            return false

        def proof_kernel_replay_linear_disequality(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> (known: bool, left: usize, right: usize):
            return (false, 0, 0) if depth >= 8 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_linear_disequality(nodes, node.left, depth + 1) if node.kind == "paren"
            return (true, node.left, node.right) if node.kind == "binary" and node.operator == "!="
            return (false, 0, 0) if node.kind != "unary" or node.operator != "not"
            inner: mutable usize = node.left
            for step in 0..<8 |step, nodes, inner|:
                break if inner >= nodes.count or not proof_kernel_replay_valid(nodes, inner) or nodes[inner].kind != "paren"
                inner <- nodes[inner].left
            return (false, 0, 0) if inner >= nodes.count or not proof_kernel_replay_valid(nodes, inner)
            return (true, nodes[inner].left, nodes[inner].right) if nodes[inner].kind == "binary" and nodes[inner].operator == "=="
            return (false, 0, 0)

        def proof_kernel_replay_linear_is_or(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return root < nodes.count and proof_kernel_replay_valid(nodes, root) and nodes[root].kind == "binary" and nodes[root].operator == "or"

        # Mirror of `proof_linear_prune`. Truth 2 is refuted.
        def proof_kernel_replay_linear_prune(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], base_terms: darray[ProofKernelReplayNormalTerm]&, base_spans: darray[ProofKernelReplayLinearSpan]&, root: usize, depth: usize) -> (truth: i64, changed: bool, root: usize):
            return (0, false, root) if depth >= 32 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_linear_prune(nodes, children, facts, base_terms, base_spans, node.left, depth + 1) if node.kind == "paren"
            return (0, false, root) if node.kind != "binary"
            if node.operator == "or":
                left_result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_linear_prune(nodes, children, facts, base_terms, base_spans, node.left, depth + 1)
                right_result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_linear_prune(nodes, children, facts, base_terms, base_spans, node.right, depth + 1)
                return (2, true, root) if left_result.truth == 2 and right_result.truth == 2
                return (1, true, root) if left_result.truth == 1 or right_result.truth == 1
                return (right_result.truth, true, right_result.root) if left_result.truth == 2
                return (left_result.truth, true, left_result.root) if right_result.truth == 2
                return (0, false, root) if not left_result.changed and not right_result.changed
                joined: usize = ElisaProofKernelCore::add_node(nodes, "binary", "or", left_result.root, right_result.root, 0, 0, 0, 0, "", "")
                return (0, joined < nodes.count, joined if joined < nodes.count else root)
            return (0, false, root) if not proof_kernel_replay_linear_comparison_operator(node.operator)
            return (0, false, root) if not proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right) or not proof_kernel_replay_signed_expression_safe(nodes, children, root, facts)
            terms: mutable darray[ProofKernelReplayNormalTerm] = []
            spans: mutable darray[ProofKernelReplayLinearSpan] = []
            terms.extend(base_terms)
            spans.extend(base_spans)
            return (0, false, root) if not proof_kernel_replay_linear_push_comparison(nodes, children, node.left, node.operator, node.right, true, facts, &terms, &spans)
            return (2, false, root) if proof_kernel_replay_linear_refutes(terms, spans)
            negated: sview = proof_kernel_replay_linear_negation(node.operator)
            return (0, false, root) if negated == "" or negated == "!="
            entail_terms: mutable darray[ProofKernelReplayNormalTerm] = []
            entail_spans: mutable darray[ProofKernelReplayLinearSpan] = []
            entail_terms.extend(base_terms)
            entail_spans.extend(base_spans)
            return (0, false, root) if not proof_kernel_replay_linear_push_comparison(nodes, children, node.left, negated, node.right, true, facts, &entail_terms, &entail_spans)
            return (1, true, root) if proof_kernel_replay_linear_refutes(entail_terms, entail_spans)
            return (0, false, root)

        # Mirror of `proof_linear_prune_facts`: 0 unchanged, 1 pruned, 2 inconsistent.
        def proof_kernel_replay_linear_prune_facts(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], pruned: mutable darray[usize]&) -> i64:
            base: mutable darray[usize] = []
            disjunctive: mutable bool = false
            for fact in facts |fact, nodes, base, disjunctive|:
                if proof_kernel_replay_linear_is_or(nodes, fact):
                    disjunctive <- true
                else:
                    base.push(fact)
            return 0 if not disjunctive
            base_terms: mutable darray[ProofKernelReplayNormalTerm] = []
            base_spans: mutable darray[ProofKernelReplayLinearSpan] = []
            proof_kernel_replay_linear_fact_constraints(nodes, children, base, true, 2, &base_terms, &base_spans)
            return 0 if base_spans.count == 0
            changed: mutable bool = false
            for fact in facts |fact, nodes, children, facts, base_terms, base_spans, pruned, changed|:
                if proof_kernel_replay_linear_is_or(nodes, fact):
                    result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_linear_prune(nodes, children, facts, base_terms, base_spans, fact, 0)
                    return 2 if result.truth == 2
                    if result.truth == 1:
                        changed <- true
                        continue
                    if result.changed:
                        changed <- true
                        pruned.push(result.root)
                        continue
                pruned.push(fact)
            return 1 if changed
            return 0
