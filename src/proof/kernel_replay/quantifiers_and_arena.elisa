const PROOF_KERNEL_REPLAY_QUANTIFIER_KEY_MARKER: sview = "__elisa_kernel_quantifier_key_marker"
const PROOF_KERNEL_REPLAY_QUANTIFIER_VALUE_MARKER: sview = "__elisa_kernel_quantifier_value_marker"

extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_quantifier_marker_available(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, marker: sview) -> bool:
            for node in nodes:
                return false if node.name == marker or node.secondary_name == marker
            return true

        # Lower the two dictionary binders to fresh marker identifiers first, then replace
        # both markers with their range expressions. This implements simultaneous substitution:
        # an occurrence inserted for one binder cannot be rewritten as the other binder.
        def proof_kernel_replay_substitute_dictionary_pair(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, body: usize, key_binder: sview, value_binder: sview, key_value: usize, value_value: usize, key_marker: usize, value_marker: usize) -> usize:
            return ElisaProofKernelCore::add_node(nodes, "unsupported", "dictionary-binder-alias", 0, 0, 0, 0, 0, 0, "", "") if key_binder == value_binder
            key_marked: usize = proof_kernel_replay_substitute(nodes, children, body, key_binder, key_marker, 0)
            both_marked: usize = proof_kernel_replay_substitute(nodes, children, key_marked, value_binder, value_marker, 0)
            key_replaced: usize = proof_kernel_replay_substitute(nodes, children, both_marked, PROOF_KERNEL_REPLAY_QUANTIFIER_KEY_MARKER, key_value, 0)
            return proof_kernel_replay_substitute(nodes, children, key_replaced, PROOF_KERNEL_REPLAY_QUANTIFIER_VALUE_MARKER, value_value, 0)

        def proof_kernel_replay_replace_exact(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, from_root: usize, replacement_root: usize, depth: usize) -> (changed: bool, value: usize):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (false, root) if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            return (true, replacement_root) if proof_kernel_replay_expr_equal(nodes, children, root, from_root, 0)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return (false, root) if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return (false, root) if node.kind == "int" or node.kind == "bool" or node.kind == "float" or node.kind == "string" or node.kind == "char" or node.kind == "ident" or node.kind == "shorthand" or node.kind == "absent" or node.kind == "unsupported"
            if node.kind == "unary" or node.kind == "move" or node.kind == "field" or node.kind == "scope" or node.kind == "call_arg" or node.kind == "field-init" or node.kind == "checked-get":
                child: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                return (false, root) if not child.changed
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, child.value, node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            if node.kind == "binary" or node.kind == "index" or node.kind == "dict_entry" or node.kind == "checked-index":
                left: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                right: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.right, from_root, replacement_root, depth + 1)
                return (false, root) if not left.changed and not right.changed
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, left.value if left.changed else node.left, right.value if right.changed else node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            if node.kind == "slice" or node.kind == "if":
                left: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                right: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.right, from_root, replacement_root, depth + 1)
                auxiliary: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.auxiliary, from_root, replacement_root, depth + 1)
                return (false, root) if not left.changed and not right.changed and not auxiliary.changed
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, left.value if left.changed else node.left, right.value if right.changed else node.right, auxiliary.value if auxiliary.changed else node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            if node.kind == "quantifier":
                # The binder scopes the body. The source-neutral arena currently represents
                # names directly rather than with binding levels, so descending into the body
                # could capture a free name from the equality replacement (for example, rewrite
                # `y` to `x` under `forall x`). Rewriting the range is safe because the current
                # binder is not in scope there; leave the body opaque until the arena grows an
                # explicit capture-avoiding representation.
                range: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                return (false, root) if not range.changed
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, "quantifier", node.operator, range.value, node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            if node.kind == "index-n" or node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call":
                return (false, root) if node.children_start > children.count or node.children_count > children.count - node.children_start
                return (false, root) if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                base_value: mutable usize = node.left
                base_changed: mutable bool = false
                if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call":
                    rewritten_base: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                    base_value <- rewritten_base.value
                    base_changed <- rewritten_base.changed
                rewritten_children: mutable darray[usize] = []
                any_changed: mutable bool = base_changed
                for index in 0..<node.children_count |index, node, children, nodes, from_root, replacement_root, depth, rewritten_children, any_changed|:
                    child: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, children[node.children_start + index], from_root, replacement_root, depth + 1)
                    rewritten_children.push(child.value)
                    any_changed <- true if child.changed
                return (false, root) if not any_changed
                start: usize = children.count
                return (true, nodes.count) if not proof_kernel_replay_extend_children(children, rewritten_children)
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, base_value, node.right, node.auxiliary, start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            return (false, root)

        def proof_kernel_replay_quantifier_values(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], body: usize, binder: sview, values_start: usize, values_count: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if values_count == 0 and kind == "exists"
            return false if values_count > PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_VALUES or values_start > children.count or values_count > children.count - values_start
            return false if not proof_kernel_replay_child_range_valid(values_start, values_count, children.count)
            for index in 0..<values_count |index, children, nodes, facts, body, binder, kind, values_start|:
                instance: usize = proof_kernel_replay_substitute(nodes, children, body, binder, children[values_start + index], 0)
                proven: bool = proof_kernel_replay_goal_depth(nodes, children, facts, instance, 0, depth + 1)
                return false if kind == "forall" and not proven
                return true if kind == "exists" and proven
            return kind == "forall"

        def proof_kernel_replay_quantifier_entries(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], body: usize, key_binder: sview, value_binder: sview, range: ElisaProofKernelCore::ProofKernelNode, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if range.children_count == 0 and kind == "exists"
            return false if range.children_count > PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_ENTRIES or range.children_start > children.count or range.children_count > children.count - range.children_start
            return false if not proof_kernel_replay_child_range_valid(range.children_start, range.children_count, children.count)
            return false if key_binder == value_binder or not proof_kernel_replay_quantifier_marker_available(nodes, PROOF_KERNEL_REPLAY_QUANTIFIER_KEY_MARKER) or not proof_kernel_replay_quantifier_marker_available(nodes, PROOF_KERNEL_REPLAY_QUANTIFIER_VALUE_MARKER)
            key_marker: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, PROOF_KERNEL_REPLAY_QUANTIFIER_KEY_MARKER, "")
            value_marker: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, PROOF_KERNEL_REPLAY_QUANTIFIER_VALUE_MARKER, "")
            for index in 0..<range.children_count |index, range, children, nodes, facts, body, key_binder, value_binder, kind|:
                entry_root: usize = children[range.children_start + index]
                return false if entry_root >= nodes.count or not proof_kernel_replay_valid(nodes, entry_root)
                entry: ElisaProofKernelCore::ProofKernelNode = nodes[entry_root]
                return false if entry.kind != "dict_entry"
                instance: usize = proof_kernel_replay_substitute_dictionary_pair(nodes, children, body, key_binder, value_binder, entry.left, entry.right, key_marker, value_marker)
                proven: bool = proof_kernel_replay_goal_depth(nodes, children, facts, instance, 0, depth + 1)
                return false if kind == "forall" and not proven
                return true if kind == "exists" and proven
            return kind == "forall"

        def proof_kernel_replay_quantifier(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if kind != "forall" and kind != "exists"
            return false if not proof_kernel_replay_valid(nodes, root)
            quantifier: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if quantifier.kind != "quantifier"
            return false if quantifier.operator != kind
            return false if not proof_kernel_replay_valid(nodes, quantifier.left) or not proof_kernel_replay_valid(nodes, quantifier.right)
            range: ElisaProofKernelCore::ProofKernelNode = nodes[quantifier.left]
            if range.kind == "binary" and (range.operator == "range_lt" or range.operator == "range_le"):
                lower: ProofKernelReplayInt = proof_kernel_replay_exact_int(nodes, children, range.left, facts)
                upper: ProofKernelReplayInt = proof_kernel_replay_exact_int(nodes, children, range.right, facts)
                return false if not lower.known or not upper.known
                return kind == "forall" if range.operator == "range_lt" and lower.value >= upper.value
                return kind == "forall" if range.operator == "range_le" and lower.value > upper.value
                width: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(upper.value, lower.value)
                return false if not width.known
                if range.operator == "range_le":
                    width_with_end: ProofKernelReplayInt = proof_kernel_replay_add_safe(width.value, 1)
                    return false if not width_with_end.known
                    width <- width_with_end
                return false if width.value <= 0 or width.value > PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_VALUES
                candidate: mutable i64 = lower.value
                offset: mutable i64 = 0
                while offset < width.value |offset, candidate, facts, nodes, children, quantifier, kind|:
                    candidate_root: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, candidate, "", "")
                    instance: usize = proof_kernel_replay_substitute(nodes, children, quantifier.right, quantifier.name, candidate_root, 0)
                    proven: bool = proof_kernel_replay_goal_depth(nodes, children, facts, instance, 0, depth + 1)
                    return false if kind == "forall" and not proven
                    return true if kind == "exists" and proven
                    offset <- offset + 1
                    if offset < width.value:
                        next_candidate: ProofKernelReplayInt = proof_kernel_replay_add_safe(candidate, 1)
                        return false if not next_candidate.known
                        candidate <- next_candidate.value
                return kind == "forall"
            match range.kind:
                "array":
                    return proof_kernel_replay_quantifier_values(nodes, children, kind, facts, quantifier.right, quantifier.name, range.children_start, range.children_count, depth + 1)
                "tuple":
                    return proof_kernel_replay_quantifier_values(nodes, children, kind, facts, quantifier.right, quantifier.name, range.children_start, range.children_count, depth + 1)
                "set":
                    return proof_kernel_replay_quantifier_values(nodes, children, kind, facts, quantifier.right, quantifier.name, range.children_start, range.children_count, depth + 1)
                "dict":
                    return proof_kernel_replay_quantifier_entries(nodes, children, kind, facts, quantifier.right, quantifier.name, quantifier.secondary_name, range, depth + 1) if quantifier.auxiliary == 2
                    return false
                _:
                    return false

        def proof_kernel_replay_arena_child_valid(validity: darray[bool]&, root: usize) -> bool:
            located: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, root)
            return located.known and located.value

        def proof_kernel_replay_arena_child_kind_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, validity: darray[bool]&, root: usize, wanted: sview) -> bool:
            return false if root >= validity.count or root >= nodes.count
            return false if not validity[root]
            return false if nodes[root].kind != wanted
            return true

        def proof_kernel_replay_arena_children_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, node: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, validity: darray[bool]&) -> bool:
            if node.kind == "unary" or node.kind == "move" or node.kind == "field" or node.kind == "scope" or node.kind == "call_arg" or node.kind == "field-init" or node.kind == "effect-call" or node.kind == "checked-get" or node.kind == "resource-call-arg" or node.kind == "resource-region-alloc" or node.kind == "resource-region-alloc-discard" or node.kind == "resource-region-return-alloc" or node.kind == "resource-region-call-alloc" or node.kind == "resource-region-rebind-alloc" or node.kind == "resource-region-bind" or node.kind == "resource-region-assign" or node.kind == "resource-region-return" or node.kind == "resource-call-result":
                return proof_kernel_replay_arena_child_valid(validity, node.left)
            if node.kind == "binary" or node.kind == "index" or node.kind == "dict_entry" or node.kind == "checked-index":
                return false if not proof_kernel_replay_arena_child_valid(validity, node.left)
                return proof_kernel_replay_arena_child_valid(validity, node.right)
            if node.kind == "slice":
                return false if not proof_kernel_replay_arena_child_valid(validity, node.left)
                return false if not proof_kernel_replay_arena_child_valid(validity, node.right)
                return proof_kernel_replay_arena_child_valid(validity, node.auxiliary)
            if node.kind == "if":
                return false if not proof_kernel_replay_arena_child_valid(validity, node.left)
                return false if not proof_kernel_replay_arena_child_valid(validity, node.right)
                return proof_kernel_replay_arena_child_valid(validity, node.auxiliary)
            if node.kind == "quantifier":
                return false if not proof_kernel_replay_arena_child_valid(validity, node.left)
                return proof_kernel_replay_arena_child_valid(validity, node.right)
            if node.kind == "effect-containment":
                declared_row: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if not declared_row.known or not declared_row.value
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, nodes, validity|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "effect-call")
                return true
            if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call" or node.kind == "effect-row" or node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict" or node.kind == "resource-call" or node.kind == "resource-call-lend":
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call" or node.kind == "resource-call":
                    collection_head: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                    return false if not collection_head.known or not collection_head.value
                for index in 0..<node.children_count |index, node, children, validity|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    return false if not proof_kernel_replay_arena_child_valid(validity, child.value)
                    if node.kind == "construct" or node.kind == "record-update":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "field-init")
                    if node.kind == "call":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "call_arg")
                    if node.kind == "effect-row":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "effect")
                    if node.kind == "effect-containment":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "effect-call")
                    if node.kind == "resource-call" and index < node.auxiliary:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-arg")
                    if node.kind == "resource-call" and index >= node.auxiliary:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-region")
                    if node.kind == "resource-call-lend" and index < node.auxiliary:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-arg")
                        shared_child: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, child.value)
                        return false if not shared_child.known or shared_child.node.operator == "region-new"
                    if node.kind == "resource-call-lend" and index >= node.auxiliary and index < node.auxiliary * 2:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-formal")
                    if node.kind == "resource-call-lend" and index >= node.auxiliary * 2:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-region")
                return true
            if node.kind == "resource-scope" or node.kind == "resource-safety" or node.kind == "structural-safety" or node.kind == "structural-edge":
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, validity|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    return false if not proof_kernel_replay_arena_child_valid(validity, child.value)
                    if node.kind == "structural-safety":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "structural-edge")
                    if node.kind == "structural-edge":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "structural-argument")
                return true
            if node.kind == "resource-disjoint":
                left_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if not left_child.known or not left_child.value
                right_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.right)
                return false if not right_child.known or not right_child.value
                goal_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.auxiliary)
                return false if not goal_child.known or not goal_child.value
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, validity|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    child_validity: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, child.value)
                    return false if not child_validity.known or not child_validity.value
                return true
            if node.kind == "resource-bind":
                return true if node.operator == "value" or node.operator == "external-shared" or node.operator == "external-mutable"
                source: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return source.known and source.value
            if node.kind == "resource-write" or node.kind == "resource-move":
                place: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return place.known and place.value
            if node.kind == "resource-use":
                place: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return place.known and place.value
            return true
