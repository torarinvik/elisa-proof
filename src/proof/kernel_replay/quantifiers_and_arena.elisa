const PROOF_KERNEL_REPLAY_QUANTIFIER_KEY_MARKER: sview = "__elisa_kernel_quantifier_key_marker"
const PROOF_KERNEL_REPLAY_QUANTIFIER_VALUE_MARKER: sview = "__elisa_kernel_quantifier_value_marker"

extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_REPLACE_EXACT_WORK_LIMIT: usize = 65536

        def proof_kernel_replay_quantifier_charge_work(work_used: mutable usize&, amount: usize) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if amount > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - work_used:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_quantifier_small_signed_bound(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count or nodes[root].kind != "unary" or nodes[root].operator != "-"
            operand: usize = nodes[root].left
            return false if operand >= nodes.count or nodes[operand].kind != "int" or proof_kernel_replay_int_tagged(nodes[operand])
            return nodes[operand].value >= 0 and nodes[operand].value <= 127

        def proof_kernel_quantifier_small_signed_bound_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            proof_kernel_quantifier_small_signed_bound(nodes, root)

        def proof_kernel_replay_quantifier_constant_int_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if not constant.known and work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return empty
            return constant

        def proof_kernel_replay_quantifier_safe_comparison_constant_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            if root < nodes.count and nodes[root].kind == "int" and nodes[root].value >= 0:
                return empty if not proof_kernel_replay_quantifier_charge_work(work_used, 1)
                return ProofKernelReplayInt{known: true, value: nodes[root].value}
            proof_kernel_replay_small_constant_with_goal_work(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)

        def proof_kernel_replay_quantifier_exact_int_from_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, constant: ProofKernelReplayInt, bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return constant if constant.known
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or nodes[root].kind != "ident" or nodes[root].name == ""
            bound: ProofKernelReplayBound = proof_kernel_replay_bound_for_with_work(bounds, nodes[root].name, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return ProofKernelReplayInt{known: true, value: bound.lower} if bound.has_lower and bound.has_upper and bound.lower == bound.upper
            return empty

        def proof_kernel_replay_quantifier_marker_available(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, marker: sview) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_quantifier_marker_available_with_work(nodes, marker, &work_used)

        def proof_kernel_replay_quantifier_marker_available_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, marker: sview, work_used: mutable usize&) -> bool:
            for node in nodes |node, nodes, marker, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    node.name == marker or node.secondary_name == marker
            return true

        # Lower the two dictionary binders to fresh marker identifiers first, then replace
        # both markers with their range expressions. This implements simultaneous substitution:
        # an occurrence inserted for one binder cannot be rewritten as the other binder.
        def proof_kernel_replay_substitute_dictionary_pair(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, body: usize, key_binder: sview, value_binder: sview, key_value: usize, value_value: usize, key_marker: usize, value_marker: usize) -> usize:
            work_used: mutable usize = 0
            proof_kernel_replay_substitute_dictionary_pair_with_work_limit(nodes, children, body, key_binder, value_binder, key_value, value_value, key_marker, value_marker, &work_used, PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT)

        def proof_kernel_replay_substitute_dictionary_pair_with_work_limit(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, body: usize, key_binder: sview, value_binder: sview, key_value: usize, value_value: usize, key_marker: usize, value_marker: usize, work_used: mutable usize&, work_limit: usize) -> usize:
            return ElisaProofKernelCore::add_node(nodes, "unsupported", "dictionary-binder-alias", 0, 0, 0, 0, 0, 0, "", "") if key_binder == value_binder
            key_marked: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, body, key_binder, key_marker, 0, work_used, work_limit)
            return nodes.count if key_marked >= nodes.count or work_used > work_limit
            both_marked: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, key_marked, value_binder, value_marker, 0, work_used, work_limit)
            return nodes.count if both_marked >= nodes.count or work_used > work_limit
            key_replaced: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, both_marked, PROOF_KERNEL_REPLAY_QUANTIFIER_KEY_MARKER, key_value, 0, work_used, work_limit)
            return nodes.count if key_replaced >= nodes.count or work_used > work_limit
            proof_kernel_replay_substitute_with_work_limit(nodes, children, key_replaced, PROOF_KERNEL_REPLAY_QUANTIFIER_VALUE_MARKER, value_value, 0, work_used, work_limit)

        def proof_kernel_replay_replace_exact(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, from_root: usize, replacement_root: usize, depth: usize) -> (changed: bool, value: usize):
            work_used: mutable usize = 0
            exhausted: mutable bool = false
            proof_kernel_replay_replace_exact_with_work(nodes, children, root, from_root, replacement_root, &work_used, &exhausted, PROOF_KERNEL_REPLAY_REPLACE_EXACT_WORK_LIMIT, depth)

        def proof_kernel_replay_replace_exact_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, from_root: usize, replacement_root: usize, work_used: mutable usize&, exhausted: mutable bool&, work_limit: usize, depth: usize) -> (changed: bool, value: usize):
            return (true, nodes.count) if proof_kernel_replay_goal_bool_ref_value(exhausted)
            result: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, root, from_root, replacement_root, work_used, exhausted, work_limit, depth)
            return (true, ElisaProofKernelCore::add_node(nodes, "unsupported", "replacement-work", 0, 0, 0, 0, 0, "", "")) if proof_kernel_replay_goal_bool_ref_value(exhausted)
            return result

        def proof_kernel_replay_replace_exact_recursive_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, from_root: usize, replacement_root: usize, work_used: mutable usize&, exhausted: mutable bool&, work_limit: usize, depth: usize) -> (changed: bool, value: usize):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (false, root) if proof_kernel_replay_goal_bool_ref_value(exhausted)
            effective_limit: usize = work_limit if work_limit < PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT else PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT
            if work_used >= effective_limit:
                work_used <- effective_limit + 1 if work_used == effective_limit
                exhausted <- true
                return (false, root)
            work_used <- work_used + 1
            return (false, root) if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            equality_work: mutable usize = 0
            equality_remaining: usize = effective_limit - work_used
            equality_limit: usize = equality_remaining if equality_remaining < PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK else PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
            equal: bool = proof_kernel_replay_expr_equal_with_work(nodes, children, root, from_root, 0, equality_limit, &equality_work)
            work_used <- work_used + equality_work
            if not equal and equality_work >= equality_limit:
                work_used <- effective_limit + 1 if work_used == effective_limit
                exhausted <- true
                return (false, root)
            return (true, replacement_root) if equal
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, root) if:
                node.kind == "typed-int"
                node.kind in {"int", "bool", "float", "opaque-float-literal", "string", "char", "ident", "shorthand", "absent", "unsupported"}
            if node.kind in {"unary", "move", "field", "scope", "call_arg", "field-init", "checked-get"}:
                child: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, node.left, from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                return (false, root) if:
                    proof_kernel_replay_goal_bool_ref_value(exhausted)
                    not child.changed
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, child.value, node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            if node.kind in {"binary", "index", "dict_entry", "checked-index"}:
                left: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, node.left, from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                return (false, root) if proof_kernel_replay_goal_bool_ref_value(exhausted)
                right: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, node.right, from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                return (false, root) if:
                    proof_kernel_replay_goal_bool_ref_value(exhausted)
                    not left.changed and not right.changed
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, left.value if left.changed else node.left, right.value if right.changed else node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            if node.kind in {"slice", "if"}:
                left: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, node.left, from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                return (false, root) if proof_kernel_replay_goal_bool_ref_value(exhausted)
                right: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, node.right, from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                return (false, root) if proof_kernel_replay_goal_bool_ref_value(exhausted)
                auxiliary: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, node.auxiliary, from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                return (false, root) if:
                    proof_kernel_replay_goal_bool_ref_value(exhausted)
                    not left.changed and not right.changed and not auxiliary.changed
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, left.value if left.changed else node.left, right.value if right.changed else node.right, auxiliary.value if auxiliary.changed else node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            if node.kind == "quantifier":
                # The binder scopes the body. The source-neutral arena currently represents
                # names directly rather than with binding levels, so descending into the body
                # could capture a free name from the equality replacement (for example, rewrite
                # `y` to `x` under `forall x`). Rewriting the range is safe because the current
                # binder is not in scope there; leave the body opaque until the arena grows an
                # explicit capture-avoiding representation.
                range: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, node.left, from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                return (false, root) if:
                    proof_kernel_replay_goal_bool_ref_value(exhausted)
                    not range.changed
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, "quantifier", node.operator, range.value, node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            if node.kind in {"index-n", "array", "tuple", "set", "dict", "construct", "record-update", "call"}:
                return (false, root) if:
                    node.children_start > children.count or node.children_count > children.count - node.children_start
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                base_value: mutable usize = node.left
                base_changed: mutable bool = false
                if node.kind in {"index-n", "construct", "record-update", "call"}:
                    rewritten_base: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, node.left, from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                    return (false, root) if proof_kernel_replay_goal_bool_ref_value(exhausted)
                    base_value <- rewritten_base.value
                    base_changed <- rewritten_base.changed
                rewritten_children: mutable darray[usize] = []
                any_changed: mutable bool = base_changed
                for index in 0..<node.children_count |index, node, children, nodes, from_root, replacement_root, depth, rewritten_children, any_changed, work_used, exhausted, work_limit|:
                    return (false, root) if proof_kernel_replay_goal_bool_ref_value(exhausted)
                    child: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_recursive_with_work(nodes, children, children[node.children_start + index], from_root, replacement_root, work_used, exhausted, work_limit, depth + 1)
                    return (false, root) if proof_kernel_replay_goal_bool_ref_value(exhausted)
                    rewritten_children.push(child.value)
                    any_changed <- true if child.changed
                return (false, root) if not any_changed
                start: usize = children.count
                return (true, nodes.count) if not proof_kernel_replay_extend_children(children, rewritten_children, start)
                rewritten: usize = ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, base_value, node.right, node.auxiliary, start, node.children_count, node.value, node.name, node.secondary_name)
                return (true, rewritten)
            return (false, root)

        def proof_kernel_replay_quantifier_values_remaining(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], body: usize, binder: sview, values_start: usize, values_count: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                values_count == 0 and kind == "exists"
                values_count > PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_VALUES or values_start > children.count or values_count > children.count - values_start
                not proof_kernel_replay_child_range_valid(values_start, values_count, children.count)
            for index in 0..<values_count |index, children, nodes, facts, body, binder, kind, values_start, depth, remaining, work_used|:
                return false if:
                    remaining <= 1
                    not proof_kernel_replay_goal_search_charge(work_used)
                    work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                instance: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, body, binder, children[values_start + index], 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if instance >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proven: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, instance, 0, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return false if kind == "forall" and not proven
                return true if kind == "exists" and proven
            return kind == "forall"

        def proof_kernel_replay_quantifier_entries_remaining(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], body: usize, key_binder: sview, value_binder: sview, range: ElisaProofKernelCore::ProofKernelNode, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                range.children_count == 0 and kind == "exists"
                range.children_count > PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_ENTRIES or range.children_start > children.count or range.children_count > children.count - range.children_start
                not proof_kernel_replay_child_range_valid(range.children_start, range.children_count, children.count)
                key_binder == value_binder or not proof_kernel_replay_quantifier_marker_available_with_work(nodes, PROOF_KERNEL_REPLAY_QUANTIFIER_KEY_MARKER, work_used) or not proof_kernel_replay_quantifier_marker_available_with_work(nodes, PROOF_KERNEL_REPLAY_QUANTIFIER_VALUE_MARKER, work_used)
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
                nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET - 2
            key_marker: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, PROOF_KERNEL_REPLAY_QUANTIFIER_KEY_MARKER, "")
            value_marker: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, PROOF_KERNEL_REPLAY_QUANTIFIER_VALUE_MARKER, "")
            for index in 0..<range.children_count |index, range, children, nodes, facts, body, key_binder, value_binder, kind, depth, remaining, work_used|:
                return false if:
                    remaining <= 1
                    not proof_kernel_replay_goal_search_charge(work_used)
                entry_root: usize = children[range.children_start + index]
                return false if entry_root >= nodes.count or not proof_kernel_replay_valid(nodes, entry_root)
                entry: ElisaProofKernelCore::ProofKernelNode = nodes[entry_root]
                return false if:
                    entry.kind != "dict_entry"
                    work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                instance: usize = proof_kernel_replay_substitute_dictionary_pair_with_work_limit(nodes, children, body, key_binder, value_binder, entry.left, entry.right, key_marker, value_marker, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if instance >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proven: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, instance, 0, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return false if kind == "forall" and not proven
                return true if kind == "exists" and proven
            return kind == "forall"

        def proof_kernel_replay_quantifier_remaining(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], root: usize, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            work_used: mutable usize = 0
            return (proof_kernel_replay_quantifier_remaining_with_work(nodes, children, kind, facts, root, &work_used, depth, remaining) can Global{Read,Write})

        def proof_kernel_replay_quantifier_remaining_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], root: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                kind != "forall" and kind != "exists"
                not proof_kernel_replay_valid(nodes, root)
            quantifier: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if:
                quantifier.kind != "quantifier"
                quantifier.operator != kind
                not proof_kernel_replay_valid(nodes, quantifier.left) or not proof_kernel_replay_valid(nodes, quantifier.right)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, quantifier.left, work_used)
            range: ElisaProofKernelCore::ProofKernelNode = nodes[quantifier.left]
            # This evaluator is also reachable outside whole-arena admission. Enforce the
            # serialized binder/range shape here so array ranges can never be replayed as
            # two-binder dictionary quantifiers by a direct kernel caller.
            return false if not proof_kernel_replay_quantifier_range_arity_valid(nodes, quantifier)
            # Direct callers do not pass through whole-arena admission, so enforce the
            # dictionary overwrite invariant at this evaluator boundary as well.
            if kind == "exists" and quantifier.auxiliary == 2:
                return false if not proof_kernel_replay_existential_dictionary_keys_unique_with_work(nodes, children, range, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if range.kind == "binary" and (range.operator in {"range_lt", "range_le"}):
                # A constant bound is read without its width, so a wrapped payload could be an
                # unsigned maximum; only bounds whose value is width-independent may decide
                # whether the range is empty.
                lower_constant: ProofKernelReplayInt = proof_kernel_replay_quantifier_constant_int_with_work(nodes, range.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if lower_constant.known:
                    lower_safe_constant: ProofKernelReplayInt = proof_kernel_replay_quantifier_safe_comparison_constant_with_work(nodes, range.left, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    lower_small_signed: bool = proof_kernel_quantifier_small_signed_bound_with_work(nodes, range.left, work_used) if not lower_safe_constant.known else false
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (not lower_safe_constant.known and not lower_small_signed)
                upper_constant: ProofKernelReplayInt = proof_kernel_replay_quantifier_constant_int_with_work(nodes, range.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if upper_constant.known:
                    upper_safe_constant: ProofKernelReplayInt = proof_kernel_replay_quantifier_safe_comparison_constant_with_work(nodes, range.right, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    upper_small_signed: bool = proof_kernel_quantifier_small_signed_bound_with_work(nodes, range.right, work_used) if not upper_safe_constant.known else false
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (not upper_safe_constant.known and not upper_small_signed)
                bounds: mutable darray[ProofKernelReplayBound] = []
                if not lower_constant.known or not upper_constant.known:
                    for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                        proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, &bounds, work_used, 0)
                        return false if work_used >= PROOF_KERNEL_REPLAY_COLLECT_BOUNDS_WORK_LIMIT
                    return false if not proof_kernel_replay_close_equalities_with_work(nodes, children, facts, &bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                        return false if:
                            not proof_kernel_replay_unsigned_expression_safe_with_goal_work(nodes, children, fact, facts, &bounds, work_used, 0) or not proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, fact, facts, &bounds, work_used, 0)
                            work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                lower: ProofKernelReplayInt = proof_kernel_replay_quantifier_exact_int_from_bounds(nodes, range.left, lower_constant, bounds, work_used)
                upper: ProofKernelReplayInt = proof_kernel_replay_quantifier_exact_int_from_bounds(nodes, range.right, upper_constant, bounds, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if not lower.known or not upper.known:
                    return false if kind != "forall" or remaining <= 1
                    return (proof_kernel_replay_symbolic_quantifier_remaining_with_work(nodes, children, facts, root, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                return kind == "forall" if:
                    range.operator == "range_lt" and lower.value >= upper.value
                    range.operator == "range_le" and lower.value > upper.value
                width: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(upper.value, lower.value)
                return false if not width.known
                if range.operator == "range_le":
                    width_with_end: ProofKernelReplayInt = proof_kernel_replay_add_safe(width.value, 1)
                    return false if not width_with_end.known
                    width <- width_with_end
                return false if:
                    width.value <= 0 or width.value > PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_VALUES
                    remaining <= 1
                    nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET - 3
                candidate: mutable i64 = lower.value
                offset: mutable i64 = 0
                while offset < width.value |offset, candidate, facts, nodes, children, quantifier, kind, depth, remaining, work_used|:
                    return false if:
                        not proof_kernel_replay_goal_search_charge(work_used)
                        nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET - 3
                    candidate_root: mutable usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, candidate, "", "")
                    if candidate < 0:
                        magnitude: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, candidate)
                        if magnitude.known:
                            return false if not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge(work_used)
                            positive_root: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, magnitude.value, "", "")
                            candidate_root <- ElisaProofKernelCore::add_node(nodes, "unary", "-", positive_root, 0, 0, 0, 0, 0, "", "")
                    return false if work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    instance: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, quantifier.right, quantifier.name, candidate_root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if instance >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    proven: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, instance, 0, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                    return false if kind == "forall" and not proven
                    return true if kind == "exists" and proven
                    offset <- offset + 1
                    if offset < width.value:
                        next_candidate: ProofKernelReplayInt = proof_kernel_replay_add_safe(candidate, 1)
                        return false if not next_candidate.known
                        candidate <- next_candidate.value
                return kind == "forall"
            return false if remaining <= 1
            match range.kind:
                "array":
                    return (proof_kernel_replay_quantifier_values_remaining(nodes, children, kind, facts, quantifier.right, quantifier.name, range.children_start, range.children_count, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                "tuple":
                    return (proof_kernel_replay_quantifier_values_remaining(nodes, children, kind, facts, quantifier.right, quantifier.name, range.children_start, range.children_count, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                "set":
                    return (proof_kernel_replay_quantifier_values_remaining(nodes, children, facts, quantifier.right, quantifier.name, range.children_start, range.children_count, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                "dict":
                    return (proof_kernel_replay_quantifier_entries_remaining(nodes, children, kind, facts, quantifier.right, quantifier.name, quantifier.secondary_name, range, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write}) if quantifier.auxiliary == 2
                    return false
                _:
                    return false

        def proof_kernel_replay_quantifier(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], root: usize, depth: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if remaining == 0
            return (proof_kernel_replay_quantifier_remaining(nodes, children, kind, facts, root, depth, remaining) can Global{Read,Write})

        def proof_kernel_replay_arena_child_valid(validity: darray[bool]&, root: usize) -> bool:
            located: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, root)
            return located.known and located.value

        def proof_kernel_replay_arena_child_kind_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, validity: darray[bool]&, root: usize, wanted: sview) -> bool:
            return false if:
                root >= validity.count or root >= nodes.count
                not validity[root]
                nodes[root].kind != wanted
            return true

        # Quantifier elimination substitutes one name for collection and integer ranges,
        # and key/value names for dictionary ranges. Keep that representation invariant
        # explicit so every consumer can rely on it after arena admission.
        def proof_kernel_replay_quantifier_range_arity_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return true if node.kind != "quantifier"
            return false if node.left >= nodes.count
            range: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            return (node.auxiliary == 1 and range.kind != "dict") or (node.auxiliary == 2 and range.kind == "dict")

        # The serialized dictionary keeps every literal pair, while runtime dictionary
        # construction overwrites earlier values for an equal key. Existential replay over
        # the raw pairs is sound only when the keys are known and pairwise distinct. Accept
        # only keys the bounded constant evaluator can prove, and meter every range scan and
        # comparison against the same arena-validation budget.
        def proof_kernel_replay_existential_dictionary_keys_unique_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, range: ElisaProofKernelCore::ProofKernelNode, work_used: mutable usize&, work_limit: usize) -> bool:
            return false if:
                range.children_count > PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_ENTRIES
                not proof_kernel_replay_child_range_valid(range.children_start, range.children_count, children.count)
            return true if range.children_count < 2
            return false if work_used > work_limit
            pair_count: usize = range.children_count * (range.children_count - 1) / 2
            return false if pair_count > work_limit - work_used
            for left_index in 0..<range.children_count |left_index, range, children, nodes, work_used, work_limit|:
                left_scan_before: usize = work_used
                return false if not proof_kernel_replay_arena_shape_text_work_charge(1, &work_used, left_scan_before, work_limit)
                left_entry_root: usize = children[range.children_start + left_index]
                return false if left_entry_root >= nodes.count or nodes[left_entry_root].kind != "dict_entry"
                left_key: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, nodes[left_entry_root].left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, work_limit)
                return false if not left_key.known
                right_start: usize = left_index + 1
                for right_index in right_start..<range.children_count |right_index, left_index, right_start, range, children, nodes, left_key, work_used, work_limit|:
                    pair_scan_before: usize = work_used
                    return false if not proof_kernel_replay_arena_shape_text_work_charge(1, &work_used, pair_scan_before, work_limit)
                    right_entry_root: usize = children[range.children_start + right_index]
                    return false if right_entry_root >= nodes.count or nodes[right_entry_root].kind != "dict_entry"
                    right_key: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, nodes[right_entry_root].left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, work_limit)
                    return false if not right_key.known or left_key.value == right_key.value
            return true

        def proof_kernel_replay_arena_children_valid_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, node: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, validity: darray[bool]&, parent: usize, require_prior_children: bool, work_used: mutable usize&, work_limit: usize) -> bool:
            if node.kind in {"frame-place", "frame-policy"}:
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                if node.kind == "frame-policy":
                    return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, node.left, "frame-place")
                for index in 0..<node.children_count |index, node, children, nodes, validity, parent, require_prior_children, work_used, work_limit|:
                    child_work_before: usize = work_used
                    return false if not proof_kernel_replay_arena_shape_text_work_charge(1, &work_used, child_work_before, work_limit)
                    can Global{Read,Write}:
                        proof_kernel_replay_child_table_edges_scanned <- proof_kernel_replay_child_table_edges_scanned + 1
                    child_root: usize = children[node.children_start + index]
                    return false if require_prior_children and child_root >= parent
                    wanted: sview = "frame-field" if node.kind == "frame-place" else "frame-place"
                    return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child_root, wanted)
                return true
            # These two value-result events point left to a resource-event witness, not to an
            # AST child. Their event-specific replay validates that witness and its move/call
            # provenance; arena validity applies only to the canonical type term on the right.
            return proof_kernel_replay_arena_child_valid(validity, node.right) if:
                node.kind == "resource-region-return" and node.operator == "value-param"
                node.kind == "resource-call-result" and node.operator == "value"
            if node.kind in {"unary", "move", "field", "scope", "call_arg", "field-init", "effect-call", "checked-get", "resource-call-arg", "resource-region-alloc", "resource-region-alloc-discard", "resource-region-return-alloc", "resource-region-call-alloc", "resource-region-rebind-alloc", "resource-region-assign", "resource-sview-param"}:
                return proof_kernel_replay_arena_child_valid(validity, node.left)
            if node.kind in {"resource-region-return", "resource-call-result"}:
                return false if not proof_kernel_replay_arena_child_valid(validity, node.left)
                return proof_kernel_replay_arena_child_valid(validity, node.right) if (node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) != 0 or node.operator in {"value-param", "value"}
                return true
            if node.kind == "resource-region-bind":
                return false if not proof_kernel_replay_arena_child_valid(validity, node.left)
                return proof_kernel_replay_arena_child_valid(validity, node.right) if (node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) != 0
                return true
            if node.kind in {"binary", "index", "dict_entry", "checked-index"}:
                return false if not proof_kernel_replay_arena_child_valid(validity, node.left)
                return proof_kernel_replay_arena_child_valid(validity, node.right)
            if node.kind == "slice":
                return false if:
                    not proof_kernel_replay_arena_child_valid(validity, node.left)
                    not proof_kernel_replay_arena_child_valid(validity, node.right)
                return proof_kernel_replay_arena_child_valid(validity, node.auxiliary)
            if node.kind == "if":
                return false if:
                    not proof_kernel_replay_arena_child_valid(validity, node.left)
                    not proof_kernel_replay_arena_child_valid(validity, node.right)
                return proof_kernel_replay_arena_child_valid(validity, node.auxiliary)
            if node.kind == "quantifier":
                return false if not proof_kernel_replay_arena_child_valid(validity, node.left)
                return false if node.left >= nodes.count
                range: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                range_kind_work_before: usize = work_used
                return false if not proof_kernel_replay_arena_shape_text_work_charge(sview_len(range.kind), &work_used, range_kind_work_before, work_limit)
                return false if not proof_kernel_replay_quantifier_range_arity_valid(nodes, node)
                if node.operator == "exists" and node.auxiliary == 2:
                    return false if not proof_kernel_replay_existential_dictionary_keys_unique_with_work(nodes, children, range, work_used, work_limit)
                return proof_kernel_replay_arena_child_valid(validity, node.right)
            if node.kind == "effect-containment":
                declared_row: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if:
                    not declared_row.known or not declared_row.value
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, nodes, validity, parent, require_prior_children, work_used, work_limit|:
                    child_work_before: usize = work_used
                    return false if not proof_kernel_replay_arena_shape_text_work_charge(1, &work_used, child_work_before, work_limit)
                    can Global{Read,Write}:
                        proof_kernel_replay_child_table_edges_scanned <- proof_kernel_replay_child_table_edges_scanned + 1
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if:
                        not child.known
                        require_prior_children and child.value >= parent
                        not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "effect-call")
                return true
            if node.kind in {"index-n", "construct", "record-update", "call", "effect-row", "array", "tuple", "set", "dict", "resource-call", "resource-call-lend"}:
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                if node.kind in {"index-n", "construct", "record-update", "call", "resource-call"}:
                    collection_head: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                    return false if not collection_head.known or not collection_head.value
                for index in 0..<node.children_count |index, node, children, nodes, validity, parent, require_prior_children, work_used, work_limit|:
                    child_work_before: usize = work_used
                    return false if not proof_kernel_replay_arena_shape_text_work_charge(1, &work_used, child_work_before, work_limit)
                    can Global{Read,Write}:
                        proof_kernel_replay_child_table_edges_scanned <- proof_kernel_replay_child_table_edges_scanned + 1
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if:
                        not child.known
                        require_prior_children and child.value >= parent
                        not proof_kernel_replay_arena_child_valid(validity, child.value)
                    if node.kind in {"construct", "record-update"}:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "field-init")
                    if node.kind == "call":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "call_arg")
                    if node.kind == "effect-row":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "effect")
                    if node.kind == "effect-containment":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "effect-call")
                    if node.kind == "resource-call" and index < node.auxiliary:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-arg")
                    if node.kind == "resource-call" and index >= node.auxiliary:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-region")
                    if node.kind == "resource-call-lend" and index < node.auxiliary:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-arg")
                        shared_child: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, child.value)
                        return false if not shared_child.known or shared_child.node.operator == "region-new"
                    if node.kind == "resource-call-lend" and index >= node.auxiliary and index < node.auxiliary * 2:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-formal")
                    if node.kind == "resource-call-lend" and index >= node.auxiliary * 2:
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "resource-call-region")
                return true
            if node.kind in {"resource-scope", "resource-alternatives", "resource-safety", "structural-safety", "structural-edge"}:
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, nodes, validity, parent, require_prior_children, work_used, work_limit|:
                    child_work_before: usize = work_used
                    return false if not proof_kernel_replay_arena_shape_text_work_charge(1, &work_used, child_work_before, work_limit)
                    can Global{Read,Write}:
                        proof_kernel_replay_child_table_edges_scanned <- proof_kernel_replay_child_table_edges_scanned + 1
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if:
                        not child.known
                        require_prior_children and child.value >= parent
                        not proof_kernel_replay_arena_child_valid(validity, child.value)
                    if node.kind == "structural-safety":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "structural-edge")
                    if node.kind == "structural-edge":
                        return false if not proof_kernel_replay_arena_child_kind_valid(nodes, validity, child.value, "structural-argument")
                return true
            if node.kind == "resource-disjoint":
                left_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if not left_child.known or not left_child.value
                right_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.right)
                return false if not right_child.known or not right_child.value
                goal_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.auxiliary)
                return false if:
                    not goal_child.known or not goal_child.value
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, nodes, validity, parent, require_prior_children, work_used, work_limit|:
                    child_work_before: usize = work_used
                    return false if not proof_kernel_replay_arena_shape_text_work_charge(1, &work_used, child_work_before, work_limit)
                    can Global{Read,Write}:
                        proof_kernel_replay_child_table_edges_scanned <- proof_kernel_replay_child_table_edges_scanned + 1
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known or (require_prior_children and child.value >= parent)
                    child_validity: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, child.value)
                    return false if not child_validity.known or not child_validity.value
                return true
            if node.kind == "resource-bind":
                return true if node.operator in {"value", "external-shared", "external-mutable"}
                source: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return source.known and source.value
            if node.kind in {"resource-write", "resource-move"}:
                place: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return place.known and place.value
            if node.kind == "resource-use":
                place: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return place.known and place.value
            return true
