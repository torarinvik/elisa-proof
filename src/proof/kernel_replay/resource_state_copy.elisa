extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_resource_copy(source: mutable ProofKernelReplayResourceState&, target: mutable ProofKernelReplayResourceState&) -> bool:
            # Preflight the element-copy cost before growing any destination arrays. A nested
            # resource scope clones the full environment, so deep scope trees pay for their
            # binding and region tables against the same shared replay budget.
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_names.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.formal_names.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_scope_depth.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_reference.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_mutable_reference.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_writable.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_borrowable.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_moved.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_region.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_region_live.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_region_owner.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.active_regions.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.protected_regions.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.external_regions.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.region_wide_borrows.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.borrow_target_slots.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.borrow_target_places.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.borrow_mutable.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.borrow_present.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.disjoint_left.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.disjoint_right.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.resource_call_events.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.resource_call_allocations.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.resource_call_allocations_used.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.resource_call_results.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.resource_return_alloc_regions.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.resource_return_witnesses.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.resource_return_witnesses_used.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.pending_join_moves.count)
            return false if not proof_kernel_replay_resource_charge_work(source, source.binding_origin_places.count)
            target.binding_names.clear()
            target.binding_scope_depth.clear()
            target.binding_reference.clear()
            target.binding_mutable_reference.clear()
            target.binding_writable.clear()
            target.binding_borrowable.clear()
            target.binding_moved.clear()
            target.binding_region.clear()
            target.binding_region_live.clear()
            target.binding_region_owner.clear()
            target.active_regions.clear()
            target.protected_regions.clear()
            target.external_regions.clear()
            target.region_wide_borrows.clear()
            target.borrow_target_slots.clear()
            target.borrow_target_places.clear()
            target.borrow_mutable.clear()
            target.borrow_present.clear()
            target.disjoint_left.clear()
            target.disjoint_right.clear()
            target.resource_call_events.clear()
            target.resource_call_allocations.clear()
            target.resource_call_allocations_used.clear()
            target.resource_call_results.clear()
            target.resource_return_alloc_regions.clear()
            target.resource_return_witnesses.clear()
            target.resource_return_witnesses_used.clear()
            target.pending_join_moves.clear()
            target.binding_origin_places.clear()
            target.resource_work_used <- source.resource_work_used
            target.binding_names.extend(source.binding_names)
            target.formal_names.clear()
            target.formal_names.extend(source.formal_names)
            target.binding_scope_depth.extend(source.binding_scope_depth)
            target.scope_depth <- source.scope_depth
            target.binding_reference.extend(source.binding_reference)
            target.binding_mutable_reference.extend(source.binding_mutable_reference)
            target.binding_writable.extend(source.binding_writable)
            target.binding_borrowable.extend(source.binding_borrowable)
            target.binding_moved.extend(source.binding_moved)
            target.binding_region.extend(source.binding_region)
            target.binding_region_live.extend(source.binding_region_live)
            target.binding_region_owner.extend(source.binding_region_owner)
            target.active_regions.extend(source.active_regions)
            target.protected_regions.extend(source.protected_regions)
            target.external_regions.extend(source.external_regions)
            target.region_wide_borrows.extend(source.region_wide_borrows)
            target.borrow_target_slots.extend(source.borrow_target_slots)
            target.borrow_target_places.extend(source.borrow_target_places)
            target.borrow_mutable.extend(source.borrow_mutable)
            target.borrow_present.extend(source.borrow_present)
            target.disjoint_left.extend(source.disjoint_left)
            target.disjoint_right.extend(source.disjoint_right)
            target.resource_call_events.extend(source.resource_call_events)
            target.resource_call_allocations.extend(source.resource_call_allocations)
            target.resource_call_allocations_used.extend(source.resource_call_allocations_used)
            target.resource_call_results.extend(source.resource_call_results)
            target.resource_return_alloc_regions.extend(source.resource_return_alloc_regions)
            target.resource_return_witnesses.extend(source.resource_return_witnesses)
            target.resource_return_witnesses_used.extend(source.resource_return_witnesses_used)
            target.pending_join_moves.extend(source.pending_join_moves)
            target.binding_origin_places.extend(source.binding_origin_places)
            return true
