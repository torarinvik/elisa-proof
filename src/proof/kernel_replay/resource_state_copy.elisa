extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_resource_copy(source: mutable ProofKernelReplayResourceState&, target: mutable ProofKernelReplayResourceState&) -> bool:
            # Preflight traversal and destination-growth costs before mutating target arrays.
            # Deep scope trees therefore pay for both the read and copy of every stored element.
            return false if:
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_names.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_event_roots.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.formal_names.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_scope_depth.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_reference.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_mutable_reference.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_writable.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_borrowable.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_moved.count)
                not proof_kernel_replay_resource_charge_work(source, source.provenance.binding_region.count)
                not proof_kernel_replay_resource_charge_work(source, source.provenance.binding_region_live.count)
                not proof_kernel_replay_resource_charge_work(source, source.provenance.binding_region_owner.count)
                not proof_kernel_replay_resource_charge_work(source, source.regions.active_regions.count)
                not proof_kernel_replay_resource_charge_work(source, source.regions.protected_regions.count)
                not proof_kernel_replay_resource_charge_work(source, source.regions.external_regions.count)
                not proof_kernel_replay_resource_charge_work(source, source.regions.region_wide_borrows.count)
                not proof_kernel_replay_resource_charge_work(source, source.borrows.borrow_target_slots.count)
                not proof_kernel_replay_resource_charge_work(source, source.borrows.borrow_target_places.count)
                not proof_kernel_replay_resource_charge_work(source, source.borrows.borrow_mutable.count)
                not proof_kernel_replay_resource_charge_work(source, source.borrows.borrow_present.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.disjoint_left.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.disjoint_right.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_events.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_events_seen.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_allocations.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_allocations_used.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_results.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_return_witnesses.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_return_witnesses_used.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.pending_join_moves.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_origin_places.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_names.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.formal_names.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_scope_depth.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_reference.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_mutable_reference.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_writable.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_borrowable.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_moved.count)
                not proof_kernel_replay_resource_charge_work(source, source.provenance.binding_region.count)
                not proof_kernel_replay_resource_charge_work(source, source.provenance.binding_region_live.count)
                not proof_kernel_replay_resource_charge_work(source, source.provenance.binding_region_owner.count)
                not proof_kernel_replay_resource_charge_work(source, source.regions.active_regions.count)
                not proof_kernel_replay_resource_charge_work(source, source.regions.protected_regions.count)
                not proof_kernel_replay_resource_charge_work(source, source.regions.external_regions.count)
                not proof_kernel_replay_resource_charge_work(source, source.regions.region_wide_borrows.count)
                not proof_kernel_replay_resource_charge_work(source, source.borrows.borrow_target_slots.count)
                not proof_kernel_replay_resource_charge_work(source, source.borrows.borrow_target_places.count)
                not proof_kernel_replay_resource_charge_work(source, source.borrows.borrow_mutable.count)
                not proof_kernel_replay_resource_charge_work(source, source.borrows.borrow_present.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.disjoint_left.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.disjoint_right.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_events.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_events_seen.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_allocations.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_allocations_used.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_call_results.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_return_witnesses.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.resource_return_witnesses_used.count)
                not proof_kernel_replay_resource_charge_work(source, source.scope.pending_join_moves.count)
                not proof_kernel_replay_resource_charge_work(source, source.bindings.binding_origin_places.count)
            target.bindings.binding_names.clear()
            target.bindings.binding_event_roots.clear()
            target.bindings.binding_scope_depth.clear()
            target.bindings.binding_reference.clear()
            target.bindings.binding_mutable_reference.clear()
            target.bindings.binding_writable.clear()
            target.bindings.binding_borrowable.clear()
            target.bindings.binding_moved.clear()
            target.provenance.binding_region.clear()
            target.provenance.binding_region_live.clear()
            target.provenance.binding_region_owner.clear()
            target.regions.active_regions.clear()
            target.regions.protected_regions.clear()
            target.regions.external_regions.clear()
            target.regions.region_wide_borrows.clear()
            target.borrows.borrow_target_slots.clear()
            target.borrows.borrow_target_places.clear()
            target.borrows.borrow_mutable.clear()
            target.borrows.borrow_present.clear()
            target.scope.disjoint_left.clear()
            target.scope.disjoint_right.clear()
            target.scope.resource_call_events.clear()
            target.scope.resource_call_events_seen.clear()
            target.scope.resource_call_allocations.clear()
            target.scope.resource_call_allocations_used.clear()
            target.scope.resource_call_results.clear()
            target.scope.resource_return_witnesses.clear()
            target.scope.resource_return_witnesses_used.clear()
            target.scope.pending_join_moves.clear()
            target.bindings.binding_origin_places.clear()
            target.scope.resource_work_used <- source.scope.resource_work_used
            target.scope.goal_work_used <- source.scope.goal_work_used
            target.scope.resource_call_events_are_sorted <- source.scope.resource_call_events_are_sorted
            target.scope.resource_call_events_seen_are_sorted <- source.scope.resource_call_events_seen_are_sorted
            target.scope.resource_call_allocations_are_sorted <- source.scope.resource_call_allocations_are_sorted
            target.scope.resource_call_allocations_used_are_sorted <- source.scope.resource_call_allocations_used_are_sorted
            target.scope.resource_call_results_are_sorted <- source.scope.resource_call_results_are_sorted
            target.scope.resource_return_witnesses_are_sorted <- source.scope.resource_return_witnesses_are_sorted
            target.scope.resource_return_witnesses_used_are_sorted <- source.scope.resource_return_witnesses_used_are_sorted
            for binding_name in source.bindings.binding_names |binding_name, target|:
                target.bindings.binding_names.push(binding_name)
            for binding_event_root in source.bindings.binding_event_roots |binding_event_root, target|:
                target.bindings.binding_event_roots.push(binding_event_root)
            target.scope.formal_names.clear()
            for formal_name in source.scope.formal_names |formal_name, target|:
                target.scope.formal_names.push(formal_name)
            for scope_depth in source.bindings.binding_scope_depth |scope_depth, target|:
                target.bindings.binding_scope_depth.push(scope_depth)
            target.scope.scope_depth <- source.scope.scope_depth
            for reference in source.bindings.binding_reference |reference, target|:
                target.bindings.binding_reference.push(reference)
            for mutable_reference in source.bindings.binding_mutable_reference |mutable_reference, target|:
                target.bindings.binding_mutable_reference.push(mutable_reference)
            for writable in source.bindings.binding_writable |writable, target|:
                target.bindings.binding_writable.push(writable)
            for borrowable in source.bindings.binding_borrowable |borrowable, target|:
                target.bindings.binding_borrowable.push(borrowable)
            for moved in source.bindings.binding_moved |moved, target|:
                target.bindings.binding_moved.push(moved)
            for region in source.provenance.binding_region |region, target|:
                target.provenance.binding_region.push(region)
            for region_live in source.provenance.binding_region_live |region_live, target|:
                target.provenance.binding_region_live.push(region_live)
            for region_owner in source.provenance.binding_region_owner |region_owner, target|:
                target.provenance.binding_region_owner.push(region_owner)
            for active_region in source.regions.active_regions |active_region, target|:
                target.regions.active_regions.push(active_region)
            for protected_region in source.regions.protected_regions |protected_region, target|:
                target.regions.protected_regions.push(protected_region)
            for external_region in source.regions.external_regions |external_region, target|:
                target.regions.external_regions.push(external_region)
            for wide_borrow_region in source.regions.region_wide_borrows |wide_borrow_region, target|:
                target.regions.region_wide_borrows.push(wide_borrow_region)
            for borrow_target_slot in source.borrows.borrow_target_slots |borrow_target_slot, target|:
                target.borrows.borrow_target_slots.push(borrow_target_slot)
            for borrow_target_place in source.borrows.borrow_target_places |borrow_target_place, target|:
                target.borrows.borrow_target_places.push(borrow_target_place)
            for mutable_borrow in source.borrows.borrow_mutable |mutable_borrow, target|:
                target.borrows.borrow_mutable.push(mutable_borrow)
            for borrow_present in source.borrows.borrow_present |borrow_present, target|:
                target.borrows.borrow_present.push(borrow_present)
            for left_disjoint in source.scope.disjoint_left |left_disjoint, target|:
                target.scope.disjoint_left.push(left_disjoint)
            for right_disjoint in source.scope.disjoint_right |right_disjoint, target|:
                target.scope.disjoint_right.push(right_disjoint)
            for call_event in source.scope.resource_call_events |call_event, target|:
                target.scope.resource_call_events.push(call_event)
            for seen_call_event in source.scope.resource_call_events_seen |seen_call_event, target|:
                target.scope.resource_call_events_seen.push(seen_call_event)
            for call_allocation in source.scope.resource_call_allocations |call_allocation, target|:
                target.scope.resource_call_allocations.push(call_allocation)
            for call_allocation_used in source.scope.resource_call_allocations_used |call_allocation_used, target|:
                target.scope.resource_call_allocations_used.push(call_allocation_used)
            for call_result in source.scope.resource_call_results |call_result, target|:
                target.scope.resource_call_results.push(call_result)
            for return_witness in source.scope.resource_return_witnesses |return_witness, target|:
                target.scope.resource_return_witnesses.push(return_witness)
            for return_witness_used in source.scope.resource_return_witnesses_used |return_witness_used, target|:
                target.scope.resource_return_witnesses_used.push(return_witness_used)
            for pending_join_move in source.scope.pending_join_moves |pending_join_move, target|:
                target.scope.pending_join_moves.push(pending_join_move)
            for binding_origin_place in source.bindings.binding_origin_places |binding_origin_place, target|:
                target.bindings.binding_origin_places.push(binding_origin_place)
            return true
