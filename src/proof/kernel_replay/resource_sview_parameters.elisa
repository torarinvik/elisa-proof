# Replay for by-value sview formals whose lifetime is a region parameter.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_resource_sview_parameter(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: mutable ProofKernelReplayResourceState&, node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return false if state.scope_depth != 0
            return false if node.auxiliary != PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG or node.left >= nodes.count
            type_node: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            return false if type_node.kind != "ident" or type_node.operator != "" or type_node.name != "sview" or type_node.left != 0 or type_node.right != 0 or type_node.auxiliary != 0 or type_node.children_start != 0 or type_node.children_count != 0 or type_node.value != 0 or type_node.secondary_name != ""
            return false if not proof_kernel_replay_resource_region_external(state, node.secondary_name) or not proof_kernel_replay_resource_region_active(state, node.secondary_name)
            slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
            return false if slot >= state.binding_names.count or slot >= state.binding_reference.count or state.binding_reference[slot]
            return false if slot >= state.binding_region.count or state.binding_region[slot] != ""
            return false if slot >= state.binding_region_live.count
            return false if slot >= state.binding_moved.count or state.binding_moved[slot]
            state.binding_region[slot] <- node.secondary_name
            state.binding_region_live[slot] <- true
            state.region_wide_borrows.push(node.secondary_name) if not any prior in state.region_wide_borrows where prior == node.secondary_name
            return true
