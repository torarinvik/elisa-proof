const PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS: usize = 4096
const PROOF_KERNEL_REPLAY_DIFFERENCE_COLLECT_WORK_LIMIT: usize = 65536
const PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK: usize = 4000000
const PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_PENDING: usize = 65536

extend ElisaProofKernelReplay:
    private:
        struct ProofKernelReplayExprPair:
            left: usize
            right: usize
            depth: usize
            call_argument: bool

        # The producer's peer rule, one step further: `base <= middle < peer` with a nameable
        # middle that is not the base itself (a partition's `lo <= k < xs.count`).
        def proof_kernel_replay_unsigned_increment_has_strict_peer(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, base: usize, width: i64, facts: darray[usize]) -> bool:
            return false if width == 0
            return true if proof_kernel_replay_unsigned_increment_has_direct_peer(nodes, children, base, width, facts)
            for fact in facts |fact, nodes, children, base, width, facts|:
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
                continue if not located.known or located.node.kind != "binary"
                node: ElisaProofKernelCore::ProofKernelNode = located.node
                if node.operator == "<=" and proof_kernel_replay_expr_equal(nodes, children, node.left, base, 0) and proof_kernel_replay_peer_is_nameable(nodes, node.right) and not proof_kernel_replay_expr_equal(nodes, children, node.right, base, 0):
                    return true if proof_kernel_replay_unsigned_increment_has_direct_peer(nodes, children, node.right, width, facts)
                if node.operator == ">=" and proof_kernel_replay_expr_equal(nodes, children, node.right, base, 0) and proof_kernel_replay_peer_is_nameable(nodes, node.left) and not proof_kernel_replay_expr_equal(nodes, children, node.left, base, 0):
                    return true if proof_kernel_replay_unsigned_increment_has_direct_peer(nodes, children, node.left, width, facts)
            return false

        def proof_kernel_replay_interval_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize]) -> bool:
            return false if:
                operator != "==" and operator != "!=" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
                not proof_kernel_replay_primitive_comparison(nodes, children, facts, left_root, right_root)
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            proof_kernel_replay_close_bounds_from_facts(nodes, children, facts, &bounds)
            proof_kernel_replay_close_defining_equalities(nodes, children, facts, &bounds)
            a: mutable (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, left_root, bounds, 0)
            b: mutable (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, children, right_root, bounds, 0)
            # A closed side that is not safe without width metadata, such as `-1`, takes its value
            # at the width of the other side when every leaf there is a witnessed signed scalar:
            # the comparison is then performed at that width, so the literal denotes that value.
            left_typed: ProofKernelReplayInt = proof_kernel_replay_typed_comparison_constant(nodes, children, facts, left_root, right_root)
            right_typed: ProofKernelReplayInt = proof_kernel_replay_typed_comparison_constant(nodes, children, facts, right_root, left_root)
            a <- (true, left_typed.value, left_typed.value, true, true) if left_typed.known
            b <- (true, right_typed.value, right_typed.value, true, true) if right_typed.known
            return a.has_lower and b.has_upper and a.lower > b.upper if operator == ">"
            return a.has_lower and b.has_upper and a.lower >= b.upper if operator == ">="
            return a.has_upper and b.has_lower and a.upper < b.lower if operator == "<"
            return a.has_upper and b.has_lower and a.upper <= b.lower if operator == "<="
            return a.known and b.known and a.lower == a.upper and b.lower == b.upper and a.lower == b.lower if operator == "=="
            return (a.has_upper and b.has_lower and a.upper < b.lower) or (a.has_lower and b.has_upper and a.lower > b.upper) if operator == "!="
            return false

        def proof_kernel_replay_difference_push(left: ProofKernelReplayAffine, right: ProofKernelReplayAffine, reverse: bool, strict: bool, constraints: mutable darray[ProofKernelReplayDifference]&) -> void:
            return if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
            first: ProofKernelReplayAffine = left if not reverse else right
            second: ProofKernelReplayAffine = right if not reverse else left
            difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(second.offset, first.offset)
            return if not difference.known
            bound: mutable i64 = difference.value
            if strict:
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(bound, 1)
                return if not decremented.known
                bound <- decremented.value
            # Encode `sign * base + offset` as a difference constraint only when the resulting
            # relation is representable by the graph. A negative affine term reverses the graph
            # edge; dropping that sign would turn `0 - x <= 0` into the false bound `x <= 0`.
            if first.base == "" and second.base == "":
                constraints.push(ProofKernelReplayDifference{left: "", right: "", bound: bound})
                return
            if first.base == "":
                constraints.push(ProofKernelReplayDifference{left: second.base, right: "", bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and second.negative
                constraints.push(ProofKernelReplayDifference{left: "", right: second.base, bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and not second.negative
                return
            if second.base == "":
                constraints.push(ProofKernelReplayDifference{left: "", right: first.base, bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and first.negative
                constraints.push(ProofKernelReplayDifference{left: first.base, right: "", bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and not first.negative
                return
            return if first.negative != second.negative
            constraints.push(ProofKernelReplayDifference{left: second.base, right: first.base, bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and first.negative
            constraints.push(ProofKernelReplayDifference{left: first.base, right: second.base, bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and not first.negative

        # Mirror of the producer's fact-side increment guard. The peer argument is asked of the
        # facts rather than of the constraint graph, because a fact is being imported into that
        # graph and there is not one yet. The base is taken from the operand's own node, so the
        # comparison against a peer fact is the same structural one the goal side performs.
        def proof_kernel_replay_affine_peer_safe_from_facts(affine: ProofKernelReplayAffine, root: usize, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]) -> bool:
            return false if not affine.known or affine.negative or affine.offset != 1 or affine.base == ""
            width: i64 = proof_kernel_replay_unsigned_marker_width_for_name(nodes, children, facts, affine.base)
            return false if:
                width == 0
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or node.operator != "+"
            unit: (known: bool, base: usize) = proof_kernel_replay_unsigned_unit_increment_base(nodes, node.left, node.right)
            return false if not unit.known
            return proof_kernel_replay_unsigned_increment_has_strict_peer(nodes, children, unit.base, width, facts)

        def proof_kernel_replay_collect_differences(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, bounds: darray[ProofKernelReplayBound]&, children: darray[usize]&, facts: darray[usize], constraints: mutable darray[ProofKernelReplayDifference]&, work_used: mutable usize&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if work_used >= PROOF_KERNEL_REPLAY_DIFFERENCE_COLLECT_WORK_LIMIT or constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
            work_used <- work_used + 1
            return if not ElisaProofKernelCore::depth_valid(depth)
            return if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return if root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary" and node.operator == "not":
                return if node.left >= nodes.count
                inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                if inner.kind == "binary" and proof_kernel_replay_negation_supported(inner.operator):
                    if proof_kernel_replay_primitive_comparison(nodes, children, facts, inner.left, inner.right):
                        # Difference constraints use discrete integer strictness (`<` becomes
                        # `<= bound - 1`). Float comparisons cannot enter this graph.
                        return if not proof_kernel_replay_denial_integer_term(nodes, children, inner.left, facts, 0) or not proof_kernel_replay_denial_integer_term(nodes, children, inner.right, facts, 0)
                        # A negated comparison is represented by its complemented operator.
                        left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, inner.left, depth + 1)
                        right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, inner.right, depth + 1)
                        left_admissible: bool = proof_kernel_replay_affine_safe(left, bounds) or proof_kernel_replay_affine_peer_safe_from_facts(left, inner.left, nodes, children, facts)
                        right_admissible: bool = proof_kernel_replay_affine_safe(right, bounds) or proof_kernel_replay_affine_peer_safe_from_facts(right, inner.right, nodes, children, facts)
                        if left.known and right.known and left_admissible and right_admissible:
                            # `not (a > b)` is `a <= b` and `not (a < b)` is `a >= b`, so a fact
                            # `a != b` over the same two terms makes either one strict, exactly as
                            # the producer's recursion through the complemented comparison does.
                            negated_distinct: bool = (inner.operator in {">", "<"}) and proof_kernel_replay_facts_state_disequality(nodes, children, facts, inner.left, inner.right)
                            proof_kernel_replay_difference_push(left, right, false, negated_distinct, constraints) if inner.operator == ">"
                            proof_kernel_replay_difference_push(left, right, false, true, constraints) if inner.operator == ">="
                            proof_kernel_replay_difference_push(left, right, true, negated_distinct, constraints) if inner.operator == "<"
                            proof_kernel_replay_difference_push(left, right, true, true, constraints) if inner.operator == "<="
                            if inner.operator == "!=":
                                proof_kernel_replay_difference_push(left, right, false, false, constraints)
                                proof_kernel_replay_difference_push(left, right, true, false, constraints)
                return
            if node.kind == "binary" and node.operator == "and":
                proof_kernel_replay_collect_differences(nodes, node.left, bounds, children, facts, constraints, work_used, depth + 1)
                proof_kernel_replay_collect_differences(nodes, node.right, bounds, children, facts, constraints, work_used, depth + 1)
                return
            return if node.kind != "binary" or node.operator != "==" and node.operator != "<" and node.operator != "<=" and node.operator != ">" and node.operator != ">="
            return if not proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right)
            return if not proof_kernel_replay_denial_integer_term(nodes, children, node.left, facts, 0) or not proof_kernel_replay_denial_integer_term(nodes, children, node.right, facts, 0)
            return if proof_kernel_replay_guarded_difference_import(nodes, children, node.left, node.operator, node.right, facts, constraints)
            left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.left, depth + 1)
            right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.right, depth + 1)
            return if not left.known or not right.known
            return if not (proof_kernel_replay_affine_safe(left, bounds) or proof_kernel_replay_affine_peer_safe_from_facts(left, node.left, nodes, children, facts))
            return if not (proof_kernel_replay_affine_safe(right, bounds) or proof_kernel_replay_affine_peer_safe_from_facts(right, node.right, nodes, children, facts))
            # `a <= b` beside a fact `a != b` over the same two terms is `a < b`.
            distinct: bool = (node.operator in {"<=", ">="}) and proof_kernel_replay_facts_state_disequality(nodes, children, facts, node.left, node.right)
            proof_kernel_replay_difference_push(left, right, false, distinct, constraints) if node.operator == "<="
            proof_kernel_replay_difference_push(left, right, false, true, constraints) if node.operator == "<"
            proof_kernel_replay_difference_push(left, right, true, distinct, constraints) if node.operator == ">="
            proof_kernel_replay_difference_push(left, right, true, true, constraints) if node.operator == ">"
            if node.operator == "==":
                proof_kernel_replay_difference_push(left, right, false, false, constraints)
                proof_kernel_replay_difference_push(left, right, true, false, constraints)

        def proof_kernel_replay_difference_node_index(nodes: darray[sview]&, name: sview) -> usize:
            for index in 0..<nodes.count:
                if nodes[index] == name:
                    return index
            return nodes.count

        def proof_kernel_replay_difference_query(nodes: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, left: sview, right: sview, bound: i64) -> bool:
            left_index: usize = proof_kernel_replay_difference_node_index(nodes, left)
            right_index: usize = proof_kernel_replay_difference_node_index(nodes, right)
            return false if left_index >= nodes.count or right_index >= nodes.count
            return proof_kernel_replay_difference_entry(matrix, known, left_index * nodes.count + right_index, bound)

        # One matrix cell: known, and at most `bound`. Kept apart from the index lookups so each
        # body stays small enough for the checker's state budget when the replay kernel audits
        # itself.
        def proof_kernel_replay_difference_entry(matrix: darray[i64]&, known: darray[bool]&, slot: usize, bound: i64) -> bool:
            known_entry: (known: bool, value: bool) = proof_kernel_replay_bool_at(known, slot)
            return false if not known_entry.known or not known_entry.value
            matrix_entry: (known: bool, value: i64) = proof_kernel_replay_model_value_at(matrix, slot)
            return matrix_entry.known and matrix_entry.value <= bound

        # Query the graph representation of `first OP second` after offsets have been moved
        # into `bound`. Preserve the affine sign when choosing the edge orientation; mixed signs
        # with two symbolic bases are outside the difference-logic fragment and must fail closed.
        def proof_kernel_replay_difference_affine_query(nodes: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, first: ProofKernelReplayAffine, second: ProofKernelReplayAffine, bound: i64) -> bool:
            return proof_kernel_replay_difference_query(nodes, matrix, known, "", "", bound) if first.base == "" and second.base == ""
            if first.base == "":
                return proof_kernel_replay_difference_query(nodes, matrix, known, second.base, "", bound) if second.negative
                return proof_kernel_replay_difference_query(nodes, matrix, known, "", second.base, bound)
            if second.base == "":
                return proof_kernel_replay_difference_query(nodes, matrix, known, "", first.base, bound) if first.negative
                return proof_kernel_replay_difference_query(nodes, matrix, known, first.base, "", bound)
            return false if first.negative != second.negative
            return proof_kernel_replay_difference_query(nodes, matrix, known, second.base, first.base, bound) if first.negative
            return proof_kernel_replay_difference_query(nodes, matrix, known, first.base, second.base, bound)

        def proof_kernel_replay_difference_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize]) -> bool:
            return false if not proof_kernel_replay_denial_integer_term(nodes, children, left_root, facts, 0) or not proof_kernel_replay_denial_integer_term(nodes, children, right_root, facts, 0)
            return proof_kernel_replay_difference_affine_comparison(nodes, children, proof_kernel_replay_affine_expression(nodes, left_root, 0), operator, proof_kernel_replay_affine_expression(nodes, right_root, 0), facts, false)

        # Mirror of the producer's split: `certified` says the caller has already shown that the
        # source terms these forms were read from do not wrap, so their range is not asked again.
        def proof_kernel_replay_difference_affine_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: ProofKernelReplayAffine, operator: sview, right: ProofKernelReplayAffine, facts: darray[usize], certified: bool) -> bool:
            return false if:
                operator != "==" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
                not left.known or not right.known
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            # With no symbolic base the graph contains only its zero node, so its reflexive
            # edge must never certify a comparison of erased integer constants. Safe direct
            # nonnegative literals were already handled by the literal rule; all other ground
            # constants may carry unsigned bit patterns or fixed-width overflow. A certified
            # caller has already decided every operator under its width guard and folded the
            # literals over the integers, so its ground forms are exact values.
            return false if not certified and left.base == "" and right.base == ""
            constraints: mutable darray[ProofKernelReplayDifference] = []
            collection_work: mutable usize = 0
            for fact in facts |fact, nodes, bounds, constraints, collection_work|:
                break if collection_work >= PROOF_KERNEL_REPLAY_DIFFERENCE_COLLECT_WORK_LIMIT or constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
                proof_kernel_replay_collect_differences(nodes, fact, bounds, children, facts, &constraints, &collection_work, 0)
            return false if constraints.count > PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
            # Collected before the overflow guard runs, because they are what gives a name an
            # interval when no fact states one about it directly.
            proof_kernel_replay_close_bounds_through_differences(constraints, &bounds)
            left_safe: bool = certified or proof_kernel_replay_affine_safe(left, bounds) or proof_kernel_replay_affine_unsigned_peer_safe(left, constraints, nodes, children, facts)
            right_safe: bool = certified or proof_kernel_replay_affine_safe(right, bounds) or proof_kernel_replay_affine_unsigned_peer_safe(right, constraints, nodes, children, facts)
            return false if not left_safe or not right_safe
            proof_kernel_replay_push_base_bounds(bounds, left.base, &constraints)
            proof_kernel_replay_push_base_bounds(bounds, right.base, &constraints)
            names: mutable darray[sview] = [""]
            for constraint in constraints |constraint, names|:
                names.push(constraint.left) if constraint.left != "" and proof_kernel_replay_difference_node_index(names, constraint.left) == names.count
                names.push(constraint.right) if constraint.right != "" and proof_kernel_replay_difference_node_index(names, constraint.right) == names.count
            return false if names.count > ElisaProofKernelCore::PROOF_DIFFERENCE_NODE_LIMIT
            matrix: mutable darray[i64] = []
            known: mutable darray[bool] = []
            matrix.resize(names.count * names.count)
            known.resize(names.count * names.count)
            for index in 0..<matrix.count |index, matrix, known|:
                matrix[index] <- 0
                known[index] <- false
            for index in 0..<names.count |index, names, matrix, known|:
                slot: usize = index * names.count + index
                matrix[slot] <- 0
                known[slot] <- true
            for constraint in constraints |constraint, names, matrix, known|:
                left_index: usize = proof_kernel_replay_difference_node_index(names, constraint.left)
                right_index: usize = proof_kernel_replay_difference_node_index(names, constraint.right)
                slot: usize = left_index * names.count + right_index
                matrix[slot] <- constraint.bound if not known[slot] or constraint.bound < matrix[slot]
                known[slot] <- true
            for pivot in 0..<names.count |pivot, names, matrix, known|:
                for source in 0..<names.count |source, pivot, names, matrix, known|:
                    first_slot: usize = source * names.count + pivot
                    continue if not known[first_slot]
                    for target in 0..<names.count |target, source, pivot, names, matrix, known|:
                        second_slot: usize = pivot * names.count + target
                        continue if not known[second_slot]
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(matrix[first_slot], matrix[second_slot])
                        continue if not combined.known
                        result_slot: usize = source * names.count + target
                        matrix[result_slot] <- combined.value if not known[result_slot] or combined.value < matrix[result_slot]
                        known[result_slot] <- true
            if operator == "==":
                forward: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right.offset, left.offset)
                reverse: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left.offset, right.offset)
                return false if not forward.known or not reverse.known
                return proof_kernel_replay_difference_affine_query(names, matrix, known, left, right, forward.value) and proof_kernel_replay_difference_affine_query(names, matrix, known, right, left, reverse.value)
            if operator in {"<=", "<"}:
                target: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(right.offset, left.offset)
                return false if not target.known
                if operator == "<":
                    decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(target.value, 1)
                    return false if not decremented.known
                    target <- decremented
                return proof_kernel_replay_difference_affine_query(names, matrix, known, left, right, target.value)
            target: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(left.offset, right.offset)
            return false if not target.known
            if operator == ">":
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(target.value, 1)
                return false if not decremented.known
                target <- decremented
            return proof_kernel_replay_difference_affine_query(names, matrix, known, right, left, target.value)

        def proof_kernel_replay_negation(operator: sview) -> sview:
            return "!=" if operator == "=="
            return "==" if operator == "!="
            return ">=" if operator == "<"
            return "<" if operator == ">="
            return ">" if operator == "<="
            return "<=" if operator == ">"
            return ""

        def proof_kernel_replay_negation_supported(operator: sview) -> bool:
            return operator in {"==", "!=", "<", "<=", ">", ">="}

        # The order whose truth refutes `a operator b` once its operands are swapped:
        # `b <= a` refutes `a < b`. Empty for any operator without one.
        def proof_kernel_replay_order_converse(operator: sview) -> sview:
            return "<=" if operator == "<"
            return "<" if operator == "<="
            return ">=" if operator == ">"
            return ">" if operator == ">="
            ""

        def proof_kernel_replay_expr_pair_enqueue(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left: usize, right: usize, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_expr_equality_work_charge(1, work_limit, work_used)
                scheduled >= PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
                pending.count >= PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_PENDING
            pending.push(ProofKernelReplayExprPair{left: left, right: right, depth: depth, call_argument: false})
            scheduled <- scheduled + 1
            return true

        def proof_kernel_replay_expr_call_argument_enqueue(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left: usize, right: usize, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_expr_equality_work_charge(1, work_limit, work_used)
                scheduled >= PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
                pending.count >= PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_PENDING
            pending.push(ProofKernelReplayExprPair{left: left, right: right, depth: depth, call_argument: true})
            scheduled <- scheduled + 1
            return true

        def proof_kernel_replay_expr_child_enqueue(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left: usize, right: usize, depth: usize, call_argument: bool) -> bool:
            return proof_kernel_replay_expr_call_argument_enqueue(pending, scheduled, work_limit, work_used, left, right, depth) if call_argument
            return proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left, right, depth)

        def proof_kernel_replay_expr_child_span_enqueue(children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left_start: usize, right_start: usize, count: usize, depth: usize, call_arguments: bool) -> bool:
            return false if count > children.count or left_start > children.count - count or right_start > children.count - count
            for index in 0..<count |index, children, pending, scheduled, work_limit, work_used, left_start, right_start, depth, call_arguments|:
                left_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, left_start + index)
                right_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, right_start + index)
                return false if not left_child.known or not right_child.known or not proof_kernel_replay_expr_child_enqueue(pending, scheduled, work_limit, work_used, left_child.value, right_child.value, depth, call_arguments)
            return true

        def proof_kernel_replay_expr_leaf_equal(kind: sview, left_value: i64, right_value: i64, left_name: sview, right_name: sview) -> (handled: bool, equal: bool):
            match kind:
                "absent":
                    return (true, true)
                "int" | "bool":
                    return (true, left_value == right_value)
                "typed-int":
                    return (true, left_value == right_value and left_name == right_name)
                "float" | "opaque-float-literal" | "string" | "char" | "ident" | "shorthand":
                    return (true, left_name == right_name)
                _:
                    return (false, false)

        def proof_kernel_replay_expr_pair_nodes_valid(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, same_root: bool, call_argument: bool, depth: usize) -> bool:
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                call_argument and left.kind != "call_arg"
            # Both checks are pure; the cheap kind/operator mismatch rejects most pairs first.
            return false if:
                left.kind != right.kind or left.operator != right.operator or left.kind == "unsupported"
                not proof_kernel_replay_arena_shape_valid(left)
                not same_root and not proof_kernel_replay_arena_shape_valid(right)
            return true

        def proof_kernel_replay_expr_equality_work_charge(amount: usize, work_limit: usize, work_used: mutable usize&) -> bool:
            effective_limit: usize = work_limit if work_limit < PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK else PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
            if work_used > effective_limit:
                return false
            if amount > effective_limit - work_used:
                work_used <- effective_limit
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_replay_expr_equality_node_work(node: ElisaProofKernelCore::ProofKernelNode, work_limit: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_expr_equality_work_charge(sview_len(node.kind), work_limit, work_used)
                not proof_kernel_replay_expr_equality_work_charge(sview_len(node.name), work_limit, work_used)
                not proof_kernel_replay_expr_equality_work_charge(sview_len(node.secondary_name), work_limit, work_used)
            return proof_kernel_replay_expr_equality_work_charge(sview_len(node.operator), work_limit, work_used)

        def proof_kernel_replay_expr_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_expr_equal_with_work(nodes, children, left_root, right_root, depth, PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK, &work_used)

        # Report adapters that search many candidate traces need the actual bounded equality
        # work, not merely one charge per root pair. Reserve bytes before node validation or
        # string comparison, so this is a hard limit on the comparison itself rather than a
        # post-hoc accounting estimate. The same budget includes one unit before each pair is
        # scheduled; total scheduled work and live pending storage have separate caps so a wide
        # aggregate cannot allocate millions of pair records before the walk begins.
        def proof_kernel_replay_expr_equal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize, work_limit: usize, work_used: mutable usize&) -> bool:
            work_used <- 0
            return false if:
                not proof_kernel_replay_valid(nodes, left_root) or not proof_kernel_replay_valid(nodes, right_root)
                not proof_kernel_replay_expr_equality_work_charge(1, work_limit, work_used)
            pending: mutable darray[ProofKernelReplayExprPair] = [ProofKernelReplayExprPair{left: left_root, right: right_root, depth: depth, call_argument: false}]
            scheduled: mutable usize = 1
            while pending.count > 0 |pending, scheduled, nodes, children, work_used|:
                invariant true
                pair: ProofKernelReplayExprPair = pending.pop()
                return false if:
                    pair.left >= nodes.count or pair.right >= nodes.count
                    not proof_kernel_replay_expr_equality_node_work(nodes[pair.left], work_limit, work_used)
                    not proof_kernel_replay_expr_equality_node_work(nodes[pair.right], work_limit, work_used)
                    not proof_kernel_replay_expr_pair_expand(nodes, children, &pending, &scheduled, work_limit, work_used, pair)
            return true

        def proof_kernel_replay_expr_pair_enqueue_two(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left_first: usize, right_first: usize, left_second: usize, right_second: usize, depth: usize) -> bool:
            return false if not proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_first, right_first, depth)
            return proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_second, right_second, depth)

        def proof_kernel_replay_expr_pair_enqueue_three(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left_first: usize, right_first: usize, left_second: usize, right_second: usize, left_third: usize, right_third: usize, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_first, right_first, depth)
                not proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_second, right_second, depth)
            return proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_third, right_third, depth)

        def proof_kernel_replay_expr_pair_enqueue_aggregate_children(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize, call_arguments: bool) -> bool:
            return false if left.children_count != right.children_count
            return proof_kernel_replay_expr_child_span_enqueue(children, pending, scheduled, work_limit, work_used, left.children_start, right.children_start, left.children_count, depth, call_arguments)

        def proof_kernel_replay_expr_pair_enqueue_aggregate_with_head(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize, call_arguments: bool) -> bool:
            return false if:
                left.children_count != right.children_count
                not proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left.left, right.left, depth)
            return proof_kernel_replay_expr_child_span_enqueue(children, pending, scheduled, work_limit, work_used, left.children_start, right.children_start, left.children_count, depth, call_arguments)

        def proof_kernel_replay_expr_pair_enqueue_aggregate_index(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if left.children_count == 0
            return proof_kernel_replay_expr_pair_enqueue_aggregate_with_head(left, right, children, pending, scheduled, work_limit, work_used, depth, false)

        def proof_kernel_replay_expr_pair_enqueue_aggregate_call(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if left.auxiliary != right.auxiliary
            return proof_kernel_replay_expr_pair_enqueue_aggregate_with_head(left, right, children, pending, scheduled, work_limit, work_used, depth, true)

        def proof_kernel_replay_expr_pair_enqueue_aggregate(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            match left.kind:
                "index-n":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate_index(left, right, children, pending, scheduled, work_limit, work_used, depth)
                "call":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate_call(left, right, children, pending, scheduled, work_limit, work_used, depth)
                "construct" | "record-update":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate_with_head(left, right, children, pending, scheduled, work_limit, work_used, depth, false)
                "array" | "tuple" | "set" | "dict":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate_children(left, right, children, pending, scheduled, work_limit, work_used, depth, false)
                _:
                    return false

        def proof_kernel_replay_expr_pair_enqueue_single(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            if left.kind in {"field", "scope", "call_arg", "field-init"}:
                return false if left.name != right.name
            return proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left.left, right.left, depth)

        def proof_kernel_replay_expr_pair_enqueue_quantifier(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if left.name != right.name or left.secondary_name != right.secondary_name
            return proof_kernel_replay_expr_pair_enqueue_two(pending, scheduled, work_limit, work_used, left.left, right.left, left.right, right.right, depth)

        def proof_kernel_replay_expr_pair_enqueue_children(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            match left.kind:
                "field" | "scope" | "call_arg" | "field-init" | "unary" | "move":
                    return proof_kernel_replay_expr_pair_enqueue_single(left, right, pending, scheduled, work_limit, work_used, depth)
                "binary" | "index" | "dict_entry":
                    return proof_kernel_replay_expr_pair_enqueue_two(pending, scheduled, work_limit, work_used, left.left, right.left, left.right, right.right, depth)
                "slice" | "if":
                    return proof_kernel_replay_expr_pair_enqueue_three(pending, scheduled, work_limit, work_used, left.left, right.left, left.right, right.right, left.auxiliary, right.auxiliary, depth)
                "index-n" | "call" | "array" | "tuple" | "set" | "dict" | "construct" | "record-update":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate(left, right, children, pending, scheduled, work_limit, work_used, depth)
                "quantifier":
                    return proof_kernel_replay_expr_pair_enqueue_quantifier(left, right, pending, scheduled, work_limit, work_used, depth)
            return false

        def proof_kernel_replay_expr_pair_expand(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, pair: ProofKernelReplayExprPair) -> bool:
            pair_left: usize = pair.left
            pair_right: usize = pair.right
            return false if not proof_kernel_replay_valid(nodes, pair_left) or not proof_kernel_replay_valid(nodes, pair_right)
            assert pair_left < nodes.count and pair_right < nodes.count
            left: ElisaProofKernelCore::ProofKernelNode = nodes[pair_left]
            right: ElisaProofKernelCore::ProofKernelNode = nodes[pair_right]
            return false if not proof_kernel_replay_expr_pair_nodes_valid(left, right, pair_left == pair_right, pair.call_argument, pair.depth)
            leaf: (handled: bool, equal: bool) = proof_kernel_replay_expr_leaf_equal(left.kind, left.value, right.value, left.name, right.name)
            return leaf.equal if leaf.handled
            return proof_kernel_replay_expr_pair_enqueue_children(left, right, children, pending, scheduled, work_limit, work_used, pair.depth + 1)

        def proof_kernel_replay_definitionally_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize) -> bool:
            # This normalization follows only a finite chain of explicit identity rewrites. The
            # same depth budget as structural equality prevents a malformed arena from turning
            # definitional comparison into unbounded host recursion.
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not ElisaProofKernelCore::depth_valid(depth)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return true if proof_kernel_replay_expr_equal(nodes, children, left_root, right_root, depth + 1)
            return false if not proof_kernel_replay_valid(nodes, left_root)
            left: ElisaProofKernelCore::ProofKernelNode = nodes[left_root]
            if left.kind == "unary" and left.operator == "+":
                return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1)
            if left.kind == "binary":
                amount: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.right, depth + 1)
                if left.operator in {"+", "-"}:
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 0
                if left.operator == "*":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 1
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, depth + 1)
                    return target.known and target.value == 0 if amount.known and amount.value == 0
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.left, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.right, right_root, depth + 1) if base.known and base.value == 1
                    return target.known and target.value == 0 if base.known and base.value == 0
                if left.operator == "/":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 1
                if left.operator == "%":
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, depth + 1)
                    return target.known and target.value == 0 if amount.known and amount.value == 1
                if left.operator == "&":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.left, depth + 1)
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, depth + 1)
                    return target.known and target.value == 0 if:
                        amount.known and amount.value == 0
                        base.known and base.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if proof_kernel_replay_expr_equal(nodes, children, left.left, left.right, depth + 1)
                if left.operator == "|":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.left, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.right, right_root, depth + 1) if base.known and base.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if proof_kernel_replay_expr_equal(nodes, children, left.left, left.right, depth + 1)
                if left.operator == "^":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.left, depth + 1)
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.right, right_root, depth + 1) if base.known and base.value == 0
                    return target.known and target.value == 0 if proof_kernel_replay_expr_equal(nodes, children, left.left, left.right, depth + 1)
                if left.operator in {"<<", ">>"}:
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 0
            if not proof_kernel_replay_valid(nodes, right_root):
                return false
            right: ElisaProofKernelCore::ProofKernelNode = nodes[right_root]
            if right.kind == "unary" and right.operator == "+":
                return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1)
            if right.kind == "binary":
                amount: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.right, depth + 1)
                if right.operator in {"+", "-"}:
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 0
                if right.operator == "*":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 1
                    left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, depth + 1)
                    return left_constant.known and left_constant.value == 0 if amount.known and amount.value == 0
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.left, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.right, depth + 1) if base.known and base.value == 1
                    return left_constant.known and left_constant.value == 0 if base.known and base.value == 0
                if right.operator == "/":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 1
                if right.operator == "%":
                    left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, depth + 1)
                    return left_constant.known and left_constant.value == 0 if amount.known and amount.value == 1
                if right.operator == "&":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.left, depth + 1)
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, depth + 1)
                    return target.known and target.value == 0 if:
                        amount.known and amount.value == 0
                        base.known and base.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if proof_kernel_replay_expr_equal(nodes, children, right.left, right.right, depth + 1)
                if right.operator == "|":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.left, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.right, depth + 1) if base.known and base.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if proof_kernel_replay_expr_equal(nodes, children, right.left, right.right, depth + 1)
                if right.operator == "^":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.left, depth + 1)
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.right, depth + 1) if base.known and base.value == 0
                    return target.known and target.value == 0 if proof_kernel_replay_expr_equal(nodes, children, right.left, right.right, depth + 1)
                if right.operator in {"<<", ">>"}:
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 0
            return false
