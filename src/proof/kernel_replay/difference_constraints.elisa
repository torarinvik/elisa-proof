const PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS: usize = 4096
const PROOF_KERNEL_REPLAY_DIFFERENCE_COLLECT_WORK_LIMIT: usize = 65536
const PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK: usize = 4000000
const PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_PENDING: usize = 65536

extend ElisaProofKernelReplay:
    private:
        struct ProofKernelReplayExprPair:
            left: usize
            right: usize
            depth: usize
            call_argument: bool

        # The producer's peer rule, one step further: `base <= middle < peer` with a nameable
        # middle that is not the base itself (a partition's `lo <= k < xs.count`).
        def proof_kernel_replay_difference_push(left: ProofKernelReplayAffine, right: ProofKernelReplayAffine, reverse: bool, strict: bool, constraints: mutable darray[ProofKernelReplayDifference]&) -> void:
            return if constraints.count >= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS
            first: ProofKernelReplayAffine = left if not reverse else right
            second: ProofKernelReplayAffine = right if not reverse else left
            difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(second.offset, first.offset)
            return if not difference.known
            bound: mutable i64 = difference.value
            if strict:
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(bound, 1)
                return if not decremented.known
                bound <- decremented.value
            # Encode `sign * base + offset` as a difference constraint only when the resulting
            # relation is representable by the graph. A negative affine term reverses the graph
            # edge; dropping that sign would turn `0 - x <= 0` into the false bound `x <= 0`.
            if first.base == "" and second.base == "":
                constraints.push(ProofKernelReplayDifference{left: "", right: "", bound: bound})
                return
            if first.base == "":
                constraints.push(ProofKernelReplayDifference{left: second.base, right: "", bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and second.negative
                constraints.push(ProofKernelReplayDifference{left: "", right: second.base, bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and not second.negative
                return
            if second.base == "":
                constraints.push(ProofKernelReplayDifference{left: "", right: first.base, bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and first.negative
                constraints.push(ProofKernelReplayDifference{left: first.base, right: "", bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and not first.negative
                return
            return if first.negative != second.negative
            constraints.push(ProofKernelReplayDifference{left: second.base, right: first.base, bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and first.negative
            constraints.push(ProofKernelReplayDifference{left: first.base, right: second.base, bound: bound}) if constraints.count < PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS and not first.negative

        # Mirror of the producer's fact-side increment guard. The peer argument is asked of the
        # facts rather than of the constraint graph, because a fact is being imported into that
        # graph and there is not one yet. The base is taken from the operand's own node, so the
        # comparison against a peer fact is the same structural one the goal side performs.
        def proof_kernel_replay_negation(operator: sview) -> sview:
            return "!=" if operator == "=="
            return "==" if operator == "!="
            return ">=" if operator == "<"
            return "<" if operator == ">="
            return ">" if operator == "<="
            return "<=" if operator == ">"
            return ""

        def proof_kernel_replay_negation_supported(operator: sview) -> bool:
            return operator in {"==", "!=", "<", "<=", ">", ">="}

        # The order whose truth refutes `a operator b` once its operands are swapped:
        # `b <= a` refutes `a < b`. Empty for any operator without one.
        def proof_kernel_replay_order_converse(operator: sview) -> sview:
            return "<=" if operator == "<"
            return "<" if operator == "<="
            return ">=" if operator == ">"
            return ">" if operator == ">="
            ""

        def proof_kernel_replay_expr_pair_enqueue(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left: usize, right: usize, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_expr_equality_work_charge(1, work_limit, work_used)
                scheduled >= PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
                pending.count >= PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_PENDING
            pending.push(ProofKernelReplayExprPair{left: left, right: right, depth: depth, call_argument: false})
            scheduled <- scheduled + 1
            return true

        def proof_kernel_replay_expr_call_argument_enqueue(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left: usize, right: usize, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_expr_equality_work_charge(1, work_limit, work_used)
                scheduled >= PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
                pending.count >= PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_PENDING
            pending.push(ProofKernelReplayExprPair{left: left, right: right, depth: depth, call_argument: true})
            scheduled <- scheduled + 1
            return true

        def proof_kernel_replay_expr_child_enqueue(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left: usize, right: usize, depth: usize, call_argument: bool) -> bool:
            return proof_kernel_replay_expr_call_argument_enqueue(pending, scheduled, work_limit, work_used, left, right, depth) if call_argument
            return proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left, right, depth)

        def proof_kernel_replay_expr_child_span_enqueue(children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left_start: usize, right_start: usize, count: usize, depth: usize, call_arguments: bool) -> bool:
            return false if count > children.count
            return false if left_start > children.count - count
            return false if right_start > children.count - count
            for index in 0..<count |index, children, pending, scheduled, work_limit, work_used, left_start, right_start, depth, call_arguments|:
                left_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, left_start + index)
                right_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, right_start + index)
                return false if not left_child.known or not right_child.known or not proof_kernel_replay_expr_child_enqueue(pending, scheduled, work_limit, work_used, left_child.value, right_child.value, depth, call_arguments)
            return true

        def proof_kernel_replay_expr_leaf_equal(kind: sview, left_value: i64, right_value: i64, left_name: sview, right_name: sview, work_limit: usize, work_used: mutable usize&) -> (complete: bool, handled: bool, equal: bool):
            return (false, false, false) if not proof_kernel_replay_expr_equality_work_charge(sview_len(kind), work_limit, work_used)
            match kind:
                "absent":
                    return (true, true, true)
                "int" | "bool":
                    return (true, true, left_value == right_value)
                "typed-int":
                    return (false, true, false) if not proof_kernel_replay_expr_equality_work_charge(sview_len(left_name), work_limit, work_used) or not proof_kernel_replay_expr_equality_work_charge(sview_len(right_name), work_limit, work_used)
                    return (true, true, left_value == right_value and left_name == right_name)
                "float" | "opaque-float-literal" | "string" | "char" | "ident" | "shorthand":
                    return (false, true, false) if not proof_kernel_replay_expr_equality_work_charge(sview_len(left_name), work_limit, work_used) or not proof_kernel_replay_expr_equality_work_charge(sview_len(right_name), work_limit, work_used)
                    return (true, true, left_name == right_name)
                _:
                    return (true, false, false)

        def proof_kernel_replay_expr_pair_nodes_valid(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, same_root: bool, call_argument: bool, depth: usize) -> bool:
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                call_argument and left.kind != "call_arg"
            # Both checks are pure; the cheap kind/operator mismatch rejects most pairs first.
            return false if:
                left.kind != right.kind or left.operator != right.operator or left.value != right.value or left.name != right.name or left.secondary_name != right.secondary_name or left.kind == "unsupported"
                not proof_kernel_replay_arena_shape_valid(left)
                not same_root and not proof_kernel_replay_arena_shape_valid(right)
            return true

        def proof_kernel_replay_expr_equality_work_charge(amount: usize, work_limit: usize, work_used: mutable usize&) -> bool:
            effective_limit: usize = work_limit if work_limit < PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK else PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
            if work_used > effective_limit:
                return false
            if amount > effective_limit - work_used:
                work_used <- effective_limit
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_replay_expr_equality_node_work(node: ElisaProofKernelCore::ProofKernelNode, work_limit: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_expr_equality_work_charge(sview_len(node.kind), work_limit, work_used)
                not proof_kernel_replay_expr_equality_work_charge(sview_len(node.name), work_limit, work_used)
                not proof_kernel_replay_expr_equality_work_charge(sview_len(node.secondary_name), work_limit, work_used)
            return proof_kernel_replay_expr_equality_work_charge(sview_len(node.operator), work_limit, work_used)

        def proof_kernel_replay_expr_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_expr_equal_with_work(nodes, children, left_root, right_root, depth, PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK, &work_used)

        # Report adapters that search many candidate traces need the actual bounded equality
        # work, not merely one charge per root pair. Reserve bytes before node validation or
        # string comparison, so this is a hard limit on the comparison itself rather than a
        # post-hoc accounting estimate. The same budget includes one unit before each pair is
        # scheduled; total scheduled work and live pending storage have separate caps so a wide
        # aggregate cannot allocate millions of pair records before the walk begins.
        def proof_kernel_replay_expr_equal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize, work_limit: usize, work_used: mutable usize&) -> bool:
            work_used <- 0
            return false if:
                not proof_kernel_replay_valid(nodes, left_root) or not proof_kernel_replay_valid(nodes, right_root)
                not proof_kernel_replay_expr_equality_work_charge(1, work_limit, work_used)
            pending: mutable darray[ProofKernelReplayExprPair] = [ProofKernelReplayExprPair{left: left_root, right: right_root, depth: depth, call_argument: false}]
            scheduled: mutable usize = 1
            while pending.count > 0 |pending, scheduled, nodes, children, work_used|:
                invariant true
                pair: ProofKernelReplayExprPair = pending.pop()
                return false if:
                    pair.left >= nodes.count or pair.right >= nodes.count
                    not proof_kernel_replay_expr_equality_node_work(nodes[pair.left], work_limit, work_used)
                    not proof_kernel_replay_expr_equality_node_work(nodes[pair.right], work_limit, work_used)
                    not proof_kernel_replay_expr_pair_expand(nodes, children, &pending, &scheduled, work_limit, work_used, pair)
            return true

        def proof_kernel_replay_expr_pair_enqueue_two(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left_first: usize, right_first: usize, left_second: usize, right_second: usize, depth: usize) -> bool:
            return false if not proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_first, right_first, depth)
            return proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_second, right_second, depth)

        def proof_kernel_replay_expr_pair_enqueue_three(pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, left_first: usize, right_first: usize, left_second: usize, right_second: usize, left_third: usize, right_third: usize, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_first, right_first, depth)
                not proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_second, right_second, depth)
            return proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left_third, right_third, depth)

        def proof_kernel_replay_expr_pair_enqueue_aggregate_children(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize, call_arguments: bool) -> bool:
            return false if left.children_count != right.children_count
            return proof_kernel_replay_expr_child_span_enqueue(children, pending, scheduled, work_limit, work_used, left.children_start, right.children_start, left.children_count, depth, call_arguments)

        def proof_kernel_replay_expr_pair_enqueue_aggregate_with_head(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize, call_arguments: bool) -> bool:
            return false if:
                left.children_count != right.children_count
                not proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left.left, right.left, depth)
            return proof_kernel_replay_expr_child_span_enqueue(children, pending, scheduled, work_limit, work_used, left.children_start, right.children_start, left.children_count, depth, call_arguments)

        def proof_kernel_replay_expr_pair_enqueue_aggregate_index(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if left.children_count == 0
            return proof_kernel_replay_expr_pair_enqueue_aggregate_with_head(left, right, children, pending, scheduled, work_limit, work_used, depth, false)

        def proof_kernel_replay_expr_pair_enqueue_aggregate_call(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if left.auxiliary != right.auxiliary
            return proof_kernel_replay_expr_pair_enqueue_aggregate_with_head(left, right, children, pending, scheduled, work_limit, work_used, depth, true)

        def proof_kernel_replay_expr_pair_enqueue_aggregate(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            match left.kind:
                "index-n":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate_index(left, right, children, pending, scheduled, work_limit, work_used, depth)
                "call":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate_call(left, right, children, pending, scheduled, work_limit, work_used, depth)
                "construct" | "record-update":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate_with_head(left, right, children, pending, scheduled, work_limit, work_used, depth, false)
                "array" | "tuple" | "set" | "dict":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate_children(left, right, children, pending, scheduled, work_limit, work_used, depth, false)
                _:
                    return false

        def proof_kernel_replay_expr_pair_enqueue_single(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            if left.kind in {"field", "scope", "call_arg", "field-init"}:
                return false if left.name != right.name
            return proof_kernel_replay_expr_pair_enqueue(pending, scheduled, work_limit, work_used, left.left, right.left, depth)

        def proof_kernel_replay_expr_pair_enqueue_quantifier(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if left.auxiliary != right.auxiliary or left.name != right.name or left.secondary_name != right.secondary_name
            return proof_kernel_replay_expr_pair_enqueue_two(pending, scheduled, work_limit, work_used, left.left, right.left, left.right, right.right, depth)

        def proof_kernel_replay_expr_pair_enqueue_children(left: ElisaProofKernelCore::ProofKernelNode, right: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, depth: usize) -> bool:
            match left.kind:
                "field" | "scope" | "call_arg" | "field-init" | "unary" | "move":
                    return proof_kernel_replay_expr_pair_enqueue_single(left, right, pending, scheduled, work_limit, work_used, depth)
                # `checked-index` retains both the guarded index and fallback children,
                # so ordinary structural equality can compare its complete value.
                # `checked-get` stays unsupported because its recovery is erased.
                "binary" | "index" | "dict_entry" | "checked-index":
                    return proof_kernel_replay_expr_pair_enqueue_two(pending, scheduled, work_limit, work_used, left.left, right.left, left.right, right.right, depth)
                "slice" | "if":
                    return proof_kernel_replay_expr_pair_enqueue_three(pending, scheduled, work_limit, work_used, left.left, right.left, left.right, right.right, left.auxiliary, right.auxiliary, depth)
                "index-n" | "call" | "array" | "tuple" | "set" | "dict" | "construct" | "record-update":
                    return proof_kernel_replay_expr_pair_enqueue_aggregate(left, right, children, pending, scheduled, work_limit, work_used, depth)
                "quantifier":
                    return proof_kernel_replay_expr_pair_enqueue_quantifier(left, right, pending, scheduled, work_limit, work_used, depth)
            return false

        def proof_kernel_replay_expr_pair_expand(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, pending: mutable darray[ProofKernelReplayExprPair]&, scheduled: mutable usize&, work_limit: usize, work_used: mutable usize&, pair: ProofKernelReplayExprPair) -> bool:
            pair_left: usize = pair.left
            pair_right: usize = pair.right
            return false if not proof_kernel_replay_valid(nodes, pair_left) or not proof_kernel_replay_valid(nodes, pair_right)
            assert pair_left < nodes.count and pair_right < nodes.count
            left: ElisaProofKernelCore::ProofKernelNode = nodes[pair_left]
            right: ElisaProofKernelCore::ProofKernelNode = nodes[pair_right]
            return false if not proof_kernel_replay_expr_pair_nodes_valid(left, right, pair_left == pair_right, pair.call_argument, pair.depth)
            leaf: (complete: bool, handled: bool, equal: bool) = proof_kernel_replay_expr_leaf_equal(left.kind, left.value, right.value, left.name, right.name, work_limit, work_used)
            return false if not leaf.complete
            return leaf.equal if leaf.handled
            return proof_kernel_replay_expr_pair_enqueue_children(left, right, children, pending, scheduled, work_limit, work_used, pair.depth + 1)
