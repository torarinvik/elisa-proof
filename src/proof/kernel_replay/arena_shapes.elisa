# Canonical shape validation for the source-neutral kernel arena.
#
# This module only answers whether a node's own fields are well-formed. Graph traversal and
# child-index validation stay in quantifiers_and_arena.elisa so the two responsibilities cannot
# silently diverge.
extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_VALUES: usize = 65536
        const PROOF_KERNEL_REPLAY_MAX_QUANTIFIER_ENTRIES: usize = 32768
        const PROOF_KERNEL_REPLAY_MAX_RESOURCE_CHILDREN: usize = 32768
        const PROOF_KERNEL_REPLAY_MAX_RESOURCE_FLAGS: usize = 7
        const PROOF_KERNEL_REPLAY_MAX_RESOURCE_EXTENT_FLAGS: usize = 15
        const PROOF_KERNEL_REPLAY_WRITABLE_FLAG: usize = 1
        const PROOF_KERNEL_REPLAY_REFERENCE_FLAG: usize = 2
        const PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG: usize = 4
        const PROOF_KERNEL_REPLAY_BORROWABLE_FLAG: usize = 8
        const PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG: usize = 16
        const PROOF_KERNEL_REPLAY_EXPLICIT_REGION_DESTROY: usize = 1
        const PROOF_KERNEL_REPLAY_MUTABLE_REGION_FLAG: usize = 2
        const PROOF_KERNEL_REPLAY_RETURN_REGION_FLAG: usize = 4
        const PROOF_KERNEL_REPLAY_MAX_RESOURCE_JOIN_MOVES: usize = 65536
        const PROOF_KERNEL_REPLAY_MAX_DISJOINT_WITNESSES: usize = 4096
        const PROOF_KERNEL_REPLAY_MAX_CHILDREN: usize = 4000000

        def proof_kernel_replay_extend_children(children: mutable darray[usize]&, values: darray[usize]&, children_count_before: usize) -> bool:
            requires children_count_before == children.count
            ensure result implies children.count == children_count_before + values.count
            ensure result implies children_count_before <= PROOF_KERNEL_REPLAY_MAX_CHILDREN and values.count <= PROOF_KERNEL_REPLAY_MAX_CHILDREN - children_count_before
            ensure result implies (forall value_index in 0..<values.count:
                children[children_count_before + value_index] == values[value_index]
            )
            ensure not result implies children.count == children_count_before
            ensure not result and children_count_before <= PROOF_KERNEL_REPLAY_MAX_CHILDREN implies values.count > PROOF_KERNEL_REPLAY_MAX_CHILDREN - children_count_before
            ensure children_count_before > PROOF_KERNEL_REPLAY_MAX_CHILDREN implies not result
            return false if children.count > PROOF_KERNEL_REPLAY_MAX_CHILDREN
            return false if values.count > PROOF_KERNEL_REPLAY_MAX_CHILDREN - children.count
            children.extend(values)
            return true

        def proof_kernel_replay_scalar_kind(kind: sview) -> i64:
            ensure kind == "int" implies result == 1
            ensure kind == "bool" implies result == 2
            ensure kind == "float" implies result == 3
            ensure kind == "string" implies result == 4
            ensure kind == "char" implies result == 5
            ensure kind == "ident" implies result == 6
            ensure (kind != "int" and kind != "bool" and kind != "float" and kind != "string" and kind != "char" and kind != "ident") implies result == 0
            return 1 if kind == "int"
            return 2 if kind == "bool"
            return 3 if kind == "float"
            return 4 if kind == "string"
            return 5 if kind == "char"
            return 6 if kind == "ident"
            return 0

        def proof_kernel_replay_operator_valid(operator: sview) -> bool:
            ensure result == (
                operator in {"+", "-", "*", "/", "%"}
                or operator in {"==", "!=", "<", ">", "<=", ">="}
                or operator in {"and", "or", "=>", "not"}
                or operator in {"in", "is", "as", "|", "^", "&"}
                or operator in {"<<", ">>", "range_lt", "range_le", "else"}
            )
            return true if:
                operator in {"+", "-", "*", "/", "%"}
                operator in {"==", "!=", "<", ">", "<=", ">="}
                operator in {"and", "or", "=>", "not"}
                operator in {"in", "is", "as", "|", "^", "&"}
                operator in {"<<", ">>", "range_lt", "range_le", "else"}
            return false

        # Unary AST nodes have a narrower grammar than binary nodes. Keep borrow (`&`)
        # because reference typing consumes it; all other entries are arithmetic or
        # proposition operators whose unary interpretation has no kernel rule.
        def proof_kernel_replay_unary_operator_valid(operator: sview) -> bool:
            ensure result == (operator in {"+", "-", "not", "&"})
            operator in {"+", "-", "not", "&"}

        # Binary AST nodes cannot carry the unary-only logical negation operator.
        def proof_kernel_replay_binary_operator_valid(operator: sview) -> bool:
            ensure result == (proof_kernel_replay_operator_valid(operator) and operator != "not")
            proof_kernel_replay_operator_valid(operator) and operator != "not"

        # An `int` operator is its typed-literal tag. Only a full-width unsigned literal whose
        # payload is negative may carry one, so each value keeps a single canonical spelling:
        # an untyped payload p denotes p, and a tagged payload p denotes p + 2^64.
        def proof_kernel_replay_int_tag_valid(tag: sview) -> bool:
            ensure result == (tag in {"u64", "usize"})
            return tag in {"u64", "usize"}

        def proof_kernel_replay_int_tagged(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.kind == "int" and node.operator != "")
            return node.kind == "int" and node.operator != ""

        def proof_kernel_replay_arena_int_scalar_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.name == "" and (node.operator == "" or (proof_kernel_replay_int_tag_valid(node.operator) and node.value < 0)))
            return node.name == "" and (node.operator == "" or (proof_kernel_replay_int_tag_valid(node.operator) and node.value < 0))

        def proof_kernel_replay_arena_bool_scalar_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.name == "" and (node.value == 0 or node.value == 1))
            return node.name == "" and (node.value == 0 or node.value == 1)

        # Floating terms cannot use ordinary reflexive equality: arithmetic can produce NaN.
        # Reject them until IEEE semantics are represented explicitly.
        def proof_kernel_replay_arena_float_scalar_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure not result
            return false

        # A float literal can be carried only as a spelling token inside an opaque Boolean
        # comparison. It is not a scalar term and cannot witness arithmetic or equality laws.
        def proof_kernel_replay_arena_opaque_float_literal_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""

        def proof_kernel_replay_arena_string_scalar_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.value == 0)
            return node.value == 0

        def proof_kernel_replay_arena_named_scalar_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.value == 0 and node.name != "")
            return node.value == 0 and node.name != ""

        def proof_kernel_replay_arena_scalar_value_shape(node: ElisaProofKernelCore::ProofKernelNode, scalar_kind: i64) -> bool:
            ensure result == (
                (scalar_kind == 1 and proof_kernel_replay_arena_int_scalar_shape(node))
                or (scalar_kind == 2 and proof_kernel_replay_arena_bool_scalar_shape(node))
                or (scalar_kind == 3 and proof_kernel_replay_arena_float_scalar_shape(node))
                or (scalar_kind == 4 and proof_kernel_replay_arena_string_scalar_shape(node))
                or ((scalar_kind == 5 or scalar_kind == 6) and proof_kernel_replay_arena_named_scalar_shape(node))
            )
            if scalar_kind == 1:
                return proof_kernel_replay_arena_int_scalar_shape(node)
            if scalar_kind == 2:
                return proof_kernel_replay_arena_bool_scalar_shape(node)
            if scalar_kind == 3:
                return proof_kernel_replay_arena_float_scalar_shape(node)
            if scalar_kind == 4:
                return proof_kernel_replay_arena_string_scalar_shape(node)
            if scalar_kind == 5 or scalar_kind == 6:
                return proof_kernel_replay_arena_named_scalar_shape(node)
            return false

        def proof_kernel_replay_arena_scalar_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == proof_kernel_replay_arena_scalar_shape_for_kind(node, proof_kernel_replay_scalar_kind(node.kind)).known
            ensure result.valid == proof_kernel_replay_arena_scalar_shape_for_kind(node, proof_kernel_replay_scalar_kind(node.kind)).valid
            if node.kind == "typed-int":
                typed: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(node)
                return (true, typed.known)
            return proof_kernel_replay_arena_scalar_shape_for_kind(node, proof_kernel_replay_scalar_kind(node.kind))

        # `scalar_kind` must be `proof_kernel_replay_scalar_kind(node.kind)`; callers that already
        # matched the kind pass its code to skip re-deriving it.
        def proof_kernel_replay_arena_scalar_shape_for_kind(node: ElisaProofKernelCore::ProofKernelNode, scalar_kind: i64) -> (known: bool, valid: bool):
            requires scalar_kind == proof_kernel_replay_scalar_kind(node.kind)
            ensure result.known == (node.kind == "typed-int" or scalar_kind != 0)
            ensure not result.known implies not result.valid
            ensure result.known and node.kind == "typed-int" implies result.valid == ElisaProofKernelCore::typed_literal_value(node).known
            ensure result.known and node.kind != "typed-int" implies result.valid == (
                (node.operator == "" or scalar_kind == 1)
                and node.left == 0 and node.right == 0 and node.auxiliary == 0
                and node.children_start == 0 and node.children_count == 0 and node.secondary_name == ""
                and proof_kernel_replay_arena_scalar_value_shape(node, scalar_kind)
            )
            if node.kind == "typed-int":
                typed: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(node)
                return (true, typed.known)
            return (false, false) if scalar_kind == 0
            operator_empty: bool = node.operator == "" or scalar_kind == 1
            fields_empty: bool = operator_empty and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.secondary_name == ""
            return (true, fields_empty and proof_kernel_replay_arena_scalar_value_shape(node, scalar_kind))

        def proof_kernel_replay_arena_leaf_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"opaque-float-literal", "shorthand", "absent", "unsupported"})
            ensure result.valid == (
                (node.kind == "opaque-float-literal" and proof_kernel_replay_arena_opaque_float_literal_shape(node))
                or (node.kind == "shorthand" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
                or (node.kind == "absent" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "unsupported" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            )
            if node.kind == "opaque-float-literal":
                return (true, proof_kernel_replay_arena_opaque_float_literal_shape(node))
            if node.kind == "shorthand":
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            if node.kind == "absent":
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "unsupported":
                return (true, node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            return (false, false)

        def proof_kernel_replay_arena_unary_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"unary", "move"})
            ensure result.valid == (
                (node.kind == "unary" and proof_kernel_replay_unary_operator_valid(node.operator) and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "move" and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            )
            if node.kind == "unary":
                return (true, proof_kernel_replay_unary_operator_valid(node.operator) and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "move":
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            return (false, false)

        def proof_kernel_replay_arena_access_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"field", "scope", "binary", "index", "dict_entry"})
            ensure result.valid == (
                ((node.kind in {"field", "scope"}) and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
                or (node.kind == "binary" and proof_kernel_replay_binary_operator_valid(node.operator) and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or ((node.kind in {"index", "dict_entry"}) and node.operator == "" and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            )
            if node.kind in {"field", "scope"}:
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            if node.kind == "binary":
                return (true, proof_kernel_replay_binary_operator_valid(node.operator) and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind in {"index", "dict_entry"}:
                return (true, node.operator == "" and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            return (false, false)

        def proof_kernel_replay_arena_projection_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"slice", "index-n", "checked-index", "checked-get"})
            ensure result.valid == (
                (node.kind == "slice" and node.operator == "" and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "index-n" and node.operator == "" and node.children_count > 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "checked-index" and node.operator == "" and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "checked-get" and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            )
            if node.kind == "slice":
                return (true, node.operator == "" and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "index-n":
                return (true, node.operator == "" and node.children_count > 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "checked-index":
                return (true, node.operator == "" and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "checked-get":
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            return (false, false)

        def proof_kernel_replay_arena_control_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"if", "call_arg", "field-init"})
            ensure result.valid == (
                (node.kind == "if" and node.operator == "" and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "call_arg" and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.secondary_name == "")
                or (node.kind == "field-init" and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            )
            if node.kind == "if":
                return (true, node.operator == "" and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "call_arg":
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.secondary_name == "")
            if node.kind == "field-init":
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            return (false, false)

        # Dispatchers are split in two so no body accumulates every callee's summary facts
        # (each result tuple and its postconditions) past the 64-fact analysis budget.
        def proof_kernel_replay_arena_simple_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (proof_kernel_replay_arena_simple_head_shape(node).known or proof_kernel_replay_arena_simple_tail_shape(node).known)
            ensure result.valid == (proof_kernel_replay_arena_simple_head_shape(node).valid or proof_kernel_replay_arena_simple_tail_shape(node).valid)
            head: (known: bool, valid: bool) = proof_kernel_replay_arena_simple_head_shape(node)
            return head if head.known
            return proof_kernel_replay_arena_simple_tail_shape(node)

        def proof_kernel_replay_arena_simple_head_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (proof_kernel_replay_arena_leaf_shape(node).known or proof_kernel_replay_arena_unary_shape(node).known)
            ensure result.valid == (proof_kernel_replay_arena_leaf_shape(node).valid or proof_kernel_replay_arena_unary_shape(node).valid)
            leaf: (known: bool, valid: bool) = proof_kernel_replay_arena_leaf_shape(node)
            return leaf if leaf.known
            unary: (known: bool, valid: bool) = proof_kernel_replay_arena_unary_shape(node)
            return unary if unary.known
            return (false, false)

        def proof_kernel_replay_arena_simple_tail_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (proof_kernel_replay_arena_access_shape(node).known or proof_kernel_replay_arena_projection_shape(node).known or proof_kernel_replay_arena_control_shape(node).known)
            ensure result.valid == (proof_kernel_replay_arena_access_shape(node).valid or proof_kernel_replay_arena_projection_shape(node).valid or proof_kernel_replay_arena_control_shape(node).valid)
            access: (known: bool, valid: bool) = proof_kernel_replay_arena_access_shape(node)
            return access if access.known
            projection: (known: bool, valid: bool) = proof_kernel_replay_arena_projection_shape(node)
            return projection if projection.known
            control: (known: bool, valid: bool) = proof_kernel_replay_arena_control_shape(node)
            return control if control.known
            return (false, false)

        def proof_kernel_replay_arena_aggregate_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"construct", "record-update", "call", "array", "tuple", "set", "dict", "quantifier"})
            ensure result.valid == (
                ((node.kind in {"construct", "record-update"}) and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "call" and node.operator == "" and node.right == 0 and (node.auxiliary == 0 or node.auxiliary == node.children_count) and node.value == 0 and node.name == "" and node.secondary_name == "")
                or ((node.kind in {"array", "tuple", "set", "dict"}) and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "quantifier" and (node.operator in {"", "forall", "exists"}) and (node.auxiliary == 1 or node.auxiliary == 2) and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and (node.auxiliary == 2 or node.secondary_name == "") and (node.auxiliary == 1 or node.secondary_name != "") and (node.auxiliary == 1 or node.name != node.secondary_name))
            )
            if node.kind in {"construct", "record-update"}:
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "call":
                return (true, node.operator == "" and node.right == 0 and (node.auxiliary == 0 or node.auxiliary == node.children_count) and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind in {"array", "tuple", "set", "dict"}:
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "quantifier":
                return (true, (node.operator in {"", "forall", "exists"}) and (node.auxiliary == 1 or node.auxiliary == 2) and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and (node.auxiliary == 2 or node.secondary_name == "") and (node.auxiliary == 1 or node.secondary_name != "") and (node.auxiliary == 1 or node.name != node.secondary_name))
            return (false, false)

        def proof_kernel_replay_arena_effect_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"effect", "effect-row", "effect-call", "effect-containment"})
            ensure result.valid == (
                (node.kind == "effect" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
                or (node.kind == "effect-row" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "effect-call" and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "")
                or (node.kind == "effect-containment" and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name != "")
            )
            if node.kind == "effect":
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            if node.kind == "effect-row":
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "effect-call":
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            if node.kind == "effect-containment":
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            return (false, false)

        def proof_kernel_replay_arena_resource_binding_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"resource-sview-param", "resource-bind", "resource-region-param", "resource-region-return"})
            ensure result.valid == (
                (node.kind == "resource-sview-param" and node.operator == "" and node.right == 0 and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != "")
                or (node.kind == "resource-bind" and (node.operator in {"value", "shared", "mutable", "external-shared", "external-mutable"}) and (node.auxiliary == 0 or node.auxiliary == PROOF_KERNEL_REPLAY_WRITABLE_FLAG or node.auxiliary == PROOF_KERNEL_REPLAY_BORROWABLE_FLAG or node.auxiliary == PROOF_KERNEL_REPLAY_WRITABLE_FLAG + PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) and ((node.auxiliary & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) == 0 or node.operator == "value") and (node.operator in {"shared", "mutable"} or node.left == 0) and node.right == 0 and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and node.name != "" and ((node.operator in {"shared", "mutable"}) and node.secondary_name != "" or node.operator == "value" and node.secondary_name == "" or node.operator in {"external-shared", "external-mutable"} and node.secondary_name == ""))
                or (node.kind == "resource-region-param" and node.operator == "external" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
                or (node.kind == "resource-region-return" and ((node.operator == "param" and node.right == 0 and node.auxiliary <= 1) or (node.operator == "value-param" and node.auxiliary == 0) or (node.operator == "sview" and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG and node.secondary_name == "") or (node.operator == "sview-call" and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG and node.secondary_name != "") or (node.operator == "param-call" and node.right == 0 and node.auxiliary <= 1 and node.secondary_name != "")) and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and (node.name != "" or node.operator == "param" and node.right == 0 and node.auxiliary <= 1 or node.operator == "param-call" and node.right == 0 and node.auxiliary <= 1 and node.secondary_name != "") and (((node.operator == "sview-call" and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG and node.secondary_name != "") or (node.operator == "param-call" and node.right == 0 and node.auxiliary <= 1 and node.secondary_name != "")) and node.secondary_name != "" or not ((node.operator == "sview-call" and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG and node.secondary_name != "") or (node.operator == "param-call" and node.right == 0 and node.auxiliary <= 1 and node.secondary_name != "")) and node.secondary_name == ""))
            )
            if node.kind == "resource-sview-param":
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != "")
            if node.kind == "resource-bind":
                valid_operator: bool = node.operator in {"value", "shared", "mutable", "external-shared", "external-mutable"}
                has_source: bool = node.operator in {"shared", "mutable"}
                external: bool = node.operator in {"external-shared", "external-mutable"}
                valid_flags: bool = node.auxiliary == 0 or node.auxiliary == PROOF_KERNEL_REPLAY_WRITABLE_FLAG or node.auxiliary == PROOF_KERNEL_REPLAY_BORROWABLE_FLAG or node.auxiliary == PROOF_KERNEL_REPLAY_WRITABLE_FLAG + PROOF_KERNEL_REPLAY_BORROWABLE_FLAG
                borrowable_mode: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) == 0 or node.operator == "value"
                return (true, valid_operator and valid_flags and borrowable_mode and (has_source or node.left == 0) and node.right == 0 and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and node.name != "" and (has_source and node.secondary_name != "" or node.operator == "value" and node.secondary_name == "" or external and node.secondary_name == ""))
            if node.kind == "resource-region-param":
                return (true, node.operator == "external" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            if node.kind == "resource-region-return":
                reference_return: bool = node.operator == "param" and node.right == 0 and node.auxiliary <= 1
                value_return: bool = node.operator == "value-param" and node.auxiliary == 0
                sview_return: bool = node.operator == "sview" and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG and node.secondary_name == ""
                sview_call_return: bool = node.operator == "sview-call" and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG and node.secondary_name != ""
                reference_call_return: bool = node.operator == "param-call" and node.right == 0 and node.auxiliary <= 1 and node.secondary_name != ""
                call_return: bool = sview_call_return or reference_call_return
                # Only a reference return may omit its lifetime: a region-less reference result.
                named_region: bool = node.name != "" or reference_return or reference_call_return
                return (true, (reference_return or value_return or sview_return or call_return) and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and named_region and (call_return and node.secondary_name != "" or not call_return and node.secondary_name == ""))
            return (false, false)

        def proof_kernel_replay_arena_resource_region_flags_valid(flags: usize) -> bool:
            ensure result == (
                flags <= PROOF_KERNEL_REPLAY_MAX_RESOURCE_EXTENT_FLAGS + PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG
                and not ((flags & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) != 0 and (flags & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) != 0)
                and not ((flags & PROOF_KERNEL_REPLAY_RETURN_REGION_FLAG) != 0 and (flags & PROOF_KERNEL_REPLAY_MUTABLE_REGION_FLAG) == 0)
            )
            return false if:
                flags > PROOF_KERNEL_REPLAY_MAX_RESOURCE_EXTENT_FLAGS + PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG
                (flags & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) != 0 and (flags & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) != 0
                (flags & PROOF_KERNEL_REPLAY_RETURN_REGION_FLAG) != 0 and (flags & PROOF_KERNEL_REPLAY_MUTABLE_REGION_FLAG) == 0
            return true

        def proof_kernel_replay_arena_resource_region_extent_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (
                node.operator == ""
                and ((node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) != 0 or node.right == 0)
                and proof_kernel_replay_arena_resource_region_flags_valid(node.auxiliary)
                and node.children_start == 0 and node.children_count == 0 and node.value == 0
                and node.name != "" and node.secondary_name != ""
            )
            has_sview_borrow: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) != 0
            return node.operator == "" and (has_sview_borrow or node.right == 0) and proof_kernel_replay_arena_resource_region_flags_valid(node.auxiliary) and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != ""

        def proof_kernel_replay_arena_resource_region_named_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (
                node.operator == "" and node.left == 0 and node.right == 0
                and (node.auxiliary == 0 or node.kind == "resource-region-close" and node.auxiliary == PROOF_KERNEL_REPLAY_EXPLICIT_REGION_DESTROY)
                and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295
                and node.name != "" and node.secondary_name == ""
            )
            valid_close_mode: bool = node.auxiliary == 0 or node.kind == "resource-region-close" and node.auxiliary == PROOF_KERNEL_REPLAY_EXPLICIT_REGION_DESTROY
            return node.operator == "" and node.left == 0 and node.right == 0 and valid_close_mode and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and node.name != "" and node.secondary_name == ""

        def proof_kernel_replay_arena_resource_region_discard_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value > 0 and node.value <= 4294967295 and node.name == "" and node.secondary_name != "")
            return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value > 0 and node.value <= 4294967295 and node.name == "" and node.secondary_name != ""

        def proof_kernel_replay_arena_resource_region_call_alloc_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name != "")
            return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name != ""

        def proof_kernel_replay_arena_resource_region_return_alloc_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value > 0 and node.value <= 4294967295 and node.name == "" and node.secondary_name != "")
            return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value > 0 and node.value <= 4294967295 and node.name == "" and node.secondary_name != ""

        def proof_kernel_replay_arena_resource_region_binding_shape(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value > 0 and node.value <= 4294967295 and node.name != "" and node.secondary_name != "")
            return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value > 0 and node.value <= 4294967295 and node.name != "" and node.secondary_name != ""

        def proof_kernel_replay_arena_resource_region_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"resource-region-open", "resource-region-close", "resource-region-alloc", "resource-region-bind", "resource-region-alloc-discard", "resource-region-return-alloc", "resource-region-call-alloc", "resource-region-rebind-alloc", "resource-region-assign"})
            ensure result.valid == (
                ((node.kind in {"resource-region-open", "resource-region-close"}) and proof_kernel_replay_arena_resource_region_named_shape(node))
                or (node.kind == "resource-region-alloc" and proof_kernel_replay_arena_resource_region_alloc_shape(node))
                or (node.kind == "resource-region-bind" and proof_kernel_replay_arena_resource_region_extent_shape(node))
                or (node.kind == "resource-region-return-alloc" and proof_kernel_replay_arena_resource_region_return_alloc_shape(node))
                or (node.kind == "resource-region-alloc-discard" and proof_kernel_replay_arena_resource_region_discard_shape(node))
                or (node.kind == "resource-region-call-alloc" and proof_kernel_replay_arena_resource_region_call_alloc_shape(node))
                or (node.kind == "resource-region-rebind-alloc" and proof_kernel_replay_arena_resource_region_binding_shape(node))
                or (node.kind == "resource-region-assign" and proof_kernel_replay_arena_resource_region_assignment_shape(node))
            )
            match node.kind:
                "resource-region-open" or "resource-region-close":
                    return (true, proof_kernel_replay_arena_resource_region_named_shape(node))
                "resource-region-alloc":
                    return (true, proof_kernel_replay_arena_resource_region_alloc_shape(node))
                "resource-region-bind":
                    return (true, proof_kernel_replay_arena_resource_region_extent_shape(node))
                "resource-region-alloc-discard":
                    return (true, proof_kernel_replay_arena_resource_region_discard_shape(node))
                "resource-region-call-alloc":
                    return (true, proof_kernel_replay_arena_resource_region_call_alloc_shape(node))
                "resource-region-return-alloc":
                    return (true, proof_kernel_replay_arena_resource_region_return_alloc_shape(node))
                "resource-region-rebind-alloc":
                    return (true, proof_kernel_replay_arena_resource_region_binding_shape(node))
                "resource-region-assign":
                    return (true, proof_kernel_replay_arena_resource_region_assignment_shape(node))
                _:
                    return (false, false)

        def proof_kernel_replay_arena_resource_event_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"resource-write", "resource-move", "resource-use", "resource-call-arg", "resource-call-formal"})
            ensure result.valid == (
                ((node.kind in {"resource-write", "resource-move", "resource-use"}) and node.operator == "" and node.right == 0 and node.auxiliary > 0 and node.auxiliary <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and node.name != "" and node.secondary_name == "")
                or (node.kind == "resource-call-arg" and (node.operator in {"value", "borrow", "reference", "region-new"}) and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and (node.operator == "region-new" and node.secondary_name != "" or node.operator != "region-new" and node.secondary_name == ""))
                or (node.kind == "resource-call-formal" and (node.operator in {"value", "external-shared", "external-mutable"}) and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "")
            )
            if node.kind in {"resource-write", "resource-move", "resource-use"}:
                return (true, node.operator == "" and node.right == 0 and node.auxiliary > 0 and node.auxiliary <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and node.children_start == 0 and node.children_count == 0 and node.value >= 0 and node.value <= 4294967295 and node.name != "" and node.secondary_name == "")
            if node.kind == "resource-call-arg":
                valid_operator: bool = node.operator in {"value", "borrow", "reference", "region-new"}
                return (true, valid_operator and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and (node.operator == "region-new" and node.secondary_name != "" or node.operator != "region-new" and node.secondary_name == ""))
            if node.kind == "resource-call-formal":
                valid_mode: bool = node.operator in {"value", "external-shared", "external-mutable"}
                return (true, valid_mode and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "")
            return (false, false)

        def proof_kernel_replay_resource_call_child_counts_valid(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return false if node.auxiliary > node.children_count
            return node.right == node.children_count - node.auxiliary

        def proof_kernel_replay_resource_call_lend_child_counts_valid(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return false if node.auxiliary >= PROOF_KERNEL_REPLAY_MAX_RESOURCE_CHILDREN
            return false if node.right > node.children_count
            return node.children_count - node.right == node.auxiliary * 2

        def proof_kernel_replay_arena_resource_call_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"resource-call-lend", "resource-call", "resource-call-region", "resource-call-result"})
            ensure result.valid == (
                (node.kind == "resource-call-lend" and node.operator == "" and node.left == 0 and proof_kernel_replay_resource_call_lend_child_counts_valid(node) and node.value >= 0 and node.value <= 4294967295 and node.name != "")
                or (node.kind == "resource-call" and node.operator == "" and proof_kernel_replay_resource_call_child_counts_valid(node) and node.value >= 0 and node.value <= 4294967295 and node.name != "")
                or (node.kind == "resource-call-region" and node.operator == "param" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != "")
                or (node.kind == "resource-call-result" and ((node.operator == "" and node.right == 0 and node.auxiliary <= PROOF_KERNEL_REPLAY_MAX_RESOURCE_FLAGS) or (node.operator == "sview" and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG + PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) or (node.operator == "value" and node.auxiliary <= PROOF_KERNEL_REPLAY_WRITABLE_FLAG)) and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != "")
            )
            if node.kind == "resource-call-lend":
                return (true, node.operator == "" and node.left == 0 and proof_kernel_replay_resource_call_lend_child_counts_valid(node) and node.value >= 0 and node.value <= 4294967295 and node.name != "")
            if node.kind == "resource-call":
                return (true, node.operator == "" and proof_kernel_replay_resource_call_child_counts_valid(node) and node.value >= 0 and node.value <= 4294967295 and node.name != "")
            if node.kind == "resource-call-region":
                return (true, node.operator == "param" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != "")
            if node.kind == "resource-call-result":
                reference_result: bool = node.operator == "" and node.right == 0 and node.auxiliary <= PROOF_KERNEL_REPLAY_MAX_RESOURCE_FLAGS
                sview_result: bool = node.operator == "sview" and node.auxiliary == PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG + PROOF_KERNEL_REPLAY_BORROWABLE_FLAG
                value_result: bool = node.operator == "value" and node.auxiliary <= PROOF_KERNEL_REPLAY_WRITABLE_FLAG
                return (true, (reference_result or sview_result or value_result) and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != "")
            return (false, false)

        def proof_kernel_replay_arena_resource_summary_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            # `resource-safety.value` is a parser byte offset; zero identifies a function that
            # begins at the first byte of the source file and is a valid owner position.
            ensure result.known == (node.kind in {"resource-scope", "resource-alternatives", "resource-join-move", "resource-safety", "resource-disjoint"})
            ensure result.valid == (
                (node.kind == "resource-scope" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "resource-alternatives" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_count > 0 and node.children_count <= PROOF_KERNEL_REPLAY_MAX_RESOURCE_CHILDREN and node.value == 0 and node.name == "" and node.secondary_name == "")
                or (node.kind == "resource-join-move" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary < PROOF_KERNEL_REPLAY_MAX_RESOURCE_JOIN_MOVES and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
                or (node.kind == "resource-safety" and node.operator == "resource-v2" and node.left == 0 and node.right > 0 and node.right <= 4294967295 and node.auxiliary < PROOF_KERNEL_REPLAY_MAX_RESOURCE_JOIN_MOVES and node.value >= 0 and node.value <= 4294967295 and node.name != "")
                or (node.kind == "resource-disjoint" and node.operator == "!=" and node.value == 0 and node.name == "" and node.secondary_name == "" and node.children_count <= PROOF_KERNEL_REPLAY_MAX_DISJOINT_WITNESSES)
            )
            if node.kind == "resource-scope":
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "resource-alternatives":
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_count > 0 and node.children_count <= PROOF_KERNEL_REPLAY_MAX_RESOURCE_CHILDREN and node.value == 0 and node.name == "" and node.secondary_name == "")
            if node.kind == "resource-join-move":
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary < PROOF_KERNEL_REPLAY_MAX_RESOURCE_JOIN_MOVES and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == "")
            if node.kind == "resource-safety":
                return (true, node.operator == "resource-v2" and node.left == 0 and node.right > 0 and node.right <= 4294967295 and node.auxiliary < PROOF_KERNEL_REPLAY_MAX_RESOURCE_JOIN_MOVES and node.value >= 0 and node.value <= 4294967295 and node.name != "")
            if node.kind == "resource-disjoint":
                return (true, node.operator == "!=" and node.value == 0 and node.name == "" and node.secondary_name == "" and node.children_count <= PROOF_KERNEL_REPLAY_MAX_DISJOINT_WITNESSES)
            return (false, false)

        def proof_kernel_replay_arena_resource_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (proof_kernel_replay_arena_resource_head_shape(node).known or proof_kernel_replay_arena_resource_tail_shape(node).known)
            ensure result.valid == (proof_kernel_replay_arena_resource_head_shape(node).valid or proof_kernel_replay_arena_resource_tail_shape(node).valid)
            head: (known: bool, valid: bool) = proof_kernel_replay_arena_resource_head_shape(node)
            return head if head.known
            return proof_kernel_replay_arena_resource_tail_shape(node)

        def proof_kernel_replay_arena_resource_head_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (proof_kernel_replay_arena_resource_binding_shape(node).known or proof_kernel_replay_arena_resource_region_shape(node).known)
            ensure result.valid == (proof_kernel_replay_arena_resource_binding_shape(node).valid or proof_kernel_replay_arena_resource_region_shape(node).valid)
            binding: (known: bool, valid: bool) = proof_kernel_replay_arena_resource_binding_shape(node)
            return binding if binding.known
            region: (known: bool, valid: bool) = proof_kernel_replay_arena_resource_region_shape(node)
            return region if region.known
            return (false, false)

        def proof_kernel_replay_arena_resource_tail_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (proof_kernel_replay_arena_resource_event_shape(node).known or proof_kernel_replay_arena_resource_call_shape(node).known or proof_kernel_replay_arena_resource_summary_shape(node).known)
            ensure result.valid == (proof_kernel_replay_arena_resource_event_shape(node).valid or proof_kernel_replay_arena_resource_call_shape(node).valid or proof_kernel_replay_arena_resource_summary_shape(node).valid)
            event: (known: bool, valid: bool) = proof_kernel_replay_arena_resource_event_shape(node)
            return event if event.known
            call: (known: bool, valid: bool) = proof_kernel_replay_arena_resource_call_shape(node)
            return call if call.known
            summary: (known: bool, valid: bool) = proof_kernel_replay_arena_resource_summary_shape(node)
            return summary if summary.known
            return (false, false)

        def proof_kernel_replay_arena_structural_shape(node: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, valid: bool):
            ensure result.known == (node.kind in {"structural-argument", "structural-edge", "structural-safety"})
            ensure result.valid == (
                (node.kind == "structural-argument" and ((node.operator == "same" and node.name == node.secondary_name and node.value == node.auxiliary) or (node.operator == "strict" and node.value != node.auxiliary)) and node.left == 0 and node.right == 0 and node.value > 0 and node.auxiliary > 0 and node.children_start == 0 and node.children_count == 0 and node.name != "" and node.secondary_name != "")
                or (node.kind == "structural-edge" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == node.children_count and node.children_count > 0 and node.value == 0 and node.name != "" and node.secondary_name != "")
                or (node.kind == "structural-safety" and node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_count > 0 and node.value == 0 and node.name != "" and node.secondary_name == "structural-v2")
            )
            if node.kind == "structural-argument":
                same: bool = node.operator == "same" and node.name == node.secondary_name and node.value == node.auxiliary
                strict: bool = node.operator == "strict" and node.value != node.auxiliary
                return (true, (same or strict) and node.left == 0 and node.right == 0 and node.value > 0 and node.auxiliary > 0 and node.children_start == 0 and node.children_count == 0 and node.name != "" and node.secondary_name != "")
            if node.kind == "structural-edge":
                return (true, node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == node.children_count and node.children_count > 0 and node.value == 0 and node.name != "" and node.secondary_name != "")
            if node.kind == "structural-safety":
                return (true, node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_count > 0 and node.value == 0 and node.name != "" and node.secondary_name == "structural-v2")
            return (false, false)

        def proof_kernel_replay_arena_shape_valid(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (
                (node.kind == "ident" and proof_kernel_replay_arena_scalar_shape_for_kind(node, 6).valid)
                or (node.kind == "binary" and proof_kernel_replay_arena_access_shape(node).valid)
                or (node.kind == "int" and proof_kernel_replay_arena_scalar_shape_for_kind(node, 1).valid)
                or (node.kind == "call" and proof_kernel_replay_arena_aggregate_shape(node).valid)
                or ((node.kind in {"frame-field", "frame-place", "frame-policy"}) and ElisaProofKernelFramePolicy::arena_shape(node))
                or (node.kind != "ident" and node.kind != "binary" and node.kind != "int" and node.kind != "call" and node.kind != "frame-field" and node.kind != "frame-place" and node.kind != "frame-policy" and proof_kernel_replay_arena_general_shape_valid(node))
            )
            # Replay validates nodes tens of millions of times per file, and identifiers, binary
            # operators, integers and calls are nearly all of them. Kind names are distinct, so
            # each shortcut selects exactly the validator the general chain below reaches.
            if node.kind == "ident":
                ident: (known: bool, valid: bool) = proof_kernel_replay_arena_scalar_shape_for_kind(node, 6)
                return ident.valid
            if node.kind == "binary":
                binary: (known: bool, valid: bool) = proof_kernel_replay_arena_access_shape(node)
                return binary.valid
            if node.kind == "int":
                integer: (known: bool, valid: bool) = proof_kernel_replay_arena_scalar_shape_for_kind(node, 1)
                return integer.valid
            if node.kind == "call":
                call: (known: bool, valid: bool) = proof_kernel_replay_arena_aggregate_shape(node)
                return call.valid
            if node.kind in {"frame-field", "frame-place", "frame-policy"}:
                return ElisaProofKernelFramePolicy::arena_shape(node)
            return proof_kernel_replay_arena_general_shape_valid(node)

        # The general chain behind the hot-kind shortcuts, kept apart so neither body carries every
        # validator's summary facts past the 64-fact analysis budget.
        def proof_kernel_replay_arena_general_shape_valid(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (
                (proof_kernel_replay_arena_scalar_shape(node).known and proof_kernel_replay_arena_scalar_shape(node).valid)
                or (not proof_kernel_replay_arena_scalar_shape(node).known and proof_kernel_replay_arena_simple_shape(node).known and proof_kernel_replay_arena_simple_shape(node).valid)
                or (not proof_kernel_replay_arena_scalar_shape(node).known and not proof_kernel_replay_arena_simple_shape(node).known and proof_kernel_replay_arena_late_shape_valid(node))
            )
            scalar: (known: bool, valid: bool) = proof_kernel_replay_arena_scalar_shape(node)
            return scalar.valid if scalar.known
            simple: (known: bool, valid: bool) = proof_kernel_replay_arena_simple_shape(node)
            return simple.valid if simple.known
            return proof_kernel_replay_arena_late_shape_valid(node)

        # The later half of the general chain, split for the same fact budget.
        def proof_kernel_replay_arena_late_shape_valid(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            ensure result == (
                (proof_kernel_replay_arena_aggregate_shape(node).known and proof_kernel_replay_arena_aggregate_shape(node).valid)
                or (not proof_kernel_replay_arena_aggregate_shape(node).known and proof_kernel_replay_arena_effect_shape(node).known and proof_kernel_replay_arena_effect_shape(node).valid)
                or (not proof_kernel_replay_arena_aggregate_shape(node).known and not proof_kernel_replay_arena_effect_shape(node).known and proof_kernel_replay_arena_resource_shape(node).known and proof_kernel_replay_arena_resource_shape(node).valid)
                or (not proof_kernel_replay_arena_aggregate_shape(node).known and not proof_kernel_replay_arena_effect_shape(node).known and not proof_kernel_replay_arena_resource_shape(node).known and proof_kernel_replay_arena_structural_shape(node).known and proof_kernel_replay_arena_structural_shape(node).valid)
            )
            aggregate: (known: bool, valid: bool) = proof_kernel_replay_arena_aggregate_shape(node)
            return aggregate.valid if aggregate.known
            effect: (known: bool, valid: bool) = proof_kernel_replay_arena_effect_shape(node)
            return effect.valid if effect.known
            resource: (known: bool, valid: bool) = proof_kernel_replay_arena_resource_shape(node)
            return resource.valid if resource.known
            structural: (known: bool, valid: bool) = proof_kernel_replay_arena_structural_shape(node)
            return structural.valid if structural.known
            return false
