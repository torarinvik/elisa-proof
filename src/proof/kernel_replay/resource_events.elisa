# Private resource-event replay submodule.
extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT: usize = 127

        def proof_kernel_replay_resource_sview_call_result[@nodes, @children, @state](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @nodes, children: mutable darray[usize]& @children, state: mutable ProofKernelReplayResourceState& @state, node: ElisaProofKernelCore::ProofKernelNode, previous_event: usize, arena_admitted: bool) -> bool:
            return false if node.operator != "sview" or node.auxiliary != PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG + PROOF_KERNEL_REPLAY_BORROWABLE_FLAG or node.right >= nodes.count
            sview_type: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
            return false if sview_type.kind != "ident" or sview_type.name != "sview" or sview_type.left != 0 or sview_type.right != 0 or sview_type.auxiliary != 0 or sview_type.children_start != 0 or sview_type.children_count != 0 or sview_type.value != 0 or sview_type.secondary_name != ""
            return false if not any prior_call in state.resource_call_events where prior_call == node.left
            return false if node.left != previous_event
            return false if any prior_result in state.resource_call_results where prior_result == node.left
            call_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
            return false if not call_located.known or call_located.node.kind != "resource-call" or call_located.node.name == ""
            call: ElisaProofKernelCore::ProofKernelNode = call_located.node
            return false if not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count) or call.auxiliary > call.children_count
            callee_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call.left)
            return false if not callee_located.known or callee_located.node.kind != "resource-safety"
            callee: ElisaProofKernelCore::ProofKernelNode = callee_located.node
            return false if not proof_kernel_replay_child_range_valid(callee.children_start, callee.children_count, children.count)

            summary_return: (known: bool, region: sview, formal: sview) = proof_kernel_replay_resource_sview_summary_return(nodes, children, call.left)
            return false if not summary_return.known
            returned_region: sview = summary_return.region
            returned_formal: sview = summary_return.formal

            mapped_region: mutable sview = ""
            for offset in call.auxiliary..<call.children_count |offset, call, children, nodes, returned_region, mapped_region|:
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + offset)
                return false if not child.known or child.value >= nodes.count
                region_map: ElisaProofKernelCore::ProofKernelNode = nodes[child.value]
                if region_map.kind == "resource-call-region" and region_map.name == returned_region:
                    return false if mapped_region != ""
                    mapped_region <- region_map.secondary_name
            return false if mapped_region == "" or mapped_region != node.secondary_name or not proof_kernel_replay_resource_region_active(state, mapped_region)

            returned_argument: mutable (known: bool, root: usize) = (false, nodes.count)
            for offset in 0..<call.auxiliary |offset, call, children, nodes, returned_formal, returned_argument|:
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + offset)
                return false if not child.known or child.value >= nodes.count
                argument: ElisaProofKernelCore::ProofKernelNode = nodes[child.value]
                return false if argument.kind != "resource-call-arg"
                if argument.name == returned_formal:
                    return false if returned_argument.known
                    returned_argument <- (true, child.value)
            return false if not returned_argument.known or returned_argument.root >= nodes.count
            return false if nodes[returned_argument.root].operator == "region-new"
            actual: (known: bool, place: ProofKernelReplayResourcePlace, slot: usize, has_slot: bool, mutable_reference: bool) = proof_kernel_replay_resource_call_actual(state, nodes, children, returned_argument.root, arena_admitted)
            return false if not actual.known or not actual.has_slot or actual.slot >= state.binding_names.count or not actual.place.whole or not proof_kernel_replay_resource_place_root_valid(nodes, actual.place)
            return false if actual.slot >= state.binding_moved.count or state.binding_moved[actual.slot]
            return false if actual.slot >= state.binding_region.count or state.binding_region[actual.slot] != mapped_region
            return false if actual.slot >= state.binding_region_live.count or not state.binding_region_live[actual.slot]
            target_slot: mutable usize = actual.slot
            target_place: mutable ProofKernelReplayResourcePlace = actual.place
            if actual.slot < state.borrow_present.count and state.borrow_present[actual.slot]:
                return false if actual.slot >= state.borrow_target_slots.count or actual.slot >= state.borrow_target_places.count
                target_slot <- state.borrow_target_slots[actual.slot]
                target_place <- state.borrow_target_places[actual.slot]
            return false if target_slot >= state.binding_region.count or target_slot >= state.binding_region_live.count
            return false if state.binding_region[target_slot] != mapped_region or not state.binding_region_live[target_slot]
            return false if not target_place.whole or not proof_kernel_replay_resource_place_root_valid(nodes, target_place)
            conflict_exception: usize = actual.slot if nodes[returned_argument.root].operator == "reference" else state.binding_names.count
            return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, target_place, conflict_exception)
            return false if not proof_kernel_replay_resource_binding_name_available(state, node.name)

            state.binding_names.push(node.name)
            state.binding_scope_depth.push(state.scope_depth)
            state.binding_reference.push(false)
            state.binding_mutable_reference.push(false)
            state.binding_writable.push(false)
            state.binding_borrowable.push(true)
            state.binding_moved.push(false)
            state.binding_region.push(mapped_region)
            state.binding_region_live.push(true)
            state.binding_region_owner.push(false)
            state.borrow_target_slots.push(target_slot)
            state.borrow_target_places.push(target_place)
            state.borrow_mutable.push(false)
            state.borrow_present.push(true)
            state.pending_join_moves.push(false)
            state.binding_origin_places.push(proof_kernel_replay_resource_empty_place())
            state.resource_call_results.push(node.left)
            return true

        def proof_kernel_replay_resource_events[@r, @e, @s](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, roots: darray[usize]&, state: mutable ProofKernelReplayResourceState& @s, effects: mutable darray[ProofKernelReplayResourceEffect]& @e, depth: usize, arena_admitted: bool) -> bool:
            requires depth <= PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT
            return false if depth >= PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT
            remaining: usize = PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT - depth
            return proof_kernel_replay_resource_events_remaining(nodes, children, roots, state, effects, depth, remaining, arena_admitted)

        def proof_kernel_replay_resource_events_remaining[@r, @e, @s](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, roots: darray[usize]&, state: mutable ProofKernelReplayResourceState& @s, effects: mutable darray[ProofKernelReplayResourceEffect]& @e, depth: usize, remaining: usize, arena_admitted: bool) -> bool:
            requires remaining > 0
            decreases remaining
            return false if depth >= PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT
            previous_event: mutable usize = nodes.count
            for root in roots |root, nodes, children, state, depth, remaining, arena_admitted, previous_event|:
                prior_event: usize = previous_event
                previous_event <- root
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
                return false if not located.known
                node: ElisaProofKernelCore::ProofKernelNode = located.node
                # A scope exit that consumed an inherited binding creates a mandatory parent
                # transition. Do not let a use, close, call, or another nested scope slip past it.
                return false if proof_kernel_replay_resource_has_pending_join(state) and node.kind != "resource-join-move"
                if node.kind == "resource-disjoint":
                    return false if node.operator != "!=" or node.left >= nodes.count or node.right >= nodes.count or node.auxiliary >= nodes.count
                    return false if not proof_kernel_replay_resource_index_expression_valid(nodes, node.left, 0) or not proof_kernel_replay_resource_index_expression_valid(nodes, node.right, 0)
                    goal_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.auxiliary)
                    return false if not goal_located.known or goal_located.node.kind != "binary" or goal_located.node.operator != "!=" or goal_located.node.left != node.left or goal_located.node.right != node.right
                    return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    proof_facts: mutable darray[usize] = []
                    for index in 0..<node.children_count |index, node, children, proof_facts|:
                        child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                        return false if not child.known or child.value >= nodes.count
                        proof_facts.push(child.value)
                    return false if not arena_admitted and not proof_kernel_replay_arena_valid(nodes, children, proof_facts, node.auxiliary)
                    return false if not proof_kernel_replay_proposition_state_valid(nodes, children, proof_facts, node.auxiliary)
                    return false if not proof_kernel_replay_goal_depth(nodes, children, proof_facts, node.auxiliary, 0, 0)
                    state.disjoint_left.push(node.left)
                    state.disjoint_right.push(node.right)
                    continue
                if node.kind == "resource-scope":
                    return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    child_roots: mutable darray[usize] = []
                    for index in 0..<node.children_count |index, node, children, child_roots|:
                        child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                        return false if not child.known
                        child_roots.push(child.value)
                    child_state: mutable ProofKernelReplayResourceState = proof_kernel_replay_resource_empty()
                    proof_kernel_replay_resource_copy(state, &child_state)
                    child_state.scope_depth <- state.scope_depth + 1
                    # Preserve region identity across the child snapshot. A same-named region
                    # opened after an inherited close is a fresh lifetime, not the parent's
                    # region, and must not be allowed to hide that close at the join boundary.
                    for inherited_region in state.active_regions |inherited_region, child_state|:
                        child_state.protected_regions.push(inherited_region) if not any prior in child_state.protected_regions where prior == inherited_region
                    return false if remaining <= 1
                    return false if not proof_kernel_replay_resource_events_remaining(nodes, children, child_roots, &child_state, effects, depth + 1, remaining - 1, arena_admitted)
                    return false if not proof_kernel_replay_resource_scope_preserves_parent(state, child_state)
                    for index in 0..<state.binding_moved.count |index, state, child_state|:
                        return false if index >= child_state.binding_moved.count or index >= state.pending_join_moves.count
                        state.pending_join_moves[index] <- true if not state.binding_moved[index] and child_state.binding_moved[index]
                    continue
                if node.kind == "resource-region-open":
                    return false if proof_kernel_replay_resource_region_active(state, node.name)
                    state.active_regions.push(node.name)
                    continue
                if node.kind == "resource-region-param":
                    return false if node.name == "" or proof_kernel_replay_resource_region_active(state, node.name)
                    state.active_regions.push(node.name)
                    state.external_regions.push(node.name)
                    continue
                if node.kind == "resource-sview-param":
                    return false if not proof_kernel_replay_resource_sview_parameter(nodes, state, node)
                    continue
                if node.kind == "resource-region-close":
                    return false if state.active_regions.count == 0
                    return false if state.active_regions[state.active_regions.count - 1] != node.name
                    return false if proof_kernel_replay_resource_region_external(state, node.name) or proof_kernel_replay_resource_region_protected(state, node.name)
                    return false if node.auxiliary == PROOF_KERNEL_REPLAY_EXPLICIT_REGION_DESTROY and proof_kernel_replay_resource_region_has_live_borrow(state, node.name)
                    state.active_regions <- state.active_regions.truncate(state.active_regions.count - 1)
                    proof_kernel_replay_resource_invalidate_region_bindings(state, node.name)
                    continue
                if node.kind == "resource-region-alloc":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not arena_admitted and not proof_kernel_replay_arena_valid(nodes, children, [], node.left)
                    return false if not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                    return false if not proof_kernel_replay_resource_binding_name_available(state, node.name)
                    state.binding_names.push(node.name)
                    state.binding_scope_depth.push(state.scope_depth)
                    state.binding_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) != 0)
                    state.binding_mutable_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0)
                    state.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
                    state.binding_borrowable.push((node.auxiliary & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) != 0)
                    state.binding_moved.push(false)
                    state.binding_region.push(node.secondary_name)
                    state.binding_region_live.push(true)
                    state.binding_region_owner.push(true)
                    state.borrow_target_slots.push(state.binding_names.count - 1)
                    state.borrow_target_places.push(proof_kernel_replay_resource_empty_place())
                    state.borrow_mutable.push(false)
                    state.borrow_present.push(false)
                    state.pending_join_moves.push(false)
                    state.binding_origin_places.push(proof_kernel_replay_resource_empty_place())
                    continue
                if node.kind == "resource-region-alloc-discard":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not arena_admitted and not proof_kernel_replay_arena_valid(nodes, children, [], node.left)
                    return false if not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                    continue
                if node.kind == "resource-region-return-alloc":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not arena_admitted and not proof_kernel_replay_arena_valid(nodes, children, [], node.left)
                    return false if not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                    return false if not proof_kernel_replay_resource_region_external(state, node.secondary_name)
                    state.resource_return_alloc_regions.push(node.secondary_name)
                    state.resource_return_witnesses.push(root)
                    continue
                if node.kind == "resource-region-call-alloc":
                    # A call temporary is a real allocation in the caller's active region, but
                    # it is intentionally not installed as a named binding. The call transition
                    # must consume this exact event before any callee effect is accepted.
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not arena_admitted and not proof_kernel_replay_arena_valid(nodes, children, [], node.left)
                    return false if not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                    state.resource_call_allocations.push(root)
                    continue
                if node.kind == "resource-region-return":
                    return false if any used_witness in state.resource_return_witnesses_used where used_witness == node.left
                    if node.name == "":
                        # A region-less reference return: see resource_call_returns.elisa.
                        if node.operator == "param-call":
                            return false if not proof_kernel_replay_resource_reference_call_return(nodes, children, state, node, prior_event, arena_admitted)
                        else:
                            return false if not proof_kernel_replay_resource_regionless_return(nodes, state, node)
                        state.resource_return_witnesses_used.push(node.left)
                        continue
                    return false if not proof_kernel_replay_resource_region_external(state, node.name) or not proof_kernel_replay_resource_region_active(state, node.name)
                    if node.operator == "sview-call" or node.operator == "param-call":
                        return false if not proof_kernel_replay_resource_region_call_return(nodes, children, state, node, prior_event, arena_admitted)
                        state.resource_return_witnesses_used.push(node.left)
                        continue
                    return false if not any witness in state.resource_return_witnesses where witness == node.left
                    witness: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                    return false if not witness.known
                    is_sview_return: bool = node.operator == "sview"
                    if is_sview_return:
                        return false if node.auxiliary != PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG or node.right >= nodes.count
                        sview_type: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                        return false if sview_type.kind != "ident" or sview_type.name != "sview" or sview_type.left != 0 or sview_type.right != 0 or sview_type.auxiliary != 0 or sview_type.children_start != 0 or sview_type.children_count != 0 or sview_type.value != 0 or sview_type.secondary_name != ""
                    if witness.node.kind == "resource-region-return-alloc":
                        return false if is_sview_return
                        return false if witness.node.secondary_name != node.name
                    elif witness.node.kind == "resource-use":
                        return false if witness.node.name == ""
                        witness_slot: usize = proof_kernel_replay_resource_lookup(state, witness.node.name)
                        return false if witness_slot >= state.binding_names.count
                        return false if proof_kernel_replay_resource_binding_region(state, witness_slot) != node.name
                        return false if not proof_kernel_replay_resource_binding_region_is_live(state, witness_slot)
                        return false if witness_slot >= state.binding_moved.count
                        return false if state.binding_moved[witness_slot]
                        if not is_sview_return:
                            # A returned reference capability must originate in a reference
                            # binding and preserve its pointee mutability. A returned sview is a
                            # shared by-value borrow, so its witness may be an owner or a reference.
                            return false if witness_slot >= state.binding_reference.count or not state.binding_reference[witness_slot]
                            witness_mutable: bool = witness_slot < state.binding_mutable_reference.count and state.binding_mutable_reference[witness_slot]
                            return false if (node.auxiliary == 1) != witness_mutable
                    else:
                        return false
                    state.resource_return_witnesses_used.push(node.left)
                    continue
                if node.kind == "resource-region-rebind-alloc":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not arena_admitted and not proof_kernel_replay_arena_valid(nodes, children, [], node.left)
                    return false if not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                    target_slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if target_slot >= state.binding_names.count or target_slot >= state.binding_moved.count or state.binding_moved[target_slot]
                    return false if not proof_kernel_replay_resource_binding_is_writable(state, target_slot)
                    return false if target_slot >= state.borrow_present.count or state.borrow_present[target_slot]
                    target_place: ProofKernelReplayResourcePlace = ProofKernelReplayResourcePlace{has_root: node.name != "", root_node: root, path_root: 0, depth: 0, whole: true}
                    return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, target_place, state.binding_names.count)
                    state.binding_region[target_slot] <- node.secondary_name
                    state.binding_region_live[target_slot] <- true
                    state.binding_region_owner[target_slot] <- true
                    continue
                if node.kind == "resource-region-bind":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    is_sview_borrow: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) != 0
                    if is_sview_borrow:
                        return false if node.auxiliary != PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG + PROOF_KERNEL_REPLAY_BORROWABLE_FLAG
                        return false if node.right >= nodes.count
                        sview_type: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                        return false if sview_type.kind != "ident" or sview_type.name != "sview" or sview_type.left != 0 or sview_type.right != 0 or sview_type.auxiliary != 0 or sview_type.children_start != 0 or sview_type.children_count != 0 or sview_type.value != 0 or sview_type.secondary_name != ""
                        return false if (node.auxiliary & (PROOF_KERNEL_REPLAY_REFERENCE_FLAG + PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG + PROOF_KERNEL_REPLAY_WRITABLE_FLAG)) != 0
                    source: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not source.known
                    # The event format stores no path for the new alias. Reject a field/index
                    # source rather than widening it to a whole-root capability.
                    return false if not source.place.whole
                    source_slot: usize = proof_kernel_replay_resource_lookup_place(state, nodes, source.place)
                    return false if source_slot >= state.binding_names.count or proof_kernel_replay_resource_binding_region(state, source_slot) != node.secondary_name
                    return false if not proof_kernel_replay_resource_binding_region_is_live(state, source_slot) or not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    source_is_reference: bool = source_slot < state.binding_reference.count and state.binding_reference[source_slot]
                    source_is_mutable_reference: bool = source_slot < state.binding_mutable_reference.count and state.binding_mutable_reference[source_slot]
                    source_region_owner: bool = source_slot < state.binding_region_owner.count and state.binding_region_owner[source_slot]
                    requested_reference: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) != 0
                    requested_mutable_reference: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0
                    borrow_target_slot: mutable usize = source_slot
                    borrow_target_place: mutable ProofKernelReplayResourcePlace = source.place
                    borrow_overlap_except: mutable usize = state.binding_names.count
                    if is_sview_borrow:
                        if source_slot < state.borrow_present.count and state.borrow_present[source_slot]:
                            return false if source_slot >= state.borrow_target_slots.count or source_slot >= state.borrow_target_places.count
                            borrow_target_slot <- state.borrow_target_slots[source_slot]
                            borrow_target_place <- state.borrow_target_places[source_slot]
                            borrow_overlap_except <- source_slot
                        elif not source_region_owner:
                            return false if not source_is_reference
                        return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, borrow_target_place, borrow_overlap_except)
                        return false if borrow_target_slot >= state.binding_names.count or borrow_target_slot >= state.binding_region.count or state.binding_region[borrow_target_slot] != node.secondary_name or borrow_target_slot >= state.binding_region_live.count or not state.binding_region_live[borrow_target_slot] or not proof_kernel_replay_resource_place_root_valid(nodes, borrow_target_place)
                    # A region alias preserves the source's reference category. A direct region
                    # allocation may be exposed as a mutable reference, but an external or
                    # borrowed mutable reference may not be copied into another mutable alias:
                    # there is no owner token to transfer, so doing so would duplicate a write
                    # capability. Moving a direct owner also requires that no live borrow overlaps
                    # its whole place.
                    return false if not is_sview_borrow and requested_reference != source_is_reference
                    return false if not is_sview_borrow and requested_reference and requested_mutable_reference != source_is_mutable_reference and not source_region_owner
                    return false if requested_mutable_reference and not requested_reference
                    return false if source_slot >= state.binding_moved.count or state.binding_moved[source_slot]
                    return false if not is_sview_borrow and source_is_reference and source_is_mutable_reference and not source_region_owner
                    return false if not is_sview_borrow and source_region_owner and proof_kernel_replay_resource_has_borrow_overlap(nodes, state, source.place, state.binding_names.count)
                    return false if not proof_kernel_replay_resource_binding_name_available(state, node.name)
                    state.binding_names.push(node.name)
                    state.binding_scope_depth.push(state.scope_depth)
                    state.binding_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) != 0)
                    state.binding_mutable_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0)
                    state.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
                    state.binding_borrowable.push((node.auxiliary & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) != 0)
                    state.binding_moved.push(false)
                    state.binding_region.push(node.secondary_name)
                    state.binding_region_live.push(true)
                    state.binding_region_owner.push(source_region_owner and not is_sview_borrow)
                    state.borrow_target_slots.push(borrow_target_slot if is_sview_borrow else state.binding_names.count - 1)
                    state.borrow_target_places.push(borrow_target_place if is_sview_borrow else proof_kernel_replay_resource_empty_place())
                    state.borrow_mutable.push(false)
                    state.borrow_present.push(is_sview_borrow)
                    state.pending_join_moves.push(false)
                    state.binding_origin_places.push(proof_kernel_replay_resource_empty_place())
                    state.binding_moved[source_slot] <- true if source_region_owner and not is_sview_borrow
                    continue
                if node.kind == "resource-region-assign":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    source: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not source.known
                    source_slot: usize = proof_kernel_replay_resource_lookup_place(state, nodes, source.place)
                    target_slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if source_slot >= state.binding_names.count or target_slot >= state.binding_names.count
                    # The assignment event stores no source path. Reject a field/index source
                    # rather than assigning its lifetime to an unrelated whole binding.
                    return false if not source.place.whole
                    return false if proof_kernel_replay_resource_binding_region(state, source_slot) != node.secondary_name
                    return false if not proof_kernel_replay_resource_binding_region_is_live(state, source_slot)
                    return false if source_slot >= state.binding_moved.count or state.binding_moved[source_slot]
                    return false if target_slot >= state.binding_moved.count or state.binding_moved[target_slot]
                    return false if not proof_kernel_replay_resource_binding_is_writable(state, target_slot)
                    return false if target_slot < state.borrow_present.count and state.borrow_present[target_slot]
                    target_place: ProofKernelReplayResourcePlace = ProofKernelReplayResourcePlace{has_root: node.name != "", root_node: root, path_root: 0, depth: 0, whole: true}
                    return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, target_place, state.binding_names.count)
                    source_region_owner: bool = source_slot < state.binding_region_owner.count and state.binding_region_owner[source_slot]
                    state.binding_region[target_slot] <- node.secondary_name
                    state.binding_region_live[target_slot] <- true
                    state.binding_region_owner[target_slot] <- source_region_owner
                    # A region-owner assignment transfers the exclusive token. Preserve
                    # self-assignment as a no-op, but consume a distinct source owner.
                    state.binding_moved[source_slot] <- true if source_region_owner and source_slot != target_slot
                    continue
                if node.kind == "resource-bind":
                    is_reference: bool = node.operator == "shared" or node.operator == "mutable" or node.operator == "external-shared" or node.operator == "external-mutable"
                    is_mutable_reference: bool = node.operator == "mutable" or node.operator == "external-mutable"
                    target_slot: mutable usize = state.binding_names.count
                    borrow_is_present: mutable bool = false
                    source_place: mutable ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                    origin_place: mutable ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                    if node.operator == "shared" or node.operator == "mutable":
                        target_slot <- proof_kernel_replay_resource_lookup(state, node.secondary_name)
                        return false if target_slot >= state.binding_names.count
                        return false if target_slot >= state.binding_moved.count or state.binding_moved[target_slot]
                        source_region: sview = proof_kernel_replay_resource_binding_region(state, target_slot)
                        return false if source_region != "" and (not proof_kernel_replay_resource_binding_region_is_live(state, target_slot) or not proof_kernel_replay_resource_region_active(state, source_region))
                        decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                        return false if not decoded.known or not proof_kernel_replay_resource_place_root_matches(nodes, decoded.place, node.secondary_name)
                        source_place <- decoded.place
                        borrow_is_present <- true
                        if node.operator == "mutable":
                            return false if node.auxiliary != 1
                            return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, source_place, state.binding_names.count)
                        else:
                            return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, source_place, state.binding_names.count)
                        source_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(nodes, state, target_slot)
                        if source_origin.known:
                            composed: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place_append(nodes, source_origin.place, source_place)
                            origin_place <- composed.place if composed.known
                    elif node.operator == "external-shared" or node.operator == "external-mutable":
                        origin_place <- ProofKernelReplayResourcePlace{has_root: node.name != "", root_node: root, path_root: 0, depth: 0, whole: true}
                    external_region: sview = node.secondary_name if node.operator == "external-shared" or node.operator == "external-mutable" else ""
                    return false if external_region != "" and not proof_kernel_replay_resource_region_active(state, external_region)
                    return false if not proof_kernel_replay_resource_binding_name_available(state, node.name)
                    state.binding_names.push(node.name)
                    state.binding_scope_depth.push(state.scope_depth)
                    state.binding_reference.push(is_reference)
                    state.binding_mutable_reference.push(is_mutable_reference)
                    state.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
                    state.binding_borrowable.push((node.auxiliary & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) != 0)
                    state.binding_moved.push(false)
                    # `proof_kernel_replay_resource_binding_region` is a bounds-checked read that
                    # returns "" outside the table, so evaluating it unconditionally is the same
                    # value the guarded arm would have produced, and it gives the call the
                    # statement boundary a conditional expression does not.
                    borrowed_region_value: sview = proof_kernel_replay_resource_binding_region(state, target_slot)
                    inherited_region: sview = borrowed_region_value if borrow_is_present else external_region
                    state.binding_region.push(inherited_region)
                    state.binding_region_live.push(inherited_region != "")
                    state.binding_region_owner.push(false)
                    state.borrow_target_slots.push(target_slot)
                    state.borrow_target_places.push(source_place)
                    state.borrow_mutable.push(is_mutable_reference)
                    state.borrow_present.push(borrow_is_present)
                    state.pending_join_moves.push(false)
                    state.binding_origin_places.push(origin_place)
                    continue
                if node.kind == "resource-use":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not decoded.known or not decoded.place.whole or not proof_kernel_replay_resource_place_root_matches(nodes, decoded.place, node.name)
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.binding_names.count
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if region != "" and (not proof_kernel_replay_resource_binding_region_is_live(state, slot) or not proof_kernel_replay_resource_region_active(state, region))
                    return false if slot >= state.binding_moved.count or state.binding_moved[slot]
                    state.resource_return_witnesses.push(root)
                    continue
                if node.kind == "resource-write":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not decoded.known or not proof_kernel_replay_resource_place_root_matches(nodes, decoded.place, node.name)
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.binding_names.count
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if region != "" and (not proof_kernel_replay_resource_binding_region_is_live(state, slot) or not proof_kernel_replay_resource_region_active(state, region))
                    return false if slot >= state.binding_moved.count or state.binding_moved[slot]
                    is_reference: bool = slot < state.binding_reference.count and state.binding_reference[slot]
                    is_mutable_reference: bool = slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot]
                    return false if is_reference and not is_mutable_reference
                    return false if decoded.place.whole and not proof_kernel_replay_resource_binding_is_writable(state, slot)
                    borrow_except_slot: usize = slot if is_reference and is_mutable_reference else state.binding_names.count
                    return false if (not is_reference or is_mutable_reference) and proof_kernel_replay_resource_has_borrow_overlap(nodes, state, decoded.place, borrow_except_slot)
                    resolved_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_resolve_origin(nodes, state, decoded.place, node.name)
                    effects.push(ProofKernelReplayResourceEffect{kind: "write", place: resolved_origin.place}) if resolved_origin.known
                    continue
                if node.kind == "resource-move":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not decoded.known or not proof_kernel_replay_resource_place_root_matches(nodes, decoded.place, node.name)
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.binding_names.count
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if region != "" and (not proof_kernel_replay_resource_binding_region_is_live(state, slot) or not proof_kernel_replay_resource_region_active(state, region))
                    return false if slot >= state.binding_moved.count or state.binding_moved[slot]
                    return false if slot < state.borrow_present.count and state.borrow_present[slot]
                    return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, decoded.place, state.binding_names.count)
                    resolved_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_resolve_origin(nodes, state, decoded.place, node.name)
                    effects.push(ProofKernelReplayResourceEffect{kind: "move", place: resolved_origin.place}) if resolved_origin.known
                    state.binding_moved[slot] <- true
                    continue
                if node.kind == "resource-join-move":
                    slot: usize = node.auxiliary
                    return false if slot >= state.binding_names.count or slot >= state.pending_join_moves.count
                    return false if state.binding_names[slot] != node.name or not state.pending_join_moves[slot]
                    return false if slot >= state.binding_moved.count or state.binding_moved[slot]
                    state.pending_join_moves[slot] <- false
                    state.binding_moved[slot] <- true
                    continue
                if node.kind == "resource-call-result":
                    return false if node.left != prior_event
                    if node.operator == "sview":
                        return false if not proof_kernel_replay_resource_sview_call_result(nodes, children, state, node, prior_event, arena_admitted)
                        continue
                    return false if not any prior_call in state.resource_call_events where prior_call == node.left
                    return false if any prior_result in state.resource_call_results where prior_result == node.left
                    call_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                    return false if not call_located.known or call_located.node.kind != "resource-call" or call_located.node.name == ""
                    call: ElisaProofKernelCore::ProofKernelNode = call_located.node
                    return false if not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count)
                    callee_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call.left)
                    return false if not callee_located.known or callee_located.node.kind != "resource-safety"
                    return false if not proof_kernel_replay_child_range_valid(callee_located.node.children_start, callee_located.node.children_count, children.count)
                    # The callee summary names the returned formal (directly or through its own
                    # replayed call-return marker) or a fresh allocation; see resource_call_returns.
                    summary_return: (known: bool, region: sview, formal: sview, mutable_reference: bool, allocation: bool) = proof_kernel_replay_resource_reference_summary_return(nodes, children, call.left)
                    return false if not summary_return.known
                    returned_region: sview = summary_return.region
                    returned_mutable: bool = summary_return.mutable_reference
                    returned_formal: sview = summary_return.formal
                    returned_allocation: bool = summary_return.allocation
                    return false if returned_region == ""
                    mapped_region: mutable sview = ""
                    for call_child_index in call.auxiliary..<call.children_count |call_child_index, call, children, nodes, returned_region, mapped_region|:
                        call_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + call_child_index)
                        return false if not call_child.known
                        call_child_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call_child.value)
                        return false if not call_child_node.known
                        if call_child_node.node.kind == "resource-call-region" and call_child_node.node.name == returned_region:
                            return false if mapped_region != ""
                            mapped_region <- call_child_node.node.secondary_name
                    return false if mapped_region == "" or mapped_region != node.secondary_name or not proof_kernel_replay_resource_region_active(state, mapped_region)
                    return false if (node.auxiliary & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) == 0
                    return false if ((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0) != returned_mutable
                    return false if not proof_kernel_replay_resource_binding_name_available(state, node.name)
                    result_alias: mutable bool = false
                    result_source_slot: mutable usize = state.binding_names.count
                    result_source_place: mutable ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                    result_owner: mutable bool = returned_allocation
                    if returned_formal != "":
                        returned_argument: mutable (known: bool, root: usize) = (false, nodes.count)
                        for call_child_index in 0..<call.auxiliary |call_child_index, call, children, nodes, returned_formal, returned_argument, arena_admitted|:
                            call_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + call_child_index)
                            return false if not call_child.known
                            return false if call_child.value >= nodes.count
                            return false if nodes[call_child.value].kind != "resource-call-arg"
                            if nodes[call_child.value].name == returned_formal:
                                return false if returned_argument.known
                                returned_argument <- (true, call_child.value)
                        return false if not returned_argument.known
                        return false if returned_argument.root >= nodes.count
                        return false if nodes[returned_argument.root].operator != "borrow" and nodes[returned_argument.root].operator != "reference" and nodes[returned_argument.root].operator != "region-new"
                        actual: (known: bool, place: ProofKernelReplayResourcePlace, slot: usize, has_slot: bool, mutable_reference: bool) = proof_kernel_replay_resource_call_actual(state, nodes, children, returned_argument.root, arena_admitted)
                        return false if not actual.known
                        if nodes[returned_argument.root].operator != "region-new":
                            return false if not proof_kernel_replay_resource_place_root_valid(nodes, actual.place)
                            result_alias <- true
                            result_source_slot <- actual.slot
                            result_source_place <- actual.place
                            if (node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0:
                                return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, actual.place, actual.slot if nodes[returned_argument.root].operator == "reference" else state.binding_names.count)
                            else:
                                return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, actual.place, actual.slot if nodes[returned_argument.root].operator == "reference" else state.binding_names.count)
                            if nodes[returned_argument.root].operator == "reference":
                                return false if not actual.has_slot or actual.slot >= state.binding_moved.count or state.binding_moved[actual.slot]
                                result_owner <- actual.slot < state.binding_region_owner.count and state.binding_region_owner[actual.slot]
                                state.binding_moved[actual.slot] <- true
                        else:
                            # A returned reference backed by a call-local `new[r]` temporary
                            # transfers that fresh allocation's owner to the caller result.
                            result_owner <- true
                    state.binding_names.push(node.name)
                    state.binding_scope_depth.push(state.scope_depth)
                    state.binding_reference.push(true)
                    state.binding_mutable_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0)
                    state.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
                    state.binding_borrowable.push(false)
                    state.binding_moved.push(false)
                    state.binding_region.push(node.secondary_name)
                    state.binding_region_live.push(true)
                    state.binding_region_owner.push(result_owner)
                    # Bound first, for the same reason: a call inside a conditional expression has
                    # no statement boundary either. `proof_kernel_replay_resource_empty_place` is a
                    # constructor over no state, so evaluating it once and unconditionally is the
                    # same value both arms would have produced.
                    result_empty_place: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                    state.borrow_target_slots.push(result_source_slot if result_alias else state.binding_names.count - 1)
                    state.borrow_target_places.push(result_source_place if result_alias else result_empty_place)
                    state.borrow_mutable.push((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0 if result_alias else false)
                    state.borrow_present.push(result_alias)
                    state.pending_join_moves.push(false)
                    state.binding_origin_places.push(result_source_place if result_alias else result_empty_place)
                    state.resource_call_results.push(node.left)
                    continue
                if node.kind == "resource-call-lend":
                    # No callee summary is consulted: the transition is derived from the callee's
                    # declared parameter modes alone. A shared formal changes nothing. An
                    # exclusive formal is over-approximated by a write to the whole lent place,
                    # which subsumes every effect any callee summary could have exported — the
                    # summary composer accepts writes rooted at a mutable formal and nothing else.
                    return false if not proof_kernel_replay_resource_lend(nodes, children, state, effects, root)
                    return false if any prior_call in state.resource_call_events where prior_call == root
                    state.resource_call_events.push(root)
                    continue
                if node.kind == "resource-call":
                    return false if any prior_call in state.resource_call_events where prior_call == root
                    return false if remaining <= 1
                    return false if not proof_kernel_replay_resource_call_remaining(nodes, children, state, effects, node, depth + 1, remaining - 1, arena_admitted)
                    for call_child_index in 0..<node.children_count |call_child_index, node, children, nodes, state|:
                        call_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + call_child_index)
                        return false if not call_child.known
                        call_argument: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call_child.value)
                        return false if not call_argument.known
                        if call_argument.node.kind == "resource-call-arg" and call_argument.node.operator == "region-new":
                            return false if any prior_allocation in state.resource_call_allocations_used where prior_allocation == call_argument.node.left
                            return false if not any allocation in state.resource_call_allocations where allocation == call_argument.node.left
                            state.resource_call_allocations_used.push(call_argument.node.left)
                    state.resource_call_events.push(root)
                    continue
                return false
            return false if proof_kernel_replay_resource_has_pending_join(state)
            return true
