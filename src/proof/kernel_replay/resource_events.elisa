# Private resource-event replay submodule.
extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT: usize = 127

        def proof_kernel_replay_resource_events[@r, @e, @s](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, roots: darray[usize]&, state: mutable ProofKernelReplayResourceState& @s, effects: mutable darray[ProofKernelReplayResourceEffect]& @e, depth: usize, arena_admitted: bool) -> bool can[Global{Read,Write}]:
            requires depth <= PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT
            return false if depth >= PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT
            remaining: usize = PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT - depth
            return (proof_kernel_replay_resource_events_remaining(nodes, children, roots, state, effects, depth, remaining, arena_admitted, false) can Global{Read,Write})

        # Only a resource-alternatives arm may return with pending moves: its enclosing
        # alternative node unions those per-arm masks, and the parent must consume them with
        # explicit resource-join-move events. Public, scope, and callee boundaries pass false.
        def proof_kernel_replay_resource_events_remaining[@r, @e, @s](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, roots: darray[usize]&, state: mutable ProofKernelReplayResourceState& @s, effects: mutable darray[ProofKernelReplayResourceEffect]& @e, depth: usize, remaining: usize, arena_admitted: bool, allow_boundary_pending_join: bool) -> bool can[Global{Read,Write}]:
            requires remaining > 0
            decreases remaining
            return false if depth >= PROOF_KERNEL_REPLAY_RESOURCE_EVENT_DEPTH_LIMIT
            previous_event: mutable usize = nodes.count
            for root in roots |root, nodes, children, state, depth, remaining, arena_admitted, previous_event|:
                return false if not proof_kernel_replay_resource_charge_work(state, 1)
                prior_event: usize = previous_event
                previous_event <- root
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
                return false if not located.known
                node: ElisaProofKernelCore::ProofKernelNode = located.node
                return false if not proof_kernel_replay_resource_charge_node_text(state, node)
                # A scope exit with a consumed inherited binding must be followed by its parent transition.
                return false if proof_kernel_replay_resource_has_pending_join(state) and node.kind != "resource-join-move"
                if node.kind == "resource-disjoint":
                    return false if node.operator != "!="
                    return false if node.left >= nodes.count or node.right >= nodes.count or node.auxiliary >= nodes.count
                    return false if not proof_kernel_replay_resource_index_expression_valid(state, nodes, node.left, 0)
                    return false if not proof_kernel_replay_resource_index_expression_valid(state, nodes, node.right, 0)
                    goal_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.auxiliary)
                    return false if:
                        not goal_located.known or goal_located.node.kind != "binary" or goal_located.node.operator != "!=" or goal_located.node.left != node.left or goal_located.node.right != node.right
                        not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    proof_facts: mutable darray[usize] = []
                    for index in 0..<node.children_count |index, node, children, proof_facts, state|:
                        return false if not proof_kernel_replay_resource_charge_work(state, 1)
                        child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                        return false if not child.known or child.value >= nodes.count
                        return false if not proof_kernel_replay_resource_charge_work(state, 2)
                        proof_facts.push(child.value)
                    return false if:
                        not arena_admitted and not (proof_kernel_replay_arena_valid(nodes, children, proof_facts, node.auxiliary) can Global{Read,Write})
                        not proof_kernel_replay_proposition_state_valid_with_goal_work(nodes, children, proof_facts, node.auxiliary, state.scope.goal_work_used)
                        not (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, proof_facts, node.auxiliary, 0, 0, &state.scope.goal_work_used, remaining: ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT) can Global{Read,Write}) or state.scope.goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return false if not proof_kernel_replay_resource_charge_work(state, 4)
                    state.scope.disjoint_left.push(node.left)
                    state.scope.disjoint_right.push(node.right)
                    continue
                if node.kind == "resource-scope":
                    return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    child_roots: mutable darray[usize] = []
                    for index in 0..<node.children_count |index, node, children, child_roots, state|:
                        return false if not proof_kernel_replay_resource_charge_work(state, 1)
                        child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                        return false if not child.known
                        return false if not proof_kernel_replay_resource_charge_work(state, 2)
                        child_roots.push(child.value)
                    child_state: mutable ProofKernelReplayResourceState = proof_kernel_replay_resource_empty()
                    return false if not proof_kernel_replay_resource_copy(state, &child_state)
                    child_state.scope.scope_depth <- state.scope.scope_depth + 1
                    # Preserve region identity across the child snapshot. A same-named region
                    # opened after an inherited close is a fresh lifetime, not the parent's
                    # region, and must not be allowed to hide that close at the join boundary.
                    for inherited_region in state.regions.active_regions |inherited_region, child_state|:
                        return false if not proof_kernel_replay_resource_charge_work(&child_state, 1)
                        already_protected: mutable bool = false
                        protected_region_count: usize = child_state.regions.protected_regions.count
                        for prior_index in 0..<protected_region_count |prior_index, child_state, inherited_region, already_protected|:
                            return false if prior_index >= child_state.regions.protected_regions.count
                            prior: sview = child_state.regions.protected_regions[prior_index]
                            return false if not proof_kernel_replay_resource_charge_text_pair(&child_state, prior, inherited_region)
                            if prior == inherited_region:
                                already_protected <- true
                                break
                        if not already_protected:
                            return false if not proof_kernel_replay_resource_charge_work(&child_state, 2)
                            child_state.regions.protected_regions.push(inherited_region)
                    return false if:
                        remaining <= 1
                        not (proof_kernel_replay_resource_events_remaining(nodes, children, child_roots, &child_state, effects, depth + 1, remaining - 1, arena_admitted, false) can Global{Read,Write})
                    state.scope.resource_work_used <- child_state.scope.resource_work_used
                    state.scope.goal_work_used <- child_state.scope.goal_work_used
                    return false if not proof_kernel_replay_resource_scope_preserves_parent(state, child_state)
                    for index in 0..<state.bindings.binding_moved.count |index, state, child_state|:
                        return false if not proof_kernel_replay_resource_charge_work(state, 1)
                        return false if index >= child_state.bindings.binding_moved.count
                        return false if index >= state.scope.pending_join_moves.count
                        state.scope.pending_join_moves[index] <- true if not state.bindings.binding_moved[index] and child_state.bindings.binding_moved[index]
                    continue
                if node.kind == "resource-alternatives":
                    return false if node.children_count == 0 or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    alternative_baseline: mutable ProofKernelReplayResourceState = proof_kernel_replay_resource_empty()
                    alternative_history: mutable ProofKernelReplayResourceState = proof_kernel_replay_resource_empty()
                    return false if:
                        not proof_kernel_replay_resource_copy(state, &alternative_baseline)
                        not proof_kernel_replay_resource_copy(state, &alternative_history)
                    first_alternative: mutable bool = true
                    for arm_index in 0..<node.children_count |arm_index, node, children, nodes, state, effects, depth, remaining, arena_admitted, alternative_history, alternative_baseline, first_alternative|:
                        return false if not proof_kernel_replay_resource_charge_work(state, 1)
                        arm_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + arm_index)
                        return false if not arm_child.known or arm_child.value >= nodes.count
                        arm_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, arm_child.value)
                        return false if not arm_node.known or arm_node.node.kind != "resource-scope"
                        arm_state: mutable ProofKernelReplayResourceState = proof_kernel_replay_resource_empty()
                        return false if not proof_kernel_replay_resource_copy(state, &arm_state)
                        for slot in 0..<arm_state.scope.pending_join_moves.count |slot, arm_state|:
                            return false if not proof_kernel_replay_resource_charge_work(&arm_state, 1)
                            return false if slot >= arm_state.bindings.binding_moved.count
                            arm_state.scope.pending_join_moves[slot] <- false
                        return false if not proof_kernel_replay_resource_charge_work(&arm_state, 2)
                        arm_roots: darray[usize] = [arm_child.value]
                        return false if:
                            remaining <= 1
                            not (proof_kernel_replay_resource_events_remaining(nodes, children, arm_roots, &arm_state, effects, depth + 1, remaining - 1, arena_admitted, true) can Global{Read,Write})
                        state.scope.resource_work_used <- arm_state.scope.resource_work_used
                        state.scope.goal_work_used <- arm_state.scope.goal_work_used
                        return false if not proof_kernel_replay_resource_scope_event_history_merge_alternative(&alternative_history, &alternative_baseline, &arm_state, &state.scope.resource_work_used, first_alternative)
                        first_alternative <- false
                        for slot in 0..<state.bindings.binding_moved.count |slot, state, arm_state|:
                            return false if not proof_kernel_replay_resource_charge_work(state, 1)
                            return false if slot >= arm_state.scope.pending_join_moves.count or slot >= state.scope.pending_join_moves.count
                            state.scope.pending_join_moves[slot] <- true if arm_state.scope.pending_join_moves[slot]
                    return false if not proof_kernel_replay_resource_scope_event_history_adopt(&state, &alternative_history)
                    continue
                if node.kind == "resource-region-open":
                    return false if proof_kernel_replay_resource_region_active(state, node.name)
                    return false if not proof_kernel_replay_resource_charge_work(state, 2)
                    state.regions.active_regions.push(node.name)
                    continue
                if node.kind == "resource-region-param":
                    return false if node.name == "" or proof_kernel_replay_resource_region_active(state, node.name)
                    return false if not proof_kernel_replay_resource_charge_work(state, 4)
                    state.regions.active_regions.push(node.name)
                    state.regions.external_regions.push(node.name)
                    continue
                if node.kind == "resource-sview-param":
                    return false if not proof_kernel_replay_resource_sview_parameter(nodes, state, node)
                    continue
                if node.kind == "resource-region-close":
                    return false if state.regions.active_regions.count == 0
                    return false if state.regions.active_regions[state.regions.active_regions.count - 1] != node.name
                    return false if proof_kernel_replay_resource_region_external(state, node.name) or proof_kernel_replay_resource_region_protected(state, node.name)
                    return false if node.auxiliary == PROOF_KERNEL_REPLAY_EXPLICIT_REGION_DESTROY and proof_kernel_replay_resource_region_has_live_borrow(state, node.name)
                    return false if not proof_kernel_replay_resource_charge_work(state, 1)
                    state.regions.active_regions <- state.regions.active_regions.truncate(state.regions.active_regions.count - 1)
                    return false if not proof_kernel_replay_resource_invalidate_region_bindings(state, node.name)
                    continue
                if node.kind == "resource-region-alloc":
                    return false if:
                        not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                        not arena_admitted and not (proof_kernel_replay_arena_valid(nodes, children, [], node.left) can Global{Read,Write})
                        not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                        not proof_kernel_replay_resource_binding_name_available(state, node.name)
                    return false if not proof_kernel_replay_resource_charge_work(state, 32)
                    state.bindings.binding_names.push(node.name)
                    state.bindings.binding_event_roots.push(root)
                    state.bindings.binding_scope_depth.push(state.scope.scope_depth)
                    state.bindings.binding_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) != 0)
                    state.bindings.binding_mutable_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0)
                    state.bindings.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
                    state.bindings.binding_borrowable.push((node.auxiliary & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) != 0)
                    state.bindings.binding_moved.push(false)
                    state.provenance.binding_region.push(node.secondary_name)
                    state.provenance.binding_region_live.push(true)
                    state.provenance.binding_region_owner.push(true)
                    state.borrows.borrow_target_slots.push(state.bindings.binding_names.count - 1)
                    state.borrows.borrow_target_places.push(proof_kernel_replay_resource_empty_place())
                    state.borrows.borrow_mutable.push(false)
                    state.borrows.borrow_present.push(false)
                    state.scope.pending_join_moves.push(false)
                    state.bindings.binding_origin_places.push(proof_kernel_replay_resource_empty_place())
                    continue
                if node.kind == "resource-region-alloc-discard":
                    return false if:
                        not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                        not arena_admitted and not (proof_kernel_replay_arena_valid(nodes, children, [], node.left) can Global{Read,Write})
                        not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                    continue
                if node.kind == "resource-region-return-alloc":
                    return false if:
                        not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                        not arena_admitted and not (proof_kernel_replay_arena_valid(nodes, children, [], node.left) can Global{Read,Write})
                        not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                        not proof_kernel_replay_resource_region_external(state, node.secondary_name)
                    return false if not proof_kernel_replay_resource_charge_work(state, 4)
                    return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_return_witnesses, &state.scope.resource_return_witnesses_are_sorted, root, &state.scope.resource_work_used)
                    continue
                if node.kind == "resource-region-call-alloc":
                    # A call temporary is a real allocation in the caller's active region, but
                    # it is intentionally not installed as a named binding. The call transition
                    # must consume this exact event before any callee effect is accepted.
                    return false if:
                        not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                        not arena_admitted and not (proof_kernel_replay_arena_valid(nodes, children, [], node.left) can Global{Read,Write})
                        not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                    return false if not proof_kernel_replay_resource_charge_work(state, 2)
                    prior_allocation: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_allocations, state.scope.resource_call_allocations_are_sorted, root, &state.scope.resource_work_used)
                    return false if not prior_allocation.complete or prior_allocation.found
                    return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_call_allocations, &state.scope.resource_call_allocations_are_sorted, root, &state.scope.resource_work_used)
                    continue
                if node.kind == "resource-region-return":
                    used_witness_membership: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_return_witnesses_used, state.scope.resource_return_witnesses_used_are_sorted, node.left, &state.scope.resource_work_used)
                    return false if not used_witness_membership.complete or used_witness_membership.found
                    if node.name == "":
                        # A region-less reference return: see resource_call_returns.elisa.
                        if node.operator == "param-call":
                            return false if not (proof_kernel_replay_resource_reference_call_return(nodes, children, state, node, prior_event, arena_admitted) can Global{Read,Write})
                        else:
                            return false if not proof_kernel_replay_resource_regionless_return(nodes, state, node)
                        return false if not proof_kernel_replay_resource_charge_work(state, 2)
                        return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_return_witnesses_used, &state.scope.resource_return_witnesses_used_are_sorted, node.left, &state.scope.resource_work_used)
                        continue
                    return false if not proof_kernel_replay_resource_region_external(state, node.name) or not proof_kernel_replay_resource_region_active(state, node.name)
                    if node.operator == "value-param":
                        return false if node.auxiliary != 0 or not proof_kernel_replay_resource_region_collection_type(nodes, children, node.right, &state.scope.resource_work_used)
                        value_witness_membership: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_return_witnesses, state.scope.resource_return_witnesses_are_sorted, node.left, &state.scope.resource_work_used)
                        return false if not value_witness_membership.complete or not value_witness_membership.found
                        return false if node.left >= nodes.count
                        return false if nodes[node.left].kind != "resource-use" or nodes[node.left].name == ""
                        value_slot: usize = proof_kernel_replay_resource_lookup(state, nodes[node.left].name)
                        return false if value_slot >= state.bindings.binding_names.count
                        return false if value_slot >= state.bindings.binding_reference.count
                        return false if state.bindings.binding_reference[value_slot]
                        return false if proof_kernel_replay_resource_binding_region(state, value_slot) != node.name or not proof_kernel_replay_resource_binding_region_is_live(state, value_slot)
                        # Returning a non-reference collection transfers its value binding; the
                        # resource-use witness must therefore have been followed by the move that
                        # the source checker observed.
                        return false if value_slot >= state.bindings.binding_moved.count
                        return false if not state.bindings.binding_moved[value_slot]
                        return false if not proof_kernel_replay_resource_charge_work(state, 2)
                        return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_return_witnesses_used, &state.scope.resource_return_witnesses_used_are_sorted, node.left, &state.scope.resource_work_used)
                        continue
                    if node.operator in {"sview-call", "param-call"}:
                        return false if not (proof_kernel_replay_resource_region_call_return(nodes, children, state, node, prior_event, arena_admitted) can Global{Read,Write})
                        return false if not proof_kernel_replay_resource_charge_work(state, 2)
                        return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_return_witnesses_used, &state.scope.resource_return_witnesses_used_are_sorted, node.left, &state.scope.resource_work_used)
                        continue
                    return_witness_membership: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_return_witnesses, state.scope.resource_return_witnesses_are_sorted, node.left, &state.scope.resource_work_used)
                    return false if not return_witness_membership.complete or not return_witness_membership.found
                    witness: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                    return false if not witness.known
                    is_sview_return: bool = node.operator == "sview"
                    if is_sview_return:
                        return false if node.auxiliary != PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG or node.right >= nodes.count
                        sview_type: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                        return false if sview_type.kind != "ident" or sview_type.name != "sview" or sview_type.left != 0 or sview_type.right != 0 or sview_type.auxiliary != 0 or sview_type.children_start != 0 or sview_type.children_count != 0 or sview_type.value != 0 or sview_type.secondary_name != ""
                    if witness.node.kind == "resource-region-return-alloc":
                        return false if:
                            is_sview_return
                            witness.node.secondary_name != node.name
                    elif witness.node.kind == "resource-use":
                        return false if witness.node.name == ""
                        witness_slot: usize = proof_kernel_replay_resource_lookup(state, witness.node.name)
                        return false if witness_slot >= state.bindings.binding_names.count
                        return false if proof_kernel_replay_resource_binding_region(state, witness_slot) != node.name
                        return false if not proof_kernel_replay_resource_binding_region_is_live(state, witness_slot)
                        return false if witness_slot >= state.bindings.binding_moved.count
                        return false if state.bindings.binding_moved[witness_slot]
                        if not is_sview_return:
                            # A returned reference capability must originate in a reference
                            # binding and preserve its pointee mutability. A returned sview is a
                            # shared by-value borrow, so its witness may be an owner or a reference.
                            return false if witness_slot >= state.bindings.binding_reference.count
                            return false if not state.bindings.binding_reference[witness_slot]
                            witness_mutable: bool = witness_slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[witness_slot]
                            return false if (node.auxiliary == 1) != witness_mutable
                    else:
                        return false
                    return false if not proof_kernel_replay_resource_charge_work(state, 2)
                    return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_return_witnesses_used, &state.scope.resource_return_witnesses_used_are_sorted, node.left, &state.scope.resource_work_used)
                    continue
                if node.kind == "resource-region-rebind-alloc":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not arena_admitted and not (proof_kernel_replay_arena_valid(nodes, children, [], node.left) can Global{Read,Write})
                    return false if not proof_kernel_replay_resource_value_term_has_no_region(nodes, children, state, node.left, 0)
                    target_slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if target_slot >= state.bindings.binding_names.count
                    return false if target_slot >= state.bindings.binding_moved.count
                    return false if state.bindings.binding_moved[target_slot]
                    return false if target_slot >= state.bindings.binding_reference.count or not state.bindings.binding_reference[target_slot]
                    return false if not proof_kernel_replay_resource_binding_is_writable(state, target_slot)
                    return false if target_slot >= state.borrows.borrow_present.count
                    return false if state.borrows.borrow_present[target_slot]
                    target_place: ProofKernelReplayResourcePlace = ProofKernelReplayResourcePlace{has_root: node.name != "", root_node: root, path_root: 0, depth: 0, whole: true}
                    return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, target_place, state.bindings.binding_names.count)
                    return false if not proof_kernel_replay_resource_charge_work(state, 3)
                    state.provenance.binding_region[target_slot] <- node.secondary_name
                    state.provenance.binding_region_live[target_slot] <- true
                    state.provenance.binding_region_owner[target_slot] <- true
                    continue
                if node.kind == "resource-region-bind":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    is_sview_borrow: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG) != 0
                    if is_sview_borrow:
                        return false if:
                            node.auxiliary != PROOF_KERNEL_REPLAY_SVIEW_BORROW_FLAG + PROOF_KERNEL_REPLAY_BORROWABLE_FLAG
                            node.right >= nodes.count
                        sview_type: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                        return false if:
                            sview_type.kind != "ident" or sview_type.name != "sview" or sview_type.left != 0 or sview_type.right != 0 or sview_type.auxiliary != 0 or sview_type.children_start != 0 or sview_type.children_count != 0 or sview_type.value != 0 or sview_type.secondary_name != ""
                            (node.auxiliary & (PROOF_KERNEL_REPLAY_REFERENCE_FLAG + PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG + PROOF_KERNEL_REPLAY_WRITABLE_FLAG)) != 0
                    source: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(state, nodes, children, node.left, 0)
                    return false if not source.known
                    # The event format stores no path for the new alias. Reject a field/index
                    # source rather than widening it to a whole-root capability.
                    return false if not source.place.whole
                    source_slot: usize = proof_kernel_replay_resource_lookup_place(state, nodes, source.place)
                    return false if source_slot >= state.bindings.binding_names.count
                    return false if proof_kernel_replay_resource_binding_region(state, source_slot) != node.secondary_name
                    return false if not proof_kernel_replay_resource_binding_region_is_live(state, source_slot) or not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    source_is_reference: bool = source_slot < state.bindings.binding_reference.count and state.bindings.binding_reference[source_slot]
                    source_is_mutable_reference: bool = source_slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[source_slot]
                    source_region_owner: bool = source_slot < state.provenance.binding_region_owner.count and state.provenance.binding_region_owner[source_slot]
                    requested_reference: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) != 0
                    requested_mutable_reference: bool = (node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0
                    borrow_target_slot: mutable usize = source_slot
                    borrow_target_place: mutable ProofKernelReplayResourcePlace = source.place
                    borrow_overlap_except: mutable usize = state.bindings.binding_names.count
                    if is_sview_borrow:
                        if source_slot < state.borrows.borrow_present.count and state.borrows.borrow_present[source_slot]:
                            return false if source_slot >= state.borrows.borrow_target_slots.count or source_slot >= state.borrows.borrow_target_places.count
                            borrow_target_slot <- state.borrows.borrow_target_slots[source_slot]
                            borrow_target_place <- state.borrows.borrow_target_places[source_slot]
                            borrow_overlap_except <- source_slot
                        elif not source_region_owner:
                            return false if not source_is_reference
                        return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, borrow_target_place, borrow_overlap_except)
                        return false if borrow_target_slot >= state.bindings.binding_names.count
                        return false if borrow_target_slot >= state.provenance.binding_region.count
                        return false if state.provenance.binding_region[borrow_target_slot] != node.secondary_name
                        return false if borrow_target_slot >= state.provenance.binding_region_live.count
                        return false if not state.provenance.binding_region_live[borrow_target_slot]
                        return false if not proof_kernel_replay_resource_place_root_valid(nodes, borrow_target_place)
                    # A region alias preserves the source's reference category. A direct region
                    # allocation may be exposed as a mutable reference, but an external or
                    # borrowed mutable reference may not be copied into another mutable alias:
                    # there is no owner token to transfer, so doing so would duplicate a write
                    # capability. Moving a direct owner also requires that no live borrow overlaps
                    # its whole place.
                    return false if source_slot >= state.bindings.binding_moved.count
                    return false if state.bindings.binding_moved[source_slot]
                    return false if:
                        not is_sview_borrow and requested_reference != source_is_reference
                        not is_sview_borrow and requested_reference and requested_mutable_reference != source_is_mutable_reference and not source_region_owner
                        requested_mutable_reference and not requested_reference
                        not is_sview_borrow and source_is_reference and source_is_mutable_reference and not source_region_owner
                        not is_sview_borrow and source_region_owner and proof_kernel_replay_resource_has_borrow_overlap(nodes, state, source.place, state.bindings.binding_names.count)
                        not proof_kernel_replay_resource_binding_name_available(state, node.name)
                    transfer_owner: bool = source_region_owner and not is_sview_borrow
                    return false if not proof_kernel_replay_resource_charge_work(state, 32 + (1 if transfer_owner else 0))
                    state.bindings.binding_names.push(node.name)
                    state.bindings.binding_event_roots.push(root)
                    state.bindings.binding_scope_depth.push(state.scope.scope_depth)
                    state.bindings.binding_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_REFERENCE_FLAG) != 0)
                    state.bindings.binding_mutable_reference.push((node.auxiliary & PROOF_KERNEL_REPLAY_MUTABLE_REFERENCE_FLAG) != 0)
                    state.bindings.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
                    state.bindings.binding_borrowable.push((node.auxiliary & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) != 0)
                    state.bindings.binding_moved.push(false)
                    state.provenance.binding_region.push(node.secondary_name)
                    state.provenance.binding_region_live.push(true)
                    state.provenance.binding_region_owner.push(source_region_owner and not is_sview_borrow)
                    state.borrows.borrow_target_slots.push(borrow_target_slot if is_sview_borrow else state.bindings.binding_names.count - 1)
                    state.borrows.borrow_target_places.push(borrow_target_place if is_sview_borrow else proof_kernel_replay_resource_empty_place())
                    state.borrows.borrow_mutable.push(false)
                    state.borrows.borrow_present.push(is_sview_borrow)
                    state.scope.pending_join_moves.push(false)
                    state.bindings.binding_origin_places.push(proof_kernel_replay_resource_empty_place())
                    state.bindings.binding_moved[source_slot] <- true if transfer_owner
                    continue
                if node.kind == "resource-region-assign":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    source: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(state, nodes, children, node.left, 0)
                    return false if not source.known
                    source_slot: usize = proof_kernel_replay_resource_lookup_place(state, nodes, source.place)
                    target_slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if source_slot >= state.bindings.binding_names.count
                    return false if target_slot >= state.bindings.binding_names.count
                    # The assignment event stores no source path. Reject a field/index source
                    # rather than assigning its lifetime to an unrelated whole binding.
                    return false if source_slot >= state.bindings.binding_moved.count
                    return false if state.bindings.binding_moved[source_slot]
                    return false if target_slot >= state.bindings.binding_moved.count
                    return false if state.bindings.binding_moved[target_slot]
                    return false if target_slot >= state.bindings.binding_reference.count or state.bindings.binding_reference[target_slot]
                    return false if:
                        not source.place.whole
                        proof_kernel_replay_resource_binding_region(state, source_slot) != node.secondary_name
                        not proof_kernel_replay_resource_binding_region_is_live(state, source_slot)
                        not proof_kernel_replay_resource_binding_is_writable(state, target_slot)
                    return false if target_slot < state.borrows.borrow_present.count and state.borrows.borrow_present[target_slot]
                    target_place: ProofKernelReplayResourcePlace = ProofKernelReplayResourcePlace{has_root: node.name != "", root_node: root, path_root: 0, depth: 0, whole: true}
                    return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, target_place, state.bindings.binding_names.count)
                    source_region_owner: bool = source_slot < state.provenance.binding_region_owner.count and state.provenance.binding_region_owner[source_slot]
                    transfer_owner: bool = source_region_owner and source_slot != target_slot
                    return false if not proof_kernel_replay_resource_charge_work(state, 3 + (1 if transfer_owner else 0))
                    state.provenance.binding_region[target_slot] <- node.secondary_name
                    state.provenance.binding_region_live[target_slot] <- true
                    state.provenance.binding_region_owner[target_slot] <- source_region_owner
                    # A region-owner assignment transfers the exclusive token. Preserve
                    # self-assignment as a no-op, but consume a distinct source owner.
                    state.bindings.binding_moved[source_slot] <- true if transfer_owner
                    continue
                if node.kind == "resource-bind":
                    is_reference: bool = node.operator in {"shared", "mutable", "external-shared", "external-mutable"}
                    is_mutable_reference: bool = node.operator in {"mutable", "external-mutable"}
                    target_slot: mutable usize = state.bindings.binding_names.count
                    borrow_is_present: mutable bool = false
                    source_place: mutable ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                    origin_place: mutable ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                    if node.operator in {"shared", "mutable"}:
                        target_slot <- proof_kernel_replay_resource_lookup(state, node.secondary_name)
                        return false if target_slot >= state.bindings.binding_names.count
                        return false if target_slot >= state.bindings.binding_moved.count
                        return false if state.bindings.binding_moved[target_slot]
                        source_region: sview = proof_kernel_replay_resource_binding_region(state, target_slot)
                        return false if source_region != "" and (not proof_kernel_replay_resource_binding_region_is_live(state, target_slot) or not proof_kernel_replay_resource_region_active(state, source_region))
                        decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(state, nodes, children, node.left, 0)
                        return false if not decoded.known or not proof_kernel_replay_resource_place_root_matches(state, nodes, decoded.place, node.secondary_name)
                        source_place <- decoded.place
                        borrow_is_present <- true
                        if node.operator == "mutable":
                            return false if:
                                node.auxiliary != 1
                                proof_kernel_replay_resource_has_borrow_overlap(nodes, state, source_place, state.bindings.binding_names.count)
                        else:
                            return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, source_place, state.bindings.binding_names.count)
                        source_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(nodes, state, target_slot)
                        if source_origin.known:
                            composed: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place_append(state, nodes, source_origin.place, source_place)
                            origin_place <- composed.place if composed.known
                    elif node.operator in {"external-shared", "external-mutable"}:
                        origin_place <- ProofKernelReplayResourcePlace{has_root: node.name != "", root_node: root, path_root: 0, depth: 0, whole: true}
                    external_region: sview = node.secondary_name if node.operator in {"external-shared", "external-mutable"} else ""
                    return false if:
                        external_region != "" and not proof_kernel_replay_resource_region_active(state, external_region)
                        not proof_kernel_replay_resource_binding_name_available(state, node.name)
                    return false if not proof_kernel_replay_resource_charge_work(state, 32)
                    state.bindings.binding_names.push(node.name)
                    state.bindings.binding_event_roots.push(root)
                    state.bindings.binding_scope_depth.push(state.scope.scope_depth)
                    state.bindings.binding_reference.push(is_reference)
                    state.bindings.binding_mutable_reference.push(is_mutable_reference)
                    state.bindings.binding_writable.push((node.auxiliary & PROOF_KERNEL_REPLAY_WRITABLE_FLAG) != 0)
                    state.bindings.binding_borrowable.push((node.auxiliary & PROOF_KERNEL_REPLAY_BORROWABLE_FLAG) != 0)
                    state.bindings.binding_moved.push(false)
                    # `proof_kernel_replay_resource_binding_region` is a bounds-checked read that
                    # returns "" outside the table, so evaluating it unconditionally is the same
                    # value the guarded arm would have produced, and it gives the call the
                    # statement boundary a conditional expression does not.
                    borrowed_region_value: sview = proof_kernel_replay_resource_binding_region(state, target_slot)
                    inherited_region: sview = borrowed_region_value if borrow_is_present else external_region
                    state.provenance.binding_region.push(inherited_region)
                    state.provenance.binding_region_live.push(inherited_region != "")
                    state.provenance.binding_region_owner.push(false)
                    state.borrows.borrow_target_slots.push(target_slot)
                    state.borrows.borrow_target_places.push(source_place)
                    state.borrows.borrow_mutable.push(is_mutable_reference)
                    state.borrows.borrow_present.push(borrow_is_present)
                    state.scope.pending_join_moves.push(false)
                    state.bindings.binding_origin_places.push(origin_place)
                    continue
                if node.kind == "resource-use":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(state, nodes, children, node.left, 0)
                    return false if not decoded.known or not decoded.place.whole or not proof_kernel_replay_resource_place_root_matches(state, nodes, decoded.place, node.name)
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.bindings.binding_names.count
                    return false if slot >= state.bindings.binding_moved.count
                    return false if slot >= state.bindings.binding_event_roots.count or node.auxiliary != state.bindings.binding_event_roots[slot] + 1
                    return false if not proof_kernel_replay_resource_binding_event_identity_matches(state, nodes, slot, node.auxiliary)
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if:
                        region != "" and (not proof_kernel_replay_resource_binding_region_is_live(state, slot) or not proof_kernel_replay_resource_region_active(state, region))
                    return false if state.bindings.binding_moved[slot]
                    return false if not proof_kernel_replay_resource_charge_work(state, 2)
                    return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_return_witnesses, &state.scope.resource_return_witnesses_are_sorted, root, &state.scope.resource_work_used)
                    continue
                if node.kind == "resource-write":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(state, nodes, children, node.left, 0)
                    return false if not decoded.known or not proof_kernel_replay_resource_place_root_matches(state, nodes, decoded.place, node.name)
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.bindings.binding_names.count
                    return false if slot >= state.bindings.binding_moved.count
                    return false if slot >= state.bindings.binding_event_roots.count or node.auxiliary != state.bindings.binding_event_roots[slot] + 1
                    return false if not proof_kernel_replay_resource_binding_event_identity_matches(state, nodes, slot, node.auxiliary)
                    return false if state.bindings.binding_moved[slot]
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if:
                        region != "" and (not proof_kernel_replay_resource_binding_region_is_live(state, slot) or not proof_kernel_replay_resource_region_active(state, region))
                    is_reference: bool = slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]
                    is_mutable_reference: bool = slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]
                    return false if:
                        is_reference and not is_mutable_reference
                        decoded.place.whole and not proof_kernel_replay_resource_binding_is_writable(state, slot)
                    borrow_except_slot: usize = slot if is_reference and is_mutable_reference else state.bindings.binding_names.count
                    return false if (not is_reference or is_mutable_reference) and proof_kernel_replay_resource_has_borrow_overlap(nodes, state, decoded.place, borrow_except_slot)
                    resolved_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_resolve_origin(nodes, state, decoded.place, node.name)
                    return false if resolved_origin.known and not proof_kernel_replay_resource_charge_work(state, 2)
                    effects.push(ProofKernelReplayResourceEffect{kind: "write", place: resolved_origin.place}) if resolved_origin.known
                    continue
                if node.kind == "resource-move":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(state, nodes, children, node.left, 0)
                    return false if not decoded.known or not proof_kernel_replay_resource_place_root_matches(state, nodes, decoded.place, node.name)
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.bindings.binding_names.count
                    return false if slot >= state.bindings.binding_moved.count
                    return false if slot >= state.bindings.binding_event_roots.count or node.auxiliary != state.bindings.binding_event_roots[slot] + 1
                    return false if not proof_kernel_replay_resource_binding_event_identity_matches(state, nodes, slot, node.auxiliary)
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if:
                        region != "" and (not proof_kernel_replay_resource_binding_region_is_live(state, slot) or not proof_kernel_replay_resource_region_active(state, region))
                        proof_kernel_replay_resource_has_borrow_overlap(nodes, state, decoded.place, state.bindings.binding_names.count)
                    return false if state.bindings.binding_moved[slot]
                    return false if slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot]
                    resolved_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_resolve_origin(nodes, state, decoded.place, node.name)
                    return false if not proof_kernel_replay_resource_charge_work(state, 1 + (2 if resolved_origin.known else 0))
                    effects.push(ProofKernelReplayResourceEffect{kind: "move", place: resolved_origin.place}) if resolved_origin.known
                    state.bindings.binding_moved[slot] <- true
                    continue
                if node.kind == "resource-join-move":
                    slot: usize = node.auxiliary
                    return false if slot >= state.bindings.binding_names.count
                    return false if slot >= state.scope.pending_join_moves.count
                    return false if state.bindings.binding_names[slot] != node.name
                    return false if not state.scope.pending_join_moves[slot]
                    return false if slot >= state.bindings.binding_moved.count
                    return false if state.bindings.binding_moved[slot]
                    return false if not proof_kernel_replay_resource_charge_work(state, 2)
                    state.scope.pending_join_moves[slot] <- false
                    state.bindings.binding_moved[slot] <- true
                    continue
                if node.kind == "resource-call-result":
                    return false if not (proof_kernel_replay_resource_call_result(nodes, children, state, node, root, prior_event, arena_admitted) can Global{Read,Write})
                    continue
                if node.kind == "resource-call-lend":
                    # No callee summary is consulted: the transition is derived from the callee's
                    # declared parameter modes alone. A shared formal changes nothing. An
                    # exclusive formal is over-approximated by a write to the whole lent place,
                    # which subsumes every effect any callee summary could have exported — the
                    # summary composer accepts writes rooted at a mutable formal and nothing else.
                    return false if not (proof_kernel_replay_resource_lend(nodes, children, state, effects, root) can Global{Read,Write})
                    lend_prior_call: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_events_seen, state.scope.resource_call_events_seen_are_sorted, root, &state.scope.resource_work_used)
                    return false if not lend_prior_call.complete or lend_prior_call.found
                    return false if not proof_kernel_replay_resource_record_call_event(state, root)
                    continue
                if node.kind == "resource-call":
                    call_prior: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_events_seen, state.scope.resource_call_events_seen_are_sorted, root, &state.scope.resource_work_used)
                    return false if:
                        not call_prior.complete or call_prior.found
                        remaining <= 1
                        not (proof_kernel_replay_resource_call_remaining(nodes, children, state, effects, node, depth + 1, remaining - 1, arena_admitted) can Global{Read,Write})
                    for call_child_index in 0..<node.children_count |call_child_index, node, children, nodes, state|:
                        return false if not proof_kernel_replay_resource_charge_work(state, 1)
                        call_child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + call_child_index)
                        return false if not call_child.known
                        call_argument: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call_child.value)
                        return false if:
                            not call_argument.known
                            not proof_kernel_replay_resource_charge_node_text(state, call_argument.node)
                        if call_argument.node.kind == "resource-call-arg" and call_argument.node.operator == "region-new":
                            used_allocation: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_allocations_used, state.scope.resource_call_allocations_used_are_sorted, call_argument.node.left, &state.scope.resource_work_used)
                            return false if not used_allocation.complete or used_allocation.found
                            available_allocation: (complete: bool, found: bool) = proof_kernel_replay_resource_usize_sorted_membership(state.scope.resource_call_allocations, state.scope.resource_call_allocations_are_sorted, call_argument.node.left, &state.scope.resource_work_used)
                            return false if not available_allocation.complete or not available_allocation.found
                            return false if not proof_kernel_replay_resource_charge_work(state, 2)
                            return false if not proof_kernel_replay_resource_record_sorted_id(&state.scope.resource_call_allocations_used, &state.scope.resource_call_allocations_used_are_sorted, call_argument.node.left, &state.scope.resource_work_used)
                    return false if not proof_kernel_replay_resource_record_call_event(state, root)
                    continue
                return false
            return false if not allow_boundary_pending_join and proof_kernel_replay_resource_has_pending_join(state)
            return false if state.scope.resource_work_used > PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT
            return true
