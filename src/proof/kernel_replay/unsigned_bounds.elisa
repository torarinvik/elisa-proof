include "unsigned_span_descent.elisa"
const PROOF_KERNEL_REPLAY_FIXED_WIDTH_SAFETY_WORK_LIMIT: usize = 65536
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_span_cursor_bound(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or (goal.operator != "<=" and goal.operator != ">=")
            low: usize = goal.right if goal.operator == ">=" else goal.left
            high: usize = goal.left if goal.operator == ">=" else goal.right
            return false if not proof_kernel_replay_valid(nodes, low) or not proof_kernel_replay_valid(nodes, high)
            for fact_root in facts |fact_root, nodes, children, facts, low, high|:
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "<=" or not proof_kernel_replay_valid(nodes, fact.left) or not proof_kernel_replay_valid(nodes, fact.right)
                span: ElisaProofKernelCore::ProofKernelNode = nodes[fact.right]
                continue if span.kind != "binary" or span.operator != "-" or not proof_kernel_replay_valid(nodes, span.left) or not proof_kernel_replay_valid(nodes, span.right)
                start: usize = span.right
                end: usize = span.left
                step: usize = fact.left
                continue if nodes[start].kind != "ident" or nodes[end].kind != "ident" or nodes[step].kind != "ident"
                width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, start, facts, 0)
                continue if width == 0 or proof_kernel_replay_unsigned_width_in_expression(nodes, children, end, facts, 0) != width or proof_kernel_replay_unsigned_width_in_expression(nodes, children, step, facts, 0) != width
                continue if not proof_kernel_replay_has_order_fact(nodes, children, start, end, false, facts)
                lower: ElisaProofKernelCore::ProofKernelNode = nodes[low]
                upper: ElisaProofKernelCore::ProofKernelNode = nodes[high]
                if lower.kind == "binary":
                    if lower.operator == "+" and proof_kernel_replay_expr_equal(nodes, children, lower.left, start, 0) and proof_kernel_replay_expr_equal(nodes, children, lower.right, step, 0) and proof_kernel_replay_expr_equal(nodes, children, high, end, 0):
                        return true
                    if lower.operator == "-" and proof_kernel_replay_expr_equal(nodes, children, lower.left, end, 0) and proof_kernel_replay_expr_equal(nodes, children, lower.right, step, 0) and proof_kernel_replay_expr_equal(nodes, children, high, end, 0):
                        return true
                if upper.kind == "binary":
                    if upper.operator == "+" and proof_kernel_replay_expr_equal(nodes, children, upper.left, start, 0) and proof_kernel_replay_expr_equal(nodes, children, upper.right, step, 0) and proof_kernel_replay_expr_equal(nodes, children, low, start, 0):
                        return true
                    if upper.operator == "-" and proof_kernel_replay_expr_equal(nodes, children, upper.left, end, 0) and proof_kernel_replay_expr_equal(nodes, children, upper.right, step, 0) and proof_kernel_replay_expr_equal(nodes, children, low, start, 0):
                        return true
            return false
        # Independently recognize only (a - b) <= a for same-width unsigned
        # identifiers and an explicit b <= a premise. The guard excludes wrap;
        # unsigned b is nonnegative even above the signed interval ceiling.
        def proof_kernel_replay_unsigned_subtraction_upper_shape(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> bool:
            return false if goal_root >= nodes.count
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if:
                goal.kind != "binary" or goal.operator != "<="
                goal.left >= nodes.count
            difference: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            return false if:
                difference.kind != "binary" or difference.operator != "-"
                difference.left >= nodes.count or difference.right >= nodes.count
                nodes[difference.left].kind != "ident" or nodes[difference.right].kind != "ident"
                not proof_kernel_replay_expr_equal(nodes, children, difference.left, goal.right, 0)
            width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, difference.left, facts, 0)
            return false if width == 0 or proof_kernel_replay_unsigned_width_in_expression(nodes, children, difference.right, facts, 0) != width
            return proof_kernel_replay_has_order_fact(nodes, children, difference.right, difference.left, false, facts)

        const PROOF_KERNEL_REPLAY_BOOLEAN_FOLD_DEPTH_LIMIT: usize = 8

        def proof_kernel_replay_unsigned_width_max(width: i64) -> i64:
            ensure width == ElisaProofKernelCore::PROOF_KERNEL_U8_WIDTH implies result == ElisaProofKernelCore::PROOF_KERNEL_U8_MAX
            ensure width == ElisaProofKernelCore::PROOF_KERNEL_U16_WIDTH implies result == ElisaProofKernelCore::PROOF_KERNEL_U16_MAX
            ensure width == ElisaProofKernelCore::PROOF_KERNEL_U32_WIDTH implies result == ElisaProofKernelCore::PROOF_KERNEL_U32_MAX
            ensure width == ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS implies result == ElisaProofKernelCore::PROOF_KERNEL_I64_MAX
            ensure (width != ElisaProofKernelCore::PROOF_KERNEL_U8_WIDTH and width != ElisaProofKernelCore::PROOF_KERNEL_U16_WIDTH and width != ElisaProofKernelCore::PROOF_KERNEL_U32_WIDTH and width != ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS) implies result == 0
            return ElisaProofKernelCore::PROOF_KERNEL_U8_MAX if width == ElisaProofKernelCore::PROOF_KERNEL_U8_WIDTH
            return ElisaProofKernelCore::PROOF_KERNEL_U16_MAX if width == ElisaProofKernelCore::PROOF_KERNEL_U16_WIDTH
            return ElisaProofKernelCore::PROOF_KERNEL_U32_MAX if width == ElisaProofKernelCore::PROOF_KERNEL_U32_WIDTH
            return ElisaProofKernelCore::PROOF_KERNEL_I64_MAX if width == ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
            return 0

        # Mirror of the producer's order atom: an integer, a bare name, or a field of a bare
        # name. A place is not arithmetic, so admitting it imports none.
        def proof_kernel_replay_order_atom(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count
            match nodes[root].kind:
                "int":
                    return not proof_kernel_replay_int_tagged(nodes[root])
                "ident":
                    return true
                "field":
                    return false if nodes[root].name == ""
                    base: usize = nodes[root].left
                    return false if base >= nodes.count
                    return nodes[base].kind == "ident"
                _:
                    return false

        def proof_kernel_replay_collect_unsigned_orders(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, orders: mutable darray[usize]&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "unary" and node.operator == "not":
                # Mirror of the producer: a negated comparison between two atoms is a comparison
                # between the same two atoms, and the collectors downstream complement it.
                negated_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                return if not negated_located.known
                inner: ElisaProofKernelCore::ProofKernelNode = negated_located.node
                return if inner.kind != "binary"
                return if not proof_kernel_replay_negation_supported(inner.operator)
                return if not proof_kernel_replay_order_atom(nodes, inner.left)
                return if not proof_kernel_replay_order_atom(nodes, inner.right)
                orders.push(root)
                return
            return if node.kind != "binary"
            if node.operator == "and":
                proof_kernel_replay_collect_unsigned_orders(nodes, node.left, orders, depth + 1)
                proof_kernel_replay_collect_unsigned_orders(nodes, node.right, orders, depth + 1)
                return
            return if not proof_kernel_replay_negation_supported(node.operator)
            return if not proof_kernel_replay_order_atom(nodes, node.left)
            return if not proof_kernel_replay_order_atom(nodes, node.right)
            orders.push(root)

        # Mirror of the producer's relational range argument for an increment: `a + 1` is in range
        # when a fact says `a < Y` for a `Y` of the same unsigned width, because `Y` is at most the
        # type's maximum by typing. No interval is involved, which is what makes it usable for a
        # 64-bit unsigned value, whose maximum this arena's i64 intervals cannot represent.
        def proof_kernel_replay_unsigned_unit_increment_base(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left: usize, right: usize) -> (known: bool, base: usize):
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right, 0)
            return (true, left) if right_constant.known and right_constant.value == 1
            left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left, 0)
            return (true, right) if left_constant.known and left_constant.value == 1
            return (false, 0)

        # Mirror: a bare name, or a field of one. Neither can spell the base's own increment.
        def proof_kernel_replay_peer_is_nameable(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count
            match nodes[root].kind:
                "ident":
                    return nodes[root].name != ""
                "field":
                    return false if nodes[root].name == ""
                    base: usize = nodes[root].left
                    return false if base >= nodes.count
                    return nodes[base].kind == "ident" and nodes[base].name != ""
                _:
                    return false

        # Mirror of the producer's peer-only width: a collection's element count is a `usize`, and
        # no width marker is recorded for a field place. Reporting the platform width here, and
        # nowhere else, is safe in the direction the peer rule uses it and keeps it out of the
        # arithmetic guard.
        def proof_kernel_replay_peer_unsigned_width(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize]) -> i64:
            declared: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, root, facts, 0)
            return declared if declared != 0
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return 0 if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return 0 if node.kind != "field" or node.name != "count"
            base: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
            return ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS if base.known and base.node.kind == "ident" and base.node.name != ""
            return 0

        def proof_kernel_replay_unsigned_increment_has_direct_peer(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, base: usize, width: i64, facts: darray[usize]) -> bool:
            return false if width == 0
            for fact in facts |fact, nodes, children, base, width, facts|:
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
                continue if not located.known
                node: mutable ElisaProofKernelCore::ProofKernelNode = located.node
                complemented: mutable bool = false
                if node.kind == "unary" and node.operator == "not":
                    inner: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                    continue if not inner.known or inner.node.kind != "binary"
                    continue if inner.node.operator != ">=" and inner.node.operator != "<="
                    node <- inner.node
                    complemented <- true
                continue if node.kind != "binary"
                operator: sview = proof_kernel_replay_negation(node.operator) if complemented else node.operator
                # The peer must be a bare name: one that mentioned the base could justify itself,
                # since `a < a + 1` is the very claim whose range this decides.
                if operator == "<" and proof_kernel_replay_expr_equal(nodes, children, node.left, base, 0) and proof_kernel_replay_peer_is_nameable(nodes, node.right):
                    return true if proof_kernel_replay_peer_unsigned_width(nodes, children, node.right, facts) == width
                if operator == ">" and proof_kernel_replay_expr_equal(nodes, children, node.right, base, 0) and proof_kernel_replay_peer_is_nameable(nodes, node.left):
                    return true if proof_kernel_replay_peer_unsigned_width(nodes, children, node.left, facts) == width
            return false
        # Mirror of the producer's boolean fold: a constant, seen through the negation that a
        # contract substitution leaves behind on a path returning `false`.
        def proof_kernel_replay_constant_bool_leaf(kind: sview, value: i64) -> (known: bool, value: bool):
            return (true, value != 0) if kind == "bool"
            return (false, false)

        def proof_kernel_replay_constant_bool_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, goal_work: mutable usize&) -> (known: bool, value: bool):
            return (false, false) if root >= nodes.count
            remaining: usize = PROOF_KERNEL_REPLAY_BOOLEAN_FOLD_DEPTH_LIMIT
            proof_kernel_replay_constant_bool_remaining_with_goal_work(nodes, children, facts, root, remaining, goal_work)

        def proof_kernel_replay_constant_bool_remaining_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, remaining: usize, goal_work: mutable usize&) -> (known: bool, value: bool):
            decreases remaining
            return (false, false) if:
                root >= nodes.count
                not proof_kernel_replay_goal_search_charge(goal_work) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, goal_work)
                goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary":
                return (false, false) if not proof_kernel_replay_arena_shape_valid(node) or node.left >= nodes.count or node.right >= nodes.count
                if node.operator in {"==", "!=", "<", "<=", ">", ">="}:
                    comparison_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, root, goal_work, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return (false, false) if not comparison_admission.complete or comparison_admission.untrusted or goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    primitive_operands: bool = proof_kernel_replay_scalar_term_pair_witnessed_with_work(nodes, children, facts, node.left, node.right, 0, goal_work, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return (false, false) if not primitive_operands or goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return ElisaProofKernelCore::typed_constant_expression_comparison_with_goal_work(nodes, node.left, node.operator, node.right, goal_work, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if node.kind == "unary":
                return (false, false) if remaining < 1 or node.operator != "not"
                inner: (known: bool, value: bool) = proof_kernel_replay_constant_bool_remaining_with_goal_work(nodes, children, facts, node.left, remaining - 1, goal_work)
                return (inner.known, not inner.value)
            proof_kernel_replay_constant_bool_leaf(node.kind, node.value)

        # A list-comprehension binder does not appear in the resource event trace, so keep this
        # small collector as an explicit loop whose indexed access is checked in the body.
        def proof_kernel_replay_collect_type_marker_facts(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], orders: mutable darray[usize]&) -> void:
            for fact_root in facts:
                orders.push(fact_root) if proof_kernel_replay_type_marker_callee(nodes, children, fact_root)

        # The source parser preserves a full-width unsigned literal in the signed AST integer
        # slot by reinterpreting its bits (for example, u64.max is stored as -1). The kernel term
        # arena does not yet carry enough literal-sort information to distinguish that value from
        # a signed integer. Never let that encoding mismatch create an empty signed interval and
        # thereby a vacuous bounded-model proof for a machine-word unsigned expression.
        def proof_kernel_replay_has_negative_integer_bit_pattern(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_has_negative_integer_bit_pattern_with_work(nodes, children, root, &work_used, depth)

        def proof_kernel_replay_has_negative_integer_bit_pattern_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&, depth: usize) -> bool:
            goal_work: mutable usize = 0
            proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, root, work_used, &goal_work, depth)

        def proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&, goal_work: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return true if:
                not proof_kernel_replay_goal_search_charge(goal_work)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, goal_work)
                goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                work_used >= PROOF_KERNEL_REPLAY_FIXED_WIDTH_SAFETY_WORK_LIMIT
            work_used <- work_used + 1
            return true if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if not proof_kernel_replay_arena_shape_valid(node)
            # Exact typed ordering is handled before this legacy i64 model gate.
            # A known unsigned value can still be unrepresentable by that model;
            # retaining its sort does not make a signed interval sound.
            if node.kind == "typed-int":
                literal = ElisaProofKernelCore::typed_literal_value(node)
                return not literal.known or (literal.unsigned and literal.width == 64 and node.value < 0)
            return node.value < 0 if node.kind == "int"
            if node.kind in {"unary", "field", "index", "checked-index", "checked-get", "paren", "call_arg", "field-init"}:
                return proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, node.left, work_used, goal_work, depth + 1) or proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, node.right, work_used, goal_work, depth + 1)
            if node.kind == "binary":
                return proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, node.left, work_used, goal_work, depth + 1) or proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, node.right, work_used, goal_work, depth + 1)
            if node.kind == "if":
                return proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, node.left, work_used, goal_work, depth + 1) or proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, node.right, work_used, goal_work, depth + 1) or proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, node.auxiliary, work_used, goal_work, depth + 1)
            if node.kind in {"call", "index-n", "array", "tuple", "set", "dict", "construct"}:
                return true if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                found: mutable bool = proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, node.left, work_used, goal_work, depth + 1)
                return true if found
            for offset in 0..<node.children_count |offset, node, children, nodes, depth, work_used, goal_work|:
                child: (known: bool, value: usize) = proof_kernel_replay_index_at(children, node.children_start + offset)
                found <- true if not child.known or proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, child.value, work_used, goal_work, depth + 1)
                return true if found
                return false
            return false

        def proof_kernel_replay_unsigned_expression_safe(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&, depth: usize) -> bool:
            work_used: mutable usize = 0
            goal_work: mutable usize = 0
            proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, root, facts, bounds, &work_used, &goal_work, depth)

        def proof_kernel_replay_unsigned_expression_safe_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&, depth: usize) -> bool:
            goal_work: mutable usize = 0
            proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, root, facts, bounds, work_used, &goal_work, depth)

        def proof_kernel_replay_unsigned_expression_safe_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&, goal_work: mutable usize&, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, root, facts, bounds, &work_used, goal_work, depth)

        def proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], bounds: darray[ProofKernelReplayBound]&, work_used: mutable usize&, goal_work: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(goal_work)
                work_used >= PROOF_KERNEL_REPLAY_FIXED_WIDTH_SAFETY_WORK_LIMIT
            work_used <- work_used + 1
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, root, facts, goal_work, depth + 1)
            return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if width == ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS:
                negative_bit_pattern: bool = proof_kernel_replay_has_negative_integer_bit_pattern_with_replay_work(nodes, children, root, work_used, goal_work, depth + 1)
                return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or negative_bit_pattern
            if node.kind == "if":
                conditional_safe: bool = proof_kernel_replay_unsigned_conditional_difference_safe_with_goal_work(nodes, children, facts, root, goal_work)
                return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if conditional_safe
            if node.kind == "unary":
                return false if not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.left, facts, bounds, work_used, goal_work, depth + 1)
                if node.operator == "-":
                    width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, node.left, facts, goal_work, depth + 1)
                    return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if width != 0:
                        interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, root, bounds, goal_work, depth + 1)
                        return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= proof_kernel_replay_unsigned_width_max(width)
                return true
            if node.kind == "binary":
                return false if not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.left, facts, bounds, work_used, goal_work, depth + 1)
                # `or` and `and` short-circuit, so an operand the left one settles is never
                # evaluated and its arithmetic never happens.
                if node.operator in {"or", "and"}:
                    settled: (known: bool, value: bool) = proof_kernel_replay_constant_bool_with_goal_work(nodes, children, facts, node.left, goal_work)
                    return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if:
                        settled.known and settled.value and node.operator == "or"
                        settled.known and not settled.value and node.operator == "and"
                return false if not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.right, facts, bounds, work_used, goal_work, depth + 1)
                arithmetic: bool = node.operator in {"+", "-", "*", "/", "%", "<<", ">>"}
                width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, root, facts, goal_work, depth + 1)
                return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if not arithmetic or width == 0
                # A guarded unsigned subtraction is range-safe even when its operands are
                # wider than the kernel's i64 interval representation.
                if node.operator == "+":
                    unit: (known: bool, base: usize) = proof_kernel_replay_unsigned_unit_increment_base_with_work(nodes, node.left, node.right, goal_work)
                    return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if unit.known:
                        strict_peer: bool = proof_kernel_replay_unsigned_increment_has_strict_peer_with_work(nodes, children, unit.base, width, facts, goal_work)
                        return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if strict_peer
                    # A sum of two non-constant terms has no interval here and never can for a
                    # 64-bit unsigned value. What it can have is a bound, and the same search that
                    # discharges `a + b <= C` names the `C`.
                    sum_witness: (known: bool, bound: usize, strict: bool) = proof_kernel_replay_sum_upper_witness_with_goal_work(nodes, children, node.left, node.right, facts, goal_work)
                    return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if sum_witness.known and proof_kernel_replay_peer_is_nameable_with_goal_work(nodes, sum_witness.bound, goal_work):
                        return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        peer_width: i64 = proof_kernel_replay_sum_peer_unsigned_width_with_goal_work(nodes, children, sum_witness.bound, facts, goal_work)
                        return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return true if peer_width == width
                if node.operator == "-":
                    has_order: bool = proof_kernel_replay_has_order_fact_with_work(nodes, children, node.right, node.left, false, facts, goal_work)
                    return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if has_order
                    difference_safe: bool = proof_kernel_replay_difference_comparison_with_work(nodes, children, node.left, ">=", node.right, facts, goal_work)
                    return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if difference_safe
                    interval_bounds: mutable darray[ProofKernelReplayBound] = []
                    return false if not proof_kernel_replay_goal_search_charge_amount(goal_work, bounds.count)
                    interval_bounds.extend(bounds)
                    interval_safe: bool = proof_kernel_replay_interval_goal_with_work(nodes, children, node.left, ">=", node.right, facts, &interval_bounds, goal_work)
                    return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return interval_safe
                # Mirror the producer's unsigned-remainder range: with a positive constant
                # divisor that fits this witnessed width, the result is between zero and d-1.
                # The signed interval fallback below cannot express that nonnegative lower bound.
                if node.operator == "%":
                    remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1
                    divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, node.right, remaining, goal_work)
                    return false if:
                        goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        not divisor.known or divisor.value <= 0
                        not proof_kernel_replay_constant_fits_unsigned_with_goal_work(nodes, node.right, width, goal_work)
                        goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        divisor.value > proof_kernel_replay_unsigned_width_max(width)
                    remainder_upper: ProofKernelReplayInt = proof_kernel_replay_sub_safe(divisor.value, 1)
                    return false if not remainder_upper.known
                    return remainder_upper.value <= proof_kernel_replay_unsigned_width_max(width)
                if node.operator == "*":
                    scaled_witness: (known: bool, base: usize, bound: usize, factor: i64) = proof_kernel_replay_unsigned_scaled_product_witness_with_work(nodes, children, root, facts, false, goal_work)
                    return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if scaled_witness.known
                interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval_with_goal_work(nodes, children, root, bounds, goal_work, depth + 1)
                return false if goal_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= proof_kernel_replay_unsigned_width_max(width)
            if node.kind == "if":
                return false if not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.left, facts, bounds, work_used, goal_work, depth + 1)
                if not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.right, facts, bounds, work_used, goal_work, depth + 1):
                    # Mirror of `proof_unsigned_arm_safe_under`: the then arm runs only under its
                    # condition, which joins the facts for that arm alone.
                    guarded: mutable darray[usize] = []
                    guarded.extend(facts)
                    guarded.push(node.left)
                    guarded_bounds: mutable darray[ProofKernelReplayBound] = []
                    return false if not proof_kernel_replay_arm_bounds_with_work(nodes, children, guarded, nodes.count, &guarded_bounds, goal_work)
                    if not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.right, guarded, guarded_bounds, work_used, goal_work, depth + 1):
                        return false if not proof_kernel_replay_close_plain_bounds_with_goal_work(nodes, children, guarded, &guarded_bounds, goal_work)
                        return false if not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.right, guarded, guarded_bounds, work_used, goal_work, depth + 1)
                return true if proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.auxiliary, facts, bounds, work_used, goal_work, depth + 1)
                # Mirror of `proof_unsigned_arm_safe_unless`: the complement enters the bounds alone.
                else_bounds: mutable darray[ProofKernelReplayBound] = []
                return false if not proof_kernel_replay_arm_bounds_with_work(nodes, children, facts, node.left, &else_bounds, goal_work)
                return true if proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.auxiliary, facts, else_bounds, work_used, goal_work, depth + 1)
                return false if not proof_kernel_replay_close_plain_bounds_with_goal_work(nodes, children, facts, &else_bounds, goal_work)
                return proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.auxiliary, facts, else_bounds, work_used, goal_work, depth + 1)
            if node.kind == "call":
                return false if:
                    node.children_start > children.count or node.children_count > children.count - node.children_start
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, node.left, facts, bounds, work_used, goal_work, depth + 1)
            for index in 0..<node.children_count |index, node, children, nodes, facts, bounds, depth, work_used, goal_work|:
                argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                return false if not argument.known
                argument_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, argument.value)
                return false if:
                    not argument_node.known or argument_node.node.kind != "call_arg"
                    not proof_kernel_replay_unsigned_expression_safe_with_replay_work(nodes, children, argument_node.node.left, facts, bounds, work_used, goal_work, depth + 1)
                return true
            return true

        # `proof_kernel_replay_unsigned_goal_safe` of every fact, with the intervals computed
        # once for the list: they depend on the facts alone, not on the term being guarded.
        def proof_kernel_replay_unsigned_facts_safe(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize]) -> bool:
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            closed: mutable darray[ProofKernelReplayBound] = []
            has_closed: mutable bool = false
            signed_bounds: darray[ProofKernelReplayBound] = proof_kernel_replay_signed_safety_bounds(nodes, children, facts)
            for fact in facts |fact, nodes, children, facts, bounds, closed, has_closed, signed_bounds|:
                unsigned_safe: mutable bool = proof_kernel_replay_unsigned_expression_safe(nodes, children, fact, facts, bounds, 0)
                if not unsigned_safe:
                    if not has_closed:
                        closed.extend(bounds)
                        return false if not proof_kernel_replay_close_plain_bounds(nodes, children, facts, &closed)
                        has_closed <- true
                    unsigned_safe <- proof_kernel_replay_unsigned_expression_safe(nodes, children, fact, facts, closed, 0)
                return false if not unsigned_safe or not proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, fact, facts, signed_bounds, 0)
            return true

        def proof_kernel_replay_unsigned_goal_safe(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            # No propagation beyond plain orders here: a difference constraint read off `y == x + 1`
            # is a modular equality for an unsigned type and says nothing about the integers, so
            # propagating it would justify this guard with the very assumption it is deciding.
            return proof_kernel_replay_unsigned_safe_closing(nodes, children, root, facts, &bounds) and proof_kernel_replay_signed_expression_safe(nodes, children, root, facts)

        def proof_kernel_replay_unsigned_safety_bounds_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if not proof_kernel_replay_close_equalities_with_work(nodes, children, facts, bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT

        def proof_kernel_replay_unsigned_report_safe_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            bounds: mutable darray[ProofKernelReplayBound] = []
            return false if not proof_kernel_replay_unsigned_safety_bounds_with_goal_work(nodes, children, facts, &bounds, work_used)
            signed_bounds: darray[ProofKernelReplayBound] = proof_kernel_replay_signed_safety_bounds_with_goal_work(nodes, children, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            closed: mutable darray[ProofKernelReplayBound] = []
            has_closed: mutable bool = false
            for fact in facts |fact, nodes, children, facts, bounds, closed, has_closed, signed_bounds, work_used|:
                unsigned_safe: mutable bool = proof_kernel_replay_unsigned_expression_safe_with_goal_work(nodes, children, fact, facts, bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if not unsigned_safe:
                    if not has_closed:
                        return false if not proof_kernel_replay_goal_search_charge_amount(work_used, bounds.count)
                        closed.extend(bounds)
                        return false if not proof_kernel_replay_close_plain_bounds_with_goal_work(nodes, children, facts, &closed, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        has_closed <- true
                    unsigned_safe <- proof_kernel_replay_unsigned_expression_safe_with_goal_work(nodes, children, fact, facts, closed, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                signed_safe: bool = proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, fact, facts, signed_bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not unsigned_safe or not signed_safe
            unsigned_safe: bool = proof_kernel_replay_unsigned_safe_closing_with_goal_work(nodes, children, root, facts, &bounds, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not unsigned_safe
            signed_safe: bool = proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, root, facts, signed_bounds, work_used, 0)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and signed_safe
