extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_LINEAR_PRUNE_PAREN_DEPTH_LIMIT: usize = 64

        def proof_kernel_replay_linear_is_or_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            current: mutable usize = root
            depth: mutable usize = 0
            while true |current, depth, nodes, work_used|:
                if depth >= PROOF_KERNEL_REPLAY_LINEAR_PRUNE_PAREN_DEPTH_LIMIT:
                    work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                    return false
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used) or current >= nodes.count or not proof_kernel_replay_valid(nodes, current)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, current, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                node: ElisaProofKernelCore::ProofKernelNode = nodes[current]
                if node.kind == "paren":
                    return false if not proof_kernel_replay_arena_shape_valid(node) or node.left >= nodes.count or not proof_kernel_replay_valid(nodes, node.left)
                    current <- node.left
                    depth <- depth + 1
                    continue
                return node.kind == "binary" and node.operator == "or"
            false

        # Metered mirror of `proof_kernel_replay_linear_prune`; the collector, fact parser,
        # and Farkas refuter are shared with the linear-disequality path. Keep signed_only=true
        # to preserve this rule's overflow-safe arithmetic fragment.
        def proof_kernel_replay_linear_prune_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: darray[ProofKernelReplayWitnessMarker], base_terms: darray[ProofKernelReplayNormalTerm]&, base_spans: darray[ProofKernelReplayLinearSpan]&, signed_bounds: darray[ProofKernelReplayBound]&, root: usize, depth: usize, work_used: mutable usize&) -> (truth: i64, changed: bool, root: usize):
            unknown: (truth: i64, changed: bool, root: usize) = (0, false, root)
            return unknown if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= 32 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren":
                return proof_kernel_replay_linear_prune_with_goal_work(nodes, children, facts, markers, base_terms, base_spans, signed_bounds, node.left, depth + 1, work_used)
            return unknown if node.kind != "binary"
            if node.operator == "or":
                left_result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_linear_prune_with_goal_work(nodes, children, facts, markers, base_terms, base_spans, signed_bounds, node.left, depth + 1, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_linear_prune_with_goal_work(nodes, children, facts, markers, base_terms, base_spans, signed_bounds, node.right, depth + 1, work_used)
                return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (2, true, root) if left_result.truth == 2 and right_result.truth == 2
                return (1, true, root) if left_result.truth == 1 or right_result.truth == 1
                return (right_result.truth, true, right_result.root) if left_result.truth == 2
                return (left_result.truth, true, left_result.root) if right_result.truth == 2
                return unknown if:
                    not left_result.changed and not right_result.changed
                    not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, "binary", "or")
                joined: usize = ElisaProofKernelCore::add_node(nodes, "binary", "or", left_result.root, right_result.root, 0, 0, 0, 0, "", "")
                return unknown if joined >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (0, true, joined)
            return unknown if not proof_kernel_replay_linear_comparison_operator(node.operator)
            relation_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return unknown if not relation_admission.complete or relation_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
            safe: bool = proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, root, facts, signed_bounds, work_used, 0)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not safe
            terms: mutable darray[ProofKernelReplayNormalTerm] = []
            spans: mutable darray[ProofKernelReplayLinearSpan] = []
            copied_items: usize = base_terms.count + base_spans.count
            return unknown if not proof_kernel_replay_goal_search_charge_amount(work_used, copied_items)
            terms.extend(base_terms)
            spans.extend(base_spans)
            read: bool = proof_kernel_replay_linear_push_comparison_with_work(nodes, children, node.left, node.operator, node.right, true, facts, &terms, &spans, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not read
            contradiction: bool = proof_kernel_replay_linear_refutes_with_work(terms, spans, work_used)
            return (2, false, root) if contradiction and work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            negated: sview = proof_kernel_replay_linear_negation(node.operator)
            return unknown if negated in {"", "!="}
            entail_terms: mutable darray[ProofKernelReplayNormalTerm] = []
            entail_spans: mutable darray[ProofKernelReplayLinearSpan] = []
            return unknown if not proof_kernel_replay_goal_search_charge_amount(work_used, copied_items)
            entail_terms.extend(base_terms)
            entail_spans.extend(base_spans)
            entail_read: bool = proof_kernel_replay_linear_push_comparison_with_work(nodes, children, node.left, negated, node.right, true, facts, &entail_terms, &entail_spans, work_used)
            return unknown if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not entail_read
            entails: bool = proof_kernel_replay_linear_refutes_with_work(entail_terms, entail_spans, work_used)
            return (1, true, root) if entails and work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            unknown

        def proof_kernel_replay_linear_prune_facts_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], pruned: mutable darray[usize]&, work_used: mutable usize&) -> i64:
            base: mutable darray[usize] = []
            disjunctive: mutable bool = false
            for fact in facts |fact, nodes, base, disjunctive, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                is_or: bool = proof_kernel_replay_linear_is_or_with_goal_work(nodes, fact, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if is_or:
                    disjunctive <- true
                else:
                    return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                    base.push(fact)
            return 0 if:
                not disjunctive
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return 0 if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            signed_bounds: darray[ProofKernelReplayBound] = proof_kernel_replay_signed_safety_bounds_with_goal_work(nodes, children, facts, work_used)
            return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            base_terms: mutable darray[ProofKernelReplayNormalTerm] = []
            base_spans: mutable darray[ProofKernelReplayLinearSpan] = []
            constraints_complete: bool = proof_kernel_replay_linear_fact_constraints_with_work(nodes, children, base, 2, true, signed_bounds, &base_terms, &base_spans, work_used)
            return 0 if not constraints_complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or base_spans.count == 0
            changed: mutable bool = false
            for fact in facts |fact, nodes, children, facts, base_terms, base_spans, signed_bounds, pruned, changed, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                is_or: bool = proof_kernel_replay_linear_is_or_with_goal_work(nodes, fact, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if is_or:
                    result: (truth: i64, changed: bool, root: usize) = proof_kernel_replay_linear_prune_with_goal_work(nodes, children, facts, markers, base_terms, base_spans, signed_bounds, fact, 0, work_used)
                    return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return 2 if result.truth == 2
                    if result.truth == 1:
                        changed <- true
                        continue
                    if result.changed:
                        changed <- true
                        return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                        pruned.push(result.root)
                        continue
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                pruned.push(fact)
            return 1 if changed
            0
