const PROOF_KERNEL_REPLAY_DIVISION_TERM_LIMIT: usize = 2

extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_charge_division_node_with_goal_work(work_used: mutable usize&, kind: sview, operator: sview, name: sview) -> bool:
            return false if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, kind, operator)
            proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(name))

        def proof_kernel_replay_charge_division_nodes_with_goal_work(work_used: mutable usize&, count: usize) -> bool:
            proof_kernel_replay_goal_search_charge_product(work_used, count, 9)

        def proof_kernel_replay_push_division_fact_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, facts: mutable darray[usize]&, operator: sview, left: usize, right: usize, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_charge_division_node_with_goal_work(work_used, "binary", operator, "")
            fact: usize = ElisaProofKernelCore::add_node(nodes, "binary", operator, left, right, 0, 0, 0, 0, "", "")
            return false if fact >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            facts.push(fact)
            true

        # Mirror of `proof_division_goal`: generalize each outermost `a / b` or `a % b` with a
        # non-constant or literal >= 1 signed divisor in a comparison goal to a reserved name, and decide the
        # generalized goal under relational facts whose side conditions replay first:
        # `b >= 1, a >= 0` give `0 <= a % b <= b - 1` and `0 <= a / b <= a`; `b >= 1, a <= 0` give
        # `a <= a / b <= 0`; `b >= 1, x <= b`
        # give `x * K / b <= K` for a literal `K >= 0`. Truncating signed division obeys each for
        # every value the source computes, so instantiating the name back is sound. The unsigned
        # direct quotient upper-bound fragment is checked separately before this signed rule.
        def proof_kernel_replay_division_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or not (goal.operator in {">", ">=", "<", "<=", "==", "!="})
            return true if:
                proof_kernel_replay_unsigned_quotient_window_goal_with_work(nodes, children, facts, goal_root, split_depth, depth, work_used, remaining: remaining - 1)
                proof_kernel_replay_exact_division_reconstruction_goal_with_work(nodes, children, facts, goal_root, split_depth, depth, work_used, remaining: remaining - 1)
                proof_kernel_replay_unsigned_quotient_upper_goal_with_goal_work(nodes, children, facts, goal_root, split_depth, depth, work_used, remaining)
            return false if work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            probe_name: sview = proof_kernel_replay_division_term_name(0)
            return false if not proof_kernel_replay_charge_division_node_with_goal_work(work_used, "ident", "", probe_name)
            probe: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, probe_name, "")
            return false if:
                not proof_kernel_replay_valid(nodes, probe)
                proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, probe, probe, work_used, 0).changed
            for fact in facts |fact, nodes, children, probe, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, probe, probe, work_used, 0).changed
            terms: mutable darray[usize] = []
            proof_kernel_replay_collect_division_terms_with_goal_work(nodes, children, goal_root, &terms, work_used, 0)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                terms.count == 0
            rewritten_goal: mutable usize = goal_root
            rewritten_facts: mutable darray[usize] = []
            for fact in facts |fact, rewritten_facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                rewritten_facts.push(fact)
            added: mutable darray[usize] = []
            # The single term's proven bounds, for the monotone step; `nodes.count` when unset.
            lower_bound: mutable usize = nodes.count
            upper_bound: mutable usize = nodes.count
            for index in 0..<terms.count |index, nodes, children, facts, terms, split_depth, depth, remaining, rewritten_goal, rewritten_facts, added, lower_bound, upper_bound, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                term: usize = terms[index]
                unsigned_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, term, facts, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if unsigned_width != 0
                scalar_witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, term, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not scalar_witnessed
                node: ElisaProofKernelCore::ProofKernelNode = nodes[term]
                return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 4)
                one: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                two: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                zero: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                divisor_positive: usize = ElisaProofKernelCore::add_node(nodes, "binary", ">=", node.right, one, 0, 0, 0, 0, "", "")
                continue if not (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, divisor_positive, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                fresh_name: sview = proof_kernel_replay_division_term_name(index)
                return false if not proof_kernel_replay_charge_division_node_with_goal_work(work_used, "ident", "", fresh_name)
                fresh: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, proof_kernel_replay_division_term_name(index), "")
                return false if:
                    not proof_kernel_replay_valid(nodes, fresh)
                    not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 3)
                dividend_bound: usize = ElisaProofKernelCore::add_node(nodes, "binary", ">=", node.left, zero, 0, 0, 0, 0, "", "")
                dividend_nonnegative: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, dividend_bound, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                dividend_positive_bound: usize = ElisaProofKernelCore::add_node(nodes, "binary", ">", node.left, zero, 0, 0, 0, 0, "", "")
                dividend_positive: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, dividend_positive_bound, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                divisor_two_bound: usize = ElisaProofKernelCore::add_node(nodes, "binary", ">=", node.right, two, 0, 0, 0, 0, "", "")
                divisor_at_least_two: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, divisor_two_bound, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                if node.operator == "%":
                    continue if not dividend_nonnegative
                    return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
                    limit: usize = ElisaProofKernelCore::add_node(nodes, "binary", "-", node.right, one, 0, 0, 0, 0, "", "")
                    return false if:
                        not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, ">=", fresh, zero, work_used)
                        not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, "<=", fresh, limit, work_used)
                    lower_bound <- zero
                    upper_bound <- limit
                else:
                    range: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_division_dividend_range_with_goal_work(nodes, children, facts, node.left, work_used)
                    if dividend_nonnegative:
                        return false if:
                            not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, ">=", fresh, zero, work_used)
                            not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, "<=", fresh, node.left, work_used)
                            dividend_positive and divisor_at_least_two and not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, "<", fresh, node.left, work_used)
                        lower_bound <- zero
                        upper_bound <- node.left
                        if range.has_upper:
                            return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
                            upper: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, range.upper, "", "")
                            return false if not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, "<=", fresh, upper, work_used)
                    else:
                        return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
                        dividend_upper: usize = ElisaProofKernelCore::add_node(nodes, "binary", "<=", node.left, zero, 0, 0, 0, 0, "", "")
                        if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, dividend_upper, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}):
                            return false if:
                                not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, ">=", fresh, node.left, work_used)
                                not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, "<=", fresh, zero, work_used)
                            lower_bound <- node.left
                            upper_bound <- zero
                            if range.has_lower:
                                return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
                                lower: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, range.lower, "", "")
                                return false if not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, ">=", fresh, lower, work_used)
                    scaled: (known: bool, factor: usize, constant: i64) = proof_kernel_replay_division_scaled_with_goal_work(nodes, node.left, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if scaled.known:
                        return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
                        factor_bound: usize = ElisaProofKernelCore::add_node(nodes, "binary", "<=", scaled.factor, node.right, 0, 0, 0, 0, "", "")
                        if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, factor_bound, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}):
                            return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 1)
                            constant: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, scaled.constant, "", "")
                            return false if not proof_kernel_replay_push_division_fact_with_goal_work(nodes, added, "<=", fresh, constant, work_used)
                # The fresh name stands for a primitive scalar of its operands' signed width, as
                # the witnessed term did, so sums over it stay in range.
                signed_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, term, work_used, depth + 1)
                return false if:
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    not proof_kernel_replay_push_fresh_markers_with_goal_work(nodes, children, fresh, signed_width, &added, work_used)
                rewritten_goal <- proof_kernel_replay_replace_exact_with_goal_work(nodes, children, rewritten_goal, term, fresh, work_used, 0).value
                next_facts: mutable darray[usize] = []
                for fact in rewritten_facts |fact, nodes, children, term, fresh, next_facts, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    next_facts.push(proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, term, fresh, work_used, 0).value)
                rewritten_facts <- next_facts
            return false if added.count == 0
            for fact in added |fact, rewritten_facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                rewritten_facts.push(fact)
            return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, rewritten_facts, rewritten_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return terms.count == 1 and proof_kernel_replay_division_monotone(nodes, children, goal_root, terms[0], lower_bound, upper_bound, work_used)

        # Independent replay of the same-width unsigned quotient bound. A positive divisor
        # makes division defined; unsigned floor division cannot exceed its dividend. Typed
        # literal and variable divisor widths are inspected separately to reject mixed-width
        # certificates and signed reinterpretations.
        def proof_kernel_replay_unsigned_quotient_upper_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_unsigned_quotient_upper_goal_with_goal_work(nodes, children, facts, goal_root, split_depth, depth, &work_used, remaining)

        def proof_kernel_replay_unsigned_quotient_upper_goal_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, goal_root) or remaining <= 1
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            quotient: mutable usize = nodes.count
            dividend: mutable usize = nodes.count
            divisor_root: mutable usize = nodes.count
            if goal.operator == "<=":
                parts: (known: bool, dividend: usize, percent: bool, divisor: usize) = proof_kernel_replay_division_parts_with_goal_work(nodes, goal.left, work_used)
                return false if not parts.known or parts.percent or not proof_kernel_replay_goal_search_expr_equal(nodes, children, parts.dividend, goal.right, work_used)
                quotient <- goal.left
                dividend <- parts.dividend
                divisor_root <- parts.divisor
            elif goal.operator == ">=":
                parts: (known: bool, dividend: usize, percent: bool, divisor: usize) = proof_kernel_replay_division_parts_with_goal_work(nodes, goal.right, work_used)
                return false if not parts.known or parts.percent or not proof_kernel_replay_goal_search_expr_equal(nodes, children, parts.dividend, goal.left, work_used)
                quotient <- goal.right
                dividend <- parts.dividend
                divisor_root <- parts.divisor
            else:
                return false
            width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, quotient, facts, work_used, depth + 1)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or proof_kernel_replay_unsigned_width_max(width) == 0
            dividend_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, dividend, facts, work_used, depth + 1)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or dividend_width != width
                not proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, dividend, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                not proof_kernel_replay_unsigned_division_divisor_width_matches_with_goal_work(nodes, children, facts, divisor_root, width, 0, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            divisor_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, divisor_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            typed_divisor_positive: mutable bool = false
            if nodes[divisor_root].kind == "typed-int":
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[divisor_root])
                typed_divisor_positive <- literal.known and literal.unsigned and literal.bits > 0
            return true if divisor_constant.known and divisor_constant.value > 0 or typed_divisor_positive
            proof_kernel_replay_unsigned_positive_divisor_fact_with_goal_work(nodes, children, facts, divisor_root, width, work_used)

        def proof_kernel_replay_unsigned_positive_divisor_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], divisor: usize, width: i64) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_unsigned_positive_divisor_fact_with_goal_work(nodes, children, facts, divisor, width, &work_used)

        def proof_kernel_replay_unsigned_positive_divisor_fact_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], divisor: usize, width: i64, work_used: mutable usize&) -> bool:
            for fact_root in facts |fact_root, nodes, children, divisor, width, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or (fact.operator != ">=" and fact.operator != ">")
                continue if not proof_kernel_replay_goal_search_expr_equal(nodes, children, fact.left, divisor, work_used)
                bound: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, fact.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not bound.known
                if fact.operator == ">=":
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    continue if bound.value != 1
                    lower_bound_fits: bool = proof_kernel_replay_unsigned_literal_bound_fits_with_goal_work(nodes, fact.right, width, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not lower_bound_fits
                    return true
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if bound.value != 0
                strict_bound_fits: bool = proof_kernel_replay_unsigned_literal_bound_fits_with_goal_work(nodes, fact.right, width, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not strict_bound_fits
                return true
            return false

        def proof_kernel_replay_division_parts_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> (known: bool, dividend: usize, percent: bool, divisor: usize):
            empty: (known: bool, dividend: usize, percent: bool, divisor: usize) = (false, 0, false, 0)
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if node.kind != "binary" or (node.operator != "/" and node.operator != "%")
            return (true, node.left, node.operator == "%", node.right)

        def proof_kernel_replay_unsigned_division_divisor_width_matches(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], divisor: usize, width: i64, depth: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_unsigned_division_divisor_width_matches_with_goal_work(nodes, children, facts, divisor, width, depth, &work_used)

        def proof_kernel_replay_unsigned_division_divisor_width_matches_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], divisor: usize, width: i64, depth: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or divisor >= nodes.count or width == 0
                not proof_kernel_replay_goal_search_charge_node_text(nodes, divisor, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[divisor]
            if node.kind == "typed-int":
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(node)
                return literal.known and literal.unsigned and literal.width == width and literal.bits > 0
            if node.kind == "int":
                value: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, divisor, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if:
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not value.known or value.value <= 0
                literal_fits: bool = proof_kernel_replay_unsigned_literal_bound_fits_with_goal_work(nodes, divisor, width, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return literal_fits
            if node.kind == "paren":
                return proof_kernel_replay_unsigned_division_divisor_width_matches_with_goal_work(nodes, children, facts, node.left, width, depth + 1, work_used)
            divisor_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, divisor, facts, work_used, depth + 1)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or divisor_width != width
            proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, divisor, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)

        # Keep report callers on the shared goal meter. The standalone helper below retains its
        # fixed-width safety ceiling for non-report callers.
        def proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&, depth: usize) -> i64:
            proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, root, facts, work_used, depth)

        def proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&, depth: usize) -> i64:
            proof_kernel_replay_signed_width_in_expression_for_interval_with_goal_work(nodes, children, facts, root, work_used, depth)

        # Mirror of `proof_division_monotone`.
        def proof_kernel_replay_division_monotone(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, goal_root: usize, term: usize, lower_bound: usize, upper_bound: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_valid(nodes, lower_bound) or not proof_kernel_replay_valid(nodes, upper_bound)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
            operator: sview = nodes[goal_root].operator
            return false if nodes[goal_root].kind != "binary" or not (operator in {"<=", "<", ">=", ">"})
            marker_name: sview = proof_kernel_replay_division_term_name(0)
            return false if not proof_kernel_replay_charge_division_node_with_goal_work(work_used, "ident", "", marker_name)
            marker: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, marker_name, "")
            return false if not proof_kernel_replay_valid(nodes, marker)
            generalized: usize = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, term, marker, work_used, 0).value
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            sum: (known: bool, coefficient: i64, constant: i64) = proof_kernel_replay_division_linear_sum_with_goal_work(nodes, generalized, marker_name, false, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not sum.known or sum.coefficient == 0
            at_least: bool = operator in {">=", ">"}
            use_upper: bool = sum.coefficient < 0 if at_least else sum.coefficient > 0
            bound: usize = upper_bound if use_upper else lower_bound
            substituted: usize = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, term, bound, work_used, 0).value
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            decided: (known: bool, coefficient: i64, constant: i64) = proof_kernel_replay_division_linear_sum_with_goal_work(nodes, substituted, marker_name, true, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not decided.known or decided.coefficient != 0
            return decided.constant >= 0 if operator == ">="
            return decided.constant > 0 if operator == ">"
            return decided.constant <= 0 if operator == "<="
            return decided.constant < 0

        # Mirror of `proof_division_linear_sum`.
        def proof_kernel_replay_division_linear_sum_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, comparison: usize, marker_name: sview, cancel: bool, work_used: mutable usize&) -> (known: bool, coefficient: i64, constant: i64):
            empty: (known: bool, coefficient: i64, constant: i64) = (false, 0, 0)
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_valid(nodes, comparison)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, comparison, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[comparison].kind != "binary"
            atoms: mutable darray[sview] = []
            coefficients: mutable darray[i64] = []
            constant: mutable i64 = 0
            return empty if:
                not proof_kernel_replay_division_collect_with_goal_work(nodes, nodes[comparison].left, 1, &atoms, &coefficients, &constant, 0, work_used)
                not proof_kernel_replay_division_collect_with_goal_work(nodes, nodes[comparison].right, -1, &atoms, &coefficients, &constant, 0, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            coefficient: mutable i64 = 0
            for index in 0..<atoms.count |index, atoms, coefficients, marker_name, coefficient, work_used, empty|:
                return empty if not proof_kernel_replay_goal_search_charge(work_used)
                coefficient_marker_match: bool = proof_kernel_replay_goal_search_text_equal(atoms[index], marker_name, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                coefficient <- coefficient + coefficients[index] if coefficient_marker_match
            for index in 0..<atoms.count |index, atoms, coefficients, marker_name, cancel, work_used, empty|:
                return empty if not proof_kernel_replay_goal_search_charge(work_used)
                continue if not cancel
                cancellation_marker_match: bool = proof_kernel_replay_goal_search_text_equal(atoms[index], marker_name, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if cancellation_marker_match
                total: mutable i64 = 0
                for other in 0..<atoms.count |other, index, atoms, coefficients, total, work_used, empty|:
                    return empty if not proof_kernel_replay_goal_search_charge(work_used)
                    same_atom: bool = proof_kernel_replay_goal_search_text_equal(atoms[other], atoms[index], work_used)
                    return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    total <- total + coefficients[other] if same_atom
                return empty if total != 0
            (true, coefficient, constant)

        # Mirror of `proof_division_collect`.
        def proof_kernel_replay_division_collect_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, sign: i64, atoms: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= 16
            decreases 16 - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= 16 or atoms.count >= 16 or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_division_collect_with_goal_work(nodes, node.left, sign, atoms, coefficients, constant, depth + 1, work_used) if node.kind == "paren"
            if node.kind == "int":
                return false if node.value < -1000000000000 or node.value > 1000000000000
                constant <- constant + (node.value if sign > 0 else 0 - node.value)
                return constant >= -1000000000000000 and constant <= 1000000000000000
            if node.kind == "ident":
                return false if:
                    node.name == ""
                    not proof_kernel_replay_goal_search_charge_product(work_used, 2, 1)
                atoms.push(node.name)
                coefficients.push(sign)
                return true
            return node.operator == "-" and proof_kernel_replay_division_collect_with_goal_work(nodes, node.left, 0 - sign, atoms, coefficients, constant, depth + 1, work_used) if node.kind == "unary"
            return false if:
                node.kind != "binary" or (node.operator != "+" and node.operator != "-")
                not proof_kernel_replay_division_collect_with_goal_work(nodes, node.left, sign, atoms, coefficients, constant, depth + 1, work_used)
            return proof_kernel_replay_division_collect_with_goal_work(nodes, node.right, sign if node.operator == "+" else 0 - sign, atoms, coefficients, constant, depth + 1, work_used)

        def proof_kernel_replay_division_dividend_range_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], dividend: usize, work_used: mutable usize&) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            empty: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = (false, 0, 0, false, false)
            return empty if not proof_kernel_replay_valid(nodes, dividend)
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, facts, bounds, work_used, empty|:
                return empty if not proof_kernel_replay_goal_search_charge(work_used)
                proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, &bounds, work_used, 0)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return empty if:
                not proof_kernel_replay_close_equalities_with_work(nodes, children, facts, &bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                not proof_kernel_replay_add_signed_type_bounds_with_goal_work(nodes, children, facts, &bounds, work_used)
            proof_kernel_replay_interval_with_goal_work(nodes, children, dividend, bounds, work_used, 0)

        def proof_kernel_replay_add_signed_type_bounds_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, bounds, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info_with_goal_work(nodes, children, fact, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not marker.known
                marker_name: sview = proof_kernel_replay_ident_name(nodes, marker.name_root)
                return false if:
                    not proof_kernel_replay_add_lower_with_work(bounds, marker_name, ElisaProofKernelCore::proof_kernel_signed_width_min(marker.width), work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    not proof_kernel_replay_add_upper_with_work(bounds, marker_name, ElisaProofKernelCore::proof_kernel_signed_width_max(marker.width), work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            true

        def proof_kernel_replay_signed_marker_info_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize, work_used: mutable usize&) -> (known: bool, name_root: usize, width: i64):
            empty: (known: bool, name_root: usize, width: i64) = (false, 0, 0)
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or root >= nodes.count
                not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if:
                node.kind != "call" or node.operator != "" or node.auxiliary != 0 or node.children_count != 2 or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                node.left >= nodes.count or not proof_kernel_replay_valid(nodes, node.left)
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len("__elisa_signed_type_bound"))
                not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                not proof_kernel_replay_ident_matches(nodes, node.left, "__elisa_signed_type_bound")
            first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start)
            second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + 1)
            return empty if:
                not first.known or not second.known or first.value >= nodes.count or second.value >= nodes.count
                not proof_kernel_replay_goal_search_charge_amount(work_used, 2)
                not proof_kernel_replay_valid(nodes, first.value) or not proof_kernel_replay_valid(nodes, second.value)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, first.value, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, second.value, work_used)
                nodes[first.value].kind != "call_arg" or nodes[second.value].kind != "call_arg" or nodes[first.value].name != "" or nodes[first.value].secondary_name != "" or nodes[second.value].name != "" or nodes[second.value].secondary_name != ""
            width: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, nodes[second.value].left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth - 1, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            name_root: usize = nodes[first.value].left
            return empty if:
                name_root >= nodes.count or not proof_kernel_replay_valid(nodes, name_root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, name_root, work_used)
            name_valid: bool = nodes[name_root].kind == "ident" and nodes[name_root].name != ""
            valid_width: bool = ElisaProofKernelCore::proof_kernel_signed_width_valid(width.value)
            return (width.known and valid_width and name_valid, name_root, width.value)

        def proof_kernel_replay_division_term_name(index: usize) -> sview:
            return "__elisa_division_term_0" if index == 0
            "__elisa_division_term_1"

        # `a / b` or `a % b` whose divisor is not an integer constant, or is a literal >= 1.
        def proof_kernel_replay_division_term(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_division_term_with_goal_work(nodes, root, &work_used)

        def proof_kernel_replay_division_term_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if:
                node.kind != "binary" or (node.operator != "/" and node.operator != "%")
                not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, node.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return not constant.known or constant.value >= 1

        # `x * K` or `K * x` with a literal `K >= 0`.
        def proof_kernel_replay_division_scaled_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> (known: bool, factor: usize, constant: i64):
            empty: (known: bool, factor: usize, constant: i64) = (false, root, 0)
            cursor: mutable usize = root
            for step in 0..<4 |cursor, nodes, work_used, empty|:
                return empty if not proof_kernel_replay_goal_search_charge(work_used)
                break if not proof_kernel_replay_valid(nodes, cursor)
                return empty if not proof_kernel_replay_goal_search_charge_node_text(nodes, cursor, work_used)
                break if nodes[cursor].kind != "paren"
                cursor <- nodes[cursor].left
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_valid(nodes, cursor)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, cursor, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[cursor]
            return empty if:
                node.kind != "binary" or node.operator != "*"
                not proof_kernel_replay_goal_search_charge_product(work_used, 2, 1) or not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.right, work_used)
            return (nodes[node.right].value >= 0, node.left, nodes[node.right].value) if nodes[node.right].kind == "int"
            return (nodes[node.left].value >= 0, node.right, nodes[node.left].value) if nodes[node.left].kind == "int"
            empty

        def proof_kernel_replay_collect_division_terms(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, terms: mutable darray[usize]&, depth: usize) -> void:
            work_used: mutable usize = 0
            proof_kernel_replay_collect_division_terms_with_goal_work(nodes, children, root, terms, &work_used, depth)

        def proof_kernel_replay_collect_division_terms_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, terms: mutable darray[usize]&, work_used: mutable usize&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not proof_kernel_replay_goal_search_charge(work_used)
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return if terms.count >= PROOF_KERNEL_REPLAY_DIVISION_TERM_LIMIT or not proof_kernel_replay_valid(nodes, root)
            return if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind in {"paren", "unary"}:
                proof_kernel_replay_collect_division_terms_with_goal_work(nodes, children, node.left, terms, work_used, depth + 1)
            elif node.kind == "binary":
                if proof_kernel_replay_division_term_with_goal_work(nodes, root, work_used):
                    for existing in terms |existing, nodes, children, root, work_used|:
                        equal: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, existing, root, work_used)
                        return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or equal
                    return if not proof_kernel_replay_goal_search_charge(work_used)
                    terms.push(root)
                    return
                proof_kernel_replay_collect_division_terms_with_goal_work(nodes, children, node.left, terms, work_used, depth + 1)
                proof_kernel_replay_collect_division_terms_with_goal_work(nodes, children, node.right, terms, work_used, depth + 1)

        # Mirror of `proof_negated_name_goal`: generalize `-x` for the goal's first negated name
        # `x` to a reserved name bounded by the negated constant range of `x`.
        def proof_kernel_replay_negated_name_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_valid(nodes, goal_root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if:
                goal.kind != "binary" or not (goal.operator in {">", ">=", "<", "<=", "==", "!="})
                not proof_kernel_replay_charge_division_node_with_goal_work(work_used, "ident", "", "__elisa_negated_name")
            fresh: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_negated_name", "")
            return false if:
                not proof_kernel_replay_valid(nodes, fresh)
                proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, fresh, fresh, work_used, 0).changed
            for fact in facts |fact, nodes, children, fresh, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, fresh, fresh, work_used, 0).changed
            term: usize = proof_kernel_replay_negated_name_with_goal_work(nodes, goal_root, work_used, 0)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_valid(nodes, term)
            operand: usize = nodes[term].left
            unsigned_width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, operand, facts, work_used, depth + 1)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or unsigned_width != 0
            scalar_witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, operand, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not scalar_witnessed
            width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, operand, work_used, depth + 1)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            range: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_division_dividend_range_with_goal_work(nodes, children, facts, operand, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not range.has_lower or not range.has_upper
                range.lower <= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN or range.upper <= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN
            rewritten_facts: mutable darray[usize] = []
            for fact in facts |fact, nodes, children, term, fresh, rewritten_facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                rewritten_facts.push(proof_kernel_replay_replace_exact_with_goal_work(nodes, children, fact, term, fresh, work_used, 0).value)
            return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 2)
            lower: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 0 - range.upper, "", "")
            upper: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 0 - range.lower, "", "")
            return false if:
                not proof_kernel_replay_push_division_fact_with_goal_work(nodes, rewritten_facts, ">=", fresh, lower, work_used)
                not proof_kernel_replay_push_division_fact_with_goal_work(nodes, rewritten_facts, "<=", fresh, upper, work_used)
                not proof_kernel_replay_push_fresh_markers_with_goal_work(nodes, children, fresh, width, &rewritten_facts, work_used)
            rewritten_goal: usize = proof_kernel_replay_replace_exact_with_goal_work(nodes, children, goal_root, term, fresh, work_used, 0).value
            return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, rewritten_facts, rewritten_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        # The primitive-scalar marker and, for a nonzero width, the signed type-bound marker.
        def proof_kernel_replay_push_fresh_markers_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, fresh: usize, width: i64, facts: mutable darray[usize]&, work_used: mutable usize&) -> bool:
            primitive_name: sview = "__elisa_primitive_scalar_type"
            return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 3) or not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(primitive_name))
            marker_callee: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
            marker_argument: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", fresh, 0, 0, 0, 0, 0, "", "")
            return false if marker_callee >= nodes.count or marker_argument >= nodes.count
            marker_start: usize = children.count
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            children.push(marker_argument)
            marker_fact: usize = ElisaProofKernelCore::add_node(nodes, "call", "", marker_callee, 0, 0, marker_start, 1, 0, "", "")
            return false if marker_fact >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            facts.push(marker_fact)
            return true if width == 0
            width_name: sview = "__elisa_signed_type_bound"
            return false if not proof_kernel_replay_charge_division_nodes_with_goal_work(work_used, 5) or not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(width_name))
            width_callee: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_signed_type_bound", "")
            width_value: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, width, "", "")
            width_term: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", fresh, 0, 0, 0, 0, 0, "", "")
            width_argument: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", width_value, 0, 0, 0, 0, 0, "", "")
            return false if width_callee >= nodes.count or width_value >= nodes.count or width_term >= nodes.count or width_argument >= nodes.count
            width_start: usize = children.count
            return false if not proof_kernel_replay_goal_search_charge_product(work_used, 3, 1)
            children.push(width_term)
            children.push(width_argument)
            width_fact: usize = ElisaProofKernelCore::add_node(nodes, "call", "", width_callee, 0, 0, width_start, 2, 0, "", "")
            return false if width_fact >= nodes.count
            facts.push(width_fact)
            true
