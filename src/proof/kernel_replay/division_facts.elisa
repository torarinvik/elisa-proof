const PROOF_KERNEL_REPLAY_DIVISION_TERM_LIMIT: usize = 2

extend ElisaProofKernelReplay:
    private:
        # Mirror of `proof_division_goal`: generalize each outermost `a / b` or `a % b` with a
        # non-constant or literal >= 1 signed divisor in a comparison goal to a reserved name, and decide the
        # generalized goal under relational facts whose side conditions replay first:
        # `b >= 1, a >= 0` give `0 <= a % b <= b - 1` and `0 <= a / b <= a`; `b >= 1, a <= 0` give
        # `a <= a / b <= 0`; `b >= 1, x <= b`
        # give `x * K / b <= K` for a literal `K >= 0`. Truncating signed division obeys each for
        # every value the source computes, so instantiating the name back is sound. The unsigned
        # direct quotient upper-bound fragment is checked separately before this signed rule.
        def proof_kernel_replay_division_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or not (goal.operator == ">" or goal.operator == ">=" or goal.operator == "<" or goal.operator == "<=" or goal.operator == "==" or goal.operator == "!=")
            return true if proof_kernel_replay_unsigned_quotient_upper_goal(nodes, children, facts, goal_root, split_depth, depth, remaining)
            probe: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, proof_kernel_replay_division_term_name(0), "")
            return false if not proof_kernel_replay_valid(nodes, probe)
            return false if proof_kernel_replay_replace_exact(nodes, children, goal_root, probe, probe, 0).changed
            for fact in facts |fact, nodes, children, probe|:
                return false if proof_kernel_replay_replace_exact(nodes, children, fact, probe, probe, 0).changed
            terms: mutable darray[usize] = []
            proof_kernel_replay_collect_division_terms(nodes, children, goal_root, &terms, 0)
            return false if terms.count == 0
            rewritten_goal: mutable usize = goal_root
            rewritten_facts: mutable darray[usize] = []
            for fact in facts |fact, rewritten_facts|:
                rewritten_facts.push(fact)
            added: mutable darray[usize] = []
            # The single term's proven bounds, for the monotone step; `nodes.count` when unset.
            lower_bound: mutable usize = nodes.count
            upper_bound: mutable usize = nodes.count
            for index in 0..<terms.count |index, nodes, children, facts, terms, split_depth, depth, remaining, rewritten_goal, rewritten_facts, added, lower_bound, upper_bound|:
                term: usize = terms[index]
                continue if proof_kernel_replay_unsigned_width_in_expression(nodes, children, term, facts, depth + 1) != 0 or not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, term, 0)
                node: ElisaProofKernelCore::ProofKernelNode = nodes[term]
                one: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                two: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                zero: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                divisor_positive: usize = ElisaProofKernelCore::add_node(nodes, "binary", ">=", node.right, one, 0, 0, 0, 0, "", "")
                continue if not proof_kernel_replay_goal_depth_remaining(nodes, children, facts, divisor_positive, split_depth + 1, depth + 1, remaining: remaining - 1)
                fresh: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, proof_kernel_replay_division_term_name(index), "")
                dividend_bound: usize = ElisaProofKernelCore::add_node(nodes, "binary", ">=", node.left, zero, 0, 0, 0, 0, "", "")
                dividend_nonnegative: bool = proof_kernel_replay_goal_depth_remaining(nodes, children, facts, dividend_bound, split_depth + 1, depth + 1, remaining: remaining - 1)
                dividend_positive_bound: usize = ElisaProofKernelCore::add_node(nodes, "binary", ">", node.left, zero, 0, 0, 0, 0, "", "")
                dividend_positive: bool = proof_kernel_replay_goal_depth_remaining(nodes, children, facts, dividend_positive_bound, split_depth + 1, depth + 1, remaining: remaining - 1)
                divisor_two_bound: usize = ElisaProofKernelCore::add_node(nodes, "binary", ">=", node.right, two, 0, 0, 0, 0, "", "")
                divisor_at_least_two: bool = proof_kernel_replay_goal_depth_remaining(nodes, children, facts, divisor_two_bound, split_depth + 1, depth + 1, remaining: remaining - 1)
                if node.operator == "%":
                    continue if not dividend_nonnegative
                    limit: usize = ElisaProofKernelCore::add_node(nodes, "binary", "-", node.right, one, 0, 0, 0, 0, "", "")
                    added.push(ElisaProofKernelCore::add_node(nodes, "binary", ">=", fresh, zero, 0, 0, 0, 0, "", ""))
                    added.push(ElisaProofKernelCore::add_node(nodes, "binary", "<=", fresh, limit, 0, 0, 0, 0, "", ""))
                    lower_bound <- zero
                    upper_bound <- limit
                else:
                    range: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_division_dividend_range(nodes, children, facts, node.left)
                    if dividend_nonnegative:
                        added.push(ElisaProofKernelCore::add_node(nodes, "binary", ">=", fresh, zero, 0, 0, 0, 0, "", ""))
                        added.push(ElisaProofKernelCore::add_node(nodes, "binary", "<=", fresh, node.left, 0, 0, 0, 0, "", ""))
                        added.push(ElisaProofKernelCore::add_node(nodes, "binary", "<", fresh, node.left, 0, 0, 0, 0, "", "")) if dividend_positive and divisor_at_least_two
                        lower_bound <- zero
                        upper_bound <- node.left
                        if range.has_upper:
                            upper: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, range.upper, "", "")
                            added.push(ElisaProofKernelCore::add_node(nodes, "binary", "<=", fresh, upper, 0, 0, 0, 0, "", ""))
                    else:
                        dividend_upper: usize = ElisaProofKernelCore::add_node(nodes, "binary", "<=", node.left, zero, 0, 0, 0, 0, "", "")
                        if proof_kernel_replay_goal_depth_remaining(nodes, children, facts, dividend_upper, split_depth + 1, depth + 1, remaining: remaining - 1):
                            added.push(ElisaProofKernelCore::add_node(nodes, "binary", ">=", fresh, node.left, 0, 0, 0, 0, "", ""))
                            added.push(ElisaProofKernelCore::add_node(nodes, "binary", "<=", fresh, zero, 0, 0, 0, 0, "", ""))
                            lower_bound <- node.left
                            upper_bound <- zero
                            if range.has_lower:
                                lower: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, range.lower, "", "")
                                added.push(ElisaProofKernelCore::add_node(nodes, "binary", ">=", fresh, lower, 0, 0, 0, 0, "", ""))
                    scaled: (known: bool, factor: usize, constant: i64) = proof_kernel_replay_division_scaled(nodes, node.left)
                    if scaled.known:
                        factor_bound: usize = ElisaProofKernelCore::add_node(nodes, "binary", "<=", scaled.factor, node.right, 0, 0, 0, 0, "", "")
                        if proof_kernel_replay_goal_depth_remaining(nodes, children, facts, factor_bound, split_depth + 1, depth + 1, remaining: remaining - 1):
                            constant: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, scaled.constant, "", "")
                            added.push(ElisaProofKernelCore::add_node(nodes, "binary", "<=", fresh, constant, 0, 0, 0, 0, "", ""))
                # The fresh name stands for a primitive scalar of its operands' signed width, as
                # the witnessed term did, so sums over it stay in range.
                proof_kernel_replay_push_fresh_markers(nodes, children, fresh, proof_kernel_replay_signed_width_in_expression(nodes, children, facts, term, depth + 1), &added)
                rewritten_goal <- proof_kernel_replay_replace_exact(nodes, children, rewritten_goal, term, fresh, 0).value
                next_facts: mutable darray[usize] = []
                for fact in rewritten_facts |fact, nodes, children, term, fresh, next_facts|:
                    next_facts.push(proof_kernel_replay_replace_exact(nodes, children, fact, term, fresh, 0).value)
                rewritten_facts <- next_facts
            return false if added.count == 0
            for fact in added |fact, rewritten_facts|:
                rewritten_facts.push(fact)
            return true if proof_kernel_replay_goal_depth_remaining(nodes, children, rewritten_facts, rewritten_goal, split_depth + 1, depth + 1, remaining: remaining - 1)
            return terms.count == 1 and proof_kernel_replay_division_monotone(nodes, children, goal_root, terms[0], lower_bound, upper_bound)

        # Independent replay of the same-width unsigned quotient bound. A positive divisor
        # makes division defined; unsigned floor division cannot exceed its dividend. Typed
        # literal and variable divisor widths are inspected separately to reject mixed-width
        # certificates and signed reinterpretations.
        def proof_kernel_replay_unsigned_quotient_upper_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, goal_root) or remaining <= 1
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            quotient: mutable usize = nodes.count
            dividend: mutable usize = nodes.count
            divisor_root: mutable usize = nodes.count
            if goal.operator == "<=":
                parts: (known: bool, dividend: usize, percent: bool, divisor: usize) = proof_kernel_replay_division_parts(nodes, goal.left)
                return false if not parts.known or parts.percent or not proof_kernel_replay_expr_equal(nodes, children, parts.dividend, goal.right, 0)
                quotient <- goal.left
                dividend <- parts.dividend
                divisor_root <- parts.divisor
            elif goal.operator == ">=":
                parts: (known: bool, dividend: usize, percent: bool, divisor: usize) = proof_kernel_replay_division_parts(nodes, goal.right)
                return false if not parts.known or parts.percent or not proof_kernel_replay_expr_equal(nodes, children, parts.dividend, goal.left, 0)
                quotient <- goal.right
                dividend <- parts.dividend
                divisor_root <- parts.divisor
            else:
                return false
            width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, quotient, facts, depth + 1)
            return false if proof_kernel_replay_unsigned_width_max(width) == 0 or proof_kernel_replay_unsigned_width_in_expression(nodes, children, dividend, facts, depth + 1) != width
            return false if not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, dividend, 0)
            return false if not proof_kernel_replay_unsigned_division_divisor_width_matches(nodes, children, facts, divisor_root, width, 0)
            divisor_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, divisor_root, 0)
            typed_divisor_positive: mutable bool = false
            if nodes[divisor_root].kind == "typed-int":
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(nodes[divisor_root])
                typed_divisor_positive <- literal.known and literal.unsigned and literal.bits > 0
            return true if divisor_constant.known and divisor_constant.value > 0 or typed_divisor_positive
            return proof_kernel_replay_unsigned_positive_divisor_fact(nodes, children, facts, divisor_root, width)

        def proof_kernel_replay_unsigned_positive_divisor_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], divisor: usize, width: i64) -> bool:
            for fact_root in facts |fact_root, nodes, children, divisor, width|:
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or (fact.operator != ">=" and fact.operator != ">")
                continue if not proof_kernel_replay_expr_equal(nodes, children, fact.left, divisor, 0)
                bound: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, fact.right, 0)
                continue if not bound.known
                if fact.operator == ">=":
                    continue if bound.value != 1 or not proof_kernel_replay_unsigned_literal_bound_fits(nodes, fact.right, width)
                    return true
                continue if bound.value != 0 or not proof_kernel_replay_unsigned_literal_bound_fits(nodes, fact.right, width)
                return true
            return false

        def proof_kernel_replay_division_parts(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, dividend: usize, percent: bool, divisor: usize):
            return (false, 0, false, 0) if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, false, 0) if node.kind != "binary" or (node.operator != "/" and node.operator != "%")
            return (true, node.left, node.operator == "%", node.right)

        def proof_kernel_replay_unsigned_division_divisor_width_matches(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], divisor: usize, width: i64, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or divisor >= nodes.count or width == 0
            node: ElisaProofKernelCore::ProofKernelNode = nodes[divisor]
            if node.kind == "typed-int":
                literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(node)
                return literal.known and literal.unsigned and literal.width == width and literal.bits > 0
            if node.kind == "int":
                value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, divisor, 0)
                return value.known and value.value > 0 and proof_kernel_replay_unsigned_literal_bound_fits(nodes, divisor, width)
            if node.kind == "paren":
                return proof_kernel_replay_unsigned_division_divisor_width_matches(nodes, children, facts, node.left, width, depth + 1)
            return proof_kernel_replay_unsigned_width_in_expression(nodes, children, divisor, facts, depth + 1) == width and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, divisor, 0)

        # Mirror of `proof_division_monotone`.
        def proof_kernel_replay_division_monotone(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, goal_root: usize, term: usize, lower_bound: usize, upper_bound: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_valid(nodes, lower_bound) or not proof_kernel_replay_valid(nodes, upper_bound)
            operator: sview = nodes[goal_root].operator
            return false if nodes[goal_root].kind != "binary" or not (operator == "<=" or operator == "<" or operator == ">=" or operator == ">")
            marker: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, proof_kernel_replay_division_term_name(0), "")
            generalized: usize = proof_kernel_replay_replace_exact(nodes, children, goal_root, term, marker, 0).value
            sum: (known: bool, coefficient: i64, constant: i64) = proof_kernel_replay_division_linear_sum(nodes, generalized, proof_kernel_replay_division_term_name(0), false)
            return false if not sum.known or sum.coefficient == 0
            at_least: bool = operator == ">=" or operator == ">"
            use_upper: bool = sum.coefficient < 0 if at_least else sum.coefficient > 0
            bound: usize = upper_bound if use_upper else lower_bound
            substituted: usize = proof_kernel_replay_replace_exact(nodes, children, goal_root, term, bound, 0).value
            decided: (known: bool, coefficient: i64, constant: i64) = proof_kernel_replay_division_linear_sum(nodes, substituted, proof_kernel_replay_division_term_name(0), true)
            return false if not decided.known or decided.coefficient != 0
            return decided.constant >= 0 if operator == ">="
            return decided.constant > 0 if operator == ">"
            return decided.constant <= 0 if operator == "<="
            return decided.constant < 0

        # Mirror of `proof_division_linear_sum`.
        def proof_kernel_replay_division_linear_sum(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, comparison: usize, marker_name: sview, cancel: bool) -> (known: bool, coefficient: i64, constant: i64):
            return (false, 0, 0) if not proof_kernel_replay_valid(nodes, comparison) or nodes[comparison].kind != "binary"
            atoms: mutable darray[sview] = []
            coefficients: mutable darray[i64] = []
            constant: mutable i64 = 0
            return (false, 0, 0) if not proof_kernel_replay_division_collect(nodes, nodes[comparison].left, 1, &atoms, &coefficients, &constant, 0)
            return (false, 0, 0) if not proof_kernel_replay_division_collect(nodes, nodes[comparison].right, -1, &atoms, &coefficients, &constant, 0)
            coefficient: mutable i64 = 0
            for index in 0..<atoms.count |index, atoms, coefficients, marker_name, coefficient|:
                coefficient <- coefficient + coefficients[index] if atoms[index] == marker_name
            for index in 0..<atoms.count |index, atoms, coefficients, marker_name, cancel|:
                continue if not cancel or atoms[index] == marker_name
                total: mutable i64 = 0
                for other in 0..<atoms.count |other, index, atoms, coefficients, total|:
                    total <- total + coefficients[other] if atoms[other] == atoms[index]
                return (false, 0, 0) if total != 0
            return (true, coefficient, constant)

        # Mirror of `proof_division_collect`.
        def proof_kernel_replay_division_collect(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, sign: i64, atoms: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&, depth: usize) -> bool:
            requires depth <= 16
            decreases 16 - depth
            return false if depth >= 16 or atoms.count >= 16 or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_division_collect(nodes, node.left, sign, atoms, coefficients, constant, depth + 1) if node.kind == "paren"
            if node.kind == "int":
                return false if node.value < -1000000000000 or node.value > 1000000000000
                constant <- constant + (node.value if sign > 0 else 0 - node.value)
                return constant >= -1000000000000000 and constant <= 1000000000000000
            if node.kind == "ident":
                return false if node.name == ""
                atoms.push(node.name)
                coefficients.push(sign)
                return true
            return node.operator == "-" and proof_kernel_replay_division_collect(nodes, node.left, 0 - sign, atoms, coefficients, constant, depth + 1) if node.kind == "unary"
            return false if node.kind != "binary" or (node.operator != "+" and node.operator != "-")
            return false if not proof_kernel_replay_division_collect(nodes, node.left, sign, atoms, coefficients, constant, depth + 1)
            return proof_kernel_replay_division_collect(nodes, node.right, sign if node.operator == "+" else 0 - sign, atoms, coefficients, constant, depth + 1)

        # Mirror of `proof_division_dividend_range`.
        def proof_kernel_replay_division_dividend_range(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], dividend: usize) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            proof_kernel_replay_add_signed_type_bounds(nodes, children, facts, &bounds)
            return proof_kernel_replay_interval(nodes, children, dividend, bounds, 0)

        def proof_kernel_replay_division_term_name(index: usize) -> sview:
            return "__elisa_division_term_0" if index == 0
            "__elisa_division_term_1"

        # `a / b` or `a % b` whose divisor is not an integer constant, or is a literal >= 1.
        def proof_kernel_replay_division_term(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if node.kind != "binary" or (node.operator != "/" and node.operator != "%")
            return false if not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
            return not constant.known or constant.value >= 1

        # `x * K` or `K * x` with a literal `K >= 0`.
        def proof_kernel_replay_division_scaled(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, factor: usize, constant: i64):
            cursor: mutable usize = root
            for step in 0..<4 |cursor, nodes|:
                break if not proof_kernel_replay_valid(nodes, cursor) or nodes[cursor].kind != "paren"
                cursor <- nodes[cursor].left
            return (false, root, 0) if not proof_kernel_replay_valid(nodes, cursor)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[cursor]
            return (false, root, 0) if node.kind != "binary" or node.operator != "*"
            return (false, root, 0) if not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right)
            return (nodes[node.right].value >= 0, node.left, nodes[node.right].value) if nodes[node.right].kind == "int"
            return (nodes[node.left].value >= 0, node.right, nodes[node.left].value) if nodes[node.left].kind == "int"
            return (false, root, 0)

        def proof_kernel_replay_collect_division_terms(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, terms: mutable darray[usize]&, depth: usize) -> void:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return if terms.count >= PROOF_KERNEL_REPLAY_DIVISION_TERM_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren" or node.kind == "unary":
                proof_kernel_replay_collect_division_terms(nodes, children, node.left, terms, depth + 1)
            elif node.kind == "binary":
                if proof_kernel_replay_division_term(nodes, root):
                    for existing in terms |existing, nodes, children, root|:
                        return if proof_kernel_replay_expr_equal(nodes, children, existing, root, 0)
                    terms.push(root)
                    return
                proof_kernel_replay_collect_division_terms(nodes, children, node.left, terms, depth + 1)
                proof_kernel_replay_collect_division_terms(nodes, children, node.right, terms, depth + 1)

        # Mirror of `proof_negated_name_goal`: generalize `-x` for the goal's first negated name
        # `x` to a reserved name bounded by the negated constant range of `x`.
        def proof_kernel_replay_negated_name_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT or remaining <= 1
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if goal.kind != "binary" or not (goal.operator == ">" or goal.operator == ">=" or goal.operator == "<" or goal.operator == "<=" or goal.operator == "==" or goal.operator == "!=")
            fresh: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_negated_name", "")
            return false if not proof_kernel_replay_valid(nodes, fresh)
            return false if proof_kernel_replay_replace_exact(nodes, children, goal_root, fresh, fresh, 0).changed
            for fact in facts |fact, nodes, children, fresh|:
                return false if proof_kernel_replay_replace_exact(nodes, children, fact, fresh, fresh, 0).changed
            term: usize = proof_kernel_replay_negated_name(nodes, goal_root, 0)
            return false if not proof_kernel_replay_valid(nodes, term)
            operand: usize = nodes[term].left
            return false if proof_kernel_replay_unsigned_width_in_expression(nodes, children, operand, facts, depth + 1) != 0 or not proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, operand, 0)
            width: i64 = proof_kernel_replay_signed_width_in_expression(nodes, children, facts, operand, depth + 1)
            range: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_division_dividend_range(nodes, children, facts, operand)
            return false if width == 0 or not range.has_lower or not range.has_upper
            return false if range.lower <= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN or range.upper <= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN
            rewritten_facts: mutable darray[usize] = []
            for fact in facts |fact, nodes, children, term, fresh, rewritten_facts|:
                rewritten_facts.push(proof_kernel_replay_replace_exact(nodes, children, fact, term, fresh, 0).value)
            lower: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 0 - range.upper, "", "")
            upper: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 0 - range.lower, "", "")
            rewritten_facts.push(ElisaProofKernelCore::add_node(nodes, "binary", ">=", fresh, lower, 0, 0, 0, 0, "", ""))
            rewritten_facts.push(ElisaProofKernelCore::add_node(nodes, "binary", "<=", fresh, upper, 0, 0, 0, 0, "", ""))
            proof_kernel_replay_push_fresh_markers(nodes, children, fresh, width, &rewritten_facts)
            rewritten_goal: usize = proof_kernel_replay_replace_exact(nodes, children, goal_root, term, fresh, 0).value
            return proof_kernel_replay_goal_depth_remaining(nodes, children, rewritten_facts, rewritten_goal, split_depth + 1, depth + 1, remaining: remaining - 1)

        # The primitive-scalar marker and, for a nonzero width, the signed type-bound marker.
        def proof_kernel_replay_push_fresh_markers(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, fresh: usize, width: i64, facts: mutable darray[usize]&) -> void:
            marker_callee: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
            marker_argument: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", fresh, 0, 0, 0, 0, 0, "", "")
            marker_start: usize = children.count
            children.push(marker_argument)
            facts.push(ElisaProofKernelCore::add_node(nodes, "call", "", marker_callee, 0, 0, marker_start, 1, 0, "", ""))
            return if width == 0
            width_callee: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_signed_type_bound", "")
            width_value: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, width, "", "")
            width_term: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", fresh, 0, 0, 0, 0, 0, "", "")
            width_argument: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", width_value, 0, 0, 0, 0, 0, "", "")
            width_start: usize = children.count
            children.push(width_term)
            children.push(width_argument)
            facts.push(ElisaProofKernelCore::add_node(nodes, "call", "", width_callee, 0, 0, width_start, 2, 0, "", ""))

        # The first `-x` node over a name in the expression, in pre-order; `nodes.count` if none.
        def proof_kernel_replay_negated_name(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> usize:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return nodes.count if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary" and node.operator == "-" and proof_kernel_replay_valid(nodes, node.left) and nodes[node.left].kind == "ident" and nodes[node.left].name != "":
                return root
            return proof_kernel_replay_negated_name(nodes, node.left, depth + 1) if node.kind == "paren" or node.kind == "unary"
            return nodes.count if node.kind != "binary"
            found: usize = proof_kernel_replay_negated_name(nodes, node.left, depth + 1)
            return found if found < nodes.count
            return proof_kernel_replay_negated_name(nodes, node.right, depth + 1)
