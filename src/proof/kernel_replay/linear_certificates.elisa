# Replay of the producer's linear certificates (BACKLOG C-02/C-03). The marker fact
# `__elisa_linear_certificate(m_goal, premise_1, m_1, ...)` is untrusted: each premise must equal a
# fact, each inequality multiplier be non-negative, and the weighted constraints `e <= 0` -- the
# goal's negation first -- must cancel every name and leave a positive constant.
const module ProofKernelReplayLinearLimit:
    PREMISES: usize = 15
    MULTIPLIER: i64 = 1048576
