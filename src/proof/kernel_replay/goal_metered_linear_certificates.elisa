extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_linear_term_with_goal_work(name: sview, coefficient: i64, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, work_used: mutable usize&) -> bool:
            index: mutable usize = 0
            while index < names.count |index, names, name, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                same: bool = proof_kernel_replay_normalized_name_equal_with_work(names[index], name, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                break if same
                index <- index + 1
            if index == names.count:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                names.push(name)
                coefficients.push(0)
            return false if index >= coefficients.count
            sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(coefficients[index], coefficient)
            return false if not sum.known or not proof_kernel_replay_goal_search_charge(work_used)
            coefficients[index] <- sum.value
            true

        def proof_kernel_replay_linear_add_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, offset: i64, multiplier: i64, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&, work_used: mutable usize&) -> bool:
            terms: mutable darray[ProofKernelReplayNormalTerm] = []
            signed: bool = proof_kernel_replay_normal_comparison_signed_with_work(nodes, children, left, right, facts, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_collect_normal_terms_with_work(nodes, children, left, 1, signed, facts, &terms, work_used, 0)
                not proof_kernel_replay_collect_normal_terms_with_work(nodes, children, right, -1, signed, facts, &terms, work_used, 0)
                not proof_kernel_replay_goal_search_charge(work_used)
            terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: offset})
            for term in terms |term, multiplier, names, coefficients, constant, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                product: ProofKernelReplayInt = proof_kernel_replay_mul_safe(term.coefficient, multiplier)
                return false if not product.known
                if proof_kernel_replay_normalized_name_equal_with_work(term.name, "", work_used):
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(constant, product.value)
                    return false if not sum.known or not proof_kernel_replay_goal_search_charge(work_used)
                    constant <- sum.value
                else:
                    return false if:
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        not proof_kernel_replay_linear_term_with_goal_work(term.name, product.value, names, coefficients, work_used)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT

        def proof_kernel_replay_linear_constraint_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, multiplier: i64, negate: bool, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary":
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not primitive
                relation: mutable sview = node.operator
                if negate:
                    return false if node.operator == "=="
                    relation <- ">" if node.operator == "<="
                    relation <- ">=" if node.operator == "<"
                    relation <- "<" if node.operator == ">="
                    relation <- "<=" if node.operator == ">"
                return false if multiplier < 0 and relation != "=="
                return proof_kernel_replay_linear_add_with_goal_work(nodes, children, facts, node.left, node.right, 0, multiplier, names, coefficients, constant, work_used) if relation in {"<=", "=="}
                return proof_kernel_replay_linear_add_with_goal_work(nodes, children, facts, node.left, node.right, 1, multiplier, names, coefficients, constant, work_used) if relation == "<"
                return proof_kernel_replay_linear_add_with_goal_work(nodes, children, facts, node.right, node.left, 0, multiplier, names, coefficients, constant, work_used) if relation == ">="
                return proof_kernel_replay_linear_add_with_goal_work(nodes, children, facts, node.right, node.left, 1, multiplier, names, coefficients, constant, work_used) if relation == ">"
                return false
            return false if negate or multiplier < 0
            marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info_with_goal_work(nodes, children, root, 0, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not marker.known or marker.name_root >= nodes.count
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, marker.name_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[marker.name_root].kind != "ident"
            proof_kernel_replay_linear_term_with_goal_work(nodes[marker.name_root].name, 0 - multiplier, names, coefficients, work_used)

        def proof_kernel_replay_linear_multiplier_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            value: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return ProofKernelReplayInt{known: false, value: 0} if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not value.known or value.value > ProofKernelReplayLinearLimit::MULTIPLIER or value.value < 0 - ProofKernelReplayLinearLimit::MULTIPLIER
            value

        def proof_kernel_replay_linear_argument_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, call: ElisaProofKernelCore::ProofKernelNode, offset: usize, work_used: mutable usize&) -> (known: bool, root: usize):
            return (false, 0) if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count) or offset >= call.children_count
            slot: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + offset)
            return (false, 0) if:
                not slot.known or slot.value >= nodes.count or not proof_kernel_replay_valid(nodes, slot.value)
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, slot.value, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            argument: ElisaProofKernelCore::ProofKernelNode = nodes[slot.value]
            return (false, 0) if argument.kind != "call_arg" or argument.name != "" or argument.secondary_name != "" or argument.left >= nodes.count or not proof_kernel_replay_valid(nodes, argument.left)
            return (true, argument.left)

        def proof_kernel_replay_linear_closes_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], certificate: usize, goal_root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                certificate >= nodes.count or not proof_kernel_replay_valid(nodes, certificate) or not proof_kernel_replay_goal_search_charge_node_text(nodes, certificate, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            call: ElisaProofKernelCore::ProofKernelNode = nodes[certificate]
            return false if:
                call.operator != "" or call.auxiliary != 0 or call.children_count % 2 != 1 or call.children_count > 1 + 2 * ProofKernelReplayLinearLimit::PREMISES
                not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count)
            names: mutable darray[sview] = []
            coefficients: mutable darray[i64] = []
            constant: mutable i64 = 0
            first: (known: bool, root: usize) = proof_kernel_replay_linear_argument_with_goal_work(nodes, children, call, 0, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not first.known
            goal_multiplier: ProofKernelReplayInt = proof_kernel_replay_linear_multiplier_with_goal_work(nodes, first.root, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not goal_multiplier.known or goal_multiplier.value <= 0
                not proof_kernel_replay_linear_constraint_with_goal_work(nodes, children, facts, goal_root, goal_multiplier.value, true, &names, &coefficients, &constant, work_used)
            index: mutable usize = 1
            while index + 1 < call.children_count |index, nodes, children, facts, call, names, coefficients, constant, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                premise: (known: bool, root: usize) = proof_kernel_replay_linear_argument_with_goal_work(nodes, children, call, index, work_used)
                weight: (known: bool, root: usize) = proof_kernel_replay_linear_argument_with_goal_work(nodes, children, call, index + 1, work_used)
                index <- index + 2
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not premise.known or not weight.known
                multiplier: ProofKernelReplayInt = proof_kernel_replay_linear_multiplier_with_goal_work(nodes, weight.root, work_used)
                return false if:
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not multiplier.known or proof_kernel_replay_linear_marker_with_work(nodes, premise.root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                present: mutable bool = false
                for fact in facts |fact, premise, present, nodes, children, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                    same: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact, premise.root, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    present <- true if same
                    break if present
                return false if not present or not proof_kernel_replay_linear_constraint_with_goal_work(nodes, children, facts, premise.root, multiplier.value, false, &names, &coefficients, &constant, work_used)
            for coefficient in coefficients |coefficient, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    coefficient != 0
            constant > 0

        def proof_kernel_replay_linear_certificate_goal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or proof_kernel_replay_linear_marker_with_work(nodes, goal_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts |fact, nodes, children, facts, goal_root, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                is_certificate: bool = proof_kernel_replay_linear_marker_with_work(nodes, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if is_certificate and proof_kernel_replay_linear_closes_with_goal_work(nodes, children, facts, fact, goal_root, work_used)
            false
