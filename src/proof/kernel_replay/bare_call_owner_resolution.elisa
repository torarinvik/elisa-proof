# Resolve bare-call owners and local shadows recorded in a proposition environment.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_symbol_name(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize, work: mutable usize&) -> sview:
            return "" if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or root >= nodes.count
            return "" if not proof_kernel_replay_type_work_consume(work)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return node.name if node.kind == "ident" or node.kind == "scope"
            return proof_kernel_replay_symbol_name(nodes, node.left, depth + 1, work) if node.kind == "paren"
            return ""

        def proof_kernel_replay_call_owner_identity(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, callee_root: usize, depth: usize, work: mutable usize&) -> (known: bool, identity: usize):
            return (false, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or callee_root >= nodes.count
            callee: ElisaProofKernelCore::ProofKernelNode = nodes[callee_root]
            if callee.kind == "paren":
                return proof_kernel_replay_call_owner_identity(nodes, environment, typing_index, callee.left, depth + 1, work)
            if callee.kind == "scope":
                identity: usize = proof_kernel_replay_scope_owner_identity(nodes, environment, typing_index.owner_path_index, callee.left, work)
                return (identity != 0, identity)
            if callee.kind == "ident":
                lookup: (known: bool, present: bool, identity: usize) = proof_kernel_replay_call_owner_lookup(environment, typing_index.call_binding_count, typing_index.scoped_local_binding_count, typing_index.value_overlay_start, typing_index.value_overlay_count, callee.name, typing_index.call_owner_name_hashes, typing_index.call_owner_name_slots, typing_index.call_owner_name_ids, typing_index.call_owner_marker_counts, typing_index.call_owner_shadowed, typing_index.call_owner_name_capacity, work)
                return (false, 0) if not lookup.known
                return (lookup.present, lookup.identity)
            return (false, 0)
