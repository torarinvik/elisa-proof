extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_comparison_complement(operator: sview) -> sview:
            return "!=" if operator == "=="
            return "==" if operator == "!="
            return ">=" if operator == "<"
            return "<" if operator == ">="
            return ">" if operator == "<="
            return "<=" if operator == ">"
            return ""

        def proof_kernel_replay_comparison_disjunct_shape(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, left: usize, operator: sview, right: usize):
            return (false, 0, "", 0) if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and proof_kernel_replay_comparison_complement(node.operator) != "":
                return (true, node.left, node.operator, node.right)
            if node.kind == "unary" and node.operator == "not" and node.left < nodes.count:
                inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                if inner.kind == "binary":
                    complement: sview = proof_kernel_replay_comparison_complement(inner.operator)
                    return (true, inner.left, complement, inner.right) if complement != ""
            return (false, 0, "", 0)

        def proof_kernel_replay_disjunct_terms_equivalent(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize) -> bool:
            return true if proof_kernel_replay_expr_equal(nodes, children, left, right, 0)
            for fact_root in facts:
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                if fact.kind == "binary" and fact.operator == "==":
                    return true if proof_kernel_replay_expr_equal(nodes, children, left, fact.left, 0) and proof_kernel_replay_expr_equal(nodes, children, right, fact.right, 0)
                    return true if proof_kernel_replay_expr_equal(nodes, children, left, fact.right, 0) and proof_kernel_replay_expr_equal(nodes, children, right, fact.left, 0)
            return false

        def proof_kernel_replay_disjunct_atoms_equivalent(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize) -> bool:
            return true if proof_kernel_replay_disjunct_terms_equivalent(nodes, children, facts, left, right)
            first: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape(nodes, left)
            second: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape(nodes, right)
            return first.known and second.known and first.operator == second.operator and proof_kernel_replay_disjunct_terms_equivalent(nodes, children, facts, first.left, second.left) and proof_kernel_replay_disjunct_terms_equivalent(nodes, children, facts, first.right, second.right)

        def proof_kernel_replay_goal_contains_disjunct(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, candidate_root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT - depth
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            return false if goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            if goal.kind == "paren":
                return proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal.left, candidate_root, depth + 1)
            if goal.kind == "binary" and goal.operator == "or":
                return proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal.left, candidate_root, depth + 1) or proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal.right, candidate_root, depth + 1)
            return proof_kernel_replay_disjunct_atoms_equivalent(nodes, children, facts, goal_root, candidate_root)

        def proof_kernel_replay_goal_disjunction_relevance(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, left: usize, right: usize) -> usize:
            left_matches: bool = proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal_root, left, 0)
            right_matches: bool = proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal_root, right, 0)
            return 2 if left_matches and right_matches
            return 1 if left_matches or right_matches
            return 0

        def proof_kernel_replay_find_goal_disjunction(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, depth: usize) -> (known: bool, index: usize, left: usize, right: usize):
            first_index: mutable usize = facts.count
            first_left: mutable usize = 0
            first_right: mutable usize = 0
            best_index: mutable usize = facts.count
            best_left: mutable usize = 0
            best_right: mutable usize = 0
            best_score: mutable usize = 0
            for index in 0..<facts.count |index, facts, nodes, children, goal_root, depth, first_index, first_left, first_right, best_index, best_left, best_right, best_score|:
                candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, facts[index], depth)
                continue if not candidate.known
                if first_index == facts.count:
                    first_index <- index
                    first_left <- candidate.left
                    first_right <- candidate.right
                score: usize = proof_kernel_replay_goal_disjunction_relevance(nodes, children, facts, goal_root, candidate.left, candidate.right)
                if score > best_score:
                    best_index <- index
                    best_left <- candidate.left
                    best_right <- candidate.right
                    best_score <- score
                break if best_score == 2
            return (true, best_index, best_left, best_right) if best_score > 0
            return (true, first_index, first_left, first_right) if first_index < facts.count
            return (false, facts.count, 0, 0)
