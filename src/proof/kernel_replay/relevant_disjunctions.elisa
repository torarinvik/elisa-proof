const PROOF_KERNEL_REPLAY_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES: usize = 8

# Independent observational counters. Replay owns its own state and does not consume producer
# measurements; increments cannot authorize, reject, or budget a certificate.
global mutable proof_kernel_replay_disjunction_facts_scanned: usize
global mutable proof_kernel_replay_disjunction_refutation_checks: usize

extend ElisaProofKernelReplay:
    public:
        def proof_kernel_replay_disjunction_work_measurements() -> (facts_scanned: usize, refutation_checks: usize):
            return (proof_kernel_replay_disjunction_facts_scanned, proof_kernel_replay_disjunction_refutation_checks)

        def proof_kernel_replay_reset_disjunction_work_measurements() -> void:
            proof_kernel_replay_disjunction_facts_scanned <- 0
            proof_kernel_replay_disjunction_refutation_checks <- 0

    private:
        # Independently recognize exact negation, with bounded parenthesis traversal.
        def proof_kernel_replay_exact_boolean_negation(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, positive: usize, negative: usize, facts: darray[usize], depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, negative)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[negative]
            return proof_kernel_replay_exact_boolean_negation(nodes, children, positive, node.left, facts, depth + 1) if node.kind == "paren"
            return false if node.kind != "unary" or node.operator != "not"
            return proof_kernel_replay_expr_equal(nodes, children, positive, node.left, depth + 1) and proof_kernel_replay_denial_fragment(nodes, children, positive, facts, depth + 1)

        def proof_kernel_replay_disjunction_entails_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], premise: usize, goal: usize, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, premise)
            return true if proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal, premise, 0)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[premise]
            if node.kind == "paren":
                return proof_kernel_replay_disjunction_entails_goal(nodes, children, facts, node.left, goal, depth + 1)
            if node.kind == "binary" and node.operator == "or":
                return proof_kernel_replay_disjunction_entails_goal(nodes, children, facts, node.left, goal, depth + 1) and proof_kernel_replay_disjunction_entails_goal(nodes, children, facts, node.right, goal, depth + 1)
            return proof_kernel_replay_disjunct_refuted(nodes, children, premise, facts, 0)

        # Mirror the producer relevance filter so unrelated premises do not
        # consume the bounded entailment-candidate budget during replay.
        def proof_kernel_replay_disjunction_candidate_relevance(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal: usize, candidate_root: usize, depth: usize) -> usize:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT - depth
            return 0 if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            return 0 if not proof_kernel_replay_valid(nodes, candidate_root)
            # Preserve whole-premise matches and fully refuted premises from
            # the old entailment check.
            return 2 if proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal, candidate_root, 0)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[candidate_root]
            if node.kind == "paren":
                return proof_kernel_replay_disjunction_candidate_relevance(nodes, children, facts, goal, node.left, depth + 1)
            if node.kind == "binary" and node.operator == "or":
                left_relevance: usize = proof_kernel_replay_disjunction_candidate_relevance(nodes, children, facts, goal, node.left, depth + 1)
                right_relevance: usize = proof_kernel_replay_disjunction_candidate_relevance(nodes, children, facts, goal, node.right, depth + 1)
                return 2 if left_relevance == 2 or right_relevance == 2
                return 1 if left_relevance == 1 and right_relevance == 1
                return 0
            # The old entailment rule also accepted premises whose every leaf
            # the kernel could refute, even without a matching goal disjunct.
            return 1 if proof_kernel_replay_disjunct_refuted(nodes, children, candidate_root, facts, 0)
            return 0

        def proof_kernel_replay_disjunction_direct_branch(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            for fact in facts:
                return true if proof_kernel_replay_fact_contains(nodes, children, fact, root, depth + 1)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren":
                return proof_kernel_replay_disjunction_direct_branch(nodes, children, node.left, facts, depth + 1)
            return node.value != 0 if node.kind == "bool"
            return false if node.kind != "binary"
            if node.operator == "or":
                return true if proof_kernel_replay_exact_boolean_negation(nodes, children, node.left, node.right, facts, depth + 1) or proof_kernel_replay_exact_boolean_negation(nodes, children, node.right, node.left, facts, depth + 1)
                return proof_kernel_replay_disjunction_direct_branch(nodes, children, node.left, facts, depth + 1) or proof_kernel_replay_disjunction_direct_branch(nodes, children, node.right, facts, depth + 1)
            if proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right) and proof_kernel_replay_expr_equal(nodes, children, node.left, node.right, 0):
                return node.operator == "==" or node.operator == "<=" or node.operator == ">="
            return proof_kernel_replay_comparison_from_equality_literal(nodes, children, facts, node.left, node.operator, node.right)

        # Independently replay elimination of a refuted alternative. No numeric
        # model is consulted, and ordering complements remain integer-only.
        # Independent closed literal-only fold. No call, identifier, comparison
        # or producer-supplied truth marker is a Boolean constant here.
        def proof_kernel_replay_disjunct_literal_bool(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize) -> (known: bool, value: bool):
            decreases remaining
            return (false, false) if remaining == 0 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, false) if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "bool":
                return (false, false) if node.value != 0 and node.value != 1
                return (true, node.value == 1)
            if node.kind == "paren":
                return proof_kernel_replay_disjunct_literal_bool(nodes, node.left, remaining - 1)
            if node.kind == "unary" and node.operator == "not":
                inner: (known: bool, value: bool) = proof_kernel_replay_disjunct_literal_bool(nodes, node.left, remaining - 1)
                return (inner.known, not inner.value)
            return (false, false)

        def proof_kernel_replay_disjunct_refuted(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], depth: usize) -> bool:
            proof_kernel_replay_disjunction_refutation_checks <- proof_kernel_replay_disjunction_refutation_checks + 1
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            return true if proof_kernel_replay_fact_denies(nodes, children, root, facts)
            constant: (known: bool, value: bool) = proof_kernel_replay_disjunct_literal_bool(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth)
            return true if constant.known and not constant.value
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren":
                return proof_kernel_replay_disjunct_refuted(nodes, children, node.left, facts, depth + 1)
            return node.value == 0 if node.kind == "bool"
            if node.kind == "binary" and node.operator == "or":
                return proof_kernel_replay_disjunct_refuted(nodes, children, node.left, facts, depth + 1) and proof_kernel_replay_disjunct_refuted(nodes, children, node.right, facts, depth + 1)
            if node.kind == "binary" and node.operator == "and":
                return proof_kernel_replay_disjunct_refuted(nodes, children, node.left, facts, depth + 1) or proof_kernel_replay_disjunct_refuted(nodes, children, node.right, facts, depth + 1)
            return false if node.kind != "binary"
            complement: sview = proof_kernel_replay_comparison_complement(node.operator)
            return false if complement == ""
            # Independently evaluate only closed constant operands, preserving
            # exact typed arithmetic and the legacy safe-constant restrictions.
            constant_denial = ElisaProofKernelCore::typed_constant_expression_comparison(nodes, node.left, complement, node.right)
            return true if constant_denial.known and constant_denial.value
            contextual_denial = ElisaProofKernelCore::contextual_unsigned_constant_comparison(nodes, node.left, complement, node.right)
            return true if contextual_denial.known and contextual_denial.value
            return true if proof_kernel_replay_negated_constant_comparison(nodes, node.left, node.operator, node.right)
            return true if proof_kernel_replay_comparison_from_equality_literal(nodes, children, facts, node.left, complement, node.right)
            equality: bool = node.operator == "==" or node.operator == "!="
            primitive: bool = proof_kernel_replay_primitive_comparison(nodes, children, facts, node.left, node.right)
            integer_order: bool = not equality and primitive and proof_kernel_replay_denial_integer_term(nodes, children, node.left, facts, 0) and proof_kernel_replay_denial_integer_term(nodes, children, node.right, facts, 0)
            for fact in facts:
                continue if not primitive or (not equality and not integer_order) or not proof_kernel_replay_valid(nodes, fact)
                premise: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape(nodes, fact)
                continue if not premise.known or premise.operator != complement
                continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, premise.left, premise.right)
                integers: bool = integer_order and proof_kernel_replay_denial_integer_term(nodes, children, premise.left, facts, 0) and proof_kernel_replay_denial_integer_term(nodes, children, premise.right, facts, 0)
                return true if (equality or integers) and proof_kernel_replay_disjunct_terms_equivalent(nodes, children, facts, node.left, premise.left) and proof_kernel_replay_disjunct_terms_equivalent(nodes, children, facts, node.right, premise.right)
            return false if not proof_kernel_replay_denial_fragment(nodes, children, root, facts, 0)
            for fact in facts:
                shape: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape(nodes, fact)
                return true if shape.known and shape.operator == complement and proof_kernel_replay_expr_equal(nodes, children, node.left, shape.left, 0) and proof_kernel_replay_expr_equal(nodes, children, node.right, shape.right, 0)
            return false

        def proof_kernel_replay_comparison_complement(operator: sview) -> sview:
            return "!=" if operator == "=="
            return "==" if operator == "!="
            return ">=" if operator == "<"
            return "<" if operator == ">="
            return ">" if operator == "<="
            return "<=" if operator == ">"
            return ""

        def proof_kernel_replay_comparison_disjunct_shape(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, left: usize, operator: sview, right: usize):
            return (false, 0, "", 0) if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and proof_kernel_replay_comparison_complement(node.operator) != "":
                return (true, node.left, node.operator, node.right)
            if node.kind == "unary" and node.operator == "not" and node.left < nodes.count:
                inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                if inner.kind == "binary":
                    complement: sview = proof_kernel_replay_comparison_complement(inner.operator)
                    return (true, inner.left, complement, inner.right) if complement != ""
            return (false, 0, "", 0)

        def proof_kernel_replay_disjunct_terms_equivalent(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize) -> bool:
            return true if proof_kernel_replay_expr_equal(nodes, children, left, right, 0)
            for fact_root in facts:
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                if fact.kind == "binary" and fact.operator == "==":
                    return true if proof_kernel_replay_expr_equal(nodes, children, left, fact.left, 0) and proof_kernel_replay_expr_equal(nodes, children, right, fact.right, 0)
                    return true if proof_kernel_replay_expr_equal(nodes, children, left, fact.right, 0) and proof_kernel_replay_expr_equal(nodes, children, right, fact.left, 0)
            return false

        def proof_kernel_replay_disjunct_atoms_equivalent(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize) -> bool:
            return true if proof_kernel_replay_disjunct_terms_equivalent(nodes, children, facts, left, right)
            first: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape(nodes, left)
            second: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape(nodes, right)
            return first.known and second.known and first.operator == second.operator and proof_kernel_replay_disjunct_terms_equivalent(nodes, children, facts, first.left, second.left) and proof_kernel_replay_disjunct_terms_equivalent(nodes, children, facts, first.right, second.right)

        def proof_kernel_replay_goal_contains_disjunct(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, candidate_root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT - depth
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            return false if goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            if goal.kind == "paren":
                return proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal.left, candidate_root, depth + 1)
            if goal.kind == "binary" and goal.operator == "or":
                return proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal.left, candidate_root, depth + 1) or proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal.right, candidate_root, depth + 1)
            return proof_kernel_replay_disjunct_atoms_equivalent(nodes, children, facts, goal_root, candidate_root)

        def proof_kernel_replay_goal_disjunction_relevance(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, left: usize, right: usize) -> usize:
            left_matches: bool = proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal_root, left, 0)
            right_matches: bool = proof_kernel_replay_goal_contains_disjunct(nodes, children, facts, goal_root, right, 0)
            return 2 if left_matches and right_matches
            return 1 if left_matches or right_matches
            return 0

        def proof_kernel_replay_find_goal_disjunction(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, depth: usize) -> (known: bool, index: usize, left: usize, right: usize):
            # The enclosing goal replay has a one-level-wider budget than the
            # congruence scan. At that final depth there is no safe disjunction
            # candidate to inspect; stop before passing an out-of-range depth to
            # the independently bounded scanner.
            return (false, facts.count, 0, 0) if not ElisaProofKernelCore::depth_valid(depth) or depth > PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            first_index: mutable usize = facts.count
            first_left: mutable usize = 0
            first_right: mutable usize = 0
            best_index: mutable usize = facts.count
            best_left: mutable usize = 0
            best_right: mutable usize = 0
            best_score: mutable usize = 0
            for index in 0..<facts.count |index, facts, nodes, children, goal_root, depth, first_index, first_left, first_right, best_index, best_left, best_right, best_score|:
                proof_kernel_replay_disjunction_facts_scanned <- proof_kernel_replay_disjunction_facts_scanned + 1
                candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, facts[index], depth)
                continue if not candidate.known
                if first_index == facts.count:
                    first_index <- index
                    first_left <- candidate.left
                    first_right <- candidate.right
                score: usize = proof_kernel_replay_goal_disjunction_relevance(nodes, children, facts, goal_root, candidate.left, candidate.right)
                if score > best_score:
                    best_index <- index
                    best_left <- candidate.left
                    best_right <- candidate.right
                    best_score <- score
                break if best_score == 2
            return (true, best_index, best_left, best_right) if best_score > 0
            return (true, first_index, first_left, first_right) if first_index < facts.count
            return (false, facts.count, 0, 0)
