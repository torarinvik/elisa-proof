const PROOF_KERNEL_REPLAY_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES: usize = 8

# Independent observational counters. Replay owns its own state and does not consume producer
# measurements; increments cannot authorize, reject, or budget a certificate.
global mutable proof_kernel_replay_disjunction_facts_scanned: usize
global mutable proof_kernel_replay_disjunction_refutation_checks: usize

extend ElisaProofKernelReplay:
    public:
        def proof_kernel_replay_disjunction_work_measurements() -> (facts_scanned: usize, refutation_checks: usize):
            can Global.Read:
                return (proof_kernel_replay_disjunction_facts_scanned, proof_kernel_replay_disjunction_refutation_checks)

        def proof_kernel_replay_reset_disjunction_work_measurements() -> void:
            can Global.Write:
                proof_kernel_replay_disjunction_facts_scanned <- 0
                proof_kernel_replay_disjunction_refutation_checks <- 0

    private:
        # Independently recognize exact negation, with bounded parenthesis traversal.
        def proof_kernel_replay_exact_boolean_negation_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, positive: usize, negative: usize, facts: darray[usize], work_used: mutable usize&, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, negative)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, negative, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[negative]
            return proof_kernel_replay_exact_boolean_negation_with_work(nodes, children, positive, node.left, facts, work_used, depth + 1) if node.kind == "paren"
            return false if node.kind != "unary" or node.operator != "not"
            same_positive: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, positive, node.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_positive
            denied: bool = proof_kernel_replay_denial_fragment_with_work(nodes, children, positive, facts, work_used, depth + 1)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and denied

        def proof_kernel_replay_disjunction_entails_goal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], premise: usize, goal: usize, work_used: mutable usize&, depth: usize) -> bool can[Global.Read, Global.Write]:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, premise)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, premise, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            contains: bool = proof_kernel_replay_goal_contains_disjunct_with_work(nodes, children, facts, goal, premise, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if contains
            node: ElisaProofKernelCore::ProofKernelNode = nodes[premise]
            if node.kind == "paren":
                return (proof_kernel_replay_disjunction_entails_goal_with_work(nodes, children, facts, node.left, goal, work_used, depth + 1) can Global{Read,Write})
            if node.kind == "binary" and node.operator == "or":
                return (proof_kernel_replay_disjunction_entails_goal_with_work(nodes, children, facts, node.left, goal, work_used, depth + 1) can Global{Read,Write}) and (proof_kernel_replay_disjunction_entails_goal_with_work(nodes, children, facts, node.right, goal, work_used, depth + 1) can Global{Read,Write})
            return (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, premise, facts, work_used, 0) can Global{Read,Write})

        # Mirror the producer relevance filter so unrelated premises do not
        # consume the bounded entailment-candidate budget during replay.
        def proof_kernel_replay_disjunction_candidate_relevance_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal: usize, candidate_root: usize, work_used: mutable usize&, depth: usize) -> usize can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT - depth
            return 0 if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
                not proof_kernel_replay_valid(nodes, candidate_root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, candidate_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            # Preserve whole-premise matches and fully refuted premises from
            # the old entailment check.
            contains: bool = proof_kernel_replay_goal_contains_disjunct_with_work(nodes, children, facts, goal, candidate_root, work_used, 0)
            return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return 2 if contains
            node: ElisaProofKernelCore::ProofKernelNode = nodes[candidate_root]
            if node.kind == "paren":
                return (proof_kernel_replay_disjunction_candidate_relevance_with_work(nodes, children, facts, goal, node.left, work_used, depth + 1) can Global{Read,Write})
            if node.kind == "binary" and node.operator == "or":
                left_relevance: usize = (proof_kernel_replay_disjunction_candidate_relevance_with_work(nodes, children, facts, goal, node.left, work_used, depth + 1) can Global{Read,Write})
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_relevance: usize = (proof_kernel_replay_disjunction_candidate_relevance_with_work(nodes, children, facts, goal, node.right, work_used, depth + 1) can Global{Read,Write})
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return 2 if left_relevance == 2 or right_relevance == 2
                return 1 if left_relevance == 1 and right_relevance == 1
                return 0
            # The old entailment rule also accepted premises whose every leaf
            # the kernel could refute, even without a matching goal disjunct.
            refuted: bool = (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, candidate_root, facts, work_used, 0) can Global{Read,Write})
            return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return 1 if refuted
            return 0

        def proof_kernel_replay_disjunction_direct_branch_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                contains: bool = proof_kernel_replay_fact_contains_with_work(nodes, children, fact, root, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if contains
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren":
                return proof_kernel_replay_disjunction_direct_branch_with_work(nodes, children, node.left, facts, work_used, depth + 1)
            return node.value != 0 if node.kind == "bool"
            return false if node.kind != "binary"
            if node.operator == "or":
                left_negates_right: bool = proof_kernel_replay_exact_boolean_negation_with_work(nodes, children, node.left, node.right, facts, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_negates_left: bool = proof_kernel_replay_exact_boolean_negation_with_work(nodes, children, node.right, node.left, facts, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if left_negates_right or right_negates_left
                return proof_kernel_replay_disjunction_direct_branch_with_work(nodes, children, node.left, facts, work_used, depth + 1) or proof_kernel_replay_disjunction_direct_branch_with_work(nodes, children, node.right, facts, work_used, depth + 1)
            primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if primitive:
                reflexive: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, node.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if reflexive:
                    return node.operator in {"==", "<=", ">="}
            equality_literal: bool = proof_kernel_replay_comparison_from_equality_literal_with_work(nodes, children, facts, node.left, node.operator, node.right, work_used)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and equality_literal

        def proof_kernel_replay_disjunct_literal_bool_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize, work_used: mutable usize&) -> (known: bool, value: bool):
            decreases remaining
            return (false, false) if:
                remaining == 0 or not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, false) if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "bool":
                return (false, false) if node.value != 0 and node.value != 1
                return (true, node.value == 1)
            if node.kind == "paren":
                return (false, false) if remaining <= 1
                return proof_kernel_replay_disjunct_literal_bool_with_work(nodes, node.left, remaining - 1, work_used)
            if node.kind == "unary" and node.operator == "not":
                return (false, false) if remaining <= 1
                inner: (known: bool, value: bool) = proof_kernel_replay_disjunct_literal_bool_with_work(nodes, node.left, remaining - 1, work_used)
                return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not inner.known
                return (true, not inner.value)
            (false, false)

        def proof_kernel_replay_disjunct_refuted_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&, depth: usize) -> bool:
            can Global{Read,Write}:
                proof_kernel_replay_disjunction_refutation_checks <- proof_kernel_replay_disjunction_refutation_checks + 1
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            denied_by_fact: bool = proof_kernel_replay_fact_denies_with_work(nodes, children, root, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if denied_by_fact
            constant: (known: bool, value: bool) = proof_kernel_replay_disjunct_literal_bool_with_work(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if constant.known and not constant.value
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "paren":
                return (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, node.left, facts, work_used, depth + 1) can Global{Read,Write})
            return node.value == 0 if node.kind == "bool"
            if node.kind == "binary" and node.operator == "or":
                return (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, node.left, facts, work_used, depth + 1) can Global{Read,Write}) and (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, node.right, facts, work_used, depth + 1) can Global{Read,Write})
            if node.kind == "binary" and node.operator == "and":
                return (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, node.left, facts, work_used, depth + 1) can Global{Read,Write}) or (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, node.right, facts, work_used, depth + 1) can Global{Read,Write})
            return false if node.kind != "binary"
            complement: sview = proof_kernel_replay_comparison_complement(node.operator)
            return false if complement == ""
            comparison_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if not comparison_admission.complete or comparison_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            primitive_operands: bool = proof_kernel_replay_scalar_term_pair_witnessed_with_work(nodes, children, facts, node.left, node.right, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if not primitive_operands or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            # Independently evaluate only closed constant operands, preserving
            # exact typed arithmetic and the legacy safe-constant restrictions.
            constant_denial: (known: bool, value: bool) = ElisaProofKernelCore::typed_constant_expression_comparison_with_goal_work(nodes, node.left, complement, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if constant_denial.known and constant_denial.value
            contextual_denial: (known: bool, value: bool) = ElisaProofKernelCore::contextual_unsigned_constant_comparison_with_goal_work(nodes, node.left, complement, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if contextual_denial.known and contextual_denial.value
            negated_constant: bool = proof_kernel_replay_fact_negated_constant_comparison_with_goal_work(nodes, children, facts, root, node.left, node.operator, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if negated_constant
            equality_literal: bool = proof_kernel_replay_comparison_from_equality_literal_with_work(nodes, children, facts, node.left, complement, node.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if equality_literal
            equality: bool = node.operator in {"==", "!="}
            primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            integer_order: bool = not equality and primitive and proof_kernel_replay_order_integer_term_with_work(nodes, children, node.left, facts, work_used, 0) and proof_kernel_replay_order_integer_term_with_work(nodes, children, node.right, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not primitive or (not equality and not integer_order) or not proof_kernel_replay_valid(nodes, fact)
                premise: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape_with_work(nodes, children, facts, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not premise.known or premise.operator != complement
                premise_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, premise.left, premise.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not premise_primitive
                integers: bool = integer_order and proof_kernel_replay_order_integer_term_with_work(nodes, children, premise.left, facts, work_used, 0) and proof_kernel_replay_order_integer_term_with_work(nodes, children, premise.right, facts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                equivalent: bool = (equality or integers) and proof_kernel_replay_disjunct_terms_equivalent_with_work(nodes, children, facts, node.left, premise.left, work_used) and proof_kernel_replay_disjunct_terms_equivalent_with_work(nodes, children, facts, node.right, premise.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if equivalent
            return false if:
                not proof_kernel_replay_denial_fragment_with_work(nodes, children, root, facts, work_used, 0)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in facts:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                shape: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape_with_work(nodes, children, facts, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                equivalent: bool = shape.known and shape.operator == complement and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, shape.left, work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.right, shape.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if equivalent
            return false

        def proof_kernel_replay_comparison_complement(operator: sview) -> sview:
            return "!=" if operator == "=="
            return "==" if operator == "!="
            return ">=" if operator == "<"
            return "<" if operator == ">="
            return ">" if operator == "<="
            return "<=" if operator == ">"
            return ""

        def proof_kernel_replay_comparison_disjunct_shape_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> (known: bool, left: usize, operator: sview, right: usize):
            return (false, 0, "", 0) if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and proof_kernel_replay_comparison_complement(node.operator) != "":
                return (true, node.left, node.operator, node.right)
            if node.kind == "unary" and node.operator == "not" and node.left < nodes.count and proof_kernel_replay_valid(nodes, node.left):
                return (false, 0, "", 0) if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                if inner.kind == "binary":
                    if proof_kernel_replay_is_order_operator(inner.operator):
                        left_integer: bool = proof_kernel_replay_denial_integer_term_with_work(nodes, children, inner.left, facts, work_used, 0)
                        return (false, 0, "", 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_integer
                        right_integer: bool = proof_kernel_replay_denial_integer_term_with_work(nodes, children, inner.right, facts, work_used, 0)
                        return (false, 0, "", 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not right_integer
                    complement: sview = proof_kernel_replay_comparison_complement(inner.operator)
                    return (true, inner.left, complement, inner.right) if complement != ""
            (false, 0, "", 0)

        def proof_kernel_replay_disjunct_terms_equivalent_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, work_used: mutable usize&) -> bool:
            left_calls: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, left, work_used, 0)
            return false if not left_calls.complete or left_calls.found
            right_calls: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, right, work_used, 0)
            return false if not right_calls.complete or right_calls.found
            same_expression: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, left, right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if same_expression
            for fact_root in facts:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count
                return false if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                if fact.kind == "binary" and fact.operator == "==":
                    name_calls: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, fact.left, work_used, 0)
                    return false if not name_calls.complete
                    continue if name_calls.found
                    value_calls: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, fact.right, work_used, 0)
                    return false if not value_calls.complete
                    continue if value_calls.found
                    forward_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, left, fact.left, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    forward_right: bool = forward_left and proof_kernel_replay_goal_search_expr_equal(nodes, children, right, fact.right, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if forward_left and forward_right
                    reverse_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, left, fact.right, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    reverse_right: bool = reverse_left and proof_kernel_replay_goal_search_expr_equal(nodes, children, right, fact.left, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if reverse_left and reverse_right
            return false

        def proof_kernel_replay_disjunct_small_literal_value_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used) or root >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "int":
                return empty if node.value < 0 or node.value > ElisaProofKernelCore::PROOF_KERNEL_I8_MAX
                return ProofKernelReplayInt{known: true, value: node.value}
            return empty if node.kind != "typed-int"
            literal: (known: bool, bits: u64, unsigned: bool, width: i64) = ElisaProofKernelCore::typed_literal_value(node)
            return empty if not literal.known or literal.bits > ElisaProofKernelCore::PROOF_KERNEL_I8_MAX.u64()
            ProofKernelReplayInt{known: true, value: literal.bits.i64()}

        def proof_kernel_replay_disjunct_contextual_comparison_equivalent_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], first: (known: bool, left: usize, operator: sview, right: usize), second: (known: bool, left: usize, operator: sview, right: usize), work_used: mutable usize&) -> bool:
            return false if not first.known or not second.known or first.operator != second.operator
            same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, first.left, second.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_left
            first_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, first.left, first.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not first_primitive
            second_primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, second.left, second.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not second_primitive
            first_literal: ProofKernelReplayInt = proof_kernel_replay_disjunct_small_literal_value_with_work(nodes, first.right, work_used)
            second_literal: ProofKernelReplayInt = proof_kernel_replay_disjunct_small_literal_value_with_work(nodes, second.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return first_literal.known and second_literal.known and first_literal.value == second_literal.value

        def proof_kernel_replay_disjunct_atoms_equivalent_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left: usize, right: usize, work_used: mutable usize&) -> bool:
            same_atom: bool = proof_kernel_replay_disjunct_terms_equivalent_with_work(nodes, children, facts, left, right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if same_atom
            first: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape_with_work(nodes, children, facts, left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not first.known
            second: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape_with_work(nodes, children, facts, right, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not second.known
                not first.known or not second.known or first.operator != second.operator
            same_terms: bool = proof_kernel_replay_disjunct_terms_equivalent_with_work(nodes, children, facts, first.left, second.left, work_used) and proof_kernel_replay_disjunct_terms_equivalent_with_work(nodes, children, facts, first.right, second.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if same_terms
            return proof_kernel_replay_disjunct_contextual_comparison_equivalent_with_work(nodes, children, facts, first, second, work_used)

        def proof_kernel_replay_goal_contains_disjunct_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, candidate_root: usize, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
                goal_root >= nodes.count or not proof_kernel_replay_valid(nodes, goal_root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            if goal.kind == "paren":
                return proof_kernel_replay_goal_contains_disjunct_with_work(nodes, children, facts, goal.left, candidate_root, work_used, depth + 1)
            if goal.kind == "binary" and goal.operator == "or":
                return proof_kernel_replay_goal_contains_disjunct_with_work(nodes, children, facts, goal.left, candidate_root, work_used, depth + 1) or proof_kernel_replay_goal_contains_disjunct_with_work(nodes, children, facts, goal.right, candidate_root, work_used, depth + 1)
            return proof_kernel_replay_disjunct_atoms_equivalent_with_work(nodes, children, facts, goal_root, candidate_root, work_used)

        def proof_kernel_replay_goal_disjunction_relevance_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, left: usize, right: usize, work_used: mutable usize&) -> usize:
            left_matches: bool = proof_kernel_replay_goal_contains_disjunct_with_work(nodes, children, facts, goal_root, left, work_used, 0)
            right_matches: bool = proof_kernel_replay_goal_contains_disjunct_with_work(nodes, children, facts, goal_root, right, work_used, 0)
            return 2 if left_matches and right_matches
            return 1 if left_matches or right_matches
            return 0

        def proof_kernel_replay_find_goal_disjunction_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&, depth: usize) -> (known: bool, index: usize, left: usize, right: usize) can[Global.Read, Global.Write]:
            # The enclosing goal replay has a one-level-wider budget than the
            # congruence scan. At that final depth there is no safe disjunction
            # candidate to inspect; stop before passing an out-of-range depth to
            # the independently bounded scanner.
            return (false, facts.count, 0, 0) if not ElisaProofKernelCore::depth_valid(depth) or depth > PROOF_KERNEL_REPLAY_CONGRUENCE_SCAN_DEPTH
            first_index: mutable usize = facts.count
            first_left: mutable usize = 0
            first_right: mutable usize = 0
            best_index: mutable usize = facts.count
            best_left: mutable usize = 0
            best_right: mutable usize = 0
            best_score: mutable usize = 0
            for index in 0..<facts.count |index, facts, nodes, children, goal_root, depth, first_index, first_left, first_right, best_index, best_left, best_right, best_score, work_used|:
                return (false, facts.count, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
                can Global{Read,Write}:
                    proof_kernel_replay_disjunction_facts_scanned <- proof_kernel_replay_disjunction_facts_scanned + 1
                candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction_with_work(nodes, facts[index], work_used, depth)
                return (false, facts.count, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not candidate.known
                if first_index == facts.count:
                    first_index <- index
                    first_left <- candidate.left
                    first_right <- candidate.right
                score: usize = proof_kernel_replay_goal_disjunction_relevance_with_work(nodes, children, facts, goal_root, candidate.left, candidate.right, work_used)
                return (false, facts.count, 0, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if score > best_score:
                    best_index <- index
                    best_left <- candidate.left
                    best_right <- candidate.right
                    best_score <- score
                break if best_score == 2
            return (true, best_index, best_left, best_right) if best_score > 0
            return (true, first_index, first_left, first_right) if first_index < facts.count
            return (false, facts.count, 0, 0)
