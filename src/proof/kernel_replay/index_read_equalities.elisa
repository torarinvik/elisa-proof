extend ElisaProofKernelReplay:
    private:
        # Transport only an established primitive comparison through two
        # independently replayed operand equalities, not arbitrary call identity.
        def proof_kernel_replay_comparison_transport(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if remaining <= 1 or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator == "==" or not proof_kernel_replay_primitive_comparison(nodes, children, facts, goal.left, goal.right)
            return false if goal.operator != "!=" and goal.operator != "<" and goal.operator != ">" and goal.operator != "<=" and goal.operator != ">="
            for premise in facts |premise, nodes, children, facts, goal, split_depth, depth, remaining|:
                continue if not proof_kernel_replay_valid(nodes, premise)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[premise]
                continue if fact.kind != "binary" or fact.operator != goal.operator
                continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right)
                left_equal: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", goal.left, fact.left, 0, 0, 0, 0, "", "")
                right_equal: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", goal.right, fact.right, 0, 0, 0, 0, "", "")
                # The outer goal has already handled cases. Opening fresh cases for each
                # operand equality cycles through antisymmetry and comparison transport;
                # check these side conditions in the deterministic arithmetic fragment.
                return true if proof_kernel_replay_goal_depth_remaining(nodes, children, facts, left_equal, PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT, depth + 1, remaining: remaining - 1) and proof_kernel_replay_goal_depth_remaining(nodes, children, facts, right_equal, PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT, depth + 1, remaining: remaining - 1)
            return false

        def proof_kernel_replay_index_read_equality(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if remaining <= 1 or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "==" or not proof_kernel_replay_primitive_comparison(nodes, children, facts, goal.left, goal.right)
            for orientation in 0..<2 |orientation, goal, nodes, children, facts, split_depth, depth, remaining|:
                read_root: usize = goal.left if orientation == 0 else goal.right
                value_root: usize = goal.right if orientation == 0 else goal.left
                continue if not proof_kernel_replay_valid(nodes, read_root)
                read: ElisaProofKernelCore::ProofKernelNode = nodes[read_root]
                continue if read.kind != "index"
                for fact_root in facts |fact_root, read, value_root, nodes, children, facts, split_depth, depth, remaining|:
                    continue if not proof_kernel_replay_valid(nodes, fact_root)
                    fact: mutable ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                    negated: mutable bool = false
                    if fact.kind == "unary" and fact.operator == "not":
                        continue if not proof_kernel_replay_valid(nodes, fact.left)
                        fact <- nodes[fact.left]
                        negated <- true
                    continue if fact.kind != "binary" or (fact.operator != "==" if not negated else fact.operator != "!=")
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right)
                    other_root: usize = fact.left if proof_kernel_replay_expr_equal(nodes, children, fact.right, value_root, 0) else (fact.right if proof_kernel_replay_expr_equal(nodes, children, fact.left, value_root, 0) else nodes.count)
                    continue if not proof_kernel_replay_valid(nodes, other_root)
                    other: ElisaProofKernelCore::ProofKernelNode = nodes[other_root]
                    continue if other.kind != "index" or not proof_kernel_replay_expr_equal(nodes, children, read.left, other.left, 0) or proof_kernel_replay_expr_equal(nodes, children, read.right, other.right, 0)
                    index_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", read.right, other.right, 0, 0, 0, 0, "", "")
                    return true if proof_kernel_replay_goal_depth_remaining(nodes, children, facts, index_goal, split_depth, depth + 1, remaining: remaining - 1)
            return false
