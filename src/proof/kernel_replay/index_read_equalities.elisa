extend ElisaProofKernelReplay:
    private:
        # Transport only an established primitive comparison through two
        # independently replayed operand equalities, not arbitrary call identity.
        def proof_kernel_replay_comparison_transport(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                remaining <= 1 or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if:
                goal.kind != "binary" or goal.operator == "=="
                goal.operator != "!=" and goal.operator != "<" and goal.operator != ">" and goal.operator != "<=" and goal.operator != ">="
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if:
                not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal_primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, goal.left, goal.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not goal_primitive
            for premise in facts |premise, nodes, children, facts, goal, markers, split_depth, depth, remaining, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if not proof_kernel_replay_valid(nodes, premise)
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, premise, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[premise]
                continue if fact.kind != "binary" or fact.operator != goal.operator
                fact_primitive: bool = proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, fact.left, fact.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not fact_primitive
                left_equal: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "==", goal.left, fact.left, 0, work_used)
                return false if left_equal >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                right_equal: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "==", goal.right, fact.right, 0, work_used)
                return false if right_equal >= nodes.count or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                # The outer goal has already handled cases. Opening fresh cases for each
                # operand equality cycles through antisymmetry and comparison transport;
                # check these side conditions in the deterministic arithmetic fragment.
                left_proven: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, left_equal, PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if left_proven:
                    right_proven: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, right_equal, PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return true if right_proven
            return false

        def proof_kernel_replay_index_read_equality(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            # The arena lacks a resolved built-in receiver type for Index nodes.
            return false

        # Typed API only: establish equality between two built-in indexed reads when their
        # receivers are the same term and their indices are structurally equal or explicitly
        # equated by an admitted premise. Requiring the same receiver term avoids treating
        # container value equality as object identity. Primitive result sorts keep overloaded
        # equality out of the conclusion; known receiver typing rules out protocol indexing.
        def proof_kernel_replay_typed_index_read_equality_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: darray[usize]& @r, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, facts: darray[usize], root: usize, type_work_used: mutable usize&, goal_work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge(goal_work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, goal_work_used)
                goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "=="
            return false if goal.left >= nodes.count or goal.right >= nodes.count
            left: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            right: ElisaProofKernelCore::ProofKernelNode = nodes[goal.right]
            return false if:
                left.kind != "index" or right.kind != "index"
                not proof_kernel_replay_arena_shape_valid(left) or not proof_kernel_replay_arena_shape_valid(right)
                left.left >= nodes.count or right.left >= nodes.count
                nodes[left.left].kind != "ident" or nodes[right.left].kind != "ident"
            same_receiver: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, left.left, right.left, goal_work_used)
            return false if goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_receiver
            # The typing environment is immutable for this query and the two receiver terms
            # are structurally equal, so one charged inference establishes both receiver sorts.
            left_receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, left.left, 0, type_work_used)
            return false if type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return false if:
                not left_receiver.known
                left_receiver.family not in {"container", "string"}
                type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            left_index_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, left.right, 0, type_work_used)
            return false if type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            right_index_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, right.right, 0, type_work_used)
            return false if type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return false if not left_index_sort.known or not right_index_sort.known or not proof_kernel_replay_integral_sort(left_index_sort) or not proof_kernel_replay_integral_sort(right_index_sort)
            return false if not proof_kernel_replay_sort_equal(left_index_sort, right_index_sort, type_work_used) or type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            left_result_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, goal.left, 0, type_work_used)
            return false if type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            right_result_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, typing_index, goal.right, 0, type_work_used)
            return false if type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return false if:
                not left_result_sort.known or not right_result_sort.known
                not proof_kernel_replay_sort_equal(left_result_sort, right_result_sort, type_work_used)
                left_result_sort.family not in {"integer", "boolean", "character"}
                type_work_used > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            indices_equal: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, left.right, right.right, goal_work_used)
            return false if goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if indices_equal
            for fact in facts |fact, nodes, children, goal_work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(goal_work_used)
                    fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, goal_work_used)
                    goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                candidate: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
                continue if candidate.kind != "binary" or candidate.operator != "=="
                forward: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, candidate.left, left.right, goal_work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, candidate.right, right.right, goal_work_used)
                return false if goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if forward
                reverse: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, candidate.left, right.right, goal_work_used) and proof_kernel_replay_goal_search_expr_equal(nodes, children, candidate.right, left.right, goal_work_used)
                return false if goal_work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if reverse
            return false
