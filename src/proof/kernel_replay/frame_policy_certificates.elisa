# Source-neutral frame policy evaluation. Source admission must additionally
# bind the owner, parameter ordinals, policy and actual place to the checked AST.
extend ElisaProofKernelFramePolicy:
    public:
        def policy_replays(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if root >= nodes.count
            policy: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if policy.kind != "frame-policy" or policy.secondary_name != "frame-policy-v1" or policy.name == "" or policy.value != 0
            return false if policy.operator != "write" and policy.operator != "spec" and policy.operator != "preserve"
            return false if policy.auxiliary == 0 or policy.auxiliary > FRAME_POLICY_PLACE_LIMIT or policy.left >= root
            return false if policy.children_count > 2 * FRAME_POLICY_PLACE_LIMIT or policy.right > policy.children_count
            return false if policy.right > FRAME_POLICY_PLACE_LIMIT or policy.children_count - policy.right > FRAME_POLICY_PLACE_LIMIT
            return false if policy.children_start > children.count or policy.children_count > children.count - policy.children_start
            return false if policy.children_count == 0 and policy.children_start != 0
            actual = decode_place(nodes, children, policy.left, policy.auxiliary)
            return false if not actual.known
            if policy.operator == "spec":
                return policy.right == 0 and policy.children_count == 0
            return false if policy.operator == "preserve" and (policy.right != 0 or policy.children_count == 0)
            changes: mutable darray[Place] = []
            preserves: mutable darray[Place] = []
            for index in 0..<policy.children_count |index, policy, children, nodes, root, changes, preserves|:
                place_root: usize = children[policy.children_start + index]
                return false if place_root >= root
                decoded = decode_place(nodes, children, place_root, policy.auxiliary)
                return false if not decoded.known
                if index < policy.right:
                    changes.push(decoded.place)
                else:
                    preserves.push(decoded.place)
            if policy.operator == "preserve":
                for preserved in preserves |actual|:
                    return false if overlap(preserved, actual.place)
                return true
            return write_allowed(actual.place, changes, preserves, policy.auxiliary)
