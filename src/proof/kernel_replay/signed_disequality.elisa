# Independent replay rules for signed constant disequality. Every source fact
# is rechecked against the exact typed term and representable signed width.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_signed_literal_fits(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, width: i64) -> bool:
            return false if not ElisaProofKernelCore::proof_kernel_signed_width_valid(width) or root >= nodes.count
            constant: ProofKernelReplayInt = proof_kernel_replay_signed_literal_comparison_constant(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
            return constant.known and constant.value >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and constant.value <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)

        def proof_kernel_replay_signed_disequality_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> (known: bool, term: usize, value: i64):
            return (false, 0, 0) if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, 0) if comparison.kind != "binary" or comparison.operator != "!=" or comparison.right >= nodes.count
            width: i64 = proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, comparison.left)
            constant: ProofKernelReplayInt = proof_kernel_replay_signed_literal_comparison_constant(nodes, comparison.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
            return (false, 0, 0) if width == 0 or not proof_kernel_replay_signed_literal_fits(nodes, comparison.right, width)
            return (false, 0, 0) if not proof_kernel_replay_primitive_comparison(nodes, children, facts, comparison.left, comparison.right)
            return (true, comparison.left, constant.value)

        def proof_kernel_replay_signed_distinct_disequality_disjunction(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "or"
            first: (known: bool, term: usize, value: i64) = proof_kernel_replay_signed_disequality_constant(nodes, children, facts, goal.left)
            second: (known: bool, term: usize, value: i64) = proof_kernel_replay_signed_disequality_constant(nodes, children, facts, goal.right)
            return false if not first.known or not second.known or first.value == second.value
            return proof_kernel_replay_expr_equal(nodes, children, first.term, second.term, 0)

        def proof_kernel_replay_signed_disequality_from_equality_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "!=" or goal.right >= nodes.count
            width: i64 = proof_kernel_replay_signed_marker_width_for_term(nodes, children, facts, goal.left)
            target: ProofKernelReplayInt = proof_kernel_replay_signed_literal_comparison_constant(nodes, goal.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
            return false if width == 0 or not proof_kernel_replay_signed_literal_fits(nodes, goal.right, width)
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, goal.left, goal.right)
            for fact_root in facts |fact_root, nodes, children, facts, goal, width, target|:
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "==" or fact.left >= nodes.count or fact.right >= nodes.count
                if proof_kernel_replay_expr_equal(nodes, children, goal.left, fact.left, 0) and proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right):
                    known_value: ProofKernelReplayInt = proof_kernel_replay_signed_literal_comparison_constant(nodes, fact.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
                    return true if known_value.known and proof_kernel_replay_signed_literal_fits(nodes, fact.right, width) and known_value.value != target.value
                if proof_kernel_replay_expr_equal(nodes, children, goal.left, fact.right, 0) and proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right):
                    known_value: ProofKernelReplayInt = proof_kernel_replay_signed_literal_comparison_constant(nodes, fact.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
                    return true if known_value.known and proof_kernel_replay_signed_literal_fits(nodes, fact.left, width) and known_value.value != target.value
            return false
