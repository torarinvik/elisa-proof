extend ElisaProofKernelReplay:
    private:
        # Contextualize only a canonical, representable unsuffixed literal.
        # Explicit typed literals and compound untyped expressions never change
        # sort merely because the other conditional branch is unsigned.
        def proof_kernel_replay_conditional_literal_fits(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, target: ProofKernelInferredSort, work: mutable usize&) -> bool:
            return false if not proof_kernel_replay_type_work_consume(work)
            return false if not target.known or target.family != "integer" or target.type_identity != 0
            return false if target.element_family != "" or target.element_name != "" or target.element_type_identity != 0
            return false if target.name != "u8" and target.name != "u16" and target.name != "u32" and target.name != "u64"
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node = nodes[root]
            return false if node.kind != "int" or node.value < 0
            return false if node.operator != "" or node.left != 0 or node.right != 0 or node.auxiliary != 0
            return false if node.children_start != 0 or node.children_count != 0 or node.name != "" or node.secondary_name != ""
            maximum: u64 = 255 if target.name == "u8" else 65535 if target.name == "u16" else 4294967295 if target.name == "u32" else 18446744073709551615u64
            return node.value.u64() <= maximum

        def proof_kernel_replay_conditional_branch_sort(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, then_root: usize, else_root: usize, then_sort: ProofKernelInferredSort, else_sort: ProofKernelInferredSort, work: mutable usize&) -> ProofKernelInferredSort:
            return then_sort if proof_kernel_replay_sort_equal(then_sort, else_sort)
            return proof_kernel_replay_unknown_sort() if not then_sort.known or not else_sort.known
            return else_sort if proof_kernel_replay_conditional_literal_fits(nodes, then_root, else_sort, work)
            return then_sort if proof_kernel_replay_conditional_literal_fits(nodes, else_root, then_sort, work)
            return proof_kernel_replay_unknown_sort()
