extend ElisaProofKernelReplay:
    private:
        # Compare stable receiver paths and validate them in one pass. Only identifiers and
        # field projections are admitted; parentheses are stripped by arena encoding.
        def proof_kernel_replay_disjunction_stable_receivers_equal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, right_root: usize, work_used: mutable usize&, depth: usize) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or left_root >= nodes.count or right_root >= nodes.count
                not proof_kernel_replay_valid(nodes, left_root) or not proof_kernel_replay_valid(nodes, right_root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, left_root, work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, right_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_arena_shape_valid(nodes[left_root]) or not proof_kernel_replay_arena_shape_valid(nodes[right_root])
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left: ElisaProofKernelCore::ProofKernelNode = nodes[left_root]
            right: ElisaProofKernelCore::ProofKernelNode = nodes[right_root]
            return false if left.kind != right.kind
            return left.name != "" and left.name == right.name if left.kind == "ident"
            return false if left.kind != "field" or left.name != right.name
            return proof_kernel_replay_disjunction_stable_receivers_equal_with_work(nodes, left.left, right.left, work_used, depth + 1)

        # Scan the expression graph under one shared replay budget. Unknown node kinds are
        # conservatively treated as call-bearing; this only disables term substitution.
        def proof_kernel_replay_disjunction_term_has_call_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&, depth: usize) -> (complete: bool, found: bool):
            return (false, false) if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                not proof_kernel_replay_arena_shape_valid(nodes[root])
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (true, true) if node.kind in {"call", "resource-call", "resource-call-lend"}
            first: (complete: bool, found: bool) = (true, false)
            second: (complete: bool, found: bool) = (true, false)
            third: (complete: bool, found: bool) = (true, false)
            if node.kind in {"binary", "index", "dict_entry"}:
                first <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                return proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.right, work_used, depth + 1)
            if node.kind in {"unary", "move", "paren", "field", "scope", "checked-get"}:
                return proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
            if node.kind in {"slice", "if"}:
                first <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                second <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.right, work_used, depth + 1)
                return (false, false) if not second.complete
                return (true, true) if second.found
                return proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.auxiliary, work_used, depth + 1)
            if node.kind == "checked-index":
                first <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                return proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.right, work_used, depth + 1)
            if node.kind in {"index-n", "construct", "record-update"}:
                first <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if:
                    first.found
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for offset in 0..<node.children_count |offset, nodes, children, node, work_used, depth|:
                    item: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, children[node.children_start + offset], work_used, depth + 1)
                    return (false, false) if not item.complete
                    return (true, true) if item.found
                return (true, false)
            if node.kind in {"array", "tuple", "set", "dict"}:
                return (true, true) if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for offset in 0..<node.children_count |offset, nodes, children, node, work_used, depth|:
                    item: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, children[node.children_start + offset], work_used, depth + 1)
                    return (false, false) if not item.complete
                    return (true, true) if item.found
                return (true, false)
            if node.kind in {"int", "typed-int", "bool", "float", "string", "char", "ident"}:
                return (true, false)
            return (true, true)

        # Operator overloads remain binary arena nodes. Walk each index subterm and match it
        # against parser-origin overload markers so an overloaded arithmetic operation cannot
        # be mistaken for a stable, pure index computation.
        def proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, markers: darray[ProofKernelReplayWitnessMarker], root: usize, work_used: mutable usize&, depth: usize) -> (complete: bool, found: bool):
            return (false, false) if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                not proof_kernel_replay_arena_shape_valid(nodes[root])
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            for marker in markers |marker, nodes, children, root, work_used|:
                return (false, false) if not proof_kernel_replay_goal_search_charge(work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if marker.kind != PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_OPERATOR and marker.kind != PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_ELEMENT_OPERATOR and marker.kind != PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_SCALAR_REFERENCE_OPERATOR
                applies: bool = proof_kernel_replay_untrusted_scalar_reference_operator_applies_with_work(nodes, children, marker.root, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) if marker.kind == PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_SCALAR_REFERENCE_OPERATOR else proof_kernel_replay_untrusted_element_operator_applies_with_work(nodes, children, marker.root, root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) if marker.kind == PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_ELEMENT_OPERATOR else proof_kernel_replay_untrusted_operator_applies_with_work(nodes, children, marker.root, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (true, true) if applies
            first: (complete: bool, found: bool) = (true, false)
            second: (complete: bool, found: bool) = (true, false)
            third: (complete: bool, found: bool) = (true, false)
            if node.kind in {"binary", "index", "dict_entry"}:
                first <- proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                return proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.right, work_used, depth + 1)
            if node.kind in {"unary", "move", "paren", "field", "scope", "checked-get"}:
                return proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.left, work_used, depth + 1)
            if node.kind in {"slice", "if"}:
                first <- proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                second <- proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.right, work_used, depth + 1)
                return (false, false) if not second.complete
                return (true, true) if second.found
                return proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.auxiliary, work_used, depth + 1)
            if node.kind == "checked-index":
                first <- proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                return proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.right, work_used, depth + 1)
            if node.kind in {"index-n", "construct", "record-update"}:
                first <- proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for offset in 0..<node.children_count |offset, children, node, markers, nodes, work_used, depth|:
                    item: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, children[node.children_start + offset], work_used, depth + 1)
                    return (false, false) if not item.complete
                    return (true, true) if item.found
                return (true, false)
            if node.kind in {"array", "tuple", "set", "dict"}:
                return (true, true) if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for offset in 0..<node.children_count |offset, children, node, markers, nodes, work_used, depth|:
                    item: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_untrusted_operator_with_work(nodes, children, markers, children[node.children_start + offset], work_used, depth + 1)
                    return (false, false) if not item.complete
                    return (true, true) if item.found
                return (true, false)
            return (true, false) if node.kind in {"int", "typed-int", "bool", "float", "string", "char", "ident"}
            return (true, false) if node.kind in {"call", "resource-call", "resource-call-lend"}
            return (true, true)
