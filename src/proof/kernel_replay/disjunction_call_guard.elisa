extend ElisaProofKernelReplay:
    private:
        # Scan the expression graph under one shared replay budget. Unknown node kinds are
        # conservatively treated as call-bearing; this only disables term substitution.
        def proof_kernel_replay_disjunction_term_has_call_with_work(nodes: darray<ElisaProofKernelCore::ProofKernelNode>&, children: darray<usize>&, root: usize, work_used: mutable usize&, depth: usize) -> (complete: bool, found: bool):
            return (false, false) if not proof_kernel_replay_goal_search_charge(work_used)
            return (false, false) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return (false, false) if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return (false, false) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (true, true) if node.kind == "call" or node.kind == "resource-call" or node.kind == "resource-call-lend"
            first: (complete: bool, found: bool) = (true, false)
            second: (complete: bool, found: bool) = (true, false)
            third: (complete: bool, found: bool) = (true, false)
            if node.kind == "binary" or node.kind == "index" or node.kind == "dict_entry":
                first <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                return proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.right, work_used, depth + 1)
            if node.kind == "unary" or node.kind == "move" or node.kind == "paren" or node.kind == "field" or node.kind == "scope" or node.kind == "checked-get":
                return proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
            if node.kind == "slice" or node.kind == "if":
                first <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                second <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.right, work_used, depth + 1)
                return (false, false) if not second.complete
                return (true, true) if second.found
                return proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.auxiliary, work_used, depth + 1)
            if node.kind == "checked-index":
                first <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                return proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.right, work_used, depth + 1)
            if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update":
                first <- proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, node.left, work_used, depth + 1)
                return (false, false) if not first.complete
                return (true, true) if first.found
                return (true, true) if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for offset in 0..<node.children_count |offset, nodes, children, node, work_used, depth|:
                    item: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, children[node.children_start + offset], work_used, depth + 1)
                    return (false, false) if not item.complete
                    return (true, true) if item.found
                return (true, false)
            if node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict":
                return (true, true) if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for offset in 0..<node.children_count |offset, nodes, children, node, work_used, depth|:
                    item: (complete: bool, found: bool) = proof_kernel_replay_disjunction_term_has_call_with_work(nodes, children, children[node.children_start + offset], work_used, depth + 1)
                    return (false, false) if not item.complete
                    return (true, true) if item.found
                return (true, false)
            if node.kind == "int" or node.kind == "typed-int" or node.kind == "bool" or node.kind == "float" or node.kind == "string" or node.kind == "char" or node.kind == "ident":
                return (true, false)
            return (true, true)
