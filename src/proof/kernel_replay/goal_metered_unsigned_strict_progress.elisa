extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_progress_positive_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], step: usize, work_used: mutable usize&) -> bool:
            orders: mutable darray[usize] = []
            proof_kernel_replay_conjunct_facts_with_goal_work(nodes, facts, &orders, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            for fact in orders |fact, nodes, children, facts, step, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                order: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_readable_order_with_work(nodes, children, facts, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not order.known
                less: bool = proof_kernel_replay_goal_search_text_equal(order.operator, "<", work_used)
                greater: bool = proof_kernel_replay_goal_search_text_equal(order.operator, ">", work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not less and not greater
                low: usize = order.right if greater else order.left
                high: usize = order.left if greater else order.right
                zero: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, low, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not zero.known or zero.value != 0
                positive_step: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, high, step, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if positive_step
            false

        def proof_kernel_replay_nonwrapping_sum_progress_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], sum: usize, base: usize, strict: bool, work_used: mutable usize&) -> bool:
            operands: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, sum, "+", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not operands.known
            step: mutable usize = operands.right
            right_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, base, operands.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if right_matches:
                step <- operands.left
            else:
                left_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, base, operands.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_matches
            base_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, base, work_used)
            step_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, step, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or base_name == "" or step_name == ""
            width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, sum, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width <= 0
            base_width: i64 = proof_kernel_replay_sum_peer_unsigned_width_with_goal_work(nodes, children, base, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or base_width != width
            step_width: i64 = proof_kernel_replay_sum_peer_unsigned_width_with_goal_work(nodes, children, step, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or step_width != width
            if strict:
                return false if:
                    not proof_kernel_replay_progress_positive_with_work(nodes, children, facts, step, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            witness: (known: bool, bound: usize, strict: bool) = proof_kernel_replay_sum_upper_witness_with_goal_work(nodes, children, operands.left, operands.right, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not witness.known
            proof_kernel_replay_sum_bound_with_goal_work(nodes, children, facts, sum, "<=", witness.bound, work_used)

        def proof_kernel_replay_positive_sum_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], sum: usize, base: usize, work_used: mutable usize&) -> bool:
            proof_kernel_replay_nonwrapping_sum_progress_with_work(nodes, children, facts, sum, base, true, work_used)

        def proof_kernel_replay_unsigned_strict_progress_shape_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            binary: bool = proof_kernel_replay_goal_search_text_equal(nodes[goal_root].kind, "binary", work_used)
            operator: sview = nodes[goal_root].operator
            greater_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, ">=", work_used)
            less_equal: bool = proof_kernel_replay_goal_search_text_equal(operator, "<=", work_used)
            greater: bool = proof_kernel_replay_goal_search_text_equal(operator, ">", work_used)
            less: bool = proof_kernel_replay_goal_search_text_equal(operator, "<", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not binary
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return proof_kernel_replay_nonwrapping_sum_progress_with_work(nodes, children, facts, goal.left, goal.right, false, work_used) if greater_equal
            return proof_kernel_replay_nonwrapping_sum_progress_with_work(nodes, children, facts, goal.right, goal.left, false, work_used) if less_equal
            return proof_kernel_replay_positive_sum_with_work(nodes, children, facts, goal.left, goal.right, work_used) if greater
            return false if not less
            return true if proof_kernel_replay_positive_sum_with_work(nodes, children, facts, goal.right, goal.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            lower: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, goal.left, "-", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not lower.known
            upper: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, goal.right, "-", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not upper.known
            same_base: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, lower.left, upper.left, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_base
                not proof_kernel_replay_positive_sum_with_work(nodes, children, facts, lower.right, upper.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            sum: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, lower.right, "+", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not sum.known
            witness: (known: bool, bound: usize, strict: bool) = proof_kernel_replay_sum_upper_witness_with_goal_work(nodes, children, sum.left, sum.right, facts, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not witness.known
            same_bound: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, witness.bound, lower.left, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            same_bound
