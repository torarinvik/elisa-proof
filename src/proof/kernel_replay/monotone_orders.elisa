extend ElisaProofKernelReplay:
    private:
        # Mirror of the producer's monotone order rules over wrap-free unsigned terms: a sum is
        # below a sum when its operands are pairwise below, one of them strictly for `<`, and a
        # quotient by a variable divisor is below a constant `k` when its dividend is below
        # `k` times that divisor. Every reduced goal is replayed through the ordinary goal
        # dispatch, with the same split budget the producer spends.
        def proof_kernel_replay_monotone_order_goal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
                split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT
            root: usize = proof_kernel_replay_monotone_strip_with_goal_work(nodes, goal_root, work_used)
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary"
            ascending: bool = goal.operator in {"<", "<="}
            return false if not ascending and goal.operator != ">" and goal.operator != ">="
            strict: bool = goal.operator in {"<", ">"}
            smaller: usize = goal.left if ascending else goal.right
            larger: usize = goal.right if ascending else goal.left
            width: i64 = proof_kernel_replay_unsigned_width_in_expression_with_goal_work(nodes, children, smaller, facts, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width == 0
            safe: bool = proof_kernel_replay_unsigned_goal_safe_with_goal_work(nodes, children, facts, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not safe
            return true if:
                (proof_kernel_replay_monotone_sum(nodes, children, facts, smaller, larger, strict, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
                (proof_kernel_replay_monotone_weaken(nodes, children, facts, smaller, larger, strict, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
            return (proof_kernel_replay_monotone_quotient(nodes, children, facts, smaller, larger, strict, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_monotone_strip_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> usize:
            current: mutable usize = root
            for _ in 0..<8 |current, nodes, work_used|:
                return nodes.count if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    current >= nodes.count or not proof_kernel_replay_valid(nodes, current) or not proof_kernel_replay_goal_search_charge_node_text(nodes, current, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return current if nodes[current].kind != "paren"
                current <- nodes[current].left
            return nodes.count if:
                not proof_kernel_replay_goal_search_charge(work_used)
                current >= nodes.count or not proof_kernel_replay_valid(nodes, current) or not proof_kernel_replay_goal_search_charge_node_text(nodes, current, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            current

        def proof_kernel_replay_monotone_sum(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], smaller: usize, larger: usize, strict: bool, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            left_root: usize = proof_kernel_replay_monotone_strip_with_goal_work(nodes, smaller, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_root >= nodes.count
            right_root: usize = proof_kernel_replay_monotone_strip_with_goal_work(nodes, larger, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_root >= nodes.count
            left_sum: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, left_root, "+", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_sum.known
            right_sum: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, right_root, "+", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not right_sum.known
            return true if (proof_kernel_replay_monotone_pair(nodes, children, facts, left_sum.left, right_sum.left, left_sum.right, right_sum.right, strict, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
            return (proof_kernel_replay_monotone_pair(nodes, children, facts, left_sum.left, right_sum.right, left_sum.right, right_sum.left, strict, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_monotone_subgoal(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], left: usize, operator: sview, right: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            goal: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", operator, left, right, 0, work_used)
            return false if goal >= nodes.count
            return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        # Mirror: a term is below a sum through either operand, and below a
        # constant multiple `k >= 1` of a term through that term.
        def proof_kernel_replay_monotone_weaken(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], smaller: usize, larger: usize, strict: bool, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            order: sview = "<" if strict else "<="
            root: usize = proof_kernel_replay_monotone_strip_with_goal_work(nodes, larger, work_used)
            return false if root >= nodes.count
            sum: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, root, "+", work_used)
            if sum.known:
                return true if (proof_kernel_replay_monotone_subgoal(nodes, children, facts, smaller, order, sum.left, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
                return (proof_kernel_replay_monotone_subgoal(nodes, children, facts, smaller, order, sum.right, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
            product: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, root, "*", work_used)
            return false if not product.known
            left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, product.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, product.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                left_constant.known == right_constant.known
            factor: i64 = left_constant.value if left_constant.known else right_constant.value
            return false if factor < 1
            multiplied: usize = product.right if left_constant.known else product.left
            (proof_kernel_replay_monotone_subgoal(nodes, children, facts, smaller, order, multiplied, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_monotone_pair(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], first: usize, first_bound: usize, second: usize, second_bound: usize, strict: bool, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            if not strict:
                return (proof_kernel_replay_monotone_subgoal(nodes, children, facts, first, "<=", first_bound, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_monotone_subgoal(nodes, children, facts, second, "<=", second_bound, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
            if (proof_kernel_replay_monotone_subgoal(nodes, children, facts, second, "<=", second_bound, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write}):
                return true if (proof_kernel_replay_monotone_subgoal(nodes, children, facts, first, "<", first_bound, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
            return (proof_kernel_replay_monotone_subgoal(nodes, children, facts, first, "<=", first_bound, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_monotone_subgoal(nodes, children, facts, second, "<", second_bound, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_monotone_quotient(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], smaller: usize, larger: usize, strict: bool, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            limit: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, larger, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not limit.known or limit.value <= 0
            smaller_root: usize = proof_kernel_replay_monotone_strip_with_goal_work(nodes, smaller, work_used)
            return false if smaller_root >= nodes.count
            division: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, smaller_root, "/", work_used)
            return false if not division.known
            divisor_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, division.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or divisor_constant.known
            order: sview = "<" if strict else "<="
            scaled: (known: bool, operand: usize) = proof_kernel_replay_monotone_scaled_operand(nodes, division.left, limit.value, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            reduced: mutable bool = false
            if scaled.known:
                reduced <- (proof_kernel_replay_monotone_subgoal(nodes, children, facts, scaled.operand, order, division.right, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
            else:
                product: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", "*", larger, division.right, 0, work_used)
                return false if product >= nodes.count
                reduced <- (proof_kernel_replay_monotone_subgoal(nodes, children, facts, division.left, order, product, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})
            return false if not reduced
            return true if strict
            zero: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "int", "", 0, 0, 0, work_used)
            return false if zero >= nodes.count
            return (proof_kernel_replay_monotone_subgoal(nodes, children, facts, zero, "<", division.right, split_depth, depth, work_used, remaining: remaining - 1) can Global{Read,Write})

        def proof_kernel_replay_monotone_scaled_operand(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, dividend: usize, factor: i64, work_used: mutable usize&) -> (known: bool, operand: usize):
            return (true, dividend) if factor == 1
            root: usize = proof_kernel_replay_monotone_strip_with_goal_work(nodes, dividend, work_used)
            return (false, 0) if root >= nodes.count
            product: (known: bool, left: usize, right: usize) = proof_kernel_replay_binary_operands_with_goal_work(nodes, root, "*", work_used)
            return (false, 0) if not product.known
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, product.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, product.left) if right_constant.known and right_constant.value == factor
            left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, product.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return (true, product.right) if left_constant.known and left_constant.value == factor
            (false, 0)
