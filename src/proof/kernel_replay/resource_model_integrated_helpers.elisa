# Factored helpers retained by the branch integration.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_congruence_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, exhausted: mutable bool&) -> bool:
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
            return false if not located.known
            goal: ElisaProofKernelCore::ProofKernelNode = located.node
            return false if not proof_kernel_replay_arena_shape_valid(goal)
            # The conclusion of this rule is always an equality. Order and disequality goals are
            # left to the arithmetic tiers; congruence establishes identity, not comparison.
            return false if goal.kind != "binary" or goal.operator != "=="
            return false if facts.count == 0
            return false if not proof_kernel_replay_congruence_has_seed_in_facts(nodes, facts)
            terms: mutable darray[usize] = []
            # The conclusion must lie entirely inside the primitive scalar fragment.
            return false if not proof_kernel_replay_congruence_collect(nodes, children, facts, goal_root, &terms, exhausted, 0)
            # Premises contribute on a best-effort basis: one outside the fragment, such as a
            # type marker or an aggregate comparison, simply adds no equality.
            for fact in facts |fact, nodes, children, terms, exhausted|:
                collected: bool = proof_kernel_replay_congruence_collect(nodes, children, facts, fact, &terms, exhausted, 0)
                continue if not collected
            parent: mutable darray[usize] = []
            for index in 0..<terms.count |index, parent|:
                parent.push(index)
            seeded: mutable bool = false
            for fact in facts |fact, nodes, children, terms, parent, seeded|:
                return false if not proof_kernel_replay_congruence_seed(nodes, children, terms, &parent, fact, 0, &seeded)
            # Without a non-trivial equality premise this rule degenerates to structural
            # equality, which earlier tiers already decided.
            return false if not seeded
            proof_kernel_replay_congruence_saturate(nodes, children, terms, &parent, exhausted)
            left_class: (known: bool, index: usize) = proof_kernel_replay_congruence_class(nodes, children, terms, &parent, goal.left)
            right_class: (known: bool, index: usize) = proof_kernel_replay_congruence_class(nodes, children, terms, &parent, goal.right)
            return false if not left_class.known or not right_class.known
            return left_class.index == right_class.index

        # --- Declared effect containment ----------------------------------------------------
        #
        # The producer resolves each direct call in a function body to a declared callee and
        # records that callee's declared `can[...]` row beside the caller's own. This rule
        # re-derives the containment: every effect named by a call entry must appear in the
        # declaring row. It is a statement about declared rows only. What a body performs
        # without a call, and whether a row faithfully describes a body, are the compiler's
        # effect checker's business, and the report says so rather than implying otherwise.
        #
        # An unresolved callee, an abstract row, or a row the producer could not compare never
        # reaches here: the producer emits a diagnostic and no certificate at all.

        def proof_kernel_replay_effect_row_contains(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, row_root: usize, effect: sview) -> bool:
            return false if effect == "" or row_root >= nodes.count or nodes[row_root].kind != "effect-row"
            row: ElisaProofKernelCore::ProofKernelNode = nodes[row_root]
            return false if not proof_kernel_replay_child_range_valid(row.children_start, row.children_count, children.count)
            for offset in 0..<row.children_count |offset, row, children, nodes, effect|:
                member: (known: bool, value: usize) = proof_kernel_replay_index_at(children, row.children_start + offset)
                continue if not member.known
                continue if member.value >= nodes.count or nodes[member.value].kind != "effect"
                return true if nodes[member.value].name == effect
            return false

        def proof_kernel_replay_effect_row_within(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, inner_root: usize, outer_root: usize) -> bool:
            return false if inner_root >= nodes.count or nodes[inner_root].kind != "effect-row"
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[inner_root]
            return false if not proof_kernel_replay_child_range_valid(inner.children_start, inner.children_count, children.count)
            for offset in 0..<inner.children_count |offset, inner, children, nodes, outer_root|:
                member: (known: bool, value: usize) = proof_kernel_replay_index_at(children, inner.children_start + offset)
                return false if not member.known
                return false if member.value >= nodes.count or nodes[member.value].kind != "effect"
                return false if not proof_kernel_replay_effect_row_contains(nodes, children, outer_root, nodes[member.value].name)
            return true

        def proof_kernel_replay_effect_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, goal_root: usize) -> bool:
            return false if goal_root >= nodes.count or nodes[goal_root].kind != "effect-containment"
            root: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if not proof_kernel_replay_arena_shape_valid(root)
            declared_row: usize = root.left
            return false if declared_row >= nodes.count or nodes[declared_row].kind != "effect-row"
            return false if not proof_kernel_replay_child_range_valid(root.children_start, root.children_count, children.count)
            for offset in 0..<root.children_count |offset, root, children, nodes, declared_row|:
                entry: (known: bool, value: usize) = proof_kernel_replay_index_at(children, root.children_start + offset)
                return false if not entry.known
                return false if entry.value >= nodes.count or nodes[entry.value].kind != "effect-call"
                return false if not proof_kernel_replay_effect_row_within(nodes, children, nodes[entry.value].left, declared_row)
            return true

        # Independent replay for `x != a or x != b`. This is valid only for one
        # exact unsigned primitive term and distinct constants that fit its width;
        # arbitrary calls and overloaded comparisons cannot enter this rule.
        def proof_kernel_replay_unsigned_literal_fits(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, width: i64) -> bool:
            return false if width <= 0 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, 0)
            return false if not constant.known
            return constant.value <= proof_kernel_replay_unsigned_width_max(width) if constant.value >= 0
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return width == 64 and node.kind == "int" and node.value == constant.value

        def proof_kernel_replay_unsigned_disequality_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> (known: bool, term: usize, value: i64):
            return (false, 0, 0) if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, 0) if comparison.kind != "binary" or comparison.operator != "!=" or comparison.right >= nodes.count
            width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, comparison.left, facts, 0)
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, comparison.right, 0)
            return (false, 0, 0) if width == 0 or not proof_kernel_replay_unsigned_literal_fits(nodes, comparison.right, width)
            return (false, 0, 0) if not proof_kernel_replay_primitive_comparison(nodes, children, facts, comparison.left, comparison.right)
            return (true, comparison.left, constant.value)

        def proof_kernel_replay_unsigned_distinct_disequality_disjunction(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "or"
            first: (known: bool, term: usize, value: i64) = proof_kernel_replay_unsigned_disequality_constant(nodes, children, facts, goal.left)
            second: (known: bool, term: usize, value: i64) = proof_kernel_replay_unsigned_disequality_constant(nodes, children, facts, goal.right)
            return false if not first.known or not second.known or first.value == second.value
            return proof_kernel_replay_expr_equal(nodes, children, first.term, second.term, 0)

        # Independently derive `x != a` from a fact `x == b` only for one
        # identical unsigned primitive term and distinct in-range constants.
        def proof_kernel_replay_unsigned_disequality_from_equality_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "!=" or goal.right >= nodes.count
            width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, goal.left, facts, 0)
            target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, goal.right, 0)
            return false if width == 0 or not proof_kernel_replay_unsigned_literal_fits(nodes, goal.right, width)
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, goal.left, goal.right)
            for fact_root in facts |fact_root, nodes, children, facts, goal, width, target|:
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "==" or fact.left >= nodes.count or fact.right >= nodes.count
                if proof_kernel_replay_expr_equal(nodes, children, goal.left, fact.left, 0) and proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right):
                    known_value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, fact.right, 0)
                    return true if known_value.known and proof_kernel_replay_unsigned_literal_fits(nodes, fact.right, width) and known_value.value != target.value
                if proof_kernel_replay_expr_equal(nodes, children, goal.left, fact.right, 0) and proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right):
                    known_value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, fact.left, 0)
                    return true if known_value.known and proof_kernel_replay_unsigned_literal_fits(nodes, fact.left, width) and known_value.value != target.value
            return false

        # Mirror the producer's local comparison rule. It consumes only a typed primitive
        # equality premise for the exact term and small literal; unrelated premises are not
        # interpreted by this step.
