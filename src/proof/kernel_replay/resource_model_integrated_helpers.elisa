# Factored helpers retained by the branch integration.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_unsigned_expressions_free_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&, depth: usize) -> bool:
            goal_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, goal_root, facts, work_used, depth)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or goal_width != 0
            for fact in facts |fact, nodes, children, facts, work_used, depth|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                fact_width: i64 = proof_kernel_replay_unsigned_width_with_goal_work(nodes, children, fact, facts, work_used, depth)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or fact_width != 0
            true

        def proof_kernel_replay_goal_depth_remaining(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            work_used: mutable usize = 0
            proven: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, goal_root, split_depth, depth, &work_used, remaining) can Global{Read,Write})
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proven

        def proof_kernel_replay_goal_depth(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_root, split_depth, depth, remaining) can Global{Read,Write})

        def proof_kernel_replay_congruence_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, exhausted: mutable bool&) -> bool:
            work_used: mutable usize = 0
            proof_kernel_replay_congruence_goal_with_goal_work(nodes, children, facts, goal_root, work_used, exhausted)

        def proof_kernel_replay_congruence_goal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&, exhausted: mutable bool&) -> bool:
            if not proof_kernel_replay_goal_search_charge(work_used):
                exhausted <- true
                return false
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
            return false if not located.known
            if not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used):
                exhausted <- true if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return false
            if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                exhausted <- true
                return false
            goal: ElisaProofKernelCore::ProofKernelNode = located.node
            return false if not proof_kernel_replay_arena_shape_valid(goal)
            # The conclusion of this rule is always an equality. Order and disequality goals are
            # left to the arithmetic tiers; congruence establishes identity, not comparison.
            return false if:
                goal.kind != "binary" or goal.operator != "=="
                facts.count == 0
            has_seed: bool = proof_kernel_replay_congruence_has_seed_in_facts_with_goal_work(nodes, facts, work_used)
            if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                exhausted <- true
                return false
            return false if not has_seed
            terms: mutable darray[usize] = []
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            marker_cache: mutable darray[ProofKernelReplayWitnessMarker] = []
            marker_cache_complete: bool = proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &marker_cache, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            if not marker_cache_complete or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                exhausted <- true if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return false
            markers.extend(marker_cache)
            markers_ready: mutable bool = true
            # The conclusion must lie entirely inside the primitive scalar fragment.
            goal_collected: bool = proof_kernel_replay_congruence_collect_with_goal_work(nodes, children, facts, &markers, &markers_ready, goal_root, &terms, exhausted, work_used, 0)
            if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                exhausted <- true
                return false
            return false if not goal_collected
            # Premises contribute on a best-effort basis: one outside the fragment, such as a
            # type marker or an aggregate comparison, simply adds no equality.
            for fact in facts |fact, nodes, children, terms, markers, markers_ready, exhausted, work_used|:
                if not proof_kernel_replay_goal_search_charge(work_used):
                    exhausted <- true
                    return false
                collected: bool = proof_kernel_replay_congruence_collect_with_goal_work(nodes, children, facts, &markers, &markers_ready, fact, &terms, exhausted, work_used, 0)
                if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                    exhausted <- true
                    return false
                continue if not collected
            parent: mutable darray[usize] = []
            for index in 0..<terms.count |index, parent, work_used|:
                if not proof_kernel_replay_goal_search_charge(work_used):
                    exhausted <- true
                    return false
                parent.push(index)
            seeded: mutable bool = false
            for fact in facts |fact, nodes, children, terms, parent, seeded, work_used|:
                if not proof_kernel_replay_goal_search_charge(work_used):
                    exhausted <- true
                    return false
                seeded_ok: bool = proof_kernel_replay_congruence_seed_with_goal_work(nodes, children, markers, terms, &parent, fact, work_used, 0, &seeded)
                if not seeded_ok or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                    exhausted <- true if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return false
            # Without a non-trivial equality premise this rule degenerates to structural
            # equality, which earlier tiers already decided.
            return false if not seeded
            saturated: bool = proof_kernel_replay_congruence_saturate_indexed_with_goal_work(nodes, children, terms, &parent, exhausted, work_used)
            if not saturated or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                exhausted <- true if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return false
            left_class: (known: bool, index: usize) = proof_kernel_replay_congruence_class_with_goal_work(nodes, children, terms, &parent, goal.left, work_used)
            if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                exhausted <- true
                return false
            right_class: (known: bool, index: usize) = proof_kernel_replay_congruence_class_with_goal_work(nodes, children, terms, &parent, goal.right, work_used)
            if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                exhausted <- true
                return false
            return false if not left_class.known or not right_class.known
            return left_class.index == right_class.index

        def proof_kernel_replay_congruence_goal_once_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&, attempted: mutable bool&) -> bool:
            return false if attempted
            attempted <- true
            exhausted: mutable bool = false
            proof_kernel_replay_congruence_goal_with_goal_work(nodes, children, facts, goal_root, work_used, &exhausted)

        # --- Declared effect containment ----------------------------------------------------
        #
        # The producer resolves each direct call in a function body to a declared callee and
        # records that callee's declared `can[...]` row beside the caller's own. This rule
        # re-derives the containment: every effect named by a call entry must appear in the
        # declaring row. It is a statement about declared rows only. What a body performs
        # without a call, and whether a row faithfully describes a body, are the compiler's
        # effect checker's business, and the report says so rather than implying otherwise.
        #
        # An unresolved callee, an abstract row, or a row the producer could not compare never
        # reaches here: the producer emits a diagnostic and no certificate at all.

        def proof_kernel_replay_effect_row_contains_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, row_root: usize, effect: sview, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_resource_charge_work_used(&work_used, 1)
                effect == "" or row_root >= nodes.count or nodes[row_root].kind != "effect-row"
            row: ElisaProofKernelCore::ProofKernelNode = nodes[row_root]
            return false if:
                not proof_kernel_replay_resource_charge_node_text_used(&work_used, row)
                not proof_kernel_replay_child_range_valid(row.children_start, row.children_count, children.count)
            for offset in 0..<row.children_count |offset, row, children, nodes, effect, work_used|:
                return false if not proof_kernel_replay_resource_charge_work_used(&work_used, 1)
                member: (known: bool, value: usize) = proof_kernel_replay_index_at(children, row.children_start + offset)
                return false if:
                    not member.known or member.value >= nodes.count or nodes[member.value].kind != "effect"
                    not proof_kernel_replay_resource_charge_node_text_used(&work_used, nodes[member.value])
                    not proof_kernel_replay_resource_charge_text_pair_used(&work_used, nodes[member.value].name, effect)
                return true if nodes[member.value].name == effect
            return false

        def proof_kernel_replay_effect_row_within_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, inner_root: usize, outer_root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_resource_charge_work_used(&work_used, 1)
                inner_root >= nodes.count or nodes[inner_root].kind != "effect-row"
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[inner_root]
            return false if:
                not proof_kernel_replay_resource_charge_node_text_used(&work_used, inner)
                not proof_kernel_replay_child_range_valid(inner.children_start, inner.children_count, children.count)
            for offset in 0..<inner.children_count |offset, inner, children, nodes, outer_root, work_used|:
                return false if not proof_kernel_replay_resource_charge_work_used(&work_used, 1)
                member: (known: bool, value: usize) = proof_kernel_replay_index_at(children, inner.children_start + offset)
                return false if:
                    not member.known
                    member.value >= nodes.count or nodes[member.value].kind != "effect"
                    not proof_kernel_replay_resource_charge_node_text_used(&work_used, nodes[member.value])
                    not proof_kernel_replay_effect_row_contains_with_work(nodes, children, outer_root, nodes[member.value].name, work_used)
            return true

        def proof_kernel_replay_effect_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, goal_root: usize) -> bool:
            work_used: mutable usize = 0
            return false if:
                not proof_kernel_replay_resource_charge_work_used(&work_used, 1)
                goal_root >= nodes.count or nodes[goal_root].kind != "effect-containment"
            root: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if:
                not proof_kernel_replay_resource_charge_node_text_used(&work_used, root)
                not proof_kernel_replay_arena_shape_valid(root)
            declared_row: usize = root.left
            return false if:
                declared_row >= nodes.count or nodes[declared_row].kind != "effect-row"
                not proof_kernel_replay_resource_charge_node_text_used(&work_used, nodes[declared_row])
                not proof_kernel_replay_child_range_valid(nodes[declared_row].children_start, nodes[declared_row].children_count, children.count)
                not proof_kernel_replay_child_range_valid(root.children_start, root.children_count, children.count)
            for offset in 0..<root.children_count |offset, root, children, nodes, declared_row, work_used|:
                return false if not proof_kernel_replay_resource_charge_work_used(&work_used, 1)
                entry: (known: bool, value: usize) = proof_kernel_replay_index_at(children, root.children_start + offset)
                return false if:
                    not entry.known
                    entry.value >= nodes.count or nodes[entry.value].kind != "effect-call"
                    not proof_kernel_replay_resource_charge_node_text_used(&work_used, nodes[entry.value])
                    not proof_kernel_replay_effect_row_within_with_work(nodes, children, nodes[entry.value].left, declared_row, work_used)
            work_used <= PROOF_KERNEL_REPLAY_RESOURCE_WORK_LIMIT

        # Independent replay for `x != a or x != b`. This is valid only for one
        # Mirror the producer's local comparison rule. It consumes only a typed primitive
        # equality premise for the exact term and small literal; unrelated premises are not
        # interpreted by this step.
