extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_call_disjunction_entails_goal_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, work_used: mutable usize&) -> bool can Global{Read,Write}:
            candidate_count: mutable usize = 0
            for fact in facts |candidate_count, nodes, children, facts, goal_root, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction_with_work(nodes, fact, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not candidate.known
                relevance: usize = (proof_kernel_replay_disjunction_candidate_relevance_with_work(nodes, children, facts, goal_root, fact, work_used, 0) can Global{Read,Write})
                return true if relevance == 1
                continue if relevance == 0
                return true if (proof_kernel_replay_disjunction_entails_goal_with_work(nodes, children, facts, fact, goal_root, work_used, 0) can Global{Read,Write})
                candidate_count <- candidate_count + 1
                break if candidate_count >= PROOF_KERNEL_REPLAY_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES
            return false
