extend ElisaProofKernelReplay:
    private:
        # Projection out of a fact, in a single signed walk. With `negated` false the question is
        # whether `root` entails the goal; with it true, whether `not root` does. A conjunction
        # entails each conjunct, a negated disjunction entails each negated disjunct, and a
        # negation flips the sign. All three are classical and hold for any propositions; the
        # proposition shape of every fact and goal is checked before this runs.
        def proof_kernel_replay_fact_contains_signed_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, goal_root: usize, negated: bool, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                root >= nodes.count
                not proof_kernel_replay_valid(nodes, root)
            if not negated:
                return true if proof_kernel_replay_goal_search_expr_equal(nodes, children, root, goal_root, work_used)
            else:
                goal_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
                if goal_located.known and goal_located.node.kind == "unary" and goal_located.node.operator == "not":
                    return true if proof_kernel_replay_goal_search_expr_equal(nodes, children, goal_located.node.left, root, work_used)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "unary" and node.operator == "not":
                return proof_kernel_replay_fact_contains_signed_with_work(nodes, children, node.left, goal_root, not negated, work_used, depth + 1)
            if node.kind == "binary" and node.operator == "and" and not negated:
                return proof_kernel_replay_fact_contains_signed_with_work(nodes, children, node.left, goal_root, false, work_used, depth + 1) or proof_kernel_replay_fact_contains_signed_with_work(nodes, children, node.right, goal_root, false, work_used, depth + 1)
            if node.kind == "binary" and node.operator == "or" and negated:
                return proof_kernel_replay_fact_contains_signed_with_work(nodes, children, node.left, goal_root, true, work_used, depth + 1) or proof_kernel_replay_fact_contains_signed_with_work(nodes, children, node.right, goal_root, true, work_used, depth + 1)
            return false
