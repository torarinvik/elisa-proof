const PROOF_KERNEL_REPLAY_MAX_FACT_BIT_WIDTH: usize = 4096
const PROOF_KERNEL_REPLAY_MAX_FACT_ENUMERATION: usize = 65536
const PROOF_KERNEL_REPLAY_MAX_MODEL_FACTS: usize = 64
const PROOF_KERNEL_REPLAY_MAX_MODEL_FRAME_NODES: usize = 512
const PROOF_KERNEL_REPLAY_MAX_MODEL_EVALUATION_WORK: usize = 200000

extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_false_boolean_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count
            match nodes[root].kind:
                "bool":
                    return nodes[root].value == 0
                _:
                    return false

        def proof_kernel_replay_negated_true_boolean_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count
            match nodes[root].kind:
                "unary":
                    return false if nodes[root].operator != "not"
                    inner: usize = nodes[root].left
                    return false if inner >= nodes.count or not proof_kernel_replay_valid(nodes, inner)
                    return nodes[inner].kind == "bool" and nodes[inner].value != 0
                _:
                    return false

        # Mirror of the producer's closed false comparison: both sides are safe constants
        # and the comparison's complement holds, so the premise is unreachable.
        def proof_kernel_replay_false_constant_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if root >= nodes.count
            match nodes[root].kind:
                "binary":
                    return proof_kernel_replay_negated_constant_comparison(nodes, nodes[root].left, nodes[root].operator, nodes[root].right)
                _:
                    return false

        def proof_kernel_replay_conjunction_operands(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, left: usize, right: usize):
            return (false, 0, 0) if root >= nodes.count
            match nodes[root].kind:
                "binary":
                    return (false, 0, 0) if nodes[root].operator != "and"
                    return (true, nodes[root].left, nodes[root].right)
                _:
                    return (false, 0, 0)

        # Inspect one fact and its conjunction operands without allocating a temporary root array.
        # `valid` is local to this bounded walk: an invalid child makes that conjunction branch
        # uninformative, while the caller may continue with the next top-level premise.
        def proof_kernel_replay_fact_inconsistent_node(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, remaining: usize) -> (valid: bool, inconsistent: bool):
            requires remaining > 0
            decreases remaining
            return (false, false) if:
                root >= nodes.count
                not proof_kernel_replay_valid(nodes, root)
            return (true, true) if:
                proof_kernel_replay_false_boolean_literal(nodes, root)
                proof_kernel_replay_negated_true_boolean_literal(nodes, root)
                proof_kernel_replay_false_constant_comparison(nodes, root)
            conjunction: (known: bool, left: usize, right: usize) = proof_kernel_replay_conjunction_operands(nodes, root)
            if conjunction.known and remaining > 1:
                left: (valid: bool, inconsistent: bool) = proof_kernel_replay_fact_inconsistent_node(nodes, conjunction.left, remaining - 1)
                return (true, false) if not left.valid
                return (true, true) if left.inconsistent
                assert remaining - 1 > 0
                assert remaining - 1 < remaining
                right: (valid: bool, inconsistent: bool) = proof_kernel_replay_fact_inconsistent_node(nodes, conjunction.right, remaining - 1)
                return (true, false) if not right.valid
                return (true, right.inconsistent)
            return (true, false)

        def proof_kernel_replay_facts_inconsistent_remaining(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, roots: darray[usize], remaining: usize) -> bool:
            return false if remaining == 0
            for root in roots |root, nodes, remaining|:
                return false if:
                    root >= nodes.count
                    not proof_kernel_replay_valid(nodes, root)
                result: (valid: bool, inconsistent: bool) = proof_kernel_replay_fact_inconsistent_node(nodes, root, remaining)
                return true if result.valid and result.inconsistent
            return false

        def proof_kernel_replay_facts_inconsistent(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, roots: darray[usize], depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if:
                not ElisaProofKernelCore::depth_valid(depth)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return proof_kernel_replay_facts_inconsistent_remaining(nodes, roots, remaining)

        # Mirror of the producer's arithmetic-free inconsistency: a false literal, or a
        # proposition beside its own negation. Safe to run before the fixed-width guard.
        def proof_kernel_replay_facts_propositionally_inconsistent(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, roots: darray[usize], depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if:
                not ElisaProofKernelCore::depth_valid(depth)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            assert depth + 1 <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return true if proof_kernel_replay_facts_inconsistent(nodes, roots, depth + 1)
            for root in roots |root, nodes, children, roots|:
                return true if proof_kernel_replay_fact_denies(nodes, children, root, roots)
            return false

        def proof_kernel_replay_model_value_at(values: darray[i64]&, requested: usize) -> (known: bool, value: i64):
            return (false, 0) if requested >= values.count
            assert requested < values.count
            return (true, values[requested])

        def proof_kernel_replay_i64_set(values: mutable darray[i64]&, requested: usize, value: i64) -> bool:
            return false if requested >= values.count
            assert requested < values.count
            values[requested] <- value
            return true

        # A compiler type marker states a declared type. It holds at every point of a bounded
        # domain and constrains nothing there, so the model evaluator reads it as true instead of
        # abandoning the enumeration on an unrecognized fact. Marker names alone are not enough:
        # every marker must pass the same arity, argument, and range checks used by scalar replay.
        def proof_kernel_replay_type_marker_callee(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> bool:
            unsigned: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info(nodes, children, root, 0)
            return true if unsigned.known
            signed: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_signed_marker_info(nodes, children, root, 0)
            return true if signed.known
            signed_place: (known: bool, term: usize, width: i64) = proof_kernel_replay_signed_place_marker_info(nodes, children, root, 0)
            return true if signed_place.known
            scalar: (known: bool, root: usize) = proof_kernel_replay_marker_argument(nodes, children, root, "__elisa_primitive_scalar_type")
            return true if scalar.known
            element: (known: bool, root: usize, depth: i64, width: i64) = proof_kernel_replay_element_marker(nodes, children, root)
            return element.known

        def proof_kernel_replay_exact_int(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize]) -> ProofKernelReplayInt:
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, 0)
            return constant if constant.known
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &bounds)
            return ProofKernelReplayInt{known: false, value: 0} if:
                root >= nodes.count
                not proof_kernel_replay_valid(nodes, root)
                nodes[root].kind != "ident" or nodes[root].name == ""
            bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, nodes[root].name)
            return ProofKernelReplayInt{known: true, value: bound.lower} if bound.has_lower and bound.has_upper and bound.lower == bound.upper
            return ProofKernelReplayInt{known: false, value: 0}

        # Replace an exact source-neutral subterm while preserving every surrounding arena
        # constructor. This is the certificate-side counterpart of the AST rewrite tactic and
        # deliberately returns the original root when no occurrence exists. The arena has already
        # passed admission before callers use this helper, so every recursive edge remains bounded
        # by the same 127-level term limit.

        # Mirror of `proof_or_leaf_matches`: whether `goal_root` is one alternative of the
        # disjunction chain at `root`. It only orders the split; every branch is still checked.
        def proof_kernel_replay_or_leaf_matches(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, goal_root: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not ElisaProofKernelCore::depth_valid(depth)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_or_leaf_matches(nodes, children, node.left, goal_root, depth + 1) if node.kind == "paren"
            if node.kind == "binary" and node.operator == "or":
                return proof_kernel_replay_or_leaf_matches(nodes, children, node.left, goal_root, depth + 1) or proof_kernel_replay_or_leaf_matches(nodes, children, node.right, goal_root, depth + 1)
            return proof_kernel_replay_expr_equal(nodes, children, root, goal_root, 0)

        def proof_kernel_replay_split_prefers(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, goal_root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            stripped: usize = nodes[root].left if nodes[root].kind == "paren" else root
            return proof_kernel_replay_linear_is_or(nodes, stripped) and proof_kernel_replay_or_leaf_matches(nodes, children, root, goal_root, 0)

include "./fact_model_integrated_helpers.elisa"
