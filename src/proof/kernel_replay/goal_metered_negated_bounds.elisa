extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_MAX_COLLECTED_BOUNDS: usize = 4096

        # Negated order facts feed the same bound model as positive comparisons. Keep their
        # classification and candidate scans inside the report's cumulative work meter.
        def proof_kernel_replay_collect_negated_bounds_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> void:
            return if not proof_kernel_replay_goal_search_charge(work_used)
            return if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if inner.kind == "binary" and inner.operator == "or":
                proof_kernel_replay_collect_negated_comparison_with_work(nodes, children, facts, inner.left, bounds, work_used)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_collect_negated_comparison_with_work(nodes, children, facts, inner.right, bounds, work_used)
                return
            proof_kernel_replay_collect_negated_comparison_with_work(nodes, children, facts, root, bounds, work_used)

        def proof_kernel_replay_collect_negated_comparison_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> void:
            return if not proof_kernel_replay_goal_search_charge(work_used)
            return if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            return if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return if inner.kind != "binary" or not proof_kernel_replay_negation_supported(inner.operator)
            if proof_kernel_replay_is_order_operator(inner.operator):
                return if not proof_kernel_replay_denial_integer_term_with_work(nodes, children, inner.left, facts, work_used, 0)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return if not proof_kernel_replay_denial_integer_term_with_work(nodes, children, inner.right, facts, work_used, 0)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proof_kernel_replay_collect_bound_comparison_with_goal_work(nodes, children, facts, root, inner.left, proof_kernel_replay_negation(inner.operator), inner.right, bounds, work_used)

        def proof_kernel_replay_collect_bound_comparison_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], comparison_root: usize, left_root: usize, operator: sview, right_root: usize, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> void:
            return if not proof_kernel_replay_goal_search_charge(work_used)
            comparison_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_work(nodes, children, facts, comparison_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return if not comparison_admission.complete or comparison_admission.untrusted or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, left_root, right_root, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, left_root, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or right_root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, right_root, work_used)
            left_name_root: mutable usize = nodes.count
            right_name_root: mutable usize = nodes.count
            if left_root < nodes.count:
                if nodes[left_root].kind == "ident" and nodes[left_root].name != "":
                    left_name_root <- left_root
            if right_root < nodes.count:
                if nodes[right_root].kind == "ident" and nodes[right_root].name != "":
                    right_name_root <- right_root
            left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_pins_goal_work(nodes, children, facts, left_root, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_pins_goal_work(nodes, children, facts, right_root, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if left_name_root < nodes.count and right_constant.known:
                incremented: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_constant.value, 1)
                proof_kernel_replay_add_named_bound_with_goal_work(nodes, bounds, nodes[left_name_root].name, incremented.value, true, work_used) if operator == ">" and incremented.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_named_bound_with_goal_work(nodes, bounds, nodes[left_name_root].name, right_constant.value, true, work_used) if operator in {">=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right_constant.value, 1)
                proof_kernel_replay_add_named_bound_with_goal_work(nodes, bounds, nodes[left_name_root].name, decremented.value, false, work_used) if operator == "<" and decremented.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_named_bound_with_goal_work(nodes, bounds, nodes[left_name_root].name, right_constant.value, false, work_used) if operator in {"<=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if right_name_root < nodes.count and left_constant.known:
                decremented_left: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, 1)
                proof_kernel_replay_add_named_bound_with_goal_work(nodes, bounds, nodes[right_name_root].name, decremented_left.value, false, work_used) if operator == ">" and decremented_left.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_named_bound_with_goal_work(nodes, bounds, nodes[right_name_root].name, left_constant.value, false, work_used) if operator in {">=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                incremented_left: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, 1)
                proof_kernel_replay_add_named_bound_with_goal_work(nodes, bounds, nodes[right_name_root].name, incremented_left.value, true, work_used) if operator == "<" and incremented_left.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_named_bound_with_goal_work(nodes, bounds, nodes[right_name_root].name, left_constant.value, true, work_used) if operator in {"<=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left_term: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key_with_goal_work(nodes, children, left_root, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if left_name_root == nodes.count and left_term.known and proof_kernel_replay_loop_range_bound_atom_with_goal_work(nodes, children, facts, left_root, work_used) and right_constant.known:
                incremented: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_constant.value, 1)
                proof_kernel_replay_add_key_bound_with_goal_work(bounds, left_term.name, left_term.offset, incremented.value, true, work_used) if operator == ">" and incremented.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_key_bound_with_goal_work(bounds, left_term.name, left_term.offset, right_constant.value, true, work_used) if operator in {">=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right_constant.value, 1)
                proof_kernel_replay_add_key_bound_with_goal_work(bounds, left_term.name, left_term.offset, decremented.value, false, work_used) if operator == "<" and decremented.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_key_bound_with_goal_work(bounds, left_term.name, left_term.offset, right_constant.value, false, work_used) if operator in {"<=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_term: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key_with_goal_work(nodes, children, right_root, work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if right_name_root == nodes.count and right_term.known and proof_kernel_replay_loop_range_bound_atom_with_goal_work(nodes, children, facts, right_root, work_used) and left_constant.known:
                decremented_left: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, 1)
                proof_kernel_replay_add_key_bound_with_goal_work(bounds, right_term.name, right_term.offset, decremented_left.value, false, work_used) if operator == ">" and decremented_left.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_key_bound_with_goal_work(bounds, right_term.name, right_term.offset, left_constant.value, false, work_used) if operator in {">=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                incremented_left: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, 1)
                proof_kernel_replay_add_key_bound_with_goal_work(bounds, right_term.name, right_term.offset, incremented_left.value, true, work_used) if operator == "<" and incremented_left.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_key_bound_with_goal_work(bounds, right_term.name, right_term.offset, left_constant.value, true, work_used) if operator in {"<=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if left_name_root == nodes.count and proof_kernel_replay_scoped_scalar_bound_atom_with_goal_work(nodes, children, facts, left_root, work_used) and right_constant.known:
                incremented: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_constant.value, 1)
                proof_kernel_replay_add_expression_bound_with_goal_work(nodes, children, bounds, left_root, incremented.value, true, work_used) if operator == ">" and incremented.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_expression_bound_with_goal_work(nodes, children, bounds, left_root, right_constant.value, true, work_used) if operator in {">=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right_constant.value, 1)
                proof_kernel_replay_add_expression_bound_with_goal_work(nodes, children, bounds, left_root, decremented.value, false, work_used) if operator == "<" and decremented.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_expression_bound_with_goal_work(nodes, children, bounds, left_root, right_constant.value, false, work_used) if operator in {"<=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if right_name_root == nodes.count and proof_kernel_replay_scoped_scalar_bound_atom_with_goal_work(nodes, children, facts, right_root, work_used) and left_constant.known:
                decremented_left: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, 1)
                proof_kernel_replay_add_expression_bound_with_goal_work(nodes, children, bounds, right_root, decremented_left.value, false, work_used) if operator == ">" and decremented_left.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_expression_bound_with_goal_work(nodes, children, bounds, right_root, left_constant.value, false, work_used) if operator in {">=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                incremented_left: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, 1)
                proof_kernel_replay_add_expression_bound_with_goal_work(nodes, children, bounds, right_root, incremented_left.value, true, work_used) if operator == "<" and incremented_left.known
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                proof_kernel_replay_add_expression_bound_with_goal_work(nodes, children, bounds, right_root, left_constant.value, true, work_used) if operator in {"<=", "=="}
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT

        def proof_kernel_replay_constant_int_with_pins_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> ProofKernelReplayInt:
            result: ProofKernelReplayInt = proof_kernel_replay_constant_int_remaining_with_work_limit(nodes, root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return ProofKernelReplayInt{known: false, value: 0} if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return result if result.known or root >= nodes.count
            return ProofKernelReplayInt{known: false, value: 0} if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[root].kind != "scope"
            pinned: (known: bool, value: i64) = proof_kernel_replay_pinned_constant_with_goal_work(nodes, children, facts, root, work_used)
            return ProofKernelReplayInt{known: false, value: 0} if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return ProofKernelReplayInt{known: true, value: pinned.value} if pinned.known
            ProofKernelReplayInt{known: false, value: 0}

        def proof_kernel_replay_loop_range_bound_atom_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            key: (known: bool, name: sview, offset: i64) = proof_kernel_replay_loop_range_atom_key_with_goal_work(nodes, children, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not key.known
            witnessed: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and witnessed

        def proof_kernel_replay_scoped_scalar_bound_atom_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            scalar_place: bool = nodes[root].kind == "call" or nodes[root].kind == "field" or (nodes[root].kind == "scope" and nodes[root].name != "")
            scalar_place and proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)

        def proof_kernel_replay_add_named_bound_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, bounds: mutable darray[ProofKernelReplayBound]&, name: sview, value: i64, lower: bool, work_used: mutable usize&) -> void:
            return if not proof_kernel_replay_goal_search_charge(work_used)
            empty_name: bool = proof_kernel_replay_goal_search_text_equal(name, "", work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or empty_name
            for mutable bound in bounds |bound, nodes, name, value, lower, work_used|:
                return if not proof_kernel_replay_goal_search_charge(work_used)
                continue if bound.term_key or bound.term_expression_key
                same_name: bool = proof_kernel_replay_goal_search_text_equal(bound.name, name, work_used)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not same_name
                old_has: bool = bound.has_lower if lower else bound.has_upper
                old_value: i64 = bound.lower if lower else bound.upper
                bound.has_lower <- true if lower
                bound.lower <- value if lower and (not old_has or value > old_value)
                bound.has_upper <- true if not lower
                bound.upper <- value if not lower and (not old_has or value < old_value)
                return
            proof_kernel_replay_fail_bound_work(work_used) if bounds.count >= PROOF_KERNEL_REPLAY_MAX_COLLECTED_BOUNDS
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            bounds <- bounds.push(ProofKernelReplayBound{name: name, term_name: "", term_offset: 0, term_key: false, term_root: 0, term_expression_key: false, has_lower: lower, lower: value if lower else 0, has_upper: not lower, upper: value if not lower else 0})

        def proof_kernel_replay_add_key_bound_with_goal_work(bounds: mutable darray[ProofKernelReplayBound]&, name: sview, offset: i64, value: i64, lower: bool, work_used: mutable usize&) -> void:
            return if not proof_kernel_replay_goal_search_charge(work_used)
            empty_name: bool = proof_kernel_replay_goal_search_text_equal(name, "", work_used)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or empty_name
            for mutable bound in bounds |bound, name, offset, value, lower, work_used|:
                return if not proof_kernel_replay_goal_search_charge(work_used)
                continue if not bound.term_key
                same_name: bool = proof_kernel_replay_goal_search_text_equal(bound.term_name, name, work_used)
                return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not same_name or bound.term_offset != offset
                old_has: bool = bound.has_lower if lower else bound.has_upper
                old_value: i64 = bound.lower if lower else bound.upper
                bound.has_lower <- true if lower
                bound.lower <- value if lower and (not old_has or value > old_value)
                bound.has_upper <- true if not lower
                bound.upper <- value if not lower and (not old_has or value < old_value)
                return
            proof_kernel_replay_fail_bound_work(work_used) if bounds.count >= PROOF_KERNEL_REPLAY_MAX_COLLECTED_BOUNDS
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            bounds <- bounds.push(ProofKernelReplayBound{name: "", term_name: name, term_offset: offset, term_key: true, term_root: 0, term_expression_key: false, has_lower: lower, lower: value if lower else 0, has_upper: not lower, upper: value if not lower else 0})

        def proof_kernel_replay_add_expression_bound_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, bounds: mutable darray[ProofKernelReplayBound]&, root: usize, value: i64, lower: bool, work_used: mutable usize&) -> void:
            return if not proof_kernel_replay_goal_search_charge(work_used)
            for mutable bound in bounds |bound, nodes, children, root, value, lower, work_used|:
                return if not proof_kernel_replay_goal_search_charge(work_used)
                continue if not bound.term_expression_key
                continue if root >= nodes.count or bound.term_root >= nodes.count
                if bound.term_root != root:
                    bound_node: ElisaProofKernelCore::ProofKernelNode = nodes[bound.term_root]
                    query_node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
                    same_kind: bool = proof_kernel_replay_goal_search_text_equal(bound_node.kind, query_node.kind, work_used)
                    if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                        proof_kernel_replay_fail_bound_work(work_used)
                        return
                    continue if not same_kind
                    same_operator: bool = proof_kernel_replay_goal_search_text_equal(bound_node.operator, query_node.operator, work_used)
                    if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                        proof_kernel_replay_fail_bound_work(work_used)
                        return
                    continue if not same_operator
                    continue if not proof_kernel_replay_goal_search_expr_equal(nodes, children, bound.term_root, root, work_used)
                old_has: bool = bound.has_lower if lower else bound.has_upper
                old_value: i64 = bound.lower if lower else bound.upper
                bound.has_lower <- true if lower
                bound.lower <- value if lower and (not old_has or value > old_value)
                bound.has_upper <- true if not lower
                bound.upper <- value if not lower and (not old_has or value < old_value)
                return
            proof_kernel_replay_fail_bound_work(work_used) if bounds.count >= PROOF_KERNEL_REPLAY_MAX_COLLECTED_BOUNDS
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            bounds <- bounds.push(ProofKernelReplayBound{name: "", term_name: "", term_offset: 0, term_key: false, term_root: root, term_expression_key: true, has_lower: lower, lower: value if lower else 0, has_upper: not lower, upper: value if not lower else 0})

        def proof_kernel_replay_fail_bound_work(work_used: mutable usize&) -> void:
            work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1

        def proof_kernel_replay_arm_bounds_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], negated: usize, bounds: mutable darray[ProofKernelReplayBound]&, work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, facts, bounds, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                proof_kernel_replay_collect_bounds_with_work(nodes, children, facts, fact, bounds, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if negated < nodes.count:
                proof_kernel_replay_collect_negated_bounds_with_work(nodes, children, facts, negated, bounds, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return proof_kernel_replay_close_equalities_with_work(nodes, children, facts, bounds, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
