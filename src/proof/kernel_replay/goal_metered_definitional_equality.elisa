extend ElisaProofKernelReplay:
    private:
        # Shared-budget, depth-preserving counterpart of structural expression equality. The
        # legacy definitionally-equal rule starts each comparison one rewrite level deeper.
        def proof_kernel_replay_expr_equal_at_depth_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize, work_used: mutable usize&) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if work_used == PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            remaining: usize = PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - work_used
            comparison_work: mutable usize = 0
            equal: bool = proof_kernel_replay_expr_equal_with_work(nodes, children, left_root, right_root, depth, remaining, &comparison_work)
            if not equal and comparison_work >= remaining:
                work_used <- PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT + 1
                return false
            return false if comparison_work > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT - work_used
            work_used <- work_used + comparison_work
            equal

        # Mirror of `proof_kernel_replay_definitionally_equal`. Explicit identity rewrites remain
        # available to proof search, while every equality and constant-folding query debits the
        # same report-level work counter.
        def proof_kernel_replay_definitionally_equal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            structural: bool = proof_kernel_replay_expr_equal_at_depth_with_goal_work(nodes, children, left_root, right_root, depth + 1, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if structural
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                left_root >= nodes.count or not proof_kernel_replay_valid(nodes, left_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, left_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            left: ElisaProofKernelCore::ProofKernelNode = nodes[left_root]
            if left.kind == "unary" and left.operator == "+":
                return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used)
            if left.kind == "binary":
                amount: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if left.operator in {"+", "-"}:
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used) if amount.known and amount.value == 0
                if left.operator == "*":
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used) if amount.known and amount.value == 1
                    if amount.known and amount.value == 0:
                        target: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return target.known and target.value == 0
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.right, right_root, depth + 1, work_used) if base.known and base.value == 1
                    if base.known and base.value == 0:
                        target: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return target.known and target.value == 0
                if left.operator == "/":
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used) if amount.known and amount.value == 1
                if left.operator == "%" and amount.known and amount.value == 1:
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return target.known and target.value == 0
                if left.operator == "&":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return target.known and target.value == 0 if:
                        amount.known and amount.value == 0
                        base.known and base.value == 0
                    same_operands: bool = proof_kernel_replay_expr_equal_at_depth_with_goal_work(nodes, children, left.left, left.right, depth + 1, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used) if same_operands
                if left.operator == "|":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.right, right_root, depth + 1, work_used) if base.known and base.value == 0
                    same_operands: bool = proof_kernel_replay_expr_equal_at_depth_with_goal_work(nodes, children, left.left, left.right, depth + 1, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used) if same_operands
                if left.operator == "^":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.right, right_root, depth + 1, work_used) if base.known and base.value == 0
                    same_operands: bool = proof_kernel_replay_expr_equal_at_depth_with_goal_work(nodes, children, left.left, left.right, depth + 1, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return target.known and target.value == 0 if same_operands
                if left.operator in {"<<", ">>"}:
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left.left, right_root, depth + 1, work_used) if amount.known and amount.value == 0
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                right_root >= nodes.count or not proof_kernel_replay_valid(nodes, right_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, right_root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right: ElisaProofKernelCore::ProofKernelNode = nodes[right_root]
            if right.kind == "unary" and right.operator == "+":
                return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used)
            if right.kind == "binary":
                amount: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if right.operator in {"+", "-"}:
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used) if amount.known and amount.value == 0
                if right.operator == "*":
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used) if amount.known and amount.value == 1
                    if amount.known and amount.value == 0:
                        left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return left_constant.known and left_constant.value == 0
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.right, depth + 1, work_used) if base.known and base.value == 1
                    if base.known and base.value == 0:
                        left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        return left_constant.known and left_constant.value == 0
                if right.operator == "/":
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used) if amount.known and amount.value == 1
                if right.operator == "%" and amount.known and amount.value == 1:
                    left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return left_constant.known and left_constant.value == 0
                if right.operator == "&":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return target.known and target.value == 0 if:
                        amount.known and amount.value == 0
                        base.known and base.value == 0
                    same_operands: bool = proof_kernel_replay_expr_equal_at_depth_with_goal_work(nodes, children, right.left, right.right, depth + 1, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used) if same_operands
                if right.operator == "|":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.right, depth + 1, work_used) if base.known and base.value == 0
                    same_operands: bool = proof_kernel_replay_expr_equal_at_depth_with_goal_work(nodes, children, right.left, right.right, depth + 1, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used) if same_operands
                if right.operator == "^":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, right.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - (depth + 1), work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.right, depth + 1, work_used) if base.known and base.value == 0
                    same_operands: bool = proof_kernel_replay_expr_equal_at_depth_with_goal_work(nodes, children, right.left, right.right, depth + 1, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    return target.known and target.value == 0 if same_operands
                if right.operator in {"<<", ">>"}:
                    return proof_kernel_replay_definitionally_equal_with_goal_work(nodes, children, left_root, right.left, depth + 1, work_used) if amount.known and amount.value == 0
            false
