extend ElisaProofKernelReplay:
    private:
        # Meter the structural conditional-difference shortcut used by unsigned safety. Width,
        # primitive-type, and expression-equality checks all spend the caller's report budget.
        def proof_kernel_replay_unsigned_conditional_difference_safe_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> bool:
            markers: mutable darray[ProofKernelReplayWitnessMarker] = []
            return false if not proof_kernel_replay_witness_marker_cache_fill_with_work(nodes, children, facts, &markers, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            proof_kernel_replay_unsigned_conditional_difference_safe_with_cached_markers_goal_work(nodes, children, facts, markers, root, work_used)

        def proof_kernel_replay_unsigned_conditional_difference_safe_with_cached_markers_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], markers: darray[ProofKernelReplayWitnessMarker], root: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            is_if: bool = proof_kernel_replay_goal_search_text_equal(node.kind, "if", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not is_if or not proof_kernel_replay_arena_shape_valid(node)
                node.left >= nodes.count or node.right >= nodes.count or node.auxiliary >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, node.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.right, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, node.auxiliary, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, node.left) or not proof_kernel_replay_valid(nodes, node.right) or not proof_kernel_replay_valid(nodes, node.auxiliary)
            zero: ElisaProofKernelCore::ProofKernelNode = nodes[node.auxiliary]
            zero_int: bool = proof_kernel_replay_goal_search_text_equal(zero.kind, "int", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not zero_int or zero.value != 0 or zero.operator != "" or zero.left != 0 or zero.right != 0 or zero.auxiliary != 0 or zero.children_start != 0 or zero.children_count != 0 or zero.name != "" or zero.secondary_name != ""
            delta: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
            delta_binary: bool = proof_kernel_replay_goal_search_text_equal(delta.kind, "binary", work_used)
            delta_subtract: bool = proof_kernel_replay_goal_search_text_equal(delta.operator, "-", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not delta_binary or not delta_subtract or not proof_kernel_replay_arena_shape_valid(delta)
                delta.left >= nodes.count or delta.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, delta.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, delta.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, delta.left) or not proof_kernel_replay_valid(nodes, delta.right)
            left_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[delta.left].kind, "ident", work_used)
            right_ident: bool = proof_kernel_replay_goal_search_text_equal(nodes[delta.right].kind, "ident", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_ident or not right_ident
            width: i64 = proof_kernel_replay_unsigned_width_from_markers_with_goal_work(markers, nodes[delta.left].name, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or (width != 8 and width != 16 and width != 32 and width != 64)
                proof_kernel_replay_unsigned_width_from_markers_with_goal_work(markers, nodes[delta.right].name, work_used) != width
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, delta.left, delta.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            condition: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
            condition_binary: bool = proof_kernel_replay_goal_search_text_equal(condition.kind, "binary", work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not condition_binary or not proof_kernel_replay_arena_shape_valid(condition)
                condition.left >= nodes.count or condition.right >= nodes.count
                not proof_kernel_replay_goal_search_charge_node_text(nodes, condition.left, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, condition.right, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not proof_kernel_replay_valid(nodes, condition.left) or not proof_kernel_replay_valid(nodes, condition.right)
            condition_admission: (complete: bool, untrusted: bool) = proof_kernel_replay_comparison_root_untrusted_with_markers_and_work(nodes, children, markers, node.left, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return false if:
                not condition_admission.complete or condition_admission.untrusted
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_primitive_comparison_with_markers_with_work(nodes, children, markers, condition.left, condition.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            is_greater: bool = proof_kernel_replay_goal_search_text_equal(condition.operator, ">", work_used)
            is_greater_equal: bool = proof_kernel_replay_goal_search_text_equal(condition.operator, ">=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if is_greater or is_greater_equal:
                same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, condition.left, delta.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_left
                proof_kernel_replay_goal_search_expr_equal(nodes, children, condition.right, delta.right, work_used)
            is_less: bool = proof_kernel_replay_goal_search_text_equal(condition.operator, "<", work_used)
            is_less_equal: bool = proof_kernel_replay_goal_search_text_equal(condition.operator, "<=", work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if is_less or is_less_equal:
                same_left: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, condition.left, delta.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_left
                return proof_kernel_replay_goal_search_expr_equal(nodes, children, condition.right, delta.left, work_used)
            false
