# Kernel replay of the symbolic-range forall rules (BACKLOG W-02; checker side in
# linear/symbolic_quantifiers.elisa): empty `b <= a`, cover by a fact `forall j in c..<d`
# with an alpha-equal body and `c <= a`, `b <= d`, or extend with `b <= d + 1` and P(d), or
# weaken: the same covering fact whose body, at the marker, proves the goal's body there, or
# weaken over `c..<d` and extend with `b <= d + 1` and P(d), or vacuous: a body `(not g) or q`
# with g free of the binder and refuted by the facts. A forall fact also proves a
# non-quantified goal that is its body at one of the goal's subscripts t, with c <= t < d.
# Bodies are compared after both binders become a marker that is absent from the arena.
# The arena is shared by every certificate and a failed side search may fill its node budget,
# so the marker, each failed side search and finally the whole search are rolled back: nodes
# are append-only and only point at older nodes, so truncating to a saved count is exact.
const PROOF_KERNEL_REPLAY_SYMBOLIC_MARKER: sview = "__elisa_kernel_symbolic_binder"
const PROOF_KERNEL_REPLAY_SYMBOLIC_MAX_FACTS: usize = 256
const PROOF_KERNEL_REPLAY_SYMBOLIC_INSTANCE_CANDIDATES: usize = 8
const PROOF_KERNEL_REPLAY_SYMBOLIC_RENAME_PAIRS: usize = 8
const PROOF_KERNEL_REPLAY_SYMBOLIC_ALIAS_CANDIDATES: usize = 4
const PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT: usize = 262144

extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_symbolic_match_charge(work_used: mutable usize&, amount: usize) -> bool:
            if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT:
                return false
            if amount > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT - work_used:
                work_used <- PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT + 1
                return false
            work_used <- work_used + amount
            return true

        def proof_kernel_replay_symbolic_match_text_charge(work_used: mutable usize&, left: sview, right: sview) -> bool:
            return false if:
                not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                not proof_kernel_replay_symbolic_match_charge(work_used, sview_len(left))
            proof_kernel_replay_symbolic_match_charge(work_used, sview_len(right))

        # Reuse expression equality's byte/pair accounting while sharing one cumulative budget
        # across all matcher leaves and candidates in this symbolic instance.
        def proof_kernel_replay_symbolic_expr_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: usize, right: usize, work_used: mutable usize&) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            remaining: usize = PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT - work_used
            comparison_work: mutable usize = 0
            equal: bool = proof_kernel_replay_expr_equal_with_work(nodes, children, left, right, 0, remaining, &comparison_work)
            if not equal and comparison_work >= remaining:
                work_used <- PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT + 1
                return false
            return false if comparison_work > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT - work_used
            work_used <- work_used + comparison_work
            equal

        def proof_kernel_replay_symbolic_range(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            quantifier: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if:
                quantifier.kind != "quantifier" or quantifier.operator != "forall"
                not proof_kernel_replay_valid(nodes, quantifier.left) or not proof_kernel_replay_valid(nodes, quantifier.right)
            range: ElisaProofKernelCore::ProofKernelNode = nodes[quantifier.left]
            return false if range.kind != "binary" or range.operator != "range_lt"
            return proof_kernel_replay_valid(nodes, range.left) and proof_kernel_replay_valid(nodes, range.right)

        # Prove `operator(left, right)` (or `left` itself when operator is empty) and undo every
        # node the search added when it fails.
        def proof_kernel_replay_symbolic_side_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], operator: sview, left: usize, right: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            goal: mutable usize = left
            goal <- ElisaProofKernelCore::add_node(nodes, "binary", operator, left, right, 0, 0, 0, 0, "", "") if operator != ""
            # Disable further case splits as the producer does, sharing the report's search budget.
            proven: bool = (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, goal, PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            nodes.truncate(saved_nodes)
            children.truncate(saved_children)
            return proven

        def proof_kernel_replay_symbolic_quantifier_remaining_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                remaining <= 1
                not proof_kernel_replay_symbolic_range(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            goal_range: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            return true if (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", goal_range.right, goal_range.left, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return false if not proof_kernel_replay_quantifier_marker_available_with_work(nodes, PROOF_KERNEL_REPLAY_SYMBOLIC_MARKER, work_used)
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            marker: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, PROOF_KERNEL_REPLAY_SYMBOLIC_MARKER, "")
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            goal_marked: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, goal.right, goal.name, marker, 0, work_used, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT)
            if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT:
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
                return false
            found: mutable bool = (proof_kernel_replay_symbolic_vacuous(nodes, children, facts, goal.right, goal.name, marker, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            scanned: mutable usize = 0
            for fact_root in facts |fact_root, nodes, children, facts, root, goal_marked, marker, depth, remaining, scanned, found, work_used|:
                break if found or scanned >= PROOF_KERNEL_REPLAY_SYMBOLIC_MAX_FACTS or work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                return false if not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                scanned <- scanned + 1
                if fact_root != root:
                    fact_nodes: usize = nodes.count
                    fact_children: usize = children.count
                    found <- (proof_kernel_replay_symbolic_from_fact(nodes, children, facts, root, fact_root, goal_marked, marker, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                    if not found:
                        nodes.truncate(fact_nodes)
                        children.truncate(fact_children)
            # The arena is shared by every certificate: leaving the marker in it would make the
            # marker look taken to the next one.
            nodes.truncate(saved_nodes)
            children.truncate(saved_children)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            return found

        # The vacuous rule: a body `(not g) or q` whose guard g is a comparison free of the binder
        # (substituting the marker leaves it equal) holds once the flipped comparison is proved.
        def proof_kernel_replay_symbolic_vacuous(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], body: usize, binder: sview, marker: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            disjunction: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, body)
            return false if not disjunction.known or disjunction.node.kind != "binary" or disjunction.node.operator != "or"
            negation: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, disjunction.node.left)
            return false if not negation.known or negation.node.kind != "unary" or negation.node.operator != "not"
            guard_root: usize = negation.node.left
            guard: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, guard_root)
            return false if not guard.known or guard.node.kind != "binary"
            left: usize = guard.node.left
            right: usize = guard.node.right
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            substituted: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, guard_root, binder, marker, 0, work_used, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT)
            binder_free: bool = proof_kernel_replay_symbolic_expr_equal(nodes, children, substituted, guard_root, work_used)
            nodes.truncate(saved_nodes)
            children.truncate(saved_children)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT or not binder_free
            operator: sview = guard.node.operator
            return (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", right, left, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) if operator == "<"
            return (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<", right, left, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) if operator == "<="
            return (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", left, right, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) if operator == ">"
            return (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<", left, right, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) if operator == ">="
            return false

        # `upper` is literally `bound + 1`, read structurally.
        def proof_kernel_replay_symbolic_successor_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, upper: usize, bound: usize, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                not proof_kernel_replay_valid(nodes, upper)
            sum: ElisaProofKernelCore::ProofKernelNode = nodes[upper]
            return false if:
                sum.kind != "binary" or sum.operator != "+"
                not proof_kernel_replay_valid(nodes, sum.right) or nodes[sum.right].kind != "int" or nodes[sum.right].operator != "" or nodes[sum.right].value != 1
            proof_kernel_replay_symbolic_expr_equal(nodes, children, sum.left, bound, work_used)

        def proof_kernel_replay_symbolic_grown_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], upper: usize, bound: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            one: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
            next: usize = ElisaProofKernelCore::add_node(nodes, "binary", "+", bound, one, 0, 0, 0, 0, "", "")
            proven: bool = (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", upper, next, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            nodes.truncate(saved_nodes)
            children.truncate(saved_children)
            proven

        # Lower: the fact covers `a + 1..<b`, so the goal over `a..<b` needs only P(a).
        def proof_kernel_replay_symbolic_lowered(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, fact_lower: usize, fact_upper: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
                not proof_kernel_replay_symbolic_range(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            goal_range: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            return false if not (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", goal_range.right, fact_upper, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            one: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
            next: usize = ElisaProofKernelCore::add_node(nodes, "binary", "+", goal_range.left, one, 0, 0, 0, 0, "", "")
            if (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", fact_lower, next, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}):
                point: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, goal.right, goal.name, goal_range.left, 0, work_used, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT)
                if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false
                proven: bool = (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "", point, 0, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                nodes.truncate(saved_nodes)
                children.truncate(saved_children)
                return proven
            nodes.truncate(saved_nodes)
            children.truncate(saved_children)
            return false

        # Cover or extend the goal quantifier `root` by the fact quantifier `fact_root`. Kept out
        # of the fact loop so that loop declares nothing per iteration.
        def proof_kernel_replay_symbolic_from_fact(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], root: usize, fact_root: usize, goal_marked: usize, marker: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
                not proof_kernel_replay_symbolic_range(nodes, root) or not proof_kernel_replay_symbolic_range(nodes, fact_root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            goal_range: ElisaProofKernelCore::ProofKernelNode = nodes[goal.left]
            fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
            fact_range: ElisaProofKernelCore::ProofKernelNode = nodes[fact.left]
            fact_marked: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, fact.right, fact.name, marker, 0, work_used, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            same_marked_body: bool = proof_kernel_replay_symbolic_expr_equal(nodes, children, fact_marked, goal_marked, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            if not same_marked_body:
                return true if (proof_kernel_replay_symbolic_weakened(nodes, children, facts, fact_range.left, fact_range.right, goal_range.left, goal_range.right, fact_marked, goal_marked, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                # Weaken over `c..<d` and extend by P(d), with the goal ending by `d + 1`.
                grown_weakened: bool = proof_kernel_replay_symbolic_successor_with_work(nodes, children, goal_range.right, fact_range.right, work_used) or (proof_kernel_replay_symbolic_grown_with_work(nodes, children, facts, goal_range.right, fact_range.right, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                return false if:
                    not grown_weakened
                    not (proof_kernel_replay_symbolic_weakened(nodes, children, facts, fact_range.left, fact_range.right, goal_range.left, fact_range.right, fact_marked, goal_marked, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                point: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, goal.right, goal.name, fact_range.right, 0, work_used, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                return (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "", point, 0, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if not (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", fact_range.left, goal_range.left, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}):
                return (proof_kernel_replay_symbolic_lowered(nodes, children, facts, root, fact_range.left, fact_range.right, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return true if (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", goal_range.right, fact_range.right, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            grown: bool = proof_kernel_replay_symbolic_successor_with_work(nodes, children, goal_range.right, fact_range.right, work_used) or (proof_kernel_replay_symbolic_grown_with_work(nodes, children, facts, goal_range.right, fact_range.right, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return false if not grown
            instance: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, goal.right, goal.name, fact_range.right, 0, work_used, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            return (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "", instance, 0, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        # The marker is absent from the arena before the search adds it, so no fact names it and
        # the instance stands for an arbitrary index of the covered range. Admitted range
        # binders have the parser-authentic i64 sort, so give the marker that sort directly;
        # endpoint markers describe the bounds and cannot be transferred to the binder.
        def proof_kernel_replay_symbolic_weakened(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], fact_lower: usize, fact_upper: usize, goal_lower: usize, goal_upper: usize, fact_marked: usize, goal_marked: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            saved_nodes: usize = nodes.count
            saved_children: usize = children.count
            proven: bool = (proof_kernel_replay_symbolic_weakened_body(nodes, children, facts, fact_lower, fact_upper, goal_lower, goal_upper, fact_marked, goal_marked, work_used, depth, remaining) can Global{Read,Write})
            nodes.truncate(saved_nodes)
            children.truncate(saved_children)
            proven

        def proof_kernel_replay_symbolic_weakened_body(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], fact_lower: usize, fact_upper: usize, goal_lower: usize, goal_upper: usize, fact_marked: usize, goal_marked: usize, work_used: mutable usize&, depth: usize, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
                not (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", fact_lower, goal_lower, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                not (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", goal_upper, fact_upper, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET - 11
                children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET - 3
                facts.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET - 5
                not proof_kernel_replay_symbolic_match_charge(work_used, 1)
            instance_facts: mutable darray[usize] = []
            for fact in facts |fact, instance_facts, work_used|:
                return false if not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                instance_facts.push(fact)
            marker: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, PROOF_KERNEL_REPLAY_SYMBOLIC_MARKER, "")
            return false if not proof_kernel_replay_symbolic_push_i64_markers_with_work(nodes, children, instance_facts, marker, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            return false if not proof_kernel_replay_symbolic_match_charge(work_used, 5)
            instance_facts.push(ElisaProofKernelCore::add_node(nodes, "binary", "<=", goal_lower, marker, 0, 0, 0, 0, "", ""))
            instance_facts.push(ElisaProofKernelCore::add_node(nodes, "binary", "<", marker, goal_upper, 0, 0, 0, 0, "", ""))
            instance_facts.push(fact_marked)
            return (proof_kernel_replay_symbolic_side_with_work(nodes, children, instance_facts, "", goal_marked, 0, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})

        # The source admission and typed proposition checker fix range binders at i64. Record
        # only that binder type on the fresh arbitrary instance; copying a bound's type marker
        # here would be unsound when its endpoint has a narrower type.
        def proof_kernel_replay_symbolic_push_i64_markers_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: mutable darray[usize]&, marker: usize, work_used: mutable usize&) -> bool:
            integer_name: sview = "__elisa_primitive_integer_type"
            return false if not proof_kernel_replay_symbolic_match_charge(work_used, 4 + sview_len(integer_name))
            integer_callee: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, integer_name, "")
            integer_argument: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", marker, 0, 0, 0, 0, 0, "", "")
            return false if children.count >= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
            integer_start: usize = children.count
            children.push(integer_argument)
            integer_fact: usize = ElisaProofKernelCore::add_node(nodes, "call", "", integer_callee, 0, 0, integer_start, 1, 0, "", "")
            return false if integer_callee >= nodes.count or integer_argument >= nodes.count or integer_fact >= nodes.count
            return false if not proof_kernel_replay_symbolic_match_charge(work_used, 8 + sview_len("__elisa_signed_type_bound"))
            signed_callee: usize = ElisaProofKernelCore::add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_signed_type_bound", "")
            width: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, 64, "", "")
            marker_argument: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", marker, 0, 0, 0, 0, 0, "", "")
            width_argument: usize = ElisaProofKernelCore::add_node(nodes, "call_arg", "", width, 0, 0, 0, 0, 0, "", "")
            return false if children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET - 2
            signed_start: usize = children.count
            children.push(marker_argument)
            children.push(width_argument)
            signed_fact: usize = ElisaProofKernelCore::add_node(nodes, "call", "", signed_callee, 0, 0, signed_start, 2, 0, "", "")
            return false if:
                signed_callee >= nodes.count or width >= nodes.count or marker_argument >= nodes.count
                width_argument >= nodes.count or signed_fact >= nodes.count
                not proof_kernel_replay_symbolic_match_charge(work_used, 2)
            facts.push(integer_fact)
            facts.push(signed_fact)
            true

        # The instance rule: the goal is a forall fact's body at one of the goal's own
        # subscripts t, and the fact's range holds t. A scalar body can also select exactly one
        # candidate by matching its binder-shaped trigger against the goal; that candidate is
        # independently substituted and range-checked here.
        def proof_kernel_replay_symbolic_instance_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
                not proof_kernel_replay_valid(nodes, goal_root)
                nodes[goal_root].kind == "quantifier"
            candidates: mutable darray[usize] = []
            proof_kernel_replay_symbolic_subscripts(nodes, children, goal_root, &candidates, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            scanned: mutable usize = 0
            found: mutable bool = false
            for fact_root in facts |fact_root, nodes, children, facts, goal_root, candidates, depth, remaining, scanned, found, work_used|:
                break if found or scanned >= PROOF_KERNEL_REPLAY_SYMBOLIC_MAX_FACTS
                return false if not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                scanned <- scanned + 1
                continue if not proof_kernel_replay_symbolic_range(nodes, fact_root)
                quantifier: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                range: ElisaProofKernelCore::ProofKernelNode = nodes[quantifier.left]
                trigger: (matches: bool, found: bool, candidate: usize) = proof_kernel_replay_symbolic_trigger_match(nodes, children, quantifier.right, quantifier.name, goal_root, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                if trigger.matches and trigger.found:
                    saved_nodes: usize = nodes.count
                    saved_children: usize = children.count
                    instance: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, quantifier.right, quantifier.name, trigger.candidate, 0, work_used, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT)
                    matches: bool = proof_kernel_replay_symbolic_expr_equal(nodes, children, instance, goal_root, work_used)
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                    if matches and (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", range.left, trigger.candidate, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}):
                        found <- (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<", trigger.candidate, range.right, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                    break if found
                for candidate in candidates |candidate, nodes, children, facts, goal_root, quantifier, range, depth, remaining, found, work_used|:
                    break if found
                    return false if not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                    saved_nodes: usize = nodes.count
                    saved_children: usize = children.count
                    instance: usize = proof_kernel_replay_substitute_with_work_limit(nodes, children, quantifier.right, quantifier.name, candidate, 0, work_used, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT)
                    matches: bool = proof_kernel_replay_symbolic_expr_equal(nodes, children, instance, goal_root, work_used)
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                    continue if not matches
                    continue if not (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<=", range.left, candidate, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                    found <- (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "<", candidate, range.right, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            return found

        # The pattern matcher varies only occurrences of the quantified binder. Its candidate is
        # drawn from the target expression, and matching all repeated binder occurrences to one
        # term prevents accidental independent instantiation. Unknown target shapes fail closed.
        def proof_kernel_replay_symbolic_trigger_match(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, pattern_root: usize, binder: sview, target_root: usize, work_used: mutable usize&, depth: usize) -> (matches: bool, found: bool, candidate: usize):
            return (false, false, 0) if:
                not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                not proof_kernel_replay_valid(nodes, pattern_root) or not proof_kernel_replay_valid(nodes, target_root)
            pattern: ElisaProofKernelCore::ProofKernelNode = nodes[pattern_root]
            target: ElisaProofKernelCore::ProofKernelNode = nodes[target_root]
            if pattern.kind == "ident":
                return (false, false, 0) if not proof_kernel_replay_symbolic_match_text_charge(work_used, pattern.name, binder)
                if pattern.name == binder:
                    mentioned: bool = proof_kernel_replay_symbolic_mentions_name(nodes, children, target_root, binder, work_used, 0)
                    return (false, false, 0) if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT or mentioned
                    return (true, true, target_root)
                return (proof_kernel_replay_symbolic_expr_equal(nodes, children, pattern_root, target_root, work_used), false, 0)
            if pattern.kind == "paren":
                return (false, false, 0) if target.kind != "paren"
                return proof_kernel_replay_symbolic_trigger_match(nodes, children, pattern.left, binder, target.left, work_used, depth + 1)
            if pattern.kind == "unary":
                return (false, false, 0) if:
                    target.kind != "unary"
                    not proof_kernel_replay_symbolic_match_text_charge(work_used, pattern.operator, target.operator)
                    pattern.operator != target.operator
                return proof_kernel_replay_symbolic_trigger_match(nodes, children, pattern.left, binder, target.left, work_used, depth + 1)
            if pattern.kind == "binary":
                return (false, false, 0) if:
                    target.kind != "binary"
                    not proof_kernel_replay_symbolic_match_text_charge(work_used, pattern.operator, target.operator)
                    pattern.operator != target.operator
                left_match: (matches: bool, found: bool, candidate: usize) = proof_kernel_replay_symbolic_trigger_match(nodes, children, pattern.left, binder, target.left, work_used, depth + 1)
                return (false, false, 0) if:
                    work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                    not left_match.matches
                right_match: (matches: bool, found: bool, candidate: usize) = proof_kernel_replay_symbolic_trigger_match(nodes, children, pattern.right, binder, target.right, work_used, depth + 1)
                return (false, false, 0) if:
                    work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                    not right_match.matches
                    left_match.found and right_match.found and not proof_kernel_replay_symbolic_expr_equal(nodes, children, left_match.candidate, right_match.candidate, work_used)
                return left_match if left_match.found
                return right_match if right_match.found
                return (true, false, 0)
            return (proof_kernel_replay_symbolic_expr_equal(nodes, children, pattern_root, target_root, work_used), false, 0)

        def proof_kernel_replay_symbolic_mentions_name(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, name: sview, work_used: mutable usize&, depth: usize) -> bool:
            return true if:
                not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "ident":
                return true if not proof_kernel_replay_symbolic_match_text_charge(work_used, node.name, name)
                return node.name == name
            if node.kind in {"paren", "unary"}:
                return proof_kernel_replay_symbolic_mentions_name(nodes, children, node.left, name, work_used, depth + 1)
            if node.kind == "binary":
                left_mentions: bool = proof_kernel_replay_symbolic_mentions_name(nodes, children, node.left, name, work_used, depth + 1)
                return true if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT or left_mentions
                proof_kernel_replay_symbolic_mentions_name(nodes, children, node.right, name, work_used, depth + 1)
            # Only closed integer/Boolean leaves are known not to carry a binder reference.
            # Calls, collections, projections, and every future node kind fail closed.
            return false if node.kind in {"int", "bool"}
            return true

        def proof_kernel_replay_symbolic_subscripts(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, candidates: mutable darray[usize]&, work_used: mutable usize&, depth: usize) -> void:
            return if not proof_kernel_replay_symbolic_match_charge(work_used, 1)
            return if depth > 16 or candidates.count >= PROOF_KERNEL_REPLAY_SYMBOLIC_INSTANCE_CANDIDATES
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "index":
                return if not proof_kernel_replay_valid(nodes, node.right)
                already_present: mutable bool = false
                for existing in candidates |existing, nodes, children, node, work_used, already_present|:
                    already_present <- true if proof_kernel_replay_symbolic_expr_equal(nodes, children, existing, node.right, work_used)
                    return if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                    break if already_present
                candidates.push(node.right) if not already_present
                return
            if node.kind in {"paren", "unary"}:
                proof_kernel_replay_symbolic_subscripts(nodes, children, node.left, candidates, work_used, depth + 1)
                return
            if node.kind == "binary":
                proof_kernel_replay_symbolic_subscripts(nodes, children, node.left, candidates, work_used, depth + 1)
                return if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                proof_kernel_replay_symbolic_subscripts(nodes, children, node.right, candidates, work_used, depth + 1)

        # The subscript rule (linear/symbolic_quantifiers.elisa): a subscript of the goal that no
        # fact subscripts, provably equal to a subscript of some fact, is replaced by it.
        def proof_kernel_replay_symbolic_renamed_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 1
                not proof_kernel_replay_valid(nodes, goal_root)
                nodes[goal_root].kind == "quantifier"
            goal_subscripts: mutable darray[usize] = []
            proof_kernel_replay_symbolic_subscripts(nodes, children, goal_root, &goal_subscripts, work_used, 0)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                goal_subscripts.count == 0
            fact_subscripts: mutable darray[usize] = []
            scanned: mutable usize = 0
            for fact_root in facts |fact_root, nodes, children, fact_subscripts, scanned, work_used|:
                break if scanned >= PROOF_KERNEL_REPLAY_SYMBOLIC_MAX_FACTS or fact_subscripts.count >= PROOF_KERNEL_REPLAY_SYMBOLIC_INSTANCE_CANDIDATES
                return false if not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                scanned <- scanned + 1
                continue if not proof_kernel_replay_valid(nodes, fact_root) or nodes[fact_root].kind == "quantifier"
                proof_kernel_replay_symbolic_subscripts(nodes, children, fact_root, &fact_subscripts, work_used, 0)
                return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            tried: mutable usize = 0
            found: mutable bool = false
            for from_root in goal_subscripts |from_root, nodes, children, facts, goal_root, fact_subscripts, depth, remaining, tried, found, work_used|:
                break if found
                already_fact_subscript: mutable bool = false
                for existing in fact_subscripts |existing, nodes, children, from_root, work_used, already_fact_subscript|:
                    already_fact_subscript <- true if proof_kernel_replay_symbolic_expr_equal(nodes, children, existing, from_root, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
                    break if already_fact_subscript
                continue if already_fact_subscript
                for to_root in fact_subscripts |to_root, from_root, nodes, children, facts, goal_root, depth, remaining, tried, found, work_used|:
                    break if found or tried >= PROOF_KERNEL_REPLAY_SYMBOLIC_RENAME_PAIRS
                    return false if not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                    tried <- tried + 1
                    continue if not (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "==", from_root, to_root, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                    saved_nodes: usize = nodes.count
                    saved_children: usize = children.count
                    replace_exhausted: mutable bool = false
                    replaced: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_with_work(nodes, children, goal_root, from_root, to_root, work_used, &replace_exhausted, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT, 0)
                    if replace_exhausted or work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT:
                        nodes.truncate(saved_nodes)
                        children.truncate(saved_children)
                        return false
                    found <- replaced.changed and (proof_kernel_replay_symbolic_side_with_work(nodes, children, facts, "", replaced.value, 0, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                    if not found:
                        nodes.truncate(saved_nodes)
                        children.truncate(saved_children)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            return found

        # The alias instance rule (linear/symbolic_quantifiers.elisa): a fact `t == xs[e]` unfolds
        # `t` in the goal to the cell, and the instance rule takes the unfolded goal.
        def proof_kernel_replay_symbolic_alias_instance_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global{Read,Write}]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if:
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or remaining <= 2
                not proof_kernel_replay_valid(nodes, goal_root)
                nodes[goal_root].kind == "quantifier"
            tried: mutable usize = 0
            scanned: mutable usize = 0
            found: mutable bool = false
            for fact_root in facts |fact_root, nodes, children, facts, goal_root, depth, remaining, tried, scanned, found, work_used|:
                break if found or scanned >= PROOF_KERNEL_REPLAY_SYMBOLIC_MAX_FACTS or tried >= PROOF_KERNEL_REPLAY_SYMBOLIC_ALIAS_CANDIDATES
                return false if not proof_kernel_replay_symbolic_match_charge(work_used, 1)
                scanned <- scanned + 1
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "==" or fact.left >= nodes.count or fact.right >= nodes.count
                name_root: mutable usize = fact.left
                cell_root: mutable usize = fact.right
                if nodes[fact.left].kind == "index" and nodes[fact.right].kind == "ident":
                    name_root <- fact.right
                    cell_root <- fact.left
                continue if nodes[name_root].kind != "ident" or nodes[cell_root].kind != "index"
                saved_nodes: usize = nodes.count
                saved_children: usize = children.count
                replace_exhausted: mutable bool = false
                unfolded: (changed: bool, value: usize) = proof_kernel_replay_replace_exact_with_work(nodes, children, goal_root, name_root, cell_root, work_used, &replace_exhausted, PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT, 0)
                if replace_exhausted or work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
                    return false
                if unfolded.changed:
                    tried <- tried + 1
                    found <- (proof_kernel_replay_symbolic_instance_with_work(nodes, children, facts, unfolded.value, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                if not found:
                    nodes.truncate(saved_nodes)
                    children.truncate(saved_children)
            return false if work_used > PROOF_KERNEL_REPLAY_SYMBOLIC_MATCH_WORK_LIMIT
            return found
