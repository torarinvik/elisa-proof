extend ElisaProofKernelReplay:
    private:

        const PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT: usize = 4

        def proof_kernel_replay_comparison_from_equality_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left_root: usize, operator: sview, right_root: usize) -> bool:
            return false if not proof_kernel_replay_negation_supported(operator)
            left_constant: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
            right_constant: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
            return proof_kernel_replay_constant_comparison(nodes, left_root, operator, right_root) if left_constant.known and right_constant.known
            return false if left_constant.known == right_constant.known
            term_root: usize = right_root if left_constant.known else left_root
            goal_constant: i64 = left_constant.value if left_constant.known else right_constant.value
            term_is_left: bool = not left_constant.known
            for fact_root in facts |fact_root, nodes, children, facts, term_root, operator, goal_constant, term_is_left|:
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "=="
                right_literal: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, fact.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
                if right_literal.known and proof_kernel_replay_expr_equal(nodes, children, fact.left, term_root, 0):
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, left_root, right_root) or not proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right)
                    return proof_kernel_replay_constant_comparison(nodes, fact.right, operator, right_root) if term_is_left
                    return proof_kernel_replay_constant_comparison(nodes, left_root, operator, fact.right)
                left_literal: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, fact.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
                if left_literal.known and proof_kernel_replay_expr_equal(nodes, children, fact.right, term_root, 0):
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, left_root, right_root) or not proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right)
                    return proof_kernel_replay_constant_comparison(nodes, fact.left, operator, right_root) if term_is_left
                    return proof_kernel_replay_constant_comparison(nodes, left_root, operator, fact.left)
            return false

        def proof_kernel_replay_goal_depth(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_root, split_depth, depth, remaining) can Global{Read,Write})

        def proof_kernel_replay_goal_depth_remaining(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal_node: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            comparison_goal: bool = goal_node.kind == "binary" and proof_kernel_replay_comparison_complement(goal_node.operator) != ""
            for fact in facts |fact, nodes, children, goal_root|:
                return true if proof_kernel_replay_fact_contains(nodes, children, fact, goal_root, depth + 1)
                continue if not comparison_goal
                candidate: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape(nodes, children, facts, fact)
                return true if candidate.known and proof_kernel_replay_disjunct_atoms_equivalent(nodes, children, facts, fact, goal_root)
            goal_identity: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            # Exact witnessed order facts require no search or arithmetic normalization. Check
            # them before symbolic instantiation can consume replay work or append scratch terms.
            return true if proof_kernel_replay_order_goal_from_facts(nodes, children, facts, goal_root)
            return true if remaining > 1 and (proof_kernel_replay_conditional_result_disjunction(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 1 and (proof_kernel_replay_symbolic_instance(nodes, children, facts, goal_root, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 1 and (proof_kernel_replay_symbolic_renamed(nodes, children, facts, goal_root, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 2 and (proof_kernel_replay_symbolic_alias_instance(nodes, children, facts, goal_root, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            # Mirror of the producer's relational bounds for a variable divisor.
            return true if remaining > 1 and (proof_kernel_replay_division_goal(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 1 and (proof_kernel_replay_negated_name_goal(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                reduced: mutable darray[usize] = []
                removed: mutable bool = false
                for fact in facts |reduced, removed, nodes|:
                    if proof_kernel_replay_valid(nodes, fact) and nodes[fact].kind == "quantifier":
                        removed <- true
                    else:
                        reduced.push(fact)
                if removed:
                    return true if (proof_kernel_replay_goal_depth_remaining(nodes, children, reduced, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                return true if (proof_kernel_replay_finite_universal_premise(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return true if proof_kernel_replay_unsigned_nonzero_lower_bound(nodes, children, facts, goal_root)
            if remaining > 1:
                return true if (proof_kernel_replay_negated_boolean_goal(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return true if goal_identity.kind == "binary" and goal_identity.operator == "or" and proof_kernel_replay_conditional_fallback_or_guard(nodes, children, facts, goal_root)
            return true if goal_identity.kind == "binary" and goal_identity.operator == "or" and proof_kernel_replay_conditional_choice_or_goal(nodes, children, facts, goal_root)
            return true if goal_identity.kind == "binary" and goal_identity.operator == "or" and proof_kernel_replay_disjunction_direct_branch(nodes, children, goal_root, facts, 0)
            # Independently check a call that survives all other alternatives
            # of a premise; numeric refutations retain exact integer witnesses.
            if goal_identity.kind == "call":
                call_disjunction_candidates: mutable usize = 0
                for fact in facts |call_disjunction_candidates, nodes, children, facts, goal_root|:
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, fact, 0)
                    continue if not candidate.known
                    relevance: usize = (proof_kernel_replay_disjunction_candidate_relevance(nodes, children, facts, goal_root, fact, 0) can Global{Read,Write})
                    return true if relevance == 1
                    continue if relevance == 0
                    return true if (proof_kernel_replay_disjunction_entails_goal(nodes, children, facts, fact, goal_root, 0) can Global{Read,Write})
                    call_disjunction_candidates <- call_disjunction_candidates + 1
                    break if call_disjunction_candidates >= PROOF_KERNEL_REPLAY_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES
            if goal_identity.kind == "binary" and goal_identity.operator == "or":
                return true if proof_kernel_replay_closed_width_uniform_true(nodes, goal_root)
                literal_left: mutable (known: bool, value: bool) = proof_kernel_replay_constant_bool(nodes, goal_identity.left, 0)
                if goal_identity.left < nodes.count:
                    left: ElisaProofKernelCore::ProofKernelNode = nodes[goal_identity.left]
                    if left.kind == "binary" and left.operator == "!=" and left.left < nodes.count and left.right < nodes.count:
                        a: ElisaProofKernelCore::ProofKernelNode = nodes[left.left]
                        b: ElisaProofKernelCore::ProofKernelNode = nodes[left.right]
                        literal_left <- (true, false) if a.kind == "int" and b.kind == "int" and a.value == b.value
                if literal_left.known and not literal_left.value:
                    return false if remaining <= 1
                    return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_identity.right, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                goal_disjunction_candidates: mutable usize = 0
                for fact in facts |goal_disjunction_candidates, nodes, children, facts, goal_root|:
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, fact, 0)
                    continue if not candidate.known
                    relevance: usize = (proof_kernel_replay_disjunction_candidate_relevance(nodes, children, facts, goal_root, fact, 0) can Global{Read,Write})
                    return true if relevance == 1
                    continue if relevance == 0
                    return true if (proof_kernel_replay_disjunction_entails_goal(nodes, children, facts, fact, goal_root, 0) can Global{Read,Write})
                    goal_disjunction_candidates <- goal_disjunction_candidates + 1
                    break if goal_disjunction_candidates >= PROOF_KERNEL_REPLAY_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES
            # Disjunctive syllogism shrinks a premise rather than making two
            # branches. Spend ordinary recursion fuel, not case-split depth.
            if remaining > 1:
                for index in 0..<facts.count |index, facts, nodes, children, goal_root, split_depth, depth, remaining|:
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, facts[index], depth)
                    continue if not candidate.known
                    left_refuted: bool = (proof_kernel_replay_disjunct_refuted(nodes, children, candidate.left, facts, 0) can Global{Read,Write})
                    right_refuted: bool = (proof_kernel_replay_disjunct_refuted(nodes, children, candidate.right, facts, 0) can Global{Read,Write})
                    continue if not left_refuted and not right_refuted
                    reduced: mutable darray[usize] = []
                    reduced.extend(facts)
                    reduced[index] <- candidate.right if left_refuted else candidate.left
                    return (proof_kernel_replay_goal_depth_remaining(nodes, children, reduced, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if goal_identity.kind == "binary" and goal_identity.operator == "==":
                return true if proof_kernel_replay_logical_join_identity(nodes, children, facts, goal_root)
                if remaining > 1:
                    return true if (proof_kernel_replay_index_read_equality(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                return true if proof_kernel_replay_ident_name(nodes, goal_identity.left) == "null" and proof_kernel_replay_ident_name(nodes, goal_identity.right) == "null"
            # Parentheses do not alter proposition semantics and may enclose an OR whose left
            # branch is already closed, so unwrap them before unsigned-range guards run.
            if goal_identity.kind == "paren":
                return false if remaining <= 1
                return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_identity.left, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            # A negated order `not (a < b)` follows from its converse `b <= a`, and likewise for the
            # other three orders. Only this direction is taken, which stays sound even over an
            # unordered float: a proved converse means both operands compare.
            if goal_identity.kind == "unary" and goal_identity.operator == "not" and goal_identity.left < nodes.count and remaining > 1:
                negated: ElisaProofKernelCore::ProofKernelNode = nodes[goal_identity.left]
                converse: sview = proof_kernel_replay_order_converse(negated.operator)
                if negated.kind == "binary" and converse != "":
                    flipped: usize = ElisaProofKernelCore::add_node(nodes, "binary", converse, negated.right, negated.left, 0, 0, 0, 0, "", "")
                    return true if (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, flipped, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            # A true Boolean literal is independent of fixed-width premises. It is admitted here
            # only after the source-bound producer chose this disjunction alternative.
            return true if goal_identity.kind == "bool" and goal_identity.value != 0
            # A predicate equation may rewrite a negated call to a negated
            # primitive comparison. Recompute its exact Boolean complement;
            # the recursive goal still applies ordinary machine-range guards.
            if remaining > 1 and goal_identity.kind == "unary" and goal_identity.operator == "not" and goal_identity.left < nodes.count:
                comparison: ElisaProofKernelCore::ProofKernelNode = nodes[goal_identity.left]
                if comparison.kind == "binary" and proof_kernel_replay_negation_supported(comparison.operator) and proof_kernel_replay_primitive_comparison(nodes, children, facts, comparison.left, comparison.right):
                    complemented: usize = ElisaProofKernelCore::add_node(nodes, "binary", proof_kernel_replay_negation(comparison.operator), comparison.left, comparison.right, 0, 0, 0, 0, "", "")
                    return true if (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, complemented, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            # Independently eliminate a primitive Boolean call's exact equality.
            # The other side still needs a proof under the same premises/fuel.
            predicate_root: mutable usize = goal_root
            predicate_negated: bool = goal_identity.kind == "unary" and goal_identity.operator == "not"
            predicate_root <- goal_identity.left if predicate_negated
            if remaining > 1 and predicate_root < nodes.count and nodes[predicate_root].kind == "call" and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, predicate_root, 0):
                for fact_root in facts |fact_root, nodes, children, facts, predicate_root, predicate_negated, goal_root, split_depth, depth, remaining|:
                    continue if fact_root >= nodes.count
                    equation: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                    continue if equation.kind != "binary" or equation.operator != "=="
                    replacement: mutable usize = nodes.count
                    replacement <- equation.right if proof_kernel_replay_expr_equal(nodes, children, equation.left, predicate_root, 0)
                    replacement <- equation.left if proof_kernel_replay_expr_equal(nodes, children, equation.right, predicate_root, 0)
                    continue if replacement >= nodes.count or proof_kernel_replay_expr_equal(nodes, children, replacement, predicate_root, 0)
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, equation.left, equation.right)
                    rewritten: mutable usize = replacement
                    rewritten <- ElisaProofKernelCore::add_node(nodes, "unary", "not", replacement, 0, 0, 0, 0, 0, "", "") if predicate_negated
                    return true if (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, rewritten, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            # Independently introduce a disjunction from either proved alternative.
            # Numeric safety is checked recursively only for the alternative consumed.
            if goal_identity.kind == "binary" and goal_identity.operator == "or":
                return true if proof_kernel_replay_signed_distinct_disequality_disjunction(nodes, children, facts, goal_root)
                return true if proof_kernel_replay_unsigned_distinct_disequality_disjunction(nodes, children, facts, goal_root)
                return true if proof_kernel_replay_facts_propositionally_inconsistent(nodes, children, facts, depth + 1)
                # Mirror the producer: split a disjunctive premise before choosing
                # one disjunct of the goal, so correlations in De Morgan cases survive.
                candidate: (known: bool, index: usize, left: usize, right: usize) = (proof_kernel_replay_find_goal_disjunction(nodes, children, facts, goal_root, depth) can Global{Read,Write})
                if candidate.known and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                    return false if remaining <= 1
                    left_facts: mutable darray[usize] = []
                    right_facts: mutable darray[usize] = []
                    for fact_index in 0..<facts.count |fact_index, facts, candidate, left_facts, right_facts|:
                        if fact_index == candidate.index:
                            left_facts.push(candidate.left)
                            right_facts.push(candidate.right)
                        else:
                            left_facts.push(facts[fact_index])
                            right_facts.push(facts[fact_index])
                    return true if (proof_kernel_replay_goal_depth_remaining(nodes, children, left_facts, goal_root, split_depth + 1, depth + 1, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_goal_depth_remaining(nodes, children, right_facts, goal_root, split_depth + 1, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                return false if remaining <= 1
                return true if (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_identity.left, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write}) or (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_identity.right, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT
                denied_facts: mutable darray[usize] = []
                denied_facts.extend(facts)
                return false if not proof_kernel_replay_push_disjunction_denial(nodes, children, goal_identity.left, &denied_facts, facts, facts.count + PROOF_KERNEL_DISJUNCTION_DENIAL_FACT_LIMIT, 0)
                return (proof_kernel_replay_goal_depth_remaining(nodes, children, denied_facts, goal_identity.right, split_depth + 1, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if goal_identity.kind == "binary":
                return true if proof_kernel_replay_strict_order_fact_implies_disequality(nodes, children, facts, goal_root)
                if remaining > 1:
                    return true if (proof_kernel_replay_strict_order_consequence(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
                return true if proof_kernel_replay_signed_disequality_from_equality_fact(nodes, children, facts, goal_root)
                return true if proof_kernel_replay_unsigned_disequality_from_equality_fact(nodes, children, facts, goal_root)
                return true if proof_kernel_replay_direct_literal_comparison(nodes, goal_identity.left, goal_identity.operator, goal_identity.right)
                return true if proof_kernel_replay_constant_comparison(nodes, goal_identity.left, goal_identity.operator, goal_identity.right)
                return true if proof_kernel_replay_comparison_from_equality_literal(nodes, children, facts, goal_identity.left, goal_identity.operator, goal_identity.right)
            # Quantifier goals are already finite, self-contained proof obligations. Dispatch
            # them before arithmetic/model tiers inspect the erased block representation; those
            # tiers deliberately do not know how to interpret a quantifier range.
            if goal_identity.kind == "quantifier":
                return false if remaining <= 1
                return (proof_kernel_replay_quantifier_remaining(nodes, children, goal_identity.operator, facts, goal_root, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if goal_identity.kind == "binary" and proof_kernel_replay_primitive_comparison(nodes, children, facts, goal_identity.left, goal_identity.right):
                # Having a comparison negation does not make an operator reflexive:
                # strict orders and disequality are false on identical operands.
                reflexive: bool = goal_identity.operator == "==" or goal_identity.operator == "<=" or goal_identity.operator == ">="
                if reflexive:
                    return true if proof_kernel_replay_definitionally_equal(nodes, children, goal_identity.left, goal_identity.right, depth + 1)
            if goal_identity.kind == "binary" and (goal_identity.operator == "<" or goal_identity.operator == "<="):
                remainder_width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, goal_identity.left, facts, depth + 1)
                if remainder_width > 0:
                    return true if proof_kernel_replay_unsigned_remainder_upper(nodes, children, facts, goal_identity.left, goal_identity.operator, goal_identity.right)
            return true if proof_kernel_replay_unsigned_unit_increment_order_shape(nodes, children, facts, goal_root)
            widened: usize = proof_kernel_replay_unsigned_widening_comparison(nodes, children, facts, goal_root)
            if widened != goal_root:
                return false if remaining <= 1
                return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, widened, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                boolean = proof_kernel_replay_comparison_boolean_equation_plan(nodes, children, facts, goal_root)
                if boolean.known:
                    return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, boolean.goal, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                pinned = proof_kernel_replay_pinned_premise_plan(nodes, children, facts)
                return true if pinned.known and pinned.contradiction
                if pinned.known:
                    return (proof_kernel_replay_goal_depth_remaining(nodes, children, pinned.facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                subtraction = proof_kernel_replay_subtraction_alias_plan(nodes, children, facts, goal_root)
                if subtraction.known:
                    return (proof_kernel_replay_goal_depth_remaining(nodes, children, facts, subtraction.goal, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            return true if proof_kernel_replay_unsigned_pinned_comparison(nodes, children, facts, goal_root)
            if remaining > 1 and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                alias = proof_kernel_replay_conditional_alias_plan(nodes, children, facts, goal_root)
                if alias.known:
                    then_facts: mutable darray[usize] = []
                    else_facts: mutable darray[usize] = []
                    then_facts.extend(facts)
                    else_facts.extend(facts)
                    then_facts[alias.index] <- alias.then_fact
                    else_facts[alias.index] <- alias.else_fact
                    then_facts.push(alias.condition)
                    negated: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", alias.condition, 0, 0, 0, 0, 0, "", "")
                    else_facts.push(negated)
                    return true if (alias.then_refuted or (proof_kernel_replay_goal_depth_remaining(nodes, children, then_facts, goal_root, split_depth + 1, depth + 1, remaining: remaining - 1) can Global{Read,Write})) and (alias.else_refuted or (proof_kernel_replay_goal_depth_remaining(nodes, children, else_facts, goal_root, split_depth + 1, depth + 1, remaining: remaining - 1) can Global{Read,Write}))
            if remaining > 1 and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                conditional = proof_kernel_replay_conditional_comparison_plan(nodes, children, facts, goal_root)
                if conditional.known:
                    then_facts: mutable darray[usize] = []
                    else_facts: mutable darray[usize] = []
                    then_facts.extend(facts)
                    else_facts.extend(facts)
                    then_facts.push(conditional.condition)
                    negated: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", conditional.condition, 0, 0, 0, 0, 0, "", "")
                    else_facts.push(negated)
                    return true if (conditional.then_refuted or (proof_kernel_replay_goal_depth_remaining(nodes, children, then_facts, conditional.then_goal, split_depth + 1, depth + 1, remaining: remaining - 1) can Global{Read,Write})) and (conditional.else_refuted or (proof_kernel_replay_goal_depth_remaining(nodes, children, else_facts, conditional.else_goal, split_depth + 1, depth + 1, remaining: remaining - 1) can Global{Read,Write}))
            return true if proof_kernel_replay_scaled_quotient_sum_goal(nodes, children, facts, goal_root)
            return true if proof_kernel_replay_unsigned_scaled_product_upper_shape(nodes, children, facts, goal_root)
            if remaining > 1:
                return true if (proof_kernel_replay_monotone_order_goal(nodes, children, facts, goal_root, split_depth, depth, remaining: remaining - 1) can Global{Read,Write})
            # Mirror: propositional inconsistency reads no term as a number, so it runs before
            # the fixed-width guard and lets a refuted branch close without range-safe facts.
            return true if proof_kernel_replay_facts_propositionally_inconsistent(nodes, children, facts, depth + 1)
            # Mirror: complementary order premises close a branch before it opens further splits.
            return true if split_depth > 0 and proof_kernel_replay_facts_order_complementary(nodes, children, facts)
            pruned_facts: mutable darray[usize] = []
            if remaining > 1 and proof_kernel_replay_disjunct_prune_facts(nodes, children, facts, &pruned_facts):
                return (proof_kernel_replay_goal_depth_remaining(nodes, children, pruned_facts, goal_root, split_depth, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            # Mirror: alternatives the linear tier refutes are removed before a split opens them.
            linear_pruned: mutable darray[usize] = []
            linear_prune: i64 = proof_kernel_replay_linear_prune_facts(nodes, children, facts, &linear_pruned)
            return true if linear_prune == 2
            if linear_prune == 1:
                return false if remaining <= 1
