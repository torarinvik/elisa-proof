                return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT
                negated_left: mutable usize = node.left
                left_is_negation: bool = node.left < nodes.count and nodes[node.left].kind == "unary" and nodes[node.left].operator == "not" and nodes[node.left].left < nodes.count
                if left_is_negation:
                    negated_left <- nodes[node.left].left
                else:
                    negated_left <- proof_kernel_replay_add_node_reused_with_goal_work(nodes, "unary", "not", node.left, 0, 0, work_used)
                    return false if negated_left >= nodes.count
                negated_facts: mutable darray[usize] = []
                return false if not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &negated_facts, work_used)
                return false if not proof_kernel_replay_goal_search_push_index_with_work(negated_left, &negated_facts, work_used)
                return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, negated_facts, node.right, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if node.kind == "binary" and node.operator == "=>":
                return false if remaining <= 1
                implication_facts: mutable darray[usize] = []
                return false if not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &implication_facts, work_used)
                return false if not proof_kernel_replay_goal_search_push_index_with_work(node.left, &implication_facts, work_used)
                return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, implication_facts, node.right, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if node.kind == "binary" and (node.operator == ">" or node.operator == ">=" or node.operator == "<" or node.operator == "<=" or node.operator == "==" or node.operator == "!=") and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                if node.left < nodes.count and nodes[node.left].kind == "if":
                    return false if remaining <= 1
                    conditional: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                    then_facts: mutable darray[usize] = []
                    else_facts: mutable darray[usize] = []
                    return false if not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &then_facts, work_used) or not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &else_facts, work_used)
                    return false if not proof_kernel_replay_goal_search_push_index_with_work(conditional.left, &then_facts, work_used)
                    negated_condition: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "unary", "not", conditional.left, 0, 0, work_used)
                    return false if negated_condition >= nodes.count
                    return false if not proof_kernel_replay_goal_search_push_index_with_work(negated_condition, &else_facts, work_used)
                    then_goal: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "binary", node.operator, conditional.right, node.right, 0, work_used)
                    return false if then_goal >= nodes.count
                    else_goal: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "binary", node.operator, conditional.auxiliary, node.right, 0, work_used)
                    return false if else_goal >= nodes.count
                    # A failed split leaves the goal to later tiers, including congruence.
                    return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, then_facts, then_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, else_facts, else_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                if node.right < nodes.count and nodes[node.right].kind == "if":
                    return false if remaining <= 1
                    conditional: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                    then_facts: mutable darray[usize] = []
                    else_facts: mutable darray[usize] = []
                    return false if not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &then_facts, work_used) or not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &else_facts, work_used)
                    return false if not proof_kernel_replay_goal_search_push_index_with_work(conditional.left, &then_facts, work_used)
                    negated_condition: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "unary", "not", conditional.left, 0, 0, work_used)
                    return false if negated_condition >= nodes.count
                    return false if not proof_kernel_replay_goal_search_push_index_with_work(negated_condition, &else_facts, work_used)
                    then_goal: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "binary", node.operator, node.left, conditional.right, 0, work_used)
                    return false if then_goal >= nodes.count
                    else_goal: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "binary", node.operator, node.left, conditional.auxiliary, 0, work_used)
                    return false if else_goal >= nodes.count
                    return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, then_facts, then_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, else_facts, else_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 1 and (proof_kernel_replay_nested_conditional_goal(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if node.kind == "binary":
                readable: darray[usize] = facts
                if proof_kernel_replay_negation_supported(node.operator) and proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_goal_search_expr_equal(nodes, children, node.left, node.right, work_used):
                    return node.operator == "==" or node.operator == "<=" or node.operator == ">="
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_negation_supported(node.operator) and proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, node.left, node.operator, node.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_interval_goal_with_work(nodes, children, node.left, node.operator, node.right, readable, signed_bounds, work_used)
                return true if proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_affine_comparison_with_work(nodes, children, node.left, node.operator, node.right, readable, signed_bounds, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_difference_comparison_with_work(nodes, children, node.left, node.operator, node.right, readable, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                # Mirror: cancellation reads each side as a sum over the integers, which the wrap
                # guards above have licensed for every operation it admits.
                return true if proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_normalized_difference_comparison_with_work(nodes, children, node.left, node.operator, node.right, readable, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                # Mirror: the general linear tier, accepted through its Farkas certificate.
                return true if proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) and proof_kernel_replay_linear_arithmetic_goal_with_work(nodes, children, node.left, node.operator, node.right, readable, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_product_sign_with_work(nodes, children, readable, node.left, node.operator, node.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_comparison_chain_with_work(nodes, children, readable, node.left, node.operator, node.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_strict_shift_with_work(nodes, children, readable, node.left, node.operator, node.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_sum_bound_with_goal_work(nodes, children, readable, node.left, node.operator, node.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if remaining > 1 and (proof_kernel_replay_place_alias_goal(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return true if remaining > 1 and (proof_kernel_replay_field_place_goal(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                # Mirror: antisymmetry, `a == b` from `a <= b` and `a >= b` over primitive scalars.
                if node.operator == "==" and remaining > 1 and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT and proof_kernel_replay_primitive_comparison_with_work(nodes, children, readable, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT):
                    lower_goal: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "binary", "<=", node.left, node.right, 0, work_used)
                    return false if lower_goal >= nodes.count
                    upper_goal: usize = proof_kernel_replay_add_node_reused_with_goal_work(nodes, "binary", ">=", node.left, node.right, 0, work_used)
                    return false if upper_goal >= nodes.count
                    return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, lower_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, upper_goal, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                # Match producer order: arithmetic/place rules close bounds before transport,
                # which otherwise repeats failed antisymmetry searches.
                return true if remaining > 1 and (proof_kernel_replay_comparison_transport(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                # Ground congruence closure follows fixed-width safety guards, preserving operand widths.
                congruence_exhausted: mutable bool = false
                return true if proof_kernel_replay_congruence_goal_with_goal_work(nodes, children, facts, goal_root, work_used, &congruence_exhausted)
            return false
include "./resource_model_integrated_helpers.elisa"
