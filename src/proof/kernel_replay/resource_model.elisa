include "./signed_product_growth.elisa"
extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT: usize = 4
        def proof_kernel_replay_goal_depth_remaining_with_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, work_used: mutable usize&, remaining: usize) -> bool can[Global.Read, Global.Write]:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not proof_kernel_replay_valid(nodes, goal_root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, goal_root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal_node: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            comparison_goal: bool = goal_node.kind == "binary" and proof_kernel_replay_comparison_complement(goal_node.operator) != ""
            for fact in facts |fact, nodes, children, goal_root, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used) or (fact < nodes.count and not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used))
                continue if fact >= nodes.count
                return true if proof_kernel_replay_fact_contains_with_work(nodes, children, fact, goal_root, work_used, depth + 1) and work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                # Replay implications when alternatives match or are refuted, including enum results.
                return true if (proof_kernel_replay_disjunction_entails_goal_with_work(nodes, children, facts, fact, goal_root, work_used, depth + 1) can Global{Read,Write})
                continue if not comparison_goal
                candidate: (known: bool, left: usize, operator: sview, right: usize) = proof_kernel_replay_comparison_disjunct_shape_with_work(nodes, children, facts, fact, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not candidate.known
                equivalent: bool = proof_kernel_replay_disjunct_atoms_equivalent_with_work(nodes, children, facts, fact, goal_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if equivalent
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            goal_identity: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            # Check exact witnessed order facts before symbolic instantiation consumes work or adds terms.
            return true if proof_kernel_replay_order_goal_from_facts_with_work(nodes, children, facts, goal_root, work_used)
            return true if remaining > 1 and (proof_kernel_replay_conditional_result_disjunction(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 1 and (proof_kernel_replay_symbolic_instance_with_work(nodes, children, facts, goal_root, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 1 and (proof_kernel_replay_symbolic_renamed_with_work(nodes, children, facts, goal_root, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 2 and (proof_kernel_replay_symbolic_alias_instance_with_work(nodes, children, facts, goal_root, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            # Mirror of the producer's relational bounds for a variable divisor.
            return true if remaining > 1 and (proof_kernel_replay_division_goal(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return true if remaining > 1 and (proof_kernel_replay_negated_name_goal(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                reduced: mutable darray[usize] = []
                removed: mutable bool = false
                for fact in facts |reduced, removed, nodes, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    if proof_kernel_replay_valid(nodes, fact) and nodes[fact].kind == "quantifier":
                        removed <- true
                    else:
                        return false if not proof_kernel_replay_goal_search_push_index_with_work(fact, &reduced, work_used)
                if removed:
                    return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, reduced, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                return true if (proof_kernel_replay_finite_universal_premise(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return true if proof_kernel_replay_unsigned_nonzero_lower_bound_with_work(nodes, children, facts, goal_root, work_used)
            if remaining > 1:
                return true if (proof_kernel_replay_negated_boolean_goal(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return true if goal_identity.kind == "binary" and goal_identity.operator == "or" and proof_kernel_replay_conditional_fallback_or_guard(nodes, children, facts, goal_root, work_used)
            return true if goal_identity.kind == "binary" and goal_identity.operator == "or" and proof_kernel_replay_conditional_choice_or_goal(nodes, children, facts, goal_root, work_used)
            return true if goal_identity.kind == "binary" and goal_identity.operator == "or" and proof_kernel_replay_disjunction_direct_branch_with_work(nodes, children, goal_root, facts, work_used, 0)
            # Check premise survivors for calls; numeric refutations keep integer witnesses.
            if goal_identity.kind == "call":
                call_disjunction_candidates: mutable usize = 0
                for fact in facts |call_disjunction_candidates, nodes, children, facts, goal_root, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction_with_work(nodes, fact, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not candidate.known
                    relevance: usize = (proof_kernel_replay_disjunction_candidate_relevance_with_work(nodes, children, facts, goal_root, fact, work_used, 0) can Global{Read,Write})
                    return true if relevance == 1
                    continue if relevance == 0
                    return true if (proof_kernel_replay_disjunction_entails_goal_with_work(nodes, children, facts, fact, goal_root, work_used, 0) can Global{Read,Write})
                    call_disjunction_candidates <- call_disjunction_candidates + 1
                    break if call_disjunction_candidates >= PROOF_KERNEL_REPLAY_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES
            if goal_identity.kind == "binary" and goal_identity.operator == "or":
                return true if proof_kernel_replay_closed_width_uniform_true_with_goal_work(nodes, goal_root, work_used)
                literal_left: mutable (known: bool, value: bool) = proof_kernel_replay_constant_bool_with_goal_work(nodes, goal_identity.left, work_used)
                literal_left <- (true, false) if proof_kernel_replay_false_integer_disequality_with_goal_work(nodes, goal_identity.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if literal_left.known and not literal_left.value:
                    return false if remaining <= 1
                    return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, goal_identity.right, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                goal_disjunction_candidates: mutable usize = 0
                for fact in facts |goal_disjunction_candidates, nodes, children, facts, goal_root, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction_with_work(nodes, fact, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not candidate.known
                    relevance: usize = (proof_kernel_replay_disjunction_candidate_relevance_with_work(nodes, children, facts, goal_root, fact, work_used, 0) can Global{Read,Write})
                    return true if relevance == 1
                    continue if relevance == 0
                    return true if (proof_kernel_replay_disjunction_entails_goal_with_work(nodes, children, facts, fact, goal_root, work_used, 0) can Global{Read,Write})
                    goal_disjunction_candidates <- goal_disjunction_candidates + 1
                    break if goal_disjunction_candidates >= PROOF_KERNEL_REPLAY_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            # Disjunctive syllogism shrinks one premise under ordinary recursion fuel.
            if remaining > 1:
                for index in 0..<facts.count |index, facts, nodes, children, goal_root, split_depth, depth, remaining, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction_with_work(nodes, facts[index], work_used, depth)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if not candidate.known
                    left_refuted: bool = (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, candidate.left, facts, work_used, 0) can Global{Read,Write})
                    right_refuted: bool = (proof_kernel_replay_disjunct_refuted_with_work(nodes, children, candidate.right, facts, work_used, 0) can Global{Read,Write})
                    continue if not left_refuted and not right_refuted
                    reduced: mutable darray[usize] = []
                    return false if not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &reduced, work_used)
                    reduced[index] <- candidate.right if left_refuted else candidate.left
                    return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, reduced, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if goal_identity.kind == "binary" and goal_identity.operator == "==":
                return true if proof_kernel_replay_logical_join_identity_with_work(nodes, children, facts, goal_root, work_used) and work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if remaining > 1:
                    return true if (proof_kernel_replay_index_read_equality(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return true if proof_kernel_replay_both_null_identifiers_with_goal_work(nodes, goal_identity.left, goal_identity.right, work_used) and work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            # Unwrap parentheses before unsigned-range guards; they may enclose a closed OR branch.
            if goal_identity.kind == "paren":
                return false if remaining <= 1
                return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, goal_identity.left, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            # A proved converse closes `not (a < b)`; the same four order pairs are sound for floats.
            if goal_identity.kind == "unary" and goal_identity.operator == "not" and goal_identity.left < nodes.count and remaining > 1:
                negated: ElisaProofKernelCore::ProofKernelNode = nodes[goal_identity.left]
                converse: sview = proof_kernel_replay_order_converse(negated.operator)
                if negated.kind == "binary" and converse != "":
                    flipped: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", converse, negated.right, negated.left, 0, work_used)
                    return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, flipped, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            # Admit a true Boolean literal only after the source-bound producer chose this alternative.
            return true if goal_identity.kind == "bool" and goal_identity.value != 0
            # Predicate rewrites use the exact Boolean complement; recursion keeps machine-range guards.
            if remaining > 1 and goal_identity.kind == "unary" and goal_identity.operator == "not" and goal_identity.left < nodes.count:
                comparison: ElisaProofKernelCore::ProofKernelNode = nodes[goal_identity.left]
                if comparison.kind == "binary" and proof_kernel_replay_negation_supported(comparison.operator) and proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, comparison.left, comparison.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT):
                    complemented: usize = proof_kernel_replay_add_node_with_goal_work(nodes, "binary", proof_kernel_replay_negation(comparison.operator), comparison.left, comparison.right, 0, work_used)
                    return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, complemented, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            # Rewriting a Boolean call leaves its peer to prove under the same premises and fuel.
            predicate_root: mutable usize = goal_root
            predicate_negated: bool = goal_identity.kind == "unary" and goal_identity.operator == "not"
            predicate_root <- goal_identity.left if predicate_negated
            witnessed_predicate: bool = proof_kernel_replay_scalar_term_witnessed_with_work(nodes, children, facts, predicate_root, 0, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT) if remaining > 1 and predicate_root < nodes.count and nodes[predicate_root].kind == "call" else false
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if witnessed_predicate:
                for fact_root in facts |fact_root, nodes, children, facts, predicate_root, predicate_negated, goal_root, split_depth, depth, remaining, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    continue if fact_root >= nodes.count
                    return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used) or work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    equation: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                    continue if equation.kind != "binary" or equation.operator != "=="
                    replacement: mutable usize = nodes.count
                    left_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, equation.left, predicate_root, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    replacement <- equation.right if left_matches
                    right_matches: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, equation.right, predicate_root, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    replacement <- equation.left if right_matches
                    continue if replacement >= nodes.count
                    already_rewritten: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, replacement, predicate_root, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    continue if already_rewritten
                    continue if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, equation.left, equation.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    rewritten: mutable usize = replacement
                    rewritten <- proof_kernel_replay_add_node_with_goal_work(nodes, "unary", "not", replacement, 0, 0, work_used) if predicate_negated
                    return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, rewritten, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            # Introduce a disjunction from either proved alternative; numeric safety follows recursively.
            if goal_identity.kind == "binary" and goal_identity.operator == "or":
                return true if proof_kernel_replay_distinct_disequality_disjunction_with_goal_work(nodes, children, facts, goal_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_facts_propositionally_inconsistent_with_goal_work(nodes, children, facts, depth + 1, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                # Split disjunctive premises before the goal to preserve De Morgan correlations.
                candidate: (known: bool, index: usize, left: usize, right: usize) = (proof_kernel_replay_find_goal_disjunction_with_work(nodes, children, facts, goal_root, work_used, depth) can Global{Read,Write})
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if candidate.known and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                    return false if remaining <= 1
                    left_facts: mutable darray[usize] = []
                    right_facts: mutable darray[usize] = []
                    for fact_index in 0..<facts.count |fact_index, facts, candidate, left_facts, right_facts, work_used|:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        if fact_index == candidate.index:
                            return false if not proof_kernel_replay_goal_search_push_index_with_work(candidate.left, &left_facts, work_used) or not proof_kernel_replay_goal_search_push_index_with_work(candidate.right, &right_facts, work_used)
                        else:
                            return false if not proof_kernel_replay_goal_search_push_index_with_work(facts[fact_index], &left_facts, work_used) or not proof_kernel_replay_goal_search_push_index_with_work(facts[fact_index], &right_facts, work_used)
                    return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, left_facts, goal_root, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) and (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, right_facts, goal_root, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return false if remaining <= 1
                return true if (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, goal_identity.left, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) or (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, goal_identity.right, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT
                denied_facts: mutable darray[usize] = []
                return false if not proof_kernel_replay_goal_search_extend_indices_with_work(facts, &denied_facts, work_used)
                return false if not proof_kernel_replay_push_disjunction_denial_with_work(nodes, children, goal_identity.left, &denied_facts, facts, facts.count + PROOF_KERNEL_DISJUNCTION_DENIAL_FACT_LIMIT, 0, work_used)
                return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, denied_facts, goal_identity.right, split_depth + 1, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if goal_identity.kind == "binary":
                return true if proof_kernel_replay_strict_order_fact_implies_disequality_with_work(nodes, children, facts, goal_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if remaining > 1:
                    return true if (proof_kernel_replay_strict_order_consequence_with_work(nodes, children, facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_equality_disequality_from_fact_with_goal_work(nodes, children, facts, goal_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_fact_constant_comparison_with_goal_work(nodes, goal_identity.left, goal_identity.operator, goal_identity.right, work_used) or proof_kernel_replay_comparison_from_equality_literal_with_work(nodes, children, facts, goal_identity.left, goal_identity.operator, goal_identity.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            # Dispatch finite quantifier goals before arithmetic/model tiers inspect erased
            # block forms, which those tiers do not interpret as ranges.
            if goal_identity.kind == "quantifier":
                return false if remaining <= 1
                return (proof_kernel_replay_quantifier_remaining_with_work(nodes, children, goal_identity.operator, facts, goal_root, work_used, depth + 1, remaining: remaining - 1) can Global{Read,Write})
            if goal_identity.kind == "binary" and proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, goal_identity.left, goal_identity.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT):
                # Negated strict orders and disequality are false for identical operands.
                reflexive: bool = goal_identity.operator == "==" or goal_identity.operator == "<=" or goal_identity.operator == ">="
                if reflexive:
                    return true if proof_kernel_replay_goal_search_expr_equal(nodes, children, goal_identity.left, goal_identity.right, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if goal_identity.kind == "binary" and (goal_identity.operator == "<" or goal_identity.operator == "<="):
                return true if proof_kernel_replay_unsigned_remainder_upper_with_work(nodes, children, facts, goal_identity.left, goal_identity.operator, goal_identity.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_unsigned_unit_increment_order_shape_with_work(nodes, children, facts, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            widened: usize = proof_kernel_replay_unsigned_widening_comparison_with_goal_work(nodes, children, facts, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or widened >= nodes.count or (widened != goal_root and remaining <= 1)
            if widened != goal_root:
                return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, widened, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                boolean = proof_kernel_replay_comparison_boolean_equation_plan_with_goal_work(nodes, children, facts, goal_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if boolean.known:
                    return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, boolean.goal, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                pinned = proof_kernel_replay_pinned_premise_plan_with_goal_work(nodes, children, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if pinned.known and pinned.contradiction
                if pinned.known:
                    return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, pinned.facts, goal_root, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write})
            if remaining > 1:
                subtraction = proof_kernel_replay_subtraction_alias_plan_with_goal_work(nodes, children, facts, goal_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return (proof_kernel_replay_goal_depth_remaining_with_work(nodes, children, facts, subtraction.goal, split_depth, depth + 1, work_used, remaining: remaining - 1) can Global{Read,Write}) if subtraction.known
            return true if proof_kernel_replay_unsigned_pinned_comparison_with_goal_work(nodes, children, facts, goal_root, work_used) and work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if remaining > 1 and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                alias_closed: bool = (proof_kernel_replay_conditional_alias_goal_with_goal_work(nodes, children, facts, goal_root, split_depth, depth, work_used, remaining) can Global{Read,Write})
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if alias_closed
                return false if work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if remaining > 1 and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                conditional_closed: bool = (proof_kernel_replay_conditional_comparison_goal_with_goal_work(nodes, children, facts, goal_root, split_depth, depth, work_used, remaining) can Global{Read,Write})
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if conditional_closed
                return false if work_used >= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_scaled_quotient_sum_goal_with_work(nodes, children, facts, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if proof_kernel_replay_unsigned_scaled_product_upper_shape_with_work(nodes, children, facts, goal_root, work_used)
