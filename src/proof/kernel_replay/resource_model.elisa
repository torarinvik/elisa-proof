extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT: usize = 4

        def proof_kernel_replay_congruence_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize, exhausted: mutable bool&) -> bool:
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
            return false if not located.known
            goal: ElisaProofKernelCore::ProofKernelNode = located.node
            return false if not proof_kernel_replay_arena_shape_valid(goal)
            # The conclusion of this rule is always an equality. Order and disequality goals are
            # left to the arithmetic tiers; congruence establishes identity, not comparison.
            return false if goal.kind != "binary" or goal.operator != "=="
            return false if facts.count == 0
            return false if not proof_kernel_replay_congruence_has_seed_in_facts(nodes, facts)
            terms: mutable darray[usize] = []
            # The conclusion must lie entirely inside the primitive scalar fragment.
            return false if not proof_kernel_replay_congruence_collect(nodes, children, facts, goal_root, &terms, exhausted, 0)
            # Premises contribute on a best-effort basis: one outside the fragment, such as a
            # type marker or an aggregate comparison, simply adds no equality.
            for fact in facts |fact, nodes, children, terms, exhausted|:
                collected: bool = proof_kernel_replay_congruence_collect(nodes, children, facts, fact, &terms, exhausted, 0)
                continue if not collected
            parent: mutable darray[usize] = []
            for index in 0..<terms.count |index, parent|:
                parent.push(index)
            seeded: mutable bool = false
            for fact in facts |fact, nodes, children, terms, parent, seeded|:
                return false if not proof_kernel_replay_congruence_seed(nodes, children, terms, &parent, fact, 0, &seeded)
            # Without a non-trivial equality premise this rule degenerates to structural
            # equality, which earlier tiers already decided.
            return false if not seeded
            proof_kernel_replay_congruence_saturate(nodes, children, terms, &parent, exhausted)
            left_class: (known: bool, index: usize) = proof_kernel_replay_congruence_class(nodes, children, terms, &parent, goal.left)
            right_class: (known: bool, index: usize) = proof_kernel_replay_congruence_class(nodes, children, terms, &parent, goal.right)
            return false if not left_class.known or not right_class.known
            return left_class.index == right_class.index

        # --- Declared effect containment ----------------------------------------------------
        #
        # The producer resolves each direct call in a function body to a declared callee and
        # records that callee's declared `can[...]` row beside the caller's own. This rule
        # re-derives the containment: every effect named by a call entry must appear in the
        # declaring row. It is a statement about declared rows only. What a body performs
        # without a call, and whether a row faithfully describes a body, are the compiler's
        # effect checker's business, and the report says so rather than implying otherwise.
        #
        # An unresolved callee, an abstract row, or a row the producer could not compare never
        # reaches here: the producer emits a diagnostic and no certificate at all.

        def proof_kernel_replay_effect_row_contains(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, row_root: usize, effect: sview) -> bool:
            return false if effect == "" or row_root >= nodes.count or nodes[row_root].kind != "effect-row"
            row: ElisaProofKernelCore::ProofKernelNode = nodes[row_root]
            return false if not proof_kernel_replay_child_range_valid(row.children_start, row.children_count, children.count)
            for offset in 0..<row.children_count |offset, row, children, nodes, effect|:
                member: (known: bool, value: usize) = proof_kernel_replay_index_at(children, row.children_start + offset)
                continue if not member.known
                continue if member.value >= nodes.count or nodes[member.value].kind != "effect"
                return true if nodes[member.value].name == effect
            return false

        def proof_kernel_replay_effect_row_within(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, inner_root: usize, outer_root: usize) -> bool:
            return false if inner_root >= nodes.count or nodes[inner_root].kind != "effect-row"
            inner: ElisaProofKernelCore::ProofKernelNode = nodes[inner_root]
            return false if not proof_kernel_replay_child_range_valid(inner.children_start, inner.children_count, children.count)
            for offset in 0..<inner.children_count |offset, inner, children, nodes, outer_root|:
                member: (known: bool, value: usize) = proof_kernel_replay_index_at(children, inner.children_start + offset)
                return false if not member.known
                return false if member.value >= nodes.count or nodes[member.value].kind != "effect"
                return false if not proof_kernel_replay_effect_row_contains(nodes, children, outer_root, nodes[member.value].name)
            return true

        def proof_kernel_replay_effect_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, goal_root: usize) -> bool:
            return false if goal_root >= nodes.count or nodes[goal_root].kind != "effect-containment"
            root: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            return false if not proof_kernel_replay_arena_shape_valid(root)
            declared_row: usize = root.left
            return false if declared_row >= nodes.count or nodes[declared_row].kind != "effect-row"
            return false if not proof_kernel_replay_child_range_valid(root.children_start, root.children_count, children.count)
            for offset in 0..<root.children_count |offset, root, children, nodes, declared_row|:
                entry: (known: bool, value: usize) = proof_kernel_replay_index_at(children, root.children_start + offset)
                return false if not entry.known
                return false if entry.value >= nodes.count or nodes[entry.value].kind != "effect-call"
                return false if not proof_kernel_replay_effect_row_within(nodes, children, nodes[entry.value].left, declared_row)
            return true

        # Independent replay for `x != a or x != b`. This is valid only for one
        # exact unsigned primitive term and distinct constants that fit its width;
        # arbitrary calls and overloaded comparisons cannot enter this rule.
        def proof_kernel_replay_unsigned_literal_fits(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, width: i64) -> bool:
            return false if width <= 0 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, 0)
            return false if not constant.known
            return constant.value <= proof_kernel_replay_unsigned_width_max(width) if constant.value >= 0
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return width == 64 and node.kind == "int" and node.value == constant.value

        def proof_kernel_replay_unsigned_disequality_constant(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> (known: bool, term: usize, value: i64):
            return (false, 0, 0) if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return (false, 0, 0) if comparison.kind != "binary" or comparison.operator != "!=" or comparison.right >= nodes.count
            width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, comparison.left, facts, 0)
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, comparison.right, 0)
            return (false, 0, 0) if width == 0 or not proof_kernel_replay_unsigned_literal_fits(nodes, comparison.right, width)
            return (false, 0, 0) if not proof_kernel_replay_primitive_comparison(nodes, children, facts, comparison.left, comparison.right)
            return (true, comparison.left, constant.value)

        def proof_kernel_replay_unsigned_distinct_disequality_disjunction(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "or"
            first: (known: bool, term: usize, value: i64) = proof_kernel_replay_unsigned_disequality_constant(nodes, children, facts, goal.left)
            second: (known: bool, term: usize, value: i64) = proof_kernel_replay_unsigned_disequality_constant(nodes, children, facts, goal.right)
            return false if not first.known or not second.known or first.value == second.value
            return proof_kernel_replay_expr_equal(nodes, children, first.term, second.term, 0)

        # Independently derive `x != a` from a fact `x == b` only for one
        # identical unsigned primitive term and distinct in-range constants.
        def proof_kernel_replay_unsigned_disequality_from_equality_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> bool:
            return false if root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            goal: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if goal.kind != "binary" or goal.operator != "!=" or goal.right >= nodes.count
            width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, goal.left, facts, 0)
            target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, goal.right, 0)
            return false if width == 0 or not proof_kernel_replay_unsigned_literal_fits(nodes, goal.right, width)
            return false if not proof_kernel_replay_primitive_comparison(nodes, children, facts, goal.left, goal.right)
            for fact_root in facts |fact_root, nodes, children, facts, goal, width, target|:
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "==" or fact.left >= nodes.count or fact.right >= nodes.count
                if proof_kernel_replay_expr_equal(nodes, children, goal.left, fact.left, 0) and proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right):
                    known_value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, fact.right, 0)
                    return true if known_value.known and proof_kernel_replay_unsigned_literal_fits(nodes, fact.right, width) and known_value.value != target.value
                if proof_kernel_replay_expr_equal(nodes, children, goal.left, fact.right, 0) and proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right):
                    known_value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, fact.left, 0)
                    return true if known_value.known and proof_kernel_replay_unsigned_literal_fits(nodes, fact.left, width) and known_value.value != target.value
            return false

        # Mirror the producer's local comparison rule. It consumes only a typed primitive
        # equality premise for the exact term and small literal; unrelated premises are not
        # interpreted by this step.
        def proof_kernel_replay_comparison_from_equality_literal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left_root: usize, operator: sview, right_root: usize) -> bool:
            return false if not proof_kernel_replay_negation_supported(operator)
            left_constant: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, left_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
            right_constant: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, right_root, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
            return proof_kernel_replay_constant_comparison(nodes, left_root, operator, right_root) if left_constant.known and right_constant.known
            return false if left_constant.known == right_constant.known
            term_root: usize = right_root if left_constant.known else left_root
            goal_constant: i64 = left_constant.value if left_constant.known else right_constant.value
            term_is_left: bool = not left_constant.known
            for fact_root in facts |fact_root, nodes, children, facts, term_root, operator, goal_constant, term_is_left|:
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "=="
                right_literal: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, fact.right, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
                if right_literal.known and proof_kernel_replay_expr_equal(nodes, children, fact.left, term_root, 0):
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, left_root, right_root) or not proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right)
                    return proof_kernel_replay_constant_comparison(nodes, fact.right, operator, right_root) if term_is_left
                    return proof_kernel_replay_constant_comparison(nodes, left_root, operator, fact.right)
                left_literal: ProofKernelReplayInt = proof_kernel_replay_small_nonnegative_constant(nodes, fact.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
                if left_literal.known and proof_kernel_replay_expr_equal(nodes, children, fact.right, term_root, 0):
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, left_root, right_root) or not proof_kernel_replay_primitive_comparison(nodes, children, facts, fact.left, fact.right)
                    return proof_kernel_replay_constant_comparison(nodes, fact.left, operator, right_root) if term_is_left
                    return proof_kernel_replay_constant_comparison(nodes, left_root, operator, fact.left)
            return false

        def proof_kernel_replay_goal_depth(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_root, split_depth, depth, remaining)

        def proof_kernel_replay_goal_depth_remaining(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize, remaining: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            return true if proof_kernel_replay_enum_variant_disjoint_from_facts(nodes, children, facts, goal_root)
            for fact in facts |fact, nodes, children, goal_root|:
                return true if proof_kernel_replay_fact_contains(nodes, children, fact, goal_root, depth + 1)
            goal_identity: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            if remaining > 1:
                reduced: mutable darray[usize] = []
                removed: mutable bool = false
                for fact in facts |reduced, removed, nodes|:
                    if proof_kernel_replay_valid(nodes, fact) and nodes[fact].kind == "quantifier":
                        removed <- true
                    else:
                        reduced.push(fact)
                if removed:
                    return true if proof_kernel_replay_goal_depth_remaining(nodes, children, reduced, goal_root, split_depth, depth + 1, remaining: remaining - 1)
            if remaining > 1:
                return true if proof_kernel_replay_finite_universal_premise(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1)
            return true if goal_identity.kind == "binary" and goal_identity.operator == "or" and proof_kernel_replay_disjunction_direct_branch(nodes, children, goal_root, facts, 0)
            if goal_identity.kind == "binary" and goal_identity.operator == "or":
                literal_left: mutable (known: bool, value: bool) = proof_kernel_replay_constant_bool(nodes, goal_identity.left, 0)
                if goal_identity.left < nodes.count:
                    left: ElisaProofKernelCore::ProofKernelNode = nodes[goal_identity.left]
                    if left.kind == "binary" and left.operator == "!=" and left.left < nodes.count and left.right < nodes.count:
                        a: ElisaProofKernelCore::ProofKernelNode = nodes[left.left]
                        b: ElisaProofKernelCore::ProofKernelNode = nodes[left.right]
                        literal_left <- (true, false) if a.kind == "int" and b.kind == "int" and a.value == b.value
                if literal_left.known and not literal_left.value:
                    return false if remaining <= 1
                    return proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_identity.right, split_depth, depth + 1, remaining: remaining - 1)
                for fact in facts:
                    return true if proof_kernel_replay_disjunction_entails_goal(nodes, children, facts, fact, goal_root, 0)
            # Disjunctive syllogism shrinks a premise rather than making two
            # branches. Spend ordinary recursion fuel, not case-split depth.
            if remaining > 1:
                for index in 0..<facts.count |index, facts, nodes, children, goal_root, split_depth, depth, remaining|:
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, facts[index], depth)
                    continue if not candidate.known
                    left_refuted: bool = proof_kernel_replay_disjunct_refuted(nodes, children, candidate.left, facts, 0)
                    right_refuted: bool = proof_kernel_replay_disjunct_refuted(nodes, children, candidate.right, facts, 0)
                    continue if not left_refuted and not right_refuted
                    reduced: mutable darray[usize] = []
                    reduced.extend(facts)
                    reduced[index] <- candidate.right if left_refuted else candidate.left
                    return proof_kernel_replay_goal_depth_remaining(nodes, children, reduced, goal_root, split_depth, depth + 1, remaining: remaining - 1)
            if goal_identity.kind == "binary" and goal_identity.operator == "==":
                if remaining > 1:
                    return true if proof_kernel_replay_index_read_equality(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1)
                return true if proof_kernel_replay_ident_name(nodes, goal_identity.left) == "null" and proof_kernel_replay_ident_name(nodes, goal_identity.right) == "null"
            # Parentheses do not alter proposition semantics and may enclose an OR whose left
            # branch is already closed, so unwrap them before unsigned-range guards run.
            if goal_identity.kind == "paren":
                return false if remaining <= 1
                return proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_identity.left, split_depth, depth + 1, remaining: remaining - 1)
            # A true Boolean literal is independent of fixed-width premises. It is admitted here
            # only after the source-bound producer chose this disjunction alternative.
            if goal_identity.kind == "bool":
                return goal_identity.value != 0
            # A predicate equation may rewrite a negated call to a negated
            # primitive comparison. Recompute its exact Boolean complement;
            # the recursive goal still applies ordinary machine-range guards.
            if remaining > 1 and goal_identity.kind == "unary" and goal_identity.operator == "not" and goal_identity.left < nodes.count:
                comparison: ElisaProofKernelCore::ProofKernelNode = nodes[goal_identity.left]
                if comparison.kind == "binary" and proof_kernel_replay_negation_supported(comparison.operator) and proof_kernel_replay_primitive_comparison(nodes, children, facts, comparison.left, comparison.right):
                    complemented: usize = ElisaProofKernelCore::add_node(nodes, "binary", proof_kernel_replay_negation(comparison.operator), comparison.left, comparison.right, 0, 0, 0, 0, "", "")
                    return true if proof_kernel_replay_goal_depth_remaining(nodes, children, facts, complemented, split_depth, depth + 1, remaining: remaining - 1)
            # Independently eliminate a primitive Boolean call's exact equality.
            # The other side still needs a proof under the same premises/fuel.
            predicate_root: mutable usize = goal_root
            predicate_negated: bool = goal_identity.kind == "unary" and goal_identity.operator == "not"
            predicate_root <- goal_identity.left if predicate_negated
            if remaining > 1 and predicate_root < nodes.count and nodes[predicate_root].kind == "call" and proof_kernel_replay_scalar_term_witnessed(nodes, children, facts, predicate_root, 0):
                for fact_root in facts |fact_root, nodes, children, facts, predicate_root, predicate_negated, goal_root, split_depth, depth, remaining|:
                    continue if fact_root >= nodes.count
                    equation: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                    continue if equation.kind != "binary" or equation.operator != "=="
                    replacement: mutable usize = nodes.count
                    replacement <- equation.right if proof_kernel_replay_expr_equal(nodes, children, equation.left, predicate_root, 0)
                    replacement <- equation.left if proof_kernel_replay_expr_equal(nodes, children, equation.right, predicate_root, 0)
                    continue if replacement >= nodes.count or proof_kernel_replay_expr_equal(nodes, children, replacement, predicate_root, 0)
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, equation.left, equation.right)
                    rewritten: mutable usize = replacement
                    rewritten <- ElisaProofKernelCore::add_node(nodes, "unary", "not", replacement, 0, 0, 0, 0, 0, "", "") if predicate_negated
                    return true if proof_kernel_replay_goal_depth_remaining(nodes, children, facts, rewritten, split_depth, depth + 1, remaining: remaining - 1)
            # Independently introduce a disjunction from either proved alternative.
            # Numeric safety is checked recursively only for the alternative consumed.
            if goal_identity.kind == "binary" and goal_identity.operator == "or":
                return true if proof_kernel_replay_signed_distinct_disequality_disjunction(nodes, children, facts, goal_root)
                return true if proof_kernel_replay_unsigned_distinct_disequality_disjunction(nodes, children, facts, goal_root)
                return true if proof_kernel_replay_facts_propositionally_inconsistent(nodes, children, facts, depth + 1)
                # Mirror the producer: split a disjunctive premise before choosing
                # one disjunct of the goal, so correlations in De Morgan cases survive.
                candidate: (known: bool, index: usize, left: usize, right: usize) = proof_kernel_replay_find_goal_disjunction(nodes, children, facts, goal_root, depth)
                if candidate.known and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                    return false if remaining <= 1
                    left_facts: mutable darray[usize] = []
                    right_facts: mutable darray[usize] = []
                    for fact_index in 0..<facts.count |fact_index, facts, candidate, left_facts, right_facts|:
                        if fact_index == candidate.index:
                            left_facts.push(candidate.left)
                            right_facts.push(candidate.right)
                        else:
                            left_facts.push(facts[fact_index])
                            right_facts.push(facts[fact_index])
                    return true if proof_kernel_replay_goal_depth_remaining(nodes, children, left_facts, goal_root, split_depth + 1, depth + 1, remaining: remaining - 1) and proof_kernel_replay_goal_depth_remaining(nodes, children, right_facts, goal_root, split_depth + 1, depth + 1, remaining: remaining - 1)
                return false if remaining <= 1
                return true if proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_identity.left, split_depth, depth + 1, remaining: remaining - 1) or proof_kernel_replay_goal_depth_remaining(nodes, children, facts, goal_identity.right, split_depth, depth + 1, remaining: remaining - 1)
                return false if split_depth >= PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT
                denied_facts: mutable darray[usize] = []
                denied_facts.extend(facts)
                return false if not proof_kernel_replay_push_disjunction_denial(nodes, children, goal_identity.left, &denied_facts, facts, facts.count + PROOF_KERNEL_DISJUNCTION_DENIAL_FACT_LIMIT, 0)
                return proof_kernel_replay_goal_depth_remaining(nodes, children, denied_facts, goal_identity.right, split_depth + 1, depth + 1, remaining: remaining - 1)
            if goal_identity.kind == "binary":
                return true if proof_kernel_replay_strict_order_fact_implies_disequality(nodes, children, facts, goal_root)
                if remaining > 1:
                    return true if proof_kernel_replay_strict_order_consequence(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1)
                return true if proof_kernel_replay_signed_disequality_from_equality_fact(nodes, children, facts, goal_root)
                return true if proof_kernel_replay_unsigned_disequality_from_equality_fact(nodes, children, facts, goal_root)
                return true if proof_kernel_replay_direct_literal_comparison(nodes, goal_identity.left, goal_identity.operator, goal_identity.right)
                return true if proof_kernel_replay_constant_comparison(nodes, goal_identity.left, goal_identity.operator, goal_identity.right)
                return true if proof_kernel_replay_comparison_from_equality_literal(nodes, children, facts, goal_identity.left, goal_identity.operator, goal_identity.right)
            # Quantifier goals are already finite, self-contained proof obligations. Dispatch
            # them before arithmetic/model tiers inspect the erased block representation; those
            # tiers deliberately do not know how to interpret a quantifier range.
            if goal_identity.kind == "quantifier":
                return false if remaining <= 1
                return proof_kernel_replay_quantifier_remaining(nodes, children, goal_identity.operator, facts, goal_root, depth + 1, remaining: remaining - 1)
            if goal_identity.kind == "binary" and proof_kernel_replay_primitive_comparison(nodes, children, facts, goal_identity.left, goal_identity.right):
                # Having a comparison negation does not make an operator reflexive:
                # strict orders and disequality are false on identical operands. Written as one
                # condition rather than a match with a `pass` default: `pass` parses to an
                # expression statement carrying `Expr.Invalid`, which the checker refuses because
                # at this AST layer it cannot tell it from a construct the frontend dropped, and
                # the refusal havocs the state for everything after it in the body.
                reflexive: bool = goal_identity.operator == "==" or goal_identity.operator == "<=" or goal_identity.operator == ">="
                if reflexive:
                    return true if proof_kernel_replay_definitionally_equal(nodes, children, goal_identity.left, goal_identity.right, depth + 1)
            if goal_identity.kind == "binary" and (goal_identity.operator == "<" or goal_identity.operator == "<="):
                remainder_width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, goal_identity.left, facts, depth + 1)
                if remainder_width > 0:
                    return true if proof_kernel_replay_unsigned_remainder_upper(nodes, children, facts, goal_identity.left, goal_identity.operator, goal_identity.right)
            return true if proof_kernel_replay_unsigned_unit_increment_order_shape(nodes, children, facts, goal_root)
            widened: usize = proof_kernel_replay_unsigned_widening_comparison(nodes, children, facts, goal_root)
            if widened != goal_root:
                return false if remaining <= 1
                return proof_kernel_replay_goal_depth_remaining(nodes, children, facts, widened, split_depth, depth + 1, remaining: remaining - 1)
            return true if proof_kernel_replay_unsigned_scaled_product_upper_shape(nodes, children, facts, goal_root)
            # Mirror: propositional inconsistency reads no term as a number, so it runs before
            # the fixed-width guard and lets a refuted branch close without range-safe facts.
            return true if proof_kernel_replay_facts_propositionally_inconsistent(nodes, children, facts, depth + 1)
            if split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                selected: (known: bool, index: usize, left: usize, right: usize) = proof_kernel_replay_find_goal_disjunction(nodes, children, facts, goal_root, depth)
                for index in 0..<facts.count |index, facts, nodes, children, goal_root, split_depth, depth, remaining|:
                    continue if not selected.known or index != selected.index
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, facts[index], depth)
                    if candidate.known:
                        return false if remaining <= 1
                        left_facts: mutable darray[usize] = []
                        right_facts: mutable darray[usize] = []
                        for fact_index in 0..<facts.count |fact_index, facts, candidate, left_facts, right_facts|:
                            if fact_index == index:
                                left_facts.push(candidate.left)
                                right_facts.push(candidate.right)
                            else:
                                left_facts.push(facts[fact_index])
                                right_facts.push(facts[fact_index])
                        return proof_kernel_replay_goal_depth_remaining(nodes, children, left_facts, goal_root, split_depth + 1, depth + 1, remaining: remaining - 1) and proof_kernel_replay_goal_depth_remaining(nodes, children, right_facts, goal_root, split_depth + 1, depth + 1, remaining: remaining - 1)
            # Mirror: nonnegativity holds under both readings of a fixed-width term and reads no
            # premise, only the traced type markers, so it runs before the fixed-width guards.
            return true if proof_kernel_replay_unsigned_nonnegative_shape(nodes, children, facts, goal_root)
            return true if proof_kernel_replay_unsigned_subtraction_upper_shape(nodes, children, facts, goal_root)
            # Mirror the producer's guarded unsigned-sum upper-bound rule before the generic
            # arithmetic safety walk encounters the addition it is proving safe. Restrict the
            # early replay path to a positively witnessed unsigned result width; signed sums
            # remain behind the ordinary whole-expression guard.
            if goal_identity.kind == "binary" and (goal_identity.operator == "<" or goal_identity.operator == "<="):
                sum_width: i64 = proof_kernel_replay_unsigned_width_in_expression(nodes, children, goal_root, facts, depth + 1)
                if sum_width > 0:
                    return true if proof_kernel_replay_sum_bound(nodes, children, facts, goal_identity.left, goal_identity.operator, goal_identity.right)
            # Equality congruence preserves deterministic fixed-width operations under wrap. It
            # establishes identity, not an unbounded-integer order or range claim.
            if goal_identity.kind == "binary" and goal_identity.operator == "==":
                unsigned_free: mutable bool = proof_kernel_replay_unsigned_width_in_expression(nodes, children, goal_root, facts, depth + 1) == 0
                for fact in facts |fact, nodes, children, depth, unsigned_free|:
                    unsigned_free <- false if proof_kernel_replay_unsigned_width_in_expression(nodes, children, fact, facts, depth + 1) != 0
                if unsigned_free:
                    congruence_exhausted: mutable bool = false
                    return true if proof_kernel_replay_congruence_goal(nodes, children, facts, goal_root, &congruence_exhausted)
            # Premises are interpreted by the same signed arithmetic/model tiers.
            # Reject their modular overflow too, independently of the AST producer.
            # Each branch of a split above re-enters here with its own premises.
            # Facts and goal share one admitted kernel arena and one premise set. Compute the two
            # arithmetic contexts once, then apply the original safety predicates to each root.
            # Their name views are only read while this call keeps the arena alive.
            unsigned_bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, facts, unsigned_bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &unsigned_bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &unsigned_bounds)
            signed_bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, children, facts, signed_bounds|:
                proof_kernel_replay_collect_bounds(nodes, children, facts, fact, &signed_bounds, 0)
            proof_kernel_replay_close_equalities(nodes, children, facts, &signed_bounds)
            proof_kernel_replay_add_signed_type_bounds(nodes, children, facts, &signed_bounds)
            signed_constraints: mutable darray[ProofKernelReplayDifference] = []
            for fact in facts |fact, nodes, children, facts, signed_bounds, signed_constraints|:
                proof_kernel_replay_collect_differences(nodes, fact, signed_bounds, children, facts, &signed_constraints, 0)
            if signed_constraints.count <= PROOF_KERNEL_REPLAY_MAX_DIFFERENCE_CONSTRAINTS:
                proof_kernel_replay_close_bounds_through_differences(signed_constraints, &signed_bounds)
            # A primitive comparison and its explicitly negated counterpart are exact
            # propositional complements, independent of the arithmetic representation of
            # their operands. Replay this before fixed-width range rejection, but only for
            # operators with a defined complement and operands witnessed as primitive scalars.
            # Typed proposition admission permits null equality only against a nullable
            # reference. Replay the exact equality complement independently of scalar
            # arithmetic; no pointer ordering or integer conversion follows from this rule.
            null_equality: bool = goal_identity.kind == "binary" and (goal_identity.operator == "==" or goal_identity.operator == "!=") and ((goal_identity.left < nodes.count and nodes[goal_identity.left].kind == "ident" and nodes[goal_identity.left].name == "null") or (goal_identity.right < nodes.count and nodes[goal_identity.right].kind == "ident" and nodes[goal_identity.right].name == "null"))
            if goal_identity.kind == "binary" and proof_kernel_replay_negation_supported(goal_identity.operator) and (proof_kernel_replay_primitive_comparison(nodes, children, facts, goal_identity.left, goal_identity.right) or null_equality):
                for fact in facts |fact, nodes, children, goal_identity, depth|:
                    return true if proof_kernel_replay_negative_fact(nodes, children, facts, fact, goal_identity.left, goal_identity.operator, goal_identity.right, depth + 1)
            for fact in facts |fact, nodes, children, facts, unsigned_bounds, signed_bounds|:
                return false if not proof_kernel_replay_unsigned_expression_safe(nodes, children, fact, facts, unsigned_bounds, 0)
                return false if not proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, fact, facts, signed_bounds, 0)
            # Mirror the producer's interval contradiction rule only after every
            # premise passes the fixed-width safety guards. Bounds are derived
            # independently from primitive comparisons and equality closure;
            # no inconsistent interval is accepted from a producer certificate.
            for bound in unsigned_bounds:
                return true if bound.has_lower and bound.has_upper and bound.lower > bound.upper
            return true if proof_kernel_replay_facts_inconsistent(nodes, facts, depth + 1)
            return true if proof_kernel_replay_fact_proves_call_summary(nodes, children, facts, goal_root)
            # Independently derive exact summary consequences before using
            # them in congruence. Existing depth/fuel bounds still apply.
            if remaining > 1:
                derived: mutable darray[usize] = []
                for fact_root in facts |fact_root, facts, nodes, children, derived|:
                    continue if fact_root >= nodes.count
                    equation: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                    continue if equation.kind != "binary" or equation.operator != "=="
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, equation.left, equation.right)
                    for orientation in 0..<2 |orientation, equation, facts, nodes, children, derived|:
                        consequence: usize = equation.right if orientation == 0 else equation.left
                        continue if consequence >= nodes.count or nodes[consequence].kind == "call"
                        present: mutable bool = false
                        for premise in facts |premise, consequence, present, nodes, children|:
                            present <- true if proof_kernel_replay_fact_contains(nodes, children, premise, consequence, 0)
                        continue if present or not proof_kernel_replay_fact_proves_call_summary(nodes, children, facts, consequence)
                        derived.push(consequence)
                if derived.count > 0:
                    enriched: mutable darray[usize] = []
                    enriched.extend(facts)
                    enriched.extend(&derived)
                    return true if proof_kernel_replay_goal_depth_remaining(nodes, children, enriched, goal_root, split_depth, depth + 1, remaining: remaining - 1)
            # Keep the source-neutral kernel from applying its signed arithmetic/model rules to a
            # fixed-width unsigned term unless every arithmetic subterm has a finite, in-range
            # interval under the traced width marker.
            return false if not (proof_kernel_replay_unsigned_expression_safe(nodes, children, goal_root, facts, unsigned_bounds, 0) and proof_kernel_replay_signed_expression_safe_with_bounds(nodes, children, goal_root, facts, signed_bounds, 0))
            return true if proof_kernel_replay_bounded_model_goal(nodes, children, facts, goal_root)
            if remaining > 1:
                return true if proof_kernel_replay_comparison_transport(nodes, children, facts, goal_root, split_depth, depth + 1, remaining: remaining - 1)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[goal_root]
            if node.kind == "bool":
                return node.value != 0
            if node.kind == "unary" and node.operator == "not":
                if node.left < nodes.count:
                    inner: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                    if inner.kind == "bool":
                        return inner.value == 0
                    if inner.kind == "binary":
                        return proof_kernel_replay_negated_constant_comparison(nodes, inner.left, inner.operator, inner.right)
            if node.kind == "binary" and node.operator == "and":
                return false if remaining <= 1
                return proof_kernel_replay_goal_depth_remaining(nodes, children, facts, node.left, split_depth, depth + 1, remaining: remaining - 1) and proof_kernel_replay_goal_depth_remaining(nodes, children, facts, node.right, split_depth, depth + 1, remaining: remaining - 1)
            if node.kind == "binary" and node.operator == "=>":
                return false if remaining <= 1
                implication_facts: mutable darray[usize] = []
                implication_facts.extend(facts)
                implication_facts.push(node.left)
                return proof_kernel_replay_goal_depth_remaining(nodes, children, implication_facts, node.right, split_depth, depth + 1, remaining: remaining - 1)
            if node.kind == "binary" and (node.operator == ">" or node.operator == ">=" or node.operator == "<" or node.operator == "<=" or node.operator == "==" or node.operator == "!=") and split_depth < PROOF_KERNEL_REPLAY_CASE_SPLIT_DEPTH_LIMIT:
                if node.left < nodes.count and nodes[node.left].kind == "if":
                    return false if remaining <= 1
                    conditional: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                    then_facts: mutable darray[usize] = []
                    else_facts: mutable darray[usize] = []
                    then_facts.extend(facts)
                    else_facts.extend(facts)
                    then_facts.push(conditional.left)
                    negated_condition: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", conditional.left, 0, 0, 0, 0, 0, "", "")
                    else_facts.push(negated_condition)
                    then_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.right, node.right, 0, 0, 0, 0, "", "")
                    else_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.auxiliary, node.right, 0, 0, 0, 0, "", "")
                    # A failed case split proves nothing either way, so it must not consume the
                    # goal: later tiers, including congruence, still get to decide it.
                    return true if proof_kernel_replay_goal_depth_remaining(nodes, children, then_facts, then_goal, split_depth + 1, depth + 1, remaining: remaining - 1) and proof_kernel_replay_goal_depth_remaining(nodes, children, else_facts, else_goal, split_depth + 1, depth + 1, remaining: remaining - 1)
                if node.right < nodes.count and nodes[node.right].kind == "if":
                    return false if remaining <= 1
                    conditional: ElisaProofKernelCore::ProofKernelNode = nodes[node.right]
                    then_facts: mutable darray[usize] = []
                    else_facts: mutable darray[usize] = []
                    then_facts.extend(facts)
                    else_facts.extend(facts)
                    then_facts.push(conditional.left)
                    negated_condition: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", conditional.left, 0, 0, 0, 0, 0, "", "")
                    else_facts.push(negated_condition)
                    then_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, node.left, conditional.right, 0, 0, 0, 0, "", "")
                    else_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, node.left, conditional.auxiliary, 0, 0, 0, 0, "", "")
                    return true if proof_kernel_replay_goal_depth_remaining(nodes, children, then_facts, then_goal, split_depth + 1, depth + 1, remaining: remaining - 1) and proof_kernel_replay_goal_depth_remaining(nodes, children, else_facts, else_goal, split_depth + 1, depth + 1, remaining: remaining - 1)
            if node.kind == "binary":
                readable: darray[usize] = facts
                if proof_kernel_replay_negation_supported(node.operator) and proof_kernel_replay_primitive_comparison(nodes, children, readable, node.left, node.right) and proof_kernel_replay_definitionally_equal(nodes, children, node.left, node.right, 0):
                    return node.operator == "==" or node.operator == "<=" or node.operator == ">="
                return true if proof_kernel_replay_negation_supported(node.operator) and proof_kernel_replay_constant_comparison(nodes, node.left, node.operator, node.right)
                return true if proof_kernel_replay_interval_goal(nodes, children, node.left, node.operator, node.right, readable)
                return true if proof_kernel_replay_primitive_comparison(nodes, children, readable, node.left, node.right) and proof_kernel_replay_affine_comparison(nodes, children, node.left, node.operator, node.right, readable)
                return true if proof_kernel_replay_primitive_comparison(nodes, children, readable, node.left, node.right) and proof_kernel_replay_difference_comparison(nodes, children, node.left, node.operator, node.right, readable)
                return true if proof_kernel_replay_product_sign(nodes, children, readable, node.left, node.operator, node.right)
                return true if proof_kernel_replay_comparison_chain(nodes, children, readable, node.left, node.operator, node.right)
                return true if proof_kernel_replay_strict_shift(nodes, children, readable, node.left, node.operator, node.right)
                return true if proof_kernel_replay_sum_bound(nodes, children, readable, node.left, node.operator, node.right)
                return true if proof_kernel_replay_unsigned_nonnegative(nodes, children, readable, node.left, node.operator, node.right)
                # Ground congruence closure is the last equality tier. It runs only after the
                # fixed-width safety guards above have rejected every wrapping premise and goal,
                # so equal operands of different widths can never be propagated through a former.
                congruence_exhausted: mutable bool = false
                return true if proof_kernel_replay_congruence_goal(nodes, children, facts, goal_root, &congruence_exhausted)
            return false


        def proof_kernel_replay_resource_index_disjoint(state: ProofKernelReplayResourceState&, left_root: usize, right_root: usize) -> bool:
            for index in 0..<state.disjoint_left.count |index, state, left_root, right_root|:
                return true if index < state.disjoint_right.count and ((state.disjoint_left[index] == left_root and state.disjoint_right[index] == right_root) or (state.disjoint_left[index] == right_root and state.disjoint_right[index] == left_root))
            return false

        def proof_kernel_replay_resource_place_is_prefix(state: ProofKernelReplayResourceState&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, prefix: ProofKernelReplayResourcePlace, target: ProofKernelReplayResourcePlace) -> bool:
            return false if not proof_kernel_replay_resource_place_root_valid(nodes, prefix) or not proof_kernel_replay_resource_place_root_valid(nodes, target)
            return false if nodes[prefix.root_node].name != nodes[target.root_node].name
            return true if prefix.whole
            return false if target.whole or prefix.depth > target.depth or prefix.depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or target.depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            for index in 0..<prefix.depth:
                prefix_component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_kernel_replay_resource_path_component(nodes, prefix.path_root, index, prefix.depth)
                target_component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_kernel_replay_resource_path_component(nodes, target.path_root, index, target.depth)
                return false if not prefix_component.known or not target_component.known or prefix_component.kind != target_component.kind
                return false if prefix_component.kind == "field" and prefix_component.field != target_component.field
                if prefix_component.kind == "index":
                    if proof_kernel_replay_resource_index_expression_valid(nodes, prefix_component.expression_root, 0) and proof_kernel_replay_resource_index_expression_valid(nodes, target_component.expression_root, 0):
                        prefix_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, prefix_component.expression_root, 0)
                        target_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, target_component.expression_root, 0)
                        return false if prefix_constant.known and target_constant.known and prefix_constant.value != target_constant.value
                    return false if proof_kernel_replay_resource_index_disjoint(state, prefix_component.expression_root, target_component.expression_root)
            return true

        def proof_kernel_replay_resource_places_overlap(state: ProofKernelReplayResourceState&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left: ProofKernelReplayResourcePlace, right: ProofKernelReplayResourcePlace) -> bool:
            return proof_kernel_replay_resource_place_is_prefix(state, nodes, left, right) or proof_kernel_replay_resource_place_is_prefix(state, nodes, right, left)

        struct ProofKernelReplayResourceState:
            binding_names: mutable darray[sview]
            # Top-level function formals are supplied from the resource-safety header.
            # Return-through-call certificates may propagate provenance only back to one
            # of these names, never to an unrelated local with the same lifetime.
            formal_names: mutable darray[sview]
            binding_scope_depth: mutable darray[usize]
            scope_depth: mutable usize
            binding_reference: mutable darray[bool]
            binding_mutable_reference: mutable darray[bool]
            binding_writable: mutable darray[bool]
            # Aggregate by-value bindings may be implicitly shared-borrowed at a call boundary.
            # This capability is serialized separately from writable/reference mode so replay can
            # distinguish a tracked aggregate place from an ordinary scalar value.
            binding_borrowable: mutable darray[bool]
            binding_moved: mutable darray[bool]
            binding_region: mutable darray[sview]
            # Region names can be reused after a close; this bit preserves region identity across
            # that spelling reuse and prevents a stale binding from being resurrected.
            binding_region_live: mutable darray[bool]
            # Direct region allocations establish an exclusive owner token. Borrowed, external,
            # and call result references do not; replay uses this provenance when checking region
            # aliases. A region alias transfers the token instead of copying it.
            binding_region_owner: mutable darray[bool]
            active_regions: mutable darray[sview]
            # A nested scope inherits the parent's active region identities. Names alone are
            # insufficient here: closing and reopening the same spelling in the child must not
            # make the parent's older region appear preserved when the child snapshot joins.
            protected_regions: mutable darray[sview]
            # Region parameters are caller-owned and remain live for the complete callee trace;
            # they are distinct from lexical regions that a close transition invalidates.
            external_regions: mutable darray[sview]
            # `sview @r` parameters borrow an unknown place in @r, so their shared borrow is
            # conservatively checked against every write in that region.
            region_wide_borrows: mutable darray[sview]
            borrow_target_slots: mutable darray[usize]
            borrow_target_places: mutable darray[ProofKernelReplayResourcePlace]
            borrow_mutable: mutable darray[bool]
            borrow_present: mutable darray[bool]
            disjoint_left: mutable darray[usize]
            disjoint_right: mutable darray[usize]
            # Result events must name calls already replayed in this trace. Fresh region call
            # arguments must likewise name allocations already consumed before the call.
            resource_call_events: mutable darray[usize]
            resource_call_allocations: mutable darray[usize]
            resource_call_allocations_used: mutable darray[usize]
            resource_call_results: mutable darray[usize]
            resource_return_alloc_regions: mutable darray[sview]
            resource_return_witnesses: mutable darray[usize]
            # A return witness is a single observed transition. It may justify at most one
            # serialized return marker in a callee summary.
            resource_return_witnesses_used: mutable darray[usize]
            # A child scope may consume an inherited binding, but that state cannot disappear
            # when the child snapshot is discarded. The parent must consume a matching, slot-based
            # join transition immediately after the scope before any other transition is allowed.
            pending_join_moves: mutable darray[bool]
            # Empty origin means body-local storage. A non-empty origin is a formal external
            # capability, possibly reached through one or more local borrow aliases.
            binding_origin_places: mutable darray[ProofKernelReplayResourcePlace]
