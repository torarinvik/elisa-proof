extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_integer_literal_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> (known: bool, value: i64):
            return (false, 0) if root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            return (false, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[root].kind != "int" or proof_kernel_replay_int_tagged(nodes[root])
            return (true, nodes[root].value)

        # Exact shared-meter counterpart of the equality-pin lookup. It only accepts raw,
        # untagged integer literals and left-side identifier/scope pins, matching legacy replay.
        def proof_kernel_replay_pinned_constant_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> (known: bool, value: i64):
            return (false, 0) if root >= nodes.count or not proof_kernel_replay_goal_search_charge(work_used)
            return (false, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if nodes[root].kind == "int":
                return (false, 0) if proof_kernel_replay_int_tagged(nodes[root])
                return (true, nodes[root].value)
            return (false, 0) if nodes[root].kind != "ident" and nodes[root].kind != "scope"
            for fact_root in facts |fact_root, nodes, children, facts, root, work_used|:
                return (false, 0) if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact_root >= nodes.count or not proof_kernel_replay_valid(nodes, fact_root)
                return (false, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, fact_root, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                fact: ElisaProofKernelCore::ProofKernelNode = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "=="
                pin_root: usize = fact.left
                continue if pin_root >= nodes.count or not proof_kernel_replay_valid(nodes, pin_root)
                return (false, 0) if not proof_kernel_replay_goal_search_charge_node_text(nodes, pin_root, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if nodes[pin_root].kind != "ident" and nodes[pin_root].kind != "scope"
                same_pin: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, pin_root, root, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not same_pin
                pinned_literal: (known: bool, value: i64) = proof_kernel_replay_integer_literal_with_goal_work(nodes, fact.right, work_used)
                return (false, 0) if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return pinned_literal if pinned_literal.known
            return (false, 0)

        def proof_kernel_replay_operand_matches_through_pins_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], fact_root: usize, goal_root: usize, work_used: mutable usize&) -> bool:
            same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, fact_root, goal_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return true if same_term
            fact_constant: (known: bool, value: i64) = proof_kernel_replay_pinned_constant_with_goal_work(nodes, children, facts, fact_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not fact_constant.known
            goal_constant: (known: bool, value: i64) = proof_kernel_replay_pinned_constant_with_goal_work(nodes, children, facts, goal_root, work_used)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and goal_constant.known and goal_constant.value == fact_constant.value

        def proof_kernel_replay_negative_fact_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, left_root: usize, operator: sview, right_root: usize, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not proof_kernel_replay_valid(nodes, root)
            return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "binary" and node.operator == "and":
                return true if proof_kernel_replay_negative_fact_with_goal_work(nodes, children, facts, node.left, left_root, operator, right_root, work_used, depth + 1)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return proof_kernel_replay_negative_fact_with_goal_work(nodes, children, facts, node.right, left_root, operator, right_root, work_used, depth + 1)
            if node.kind == "unary" and node.operator == "not":
                inner_root: usize = node.left
                return false if inner_root >= nodes.count or not proof_kernel_replay_goal_search_charge_node_text(nodes, inner_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or nodes[inner_root].kind != "binary"
                if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(operator)):
                    return false
                if proof_kernel_replay_is_order_operator(operator):
                    left_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, left_root, facts, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not left_integer
                    right_integer: bool = proof_kernel_replay_order_integer_term_with_work(nodes, children, right_root, facts, work_used, 0)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not right_integer
                inner: ElisaProofKernelCore::ProofKernelNode = nodes[inner_root]
                complementary: bool = proof_kernel_replay_goal_search_text_equal(inner.operator, proof_kernel_replay_negation(operator), work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not complementary
                same_left: bool = proof_kernel_replay_operand_matches_through_pins_with_goal_work(nodes, children, facts, inner.left, left_root, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not same_left
                return proof_kernel_replay_operand_matches_through_pins_with_goal_work(nodes, children, facts, inner.right, right_root, work_used)
            return false

        def proof_kernel_replay_negative_fact_in_context_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], left_root: usize, operator: sview, right_root: usize, work_used: mutable usize&, depth: usize) -> bool:
            for fact_root in facts |fact_root, nodes, children, facts, left_root, operator, right_root, work_used, depth|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return true if proof_kernel_replay_negative_fact_with_goal_work(nodes, children, facts, fact_root, left_root, operator, right_root, work_used, depth)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false

        # The enclosing goal scan has already charged the goal node. Charge each operand node
        # before reading its tag or identifier text to preserve the null-equality exception.
        def proof_kernel_replay_null_equality_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, goal: ElisaProofKernelCore::ProofKernelNode, work_used: mutable usize&) -> bool:
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return false if goal.kind != "binary" or (goal.operator != "==" and goal.operator != "!=")
            left_is_null: mutable bool = false
            if goal.left < nodes.count:
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.left, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                left_is_null <- nodes[goal.left].kind == "ident" and nodes[goal.left].name == "null"
            return true if left_is_null
            if goal.right < nodes.count:
                return false if not proof_kernel_replay_goal_search_charge_node_text(nodes, goal.right, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                return nodes[goal.right].kind == "ident" and nodes[goal.right].name == "null"
            return false

        def proof_kernel_replay_both_null_identifiers_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, right_root: usize, work_used: mutable usize&) -> bool:
            return false if left_root >= nodes.count or not proof_kernel_replay_valid(nodes, left_root)
            left_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, left_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or left_name != "null"
            return false if right_root >= nodes.count or not proof_kernel_replay_valid(nodes, right_root)
            right_name: sview = proof_kernel_replay_ident_name_with_goal_work(nodes, right_root, work_used)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            right_name == "null"
