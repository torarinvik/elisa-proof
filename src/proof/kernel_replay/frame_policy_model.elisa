# Source-neutral frame relations. Parameter ordinals belong to one caller
# signature; source correspondence must bind that signature before admission.
module ElisaProofKernelFramePolicy:
    public:
        struct Place:
            parameter: usize
            depth: usize
            field: sview
            field2: sview
            field3: sview

    private:
        const FRAME_POLICY_PLACE_LIMIT: usize = 64

        def place_valid(place: Place, parameter_count: usize) -> bool:
            return false if parameter_count > FRAME_POLICY_PLACE_LIMIT or place.parameter >= parameter_count or place.depth > 3
            return false if (place.field == "") != (place.depth == 0)
            return false if (place.field2 == "") != (place.depth < 2)
            return false if (place.field3 == "") != (place.depth < 3)
            return true

        def prefix_of(prefix: Place, target: Place) -> bool:
            return false if prefix.parameter != target.parameter or prefix.depth > target.depth
            return false if prefix.depth > 0 and prefix.field != target.field
            return false if prefix.depth > 1 and prefix.field2 != target.field2
            return false if prefix.depth > 2 and prefix.field3 != target.field3
            return true

        def overlap(left: Place, right: Place) -> bool:
            return prefix_of(left, right) or prefix_of(right, left)

    public:
        # Check every supplied place before searching for a successful match.
        # A valid first entry must not hide malformed trailing policy entries.
        def write_allowed(actual: Place, changes: darray[Place]&, preserves: darray[Place]&, parameter_count: usize) -> bool:
            return false if not place_valid(actual, parameter_count)
            return false if changes.count == 0 or changes.count > FRAME_POLICY_PLACE_LIMIT or preserves.count > FRAME_POLICY_PLACE_LIMIT
            for changed in changes:
                return false if not place_valid(changed, parameter_count)
            for preserved in preserves:
                return false if not place_valid(preserved, parameter_count)
            contained: mutable bool = false
            for changed in changes |actual, contained|:
                contained <- true if prefix_of(changed, actual)
            return false if not contained
            for preserved in preserves |actual|:
                return false if overlap(preserved, actual)
            return true
