# Minimal source-neutral typing for logical proposition formation. The environment contains
# declaration signatures only; it is kept separate from facts/hypotheses and never treats an
# arbitrary term-root tag as type evidence.
extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_function_arguments_well_typed_remaining(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, function: ElisaProofKernelCore::ProofKernelTypingBinding, call: ElisaProofKernelCore::ProofKernelNode, depth: usize, remaining: usize, work: mutable usize&) -> bool:
            requires depth <= PROOF_KERNEL_FUNCTION_DEPTH_PRECONDITION
            requires remaining > 0
            ensure result => call.children_count <= function.parameter_count
            decreases remaining
            return false if:
                remaining == 0
                function.parameter_count > PROOF_KERNEL_MAX_TYPED_FUNCTION_PARAMETERS or call.children_count > function.parameter_count
                not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count)
                not proof_kernel_replay_type_work_consume_amount(function.parameter_count, work)
            assigned: mutable darray[bool] = [false for _slot in 0..<function.parameter_count]
            next_position: mutable usize = 0
            for offset in 0..<call.children_count |offset, nodes, children, environment, function, call, depth, remaining, assigned, next_position, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                argument_wrapper: usize = proof_kernel_replay_child_root(nodes.count, children, call, offset)
                return false if argument_wrapper >= nodes.count
                return false if nodes[argument_wrapper].kind != "call_arg"
                argument: ElisaProofKernelCore::ProofKernelNode = nodes[argument_wrapper]
                selected_index: mutable usize = function.parameter_count
                if argument.name != "":
                    named_parameter: (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_function_parameter_by_name(environment, typing_index, function, argument.name, work)
                    return false if not named_parameter.known
                    selected_index <- named_parameter.parameter.parameter_index
                else:
                    while next_position < function.parameter_count and assigned[next_position] |next_position, assigned|:
                        next_position <- next_position + 1
                    selected_index <- next_position
                    next_position <- next_position + 1 if next_position < function.parameter_count
                return false if selected_index >= function.parameter_count or assigned[selected_index]
                assigned[selected_index] <- true
                indexed_parameter: (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_function_parameter_by_index(environment, typing_index, function, selected_index, work)
                return false if:
                    not indexed_parameter.known
                    remaining <= 1
                    not proof_kernel_replay_argument_matches_parameter_remaining(nodes, children, environment, typing_index, argument.left, indexed_parameter.parameter, true, depth + 1, remaining - 1, work)
            for index in 0..<function.parameter_count |index, nodes, children, environment, function, call, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                parameter: (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_function_parameter_by_index(environment, typing_index, function, index, work)
                return false if:
                    not parameter.known
                    not assigned[index] and not parameter.parameter.parameter_has_default
            return true

        def proof_kernel_replay_call_result_sort_remaining(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, call: ElisaProofKernelCore::ProofKernelNode, callee_name: sview, callee_owner_identity: usize, depth: usize, remaining: usize, work: mutable usize&) -> ProofKernelInferredSort:
            requires depth <= PROOF_KERNEL_CALL_DEPTH_PRECONDITION
            requires remaining > 0
            decreases remaining
            global_result: (known: bool, found: bool, applicable: bool, ambiguous: bool, selected: ProofKernelInferredSort) = proof_kernel_replay_call_result_sort_in_group(nodes, children, environment, typing_index, environment.global_bindings, typing_index.global_function_group_index, call, callee_name, callee_owner_identity, depth, remaining, work)
            return proof_kernel_replay_unknown_sort() if not global_result.known
            local_result: (known: bool, found: bool, applicable: bool, ambiguous: bool, selected: ProofKernelInferredSort) = proof_kernel_replay_call_result_sort_in_group(nodes, children, environment, typing_index, environment.bindings, typing_index.local_function_group_index, call, callee_name, callee_owner_identity, depth, remaining, work)
            return proof_kernel_replay_unknown_sort() if:
                not local_result.known
                work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
                global_result.found and local_result.found
            return global_result.selected if global_result.found and global_result.applicable and not global_result.ambiguous
            return local_result.selected if local_result.found and local_result.applicable and not local_result.ambiguous
            return proof_kernel_replay_unknown_sort()

        def proof_kernel_replay_primitive_numeric_sort(name: sview) -> ProofKernelInferredSort:
            if name in {"i8", "i16", "i32", "i64", "i128", "u8", "u16", "u32", "u64", "u128", "usize", "isize", "uintptr", "int", "byte"}:
                return proof_kernel_replay_known_sort("integer", name)
            if name in {"f16", "f32", "f64", "float"}:
                return proof_kernel_replay_known_sort("floating", name)
            return proof_kernel_replay_known_sort("character", "char") if name == "char"
            return proof_kernel_replay_unknown_sort()

        def proof_kernel_replay_term_sort(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, root: usize, depth: usize, work: mutable usize&) -> ProofKernelInferredSort:
            requires depth <= PROOF_KERNEL_TYPING_DEPTH_LIMIT
            return proof_kernel_replay_unknown_sort() if depth >= PROOF_KERNEL_TYPING_DEPTH_LIMIT
            remaining: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND - depth
            return proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, root, depth, remaining, work)

        def proof_kernel_replay_term_sort_remaining(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, typing_index: ProofKernelReplayTypingIndex, root: usize, depth: usize, remaining: usize, work: mutable usize&) -> ProofKernelInferredSort:
            requires depth <= PROOF_KERNEL_TYPING_DEPTH_LIMIT
            requires remaining > 0
            decreases remaining
            return proof_kernel_replay_unknown_sort() if:
                depth >= PROOF_KERNEL_TYPING_DEPTH_LIMIT or root >= nodes.count
                not proof_kernel_replay_type_work_consume(work)
                not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "typed-int":
                return proof_kernel_replay_unknown_sort() if not ElisaProofKernelCore::typed_literal_value(node).known
                return proof_kernel_replay_known_sort("integer", node.name)
            if node.kind == "int":
                return proof_kernel_replay_known_sort("integer", node.operator) if proof_kernel_replay_int_tagged(node)
                return proof_kernel_replay_known_sort("integer", "i64")
            if node.kind == "float":
                return proof_kernel_replay_known_sort("floating", "f64")
            if node.kind == "opaque-float-literal":
                return proof_kernel_replay_known_sort("opaque-floating-literal", node.name)
            if node.kind == "char":
                return proof_kernel_replay_known_sort("character", "char")
            if node.kind == "bool":
                return proof_kernel_replay_known_sort("boolean", "bool")
            if node.kind == "string":
                return proof_kernel_replay_known_sort("string", "cstr")
            if node.kind == "ident":
                # `null` is a polymorphic sentinel, not a general value binding. Comparison
                # formation below admits it only against a declared nullable pointer sort.
                return proof_kernel_replay_known_sort("null", "null") if node.name == "null"
                value: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_value_binding(environment, typing_index, node.name, work)
                return proof_kernel_replay_binding_sort(value.binding) if value.known
                return proof_kernel_replay_unknown_sort()
            if node.kind == "scope":
                enum_member: (is_enum_path: bool, sort: ProofKernelInferredSort) = proof_kernel_replay_qualified_enum_member_sort(nodes, environment, typing_index, root, work)
                return enum_member.sort if enum_member.is_enum_path
                owner_identity: usize = proof_kernel_replay_scope_owner_identity(nodes, environment, typing_index.owner_path_index, node.left, work)
                return proof_kernel_replay_unknown_sort() if owner_identity == 0
                owned: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_owned_value_binding(environment, typing_index, node.name, owner_identity, work)
                return proof_kernel_replay_binding_sort(owned.binding) if owned.known
                return proof_kernel_replay_unknown_sort()
            # Every leaf returned above; a compound term needs one more level of budget. A bare
            # guard keeps the fact visible to the bootstrap compiler's precondition checker.
            return proof_kernel_replay_unknown_sort() if remaining <= 1
            if node.kind == "shorthand":
                return proof_kernel_replay_enum_member_sort(environment, typing_index, node.name, work)
            if node.kind == "call":
                callee_name: sview = proof_kernel_replay_symbol_name(nodes, node.left, 0, work)
                if callee_name == "old" and node.children_count == 1:
                    argument_wrapper: usize = proof_kernel_replay_child_root(nodes.count, children, node, 0)
                    return proof_kernel_replay_unknown_sort() if argument_wrapper >= nodes.count
                    return proof_kernel_replay_unknown_sort() if nodes[argument_wrapper].kind != "call_arg"
                    return proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, nodes[argument_wrapper].left, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if:
                    depth >= PROOF_KERNEL_CALL_DEPTH_PRECONDITION
                    node.left >= nodes.count
                callee: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                if callee.kind == "field" and node.children_count == 0:
                    target: ProofKernelInferredSort = proof_kernel_replay_primitive_numeric_sort(callee.name)
                    receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, callee.left, depth + 1, remaining - 1, work)
                    return target if target.known and proof_kernel_replay_numeric_sort(receiver) and proof_kernel_replay_numeric_sort(target) and proof_kernel_replay_builtin_cast_dispatch_absent(environment, typing_index, receiver, target, work)
                    receiver_member: (is_enum_path: bool, sort: ProofKernelInferredSort) = proof_kernel_replay_qualified_enum_member_sort(nodes, environment, typing_index, callee.left, work)
                    if receiver_member.is_enum_path and target.known and proof_kernel_replay_numeric_sort(target):
                        enum_backing: ProofKernelInferredSort = proof_kernel_replay_const_enum_underlying_sort(environment, typing_index, receiver_member.sort, work)
                        return target if enum_backing.known and enum_backing.family == "integer" and proof_kernel_replay_type_text_equal(enum_backing.name, target.name, work) and proof_kernel_replay_builtin_cast_dispatch_absent(environment, typing_index, receiver_member.sort, target, work)
                    return proof_kernel_replay_unknown_sort()
                callee_owner: (known: bool, identity: usize) = proof_kernel_replay_call_owner_identity(nodes, environment, typing_index, node.left, 0, work)
                return proof_kernel_replay_unknown_sort() if not callee_owner.known
                return proof_kernel_replay_call_result_sort_remaining(nodes, children, environment, typing_index, node, callee_name, callee_owner.identity, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort()
            if node.kind == "construct":
                type_name_root: usize = proof_kernel_replay_symbol_name_root(nodes, node.left, depth + 1, work)
                declared_type: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_type_binding_for_symbol(nodes, environment, typing_index, type_name_root, work)
                return proof_kernel_replay_unknown_sort() if not declared_type.known
                for offset in 0..<node.children_count |offset, nodes, children, environment, node, declared_type, depth, remaining, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    field_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, offset)
                    return proof_kernel_replay_unknown_sort() if field_root >= nodes.count
                    return proof_kernel_replay_unknown_sort() if nodes[field_root].kind != "field-init"
                    field_node: ElisaProofKernelCore::ProofKernelNode = nodes[field_root]
                    declared_field: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, typing_index, "field", field_node.name, declared_type.binding.name, declared_type.binding.type_identity, true, 0, "", work)
                    return proof_kernel_replay_unknown_sort() if not declared_field.known
                    actual_field: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, field_node.left, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_sort_equal(actual_field, proof_kernel_replay_binding_sort(declared_field.binding), work)
                    for prior_offset in 0..<offset |prior_offset, children, node, nodes, field_node, work|:
                        return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                        prior_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, prior_offset)
                        return proof_kernel_replay_unknown_sort() if:
                            prior_root >= nodes.count
                        return proof_kernel_replay_unknown_sort() if:
                            nodes[prior_root].kind != "field-init"
                            proof_kernel_replay_type_text_equal(nodes[prior_root].name, field_node.name, work)
                return proof_kernel_replay_binding_sort(declared_type.binding)
            if node.kind == "record-update":
                base: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if not base.known or base.family != "named" or base.type_identity == 0
                declared_type: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, typing_index, "type", base.name, "", 0, true, 0, "", work)
                return proof_kernel_replay_unknown_sort() if:
                    not declared_type.known or declared_type.binding.sort != "named" or not proof_kernel_replay_type_text_equal(declared_type.binding.type_name, base.name, work) or declared_type.binding.type_identity != base.type_identity
                    not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for offset in 0..<node.children_count |offset, nodes, children, environment, node, base, depth, remaining, work|:
                    return proof_kernel_replay_unknown_sort() if:
                        not proof_kernel_replay_type_work_consume(work)
                        not proof_kernel_replay_record_update_field_valid_remaining(nodes, children, environment, typing_index, node, base, offset, depth + 1, remaining - 1, work)
                return base
            if node.kind == "field":
                enum_member: (is_enum_path: bool, sort: ProofKernelInferredSort) = proof_kernel_replay_qualified_enum_member_sort(nodes, environment, typing_index, root, work)
                return enum_member.sort if enum_member.is_enum_path
                receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                return proof_kernel_replay_known_sort("integer", "usize") if:
                    receiver.known and receiver.family == "container" and node.name == "count"
                    receiver.known and receiver.family == "string" and node.name == "count"
                return proof_kernel_replay_unknown_sort() if not receiver.known
                # A nullable pointer carries only identity/null observations in the admitted
                # source subset. Do not project through it without a non-null refinement.
                # The typing environment has no path-sensitive null refinement, so fail closed.
                return proof_kernel_replay_unknown_sort() if receiver.family in {"nullable-reference", "nullable-opaque-reference"}
                field: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, typing_index, "field", node.name, receiver.name, receiver.type_identity, true, 0, "", work)
                return proof_kernel_replay_binding_sort(field.binding) if field.known
                return proof_kernel_replay_unknown_sort()
            if node.kind == "index":
                receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                index: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.right, depth + 1, remaining - 1, work)
                return proof_kernel_replay_index_or_scalar_reference_sort(nodes, environment, typing_index, receiver, node.left, node.right, depth + 1, work) if index.known and proof_kernel_replay_integral_sort(index)
                return proof_kernel_replay_unknown_sort()
            if node.kind == "index-n":
                return proof_kernel_replay_unknown_sort() if node.children_count == 0
                current: mutable ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if not current.known
                for offset in 0..<node.children_count |offset, nodes, children, environment, node, depth, remaining, current, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    index_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, offset)
                    return proof_kernel_replay_unknown_sort() if index_root >= nodes.count
                    index_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, index_root, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if not index_sort.known or not proof_kernel_replay_integral_sort(index_sort)
                    current <- proof_kernel_replay_index_element_sort(current, environment, typing_index, work)
                    return proof_kernel_replay_unknown_sort() if not current.known
                return current
            if node.kind == "slice":
                receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                low: mutable ProofKernelInferredSort = proof_kernel_replay_known_sort("integer", "usize")
                high: mutable ProofKernelInferredSort = proof_kernel_replay_known_sort("integer", "usize")
                if node.right < nodes.count:
                    if nodes[node.right].kind != "absent":
                        low <- proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.right, depth + 1, remaining - 1, work)
                if node.auxiliary < nodes.count:
                    if nodes[node.auxiliary].kind != "absent":
                        high <- proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.auxiliary, depth + 1, remaining - 1, work)
                return proof_kernel_replay_known_sort("string", "sview") if receiver.known and receiver.family == "string" and low.known and proof_kernel_replay_integral_sort(low) and high.known and proof_kernel_replay_integral_sort(high)
                return proof_kernel_replay_container_identity_sort("view", receiver.element_family, receiver.element_name, receiver.element_type_identity) if receiver.known and receiver.family == "container" and low.known and proof_kernel_replay_integral_sort(low) and high.known and proof_kernel_replay_integral_sort(high) and receiver.element_type_identity != 0
                return proof_kernel_replay_container_sort("view", receiver.element_family, receiver.element_name) if receiver.known and receiver.family == "container" and low.known and proof_kernel_replay_integral_sort(low) and high.known and proof_kernel_replay_integral_sort(high) and receiver.element_type_identity == 0
                return proof_kernel_replay_unknown_sort()
            if node.kind in {"checked-index", "checked-get"}:
                return proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
            if node.kind == "unary":
                operand: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                if node.operator == "not":
                    return proof_kernel_replay_known_sort("boolean", "bool") if operand.known and (operand.family in {"boolean", "proposition"})
                    return proof_kernel_replay_unknown_sort()
                # Borrow expressions are reference values, not terms of the pointee sort.
                # Call matching strips a single borrow through its dedicated argument path.
                return operand if:
                    operand.known and proof_kernel_replay_numeric_sort(operand) and (node.operator in {"+", "-"})
                    operand.known and proof_kernel_replay_integral_sort(operand) and node.operator == "~"
                return proof_kernel_replay_unknown_sort()
            if node.kind == "binary":
                left: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                right: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.right, depth + 1, remaining - 1, work)
                if node.operator in {"and", "or", "=>"}:
                    return proof_kernel_replay_known_sort("boolean", "bool") if left.known and right.known and (left.family in {"boolean", "proposition"}) and (right.family in {"boolean", "proposition"})
                    return proof_kernel_replay_unknown_sort()
                if node.operator in {"==", "!=", "<", ">", "<=", ">=", "in", "is"}:
                    if node.operator in {"==", "!=", "<", ">", "<=", ">="}:
                        left_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                        right_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, node.right, depth + 1, remaining - 1, work)
                        if node.operator in {"==", "!="}:
                            # The backend uses address identity only when both operands are
                            # references. A single Ref auto-dereferences against a value operand.
                            return proof_kernel_replay_unknown_sort() if left_reference.known and left_reference.is_reference and right_reference.known and right_reference.is_reference
                        return proof_kernel_replay_unknown_sort() if left_reference.known and left_reference.is_reference and right_reference.known and right_reference.is_reference
                    return proof_kernel_replay_known_sort("boolean", "bool") if proof_kernel_replay_comparison_sorts_valid(nodes, environment, typing_index, node, left, right, work)
                    return proof_kernel_replay_unknown_sort()
                if node.operator in {"|", "^", "&", "<<", ">>"}:
                    return left if left.known and right.known and proof_kernel_replay_integral_sort(left) and proof_kernel_replay_integral_sort(right)
                    return proof_kernel_replay_unknown_sort()
                # `range_*` is meaningful only as a quantifier domain, where the dedicated range
                # checker above validates its bounds. `as` needs a type-target representation that
                # the source-neutral term arena does not carry, and a raw `else` is only valid when
                # it has been lowered to checked-index/checked-get. Never reinterpret any of these
                # nodes as ordinary arithmetic merely because both children are numeric.
                if node.operator in {"+", "-"}:
                    raw_pointer_shape: (known: bool, raw_pointer: bool) = proof_kernel_replay_raw_pointer_reference_shape_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if:
                        not raw_pointer_shape.known or raw_pointer_shape.raw_pointer
                        proof_kernel_replay_byte_pointer_reference_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                return left if (node.operator in {"+", "-", "*", "/", "%"}) and left.known and right.known and proof_kernel_replay_numeric_sort(left) and proof_kernel_replay_numeric_sort(right)
                return proof_kernel_replay_unknown_sort()
            if node.kind == "if":
                condition: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.left, depth + 1, remaining - 1, work)
                then_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.right, depth + 1, remaining - 1, work)
                else_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, node.auxiliary, depth + 1, remaining - 1, work)
                return proof_kernel_replay_conditional_branch_sort(nodes, node.right, node.auxiliary, then_sort, else_sort, work) if condition.known and (condition.family in {"boolean", "proposition"})
                return proof_kernel_replay_unknown_sort()
            if node.kind in {"array", "tuple"}:
                return proof_kernel_replay_unknown_sort() if node.children_count == 0
                first_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, 0)
                first_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, first_root, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if not first_reference.known or first_reference.is_reference
                element: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, first_root, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if not element.known
                for offset in 1..<node.children_count |offset, nodes, children, environment, node, depth, remaining, element, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    child_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, offset)
                    child_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, child_root, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if not child_reference.known or child_reference.is_reference
                    child_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, child_root, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if:
                        not child_sort.known
                        node.kind == "array" and not proof_kernel_replay_sort_equal(element, child_sort, work)
                return proof_kernel_replay_container_identity_sort(node.kind, element.family, element.name, element.type_identity) if element.known and element.type_identity != 0
                return proof_kernel_replay_container_sort(node.kind, element.family, element.name) if element.known and element.type_identity == 0
                return proof_kernel_replay_unknown_sort()
            if node.kind == "set":
                return proof_kernel_replay_unknown_sort() if node.children_count == 0
                first_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, 0)
                first_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, first_root, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if not first_reference.known or first_reference.is_reference
                element: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, first_root, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if not element.known
                for offset in 1..<node.children_count |offset, nodes, children, environment, node, depth, remaining, element, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    child_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, offset)
                    child_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, child_root, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if not child_reference.known or child_reference.is_reference
                    child_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, child_root, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_sort_equal(element, child_sort, work)
                return proof_kernel_replay_container_identity_sort("set", element.family, element.name, element.type_identity) if element.type_identity != 0
                return proof_kernel_replay_container_sort("set", element.family, element.name)
            if node.kind == "dict":
                return proof_kernel_replay_unknown_sort() if node.children_count == 0
                first_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, 0)
                return proof_kernel_replay_unknown_sort() if first_root >= nodes.count
                return proof_kernel_replay_unknown_sort() if nodes[first_root].kind != "dict_entry"
                first_key_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, nodes[first_root].left, depth + 1, remaining - 1, work)
                first_value_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, nodes[first_root].right, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if not first_key_reference.known or first_key_reference.is_reference or not first_value_reference.known or first_value_reference.is_reference
                key_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, nodes[first_root].left, depth + 1, remaining - 1, work)
                value_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, nodes[first_root].right, depth + 1, remaining - 1, work)
                return proof_kernel_replay_unknown_sort() if not key_sort.known or not value_sort.known
                for offset in 1..<node.children_count |offset, nodes, children, environment, node, depth, remaining, key_sort, value_sort, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    entry_root: usize = proof_kernel_replay_child_root(nodes.count, children, node, offset)
                    return proof_kernel_replay_unknown_sort() if entry_root >= nodes.count
                    return proof_kernel_replay_unknown_sort() if nodes[entry_root].kind != "dict_entry"
                    next_key_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, nodes[entry_root].left, depth + 1, remaining - 1, work)
                    next_value_reference: (known: bool, is_reference: bool) = proof_kernel_replay_argument_is_reference_remaining(nodes, children, environment, typing_index, nodes[entry_root].right, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if not next_key_reference.known or next_key_reference.is_reference or not next_value_reference.known or next_value_reference.is_reference
                    next_key_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, nodes[entry_root].left, depth + 1, remaining - 1, work)
                    next_value_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort_remaining(nodes, children, environment, typing_index, nodes[entry_root].right, depth + 1, remaining - 1, work)
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_sort_equal(key_sort, next_key_sort, work) or not proof_kernel_replay_sort_equal(value_sort, next_value_sort, work)
                return proof_kernel_replay_container_identity_sort("dict", value_sort.family, value_sort.name, value_sort.type_identity) if value_sort.type_identity != 0
                return proof_kernel_replay_container_sort("dict", value_sort.family, value_sort.name)
            if node.kind == "quantifier":
                # Quantifiers are propositions, not ordinary value terms. Their type checking
                # lives in the proposition walker below so term-sort inference stays acyclic.
                return proof_kernel_replay_unknown_sort()
            return proof_kernel_replay_unknown_sort()
