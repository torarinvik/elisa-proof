# Minimal source-neutral typing for logical proposition formation. The environment contains
# declaration signatures only; it is kept separate from facts/hypotheses and never treats an
# arbitrary term-root tag as type evidence.
extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_TYPING_DEPTH_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
        # These entry points consume different amounts of recursive headroom before they
        # descend into a callee or argument. Derive every threshold from the one replay limit;
        # independent literals here could silently widen one typing path past the kernel bound.
        const PROOF_KERNEL_ARGUMENT_DEPTH_PRECONDITION: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 2
        const PROOF_KERNEL_ARGUMENT_DEPTH_GUARD: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 1
        const PROOF_KERNEL_FUNCTION_DEPTH_PRECONDITION: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 3
        const PROOF_KERNEL_CALL_DEPTH_PRECONDITION: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 5
        const PROOF_KERNEL_CALL_DEPTH_GUARD: usize = PROOF_KERNEL_TYPING_DEPTH_LIMIT - 4

        struct ProofKernelInferredSort:
            known: bool
            family: sview
            name: sview
            element_family: sview
            element_name: sview
            type_identity: usize
            element_type_identity: usize

        def proof_kernel_replay_type_work_consume(work: mutable usize&) -> bool:
            if work >= ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET:
                work <- ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET + 1
                return false
            work <- work + 1
            return true

        def proof_kernel_replay_unknown_sort() -> ProofKernelInferredSort:
            return ProofKernelInferredSort{known: false, family: "", name: "", element_family: "", element_name: "", type_identity: 0, element_type_identity: 0}

        def proof_kernel_replay_known_sort(family: sview, name: sview) -> ProofKernelInferredSort:
            return ProofKernelInferredSort{known: family != "", family: family, name: name, element_family: "", element_name: "", type_identity: 0, element_type_identity: 0}

        def proof_kernel_replay_identity_sort(family: sview, name: sview, identity: usize) -> ProofKernelInferredSort:
            return ProofKernelInferredSort{known: family != "" and identity != 0, family: family, name: name, element_family: "", element_name: "", type_identity: identity, element_type_identity: 0}

        def proof_kernel_replay_required_identity_present(identity_required: bool, identity: usize) -> bool:
            ensure not result or not identity_required or identity != 0
            if identity_required:
                if identity != 0:
                    return true
                return false
            return identity == 0

        def proof_kernel_replay_container_element_identity_valid(element_family: sview, element_name: sview, element_identity: usize) -> bool:
            identity_required: bool = element_family == "named" or element_family == "container" or (element_family == "aggregate" and element_name == "tuple")
            return element_family != "" and proof_kernel_replay_required_identity_present(identity_required, element_identity)

        def proof_kernel_replay_container_sort(name: sview, element_family: sview, element_name: sview) -> ProofKernelInferredSort:
            valid_element: bool = proof_kernel_replay_container_element_identity_valid(element_family, element_name, 0)
            return ProofKernelInferredSort{known: name != "" and valid_element, family: "container", name: name, element_family: element_family, element_name: element_name, type_identity: 0, element_type_identity: 0}

        def proof_kernel_replay_container_identity_sort(name: sview, element_family: sview, element_name: sview, element_identity: usize) -> ProofKernelInferredSort:
            valid_element: bool = proof_kernel_replay_container_element_identity_valid(element_family, element_name, element_identity)
            return ProofKernelInferredSort{known: name != "" and valid_element, family: "container", name: name, element_family: element_family, element_name: element_name, type_identity: 0, element_type_identity: element_identity}

        def proof_kernel_replay_numeric_sort(sort: ProofKernelInferredSort) -> bool:
            return sort.family == "integer" or sort.family == "floating" or sort.family == "character"

        def proof_kernel_replay_integral_sort(sort: ProofKernelInferredSort) -> bool:
            return sort.family == "integer"

        def proof_kernel_replay_sort_equal(left: ProofKernelInferredSort, right: ProofKernelInferredSort) -> bool:
            return false if not left.known or not right.known or left.family != right.family
            return left.name == right.name and left.element_family == right.element_family and left.element_name == right.element_name and left.element_type_identity == right.element_type_identity if left.family == "container"
            return left.name == right.name and left.element_family == right.element_family and left.element_name == right.element_name and left.type_identity == right.type_identity and left.element_type_identity == right.element_type_identity

        def proof_kernel_replay_binding_sort(binding: ElisaProofKernelCore::ProofKernelTypingBinding) -> ProofKernelInferredSort:
            return ProofKernelInferredSort{known: binding.type_name != "" and binding.element_sort != "", family: "container", name: binding.type_name, element_family: binding.element_sort, element_name: binding.element_type_name, type_identity: binding.type_identity, element_type_identity: binding.element_type_identity} if binding.sort == "container"
            return proof_kernel_replay_identity_sort(binding.sort, binding.type_name, binding.type_identity) if binding.type_identity != 0
            return proof_kernel_replay_known_sort(binding.sort, binding.type_name)

        def proof_kernel_replay_typing_evidence_equal(left: ElisaProofKernelCore::ProofKernelTypingBinding, right: ElisaProofKernelCore::ProofKernelTypingBinding) -> bool:
            return left.kind == right.kind and left.name == right.name and left.owner == right.owner and left.sort == right.sort and left.type_name == right.type_name and left.element_sort == right.element_sort and left.element_type_name == right.element_type_name and left.type_identity == right.type_identity and left.owner_type_identity == right.owner_type_identity and left.element_type_identity == right.element_type_identity and left.signature_identity == right.signature_identity and left.parameter_index == right.parameter_index and left.parameter_count == right.parameter_count and left.parameter_has_default == right.parameter_has_default and left.parameter_by_reference == right.parameter_by_reference

        def proof_kernel_replay_find_typing_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, kind: sview, name: sview, owner: sview, owner_type_identity: usize, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, kind, name, owner, owner_type_identity, found, ambiguous, selected, work|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if binding.kind != kind or binding.name != name or binding.owner != owner or binding.owner_type_identity != owner_type_identity
                if not found:
                    selected <- binding
                    found <- true
                elif not proof_kernel_replay_typing_evidence_equal(selected, binding):
                    ambiguous <- true
            return (found and not ambiguous, selected)

        def proof_kernel_replay_find_value_binding(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, index: ProofKernelReplayValueIndex, name: sview, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            return (false, selected) if index.source_binding_count != proof_kernel_replay_type_environment_binding_count(environment) or index.binding_count > index.binding_indices.count
            for value_offset in 0..<index.binding_count |value_offset, environment, index, name, found, ambiguous, selected, work|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding_index: usize = index.binding_indices[value_offset]
                return (false, selected) if binding_index >= index.source_binding_count
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, binding_index)
                if binding.name == name:
                    if not found:
                        selected <- binding
                        found <- true
                    elif not proof_kernel_replay_typing_evidence_equal(selected, binding):
                        ambiguous <- true
            return (found and not ambiguous, selected)

        def proof_kernel_replay_symbol_name(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize, work: mutable usize&) -> sview:
            return "" if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or root >= nodes.count
            return "" if not proof_kernel_replay_type_work_consume(work)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return node.name if node.kind == "ident" or node.kind == "scope"
            return proof_kernel_replay_symbol_name(nodes, node.left, depth + 1, work) if node.kind == "paren"
            return ""

        def proof_kernel_replay_child_root(children: darray[usize]&, node: ElisaProofKernelCore::ProofKernelNode, offset: usize) -> usize:
            return children[node.children_start + offset] if offset < node.children_count and node.children_start <= children.count and offset < children.count - node.children_start
            return children.count

        def proof_kernel_replay_container_descriptor_matches(binding: ElisaProofKernelCore::ProofKernelTypingBinding, name: sview, identity: usize) -> bool:
            return false if binding.kind != "type"
            return false if binding.sort != "container"
            return false if binding.name != name
            return false if binding.type_identity != identity
            assert binding.kind == "type"
            assert binding.sort == "container"
            assert binding.name == name
            assert binding.type_identity == identity
            return true

        def proof_kernel_replay_container_descriptor(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, name: sview, identity: usize, work: mutable usize&) -> (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding):
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, name, identity, found, ambiguous, selected, work|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if binding.kind != "type" or binding.sort != "container" or binding.name != name or binding.type_identity != identity
                if not found:
                    selected <- binding
                    found <- true
                elif selected.element_sort != binding.element_sort or selected.element_type_name != binding.element_type_name or selected.element_type_identity != binding.element_type_identity:
                    ambiguous <- true
            selected_matches_query: bool = proof_kernel_replay_container_descriptor_matches(selected, name, identity)
            return (found and not ambiguous and selected_matches_query, selected)

        def proof_kernel_replay_index_element_sort(receiver: ProofKernelInferredSort, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, work: mutable usize&) -> ProofKernelInferredSort:
            return proof_kernel_replay_unknown_sort() if not receiver.known or receiver.family != "container"
            if receiver.type_identity != 0:
                descriptor: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_container_descriptor(environment, receiver.name, receiver.type_identity, work)
                return proof_kernel_replay_unknown_sort() if not descriptor.known or descriptor.binding.sort != "container"
                return proof_kernel_replay_identity_sort(descriptor.binding.element_sort, descriptor.binding.element_type_name, descriptor.binding.element_type_identity) if descriptor.binding.element_type_identity != 0
                return proof_kernel_replay_known_sort(descriptor.binding.element_sort, descriptor.binding.element_type_name)
            return proof_kernel_replay_identity_sort(receiver.element_family, receiver.element_name, receiver.element_type_identity) if receiver.element_type_identity != 0
            return proof_kernel_replay_known_sort(receiver.element_family, receiver.element_name)

        def proof_kernel_replay_enum_member_sort(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, name: sview, work: mutable usize&) -> ProofKernelInferredSort:
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, name, found, ambiguous, selected, work|:
                return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if binding.kind != "enum-member" or binding.name != name
                if not found:
                    selected <- binding
                    found <- true
                elif selected.owner != binding.owner or selected.owner_type_identity != binding.owner_type_identity or selected.type_identity != binding.type_identity:
                    ambiguous <- true
            return proof_kernel_replay_binding_sort(selected) if found and not ambiguous
            return proof_kernel_replay_unknown_sort()

        def proof_kernel_replay_element_sort(binding: ElisaProofKernelCore::ProofKernelTypingBinding) -> ProofKernelInferredSort:
            return proof_kernel_replay_identity_sort(binding.element_sort, binding.element_type_name, binding.element_type_identity) if binding.element_type_identity != 0
            return proof_kernel_replay_known_sort(binding.element_sort, binding.element_type_name)

        def proof_kernel_replay_argument_matches_parameter(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, value_index: ProofKernelReplayValueIndex, argument_root: usize, parameter: ElisaProofKernelCore::ProofKernelTypingBinding, depth: usize, work: mutable usize&) -> bool:
            requires depth <= PROOF_KERNEL_ARGUMENT_DEPTH_PRECONDITION
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND - depth
            return false if argument_root >= nodes.count or depth >= PROOF_KERNEL_ARGUMENT_DEPTH_GUARD
            return false if not proof_kernel_replay_type_work_consume(work)
            expected: ProofKernelInferredSort = proof_kernel_replay_binding_sort(parameter)
            argument: ElisaProofKernelCore::ProofKernelNode = nodes[argument_root]
            reference_argument: bool = argument.kind == "unary" and argument.operator == "&"
            # A bare local can already denote a reference formal, so source-neutral terms cannot
            # distinguish an explicit borrow from forwarding that reference. The compiler-checked
            # source adapter establishes borrow/lvalue legality; this kernel checks the value sort.
            return false if reference_argument and not parameter.parameter_by_reference
            value_root: usize = argument.left if reference_argument else argument_root
            return false if value_root >= nodes.count
            value_argument: ElisaProofKernelCore::ProofKernelNode = nodes[value_root]
            actual: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, value_root, depth + 1, work)
            return true if actual.known and proof_kernel_replay_sort_equal(actual, expected)
            string_literal_adapts: bool = not parameter.parameter_by_reference and value_argument.kind == "string" and actual.family == "string" and expected.family == "string" and (expected.name == "cstr" or expected.name == "dstr" or expected.name == "sview")
            return true if actual.known and expected.known and string_literal_adapts
            numeric_conversion: bool = (actual.family == "integer" or actual.family == "floating") and (expected.family == "integer" or expected.family == "floating")
            return true if actual.known and expected.known and numeric_conversion
            if value_argument.kind == "array" or value_argument.kind == "set":
                return false if expected.family != "container"
                return false if value_argument.kind == "array" and expected.name != "array" and expected.name != "darray"
                return false if value_argument.kind == "set" and expected.name != "set"
                return false if parameter.element_sort == "container"
                return false if parameter.element_sort == "aggregate" and parameter.element_type_name == "tuple"
                return true if value_argument.children_count == 0 and parameter.element_sort != ""
                return false if not actual.known or actual.family != "container"
                expected_element: ProofKernelInferredSort = proof_kernel_replay_element_sort(parameter)
                actual_element: ProofKernelInferredSort = ProofKernelInferredSort{known: actual.element_family != "", family: actual.element_family, name: actual.element_name, element_family: "", element_name: "", type_identity: actual.element_type_identity, element_type_identity: 0}
                return proof_kernel_replay_sort_equal(actual_element, expected_element)
            return false

        def proof_kernel_replay_find_function_parameter_by_index(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, function: ElisaProofKernelCore::ProofKernelTypingBinding, requested_index: usize, work: mutable usize&) -> (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding):
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, function, requested_index, found, ambiguous, selected, work|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if binding.kind != "function-parameter" or binding.owner != function.name or binding.signature_identity != function.signature_identity or binding.parameter_index != requested_index
                if found:
                    ambiguous <- true
                else:
                    selected <- binding
                    found <- true
            return (found and not ambiguous, selected)

        def proof_kernel_replay_find_function_parameter_by_name(environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, function: ElisaProofKernelCore::ProofKernelTypingBinding, requested_name: sview, work: mutable usize&) -> (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding):
            found: mutable bool = false
            ambiguous: mutable bool = false
            selected: mutable ElisaProofKernelCore::ProofKernelTypingBinding = ElisaProofKernelCore::ProofKernelTypingBinding{kind: "", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: 0, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false}
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, environment, function, requested_name, found, ambiguous, selected, work|:
                return (false, selected) if not proof_kernel_replay_type_work_consume(work)
                binding: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if binding.kind != "function-parameter" or binding.owner != function.name or binding.signature_identity != function.signature_identity or binding.name != requested_name
                if found:
                    ambiguous <- true
                else:
                    selected <- binding
                    found <- true
            return (found and not ambiguous, selected)

        def proof_kernel_replay_function_arguments_well_typed(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, value_index: ProofKernelReplayValueIndex, function: ElisaProofKernelCore::ProofKernelTypingBinding, call: ElisaProofKernelCore::ProofKernelNode, depth: usize, work: mutable usize&) -> bool:
            requires depth <= PROOF_KERNEL_FUNCTION_DEPTH_PRECONDITION
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND - depth
            ensure result => call.children_count <= function.parameter_count
            return false if function.parameter_count > PROOF_KERNEL_MAX_TYPED_FUNCTION_PARAMETERS or call.children_count > function.parameter_count
            return false if not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count)
            return false if not proof_kernel_replay_type_work_consume(work)
            has_named: mutable bool = false
            has_positional: mutable bool = false
            for offset in 0..<call.children_count |offset, nodes, children, call, has_named, has_positional, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                wrapper: usize = proof_kernel_replay_child_root(children, call, offset)
                return false if wrapper >= nodes.count or nodes[wrapper].kind != "call_arg"
                has_named <- true if nodes[wrapper].name != ""
                has_positional <- true if nodes[wrapper].name == ""
            return false if has_named and has_positional
            for offset in 0..<call.children_count |offset, nodes, children, environment, function, call, depth, has_named, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                argument_wrapper: usize = proof_kernel_replay_child_root(children, call, offset)
                return false if argument_wrapper >= nodes.count or nodes[argument_wrapper].kind != "call_arg"
                argument: ElisaProofKernelCore::ProofKernelNode = nodes[argument_wrapper]
                indexed_parameter: (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_function_parameter_by_index(environment, function, offset, work)
                parameter_known: mutable bool = indexed_parameter.known
                parameter_binding: mutable ElisaProofKernelCore::ProofKernelTypingBinding = indexed_parameter.parameter
                if argument.name != "":
                    named_parameter: (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_function_parameter_by_name(environment, function, argument.name, work)
                    parameter_known <- named_parameter.known
                    parameter_binding <- named_parameter.parameter
                    return false if not parameter_known
                    for prior_offset in 0..<offset |prior_offset, nodes, children, call, argument, work|:
                        return false if not proof_kernel_replay_type_work_consume(work)
                        prior_wrapper: usize = proof_kernel_replay_child_root(children, call, prior_offset)
                        return false if prior_wrapper >= nodes.count
                        return false if nodes[prior_wrapper].name == argument.name
                return false if not parameter_known
                return false if not proof_kernel_replay_argument_matches_parameter(nodes, children, environment, value_index, argument.left, parameter_binding, depth + 1, work)
            for index in 0..<function.parameter_count |index, nodes, children, environment, function, call, has_named, work|:
                return false if not proof_kernel_replay_type_work_consume(work)
                parameter: (known: bool, parameter: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_function_parameter_by_index(environment, function, index, work)
                return false if not parameter.known
                if has_named:
                    supplied: mutable bool = false
                    for offset in 0..<call.children_count |offset, nodes, children, call, parameter, supplied, work|:
                        return false if not proof_kernel_replay_type_work_consume(work)
                        wrapper: usize = proof_kernel_replay_child_root(children, call, offset)
                        return false if wrapper >= nodes.count
                        supplied <- true if nodes[wrapper].name == parameter.parameter.name
                    return false if not supplied and not parameter.parameter.parameter_has_default
                else:
                    return false if index >= call.children_count and not parameter.parameter.parameter_has_default
            return true

        def proof_kernel_replay_call_result_sort(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, value_index: ProofKernelReplayValueIndex, call: ElisaProofKernelCore::ProofKernelNode, callee_name: sview, depth: usize, work: mutable usize&) -> ProofKernelInferredSort:
            requires depth <= PROOF_KERNEL_CALL_DEPTH_PRECONDITION
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND - depth
            selected: mutable ProofKernelInferredSort = proof_kernel_replay_unknown_sort()
            found: mutable bool = false
            name_seen: mutable bool = false
            ambiguous: mutable bool = false
            total_bindings: usize = proof_kernel_replay_type_environment_binding_count(environment)
            for index in 0..<total_bindings |index, nodes, children, environment, call, callee_name, depth, selected, found, name_seen, ambiguous, work|:
                return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                function: ElisaProofKernelCore::ProofKernelTypingBinding = proof_kernel_replay_type_environment_binding_at(environment, index)
                continue if function.kind != "function" or function.name != callee_name
                # The source-neutral call node retains only the leaf of a qualified callee. Once
                # two declarations share that leaf, the environment no longer identifies which
                # module member the source resolver selected. Reject the whole name, even when
                # the declarations happen to return the same sort or only one accepts the
                # supplied arguments; otherwise a qualified call can be admitted against the
                # wrong declaration with no diagnostic.
                if name_seen:
                    ambiguous <- true
                else:
                    name_seen <- true
                continue if depth >= PROOF_KERNEL_CALL_DEPTH_GUARD or not proof_kernel_replay_function_arguments_well_typed(nodes, children, environment, value_index, function, call, depth + 1, work)
                candidate: ProofKernelInferredSort = proof_kernel_replay_binding_sort(function)
                if not found:
                    selected <- candidate
                    found <- true
                elif not proof_kernel_replay_sort_equal(selected, candidate):
                    ambiguous <- true
            return proof_kernel_replay_unknown_sort() if work > ElisaProofKernelCore::PROOF_KERNEL_TYPE_WORK_BUDGET
            return selected if found and not ambiguous
            return proof_kernel_replay_unknown_sort()

        def proof_kernel_replay_primitive_numeric_sort(name: sview) -> ProofKernelInferredSort:
            if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "i128" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "u128" or name == "usize" or name == "isize" or name == "uintptr" or name == "int" or name == "uint" or name == "byte":
                return proof_kernel_replay_known_sort("integer", name)
            if name == "f16" or name == "f32" or name == "f64" or name == "float":
                return proof_kernel_replay_known_sort("floating", name)
            return proof_kernel_replay_known_sort("character", "char") if name == "char"
            return proof_kernel_replay_unknown_sort()

        def proof_kernel_replay_term_sort(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, environment: ElisaProofKernelCore::ProofKernelTypeEnvironment, value_index: ProofKernelReplayValueIndex, root: usize, depth: usize, work: mutable usize&) -> ProofKernelInferredSort:
            requires depth <= PROOF_KERNEL_TYPING_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND - depth
            return proof_kernel_replay_unknown_sort() if depth >= PROOF_KERNEL_TYPING_DEPTH_LIMIT or root >= nodes.count
            return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
            return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "int":
                return proof_kernel_replay_known_sort("integer", "i64")
            if node.kind == "float":
                return proof_kernel_replay_known_sort("floating", "f64")
            if node.kind == "char":
                return proof_kernel_replay_known_sort("character", "char")
            if node.kind == "bool":
                return proof_kernel_replay_known_sort("boolean", "bool")
            if node.kind == "string":
                return proof_kernel_replay_known_sort("string", "cstr")
            if node.kind == "ident" or node.kind == "scope":
                value: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_value_binding(environment, value_index, node.name, work)
                return proof_kernel_replay_binding_sort(value.binding) if value.known
                return proof_kernel_replay_unknown_sort()
            if node.kind == "shorthand":
                return proof_kernel_replay_enum_member_sort(environment, node.name, work)
            if node.kind == "call":
                callee_name: sview = proof_kernel_replay_symbol_name(nodes, node.left, 0, work)
                if callee_name == "old" and node.children_count == 1:
                    argument_wrapper: usize = proof_kernel_replay_child_root(children, node, 0)
                    return proof_kernel_replay_unknown_sort() if argument_wrapper >= nodes.count or nodes[argument_wrapper].kind != "call_arg"
                    return proof_kernel_replay_term_sort(nodes, children, environment, value_index, nodes[argument_wrapper].left, depth + 1, work)
                return proof_kernel_replay_unknown_sort() if depth >= PROOF_KERNEL_CALL_DEPTH_PRECONDITION
                return proof_kernel_replay_unknown_sort() if node.left >= nodes.count
                callee: ElisaProofKernelCore::ProofKernelNode = nodes[node.left]
                if callee.kind == "field" and node.children_count == 0:
                    receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, callee.left, depth + 1, work)
                    target: ProofKernelInferredSort = proof_kernel_replay_primitive_numeric_sort(callee.name)
                    return target if target.known and proof_kernel_replay_numeric_sort(receiver) and proof_kernel_replay_numeric_sort(target)
                    return proof_kernel_replay_unknown_sort()
                return proof_kernel_replay_call_result_sort(nodes, children, environment, value_index, node, callee_name, depth + 1, work)
                return proof_kernel_replay_unknown_sort()
            if node.kind == "construct":
                type_name: sview = proof_kernel_replay_symbol_name(nodes, node.left, depth + 1, work)
                declared_type: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "type", type_name, "", 0, work)
                return proof_kernel_replay_unknown_sort() if type_name == "" or not declared_type.known
                for offset in 0..<node.children_count |offset, nodes, children, environment, node, type_name, depth, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    field_root: usize = proof_kernel_replay_child_root(children, node, offset)
                    return proof_kernel_replay_unknown_sort() if field_root >= nodes.count or nodes[field_root].kind != "field-init"
                    field_node: ElisaProofKernelCore::ProofKernelNode = nodes[field_root]
                    declared_field: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "field", field_node.name, type_name, declared_type.binding.type_identity, work)
                    return proof_kernel_replay_unknown_sort() if not declared_field.known
                    actual_field: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, field_node.left, depth + 1, work)
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_sort_equal(actual_field, proof_kernel_replay_binding_sort(declared_field.binding))
                    for prior_offset in 0..<offset |prior_offset, children, node, nodes, field_node, work|:
                        return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                        prior_root: usize = proof_kernel_replay_child_root(children, node, prior_offset)
                        return proof_kernel_replay_unknown_sort() if prior_root >= nodes.count or nodes[prior_root].kind != "field-init"
                        return proof_kernel_replay_unknown_sort() if nodes[prior_root].name == field_node.name
                return proof_kernel_replay_binding_sort(declared_type.binding)
            if node.kind == "record-update":
                base: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
                return proof_kernel_replay_unknown_sort() if not base.known or base.family != "named" or base.type_identity == 0
                declared_type: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "type", base.name, "", 0, work)
                return proof_kernel_replay_unknown_sort() if not declared_type.known or declared_type.binding.sort != "named" or declared_type.binding.type_name != base.name or declared_type.binding.type_identity != base.type_identity
                return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for offset in 0..<node.children_count |offset, nodes, children, environment, node, base, depth, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_record_update_field_valid(nodes, children, environment, value_index, node, base, offset, depth + 1, work)
                return base
            if node.kind == "field":
                receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
                return proof_kernel_replay_known_sort("integer", "usize") if receiver.known and receiver.family == "container" and node.name == "count"
                return proof_kernel_replay_known_sort("integer", "usize") if receiver.known and receiver.family == "string" and node.name == "count"
                return proof_kernel_replay_unknown_sort() if not receiver.known
                field: (known: bool, binding: ElisaProofKernelCore::ProofKernelTypingBinding) = proof_kernel_replay_find_typing_binding(environment, "field", node.name, receiver.name, receiver.type_identity, work)
                return proof_kernel_replay_binding_sort(field.binding) if field.known
                return proof_kernel_replay_unknown_sort()
            if node.kind == "index":
                receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
                index: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.right, depth + 1, work)
                return proof_kernel_replay_index_element_sort(receiver, environment, work) if index.known and proof_kernel_replay_integral_sort(index)
                return proof_kernel_replay_unknown_sort()
            if node.kind == "index-n":
                return proof_kernel_replay_unknown_sort() if node.children_count == 0
                current: mutable ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
                return proof_kernel_replay_unknown_sort() if not current.known
                for offset in 0..<node.children_count |offset, nodes, children, environment, node, depth, current, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    index_root: usize = proof_kernel_replay_child_root(children, node, offset)
                    return proof_kernel_replay_unknown_sort() if index_root >= nodes.count
                    index_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, index_root, depth + 1, work)
                    return proof_kernel_replay_unknown_sort() if not index_sort.known or not proof_kernel_replay_integral_sort(index_sort)
                    current <- proof_kernel_replay_index_element_sort(current, environment, work)
                    return proof_kernel_replay_unknown_sort() if not current.known
                return current
            if node.kind == "slice":
                receiver: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
                low: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.right, depth + 1, work) if node.right < nodes.count and nodes[node.right].kind != "absent" else proof_kernel_replay_known_sort("integer", "usize")
                high: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.auxiliary, depth + 1, work) if node.auxiliary < nodes.count and nodes[node.auxiliary].kind != "absent" else proof_kernel_replay_known_sort("integer", "usize")
                return proof_kernel_replay_known_sort("string", "sview") if receiver.known and receiver.family == "string" and low.known and proof_kernel_replay_integral_sort(low) and high.known and proof_kernel_replay_integral_sort(high)
                return proof_kernel_replay_container_identity_sort("view", receiver.element_family, receiver.element_name, receiver.element_type_identity) if receiver.known and receiver.family == "container" and low.known and proof_kernel_replay_integral_sort(low) and high.known and proof_kernel_replay_integral_sort(high) and receiver.element_type_identity != 0
                return proof_kernel_replay_container_sort("view", receiver.element_family, receiver.element_name) if receiver.known and receiver.family == "container" and low.known and proof_kernel_replay_integral_sort(low) and high.known and proof_kernel_replay_integral_sort(high) and receiver.element_type_identity == 0
                return proof_kernel_replay_unknown_sort()
            if node.kind == "checked-index" or node.kind == "checked-get":
                return proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
            if node.kind == "unary":
                operand: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
                if node.operator == "not":
                    return proof_kernel_replay_known_sort("boolean", "bool") if operand.known and (operand.family == "boolean" or operand.family == "proposition")
                    return proof_kernel_replay_unknown_sort()
                return operand if operand.known and node.operator == "&"
                return operand if operand.known and proof_kernel_replay_numeric_sort(operand) and (node.operator == "+" or node.operator == "-")
                return operand if operand.known and proof_kernel_replay_integral_sort(operand) and node.operator == "~"
                return proof_kernel_replay_unknown_sort()
            if node.kind == "binary":
                left: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
                right: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.right, depth + 1, work)
                if node.operator == "and" or node.operator == "or" or node.operator == "=>":
                    return proof_kernel_replay_known_sort("boolean", "bool") if left.known and right.known and (left.family == "boolean" or left.family == "proposition") and (right.family == "boolean" or right.family == "proposition")
                    return proof_kernel_replay_unknown_sort()
                if node.operator == "==" or node.operator == "!=" or node.operator == "<" or node.operator == ">" or node.operator == "<=" or node.operator == ">=" or node.operator == "in" or node.operator == "is":
                    return proof_kernel_replay_known_sort("boolean", "bool") if proof_kernel_replay_comparison_sorts_valid(nodes, environment, node, left, right, work)
                    return proof_kernel_replay_unknown_sort()
                if node.operator == "|" or node.operator == "^" or node.operator == "&" or node.operator == "<<" or node.operator == ">>":
                    return left if left.known and right.known and proof_kernel_replay_integral_sort(left) and proof_kernel_replay_integral_sort(right)
                    return proof_kernel_replay_unknown_sort()
                # `range_*` is meaningful only as a quantifier domain, where the dedicated range
                # checker above validates its bounds. `as` needs a type-target representation that
                # the source-neutral term arena does not carry, and a raw `else` is only valid when
                # it has been lowered to checked-index/checked-get. Never reinterpret any of these
                # nodes as ordinary arithmetic merely because both children are numeric.
                return left if (node.operator == "+" or node.operator == "-" or node.operator == "*" or node.operator == "/" or node.operator == "%") and left.known and right.known and proof_kernel_replay_numeric_sort(left) and proof_kernel_replay_numeric_sort(right)
                return proof_kernel_replay_unknown_sort()
            if node.kind == "if":
                condition: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.left, depth + 1, work)
                then_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.right, depth + 1, work)
                else_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, node.auxiliary, depth + 1, work)
                return then_sort if condition.known and (condition.family == "boolean" or condition.family == "proposition") and proof_kernel_replay_sort_equal(then_sort, else_sort)
                return proof_kernel_replay_unknown_sort()
            if node.kind == "array" or node.kind == "tuple":
                return proof_kernel_replay_unknown_sort() if node.children_count == 0
                first_root: usize = proof_kernel_replay_child_root(children, node, 0)
                element: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, first_root, depth + 1, work)
                return proof_kernel_replay_unknown_sort() if not element.known
                for offset in 1..<node.children_count |offset, nodes, children, environment, node, depth, element, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    child_root: usize = proof_kernel_replay_child_root(children, node, offset)
                    child_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, child_root, depth + 1, work)
                    return proof_kernel_replay_unknown_sort() if not child_sort.known
                    return proof_kernel_replay_unknown_sort() if node.kind == "array" and not proof_kernel_replay_sort_equal(element, child_sort)
                return proof_kernel_replay_container_identity_sort(node.kind, element.family, element.name, element.type_identity) if element.known and element.type_identity != 0
                return proof_kernel_replay_container_sort(node.kind, element.family, element.name) if element.known and element.type_identity == 0
                return proof_kernel_replay_unknown_sort()
            if node.kind == "set":
                return proof_kernel_replay_unknown_sort() if node.children_count == 0
                first_root: usize = proof_kernel_replay_child_root(children, node, 0)
                element: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, first_root, depth + 1, work)
                return proof_kernel_replay_unknown_sort() if not element.known
                for offset in 1..<node.children_count |offset, nodes, children, environment, node, depth, element, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    child_root: usize = proof_kernel_replay_child_root(children, node, offset)
                    child_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, child_root, depth + 1, work)
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_sort_equal(element, child_sort)
                return proof_kernel_replay_container_identity_sort("set", element.family, element.name, element.type_identity) if element.type_identity != 0
                return proof_kernel_replay_container_sort("set", element.family, element.name)
            if node.kind == "dict":
                return proof_kernel_replay_unknown_sort() if node.children_count == 0
                first_root: usize = proof_kernel_replay_child_root(children, node, 0)
                return proof_kernel_replay_unknown_sort() if first_root >= nodes.count or nodes[first_root].kind != "dict_entry"
                key_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, nodes[first_root].left, depth + 1, work)
                value_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, nodes[first_root].right, depth + 1, work)
                return proof_kernel_replay_unknown_sort() if not key_sort.known or not value_sort.known
                for offset in 1..<node.children_count |offset, nodes, children, environment, node, depth, key_sort, value_sort, work|:
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_type_work_consume(work)
                    entry_root: usize = proof_kernel_replay_child_root(children, node, offset)
                    return proof_kernel_replay_unknown_sort() if entry_root >= nodes.count or nodes[entry_root].kind != "dict_entry"
                    next_key_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, nodes[entry_root].left, depth + 1, work)
                    next_value_sort: ProofKernelInferredSort = proof_kernel_replay_term_sort(nodes, children, environment, value_index, nodes[entry_root].right, depth + 1, work)
                    return proof_kernel_replay_unknown_sort() if not proof_kernel_replay_sort_equal(key_sort, next_key_sort) or not proof_kernel_replay_sort_equal(value_sort, next_value_sort)
                return proof_kernel_replay_container_identity_sort("dict", value_sort.family, value_sort.name, value_sort.type_identity) if value_sort.type_identity != 0
                return proof_kernel_replay_container_sort("dict", value_sort.family, value_sort.name)
            if node.kind == "quantifier":
                # Quantifiers are propositions, not ordinary value terms. Their type checking
                # lives in the proposition walker below so term-sort inference stays acyclic.
                return proof_kernel_replay_unknown_sort()
            return proof_kernel_replay_unknown_sort()
