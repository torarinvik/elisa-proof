extend ElisaProofKernelReplay:
    private:
        # Independent replay consumes only an exact primitive zero pin and
        # same-width named unsigned operands. No range premise is invented.
        def proof_kernel_replay_zero_subtraction_plan(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize) -> (known: bool, goal: usize):
            return (false, 0) if not proof_kernel_replay_valid(nodes, root)
            goal = nodes[root]
            return (false, 0) if goal.kind != "binary" or goal.operator != "==" or not proof_kernel_replay_arena_shape_valid(goal)
            for orientation in 0..<2 |orientation, goal, nodes, children, facts|:
                term: usize = goal.right if orientation == 0 else goal.left
                peer: usize = goal.left if orientation == 0 else goal.right
                continue if not proof_kernel_replay_valid(nodes, term) or not proof_kernel_replay_valid(nodes, peer)
                delta = nodes[term]
                continue if delta.kind != "binary" or delta.operator != "-" or not proof_kernel_replay_arena_shape_valid(delta)
                delta_left: usize = delta.left
                delta_right: usize = delta.right
                continue if not proof_kernel_replay_valid(nodes, delta_left) or not proof_kernel_replay_valid(nodes, delta_right)
                continue if nodes[delta_left].kind != "ident" or nodes[delta_right].kind != "ident"
                width: i64 = proof_kernel_replay_peer_unsigned_width(nodes, children, delta_left, facts)
                continue if width != 8 and width != 16 and width != 32 and width != 64
                continue if proof_kernel_replay_peer_unsigned_width(nodes, children, delta_right, facts) != width or not proof_kernel_replay_primitive_comparison(nodes, children, facts, peer, term)
                for fact_root in facts |fact_root, delta, peer, nodes, children, facts|:
                    continue if not proof_kernel_replay_valid(nodes, fact_root)
                    fact = nodes[fact_root]
                    continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                    fact_left: usize = fact.left
                    fact_right: usize = fact.right
                    continue if not proof_kernel_replay_valid(nodes, fact_left) or not proof_kernel_replay_valid(nodes, fact_right)
                    continue if not proof_kernel_replay_expr_equal(nodes, children, fact_left, delta_right, 0)
                    literal = nodes[fact_right]
                    continue if literal.kind != "int" or literal.value != 0 or not proof_kernel_replay_arena_shape_valid(literal)
                    continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, fact_left, fact_right)
                    rewritten: usize = ElisaProofKernelCore::add_node(nodes, "binary", "==", peer, delta_left, 0, 0, 0, 0, "", "")
                    return (true, rewritten)
            return (false, 0)

        def proof_kernel_replay_subtraction_alias_rewrite(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, term: usize, alias: usize, depth: usize, work: mutable usize&) -> usize:
            return nodes.count if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or work == 0 or not proof_kernel_replay_valid(nodes, root)
            work <- work - 1
            return alias if proof_kernel_replay_expr_equal(nodes, children, root, term, 0)
            node = nodes[root]
            return nodes.count if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "paren" or node.kind == "unary":
                a: usize = proof_kernel_replay_subtraction_alias_rewrite(nodes, children, node.left, term, alias, depth + 1, work)
                return nodes.count if not proof_kernel_replay_valid(nodes, a)
                return root if a == node.left
                return ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, a, 0, 0, 0, 0, 0, "", "")
            if node.kind == "binary" or node.kind == "if":
                a: usize = proof_kernel_replay_subtraction_alias_rewrite(nodes, children, node.left, term, alias, depth + 1, work)
                return nodes.count if not proof_kernel_replay_valid(nodes, a)
                b: usize = proof_kernel_replay_subtraction_alias_rewrite(nodes, children, node.right, term, alias, depth + 1, work)
                return nodes.count if not proof_kernel_replay_valid(nodes, b)
                c: mutable usize = 0
                if node.kind == "if":
                    c <- proof_kernel_replay_subtraction_alias_rewrite(nodes, children, node.auxiliary, term, alias, depth + 1, work)
                    return nodes.count if not proof_kernel_replay_valid(nodes, c)
                return root if a == node.left and b == node.right and c == node.auxiliary
                return ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, a, b, c, 0, 0, 0, "", "")
            return root

        def proof_kernel_replay_subtraction_alias_plan(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> (known: bool, goal: usize):
            return (false, 0) if not proof_kernel_replay_valid(nodes, goal_root)
            zero = proof_kernel_replay_zero_subtraction_plan(nodes, children, facts, goal_root)
            return zero if zero.known
            work: mutable usize = PROOF_KERNEL_REPLAY_WORK_BUDGET
            for fact_root in facts |fact_root, nodes, children, facts, goal_root, work|:
                return (false, 0) if work == 0
                work <- work - 1
                continue if not proof_kernel_replay_valid(nodes, fact_root)
                fact = nodes[fact_root]
                continue if fact.kind != "binary" or fact.operator != "==" or not proof_kernel_replay_arena_shape_valid(fact)
                fact_left: usize = fact.left
                fact_right: usize = fact.right
                continue if not proof_kernel_replay_valid(nodes, fact_left) or not proof_kernel_replay_valid(nodes, fact_right)
                alias: usize = fact_left if nodes[fact_left].kind == "ident" else fact_right
                term: usize = fact_right if nodes[fact_left].kind == "ident" else fact_left
                continue if nodes[alias].kind != "ident" or not proof_kernel_replay_arena_shape_valid(nodes[alias])
                delta = nodes[term]
                continue if delta.kind != "binary" or delta.operator != "-" or not proof_kernel_replay_arena_shape_valid(delta)
                delta_left: usize = delta.left
                delta_right: usize = delta.right
                continue if not proof_kernel_replay_valid(nodes, delta_left) or not proof_kernel_replay_valid(nodes, delta_right)
                continue if nodes[delta_left].kind != "ident" or nodes[delta_right].kind != "ident"
                continue if not proof_kernel_replay_arena_shape_valid(nodes[delta_left]) or not proof_kernel_replay_arena_shape_valid(nodes[delta_right])
                continue if nodes[delta_left].name == nodes[alias].name or nodes[delta_right].name == nodes[alias].name
                width: i64 = proof_kernel_replay_peer_unsigned_width(nodes, children, alias, facts)
                continue if width != 8 and width != 16 and width != 32 and width != 64
                continue if proof_kernel_replay_peer_unsigned_width(nodes, children, delta_left, facts) != width or proof_kernel_replay_peer_unsigned_width(nodes, children, delta_right, facts) != width
                continue if not proof_kernel_replay_primitive_comparison(nodes, children, facts, alias, term)
                rewritten: usize = proof_kernel_replay_subtraction_alias_rewrite(nodes, children, goal_root, term, alias, 0, &work)
                return (false, 0) if not proof_kernel_replay_valid(nodes, rewritten)
                return (true, rewritten) if rewritten != goal_root
            return (false, 0)
