extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_linear_name_equal_with_work(left: sview, right: sview, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(left))
                not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(right))
            left == right

        def proof_kernel_replay_linear_marker_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, work_used: mutable usize&) -> bool:
            return false if root >= nodes.count or nodes[root].kind != "call"
            proof_kernel_replay_goal_search_ident_matches(nodes, nodes[root].left, "__elisa_linear_certificate", work_used)

        def proof_kernel_replay_linear_call_argument_labels_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&) -> bool:
            return true if root >= nodes.count or nodes[root].kind != "call"
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if:
                node.children_count != 2 and node.children_count != 3
                not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
            if node.left < nodes.count and nodes[node.left].kind == "ident":
                return false if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(nodes[node.left].name))
            for offset in 0..<node.children_count |offset, nodes, children, node, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + offset)
                continue if not argument.known or argument.value >= nodes.count or nodes[argument.value].kind != "call_arg"
                return false if:
                    not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(nodes[argument.value].name))
                    not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(nodes[argument.value].secondary_name))
            true

        def proof_kernel_replay_element_marker_with_goal_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, work_used: mutable usize&) -> (known: bool, root: usize, depth: i64, width: i64):
            empty: (known: bool, root: usize, depth: i64, width: i64) = (false, 0, 0, 0)
            return empty if:
                not proof_kernel_replay_goal_search_charge(work_used)
                root >= nodes.count or not proof_kernel_replay_valid(nodes, root) or not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            marker: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return empty if:
                marker.kind != "call" or marker.operator != "" or marker.auxiliary != 0 or (marker.children_count != 2 and marker.children_count != 3)
                not proof_kernel_replay_child_range_valid(marker.children_start, marker.children_count, children.count)
                marker.left >= nodes.count or not proof_kernel_replay_valid(nodes, marker.left) or not proof_kernel_replay_goal_search_charge_node_text(nodes, marker.left, work_used)
            callee_matches: bool = proof_kernel_replay_goal_search_ident_matches(nodes, marker.left, "__elisa_primitive_scalar_element", work_used)
            return empty if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not callee_matches
                not proof_kernel_replay_goal_search_charge(work_used)
            term_argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start)
            return empty if not proof_kernel_replay_goal_search_charge(work_used)
            depth_argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start + 1)
            return empty if:
                not term_argument.known or not depth_argument.known or term_argument.value >= nodes.count or depth_argument.value >= nodes.count
                not proof_kernel_replay_valid(nodes, term_argument.value) or not proof_kernel_replay_valid(nodes, depth_argument.value)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, term_argument.value, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, depth_argument.value, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            term_node: ElisaProofKernelCore::ProofKernelNode = nodes[term_argument.value]
            depth_node: ElisaProofKernelCore::ProofKernelNode = nodes[depth_argument.value]
            term_labels_empty: bool = proof_kernel_replay_goal_search_text_equal(term_node.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(term_node.secondary_name, "", work_used)
            depth_labels_empty: bool = proof_kernel_replay_goal_search_text_equal(depth_node.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(depth_node.secondary_name, "", work_used)
            return empty if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or term_node.kind != "call_arg" or depth_node.kind != "call_arg" or not term_labels_empty or not depth_labels_empty
                not proof_kernel_replay_valid(nodes, term_node.left) or not proof_kernel_replay_goal_search_charge_node_text(nodes, term_node.left, work_used)
            depth_value: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, depth_node.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
            return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not depth_value.known or depth_value.value < 1 or depth_value.value > PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT
            width: mutable i64 = 0
            if marker.children_count == 3:
                return empty if not proof_kernel_replay_goal_search_charge(work_used)
                width_argument: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start + 2)
                return empty if:
                    not width_argument.known or width_argument.value >= nodes.count or not proof_kernel_replay_valid(nodes, width_argument.value)
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, width_argument.value, work_used)
                width_node: ElisaProofKernelCore::ProofKernelNode = nodes[width_argument.value]
                width_labels_empty: bool = proof_kernel_replay_goal_search_text_equal(width_node.name, "", work_used) and proof_kernel_replay_goal_search_text_equal(width_node.secondary_name, "", work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or width_node.kind != "call_arg" or not width_labels_empty or not proof_kernel_replay_valid(nodes, width_node.left)
                marked_width: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, width_node.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return empty if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or not marked_width.known or marked_width.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or marked_width.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
                width <- marked_width.value
            return (true, term_node.left, depth_value.value, width)

        def proof_kernel_replay_linear_place_marker_width_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], term: usize, work_used: mutable usize&) -> i64:
            width: mutable i64 = 0
            for fact in facts |fact, nodes, children, facts, term, width, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                return 0 if:
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, fact, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, fact)
                continue if not located.known or located.node.kind != "call" or located.node.operator != "" or located.node.auxiliary != 0 or located.node.children_count != 2
                marker: ElisaProofKernelCore::ProofKernelNode = located.node
                continue if not proof_kernel_replay_child_range_valid(marker.children_start, marker.children_count, children.count)
                return 0 if marker.left >= nodes.count or not proof_kernel_replay_valid(nodes, marker.left) or not proof_kernel_replay_goal_search_charge_node_text(nodes, marker.left, work_used)
                continue if not proof_kernel_replay_goal_search_ident_matches(nodes, marker.left, "__elisa_unsigned_type_bound", work_used)
                return 0 if:
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    not proof_kernel_replay_goal_search_charge(work_used)
                first: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start)
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                second: (known: bool, value: usize) = proof_kernel_replay_child_at(children, marker.children_start + 1)
                continue if not first.known or not second.known
                return 0 if:
                    first.value >= nodes.count or second.value >= nodes.count
                    not proof_kernel_replay_goal_search_charge_node_text(nodes, first.value, work_used) or not proof_kernel_replay_goal_search_charge_node_text(nodes, second.value, work_used)
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                first_argument: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, first.value)
                second_argument: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, second.value)
                continue if not first_argument.known or not second_argument.known or first_argument.node.kind != "call_arg" or second_argument.node.kind != "call_arg"
                first_labels_empty: bool = proof_kernel_replay_linear_name_equal_with_work(first_argument.node.name, "", work_used) and proof_kernel_replay_linear_name_equal_with_work(first_argument.node.secondary_name, "", work_used)
                second_labels_empty: bool = proof_kernel_replay_linear_name_equal_with_work(second_argument.node.name, "", work_used) and proof_kernel_replay_linear_name_equal_with_work(second_argument.node.secondary_name, "", work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not first_labels_empty or not second_labels_empty
                continue if not proof_kernel_replay_valid(nodes, first_argument.node.left) or not proof_kernel_replay_valid(nodes, second_argument.node.left)
                same_term: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, first_argument.node.left, term, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not same_term
                value: ProofKernelReplayInt = proof_kernel_replay_constant_int_with_goal_work(nodes, second_argument.node.left, ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not value.known or value.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or value.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
                width <- value.value if width == 0 or value.value < width
            width

        def proof_kernel_replay_linear_unsigned_marker_width_for_name_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], name: sview, work_used: mutable usize&) -> i64:
            width: mutable i64 = 0
            for fact in facts |fact, nodes, children, facts, name, width, work_used|:
                return 0 if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    not proof_kernel_replay_linear_call_argument_labels_with_work(nodes, children, fact, work_used)
                marker: (known: bool, name_root: usize, width: i64) = proof_kernel_replay_unsigned_marker_info_with_goal_work(nodes, children, fact, 0, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not marker.known or marker.name_root >= nodes.count or nodes[marker.name_root].kind != "ident"
                matches: bool = proof_kernel_replay_goal_search_text_equal(nodes[marker.name_root].name, name, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                width <- marker.width if matches and (width == 0 or marker.width < width)
            width

        def proof_kernel_replay_linear_indexed_container_path_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, expression: usize, container: mutable usize&, subscripts: mutable i64&, depth: usize, work_used: mutable usize&) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, expression)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[expression]
            return false if not proof_kernel_replay_arena_shape_valid(node)
            if node.kind == "index":
                return false if:
                    not proof_kernel_replay_linear_indexed_container_path_with_work(nodes, children, node.left, container, subscripts, depth + 1, work_used)
                    subscripts >= PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT
                subscripts <- subscripts + 1
                return true
            if node.kind == "index-n":
                return false if:
                    node.children_count == 0 or node.children_count > PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT.usize() or not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    not proof_kernel_replay_linear_indexed_container_path_with_work(nodes, children, node.left, container, subscripts, depth + 1, work_used)
                count: i64 = node.children_count.i64()
                return false if subscripts > PROOF_KERNEL_SCALAR_ELEMENT_DEPTH_LIMIT - count
                subscripts <- subscripts + count
                return true
            container <- expression
            true

        def proof_kernel_replay_linear_element_width_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], root: usize, work_used: mutable usize&) -> i64:
            container: mutable usize = 0
            subscripts: mutable i64 = 0
            return 0 if not proof_kernel_replay_linear_indexed_container_path_with_work(nodes, children, root, &container, &subscripts, 0, work_used) or subscripts == 0
            width: mutable i64 = 0
            for fact in facts |fact, nodes, children, facts, container, subscripts, width, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                marker: (known: bool, root: usize, depth: i64, width: i64) = proof_kernel_replay_element_marker_with_goal_work(nodes, children, fact, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not marker.known or marker.width == 0 or marker.depth != subscripts
                same_container: bool = proof_kernel_replay_goal_search_expr_equal(nodes, children, marker.root, container, work_used)
                return 0 if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                width <- marker.width if same_container and (width == 0 or marker.width < width)
            width

        def proof_kernel_replay_linear_unsigned_width_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], work_used: mutable usize&, depth: usize) -> i64:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return 0 if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or not ElisaProofKernelCore::depth_valid(depth) or not proof_kernel_replay_valid(nodes, root)
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            if node.kind == "typed-int":
                literal = ElisaProofKernelCore::typed_literal_value(node)
                return literal.width if literal.known and literal.unsigned
            if node.kind == "ident":
                return proof_kernel_replay_linear_unsigned_marker_width_for_name_with_work(nodes, children, facts, node.name, work_used)
            if node.kind == "field":
                return proof_kernel_replay_linear_place_marker_width_with_work(nodes, children, facts, root, work_used)
            if node.kind in {"index", "index-n"}:
                return proof_kernel_replay_linear_element_width_with_work(nodes, children, facts, root, work_used)
            if node.kind == "unary":
                return proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, node.left, facts, work_used, depth + 1)
            if node.kind == "binary":
                left_width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, node.left, facts, work_used, depth + 1)
                right_width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, node.right, facts, work_used, depth + 1)
                return right_width if left_width == 0
                return left_width if right_width == 0 or left_width < right_width
                return right_width
            if node.kind == "if":
                then_width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, node.right, facts, work_used, depth + 1)
                else_width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, node.auxiliary, facts, work_used, depth + 1)
                return 0 if then_width == 0 or else_width == 0
                return then_width if then_width < else_width
                return else_width
            0

        def proof_kernel_replay_linear_term_has_width_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, facts: darray[usize], signed_only: bool, work_used: mutable usize&) -> bool:
            signed_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, root, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return signed_width != 0 if signed_only
            return true if signed_width != 0
            unsigned_width: i64 = proof_kernel_replay_linear_unsigned_width_with_work(nodes, children, root, facts, work_used, 0)
            return work_used <= PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT and unsigned_width != 0

        def proof_kernel_replay_linear_collect_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, sign: i64, signed: bool, signed_only: bool, facts: darray[usize], terms: mutable darray[ProofKernelReplayNormalTerm]&, work_used: mutable usize&, depth: usize) -> bool:
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                not ElisaProofKernelCore::depth_valid(depth) or depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
                terms.count >= PROOF_KERNEL_REPLAY_LINEAR_TERM_LIMIT
                not proof_kernel_replay_goal_search_charge_node_text(nodes, root, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "int":
                return false if node.value < 0
                scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(node.value, sign)
                return false if not scaled.known or not proof_kernel_replay_goal_search_charge(work_used)
                terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: scaled.value})
                return true
            if node.kind == "ident":
                return false if:
                    not proof_kernel_replay_linear_name_equal_with_work(node.name, "", work_used) or not proof_kernel_replay_linear_term_has_width_with_work(nodes, children, root, facts, signed_only, work_used)
                    not proof_kernel_replay_goal_search_charge(work_used)
                terms.push(ProofKernelReplayNormalTerm{name: node.name, coefficient: sign})
                return true
            if node.kind == "unary":
                return false if node.operator != "+" and node.operator != "-"
                negated: ProofKernelReplayInt = proof_kernel_replay_signed_negated_literal_with_goal_work(nodes, root, signed, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                if negated.known:
                    scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(negated.value, sign)
                    return false if not scaled.known or not proof_kernel_replay_goal_search_charge(work_used)
                    terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: scaled.value})
                    return true
                return false if not proof_kernel_replay_linear_term_has_width_with_work(nodes, children, root, facts, signed_only, work_used)
                flipped: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, sign)
                return false if not flipped.known
                return proof_kernel_replay_linear_collect_with_work(nodes, children, node.left, sign if node.operator == "+" else flipped.value, signed, signed_only, facts, terms, work_used, depth + 1)
            if node.kind == "binary":
                if node.operator == "*":
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    literal_left: ProofKernelReplayInt = proof_kernel_replay_linear_literal_with_goal_work(nodes, node.left, work_used)
                    return false if:
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        not proof_kernel_replay_goal_search_charge(work_used)
                    literal_right: ProofKernelReplayInt = proof_kernel_replay_linear_literal_with_goal_work(nodes, node.right, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if literal_left.known and literal_right.known and (literal_left.value <= 1 or literal_right.value <= 1):
                        product: ProofKernelReplayInt = proof_kernel_replay_mul_safe(literal_left.value, literal_right.value)
                        return false if not product.known
                        scaled_product: ProofKernelReplayInt = proof_kernel_replay_mul_safe(product.value, sign)
                        return false if not scaled_product.known or not proof_kernel_replay_goal_search_charge(work_used)
                        terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: scaled_product.value})
                        return true
                return false if not proof_kernel_replay_linear_term_has_width_with_work(nodes, children, root, facts, signed_only, work_used)
                if node.operator == "*":
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    left_scale: ProofKernelReplayInt = proof_kernel_replay_linear_literal_with_goal_work(nodes, node.left, work_used)
                    return false if:
                        work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        not proof_kernel_replay_goal_search_charge(work_used)
                    right_scale: ProofKernelReplayInt = proof_kernel_replay_linear_literal_with_goal_work(nodes, node.right, work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if left_scale.known:
                        scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(left_scale.value, sign)
                        return false if not scaled.known
                        return proof_kernel_replay_linear_collect_with_work(nodes, children, node.right, scaled.value, signed, signed_only, facts, terms, work_used, depth + 1)
                    if right_scale.known:
                        scaled: ProofKernelReplayInt = proof_kernel_replay_mul_safe(right_scale.value, sign)
                        return false if not scaled.known
                        return proof_kernel_replay_linear_collect_with_work(nodes, children, node.left, scaled.value, signed, signed_only, facts, terms, work_used, depth + 1)
                    return false
                return false if:
                    node.operator != "+" and node.operator != "-"
                    not proof_kernel_replay_linear_collect_with_work(nodes, children, node.left, sign, signed, signed_only, facts, terms, work_used, depth + 1)
                flipped: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, sign)
                return false if not flipped.known
                return proof_kernel_replay_linear_collect_with_work(nodes, children, node.right, sign if node.operator == "+" else flipped.value, signed, signed_only, facts, terms, work_used, depth + 1)
            false

        def proof_kernel_replay_linear_push_order_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, lower: usize, upper: usize, strict: bool, signed: bool, signed_only: bool, facts: darray[usize], terms: mutable darray[ProofKernelReplayNormalTerm]&, spans: mutable darray[ProofKernelReplayLinearSpan]&, work_used: mutable usize&) -> bool:
            return false if:
                not proof_kernel_replay_goal_search_charge(work_used)
                spans.count >= PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT
            start: usize = terms.count
            return false if:
                not proof_kernel_replay_linear_collect_with_work(nodes, children, lower, 1, signed, signed_only, facts, terms, work_used, 0)
                not proof_kernel_replay_linear_collect_with_work(nodes, children, upper, -1, signed, signed_only, facts, terms, work_used, 0)
            if strict:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                terms.push(ProofKernelReplayNormalTerm{name: "", coefficient: 1})
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            spans.push(ProofKernelReplayLinearSpan{start: start, stop: terms.count})
            true

        def proof_kernel_replay_linear_push_comparison_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: usize, operator: sview, right: usize, signed_only: bool, facts: darray[usize], terms: mutable darray[ProofKernelReplayNormalTerm]&, spans: mutable darray[ProofKernelReplayLinearSpan]&, work_used: mutable usize&) -> bool:
            left_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, left, work_used, 0)
            right_width: i64 = proof_kernel_replay_signed_width_in_expression_with_goal_work(nodes, children, facts, right, work_used, 0)
            return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            signed: bool = left_width != 0 or right_width != 0
            if operator == "<":
                return proof_kernel_replay_linear_push_order_with_work(nodes, children, left, right, true, signed, signed_only, facts, terms, spans, work_used)
            if operator == "<=":
                return proof_kernel_replay_linear_push_order_with_work(nodes, children, left, right, false, signed, signed_only, facts, terms, spans, work_used)
            if operator == ">":
                return proof_kernel_replay_linear_push_order_with_work(nodes, children, right, left, true, signed, signed_only, facts, terms, spans, work_used)
            if operator == ">=":
                return proof_kernel_replay_linear_push_order_with_work(nodes, children, right, left, false, signed, signed_only, facts, terms, spans, work_used)
            if operator == "==":
                return proof_kernel_replay_linear_push_order_with_work(nodes, children, left, right, false, signed, signed_only, facts, terms, spans, work_used) and proof_kernel_replay_linear_push_order_with_work(nodes, children, right, left, false, signed, signed_only, facts, terms, spans, work_used)
            false

        def proof_kernel_replay_linear_fact_parts_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, fact: usize, negated: bool, facts: darray[usize], reserve: usize, signed_only: bool, bounds: darray[ProofKernelReplayBound]&, terms: mutable darray[ProofKernelReplayNormalTerm]&, spans: mutable darray[ProofKernelReplayLinearSpan]&, work_used: mutable usize&, depth: usize) -> void:
            return if not proof_kernel_replay_goal_search_charge(work_used)
            return if depth >= 16 or spans.count + reserve >= PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT
            return if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[fact]
            if node.kind == "paren":
                proof_kernel_replay_linear_fact_parts_with_work(nodes, children, node.left, negated, facts, reserve, signed_only, bounds, terms, spans, work_used, depth + 1)
                return
            if node.kind == "unary" and node.operator == "not":
                proof_kernel_replay_linear_fact_parts_with_work(nodes, children, node.left, not negated, facts, reserve, signed_only, bounds, terms, spans, work_used, depth + 1)
                return
            return if node.kind != "binary"
            if (node.operator == "and" and not negated) or (node.operator == "or" and negated):
                proof_kernel_replay_linear_fact_parts_with_work(nodes, children, node.left, negated, facts, reserve, signed_only, bounds, terms, spans, work_used, depth + 1)
                proof_kernel_replay_linear_fact_parts_with_work(nodes, children, node.right, negated, facts, reserve, signed_only, bounds, terms, spans, work_used, depth + 1)
                return
            negated_equality: bool = negated and node.operator == "!="
            return if not negated_equality and node.operator != "<" and node.operator != "<=" and node.operator != ">" and node.operator != ">=" and node.operator != "=="
            if negated and proof_kernel_replay_is_order_operator(node.operator):
                return if not proof_kernel_replay_denial_integer_term_with_work(nodes, children, node.left, facts, work_used, 0) or not proof_kernel_replay_denial_integer_term_with_work(nodes, children, node.right, facts, work_used, 0)
            effective: sview = "==" if negated_equality else (proof_kernel_replay_linear_negation(node.operator) if negated else node.operator)
            return if effective == ""
            return if not proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, node.left, node.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            return if signed_only and not proof_kernel_replay_signed_expression_safe_with_bounds_goal_work(nodes, children, fact, facts, bounds, work_used, 0)
            return if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            if spans.count + reserve + 2 <= PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT or effective != "==":
                proof_kernel_replay_linear_push_comparison_with_work(nodes, children, node.left, effective, node.right, signed_only, facts, terms, spans, work_used)

        def proof_kernel_replay_linear_fact_constraints_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], reserve: usize, signed_only: bool, bounds: darray[ProofKernelReplayBound]&, terms: mutable darray[ProofKernelReplayNormalTerm]&, spans: mutable darray[ProofKernelReplayLinearSpan]&, work_used: mutable usize&) -> void:
            for fact in facts |fact, nodes, children, facts, reserve, terms, spans, work_used|:
                return if not proof_kernel_replay_goal_search_charge(work_used)
                break if spans.count + reserve >= PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT
                proof_kernel_replay_linear_fact_parts_with_work(nodes, children, fact, false, facts, reserve, signed_only, bounds, terms, spans, work_used, 0)

        def proof_kernel_replay_linear_gcd_with_work(left: i64, right: i64, work_used: mutable usize&) -> i64:
            a: mutable i64 = left if left >= 0 else 0 - left
            b: mutable i64 = right if right >= 0 else 0 - right
            for step in 0..<128 |step, a, b, work_used|:
                return 0 if not proof_kernel_replay_goal_search_charge(work_used)
                break if b == 0
                remainder: i64 = a % b
                a <- b
                b <- remainder
            return a if a > 0 else 1

        def proof_kernel_replay_linear_farkas_valid_with_work(original: darray[i64]&, atom_count: usize, width: usize, multipliers: darray[i64]&, work_used: mutable usize&) -> bool:
            any_positive: mutable bool = false
            for multiplier in multipliers |multiplier, any_positive, work_used|:
                return false if:
                    not proof_kernel_replay_goal_search_charge(work_used)
                    multiplier < 0
                any_positive <- true if multiplier > 0
            return false if not any_positive
            for column in 0..<(atom_count + 1) |column, original, atom_count, width, multipliers, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                total: mutable i64 = 0
                for index in 0..<multipliers.count |index, column, original, width, multipliers, total, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    product: ProofKernelReplayInt = proof_kernel_replay_mul_safe(multipliers[index], original[index * width + column])
                    return false if not product.known
                    summed: ProofKernelReplayInt = proof_kernel_replay_add_safe(total, product.value)
                    return false if not summed.known
                    total <- summed.value
                return false if:
                    column < atom_count and total != 0
                    column == atom_count and total <= 0
            true

        def proof_kernel_replay_linear_refutes_with_work(terms: darray[ProofKernelReplayNormalTerm]&, spans: darray[ProofKernelReplayLinearSpan]&, work_used: mutable usize&) -> bool:
            return false if not proof_kernel_replay_goal_search_charge(work_used)
            count: usize = spans.count
            return false if count == 0 or count > PROOF_KERNEL_REPLAY_LINEAR_CONSTRAINT_LIMIT
            atoms: mutable darray[sview] = []
            for span in spans |span, terms, atoms, work_used|:
                for position in span.start..<span.stop |position, terms, atoms, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    term: ProofKernelReplayNormalTerm = terms[position]
                    continue if proof_kernel_replay_linear_name_equal_with_work(term.name, "", work_used)
                    return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    seen: mutable bool = false
                    for atom in atoms |atom, term, seen, work_used|:
                        seen <- true if proof_kernel_replay_linear_name_equal_with_work(atom, term.name, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    if not seen:
                        return false if atoms.count >= PROOF_KERNEL_REPLAY_LINEAR_ATOM_LIMIT or not proof_kernel_replay_goal_search_charge(work_used)
                        atoms.push(term.name)
            return false if atoms.count > PROOF_KERNEL_REPLAY_LINEAR_ATOM_LIMIT
            width: usize = atoms.count + 1 + count
            original: mutable darray[i64] = []
            for index in 0..<count |index, spans, terms, atoms, width, count, original, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                row_start: usize = original.count
                for column in 0..<width |column, original, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    original.push(0)
                span: ProofKernelReplayLinearSpan = spans[index]
                for position in span.start..<span.stop |position, terms, atoms, row_start, original, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    term: ProofKernelReplayNormalTerm = terms[position]
                    column: mutable usize = atoms.count
                    for atom_index in 0..<atoms.count |atom_index, atoms, term, column, work_used|:
                        matches: bool = proof_kernel_replay_linear_name_equal_with_work(atoms[atom_index], term.name, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                        column <- atom_index if matches
                    summed: ProofKernelReplayInt = proof_kernel_replay_add_safe(original[row_start + column], term.coefficient)
                    return false if not summed.known
                    original[row_start + column] <- summed.value
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                original[row_start + atoms.count + 1 + index] <- 1
            rows: mutable darray[i64] = []
            for value in original |value, rows, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                rows.push(value)
            row_count: mutable usize = count
            for atom_index in 0..<atoms.count |atom_index, width, rows, row_count, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                next: mutable darray[i64] = []
                next_count: mutable usize = 0
                for row in 0..<row_count |row, width, atom_index, rows, next, next_count, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    if rows[row * width + atom_index] == 0:
                        for column in 0..<width |column, row, width, rows, next, work_used|:
                            return false if not proof_kernel_replay_goal_search_charge(work_used)
                            next.push(rows[row * width + column])
                        next_count <- next_count + 1
                for positive in 0..<row_count |positive, width, atom_index, rows, next, next_count, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    upper: i64 = rows[positive * width + atom_index]
                    continue if upper <= 0
                    for negative in 0..<row_count |negative, positive, upper, width, atom_index, rows, next, next_count, work_used|:
                        return false if not proof_kernel_replay_goal_search_charge(work_used)
                        lower: i64 = rows[negative * width + atom_index]
                        continue if lower >= 0
                        return false if next_count >= PROOF_KERNEL_REPLAY_LINEAR_ROW_LIMIT
                        divisor: i64 = proof_kernel_replay_linear_gcd_with_work(upper, lower, work_used)
                        return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT or divisor == 0
                        positive_scale: i64 = (0 - lower) / divisor
                        negative_scale: i64 = upper / divisor
                        for column in 0..<width |column, positive, negative, positive_scale, negative_scale, width, rows, next, work_used|:
                            return false if not proof_kernel_replay_goal_search_charge(work_used)
                            first: ProofKernelReplayInt = proof_kernel_replay_mul_safe(positive_scale, rows[positive * width + column])
                            second: ProofKernelReplayInt = proof_kernel_replay_mul_safe(negative_scale, rows[negative * width + column])
                            return false if not first.known or not second.known
                            combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(first.value, second.value)
                            return false if not combined.known
                            next.push(combined.value)
                        next_count <- next_count + 1
                rows <- next
                row_count <- next_count
            for row in 0..<row_count |row, width, atoms, rows, original, count, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if rows[row * width + atoms.count] <= 0
                multipliers: mutable darray[i64] = []
                for index in 0..<count |index, row, width, atoms, rows, multipliers, work_used|:
                    return false if not proof_kernel_replay_goal_search_charge(work_used)
                    multipliers.push(rows[row * width + atoms.count + 1 + index])
                return true if proof_kernel_replay_linear_farkas_valid_with_work(original, atoms.count, width, multipliers, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            false

        def proof_kernel_replay_linear_arithmetic_goal_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: usize, operator: sview, right: usize, facts: darray[usize], work_used: mutable usize&) -> bool:
            return proof_kernel_replay_linear_arithmetic_goal_with_work(nodes, children, left, "<=", right, facts, work_used) and proof_kernel_replay_linear_arithmetic_goal_with_work(nodes, children, left, ">=", right, facts, work_used) if operator == "=="
            for fact in facts |fact, nodes, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                continue if fact >= nodes.count or not proof_kernel_replay_valid(nodes, fact)
                marker: bool = proof_kernel_replay_linear_marker_with_work(nodes, fact, work_used)
                return false if:
                    work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                    marker
            negated: sview = proof_kernel_replay_linear_negation(operator)
            return false if negated == ""
            terms: mutable darray[ProofKernelReplayNormalTerm] = []
            spans: mutable darray[ProofKernelReplayLinearSpan] = []
            empty_bounds: darray[ProofKernelReplayBound] = []
            proof_kernel_replay_linear_fact_constraints_with_work(nodes, children, facts, 1, false, empty_bounds, &terms, &spans, work_used)
            return false if:
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                not proof_kernel_replay_linear_push_comparison_with_work(nodes, children, left, negated, right, false, facts, &terms, &spans, work_used)
                work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            proof_kernel_replay_linear_refutes_with_work(terms, spans, work_used)

        def proof_kernel_replay_linear_disequality_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize, work_used: mutable usize&) -> (known: bool, left: usize, right: usize):
            return (false, 0, 0) if:
                not proof_kernel_replay_goal_search_charge(work_used)
                depth >= 8 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return proof_kernel_replay_linear_disequality_with_work(nodes, node.left, depth + 1, work_used) if node.kind == "paren"
            return (true, node.left, node.right) if node.kind == "binary" and node.operator == "!="
            return (false, 0, 0) if node.kind != "unary" or node.operator != "not"
            inner: mutable usize = node.left
            for step in 0..<8 |step, nodes, inner, work_used|:
                return (false, 0, 0) if not proof_kernel_replay_goal_search_charge(work_used)
                break if inner >= nodes.count or not proof_kernel_replay_valid(nodes, inner) or nodes[inner].kind != "paren"
                inner <- nodes[inner].left
            return (false, 0, 0) if inner >= nodes.count or not proof_kernel_replay_valid(nodes, inner)
            return (true, nodes[inner].left, nodes[inner].right) if nodes[inner].kind == "binary" and nodes[inner].operator == "=="
            (false, 0, 0)

        # Same recognized disequality forms and Farkas checks as the legacy entry point, with
        # every fact scan, normalization step, matrix operation, and certificate check on the
        # report's shared work meter.
        def proof_kernel_replay_linear_disequality_refuted_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], work_used: mutable usize&) -> bool:
            for fact in facts |fact, nodes, children, facts, work_used|:
                return false if not proof_kernel_replay_goal_search_charge(work_used)
                pair: (known: bool, left: usize, right: usize) = proof_kernel_replay_linear_disequality_with_work(nodes, fact, 0, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not pair.known
                primitive: bool = proof_kernel_replay_primitive_comparison_with_work(nodes, children, facts, pair.left, pair.right, work_used, PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
                continue if not primitive
                return true if proof_kernel_replay_linear_arithmetic_goal_with_work(nodes, children, pair.left, "==", pair.right, facts, work_used)
                return false if work_used > PROOF_KERNEL_REPLAY_GOAL_SEARCH_WORK_LIMIT
            false
