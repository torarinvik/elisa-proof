extend ElisaProofKernelReplay:
    private:
        def proof_kernel_replay_add_node_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, kind: sview, operator: sview, left: usize, right: usize, auxiliary: usize, work_used: mutable usize&) -> usize:
            empty: usize = nodes.count
            return empty if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, kind, operator)
            created: usize = ElisaProofKernelCore::add_node(nodes, kind, operator, left, right, auxiliary, 0, 0, 0, "", "")
            return created if created < nodes.count else empty

        # The replay's bounded arena reuse scan is useful, but each candidate and text
        # comparison must consume the caller's shared goal-search budget.
        def proof_kernel_replay_add_node_reused_with_goal_work(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, kind: sview, operator: sview, left: usize, right: usize, auxiliary: usize, work_used: mutable usize&) -> usize:
            empty: usize = nodes.count
            return empty if not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(kind)) or not proof_kernel_replay_goal_search_charge_amount(work_used, sview_len(operator))
            for offset in 0..<ElisaProofKernelCore::PROOF_KERNEL_REUSE_WINDOW |offset, nodes, kind, operator, left, right, auxiliary, work_used|:
                return empty if not proof_kernel_replay_goal_search_charge(work_used)
                break if offset >= nodes.count
                candidate: usize = nodes.count - 1 - offset
                return empty if not proof_kernel_replay_goal_search_charge_node_text(nodes, candidate, work_used)
                existing: ElisaProofKernelCore::ProofKernelNode = nodes[candidate]
                if existing.kind == kind and existing.operator == operator and existing.left == left and existing.right == right and existing.auxiliary == auxiliary and existing.children_count == 0 and existing.value == 0 and existing.name == "" and existing.secondary_name == "":
                    return candidate
            return empty if not proof_kernel_replay_charge_synthetic_node_with_goal_work(work_used, kind, operator)
            created: usize = ElisaProofKernelCore::add_node(nodes, kind, operator, left, right, auxiliary, 0, 0, 0, "", "")
            return created if created < nodes.count else empty
