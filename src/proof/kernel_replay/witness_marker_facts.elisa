extend ElisaProofKernelReplay:
    private:
        # The scalar-witness recursion consults its facts only through four marker readers
        # (`proof_kernel_replay_untrusted_operator_marker`, `proof_kernel_replay_marker_argument`
        # for `__elisa_primitive_scalar_type`, `proof_kernel_replay_unsigned_marker_info` and
        # `proof_kernel_replay_element_marker`). Each of them answers "unknown" unless the fact
        # is a call whose callee is a bare identifier spelled as its marker. A fact outside that
        # set can therefore never change a witness verdict, while the recursion re-scanned every
        # fact at every subterm. Keeping only the candidates, in their original order, gives each
        # reader the same first match and the same verdict. This is a filter on calls the
        # readers would reject anyway; it admits nothing they would not.
        def proof_kernel_replay_witness_marker_candidate(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, fact: usize) -> bool:
            return false if fact >= nodes.count
            return false if nodes[fact].kind != "call"
            callee: usize = nodes[fact].left
            return false if callee >= nodes.count
            return nodes[callee].kind == "ident" and proof_kernel_replay_witness_marker_name(nodes[callee].name)

        def proof_kernel_replay_witness_marker_name(name: sview) -> bool:
            match name:
                "__elisa_untrusted_operator_type" | "__elisa_primitive_scalar_type" | "__elisa_unsigned_type_bound" | "__elisa_primitive_scalar_element":
                    return true
                _:
                    return false

        def proof_kernel_replay_witness_marker_facts(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, facts: darray[usize]) -> darray[usize]:
            markers: mutable darray[usize] = []
            for fact in facts |fact, nodes, markers|:
                if proof_kernel_replay_witness_marker_candidate(nodes, fact):
                    markers.push(fact)
            return markers
