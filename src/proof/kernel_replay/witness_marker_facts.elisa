extend ElisaProofKernelReplay:
    private:
        const PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_OPERATOR: usize = 1
        const PROOF_KERNEL_REPLAY_WITNESS_PRIMITIVE_SCALAR: usize = 2
        const PROOF_KERNEL_REPLAY_WITNESS_UNSIGNED_TYPE: usize = 3
        const PROOF_KERNEL_REPLAY_WITNESS_SCALAR_ELEMENT: usize = 4
        const PROOF_KERNEL_REPLAY_WITNESS_PRIMITIVE_INTEGER: usize = 5
        const PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_ELEMENT_OPERATOR: usize = 6
        const PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_SCALAR_REFERENCE_OPERATOR: usize = 7

        # Parsed once for a single immutable nodes/children/facts query context. These records
        # cache only exact, fully validated marker payloads; they never cache a proof verdict.
        # The array is local to the scalar-witness query, so a later arena/fact context cannot
        # reuse it after mutation.
        struct ProofKernelReplayWitnessMarker:
            kind: usize
            root: usize
            depth: i64
            width: i64
            # Unsigned type markers cache their validated binder spelling. Other marker kinds
            # leave this empty because their roots may be arbitrary expressions.
            name: sview

        # The scalar-witness recursion consults its facts only through four marker readers
        # (`proof_kernel_replay_untrusted_operator_marker`, `proof_kernel_replay_marker_argument`
        # for the primitive-scalar and primitive-integer markers,
        # `proof_kernel_replay_unsigned_marker_info` and `proof_kernel_replay_element_marker`).
        # Non-marker facts cannot change a witness verdict, while the recursion re-scanned every
        # fact at every subterm. This pass classifies names in marker-reader order and charges each
        # attempted text comparison. A recognized marker with a malformed payload invalidates the
        # cache rather than becoming indistinguishable from absent metadata; valid rows retain
        # source order so first-match behavior stays unchanged.
        def proof_kernel_replay_witness_marker_candidate_with_work(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, fact: usize, work_used: mutable usize&, work_limit: usize) -> (complete: bool, kind: usize):
            return (false, 0) if fact >= nodes.count
            return (true, 0) if nodes[fact].kind != "call"
            callee: usize = nodes[fact].left
            return (false, 0) if callee >= nodes.count
            return (true, 0) if nodes[callee].kind != "ident"
            proof_kernel_replay_witness_marker_kind_with_work(nodes[callee].name, work_used, work_limit)

        def proof_kernel_replay_witness_marker_kind_with_work(name: sview, work_used: mutable usize&, work_limit: usize) -> (complete: bool, kind: usize):
            return (false, 0) if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, name, "__elisa_untrusted_operator_type", work_limit)
            return (true, PROOF_KERNEL_REPLAY_WITNESS_UNTRUSTED_OPERATOR) if name == "__elisa_untrusted_operator_type"
            return (false, 0) if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, name, "__elisa_primitive_scalar_type", work_limit)
            return (true, PROOF_KERNEL_REPLAY_WITNESS_PRIMITIVE_SCALAR) if name == "__elisa_primitive_scalar_type"
            return (false, 0) if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, name, "__elisa_primitive_integer_type", work_limit)
            return (true, PROOF_KERNEL_REPLAY_WITNESS_PRIMITIVE_INTEGER) if name == "__elisa_primitive_integer_type"
            return (false, 0) if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, name, "__elisa_unsigned_type_bound", work_limit)
            return (true, PROOF_KERNEL_REPLAY_WITNESS_UNSIGNED_TYPE) if name == "__elisa_unsigned_type_bound"
            return (false, 0) if not proof_kernel_replay_scalar_witness_charge_text_pair(work_used, name, "__elisa_primitive_scalar_element", work_limit)
            return (true, PROOF_KERNEL_REPLAY_WITNESS_SCALAR_ELEMENT) if name == "__elisa_primitive_scalar_element"
            (true, 0)
