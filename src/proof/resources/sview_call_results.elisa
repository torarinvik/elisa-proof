# Tracking of sview results returned by calls: whether a call's view result has a linked
# provenance, and recording such a result as a resource of the statement that binds it.
extend ElisaProof:
    private:
        # Normal calls need a kernel-linked return marker; their argument reads are not
        # interchangeable provenance witnesses. The builtin conversion has a direct receiver.
        def proof_resource_sview_return_call_has_unlinked_provenance(expression: Ast::Expr, functions: ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return not proof_resource_builtin_sview_conversion(expression, functions, report, depth).known
                Ast::Expr.Paren(inner, _):
                    return proof_resource_sview_return_call_has_unlinked_provenance(inner, functions, report, depth + 1)
                _:
                    return false

        def proof_resource_sview_return_call_name(expression: Ast::Expr, functions: ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> sview:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return ""
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    return proof_callable_name(callee) if not proof_resource_builtin_sview_conversion(expression, functions, report, depth).known
                Ast::Expr.Paren(inner, _):
                    return proof_resource_sview_return_call_name(inner, functions, report, depth + 1)
                _:
                    pass
            return ""

        def proof_resource_sview_return_call_function_index(expression: Ast::Expr, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> usize:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return functions.lookup.source.names.count
            return functions.lookup.source.names.count if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    return functions.lookup.source.names.count if proof_resource_builtin_sview_conversion(expression, functions, report, depth).known
                    return proof_function_index_for_callee(functions, callee)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_sview_return_call_function_index(inner, functions, report, depth + 1)
                _:
                    pass
            functions.lookup.source.names.count

        # Install a by-value sview call result as a shared borrow of the exact actual place
        # selected by the callee's resource-return summary. The kernel repeats this mapping and
        # checks the callee witness before accepting the result event.
        def proof_resource_add_sview_call_result[@s, @r](statement_name: sview, type_expression: Ast::Expr, initializer: Ast::Expr, source_region: sview, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: mutable ProofFunctionTable&) -> void can[Global{Read,Write}]:
            source: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool) = proof_resource_call_result_sview_source_actual(initializer, state, functions, report)
            type_root: (known: bool, root: usize) = proof_resource_encode_expression(type_expression, report)
            exact_sview_type: mutable bool = false
            if type_root.known and type_root.root < report.analysis_1.kernel.nodes.count:
                type_node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[type_root.root]
                exact_sview_type <- type_node.kind == "ident" and type_node.name == "sview"
            target_slot: mutable usize = source.slot
            target_place: mutable ProofResourcePlace = source.place
            source_valid: mutable bool = source.known
            if source_valid:
                if source.slot < state.borrows.borrow_present.count:
                    if state.borrows.borrow_present[source.slot]:
                        if source.slot < state.borrows.borrow_target_slots.count and source.slot < state.borrows.borrow_target_places.count:
                            target_slot <- state.borrows.borrow_target_slots[source.slot]
                            target_place <- state.borrows.borrow_target_places[source.slot]
                        else:
                            source_valid <- false
            source_region_matches: bool = source.slot < state.bindings.binding_region.count and proof_resource_binding_region(state, source.slot) == source_region
            target_region_matches: bool = target_slot < state.bindings.binding_region.count and proof_resource_binding_region(state, target_slot) == source_region
            source_live: bool = source.slot < state.bindings.binding_region_live.count and proof_resource_binding_region_is_live(state, source.slot) and not proof_resource_binding_is_moved(state, source.slot)
            target_live: bool = target_slot < state.bindings.binding_region_live.count and proof_resource_binding_region_is_live(state, target_slot) and not proof_resource_binding_is_moved(state, target_slot)
            call_name: mutable sview = ""
            match initializer:
                Ast::Expr.Call(callee, _, _, _):
                    call_name <- proof_callable_name(callee)
                _:
                    pass
            call_event: usize = state.evidence.trace_events[state.evidence.trace_events.count - 1] if state.evidence.trace_events.count > 0 else report.analysis_1.kernel.nodes.count
            call_event_valid: mutable bool = false
            if call_event < report.analysis_1.kernel.nodes.count:
                call_event_node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[call_event]
                call_event_valid <- call_event_node.kind == "resource-call" and call_event_node.name == call_name
            borrow_except: usize = source.slot if source.is_reference and source.mutable_reference else state.bindings.binding_names.count
            borrow_conflict: bool = source_valid and (proof_resource_has_mutable_borrow_overlap(state, report, target_place, borrow_except) can Global{Read,Write})
            valid: bool = statement_name != "" and source_valid and source.place.whole and target_place.root != "" and target_place.whole and exact_sview_type and source_region != "" and proof_resource_region_is_active(state, source_region) and source_region_matches and target_region_matches and source_live and target_live and not borrow_conflict and call_event_valid
            if not valid:
                proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a returned sview requires a replayed region-tied return witness and a live, unconflicted caller place")
                proof_resource_add_binding(state, statement_name, false, false, false, state.bindings.binding_names.count, false, proof_resource_empty_place())
                return
            proof_resource_add_binding(state, statement_name, false, false, false, target_slot, false, target_place)
            result_slot: usize = state.bindings.binding_names.count - 1
            state.bindings.binding_region[result_slot] <- source_region
            state.bindings.binding_region_live[result_slot] <- true
            state.bindings.binding_region_owner[result_slot] <- false
            state.bindings.binding_borrowable[result_slot] <- true
            state.borrows.borrow_target_slots[result_slot] <- target_slot
            state.borrows.borrow_target_places[result_slot] <- target_place
            state.borrows.borrow_mutable[result_slot] <- false
            state.borrows.borrow_present[result_slot] <- true
            proof_resource_record_sview_call_result(state, report, call_event, type_root.root, statement_name, source_region)
