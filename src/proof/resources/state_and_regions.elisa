extend ElisaProof:
    private:
        const PROOF_RESOURCE_WRITABLE_FLAG: usize = 1
        const PROOF_RESOURCE_REFERENCE_FLAG: usize = 2
        const PROOF_RESOURCE_MUTABLE_REFERENCE_FLAG: usize = 4
        const PROOF_RESOURCE_BORROWABLE_FLAG: usize = 8
        const PROOF_RESOURCE_SVIEW_BORROW_FLAG: usize = 16
        const PROOF_RESOURCE_EXPLICIT_REGION_DESTROY: usize = 1
        const PROOF_RESOURCE_JOIN_MOVE_SLOT_LIMIT: usize = 65536

        struct ProofResourcePlace:
            root: sview
            # Exact named-field path into the report's source-neutral kernel arena. Indexes are
            # intentionally structural rather than hashed and are widened to a whole-root place
            # only for dynamic selectors.
            path_root: usize
            depth: usize
            whole: bool
            # Diagnostic precision only; widened places still conservatively deny access.
            exact: bool

        struct ProofResourceContext:
            function_name: mutable sview
            generic_declaration_line: mutable u32
            generic_declaration_owner_offset: mutable u32
            formal_count: mutable usize
            # Formal types stay fixed through branch snapshots, avoiding repeated source scans.
            formal_parameter_types: mutable darray[Ast::Expr]
            formal_scalar_reference_index_values: mutable darray[bool]
            # Expression recursion has its own per-snapshot bound, independent of statement work.
            expression_depth: mutable usize

        def proof_resource_context_empty() -> ProofResourceContext:
            return ProofResourceContext{
                function_name: "",
                generic_declaration_line: 0,
                generic_declaration_owner_offset: 0,
                formal_count: 0,
                formal_parameter_types: [],
                formal_scalar_reference_index_values: [],
                expression_depth: 0,
            }

        struct ProofResourceBindings:
            binding_names: mutable darray[sview]
            # Arena root of the source-authenticated bind event for each slot. Uses carry this
            # identity so replay cannot redirect a same-spelled identifier to another scope.
            binding_event_roots: mutable darray[usize]
            # Locals from inferred first bindings; a later non-writable `=` shadows one.
            inferred_names: mutable darray[sview]
            binding_reference: mutable darray[bool]
            binding_mutable_reference: mutable darray[bool]
            binding_type_marker_complete: mutable darray[bool]
            binding_writable: mutable darray[bool]
            binding_moved: mutable darray[bool]
            # A non-empty region label means the binding's value carries storage owned by that
            # lexical region. Region values are tracked separately from ordinary borrows: they
            # may be used while the region is active, but cannot cross its closing boundary.
            binding_region: mutable darray[sview]
            # Liveness is separate so destroy/reopen of the same label cannot revive an old binding.
            binding_region_live: mutable darray[bool]
            # Diagnostic evidence only: false liveness can also mean unsupported provenance.
            binding_region_destroyed: mutable darray[bool]
            # A direct `new[r]` binding carries the exclusive owner token for its allocation.
            # This is distinct from a borrowed or externally supplied reference: only the former
            # may be re-exposed as a mutable reference when the source type lacks that marker.
            # Region aliases transfer this token instead of copying it, so one allocation cannot
            # mint multiple independently writable capabilities.
            binding_region_owner: mutable darray[bool]
            # A binding declared with a scalar primitive type holds a copied value. Reading a
            # scalar out of a region-owned value does not tie the binding to that region, so
            # region propagation skips these bindings on declaration and assignment.
            binding_scalar: mutable darray[bool]
            # Non-scalar bindings have addressable storage and may be implicitly shared-borrowed
            # when passed to a `T&` formal. Keep this separate from `binding_extent`: collection
            # extent tracking is about the special scalar `.count` projection, while this bit
            # covers structs and other aggregate values whose storage the callee may observe.
            binding_borrowable: mutable darray[bool]
            # A binding whose declared type is a collection. Its `.count` is the element count,
            # a machine integer copied out of the collection, so reading it ties nothing to the
            # collection's lifetime -- which is what lets a region-polymorphic function state a
            # bounds contract over its own parameter.
            binding_extent: mutable darray[bool]
            binding_darray: mutable darray[bool]

        def proof_resource_bindings_empty() -> ProofResourceBindings:
            return ProofResourceBindings{
                binding_names: [],
                binding_event_roots: [],
                inferred_names: [],
                binding_reference: [],
                binding_mutable_reference: [],
                binding_type_marker_complete: [],
                binding_writable: [],
                binding_moved: [],
                binding_region: [],
                binding_region_live: [],
                binding_region_destroyed: [],
                binding_region_owner: [],
                binding_scalar: [],
                binding_borrowable: [],
                binding_extent: [],
                binding_darray: [],
            }

        struct ProofResourceRegions:
            active_regions: mutable darray[cstr]
            # Nested snapshots inherit these region identities. A child may not destroy an
            # inherited region and reopen the same spelling, because the parent would otherwise
            # continue with a different lifetime after the child joins.
            protected_regions: mutable darray[cstr]
            # Region parameters are caller-owned capabilities. They remain active across the
            # callee's return and therefore must not be closed by proof_resource_finish.
            external_regions: mutable darray[sview]
            # A by-value `sview @r` formal borrows an unknown place within the region. Until
            # the language carries a finer pointee-place witness, this shared borrow conservatively
            # conflicts with every write in @r for the duration of the function.
            region_wide_borrows: mutable darray[sview]

        def proof_resource_regions_empty() -> ProofResourceRegions:
            return ProofResourceRegions{
                active_regions: [],
                protected_regions: [],
                external_regions: [],
                region_wide_borrows: [],
            }

        struct ProofResourceStatics:
            # The function's module path and the immutable constants declared directly in it:
            # what a bare, unbound name in a value operand can denote. See encode_value.
            static_scope: mutable darray[sview]
            static_names: mutable darray[sview]
            static_root_names: mutable darray[sview]

        def proof_resource_statics_empty() -> ProofResourceStatics:
            return ProofResourceStatics{
                static_scope: [],
                static_names: [],
                static_root_names: [],
            }

        struct ProofResourceBorrows:
            borrow_target_slots: mutable darray[usize]
            borrow_target_places: mutable darray[ProofResourcePlace]
            borrow_mutable: mutable darray[bool]
            borrow_present: mutable darray[bool]

        def proof_resource_borrows_empty() -> ProofResourceBorrows:
            return ProofResourceBorrows{
                borrow_target_slots: [],
                borrow_target_places: [],
                borrow_mutable: [],
                borrow_present: [],
            }

        struct ProofResourceEvidence:
            # The resource pass receives a snapshot of the logical entry facts. It may use those
            # facts only for explicit symbolic-index separation; assignments and calls clear the
            # snapshot before it can become stale.
            facts: mutable darray[Ast::Expr]
            # The trace is a flat list of source-neutral transition roots. Nested lexical states
            # are wrapped in resource-scope nodes when their snapshots are closed.
            trace_events: mutable darray[usize]

        def proof_resource_evidence_empty() -> ProofResourceEvidence:
            return ProofResourceEvidence{
                facts: [],
                trace_events: [],
            }

        # Each component is copied into destination-owned storage by proof_resource_copy_into.
        struct ProofResourceState:
            context: mutable ProofResourceContext
            bindings: mutable ProofResourceBindings
            regions: mutable ProofResourceRegions
            statics: mutable ProofResourceStatics
            borrows: mutable ProofResourceBorrows
            evidence: mutable ProofResourceEvidence

        def proof_resource_empty() -> ProofResourceState:
            return ProofResourceState{
                context: proof_resource_context_empty(),
                bindings: proof_resource_bindings_empty(),
                regions: proof_resource_regions_empty(),
                statics: proof_resource_statics_empty(),
                borrows: proof_resource_borrows_empty(),
                evidence: proof_resource_evidence_empty(),
            }

        def proof_resource_kernel_capacity(report: mutable ProofReport&, node_count: usize, child_count: usize, name: sview) -> bool:
            return false if:
                report.analysis_1.kernel.budget_exhausted
                report.analysis_1.kernel.nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.analysis_1.kernel.children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET
                node_count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET - report.analysis_1.kernel.nodes.count
                child_count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET - report.analysis_1.kernel.children.count
            return true

        def proof_resource_record_event[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, kind: sview, operator: sview, left: usize, name: sview, secondary_name: sview, auxiliary: usize) -> void:
            if not proof_resource_kernel_capacity(report, 1, 0, name):
                proof_kernel_budget_note(report, name)
                return
            event: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, kind, operator, left, 0, auxiliary, 0, 0, 0, name, secondary_name)
            if event >= report.analysis_1.kernel.nodes.count:
                proof_kernel_budget_note(report, name)
                return
            state.evidence.trace_events.push(event)

        def proof_resource_record_event_at_position[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, kind: sview, operator: sview, left: usize, name: sview, secondary_name: sview, auxiliary: usize, position: Ast::Pos) -> void:
            event_count: usize = state.evidence.trace_events.count
            proof_resource_record_event(state, report, kind, operator, left, name, secondary_name, auxiliary)
            return if state.evidence.trace_events.count != event_count + 1
            event: usize = state.evidence.trace_events[event_count]
            return if event >= report.analysis_1.kernel.nodes.count
            report.analysis_1.kernel.nodes[event].value <- -1 if position.offset > 4294967295
            report.analysis_1.kernel.nodes[event].value <- position.offset.i64() if position.offset <= 4294967295

        def proof_resource_record_event_at_end_position[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, kind: sview, position: Ast::Pos) -> void:
            event_count: usize = state.evidence.trace_events.count
            proof_resource_record_event(state, report, kind, "", 0, "", "", 0)
            return if state.evidence.trace_events.count != event_count + 1
            event: usize = state.evidence.trace_events[event_count]
            return if event >= report.analysis_1.kernel.nodes.count
            report.analysis_1.kernel.nodes[event].value <- -1 if position.end_offset > 4294967295
            report.analysis_1.kernel.nodes[event].value <- position.end_offset.i64() if position.end_offset <= 4294967295

        def proof_resource_clear_facts_at_position[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, position: Ast::Pos) -> void:
            state.evidence.facts.clear()
            proof_resource_record_event_at_end_position(state, report, "resource-facts-clear", position)

        def proof_resource_close_child[@parent, @child, @r](parent: mutable ProofResourceState& @parent, child: ProofResourceState& @child, report: mutable ProofReport& @r, join_moves: bool) -> void:
            return if report.analysis_1.kernel.budget_exhausted
            if parent.bindings.binding_names.count != parent.bindings.binding_moved.count or child.bindings.binding_names.count != child.bindings.binding_moved.count or child.bindings.binding_moved.count < parent.bindings.binding_moved.count:
                report.source_types.source_effect_index.work.implicit_effect_work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return
            return if:
                join_moves and not proof_source_index_work_charge(report, parent.bindings.binding_moved.count)
                join_moves and not proof_source_index_work_charge(report, parent.bindings.binding_moved.count)
                not proof_source_index_work_charge(report, child.evidence.trace_events.count)
                not proof_source_index_work_charge(report, child.evidence.trace_events.count)
            join_count: mutable usize = 0
            if join_moves:
                for index in 0..<parent.bindings.binding_moved.count |index, parent, child, join_count|:
                    return if index >= parent.bindings.binding_names.count or index >= child.bindings.binding_moved.count
                    if child.bindings.binding_moved[index] and not parent.bindings.binding_moved[index] and index >= PROOF_RESOURCE_JOIN_MOVE_SLOT_LIMIT:
                        proof_kernel_budget_note(report, "")
                        return
                    join_count <- join_count + 1 if child.bindings.binding_moved[index] and not parent.bindings.binding_moved[index]
            if not proof_resource_kernel_capacity(report, 1 + join_count, child.evidence.trace_events.count, ""):
                proof_kernel_budget_note(report, "")
                return
            start: usize = report.analysis_1.kernel.children.count
            for event in child.evidence.trace_events |event, report|:
                if event >= report.analysis_1.kernel.nodes.count:
                    proof_kernel_budget_note(report, "")
                    return
            for event in child.evidence.trace_events |event, report|:
                report.analysis_1.kernel.children.push(event)
            scope_root: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "resource-scope", "", 0, 0, 0, start, child.evidence.trace_events.count, 0, "", "")
            if scope_root >= report.analysis_1.kernel.nodes.count:
                report.analysis_1.kernel.children <- report.analysis_1.kernel.children.truncate(start)
                proof_kernel_budget_note(report, "")
                return
            parent.evidence.trace_events.push(scope_root)
            if join_moves:
                for index in 0..<parent.bindings.binding_moved.count |index, parent, child|:
                    return if index >= parent.bindings.binding_names.count or index >= child.bindings.binding_moved.count
                    if child.bindings.binding_moved[index] and not parent.bindings.binding_moved[index]:
                        if index >= PROOF_RESOURCE_JOIN_MOVE_SLOT_LIMIT:
                            proof_kernel_budget_note(report, "")
                            return
                        parent.bindings.binding_moved[index] <- true
                        # Carry the exact parent slot. Names can be shadowed, so replaying a join
                        # by name alone could mark the wrong binding as moved.
                        join_root: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "resource-join-move", "", 0, 0, index, 0, 0, 0, parent.bindings.binding_names[index], "")
                        if join_root >= report.analysis_1.kernel.nodes.count:
                            proof_kernel_budget_note(report, "")
                            return
                        parent.evidence.trace_events.push(join_root)

        def proof_resource_add_binding_traced[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, name: sview, is_reference: bool, is_mutable_reference: bool, is_writable: bool, target_slot: usize, borrow_is_mutable: bool, source_name: sview, source_place: ProofResourcePlace, source_place_root: usize) -> void:
            proof_resource_add_binding(state, name, is_reference, is_mutable_reference, is_writable, target_slot, borrow_is_mutable, source_place)
            event_count: usize = state.evidence.trace_events.count
            operator: mutable sview = "value"
            if is_reference:
                operator <- "mutable" if borrow_is_mutable and source_name != ""
                operator <- "shared" if not borrow_is_mutable and source_name != ""
                operator <- "external-mutable" if is_mutable_reference and source_name == ""
                operator <- "external-shared" if not is_mutable_reference and source_name == ""
            proof_resource_record_event(state, report, "resource-bind", operator, source_place_root if operator in {"shared", "mutable"} else 0, name, source_name, 1 if is_writable else 0)
            if state.evidence.trace_events.count == event_count + 1 and state.bindings.binding_event_roots.count == state.bindings.binding_names.count:
                slot: usize = state.bindings.binding_names.count - 1
                state.bindings.binding_event_roots[slot] <- state.evidence.trace_events[event_count]

        # A source binding enters resource state after its initializer or iterable is checked.
        # Record that expression's end offset so replay cannot place the bind before a move/use
        # performed while evaluating it. Local declarations pass their statement end position.
        def proof_resource_add_binding_traced_at_position[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, name: sview, is_reference: bool, is_mutable_reference: bool, is_writable: bool, target_slot: usize, borrow_is_mutable: bool, source_name: sview, source_place: ProofResourcePlace, source_place_root: usize, position: Ast::Pos) -> void:
            event_count: usize = state.evidence.trace_events.count
            proof_resource_add_binding_traced(state, report, name, is_reference, is_mutable_reference, is_writable, target_slot, borrow_is_mutable, source_name, source_place, source_place_root)
            return if state.evidence.trace_events.count != event_count + 1
            event: usize = state.evidence.trace_events[event_count]
            return if event >= report.analysis_1.kernel.nodes.count
            report.analysis_1.kernel.nodes[event].value <- -1 if position.end_offset > 4294967295
            report.analysis_1.kernel.nodes[event].value <- position.end_offset.i64() if position.end_offset <= 4294967295

        # Region-owned values use their own transition forms. Treating `new[r] x` as an
        # external reference would let a certificate forget which lexical lifetime owns the
        # allocation, so the trusted replay state carries the region label explicitly.
        def proof_resource_region_is_active(state: ProofResourceState&, region: sview) -> bool:
            return false if region == ""
            index: mutable usize = state.regions.active_regions.count
            while index > 0 |index, state, region|:
                index <- index - 1
                return true if string_view_eq(region, state.regions.active_regions[index]) != 0
            return false

        def proof_resource_region_is_external(state: ProofResourceState&, region: sview) -> bool:
            return any external in state.regions.external_regions where external == region

        def proof_resource_region_is_protected(state: ProofResourceState&, region: sview) -> bool:
            return any protected in state.regions.protected_regions where string_view_eq(region, protected) != 0

        # Mark the active region identities inherited by a child snapshot before its body is
        # checked. This is separate from external-region status: ordinary lexical regions are
        # also protected from child destruction, even when they have no live binding yet.
        def proof_resource_mark_scope_inherited(parent: ProofResourceState&, child: mutable ProofResourceState&) -> void:
            for region in parent.regions.active_regions |region, child|:
                child.regions.protected_regions.push(region) if not any prior in child.regions.protected_regions where prior == region

        # Attach the explicit `@r` lifetime of a formal reference parameter to both the source
        # state and its serialized bind node. Keeping it on the bind node lets independent replay
        # validate the same region relation without consulting the AST or the producer tables.
        def proof_resource_set_binding_region(state: mutable ProofResourceState&, report: mutable ProofReport&, name: sview, region: sview) -> void:
            return if name == "" or region == ""
            binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
            return if not binding.complete
            slot: usize = binding.slot
            return if slot >= state.bindings.binding_names.count
            state.bindings.binding_region[slot] <- region
            state.bindings.binding_region_live[slot] <- proof_resource_region_is_active(state, region)
            return if state.evidence.trace_events.count == 0
            event: usize = state.evidence.trace_events[state.evidence.trace_events.count - 1]
            return if event >= report.analysis_1.kernel.nodes.count
            return if report.analysis_1.kernel.nodes[event].kind != "resource-bind"
            return if report.analysis_1.kernel.nodes[event].name != name
            report.analysis_1.kernel.nodes[event].secondary_name <- region

        # Persist the aggregate-storage capability on the last bind event. This keeps the
        # producer and the independent resource replay in agreement for ordinary bindings,
        # region allocations, and region aliases without widening any unrelated event shape.
        def proof_resource_set_binding_borrowable(state: mutable ProofResourceState&, report: mutable ProofReport&, name: sview, borrowable: bool) -> void:
            return if name == "" or not borrowable
            binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
            return if not binding.complete
            slot: usize = binding.slot
            return if slot >= state.bindings.binding_names.count or slot >= state.bindings.binding_borrowable.count
            state.bindings.binding_borrowable[slot] <- true
            return if state.evidence.trace_events.count == 0
            event: usize = state.evidence.trace_events[state.evidence.trace_events.count - 1]
            return if event >= report.analysis_1.kernel.nodes.count or report.analysis_1.kernel.nodes[event].name != name
            kind: sview = report.analysis_1.kernel.nodes[event].kind
            return if kind != "resource-bind" and kind != "resource-region-alloc" and kind != "resource-region-bind"
            return if kind == "resource-bind" and report.analysis_1.kernel.nodes[event].operator != "value"
            return if kind != "resource-bind" and (report.analysis_1.kernel.nodes[event].auxiliary & PROOF_RESOURCE_REFERENCE_FLAG) != 0
            report.analysis_1.kernel.nodes[event].auxiliary <- report.analysis_1.kernel.nodes[event].auxiliary + PROOF_RESOURCE_BORROWABLE_FLAG if (report.analysis_1.kernel.nodes[event].auxiliary & PROOF_RESOURCE_BORROWABLE_FLAG) == 0

        def proof_resource_binding_region[@r](state: ProofResourceState& @r, slot: usize) -> sview @r:
            return state.bindings.binding_region[slot] if slot < state.bindings.binding_region.count
            return ""

        def proof_resource_binding_region_is_live(state: ProofResourceState&, slot: usize) -> bool:
            return slot < state.bindings.binding_region_live.count and state.bindings.binding_region_live[slot]

        def proof_resource_report_unavailable_region(state: ProofResourceState&, slot: usize, report: mutable ProofReport&, position: Ast::Pos, function_name: sview) -> void:
            if slot < state.bindings.binding_region_destroyed.count and state.bindings.binding_region_destroyed[slot]:
                proof_resource_add_failing_obligation(report, "region-use-after-destroy", position, function_name, "a region-owned binding is accessed after its region was destroyed")
            else:
                proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "the binding's backing-region lifetime was not established; destruction has not been demonstrated")

        def proof_resource_region_has_live_borrow(state: ProofResourceState&, report: mutable ProofReport&, region: sview) -> bool:
            for borrowed in state.regions.region_wide_borrows |borrowed, region, report|:
                return true if not proof_source_index_work_charge(report, 1) or not proof_source_index_work_charge(report, sview_len(borrowed)) or not proof_source_index_work_charge(report, sview_len(region))
                return true if borrowed == region
            return true if not proof_source_index_work_charge(report, state.borrows.borrow_present.count)
            for slot in 0..<state.borrows.borrow_present.count |slot, state, region, report|:
                if state.borrows.borrow_present[slot]:
                    return true if slot >= state.bindings.binding_region.count or slot >= state.bindings.binding_moved.count or slot >= state.borrows.borrow_target_slots.count
                    if not state.bindings.binding_moved[slot] and state.bindings.binding_region[slot] == region:
                        target_slot: usize = state.borrows.borrow_target_slots[slot]
                        return true if:
                            target_slot >= state.bindings.binding_region.count or target_slot >= state.bindings.binding_region_live.count
                            state.bindings.binding_region[target_slot] == region and state.bindings.binding_region_live[target_slot]
            return false

        def proof_resource_invalidate_region_bindings(state: mutable ProofResourceState&, report: mutable ProofReport&, region: sview) -> void:
            return if not proof_source_index_work_charge(report, state.bindings.binding_region.count)
            for index in 0..<state.bindings.binding_region.count |index, state, region|:
                if index < state.bindings.binding_region_live.count and state.bindings.binding_region[index] == region:
                    if state.bindings.binding_region_live[index] and index < state.bindings.binding_region_destroyed.count:
                        state.bindings.binding_region_destroyed[index] <- true
                    state.bindings.binding_region_live[index] <- false

        # Close a named region in the same state in which it was opened. The compiler's flat
        # `region r(size)` form keeps the owner live across following statements, so its close
        # must be a real stack transition rather than the end of a synthetic child scope.
        def proof_resource_close_named_region[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, region: sview, position: Ast::Pos, function_name: sview) -> void:
            innermost: bool = region != "" and not proof_resource_region_is_external(state, region) and not proof_resource_region_is_protected(state, region) and state.regions.active_regions.count > 0 and string_view_eq(region, state.regions.active_regions[state.regions.active_regions.count - 1]) != 0
            live_borrow: bool = innermost and proof_resource_region_has_live_borrow(state, report, region)
            valid: bool = innermost and not live_borrow
            proof_resource_add_failing_obligation(report, "region-destroy-unsupported", position, function_name, "destroy must name the innermost active tracked region") if not innermost
            proof_resource_add_failing_obligation(report, "region-destroy-live-borrow", position, function_name, "a region cannot be destroyed while a borrowed view or reference to it is still live") if live_borrow
            if valid:
                state.regions.active_regions <- state.regions.active_regions.truncate(state.regions.active_regions.count - 1)
                proof_resource_invalidate_region_bindings(state, report, region)
                proof_resource_record_event_at_position(state, report, "resource-region-close", "", 0, region, "", PROOF_RESOURCE_EXPLICIT_REGION_DESTROY, position)

        def proof_resource_add_region_allocation[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, name: sview, type_expression: Ast::Expr, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> void:
            marker_summary: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(type_expression, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, state.context.generic_declaration_line, state.context.generic_declaration_owner_offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work)
            is_reference: bool = marker_summary.reference
            is_mutable_reference: bool = marker_summary.mutable_reference
            writable: bool = is_mutable_reference or marker_summary.is_mutable
            encoded_value: (known: bool, root: usize) = proof_resource_encode_value(operand, state, report)
            encoded: usize = encoded_value.root
            operand_has_region: bool = proof_resource_expr_contains_region_value(operand, state, report)
            valid: mutable bool = encoded_value.known and marker_summary.complete
            valid <- proof_resource_region_is_active(state, region) if valid
            valid <- not operand_has_region if valid
            valid <- report.analysis_1.kernel.nodes[encoded].kind != "unsupported" if valid
            proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region allocation operand contains a value whose lifetime is not summarized") if operand_has_region
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "region allocation requires an active lexical region and a kernel-replayable operand") if not valid and not operand_has_region
            proof_resource_add_binding(state, name, is_reference, is_mutable_reference, writable, state.bindings.binding_names.count, false, proof_resource_empty_place())
            state.bindings.binding_region[state.bindings.binding_region.count - 1] <- region
            state.bindings.binding_region_live[state.bindings.binding_region_live.count - 1] <- valid
            state.bindings.binding_region_owner[state.bindings.binding_region_owner.count - 1] <- valid
            if valid:
                event_count: usize = state.evidence.trace_events.count
                proof_resource_record_event_at_position(state, report, "resource-region-alloc", "", encoded, name, region, (PROOF_RESOURCE_WRITABLE_FLAG if writable else 0) + (PROOF_RESOURCE_REFERENCE_FLAG if is_reference else 0) + (PROOF_RESOURCE_MUTABLE_REFERENCE_FLAG if is_mutable_reference else 0), position)
                if state.evidence.trace_events.count == event_count + 1 and state.bindings.binding_event_roots.count == state.bindings.binding_names.count:
                    slot: usize = state.bindings.binding_names.count - 1
                    state.bindings.binding_event_roots[slot] <- state.evidence.trace_events[event_count]

        # A discarded `new[r] value` still performs a real allocation into @r. Keep it in the
        # trace without inventing a user-visible binding: the replay kernel validates the
        # operand and active region, then deliberately leaves no value available after the
        # expression statement.
        def proof_resource_add_region_discard[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> void:
            encoded_value: (known: bool, root: usize) = proof_resource_encode_value(operand, state, report)
            encoded: usize = encoded_value.root
            operand_has_region: bool = proof_resource_expr_contains_region_value(operand, state, report)
            valid: mutable bool = encoded_value.known
            valid <- proof_resource_region_is_active(state, region) if valid
            valid <- not operand_has_region if valid
            valid <- report.analysis_1.kernel.nodes[encoded].kind != "unsupported" if valid
            proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region allocation operand contains a value whose lifetime is not summarized") if operand_has_region
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "region allocation requires an active lexical region and a kernel-replayable operand") if not valid and not operand_has_region
            proof_resource_record_event_at_position(state, report, "resource-region-alloc-discard", "", encoded, "", region, 0, position) if valid

        def proof_resource_add_region_return_alloc[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> usize:
            encoded_value: (known: bool, root: usize) = proof_resource_encode_value(operand, state, report)
            encoded: usize = encoded_value.root
            operand_has_region: bool = proof_resource_expr_contains_region_value(operand, state, report)
            valid: mutable bool = encoded_value.known
            valid <- proof_resource_region_is_active(state, region) if valid
            valid <- not operand_has_region if valid
            valid <- report.analysis_1.kernel.nodes[encoded].kind != "unsupported" if valid
            proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "a returned region allocation operand contains a value whose lifetime is not summarized") if operand_has_region
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "a returned region allocation requires an active lifetime and a kernel-replayable operand") if not valid and not operand_has_region
            if valid:
                proof_resource_record_event_at_position(state, report, "resource-region-return-alloc", "", encoded, "", region, 0, position)
                event_root: usize = state.evidence.trace_events[state.evidence.trace_events.count - 1]
                return event_root
            node_count: usize = report.analysis_1.kernel.nodes.count
            return node_count

        def proof_resource_rebind_region_allocation[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, target: Ast::Expr, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> void can[Global{Read,Write}]:
            target_name: sview = proof_resource_direct_binding_name(target, report)
            target_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, target_name, report)
            target_slot: usize = target_binding.slot
            encoded_value: (known: bool, root: usize) = proof_resource_encode_value(operand, state, report)
            encoded: usize = encoded_value.root
            operand_has_region: bool = proof_resource_expr_contains_region_value(operand, state, report)
            target_is_reference: bool = target_slot < state.bindings.binding_reference.count and state.bindings.binding_reference[target_slot]
            target_access: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(target, report)
            valid: mutable bool = encoded_value.known
            valid <- target_name != "" and not proof_resource_is_discard_target(target, report) and not operand_has_region if valid
            valid <- target_access.known if valid
            valid <- target_slot < state.bindings.binding_names.count if valid
            valid <- proof_resource_binding_is_writable(state, target_slot) if valid
            valid <- target_slot < state.bindings.binding_moved.count if valid
            valid <- not state.bindings.binding_moved[target_slot] if valid
            valid <- target_slot < state.borrows.borrow_present.count if valid
            valid <- not state.borrows.borrow_present[target_slot] if valid
            valid <- not (proof_resource_has_borrow_overlap(state, report, target_access.place, state.bindings.binding_names.count) can Global{Read,Write}) if valid
            valid <- proof_resource_region_is_active(state, region) if valid
            valid <- target_is_reference if valid
            valid <- report.analysis_1.kernel.nodes[encoded].kind != "unsupported" if valid
            proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region allocation operand contains a value whose lifetime is not summarized") if operand_has_region
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "new[r] produces a region reference and requires a reference-bearing destination") if not target_is_reference
            proof_resource_add_failing_obligation(report, "region-store-escape", position, function_name, "a region allocation may be assigned only to a directly tracked live binding without an active borrow handle") if not valid and not operand_has_region and target_is_reference
            if valid:
                state.bindings.binding_region[target_slot] <- region
                state.bindings.binding_region_live[target_slot] <- true
                state.bindings.binding_region_destroyed[target_slot] <- false
                state.bindings.binding_region_owner[target_slot] <- true
                proof_resource_record_event_at_position(state, report, "resource-region-rebind-alloc", "", encoded, target_name, region, 0, position)

        def proof_resource_add_region_binding[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, name: sview, type_expression: Ast::Expr, source: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview, functions: ProofFunctionTable&) -> void can[Global{Read,Write}]:
            marker_summary: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(type_expression, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, state.context.generic_declaration_line, state.context.generic_declaration_owner_offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work)
            is_reference: bool = marker_summary.reference
            is_mutable_reference: bool = marker_summary.mutable_reference
            sview_conversion: (known: bool, receiver: Ast::Expr) = proof_resource_builtin_sview_conversion(source, functions, report, 0)
            is_borrowed_sview: bool = proof_resource_type_may_contain_sview(type_expression, functions.type_indexes.type_audit_index, &report.source_types.source_effect_index.work.implicit_effect_work) or sview_conversion.known
            writable: bool = is_mutable_reference or marker_summary.is_mutable
            source_place_expression: mutable Ast::Expr = source
            source_place_expression <- sview_conversion.receiver if sview_conversion.known
            source_place: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(source_place_expression, report)
            encoded: usize = proof_resource_encode_access_place(source_place_expression, report)
            source_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, source_place.place.root, report)
            source_slot: usize = source_binding.slot
            source_is_reference: bool = source_slot < state.bindings.binding_reference.count and state.bindings.binding_reference[source_slot]
            source_is_mutable_reference: bool = source_slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[source_slot]
            source_region_owner: bool = source_slot < state.bindings.binding_region_owner.count and state.bindings.binding_region_owner[source_slot]
            source_moved: bool = proof_resource_binding_is_moved(state, source_slot)
            borrow_target_slot: mutable usize = source_slot
            borrow_target_place: mutable ProofResourcePlace = source_place.place
            if is_borrowed_sview and source_slot < state.borrows.borrow_present.count and state.borrows.borrow_present[source_slot]:
                borrow_target_slot <- state.borrows.borrow_target_slots[source_slot]
                borrow_target_place <- state.borrows.borrow_target_places[source_slot]
            view_type_root: mutable usize = 0
            view_type_valid: mutable bool = not is_borrowed_sview
            if is_borrowed_sview:
                view_type_expression: mutable Ast::Expr = type_expression
                if sview_conversion.known and not proof_resource_type_may_contain_sview(type_expression, functions.type_indexes.type_audit_index, &report.source_types.source_effect_index.work.implicit_effect_work):
                    view_type_expression <- Ast::Expr.Ident("sview", position)
                encoded_type: (known: bool, root: usize) = proof_resource_encode_expression(view_type_expression, report)
                view_type_root <- encoded_type.root
                view_type_valid <- encoded_type.known and encoded_type.root < report.analysis_1.kernel.nodes.count and report.analysis_1.kernel.nodes[encoded_type.root].kind == "ident" and report.analysis_1.kernel.nodes[encoded_type.root].name == "sview"
            # A borrowed or external mutable reference has no linear owner token that can be
            # transferred. Copying it through a region alias would therefore manufacture a
            # second mutable capability while leaving the original writable. A direct region
            # owner may be exposed once, but moving that owner is also forbidden while any live
            # borrow overlaps its place.
            mutable_reference_duplication: bool = source_is_reference and source_is_mutable_reference and not source_region_owner and not is_borrowed_sview
            borrow_overlap_except: mutable usize = state.bindings.binding_names.count
            if is_borrowed_sview and source_slot < state.borrows.borrow_present.count and state.borrows.borrow_present[source_slot]:
                borrow_overlap_except <- source_slot
            sview_borrow_overlap: bool = is_borrowed_sview and (proof_resource_has_mutable_borrow_overlap(state, report, borrow_target_place, borrow_overlap_except) can Global{Read,Write})
            owner_borrow_overlap: bool = source_region_owner and not is_borrowed_sview and (proof_resource_has_borrow_overlap(state, report, source_place.place, state.bindings.binding_names.count) can Global{Read,Write})
            valid: bool = marker_summary.complete and proof_resource_region_is_active(state, region) and source_place.known and source_place.place.whole and source_slot < state.bindings.binding_names.count and not source_moved and not mutable_reference_duplication and not sview_borrow_overlap and not owner_borrow_overlap and proof_resource_binding_region(state, source_slot) == region and proof_resource_binding_region_is_live(state, source_slot) and encoded < report.analysis_1.kernel.nodes.count and (not is_borrowed_sview or view_type_valid and borrow_target_slot < state.bindings.binding_names.count and borrow_target_place.root != "") and (is_borrowed_sview or not is_reference and not source_is_reference or is_reference and source_is_reference) and (is_borrowed_sview or not is_reference or is_mutable_reference == source_is_mutable_reference or source_region_owner)
            proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "region value aliases require a live, unmoved whole-binding source with the same tracked region") if not valid
            proof_resource_add_binding(state, name, is_reference, is_mutable_reference, writable, state.bindings.binding_names.count, false, proof_resource_empty_place())
            state.bindings.binding_region[state.bindings.binding_region.count - 1] <- region
            state.bindings.binding_region_live[state.bindings.binding_region_live.count - 1] <- valid
            state.bindings.binding_region_owner[state.bindings.binding_region_owner.count - 1] <- valid and source_region_owner and not is_borrowed_sview
            if valid and is_borrowed_sview:
                new_slot: usize = state.bindings.binding_names.count - 1
                state.borrows.borrow_target_slots[new_slot] <- borrow_target_slot
                state.borrows.borrow_target_places[new_slot] <- borrow_target_place
                state.borrows.borrow_mutable[new_slot] <- false
                state.borrows.borrow_present[new_slot] <- true
            # The owner token is linear even though shared region references may otherwise be
            # copied. Transfer it to the new binding; borrowed/external references have no token
            # and therefore remain ordinary shared aliases.
            proof_resource_mark_binding_moved(state, source_slot) if valid and source_region_owner and not is_borrowed_sview
            event_flags: usize = (PROOF_RESOURCE_WRITABLE_FLAG if writable else 0) + (PROOF_RESOURCE_REFERENCE_FLAG if is_reference else 0) + (PROOF_RESOURCE_MUTABLE_REFERENCE_FLAG if is_mutable_reference else 0)
            if valid:
                event_count: usize = state.evidence.trace_events.count
                proof_resource_record_sview_binding(state, report, encoded, view_type_root, name, region, event_flags) if is_borrowed_sview
                proof_resource_record_event(state, report, "resource-region-bind", "", encoded, name, region, event_flags) if not is_borrowed_sview
                if state.evidence.trace_events.count == event_count + 1 and state.bindings.binding_event_roots.count == state.bindings.binding_names.count:
                    slot: usize = state.bindings.binding_names.count - 1
                    state.bindings.binding_event_roots[slot] <- state.evidence.trace_events[event_count]
