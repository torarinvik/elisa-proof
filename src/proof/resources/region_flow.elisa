extend ElisaProof:
    private:
        def proof_resource_check_write[@s, @r](target: Ast::Expr, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: ProofFunctionTable&) -> void can[Global{Read,Write}]:
            root: sview = proof_resource_place_root(target, report)
            if root == "":
                proof_resource_add_failing_obligation(report, "resource-write-opaque", position, function_name, "a write target without a tracked storage root cannot be checked safely")
                return
            binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, root, report)
            if not binding.complete:
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "resource write root lookup exceeded its shared source-work budget", "resource-source-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            if binding.slot >= state.bindings.binding_names.count:
                proof_resource_add_failing_obligation(report, "resource-write-opaque", position, function_name, "a write to storage outside the tracked function resource frame cannot be checked safely")
                return
            slot: usize = binding.slot
            region: sview = proof_resource_binding_region(state, slot)
            if region != "" and (not proof_resource_binding_region_is_live(state, slot) or not proof_resource_region_is_active(state, region)):
                proof_resource_report_unavailable_region(state, slot, report, position, function_name)
                return
            if proof_resource_binding_is_moved(state, slot):
                proof_resource_add_failing_obligation(report, "resource-use-after-move", position, function_name, "a moved resource is written again")
                return
            if slot >= state.bindings.binding_type_marker_complete.count or not state.bindings.binding_type_marker_complete[slot]:
                proof_resource_add_failing_obligation(report, "resource-write-opaque", position, function_name, "a write through an incompletely classified type cannot be checked safely")
                return
            access: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(target, report)
            is_reference: bool = slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]
            is_mutable_reference: bool = slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]
            conflict: mutable bool = false
            if is_reference and not is_mutable_reference:
                conflict <- true
                proof_resource_add_failing_obligation(report, "borrow-readonly-write", position, function_name, "a write through an immutable reference is not permitted by the proof resource state")
            elif is_mutable_reference and not access.known:
                conflict <- true
                proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "a write through a mutable reference has no directly tracked target place")
            elif is_mutable_reference and (proof_resource_has_borrow_overlap(state, report, access.place, slot) can Global{Read,Write}):
                conflict <- true
                proof_resource_report_borrow_conflict(state, report, access.place, slot, false, "borrow-write-conflict", position, function_name, "a write through a mutable reference overlaps a live borrow")
            elif not is_reference and (proof_resource_has_borrow_overlap(state, report, access.place, state.bindings.binding_names.count) can Global{Read,Write}):
                conflict <- true
                proof_resource_report_borrow_conflict(state, report, access.place, state.bindings.binding_names.count, false, "borrow-write-conflict", position, function_name, "a write to a place overlapping a live borrow is not permitted by the proof resource state")
            elif not is_reference and access.known and access.place.whole and not proof_resource_binding_is_writable(state, slot):
                conflict <- true
                proof_resource_add_failing_obligation(report, "resource-write-readonly", position, function_name, "a whole-binding write requires a mutable resource binding")
            if not conflict:
                access_root: usize = proof_resource_encode_access_place(target, report)
                event_count: usize = state.evidence.trace_events.count
                proof_resource_record_event(state, report, "resource-write", "", access_root, root, "", 0)
                # Bind this mutation witness to its parser-owned assignment/call position so
                # replay can reject a fabricated resource write at another source expression.
                if state.evidence.trace_events.count == event_count + 1:
                    event: usize = state.evidence.trace_events[event_count]
                    if event >= report.analysis_1.kernel.nodes.count:
                        proof_kernel_budget_note(report, function_name)
                        return
                    report.analysis_1.kernel.nodes[event].value <- -1 if position.offset > 4294967295
                    report.analysis_1.kernel.nodes[event].value <- position.offset.i64() if position.offset <= 4294967295
                    if slot < state.bindings.binding_event_roots.count:
                        bind_root: usize = state.bindings.binding_event_roots[slot]
                        report.analysis_1.kernel.nodes[event].auxiliary <- bind_root + 1 if bind_root < ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET

        # Return the tracked region carried by a direct value path. Calls and aggregate
        # transformations intentionally return no region here; their broader recursive check
        # below rejects a hidden region value instead of guessing its lifetime.
        def proof_resource_expr_region(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&, depth: usize) -> sview:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return ""
            return "" if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.RegionNew(_, region, _):
                    return region
                Ast::Expr.Ident(name, _):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    return "" if not binding.complete
                    slot: usize = binding.slot
                    return proof_resource_binding_region(state, slot) if slot < state.bindings.binding_names.count and proof_resource_binding_region_is_live(state, slot)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_region(inner, state, report, depth + 1)
                Ast::Expr.Move(inner, _):
                    return proof_resource_expr_region(inner, state, report, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_region(object, state, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_region(base, state, report, depth + 1)
                Ast::Expr.Index(object, _, _):
                    return proof_resource_expr_region(object, state, report, depth + 1)
                Ast::Expr.IndexN(object, _, _):
                    return proof_resource_expr_region(object, state, report, depth + 1)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_resource_expr_region(object, state, report, depth + 1)
                _:
                    return ""
            return ""

        # The first by-value region-call rule is deliberately narrow: a dynamic array whose
        # elements are scalar values. Containers of references and nested/opaque element types
        # need their own provenance model and stay unsupported.
        def proof_resource_region_collection_type_tag(expression: Ast::Expr, report: mutable ProofReport&) -> sview:
            proof_resource_region_collection_type_tag_with_depth(expression, report, 0)

        def proof_resource_region_collection_type_tag_with_depth(expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> sview:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return ""
            return "" if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_resource_region_collection_type_tag_with_depth(inner, report, depth + 1)
                Ast::Expr.Unary(TokenKind.Mutable, inner, _):
                    return proof_resource_region_collection_type_tag_with_depth(inner, report, depth + 1)
                Ast::Expr.Index(head, element, _):
                    element_name: sview = proof_ident_name(element)
                    return "__elisa_darray_i8" if proof_ident_name(head) == "darray" and element_name == "i8"
                    return "__elisa_darray_i16" if proof_ident_name(head) == "darray" and element_name == "i16"
                    return "__elisa_darray_i32" if proof_ident_name(head) == "darray" and element_name == "i32"
                    return "__elisa_darray_i64" if proof_ident_name(head) == "darray" and element_name == "i64"
                    return "__elisa_darray_u8" if proof_ident_name(head) == "darray" and element_name == "u8"
                    return "__elisa_darray_u16" if proof_ident_name(head) == "darray" and element_name == "u16"
                    return "__elisa_darray_u32" if proof_ident_name(head) == "darray" and element_name == "u32"
                    return "__elisa_darray_u64" if proof_ident_name(head) == "darray" and element_name == "u64"
                    return "__elisa_darray_usize" if proof_ident_name(head) == "darray" and element_name == "usize"
                    return "__elisa_darray_bool" if proof_ident_name(head) == "darray" and element_name == "bool"
                    return "__elisa_darray_char" if proof_ident_name(head) == "darray" and element_name == "char"
                _:
                    pass
            return ""

        def proof_resource_region_collection_value_type(expression: Ast::Expr, report: mutable ProofReport&) -> bool:
            return proof_resource_region_collection_type_tag(expression, report) != ""

        # A call returning `T& @r` or `sview @r` carries the caller's concrete region only when
        # the callee has a verified resource summary and its explicit `@r` witness is mapped at
        # this call site. By-value sviews additionally need a matching return marker in that
        # summary; the source-level return annotation alone cannot manufacture provenance.
        def proof_resource_call_result_region(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> sview:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    callee_name: sview = proof_callable_name(callee)
                    return "" if proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    is_reference_result: mutable bool = false
                    is_sview_result: mutable bool = false
                    is_region_value_result: mutable bool = false
                    if function_index < functions.returns.return_references.count:
                        is_reference_result <- functions.returns.return_references[function_index]
                    if function_index < functions.returns.return_sviews.count:
                        is_sview_result <- functions.returns.return_sviews[function_index]
                    if function_index < functions.returns.return_types.count:
                        is_region_value_result <- not is_reference_result and not is_sview_result and proof_resource_region_collection_value_type(functions.returns.return_types[function_index], report)
                    return "" if function_index >= functions.returns.return_type_marker_complete.count or not functions.returns.return_type_marker_complete[function_index] or (not is_reference_result and not is_sview_result and not is_region_value_result)
                    return_region: sview = proof_resource_function_return_region(functions, function_index)
                    return "" if return_region == ""
                    region_count: usize = proof_resource_function_region_param_count(functions, function_index)
                    formal_region_index: mutable usize = region_count
                    for candidate in 0..<region_count |candidate, functions, function_index, return_region, formal_region_index|:
                        formal_region_index <- candidate if proof_resource_function_region_param_at(functions, function_index, candidate) == return_region
                    return "" if:
                        formal_region_index >= region_count
                        function_index >= functions.summaries.verified.count or not functions.summaries.verified[function_index]
                    summary_root: usize = proof_resource_summary_root_for_function(functions, report, function_index)
                    return "" if summary_root >= report.analysis_1.kernel.nodes.count
                    if is_sview_result:
                        sview_markers: mutable darray[usize] = []
                        return "" if not proof_resource_summary_return_markers(report, summary_root, &sview_markers) or sview_markers.count == 0
                        for marker_root in sview_markers |marker_root, report, return_region|:
                            marker: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[marker_root]
                            return "" if (marker.operator != "sview" and marker.operator != "sview-call") or marker.name != return_region
                    if is_region_value_result:
                        value_markers: darray[usize] = []
                        return "" if not proof_resource_summary_return_markers(report, summary_root, &value_markers) or value_markers.count == 0
                        for marker_root in value_markers |marker_root, report, return_region|:
                            marker: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[marker_root]
                            return "" if marker.operator != "value-param" or marker.name != return_region or marker.right >= report.analysis_1.kernel.nodes.count
                    mapped: mutable darray[Ast::Expr] = []
                    return "" if not proof_resource_map_call_arguments(functions, function_index, arguments, argument_names, &mapped, report)
                    formal_regions: mutable darray[sview] = []
                    actual_regions: mutable darray[sview] = []
                    return "" if not proof_resource_collect_call_regions(state, functions, function_index, mapped, &formal_regions, &actual_regions, report)
                    return actual_regions[formal_region_index] if formal_region_index < actual_regions.count
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    # Static-effect calls are frontend rewrites, not source-level calls with a
                    # stable region witness. Do not manufacture a lifetime through the temporary
                    # lowered AST; the ordinary call path remains available after the rewrite.
                    return ""
                _:
                    pass
            return ""

        # Recover the formal whose checked return witness backs an sview. A direct return names
        # its resource-use witness; a call return names the formal established by kernel replay.
        # Conditional returns from different formals and opaque transformations remain refused.
        def proof_resource_sview_return_formal_at(report: mutable ProofReport&, summary_root: usize) -> sview:
            return "" if summary_root >= report.analysis_1.kernel.nodes.count or report.analysis_1.kernel.nodes[summary_root].kind != "resource-safety" or report.analysis_1.kernel.nodes[summary_root].operator != "resource-v2"
            markers: mutable darray[usize] = []
            return "" if not proof_resource_summary_return_markers(report, summary_root, &markers)
            returned_formal: mutable sview = ""
            found_return: mutable bool = false
            for marker_root in markers |marker_root, report, returned_formal, found_return|:
                return "" if not proof_source_index_work_charge(report, 1)
                marker: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[marker_root]
                marker_formal: mutable sview = ""
                if marker.operator == "sview":
                    return "" if marker.secondary_name != "" or marker.left >= report.analysis_1.kernel.nodes.count
                    witness: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[marker.left]
                    return "" if witness.kind != "resource-use" or witness.name == ""
                    marker_formal <- witness.name
                elif marker.operator == "sview-call":
                    return "" if marker.secondary_name == ""
                    marker_formal <- marker.secondary_name
                else:
                    return ""
                return "" if returned_formal != "" and returned_formal != marker_formal
                returned_formal <- marker_formal
                found_return <- true
            return returned_formal if found_return
            return ""

        # Map the summary's returned formal to the actual caller place. Region identity and
        # borrow conflicts are checked by the caller-side producer and then independently again
        # by resource-call-result replay.
        def proof_resource_call_result_sview_source_actual(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool):
            proof_resource_call_result_sview_source_actual_with_depth(expression, state, functions, report, 0)

        def proof_resource_call_result_sview_source_actual_with_depth(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool):
            empty: ProofResourcePlace = proof_resource_empty_place()
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return (false, empty, state.bindings.binding_names.count, false, false)
            return (false, empty, state.bindings.binding_names.count, false, false) if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    callee_name: sview = proof_callable_name(callee)
                    return (false, empty, state.bindings.binding_names.count, false, false) if proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    return (false, empty, state.bindings.binding_names.count, false, false) if:
                        function_index >= functions.returns.return_type_marker_complete.count or not functions.returns.return_type_marker_complete[function_index]
                        function_index >= functions.returns.return_sviews.count
                        not functions.returns.return_sviews[function_index]
                        function_index >= functions.summaries.verified.count or not functions.summaries.verified[function_index]
                    summary_root: usize = proof_resource_summary_root_for_function(functions, report, function_index)
                    formal_name: sview = proof_resource_sview_return_formal_at(report, summary_root)
                    return (false, empty, state.bindings.binding_names.count, false, false) if:
                        formal_name == ""
                        function_index >= functions.parameters.metadata.param_counts.count or function_index >= functions.parameters.metadata.param_starts.count
                    param_start: usize = functions.parameters.metadata.param_starts[function_index]
                    param_count: usize = functions.parameters.metadata.param_counts[function_index]
                    formal_index: mutable usize = param_count
                    for candidate in 0..<param_count |candidate, functions, param_start, formal_name, formal_index|:
                        formal_index <- candidate if param_start + candidate < functions.parameters.metadata.all_params.count and functions.parameters.metadata.all_params[param_start + candidate] == formal_name
                    return (false, empty, state.bindings.binding_names.count, false, false) if formal_index >= param_count
                    mapped: mutable darray[Ast::Expr] = []
                    return (false, empty, state.bindings.binding_names.count, false, false) if:
                        not proof_resource_map_call_arguments(functions, function_index, arguments, argument_names, &mapped, report)
                        formal_index >= mapped.count
                    actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_source_actual(mapped[formal_index], functions, state, report)
                    return (actual.known and actual.place.root != "" and actual.place.whole, actual.place, actual.slot, actual.is_reference, actual.mutable_reference)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_call_result_sview_source_actual_with_depth(inner, state, functions, report, depth + 1)
                _:
                    pass
            return (false, empty, state.bindings.binding_names.count, false, false)

        # Recover the provenance of a region-carrying reference result. A returned formal gives
        # the caller's place (and therefore must remain an alias); a
        # `resource-region-return-alloc` witness is the only other accepted shape and denotes a
        # fresh allocation. Any summary that returns a reference through an opaque expression is
        # deliberately rejected instead of minting an independent capability.
        def proof_resource_call_result_source_actual(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> (known: bool, aliases_source: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool):
            proof_resource_call_result_source_actual_with_depth(expression, state, functions, report, 0)

        def proof_resource_call_result_source_actual_with_depth(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> (known: bool, aliases_source: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool):
            empty: ProofResourcePlace = proof_resource_empty_place()
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return (false, false, empty, state.bindings.binding_names.count, false, false, false)
            return (false, false, empty, state.bindings.binding_names.count, false, false, false) if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    callee_name: sview = proof_callable_name(callee)
                    return (false, false, empty, state.bindings.binding_names.count, false, false, false) if proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    return (false, false, empty, state.bindings.binding_names.count, false, false, false) if:
                        function_index >= functions.returns.return_type_marker_complete.count or not functions.returns.return_type_marker_complete[function_index]
                        function_index >= functions.returns.return_references.count or not functions.returns.return_references[function_index]
                        function_index >= functions.summaries.verified.count or not functions.summaries.verified[function_index]
                    # The callee's replayed summary names the returned formal (through an exact
                    # direct witness or a `param-call` marker) or a fresh allocation, and
                    # resource-call-result replay re-derives exactly that. A syntactic
                    # `return formal` scan is never consulted: it does not see nested returns.
                    summary_root: usize = proof_resource_summary_root_for_function(functions, report, function_index)
                    summary_return: (known: bool, region: sview, formal: sview, mutable_reference: bool, allocation: bool) = proof_resource_reference_summary_return_at(report, summary_root)
                    return (false, false, empty, state.bindings.binding_names.count, false, false, false) if not summary_return.known
                    return (true, false, empty, state.bindings.binding_names.count, false, false, false) if summary_return.allocation
                    formal_actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_formal_actual(expression, summary_return.formal, state, functions, report)
                    return (formal_actual.known, formal_actual.place.root != "", formal_actual.place, formal_actual.slot, formal_actual.is_reference, formal_actual.mutable_reference, formal_actual.writable)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_call_result_source_actual_with_depth(inner, state, functions, report, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_call_result_source_actual_with_depth(lowered.call, state, functions, report, depth + 1) if lowered.known
                _:
                    pass
            return (false, false, empty, state.bindings.binding_names.count, false, false, false)

        def proof_resource_local_binding_region[@r](functions: ProofFunctionTable& @r, name: sview, line: u32, report: mutable ProofReport&) -> sview @r:
            for index in 0..<functions.parameters.locals.local_region_binding_names.count |index, functions, name, line, report|:
                return "" if not proof_source_index_work_charge(report, 1)
                return "" if not proof_source_index_work_charge(report, sview_len(functions.parameters.locals.local_region_binding_names[index])) or not proof_source_index_work_charge(report, sview_len(name))
                if index < functions.parameters.locals.local_region_binding_regions.count and index < functions.parameters.locals.local_region_binding_lines.count and functions.parameters.locals.local_region_binding_names[index] == name and functions.parameters.locals.local_region_binding_lines[index] == line:
                    return functions.parameters.locals.local_region_binding_regions[index]
            return ""

        def proof_resource_is_loop_accumulator(functions: ProofFunctionTable&, name: sview, offset: u32, report: mutable ProofReport&) -> bool:
            for index in 0..<functions.parameters.locals.loop_accumulator_names.count |index, functions, name, offset, report|:
                return false if not proof_source_index_work_charge(report, 1)
                return false if not proof_source_index_work_charge(report, sview_len(functions.parameters.locals.loop_accumulator_names[index])) or not proof_source_index_work_charge(report, sview_len(name))
                if index < functions.parameters.locals.loop_accumulator_offsets.count and functions.parameters.locals.loop_accumulator_offsets[index] == offset and functions.parameters.locals.loop_accumulator_names[index] == name:
                    return true
            return false

        def proof_resource_is_mutable_local(functions: ProofFunctionTable&, name: sview, offset: u32, report: mutable ProofReport&) -> bool:
            for index in 0..<functions.parameters.locals.mutable_local_names.count |index, functions, name, offset, report|:
                return false if not proof_source_index_work_charge(report, 1)
                return false if not proof_source_index_work_charge(report, sview_len(functions.parameters.locals.mutable_local_names[index])) or not proof_source_index_work_charge(report, sview_len(name))
                if index < functions.parameters.locals.mutable_local_offsets.count and functions.parameters.locals.mutable_local_offsets[index] == offset and functions.parameters.locals.mutable_local_names[index] == name:
                    return true
            return false

        def proof_resource_expr_result_region(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> sview:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return ""
            direct: sview = proof_resource_expr_region(expression, state, report, depth)
            return direct if direct != ""
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    sview_conversion: (known: bool, receiver: Ast::Expr) = proof_resource_builtin_sview_conversion(expression, functions, report, 0)
                    return proof_resource_expr_region(sview_conversion.receiver, state, report, depth + 1) if sview_conversion.known
                    result: sview = proof_resource_call_result_region(expression, state, functions, report)
                    return result
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    # See proof_resource_call_result_region: an effect rewrite may allocate its
                    # synthetic call in a shorter-lived AST region, so it has no result-region
                    # witness until a later source pass materializes the direct call.
                    return ""
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_result_region(inner, state, functions, report, depth + 1)
                Ast::Expr.Move(inner, _):
                    return proof_resource_expr_result_region(inner, state, functions, report, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_result_region(object, state, functions, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_result_region(base, state, functions, report, depth + 1)
                Ast::Expr.Index(object, _, _):
                    return proof_resource_expr_result_region(object, state, functions, report, depth + 1)
                Ast::Expr.IndexN(object, _, _):
                    return proof_resource_expr_result_region(object, state, functions, report, depth + 1)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_resource_expr_result_region(object, state, functions, report, depth + 1)
                _:
                    pass
            return ""

        # A verified call consumes direct region temporaries as part of its resource transition.
        # Do not confuse those consumed inputs with a region value produced by the call. Calls
        # whose result is itself region-tied remain visible here; unresolved calls are already
        # rejected by the call-summary/resource transition above.
        def proof_resource_expr_contains_unresolved_region_value(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            return true if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    return true if proof_resource_expr_result_region(expression, state, functions, report, depth) != ""
                    return proof_resource_expr_contains_region_value(callee, state, report)
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_contains_unresolved_region_value(lowered.call, state, functions, report, depth + 1) if lowered.known
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_contains_unresolved_region_value(inner, state, functions, report, depth + 1)
                _:
                    return proof_resource_expr_contains_region_value(expression, state, report)

        # What an expression *statement* discards. The statement evaluates the expression and
        # throws the result away, so the only region-relevant thing it can drop is that result.
        # Every use, write, borrow and call inside the expression has already been recorded as its
        # own transition by `proof_resource_check_expression`, and replay validates those; a callee
        # path that merely names a region binding -- `out.push(value)` where `out` is a parameter
        # with a lifetime -- is one of those uses, not a discarded region value. Refusing on the
        # callee path made a method call on any region-owned receiver unsupported, which is 88 of
        # the 116 `region-expression-unsupported` findings on the kernel's own source and every
        # such call in a region-polymorphic function.
        def proof_resource_expr_statement_discards_region_value(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            return true if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return proof_resource_expr_result_region(expression, state, functions, report, depth) != ""
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_statement_discards_region_value(lowered.call, state, functions, report, depth + 1) if lowered.known
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_statement_discards_region_value(inner, state, functions, report, depth + 1)
                Ast::Expr.Block(_, value, _, _):
                    # A block statement discards its own value and nothing else. `for x in xs
                    # |caps|:` parses as a block, so asking whether the block *mentions* a
                    # region-owned binding asked whether any statement in the loop body does --
                    # and reported every such loop as a region value thrown away. The body is
                    # checked as ordinary statements by the walk just above this test; what this
                    # boundary owes is the block's own value, which for a loop is absent.
                    return proof_resource_expr_contains_region_value(value, state, report)
                _:
                    return proof_resource_expr_contains_region_value(expression, state, report)

        # A region-polymorphic callee may return/use values tied to an EXTERNAL caller region. A
        # local region remains forbidden at return, so keep that distinction explicit instead of
        # weakening the general region-value predicate used at opaque boundaries.
        def proof_resource_expr_contains_local_region_value(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            proof_resource_expr_contains_local_region_value_with_depth(expression, state, report, 0)

        def proof_resource_expr_contains_local_region_value_with_depth(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            return true if not proof_source_index_work_charge(report, 1)
            return false if proof_resource_expr_is_collection_extent(expression, state, report)
            match expression:
                Ast::Expr.RegionNew(_, region, _):
                    return region != "" and not proof_resource_region_is_external(state, region)
                Ast::Expr.Ident(name, _):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    return true if not binding.complete
                    slot: usize = binding.slot
                    region: sview = proof_resource_binding_region(state, slot)
                    return slot < state.bindings.binding_names.count and region != "" and not proof_resource_region_is_external(state, region)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_contains_local_region_value_with_depth(inner, state, report, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_contains_local_region_value_with_depth(operand, state, report, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_contains_local_region_value_with_depth(left, state, report, depth + 1) or proof_resource_expr_contains_local_region_value_with_depth(right, state, report, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_contains_local_region_value_with_depth(callee, state, report, depth + 1)
                    for argument in arguments |argument, state, report, depth|:
                        return true if proof_resource_expr_contains_local_region_value_with_depth(argument, state, report, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_contains_local_region_value_with_depth(lowered.call, state, report, depth + 1) if lowered.known
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_contains_local_region_value_with_depth(object, state, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_contains_local_region_value_with_depth(base, state, report, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_contains_local_region_value_with_depth(object, state, report, depth + 1) or proof_resource_expr_contains_local_region_value_with_depth(index, state, report, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_contains_local_region_value_with_depth(object, state, report, depth + 1)
                    for argument in arguments |argument, state, report, depth|:
                        return true if proof_resource_expr_contains_local_region_value_with_depth(argument, state, report, depth + 1)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_contains_local_region_value_with_depth(object, state, report, depth + 1) or proof_resource_expr_contains_local_region_value_with_depth(low, state, report, depth + 1) or proof_resource_expr_contains_local_region_value_with_depth(high, state, report, depth + 1)
                Ast::Expr.Move(operand, _):
                    return proof_resource_expr_contains_local_region_value_with_depth(operand, state, report, depth + 1)
                _:
                    return false

        # A call may consume a local region temporary while returning an ordinary scalar. The
        # lifetime of the returned value is therefore not the union of all input lifetimes. Use
        # the verified result summary for calls, while retaining the conservative recursive walk
        # for every other expression shape.
        def proof_resource_expr_returns_local_region_value(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> bool:
            proof_resource_expr_returns_local_region_value_with_depth(expression, state, functions, report, 0)

        def proof_resource_expr_returns_local_region_value_with_depth(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            return true if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    returned_region: sview = proof_resource_expr_result_region(expression, state, functions, report, 0)
                    return returned_region != "" and not proof_resource_region_is_external(state, returned_region)
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_returns_local_region_value_with_depth(lowered.call, state, functions, report, depth + 1) if lowered.known
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_returns_local_region_value_with_depth(inner, state, functions, report, depth + 1)
                _:
                    return proof_resource_expr_contains_local_region_value(expression, state, report)

        # A child region may expose a value to the enclosing resource state only when that
        # value is still owned by a region that remains active in the parent. Locals introduced
        # inside the region are dropped with the child and therefore need no join operation.
        def proof_resource_check_region_boundary[@r](parent: ProofResourceState&, child: ProofResourceState&, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos) -> void:
            return if not proof_source_index_work_charge(report, child.bindings.binding_region.count)
            for index in 0..<child.bindings.binding_region.count |index, child, parent, report, function_name, position|:
                region: sview = child.bindings.binding_region[index]
                if index < parent.bindings.binding_region.count and region != parent.bindings.binding_region[index]:
                    proof_resource_add_failing_obligation(report, "region-scope-unsupported", position, function_name, "a nested scope may not change the region ownership of an inherited binding")
                if index < parent.bindings.binding_region_owner.count:
                    owner_changed: bool = index >= child.bindings.binding_region_owner.count or child.bindings.binding_region_owner[index] != parent.bindings.binding_region_owner[index]
                    proof_resource_add_failing_obligation(report, "region-scope-unsupported", position, function_name, "a nested scope may not change region allocation provenance of an inherited binding") if owner_changed
                if region != "" and index < parent.bindings.binding_names.count and (not proof_resource_binding_region_is_live(child, index) or not proof_resource_region_is_active(parent, region)):
                    proof_resource_add_failing_obligation(report, "region-store-escape", position, function_name, "a region-owned value outlives the lexical region that owns its storage")

        def proof_resource_direct_binding_name(expression: Ast::Expr, report: mutable ProofReport&) -> sview:
            proof_resource_direct_binding_name_with_depth(expression, report, 0)

        def proof_resource_direct_binding_name_with_depth(expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> sview:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return ""
            return "" if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_resource_direct_binding_name_with_depth(inner, report, depth + 1)
                _:
                    return ""

        def proof_resource_handle_region_assignment[@s, @r](target: Ast::Expr, initializer: Ast::Expr, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: mutable ProofFunctionTable&) -> void can[Global{Read,Write}]:
            match initializer:
                Ast::Expr.RegionNew(operand, region, allocation_position):
                    discard_target: bool = proof_resource_is_discard_target(target, report)
                    proof_resource_add_region_discard(state, report, operand, region, allocation_position, function_name) if discard_target
                    (proof_resource_rebind_region_allocation(state, report, target, operand, region, position, function_name) can Global{Read,Write}) if not discard_target
                    return
                _:
                    pass
            assigned_region: mutable sview = proof_resource_expr_result_region(initializer, state, functions, report, 0)
            scalar_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, proof_resource_direct_binding_name(target, report), report)
            scalar_target_slot: usize = scalar_binding.slot
            assigned_region <- "" if proof_resource_binding_is_scalar(state, scalar_target_slot)
            if assigned_region != "":
                target_name: sview = proof_resource_direct_binding_name(target, report)
                target_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, target_name, report)
                target_slot: usize = target_binding.slot
                source_place: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(initializer, report)
                source_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, source_place.place.root, report)
                source_slot: usize = source_binding.slot
                target_identity: mutable usize = 0
                source_identity: mutable usize = 0
                if target_slot < state.bindings.binding_event_roots.count:
                    target_event_root: usize = state.bindings.binding_event_roots[target_slot]
                    target_identity <- target_event_root + 1 if target_event_root < ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
                if source_slot < state.bindings.binding_event_roots.count:
                    source_event_root: usize = state.bindings.binding_event_roots[source_slot]
                    source_identity <- source_event_root + 1 if source_event_root < ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
                target_access: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(target, report)
                encoded_source: usize = proof_resource_encode_access_place(initializer, report)
                source_region_owner: bool = source_slot < state.bindings.binding_region_owner.count and state.bindings.binding_region_owner[source_slot]
                valid: bool = target_name != "" and target_identity != 0 and source_identity != 0 and target_slot < state.bindings.binding_names.count and target_slot < state.bindings.binding_reference.count and not state.bindings.binding_reference[target_slot] and source_slot < state.bindings.binding_names.count and source_place.known and source_place.place.whole and target_access.known and target_access.place.whole and proof_resource_binding_is_writable(state, target_slot) and not proof_resource_binding_is_moved(state, source_slot) and not proof_resource_binding_is_moved(state, target_slot) and target_slot < state.borrows.borrow_present.count and not state.borrows.borrow_present[target_slot] and not (proof_resource_has_borrow_overlap(state, report, target_access.place, state.bindings.binding_names.count) can Global{Read,Write}) and proof_resource_binding_region(state, source_slot) == assigned_region and proof_resource_binding_region_is_live(state, source_slot) and proof_resource_region_is_active(state, assigned_region) and encoded_source < report.analysis_1.kernel.nodes.count
                proof_resource_add_failing_obligation(report, "region-store-escape", position, function_name, "a region-owned value may be assigned only from a directly tracked whole binding") if not valid
                if valid:
                    state.bindings.binding_region[target_slot] <- assigned_region
                    state.bindings.binding_region_live[target_slot] <- true
                    state.bindings.binding_region_destroyed[target_slot] <- false
                    state.bindings.binding_region_owner[target_slot] <- source_region_owner
                    # Assignment of a direct region owner is a move-like rebind. Do not leave
                    # the source owner usable after installing the same exclusive token on the
                    # target; self-assignment is a no-op for ownership purposes.
                    proof_resource_mark_binding_moved(state, source_slot) if source_region_owner and source_slot != target_slot
                    event_count: usize = state.evidence.trace_events.count
                    proof_resource_record_event_at_position(state, report, "resource-region-assign", "", encoded_source, target_name, assigned_region, target_identity, position)
                    if state.evidence.trace_events.count == event_count + 1:
                        event: usize = state.evidence.trace_events[event_count]
                        report.analysis_1.kernel.nodes[event].right <- source_identity if event < report.analysis_1.kernel.nodes.count
            if assigned_region == "" and not proof_resource_binding_is_scalar(state, scalar_target_slot) and proof_resource_expr_contains_unresolved_region_value(initializer, state, functions, report, 0):
                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region value flows through an assignment without a lifetime summary")
