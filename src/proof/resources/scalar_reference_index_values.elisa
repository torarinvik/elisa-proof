# Scalar reference index reads produce scalar values and remain outside resource transitions.
extend ElisaProof:
    private:
        def proof_resource_strip_parens_with_work(expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> Ast::Expr:
            return Ast::Expr.Invalid if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT or not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_resource_strip_parens_with_work(inner, report, depth + 1)
                _:
                    return expression

        # Reading the sole primitive element of a typed scalar reference produces a scalar
        # value, not another capability. Keep that distinction only for the current formal
        # binding and literal zero; a shadowing local, a different index, or a non-scalar target
        # retains the ordinary conservative resource classification.
        def proof_resource_is_scalar_reference_index_value(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            stripped: Ast::Expr = proof_resource_strip_parens_with_work(expression, report, 0)
            match stripped:
                Ast::Expr.Index(object, index, _):
                    root: sview = proof_ident_name(object)
                    stripped_index: Ast::Expr = proof_resource_strip_parens_with_work(index, report, 0)
                    match stripped_index:
                        Ast::Expr.IntLit(offset, _):
                            return false if offset != 0
                        _:
                            return false
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, root, report)
                    return false if not binding.complete
                    slot: usize = binding.slot
                    return false if root == "" or slot >= state.context.formal_count or slot >= state.context.formal_scalar_reference_index_values.count or slot >= state.bindings.binding_reference.count or not state.bindings.binding_reference[slot]
                    state.context.formal_scalar_reference_index_values[slot]
                _:
                    return false
