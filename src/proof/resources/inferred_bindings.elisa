# A first `name = value` binding has no type node in the parser's Assign form. Without one the
# resource checker recorded no binding for `name`, so a later use or call argument named an
# unbound local and the resource certificate could not replay. Recover the declared type only
# where the source states it outright, and otherwise leave the statement on the assignment path:
#   - a direct call resolved from the current function row takes that function's declared return type;
#   - an element read `p[i]` of a parameter `p` of the current function, declared once, takes the
#     element type of `p`'s `darray[T]` or `view[T]` type (through `&`, `mutable` and `lmut`).
extend ElisaProof:
    private:
        const PROOF_RESOURCE_INFERRED_TYPE_DEPTH_LIMIT: usize = 64

        def proof_resource_collection_element_type(expression: Ast::Expr, depth: usize) -> Ast::Expr:
            return Ast::Expr.Absent if depth >= PROOF_RESOURCE_INFERRED_TYPE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_resource_collection_element_type(inner, depth + 1)
                Ast::Expr.Unary(operator, inner, _):
                    return proof_resource_collection_element_type(inner, depth + 1) if operator == TokenKind.Mutable or operator == TokenKind.Ampersand or operator == TokenKind.Lmut
                    return Ast::Expr.Absent
                Ast::Expr.Index(head, element, _):
                    head_name: sview = proof_ident_name(head)
                    return element if head_name == "darray" or head_name == "view"
                    return Ast::Expr.Absent
                _:
                    return Ast::Expr.Absent

        def proof_resource_inferred_binding_type(initializer: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&) -> Ast::Expr can[Memory.Allocate, Abort.Panic]:
            match initializer:
                Ast::Expr.Paren(inner, _):
                    return proof_resource_inferred_binding_type(inner, state, functions)
                Ast::Expr.Call(callee, _, _, _):
                    match callee:
                        Ast::Expr.Ident(name, _):
                            # A local callable shadows the same-spelled function. Resolve the
                            # surviving bare call from its scheduled caller row, not by a global
                            # leaf scan that loses module identity.
                            return Ast::Expr.Absent if proof_resource_lookup(state, name) < state.binding_names.count
                            return Ast::Expr.Absent if proof_callable_name(callee) == ""
                            called: usize = proof_function_index_for_callee(functions, callee)
                            return Ast::Expr.Absent if called >= functions.return_types.count
                            return_type: Ast::Expr = functions.return_types[called]
                            return Ast::Expr.Absent if return_type is Ast::Expr.Invalid or return_type is Ast::Expr.Absent or proof_ident_name(return_type) == "void"
                            return return_type
                        _:
                            return Ast::Expr.Absent
                Ast::Expr.Index(Ast::Expr.Ident(root, _), _, _):
                    # The root must still resolve to the formal itself, not to a later local.
                    parameter_slot: usize = proof_resource_lookup(state, root)
                    return Ast::Expr.Absent if parameter_slot >= state.formal_count or parameter_slot >= state.formal_parameter_types.count
                    return proof_resource_collection_element_type(state.formal_parameter_types[parameter_slot], 0)
                _:
                    return Ast::Expr.Absent
