extend ElisaProof:
    private:
        # Copy region labels into Elisa's permanent string arena before retaining them in
        # resource snapshots; this makes the pointer safe after the AST match scope ends.
        def proof_resource_stable_region_name(name: sview) -> cstr can[Global{Read,Write}]:
            return (string_view_copy(name) can Global{Read,Write})

        def proof_resource_analysis_budget_available(report: mutable ProofReport&, function_name: sview, position: Ast::Pos) -> bool:
            return true if report.analysis_1.budgets.resource_steps < PROOF_RESOURCE_ANALYSIS_BUDGET
            if not report.analysis_1.budgets.resource_reported:
                report.analysis_1.budgets.resource_reported <- true
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "resource-state analysis exceeded its bounded symbolic-state budget", "steps", report.analysis_1.budgets.resource_steps + 1, PROOF_RESOURCE_ANALYSIS_BUDGET)
            return false

        def proof_resource_check_var[@s, @r](statement_name: sview, type_expression: Ast::Expr, initializer: Ast::Expr, marker_summary: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool), state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: mutable ProofFunctionTable&) -> void can[Global{Read,Write}]:
            if not marker_summary.complete:
                initializer_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
                opaque_call_result: bool = proof_resource_expr_has_opaque_call_result(initializer, state, functions, initializer_work, 0)
                report.source_types.source_effect_index.work.implicit_effect_work <- initializer_work
                resource_sensitive_initializer: bool = proof_resource_expr_carries_resource(initializer, state, report) or proof_resource_expr_contains_region_value(initializer, state, report) or opaque_call_result
                if resource_sensitive_initializer:
                    proof_resource_add_failing_obligation(report, "resource-type-marker-incomplete", position, function_name, "the resource checker cannot classify this resource-bearing initializer safely")
                    # Do not serialize a borrow or region transition whose destination mode is unknown.
                    match initializer:
                        Ast::Expr.RegionNew(_, _, _):
                            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "a region allocation cannot be attached to a destination with incomplete resource type markers")
                        _:
                            pass
                else:
                    (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
                proof_resource_add_binding_traced_at_position(state, report, statement_name, false, false, false, state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0, position)
                slot: usize = state.bindings.binding_names.count - 1
                state.bindings.binding_type_marker_complete[slot] <- false if slot < state.bindings.binding_type_marker_complete.count
                return
            is_reference: bool = marker_summary.reference
            is_mutable_reference: bool = marker_summary.mutable_reference
            declared_region: sview = proof_resource_local_binding_region(functions, statement_name, position.line, report)
            declared_reference_call: mutable bool = false
            if declared_region != "":
                match initializer:
                    Ast::Expr.Call(callee, _, _, _):
                        callee_index: mutable usize = functions.lookup.source.names.count
                        callee_index <- proof_function_index_for_callee(functions, callee) if not proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                        declared_reference_call <- callee_index < functions.returns.return_type_marker_complete.count and functions.returns.return_type_marker_complete[callee_index] and callee_index < functions.returns.return_references.count and functions.returns.return_references[callee_index]
                    _:
                        pass
            sview_conversion: (known: bool, receiver: Ast::Expr) = proof_resource_builtin_sview_conversion(initializer, functions, report, 0)
            resource_type_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            destination_may_contain_sview: mutable bool = proof_resource_type_may_be_sview(type_expression, functions.type_indexes.type_audit_index, &resource_type_work)
            report.source_types.source_effect_index.work.implicit_effect_work <- resource_type_work
            carries_sview: mutable bool = destination_may_contain_sview or sview_conversion.known
            direct_region: mutable sview = ""
            direct_region_operand: mutable Ast::Expr = Ast::Expr.Invalid
            match initializer:
                Ast::Expr.RegionNew(operand, region, _):
                    direct_region <- region
                    direct_region_operand <- operand
                _:
                    pass
            if direct_region != "":
                if not is_reference:
                    (proof_resource_check_expression(direct_region_operand, state, report, function_name, functions) can Global{Read,Write})
                    proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "new[r] produces a region reference and requires a reference-bearing destination")
                    proof_resource_add_binding(state, statement_name, false, false, false, state.bindings.binding_names.count, false, proof_resource_empty_place())
                    return
                if not destination_may_contain_sview:
                    destination_may_contain_sview <- proof_resource_type_may_contain_sview(type_expression, functions.type_indexes.type_audit_index, &report.source_types.source_effect_index.work.implicit_effect_work)
                    carries_sview <- destination_may_contain_sview or sview_conversion.known
                if carries_sview:
                    (proof_resource_check_expression(direct_region_operand, state, report, function_name, functions) can Global{Read,Write})
                    proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "allocating storage for an sview value does not establish the lifetime of its pointee")
                    proof_resource_add_binding(state, statement_name, false, false, false, state.bindings.binding_names.count, false, proof_resource_empty_place())
                    return
                (proof_resource_check_expression(direct_region_operand, state, report, function_name, functions) can Global{Read,Write})
                proof_resource_add_region_allocation(state, report, statement_name, type_expression, direct_region_operand, direct_region, position, function_name)
                return
            if declared_region != "" and not declared_reference_call:
                shadowed_region_call: mutable bool = false
                match initializer:
                    Ast::Expr.Call(callee, _, _, _):
                        shadowed_region_call <- proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                    _:
                        pass
                if shadowed_region_call:
                    (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
                    proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a local function value has no verified caller-region return summary")
                    proof_resource_add_binding(state, statement_name, false, false, false, state.bindings.binding_names.count, false, proof_resource_empty_place())
                    return
                if not destination_may_contain_sview:
                    destination_may_contain_sview <- proof_resource_type_may_contain_sview(type_expression, functions.type_indexes.type_audit_index, &report.source_types.source_effect_index.work.implicit_effect_work)
                    carries_sview <- destination_may_contain_sview or sview_conversion.known
                (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
                initializer_region: sview = proof_resource_expr_result_region(initializer, state, functions, report, 0)
                region_value_call: mutable bool = false
                region_value_call_event: mutable usize = report.analysis_1.kernel.nodes.count
                match initializer:
                    Ast::Expr.Call(callee, _, _, _):
                        result_index: mutable usize = functions.lookup.source.names.count
                        result_index <- proof_function_index_for_callee(functions, callee) if not proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                        region_value_call <- result_index < functions.returns.return_type_marker_complete.count and functions.returns.return_type_marker_complete[result_index] and result_index < functions.returns.return_types.count and result_index < functions.returns.return_references.count and result_index < functions.returns.return_sviews.count and not functions.returns.return_references[result_index] and not functions.returns.return_sviews[result_index] and proof_resource_region_collection_value_type(functions.returns.return_types[result_index], report)
                        region_value_call_event <- state.evidence.trace_events[state.evidence.trace_events.count - 1] if state.evidence.trace_events.count > 0
                    _:
                        pass
                if region_value_call:
                    proof_resource_add_binding(state, statement_name, is_reference, is_mutable_reference, marker_summary.is_mutable, state.bindings.binding_names.count, false, proof_resource_empty_place())
                    bound: bool = initializer_region == declared_region and region_value_call_event < report.analysis_1.kernel.nodes.count and proof_resource_record_region_call_value(state, report, region_value_call_event, type_expression, statement_name, declared_region, marker_summary.is_mutable, position, functions)
                    state.bindings.binding_region_live[state.bindings.binding_region.count - 1] <- false if not bound
                    proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a by-value collection call must match its verified returned collection type and caller-owned region") if not bound
                    return
                if carries_sview and initializer_region == "":
                    proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "an sview value has no directly tracked live backing region")
                    proof_resource_add_binding(state, statement_name, false, false, false, state.bindings.binding_names.count, false, proof_resource_empty_place())
                    return
                if carries_sview and initializer_region != "":
                    call_name: mutable sview = ""
                    call_function_index: mutable usize = functions.lookup.source.names.count
                    match initializer:
                        Ast::Expr.Call(callee, _, _, _):
                            call_name <- proof_callable_name(callee)
                            call_function_index <- proof_function_index_for_callee(functions, callee) if not proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                        _:
                            pass
                    returns_sview: mutable bool = false
                    if call_function_index < functions.returns.return_sviews.count and call_function_index < functions.returns.return_type_marker_complete.count and functions.returns.return_type_marker_complete[call_function_index]:
                        returns_sview <- functions.returns.return_sviews[call_function_index]
                    if returns_sview:
                        if initializer_region == declared_region:
                            (proof_resource_add_sview_call_result(statement_name, type_expression, initializer, initializer_region, state, report, function_name, position, functions) can Global{Read,Write})
                        else:
                            proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a returned sview must be bound to the same live region as its verified return summary")
                            proof_resource_add_binding(state, statement_name, false, false, false, state.bindings.binding_names.count, false, proof_resource_empty_place())
                        return
                if initializer_region == "":
                    proof_resource_add_region_allocation(state, report, statement_name, type_expression, initializer, declared_region, position, function_name)
                else:
                    (proof_resource_add_region_binding(state, report, statement_name, type_expression, initializer, declared_region, position, function_name, functions) can Global{Read,Write})
                return
            # A scalar copied out of a region-owned value is a plain value, not a view into the
            # region. Only reference-like results carry the source lifetime.
            scalar_binding: bool = proof_resource_type_is_scalar(type_expression)
            source_region: sview = "" if scalar_binding else proof_resource_expr_result_region(initializer, state, functions, report, 0)
            # Reference-returning calls need the call-result transition below, even with an
            # explicit local lifetime. Check that annotation before evaluating the call once.
            if declared_reference_call and source_region != declared_region:
                (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
                proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a returned reference must retain the region established by the callee summary")
                proof_resource_add_binding(state, statement_name, is_reference, is_mutable_reference, false, state.bindings.binding_names.count, false, proof_resource_empty_place())
                return
            if source_region != "" and not destination_may_contain_sview:
                destination_may_contain_sview <- proof_resource_type_may_contain_sview(type_expression, functions.type_indexes.type_audit_index, &report.source_types.source_effect_index.work.implicit_effect_work)
                carries_sview <- destination_may_contain_sview or sview_conversion.known
            if carries_sview and source_region == "":
                (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
                proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "an sview value has no directly tracked live backing region")
                proof_resource_add_binding(state, statement_name, false, false, false, state.bindings.binding_names.count, false, proof_resource_empty_place())
                return
            if source_region != "":
                (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
                callee_name: mutable sview = ""
                match initializer:
                    Ast::Expr.Call(callee, _, _, _):
                        callee_name <- proof_callable_name(callee)
                    _:
                        pass
                result_function_index: mutable usize = functions.lookup.source.names.count
                match initializer:
                    Ast::Expr.Call(callee, _, _, _):
                        result_function_index <- proof_function_index_for_callee(functions, callee) if not proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                    _:
                        pass
                result_is_reference: bool = result_function_index < functions.returns.return_type_marker_complete.count and functions.returns.return_type_marker_complete[result_function_index] and result_function_index < functions.returns.return_references.count and functions.returns.return_references[result_function_index]
                result_is_sview: mutable bool = false
                if result_function_index < functions.returns.return_sviews.count and result_function_index < functions.returns.return_type_marker_complete.count and functions.returns.return_type_marker_complete[result_function_index]:
                    result_is_sview <- functions.returns.return_sviews[result_function_index]
                if result_is_sview and callee_name != "":
                    (proof_resource_add_sview_call_result(statement_name, type_expression, initializer, source_region, state, report, function_name, position, functions) can Global{Read,Write})
                    return
                if result_is_reference and callee_name != "":
                    is_mutable_result: bool = result_function_index < functions.returns.return_mutable_references.count and functions.returns.return_mutable_references[result_function_index]
                    writable_result: bool = is_mutable_result or marker_summary.is_mutable
                    result_source: (known: bool, aliases_source: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_result_source_actual(initializer, state, functions, report)
                    result_target_slot: mutable usize = state.bindings.binding_names.count
                    result_target_place: mutable ProofResourcePlace = proof_resource_empty_place()
                    result_alias: mutable bool = false
                    result_owner: mutable bool = result_source.known and not result_source.aliases_source
                    if not result_source.known:
                        proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a region reference result is neither tied to a direct returned formal nor backed by a fresh return allocation")
                    elif result_source.aliases_source:
                        result_target_slot <- result_source.slot
                        result_target_place <- result_source.place
                        result_alias <- result_source.slot < state.bindings.binding_names.count and result_source.place.root != ""
                        if result_alias:
                            if is_mutable_result and (proof_resource_has_borrow_overlap(state, report, result_source.place, result_source.slot if result_source.is_reference else state.bindings.binding_names.count) can Global{Read,Write}):
                                proof_resource_report_borrow_conflict(state, report, result_source.place, result_source.slot if result_source.is_reference else state.bindings.binding_names.count, false, "borrow-alias-conflict", position, function_name, "a returned mutable reference conflicts with another live borrow of its source place")
                            elif not is_mutable_result and (proof_resource_has_mutable_borrow_overlap(state, report, result_source.place, result_source.slot if result_source.is_reference else state.bindings.binding_names.count) can Global{Read,Write}):
                                proof_resource_report_borrow_conflict(state, report, result_source.place, result_source.slot if result_source.is_reference else state.bindings.binding_names.count, true, "borrow-alias-conflict", position, function_name, "a returned shared reference conflicts with a live mutable borrow of its source place")
                            # Passing a reference handle through a direct-return callee transfers
                            # that handle to the result. Keeping both names live would mint two
                            # independently writable capabilities for one underlying place.
                            result_owner <- result_source.slot < state.bindings.binding_region_owner.count and state.bindings.binding_region_owner[result_source.slot]
                            proof_resource_mark_binding_moved(state, result_source.slot) if result_source.is_reference
                        else:
                            proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a returned reference source did not resolve to a live caller place")
                    proof_resource_add_binding(state, statement_name, true, is_mutable_result, writable_result, result_target_slot if result_alias else state.bindings.binding_names.count, is_mutable_result if result_alias else false, result_target_place if result_alias else proof_resource_empty_place())
                    state.bindings.binding_region[state.bindings.binding_region.count - 1] <- source_region
                    state.bindings.binding_region_live[state.bindings.binding_region_live.count - 1] <- proof_resource_region_is_active(state, source_region)
                    state.bindings.binding_region_owner[state.bindings.binding_region_owner.count - 1] <- result_owner
                    call_event: usize = state.evidence.trace_events[state.evidence.trace_events.count - 1] if state.evidence.trace_events.count > 0 else report.analysis_1.kernel.nodes.count
                    valid_call_event: bool = call_event < report.analysis_1.kernel.nodes.count and report.analysis_1.kernel.nodes[call_event].kind == "resource-call"
                    result_flags: usize = (PROOF_RESOURCE_WRITABLE_FLAG if writable_result else 0) + PROOF_RESOURCE_REFERENCE_FLAG + (PROOF_RESOURCE_MUTABLE_REFERENCE_FLAG if is_mutable_result else 0)
                    result_events_before: usize = state.evidence.trace_events.count
                    proof_resource_record_event(state, report, "resource-call-result", "", call_event, statement_name, source_region, result_flags) if valid_call_event
                    if valid_call_event and state.evidence.trace_events.count == result_events_before + 1 and state.bindings.binding_event_roots.count == state.bindings.binding_names.count:
                        state.bindings.binding_event_roots[state.bindings.binding_names.count - 1] <- state.evidence.trace_events[result_events_before]
                    proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "a region-returning call did not leave a replayable call transition") if not valid_call_event
                    return
                (proof_resource_add_region_binding(state, report, statement_name, type_expression, initializer, source_region, position, function_name, functions) can Global{Read,Write})
                return
            if not scalar_binding and proof_resource_expr_contains_unresolved_region_value(initializer, state, functions, report, 0):
                (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region value flows through an expression without a lifetime summary")
                proof_resource_add_binding_traced_at_position(state, report, statement_name, is_reference, is_mutable_reference, is_mutable_reference or marker_summary.is_mutable, state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0, position)
                return
            direct_root: sview = proof_resource_direct_borrow_root(initializer, report)
            borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(initializer, report)
            (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
            if is_reference and not borrowed.known:
                proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "reference initializer is not a bounded static address-of borrow")
            elif not is_reference and proof_resource_expr_returns_local_borrow(initializer, state, functions, report):
                proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "address-of value enters a non-reference binding")
            target_slot: mutable usize = state.bindings.binding_names.count
            borrow_is_mutable: mutable bool = false
            source_place_root: mutable usize = 0
            source_name: sview = borrowed.place.root if borrowed.known else direct_root
            if borrowed.known:
                target_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, borrowed.place.root, report)
                target_slot <- target_binding.slot
                if not target_binding.complete or target_slot >= state.bindings.binding_names.count:
                    proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "borrow target is not a live proof binding")
                    proof_resource_add_binding_traced_at_position(state, report, statement_name, false, false, false, state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0, position)
                    opaque_slot: usize = state.bindings.binding_names.count - 1
                    state.bindings.binding_type_marker_complete[opaque_slot] <- false if opaque_slot < state.bindings.binding_type_marker_complete.count
                    return
                elif proof_resource_binding_is_moved(state, target_slot):
                    proof_resource_add_failing_obligation(report, "resource-use-after-move", position, function_name, "a borrow cannot be created from a moved resource binding")
                elif target_slot >= state.bindings.binding_type_marker_complete.count or not state.bindings.binding_type_marker_complete[target_slot]:
                    proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "a borrow cannot be created from a binding with incomplete resource type markers")
                    proof_resource_add_binding_traced_at_position(state, report, statement_name, false, false, false, state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0, position)
                    opaque_slot: usize = state.bindings.binding_names.count - 1
                    state.bindings.binding_type_marker_complete[opaque_slot] <- false if opaque_slot < state.bindings.binding_type_marker_complete.count
                    return
                else:
                    borrow_is_mutable <- is_mutable_reference
                    if borrow_is_mutable and (proof_resource_has_borrow_overlap(state, report, borrowed.place, state.bindings.binding_names.count) can Global{Read,Write}):
                        proof_resource_report_borrow_conflict(state, report, borrowed.place, state.bindings.binding_names.count, false, "borrow-alias-conflict", position, function_name, "mutable borrow conflicts with another live borrow of the same root")
                    elif not borrow_is_mutable and (proof_resource_has_mutable_borrow_overlap(state, report, borrowed.place, state.bindings.binding_names.count) can Global{Read,Write}):
                        proof_resource_report_borrow_conflict(state, report, borrowed.place, state.bindings.binding_names.count, true, "borrow-alias-conflict", position, function_name, "shared borrow conflicts with a live mutable borrow of the same root")
                    # Reuse the exact path already stored in the resource state. Re-encoding the
                    # same AST would create structurally equal but numerically different roots,
                    # which would make replayed resource-disjoint evidence unable to identify the
                    # path component it justified.
                    source_place_root <- borrowed.place.path_root
            if borrowed.known and target_slot < state.bindings.binding_names.count and borrow_is_mutable:
                source_writable: bool = target_slot < state.bindings.binding_writable.count and (state.bindings.binding_writable[target_slot] or (target_slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[target_slot]))
                proof_resource_add_failing_obligation(report, "borrow-mutable-source", position, function_name, "mutable borrow requires a writable source binding") if not source_writable
            # A loop-header accumulator is a mutable local that the parser declares with its bare type.
            writable: bool = is_mutable_reference or marker_summary.is_mutable or proof_resource_is_mutable_local(functions, statement_name, position.offset, report) or proof_resource_is_loop_accumulator(functions, statement_name, position.offset, report)
            proof_resource_add_binding_traced_at_position(state, report, statement_name, is_reference, is_mutable_reference, writable, target_slot, borrow_is_mutable, source_name, borrowed.place, source_place_root, position) if is_reference
            proof_resource_add_binding_traced_at_position(state, report, statement_name, false, false, writable, state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0, position) if not is_reference
