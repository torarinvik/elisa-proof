extend ElisaProof:
    private:
        def proof_resource_record_lend_call[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, callee_name: sview, callee_index: usize, mapped: darray[Ast::Expr]&, functions: ProofFunctionTable&) -> bool:
            # The argument mode is the actual's own shape, exactly as on the summary path, so the
            # kernel decodes the lent place with the same routine. The event kind is what carries
            # the claim that every one of them is lent as a shared capability.
            return false if:
                callee_name == ""
                callee_index >= functions.parameters.metadata.param_starts.count or callee_index >= functions.parameters.metadata.param_counts.count
                mapped.count != functions.parameters.metadata.param_counts[callee_index]
            param_start: usize = functions.parameters.metadata.param_starts[callee_index]
            return false if callee_index >= functions.returns.return_type_marker_complete.count or not functions.returns.return_type_marker_complete[callee_index]
            for parameter_index in 0..<mapped.count |parameter_index, functions, param_start|:
                slot: usize = param_start + parameter_index
                return false if slot >= functions.parameters.metadata.all_parameter_type_marker_complete.count or not functions.parameters.metadata.all_parameter_type_marker_complete[slot]
            encoded_arguments: mutable darray[usize] = []
            for parameter_index in 0..<mapped.count |parameter_index, mapped, report, encoded_arguments|:
                actual: Ast::Expr = mapped[parameter_index]
                encoded_value: (known: bool, root: usize) = proof_resource_encode_value(actual, state, report)
                return false if not encoded_value.known
                encoded: mutable usize = encoded_value.root
                match actual:
                    Ast::Expr.Unary(operator, operand, _):
                        encoded <- proof_resource_encode_access_place(operand, report) if operator == TokenKind.Ampersand
                    Ast::Expr.Paren(inner, _):
                        match inner:
                            Ast::Expr.Unary(operator, operand, _):
                                encoded <- proof_resource_encode_access_place(operand, report) if operator == TokenKind.Ampersand
                            _:
                                pass
                    _:
                        pass
                return false if encoded >= report.analysis_1.kernel.nodes.count
                encoded_arguments.push(encoded)
            argument_kinds: mutable darray[sview] = []
            for parameter_index in 0..<mapped.count |parameter_index, mapped, state, report, argument_kinds|:
                kind: sview = proof_resource_call_argument_kind(mapped[parameter_index], functions, state, report)
                return false if kind != "value" and kind != "borrow" and kind != "reference"
                argument_kinds.push(kind)
            lend_formal_regions: mutable darray[sview] = []
            lend_actual_regions: mutable darray[sview] = []
            lend_frame_pinned: mutable bool = false
            return false if not proof_resource_collect_call_regions_framed(state, functions, callee_index, mapped, &lend_formal_regions, &lend_actual_regions, &lend_frame_pinned, report, true)
            needed_nodes: usize = mapped.count * 2 + lend_formal_regions.count + 1
            needed_children: usize = mapped.count * 2 + lend_formal_regions.count
            if not proof_resource_kernel_capacity(report, needed_nodes, needed_children, callee_name):
                proof_kernel_budget_note(report, callee_name)
                return false
            start: usize = report.analysis_1.kernel.children.count
            for parameter_index in 0..<mapped.count |parameter_index, encoded_arguments, argument_kinds, report, functions, param_start|:
                return false if param_start + parameter_index >= functions.parameters.metadata.all_params.count
                child: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "resource-call-arg", argument_kinds[parameter_index], encoded_arguments[parameter_index], 0, 0, 0, 0, 0, functions.parameters.metadata.all_params[param_start + parameter_index], "")
                report.analysis_1.kernel.children.push(child)
            # The callee's declared parameter modes are the whole premise of the rule, so they are
            # recorded alongside the actuals rather than left as the producer's word. Replay pairs
            # each formal with its actual and re-derives the permission each mode requires, and
            # over-approximates an exclusive formal by a write to the whole lent place.
            for parameter_index in 0..<mapped.count |parameter_index, report, functions, param_start|:
                slot: usize = param_start + parameter_index
                return false if slot >= functions.parameters.metadata.all_params.count or slot >= functions.parameters.metadata.all_parameter_references.count or slot >= functions.parameters.metadata.all_parameter_mutable_references.count
                reference_formal: bool = functions.parameters.metadata.all_parameter_references[slot]
                exclusive_formal: bool = functions.parameters.metadata.all_parameter_mutable_references[slot]
                return false if exclusive_formal and not reference_formal
                shared_mode: sview = "external-shared" if reference_formal else "value"
                mode: sview = "external-mutable" if exclusive_formal else shared_mode
                formal_region: sview = proof_resource_function_parameter_region(functions, callee_index, parameter_index)
                formal: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "resource-call-formal", mode, 0, 0, 0, 0, 0, 0, functions.parameters.metadata.all_params[slot], formal_region)
                report.analysis_1.kernel.children.push(formal)
            for region_index in 0..<lend_formal_regions.count |region_index, lend_formal_regions, lend_actual_regions, report|:
                region_child: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, lend_formal_regions[region_index], lend_actual_regions[region_index])
                report.analysis_1.kernel.children.push(region_child)
            event: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "resource-call-lend", "", 0, lend_formal_regions.count, mapped.count, start, mapped.count * 2 + lend_formal_regions.count, 0, callee_name, proof_resource_function_owner(functions, callee_index))
            state.evidence.trace_events.push(event)
            return true

        def proof_resource_binding_is_moved(state: ProofResourceState&, slot: usize) -> bool:
            return slot < state.bindings.binding_moved.count and state.bindings.binding_moved[slot]

        # A whole binding write needs mutable storage. Mutable references are writable by their
        # type; ordinary bindings carry the explicit `mutable` capability bit. Path writes are
        # checked separately because struct fields may be mutable even when their root is not.
        def proof_resource_binding_is_writable(state: ProofResourceState&, slot: usize) -> bool:
            return false if slot >= state.bindings.binding_type_marker_complete.count or not state.bindings.binding_type_marker_complete[slot]
            is_reference: bool = slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]
            if is_reference:
                return slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]
            return slot < state.bindings.binding_writable.count and state.bindings.binding_writable[slot]

        def proof_resource_mark_binding_moved(state: mutable ProofResourceState&, slot: usize) -> void:
            state.bindings.binding_moved[slot] <- true if slot < state.bindings.binding_moved.count

        def proof_resource_has_borrow_for(state: ProofResourceState&, target_slot: usize, except_slot: usize) -> bool:
            for index in 0..<state.borrows.borrow_target_slots.count |index, state, target_slot, except_slot|:
                return true if index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and state.borrows.borrow_target_slots[index] == target_slot
            return false

        def proof_resource_has_mutable_borrow_for(state: ProofResourceState&, target_slot: usize, except_slot: usize) -> bool:
            for index in 0..<state.borrows.borrow_target_slots.count |index, state, target_slot, except_slot|:
                return true if index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and state.borrows.borrow_target_slots[index] == target_slot and index < state.borrows.borrow_mutable.count and state.borrows.borrow_mutable[index]
            return false

        def proof_resource_has_borrow_overlap[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, target: ProofResourcePlace, except_slot: usize) -> bool can[Global.Read, Global.Write]:
            return false if target.root == ""
            for index in 0..<state.borrows.borrow_target_places.count |index, state, report, target, except_slot|:
                return true if index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and (proof_resource_places_overlap(state, report, state.borrows.borrow_target_places[index], target) can Global{Read,Write})
            binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, target.root, report)
            return true if not binding.complete
            target_slot: usize = binding.slot
            target_region: sview = proof_resource_binding_region(state, target_slot)
            return true if target_region != "" and any borrowed in state.regions.region_wide_borrows where borrowed == target_region
            return false

        def proof_resource_has_mutable_borrow_overlap[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, target: ProofResourcePlace, except_slot: usize) -> bool can[Global.Read, Global.Write]:
            return false if target.root == ""
            for index in 0..<state.borrows.borrow_target_places.count |index, state, report, target, except_slot|:
                return true if index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and index < state.borrows.borrow_mutable.count and state.borrows.borrow_mutable[index] and (proof_resource_places_overlap(state, report, state.borrows.borrow_target_places[index], target) can Global{Read,Write})
            return false

        # Read-only callers such as contract escape diagnostics must not emit resource proof
        # events. Root equality is intentionally conservative here; the permission transitions
        # above use the fact-aware mutable relation when they decide acceptance.
        def proof_resource_has_borrow_overlap_readonly(state: ProofResourceState&, report: mutable ProofReport&, target: ProofResourcePlace, except_slot: usize) -> bool:
            return false if target.root == ""
            for index in 0..<state.borrows.borrow_target_places.count |index, state, target, except_slot|:
                return true if index != except_slot and index < state.borrows.borrow_present.count and state.borrows.borrow_present[index] and state.borrows.borrow_target_places[index].root == target.root
            binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, target.root, report)
            return true if not binding.complete
            target_slot: usize = binding.slot
            target_region: sview = proof_resource_binding_region(state, target_slot)
            return true if target_region != "" and any borrowed in state.regions.region_wide_borrows where borrowed == target_region
            return false

        def proof_resource_add_failing_obligation(report: mutable ProofReport&, kind: sview, position: Ast::Pos, function_name: sview, message: sview) -> void:
            report.proof_obligation(false)
            proof_add_finding(report, kind, position.line, function_name, message)

        def proof_resource_expr_has_call(expression: Ast::Expr) -> bool:
            # Keep resource state transitions aligned with the main expression effect scan. The
            # old local walk omitted calls hidden in aggregates and future AST forms, which could
            # let a resource fact survive an expression the proof checker treated as effectful.
            return proof_expr_has_call(expression)

        def proof_resource_expr_has_move(expression: Ast::Expr) -> bool:
            return proof_expr_has_move(expression)

        def proof_resource_add_binding[@s](state: mutable ProofResourceState& @s, name: sview, is_reference: bool, is_mutable_reference: bool, is_writable: bool, target_slot: usize, borrow_is_mutable: bool, target_place: ProofResourcePlace) -> void:
            borrow_is_present: bool = target_slot < state.bindings.binding_names.count
            state.bindings.binding_names.push(name)
            state.bindings.binding_reference.push(is_reference)
            state.bindings.binding_mutable_reference.push(is_mutable_reference)
            state.bindings.binding_type_marker_complete.push(true)
            state.bindings.binding_writable.push(is_writable)
            state.bindings.binding_moved.push(false)
            state.bindings.binding_region.push("")
            state.bindings.binding_region_live.push(false)
            state.bindings.binding_region_destroyed.push(false)
            state.bindings.binding_region_owner.push(false)
            state.bindings.binding_scalar.push(false)
            state.bindings.binding_borrowable.push(false)
            state.bindings.binding_extent.push(false)
            state.borrows.borrow_target_slots.push(target_slot)
            state.borrows.borrow_target_places.push(target_place)
            state.borrows.borrow_mutable.push(borrow_is_mutable)
            state.borrows.borrow_present.push(borrow_is_present)

        def proof_resource_expr_has_address_of(expression: Ast::Expr) -> bool:
            return proof_resource_expr_has_address_of_depth(expression, 0)

        def proof_resource_expr_has_address_of_depth(expression: Ast::Expr, depth: usize) -> bool:
            # This resource-specific classifier has its own bound. Do not use the broad
            # expression-support predicate as an opaque marker: known unsupported forms such as a
            # conditional containing a call are not evidence of an address-of value.
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == TokenKind.Ampersand
                    return proof_resource_expr_has_address_of_depth(operand, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_has_address_of_depth(inner, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_has_address_of_depth(left, depth + 1) or proof_resource_expr_has_address_of_depth(right, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_has_address_of_depth(callee, depth + 1)
                    for argument in arguments |argument, depth|:
                        return true if proof_resource_expr_has_address_of_depth(argument, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_has_address_of_depth(lowered.call, depth + 1) if lowered.known
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_has_address_of_depth(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_has_address_of_depth(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_has_address_of_depth(object, depth + 1) or proof_resource_expr_has_address_of_depth(index, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_has_address_of_depth(object, depth + 1)
                    for argument in arguments |argument, depth|:
                        return true if proof_resource_expr_has_address_of_depth(argument, depth + 1)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_has_address_of_depth(object, depth + 1) or proof_resource_expr_has_address_of_depth(low, depth + 1) or proof_resource_expr_has_address_of_depth(high, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_resource_expr_has_address_of_depth(operand, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, depth|:
                        return true if proof_resource_expr_has_address_of_depth(element, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, depth|:
                        return true if proof_resource_expr_has_address_of_depth(element, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, depth|:
                        return true if proof_resource_expr_has_address_of_depth(element, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, depth|:
                        return true if proof_resource_expr_has_address_of_depth(entry.key, depth + 1) or proof_resource_expr_has_address_of_depth(entry.value, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, depth|:
                        return true if proof_resource_expr_has_address_of_depth(field.value, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_has_address_of_depth(base, depth + 1)
                    for field in fields |field, depth|:
                        return true if proof_resource_expr_has_address_of_depth(field.value, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_has_address_of_depth(condition, depth + 1) or proof_resource_expr_has_address_of_depth(then_expr, depth + 1) or proof_resource_expr_has_address_of_depth(else_expr, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_resource_expr_has_address_of_depth(iterable, depth + 1) or proof_resource_expr_has_address_of_depth(condition, depth + 1) or proof_resource_expr_has_address_of_depth(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_resource_expr_has_address_of_depth(base, depth + 1) or proof_resource_expr_has_address_of_depth(predicate, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_resource_expr_has_address_of_depth(scrutinee, depth + 1)
                    for arm in arms |arm, depth|:
                        return true if:
                            proof_resource_expr_has_address_of_depth(arm.guard, depth + 1)
                            proof_resource_statements_have_address_of_depth(arm.body, depth + 1)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_has_address_of_depth(guarded, depth + 1)
                    for arm in arms |arm, depth|:
                        return true if:
                            proof_resource_expr_has_address_of_depth(arm.guard, depth + 1)
                            proof_resource_statements_have_address_of_depth(arm.body, depth + 1)
                    return false
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_resource_expr_has_address_of_depth(guarded, depth + 1) or proof_resource_statements_have_address_of_depth(recovery, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    return proof_resource_statements_have_address_of_depth(body, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_resource_statements_have_address_of_depth(statements, depth + 1) or proof_resource_expr_has_address_of_depth(value, depth + 1)
                _:
                    return false

        def proof_resource_statements_have_address_of(statements: darray[Ast::Stmt]&) -> bool:
            return proof_resource_statements_have_address_of_depth(statements, 0)

        def proof_resource_statements_have_address_of_depth(statements: darray[Ast::Stmt]&, depth: usize) -> bool:
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            for statement in statements:
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_resource_expr_has_address_of_depth(initializer, depth + 1)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        return true if proof_resource_expr_has_address_of_depth(target, depth + 1) or proof_resource_expr_has_address_of_depth(initializer, depth + 1)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_resource_expr_has_address_of_depth(expression, depth + 1)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_has_address_of_depth(returned, depth + 1)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_resource_expr_has_address_of_depth(condition, depth + 1) or proof_resource_statements_have_address_of_depth(then_body, depth + 1) or proof_resource_statements_have_address_of_depth(else_body, depth + 1)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_resource_expr_has_address_of_depth(condition, depth + 1) or proof_resource_statements_have_address_of_depth(while_body, depth + 1)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        return true if proof_resource_expr_has_address_of_depth(iterable, depth + 1) or proof_resource_statements_have_address_of_depth(for_body, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_resource_expr_has_address_of_depth(scrutinee, depth + 1)
                        for arm in arms |arm|:
                            return true if proof_resource_expr_has_address_of_depth(arm.guard, depth + 1) or proof_resource_statements_have_address_of_depth(arm.body, depth + 1)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_have_address_of_depth(block_body, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_resource_expr_has_address_of_depth(expression, depth + 1)
                    _:
                        pass
            return false

        # Integer ranges (`a..<b`, `a..=b`, `a..>b`) yield scalar copies, never borrows.
        def proof_resource_iterable_is_range(iterable: Ast::Expr, report: mutable ProofReport&) -> bool:
            proof_resource_iterable_is_range_with_depth(iterable, report, 0)

        def proof_resource_iterable_is_range_with_depth(iterable: Ast::Expr, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return false
            return false if not proof_source_index_work_charge(report, 1)
            match iterable:
                Ast::Expr.Binary(_, operator, _, _):
                    return operator == TokenKind.RangeLt or operator == TokenKind.RangeLe or operator == TokenKind.RangeGt
                Ast::Expr.Paren(inner, _):
                    return proof_resource_iterable_is_range_with_depth(inner, report, depth + 1)
                _:
                    return false

        def proof_resource_expr_uses_local_borrow(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            return proof_resource_expr_uses_local_borrow_depth(expression, state, report, 0)

        def proof_resource_expr_uses_local_borrow_depth(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&, depth: usize) -> bool:
            # Unsupported syntax is diagnosed by the expression checker. This classifier only
            # reports a borrow when it finds one, while the depth boundary prevents an imported
            # term from exhausting the verifier stack.
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    return true if not binding.complete
                    slot: usize = binding.slot
                    return slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot]
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_uses_local_borrow_depth(operand, state, report, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_uses_local_borrow_depth(inner, state, report, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_uses_local_borrow_depth(left, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(right, state, report, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_uses_local_borrow_depth(callee, state, report, depth + 1)
                    for argument in arguments |argument, state, report, depth|:
                        return true if proof_resource_expr_uses_local_borrow_depth(argument, state, report, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_uses_local_borrow_depth(lowered.call, state, report, depth + 1) if lowered.known
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_uses_local_borrow_depth(object, state, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_uses_local_borrow_depth(base, state, report, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_uses_local_borrow_depth(object, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(index, state, report, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_uses_local_borrow_depth(object, state, report, depth + 1)
                    for argument in arguments |argument, state, report, depth|:
                        return true if proof_resource_expr_uses_local_borrow_depth(argument, state, report, depth + 1)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_uses_local_borrow_depth(object, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(low, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(high, state, report, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_resource_expr_uses_local_borrow_depth(operand, state, report, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state, report, depth|:
                        return true if proof_resource_expr_uses_local_borrow_depth(element, state, report, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state, report, depth|:
                        return true if proof_resource_expr_uses_local_borrow_depth(element, state, report, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state, report, depth|:
                        return true if proof_resource_expr_uses_local_borrow_depth(element, state, report, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state, report, depth|:
                        return true if proof_resource_expr_uses_local_borrow_depth(entry.key, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(entry.value, state, report, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state, report, depth|:
                        return true if proof_resource_expr_uses_local_borrow_depth(field.value, state, report, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_uses_local_borrow_depth(base, state, report, depth + 1)
                    for field in fields |field, state, report, depth|:
                        return true if proof_resource_expr_uses_local_borrow_depth(field.value, state, report, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_uses_local_borrow_depth(condition, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(then_expr, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(else_expr, state, report, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_resource_expr_uses_local_borrow_depth(iterable, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(condition, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(body, state, report, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_resource_expr_uses_local_borrow_depth(base, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(predicate, state, report, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_resource_expr_uses_local_borrow_depth(scrutinee, state, report, depth + 1)
                    for arm in arms |arm, state, report, depth|:
                        return true if:
                            proof_resource_expr_uses_local_borrow_depth(arm.guard, state, report, depth + 1)
                            proof_resource_statements_use_local_borrow_depth(arm.body, state, report, depth + 1)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_uses_local_borrow_depth(guarded, state, report, depth + 1)
                    for arm in arms |arm, state, report, depth|:
                        return true if:
                            proof_resource_expr_uses_local_borrow_depth(arm.guard, state, report, depth + 1)
                            proof_resource_statements_use_local_borrow_depth(arm.body, state, report, depth + 1)
                    return false
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_resource_expr_uses_local_borrow_depth(guarded, state, report, depth + 1) or proof_resource_statements_use_local_borrow_depth(recovery, state, report, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    return proof_resource_statements_use_local_borrow_depth(body, state, report, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_resource_statements_use_local_borrow_depth(statements, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(value, state, report, depth + 1)
                _:
                    return false

        def proof_resource_statements_use_local_borrow(statements: darray[Ast::Stmt]&, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            return proof_resource_statements_use_local_borrow_depth(statements, state, report, 0)

        def proof_resource_statements_use_local_borrow_depth(statements: darray[Ast::Stmt]&, state: ProofResourceState&, report: mutable ProofReport&, depth: usize) -> bool:
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT or not proof_source_index_work_charge(report, 1)
            for statement in statements |report|:
                return true if not proof_source_index_work_charge(report, 1)
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        return true if proof_resource_expr_uses_local_borrow_depth(initializer, state, report, depth + 1)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        return true if proof_resource_expr_uses_local_borrow_depth(target, state, report, depth + 1) or proof_resource_expr_uses_local_borrow_depth(initializer, state, report, depth + 1)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_resource_expr_uses_local_borrow_depth(expression, state, report, depth + 1)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_uses_local_borrow_depth(returned, state, report, depth + 1)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_resource_expr_uses_local_borrow_depth(condition, state, report, depth + 1) or proof_resource_statements_use_local_borrow_depth(then_body, state, report, depth + 1) or proof_resource_statements_use_local_borrow_depth(else_body, state, report, depth + 1)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_resource_expr_uses_local_borrow_depth(condition, state, report, depth + 1) or proof_resource_statements_use_local_borrow_depth(while_body, state, report, depth + 1)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        return true if proof_resource_expr_uses_local_borrow_depth(iterable, state, report, depth + 1) or proof_resource_statements_use_local_borrow_depth(for_body, state, report, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_resource_expr_uses_local_borrow_depth(scrutinee, state, report, depth + 1)
                        for arm in arms |arm, state, report|:
                            return true if proof_resource_expr_uses_local_borrow_depth(arm.guard, state, report, depth + 1) or proof_resource_statements_use_local_borrow_depth(arm.body, state, report, depth + 1)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_use_local_borrow_depth(block_body, state, report, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_resource_expr_uses_local_borrow_depth(expression, state, report, depth + 1)
                    _:
                        pass
            return false
