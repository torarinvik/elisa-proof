# Detect call expressions whose return resource mode cannot be trusted by the local checker.
extend ElisaProof:
    private:
        def proof_resource_expr_has_opaque_call_result(expression: Ast::Expr, state: ProofResourceState&, functions: ProofFunctionTable&, source_work: mutable usize&, depth: usize) -> bool:
            return true if depth >= PROOF_TYPE_AUDIT_DEPTH_LIMIT or not proof_type_audit_work_charge(1, source_work)
            match expression:
                Ast::Expr.Invalid:
                    return true
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_callee_shadowed_by_local(callee, state)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    return true if function_index >= functions.lookup.names.count or function_index >= functions.returns.return_type_marker_complete.count or not functions.returns.return_type_marker_complete[function_index]
                    return true if function_index < functions.returns.return_references.count and functions.returns.return_references[function_index]
                    return true if function_index < functions.returns.return_sviews.count and functions.returns.return_sviews[function_index]
                    return true if function_index >= functions.returns.return_scalar.count or not functions.returns.return_scalar[function_index]
                    return true if proof_resource_expr_has_opaque_call_result(callee, state, functions, source_work, depth + 1)
                    for argument in arguments |argument, state, functions, source_work, depth|:
                        return true if proof_resource_expr_has_opaque_call_result(argument, state, functions, source_work, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return true if not lowered.known
                    return proof_resource_expr_has_opaque_call_result(lowered.call, state, functions, source_work, depth + 1)
                Ast::Expr.Paren(inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_resource_expr_has_opaque_call_result(inner, state, functions, source_work, depth + 1)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _):
                    return true if proof_resource_expr_has_opaque_call_result(object, state, functions, source_work, depth + 1)
                    return proof_resource_expr_has_opaque_call_result(index, state, functions, source_work, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return true if proof_resource_expr_has_opaque_call_result(object, state, functions, source_work, depth + 1)
                    return true if proof_resource_expr_has_opaque_call_result(low, state, functions, source_work, depth + 1)
                    return proof_resource_expr_has_opaque_call_result(high, state, functions, source_work, depth + 1)
                Ast::Expr.RegionNew(_, _, _):
                    return true
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_has_opaque_call_result(object, state, functions, source_work, depth + 1)
                    for argument in arguments |argument, state, functions, source_work, depth|:
                        return true if proof_resource_expr_has_opaque_call_result(argument, state, functions, source_work, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _) | Ast::Expr.Array(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state, functions, source_work, depth|:
                        return true if proof_resource_expr_has_opaque_call_result(element, state, functions, source_work, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state, functions, source_work, depth|:
                        return true if proof_resource_expr_has_opaque_call_result(entry.key, state, functions, source_work, depth + 1)
                        return true if proof_resource_expr_has_opaque_call_result(entry.value, state, functions, source_work, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state, functions, source_work, depth|:
                        return true if proof_resource_expr_has_opaque_call_result(field.value, state, functions, source_work, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_has_opaque_call_result(base, state, functions, source_work, depth + 1)
                    for field in fields |field, state, functions, source_work, depth|:
                        return true if proof_resource_expr_has_opaque_call_result(field.value, state, functions, source_work, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return true if proof_resource_expr_has_opaque_call_result(condition, state, functions, source_work, depth + 1)
                    return true if proof_resource_expr_has_opaque_call_result(then_expr, state, functions, source_work, depth + 1)
                    return proof_resource_expr_has_opaque_call_result(else_expr, state, functions, source_work, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return true if proof_resource_expr_has_opaque_call_result(base, state, functions, source_work, depth + 1)
                    return proof_resource_expr_has_opaque_call_result(predicate, state, functions, source_work, depth + 1)
                # These forms contain branch bodies or deferred closures, whose tail-result
                # resource modes are not summarized here. Fail closed for an opaque destination.
                Ast::Expr.Match(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _):
                    return true
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return true if proof_resource_expr_has_opaque_call_result(iterable, state, functions, source_work, depth + 1)
                    return true if proof_resource_expr_has_opaque_call_result(condition, state, functions, source_work, depth + 1)
                    return proof_resource_expr_has_opaque_call_result(body, state, functions, source_work, depth + 1)
                _:
                    return true
