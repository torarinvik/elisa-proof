extend ElisaProof:
    private:
        # Admission uses may-overlap. Diagnostics must not turn failure to prove
        # disjointness (or a widened footprint) into a concrete violation.
        # Closed, exact prefixes establish overlap without consulting assumptions.
        def proof_resource_places_definitely_overlap(report: ProofReport&, left: ProofResourcePlace, right: ProofResourcePlace) -> bool:
            return false if not left.exact or not right.exact or left.root == "" or left.root != right.root
            return true if left.whole or right.whole
            depth: usize = left.depth if left.depth < right.depth else right.depth
            return false if depth == 0 or left.depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or right.depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            for index in 0..<depth:
                a: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_resource_path_component(report, left.path_root, index, left.depth)
                b: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_resource_path_component(report, right.path_root, index, right.depth)
                return false if not a.known or not b.known or a.kind != b.kind
                match a.kind:
                    "field":
                        return false if a.field != b.field
                    "index":
                        return false if not proof_resource_index_is_closed(report, a.expression_root) or not proof_resource_index_is_closed(report, b.expression_root) or a.value != b.value
                    _:
                        return false
            return true

        def proof_resource_report_borrow_conflict(state: ProofResourceState&, report: mutable ProofReport&, target: ProofResourcePlace, except_slot: usize, mutable_only: bool, kind: sview, position: Ast::Pos, function_name: sview, message: sview) -> void:
            for index in 0..<state.borrow_target_places.count |index, state, report, target, except_slot, mutable_only, kind, position, function_name, message|:
                continue if index == except_slot or index >= state.borrow_present.count or not state.borrow_present[index]
                continue if mutable_only and (index >= state.borrow_mutable.count or not state.borrow_mutable[index])
                if proof_resource_places_definitely_overlap(report, state.borrow_target_places[index], target):
                    proof_resource_add_failing_obligation(report, kind, position, function_name, message)
                    return
            proof_resource_add_failing_obligation(report, "borrow-overlap-unproven", position, function_name, "the access may overlap a live borrow; disjointness was not established, but a concrete overlap was not demonstrated")
